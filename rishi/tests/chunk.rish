# chunk.rish — tests for the `chunk`, `window`, and `flatten` list builtins.
#
# Wired from the PLEAC lists cookbook (spec: pleac/lists.rye). chunk cuts into
# consecutive groups; window yields overlapping runs; flatten concatenates lists.
# (Rishi indexes one level at a time, so inner lists are bound before indexing.)

# chunk into groups of two — [[1 2] [3 4] [5]]; the last is short.
let cs = chunk [1 2 3 4 5] 2
assert (length cs) == 3 else "chunk: group count failed"
let g0 = cs[0]
assert (length g0) == 2 else "chunk: first group size failed"
assert g0[0] == 1 else "chunk: first element failed"
let g2 = cs[2]
assert (length g2) == 1 else "chunk: short last group failed"
assert g2[0] == 5 else "chunk: last element failed"

# flatten is the inverse of chunk — flatten (chunk xs n) == xs.
let back = flatten (chunk [1 2 3 4 5] 2)
assert (length back) == 5 else "flatten: round-trip length failed"
assert back[0] == 1 else "flatten: first element failed"
assert back[4] == 5 else "flatten: last element failed"

# window of three — [[1 2 3] [2 3 4] [3 4 5]]; count is len - size + 1 = 3.
let ws = window [1 2 3 4 5] 3
assert (length ws) == 3 else "window: count failed"
let w0 = ws[0]
assert w0[0] == 1 else "window: first run start failed"
assert w0[2] == 3 else "window: first run end failed"
let w2 = ws[2]
assert w2[2] == 5 else "window: last run end failed"

# a list shorter than a window yields none.
assert (length (window [7 8] 3)) == 0 else "window: short list not empty"

say "GREEN: chunk/window/flatten — grouping lossless, windows overlapping, flatten the inverse of chunk."
