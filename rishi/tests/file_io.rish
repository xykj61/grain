# file_io.rish -- file I/O builtins for Rishi.
# Proves: read-file, write-file, list-dir -- each behind the OS boundary.
#
# The scratch anchor is tools/fixtures/rish_io/, inside this checkout, rather than /tmp. Eight
# ships run one roster from eight trees on one pier and share a single /tmp, so a constant name
# there is a name eight hands reach for at once, and the reading that follows is a fact about the
# pen wearing the costume of a fact about the builtin. The sibling witness
# tools/r/rish_file_io_witness.rish has written here since it was seated; this elder copy kept the
# /tmp names, and tools/fixtures/s/shared_pen_scan.sh could not see it while its population was
# tools/ alone. The directory's *.txt are gitignored and the README there is the anchor.

# Write a file, then read it back.
write-file "tools/fixtures/rish_io/io_test.txt" "hello from rishi"
let content = read-file "tools/fixtures/rish_io/io_test.txt"
assert content == "hello from rishi" else "read-file round-trip failed"

# Write a second file with an integer value rendered to text.
write-file "tools/fixtures/rish_io/io_test_num.txt" 42
let num_content = read-file "tools/fixtures/rish_io/io_test_num.txt"
assert num_content == "42" else "write-file integer rendering failed"

# List the directory containing our test files.
let entries = list-dir "tools/fixtures/rish_io"
assert entries contains "io_test.txt" else "list-dir did not find io_test.txt"
assert entries contains "io_test_num.txt" else "list-dir did not find io_test_num.txt"

# Write with a variable path.
let path = "tools/fixtures/rish_io/io_var_path.txt"
write-file path "variable path works"
let var_content = read-file path
assert var_content == "variable path works" else "variable-path write-file round-trip failed"

say "file I/O held."
