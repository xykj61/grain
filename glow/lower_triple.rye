//! glow/lower_triple.rye -- lower a parsed `:+` triple cell to runnable `.rye`.
//!
//! Thin STOA3 face: three demo atoms into a Zig triple struct.

const std = @import("std");
const assert = std.debug.assert;
const rt = @import("rune_triple.rye");
const refusal = @import("refusal.rye");
const zig_ident = @import("zig_ident.rye");

pub const LowerError = rt.ParseError || error{
    Overflow,
    EmptySource,
    BadIdent,
};

pub const triple_demo_a: u32 = 5;
pub const triple_demo_b: u32 = 3;
pub const triple_demo_c: u32 = 1;

/// The one ident rule, reached through `glow/zig_ident.rye`. The ceiling is this module's
/// own `rt.max_name_len`; the rule -- hyphen to underscore, then Zig's own identifier bytes -- is the
/// room's, and stood in 29 copies before it moved.
fn zig_safe_ident(face: []const u8, out: *[rt.max_name_len]u8, field: []const u8) LowerError!u32 {
    var slot: refusal.Slot = null;
    // invariant: this entry keeps the parameters and the error name it always had, and it
    // answers the `u32` the rule itself answers rather than widening it to `usize` for the
    // caller -- a return width is authored API, where TAME asks a fixed width and leaves
    // `usize` at the seam; the record is dropped here because a caller wanting it reaches
    // `zig_ident.safe_ident` directly rather than through this module
    const n = try zig_ident.safe_ident(face, out[0..], rt.max_name_len, field, .refuse, &slot);
    // invariant: the rule wrote exactly the face it was handed, so the span below is the
    // caller's own length rather than a truncation the buffer would have hidden
    assert(n == face.len);
    return n;
}

fn emit_triple_program(
    ga: []const u8,
    gb: []const u8,
    gc: []const u8,
    za: []const u8,
    zb: []const u8,
    zc: []const u8,
    expect_p: u32,
    expect_q: u32,
    expect_r: u32,
    out: []u8,
) LowerError!u32 {
    const written = std.fmt.bufPrint(out,
        \\const std = @import("std");
        \\
        \\/// Lowered from Glow `:+  {s}  {s}  {s}` — triple cell of demo atoms.
        \\pub fn main(_: std.process.Init) !u8 {{
        \\    const Triple = struct {{ p: u32, q: u32, r: u32 }};
        \\    const {s}: u32 = {d};
        \\    const {s}: u32 = {d};
        \\    const {s}: u32 = {d};
        \\    const trip: Triple = .{{ .p = {s}, .q = {s}, .r = {s} }};
        \\    return if (trip.p == {d} and trip.q == {d} and trip.r == {d}) 0 else 1;
        \\}}
        \\
    , .{
        ga,
        gb,
        gc,
        za,
        triple_demo_a,
        zb,
        triple_demo_b,
        zc,
        triple_demo_c,
        za,
        zb,
        zc,
        expect_p,
        expect_q,
        expect_r,
    }) catch return error.Overflow;
    return @intCast(written.len);
}

fn lower_line(line: []const u8, welcome: bool, out: []u8) LowerError!u32 {
    const trimmed = std.mem.trim(u8, line, " \t\r\n");
    if (trimmed.len == 0) return error.EmptySource;
    const spec = try rt.parse(trimmed);
    const ga = rt.a_slice(&spec);
    const gb = rt.b_slice(&spec);
    const gc = rt.c_slice(&spec);
    var za: [rt.max_name_len]u8 = undefined;
    var zb: [rt.max_name_len]u8 = undefined;
    var zc: [rt.max_name_len]u8 = undefined;
    const an = try zig_safe_ident(ga, &za, "gate");
    const bn = try zig_safe_ident(gb, &zb, "gate");
    const cn = try zig_safe_ident(gc, &zc, "gate");
    const expect_p: u32 = if (welcome) triple_demo_a else triple_demo_a +% 1;
    return emit_triple_program(
        ga,
        gb,
        gc,
        za[0..an],
        zb[0..bn],
        zc[0..cn],
        expect_p,
        triple_demo_b,
        triple_demo_c,
        out,
    );
}

pub fn lower_line_welcome(line: []const u8, out: []u8) LowerError!u32 {
    return lower_line(line, true, out);
}

pub fn lower_line_unwelcome(line: []const u8, out: []u8) LowerError!u32 {
    return lower_line(line, false, out);
}
