//! glow/lower_shop_core.rye -- lower a `|%` core to one runnable Rye module.
//!
//! Each arm lowers to one public function named for the arm (hyphens become
//! underscores), and a speaking argv main dispatches: argv[1] is the arm's
//! ordinal in source order, the remaining decimals are its faces, and the
//! answer reaches stdout -- so a witness drives every arm with the same
//! samples its standing single desks take, and the two homes are held to one
//! truth. Arm bodies admit the three kinds the Lantern face's laws use --
//! the single-face gth cond and the and/or pairs -- and any other kind
//! refuses by name until a law brings it.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const rb = @import("rune_shop_gate.rye");
const rc = @import("rune_shop_core.rye");

pub const looks_like_core = rc.looks_like_core;
pub const core_max_lines = rc.core_max_lines;

pub const LowerError = error{
    Overflow,
    CoreArmNotYetLowered,
} || rc.CoreError;

fn append_print(out: []u8, used: *u32, comptime f: []const u8, args: anytype) LowerError!void {
    const rest = out[@as(usize, @intCast(used.*))..];
    const line = std.fmt.bufPrint(rest, f, args) catch return error.Overflow;
    used.* += @as(u32, @intCast(line.len));
}

/// The arm's Zig-safe function name: lowercase kept, hyphens to underscores.
fn safe_arm_name(name: []const u8, buf: []u8) LowerError![]const u8 {
    // invariant: the caller's buffer holds any lawful arm name.
    assert(buf.len >= rc.max_arm_name_len);
    if (name.len > buf.len) return error.Overflow;
    var i: u32 = 0;
    while (i < name.len) : (i += 1) {
        const c = name[@as(usize, @intCast(i))];
        buf[@as(usize, @intCast(i))] = if (c == '-') '_' else c;
    }
    return buf[0..name.len];
}

/// How many faces an arm's dispatch case parses -- from its body kind.
pub fn arm_face_count(gate: *const rb.GateSpec) LowerError!u32 {
    return switch (gate.body) {
        .cond_gth => 1,
        .cond_and_pair, .cond_or_pair => 2,
        else => error.CoreArmNotYetLowered,
    };
}

fn emit_arm_fn(out: []u8, used: *u32, arm: *const rc.ArmSpec, zname: []const u8) LowerError!void {
    const gate = &arm.gate;
    var fb: [rb.max_face_len]u8 = undefined;
    const zface = try safe_arm_name(rb.face_slice(gate), &fb);
    switch (gate.body) {
        .cond_gth => {
            try append_print(out, used, "/// Lowered from core arm `{s}` -- single-face gth cond.\n", .{arm_label(arm)});
            try append_print(out, used, "pub fn {s}({s}: u32) u32 {{\n    return if ({s} > {d}) {d} else {d};\n}}\n\n", .{ zname, zface, zface, gate.cond_rhs, gate.cond_then, gate.cond_else });
        },
        .cond_and_pair, .cond_or_pair => {
            var f2b: [rb.max_face_len]u8 = undefined;
            const zfb = try safe_arm_name(rb.face2_slice(gate), &f2b);
            const op1: []const u8 = if (gate.and_op1 == 1) ">" else "==";
            const op2: []const u8 = if (gate.and_op2 == 1) ">" else "==";
            const joiner: []const u8 = if (gate.body == .cond_and_pair) "and" else "or";
            try append_print(out, used, "/// Lowered from core arm `{s}` -- composed {s} cond.\n", .{ arm_label(arm), joiner });
            try append_print(out, used, "pub fn {s}({s}: u32, {s}: u32) u32 {{\n    return if (({s} {s} {d}) {s} ({s} {s} {d})) {d} else {d};\n}}\n\n", .{ zname, zface, zfb, zface, op1, gate.and_rhs1, joiner, zfb, op2, gate.and_rhs2, gate.cond_then, gate.cond_else });
        },
        else => return error.CoreArmNotYetLowered,
    }
}

fn arm_label(arm: *const rc.ArmSpec) []const u8 {
    return rc.arm_name_slice(arm);
}

/// Lower the whole core: module head, one function per arm, the dispatch main.
pub fn lower_core_argv(src: []const u8, out: []u8) LowerError!u32 {
    const spec = try rc.parse_core(src);
    // invariant: parse_core admits only cores holding at least one arm.
    assert(spec.arm_count >= 1);
    var used: u32 = 0;
    try append_print(out, &used, "//! Lowered from a Glow `|%` core -- {d} arms, one module (20260830.224500).\n\nconst std = @import(\"std\");\n\n", .{spec.arm_count});
    var k: u32 = 0;
    while (k < spec.arm_count) : (k += 1) {
        const arm = &spec.arms[@as(usize, @intCast(k))];
        var nb: [rc.max_arm_name_len]u8 = undefined;
        const zname = try safe_arm_name(rc.arm_name_slice(arm), &nb);
        try emit_arm_fn(out, &used, arm, zname);
    }
    try append_print(out, &used, "pub fn main(init: std.process.Init) !u8 {{\n    const alloc = init.arena.allocator();\n    const argv = try init.minimal.args.toSlice(alloc);\n    if (argv.len < 3) return 2;\n    const arm = std.fmt.parseInt(u32, argv[1], 10) catch return 2;\n    const s1 = std.fmt.parseInt(u32, argv[2], 10) catch return 2;\n    const answer: u32 = switch (arm) {{\n", .{});
    k = 0;
    while (k < spec.arm_count) : (k += 1) {
        const arm = &spec.arms[@as(usize, @intCast(k))];
        var nb: [rc.max_arm_name_len]u8 = undefined;
        const zname = try safe_arm_name(rc.arm_name_slice(arm), &nb);
        const faces = try arm_face_count(&arm.gate);
        if (faces == 1) {
            try append_print(out, &used, "        {d} => {s}(s1),\n", .{ k + 1, zname });
        } else {
            try append_print(out, &used, "        {d} => blk: {{\n            if (argv.len < 4) return 2;\n            const s2 = std.fmt.parseInt(u32, argv[3], 10) catch return 2;\n            break :blk {s}(s1, s2);\n        }},\n", .{ k + 1, zname });
        }
    }
    try append_print(out, &used, "        else => return 2,\n    }};\n    var buf: [12]u8 = undefined;\n    const line = std.fmt.bufPrint(&buf, \"{{d}}\\n\", .{{answer}}) catch return 2;\n    const io = init.io;\n    std.Io.File.stdout().writeStreamingAll(io, line) catch return 2;\n    return 0;\n}}\n", .{});
    return used;
}
