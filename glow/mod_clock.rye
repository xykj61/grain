//! glow/mod_clock.rye -- paired clocks for n mod 12 - n mod 16 collaboration.
//!
//! Honest law: Z/12 and Z/16 differ in size, so there is no set bijection
//! between residue classes alone. Collaboration uses the **joint clock**
//! LCM(12,16)=48 and the pair map n ↦ (n mod 12, n mod 16). Compatible
//! lifts exist when a ≡ b (mod gcd(12,16)=4).
//!
//!   rye/bin/rye build glow/mod_clock.rye -femit-bin=glow/bin/mod-clock
//!   glow/bin/mod-clock
//!
//! Data companion: tools/gen/season/recursion_block.brix (Brix = data).

const std = @import("std");
const assert = std.debug.assert;

pub const mod_twelve: u32 = 12;
pub const mod_sixteen: u32 = 16;
pub const joint_clock: u32 = 48; // LCM(12,16)
pub const gcd_clock: u32 = 4;

pub const Pair = struct {
    house12: u32,
    slot16: u32,
};

pub fn mod12(n: u32) u32 {
    return n % mod_twelve;
}

pub fn mod16(n: u32) u32 {
    return n % mod_sixteen;
}

pub fn pair(n: u32) Pair {
    return .{ .house12 = mod12(n), .slot16 = mod16(n) };
}

/// Compatible when house12 ≡ slot16 (mod 4).
pub fn compatible(house12: u32, slot16: u32) bool {
    // invariant: the two moduli are what the joint index multiplies together, so a value past
    // either would name a joint that does not exist
    assert(house12 < mod_twelve);
    assert(slot16 < mod_sixteen);
    return (house12 % gcd_clock) == (slot16 % gcd_clock);
}

pub const priority_slots: u32 = 16;

/// The twelve base priorities -- the ten grain strands (20260702.184312) plus
/// Radiant and single-stranded. Roster seated 20260729.203719.
/// Data twin: tools/gen/season/recursion_block.brix priority_1..priority_12.
pub const Priority = enum(u8) {
    five_primitives = 0,
    tame_order = 1,
    explicit_bounds = 2,
    values_apart = 3,
    accretion_one_clock = 4,
    galls_law_graduation = 5,
    seam_honesty = 6,
    happy_zone_witnesses_first = 7,
    sameness_as_compression = 8,
    opening_lines_and_silo = 9,
    radiant = 10,
    single_stranded = 11,
};

pub const priority_base_count: u32 = 12;
pub const emphasis_stride: u32 = 4; // one emphasis slot per quarter journey

/// The four double-weighted practices, in the order they take emphasis slots.
/// Order corrected 20260729.225900 (Voice v11). The first arrangement put
/// sameness_as_compression at emphasis slot 11 while its base slot is 10 --
/// adjacent, which is precisely the clustering the spacing exists to prevent.
/// Searched all 24 orderings: this one maximizes the minimum gap between a
/// doubled practice's two appearances, lifting it from 1 to 6.
pub const doubled = [4]Priority{
    .sameness_as_compression,
    .single_stranded,
    .explicit_bounds,
    .happy_zone_witnesses_first,
};

/// The minimum gap this arrangement guarantees, asserted by the fold's witness.
pub const min_emphasis_gap: u32 = 6;

/// Slot to priority across one sixteen-slot journey.
///
/// Emphasis slots 3 - 7 - 11 - 15 carry the four doubles, one per quarter, so
/// a doubled practice recurs across the whole journey rather than clustering
/// at its end. The remaining twelve slots carry the base roster in order.
/// The roster is data; this spacing is the fold -- proposed, and one line of
/// brix away from any other arrangement Keaton prefers.
pub fn priority_of_slot(slot: u32) Priority {
    // invariant: the priority table is indexed by this slot directly, so a slot past its length
    // would read past the table
    assert(slot < priority_slots);
    if (slot % emphasis_stride == emphasis_stride - 1) {
        const which: u32 = slot / emphasis_stride;
        // invariant: four emphasis slots and four doubles, so the table and the index into it
        // share one length
        assert(which < doubled.len);
        return doubled[@intCast(which)];
    }
    const base: u32 = slot - (slot / emphasis_stride);
    // invariant: twelve base slots and twelve names, so the table and the index into it share
    // one length
    assert(base < priority_base_count);
    return @enumFromInt(@as(u8, @intCast(base)));
}

/// The priority a numbered round is walked under -- n mod 16.
pub fn priority_of_round(n: u32) Priority {
    return priority_of_slot(n % priority_slots);
}

/// Four direction houses for collaboration priority (seated Equinox e0).
/// East 0 - North 1 - West 2 - South 3 -- each covers three zodiac houses.
pub const Direction = enum(u32) {
    east = 0,
    north = 1,
    west = 2,
    south = 3,
};

/// Zodiac house 0=Aries ... 11=Pisces -> direction quadrant.
pub fn direction_of_house12(house12: u32) Direction {
    // invariant: the direction table is indexed by house directly, so a house past twelve would
    // read past it
    assert(house12 < mod_twelve);
    // East: 11 (Pisces/12th), 0 (Aries/1st), 1 (Taurus/2nd) -- user seat 12th-1st-2nd
    if (house12 == 11 or house12 == 0 or house12 == 1) return .east;
    // North: 8 (Sag/9th), 9 (Cap/10th), 10 (Aqu/11th)
    if (house12 == 8 or house12 == 9 or house12 == 10) return .north;
    // West: 5 (Virgo/6th), 6 (Libra/7th), 7 (Scorpio/8th)
    if (house12 == 5 or house12 == 6 or house12 == 7) return .west;
    // South: 2 (Gemini/3rd), 3 (Cancer/4th), 4 (Leo/5th)
    return .south;
}

pub fn joint_index(n: u32) u32 {
    return n % joint_clock;
}

fn selftest() void {
    assert(mod12(12) == 0);
    assert(mod16(16) == 0);
    assert(joint_index(48) == 0);
    assert(compatible(0, 4));
    assert(compatible(0, 8));
    assert(!compatible(0, 1));
    const p = pair(25);
    assert(p.house12 == 1);
    assert(p.slot16 == 9);
    assert(direction_of_house12(0) == .east);
    assert(direction_of_house12(9) == .north);
    assert(direction_of_house12(6) == .west);
    assert(direction_of_house12(3) == .south);
}

pub fn main(_: std.process.Init) !u8 {
    selftest();
    const p = pair(25);
    std.debug.print(
        "mod-clock: joint={d} pair n=25 -> ({d},{d}) east/north/west/south — GREEN\n",
        .{ joint_clock, p.house12, p.slot16 },
    );
    return 0;
}
