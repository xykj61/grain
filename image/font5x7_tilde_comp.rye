//! image/font5x7_tilde_comp.rye -- the open tilde-accent vowels corpus, GROWN BY COMPOSITION (Season G, the overlay economy for a fourth mark).
//!
//! Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the
//! hand-drawn accent corpora (image/font5x7_tilde.rye the tilde vowels drawn by hand, image/font5x7_grave.rye the
//! grave, image/font5x7_circumflex.rye the circumflex, image/font5x7_latin1.rye the acute and cedilla) and beside
//! image/font5x7_acute.rye and image/font5x7_circumflex_comp.rye, the acute and circumflex sets grown the same way.
//! Where the hand-drawn tilde corpus draws each letter, this one draws NOTHING but a single tilde wave and grows the
//! whole composable tilde vowel set by composition -- image/glyph_accent.rye's compose_accent_atlas overlays one wave
//! onto each mapped lowercase base, so a tilde and o tilde (U+00E3, U+00F5) arrive from a two-row table plus one
//! drawing rather than two. This is the FOURTH mark to prove the accent economy on metal, after the grave
//! (image/glyph_accent.rye), the acute (image/font5x7_acute.rye), and the circumflex (image/font5x7_circumflex_comp.rye).
//!
//! The crux stays byte-for-byte parity with the hand: each composed tilde vowel equals the hand-drawn
//! image/font5x7_tilde.rye's own coverage for that codepoint, so the corpus grown by composition IS the corpus drawn
//! by hand -- proven, not claimed. Only the two nasal VOWELS are composed here: the n tilde (U+00F1) rides a consonant
//! base and lives hand-drawn in image/font5x7_latin1.rye, outside a vowel-base table.
//!
//! The source stays plain ASCII (ASCII-first): codepoints are numeric literals (0x00E3 ...) and each letter is named
//! in an ASCII comment, so no non-ASCII byte enters the file though the glyphs cover a non-ASCII range. The tilde mark
//! is a WAVE that spans the whole top -- ink in both the left and right halves of the top two rows, cresting right of
//! center -- the fourth lean beside the acute's right lean, the grave's left, and the circumflex's centered peak; the
//! composed atlas round-trips through the gfa1 encoder/decoder byte-for-byte. No network, no key, no funds -- the marks
//! a surface reads the day it prints a Portuguese name that ASCII cannot spell, grown on our own open font.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_tilde_comp.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");
const compose = @import("glyph_compose.rye");
const accent = @import("glyph_accent.rye");
const font_lower = @import("font5x7_lower.rye");
const font_tilde = @import("font5x7_tilde.rye");

pub const font5x7_tilde_comp_version = "20260817.081500";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the ASCII, Greek, and Latin-1 corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const tilde_advance: u8 = cell_w + 1;

/// The corpus holds exactly the two composable tilde vowels named in the table below (the n tilde rides a consonant
/// base and lives hand-drawn in font5x7_latin1).
pub const tilde_count: u32 = 2;

/// Cells per glyph -- the coverage length every letter carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The column that separates the two halves of the cell. Columns 0-1 are the left half, columns 3-4 the right half;
/// column 2 (the center) belongs to neither. The tilde proof reads both halves and the crest right of center.
pub const center_col: u32 = 2;

/// The tilde combining mark, drawn ONCE -- the whole economy of this corpus. A WAVE spanning the cell (row 0 crests at
/// columns 2 and 4, row 1 dips to columns 1 and 3), the body rows blank; overlaid onto a lowercase vowel it yields the
/// tilde letter image/font5x7_tilde.rye draws by hand. It reaches BOTH halves of the top and crests right of center --
/// the fourth lean, neither the acute's right lean, the grave's left, nor the circumflex's centered peak.
const tilde_mark_art = [cell_h][]const u8{
    "..#.#",
    ".#.#.",
    ".....",
    ".....",
    ".....",
    ".....",
    ".....",
};

/// The composition table: two lowercase vowels, each mapped to its tilde codepoint, strictly ascending by the accented
/// codepoint (the order the gfa1 encoder trusts).
///   0x00E3 a tilde, 0x00F5 o tilde.
const tilde_map = [tilde_count]accent.AccentMap{
    .{ .base = 'a', .accented = 0x00E3 },
    .{ .base = 'o', .accented = 0x00F5 },
};

/// Lift the tilde mark's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad mark.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the tilde-accent vowels atlas by composition: overlay the one wave onto each mapped lowercase base, yielding
/// two accented glyphs at the named ascending codepoints. The gfa1 encoder accepts the result directly.
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the two named composable tilde vowels and no more.
    assert(tilde_count == 2);
    assert(cell_area == 35);
    const lower = try font_lower.build_atlas(allocator);
    const mark = try coverage_from_art(allocator, tilde_mark_art);
    // The tool from image/glyph_accent.rye does the growing -- a table plus one mark, not two drawings.
    const atlas = try accent.compose_accent_atlas(allocator, &lower, mark, tilde_map[0..], tilde_advance);
    // invariant: exactly one composed glyph per table row, at the shared cell.
    assert(atlas.glyphs.len == tilde_count);
    assert(atlas.cell_area() == cell_area);
    return atlas;
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

/// Count the inked cells in row r of a glyph, restricted to the half-open column band [c0, c1). The tilde proof reads
/// the top two rows' left half and right half with this one reader. Row 0 is the top.
fn row_band_ink(cov: []const u8, r: u32, c0: u32, c1: u32) u32 {
    // invariant: the row index sits inside the shared cell, over the shared grid.
    assert(r < cell_h);
    assert(cov.len == cell_area);
    // invariant: the column band is well-ordered and inside the cell width.
    assert(c0 <= c1);
    assert(c1 <= cell_w);
    var n: u32 = 0;
    var c: u32 = c0;
    while (c < c1) : (c += 1) {
        if (cov[r * cell_w + c] != 0) n += 1;
    }
    // invariant: the band count never exceeds the band it was counted over.
    assert(n <= c1 - c0);
    return n;
}

/// The tilde-mark ink in the LEFT half (columns 0-1) across the top two rows of a codepoint's glyph -- one half of the
/// wave-spans-both-sides proof. Rows 0 and 1 carry the mark; the body begins on row 2.
fn top_left_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| {
        return row_band_ink(g.coverage, 0, 0, center_col) + row_band_ink(g.coverage, 1, 0, center_col);
    }
    return error.TildeVowelMissing;
}

/// The tilde-mark ink in the RIGHT half (columns 3-4) across the top two rows of a codepoint's glyph -- the other half
/// of the wave-spans-both-sides proof.
fn top_right_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| {
        return row_band_ink(g.coverage, 0, center_col + 1, cell_w) + row_band_ink(g.coverage, 1, center_col + 1, cell_w);
    }
    return error.TildeVowelMissing;
}

/// The top-row (row 0) ink strictly RIGHT of center of a codepoint's glyph -- the crest that rises where a circumflex
/// apex would sit only on center. This is the reader that separates a tilde wave from a centered peak.
fn crest_right_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return row_band_ink(g.coverage, 0, center_col + 1, cell_w);
    return error.TildeVowelMissing;
}

// --- selftest: grow the tilde atlas by composition, prove parity with the hand, round-trip, distinct, legible, wave-spanning --

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the two-vowel corpus at the shared cell.
    assert(glyph_count == tilde_count);
    assert(atlas.cell_area() == cell_area);

    // The crux -- byte-for-byte parity with the hand-drawn corpus. Each composed tilde vowel equals the hand-drawn
    // font5x7_tilde corpus's own coverage for that codepoint, so the corpus grown by composition IS the corpus drawn
    // by hand -- proven on a fourth mark after the grave, the acute, and the circumflex.
    const hand = try font_tilde.build_atlas(garden);
    var matched: u32 = 0;
    var i: u32 = 0;
    while (i < atlas.glyphs.len) : (i += 1) {
        const g = atlas.glyphs[i];
        const want = hand.lookup(g.codepoint) orelse return error.TildeHandMissing;
        if (!std.mem.eql(u8, g.coverage, want.coverage)) return error.ComposedMismatch;
        if (g.advance != tilde_advance) return error.ComposedWrongAdvance;
        matched += 1;
    }
    // invariant: every composed vowel matched its hand-drawn twin.
    assert(matched == tilde_count);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Two present vowels: every mapped codepoint looks up and carries the shared advance; an unaccented ASCII vowel misses.
    var d: u32 = 0;
    while (d < tilde_count) : (d += 1) {
        const cp = tilde_map[d].accented;
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == tilde_advance);
        } else return error.TildeVowelMissing;
    }
    if (back.lookup('a')) |_| return error.NonTildeFound else {}

    // Distinctness: the a tilde and the o tilde carry different coverage (catches a copy slip that would leave both
    // names spelled with one glyph).
    var a: u32 = 0;
    while (a < tilde_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < tilde_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.TildeVowelsNotDistinct;
        }
    }

    // Legibility: each letter's ink count sits inside an honest band -- the floor where the o tilde (its lighter, a
    // round bowl under a wave) still reads, the ceiling where the a tilde (its heavier) still resolves as a letter.
    const ink_min: u32 = 12;
    const ink_max: u32 = 22;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < tilde_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.TildeVowelIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Tilde placement -- the fourth lean, proven on the composed letter: the mark is a WAVE spanning the whole top.
    // Three toothed guards read it -- ink in the LEFT half AND the RIGHT half of the top two rows (a wave reaches both
    // sides, where acute is right-only and grave left-only), and the top row itself crests RIGHT of center (where a
    // circumflex apex sits only on center). Each guard reds by name on a drifted or one-sided mark.
    var m: u32 = 0;
    while (m < tilde_count) : (m += 1) {
        const cp = tilde_map[m].accented;
        if (!(try top_left_ink_of(&atlas, cp) >= 1)) return error.TildeNotSpanningLeft;
        if (!(try top_right_ink_of(&atlas, cp) >= 1)) return error.TildeNotSpanningRight;
        if (!(try crest_right_of(&atlas, cp) >= 1)) return error.TildeNoRightCrest;
    }

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-tilde-comp: {d} tilde vowels U+00E3,U+00F5 grown by composition (one wave + a {d}-row table), each byte-for-byte the hand-drawn font5x7_tilde coverage; round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); every mark a wave spanning both halves and cresting right (the fourth lean beside acute/grave/circumflex); encoded {d} bytes, raw {d}\n", .{
        glyph_count, tilde_count, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_tilde_comp selftest\n", .{});
    return 1;
}
