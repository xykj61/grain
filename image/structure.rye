//! image/structure.rye -- an RGBA image reshaped by a GENERAL STRUCTURING ELEMENT: dilate (max) and erode (min) over an
//! ARBITRARY set of offsets, not only the square window (Season G, the general the square morphology is one shape of).
//!
//! Season G (Open Media Primitives) -- the generalization the whole morphology family descends from. image/morphology.rye
//! grows the two base verbs over a SQUARE `(2r+1)x(2r+1)` element, separable and fast. Yet a square is only the simplest
//! element: a mask cleanup often wants a CROSS (the 4-neighborhood, no corners), a LINE (a directional element that trims
//! a thin scratch along one axis), a DISK (a round element that leaves no square footprint), or the paired templates a
//! HIT-OR-MISS transform reads. Every one of those is the SAME two verbs -- a max or a min gathered over the element -- with
//! only the SHAPE of the element changed. So this rung generalizes the window from "a radius" to "a set of `(dx, dy)`
//! offsets," and the square element proves it: a square offset set reproduces `morphology.dilate`/`morphology.erode`
//! byte-for-byte, exactly as `convolve_n`'s widest kernel reproduces `convolve`. The general contains the special.
//!
//! One gather serves both verbs and every shape. For each pixel, dilate folds the MAX of the source at each offset (a
//! bright mark grows toward the element's reach), erode the MIN (a bright mark shrinks by it); a comptime `is_max` chooses
//! the rank, so one loop is both verbs. Both read the SAME offset set at `p + offset` -- the symmetric-element convention
//! the square morphology floor already uses, under which erode and dilate stay DUALS under complement (erode(x) equals the
//! complemented dilate of the complement) for any element symmetric through its center, the cross and the square among
//! them. Edges CLAMP exactly as the blur and the square morphology do: an offset that reaches past the border reads the
//! nearest border pixel, so a solid image stays solid at its edges and the element is never silently trimmed. Each channel
//! including alpha is gathered the same way; a rank of bytes is itself a byte, so no arithmetic can wrap and a result is
//! deterministic byte-for-byte.
//!
//! This rung owns the general gather and leans only on image/qoi.rye for the pixel grid; it adds no blend, no codec, no
//! color math. `dilate_se` and `erode_se` are the two general verbs; a `StructuringElement` is a bounded list of `Offset`.
//! The offset count is bounded by `structure_max_offsets` (a 256x256 element ceiling); a WIDE SQUARE element runs faster
//! through the separable `morphology` verbs, so the general path is for the arbitrary shapes those cannot express. An empty
//! source, an empty element, or an over-max element refuses BY NAME before any allocation -- all-or-nothing, never a
//! half-shaped image. No network, no key, no funds -- the cross, the line, the disk, and the hit-or-miss template a surface
//! reaches for the day a square is the wrong shape, on our own open geometry.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/structure.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const qoi = @import("qoi.rye");
const morphology = @import("morphology.rye");

pub const structure_version = "20260818.105641";

/// The most offsets a single structuring element may name. A 256x256 element is already 65536 cells, far past any hand
/// shape (a cross is 5, a disk of radius 8 about 200); a WIDE SQUARE element runs faster through the separable `morphology`
/// verbs, so this ceiling bounds the general gather without pretending it is the path for a large box.
pub const structure_max_offsets: u32 = 65536;

/// One cell of a structuring element: a signed offset from the pixel under the element's center. `dx`/`dy` are i32 so a
/// far element (up to the pixel-grid extent) is expressible; the gather clamps each axis onto a real pixel, so no offset
/// can read outside the buffer no matter how far it reaches.
pub const Offset = struct {
    dx: i32,
    dy: i32,
};

/// A general structuring element: a bounded list of offsets read at each pixel. The square window is the offset set
/// `{(dx, dy) : -r <= dx <= r, -r <= dy <= r}`; a cross, a line, and a disk are their own small sets.
pub const StructuringElement = struct {
    offsets: []const Offset,
};

pub const StructureError = error{
    EmptySource,
    EmptyElement,
    StructureElementTooLarge,
};

/// Clamp a signed axis position onto a real pixel index in `[0, extent-1]`. An offset that reaches past a border reads the
/// nearest border pixel, so the element is never silently trimmed and a solid edge never grows a phantom margin.
fn clamp_axis(pos: i64, extent: u32) u32 {
    // invariant: a real axis has at least one pixel to clamp onto.
    assert(extent >= 1);
    if (pos <= 0) return 0;
    const hi: i64 = @as(i64, extent) - 1;
    // invariant: the far clamp lands on the last real pixel, never past it.
    if (pos >= hi) return @intCast(hi);
    return @intCast(pos);
}

/// Gather `src` into `out` by a rank over the element: `out[y][x]` is the MAX (dilate) or MIN (erode) of the source at
/// `(x + off.dx, y + off.dy)` for every offset, each axis clamped to the border. Both buffers hold exactly `w*h` RGBA
/// pixels; the pass reads `src` and writes `out`, touching no other memory. `is_max` chooses the rank at compile time.
fn apply(out: []u8, src: []const u8, w: u32, h: u32, se: StructuringElement, comptime is_max: bool) void {
    // invariant: both buffers hold exactly w*h RGBA pixels, so every index below lands inside them.
    assert(out.len == @as(usize, w) * @as(usize, h) * 4);
    assert(src.len == out.len);
    // invariant: a morphology has real extent to sweep on both axes.
    assert(w >= 1);
    assert(h >= 1);
    // invariant: a real element has at least one offset to gather, so the accumulator is always a real pixel.
    assert(se.offsets.len >= 1);

    const seed: u8 = if (is_max) 0 else 255; // max folds up from the darkest byte, min folds down from the brightest

    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            var acc_r: u8 = seed;
            var acc_g: u8 = seed;
            var acc_b: u8 = seed;
            var acc_a: u8 = seed;
            for (se.offsets) |off| {
                const sx = clamp_axis(@as(i64, x) + @as(i64, off.dx), w);
                const sy = clamp_axis(@as(i64, y) + @as(i64, off.dy), h);
                const si = (@as(usize, sy) * @as(usize, w) + @as(usize, sx)) * 4;
                if (is_max) {
                    acc_r = @max(acc_r, src[si]);
                    acc_g = @max(acc_g, src[si + 1]);
                    acc_b = @max(acc_b, src[si + 2]);
                    acc_a = @max(acc_a, src[si + 3]);
                } else {
                    acc_r = @min(acc_r, src[si]);
                    acc_g = @min(acc_g, src[si + 1]);
                    acc_b = @min(acc_b, src[si + 2]);
                    acc_a = @min(acc_a, src[si + 3]);
                }
            }
            // invariant: a rank of bytes is itself a byte -- the accumulators never leave 0..255 (u8 by type).
            assert(@as(u32, acc_r) <= 255);
            assert(@as(u32, acc_a) <= 255);
            const di = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            out[di] = acc_r;
            out[di + 1] = acc_g;
            out[di + 2] = acc_b;
            out[di + 3] = acc_a;
        }
    }
}

/// Guard a source and element shared by both public verbs: a zero-extent source refuses `EmptySource`, an empty element
/// `EmptyElement`, an over-max element `StructureElementTooLarge`, all BY NAME before any allocation. Returns the
/// pixel-buffer length so the caller allocates once.
fn guard(src: *const qoi.Pixmap, se: StructuringElement) StructureError!usize {
    // invariant: a real source has extent on both axes; a zero-size source has nothing to reshape.
    if (src.width == 0 or src.height == 0) return error.EmptySource;
    // invariant: a real element names at least one cell to gather.
    if (se.offsets.len == 0) return error.EmptyElement;
    // invariant: the element stays within the module's named ceiling so the per-pixel gather stays bounded.
    if (se.offsets.len > @as(usize, structure_max_offsets)) return error.StructureElementTooLarge;
    return @as(usize, src.width) * @as(usize, src.height) * 4;
}

/// Dilate `src` into a fresh same-size RGBA Pixmap by the MAX over the general element. Returns a newly allocated Pixmap
/// the caller owns; `src` is read-only and untouched.
pub fn dilate_se(allocator: std.mem.Allocator, src: *const qoi.Pixmap, se: StructuringElement) !qoi.Pixmap {
    const n = try guard(src, se);
    // invariant: the guard proved real extent, so the buffer length is a real positive pixel count.
    assert(n >= 4);
    const out = try allocator.alloc(u8, n);
    apply(out, src.pixels, src.width, src.height, se, true);
    return qoi.Pixmap{ .width = src.width, .height = src.height, .channels = 4, .colorspace = 0, .pixels = out };
}

/// Erode `src` into a fresh same-size RGBA Pixmap by the MIN over the general element -- the min twin of `dilate_se`, read
/// over the same offset set. Returns a newly allocated Pixmap the caller owns; `src` is read-only and untouched.
pub fn erode_se(allocator: std.mem.Allocator, src: *const qoi.Pixmap, se: StructuringElement) !qoi.Pixmap {
    const n = try guard(src, se);
    // invariant: the guard proved real extent, so the buffer length is a real positive pixel count.
    assert(n >= 4);
    const out = try allocator.alloc(u8, n);
    apply(out, src.pixels, src.width, src.height, se, false);
    return qoi.Pixmap{ .width = src.width, .height = src.height, .channels = 4, .colorspace = 0, .pixels = out };
}

// --- selftest: general-contains-square, cross shape, directional line, duality, identity, alpha, round-trip, refusals ----

/// Mint a one-color RGBA canvas for the selftest -- a local, bounded builder so this rung leans on no higher module.
fn make_canvas(garden: std.mem.Allocator, w: u32, h: u32, fill: color.Rgba) !qoi.Pixmap {
    // invariant: a canvas has real extent within the image module's named pixel ceiling.
    assert(w >= 1);
    assert(h >= 1);
    const total: u64 = @as(u64, w) * @as(u64, h);
    assert(total <= qoi.qoi_max_pixels);
    const pixels = try garden.alloc(u8, @as(usize, @intCast(total)) * 4);
    var i: usize = 0;
    while (i < pixels.len) : (i += 4) {
        pixels[i] = fill.r;
        pixels[i + 1] = fill.g;
        pixels[i + 2] = fill.b;
        pixels[i + 3] = fill.a;
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = pixels };
}

/// Read one pixel's RGBA at (x, y) -- a small reader the checks below share.
fn pixel_at(img: *const qoi.Pixmap, x: u32, y: u32) color.Rgba {
    // invariant: the read stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    return color.Rgba{ .r = img.pixels[di], .g = img.pixels[di + 1], .b = img.pixels[di + 2], .a = img.pixels[di + 3] };
}

/// Set one pixel's RGBA at (x, y) -- a small writer the pattern builders share.
fn set_pixel(img: *qoi.Pixmap, x: u32, y: u32, c: color.Rgba) void {
    // invariant: the write stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    img.pixels[di] = c.r;
    img.pixels[di + 1] = c.g;
    img.pixels[di + 2] = c.b;
    img.pixels[di + 3] = c.a;
}

/// Complement every channel of `img` in place (255 - value), the reflection the duality law reads through.
fn complement(img: *qoi.Pixmap) void {
    // invariant: the buffer is a whole RGBA grid, so every byte is a channel to reflect.
    assert(img.pixels.len == @as(usize, img.width) * @as(usize, img.height) * 4);
    var i: usize = 0;
    while (i < img.pixels.len) : (i += 1) {
        img.pixels[i] = 255 - img.pixels[i];
    }
}

/// Build a SQUARE offset set of radius `radius` -- the element that must reproduce the separable `morphology` verbs
/// byte-for-byte (the general-contains-special crux). The offsets sweep row by row; order does not matter to a max or min.
fn square_se(garden: std.mem.Allocator, radius: u32) ![]Offset {
    // invariant: the selftest builds only small squares, far within the offset ceiling.
    const side: u32 = 2 * radius + 1;
    const count: usize = @as(usize, side) * @as(usize, side);
    assert(count <= @as(usize, structure_max_offsets));
    const offs = try garden.alloc(Offset, count);
    const r: i32 = @intCast(radius);
    var idx: usize = 0;
    var dy: i32 = -r;
    while (dy <= r) : (dy += 1) {
        var dx: i32 = -r;
        while (dx <= r) : (dx += 1) {
            offs[idx] = Offset{ .dx = dx, .dy = dy };
            idx += 1;
        }
    }
    // invariant: the sweep filled exactly the (2r+1)^2 cells it named.
    assert(idx == count);
    return offs;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const black = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
    const white = color.Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };
    const red = color.Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 };
    const green = color.Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 };
    const blue = color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 };

    // A 2x2 four-color pattern -- the same corners the blur and morphology siblings prove against.
    var pattern = try make_canvas(garden, 2, 2, red);
    set_pixel(&pattern, 1, 0, green);
    set_pixel(&pattern, 0, 1, blue);
    set_pixel(&pattern, 1, 1, white);

    // --- the GENERAL-CONTAINS-SPECIAL crux: a SQUARE offset set reproduces the separable morphology verbs byte-for-byte,
    //     on a colored translucent field so the parity is not a black-and-white accident -----------------------------------
    var field = try make_canvas(garden, 6, 5, color.Rgba{ .r = 40, .g = 90, .b = 200, .a = 128 });
    set_pixel(&field, 1, 1, color.Rgba{ .r = 255, .g = 30, .b = 10, .a = 255 });
    set_pixel(&field, 4, 3, color.Rgba{ .r = 10, .g = 240, .b = 60, .a = 30 });
    set_pixel(&field, 5, 0, white);
    const sq2 = StructuringElement{ .offsets = try square_se(garden, 2) };
    const gen_d = try dilate_se(garden, &field, sq2);
    const morph_d = try morphology.dilate(garden, &field, 2);
    if (!gen_d.same_bytes(&morph_d)) return error.GeneralSquareNotEqualMorphologyDilate;
    const gen_e = try erode_se(garden, &field, sq2);
    const morph_e = try morphology.erode(garden, &field, 2);
    if (!gen_e.same_bytes(&morph_e)) return error.GeneralSquareNotEqualMorphologyErode;
    // and radius 1 too, so the parity is not a one-radius accident
    const sq1 = StructuringElement{ .offsets = try square_se(garden, 1) };
    const gen_d1 = try dilate_se(garden, &field, sq1);
    const morph_d1 = try morphology.dilate(garden, &field, 1);
    if (!gen_d1.same_bytes(&morph_d1)) return error.GeneralSquareR1NotEqualMorphology;

    // --- the SHAPE matters: a CROSS element (center + 4-neighbors, no corners) grows a dot into a PLUS, leaving the
    //     diagonal corners black where a square would light them -- the whole point of a general element ------------------
    const cross_offsets = try garden.alloc(Offset, 5);
    cross_offsets[0] = Offset{ .dx = 0, .dy = 0 };
    cross_offsets[1] = Offset{ .dx = 1, .dy = 0 };
    cross_offsets[2] = Offset{ .dx = -1, .dy = 0 };
    cross_offsets[3] = Offset{ .dx = 0, .dy = 1 };
    cross_offsets[4] = Offset{ .dx = 0, .dy = -1 };
    const cross = StructuringElement{ .offsets = cross_offsets };
    var dot = try make_canvas(garden, 5, 5, black);
    set_pixel(&dot, 2, 2, white);
    const plus = try dilate_se(garden, &dot, cross);
    // the four edge-neighbors of the center light white
    if (!pixel_at(&plus, 1, 2).eql(white)) return error.CrossDidNotGrowLeft;
    if (!pixel_at(&plus, 3, 2).eql(white)) return error.CrossDidNotGrowRight;
    if (!pixel_at(&plus, 2, 1).eql(white)) return error.CrossDidNotGrowUp;
    if (!pixel_at(&plus, 2, 3).eql(white)) return error.CrossDidNotGrowDown;
    // yet the four DIAGONAL corners stay black -- a square element would have filled them
    if (!pixel_at(&plus, 1, 1).eql(black)) return error.CrossLitADiagonal;
    if (!pixel_at(&plus, 3, 3).eql(black)) return error.CrossLitADiagonal;

    // --- a DIRECTIONAL LINE element (three cells across one axis) widens a vertical line HORIZONTALLY yet leaves it whole
    //     down its columns -- the directional sibling, now one offset set rather than a separate verb ---------------------
    const hline_offsets = try garden.alloc(Offset, 3);
    hline_offsets[0] = Offset{ .dx = -1, .dy = 0 };
    hline_offsets[1] = Offset{ .dx = 0, .dy = 0 };
    hline_offsets[2] = Offset{ .dx = 1, .dy = 0 };
    const hline = StructuringElement{ .offsets = hline_offsets };
    var vline = try make_canvas(garden, 5, 3, black);
    var ly: u32 = 0;
    while (ly < 3) : (ly += 1) set_pixel(&vline, 2, ly, white);
    const widened = try dilate_se(garden, &vline, hline);
    // the line at column 2 spreads to columns 1 and 3; columns 0 and 4 stay black; every row of the line stays lit
    if (!pixel_at(&widened, 1, 1).eql(white)) return error.LineDidNotWiden;
    if (!pixel_at(&widened, 3, 1).eql(white)) return error.LineDidNotWiden;
    if (!pixel_at(&widened, 0, 1).eql(black)) return error.LineReachedTooFar;
    if (!pixel_at(&widened, 2, 0).eql(white)) return error.LineLostAColumn;

    // --- the DUALITY law holds for the symmetric CROSS: erode_se(x) equals 255 - dilate_se(255 - x) byte-for-byte -------
    const ero = try erode_se(garden, &pattern, cross);
    var comp = try make_canvas(garden, 2, 2, black);
    var ci: usize = 0;
    while (ci < comp.pixels.len) : (ci += 1) comp.pixels[ci] = pattern.pixels[ci];
    complement(&comp);
    var dil_comp = try dilate_se(garden, &comp, cross);
    complement(&dil_comp);
    if (!ero.same_bytes(&dil_comp)) return error.CrossDualityBroken;

    // --- a SINGLE-OFFSET element {(0,0)} is the IDENTITY for both verbs byte-for-byte (a 1-cell element copies the source)
    const one_offset = try garden.alloc(Offset, 1);
    one_offset[0] = Offset{ .dx = 0, .dy = 0 };
    const one = StructuringElement{ .offsets = one_offset };
    const dsame = try dilate_se(garden, &pattern, one);
    if (!dsame.same_bytes(&pattern)) return error.SingleOffsetDilateNotIdentity;
    const esame = try erode_se(garden, &pattern, one);
    if (!esame.same_bytes(&pattern)) return error.SingleOffsetErodeNotIdentity;

    // --- ALPHA morphs like any channel: a 2px row [a=255, a=0] under a horizontal line dilates its alpha to the max,
    //     erodes to the min -------------------------------------------------------------------------------------------
    const opaque_blue = color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 };
    const clear_blue = color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 0 };
    var arow = try make_canvas(garden, 2, 1, opaque_blue);
    set_pixel(&arow, 1, 0, clear_blue);
    const adil = try dilate_se(garden, &arow, hline);
    if (pixel_at(&adil, 0, 0).a != 255 or pixel_at(&adil, 1, 0).a != 255) return error.AlphaDilateWrong;
    const aero = try erode_se(garden, &arow, hline);
    if (pixel_at(&aero, 0, 0).a != 0 or pixel_at(&aero, 1, 0).a != 0) return error.AlphaErodeWrong;

    // --- a reshaped image round-trips through the open QOI codec byte-for-byte -- a real image, not a private buffer ------
    var checker = try make_canvas(garden, 4, 4, black);
    var ky: u32 = 0;
    while (ky < 4) : (ky += 1) {
        var kx: u32 = 0;
        while (kx < 4) : (kx += 1) {
            if ((kx + ky) % 2 == 0) set_pixel(&checker, kx, ky, white);
        }
    }
    const shown = try dilate_se(garden, &checker, cross);
    const cap = qoi.encoded_bound(shown.pixel_count());
    const dst = try garden.alloc(u8, cap);
    const enc = try qoi.encode(&shown, dst);
    const backimg = try qoi.decode(garden, dst[0..enc.len]);
    if (!backimg.same_bytes(&shown)) return error.StructureDidNotRoundTrip;

    // --- refusals by name, each having allocated nothing --------------------------------------------------------------
    const empty_element = StructuringElement{ .offsets = &[_]Offset{} };
    if (dilate_se(garden, &pattern, empty_element)) |_| return error.EmptyElementNotRefused else |err| {
        if (err != error.EmptyElement) return error.WrongEmptyElementError;
    }
    const too_many = try garden.alloc(Offset, @as(usize, structure_max_offsets) + 1);
    var ti: usize = 0;
    while (ti < too_many.len) : (ti += 1) too_many[ti] = Offset{ .dx = 0, .dy = 0 };
    const oversize = StructuringElement{ .offsets = too_many };
    if (dilate_se(garden, &pattern, oversize)) |_| return error.OversizeNotRefused else |err| {
        if (err != error.StructureElementTooLarge) return error.WrongOversizeError;
    }
    var empty_src = qoi.Pixmap{ .width = 0, .height = 0, .channels = 4, .colorspace = 0, .pixels = &[_]u8{} };
    if (erode_se(garden, &empty_src, cross)) |_| return error.EmptySourceNotRefused else |err| {
        if (err != error.EmptySource) return error.WrongEmptyError;
    }

    // --- determinism: the same dilate reaches the same pixels byte-for-byte --------------------------------------------
    const da = try dilate_se(garden, &checker, cross);
    const db = try dilate_se(garden, &checker, cross);
    if (!da.same_bytes(&db)) return error.DilateNotDeterministic;

    print("GREEN image-structure: an RGBA image reshaped by dilate (max) and erode (min) over a GENERAL structuring element (an arbitrary offset set, not only a square) -- a square offset set reproduces the separable morphology dilate and erode byte-for-byte at radius 1 and 2 on a colored translucent field (the general contains the special); a CROSS element grows a dot into a plus and leaves the diagonal corners black where a square would light them (the shape matters); a directional horizontal-line element widens a vertical line horizontally yet leaves every column whole; the DUALITY law holds for the symmetric cross, erode(x) equals 255 minus dilate of the complement byte-for-byte; a single-offset element is the identity for both verbs; alpha morphs like any channel; the result round-trips through the open QOI codec byte-for-byte; an empty element, an over-max element, and an empty source refuse by name having allocated nothing; the same dilate is deterministic byte-for-byte\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: structure selftest\n", .{});
    return 1;
}
