//! image/font5x7_geometric.rye -- the open geometric-shapes corpus: the marks a list points and selects with
//! (Season G, font content).
//!
//! Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the
//! five ASCII corpora (image/font5x7.rye the numerals, image/font5x7_alpha.rye the uppercase, image/font5x7_lower.rye
//! the lowercase, image/font5x7_punct.rye the punctuation, image/font5x7_symbol.rye the symbols) and the wider-symbol
//! corpora that opened next -- the box family (image/font5x7_box.rye light, image/font5x7_boxdouble.rye double,
//! image/font5x7_boxdiag.rye diagonal), the arrows (image/font5x7_arrow.rye), and the block elements
//! (image/font5x7_block.rye). Where the box corpora FRAME and rule and the arrows POINT, this corpus supplies the ten
//! geometric shapes a terminal surface marks and selects WITH: the bullet, the filled and hollow square, the four
//! filled triangles (up, right, down, left), the diamond, and the hollow and filled circle -- at their real Unicode
//! codepoints U+2022 and U+25A0..U+25CF, drawn in our own open hand on the same 5x7 body. These are exactly the marks
//! Scooter and Dexter reach for as a list bullet, an unread badge, a radio dot, a selection caret, or a menu marker.
//!
//! The source stays plain ASCII (ASCII-first): the codepoints are written as numeric literals (0x2022 ...) and each
//! mark is named in an ASCII comment, so no non-ASCII byte enters the file even though the glyphs it builds cover a
//! non-ASCII range. The codepoints are NOT contiguous (the bullet sits far below the geometric block, and the block
//! itself skips the marks this set leaves out), so this corpus carries an explicit ascending codepoint table -- the
//! shape the gfa1 encoder trusts (strictly ascending, shared cell, coverage length == cell area). The drawings ARE
//! the specification: each mark is seven rows of five cells in ASCII line art ('#' full ink, '.' none) that a reader
//! audits by eye; the coverage bytes are derived from that art, never the reverse. build_atlas turns the ten drawings
//! into a glyph.GlyphAtlas the gfa1 encoder accepts, so the property that matters stays provable on metal:
//! decode(encode(atlas)) recovers every glyph byte-for-byte, the marks are present and distinct, each reads within an
//! honest legibility band, and the filled/hollow twins and the small/large disc pair keep their honest ink order. No
//! network, no key, no funds -- the marks a surface reads the day it wants to bullet a list, on our own open font.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_geometric.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

pub const font5x7_geometric_version = "20260817.044738";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the ASCII and wider-symbol corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const geometric_advance: u8 = cell_w + 1;

/// The corpus holds exactly the ten geometric marks named in the table below.
pub const geometric_count: u32 = 10;

/// Cells per glyph -- the coverage length every mark carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The ten geometric codepoints, strictly ascending -- the order the gfa1 encoder trusts. Each aligns by index with
/// geometric_art below. Written as numeric literals so the source stays plain ASCII while the glyphs cover a non-ASCII
/// range:
///   0x2022 bullet, 0x25A0 black (filled) square, 0x25A1 white (hollow) square, 0x25B2 black up-pointing triangle,
///   0x25B6 black right-pointing triangle, 0x25BC black down-pointing triangle, 0x25C0 black left-pointing triangle,
///   0x25C6 black diamond, 0x25CB white (hollow) circle, 0x25CF black (filled) circle. The bullet sits far below the
///   geometric block, so the codepoints are named outright rather than derived from a base.
const geometric_codepoints = [geometric_count]u32{
    0x2022, 0x25A0, 0x25A1, 0x25B2, 0x25B6, 0x25BC, 0x25C0, 0x25C6, 0x25CB, 0x25CF,
};

/// The ten marks, drawn in the open. Each is seven rows of five cells; '#' ink, '.' background. A reader audits every
/// mark here by eye, and the coverage bytes are lifted from this art, never guessed. The filled shapes fill their body
/// solid; the hollow shapes ring it; the four triangles point their apex; the two discs differ in size (bullet small,
/// black circle large) so a list can mark a leaf and a node distinctly.
const geometric_art = [geometric_count][cell_h][]const u8{
    .{ ".....", "..#..", ".###.", ".###.", ".###.", "..#..", "....." }, // U+2022 bullet
    .{ ".....", ".###.", ".###.", ".###.", ".###.", ".###.", "....." }, // U+25A0 black square
    .{ ".....", ".###.", ".#.#.", ".#.#.", ".#.#.", ".###.", "....." }, // U+25A1 white square
    .{ ".....", "..#..", ".###.", ".###.", "#####", "#####", "....." }, // U+25B2 up triangle
    .{ "#....", "##...", "###..", "####.", "###..", "##...", "#...." }, // U+25B6 right triangle
    .{ ".....", "#####", "#####", ".###.", ".###.", "..#..", "....." }, // U+25BC down triangle
    .{ "....#", "...##", "..###", ".####", "..###", "...##", "....#" }, // U+25C0 left triangle
    .{ ".....", "..#..", ".###.", "#####", ".###.", "..#..", "....." }, // U+25C6 diamond
    .{ ".....", ".###.", "#...#", "#...#", "#...#", ".###.", "....." }, // U+25CB white circle
    .{ ".....", ".###.", "#####", "#####", "#####", ".###.", "....." }, // U+25CF black circle
};

/// Lift one mark's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad glyph.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the geometric-shapes atlas: ten glyphs at the named ascending codepoints, sharing the 5x7 cell and advance.
/// The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the ten named geometric marks and no more.
    assert(geometric_count == 10);
    assert(cell_area == 35);
    const glyphs = try allocator.alloc(glyph.Glyph, geometric_count);
    var i: u32 = 0;
    var last_cp: u32 = 0;
    while (i < geometric_count) : (i += 1) {
        const cp = geometric_codepoints[i];
        // invariant: codepoints are strictly ascending -- the ordering the gfa1 encoder trusts.
        assert(i == 0 or cp > last_cp);
        last_cp = cp;
        const cov = try coverage_from_art(allocator, geometric_art[i]);
        glyphs[i] = glyph.Glyph{
            .codepoint = cp,
            .advance = geometric_advance,
            .coverage = cov,
        };
    }
    // invariant: the last codepoint is the black circle (U+25CF) -- the table ends where this set ends.
    assert(glyphs[geometric_count - 1].codepoint == 0x25CF);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

/// The ink count of a codepoint's glyph in the built atlas -- the reader the family-order proofs use.
fn ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return ink_count(g.coverage);
    return error.GeometricMarkMissing;
}

// --- selftest: build the geometric atlas, round-trip it through gfa1, prove all present, distinct, legible ---------

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the ten-mark corpus at the shared cell.
    assert(glyph_count == geometric_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Ten present marks: every one looks up, carries the shared advance; an ASCII letter misses.
    var d: u32 = 0;
    while (d < geometric_count) : (d += 1) {
        const cp = geometric_codepoints[d];
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == geometric_advance);
        } else return error.GeometricMarkMissing;
    }
    if (back.lookup('A')) |_| return error.NonGeometricFound else {}

    // Distinctness: no two marks share identical coverage -- a real shape set's glyphs differ (catches a copy slip).
    var a: u32 = 0;
    while (a < geometric_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < geometric_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.GeometricMarksNotDistinct;
        }
    }

    // Legibility: each mark's ink count sits inside an honest band. The geometric shapes are denser than the sparse box
    // rules -- the floor sits where the small bullet still reads, the ceiling where the filled disc still resolves as a
    // shape rather than filling the whole body.
    const ink_min: u32 = 8;
    const ink_max: u32 = 24;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < geometric_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.GeometricMarkIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Family order: the filled twin out-inks its hollow twin, and the small bullet under-inks the large disc -- what
    // makes the pairs a true family rather than ten unrelated drawings, and what lets a list mark a leaf and a node
    // (or a read and an unread item) distinctly.
    if (!(try ink_of(&atlas, 0x25A0) > try ink_of(&atlas, 0x25A1))) return error.SquareOrderWrong; // black > white square
    if (!(try ink_of(&atlas, 0x25CF) > try ink_of(&atlas, 0x25CB))) return error.CircleOrderWrong; // black > white circle
    if (!(try ink_of(&atlas, 0x2022) < try ink_of(&atlas, 0x25CF))) return error.DiscOrderWrong; // bullet < filled disc

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-geometric: {d} geometric marks U+2022,U+25A0..U+25CF at {d}x{d} round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); filled>hollow and bullet<disc hold; encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_geometric selftest\n", .{});
    return 1;
}
