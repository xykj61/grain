//! image/font5x7_upper_accented.rye -- the open uppercase accented-letters corpus: the capitals a Romance name reaches for (Season G, font content).
//!
//! Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the
//! five ASCII corpora (image/font5x7.rye the numerals, image/font5x7_alpha.rye the uppercase A-Z, image/font5x7_lower.rye
//! the lowercase, image/font5x7_punct.rye the punctuation, image/font5x7_symbol.rye the symbols), the wider-symbol
//! corpora (the box family, the arrows, the block elements, the geometric marks, the math/technical operators, the
//! currency signs), the Greek letters (image/font5x7_greek.rye), the sub/superscript and fraction corpora, and the
//! accented LOWERCASE family (image/font5x7_latin1.rye and its grave/circumflex/german siblings, unified in
//! image/font5x7_accented.rye). Where the lowercase accented corpus spells a keeper's name mid-word, this corpus
//! supplies the eight uppercase accented letters the same name reaches for at the START of a sentence or set in
//! ALL-CAPS -- A acute, C cedilla, E acute, I acute, N tilde, O acute, U acute, U diaeresis, at their real Unicode
//! codepoints U+00C1, U+00C7, U+00C9, U+00CD, U+00D1, U+00D3, U+00DA, U+00DC, exactly 0x20 below their lowercase
//! twins, drawn in our own open hand on the same 5x7 body. These are the capitals that let a civic surface print
//! ALVARO as ALVARO with its mark, GARCIA as GARCIA, NONO as NONO -- rather than an ASCII-folded approximation.
//!
//! The source stays plain ASCII (ASCII-first): the codepoints are written as numeric literals (0x00C1 ...) and each
//! letter is named in an ASCII comment, so no non-ASCII byte enters the file even though the glyphs it builds cover a
//! non-ASCII range. The codepoints are NOT contiguous (they skip the unaccented capitals between them in the Latin-1
//! Supplement block), so this corpus carries an explicit ascending codepoint table -- the shape the gfa1 encoder
//! trusts (strictly ascending, shared cell, coverage length == cell area). The drawings ARE the specification: each
//! letter is seven rows of five cells in ASCII line art ('#' full ink, '.' none) that a reader audits by eye; the
//! coverage bytes are derived from that art, never the reverse. THE CRUX THAT SETS UPPERCASE APART from the lowercase
//! twin: a capital fills the whole 5x7 body, leaving no daylight above it for a mark, so each capital is compressed
//! into the bottom FIVE rows (rows 2..6) and its diacritic drawn on the top two rows (rows 0..1) -- the standard
//! bitmap-font accommodation, here proven honest. Seven letters carry their diacritic ABOVE (an acute stroke, a tilde
//! wave, or two diaeresis dots on the top row); the C cedilla alone is marked from BENEATH, its top row empty and a
//! small tail hung under the bowl -- the family order this corpus proves, mirroring the lowercase set. build_atlas
//! turns the eight drawings into a glyph.GlyphAtlas the gfa1 encoder accepts, so the property that matters stays
//! provable on metal: decode(encode(atlas)) recovers every glyph byte-for-byte, the letters are present and distinct,
//! each reads within an honest legibility band, and each diacritic sits where the letter demands it. No network, no
//! key, no funds -- the capitals a surface reads the day it prints a name that ASCII cannot spell, on our own open font.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_upper_accented.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

pub const font5x7_upper_accented_version = "20260817.061655";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the ASCII, Greek, and accented corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const upper_advance: u8 = cell_w + 1;

/// The corpus holds exactly the eight uppercase accented letters named in the table below.
pub const upper_count: u32 = 8;

/// Cells per glyph -- the coverage length every letter carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The eight uppercase Latin-1 codepoints, strictly ascending -- the order the gfa1 encoder trusts. Each aligns by
/// index with upper_art below. Written as numeric literals so the source stays plain ASCII while the glyphs cover a
/// non-ASCII range:
///   0x00C1 A acute, 0x00C7 C cedilla, 0x00C9 E acute, 0x00CD I acute,
///   0x00D1 N tilde, 0x00D3 O acute, 0x00DA U acute, 0x00DC U diaeresis. Each is exactly 0x20 below its lowercase
///   twin in font5x7_latin1.rye; the unaccented capitals between them in the Latin-1 Supplement block are skipped.
const upper_codepoints = [upper_count]u32{
    0x00C1, 0x00C7, 0x00C9, 0x00CD, 0x00D1, 0x00D3, 0x00DA, 0x00DC,
};

/// The eight capitals, drawn in the open. Each is seven rows of five cells; '#' ink, '.' background. A reader audits
/// every letter here by eye, and the coverage bytes are lifted from this art, never guessed. Because a capital fills
/// the whole body, each letter is compressed into rows 2..6 and its mark drawn on rows 0..1: an acute stroke rising to
/// the right (A, E, I, O, U), a tilde wave (N), two diaeresis dots (U). The C cedilla alone leaves the top row empty
/// and hangs a small tail beneath the bowl on the bottom row, the one letter this corpus marks from below.
const upper_art = [upper_count][cell_h][]const u8{
    .{ "...#.", "..#..", ".###.", "#...#", "#####", "#...#", "#...#" }, // U+00C1 A acute
    .{ ".....", ".###.", "#....", "#....", "#....", ".###.", "..#.." }, // U+00C7 C cedilla
    .{ "...#.", "..#..", "#####", "#....", "###..", "#....", "#####" }, // U+00C9 E acute
    .{ "...#.", "..#..", ".###.", "..#..", "..#..", "..#..", ".###." }, // U+00CD I acute
    .{ "..#.#", ".#.#.", "#...#", "##..#", "#.#.#", "#..##", "#...#" }, // U+00D1 N tilde
    .{ "...#.", "..#..", ".###.", "#...#", "#...#", "#...#", ".###." }, // U+00D3 O acute
    .{ "...#.", "..#..", "#...#", "#...#", "#...#", "#...#", ".###." }, // U+00DA U acute
    .{ ".#.#.", ".....", "#...#", "#...#", "#...#", "#...#", ".###." }, // U+00DC U diaeresis
};

/// Lift one letter's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad glyph.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the uppercase accented-letters atlas: eight glyphs at the named ascending codepoints, sharing the 5x7 cell and
/// advance. The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the eight named uppercase letters and no more.
    assert(upper_count == 8);
    assert(cell_area == 35);
    const glyphs = try allocator.alloc(glyph.Glyph, upper_count);
    var i: u32 = 0;
    var last_cp: u32 = 0;
    while (i < upper_count) : (i += 1) {
        const cp = upper_codepoints[i];
        // invariant: codepoints are strictly ascending -- the ordering the gfa1 encoder trusts.
        assert(i == 0 or cp > last_cp);
        last_cp = cp;
        const cov = try coverage_from_art(allocator, upper_art[i]);
        glyphs[i] = glyph.Glyph{
            .codepoint = cp,
            .advance = upper_advance,
            .coverage = cov,
        };
    }
    // invariant: the last codepoint is the U diaeresis (U+00DC) -- the table ends where this set ends.
    assert(glyphs[upper_count - 1].codepoint == 0x00DC);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

/// Count the inked cells in one row r of a glyph -- the reader the diacritic-placement proof uses. Row 0 is the top.
fn row_ink(cov: []const u8, r: u32) u32 {
    // invariant: the row index sits inside the shared cell, over the shared grid.
    assert(r < cell_h);
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var c: u32 = 0;
    while (c < cell_w) : (c += 1) {
        if (cov[r * cell_w + c] != 0) n += 1;
    }
    // invariant: a single row can hold at most cell_w inked cells.
    assert(n <= cell_w);
    return n;
}

/// The top-row (row 0) ink of a codepoint's glyph in the built atlas -- the reader the placement proof uses.
fn top_row_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return row_ink(g.coverage, 0);
    return error.UpperLetterMissing;
}

/// The bottom-row (row cell_h-1) ink of a codepoint's glyph -- the reader the cedilla proof uses.
fn bottom_row_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return row_ink(g.coverage, cell_h - 1);
    return error.UpperLetterMissing;
}

// --- selftest: build the uppercase atlas, round-trip it through gfa1, prove all present, distinct, legible, placed ---

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the eight-letter corpus at the shared cell.
    assert(glyph_count == upper_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Eight present letters: every one looks up, carries the shared advance; an unaccented ASCII capital misses.
    var d: u32 = 0;
    while (d < upper_count) : (d += 1) {
        const cp = upper_codepoints[d];
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == upper_advance);
        } else return error.UpperLetterMissing;
    }
    if (back.lookup('A')) |_| return error.NonUpperFound else {}

    // Distinctness: no two letters share identical coverage -- the acute A and the acute E differ, the acute U and the
    // diaeresis U differ (catches a copy slip that would leave two names spelled with one glyph).
    var a: u32 = 0;
    while (a < upper_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < upper_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.UpperLettersNotDistinct;
        }
    }

    // Legibility: each letter's ink count sits inside an honest band. The floor sits where the C cedilla (its lightest,
    // a compressed bowl with a tail) still reads, the ceiling where the E acute and N tilde (its heaviest) still resolve
    // as letters, not blocks.
    const ink_min: u32 = 8;
    const ink_max: u32 = 20;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < upper_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.UpperLetterIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Diacritic placement -- what makes each of these an accented capital rather than a plain one, and what a reader
    // audits: the seven above-marked letters (A, E, I, N, O, U acute and U diaeresis) each carry ink on their top row,
    // while the C cedilla alone leaves its top row empty and hangs its mark on the bottom row. This proves the mark
    // sits above the compressed body rather than drifting into it -- the uppercase crux, since the capital fills the
    // whole cell but for the two rows this proof reserves for the mark.
    const above_marked = [_]u32{ 0x00C1, 0x00C9, 0x00CD, 0x00D1, 0x00D3, 0x00DA, 0x00DC };
    var m: u32 = 0;
    while (m < above_marked.len) : (m += 1) {
        if (!(try top_row_ink_of(&atlas, above_marked[m]) >= 1)) return error.DiacriticNotAbove;
    }
    if (!(try top_row_ink_of(&atlas, 0x00C7) == 0)) return error.CedillaNotEmptyAbove; // C cedilla top row empty
    if (!(try bottom_row_ink_of(&atlas, 0x00C7) >= 1)) return error.CedillaNotBelow; // C cedilla marked beneath

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-upper-accented: {d} uppercase letters U+00C1,U+00C7,U+00C9,U+00CD,U+00D1,U+00D3,U+00DA,U+00DC at {d}x{d} round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); seven marked above, the C cedilla below; encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_upper_accented selftest\n", .{});
    return 1;
}
