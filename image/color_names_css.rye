//! image/color_names_css.rye -- the full CSS named-color table over the open color algebra (Season G, the whole
//! keyword set a stylesheet speaks).
//!
//! Season G (Open Media Primitives) -- a single-stranded sibling of image/color_names.rye. Where that module holds
//! the sixteen HTML4 / CSS Level 1 keywords, the oldest and smallest durable named set, this holds the WHOLE modern
//! set: the 148 CSS Color named colors, aliceblue through yellowgreen, each bound to its canonical hex. The two stand
//! side by side, each its own green binary -- the HTML4 module stays the block-complete sixteen it always was
//! (accrete, never break), and this one offers the richer table that color_nearest and color_name_group can read to
//! name any color more finely. The extended set the earlier color logs kept naming as "a fetch-verified round" lands
//! here, verified two ways rather than transcribed once.
//!
//! Compose, not braid: this module NAMES each color by its canonical hex text and color DECIDES the bytes through its
//! own parse_hex -- no new parser, no channel byte stored here, no maths. resolve(name) reads a name to a color
//! case-insensitively; name_of(color) reads a color back to its earliest matching name (the CSS set carries nine
//! synonym pairs -- aqua/cyan, gray/grey and their kin -- so a color with two names reads back to the alphabetically
//! first, deterministically and honestly). An unknown name refuses UnknownColorName by name rather than guessing.
//!
//! Verified two ways against transcription reds: the values were cross-read from the W3C CSS Color specification and
//! from an independent recall of the same standard, agreeing byte-for-byte; and the selftest proves this set is a
//! strict SUPERSET of the HTML4 sixteen -- every color_names.rye name resolves here to identical bytes -- so the
//! sixteen the older module already witnesses guard the overlap of the larger table by construction. No network, no
//! key, no funds -- the color names Brushstroke, Skate, and any stylesheet reader read the day the design system lands.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/color_names_css.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const html4 = @import("color_names.rye");

pub const color_names_css_version = "20260817.133152";

/// The longest color name we will read -- a generous ceiling over the longest CSS keyword ("lightgoldenrodyellow",
/// twenty bytes). A name longer than this is not a known color, so it refuses at the door rather than scanning.
pub const name_max: u32 = 32;

/// The whole CSS named-color set -- 148 colors, block-complete. This count is fixed by the standard, not a budget we
/// chose; it is the HTML4 sixteen plus every later web-safe keyword, including the nine gray/grey synonym pairs and
/// rebeccapurple. The selftest asserts the table length equals this count, so a dropped or doubled row cannot hide.
pub const css_named_color_count: u32 = 148;

/// One named color: a plain keyword and the canonical hex it stands for. The hex is the source of the bytes, read
/// through color.parse_hex, so this module stores a NAME and a TEXT, never a decoded channel byte of its own.
pub const Named = struct {
    name: []const u8,
    hex: []const u8,
};

/// The 148 CSS named colors, sorted strictly ascending by name so the table is canonical and duplicate-free by
/// inspection. Each hex is the standard's own canonical value; the selftest proves every one parses and round-trips.
