fn ascii_lower(c: u8) u8 {
    // invariant: only the 26 uppercase letters shift; every other byte returns unchanged.
    if (c >= 'A' and c <= 'Z') return c + 32;
    return c;
}

/// Compare two names for equality ignoring ASCII case, so "RED", "Red", and "red" all name the same color.
fn eql_ignore_case(a: []const u8, b: []const u8) bool {
    // invariant: both names are bounded by the module ceiling, so the length seam-cast to u32 is safe.
    assert(a.len <= name_max);
    assert(b.len <= name_max);
    if (a.len != b.len) return false;
    const n: u32 = @intCast(a.len);
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        if (ascii_lower(a[i]) != ascii_lower(b[i])) return false;
    }
    return true;
}

/// Read a color name to its four bytes -- "rebeccapurple" to {102,51,153,255} -- case-insensitively. An unknown name
/// refuses UnknownColorName by name rather than guessing; the bytes come from color.parse_hex, so this composes the
/// algebra rather than storing a channel of its own.
pub fn resolve(name: []const u8) !color.Rgba {
    // invariant: the table is the whole CSS set, bounded and never scanned past its end.
    assert(css_named_color_count == table.len);
    // invariant: the name ceiling is at least one byte, so an empty name is meaningfully shorter than any keyword.
    assert(name_max >= 1);
    if (name.len == 0) return error.UnknownColorName;
    if (name.len > name_max) return error.UnknownColorName;
    var i: u32 = 0;
    while (i < css_named_color_count) : (i += 1) {
        if (eql_ignore_case(name, table[i].name)) {
            // Compose, not braid: color DECIDES the bytes from the canonical hex; this module only NAMES them.
            return try color.parse_hex(table[i].hex);
        }
    }
    return error.UnknownColorName;
}

/// Read a color back to its earliest matching CSS name, or null when no named color matches it byte-for-byte. Because
/// the table is sorted ascending and carries nine synonym pairs (aqua/cyan, gray/grey and kin), a color with two names
/// reads back to the alphabetically first -- #00ffff to "aqua", #808080 to "gray" -- deterministically. Matches only
/// opaque colors (the named set is all opaque), so it never claims a name for a color it cannot honestly hold.
pub fn name_of(c: color.Rgba) ?[]const u8 {
    // invariant: the table is the whole CSS set, bounded and never scanned past its end.
    assert(css_named_color_count == table.len);
    // invariant: the name ceiling is at least one byte -- every keyword fits, so a returned name is a real table entry.
    assert(name_max >= 1);
    var i: u32 = 0;
    while (i < css_named_color_count) : (i += 1) {
        const known = color.parse_hex(table[i].hex) catch continue;
        if (known.eql(c)) return table[i].name;
    }
    return null;
}

// --- selftest: prove every name parses through color.parse_hex, the table is the sorted block-complete CSS set of
// --- 148, names resolve case-insensitively, the unknown is refused, name_of reads back the earliest synonym, and the
// --- set is a strict superset of the HTML4 sixteen (so the older module's witness guards the overlap by construction).

fn run_selftest(garden: std.mem.Allocator) !u8 {
    _ = garden;

    // 1. Every named color's canonical hex parses through color.parse_hex -- the compose crux, no private parser.
    var i: u32 = 0;
    while (i < css_named_color_count) : (i += 1) {
        _ = color.parse_hex(table[i].hex) catch return error.EntryHexUnparseable;
    }

    // 2. The table is strictly ascending by name -- a canonical, block-complete, duplicate-free set by inspection.
    i = 1;
    while (i < css_named_color_count) : (i += 1) {
        if (!std.mem.lessThan(u8, table[i - 1].name, table[i].name)) return error.TableNotSorted;
    }

    // 3. Known names resolve to their standard bytes -- one at each end and rebeccapurple, the CSS4 addition.
    const alice = try resolve("aliceblue");
    if (!alice.eql(.{ .r = 240, .g = 248, .b = 255, .a = 255 })) return error.AliceWrong;
    const yellowgreen = try resolve("yellowgreen");
    if (!yellowgreen.eql(.{ .r = 154, .g = 205, .b = 50, .a = 255 })) return error.YellowgreenWrong;
    const rebecca = try resolve("rebeccapurple");
    if (!rebecca.eql(.{ .r = 102, .g = 51, .b = 153, .a = 255 })) return error.RebeccaWrong;

    // 4. The read is case-insensitive -- "DodgerBlue" and "dodgerblue" name the same color.
    const dodger_mixed = try resolve("DodgerBlue");
    const dodger_lower = try resolve("dodgerblue");
    if (!dodger_mixed.eql(dodger_lower)) return error.MixedCaseDiffers;

    // 5. An unknown name refuses UnknownColorName by name, having guessed nothing; an empty name likewise.
    if (resolve("burntsienna")) |_| return error.UnknownNotRefused else |err| {
        if (err != error.UnknownColorName) return error.WrongUnknownError;
    }
    if (resolve("")) |_| return error.EmptyNotRefused else |err| {
        if (err != error.UnknownColorName) return error.WrongEmptyError;
    }

    // 6. A resolved color round-trips through color.format_hex to its canonical nine-byte form.
    var buf: [9]u8 = undefined;
    const shown = try color.format_hex(rebecca, buf[0..]);
    if (!std.mem.eql(u8, shown, "#663399ff")) return error.RoundTripWrong;

    // 7. name_of reads a color back to its earliest matching name across the synonym pairs, and null for the unnamed.
    const aqua_name = name_of(.{ .r = 0, .g = 255, .b = 255, .a = 255 }) orelse return error.AquaNameMissing;
    if (!std.mem.eql(u8, aqua_name, "aqua")) return error.AquaNotEarliest; // aqua before cyan
    const gray_name = name_of(.{ .r = 128, .g = 128, .b = 128, .a = 255 }) orelse return error.GrayNameMissing;
    if (!std.mem.eql(u8, gray_name, "gray")) return error.GrayNotEarliest; // gray before grey
    if (name_of(.{ .r = 1, .g = 2, .b = 3, .a = 255 })) |_| return error.UnnamedFalselyNamed else {}
    if (name_of(.{ .r = 0, .g = 255, .b = 255, .a = 128 })) |_| return error.TranslucentFalselyNamed else {}

    // 8. The set is the whole CSS 148 -- block-complete, not a truncated sample.
    if (css_named_color_count != 148) return error.CountWrong;

    // 9. Strict superset of the HTML4 sixteen: every color_names.rye name resolves here to identical bytes, so the
    // older module's own green witness guards the sixteen overlapping rows of this larger table by construction.
    var covered: u32 = 0;
    var h: u32 = 0;
    while (h < html4.named_color_count) : (h += 1) {
        const want = try html4.resolve(html4.table[h].name);
        const got = resolve(html4.table[h].name) catch return error.Html4NameMissingHere;
        if (!got.eql(want)) return error.Html4ByteMismatch;
        covered += 1;
    }
    if (covered != 16) return error.Html4CoverageWrong;

    // 10. Determinism -- the same name reads the same bytes every time.
    const alice_again = try resolve("aliceblue");
    if (!alice_again.eql(alice)) return error.NotDeterministic;

    print("GREEN image-color-names-css: the 148 CSS color names read over the open color algebra; every named color's canonical hex parses through color.parse_hex (compose not braid, no private parser); a name resolves case-insensitively (DodgerBlue, dodgerblue one color); an unknown or empty name refuses UnknownColorName by name having guessed nothing; a resolved color round-trips through color.format_hex to its canonical nine-byte form; name_of reads a color back to its earliest matching name across the nine synonym pairs (aqua before cyan, gray before grey) and honestly null for an unnamed or translucent one; the table is strictly ascending, duplicate-free, and block-complete at 148; the set is a strict superset of the HTML4 sixteen -- every color_names name resolves here to identical bytes, so the older witness guards the overlap by construction; the same name reads the same bytes every time\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: color_names_css selftest\n", .{});
    return 1;
}
