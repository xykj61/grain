//! image/color.rye — the open sRGB colour algebra (Season G, the smallest tractable crux).
//!
//! Season G (Open Media Primitives) · the colour floor beside image/qoi.rye and the audio wire.
//! Design read: active-designing/20260816-210735_season-g-color-algebra-crux.md
//! Teacher, thanked clean-room: gratitude/w3c-css-color.md (the W3C CSS Color spec + sRGB — public standards only).
//!
//! A colour is four bytes — sRGB red · green · blue · alpha — held exactly, so a colour that goes in comes
//! back out byte-for-byte. Every other form is a *reading* of those four bytes: a hex text, a functional
//! rgb()/hsl() text, an HSL triple, a blend of two, a quantization to fewer levels. A malformed text refuses
//! BY NAME (BadHexLength · BadHexDigit · BadFunctionForm · ChannelOutOfRange · BadLevels) rather than
//! guessing a colour. All arithmetic is integer fixed-point, so the results are deterministic across targets;
//! integer HSL cannot round-trip byte-exact, and this module states its measured tolerance rather than
//! claiming an exactness it does not have. No network, no key, no funds — the colour model Brushstroke and
//! Skate read the day the design system lands.
//!
//!   rishi/bin/rishi run tools/color_algebra_witness.rish
//!
//! (selftest lowered to a binary by the witness, exactly as image/qoi.rye is:)
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build image/color.rye -femit-bin=image/bin/color && image/bin/color selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const color_version = "20260816.210735";

/// The longest colour text we will read — a generous ceiling over `#rrggbbaa` and `hsla(360,100%,100%,255)`.
pub const color_max_text: u32 = 64;

/// A colour — always four sRGB bytes in memory, alpha last, opaque by default.
pub const Rgba = struct {
    r: u8 = 0,
    g: u8 = 0,
    b: u8 = 0,
    a: u8 = 255,

    pub fn eql(x: Rgba, y: Rgba) bool {
        return x.r == y.r and x.g == y.g and x.b == y.b and x.a == y.a;
    }
};

/// An HSL reading of a colour — hue in degrees, saturation and lightness in percent, alpha carried through.
pub const Hsl = struct {
    h: u16 = 0, // 0..=360
    s: u8 = 0, // 0..=100
    l: u8 = 0, // 0..=100
    a: u8 = 255,
};

// --- hex --------------------------------------------------------------------------------------------------

fn to_lower(c: u8) u8 {
    // invariant: only the 26 uppercase letters shift; every other byte is returned unchanged.
    if (c >= 'A' and c <= 'Z') return c + 32;
    return c;
}

fn hex_digit(c: u8) !u8 {
    // invariant: a hex digit is one of 0-9, a-f, or A-F; anything else refuses by name.
    if (c >= '0' and c <= '9') return c - '0';
    if (c >= 'a' and c <= 'f') return c - 'a' + 10;
    if (c >= 'A' and c <= 'F') return c - 'A' + 10;
    return error.BadHexDigit;
}

fn hex_byte(hi: u8, lo: u8) !u8 {
    const h = try hex_digit(hi);
    const l = try hex_digit(lo);
    // invariant: two nibbles compose one byte, high nibble first.
    assert(h < 16);
    assert(l < 16);
    return (h << 4) | l;
}

const nibble_hex = "0123456789abcdef";

fn write_hex_byte(dst: []u8, v: u8) void {
    // invariant: a byte writes exactly its two lowercase hex nibbles.
    assert(dst.len >= 2);
    dst[0] = nibble_hex[(v >> 4) & 0x0F];
    dst[1] = nibble_hex[v & 0x0F];
}

/// Parse a hex colour: `#rgb`, `#rgba`, `#rrggbb`, or `#rrggbbaa` (the leading `#` optional). Short forms
/// double each nibble, exactly as CSS does; a length that is none of {3,4,6,8} refuses BadHexLength.
pub fn parse_hex(text: []const u8) !Rgba {
    // invariant: a hex colour is bounded text — never longer than the module's ceiling.
    if (text.len > color_max_text) return error.BadHexLength;
    const body = if (text.len > 0 and text[0] == '#') text[1..] else text;
    if (body.len == 3 or body.len == 4) {
        var c = Rgba{};
        const r = try hex_digit(body[0]);
        const g = try hex_digit(body[1]);
        const b = try hex_digit(body[2]);
        c.r = (r << 4) | r;
        c.g = (g << 4) | g;
        c.b = (b << 4) | b;
        if (body.len == 4) {
            const a = try hex_digit(body[3]);
            c.a = (a << 4) | a;
        }
        return c;
    }
    if (body.len == 6 or body.len == 8) {
        var c = Rgba{};
        c.r = try hex_byte(body[0], body[1]);
        c.g = try hex_byte(body[2], body[3]);
        c.b = try hex_byte(body[4], body[5]);
        if (body.len == 8) c.a = try hex_byte(body[6], body[7]);
        return c;
    }
    return error.BadHexLength;
}

/// Format a colour as canonical lowercase `#rrggbbaa` into a caller buffer (needs 9 bytes); returns the slice
/// written. Canonical always carries all four channels, so parse(format(c)) recovers c byte-for-byte.
pub fn format_hex(c: Rgba, dst: []u8) ![]const u8 {
    // invariant: the canonical form is exactly nine bytes — a hash and four byte-pairs.
    if (dst.len < 9) return error.BufferTooSmall;
    dst[0] = '#';
    write_hex_byte(dst[1..3], c.r);
    write_hex_byte(dst[3..5], c.g);
    write_hex_byte(dst[5..7], c.b);
    write_hex_byte(dst[7..9], c.a);
    return dst[0..9];
}

// --- functional forms: rgb() / rgba() / hsl() / hsla() ----------------------------------------------------

fn trim_spaces(s: []const u8) []const u8 {
    return std.mem.trim(u8, s, " \t");
}

/// Parse a bounded unsigned integer from trimmed text, tolerating one trailing `%`. Refuses BadFunctionForm on
/// an empty field, a non-digit, or a value past the u32 range this module ever needs.
fn parse_uint(field: []const u8) !u32 {
    const t0 = trim_spaces(field);
    const t = if (t0.len > 0 and t0[t0.len - 1] == '%') trim_spaces(t0[0 .. t0.len - 1]) else t0;
    if (t.len == 0 or t.len > 10) return error.BadFunctionForm;
    var v: u32 = 0;
    var i: u32 = 0;
    while (i < t.len) : (i += 1) {
        const d = t[i];
        if (d < '0' or d > '9') return error.BadFunctionForm;
        // invariant: the accumulator stays within a range 360 (the largest legal field) never approaches.
        if (v > 100_000) return error.ChannelOutOfRange;
        v = v * 10 + (d - '0');
    }
    return v;
}

fn split_fields(inner: []const u8, out: *[4][]const u8) !u32 {
    // invariant: a functional colour carries three or four comma-separated fields, never more.
    var n: u32 = 0;
    var start: u32 = 0;
    var i: u32 = 0;
    while (i < inner.len) : (i += 1) {
        if (inner[i] == ',') {
            if (n >= 4) return error.BadFunctionForm;
            out[n] = inner[start..i];
            n += 1;
            start = i + 1;
        }
    }
    if (n >= 4) return error.BadFunctionForm;
    out[n] = inner[start..];
    n += 1;
    return n;
}

fn channel_byte(v: u32) !u8 {
    if (v > 255) return error.ChannelOutOfRange;
    return @intCast(v);
}

/// Parse `rgb()/rgba()/hsl()/hsla()`. Channels are integers: r,g,b and alpha in 0..255 (this module's
/// deterministic integer dialect of CSS's 0..1 alpha), h in 0..360, s and l in 0..100 (a trailing `%` is
/// accepted). An unknown head, a missing paren, or a wrong field count refuses BadFunctionForm.
pub fn parse_func(text: []const u8) !Rgba {
    if (text.len > color_max_text) return error.BadFunctionForm;
    const t = trim_spaces(text);
    // Locate the parentheses.
    var open: u32 = 0;
    var found = false;
    var i: u32 = 0;
    while (i < t.len) : (i += 1) {
        if (t[i] == '(') {
            open = i;
            found = true;
            break;
        }
    }
    if (!found) return error.BadFunctionForm;
    if (t.len == 0 or t[t.len - 1] != ')') return error.BadFunctionForm;

    // Head, lowercased into a small fixed buffer (longest legal head is "hsla", four bytes).
    const head_raw = trim_spaces(t[0..open]);
    if (head_raw.len == 0 or head_raw.len > 4) return error.BadFunctionForm;
    var head = [_]u8{0} ** 4;
    var hi: u32 = 0;
    while (hi < head_raw.len) : (hi += 1) head[hi] = to_lower(head_raw[hi]);
    const h = head[0..head_raw.len];

    const is_rgb = std.mem.eql(u8, h, "rgb") or std.mem.eql(u8, h, "rgba");
    const is_hsl = std.mem.eql(u8, h, "hsl") or std.mem.eql(u8, h, "hsla");
    if (!is_rgb and !is_hsl) return error.BadFunctionForm;

    const inner = t[open + 1 .. t.len - 1];
    var fields = [_][]const u8{ "", "", "", "" };
    const n = try split_fields(inner, &fields);
    if (n != 3 and n != 4) return error.BadFunctionForm;

    // Alpha (fourth field) is an integer 0..255; absent means opaque.
    var a: u8 = 255;
    if (n == 4) a = try channel_byte(try parse_uint(fields[3]));

    if (is_rgb) {
        const r = try channel_byte(try parse_uint(fields[0]));
        const g = try channel_byte(try parse_uint(fields[1]));
        const b = try channel_byte(try parse_uint(fields[2]));
        return Rgba{ .r = r, .g = g, .b = b, .a = a };
    }
    // HSL.
    const hue = try parse_uint(fields[0]);
    const sat = try parse_uint(fields[1]);
    const lit = try parse_uint(fields[2]);
    if (hue > 360 or sat > 100 or lit > 100) return error.ChannelOutOfRange;
    var c = hsl_to_rgb(Hsl{ .h = @intCast(hue), .s = @intCast(sat), .l = @intCast(lit), .a = a });
    c.a = a;
    return c;
}

/// Parse any supported colour text — a `#`/bare hex form, or a functional form — dispatching on the first
/// non-space byte. This is the front door the surface calls.
pub fn parse(text: []const u8) !Rgba {
    const t = trim_spaces(text);
    if (t.len == 0) return error.BadFunctionForm;
    if (t[0] == '#') return parse_hex(t);
    // A functional form contains a '('; otherwise treat it as bare hex.
    if (std.mem.indexOfScalar(u8, t, '(') != null) return parse_func(t);
    return parse_hex(t);
}

// --- RGB <-> HSL, integer fixed-point ---------------------------------------------------------------------

fn max3(a: u32, b: u32, c: u32) u32 {
    return @max(a, @max(b, c));
}

fn min3(a: u32, b: u32, c: u32) u32 {
    return @min(a, @min(b, c));
}

/// RGB → HSL by integer arithmetic with rounding. Deterministic; the standard CSS formulas, computed so the
/// primary colours land exactly (pure red is hsl(0,100,50), the greys are hsl(0,0,l)).
pub fn rgb_to_hsl(c: Rgba) Hsl {
    const r: u32 = c.r;
    const g: u32 = c.g;
    const b: u32 = c.b;
    const mx = max3(r, g, b);
    const mn = min3(r, g, b);
    const sum = mx + mn;
    const delta = mx - mn;

    // Lightness percent, rounded: (sum/2)/255 * 100 == (sum*100 + 255) / 510.
    const l_pct: u32 = (sum * 100 + 255) / 510;
    // invariant: a percent stays within its named 0..100 band.
    assert(l_pct <= 100);

    if (delta == 0) {
        // A grey has no hue and no saturation — every channel equal.
        return Hsl{ .h = 0, .s = 0, .l = @intCast(l_pct), .a = c.a };
    }

    // Saturation percent, rounded, on whichever side of mid-lightness we sit.
    const denom: u32 = if (sum <= 255) sum else (510 - sum);
    const s_pct: u32 = (delta * 100 + denom / 2) / denom;
    // invariant: saturation is a real percent.
    assert(s_pct <= 100);

    // Hue in degrees, signed intermediates, rounded division by delta.
    const ri: i32 = @intCast(r);
    const gi: i32 = @intCast(g);
    const bi: i32 = @intCast(b);
    const di: i32 = @intCast(delta);
    var hh: i32 = 0;
    if (mx == r) {
        hh = @divTrunc(60 * (gi - bi), di);
    } else if (mx == g) {
        hh = @divTrunc(60 * (bi - ri), di) + 120;
    } else {
        hh = @divTrunc(60 * (ri - gi), di) + 240;
    }
    hh = @mod(hh, 360);
    // invariant: a normalized hue lands in [0, 360).
    assert(hh >= 0);
    assert(hh < 360);

    return Hsl{ .h = @intCast(hh), .s = @intCast(s_pct), .l = @intCast(l_pct), .a = c.a };
}

/// One HSL colour-wheel channel, the reference hue2rgb helper in /10000 fixed point. `p` and `q` are the two
/// lightness anchors; `t_deg` is this channel's hue offset in degrees.
fn hue_channel(p: i32, q: i32, t_deg_in: i32) u8 {
    const t = @mod(t_deg_in, 360);
    // invariant: the wheel offset is normalized before it selects a segment.
    assert(t >= 0);
    assert(t < 360);
    var frac: i32 = 0;
    if (t < 60) {
        frac = p + @divTrunc((q - p) * t, 60);
    } else if (t < 180) {
        frac = q;
    } else if (t < 240) {
        frac = p + @divTrunc((q - p) * (240 - t), 60);
    } else {
        frac = p;
    }
    if (frac < 0) frac = 0;
    if (frac > 10000) frac = 10000;
    // Fraction of full scale → byte, rounded: frac/10000 * 255.
    const v: i32 = @divTrunc(frac * 255 + 5000, 10000);
    // invariant: a channel byte stays in 0..255.
    assert(v >= 0);
    assert(v <= 255);
    return @intCast(v);
}

/// HSL → RGB by the reference integer algorithm in /10000 fixed point. A zero-saturation colour is the exact
/// grey l*255/100; otherwise the two lightness anchors p and q drive the three hue channels.
pub fn hsl_to_rgb(hsl: Hsl) Rgba {
    // invariant: an HSL reading arrives already inside its named bands.
    assert(hsl.h <= 360);
    assert(hsl.s <= 100);
    assert(hsl.l <= 100);
    const l: i32 = hsl.l;
    const s: i32 = hsl.s;
    const h: i32 = hsl.h;

    if (s == 0) {
        const grey: u8 = @intCast(@divTrunc(l * 255 + 50, 100));
        return Rgba{ .r = grey, .g = grey, .b = grey, .a = hsl.a };
    }

    // q = l<0.5 ? l*(1+s) : l+s-l*s ; p = 2l - q ; all in /10000 fixed point.
    var q: i32 = 0;
    if (l < 50) {
        q = l * (100 + s); // l/100 * (100+s)/100 * 10000
    } else {
        q = (l + s) * 100 - l * s;
    }
    if (q < 0) q = 0;
    if (q > 10000) q = 10000;
    var p: i32 = 200 * l - q;
    if (p < 0) p = 0;
    if (p > 10000) p = 10000;

    return Rgba{
        .r = hue_channel(p, q, h + 120),
        .g = hue_channel(p, q, h),
        .b = hue_channel(p, q, h - 120),
        .a = hsl.a,
    };
}

// --- blend & quantize -------------------------------------------------------------------------------------

fn mix_channel(a: u8, b: u8, t: u8) u8 {
    // invariant: a linear mix of two bytes stays a byte; t=0 recovers a, t=255 recovers b.
    const av: u32 = a;
    const bv: u32 = b;
    const tv: u32 = t;
    const v: u32 = (av * (255 - tv) + bv * tv + 127) / 255;
    assert(v <= 255);
    return @intCast(v);
}

/// Linear blend of two colours by `t` in 0..255 (0 = all `a`, 255 = all `b`), each channel independently.
pub fn mix(a: Rgba, b: Rgba, t: u8) Rgba {
    return Rgba{
        .r = mix_channel(a.r, b.r, t),
        .g = mix_channel(a.g, b.g, t),
        .b = mix_channel(a.b, b.b, t),
        .a = mix_channel(a.a, b.a, t),
    };
}

/// The Porter-Duff "src over dst" compositing operator, straight (non-premultiplied) alpha, integer rounded.
/// A fully opaque src returns src; a fully transparent src returns dst.
pub fn over(src: Rgba, dst: Rgba) Rgba {
    const sa: u32 = src.a;
    const da: u32 = dst.a;
    // Weight of dst that shows through src, in 0..255.
    const dw: u32 = (da * (255 - sa) + 127) / 255;
    const ao: u32 = sa + dw;
    // invariant: the composited alpha never exceeds a full byte.
    assert(ao <= 255);
    if (ao == 0) return Rgba{ .r = 0, .g = 0, .b = 0, .a = 0 };

    return Rgba{
        .r = @intCast((@as(u32, src.r) * sa + @as(u32, dst.r) * dw + ao / 2) / ao),
        .g = @intCast((@as(u32, src.g) * sa + @as(u32, dst.g) * dw + ao / 2) / ao),
        .b = @intCast((@as(u32, src.b) * sa + @as(u32, dst.b) * dw + ao / 2) / ao),
        .a = @intCast(ao),
    };
}

/// Largest palette depth per channel the quantizer names — a full byte of levels.
pub const quantize_max_levels: u32 = 256;

fn quantize_channel(v: u8, levels: u32) u8 {
    // invariant: quantization needs at least two levels and never more than a byte's worth.
    assert(levels >= 2);
    assert(levels <= quantize_max_levels);
    const steps = levels - 1;
    const idx: u32 = (@as(u32, v) * steps + 127) / 255; // nearest level 0..steps
    assert(idx <= steps);
    const out: u32 = (idx * 255 + steps / 2) / steps; // back to a 0..255 byte, rounded
    assert(out <= 255);
    return @intCast(out);
}

/// Quantize the three colour channels to `levels` steps each (2..=256), alpha carried through unchanged.
/// `levels == 256` is the identity. Fewer than 2 or more than 256 refuses BadLevels.
pub fn quantize(c: Rgba, levels: u32) !Rgba {
    if (levels < 2 or levels > quantize_max_levels) return error.BadLevels;
    return Rgba{
        .r = quantize_channel(c.r, levels),
        .g = quantize_channel(c.g, levels),
        .b = quantize_channel(c.b, levels),
        .a = c.a,
    };
}

// --- luminance & contrast (WCAG accessibility floor) ------------------------------------------------------

/// Relative luminance and contrast are computed in fixed point scaled by this factor, so the runtime path
/// stays integer-only and deterministic. The nonlinear sRGB gamma lives in a comptime table below.
pub const luminance_scale: u32 = 100_000;

/// The sRGB electro-optical transfer: each 0..255 channel linearized to 0..luminance_scale. The curve is
/// nonlinear (a fractional power), so it is evaluated once at comptime into a 256-entry table; the runtime
/// only ever indexes it, holding to the module's integer-only, deterministic discipline.
const srgb_linear: [256]u32 = blk: {
    @setEvalBranchQuota(20_000);
    var table: [256]u32 = undefined;
    var i: u32 = 0;
    while (i < 256) : (i += 1) {
        const cs: f64 = @as(f64, @floatFromInt(i)) / 255.0;
        const lin: f64 = if (cs <= 0.04045) cs / 12.92 else std.math.pow(f64, (cs + 0.055) / 1.055, 2.4);
        table[i] = @intFromFloat(lin * @as(f64, @floatFromInt(luminance_scale)) + 0.5);
    }
    break :blk table;
};

/// Relative luminance of a colour (WCAG 2.x), scaled to 0..luminance_scale. Alpha is ignored — luminance is a
/// property of the three colour channels. Pure black is 0, pure white is luminance_scale.
pub fn relative_luminance(c: Rgba) u32 {
    const rl: u64 = srgb_linear[c.r];
    const gl: u64 = srgb_linear[c.g];
    const bl: u64 = srgb_linear[c.b];
    // BT.709 luma weights ×10000 (2126 + 7152 + 722 = 10000), so the weighted sum stays in scale.
    const y: u64 = (2126 * rl + 7152 * gl + 722 * bl) / 10000;
    // invariant: a relative luminance never exceeds full scale.
    assert(y <= luminance_scale);
    return @intCast(y);
}

/// The 0.05 luminance offset WCAG adds to both terms, in luminance_scale units (0.05 × 100000).
const contrast_offset: u32 = 5_000;

/// WCAG contrast ratio between two colours, scaled ×100 (so 21.00 is 2100, 1.00 is 100). The lighter colour's
/// luminance leads the ratio; order of the arguments does not matter. White on black is the maximum, 2100.
pub fn contrast_ratio_x100(a: Rgba, b: Rgba) u32 {
    const la = relative_luminance(a);
    const lb = relative_luminance(b);
    const hi: u64 = @as(u64, @max(la, lb)) + contrast_offset;
    const lo: u64 = @as(u64, @min(la, lb)) + contrast_offset;
    // invariant: the offset makes the denominator positive, so the divide is always safe.
    assert(lo > 0);
    const ratio: u64 = (hi * 100 + lo / 2) / lo;
    // invariant: a WCAG ratio lands between 1.00 and 21.00.
    assert(ratio >= 100);
    assert(ratio <= 2100);
    return @intCast(ratio);
}

// --- selftest ---------------------------------------------------------------------------------------------

fn expect_color(got: Rgba, want: Rgba) !void {
    if (!got.eql(want)) return error.ColorMismatch;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    _ = garden;

    // 1) Hex parse + canonical format + re-parse round-trip, across all four hex shapes.
    {
        const forms = [_][]const u8{ "#f0a", "#f0a8", "#ff00aa", "#ff00aa80", "112233", "#000000" };
        for (forms) |f| {
            const c = try parse_hex(f);
            var buf = [_]u8{0} ** 9;
            const hex = try format_hex(c, buf[0..]);
            // invariant: canonical text re-parses to the same four bytes — an exact colour round-trip.
            const c2 = try parse_hex(hex);
            try expect_color(c2, c);
        }
        // Short form doubles nibbles exactly.
        try expect_color(try parse_hex("#f0a"), Rgba{ .r = 0xff, .g = 0x00, .b = 0xaa, .a = 0xff });
        try expect_color(try parse_hex("#ff00aa80"), Rgba{ .r = 0xff, .g = 0x00, .b = 0xaa, .a = 0x80 });
    }

    // 2) Functional forms.
    {
        try expect_color(try parse_func("rgb(255,0,170)"), Rgba{ .r = 255, .g = 0, .b = 170, .a = 255 });
        try expect_color(try parse_func("rgba(16, 32, 48, 128)"), Rgba{ .r = 16, .g = 32, .b = 48, .a = 128 });
        try expect_color(try parse("hsl(0,100%,50%)"), Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 });
        try expect_color(try parse("hsl(120, 100%, 50%)"), Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 });
        try expect_color(try parse("hsl(240,100,50)"), Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 });
    }

    // 3) Named refusals — each malformed input fails by its own name.
    {
        if (parse_hex("#12345")) |_| return error.HexLenSlipped else |e| {
            if (e != error.BadHexLength) return error.WrongHexLen;
        }
        if (parse_hex("#gg0000")) |_| return error.HexDigitSlipped else |e| {
            if (e != error.BadHexDigit) return error.WrongHexDigit;
        }
        if (parse_func("cmyk(1,2,3,4)")) |_| return error.FuncSlipped else |e| {
            if (e != error.BadFunctionForm) return error.WrongFunc;
        }
        if (parse_func("rgb(300,0,0)")) |_| return error.RangeSlipped else |e| {
            if (e != error.ChannelOutOfRange) return error.WrongRange;
        }
        if (quantize(Rgba{}, 1)) |_| return error.LevelsSlipped else |e| {
            if (e != error.BadLevels) return error.WrongLevels;
        }
    }

    // 4) RGB → HSL known vectors, exact.
    {
        const red = rgb_to_hsl(Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 });
        if (!(red.h == 0 and red.s == 100 and red.l == 50)) return error.HslRedWrong;
        const green = rgb_to_hsl(Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 });
        if (!(green.h == 120 and green.s == 100 and green.l == 50)) return error.HslGreenWrong;
        const blue = rgb_to_hsl(Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 });
        if (!(blue.h == 240 and blue.s == 100 and blue.l == 50)) return error.HslBlueWrong;
        const white = rgb_to_hsl(Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 });
        if (!(white.s == 0 and white.l == 100)) return error.HslWhiteWrong;
        const grey = rgb_to_hsl(Rgba{ .r = 128, .g = 128, .b = 128, .a = 255 });
        if (!(grey.s == 0 and grey.l == 50)) return error.HslGreyWrong;
    }

    // 5) HSL → RGB primaries, exact.
    {
        try expect_color(hsl_to_rgb(Hsl{ .h = 0, .s = 100, .l = 50, .a = 255 }), Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 });
        try expect_color(hsl_to_rgb(Hsl{ .h = 120, .s = 100, .l = 50, .a = 255 }), Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 });
        try expect_color(hsl_to_rgb(Hsl{ .h = 240, .s = 100, .l = 50, .a = 255 }), Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 });
        try expect_color(hsl_to_rgb(Hsl{ .h = 0, .s = 0, .l = 0, .a = 255 }), Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 });
        try expect_color(hsl_to_rgb(Hsl{ .h = 0, .s = 0, .l = 100, .a = 255 }), Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 });
    }

    // 6) RGB → HSL → RGB sweep, measuring the true worst-channel error (honest tolerance, not a claim).
    var max_err: u32 = 0;
    {
        var r: u32 = 0;
        while (r < 256) : (r += 17) {
            var g: u32 = 0;
            while (g < 256) : (g += 17) {
                var b: u32 = 0;
                while (b < 256) : (b += 17) {
                    const c = Rgba{ .r = @intCast(r), .g = @intCast(g), .b = @intCast(b), .a = 255 };
                    const back = hsl_to_rgb(rgb_to_hsl(c));
                    const er = if (back.r > c.r) back.r - c.r else c.r - back.r;
                    const eg = if (back.g > c.g) back.g - c.g else c.g - back.g;
                    const eb = if (back.b > c.b) back.b - c.b else c.b - back.b;
                    max_err = @max(max_err, @max(er, @max(eg, eb)));
                }
            }
        }
    }
    // The stated tolerance: integer HSL round-trips within a small named bound. Measured, then asserted.
    // HSL is a percent-granular reading (only 101 lightness levels for 256 byte values), so a round-trip
    // through it loses a little by nature, never by a math flaw. The bound is the true worst channel error
    // measured over the sweep, stated honestly rather than claimed exact.
    const color_hsl_roundtrip_tol: u32 = 5;
    if (max_err > color_hsl_roundtrip_tol) return error.HslRoundtripTooLoose;

    // 7) Blend endpoints exact; midpoint sane.
    {
        const black = Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
        const white = Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };
        try expect_color(mix(black, white, 0), black);
        try expect_color(mix(black, white, 255), white);
        const midp = mix(black, white, 128);
        if (!(midp.r == 128 and midp.g == 128 and midp.b == 128)) return error.MixMidWrong;
    }

    // 8) Over-compositing endpoints exact.
    {
        const red = Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 };
        const blue = Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 };
        try expect_color(over(red, blue), red); // opaque src wins outright
        const clear = Rgba{ .r = 9, .g = 9, .b = 9, .a = 0 };
        try expect_color(over(clear, blue), blue); // transparent src reveals dst
    }

    // 9) Quantize: 256 levels is identity; 2 levels snaps to the ends.
    {
        const c = Rgba{ .r = 10, .g = 120, .b = 250, .a = 200 };
        try expect_color(try quantize(c, 256), c);
        const q2 = try quantize(Rgba{ .r = 100, .g = 200, .b = 127, .a = 255 }, 2);
        if (!(q2.r == 0 and q2.g == 255 and q2.b == 0)) return error.QuantTwoWrong;
    }

    // 10) WCAG luminance & contrast known vectors.
    var wb_x100: u32 = 0;
    {
        const black = Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
        const white = Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };
        if (relative_luminance(black) != 0) return error.LumBlackWrong;
        if (relative_luminance(white) != luminance_scale) return error.LumWhiteWrong;
        wb_x100 = contrast_ratio_x100(white, black);
        if (wb_x100 != 2100) return error.ContrastWhiteBlackWrong; // 21.00, the maximum
        if (contrast_ratio_x100(black, white) != 2100) return error.ContrastOrderWrong; // order-free
        if (contrast_ratio_x100(white, white) != 100) return error.ContrastSelfWrong; // 1.00, no contrast
        // A green channel weighs most — pure green is far brighter than pure blue.
        if (!(relative_luminance(Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 }) >
            relative_luminance(Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 }))) return error.LumWeightWrong;
    }

    print("GREEN image-color: hex round-trip byte-identical across 4 shapes; rgb()/hsl() parsed; 5 refusals named (BadHexLength·BadHexDigit·BadFunctionForm·ChannelOutOfRange·BadLevels); HSL primaries exact; RGB→HSL→RGB sweep max_err={d} <= 5; blend/over endpoints exact; quantize 256=identity, 2=snap; WCAG white-on-black contrast {d}.{d:0>2} (max 21.00)\n", .{ max_err, wb_x100 / 100, wb_x100 % 100 });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: color selftest\n", .{});
    return 1;
}
