//! image/photo_revert.rye — HUNK14: the Photos app reverts — step back through the edit-list, the original one apply away.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK14.
//! Design read: active-designing/date/20260813/20260813-155719_hunk-photo-edits-non-destructive-exploration.md (HUNK14 horizon).
//! Teacher, thanked clean-room: the "revert to original" of iCloud Photos / Google Photos — the original is never
//! overwritten, so a revert only forgets edits, it never reconstructs pixels (concept only, siloed).
//!
//! HUNK11 recorded the six Photos verbs as a bounded `EditList` and replayed them over an untouched source. This rung
//! is the other half non-destructiveness buys for free: because the source is never mutated, a *revert* is nothing but
//! dropping edits off the end of the list — the earlier image is always one `apply` of the shorter list away, and the
//! original is one `apply` of the empty list away. `drop_last` forgets the last `k` edits; `truncate` keeps the first
//! `keep`; both are **pure over the count**, returning a fresh shorter list and leaving the caller's own list whole,
//! so a keeper can revert without ever losing the edits they might redo. No pixels are stored, no bytes reconstructed
//! from a history log — only the recipe is shortened. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/photo_revert.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const photos = @import("photos.rye");
const edits = @import("photo_edits.rye");

pub const photo_revert_version = "20260813.161500";

/// Keep the first `keep` edits of a list, returning a fresh shorter list. `keep` past the list's own length keeps
/// the whole list (a copy), never reading past the held edits. Pure — the caller's list is untouched, so the dropped
/// edits are only forgotten by *this* result, never destroyed at the source.
pub fn truncate(list: *const edits.EditList, keep: u32) edits.EditList {
    // invariant: the source list is within its named ceiling.
    assert(list.count <= edits.max_edits);
    var out = edits.EditList.init();
    // A value copy of the whole fixed array — the tail past `count` is never read, `count` bounds every access.
    out.items = list.items;
    out.count = if (keep >= list.count) list.count else keep;
    // invariant: a truncation only shrinks — the result never holds more than the source, nor past the ceiling.
    assert(out.count <= list.count);
    assert(out.count <= edits.max_edits);
    return out;
}

/// Drop the last `k` edits, returning a fresh shorter list — a revert by `k` steps. Dropping at least as many as the
/// list holds recovers the empty list (the original image is always one empty-list `apply` away), never underflowing.
/// Pure — the caller's list is untouched.
pub fn drop_last(list: *const edits.EditList, k: u32) edits.EditList {
    // invariant: the source list is within its named ceiling.
    assert(list.count <= edits.max_edits);
    const keep = if (k >= list.count) 0 else list.count - k;
    const out = truncate(list, keep);
    // invariant: a revert only shrinks the list.
    assert(out.count <= list.count);
    return out;
}

/// Drop exactly the last edit — the common single-step undo. A revert of one; the empty list stays empty.
pub fn revert_one(list: *const edits.EditList) edits.EditList {
    return drop_last(list, 1);
}

// --- selftest: prove a revert forgets edits off the end, recovers earlier images and the original by replay, clamps
//     without underflow, keeps the source list whole, and its result still travels as an open, fixed-point record ---

/// Build a 6×6 image where each pixel encodes its own coordinates, so a replayed revert's correctness is
/// unambiguous: pixel (x,y) = (x·40, y·40, x+y, 255). Matches photo_edits.rye's own craft so proofs line up.
fn craft_tagged(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 6;
    const h: u32 = 6;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            buf[off] = @intCast(x * 40);
            buf[off + 1] = @intCast(y * 40);
            buf[off + 2] = @intCast(x + y);
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_tagged(garden);

    // A three-verb edit-list: crop a 4×4, turn a quarter clockwise, lift brightness +40.
    var list = edits.EditList.init();
    try list.push(.{ .crop = .{ .x = 1, .y = 1, .w = 4, .h = 4 } });
    try list.push(.{ .rotate = .{ .turns = 1 } });
    try list.push(.{ .adjust = .{ .brightness = 40, .num = 1, .den = 1 } });

    // Revert one step == truncate to two == the first two verbs by hand, byte-for-byte through replay.
    const reverted = revert_one(&list);
    const trunc2 = truncate(&list, 2);
    assert(reverted.len() == 2);
    assert(trunc2.len() == 2);
    const step2_replay = try edits.apply(garden, &pm, &reverted);
    const by_hand_crop = try photos.crop(garden, &pm, 1, 1, 4, 4);
    const by_hand_step2 = try photos.rotate_quarter(garden, &by_hand_crop, 1);
    assert(step2_replay.same_bytes(&by_hand_step2));
    // truncate and drop_last are duals over the same count — same result bytes.
    const trunc2_replay = try edits.apply(garden, &pm, &trunc2);
    assert(trunc2_replay.same_bytes(&step2_replay));

    // Dropping zero is identity: the full replay is unchanged.
    const full = try edits.apply(garden, &pm, &list);
    const drop0 = drop_last(&list, 0);
    assert(drop0.len() == list.len());
    const drop0_replay = try edits.apply(garden, &pm, &drop0);
    assert(drop0_replay.same_bytes(&full));

    // Revert all the way: dropping every edit recovers the ORIGINAL — one empty-list apply away, byte-for-byte.
    const all_back = drop_last(&list, list.len());
    assert(all_back.len() == 0);
    const original = try edits.apply(garden, &pm, &all_back);
    assert(original.same_bytes(&pm));

    // Clamp, never underflow: dropping more than the list holds still lands at the empty original, not a wild count.
    const over = drop_last(&list, list.len() + 5);
    assert(over.len() == 0);
    // And truncate past the length keeps the whole list, a faithful copy.
    const keep_over = truncate(&list, list.len() + 5);
    assert(keep_over.len() == list.len());
    const keep_over_replay = try edits.apply(garden, &pm, &keep_over);
    assert(keep_over_replay.same_bytes(&full));

    // Pure: the caller's own list is untouched by any revert — the dropped edits are never destroyed at the source,
    // so a keeper can revert then redo.
    assert(list.len() == 3);
    const redo = try edits.apply(garden, &pm, &list);
    assert(redo.same_bytes(&full));

    // The revert is a PREFIX: the reverted list's rendered record is a byte-prefix of the full list's record.
    var full_buf: [edits.max_edits_bytes]u8 = undefined;
    const full_n = try edits.render_edits(&list, full_buf[0..]);
    var rev_buf: [edits.max_edits_bytes]u8 = undefined;
    const rev_n = try edits.render_edits(&reverted, rev_buf[0..]);
    assert(rev_n < full_n);
    assert(std.mem.eql(u8, rev_buf[0..rev_n], full_buf[0..rev_n]));

    // The reverted list still travels as an open, fixed-point record: render, parse, and it rebuilds the same image.
    var rebuilt: edits.EditList = undefined;
    try edits.parse_edits(rev_buf[0..rev_n], &rebuilt);
    assert(rebuilt.len() == reverted.len());
    const rebuilt_replay = try edits.apply(garden, &pm, &rebuilt);
    assert(rebuilt_replay.same_bytes(&step2_replay));

    // The empty list reverts to itself — revert_one of empty stays empty, no underflow.
    var empty = edits.EditList.init();
    const still_empty = revert_one(&empty);
    assert(still_empty.len() == 0);

    print("GREEN image-photo-revert: reverting one step of a {d}-verb list equals the first two verbs by hand " ++
        "byte-for-byte; truncate and drop_last are duals; dropping zero is identity; dropping all recovers the " ++
        "original one empty-list apply away byte-for-byte; dropping past the count clamps to empty without " ++
        "underflow while truncate past the length keeps the whole list; the source list is untouched so a revert " ++
        "can be redone; a revert is a byte-prefix of the full record and still round-trips as an open fixed-point " ++
        "record; the empty list reverts to itself\n", .{list.len()});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: photo_revert selftest\n", .{});
    return 1;
}
