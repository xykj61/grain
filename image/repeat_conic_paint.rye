//! image/repeat_conic_paint.rye -- a REPEATING CONIC positioned gradient SEEN on an image (Season G, the sweep that tiles).
//!
//! Season G (Open Media Primitives) -- the sixth and last shape of the CSS gradient family, closing the set that
//! image/gradient_paint.rye (LINEAR), image/radial_paint.rye (RADIAL), image/conic_paint.rye (CONIC), image/repeat_paint.rye
//! (REPEATING LINEAR), and image/repeat_radial_paint.rye (REPEATING RADIAL) began. It is the conic twin of the repeating
//! linear ramp and the repeating sibling of the single conic sweep. Where the single conic gradient runs its ramp ONCE around
//! the turn (top clockwise back to top), this rung runs the ramp `reps` times around and TILES it -- the CSS
//! `repeating-conic-gradient` shape -- so the picture reads as `reps` identical pie wedges, a hard seam at each tile boundary
//! just as CSS draws unless the first and last controls match.
//!
//! Compose, not braid: color_ramp_stops.sample_checked DECIDES each pixel's color at its computed position, image/qoi owns
//! the RGBA target, and image/color composites the paint over the destination (Porter-Duff src-over, straight alpha). This
//! module only ROUTES each pixel to its position WITHIN its angular tile and writes it -- no new color math, no new codec.
//!
//! The routing stays integer fixed-point so a painted sweep is deterministic, and needs no trigonometry. Coordinates are
//! DOUBLED (2*c - (dim-1)) so the center lands exactly on a pixel for odd dimensions and exactly between two for even ones,
//! without a fraction -- kept identical to image/conic_paint.rye. The bearing is a PSEUDO-ANGLE held at FULL precision as a
//! fraction T/D of the turn (T = q*s + numer, D = 4*s), the four quadrants clockwise from the top split the turn into four,
//! and within a quadrant the position grows linearly with the ratio of the two doubled coordinates. To tile, the fraction is
//! multiplied by `reps` and reduced modulo the turn: `tile = (T * reps) mod D`, scaled to the ramp domain
//! `tile * pos_max / D`. So the ramp completes `reps` full cycles around the center: with reps 2 the top reads 0 and the south
//! reads 0 again (the ramp tiled once by the halfway point), each ray between the center still one constant wedge color. The
//! whole box is bound-checked ONCE up front (in u64 so a far edge can never wrap before the bound refuses), `reps` is checked
//! against a named ceiling, and the ramp is validated ONCE before any pixel is written, so a malformed sweep refuses by name
//! having painted nothing -- all-or-nothing, never a half-painted wedge. No network, no key, no funds.
//!
//! Teacher, thanked clean-room: the CSS repeating-conic-gradient concept (W3C CSS Color / Images -- public standard only).
//! The idea enters siloed (context/SILO_TECHNIQUE.md): the shape is ours, named plainly; the thanks live in the witness header.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/repeat_conic_paint.rye -- selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const qoi = @import("qoi.rye");
const ramp_stops = @import("color_ramp_stops.rye");

pub const repeat_conic_paint_version = "20260817.154231";

/// Composite one paint color over the destination pixel at (x, y), src-over, so a translucent sweep reads through to the
/// picture beneath. The caller proves the pixel lands inside the target; this writer only blends.
fn blend_pixel(target: *qoi.Pixmap, x: u32, y: u32, paint: color.Rgba) void {
    // invariant: the caller proved this pixel lands inside the target buffer, on the horizontal axis.
    assert(x < target.width);
    // invariant: and on the vertical axis -- both are load-bearing for the flat index below.
    assert(y < target.height);
    const di = (@as(usize, y) * @as(usize, target.width) + @as(usize, x)) * 4;
    const dst = color.Rgba{
        .r = target.pixels[di],
        .g = target.pixels[di + 1],
        .b = target.pixels[di + 2],
        .a = target.pixels[di + 3],
    };
    const res = color.over(paint, dst);
    target.pixels[di] = res.r;
    target.pixels[di + 1] = res.g;
    target.pixels[di + 2] = res.b;
    target.pixels[di + 3] = res.a;
}

/// The repeating-conic position (0..pos_max) of pixel (`cx`, `cy`) in a box of size `w` x `h`, tiling the ramp `reps` times
/// around the turn -- its bearing CLOCKWISE from the top held at full precision as the fraction T/D of the turn, then wound
/// `reps` times and reduced. The four quadrants split the turn into four; within a quadrant the position grows linearly with
/// the ratio of the two doubled coordinates, so the raw bearing runs 0 at the top through a quarter east, half south, three
/// quarters west. With reps tiles the ramp repeats: `tile = (T * reps) mod D` scaled to the ramp domain. Shared by the
/// painter, so the pixel-to-bearing routing is one small honest reader. The exact center has no bearing and reads 0.
fn repeat_conic_pos(cx: u32, cy: u32, w: u32, h: u32, reps: u32) u8 {
    // invariant: the pixel names a real cell of the box.
    assert(cx < w);
    assert(cy < h);
    // invariant: a repeating conic tiles at least twice, so the winding is a genuine repeat and never degenerate.
    assert(reps >= 2);
    // Doubled coordinates keep the center exact without a fraction: dx2 runs -(w-1)..(w-1) (positive = right of center),
    // dy2 the same on the vertical axis (positive = below center, since a row grows downward).
    const dx2: i64 = 2 * @as(i64, cx) - (@as(i64, w) - 1);
    const dy2: i64 = 2 * @as(i64, cy) - (@as(i64, h) - 1);
    // Absolute coordinate magnitudes; dx2,dy2 <= 8191 so each fits u64 with room to spare after the abs.
    const a: u64 = @intCast(if (dx2 < 0) -dx2 else dx2);
    const b: u64 = @intCast(if (dy2 < 0) -dy2 else dy2);
    const s: u64 = a + b;
    // invariant: the exact center (both coordinates zero) has no bearing -- read the first control, position zero.
    if (s == 0) return 0;
    // Pick the quadrant clockwise from the top and the numerator whose ratio grows 0..1 across that quadrant. The top
    // (dx2 == 0, dy2 < 0) falls in the north-east branch by the dx2 >= 0 test, so the top reads exactly zero (the seam).
    var q: u64 = undefined;
    var numer: u64 = undefined;
    if (dy2 <= 0) {
        // Upper half: north-east (top -> east) reads |dx2|/s from 0 to 1; north-west (west -> top) is the last quadrant.
        if (dx2 >= 0) {
            q = 0;
            numer = a;
        } else {
            q = 3;
            numer = b;
        }
    } else {
        // Lower half: south-east (east -> south) reads |dy2|/s; south-west (south -> west) reads |dx2|/s.
        if (dx2 >= 0) {
            q = 1;
            numer = b;
        } else {
            q = 2;
            numer = a;
        }
    }
    // The raw bearing is the fraction T/D of the turn, held exact: T = q*s + numer (0 <= T < 4*s), D = 4*s. Tiling winds it
    // `reps` times and reduces: tile = (T*reps) mod D. s <= ~16382, so T < 4*s <= ~65528, and T*reps <= ~65528*qoi_max_dim
    // (~5.4e8) stays far inside u64; the final scale tile*pos_max <= ~65528*255 (~1.7e7) never wraps either.
    const t: u64 = q * s + numer;
    const den: u64 = 4 * s;
    // invariant: the raw bearing stays inside its own turn (equality only at the unreachable top seam of the last quadrant).
    assert(t <= den);
    const tile: u64 = (t * @as(u64, reps)) % den;
    // invariant: the tiled bearing lands strictly inside one turn, so the scaled position never reaches pos_max at a seam.
    assert(tile < den);
    const pos: u64 = tile * @as(u64, ramp_stops.pos_max) / den;
    // invariant: the position stays inside the ramp domain.
    assert(pos <= ramp_stops.pos_max);
    return @intCast(pos);
}

/// Paint a REPEATING CONIC positioned gradient into the rectangle at (`x`, `y`) of size `w` x `h` on `target`: the ramp runs
/// clockwise from the top and tiles `reps` times around the turn, each tile a hard-seamed pie wedge, every ray from the
/// center one constant color. Refuses `BadStripDims` if `w` or `h` is zero, `StripTooSmall` on a single-pixel box (no angular
/// direction), `RepsTooSmall` if `reps` is under two (a single turn is the plain conic), `RepsTooLarge` if `reps` exceeds the
/// image dimension ceiling, `RepeatConicOutOfBounds` BY NAME if the box would exceed the target, and every `color_ramp_stops`
/// refusal by name -- all checked BEFORE any pixel is written, so a refusal leaves the target untouched.
pub fn paint_gradient_repeat_conic(target: *qoi.Pixmap, x: u32, y: u32, w: u32, h: u32, reps: u32, control: []const color.Rgba, positions: []const u8) !void {
    // invariant: a repeating conic box has real extent and more than one pixel, so at least one bearing exists.
    if (w == 0 or h == 0) return error.BadStripDims;
    if (w == 1 and h == 1) return error.StripTooSmall;
    // invariant: the winding count tiles the ramp, so it needs at least two turns and stays within the named ceiling.
    if (reps < 2) return error.RepsTooSmall;
    if (reps > qoi.qoi_max_dim) return error.RepsTooLarge;
    // The ramp is validated ONCE up front, so a malformed stop list refuses having painted nothing.
    try ramp_stops.check(control, positions);
    // The box's far edges, in u64 so the sum can never wrap before the bound check refuses.
    const right: u64 = @as(u64, x) + @as(u64, w);
    const bottom: u64 = @as(u64, y) + @as(u64, h);
    if (right > @as(u64, target.width) or bottom > @as(u64, target.height)) return error.RepeatConicOutOfBounds;
    // invariant: the up-front check proved every pixel of the w x h box lands inside the target buffer.
    assert(right <= @as(u64, target.width));
    assert(bottom <= @as(u64, target.height));

    var cy: u32 = 0;
    while (cy < h) : (cy += 1) {
        var cx: u32 = 0;
        while (cx < w) : (cx += 1) {
            // The pixel's color is decided by the positioned ramp; this module only routes it to its tiled angular bearing.
            const col = ramp_stops.sample_checked(control, positions, repeat_conic_pos(cx, cy, w, h, reps));
            blend_pixel(target, x + cx, y + cy, col);
        }
    }
}

// --- selftest: paint a repeating conic, prove its tiling, its cardinal bearings, its constant wedges, its round trip --------

/// Mint a one-color RGBA canvas for the selftest -- a local, bounded builder so this rung leans on no higher module (it
/// keeps its own canvas exactly as image/conic_paint.rye and image/repeat_radial_paint.rye do).
fn make_canvas(garden: std.mem.Allocator, w: u32, h: u32, fill: color.Rgba) !qoi.Pixmap {
    // invariant: a canvas has real extent within the image module's named pixel ceiling.
    assert(w >= 1);
    assert(h >= 1);
    const total: u64 = @as(u64, w) * @as(u64, h);
    assert(total <= qoi.qoi_max_pixels);
    const pixels = try garden.alloc(u8, @as(usize, @intCast(total)) * 4);
    var i: usize = 0;
    while (i < pixels.len) : (i += 4) {
        pixels[i] = fill.r;
        pixels[i + 1] = fill.g;
        pixels[i + 2] = fill.b;
        pixels[i + 3] = fill.a;
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = pixels };
}

/// Read one pixel's RGBA at (x, y) -- a small reader the checks below share.
fn pixel_at(img: *const qoi.Pixmap, x: u32, y: u32) color.Rgba {
    // invariant: the read stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    return color.Rgba{ .r = img.pixels[di], .g = img.pixels[di + 1], .b = img.pixels[di + 2], .a = img.pixels[di + 3] };
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const red = color.Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 };
    const green = color.Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 };
    const blue = color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 };
    const black = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
    const white = color.Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };

    const bw = [_]color.Rgba{ black, white };
    const at_ends = [_]u8{ 0, 255 };
    const sq: u32 = 7;
    const cc: u32 = sq / 2; // the center cell (3,3)

    // A black -> white repeating conic over an odd 7x7 box with reps 2 makes each pixel's RED channel EQUAL its tiled bearing
    // (color.mix of 0 and 255 by parameter p reads back p). With two tiles the ramp cycles TWICE around the turn: the top
    // reads 0, east reads pos_max/2 = 127 (a full first tile spent by the quarter mark), south reads 0 again (the second tile
    // begins), west reads 127 -- the crux that the ramp tiled: top and south share the first control, east and west the mid.
    var img = try make_canvas(garden, sq, sq, red);
    try paint_gradient_repeat_conic(&img, 0, 0, sq, sq, 2, bw[0..], at_ends[0..]);
    if (pixel_at(&img, cc, 0).r != 0) return error.TopNotZero;
    if (pixel_at(&img, sq - 1, cc).r != 127) return error.EastNotHalf;
    if (pixel_at(&img, cc, sq - 1).r != 0) return error.SouthNotWrapped;
    if (pixel_at(&img, 0, cc).r != 127) return error.WestNotHalf;

    // The tiling is real: with reps 2 the top and the south read the SAME first control (the ramp wrapped once by halfway),
    // and the east and west read the SAME mid bearing -- a repeat the single conic (top 0, east 63, south 127, west 191) can
    // never make. This is the whole difference from image/conic_paint.rye.
    if (pixel_at(&img, cc, 0).r != pixel_at(&img, cc, sq - 1).r) return error.TilesDoNotMatchAcrossTurn;
    if (pixel_at(&img, sq - 1, cc).r != pixel_at(&img, 0, cc).r) return error.TileMidsDoNotMatch;

    // Each tile ascends clockwise then SEAMS hard: within the first tile the bearing rises top(0) < east(127) toward the seam,
    // and a cell just clockwise of the south seam reads a HIGH bearing near the end of the tile before south drops to 0.
    if (!(pixel_at(&img, cc, 0).r < pixel_at(&img, sq - 1, cc).r)) return error.TileNotAscending;
    if (!(pixel_at(&img, cc + 1, sq - 1).r > 191)) return error.PreSeamNotHighBearing;
    if (pixel_at(&img, cc, sq - 1).r != 0) return error.SeamNotFirstControl;

    // Each ray from the center is one constant wedge color: every pixel straight above the center shares the top bearing (the
    // first control), and every pixel straight below shares the south bearing (also the first control at reps 2) -- a wedge.
    const top_r = pixel_at(&img, cc, 0).r;
    var ry: u32 = 0;
    while (ry < cc) : (ry += 1) {
        if (pixel_at(&img, cc, ry).r != top_r) return error.NorthRayNotConstant;
    }
    const east_r = pixel_at(&img, sq - 1, cc).r;
    var rx: u32 = 0;
    while (rx < cc) : (rx += 1) {
        if (pixel_at(&img, sq - 1 - rx, cc).r != east_r) return error.EastRayNotConstant;
    }

    // Paint a red-green-blue repeating conic and prove it round-trips through the open QOI codec byte-for-byte -- a real image.
    const rgb = [_]color.Rgba{ red, green, blue };
    const at_even = [_]u8{ 0, 128, 255 };
    var img_rgb = try make_canvas(garden, sq, sq, white);
    try paint_gradient_repeat_conic(&img_rgb, 0, 0, sq, sq, 2, rgb[0..], at_even[0..]);
    const cap = qoi.encoded_bound(img_rgb.pixel_count());
    const dst = try garden.alloc(u8, cap);
    const enc = try qoi.encode(&img_rgb, dst);
    const back = try qoi.decode(garden, dst[0..enc.len]);
    if (!back.same_bytes(&img_rgb)) return error.SweepDidNotRoundTrip;

    // More tiles pack more wedges: at reps 4 the east bearing (T = s at east, tiled *4 mod 4s = 0) reads the first control 0
    // where reps 2 read 127 -- the same pixel changes as the winding count changes, a real control.
    var img_four = try make_canvas(garden, sq, sq, red);
    try paint_gradient_repeat_conic(&img_four, 0, 0, sq, sq, 4, bw[0..], at_ends[0..]);
    if (pixel_at(&img_four, sq - 1, cc).r != 0) return error.RepsFourEastNotWrapped;
    if (pixel_at(&img_four, sq - 1, cc).eql(pixel_at(&img, sq - 1, cc))) return error.RepsDidNotChangeSweep;

    // A sub-rectangle paints only its own box: paint a 3x3 sweep at (1,1) on a wider canvas and prove the ground around it
    // stays the untouched white (the box is honored, nothing bleeds).
    var img_sub = try make_canvas(garden, 6, 6, white);
    try paint_gradient_repeat_conic(&img_sub, 1, 1, 3, 3, 2, rgb[0..], at_even[0..]);
    if (!pixel_at(&img_sub, 0, 0).eql(white)) return error.GutterPainted;
    if (!pixel_at(&img_sub, 5, 5).eql(white)) return error.FarGutterPainted;
    if (pixel_at(&img_sub, 2, 1).eql(white)) return error.SweepTopNotPainted;

    // A non-square box still tiles: a 7x3 box reads the first control at its top-center and at its south-center (reps 2),
    // proving the winding does not assume a square (the quadrants split by sign, at any aspect).
    var img_wide = try make_canvas(garden, 7, 3, black);
    try paint_gradient_repeat_conic(&img_wide, 0, 0, 7, 3, 2, bw[0..], at_ends[0..]);
    if (pixel_at(&img_wide, 3, 0).r != 0) return error.WideTopNotFirstControl;
    if (pixel_at(&img_wide, 3, 2).r != 0) return error.WideSouthNotWrapped;

    // Refusals by name, each having painted nothing: a single-pixel box (no angular direction), a zero dimension, a reps under
    // two (that is the plain conic), a reps past the ceiling, an out-of-bounds box, and a malformed ramp (non-ascending).
    var tiny = try make_canvas(garden, 4, 4, white);
    if (paint_gradient_repeat_conic(&tiny, 0, 0, 1, 1, 2, rgb[0..], at_even[0..])) |_| return error.SinglePixelNotRefused else |err| {
        if (err != error.StripTooSmall) return error.WrongSmallError;
    }
    if (paint_gradient_repeat_conic(&tiny, 0, 0, 4, 0, 2, rgb[0..], at_even[0..])) |_| return error.ZeroDimNotRefused else |err| {
        if (err != error.BadStripDims) return error.WrongDimsError;
    }
    if (paint_gradient_repeat_conic(&tiny, 0, 0, 4, 4, 1, rgb[0..], at_even[0..])) |_| return error.SmallRepsNotRefused else |err| {
        if (err != error.RepsTooSmall) return error.WrongRepsError;
    }
    if (paint_gradient_repeat_conic(&tiny, 0, 0, 4, 4, qoi.qoi_max_dim + 1, rgb[0..], at_even[0..])) |_| return error.LargeRepsNotRefused else |err| {
        if (err != error.RepsTooLarge) return error.WrongLargeRepsError;
    }
    if (paint_gradient_repeat_conic(&tiny, 2, 0, 4, 4, 2, rgb[0..], at_even[0..])) |_| return error.OverrunNotRefused else |err| {
        if (err != error.RepeatConicOutOfBounds) return error.WrongOverrunError;
    }
    const not_asc = [_]u8{ 0, 0, 255 };
    if (paint_gradient_repeat_conic(&tiny, 0, 0, 4, 4, 2, rgb[0..], not_asc[0..])) |_| return error.BadRampNotRefused else |err| {
        if (err != error.StopsNotAscending) return error.WrongRampError;
    }
    // The refused calls painted nothing -- the tiny canvas is still all white.
    var wy: u32 = 0;
    while (wy < tiny.height) : (wy += 1) {
        var wx: u32 = 0;
        while (wx < tiny.width) : (wx += 1) {
            if (!pixel_at(&tiny, wx, wy).eql(white)) return error.RefusedButPainted;
        }
    }

    // Determinism: the same ramp painted twice grows byte-for-byte the same sweep.
    var img_a = try make_canvas(garden, sq, sq, white);
    var img_b = try make_canvas(garden, sq, sq, white);
    try paint_gradient_repeat_conic(&img_a, 0, 0, sq, sq, 2, rgb[0..], at_even[0..]);
    try paint_gradient_repeat_conic(&img_b, 0, 0, sq, sq, 2, rgb[0..], at_even[0..]);
    if (!img_a.same_bytes(&img_b)) return error.SweepNotDeterministic;

    print("GREEN image-repeat-conic-paint: a repeating conic positioned gradient painted onto a real image -- a black-to-white ramp over reps 2 makes each pixel red channel equal its tiled bearing, so the top reads 0, east 127, south 0, west 127 (the ramp cycles twice around the turn), top and south sharing the first control and east and west the mid where the single conic never could; each tile ascends clockwise then seams hard (a cell just clockwise of the south seam reads a high bearing near the end of the tile before south drops to 0); each ray from the center is one constant wedge color; a red-green-blue sweep round-trips through the open QOI codec byte-for-byte; more tiles pack more wedges (reps 4 wraps the east bearing to 0 where reps 2 read 127); a sub-rectangle paints only its own box (the ground stays white); a non-square 7x3 box still tops and wraps exactly; a single-pixel box, a zero dimension, a reps under two, a reps past the dimension ceiling, an out-of-bounds box, and a non-ascending ramp refuse by name having painted nothing; the same ramp paints the same sweep byte-for-byte\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: repeat_conic_paint selftest\n", .{});
    return 1;
}
