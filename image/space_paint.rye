//! image/space_paint.rye -- a source pattern SPACED to fill a box, whole copies with even ground gaps (Season G, the CSS background-repeat: space sibling of compose_tiled).
//!
//! Season G (Open Media Primitives) - the third and last member of the CSS `background-repeat` family. Where
//! image/compose_tiled.rye TILES a pattern edge to edge and CLIPS the boundary copy (`background-repeat: repeat`), and
//! image/place_paint.rye places ONE copy at an anchor (`background-repeat: no-repeat`), this rung tiles only WHOLE
//! copies and never clips one -- it fits as many whole patterns as the box holds, pins the first and last flush to the
//! two edges, and distributes the leftover space as EVEN GROUND GAPS between them (the CSS `background-repeat: space`
//! gesture: a row of evenly-spaced badges, a strip of logos gapped to the margins, a motif that fills a panel without a
//! seam AND without a cut). A keeper names a box and a pattern and reads back the box paved with whole copies, the
//! ground showing between and never through them.
//!
//! Compose, not braid: image/compose.rye owns the blit (paint_over_region composites a source window over a target
//! window, src-over), image/qoi.rye owns both buffers, and this module only ROUTES each whole copy to its spaced offset
//! -- no new blend math, no new codec, no new color, not even a new pixel loop. The offsets are a pure per-axis rule
//! (plan_axis): count = floor(box / unit) whole copies; copy i seats at i*unit plus its share of the total gap
//! (i*total_gap / (count-1), integer-rounded, so copy 0 seats flush at 0 and copy count-1 seats flush at box-unit, the
//! copies contiguous-or-gapped and always disjoint). Two edges honestly met: when the box holds only ONE whole copy it
//! seats at the start with the leftover as trailing ground; when the pattern is LARGER than the box a single copy is
//! clipped to the box (its top-left window), so the family's oversize rule holds here too. The whole box is
//! bound-checked ONCE up front (in u64 so a far edge can never wrap before the bound refuses), so a malformed fill
//! refuses BY NAME having painted nothing -- all-or-nothing, never a half-spaced box. No network, no key, no funds --
//! the evenly-gapped strip a surface lays the day it wants copies with air between them, on our own open geometry.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/space_paint.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const qoi = @import("qoi.rye");
const compose = @import("compose.rye");

pub const space_paint_version = "20260817.164232";

/// How whole copies of a `unit`-wide pattern seat within a `box`-wide axis: `count` whole copies, each showing `span`
/// units, with `total_gap` leftover units distributed evenly between them. Two honest edges: when no whole copy fits
/// (`unit > box`) one clipped copy shows (`count` 1, `span` the box, `total_gap` 0); otherwise `span` equals `unit` and
/// the copies never clip. Both axes share this so a fill is the same rule seen twice.
const AxisPlan = struct { count: u32, unit: u32, span: u32, total_gap: u32 };

/// Plan one axis: given a box extent `box` and a pattern extent `unit`, return how many WHOLE copies seat and the
/// leftover gap to distribute. `count` is the floor division floor(box/unit) -- the copies that fit without clipping.
/// When even one whole copy does not fit (`unit > box`, count 0) the plan falls back to ONE copy CLIPPED to the box, so
/// an oversize pattern still shows its top-left window rather than nothing (the family's oversize rule). The caller has
/// proven `box >= 1` and `unit >= 1`.
fn plan_axis(box: u32, unit: u32) AxisPlan {
    // invariant: the axis has real extent, so a fill is meaningful.
    assert(box >= 1);
    // invariant: a real pattern has extent, so the division below never divides by zero.
    assert(unit >= 1);
    const count = box / unit;
    if (count == 0) {
        // The pattern is wider than the box: one copy, clipped to the box's own extent -- its top-left window.
        // invariant: a clipped fallback shows a real, box-sized window (box < unit, so the clip is a true shorten).
        assert(box < unit);
        return .{ .count = 1, .unit = unit, .span = box, .total_gap = 0 };
    }
    // count >= 1 whole copies fit; the leftover units become the gaps distributed between them.
    const total_gap = box - count * unit;
    // invariant: the whole copies plus the gap account for the box exactly (no unit unassigned).
    assert(count * unit + total_gap == box);
    return .{ .count = count, .unit = unit, .span = unit, .total_gap = total_gap };
}

/// The start offset of whole copy `i` on a planned axis -- copy 0 flush at 0, copy `count-1` flush at `box - unit`, the
/// gap between them shared by an integer-rounded even split (`i * total_gap / (count-1)`). A single-copy plan seats at 0
/// (whether a lone whole copy with trailing ground or a clipped oversize copy). Monotonic and disjoint: consecutive
/// offsets differ by at least `unit`, so no two copies overlap.
fn axis_offset(plan: AxisPlan, i: u32) u32 {
    // invariant: the index names a real copy in the plan.
    assert(i < plan.count);
    if (plan.count == 1) return 0;
    // i < count and unit*count <= box <= qoi_max_dim, and i*total_gap <= count*total_gap <= box, so neither term wraps.
    const gap_before = (i * plan.total_gap) / (plan.count - 1);
    const off = i * plan.unit + gap_before;
    // invariant: the copy seats inside the box -- its far edge never passes the box extent.
    assert(off + plan.span <= plan.count * plan.unit + plan.total_gap);
    return off;
}

/// Fill the rectangle at (`x`, `y`) of size `w` x `h` on `target` with WHOLE copies of `pattern`, spaced so the first
/// and last copies pin flush to the box edges and the leftover shows as even ground gaps between them -- the CSS
/// `background-repeat: space` gesture. A copy is never clipped to make it fit; when only one whole copy fits it seats at
/// the start; when the pattern is larger than the box a single copy is clipped to the box. Each copy is composited
/// src-over through compose.paint_over_region, so a translucent pattern spaces over whatever lies beneath. Refuses
/// `BadSpaceDims` if `w` or `h` is zero, `EmptySource` if the pattern has no extent, `SpaceOutOfBounds` BY NAME if the
/// box exceeds the target -- all checked BEFORE any pixel, so a refusal leaves the target untouched.
pub fn paint_spaced(target: *qoi.Pixmap, x: u32, y: u32, w: u32, h: u32, pattern: *const qoi.Pixmap) !void {
    // invariant: a fillable box has real extent on both axes.
    if (w == 0 or h == 0) return error.BadSpaceDims;
    // invariant: a real pattern has extent; a zero-size pattern spaces nothing and refuses by name.
    if (pattern.width == 0 or pattern.height == 0) return error.EmptySource;
    // The box's far edges, in u64 so the sum can never wrap before the bound check refuses.
    const right: u64 = @as(u64, x) + @as(u64, w);
    const bottom: u64 = @as(u64, y) + @as(u64, h);
    if (right > @as(u64, target.width) or bottom > @as(u64, target.height)) return error.SpaceOutOfBounds;
    // invariant: the up-front check proved every pixel of the w x h box lands inside the target buffer.
    assert(right <= @as(u64, target.width));
    assert(bottom <= @as(u64, target.height));

    const px = plan_axis(w, pattern.width);
    const py = plan_axis(h, pattern.height);

    var r: u32 = 0;
    while (r < py.count) : (r += 1) {
        const lo_y = axis_offset(py, r);
        // invariant: the copy's row band stays inside the box (proven in bounds up front, so inside the target).
        assert(lo_y + py.span <= h);
        var c: u32 = 0;
        while (c < px.count) : (c += 1) {
            const lo_x = axis_offset(px, c);
            // invariant: the copy's column band stays inside the box.
            assert(lo_x + px.span <= w);
            // Route this whole (or, for an oversize pattern, once-clipped) copy to compose: its top-left window drawn
            // at the spaced corner. The box was proven in bounds up front, so this window lands inside the target.
            try compose.paint_over_region(target, x + lo_x, y + lo_y, pattern, 0, 0, px.span, py.span);
        }
    }
}

// --- selftest: prove whole copies space with even ground gaps, edges flush, oversize clips, blend true, round-trip ---

/// Mint a one-color RGBA canvas for the selftest -- a local, bounded builder so this rung leans on no higher module
/// (exactly as image/compose_tiled.rye and image/place_paint.rye keep their own canvas).
fn make_canvas(garden: std.mem.Allocator, w: u32, h: u32, fill: color.Rgba) !qoi.Pixmap {
    // invariant: a canvas has real extent within the image module's named pixel ceiling.
    assert(w >= 1);
    assert(h >= 1);
    const total: u64 = @as(u64, w) * @as(u64, h);
    assert(total <= qoi.qoi_max_pixels);
    const pixels = try garden.alloc(u8, @as(usize, @intCast(total)) * 4);
    var i: usize = 0;
    while (i < pixels.len) : (i += 4) {
        pixels[i] = fill.r;
        pixels[i + 1] = fill.g;
        pixels[i + 2] = fill.b;
        pixels[i + 3] = fill.a;
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = pixels };
}

/// Read one pixel's RGBA at (x, y) -- a small reader the checks below share.
fn pixel_at(img: *const qoi.Pixmap, x: u32, y: u32) color.Rgba {
    // invariant: the read stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    return color.Rgba{ .r = img.pixels[di], .g = img.pixels[di + 1], .b = img.pixels[di + 2], .a = img.pixels[di + 3] };
}

/// Set one pixel's RGBA at (x, y) -- a small writer the pattern builder shares.
fn set_pixel(img: *qoi.Pixmap, x: u32, y: u32, c: color.Rgba) void {
    // invariant: the write stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    img.pixels[di] = c.r;
    img.pixels[di + 1] = c.g;
    img.pixels[di + 2] = c.b;
    img.pixels[di + 3] = c.a;
}

/// Count pixels of `img` whose RGBA differs from `bg` -- the honest measure of how much a fill covered (the ground gaps
/// stay `bg`, so this counts only the painted copies).
fn changed_from(img: *const qoi.Pixmap, bg: color.Rgba) u32 {
    // invariant: the buffer is four bytes per pixel -- the RGBA invariant a Pixmap carries.
    assert(img.pixels.len % 4 == 0);
    var n: u32 = 0;
    var i: usize = 0;
    while (i < img.pixels.len) : (i += 4) {
        const px = color.Rgba{ .r = img.pixels[i], .g = img.pixels[i + 1], .b = img.pixels[i + 2], .a = img.pixels[i + 3] };
        if (!px.eql(bg)) n += 1;
    }
    // invariant: the changed count never exceeds the pixels walked.
    assert(n <= @as(u32, @intCast(img.pixels.len / 4)));
    return n;
}

/// Mint a 2x2 four-color pattern -- red, green at the top; blue, black at the bottom -- so a spaced copy is checkable
/// by which of the four corners a target pixel matches.
fn make_pattern(garden: std.mem.Allocator) !qoi.Pixmap {
    var p = try make_canvas(garden, 2, 2, color.Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 });
    set_pixel(&p, 0, 0, color.Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 }); // red
    set_pixel(&p, 1, 0, color.Rgba{ .r = 0, .g = 255, .b = 0, .a = 255 }); // green
    set_pixel(&p, 0, 1, color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 255 }); // blue
    set_pixel(&p, 1, 1, color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 }); // black
    return p;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const white = color.Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };
    const red = color.Rgba{ .r = 255, .g = 0, .b = 0, .a = 255 };
    const black = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };

    const pattern = try make_pattern(garden); // 2x2: red, green / blue, black

    // --- an EXACT fit spaces with no gap: a 2x2 pattern fills a 4x4 box as a 2x2 grid of WHOLE copies ------------------
    // count 2 each axis, total_gap 0 -- identical to a clean repeat, but every copy is whole (none clipped).
    var img = try make_canvas(garden, 4, 4, white);
    try paint_spaced(&img, 0, 0, 4, 4, &pattern);
    var ty: u32 = 0;
    while (ty < 4) : (ty += 1) {
        var tx: u32 = 0;
        while (tx < 4) : (tx += 1) {
            const want = pixel_at(&pattern, tx % 2, ty % 2); // exact fit repeats by a pure modulo
            if (!pixel_at(&img, tx, ty).eql(want)) return error.ExactColourWrong;
        }
    }
    if (!pixel_at(&img, 3, 3).eql(black)) return error.ExactFarWrong; // the far copy is a full fresh pattern
    if (changed_from(&img, white) != 16) return error.ExactFootprintWrong; // no ground left on an exact fit

    // --- a leftover axis SPACES the copies, the gap showing GROUND between them ---------------------------------------
    // Box 5 wide x 2 tall, pattern 2x2: cols count floor(5/2)=2, total_gap 1, one gap. Copy 0 at x=0, copy 1 at
    // x = 2 + (1*1)/1 = 3, so copies occupy [0,2) and [3,5); the column x=2 is the ground gap between them.
    var img_sp = try make_canvas(garden, 5, 2, white);
    try paint_spaced(&img_sp, 0, 0, 5, 2, &pattern);
    if (!pixel_at(&img_sp, 0, 0).eql(red)) return error.SpaceFirstWrong; // copy 0 flush at the left edge, its (0,0)
    if (!pixel_at(&img_sp, 2, 0).eql(white)) return error.SpaceGapNotGround; // the gap column stays ground
    if (!pixel_at(&img_sp, 2, 1).eql(white)) return error.SpaceGapNotGround;
    if (!pixel_at(&img_sp, 3, 0).eql(red)) return error.SpaceLastWrong; // copy 1's own (0,0)
    if (!pixel_at(&img_sp, 4, 1).eql(black)) return error.SpaceLastFarWrong; // copy 1 flush to the right edge, its (1,1)
    if (changed_from(&img_sp, white) != 8) return error.SpaceFootprintWrong; // two whole 2x2 copies = 8, the gap ground

    // --- only ONE whole copy fits: it seats at the start, the leftover trailing as ground ------------------------------
    // Box 3 wide x 2 tall, pattern 2x2: floor(3/2)=1 copy at x=0, the column x=2 trailing ground.
    var img_one = try make_canvas(garden, 3, 2, white);
    try paint_spaced(&img_one, 0, 0, 3, 2, &pattern);
    if (!pixel_at(&img_one, 0, 0).eql(red)) return error.OneStartWrong; // the lone copy seats flush at the start
    if (!pixel_at(&img_one, 1, 1).eql(black)) return error.OneFarWrong;
    if (!pixel_at(&img_one, 2, 0).eql(white)) return error.OneTrailNotGround; // the leftover trails as ground
    if (changed_from(&img_one, white) != 4) return error.OneFootprintWrong; // exactly one 2x2 copy

    // --- a pattern LARGER than its box: a single copy CLIPPED to the box (its top-left window) -------------------------
    var img_big = try make_canvas(garden, 1, 1, white);
    try paint_spaced(&img_big, 0, 0, 1, 1, &pattern);
    if (!pixel_at(&img_big, 0, 0).eql(red)) return error.OversizeClipWrong; // the pattern's own (0,0), clipped to 1x1

    // --- a translucent pattern spaces over its ground: a half-alpha copy blends src-over, not overwrites ---------------
    const blue_half = color.Rgba{ .r = 0, .g = 0, .b = 255, .a = 128 };
    var p_trans = try make_canvas(garden, 2, 2, blue_half);
    var img_blend = try make_canvas(garden, 4, 4, white);
    try paint_spaced(&img_blend, 0, 0, 4, 4, &p_trans); // exact fit -> every pixel a copy
    const blended = color.over(blue_half, white);
    if (blended.eql(blue_half) or blended.eql(white)) return error.BlendNotBetween; // a real blend, not either pole
    if (!pixel_at(&img_blend, 0, 0).eql(blended)) return error.SpaceBlendWrong;
    if (!pixel_at(&img_blend, 3, 3).eql(blended)) return error.SpaceBlendWrong;

    // --- the spaced image round-trips through the open QOI codec byte-for-byte -- a real image, not a private buffer ---
    const cap = qoi.encoded_bound(img_sp.pixel_count());
    const dst = try garden.alloc(u8, cap);
    const enc = try qoi.encode(&img_sp, dst);
    const back = try qoi.decode(garden, dst[0..enc.len]);
    if (!back.same_bytes(&img_sp)) return error.SpaceDidNotRoundTrip;

    // --- a sub-rectangle spaces only its own box: a spaced fill at (1,1) leaves the surrounding gutters untouched ------
    var img_sub = try make_canvas(garden, 7, 4, white);
    try paint_spaced(&img_sub, 1, 1, 5, 2, &pattern); // same 5x2 space as above, shifted into the interior
    if (!pixel_at(&img_sub, 0, 0).eql(white)) return error.CornerGutterSpaced;
    if (!pixel_at(&img_sub, 6, 3).eql(white)) return error.FarGutterSpaced;
    if (!pixel_at(&img_sub, 1, 1).eql(red)) return error.SubStartWrong; // the box's own (0,0) copy
    if (!pixel_at(&img_sub, 3, 1).eql(white)) return error.SubGapNotGround; // the gap column, now at x=3

    // --- refusals by name, each having painted nothing ---------------------------------------------------------------
    var tgt = try make_canvas(garden, 4, 4, white);
    if (paint_spaced(&tgt, 0, 0, 4, 0, &pattern)) |_| return error.ZeroDimsNotRefused else |err| {
        if (err != error.BadSpaceDims) return error.WrongDimsError;
    }
    var empty = qoi.Pixmap{ .width = 0, .height = 0, .channels = 4, .colorspace = 0, .pixels = &[_]u8{} };
    if (paint_spaced(&tgt, 0, 0, 4, 4, &empty)) |_| return error.EmptySourceNotRefused else |err| {
        if (err != error.EmptySource) return error.WrongEmptyError;
    }
    if (paint_spaced(&tgt, 2, 0, 4, 4, &pattern)) |_| return error.OverrunNotRefused else |err| {
        if (err != error.SpaceOutOfBounds) return error.WrongOverrunError; // 2+4 = 6 > width 4
    }
    if (changed_from(&tgt, white) != 0) return error.RefusedButPainted; // every refusal painted nothing

    // --- determinism: the same fill spaces the same copies byte-for-byte ----------------------------------------------
    var img_a = try make_canvas(garden, 5, 2, white);
    var img_b = try make_canvas(garden, 5, 2, white);
    try paint_spaced(&img_a, 0, 0, 5, 2, &pattern);
    try paint_spaced(&img_b, 0, 0, 5, 2, &pattern);
    if (!img_a.same_bytes(&img_b)) return error.SpaceNotDeterministic;

    print("GREEN image-space: a source pattern spaced to fill a box with whole copies and even ground gaps -- an exact 2x2 pattern fills a 4x4 box as a 2x2 grid of whole copies with no ground left; a 5x2 box holding two whole copies pins them flush to the left and right edges (copy 0 at x=0, copy 1 at x=3) and shows the middle column as ground gap between them; a 3x2 box holding one whole copy seats it at the start with the leftover trailing as ground; a 2x2 pattern larger than a 1x1 box shows a single copy clipped to the box (its top-left window); a translucent pattern blends src-over uniform on an exact fill; the spaced image round-trips through the open QOI codec byte-for-byte; a sub-rectangle spaces only its own box (the gutters stay ground); a zero dimension, an empty pattern, and an out-of-bounds box refuse by name having painted nothing; the same fill spaces the same copies byte-for-byte\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: space_paint selftest\n", .{});
    return 1;
}
