//! image/crop_gesture.rye — HUNK60: drag a rectangle on the picture, lift, and it becomes a crop edit.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK60.
//! Design read: active-designing/20260813-222800_hunk-crop-gesture-exploration.md
//! Teacher, thanked clean-room: the crop gesture of a photo app (iCloud Photos / Google Photos) — a keeper drags a
//! rectangle over the picture and the app crops to it (concept only, siloed).
//!
//! HUNK3 gave the Photos app a pure `crop` verb, and the itinerary names cropping the crux gesture of the app — yet a
//! keeper could only crop by naming four numbers, never by dragging a rectangle. This rung is that gesture. `CropGesture`
//! owns the image dimensions and a drag (HUNK50's down/move/up law) in IMAGE pixels: press sets an anchor corner, a
//! sweep moves the opposite corner, and lift settles the rectangle. It normalizes any drag direction to a top-left
//! rectangle (`min`/`max` of the two corners), clamps both corners inside the image, and turns the result into a
//! `.crop` edit a keeper's cursor can `push` — so a dragged crop joins the same non-destructive history as every other
//! verb. `preview` applies the rectangle to the source for a live look at what commit will produce. A degenerate drag
//! (zero width or height) commits nothing, refusing `NoRect` by name rather than an empty crop. A pure composition over
//! HUNK3's `crop` and HUNK11's edit vocabulary — no new pixel op, no new failure mode of its own. No network, no key,
//! no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/crop_gesture.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const edits = @import("photo_edits.rye");
const photos = @import("photos.rye");

pub const crop_gesture_version = "20260813.222800";

pub const CropGestureError = error{
    BadImage,
    NoRect,
};

/// A normalized crop rectangle in image pixels — a top-left corner and a size, the shape HUNK3's `crop` takes. Produced
/// from the two dragged corners; `w` or `h` of zero means the drag named no area to keep.
pub const CropRect = struct {
    x: u32,
    y: u32,
    w: u32,
    h: u32,
};

/// A drag-to-crop surface over one image: it owns the image's `width`×`height` (the bounds every corner clamps into) and
/// the two corners of the drag, in image pixels. The governing law: press anchors one corner, each sweep moves the
/// opposite corner, lift settles both; the rectangle is always `min`/`max` of the two corners clamped inside the image,
/// so a drag in any direction names the same top-left rectangle and no corner ever falls outside the picture. It invents
/// no pixel op (HUNK3's `crop`) and no edit (HUNK11's vocabulary); it only turns a drag into the four numbers `crop`
/// already takes.
pub const CropGesture = struct {
    width: u32,
    height: u32,
    dragging: bool = false,
    ax: u32 = 0, // the anchor corner, set at press
    ay: u32 = 0,
    bx: u32 = 0, // the opposite corner, moved by each sweep
    by: u32 = 0,

    /// Open a crop surface over a `width`×`height` image, refusing `BadImage` on a zero dimension (no area to crop from).
    /// The drag opens unarmed; the rectangle is built by `finger_down` then `finger_move`/`finger_up`.
    pub fn open(width: u32, height: u32) CropGestureError!CropGesture {
        // invariant: an image has real area, so a corner has somewhere to clamp into.
        if (width == 0 or height == 0) return error.BadImage;
        assert(width >= 1);
        assert(height >= 1);
        return CropGesture{ .width = width, .height = height };
    }

    /// Clamp an x pixel into `[0, width]` — the right edge is inclusive, so a corner may rest on `width` (the exclusive
    /// right boundary) and a rectangle can reach the last column. A negative x rests on the left edge.
    fn clamp_x(self: *const CropGesture, x: i32) u32 {
        if (x < 0) return 0;
        const ux: u32 = @intCast(x);
        return if (ux > self.width) self.width else ux;
    }

    /// Clamp a y pixel into `[0, height]` — the bottom edge inclusive, mirroring `clamp_x`.
    fn clamp_y(self: *const CropGesture, y: i32) u32 {
        if (y < 0) return 0;
        const uy: u32 = @intCast(y);
        return if (uy > self.height) self.height else uy;
    }

    /// A finger presses at image pixel `(x, y)`: arm the drag and set BOTH corners to the clamped press point, so a press
    /// with no sweep names a zero-area rectangle (a tap crops nothing). Every corner stays inside the image.
    pub fn finger_down(self: *CropGesture, x: i32, y: i32) void {
        self.dragging = true;
        self.ax = self.clamp_x(x);
        self.ay = self.clamp_y(y);
        self.bx = self.ax;
        self.by = self.ay;
        // invariant: an armed drag has both corners clamped inside the image.
        assert(self.dragging);
        assert(self.ax <= self.width and self.ay <= self.height);
        assert(self.bx <= self.width and self.by <= self.height);
    }

    /// The finger sweeps to `(x, y)`: while armed, move the opposite corner to the clamped point — the anchor stays put,
    /// so the rectangle grows and shrinks under the finger. A move with no press before it (not armed) moves nothing
    /// (HUNK50's arming law).
    pub fn finger_move(self: *CropGesture, x: i32, y: i32) void {
        if (!self.dragging) return;
        self.bx = self.clamp_x(x);
        self.by = self.clamp_y(y);
        // invariant: an armed move keeps the opposite corner inside the image.
        assert(self.bx <= self.width and self.by <= self.height);
    }

    /// The finger lifts at `(x, y)`: settle the opposite corner and disarm. A lift only follows a press. The rectangle is
    /// whatever `rect` now reads; a degenerate one is refused only at `as_edit`/`preview`, so `finger_up` never fails.
    pub fn finger_up(self: *CropGesture, x: i32, y: i32) void {
        // invariant: a lift only follows a landed finger.
        assert(self.dragging);
        self.bx = self.clamp_x(x);
        self.by = self.clamp_y(y);
        self.dragging = false;
        // invariant: the surface disarmed with both corners inside the image.
        assert(!self.dragging);
        assert(self.bx <= self.width and self.by <= self.height);
    }

    /// The normalized rectangle the two corners currently name: top-left `min` of the corners, size their `max` minus
    /// `min`. Always inside the image by the corner clamps, so `x + w <= width` and `y + h <= height`. A `w` or `h` of
    /// zero means the drag named no area. Pure — reads the corners, moves nothing.
    pub fn rect(self: *const CropGesture) CropRect {
        const left: u32 = if (self.ax < self.bx) self.ax else self.bx;
        const right: u32 = if (self.ax > self.bx) self.ax else self.bx;
        const top: u32 = if (self.ay < self.by) self.ay else self.by;
        const bottom: u32 = if (self.ay > self.by) self.ay else self.by;
        const r = CropRect{ .x = left, .y = top, .w = right - left, .h = bottom - top };
        // invariant: the rectangle sits wholly inside the image — exactly what HUNK3's crop requires of x+w, y+h.
        assert(@as(u64, r.x) + @as(u64, r.w) <= self.width);
        assert(@as(u64, r.y) + @as(u64, r.h) <= self.height);
        return r;
    }

    /// True when the current rectangle has real area — the drag named something to keep.
    pub fn has_rect(self: *const CropGesture) bool {
        const r = self.rect();
        return r.w > 0 and r.h > 0;
    }

    /// Turn the current rectangle into a `.crop` edit a keeper's cursor can `push`, so a dragged crop joins the same
    /// non-destructive history as every other verb. Refuses `NoRect` when the drag named no area (a tap, a zero-width or
    /// zero-height sweep) — a crop of nothing is never committed. The returned edit is in-bounds by construction, so its
    /// later `apply` cannot raise `OutOfBounds`.
    pub fn as_edit(self: *const CropGesture) CropGestureError!edits.Edit {
        const r = self.rect();
        if (r.w == 0 or r.h == 0) return error.NoRect;
        // invariant: the committed rectangle is a real, in-bounds area.
        assert(r.w >= 1 and r.h >= 1);
        assert(@as(u64, r.x) + @as(u64, r.w) <= self.width);
        assert(@as(u64, r.y) + @as(u64, r.h) <= self.height);
        return edits.Edit{ .crop = .{ .x = r.x, .y = r.y, .w = r.w, .h = r.h } };
    }

    /// A live preview of what committing the crop will produce: apply the current rectangle to `source` through HUNK3's
    /// `crop`. Refuses `NoRect` on a degenerate rectangle, so a preview never shows an empty image. Pure — `source` is
    /// never mutated; the cropped pixmap is a fresh allocation.
    pub fn preview(self: *const CropGesture, allocator: std.mem.Allocator, source: *const qoi.Pixmap) !qoi.Pixmap {
        // invariant: the preview crops the very image the gesture was opened over.
        assert(source.width == self.width);
        assert(source.height == self.height);
        const r = self.rect();
        if (r.w == 0 or r.h == 0) return error.NoRect;
        return photos.crop(allocator, source, r.x, r.y, r.w, r.h);
    }
};

// --- selftest: an 8x8 two-tone source — a drag from (2,2) to (6,6) commits crop{2,2,4,4} whose preview equals a direct
//     crop cell-for-cell and whose edit round-trips the vocabulary; a reverse drag normalizes the same; corners past the
//     edges clamp to the whole image; a tap and a zero-width sweep refuse NoRect; an unarmed move moves nothing; a bad
//     image refuses at open ---------------------------------------------------------------------------------------------

fn craft_two_tone(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 8;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const left = x < w / 2;
            buf[off] = if (left) 255 else 0; // r
            buf[off + 1] = @intCast(x * 8); // g — a per-column gradient so a mis-placed crop would show
            buf[off + 2] = if (left) 0 else 255; // b
            buf[off + 3] = 255; // a
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

fn same_bytes(a: *const qoi.Pixmap, b: *const qoi.Pixmap) bool {
    if (a.width != b.width or a.height != b.height) return false;
    if (a.pixels.len != b.pixels.len) return false;
    var i: usize = 0;
    while (i < a.pixels.len) : (i += 1) {
        if (a.pixels[i] != b.pixels[i]) return false;
    }
    return true;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_two_tone(garden);

    var g = try CropGesture.open(pm.width, pm.height);

    // A drag from (2,2) to (6,6): press, sweep, lift. The rectangle is crop{2,2,4,4}, and its live preview equals a
    // direct crop cell-for-cell — the dragged rectangle is exactly what commit produces.
    {
        g.finger_down(2, 2);
        assert(!g.has_rect()); // a press alone names no area yet
        g.finger_move(4, 4);
        g.finger_move(6, 6);
        assert(g.has_rect());
        g.finger_up(6, 6);
        const r = g.rect();
        assert(r.x == 2 and r.y == 2 and r.w == 4 and r.h == 4);

        const live = try g.preview(garden, &pm);
        const direct = try photos.crop(garden, &pm, 2, 2, 4, 4);
        assert(live.width == 4 and live.height == 4);
        assert(same_bytes(&live, &direct)); // the preview is the crop, no drift

        // The edit round-trips the vocabulary: push it, render, parse, apply — the same cropped image returns.
        const e = try g.as_edit();
        var list = edits.EditList.init();
        try list.push(e);
        var buf: [edits.max_edits_bytes]u8 = undefined;
        const n = try edits.render_edits(&list, &buf);
        var parsed = edits.EditList.init();
        try edits.parse_edits(buf[0..n], &parsed);
        assert(parsed.count == 1);
        const applied = try edits.apply(garden, &pm, &parsed);
        assert(same_bytes(&applied, &direct)); // a dragged crop is a first-class edit
    }

    // A reverse drag (bottom-right to top-left) normalizes to the SAME rectangle — direction never matters.
    {
        var rg = try CropGesture.open(pm.width, pm.height);
        rg.finger_down(6, 6);
        rg.finger_move(2, 2);
        rg.finger_up(2, 2);
        const r = rg.rect();
        assert(r.x == 2 and r.y == 2 and r.w == 4 and r.h == 4);
    }

    // Corners past the edges clamp to the whole image: a drag from far off the top-left to far off the bottom-right keeps
    // the whole 8x8 picture, never a rectangle larger than the image.
    {
        var wg = try CropGesture.open(pm.width, pm.height);
        wg.finger_down(-50, -50);
        wg.finger_move(500, 500);
        wg.finger_up(500, 500);
        const r = wg.rect();
        assert(r.x == 0 and r.y == 0 and r.w == 8 and r.h == 8);
        const whole = try wg.preview(garden, &pm);
        assert(same_bytes(&whole, &pm)); // cropping to the whole image recovers the source
    }

    // A tap (press and lift at one point) names no area — it refuses NoRect rather than committing an empty crop.
    {
        var tg = try CropGesture.open(pm.width, pm.height);
        tg.finger_down(3, 3);
        tg.finger_up(3, 3);
        assert(!tg.has_rect());
        if (tg.as_edit()) |_| return error.RectSlipped else |e| {
            if (e != error.NoRect) return error.WrongRect;
        }
        if (tg.preview(garden, &pm)) |_| return error.RectSlipped else |e| {
            if (e != error.NoRect) return error.WrongRect;
        }
    }

    // A zero-width sweep (a vertical line) names no area either — a crop needs both dimensions.
    {
        var zg = try CropGesture.open(pm.width, pm.height);
        zg.finger_down(2, 2);
        zg.finger_move(2, 6); // same x, so w == 0
        zg.finger_up(2, 6);
        assert(!zg.has_rect());
        if (zg.as_edit()) |_| return error.RectSlipped else |e| {
            if (e != error.NoRect) return error.WrongRect;
        }
    }

    // A move with no press before it moves nothing — the arming law (HUNK50): a fresh surface, a move without a down, the
    // corners still at the origin.
    {
        var fg = try CropGesture.open(pm.width, pm.height);
        fg.finger_move(5, 5);
        assert(fg.ax == 0 and fg.ay == 0 and fg.bx == 0 and fg.by == 0);
        assert(!fg.dragging);
    }

    // A bad image refuses at open by name — a zero dimension has no area to crop from.
    if (CropGesture.open(0, 8)) |_| return error.ImageSlipped else |e| {
        if (e != error.BadImage) return error.WrongImage;
    }
    if (CropGesture.open(8, 0)) |_| return error.ImageSlipped else |e| {
        if (e != error.BadImage) return error.WrongImage;
    }

    print("GREEN crop-gesture: an 8x8 two-tone source — a drag from (2,2) to (6,6) commits crop{{2,2,4,4}} whose live " ++
        "preview equals a direct crop cell-for-cell and whose edit round-trips render/parse/apply to the same cropped " ++
        "image (a dragged crop is a first-class, non-destructive edit); a reverse drag normalizes to the same rectangle " ++
        "(direction never matters); corners past the edges clamp to the whole image (cropping to it recovers the " ++
        "source); a tap and a zero-width sweep each refuse NoRect rather than commit an empty crop; a move with no press " ++
        "moves nothing; a zero-dimension image refuses BadImage at open. HUNK3 crop, HUNK11 edit vocabulary GREEN " ++
        "beneath; no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: crop_gesture selftest\n", .{});
    return 1;
}
