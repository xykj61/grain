//! image/font5x7_accented.rye -- the unifying accented-Latin font: the four accent corpora merged into one table.
//!
//! Season G (Open Media Primitives) - the finishing rung of the accented-letter family, the parallel of
//! image/font5x7_ascii.rye for the marks ASCII cannot spell. The accented corpora landed one at a time -- the
//! acute/cedilla set (font5x7_latin1.rye, eight letters), the grave vowels (font5x7_grave.rye, five), the circumflex
//! vowels (font5x7_circumflex.rye, five), and the German letters (font5x7_german.rye, the two remaining umlauts and the
//! eszett, three) -- each proven on metal in its own hand-drawn corpus. This module gathers all four into a single gfa1
//! atlas covering the twenty-one accented lowercase Latin letters a Romance, French, Italian, Portuguese, or German
//! name reaches for, our own hand end to end, permissively ours, no external font to license. This is the table a
//! surface actually reaches for when it prints a name ASCII folds -- one lookup Dexter, Scooter, Skate, and Brushstroke
//! read the day they want an accented letter, rather than four corpora to stitch by hand.
//!
//! The distinctive crux this module proves, beyond the round-trip each corpus already proves: the merged codepoints run
//! STRICTLY ASCENDING WITH NO DUPLICATE across the accented set, and the merged count equals the SUM of the four corpora
//! (8 + 5 + 5 + 3 = 21). Those two facts together prove the corpora are DISJOINT -- no two claim the same codepoint, so
//! the four sets compose into one font with no collision and no letter lost. Unlike the ASCII font this band is NOT
//! contiguous (it skips the unaccented letters between the accented ones in the Latin-1 Supplement block), so the proof
//! is ascending-and-unique rather than contiguous; every glyph carries ink (there is no blank in an accented set).
//! decode(encode()) recovers the whole font byte-for-byte. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_accented.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");
const latin1 = @import("font5x7_latin1.rye");
const grave = @import("font5x7_grave.rye");
const circumflex = @import("font5x7_circumflex.rye");
const german = @import("font5x7_german.rye");

pub const font5x7_accented_version = "20260817.061103";

/// The whole family shares one 5x7 cell -- the corpora agree on this, and this module asserts the agreement.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance every glyph carries: the cell width plus one column of daylight.
pub const glyph_advance: u8 = cell_w + 1;

/// Cells per glyph -- the coverage length every glyph carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The unifying count -- the sum of the four accented corpora: acute/cedilla (8), grave (5), circumflex (5), German (3).
/// Named from the corpora's own counts, so a corpus that grows without this sum growing fails the fill assert below.
pub const accented_count: u32 = latin1.latin1_count + grave.grave_count + circumflex.circumflex_count + german.german_count;

/// Lift one corpus atlas's glyphs into the combined table starting at `dst_off`, asserting each shares the cell and
/// advance. Returns the next free offset. The gathered coverage slices are borrowed from the source atlas, which
/// lives in the same arena -- no copy, and the merge sort below reorders references, never bytes.
fn gather(dst: []glyph.Glyph, dst_off: u32, src: *const glyph.GlyphAtlas) u32 {
    // invariant: the source shares this family's cell -- a corpus at a different size would corrupt the font.
    assert(src.cell_w == cell_w);
    assert(src.cell_h == cell_h);
    const n: u32 = @intCast(src.glyphs.len);
    // invariant: the gathered run fits inside the combined table.
    assert(dst_off + n <= accented_count);
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        const g = src.glyphs[i];
        // invariant: every merged glyph carries the shared advance, so every accented letter lays out alike.
        assert(g.advance == glyph_advance);
        assert(g.coverage.len == cell_area);
        dst[dst_off + i] = g;
    }
    return dst_off + n;
}

/// Build the unifying accented-Latin font: merge the four corpora, then sort the whole table strictly ascending by
/// codepoint. The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area), and
/// the selftest proves the band is ascending-and-unique with the merged count equal to the sum of the four corpora.
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the family cell matches the atlas ceiling it must fit under, and the count fits the glyph ceiling.
    assert(cell_area <= glyph.coverage_max);
    assert(accented_count <= glyph.glyph_max);
    // invariant: the unifying count is the sum the four corpora name -- 21 letters, no more.
    assert(accented_count == 21);

    const glyphs = try allocator.alloc(glyph.Glyph, accented_count);
    var off: u32 = 0;

    // Gather the four proven corpora. Order of gathering does not matter -- the sort below places every glyph.
    const l1_atlas = try latin1.build_atlas(allocator);
    off = gather(glyphs, off, &l1_atlas);
    const gr_atlas = try grave.build_atlas(allocator);
    off = gather(glyphs, off, &gr_atlas);
    const cx_atlas = try circumflex.build_atlas(allocator);
    off = gather(glyphs, off, &cx_atlas);
    const de_atlas = try german.build_atlas(allocator);
    off = gather(glyphs, off, &de_atlas);

    // invariant: the four corpora fill the table exactly -- a short count would mean a lost corpus.
    assert(off == accented_count);

    // Insertion sort by codepoint -- bounded by accented_count, stable, and small (twenty-one glyphs). The gfa1
    // encoder demands strictly ascending codepoints; this is where the four corpora become one ordered font.
    var i: u32 = 1;
    while (i < accented_count) : (i += 1) {
        const key = glyphs[i];
        var j: u32 = i;
        while (j > 0 and glyphs[j - 1].codepoint > key.codepoint) : (j -= 1) {
            glyphs[j] = glyphs[j - 1];
        }
        glyphs[j] = key;
    }

    // invariant: the sorted table opens at the eszett (U+00DF, the lowest accented codepoint) and closes at the u
    // diaeresis (U+00FC, the highest) -- the accented band, end to end.
    assert(glyphs[0].codepoint == 0x00DF);
    assert(glyphs[accented_count - 1].codepoint == 0x00FC);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- every accented letter carries ink; none is blank.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

// --- selftest: build the accented font, round-trip it through gfa1, prove ascending-and-unique and disjoint corpora ---

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built font is the twenty-one-glyph accented set at the shared cell.
    assert(glyph_count == accented_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // The disjointness crux: the merged codepoints run STRICTLY ASCENDING with NO DUPLICATE. Since the merged count is
    // the sum of the four corpora (asserted 21 in build_atlas), strictly-ascending here proves the corpora are disjoint
    // -- no two claim the same codepoint, so a collision (two corpora drawing one letter) would fail here.
    var e: u32 = 1;
    while (e < glyph_count) : (e += 1) {
        if (!(atlas.glyphs[e].codepoint > atlas.glyphs[e - 1].codepoint)) return error.CodepointsNotStrictlyAscending;
    }

    // Every accented letter the four corpora drew looks up present through the decoded font and carries the shared
    // advance. The full merged set, checked one codepoint at a time.
    const all = [accented_count]u32{
        0x00DF, 0x00E0, 0x00E1, 0x00E2, 0x00E4, 0x00E7, 0x00E8, 0x00E9, 0x00EA, 0x00EC, 0x00ED,
        0x00EE, 0x00F1, 0x00F2, 0x00F3, 0x00F4, 0x00F6, 0x00F9, 0x00FA, 0x00FB, 0x00FC,
    };
    var a: u32 = 0;
    while (a < accented_count) : (a += 1) {
        if (back.lookup(all[a])) |g| {
            assert(g.codepoint == all[a]);
            assert(g.advance == glyph_advance);
        } else return error.AccentedLetterMissing;
    }

    // A plain ASCII 'a' misses -- this font is the accented set, not the base letters. And an accented codepoint no
    // corpus drew (U+00E3, a tilde) misses too -- the font holds exactly what the four corpora drew, no phantom glyph.
    if (back.lookup('a')) |_| return error.BaseLetterFound else {}
    if (back.lookup(0x00E3)) |_| return error.PhantomAccentedFound else {}

    // Every glyph carries ink -- unlike the ASCII font there is no blank space in an accented set.
    var k: u32 = 0;
    while (k < glyph_count) : (k += 1) {
        if (ink_count(atlas.glyphs[k].coverage) == 0) return error.AccentedGlyphBlank;
    }

    // Compression is reported as a fact, not asserted -- the round-trip is the proof (the REDS %82 lesson).
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-accented: {d} accented Latin letters U+00DF..U+00FC (non-contiguous) at {d}x{d} round-trip byte-identical; codepoints strictly ascending and unique (the four corpora disjoint: 8+5+5+3), every glyph inked, a base 'a' and an undrawn a-tilde both absent; encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_accented selftest\n", .{});
    return 1;
}
