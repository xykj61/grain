//! image/font5x7_boxdiag.rye -- the open box-drawing corpus: the light diagonal set (Season G, font content).
//!
//! Season G (Open Media Primitives) - the third content beyond printable ASCII for the open glyph atlas
//! image/glyph.rye (gfa1), completing the box-drawing family the light set (image/font5x7_box.rye, U+2500..U+253C) and
//! the double set (image/font5x7_boxdouble.rye, U+2550..U+256C) began. Where those two frame and rule with straight
//! lines, this corpus draws the three light DIAGONAL marks -- the forward slash, the backslash, and their cross -- at
//! their real Unicode codepoints U+2571..U+2573. These are the marks a terminal surface (the Dexter/Scooter family)
//! reaches for to strike through a cell, hatch a region, or mark an X, drawn in our own open hand on the same 5x7 body.
//!
//! The source stays plain ASCII (ASCII-first): the codepoints are written as numeric literals (0x2571 ...) and each
//! mark is named in an ASCII comment, so no non-ASCII byte enters the file even though the glyphs it builds cover a
//! non-ASCII range. The three codepoints are contiguous, yet the corpus carries an explicit ascending table like its
//! siblings -- the shape the gfa1 encoder trusts (strictly ascending, shared cell, coverage length == cell area). The
//! drawings ARE the specification: each mark is seven rows of five cells in ASCII line art ('#' full ink, '.' none),
//! the pen stepping from corner to corner so a straight-line diagonal crosses the 5x7 body, that a reader audits by
//! eye; the coverage bytes are derived from that art, never the reverse. build_atlas turns the three drawings into a
//! glyph.GlyphAtlas the gfa1 encoder accepts, so the property that matters stays provable on metal:
//! decode(encode(atlas)) recovers every glyph byte-for-byte, the marks are present and distinct, and each reads within
//! an honest legibility band. One structural property earns its own proof: the cross is exactly the two single
//! diagonals overlaid, so a cell is inked in the cross when either single diagonal inks it (a union), which is what
//! makes the three a true family rather than three unrelated drawings. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_boxdiag.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

pub const font5x7_boxdiag_version = "20260817.013000";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the sibling box corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const boxdiag_advance: u8 = cell_w + 1;

/// The corpus holds exactly the three light diagonal box marks named in the table below.
pub const boxdiag_count: u32 = 3;

/// Cells per glyph -- the coverage length every mark carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The three light diagonal codepoints, strictly ascending -- the order the gfa1 encoder trusts. Each aligns by index
/// with boxdiag_art below. Written as numeric literals so the source stays plain ASCII while the glyphs cover a
/// non-ASCII range:
///   0x2571 diagonal upper-right to lower-left (the forward slash),
///   0x2572 diagonal upper-left to lower-right (the backslash),
///   0x2573 diagonal cross (the two overlaid).
const boxdiag_codepoints = [boxdiag_count]u32{
    0x2571, 0x2572, 0x2573,
};

/// The three marks, drawn in the open. Each is seven rows of five cells; '#' ink, '.' background. A single diagonal
/// steps one cell down each row while crossing the five columns corner to corner; the cross overlays both. A reader
/// audits every mark here by eye, and the coverage bytes are lifted from this art, never guessed.
const boxdiag_art = [boxdiag_count][cell_h][]const u8{
    .{ "....#", "...#.", "...#.", "..#..", ".#...", ".#...", "#...." }, // U+2571 upper-right to lower-left (/)
    .{ "#....", ".#...", ".#...", "..#..", "...#.", "...#.", "....#" }, // U+2572 upper-left to lower-right (\)
    .{ "#...#", ".#.#.", ".#.#.", "..#..", ".#.#.", ".#.#.", "#...#" }, // U+2573 diagonal cross (X)
};

/// Lift one mark's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad glyph.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the diagonal atlas: three glyphs at the named ascending codepoints, sharing the 5x7 cell and advance. The
/// gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the three named diagonal marks and no more.
    assert(boxdiag_count == 3);
    assert(cell_area == 35);
    const glyphs = try allocator.alloc(glyph.Glyph, boxdiag_count);
    var i: u32 = 0;
    var last_cp: u32 = 0;
    while (i < boxdiag_count) : (i += 1) {
        const cp = boxdiag_codepoints[i];
        // invariant: codepoints are strictly ascending -- the ordering the gfa1 encoder trusts.
        assert(i == 0 or cp > last_cp);
        last_cp = cp;
        const cov = try coverage_from_art(allocator, boxdiag_art[i]);
        glyphs[i] = glyph.Glyph{
            .codepoint = cp,
            .advance = boxdiag_advance,
            .coverage = cov,
        };
    }
    // invariant: the last codepoint is the diagonal cross (U+2573) -- the table ends where the diagonal set ends.
    assert(glyphs[boxdiag_count - 1].codepoint == 0x2573);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

// --- selftest: build the diagonal atlas, round-trip it through gfa1, prove present, distinct, legible, union -------

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the three-mark corpus at the shared cell.
    assert(glyph_count == boxdiag_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Three present marks: every one looks up, carries the shared advance; an ASCII letter misses.
    var d: u32 = 0;
    while (d < boxdiag_count) : (d += 1) {
        const cp = boxdiag_codepoints[d];
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == boxdiag_advance);
        } else return error.DiagMarkMissing;
    }
    if (back.lookup('A')) |_| return error.NonDiagFound else {}

    // Distinctness: no two marks share identical coverage -- a real diagonal set's glyphs differ (catches a copy slip).
    var a: u32 = 0;
    while (a < boxdiag_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < boxdiag_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.DiagMarksNotDistinct;
        }
    }

    // Union: the cross (index 2) is EXACTLY the two single diagonals overlaid -- a cell is inked in the cross when
    // either single diagonal inks it, and only then. This is what makes the three a family, not three lone drawings.
    {
        const slash = atlas.glyphs[0].coverage; // U+2571 /
        const backsl = atlas.glyphs[1].coverage; // U+2572 backslash
        const cross = atlas.glyphs[2].coverage; // U+2573 X
        var c: u32 = 0;
        while (c < cell_area) : (c += 1) {
            const either = (slash[c] != 0) or (backsl[c] != 0);
            const in_cross = cross[c] != 0;
            if (either != in_cross) return error.CrossNotUnion;
        }
    }

    // Legibility: each mark's ink count sits inside an honest band. A single diagonal crosses seven cells of the body;
    // the cross overlays two diagonals sharing the centre cell, so it sits highest. The floor sits where a single
    // diagonal still reads as a line, the ceiling where the cross still resolves as an X rather than a blob.
    const ink_min: u32 = 6;
    const ink_max: u32 = 14;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < boxdiag_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.DiagMarkIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-boxdiag: {d} light diagonal box marks U+2571..U+2573 at {d}x{d} round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); the cross is exactly the two single diagonals overlaid (a union); encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_boxdiag selftest\n", .{});
    return 1;
}
