//! image/color_nearest_css.rye -- the nearest CSS-named color to ANY color, over the open color algebra (Season G).
//!
//! Season G (Open Media Primitives) -- a single-stranded sibling of image/color_nearest.rye. Where that rung scans the
//! sixteen HTML4 names and answers "what do we call this?" coarsely -- a cornflower blue reads only "blue" -- this rung
//! scans the full 148 CSS names (image/color_names_css.rye) and answers it finely: nearest(c) returns the CSS table
//! entry closest to c in sRGB, so #6495ed reads "cornflowerblue" exactly and a color a shade off still reads it. The
//! richer table is a finer ruler; the payoff the 148-name set was built for, made literal.
//!
//! Compose, not braid: color_names_css OWNS the names and their canonical hex, color DECIDES the bytes through its own
//! parse_hex, and this module only MEASURES squared sRGB distance and PICKS the smallest -- no new table, no stored
//! channel byte, no parser. Alpha is outside the named-set metric (the set is all opaque), so a translucent color reads
//! by its three channels. Ties break to the EARLIER table entry, and the table is sorted ascending by name, so a color
//! that ties two names reads the alphabetically-first (the synonym pairs resolve the same way -- #00ffff reads "aqua"
//! before "cyan"). Bounded (the scan is the fixed 148), integer (the squared distance never leaves u32), no network,
//! no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/color_nearest_css.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const names_css = @import("color_names_css.rye");
const nearest16 = @import("color_nearest.rye");

pub const color_nearest_css_version = "20260817.133847";

/// The largest squared sRGB distance between two colors -- three channels, each byte diff at most 255, each square at
/// most 65025, so the sum never exceeds 195075. Named so the u32 the distance rides in is proven to hold it with room.
pub const max_dist_sq: u32 = 3 * 255 * 255;

/// A nearest-color reading: the matched CSS name, the exact color the name stands for, and the squared sRGB distance
/// from the queried color to it (0 exactly when the query IS a CSS-named color). The name and color come from
/// color_names_css, so this struct stores a reading, never a fact of its own.
pub const Match = struct {
    name: []const u8,
    color: color.Rgba,
    dist: u32,
};

/// The squared sRGB distance between two colors over the three color channels -- alpha is not part of the named-set
/// metric, so it is deliberately left out. Squared rather than rooted because the square root is monotonic: the
/// nearest color by squared distance is the nearest by true distance, and the square stays exact integer arithmetic.
fn rgb_dist_sq(x: color.Rgba, y: color.Rgba) u32 {
    // invariant: each channel difference is a byte magnitude, so it never exceeds 255 and its square never exceeds 65025.
    const dr: u32 = if (x.r >= y.r) x.r - y.r else y.r - x.r;
    const dg: u32 = if (x.g >= y.g) x.g - y.g else y.g - x.g;
    const db: u32 = if (x.b >= y.b) x.b - y.b else y.b - x.b;
    // invariant: the per-channel distances are each within a byte before they are squared and
    // summed, so the sum stays inside the width the search compares in
    assert(dr <= 255);
    assert(dg <= 255);
    const sum = dr * dr + dg * dg + db * db;
    // invariant: the summed square is bounded by the three-channel maximum, so it fits the u32 it is carried in.
    assert(sum <= max_dist_sq);
    return sum;
}

/// The nearest CSS-named color to any color -- the fine answer to "what do we call this?" over 148 names rather than
/// sixteen. Scans the whole CSS table, measures the squared sRGB distance to each, and keeps the smallest; a tie breaks
/// to the earlier (alphabetically-first) table entry because the scan keeps the first winner. Composes:
/// color_names_css owns the names, color decides the bytes, this only picks the least distance.
pub fn nearest(c: color.Rgba) Match {
    // invariant: the table is the whole CSS set, non-empty, so a nearest match always exists.
    assert(names_css.css_named_color_count == names_css.table.len);
    assert(names_css.css_named_color_count >= 1);
    var best: ?Match = null;
    var i: u32 = 0;
    while (i < names_css.css_named_color_count) : (i += 1) {
        // Compose, not braid: color DECIDES the bytes from color_names_css' canonical hex; a rare unparseable entry is
        // skipped rather than trusted, exactly as color_names_css.name_of skips it.
        const known = color.parse_hex(names_css.table[i].hex) catch continue;
        const d = rgb_dist_sq(c, known);
        if (best) |b| {
            // Strictly-less keeps the FIRST winner on a tie, so the alphabetically-earlier name wins deterministically.
            if (d < b.dist) best = .{ .name = names_css.table[i].name, .color = known, .dist = d };
        } else {
            best = .{ .name = names_css.table[i].name, .color = known, .dist = d };
        }
    }
    // invariant: the table is non-empty and every CSS entry parses, so a best match was found.
    assert(best != null);
    return best.?;
}

/// The nearest CSS-named color's name alone, for a caller that wants only the word. A thin reading of nearest, so the
/// two never disagree.
pub fn nearest_name(c: color.Rgba) []const u8 {
    // invariant: nearest always returns a real table entry, so its name is a real keyword.
    const m = nearest(c);
    // invariant: a palette entry carries a name, since a nameless nearest match would be
    // returned as an answer nobody can print
    assert(m.name.len >= 1);
    return m.name;
}

// --- selftest: prove every CSS color is its own nearest at distance zero, the richer table names MORE FINELY than the
// --- HTML4 sixteen (the payoff), a tie breaks to the earlier synonym, alpha is outside the metric, deterministic.

fn run_selftest(garden: std.mem.Allocator) !u8 {
    _ = garden;

    // 1. Every CSS color is its OWN nearest, at squared distance exactly zero, reading back its own name -- the
    // completeness crux, walked over the whole 148 table.
    var i: u32 = 0;
    while (i < names_css.css_named_color_count) : (i += 1) {
        const known = try color.parse_hex(names_css.table[i].hex);
        const m = nearest(known);
        if (m.dist != 0) return error.NamedNotZeroDist;
        // A synonym color reads the earliest name, so compare bytes for the color and only require a zero-distance,
        // exactly-matching-color reading; the name equals this row's name unless an earlier synonym shares its bytes.
        if (!m.color.eql(known)) return error.NamedWrongColor;
    }

    // 2. An exact cornflowerblue reads "cornflowerblue" at distance zero -- a name the HTML4 sixteen cannot hold.
    const cornflower = try color.parse_hex("#6495ed");
    const cf_match = nearest(cornflower);
    if (!std.mem.eql(u8, cf_match.name, "cornflowerblue")) return error.CornflowerNameWrong;
    if (cf_match.dist != 0) return error.CornflowerDistWrong;

    // 3. The PAYOFF, proven against the HTML4 sibling: for cornflowerblue the CSS reading is nearer (distance 0) and
    // finer-named than the sixteen-name reading, which lands on a coarser keyword at a strictly larger distance. The
    // richer table is a finer ruler -- exactly why it was built.
    const cf16 = nearest16.nearest(cornflower);
    if (cf16.dist == 0) return error.Html4UnexpectedlyExact; // the sixteen do not carry cornflowerblue
    if (!(cf_match.dist < cf16.dist)) return error.CssNotFiner;
    if (std.mem.eql(u8, cf_match.name, cf16.name)) return error.CssNameNotFiner;

    // 4. A near-cornflowerblue {100,150,235} that is no exact keyword still reads "cornflowerblue", the closest of 148.
    const near_cf = color.Rgba{ .r = 100, .g = 150, .b = 235, .a = 255 };
    if (names_css.name_of(near_cf)) |_| return error.NearCfFalselyExact else {}
    const near_match = nearest(near_cf);
    if (!std.mem.eql(u8, near_match.name, "cornflowerblue")) return error.NearCfNameWrong;

    // 5. A synonym color reads the EARLIEST name: #00ffff is both aqua and cyan; nearest reads "aqua" at distance zero.
    const aqua = try color.parse_hex("#00ffff");
    const aqua_match = nearest(aqua);
    if (!std.mem.eql(u8, aqua_match.name, "aqua")) return error.SynonymNotEarliest;
    if (aqua_match.dist != 0) return error.SynonymDistWrong;

    // 6. Alpha is outside the named-set metric: a translucent cornflowerblue still reads "cornflowerblue" at distance
    // zero, where color_names_css.name_of honestly returns null for the translucent color.
    const glass_cf = color.Rgba{ .r = 100, .g = 149, .b = 237, .a = 20 };
    if (names_css.name_of(glass_cf)) |_| return error.GlassFalselyExact else {}
    const glass_match = nearest(glass_cf);
    if (!std.mem.eql(u8, glass_match.name, "cornflowerblue")) return error.GlassNameWrong;
    if (glass_match.dist != 0) return error.GlassDistWrong;

    // 7. nearest_name reads the same word as nearest, and the reading is deterministic.
    if (!std.mem.eql(u8, nearest_name(near_cf), near_match.name)) return error.ConvenienceDisagrees;
    const again = nearest(near_cf);
    if (!std.mem.eql(u8, again.name, near_match.name)) return error.NotDeterministicName;
    if (again.dist != near_match.dist) return error.NotDeterministicDist;

    print("GREEN image-color-nearest-css: the nearest CSS-named color to ANY color over the open color algebra; every one of the 148 CSS colors is its own nearest at squared distance zero (compose not braid, color_names_css owns the names and color decides the bytes); an exact cornflowerblue reads 'cornflowerblue' at distance zero, a name the HTML4 sixteen cannot hold; the PAYOFF proven against the sixteen-name sibling -- for the same color the CSS reading is strictly nearer and finer-named than color_nearest's, the richer table a finer ruler; a near-cornflowerblue that is no keyword still reads 'cornflowerblue'; a synonym color reads the earliest name ('aqua' before 'cyan') at distance zero; alpha is outside the metric so a translucent cornflowerblue still reads its name at distance zero where name_of returns null; nearest_name agrees with nearest, and the same color reads the same name and distance every time\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: color_nearest_css selftest\n", .{});
    return 1;
}
