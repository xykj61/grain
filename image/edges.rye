//! image/edges.rye -- an RGBA image's EDGES found by the Sobel operator (Season G, the convolution floor's DETECT verb).
//!
//! Season G (Open Media Primitives) -- the third pillar of the convolution floor beside image/blur.rye and image/gaussian.rye
//! (which smooth) and image/sharpen.rye (which enhances detail). Where a blur averages a window toward its mean and a sharpen
//! adds a window's detail back, an EDGE detector measures how fast the image is CHANGING at each pixel -- it lights the
//! boundaries where one region meets another and leaves the flat interiors dark. This is the classic first step of every
//! outline, mask, and shape-finding pass: a photo becomes a line drawing of its own contours, a scanned page becomes the
//! strokes of its letters, a sprite becomes its silhouette.
//!
//! The math is the Sobel operator -- two small signed kernels that estimate the image's gradient, one per axis. The
//! horizontal kernel Gx = [[-1,0,1],[-2,0,2],[-1,0,1]] answers "how much brighter is the right side of this pixel than the
//! left?" and the vertical kernel Gy = [[-1,-2,-1],[0,0,0],[1,2,1]] answers the same up-and-down. Each is a weighted
//! difference across the pixel, so a flat field returns zero and a sharp boundary returns a large signed value. The edge
//! STRENGTH is the length of that gradient vector; this rung uses the integer L1 magnitude `|gx| + |gy|` (the Manhattan
//! approximation of `sqrt(gx*gx + gy*gy)`), so an edge is found with NO float and NO square root -- deterministic
//! byte-for-byte. A `gain` percent scales the magnitude before the clamp, so faint edges can be lifted into view: gain 100 is
//! the raw magnitude, 300 triples it, 0 darkens the whole map. Every value is clamped onto a real byte 0..255.
//!
//! This rung owns ONE new operation -- the signed directional gradient combined by magnitude -- and leans only on
//! image/qoi.rye for the grid; it adds no blur, no blend, no codec, no color model. The gradient is measured on the three
//! COLOR channels, each independently (a red edge on a green field lights red and green), and the ALPHA is CARRIED from the
//! source unchanged rather than edge-detected -- so the edge map stays visible exactly where the source was visible (an
//! opaque photo yields an opaque outline; a sprite's transparent ground stays transparent), the sensible default for seeing
//! an image's edges. Window edges CLAMP to the border, exactly as the blur family does, so the 3x3 kernel is always full and
//! a 1x1 image (which has no edges) yields black. `edge_magnitude` is the general verb (any gain in band); `edges` is the
//! `edge_default_gain` convenience. A zero-extent source or an over-max gain refuses BY NAME before any allocation, so a
//! malformed call leaves nothing behind. No network, no key, no funds -- the outline a surface draws the day it wants a
//! contour, a mask, or a shape, on our own open geometry.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/edges.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const color = @import("color.rye");
const qoi = @import("qoi.rye");

pub const edges_version = "20260818.094500";

/// The gain band, a PERCENT of the raw Sobel magnitude over `edge_gain_scale`. Zero darkens the whole map (no edge shown);
/// 100 is the raw magnitude; the ceiling bounds the lift so `magnitude * gain` stays a small bounded value inside i32.
pub const edge_min_gain: u32 = 0;
pub const edge_max_gain: u32 = 500;
pub const edge_default_gain: u32 = 100;

/// The fixed denominator `gain` is measured against: gain 100 means "show 100% of the magnitude," so a designer reads the
/// gain as a plain percentage rather than a raw fixed-point fraction.
pub const edge_gain_scale: u32 = 100;

// The scale as a signed value for the i32 gradient arithmetic -- the same constant, typed for the divide below.
const gain_scale_i: i32 = @intCast(edge_gain_scale);

// The Sobel kernels in row-major order over the 3x3 window (k = 0..8, dx = k%3 - 1, dy = k/3 - 1). Gx measures the
// left-to-right gradient, Gy the top-to-bottom; a flat window returns zero from each because the weights sum to zero.
const sobel_gx = [9]i32{ -1, 0, 1, -2, 0, 2, -1, 0, 1 };
const sobel_gy = [9]i32{ -1, -2, -1, 0, 0, 0, 1, 2, 1 };

pub const EdgeError = error{
    EmptySource,
    EdgeGainTooLarge,
};

/// Clamp a signed axis position onto a real pixel index in `[0, extent-1]`. A window that reaches past a border reads the
/// nearest border pixel, so the 3x3 kernel is always full and a flat edge never invents a phantom gradient at the margin.
fn clamp_axis(pos: i64, extent: u32) u32 {
    // invariant: a real axis has at least one pixel to clamp onto.
    assert(extent >= 1);
    if (pos <= 0) return 0;
    const hi: i64 = @as(i64, extent) - 1;
    // invariant: the far clamp lands on the last real pixel, never past it.
    if (pos >= hi) return @intCast(hi);
    return @intCast(pos);
}

/// Clamp a signed edge value onto a real byte 0..255. A magnitude past 255 pins to 255, a negative (impossible here yet
/// guarded) pins to 0 -- the whole reason the intermediate is i32 and the result is clamped, not cast raw.
fn clamp_byte(v: i32) u8 {
    // invariant: a value below the floor pins to 0; the guard below proves the cast then cannot see a negative.
    if (v < 0) return 0;
    // invariant: a value above the ceiling pins to 255; the guard below proves the cast then cannot see 256+.
    if (v > 255) return 255;
    // invariant: past both rails the value is already a real byte, so the cast never truncates.
    assert(v >= 0);
    assert(v <= 255);
    return @intCast(v);
}

/// Apply one Sobel kernel to one color channel at pixel (x, y), reading the clamped 3x3 window. Returns the signed
/// directional gradient -- positive where that axis rises, negative where it falls, zero on a flat window.
fn gradient(src: []const u8, w: u32, h: u32, x: u32, y: u32, ch: u32, kernel: [9]i32) i32 {
    // invariant: the channel is one of the four RGBA lanes.
    assert(ch < 4);
    // invariant: the read pixel lies inside the image on both axes.
    assert(x < w);
    assert(y < h);
    var sum: i32 = 0;
    var k: u32 = 0;
    while (k < 9) : (k += 1) {
        const dx: i64 = @as(i64, k % 3) - 1;
        const dy: i64 = @as(i64, k / 3) - 1;
        const sx = clamp_axis(@as(i64, x) + dx, w);
        const sy = clamp_axis(@as(i64, y) + dy, h);
        const si = (@as(usize, sy) * @as(usize, w) + @as(usize, sx)) * 4 + @as(usize, ch);
        // each weight is at most 2 in magnitude and each sample at most 255, so |sum| <= 4*255 = 1020 -- far inside i32
        sum += kernel[k] * @as(i32, src[si]);
    }
    return sum;
}

/// The edge STRENGTH at one color channel of pixel (x, y): the L1 magnitude `|gx| + |gy|` of the two Sobel gradients, the
/// integer stand-in for the true gradient length that needs no square root. Zero on a flat field, large across a boundary.
fn magnitude_at(src: []const u8, w: u32, h: u32, x: u32, y: u32, ch: u32) i32 {
    // invariant: the channel is one of the four RGBA lanes.
    assert(ch < 4);
    const gx = gradient(src, w, h, x, y, ch, sobel_gx);
    const gy = gradient(src, w, h, x, y, ch, sobel_gy);
    const ax: i32 = if (gx < 0) -gx else gx;
    const ay: i32 = if (gy < 0) -gy else gy;
    // invariant: each absolute gradient is non-negative and bounded by 1020, so the sum stays far inside i32.
    assert(ax >= 0);
    assert(ay >= 0);
    return ax + ay;
}

/// Write the Sobel edge map of `src` into `out`: each color channel becomes `clamp(|gx| + |gy| * gain / edge_gain_scale)`
/// and the alpha is carried from `src` unchanged. Both buffers hold the same RGBA byte count; the pass reads `src` and writes
/// `out`, touching no other memory.
fn apply_edges(out: []u8, src: []const u8, w: u32, h: u32, gain: u32) void {
    // invariant: both buffers hold exactly w*h RGBA pixels, so every index lands inside each.
    assert(out.len == src.len);
    assert(out.len == @as(usize, w) * @as(usize, h) * 4);
    // invariant: the gain stays in band (guarded before the call), so magnitude * gain can never wrap i32.
    assert(gain <= edge_max_gain);
    const gain_i: i32 = @intCast(gain);

    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const base = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            var ch: u32 = 0;
            while (ch < 3) : (ch += 1) {
                const mag = magnitude_at(src, w, h, x, y, ch);
                // mag <= 2040 and gain <= 500, so mag * gain_i <= 1_020_000 -- far inside i32, no overflow
                const scaled: i32 = @divTrunc(mag * gain_i, gain_scale_i);
                out[base + ch] = clamp_byte(scaled);
            }
            out[base + 3] = src[base + 3]; // alpha carried from the source, not edge-detected
        }
    }
}

/// Guard the source and gain shared by both public verbs: a zero-extent source refuses `EmptySource`, an over-max gain
/// refuses `EdgeGainTooLarge`, each BY NAME before any allocation. Returns the pixel-buffer length so the caller allocates
/// once.
fn guard(src: *const qoi.Pixmap, gain: u32) EdgeError!usize {
    // invariant: a real source has extent on both axes; a zero-size source has nothing to detect.
    if (src.width == 0 or src.height == 0) return error.EmptySource;
    // invariant: the gain stays in the named band, so the lift is a small bounded multiple of the magnitude.
    if (gain > edge_max_gain) return error.EdgeGainTooLarge;
    return @as(usize, src.width) * @as(usize, src.height) * 4;
}

/// Detect `src`'s edges into a fresh same-size RGBA Pixmap by the Sobel operator: each color channel becomes the L1
/// gradient magnitude scaled by `gain` percent and clamped, the alpha carried from `src` unchanged. Returns a newly
/// allocated Pixmap the caller owns; `src` is read-only and untouched. Gain 0 yields a black edge map (no edge shown).
pub fn edge_magnitude(allocator: std.mem.Allocator, src: *const qoi.Pixmap, gain: u32) !qoi.Pixmap {
    const n = try guard(src, gain);
    // invariant: the guard proved real extent, so the buffer length is a real positive pixel count.
    assert(n >= 4);
    const out = try allocator.alloc(u8, n);
    apply_edges(out, src.pixels, src.width, src.height, gain);
    return qoi.Pixmap{ .width = src.width, .height = src.height, .channels = 4, .colorspace = 0, .pixels = out };
}

/// Detect `src`'s edges into a fresh same-size RGBA Pixmap at the STANDARD gain -- exactly `edge_magnitude` at
/// `edge_default_gain`. The raw-magnitude edge map a surface reaches for by default.
pub fn edges(allocator: std.mem.Allocator, src: *const qoi.Pixmap) !qoi.Pixmap {
    // invariant: the default gain sits inside the named band, so it never trips the guard on its own.
    assert(edge_default_gain >= edge_min_gain);
    assert(edge_default_gain <= edge_max_gain);
    return edge_magnitude(allocator, src, edge_default_gain);
}

// --- selftest: flat stays dark, directional gradients, the L1 sum, gain scaling, alpha carried, round-trip, refusals -------

/// Mint a one-color RGBA canvas for the selftest -- a local, bounded builder so this rung leans on no higher module.
fn make_canvas(garden: std.mem.Allocator, w: u32, h: u32, fill: color.Rgba) !qoi.Pixmap {
    // invariant: a canvas has real extent within the image module's named pixel ceiling.
    assert(w >= 1);
    assert(h >= 1);
    const total: u64 = @as(u64, w) * @as(u64, h);
    assert(total <= qoi.qoi_max_pixels);
    const pixels = try garden.alloc(u8, @as(usize, @intCast(total)) * 4);
    var i: usize = 0;
    while (i < pixels.len) : (i += 4) {
        pixels[i] = fill.r;
        pixels[i + 1] = fill.g;
        pixels[i + 2] = fill.b;
        pixels[i + 3] = fill.a;
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = pixels };
}

/// Read one pixel's RGBA at (x, y) -- a small reader the checks below share.
fn pixel_at(img: *const qoi.Pixmap, x: u32, y: u32) color.Rgba {
    // invariant: the read stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    return color.Rgba{ .r = img.pixels[di], .g = img.pixels[di + 1], .b = img.pixels[di + 2], .a = img.pixels[di + 3] };
}

/// Set one pixel's RGBA at (x, y) -- a small writer the pattern builders share.
fn set_pixel(img: *qoi.Pixmap, x: u32, y: u32, c: color.Rgba) void {
    // invariant: the write stays inside the buffer on both axes.
    assert(x < img.width);
    assert(y < img.height);
    const di = (@as(usize, y) * @as(usize, img.width) + @as(usize, x)) * 4;
    img.pixels[di] = c.r;
    img.pixels[di + 1] = c.g;
    img.pixels[di + 2] = c.b;
    img.pixels[di + 3] = c.a;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const black = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
    const white = color.Rgba{ .r = 255, .g = 255, .b = 255, .a = 255 };

    // --- a FLAT field has NO edges: every color channel returns zero (black), and the alpha is carried through ----------
    const teal = color.Rgba{ .r = 0, .g = 128, .b = 128, .a = 200 };
    var flat = try make_canvas(garden, 6, 6, teal);
    _ = &flat;
    const flat_edges = try edges(garden, &flat);
    var fy: u32 = 0;
    while (fy < 6) : (fy += 1) {
        var fx: u32 = 0;
        while (fx < 6) : (fx += 1) {
            const p = pixel_at(&flat_edges, fx, fy);
            if (p.r != 0 or p.g != 0 or p.b != 0) return error.FlatFieldHadEdges;
            if (p.a != 200) return error.FlatFieldAlphaNotCarried;
        }
    }

    // --- a VERTICAL edge lights a HORIZONTAL gradient: left two columns black, right column white on a 3x3 --------------
    // At the center (1,1) the window straddles the black/white boundary, so gx is maximal (|gx| = 1020) and gy = 0 (the
    // column is uniform up and down); the magnitude clamps to 255 -- a bright edge. The far-left flat pixel (0,1) is black.
    var vedge = try make_canvas(garden, 3, 3, black);
    var vy: u32 = 0;
    while (vy < 3) : (vy += 1) set_pixel(&vedge, 2, vy, white);
    const vmap = try edges(garden, &vedge);
    if (pixel_at(&vmap, 1, 1).r != 255) return error.VerticalEdgeNotLit;
    if (pixel_at(&vmap, 0, 1).r != 0) return error.VerticalFlatNotDark;

    // --- a HORIZONTAL edge is the mirror: the transpose lights a vertical gradient the same way -------------------------
    var hedge = try make_canvas(garden, 3, 3, black);
    var hx: u32 = 0;
    while (hx < 3) : (hx += 1) set_pixel(&hedge, hx, 2, white);
    const hmap = try edges(garden, &hedge);
    if (pixel_at(&hmap, 1, 1).r != 255) return error.HorizontalEdgeNotLit;
    if (pixel_at(&hmap, 1, 0).r != 0) return error.HorizontalFlatNotDark;

    // --- THE L1 SUM CRUX: a single dim corner drives BOTH gradients, so the magnitude is |gx| + |gy|, not either alone --
    // A 3x3 black field with only the bottom-right pixel set to 32. At the center (1,1): gx reads the right column
    // (+1*32 at the corner) = 32, gy reads the bottom row (+1*32 at the corner) = 32, so |gx| + |gy| = 64. A single kernel
    // or a max would report only 32 -- the value 64 proves the two axes are SUMMED.
    const dim = color.Rgba{ .r = 32, .g = 32, .b = 32, .a = 255 };
    var corner = try make_canvas(garden, 3, 3, black);
    set_pixel(&corner, 2, 2, dim);
    const cmap = try edge_magnitude(garden, &corner, edge_default_gain);
    if (pixel_at(&cmap, 1, 1).r != 64) return error.L1SumWrong;

    // --- GAIN scales the magnitude before the clamp: the same 64 lifts to 192 at gain 300 and clamps to 255 at gain 500 -
    const cmap3 = try edge_magnitude(garden, &corner, 300);
    if (pixel_at(&cmap3, 1, 1).r != 192) return error.GainDidNotScale;
    const cmap5 = try edge_magnitude(garden, &corner, 500);
    if (pixel_at(&cmap5, 1, 1).r != 255) return error.GainDidNotClamp;
    // gain 0 shows no edge at all -- the whole map darkens to black
    const cmap0 = try edge_magnitude(garden, &corner, 0);
    if (pixel_at(&cmap0, 1, 1).r != 0) return error.ZeroGainNotDark;

    // --- ALPHA is CARRIED, not detected: an alpha edge leaves the output alpha equal to the source alpha everywhere ------
    // Left two columns alpha 0, right column alpha 255 (all rgb 0). If alpha were edge-detected the boundary would light;
    // because it is carried, each output alpha equals its own source alpha -- 0 at the boundary (1,1), 255 at the right.
    const clear = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 0 };
    const opaque_k = color.Rgba{ .r = 0, .g = 0, .b = 0, .a = 255 };
    var aedge = try make_canvas(garden, 3, 3, clear);
    var ay2: u32 = 0;
    while (ay2 < 3) : (ay2 += 1) set_pixel(&aedge, 2, ay2, opaque_k);
    const amap = try edges(garden, &aedge);
    if (pixel_at(&amap, 1, 1).a != 0) return error.AlphaBoundaryNotCarried;
    if (pixel_at(&amap, 2, 1).a != 255) return error.AlphaRightNotCarried;

    // --- a 1x1 image has NO edges (every neighbour clamps to itself): the map is black, alpha carried -------------------
    var one = try make_canvas(garden, 1, 1, white);
    _ = &one;
    const onemap = try edges(garden, &one);
    if (pixel_at(&onemap, 0, 0).r != 0) return error.SinglePixelHadEdge;
    if (pixel_at(&onemap, 0, 0).a != 255) return error.SinglePixelAlphaLost;

    // --- an edge map round-trips through the open QOI codec byte-for-byte -- a real image, not a private buffer ----------
    var checker = try make_canvas(garden, 5, 5, black);
    var ky: u32 = 0;
    while (ky < 5) : (ky += 1) {
        var kx: u32 = 0;
        while (kx < 5) : (kx += 1) {
            if ((kx + ky) % 2 == 0) set_pixel(&checker, kx, ky, white);
        }
    }
    const shown = try edges(garden, &checker);
    const cap = qoi.encoded_bound(shown.pixel_count());
    const dst = try garden.alloc(u8, cap);
    const enc = try qoi.encode(&shown, dst);
    const back = try qoi.decode(garden, dst[0..enc.len]);
    if (!back.same_bytes(&shown)) return error.EdgesDidNotRoundTrip;

    // --- refusals by name, each having allocated nothing --------------------------------------------------------------
    if (edge_magnitude(garden, &checker, edge_max_gain + 1)) |_| return error.OverGainNotRefused else |err| {
        if (err != error.EdgeGainTooLarge) return error.WrongGainError;
    }
    var empty = qoi.Pixmap{ .width = 0, .height = 0, .channels = 4, .colorspace = 0, .pixels = &[_]u8{} };
    if (edges(garden, &empty)) |_| return error.EmptySourceNotRefused else |err| {
        if (err != error.EmptySource) return error.WrongEmptyError;
    }

    // --- the default convenience equals the general verb at the default gain byte-for-byte ----------------------------
    const by_default = try edges(garden, &checker);
    const by_general = try edge_magnitude(garden, &checker, edge_default_gain);
    if (!by_default.same_bytes(&by_general)) return error.DefaultIsNotGeneralAtDefaultGain;

    // --- determinism: the same edge detection finds the same gradients byte-for-byte ----------------------------------
    const map_a = try edges(garden, &checker);
    const map_b = try edges(garden, &checker);
    if (!map_a.same_bytes(&map_b)) return error.EdgesNotDeterministic;

    print("GREEN image-edges: an RGBA image's edges found by the Sobel operator (|gx| + |gy| per color channel, gain-scaled and clamped, alpha carried) -- a flat field has no edges and stays black with its alpha carried; a vertical edge lights a horizontal gradient to 255 at the boundary while the flat interior stays dark, and a horizontal edge is its mirror; THE L1 SUM CRUX -- a dim corner drives both gradients so the magnitude is 64 (|gx| + |gy|), where a single kernel or a max would report only 32; gain scales the magnitude before the clamp (64 lifts to 192 at gain 300, clamps to 255 at gain 500, darkens to 0 at gain 0); alpha is carried not detected (an alpha edge leaves the output alpha equal to the source alpha); a 1x1 image has no edges and yields black; the edge map round-trips through the open QOI codec byte-for-byte; an over-max gain and an empty source refuse by name having allocated nothing; the default equals the general verb at the default gain; the same detection is deterministic byte-for-byte\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: edges selftest\n", .{});
    return 1;
}
