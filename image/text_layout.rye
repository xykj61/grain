//! image/text_layout.rye -- the open text-layout rung (Season G, the composition after the font family).
//!
//! Season G (Open Media Primitives) - the measure half that makes the nine hand-drawn corpora usable. The glyph
//! atlas (image/glyph.rye, gfa1) and the full-ASCII font (image/font5x7_ascii.rye) give a surface the glyphs; this
//! module gives it their GEOMETRY -- where each glyph of a string sits along a line, and how wide the whole line runs.
//! It is pure measurement, the twin of image/color.rye's arithmetic: no pixel is touched, so it is floor code that
//! does not wait on DJINN's Bit Design System (only Brushstroke rendering is paused, not layout math). Painting the
//! placed coverage into an RGBA grid is the later rung this one prepares; here we only place and measure.
//!
//! A line is laid left to right: each glyph is stamped at the running pen origin, then the pen steps forward by that
//! glyph's advance. A byte with no glyph in the atlas is a NAMED refusal (UncoveredCodepoint) rather than a silent
//! hole -- the same discipline glyph.rye keeps, refusing rather than painting garbage. The full-ASCII font covers the
//! whole printable band, so a caller that composes with it lays out any printable string; an uncovered byte (a
//! control char, or a codepoint only some other corpus draws) refuses by name. wrap_lines grows on top: it breaks a
//! paragraph into lines that stay within a max width, at space boundaries, so each wrapped span lays out directly and
//! its stated width equals a fresh measure of it. A word wider than the max takes its own line whole. wrap_lines_break
//! is the opt-in companion beside it: it wraps at spaces exactly as wrap_lines does, yet when a single word alone
//! overflows the max it SPLITS that word at a glyph boundary rather than letting one line run past the max -- so every
//! emitted line stays within the max whenever the max holds at least one glyph, and the split loses no glyph. The two
//! are the strict/relaxed pair the text_paint rung already keeps (strict paint vs clipped paint): word-boundary wrap
//! is the whole-word promise, break wrap is the never-overflow promise. justify_line is the alignment family's fourth
//! member beside left, right, and center: given a line already laid, it flushes both margins to a wider target by
//! spreading the slack evenly across the interior word gaps -- pure geometry, shifting pen origins, touching no pixel;
//! a single-word line has no gap to stretch and is left exactly as laid. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/text_layout.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");
const font_ascii = @import("font5x7_ascii.rye");

pub const text_layout_version = "20260817.022328";

/// The most glyphs one laid-out line may hold -- a generous ceiling over any label a repair-panel UI shows.
pub const line_glyph_max: u32 = 4096;

/// The widest a line's pen may travel, in cells: line_glyph_max glyphs times the largest advance a glyph can carry.
/// Named so the running pen sum has a proven ceiling and never has to be trusted unbounded.
pub const line_width_max: u32 = line_glyph_max * 255;

/// One placed glyph -- its codepoint, its pen origin along the line (cells from the line start), and the atlas glyph
/// it points to. The pointer is borrowed from the atlas the caller passed; this module reorders references, not bytes.
pub const PlacedGlyph = struct {
    codepoint: u32 = 0,
    pen_x: u32 = 0,
    src: *const glyph.Glyph = undefined,
};

/// A laid-out single line -- how many glyphs were placed, and the total pen width in cells (the sum of advances).
pub const LineLayout = struct {
    count: u32 = 0,
    width: u32 = 0,
};

/// Lay `text` (a byte string, one codepoint per byte) into `out`, one PlacedGlyph per byte, left to right by each
/// glyph's advance. Returns the placed count and total width. Refuses UncoveredCodepoint by name the moment a byte
/// has no glyph in the atlas -- a caller composes with a font whose band it covers, and learns of a gap at once.
pub fn layout_line(atlas: *const glyph.GlyphAtlas, text: []const u8, out: []PlacedGlyph) !LineLayout {
    // invariant: the input line stays within the named ceiling, so the loop below is bounded.
    if (text.len > line_glyph_max) return error.LineTooLong;
    // invariant: the caller's buffer holds at least one placed glyph per input byte.
    assert(out.len >= text.len);

    var pen: u32 = 0;
    var i: u32 = 0;
    const n: u32 = @intCast(text.len);
    while (i < n) : (i += 1) {
        const cp: u32 = text[i];
        const g = atlas.lookup(cp) orelse return error.UncoveredCodepoint;
        // invariant: a glyph advance is a real forward step, so the pen strictly increases per glyph.
        assert(g.advance >= 1);
        out[i] = PlacedGlyph{ .codepoint = cp, .pen_x = pen, .src = g };
        pen += g.advance;
        // invariant: the running pen never exceeds the proven line-width ceiling.
        assert(pen <= line_width_max);
    }
    // invariant: with every advance >= 1, the total width is at least the glyph count -- no origin underflows.
    assert(pen >= n);
    return LineLayout{ .count = n, .width = pen };
}

/// Measure the total pen width of `text` in cells without placing glyphs -- the sizing a wrap or a centered label
/// needs before it lays anything. Refuses UncoveredCodepoint by name, so a measured width is always an honest one.
pub fn measure_width(atlas: *const glyph.GlyphAtlas, text: []const u8) !u32 {
    // invariant: the measured line stays within the named ceiling.
    if (text.len > line_glyph_max) return error.LineTooLong;
    var pen: u32 = 0;
    var i: u32 = 0;
    const n: u32 = @intCast(text.len);
    while (i < n) : (i += 1) {
        const g = atlas.lookup(text[i]) orelse return error.UncoveredCodepoint;
        // invariant: each advance is a real forward step within the width ceiling.
        assert(g.advance >= 1);
        pen += g.advance;
        assert(pen <= line_width_max);
    }
    return pen;
}

/// Does `atlas` carry a glyph for every byte in `text`? The non-refusing predicate a caller checks before laying
/// out, when it would rather substitute a font than field a refusal. A bounded scan -- text is capped at the ceiling.
pub fn covers(atlas: *const glyph.GlyphAtlas, text: []const u8) bool {
    // invariant: the checked line stays within the named ceiling, so the scan is bounded.
    assert(text.len <= line_glyph_max);
    var i: u32 = 0;
    const n: u32 = @intCast(text.len);
    while (i < n) : (i += 1) {
        if (atlas.lookup(text[i]) == null) return false;
    }
    return true;
}

/// One wrapped line -- a byte span into the original text (start offset, length) and its pen width in cells. The
/// span excludes the space that broke it, so a caller lays out out_lines[k] directly with layout_line.
pub const WrapLine = struct {
    start: u32 = 0,
    len: u32 = 0,
    width: u32 = 0,
};

/// A measured byte run -- the exclusive end offset it reached and the pen width of the glyphs between the start and
/// that end. Shared by the word-measure and glyph-fit helpers both wrap functions lean on, so one measure serves all.
const WordRun = struct {
    end: u32 = 0,
    width: u32 = 0,
};

/// Measure the run of non-space bytes starting at `at`, returning the exclusive end and the summed pen width. A
/// caller trusts the width only after this returns, since an uncovered byte refuses here BY NAME. Lifted to file
/// level so both wrap_lines and wrap_lines_break measure a word by one shared routine (single-stranded, never twice).
fn measure_word(atlas: *const glyph.GlyphAtlas, text: []const u8, at: u32) !WordRun {
    // invariant: the start sits within the text, so the scan below is bounded.
    assert(at <= text.len);
    var p: u32 = at;
    var wsum: u32 = 0;
    const len: u32 = @intCast(text.len);
    while (p < len and text[p] != ' ') : (p += 1) {
        const g = atlas.lookup(text[p]) orelse return error.UncoveredCodepoint;
        // invariant: an advance is a real forward step, so a word width never stalls.
        assert(g.advance >= 1);
        wsum += g.advance;
        assert(wsum <= line_width_max);
    }
    return WordRun{ .end = p, .width = wsum };
}

/// Fit as many leading glyphs of the run `[at, end_limit)` as stay within `max_width`, ALWAYS taking at least one
/// (so a wrap makes progress even for a glyph wider than the max, rather than looping). Returns the exclusive end it
/// reached and that partial run's pen width. Refuses UncoveredCodepoint by name. The mid-word split leans on this.
fn fit_glyphs(atlas: *const glyph.GlyphAtlas, text: []const u8, at: u32, end_limit: u32, max_width: u32) !WordRun {
    // invariant: there is at least one glyph to place, within a real max, inside the text.
    assert(end_limit <= text.len);
    assert(at < end_limit);
    assert(max_width >= 1);
    var p: u32 = at;
    var w: u32 = 0;
    while (p < end_limit) : (p += 1) {
        const g = atlas.lookup(text[p]) orelse return error.UncoveredCodepoint;
        // invariant: an advance is a real forward step, so the fit never stalls.
        assert(g.advance >= 1);
        const next: u32 = w + g.advance;
        // Keep the first glyph unconditionally (progress); stop before a later one would overflow the max.
        if (p > at and next > max_width) break;
        w = next;
        assert(w <= line_width_max);
    }
    // invariant: at least the first glyph was placed, so the caller always advances.
    assert(p > at);
    return WordRun{ .end = p, .width = w };
}

/// Greedy word-wrap: break `text` into lines whose pen width stays within `max_width`, breaking only at spaces
/// (codepoint 32). A word wider than max_width takes its own line whole -- this rung never splits mid-word (that is
/// a later rung); it wraps at word boundaries, the smallest complete thing. Returns the line count written to
/// `out_lines`. Refuses UncoveredCodepoint by name if any non-space byte has no glyph, and MaxWidthTooSmall if
/// max_width cannot hold even one glyph. The spans reference `text`, so a caller lays each out with layout_line.
pub fn wrap_lines(atlas: *const glyph.GlyphAtlas, text: []const u8, max_width: u32, out_lines: []WrapLine) !u32 {
    // invariant: a usable wrap needs room for at least one glyph, and the input stays within the named ceiling.
    if (max_width == 0) return error.MaxWidthTooSmall;
    if (text.len > line_glyph_max) return error.LineTooLong;
    // invariant: worst case is one line per byte, so the buffer must hold a line for every byte of input.
    assert(out_lines.len >= text.len);

    const space_cp: u32 = ' ';
    var lines: u32 = 0;
    var i: u32 = 0;
    const n: u32 = @intCast(text.len);

    while (i < n) {
        // Skip the run of spaces that separates words; leading and inter-line spaces never begin a line.
        while (i < n and text[i] == space_cp) : (i += 1) {}
        if (i >= n) break;

        const line_start = i;
        // The first word of a line is always accepted, even if wider than max_width (this rung wraps at word
        // boundaries and never splits mid-word). Its width seeds the line.
        const first = try measure_word(atlas, text, i);
        var line_width: u32 = first.width;
        var line_end: u32 = first.end;
        i = first.end;

        // Grow the line word by word: measure the whitespace run, then the next word; accept while it fits.
        while (i < n) {
            const sp_start = i;
            while (i < n and text[i] == space_cp) : (i += 1) {}
            if (i >= n) break; // trailing spaces end the line; they are not part of the span
            const sp_width: u32 = (i - sp_start) * @as(u32, (atlas.lookup(space_cp) orelse return error.UncoveredCodepoint).advance);
            const word = try measure_word(atlas, text, i);
            if (line_width + sp_width + word.width > max_width) {
                // The word does not fit -- rewind to its start; the spaces before it belong to no line.
                i = word_start_rewind(sp_start, text, space_cp);
                break;
            }
            line_width += sp_width + word.width;
            line_end = word.end;
            i = word.end;
        }

        // invariant: a closed line holds at least one glyph and never begins on a space.
        assert(line_end > line_start);
        assert(text[line_start] != space_cp);
        out_lines[lines] = WrapLine{ .start = line_start, .len = line_end - line_start, .width = line_width };
        lines += 1;
    }
    // invariant: the wrap produced no more lines than bytes -- the worst-case ceiling held.
    assert(lines <= n);
    return lines;
}

/// Word-wrap with a mid-word split: break `text` into lines whose pen width stays within `max_width`, breaking at
/// spaces exactly as wrap_lines does -- yet when a single word alone overflows `max_width`, SPLIT it at a glyph
/// boundary rather than letting one line run past the max. So every emitted line stays within `max_width` whenever
/// the max holds at least one glyph, and no glyph is lost (the spans concatenate back to the words). A max narrower
/// than the narrowest glyph still places one glyph per line (progress over perfection), never looping. Returns the
/// line count. Refuses UncoveredCodepoint by name, and MaxWidthTooSmall for a zero max. This is the never-overflow
/// companion to wrap_lines' whole-word promise -- the strict/relaxed pair the text_paint rung already keeps.
pub fn wrap_lines_break(atlas: *const glyph.GlyphAtlas, text: []const u8, max_width: u32, out_lines: []WrapLine) !u32 {
    // invariant: a usable wrap needs room for at least one glyph, and the input stays within the named ceiling.
    if (max_width == 0) return error.MaxWidthTooSmall;
    if (text.len > line_glyph_max) return error.LineTooLong;
    // invariant: worst case is one line per byte (a max narrower than a glyph), so the buffer holds a line per byte.
    assert(out_lines.len >= text.len);

    const space_cp: u32 = ' ';
    var lines: u32 = 0;
    var i: u32 = 0;
    const n: u32 = @intCast(text.len);

    while (i < n) {
        // Skip the run of spaces that separates words; leading and inter-line spaces never begin a line.
        while (i < n and text[i] == space_cp) : (i += 1) {}
        if (i >= n) break;

        const line_start = i;
        const first = try measure_word(atlas, text, i);

        if (first.width > max_width) {
            // The word alone overflows the line: split it, filling this line with as many leading glyphs as fit
            // (always at least one). The remainder of the word begins the next line mid-word, where the outer loop
            // resumes -- its leading space-skip is a no-op on a non-space byte, so the remainder wraps or splits again.
            const fit = try fit_glyphs(atlas, text, i, first.end, max_width);
            // invariant: the split advanced past the line start, so the wrap always makes progress.
            assert(fit.end > line_start);
            out_lines[lines] = WrapLine{ .start = line_start, .len = fit.end - line_start, .width = fit.width };
            lines += 1;
            i = fit.end;
            continue;
        }

        var line_width: u32 = first.width;
        var line_end: u32 = first.end;
        i = first.end;

        // Grow the line word by word: measure the whitespace run, then the next word; accept while it fits.
        while (i < n) {
            const sp_start = i;
            while (i < n and text[i] == space_cp) : (i += 1) {}
            if (i >= n) break; // trailing spaces end the line; they are not part of the span
            const sp_width: u32 = (i - sp_start) * @as(u32, (atlas.lookup(space_cp) orelse return error.UncoveredCodepoint).advance);
            const word = try measure_word(atlas, text, i);
            if (line_width + sp_width + word.width > max_width) {
                // The word does not fit -- rewind to its start; the spaces before it belong to no line. If that word
                // alone overflows the next line, the outer loop's split handles it; here we only close this line.
                i = word_start_rewind(sp_start, text, space_cp);
                break;
            }
            line_width += sp_width + word.width;
            line_end = word.end;
            i = word.end;
        }

        // invariant: a closed line holds at least one glyph and never begins on a space.
        assert(line_end > line_start);
        assert(text[line_start] != space_cp);
        out_lines[lines] = WrapLine{ .start = line_start, .len = line_end - line_start, .width = line_width };
        lines += 1;
    }
    // invariant: the wrap produced no more lines than bytes -- the worst-case ceiling held.
    assert(lines <= n);
    return lines;
}

/// Rewind helper: from the start of a whitespace run, return the index of the first non-space byte -- the start of
/// the word that overflowed, where the next line begins. The spaces between are dropped from every span.
fn word_start_rewind(sp_start: u32, text: []const u8, space_cp: u32) u32 {
    var p: u32 = sp_start;
    const n: u32 = @intCast(text.len);
    // invariant: the run stays within the text.
    assert(sp_start <= n);
    while (p < n and text[p] == space_cp) : (p += 1) {}
    return p;
}

/// Count the INTERIOR word gaps in a laid-out line -- each space glyph that carries a non-space glyph on both sides.
/// A leading, trailing, or run-internal space is not a gap justification may stretch (nothing to push apart on one
/// side), so it is not counted. A single-word line has zero gaps. Bounded: the scan walks at most `count` glyphs.
fn interior_gaps(placed: []const PlacedGlyph, count: u32, space_cp: u32) u32 {
    // invariant: the reported count fits the buffer and stays within the line ceiling, so the walk is bounded.
    assert(count <= placed.len);
    assert(count <= line_glyph_max);
    if (count < 3) return 0; // a gap needs a glyph on each side -- three glyphs minimum ("a b").
    var gaps: u32 = 0;
    var i: u32 = 1;
    while (i + 1 < count) : (i += 1) {
        const is_gap = placed[i].codepoint == space_cp and
            placed[i - 1].codepoint != space_cp and
            placed[i + 1].codepoint != space_cp;
        if (is_gap) gaps += 1;
    }
    // invariant: a gap needs a neighbor pair, so there are fewer gaps than glyphs.
    assert(gaps < count);
    return gaps;
}

/// Justify a laid-out line to `target_width` by widening its interior word gaps evenly -- the flush-both-margins rung
/// the alignment family (left, right, center) was missing. `placed[0..count]` is a line already laid by layout_line,
/// so pen_x is each glyph's advance-summed origin and `current_width` is that line's pen width. The slack
/// (target_width - current_width) is spread across the interior gaps: each gap grows by `slack / gaps` cells, and the
/// first `slack % gaps` gaps take one extra cell, so the total added is exactly the slack and the last glyph's right
/// edge lands on target_width. A single-word line (zero gaps) cannot be stretched -- it is left untouched, the honest
/// classic behaviour (a last line or an unbreakable word stays left-set). Returns the line's new pen width. Pure
/// geometry: it shifts pen origins, touches no pixel and allocates nothing -- the twin discipline of layout_line.
pub fn justify_line(placed: []PlacedGlyph, count: u32, space_cp: u32, current_width: u32, target_width: u32) !u32 {
    // invariant: the buffer holds the reported glyphs and the line stays within the named ceiling.
    assert(count <= placed.len);
    assert(count <= line_glyph_max);
    // invariant: justify only ever widens -- a target tighter than the laid line is a caller error, refused by name.
    if (target_width < current_width) return error.JustifyTargetTooSmall;
    // invariant: the target stays within the proven width ceiling, so the added slack can never wrap.
    if (target_width > line_width_max) return error.JustifyTargetTooWide;

    const gaps = interior_gaps(placed, count, space_cp);
    if (gaps == 0) return current_width; // nothing to push apart -- the line stays exactly as laid.

    const slack: u32 = target_width - current_width;
    const base: u32 = slack / gaps; // every interior gap grows by at least this many cells.
    const extra: u32 = slack % gaps; // the first `extra` gaps take one more, so the total added equals the slack.

    var added: u32 = 0; // cumulative widening applied to every glyph seen so far -- only ever grows.
    var seen_gaps: u32 = 0;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        // A glyph is shifted right by all the widening that landed before it -- pen origins stay monotone.
        placed[i].pen_x += added;
        const is_gap = i > 0 and i + 1 < count and
            placed[i].codepoint == space_cp and
            placed[i - 1].codepoint != space_cp and
            placed[i + 1].codepoint != space_cp;
        if (is_gap) {
            // This gap widens after its own space glyph, so the next word starts further along.
            added += base;
            if (seen_gaps < extra) added += 1;
            seen_gaps += 1;
        }
    }
    // invariant: every interior gap was widened exactly once, and the total added is exactly the slack.
    assert(seen_gaps == gaps);
    assert(added == slack);
    const new_width: u32 = current_width + added;
    // invariant: the line now flushes to the requested target width, both margins met.
    assert(new_width == target_width);
    return new_width;
}

// --- selftest: lay real text against the full-ASCII font, prove pen positions, width, coverage, and the refusal ---

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try font_ascii.build_atlas(garden);
    const advance: u32 = font_ascii.glyph_advance; // every printable-ASCII glyph shares this advance (6 cells)

    // Lay a short line and prove the geometry: three glyphs at 0, advance, 2*advance; width = 3*advance.
    const text = "Hi!";
    const out = try garden.alloc(PlacedGlyph, text.len);
    const line = try layout_line(&atlas, text, out);
    // invariant: every byte was placed, and the total width is the sum of the shared advances.
    assert(line.count == text.len);
    assert(line.width == advance * @as(u32, text.len));

    // Each placed glyph sits at its cumulative pen origin and points at the right codepoint.
    var i: u32 = 0;
    var expect_pen: u32 = 0;
    while (i < line.count) : (i += 1) {
        assert(out[i].codepoint == text[i]);
        assert(out[i].pen_x == expect_pen);
        assert(out[i].src.codepoint == text[i]);
        expect_pen += out[i].src.advance;
    }
    // invariant: the walked pen ends exactly at the reported width.
    assert(expect_pen == line.width);

    // measure_width agrees with the laid line, without needing an out buffer.
    const w = try measure_width(&atlas, text);
    assert(w == line.width);

    // The empty line places nothing and measures zero -- a real, bounded base case.
    const empty_line = try layout_line(&atlas, "", out);
    assert(empty_line.count == 0);
    assert(empty_line.width == 0);
    assert((try measure_width(&atlas, "")) == 0);

    // covers: the full-ASCII font covers a printable line, and does not cover a control char (tab, 0x09).
    assert(covers(&atlas, text));
    const tab = [_]u8{0x09};
    assert(!covers(&atlas, tab[0..]));

    // UncoveredCodepoint: laying or measuring an uncovered byte refuses BY NAME, never a silent hole.
    if (layout_line(&atlas, tab[0..], out)) |_| return error.UncoveredSlipped else |e| {
        if (e != error.UncoveredCodepoint) return error.WrongUncovered;
    }
    if (measure_width(&atlas, tab[0..])) |_| return error.MeasureSlipped else |e| {
        if (e != error.UncoveredCodepoint) return error.WrongMeasure;
    }

    // A full printable-band sweep lays out cleanly: every codepoint 32..126 covered, width = band * advance.
    const band_lo: u32 = font_ascii.printable_lo;
    const band_hi: u32 = font_ascii.printable_hi;
    const band_len: u32 = band_hi - band_lo + 1;
    const band = try garden.alloc(u8, band_len);
    var c: u32 = 0;
    while (c < band_len) : (c += 1) band[c] = @intCast(band_lo + c);
    const band_out = try garden.alloc(PlacedGlyph, band_len);
    const band_line = try layout_line(&atlas, band, band_out);
    assert(band_line.count == band_len);
    assert(band_line.width == advance * band_len);
    assert(covers(&atlas, band));

    // --- word-wrap: break a line at spaces so each line stays within a max width ------------------------------
    const para = "ab cd ef"; // three 2-glyph words; each word 2*advance=12, a space advance=6
    // One WrapLine per byte is the worst case; size for the longest string this selftest wraps.
    const wl = try garden.alloc(WrapLine, 64);

    // A wide max holds the whole paragraph on one line: eight glyphs (two words, two spaces, ...) = 8*advance.
    const one = try wrap_lines(&atlas, para, 1000, wl);
    assert(one == 1);
    assert(wl[0].start == 0);
    assert(wl[0].len == para.len);
    assert(wl[0].width == advance * 8);

    // max_width 30 (5*advance = 30) fits "ab cd" (=30) but not a third word: two lines, no space begins a line.
    const two = try wrap_lines(&atlas, para, advance * 5, wl);
    assert(two == 2);
    // Each wrapped span's stated width equals a fresh measure of that span -- the promise a caller relies on.
    var li: u32 = 0;
    while (li < two) : (li += 1) {
        const span = para[wl[li].start .. wl[li].start + wl[li].len];
        assert(wl[li].width == (try measure_width(&atlas, span)));
        assert(para[wl[li].start] != ' ');
    }
    assert(wl[0].width == advance * 5); // "ab cd" -- five glyphs
    assert(wl[1].width == advance * 2); // "ef" -- two glyphs

    // A single word wider than max_width takes its own line whole -- wrap never splits mid-word here.
    const longword = try wrap_lines(&atlas, "abcdef", advance, wl);
    assert(longword == 1);
    assert(wl[0].width == advance * 6);

    // Multiple and leading spaces collapse cleanly: spans never begin on a space, widths stay honest.
    const messy = try wrap_lines(&atlas, "  ab   cd  ", 1000, wl);
    assert(messy == 1);
    const mspan = "  ab   cd  "[wl[0].start .. wl[0].start + wl[0].len];
    assert(mspan[0] != ' ');
    assert(wl[0].width == (try measure_width(&atlas, mspan)));

    // MaxWidthTooSmall: a zero max refuses by name rather than looping forever.
    if (wrap_lines(&atlas, para, 0, wl)) |_| return error.ZeroWidthSlipped else |e| {
        if (e != error.MaxWidthTooSmall) return error.WrongZeroWidth;
    }

    // --- wrap_lines_break: the never-overflow companion splits an over-wide word at a glyph boundary --------------
    // "abcdef" is six glyphs (width 6*advance); at max 3*advance it splits into "abc" and "def", each exactly the max.
    const bw = try garden.alloc(WrapLine, 64);
    const split2 = try wrap_lines_break(&atlas, "abcdef", advance * 3, bw);
    assert(split2 == 2);
    assert(bw[0].start == 0);
    assert(bw[0].len == 3);
    assert(bw[0].width == advance * 3);
    assert(bw[1].start == 3);
    assert(bw[1].len == 3);
    assert(bw[1].width == advance * 3);

    // A seven-glyph word at the same max splits into three lines "abc" "def" "g"; the tail carries the remainder.
    const split3 = try wrap_lines_break(&atlas, "abcdefg", advance * 3, bw);
    assert(split3 == 3);
    assert(bw[2].len == 1); // "g" alone
    assert(bw[2].width == advance);

    // The crux, proven two ways at once: every emitted line stays within the max, AND the split loses no glyph --
    // concatenating the spans reconstructs the original word byte-for-byte.
    const recon = try garden.alloc(u8, 16);
    var rlen: u32 = 0;
    var bi: u32 = 0;
    while (bi < split3) : (bi += 1) {
        assert(bw[bi].width <= advance * 3); // no line overflows the max (the never-overflow promise)
        const s = "abcdefg"[bw[bi].start .. bw[bi].start + bw[bi].len];
        var si: u32 = 0;
        while (si < s.len) : (si += 1) {
            recon[rlen] = s[si];
            rlen += 1;
        }
    }
    assert(rlen == "abcdefg".len);
    assert(std.mem.eql(u8, recon[0..rlen], "abcdefg")); // no glyph dropped or duplicated across the split

    // A word that fits whole still lays whole: break wrap is a strict superset of word wrap on a fitting paragraph,
    // so wrap_lines and wrap_lines_break agree line-for-line when no word overflows.
    const agree_wb = try wrap_lines_break(&atlas, para, advance * 5, bw);
    const agree_wl = try wrap_lines(&atlas, para, advance * 5, wl);
    assert(agree_wb == agree_wl);
    var ai: u32 = 0;
    while (ai < agree_wb) : (ai += 1) {
        assert(bw[ai].start == wl[ai].start);
        assert(bw[ai].len == wl[ai].len);
        assert(bw[ai].width == wl[ai].width);
    }

    // Word wrap then mid-word split compose: "ab cdefghij" wraps "ab" off, then splits the long word to the max.
    const mixed = try wrap_lines_break(&atlas, "ab cdefghij", advance * 3, bw);
    assert(mixed == 4); // "ab" | "cde" | "fgh" | "ij"
    var mi: u32 = 0;
    while (mi < mixed) : (mi += 1) assert(bw[mi].width <= advance * 3);

    // Progress guarantee: a max narrower than one glyph still places exactly one glyph per line, never looping.
    const tiny = try wrap_lines_break(&atlas, "ab", advance - 1, bw);
    assert(tiny == 2);
    assert(bw[0].len == 1);
    assert(bw[1].len == 1);

    // The zero-max refusal holds for the break companion too.
    if (wrap_lines_break(&atlas, para, 0, bw)) |_| return error.ZeroWidthSlipped else |e| {
        if (e != error.MaxWidthTooSmall) return error.WrongZeroWidth;
    }

    // --- justify: stretch a laid line's interior gaps so both margins flush to a wider target ---
    // "ab cd ef" lays as three two-glyph words joined by two single-space gaps; justify to width + 6 grows each gap
    // by 3, so both margins meet the target and the word origins step out by the cumulative widening.
    const jtext = "ab cd ef";
    const jout = try garden.alloc(PlacedGlyph, jtext.len);
    const jlaid = try layout_line(&atlas, jtext, jout);
    const jtarget: u32 = jlaid.width + 6; // 6 extra cells over two gaps -> 3 cells each, no remainder
    const jwidth = try justify_line(jout, jlaid.count, ' ', jlaid.width, jtarget);
    assert(jwidth == jtarget); // the line now flushes exactly to the target
    // 'a'(0) 'b'(adv) ' '(2adv) 'c'(3adv+3) 'd'(4adv+3) ' '(5adv+3) 'e'(6adv+6) 'f'(7adv+6): each gap adds 3 downstream.
    assert(jout[0].pen_x == 0);
    assert(jout[1].pen_x == advance);
    assert(jout[2].pen_x == advance * 2); // the first space sits where it was laid; the widening lands after it
    assert(jout[3].pen_x == advance * 3 + 3); // 'c' -- first word after the first stretched gap
    assert(jout[6].pen_x == advance * 6 + 6); // 'e' -- shifted by both stretched gaps
    // The pen origins stay strictly monotone after the stretch -- no glyph slid backward.
    var ji: u32 = 1;
    while (ji < jlaid.count) : (ji += 1) assert(jout[ji].pen_x > jout[ji - 1].pen_x);

    // An uneven slack spreads the remainder to the FIRST gaps: +7 over two gaps is 4 then 3.
    const jout2 = try garden.alloc(PlacedGlyph, jtext.len);
    const jlaid2 = try layout_line(&atlas, jtext, jout2);
    const jwidth2 = try justify_line(jout2, jlaid2.count, ' ', jlaid2.width, jlaid2.width + 7);
    assert(jwidth2 == jlaid2.width + 7);
    assert(jout2[3].pen_x == advance * 3 + 4); // first gap took the extra cell (4)
    assert(jout2[6].pen_x == advance * 6 + 7); // second gap took 3 -- cumulative 4 + 3 = 7

    // A single-word line has no interior gap, so justify leaves it exactly as laid -- the honest last-line behaviour.
    const jsolo = try garden.alloc(PlacedGlyph, "word".len);
    const jsololaid = try layout_line(&atlas, "word", jsolo);
    const jsolowidth = try justify_line(jsolo, jsololaid.count, ' ', jsololaid.width, jsololaid.width + 10);
    assert(jsolowidth == jsololaid.width); // untouched: no gap to stretch
    assert(jsolo[0].pen_x == 0);

    // A target tighter than the laid line refuses BY NAME rather than underflowing a pen origin.
    if (justify_line(jout, jlaid.count, ' ', jlaid.width, jlaid.width - 1)) |_| return error.TightJustifySlipped else |e| {
        if (e != error.JustifyTargetTooSmall) return error.WrongTightJustify;
    }

    print("GREEN image-text-layout: laid '{s}' as {d} glyphs at pen 0..{d} width {d}; measure agrees; empty line zero; full printable band {d}..{d} ({d} glyphs) lays clean at width {d}; wrap breaks '{s}' into {d} lines at width {d}; a too-wide word takes its own line; break-wrap splits 'abcdefg' into {d} lines each within the max with no glyph lost; justify flushes 'ab cd ef' from width {d} to {d} spreading slack across two interior gaps (single word untouched); UncoveredCodepoint, MaxWidthTooSmall, and JustifyTargetTooSmall refused by name\n", .{
        text, line.count, line.width - advance, line.width, band_lo, band_hi, band_len, band_line.width, para, two, advance * 5, split3, jlaid.width, jtarget,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: text_layout selftest\n", .{});
    return 1;
}
