//! image/font5x7_boxdrawing.rye -- the unifying box-drawing font: the whole terminal frame set in one atlas.
//!
//! Season G (Open Media Primitives) - the SECOND unifier on the SYMBOL side of the family, the sibling to the arrow
//! unifier already landed (image/font5x7_arrows.rye gathers the ten arrows), and to the two letter unifiers
//! (image/font5x7_ascii.rye, the ninety-five printable ASCII glyphs; image/font5x7_latin1_block.rye, the sixty-two
//! Latin-1 letters). The box-drawing marks still stand as four separate leaf corpora; this module gathers them whole.
//! It merges image/font5x7_box.rye (the eleven light marks, U+2500..U+253C), image/font5x7_boxdouble.rye (their eleven
//! double-line twins, U+2550..U+256C), image/font5x7_boxarc.rye (the four rounded corners, U+256D..U+2570), and
//! image/font5x7_boxdiag.rye (the three diagonals, U+2571..U+2573) into ONE gfa1 atlas -- the whole set a terminal
//! surface (the Dexter/Scooter family) reads in a single lookup the day it frames a panel, rules a table, or draws a
//! soft or diagonal edge, rather than four corpora to stitch by hand.
//!
//! The distinctive crux this module proves, beside the round-trip and the ascending-and-unique disjointness the arrow
//! unifier shares, is SPARSE BLOCK COMPLETENESS -- the deliberate contrast to the arrow set's contiguous span. The four
//! corpora draw exactly twenty-nine marks scattered across a span of one hundred sixteen codepoints (U+2500..U+2573):
//! the Box Drawing block is holey (the heavy-line variants U+2501, U+2503, and their kin are not marks this open font
//! draws). So the selftest walks the WHOLE span and proves EXACTLY twenty-nine hits and eighty-seven misses -- the exact
//! sparse shape, so a mark gained (a phantom heavy variant) or lost (a corner dropped) breaks the tally. The merged
//! count equals the SUM of the four corpora (11 + 11 + 4 + 3 = 29), which together with strictly-ascending codepoints
//! proves them DISJOINT: no corpus claims another's mark, so the four compose with no collision and no mark lost.
//!
//! The source stays plain ASCII (ASCII-first): the four corpora it merges carry numeric codepoint literals, and this
//! module names the span bounds as numeric literals too. No network, no key, no funds -- the whole terminal frame set a
//! surface reads the day it draws a box on our own open font.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_boxdrawing.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

// The four leaf corpora, gathered directly. The sort in build_atlas places every glyph regardless of gather order.
const box = @import("font5x7_box.rye"); // light marks, U+2500..U+253C, 11
const boxdouble = @import("font5x7_boxdouble.rye"); // double-line marks, U+2550..U+256C, 11
const boxarc = @import("font5x7_boxarc.rye"); // rounded corners, U+256D..U+2570, 4
const boxdiag = @import("font5x7_boxdiag.rye"); // diagonals, U+2571..U+2573, 3

pub const font5x7_boxdrawing_version = "20260817.090832";

/// The whole family shares one 5x7 cell -- all four corpora agree, and this module asserts the agreement per gather.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance every glyph carries: the cell width plus one column of daylight, the same advance the corpora carry.
pub const glyph_advance: u8 = cell_w + 1;

/// Cells per glyph -- the coverage length every glyph carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The first and last codepoints of the box-drawing span this font covers. Unlike the arrow block, this span is HOLEY --
/// only twenty-nine of its one hundred sixteen codepoints are drawn marks, so the completeness proof walks the whole span
/// and expects exactly block_count hits, the rest misses.
pub const block_first: u32 = 0x2500;
pub const block_last: u32 = 0x2573;

/// The unifying count -- the sum of the four corpora's own count constants (11 light + 11 double + 4 arc + 3 diagonal =
/// 29). Named from the corpora's own count constants, so a corpus that grows without this sum growing fails the fill
/// assert in build_atlas.
pub const block_count: u32 = box.box_count + boxdouble.box_count + boxarc.boxarc_count + boxdiag.boxdiag_count;

/// The number of codepoints in the whole box-drawing span. This span is SPARSE -- it exceeds block_count, and the selftest
/// proves the exact difference is holes (undrawn heavy-line and quadrant variants), the mirror-image of the arrow set's
/// contiguous span where the two counts agree.
pub const block_span: u32 = block_last - block_first + 1;

/// Lift one corpus atlas's glyphs into the combined table starting at `dst_off`, asserting each shares the cell and
/// advance. Returns the next free offset. The gathered coverage slices are borrowed from the source atlas, which lives in
/// the same arena -- no copy, and the merge sort below reorders references, never bytes.
fn gather(dst: []glyph.Glyph, dst_off: u32, src: *const glyph.GlyphAtlas) u32 {
    // invariant: the source shares this family's cell -- a corpus at a different size would corrupt the font.
    assert(src.cell_w == cell_w);
    assert(src.cell_h == cell_h);
    const n: u32 = @intCast(src.glyphs.len);
    // invariant: the gathered run fits inside the combined table.
    assert(dst_off + n <= block_count);
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        const g = src.glyphs[i];
        // invariant: every merged glyph carries the shared advance, so every mark lays out alike.
        assert(g.advance == glyph_advance);
        assert(g.coverage.len == cell_area);
        dst[dst_off + i] = g;
    }
    return dst_off + n;
}

/// Build the unifying box-drawing font: merge the four corpora, then sort the whole table strictly ascending by codepoint.
/// The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area); the selftest proves
/// the span ascending-and-unique, the count equal to the sum, and the whole span sparsely complete (exactly block_count
/// marks present, the rest holes).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the family cell fits the atlas ceiling, and the count fits the glyph ceiling.
    assert(cell_area <= glyph.coverage_max);
    assert(block_count <= glyph.glyph_max);
    // invariant: the unifying count is the twenty-nine marks the four corpora name, and it is strictly LESS than the span
    // -- this block is holey, the deliberate contrast to the arrow set where count equals span.
    assert(block_count == 29);
    assert(block_count < block_span);

    const glyphs = try allocator.alloc(glyph.Glyph, block_count);
    var off: u32 = 0;

    // Gather the four proven corpora. Order of gathering does not matter -- the sort below places every glyph.
    const a01 = try box.build_atlas(allocator);
    off = gather(glyphs, off, &a01);
    const a02 = try boxdouble.build_atlas(allocator);
    off = gather(glyphs, off, &a02);
    const a03 = try boxarc.build_atlas(allocator);
    off = gather(glyphs, off, &a03);
    const a04 = try boxdiag.build_atlas(allocator);
    off = gather(glyphs, off, &a04);

    // invariant: the four corpora fill the table exactly -- a short count would mean a lost corpus.
    assert(off == block_count);

    // Insertion sort by codepoint -- bounded by block_count, stable, and small (twenty-nine glyphs). The gfa1 encoder
    // demands strictly ascending codepoints; this is where the four corpora become one ordered font.
    var i: u32 = 1;
    while (i < block_count) : (i += 1) {
        const key = glyphs[i];
        var j: u32 = i;
        while (j > 0 and glyphs[j - 1].codepoint > key.codepoint) : (j -= 1) {
            glyphs[j] = glyphs[j - 1];
        }
        glyphs[j] = key;
    }

    // invariant: the sorted table opens at the light horizontal (U+2500) and closes at the diagonal cross (U+2573) -- the
    // whole box-drawing span this font covers, end to end.
    assert(glyphs[0].codepoint == block_first);
    assert(glyphs[block_count - 1].codepoint == block_last);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- every box-drawing mark carries ink; none is blank.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

// --- selftest: build the whole box-drawing font, round-trip it, prove disjoint corpora and SPARSE COMPLETENESS ---------

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built font is the twenty-nine-mark set at the shared cell.
    assert(glyph_count == block_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // The disjointness crux: the merged codepoints run STRICTLY ASCENDING with NO DUPLICATE. Since the merged count is the
    // sum of the four corpora (asserted 29 in build_atlas), strictly-ascending here proves the corpora disjoint -- a
    // collision (two corpora drawing one mark) would fail this walk.
    var e: u32 = 1;
    while (e < glyph_count) : (e += 1) {
        if (!(atlas.glyphs[e].codepoint > atlas.glyphs[e - 1].codepoint)) return error.CodepointsNotStrictlyAscending;
    }

    // The SPARSE COMPLETENESS crux: walk the WHOLE box-drawing span U+2500..U+2573 and tally hits and misses. Exactly
    // block_count (29) codepoints are drawn marks and the rest are holes -- the undrawn heavy-line and quadrant variants
    // this open font does not carry. This is the deliberate contrast to the arrow unifier's contiguous span: there every
    // codepoint was a hit; here the exact sparse shape is the proof, so a phantom mark or a dropped corner breaks the tally.
    var hits: u32 = 0;
    var misses: u32 = 0;
    var cp: u32 = block_first;
    while (cp <= block_last) : (cp += 1) {
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == glyph_advance);
            hits += 1;
        } else misses += 1;
    }
    // invariant: exactly the twenty-nine named marks are present, and the rest of the span is holes -- the two tallies sum
    // to the whole span, so neither a phantom nor a dropped mark can hide.
    if (hits != block_count) return error.BoxCoverageWrongCount;
    if (misses != block_span - block_count) return error.BoxHoleWrongCount;
    if (hits + misses != block_span) return error.BoxSpanTallyMismatch;

    // Two named holes proven absent by hand, so the sparse shape is not merely a count: the heavy horizontal (U+2501) and
    // the heavy vertical (U+2503) sit between drawn marks yet are not this font's -- a terminal that wants them reaches a
    // heavy corpus a later rung may draw.
    if (back.lookup(0x2501)) |_| return error.PhantomHeavyHorizontal else {}
    if (back.lookup(0x2503)) |_| return error.PhantomHeavyVertical else {}

    // A plain ASCII 'A' misses (this is the box-drawing set, not letters) and a codepoint just past the span (U+2574)
    // misses too (no phantom mark beyond the block this font covers).
    if (back.lookup('A')) |_| return error.NonBoxFound else {}
    if (back.lookup(block_last + 1)) |_| return error.PhantomBoxFound else {}

    // Every glyph carries ink -- there is no blank in a box-drawing set.
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < glyph_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n == 0) return error.BoxGlyphBlank;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }

    // Compression is reported as a fact, not asserted -- the round-trip is the proof (the REDS %82 lesson).
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-boxdrawing: {d} box-drawing marks across the sparse span U+2500..U+2573 ({d} codepoints, {d} holes) at {d}x{d} round-trip byte-identical; codepoints strictly ascending and unique (four corpora disjoint: 11 light + 11 double + 4 arc + 3 diagonal); sparsely complete (exactly {d} present, the heavy variants proven absent), every glyph inked (ink {d}..{d} of {d}); encoded {d} bytes, raw {d}\n", .{
        glyph_count, block_span, block_span - block_count, cell_w, cell_h, block_count, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_boxdrawing selftest\n", .{});
    return 1;
}
