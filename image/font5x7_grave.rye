//! image/font5x7_grave.rye -- the open grave-accent vowels corpus: the mirror of the acute set (Season G, font content).
//!
//! Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the
//! five ASCII corpora (image/font5x7.rye the numerals, image/font5x7_alpha.rye the uppercase, image/font5x7_lower.rye
//! the lowercase, image/font5x7_punct.rye the punctuation, image/font5x7_symbol.rye the symbols), the wider-symbol
//! corpora (the box family, the arrows, the block elements, the geometric marks, the math/technical operators, the
//! currency signs), the Greek letters (image/font5x7_greek.rye), the sub/superscript and fraction corpora, and the
//! Latin-1 acute/cedilla corpus (image/font5x7_latin1.rye). Where that corpus supplies the marks a Romance name in the
//! Iberian hand reaches for, this one supplies the five grave-accent lowercase vowels a French, Italian, or Portuguese
//! name reaches for -- a grave, e grave, i grave, o grave, u grave, at their real Unicode codepoints U+00E0, U+00E8,
//! U+00EC, U+00F2, U+00F9, drawn in our own open hand on the same 5x7 body. These are the letters that let a civic
//! surface print a keeper's own name -- Andrea, Nicole, Fabio, Antonio, Ilaria -- with the accent that name actually
//! carries, rather than an ASCII-folded approximation of it.
//!
//! The corpus is the deliberate MIRROR of the acute set: the acute mark in image/font5x7_latin1.rye rises to the right
//! (its top-row ink sits right-of-center), while the grave mark here descends to the right -- its top-row ink sits
//! LEFT-of-center. That symmetry is the crux this corpus proves: each grave vowel carries top-row ink in the left half
//! (columns 0-1) and none in the right half (columns 3-4), the honest signal that separates a grave letter from its
//! acute twin. This mirrors, in placement, the diacritic proof the acute/cedilla corpus carries in kind.
//!
//! The source stays plain ASCII (ASCII-first): the codepoints are written as numeric literals (0x00E0 ...) and each
//! letter is named in an ASCII comment, so no non-ASCII byte enters the file even though the glyphs it builds cover a
//! non-ASCII range. The codepoints are NOT contiguous (they skip the unaccented and acute letters between them in the
//! Latin-1 Supplement block), so this corpus carries an explicit ascending codepoint table -- the shape the gfa1
//! encoder trusts (strictly ascending, shared cell, coverage length == cell area). The drawings ARE the specification:
//! each letter is seven rows of five cells in ASCII line art ('#' full ink, '.' none) that a reader audits by eye; the
//! coverage bytes are derived from that art, never the reverse. build_atlas turns the five drawings into a
//! glyph.GlyphAtlas the gfa1 encoder accepts, so the property that matters stays provable on metal: decode(encode(atlas))
//! recovers every glyph byte-for-byte, the letters are present and distinct, each reads within an honest legibility
//! band, and each grave mark leans left where its acute twin leans right. No network, no key, no funds -- the marks a
//! surface reads the day it prints a name that ASCII cannot spell, on our own open font.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_grave.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

pub const font5x7_grave_version = "20260817.055434";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the ASCII, Greek, and Latin-1 corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const grave_advance: u8 = cell_w + 1;

/// The corpus holds exactly the five grave-accent vowels named in the table below.
pub const grave_count: u32 = 5;

/// Cells per glyph -- the coverage length every letter carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The column that separates the two halves of the cell. Columns 0-1 are the left half, columns 3-4 the right half;
/// column 2 (the center) belongs to neither, so a mark sitting dead-center leans nowhere. The grave proof reads these.
pub const center_col: u32 = 2;

/// The five grave codepoints, strictly ascending -- the order the gfa1 encoder trusts. Each aligns by index with
/// grave_art below. Written as numeric literals so the source stays plain ASCII while the glyphs cover a non-ASCII
/// range:
///   0x00E0 a grave, 0x00E8 e grave, 0x00EC i grave, 0x00F2 o grave, 0x00F9 u grave. The unaccented and acute letters
///   between them in the Latin-1 Supplement block are skipped, so the codepoints are named outright rather than derived.
const grave_codepoints = [grave_count]u32{
    0x00E0, 0x00E8, 0x00EC, 0x00F2, 0x00F9,
};

/// The five letters, drawn in the open. Each is seven rows of five cells; '#' ink, '.' background. A reader audits
/// every letter here by eye, and the coverage bytes are lifted from this art, never guessed. Every letter wears the
/// same grave mark on its top two rows -- a stroke that descends to the right (column 1 on row 0, column 2 on row 1),
/// sitting LEFT of center -- above a letter body shared with the acute twins in image/font5x7_latin1.rye. The mark
/// leaning left is the whole point: it is the acute mark reflected, the difference between a grave letter and an acute one.
const grave_art = [grave_count][cell_h][]const u8{
    .{ ".#...", "..#..", ".###.", "....#", ".####", "#...#", ".####" }, // U+00E0 a grave
    .{ ".#...", "..#..", ".###.", "#...#", "#####", "#....", ".###." }, // U+00E8 e grave
    .{ ".#...", "..#..", ".##..", "..#..", "..#..", "..#..", ".###." }, // U+00EC i grave
    .{ ".#...", "..#..", ".###.", "#...#", "#...#", "#...#", ".###." }, // U+00F2 o grave
    .{ ".#...", "..#..", "#...#", "#...#", "#...#", "#...#", ".####" }, // U+00F9 u grave
};

/// Lift one letter's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad glyph.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the grave-accent vowels atlas: five glyphs at the named ascending codepoints, sharing the 5x7 cell and
/// advance. The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the five named grave vowels and no more.
    assert(grave_count == 5);
    assert(cell_area == 35);
    const glyphs = try allocator.alloc(glyph.Glyph, grave_count);
    var i: u32 = 0;
    var last_cp: u32 = 0;
    while (i < grave_count) : (i += 1) {
        const cp = grave_codepoints[i];
        // invariant: codepoints are strictly ascending -- the ordering the gfa1 encoder trusts.
        assert(i == 0 or cp > last_cp);
        last_cp = cp;
        const cov = try coverage_from_art(allocator, grave_art[i]);
        glyphs[i] = glyph.Glyph{
            .codepoint = cp,
            .advance = grave_advance,
            .coverage = cov,
        };
    }
    // invariant: the last codepoint is the u grave (U+00F9) -- the table ends where this set ends.
    assert(glyphs[grave_count - 1].codepoint == 0x00F9);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

/// Count the inked cells in row r of a glyph, restricted to the half-open column band [c0, c1). The grave proof reads
/// the top row's left half (columns 0-2) and right half (columns 3-5) with this one reader. Row 0 is the top.
fn row_band_ink(cov: []const u8, r: u32, c0: u32, c1: u32) u32 {
    // invariant: the row index sits inside the shared cell, over the shared grid.
    assert(r < cell_h);
    assert(cov.len == cell_area);
    // invariant: the column band is well-ordered and inside the cell width.
    assert(c0 <= c1);
    assert(c1 <= cell_w);
    var n: u32 = 0;
    var c: u32 = c0;
    while (c < c1) : (c += 1) {
        if (cov[r * cell_w + c] != 0) n += 1;
    }
    // invariant: the band count never exceeds the band it was counted over.
    assert(n <= c1 - c0);
    return n;
}

/// The top-row ink in the left half (columns 0-1) of a codepoint's glyph -- the reader the grave-leans-left proof uses.
fn top_left_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return row_band_ink(g.coverage, 0, 0, center_col);
    return error.GraveVowelMissing;
}

/// The top-row ink in the right half (columns 3-4) of a codepoint's glyph -- the reader that proves the mark stayed left.
fn top_right_ink_of(atlas: *const glyph.GlyphAtlas, codepoint: u32) !u32 {
    if (atlas.lookup(codepoint)) |g| return row_band_ink(g.coverage, 0, center_col + 1, cell_w);
    return error.GraveVowelMissing;
}

// --- selftest: build the grave atlas, round-trip it through gfa1, prove all present, distinct, legible, left-leaning --

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the five-vowel corpus at the shared cell.
    assert(glyph_count == grave_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Five present vowels: every one looks up, carries the shared advance; an unaccented ASCII vowel misses.
    var d: u32 = 0;
    while (d < grave_count) : (d += 1) {
        const cp = grave_codepoints[d];
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == grave_advance);
        } else return error.GraveVowelMissing;
    }
    if (back.lookup('a')) |_| return error.NonGraveFound else {}

    // Distinctness: no two letters share identical coverage -- the a grave and the o grave differ, the i grave and the
    // u grave differ (catches a copy slip that would leave two names spelled with one glyph).
    var a: u32 = 0;
    while (a < grave_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < grave_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.GraveVowelsNotDistinct;
        }
    }

    // Legibility: each letter's ink count sits inside an honest band. The floor sits where the i grave (its lightest,
    // a thin stem under a mark) still reads, the ceiling where the a grave and e grave (its heaviest) still resolve as
    // letters, not blocks.
    const ink_min: u32 = 8;
    const ink_max: u32 = 18;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < grave_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.GraveVowelIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Grave placement -- the mirror of the acute proof, and what makes each of these a grave letter rather than an acute
    // one: every grave vowel carries top-row ink in the LEFT half (columns 0-1) and none in the right half (columns
    // 3-4). The acute corpus (image/font5x7_latin1.rye) leans the same mark right; here it leans left. This proves the
    // mark sits where a grave accent demands rather than drifting into the acute's place or into the body.
    var m: u32 = 0;
    while (m < grave_count) : (m += 1) {
        const cp = grave_codepoints[m];
        if (!(try top_left_ink_of(&atlas, cp) >= 1)) return error.GraveNotLeftLeaning;
        if (!(try top_right_ink_of(&atlas, cp) == 0)) return error.GraveMarkDriftedRight;
    }

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-grave: {d} grave vowels U+00E0,U+00E8,U+00EC,U+00F2,U+00F9 at {d}x{d} round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); every mark leans left (mirror of the acute set); encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_grave selftest\n", .{});
    return 1;
}
