//! image/font5x7_arrow.rye -- the open arrow corpus: the six basic directional arrows (Season G, font content).
//!
//! Season G (Open Media Primitives) - more content BEYOND printable ASCII for the open glyph atlas image/glyph.rye
//! (gfa1), a sibling of the box-drawing corpora (image/font5x7_box.rye the light single-line set,
//! image/font5x7_boxdouble.rye the double-line set). Where the box corpora frame and rule, arrows POINT: this corpus
//! draws the six basic directional arrows -- left, up, right, down, and the two axis double-heads (left-right,
//! up-down) -- at their real Unicode codepoints U+2190..U+2195. These are exactly the marks a terminal surface (the
//! Dexter/Scooter family) reaches for to mark a selection, scroll a list, or point at a field, drawn in our own open
//! hand on the same 5x7 body.
//!
//! The source stays plain ASCII (ASCII-first): the codepoints are written as numeric literals (0x2190 ...) and each
//! arrow is named in an ASCII comment, so no non-ASCII byte enters the file even though the glyphs it builds cover a
//! non-ASCII range. The codepoints are contiguous U+2190..U+2195 -- still carried as an explicit ascending table, the
//! shape the gfa1 encoder trusts (strictly ascending, shared cell, coverage length == cell area). The drawings ARE
//! the specification: each arrow is seven rows of five cells in ASCII line art ('#' full ink, '.' none) -- a shaft on
//! the middle row (3) or middle column (2) with a filled-triangle head for the four cardinals, and outward chevron
//! heads for the two double-heads -- that a reader audits by eye; the coverage bytes are derived from that art, never
//! the reverse. build_atlas turns the six drawings into a glyph.GlyphAtlas the gfa1 encoder accepts, so the property
//! that matters stays provable on metal: decode(encode(atlas)) recovers every glyph byte-for-byte, the arrows are
//! present and distinct, and each reads within an honest legibility band. No network, no key, no funds -- the marks a
//! surface reads the day it wants to point.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run image/font5x7_arrow.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const glyph = @import("glyph.rye");

pub const font5x7_arrow_version = "20260817.000000";

/// Every glyph in this corpus shares one 5-wide, 7-tall cell -- the same body the ASCII and box corpora carry.
pub const cell_w: u8 = 5;
pub const cell_h: u8 = 7;

/// The pen advance: the cell width plus one column of daylight, the same advance the sibling corpora carry.
pub const arrow_advance: u8 = cell_w + 1;

/// The corpus holds exactly the six basic directional arrows named in the table below.
pub const arrow_count: u32 = 6;

/// Cells per glyph -- the coverage length every arrow carries, named at construction.
pub const cell_area: u32 = @as(u32, cell_w) * @as(u32, cell_h);

/// The six arrow codepoints, strictly ascending and contiguous -- the order the gfa1 encoder trusts. Each aligns by
/// index with arrow_art below. Written as numeric literals so the source stays plain ASCII while the glyphs cover a
/// non-ASCII range:
///   0x2190 leftwards, 0x2191 upwards, 0x2192 rightwards, 0x2193 downwards, 0x2194 left-right, 0x2195 up-down.
const arrow_codepoints = [arrow_count]u32{
    0x2190, 0x2191, 0x2192, 0x2193, 0x2194, 0x2195,
};

/// The six arrows, drawn in the open. Each is seven rows of five cells; '#' ink, '.' background. The four cardinals
/// carry a shaft on the middle row/column and a filled-triangle head; the two double-heads carry outward chevrons on
/// both ends. A reader audits every arrow here by eye, and the coverage bytes are lifted from this art, never guessed.
const arrow_art = [arrow_count][cell_h][]const u8{
    .{ ".....", "..#..", ".##..", "#####", ".##..", "..#..", "....." }, // U+2190 leftwards  (head tip at col 0)
    .{ ".....", "..#..", ".###.", "#####", "..#..", "..#..", "..#.." }, // U+2191 upwards     (head tip at row 0)
    .{ ".....", "..#..", "..##.", "#####", "..##.", "..#..", "....." }, // U+2192 rightwards  (head tip at col 4)
    .{ "..#..", "..#..", "..#..", "#####", ".###.", "..#..", "....." }, // U+2193 downwards   (head tip at row 6)
    .{ ".....", ".....", ".#.#.", "#####", ".#.#.", ".....", "....." }, // U+2194 left-right  (chevrons both ends)
    .{ "..#..", ".#.#.", "..#..", "..#..", "..#..", ".#.#.", "..#.." }, // U+2195 up-down     (chevrons both ends)
};

/// Lift one arrow's ASCII art into a freshly allocated coverage grid of exactly cell_area bytes: 255 for ink,
/// 0 for background. The art's own shape is asserted, so a mistyped row is a stopped line rather than a bad glyph.
fn coverage_from_art(allocator: std.mem.Allocator, art: [cell_h][]const u8) ![]u8 {
    // invariant: a coverage grid is exactly the shared cell area, within the atlas ceiling.
    assert(cell_area >= 1);
    assert(cell_area <= glyph.coverage_max);
    const cov = try allocator.alloc(u8, cell_area);
    var idx: u32 = 0;
    var r: u32 = 0;
    while (r < cell_h) : (r += 1) {
        const row = art[r];
        // invariant: every drawn row is exactly the cell width -- the art matches the grid.
        assert(row.len == cell_w);
        var c: u32 = 0;
        while (c < cell_w) : (c += 1) {
            cov[idx] = if (row[c] == '#') 255 else 0;
            idx += 1;
        }
    }
    // invariant: the whole grid was filled, no cell left unwritten.
    assert(idx == cell_area);
    return cov;
}

/// Build the arrow atlas: six glyphs at the named ascending codepoints, sharing the 5x7 cell and advance.
/// The gfa1 encoder accepts the result directly (ascending codepoints, coverage length == cell area).
pub fn build_atlas(allocator: std.mem.Allocator) !glyph.GlyphAtlas {
    // invariant: the corpus is the six named arrows and no more.
    assert(arrow_count == 6);
    assert(cell_area == 35);
    const glyphs = try allocator.alloc(glyph.Glyph, arrow_count);
    var i: u32 = 0;
    var last_cp: u32 = 0;
    while (i < arrow_count) : (i += 1) {
        const cp = arrow_codepoints[i];
        // invariant: codepoints are strictly ascending -- the ordering the gfa1 encoder trusts.
        assert(i == 0 or cp > last_cp);
        last_cp = cp;
        const cov = try coverage_from_art(allocator, arrow_art[i]);
        glyphs[i] = glyph.Glyph{
            .codepoint = cp,
            .advance = arrow_advance,
            .coverage = cov,
        };
    }
    // invariant: the last codepoint is the up-down arrow (U+2195) -- the table ends where the basic set ends.
    assert(glyphs[arrow_count - 1].codepoint == 0x2195);
    return glyph.GlyphAtlas{ .cell_w = cell_w, .cell_h = cell_h, .glyphs = glyphs };
}

/// Count the inked cells (coverage byte != 0) in a glyph -- the legibility signal a blank glyph would fail.
fn ink_count(cov: []const u8) u32 {
    // invariant: coverage is the shared, bounded grid.
    assert(cov.len == cell_area);
    var n: u32 = 0;
    var i: u32 = 0;
    while (i < cov.len) : (i += 1) {
        if (cov[i] != 0) n += 1;
    }
    // invariant: the ink count never exceeds the grid it was counted over.
    assert(n <= cell_area);
    return n;
}

// --- selftest: build the arrow atlas, round-trip it through gfa1, prove all present, distinct, legible -----------

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const atlas = try build_atlas(garden);
    const glyph_count: u32 = @intCast(atlas.glyphs.len);
    // invariant: the built atlas is the six-arrow corpus at the shared cell.
    assert(glyph_count == arrow_count);
    assert(atlas.cell_area() == cell_area);

    // Round-trip through the gfa1 encoder/decoder, byte-for-byte -- the crux inherited from the atlas rung.
    const cap = glyph.encoded_bound(glyph_count, cell_area);
    const dst = try garden.alloc(u8, cap);
    const res = try glyph.encode(&atlas, dst);
    const stream = dst[0..res.len];
    const back = try glyph.decode(garden, stream);
    assert(back.same_bytes(&atlas));

    // Six present arrows: every one looks up, carries the shared advance; an ASCII letter misses.
    var d: u32 = 0;
    while (d < arrow_count) : (d += 1) {
        const cp = arrow_codepoints[d];
        if (back.lookup(cp)) |g| {
            assert(g.codepoint == cp);
            assert(g.advance == arrow_advance);
        } else return error.ArrowMissing;
    }
    if (back.lookup('A')) |_| return error.NonArrowFound else {}

    // Distinctness: no two arrows share identical coverage -- a real arrow set points four ways (catches a copy slip).
    var a: u32 = 0;
    while (a < arrow_count) : (a += 1) {
        var b: u32 = a + 1;
        while (b < arrow_count) : (b += 1) {
            if (std.mem.eql(u8, atlas.glyphs[a].coverage, atlas.glyphs[b].coverage)) return error.ArrowsNotDistinct;
        }
    }

    // Legibility: each arrow's ink count sits inside an honest band. The floor sits where a double-head chevron arrow
    // (nine cells) still reads, and the ceiling where a filled-triangle cardinal (twelve cells) still resolves as an
    // arrow rather than a blob.
    const ink_min: u32 = 6;
    const ink_max: u32 = 16;
    var lo: u32 = cell_area;
    var hi: u32 = 0;
    var k: u32 = 0;
    while (k < arrow_count) : (k += 1) {
        const n = ink_count(atlas.glyphs[k].coverage);
        if (n < ink_min or n > ink_max) return error.ArrowIllegible;
        if (n < lo) lo = n;
        if (n > hi) hi = n;
    }
    // invariant: the observed ink band stayed inside the honest bounds.
    assert(lo >= ink_min);
    assert(hi <= ink_max);

    // Compression is reported as a fact, not asserted -- the round-trip is the proof.
    const raw_coverage = glyph_count * cell_area;
    print("GREEN image-font5x7-arrow: {d} arrows U+2190..U+2195 at {d}x{d} round-trip byte-identical; all present, distinct, legible (ink {d}..{d} of {d}); encoded {d} bytes, raw {d}\n", .{
        glyph_count, cell_w, cell_h, lo, hi, cell_area, res.len, raw_coverage,
    });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: font5x7_arrow selftest\n", .{});
    return 1;
}
