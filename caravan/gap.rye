//! Caravan gap -- a hole in a ring is a place the lap waits at, and the
//! bell is the one thing a fall can swallow that a restart will not redo.
//!
//! `cycle.rye` closed the ring: every domain a middle, the flow graph
//! closing on itself, a lap that settles because no verb waits. Every
//! domain in it ran to completion. A ring that only ever completes has
//! proven nothing about the day one of its middles falls, and a middle is
//! the only kind of domain a ring has.
//!
//! So this ring drops `birch` mid-lap, with asks standing in the arcs on
//! either side of it, and asks two questions. **What does a lap owe a
//! domain that was absent for part of it?** And **does a circuit with a
//! hole in it settle, or simply wait for the hole to close?**
//!
//! The first answer is the reassuring one, and `restart.rye` already
//! taught its shape: a lap owes a returned domain nothing at all, because
//! the debt is written where the domain can read it. A region belongs to
//! the declaration rather than to a process, so the asks alder placed
//! stand exactly where they stood, and the arithmetic that says how many
//! wait -- the inbound head above the onward head -- reads the same on the
//! attempt after the fall as it would have on the attempt that fell. A
//! domain that falls before it writes costs the ring one attempt and
//! nothing else.
//!
//! The second answer is the finding, and it is sharper than it looks:
//!
//!   **Idempotence over bytes is what makes a restart safe, and it is also
//!   what makes a restart silent.**
//!
//! A step written to be safe to take twice finds, on its second taking,
//! that there is nothing left to do -- and so it does nothing, including
//! the one thing that was actually left undone. `birch` falls after
//! writing its onward batch and before ringing `cedar`. The bytes are
//! whole. The restart reads its arc, finds nothing pending, reports
//! nothing new, and rings nobody. `cedar` hears an unrung bell, and the
//! lap stalls one arc short of home with every ask it was carrying safely
//! on disk. Nothing was lost, and nothing arrives.
//!
//! The cure is to make the wake idempotent too, which is what the two
//! readings of a pass named here are for:
//!
//!   when_moved   The pass rings its successor only when this attempt
//!                actually moved bytes. This is the strict reading, and it
//!                is the one `cycle.rye` runs, where nothing ever falls.
//!   every_pass   The pass rings its successor whenever the pass
//!                completes, whether or not this attempt moved anything.
//!                A bell rung twice costs a wasted pass; a bell never rung
//!                costs the lap.
//!
//! One line apart, and the difference is a ring that closes against a ring
//! that stands still holding all its work. Both readings run here, so the
//! stall is proven rather than asserted.
//!
//! A pass under either reading checks **where things stand** rather than
//! how far this attempt moved them: after the move, the onward arc stands
//! at the inbound head, and that total is what the step is held to. A
//! restarted step that measured its own progress would call a correct
//! no-op a failure.
//!
//! And every attempt -- the first and each restart after it -- reloads the
//! declaration from disk and derives the returning domain's line from that
//! read, so a domain that comes back takes its rights from the document
//! rather than from a parent's memory of it (`rederive.rye`).
//!
//! Hosted ground: real processes, real files, pure policy, no kernel
//! underneath it yet.
//!
//! Usage:
//!   gap selftest                  Drop a middle mid-lap and see what stands
//!   gap                           Same as selftest
//!   gap dependent <domain> <plan> ... Run as a supervised dependent (internal)

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const regions = @import("regions.rye");
const channels = @import("channels.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const serve = @import("serve.rye");
const queue = @import("queue.rye");
const relay = @import("relay.rye");
const cycle = @import("cycle.rye");
const restart = @import("restart.rye");
const tally_parse_int = @import("parse_int.rye");

const caravan_gap_version = "20260819.164844";

// =========================================================================
// The bounds -- one ring, one hole, a bounded number of returns
// =========================================================================

/// The ring this module drops a middle out of, unchanged from `cycle.rye`.
///
/// The question here is about a fall rather than about a shape, so the
/// shape stays exactly the one already proven, and nothing new is declared.
pub const declaration_path = cycle.declaration_path;

/// How many times one assigned step may be attempted before the supervisor
/// gives up on it.
///
/// Two is enough to state the whole property: one attempt that falls, one
/// that returns. The bound exists so a domain that falls every time ends
/// the run by name rather than spinning.
pub const max_attempts: u32 = 2;

/// A dependent's fixed argv: the program, the marker, its domain, its plan, the
/// point it may be dropped at, how it wakes its successor, and how many
/// capability words follow.
pub const fixed_argv_words: u32 = 7;

comptime {
    // invariant: a fall is always followed by at least one return
    assert(max_attempts >= 2);
    // invariant: a return here stays within what a supervisor already allows
    assert(max_attempts <= restart.max_restarts + 1);
    // invariant: a whole dependent argv stays within what one run builds
    assert(fixed_argv_words + capabilities.max_caps_per_dependent + notify.max_peers_per_dependent <= 32);
}

/// Names one outcome for an operator, adding the one word a ring under
/// fall needs that a whole ring never did.
pub fn outcome_name(code: u8) []const u8 {
    if (code == restart.fell) return "fell";
    return cycle.outcome_name(code);
}

// =========================================================================
// The fall wire -- where in a pass the supervisor drops the middle
// =========================================================================

/// Where an injected fall lands inside one pass.
///
/// A pass consumes a wake and produces a batch, so the two points worth
/// dropping it at sit either side of the write: before it, where nothing
/// has changed, and after it, where everything has changed except the one
/// bell that tells the successor so.
pub const Fall = enum { none, after_hear, after_write };

/// Renders one fall point as the word its dependent will read.
pub fn fall_word(f: Fall) []const u8 {
    return switch (f) {
        .none => "run",
        .after_hear => "fall-after-hear",
        .after_write => "fall-after-write",
    };
}

/// Reads a fall word back, refusing anything it cannot name.
pub fn read_fall(word: []const u8) ?Fall {
    // invariant: a fall word worth reading carries something
    assert(word.len >= 1);
    if (std.mem.eql(u8, word, "run")) return .none;
    if (std.mem.eql(u8, word, "fall-after-hear")) return .after_hear;
    if (std.mem.eql(u8, word, "fall-after-write")) return .after_write;
    return null;
}

/// The two readings of when a pass rings the neighbor that carries its work
/// onward.
///
/// `when_moved` is the strict reading a whole ring runs under, where a pass
/// that moved nothing has nothing to announce. `every_pass` rings on every
/// completed pass, so a wake swallowed by a fall is replaced by the attempt
/// that returns.
pub const Wake = enum { when_moved, every_pass };

/// Renders one wake reading as the word its dependent will read.
pub fn wake_word(w: Wake) []const u8 {
    return switch (w) {
        .when_moved => "wake-when-moved",
        .every_pass => "wake-every-pass",
    };
}

/// Reads a wake word back, refusing anything it cannot name.
pub fn read_wake(word: []const u8) ?Wake {
    // invariant: a wake word worth reading carries something
    assert(word.len >= 1);
    if (std.mem.eql(u8, word, "wake-when-moved")) return .when_moved;
    if (std.mem.eql(u8, word, "wake-every-pass")) return .every_pass;
    return null;
}

// =========================================================================
// The dependent -- one process, one arc, one place it may be dropped
// =========================================================================

/// Reads how far a writer's head stands against a reader's own, and answers
/// how many messages wait -- or names why the pair is unreadable.
///
/// Exported so a supervisor asking a further question of the same ring --
/// `decline.rye` asks what the circuit may do when the hole stays open --
/// reads the arc by the same arithmetic rather than growing a second one.
pub fn pending_between(head: u32, tail: u32) ?u32 {
    if (head < tail) return null;
    const waiting = head - tail;
    if (waiting > queue.max_outstanding) return null;
    return waiting;
}

/// Writes a batch of asks naming this domain as their origin, and rings the
/// successor that will carry them onward.
fn do_place(
    io: std.Io,
    slot: *const capabilities.DependentSlot,
    peers: *const notify.PeerList,
    self_name: []const u8,
    task: cycle.Task,
) u8 {
    if (task.count == 0 or task.count > queue.max_outstanding) return carry.Outcome.malformed;
    const mine = task.hops.name_at(0);
    const successor = task.peers.name_at(0);
    if (!peers.wired_to(successor)) return notify.Bell.not_wired;

    const head = queue.read_index(io, slot, mine) catch |err| return serve.reach_code(err);
    var k: u32 = 0;
    while (k < task.count) : (k += 1) {
        var text_buf: [serve.max_message_len]u8 = undefined;
        const text = relay.ask_text(&text_buf, self_name, head + k);
        queue.write_slot(io, slot, mine, head + k, text) catch |err|
            return serve.reach_code(err);
    }
    queue.write_index(io, slot, mine, head + task.count) catch |err|
        return serve.reach_code(err);
    const rung = roundtrip.ring_to(io, peers, self_name, successor) catch |err|
        return serve.bell_code(err);
    // invariant: a batch that landed spends exactly one ring
    assert(rung >= 1);
    print("    {s}: placed {d}, head now {d}\n", .{ self_name, task.count, head + task.count });
    return carry.Outcome.carried_ok;
}

/// Carries every standing ask one arc further around the ring, dropping the
/// dependent where the supervisor asked and waking the successor by the reading
/// the supervisor named.
///
/// The step is held to where its arc **stands** once the move is done --
/// the onward head level with the inbound head, at the total the plan names
/// -- rather than to how far this attempt moved it. A restarted step that
/// measured its own progress would read a correct no-op as a failure.
fn do_pass(
    io: std.Io,
    slot: *const capabilities.DependentSlot,
    peers: *const notify.PeerList,
    self_name: []const u8,
    task: cycle.Task,
    fall: Fall,
    wake: Wake,
) u8 {
    const inbound = task.hops.name_at(0);
    const onward = task.hops.name_at(1);
    const predecessor = task.peers.name_at(0);
    const successor = task.peers.name_at(1);
    if (!peers.wired_to(predecessor)) return notify.Bell.not_wired;
    if (!peers.wired_to(successor)) return notify.Bell.not_wired;

    const rung = roundtrip.hear_from(io, peers, self_name, predecessor) catch |err|
        return serve.bell_code(err);
    if (rung == 0) return notify.Bell.unheard;
    if (fall == .after_hear) return restart.fell;

    const head = queue.read_index(io, slot, inbound) catch |err| return serve.reach_code(err);
    const sent = queue.read_index(io, slot, onward) catch |err| return serve.reach_code(err);
    const pending = pending_between(head, sent) orelse return carry.Outcome.bytes_differed;
    // The strict reading stops here with nothing to announce. This one line
    // is the whole difference between a ring that closes after a fall and a
    // ring that stands still holding all of its work.
    if (pending == 0 and wake == .when_moved) return queue.nothing_new;

    var seq = sent;
    while (seq < head) : (seq += 1) {
        var seen_buf: [serve.max_message_len]u8 = undefined;
        const seen = queue.read_slot(io, slot, inbound, seq, &seen_buf) catch |err|
            return serve.reach_code(err);
        const message = seen orelse return carry.Outcome.bytes_differed;
        // An ask whose bytes never carried this ring's shape is refused
        // here rather than handed to a neighbor that would have to guess.
        const origin = relay.asked_origin(message) orelse return carry.Outcome.bytes_differed;
        // A passer carries what it was handed; an ask it authored itself
        // would make the origin its own invention rather than a fact.
        if (std.mem.eql(u8, origin, self_name)) return carry.Outcome.bytes_differed;
        queue.write_slot(io, slot, onward, seq, message) catch |err|
            return serve.reach_code(err);
    }
    // invariant: the walk stopped exactly where the inbound head stands
    assert(seq == head);
    queue.write_index(io, slot, onward, head) catch |err| return serve.reach_code(err);
    if (fall == .after_write) return restart.fell;

    const rang = roundtrip.ring_to(io, peers, self_name, successor) catch |err|
        return serve.bell_code(err);
    // invariant: a completed pass spends exactly one ring
    assert(rang >= 1);
    if (head != task.count) {
        print("    {s}: expected the arc to stand at {d}, found {d}\n", .{
            self_name, task.count, head,
        });
        return carry.Outcome.bytes_differed;
    }
    print("    {s}: carried {d} from {s} onward to {s}, arc standing at {d}\n", .{
        self_name, pending, predecessor, successor, head,
    });
    return carry.Outcome.carried_ok;
}

/// Reads the asks standing in from the predecessor and takes home the ones
/// this domain wrote itself.
fn do_home(
    io: std.Io,
    slot: *const capabilities.DependentSlot,
    peers: *const notify.PeerList,
    self_name: []const u8,
    task: cycle.Task,
) u8 {
    const inbound = task.hops.name_at(0);
    const mine = task.hops.name_at(1);
    const predecessor = task.peers.name_at(0);
    if (!peers.wired_to(predecessor)) return notify.Bell.not_wired;

    const rung = roundtrip.hear_from(io, peers, self_name, predecessor) catch |err|
        return serve.bell_code(err);
    if (rung == 0) return notify.Bell.unheard;

    const head = queue.read_index(io, slot, inbound) catch |err| return serve.reach_code(err);
    const tail = queue.read_index(io, slot, mine) catch |err| return serve.reach_code(err);
    const pending = pending_between(head, tail) orelse return carry.Outcome.bytes_differed;
    if (pending == 0) return queue.nothing_new;

    var seq = tail;
    while (seq < head) : (seq += 1) {
        var seen_buf: [serve.max_message_len]u8 = undefined;
        const seen = queue.read_slot(io, slot, inbound, seq, &seen_buf) catch |err|
            return serve.reach_code(err);
        const message = seen orelse return carry.Outcome.bytes_differed;
        const origin = relay.asked_origin(message) orelse return carry.Outcome.bytes_differed;
        // An ask that came home names this domain as its origin. Anything
        // else is a stranger's ask still travelling, and taking it home
        // would close a lap that never happened.
        if (!std.mem.eql(u8, origin, self_name)) return carry.Outcome.bytes_differed;
    }
    // invariant: the walk stopped exactly where the predecessor's head stands
    assert(seq == head);
    queue.write_index(io, slot, mine, head) catch |err| return serve.reach_code(err);

    if (pending != task.count) {
        print("    {s}: expected {d} asks home, took {d}\n", .{ self_name, task.count, pending });
        return carry.Outcome.bytes_differed;
    }
    print("    {s}: took {d} home from {s} across a hole that closed\n", .{
        self_name, pending, predecessor,
    });
    return carry.Outcome.carried_ok;
}

/// Reads the index at the front of one region and changes nothing.
///
/// The one word this supervised path had no way to say. `place`, `pass`,
/// and `home` each write something before they finish, so a rung whose
/// whole question is DIRECTION -- who may write a region two domains hold
/// -- had no step to put behind a reader. Peeking answers exactly what
/// `cycle.rye`'s own peek answers, so one word keeps one spelling.
/// Accreted for `commute.rye`; the three verbs a ring under fall asks are
/// untouched by it.
fn do_peek(
    io: std.Io,
    slot: *const capabilities.DependentSlot,
    task: cycle.Task,
) u8 {
    // invariant: a peek always names the one region it reads
    assert(task.hops.count == 1);
    // invariant: a peek names a region, never an empty word
    assert(task.hops.name_at(0).len >= 1);
    _ = queue.read_index(io, slot, task.hops.name_at(0)) catch |err|
        return serve.reach_code(err);
    return carry.Outcome.bytes_differed;
}

/// Attempts one step, dropping the dependent where the supervisor asked.
///
/// Exported so a ring under a hole that stays open (`decline.rye`) runs the
/// same three verbs this module already proved, and adds only the one act
/// its own question needs.
pub fn attempt(
    io: std.Io,
    slot: *const capabilities.DependentSlot,
    peers: *const notify.PeerList,
    self_name: []const u8,
    task: cycle.Task,
    fall: Fall,
    wake: Wake,
) u8 {
    return switch (task.verb) {
        .place => do_place(io, slot, peers, self_name, task),
        .pass => do_pass(io, slot, peers, self_name, task, fall, wake),
        .home => do_home(io, slot, peers, self_name, task),
        .peek => do_peek(io, slot, task),
        // A ring under fall asks nothing the remaining verbs answer, so
        // they are refused here rather than half-carried.
        else => carry.Outcome.malformed,
    };
}

/// Reads the capability words a dependent was handed into its own slot.
fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    // invariant: a dependent always knows which domain it is
    assert(domain.len >= 1);
    // invariant: the count stays within what one dependent may hold
    assert(cap_count <= capabilities.max_caps_per_dependent);
    var slot = capabilities.DependentSlot.init(domain);
    var i: u32 = 0;
    while (i < cap_count) : (i += 1) {
        const cap = boot.read_cap_word(args[fixed_argv_words + i]) orelse return null;
        slot.grant(cap) catch return null;
    }
    // invariant: the dependent holds exactly the capability words it was handed
    assert(slot.cap_count == cap_count);
    return slot;
}

/// Runs as one supervised dependent, holding exactly the capabilities, the
/// neighbors, the one arc, the one place it may be dropped, and the reading
/// by which it wakes whoever carries its work onward.
fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    // invariant: a dependent always receives its marker, domain, plan, fall, wake, and count
    assert(args.len >= fixed_argv_words);
    const domain = args[2];
    const plan = args[3];
    // invariant: a dependent always knows which domain it is
    assert(domain.len >= 1);

    const fall = read_fall(args[4]) orelse {
        print("    {s}: refused a fall word it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };
    const wake = read_wake(args[5]) orelse {
        print("    {s}: refused a wake word it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };

    const cap_count = tally_parse_int.parse_int(u32, args[6], .{}) catch {
        print("    {s}: refused an unreadable capability count\n", .{domain});
        return carry.Outcome.malformed;
    };
    if (cap_count > capabilities.max_caps_per_dependent) {
        print("    {s}: more capabilities than one dependent holds\n", .{domain});
        return carry.Outcome.malformed;
    }
    if (fixed_argv_words + cap_count > args.len) {
        print("    {s}: a capability count past the words it was handed\n", .{domain});
        return carry.Outcome.malformed;
    }

    var slot = slot_from_argv(args, domain, cap_count) orelse {
        print("    {s}: refused a malformed capability word\n", .{domain});
        return carry.Outcome.malformed;
    };

    var peers: notify.PeerList = .{};
    var p: usize = fixed_argv_words + cap_count;
    while (p < args.len) : (p += 1) {
        peers.add(args[p]) catch {
            print("    {s}: more peers than one dependent holds\n", .{domain});
            return carry.Outcome.malformed;
        };
    }
    // invariant: the dependent holds exactly the peer words it was handed
    assert(peers.count == args.len - fixed_argv_words - cap_count);

    const task = cycle.read_plan(plan) orelse {
        print("    {s}: refused a plan it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };
    const code = attempt(io, &slot, &peers, domain, task, fall, wake);
    print("    {s}: {s} -- {s}\n", .{ domain, fall_word(fall), outcome_name(code) });
    return code;
}

// =========================================================================
// The supervisor -- one document re-read per attempt, one hole, one lap
// =========================================================================

/// One declared domain's step in a ring that may lose a middle.
pub const Assignment = struct {
    domain: []const u8,
    verb: cycle.Verb,
    hops: []const u8,
    peers: []const u8,
    count: u32,
    fall: Fall,
    expect: u8,
};

/// What one run did, reported whole -- the total no domain inside the ring
/// can read for itself, least of all one that was absent for part of it.
pub const Report = struct {
    started: u32 = 0,
    attempts: u32 = 0,
    derivations: u32 = 0,
    falls: u32 = 0,
    returned: u32 = 0,
    homed: u32 = 0,
    bells: u32 = 0,
};

/// Named ways a run declines rather than reporting a hollow success.
pub const RunError = error{
    SpawnFailed,
    UnknownDomain,
    PlanTooLong,
    DeclarationUnreadable,
    OutcomeMismatch,
    FellTooOften,
};

/// Spawns one dependent once, with the fall and wake words it was assigned.
fn spawn_once(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    table: *const capabilities.CapabilityTable,
    step: Assignment,
    fall: Fall,
    wake: Wake,
) (RunError || boot.BootError)!u8 {
    const slot = table.find_dependent(step.domain) orelse return error.UnknownDomain;
    // invariant: the line handed out agrees with the declaration it came from
    assert(boot.line_agrees(sys, slot));

    var peers: notify.PeerList = .{};
    notify.peers_of(sys, step.domain, &peers);

    var plan_buf: [cycle.max_plan_len]u8 = undefined;
    const plan = std.fmt.bufPrint(&plan_buf, "{s}:{s}:{s}:{d}", .{
        cycle.verb_word(step.verb), step.hops, step.peers, step.count,
    }) catch return error.PlanTooLong;

    var count_buf: [8]u8 = undefined;
    const count_word = std.fmt.bufPrint(&count_buf, "{d}", .{slot.cap_count}) catch
        return error.PlanTooLong;

    var storage: [capabilities.max_caps_per_dependent][boot.max_cap_word_len]u8 = undefined;
    const argv = allocator.alloc(
        []const u8,
        fixed_argv_words + slot.cap_count + peers.count,
    ) catch return error.SpawnFailed;
    argv[0] = self_path;
    argv[1] = "dependent";
    argv[2] = slot.label_slice();
    argv[3] = plan;
    argv[4] = fall_word(fall);
    argv[5] = wake_word(wake);
    argv[6] = count_word;
    var c: u32 = 0;
    while (c < slot.cap_count) : (c += 1) {
        assert(c < capabilities.max_caps_per_dependent); // invariant: the walk stays in the array
        argv[fixed_argv_words + c] = try boot.write_cap_word(&storage[c], &slot.caps[c]);
    }
    var q: u32 = 0;
    while (q < peers.count) : (q += 1) {
        argv[fixed_argv_words + slot.cap_count + q] = peers.name_at(q);
    }

    var proc = std.process.spawn(io, .{ .argv = argv }) catch return error.SpawnFailed;
    const term = proc.wait(io) catch return error.SpawnFailed;
    return switch (term) {
        .exited => |code| code,
        else => restart.fell,
    };
}

/// Runs one assigned step, returning it to the ring when it falls.
///
/// Every attempt reloads the declaration from disk and derives the dependent's
/// line from that read, so a domain that comes back takes its rights from
/// the document rather than from what the parent recalls granting it. The
/// injected fall lands on the first attempt alone -- a fall is an accident
/// this run schedules once, never a property of the domain.
fn run_assignment(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    step: Assignment,
    wake: Wake,
    report_out: *Report,
) (roster.RosterError || RunError || boot.BootError)!void {
    // invariant: an assignment always names a domain, its regions, and its peers
    assert(step.domain.len >= 1);
    assert(step.hops.len >= 1);
    assert(step.peers.len >= 1);

    var tries: u32 = 0;
    while (tries < max_attempts) : (tries += 1) {
        var buf: [read.read_buffer_bytes]u8 = undefined;
        const fresh = read.load(io, declaration_path, &buf) catch
            return error.DeclarationUnreadable;
        if (fresh.verify() != .whole) return error.DeclarationUnreadable;
        const table = try roster.from_system(&fresh);
        // invariant: the freshly derived table enforces exactly what the document permits
        assert(roster.agrees(&fresh, &table));
        report_out.derivations += 1;

        const fall: Fall = if (tries == 0) step.fall else .none;
        const code = try spawn_once(allocator, io, self_path, &fresh, &table, step, fall, wake);
        report_out.attempts += 1;
        if (code == restart.fell) {
            report_out.falls += 1;
            print("    {s}: fell at {s} -- the ring now has a hole\n", .{
                step.domain, fall_word(fall),
            });
            continue;
        }
        if (tries >= 1) report_out.returned += 1;
        if (code != step.expect) {
            print("    {s}: expected {s}, heard {s}\n", .{
                step.domain, outcome_name(step.expect), outcome_name(code),
            });
            return error.OutcomeMismatch;
        }
        return;
    }
    return error.FellTooOften;
}

/// Runs a whole ordered lap against the ring declaration, under one reading
/// of how a pass wakes its successor.
pub fn run_plan(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Assignment,
    wake: Wake,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || RunError || boot.BootError)!Report {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always carries at least one step
    assert(plan.len >= 1);
    const provisioned = try exercise.provision(io, sys);
    // invariant: every declared region has a backing store before any dependent runs
    assert(provisioned == sys.map.region_count);
    const bells = try roundtrip.provision_directed(io, sys);
    // invariant: every declared channel has two silent bells before any dependent runs
    assert(bells == sys.graph.channel_count * 2);

    var report_out: Report = .{ .bells = bells };
    var i: u32 = 0;
    while (i < plan.len) : (i += 1) {
        try run_assignment(allocator, io, self_path, plan[i], wake, &report_out);
        report_out.started += 1;
        const step = plan[i];
        if (step.expect == carry.Outcome.carried_ok and step.verb == .home) {
            report_out.homed += step.count;
        }
    }
    // invariant: no step ever ran without a fresh derivation standing behind it
    assert(report_out.derivations == report_out.attempts);
    // invariant: every step that started was attempted at least once
    assert(report_out.attempts >= report_out.started);
    return report_out;
}

// =========================================================================
// Self-test -- a middle falls twice, and only one reading brings it home
// =========================================================================

/// A fall before the write, under the strict reading.
///
/// birch hears alder's bell and drops before touching a byte. Nothing moved
/// and nothing was announced, so the attempt that returns simply does the
/// whole step -- the debt stood in the region, and the bell stood on the
/// channel.
const clean_fall_plan = [_]Assignment{
    .{ .domain = "alder", .verb = .place, .hops = "ask_ab", .peers = "birch", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
    .{ .domain = "birch", .verb = .pass, .hops = "ask_ab,ask_bc", .peers = "alder,cedar", .count = 2, .fall = .after_hear, .expect = carry.Outcome.carried_ok },
    .{ .domain = "cedar", .verb = .pass, .hops = "ask_bc,ask_ca", .peers = "birch,alder", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
    .{ .domain = "alder", .verb = .home, .hops = "ask_ca,taken", .peers = "cedar", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
};

/// The same fall one step later, under the same strict reading.
///
/// birch drops after writing its onward batch and before ringing cedar. The
/// attempt that returns finds its arc already carried, reports nothing new,
/// and rings nobody -- so cedar hears an unrung bell and the lap stands one
/// arc short of home with every ask safely on disk. This is the stall, run
/// rather than asserted.
const silent_restart_plan = [_]Assignment{
    .{ .domain = "alder", .verb = .place, .hops = "ask_ab", .peers = "birch", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
    .{ .domain = "birch", .verb = .pass, .hops = "ask_ab,ask_bc", .peers = "alder,cedar", .count = 2, .fall = .after_write, .expect = queue.nothing_new },
    .{ .domain = "cedar", .verb = .pass, .hops = "ask_bc,ask_ca", .peers = "birch,alder", .count = 2, .fall = .none, .expect = notify.Bell.unheard },
};

/// The same fall again, under the reading that rings on every pass.
///
/// One line apart from the plan above, and the hole closes: the attempt
/// that returns finds nothing left to move, rings cedar anyway, and the lap
/// comes home.
const mended_plan = [_]Assignment{
    .{ .domain = "alder", .verb = .place, .hops = "ask_ab", .peers = "birch", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
    .{ .domain = "birch", .verb = .pass, .hops = "ask_ab,ask_bc", .peers = "alder,cedar", .count = 2, .fall = .after_write, .expect = carry.Outcome.carried_ok },
    .{ .domain = "cedar", .verb = .pass, .hops = "ask_bc,ask_ca", .peers = "birch,alder", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
    .{ .domain = "alder", .verb = .home, .hops = "ask_ca,taken", .peers = "cedar", .count = 2, .fall = .none, .expect = carry.Outcome.carried_ok },
};

/// Proves the fall and wake words hold before any process runs.
fn check_wire() u8 {
    if (read_fall("fall-after-read") != null) {
        print("  RED: a fall point this ring never named was accepted\n", .{});
        return 1;
    }
    if (read_wake("wake-sometimes") != null) {
        print("  RED: a wake reading this ring never named was accepted\n", .{});
        return 1;
    }
    // invariant: every word this ring writes reads back as itself
    assert(read_fall(fall_word(.after_hear)).? == .after_hear);
    assert(read_fall(fall_word(.after_write)).? == .after_write);
    assert(read_wake(wake_word(.when_moved)).? == .when_moved);
    assert(read_wake(wake_word(.every_pass)).? == .every_pass);
    // invariant: a fall is a code no named outcome already spends
    assert(restart.fell != carry.Outcome.carried_ok);
    assert(restart.fell != queue.nothing_new);
    assert(restart.fell != notify.Bell.unheard);
    print("  the fall and wake words read back as themselves, and a fall is nobody else's code\n", .{});
    return 0;
}

/// Loads the ring declaration, or names why it could not be read.
fn load_declaration(io: std.Io, buf: []u8) ?system.System {
    const parsed = read.load(io, declaration_path, buf) catch |err| {
        print("  RED: {s} refused: {s}\n", .{ declaration_path, @errorName(err) });
        return null;
    };
    if (parsed.verify() != .whole) {
        print("  RED: {s} did not read whole\n", .{declaration_path});
        return null;
    }
    return parsed;
}

/// A fall before the write costs the ring one attempt and nothing else.
fn check_clean_fall(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const parsed = load_declaration(io, &buf) orelse return 1;
    const done = run_plan(allocator, io, self_path, &parsed, &clean_fall_plan, .when_moved) catch |err| {
        print("  RED: a lap with a hole before the write did not close: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: the middle fell once and came back once
    assert(done.falls == 1);
    assert(done.returned == 1);
    // invariant: every ask placed still came home across the hole
    assert(done.homed == 2);
    print("  a middle that falls before it writes costs one attempt: {d} fall, {d} return, {d} asks home\n", .{
        done.falls, done.returned, done.homed,
    });
    print("  the debt stood in the region and the bell stood on the channel -- a lap owes a returned domain nothing\n", .{});
    return 0;
}

/// A fall after the write leaves the bytes whole and the wake swallowed.
fn check_silent_restart(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const parsed = load_declaration(io, &buf) orelse return 1;
    const done = run_plan(allocator, io, self_path, &parsed, &silent_restart_plan, .when_moved) catch |err| {
        print("  RED: the stall did not report itself by name: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: the middle fell once, came back once, and announced nothing
    assert(done.falls == 1);
    assert(done.returned == 1);
    // invariant: no ask reached home across a hole that never rang
    assert(done.homed == 0);
    print("  a middle that falls after it writes returns to nothing left to do, and so does nothing at all\n", .{});
    print("  idempotence over bytes makes a restart safe, and it makes a restart silent -- {d} asks home\n", .{done.homed});
    return 0;
}

/// The same fall under a wake that rings on every completed pass.
fn check_mended(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const parsed = load_declaration(io, &buf) orelse return 1;
    const done = run_plan(allocator, io, self_path, &parsed, &mended_plan, .every_pass) catch |err| {
        print("  RED: the mended lap did not close: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: the same fall landed, and this time the lap closed over it
    assert(done.falls == 1);
    assert(done.returned == 1);
    assert(done.homed == 2);
    // invariant: every attempt took its rights from a fresh read of the document
    assert(done.derivations == done.attempts);
    print("  ringing on every completed pass closes the same hole: {d} asks home across it\n", .{done.homed});
    print("  a bell rung twice costs a wasted pass; a bell never rung costs the lap\n", .{});
    print("  {d} attempts, each deriving its rights from {d} fresh reads of the declaration\n", .{
        done.attempts, done.derivations,
    });
    return 0;
}

fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan gap {s} -- self-test\n", .{caravan_gap_version});
    const wire = check_wire();
    if (wire != 0) return wire;
    const clean = check_clean_fall(allocator, io, self_path);
    if (clean != 0) return clean;
    const silent = check_silent_restart(allocator, io, self_path);
    if (silent != 0) return silent;
    const mended = check_mended(allocator, io, self_path);
    if (mended != 0) return mended;
    print("  GREEN: a hole in a ring closes on the bytes, once the wake is idempotent too\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return run_self_test(allocator, io, self_path);
}
