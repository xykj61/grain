//! Caravan bear -- a plan may name the loss it would rather carry than repair,
//! and a run that repairs it anyway has disobeyed the author it serves.
//!
//! `mend.rye` taught a run to read its own short verdict and run the plan again
//! for exactly the arcs it lost. It repairs **everything** it lost, because
//! nothing in the record ever told it otherwise. That is the right default and
//! the wrong law: some work is worth doing twice, and some work is worth
//! carrying as a loss -- and only the author of a plan knows which is which.
//!
//! **The measurement is work re-run against the plan's own word.** Every count
//! before it weighs a harm: reach a dependent held past its work, a claim a
//! supervisor made, an arc nobody carried. This one weighs an **overreach** --
//! an arc a run re-ran after its author asked it to be borne. The plan still
//! comes out complete under the elder reading; what it cost was obedience.
//!
//! **A phase declares its own bearing, and the run reads it from the record.**
//! A phase written `bear = true` says: if this arc is lost, carry the loss. It
//! is a declaration about the *future* of one phase, sitting beside the outcome
//! its author already declares, so a plan says both what it expects and what it
//! would accept.
//!
//! **The bearing stands on the wire beside the loss.** The run writes a bearing
//! note next to the loss note -- one glyph per phase, `b` where an arc was lost
//! and its author asked it borne -- and the repair reads it back before it
//! seats a single phase. A supervisor that bore from memory would be obeying a
//! plan it believes in rather than the one it published.
//!
//! **The settlement gains a third word, because two were no longer honest.** A
//! plan whose every repairable arc came home and whose borne arc remains is
//! neither `carried` nor plainly `short`: it is **borne** -- as complete as its
//! author ever asked it to be. Reporting that plan short would tell an operator
//! to go looking for work nobody wants done.
//!
//! **The rung earns four refusals, and each is about the bearing rather than
//! the repair it bounds.** `BearEarly` is the moment: a bearing weighed before
//! the run published what it lost is judging from memory. `BearWhole` is the
//! work: a plan that lost nothing has nothing to bear. `BearMiscounted` is the
//! honesty of the count: every lost arc is either borne or repaired, and never
//! both or neither. `BearOverrepaired` is the answer -- the hard half -- since a
//! run that re-ran an arc its author asked it to bear, or that published a
//! settlement the wire does not carry, would report an obedience it never
//! practiced.
//!
//! **A plan that loses nothing reads as the rung below.** With every absorbed
//! phase served, the bearing is refused before it weighs anything, each line
//! stands at the width it was handed, and the door answers
//! `unhand.admissible_held` pair for pair -- this arc's standing generalization
//! test, one tier further out.
//!
//! Usage:
//!   bear            Run the self-test (default)
//!   bear selftest   Same as default
//!   bear dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const ladder_checks = @import("ladder_checks.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");

const Dir = std.Io.Dir;

const caravan_bear_version = "20260820.033252";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = mending_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = mending_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = mending_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = mending_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = mending_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = mending_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.bears";

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = mending_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = mending_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = mending_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = mending_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = mending_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = mending_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = mending_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the abandoning notes
    assert(!std.mem.eql(u8, note_dir, mending_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return mending_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// or carry the loss its author asked it to bear.
///
/// Four names of this rung's own, and each is about the bearing rather than the
/// repair it bounds: the moment it is weighed, the work it weighs, the honesty
/// of the count, and the obedience it publishes once the repair is over.
pub const RunError = mending_rung.RunError || error{
    BearEarly,
    BearWhole,
    BearMiscounted,
    BearOverrepaired,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = mending_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = mending_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted --
/// and the one word this rung adds: whether its author would carry a loss here
/// rather than have it repaired.
///
/// The bearing sits beside the outcome a phase already declares, so a plan says
/// both what it expects of a phase and what it would accept. It says nothing at
/// all about how the phase runs: a phase that comes home is unaffected by it,
/// since a bearing only ever answers a question the loss itself asks.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, without the bearing it never had.
pub fn below(phase: Phase) mending_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return mending_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = mending_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = mending_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = mending_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = mending_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return mending_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return mending_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return mending_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return mending_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return mending_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = mending_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return mending_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return mending_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the bearing it kept added.
///
/// `overrepaired` is the number this rung moves: arcs a run re-ran after its
/// author asked it to bear them. `bore` is what it carried as a loss instead,
/// and `settlement` is the word an operator finally reads.
pub const Report = struct {
    inner: mending_rung.Report = .{},
    bore: u32 = 0,
    overrepaired: u32 = 0,
    settlement: Settlement = .carried,
};

/// The mending rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
fn below_of(report_out: *Report) *mending_rung.Report {
    return &report_out.inner;
}

/// The abandoning rung's tally, three tiers further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return mending_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return mending_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return mending_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return mending_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return mending_rung.reserve_depth(reserve);
}

// =========================================================================
// The reclamation -- carried whole from the rung below, since this rung
// always reclaims and asks a different question about the same act
// =========================================================================

/// What becomes of a conferral when its holder is reaped, from the rung below.
pub const Take = mending_rung.Take;

/// Renders one take as the words an operator reads.
pub fn take_words(t: Take) []const u8 {
    return mending_rung.take_words(t);
}

/// Answers why one conferral may not be reclaimed, or that it may.
pub fn reclaim_refusal(conferred: u32, in_flight: bool, already: bool) ?RunError {
    return mending_rung.reclaim_refusal(conferred, in_flight, already);
}

/// Counts the reach a successor finds waiting at its first breath.
pub fn inherited_reach(conferred: u32, take: Take) u32 {
    return mending_rung.inherited_reach(conferred, take);
}

// =========================================================================
// The abandonment -- carried whole from the rung below, since this rung
// always answers for lost work and asks what the plan is worth afterwards
// =========================================================================

/// Whether a run answers for the work a fallen holder's conferral never
/// served, from the rung below. This rung always answers.
pub const Answer = mending_rung.Answer;

/// Answers why one abandonment may not be recorded, or that it may.
pub fn abandon_refusal(granted: u32, in_flight: bool, came_home: bool) ?RunError {
    return mending_rung.abandon_refusal(granted, in_flight, came_home);
}

/// Counts the reach a run conferred that nobody ever served.
pub fn abandoned_reach(granted: u32, came_home: bool, answer: Answer) u32 {
    return mending_rung.abandoned_reach(granted, came_home, answer);
}

// =========================================================================
// The mend -- carried whole from the rung below, since this rung repairs the
// same way and asks a different question about which arcs to repair at all
// =========================================================================

/// Answers why one mend may not be attempted, or that it may.
pub fn mend_refusal(published: ?Verdict, lost: u32, seating: u32) ?RunError {
    return mending_rung.mend_refusal(published, lost, seating);
}

/// Counts the work still standing when the supervisor exits.
pub fn unserved_after(lost: u32, served_again: u32) u32 {
    return mending_rung.unserved_after(lost, served_again);
}

/// Answers what the plan came to once the mend has had its turn, from below.
pub fn settled_verdict(unserved: u32) Verdict {
    return mending_rung.settled_verdict(unserved);
}

/// Reads one phase back as the work it names, freed of the plan it belonged to.
///
/// The rung below sheds the arrangement and keeps the work. This one keeps the
/// bearing too, since a phase that asked to be borne asks it every time it is
/// written down -- a repair that quietly dropped the word would be free to
/// re-run the arc on its next pass.
pub fn reseated(phase: Phase, at: u32) Phase {
    // invariant: a re-seated phase always keeps the domain its author named
    assert(phase.task.item.domain.len >= 1);
    // invariant: a re-seat never numbers a turn past the plan's own bound
    assert(at < max_turns);
    const beneath = mending_rung.reseated(below(phase), at);
    return .{
        .turn = beneath.turn,
        .step = beneath.step,
        .follows = beneath.follows,
        .follows_turns = beneath.follows_turns,
        .reserve = beneath.reserve,
        .bear = phase.bear,
        .task = beneath.task,
    };
}

// =========================================================================
// The bearing -- which of a plan's losses its author would rather carry
// =========================================================================

/// How a run answers the losses its own plan asked it to bear.
///
/// `repaired` is where the rung below left it: every lost arc is run again,
/// whatever the plan said about it, because nothing in the record ever said
/// anything. `borne` is this rung: a loss its author marked is carried as a
/// loss, only the rest is repaired, and the settlement says which happened.
pub const Bearing = enum { repaired, borne };

/// Renders one bearing as the words an operator reads.
pub fn bearing_words(b: Bearing) []const u8 {
    return switch (b) {
        .repaired => "every loss is run again, whatever its author asked",
        .borne => "a loss its author asked to bear is carried rather than repaired",
    };
}

/// What an operator finally reads about a plan, once the repair is over.
///
/// The rung below has two words, and two were no longer honest. A plan whose
/// every repairable arc came home and whose borne arc remains is neither
/// carried out nor plainly short: reporting it short would send an operator
/// looking for work nobody wants done.
pub const Settlement = enum { carried, short, borne };

/// Renders one settlement as the words an operator reads.
pub fn settlement_words(s: Settlement) []const u8 {
    return switch (s) {
        .carried => "carried out whole",
        .short => "short by the work nobody served",
        .borne => "whole but for the loss its author chose to carry",
    };
}

/// The one byte a settlement rides as, so an operator's note is a single glyph.
pub fn settlement_byte(s: Settlement) u8 {
    return switch (s) {
        .carried => 'c',
        .short => 's',
        .borne => 'b',
    };
}

/// Reads one settlement back from the byte it rode as, or nothing at all.
pub fn settlement_of_byte(byte: u8) ?Settlement {
    if (byte == 'c') return .carried;
    if (byte == 's') return .short;
    if (byte == 'b') return .borne;
    return null;
}

/// Answers why one bearing may not be weighed, or that it may.
///
/// The whole fold of this rung, and every refusal it earns before a single
/// phase is re-seated. `published` is the verdict this run read back from the
/// wire, `lost` is the reach the plan absorbed and nobody served, `borne` is
/// how much of that loss its author asked to carry, and `repairing` is what
/// the mend would run again.
///
/// The order matters, and it is the rung below's order one tier out. A bearing
/// asks whether the run has published anything to weigh before it asks what
/// the plan said about it, because a supervisor that obeys a plan it never
/// published is obeying a plan it remembers.
pub fn bear_refusal(published: ?Verdict, lost: u32, borne: u32, repairing: u32) ?RunError {
    // invariant: a bearing never weighs more loss than one record may hold
    assert(lost <= max_queue_len);
    // invariant: a bearing never carries more loss than one record may hold
    assert(borne <= max_queue_len);
    _ = published orelse return error.BearEarly;
    if (lost == 0) return error.BearWhole;
    if (borne > lost) return error.BearMiscounted;
    // Every lost arc is either borne or repaired, and never both or neither.
    // A count that does not close is a supervisor about to obey half a plan.
    if (borne + repairing != lost) return error.BearMiscounted;
    return null;
}

/// Counts the arcs a run re-ran after its author asked it to bear them.
///
/// The seventh of the family, and the first that weighs **obedience** rather
/// than harm. Every count before it names something a run left standing or
/// claimed without cause; this names something a run did that it was asked not
/// to do. A plan repaired against its own word still comes out complete, which
/// is exactly why nothing below this rung could see it.
pub fn overrepaired(borne_mask: u32, seated_mask: u32) u32 {
    // invariant: a bearing never names a phase outside the record's own bits
    assert(borne_mask >> @intCast(max_queue_len) == 0);
    // invariant: a repair never seats a phase outside the record's own bits
    assert(seated_mask >> @intCast(max_queue_len) == 0);
    return @popCount(borne_mask & seated_mask);
}

/// Answers what an operator finally reads, once the repair has had its turn.
///
/// A plan with nothing standing was carried out. A plan whose whole remaining
/// loss is loss its author asked to carry is borne. A plan still holding work
/// nobody asked anybody to bear is short, exactly as the rung below reads it.
pub fn settlement_of(unserved: u32, bore: u32) Settlement {
    // invariant: a settlement never weighs more loss than one record may hold
    assert(unserved <= max_queue_len);
    // invariant: a run never bears more loss than one record may hold
    assert(bore <= max_queue_len);
    if (unserved == 0) return .carried;
    if (unserved == bore) return .borne;
    return .short;
}

// =========================================================================
// The door -- unchanged, since this rung moves a conferral rather than a line
// =========================================================================

/// Answers whether the head may enter, over the lines the run remembers.
///
/// The door is `revoke.admissible_in` exactly: a widened line is weighed the
/// same way whether a departed dependent's conferral stands or leaves with it.
/// What this rung changes stands entirely on the wire between the two.
pub fn admissible_in(
    sys: *const system.System,
    live: []const cohort.Running,
    handed: []const Task,
    reserves: []const ?Task,
    taken: []const u32,
    head: Task,
) RunError!bool {
    return mending_rung.admissible_in(sys, live, handed, reserves, taken, head);
}

// =========================================================================
// The notes -- what a run publishes, and the answers it reads back
// =========================================================================

/// Why a conferral could not be published, read, confirmed, or reclaimed.
pub const NoteError = mending_rung.NoteError;

/// Writes the path of one dependent's note.
pub fn note_path(buf: *[max_note_path_len]u8, domain: []const u8, suffix: []const u8) NoteError![]const u8 {
    return ladder_checks.note_path(@This(), buf, domain, suffix);
}

/// Writes bytes into a note, creating it fresh.
pub fn seat_note(io: std.Io, domain: []const u8, suffix: []const u8, bytes: []const u8) NoteError!void {
    return ladder_checks.seat_note(@This(), io, domain, suffix, bytes);
}

/// Reads the one byte a counting note carries.
pub fn read_count(io: std.Io, domain: []const u8, suffix: []const u8) NoteError!u8 {
    return ladder_checks.read_count(@This(), io, domain, suffix);
}

/// Reads the word list a dependent's domain has been handed so far.
pub fn read_words(io: std.Io, domain: []const u8, out: *Words) NoteError!void {
    return ladder_checks.read_words(@This(), io, domain, out);
}

/// Provisions one set of notes per declared domain, all standing at nothing.
///
/// Every run starts with no reach conferred, none revoked, and no conferral
/// standing anywhere, so a word a dependent finds at its first breath was left
/// by this run's own supervisor rather than by the last.
pub fn provision_notes(io: std.Io, sys: *const system.System) NoteError!u32 {
    // invariant: the domain roster stays within its bound
    assert(sys.graph.domain_count >= 1);
    // invariant: a run always provisions into a declaration that read whole
    assert(sys.map.region_count >= 1);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    var i: u32 = 0;
    while (i < sys.graph.domain_count) : (i += 1) {
        const name = sys.graph.domains[i].name_slice();
        try seat_note(io, name, ".given", &[_]u8{0});
        try seat_note(io, name, ".held", &[_]u8{0});
        try seat_note(io, name, ".offered", &[_]u8{0});
        try seat_note(io, name, ".words", "");
        try seat_note(io, name, ".pruning", &[_]u8{0});
        try seat_note(io, name, ".kept", &[_]u8{0});
        try seat_note(io, name, ".pruned", &[_]u8{0});
        try seat_note(io, name, ".inherited", &[_]u8{0});
        try seat_note(io, name, ".epoch", &[_]u8{0});
        try seat_note(io, name, ".for", &[_]u8{0});
        try seat_note(io, name, ".falls", &[_]u8{0});
        try seat_note(io, name, ".abandoned", &[_]u8{0});
    }
    // The plan's own verdict is cleared with them, so no run ever reads the
    // last run's judgment of a plan this one has not finished. Its bearing and
    // its settlement clear beside it, for exactly the same reason: a repair
    // that read the last run's bearing would spare an arc this plan never
    // asked it to spare.
    try seat_note(io, plan_name, ".verdict", &[_]u8{0});
    try seat_note(io, plan_name, ".bearing", "");
    try seat_note(io, plan_name, ".settled", &[_]u8{0});
    // invariant: a fresh provisioning leaves no verdict standing to be read
    assert(verdict_published(io) == null);
    // invariant: a fresh provisioning leaves no settlement standing to be read
    assert(settlement_published(io) == null);
    // invariant: every declared domain got its notes, none invented
    assert(i == sys.graph.domain_count);
    return i;
}

/// Tells one dependent how much reach may yet arrive for it.
pub fn offer(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    return ladder_checks.offer(@This(), io, domain, depth);
}

/// Reads how much reach this dependent was told may yet arrive.
pub fn offered(io: std.Io, domain: []const u8) NoteError!u32 {
    // invariant: an offer is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = try read_count(io, domain, ".offered");
    // invariant: an offer stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Tells one dependent whether a pruning will come for it at all.
pub fn promise_pruning(io: std.Io, domain: []const u8, keep: Keep) NoteError!void {
    return ladder_checks.promise_pruning(@This(), io, domain, keep);
}

/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(io: std.Io, domain: []const u8) bool {
    return ladder_checks.pruning_promised(@This(), io, domain);
}

/// Tells this dependent how its author declared it would end.
///
/// A plan already names the outcome it expects of every phase, and until now
/// only the supervisor read that word. The dependent needs it too, since the
/// window this rung studies opens inside the dependent's own life -- after it
/// grafts a conferral and before it carries the work. So the declaration rides
/// the same wire as the pruning promise, written before the spawn.
pub fn promise_falling(io: std.Io, domain: []const u8, falling: bool) NoteError!void {
    return ladder_checks.promise_falling(@This(), io, domain, falling);
}

/// Answers whether this dependent's author declared that it falls.
pub fn falling_promised(io: std.Io, domain: []const u8) bool {
    // invariant: a declaration is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".falls") catch return false;
    return seen != 0;
}

/// Publishes one conferral: the generation it is meant for, the words
/// themselves, then the count that makes them live.
///
/// The generation is what lets a dependent tell a word meant for it from a
/// word left standing by the dependent before it. It is a **measurement**
/// rather than a guard: a careless successor may graft a foreign word all the
/// same, which is exactly why the conferral is reclaimed rather than merely
/// labelled.
pub fn confer_words(io: std.Io, domain: []const u8, words: *const Words, depth: u32) NoteError!void {
    // invariant: a conferral always names the dependent it is handed to
    assert(domain.len >= 1);
    // invariant: a conferral never hands more than one line may name
    assert(depth <= cycle.max_hops);
    const generation = read_count(io, domain, ".epoch") catch 0;
    try seat_note(io, domain, ".for", &[_]u8{generation});
    try seat_note(io, domain, ".words", words.slice());
    try seat_note(io, domain, ".given", &[_]u8{@intCast(depth)});
}

/// Opens one generation of a domain, and answers which it is.
///
/// A domain outlives every dependent that stands in it, so each start counts
/// one further. The number is seated before the spawn, so a dependent always
/// finds its own generation waiting for it.
pub fn open_generation(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.open_generation(@This(), io, domain);
}

/// Tells the run this dependent has grafted the reach it was conferred.
pub fn holds(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never grafts more than one line may name
    assert(depth <= cycle.max_hops);
    try seat_note(io, domain, ".held", &[_]u8{@intCast(depth)});
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(io: std.Io, domain: []const u8, depth: u32) bool {
    return ladder_checks.confirm(@This(), io, domain, depth);
}

/// Publishes one revocation: how many conferred words remain live.
pub fn revoke(io: std.Io, domain: []const u8, keep: u32) NoteError!void {
    // invariant: a revocation always names the dependent it is asked of
    assert(domain.len >= 1);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    try seat_note(io, domain, ".kept", &[_]u8{@intCast(keep)});
}

/// Reads how many conferred words this dependent may still hold.
pub fn kept(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.kept(@This(), io, domain);
}

/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    return ladder_checks.pruned(@This(), io, domain, count);
}

/// Waits, bounded, until this revocation has been pruned.
pub fn confirm_pruned(io: std.Io, domain: []const u8, count: u32) bool {
    return ladder_checks.confirm_pruned(@This(), io, domain, count);
}

/// Tells the run how much reach this dependent found standing at its first breath.
pub fn inherited(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never inherits more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".inherited", &[_]u8{@intCast(count)});
}

/// Reads how much reach this dependent found standing at its first breath.
pub fn inherited_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an answer is always read about the dependent that gave it
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".inherited") catch return 0;
    // invariant: an inheritance stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Takes one conferral back whole, so nothing of it stands for a successor.
///
/// The words, the count that makes them live, and every answer given about
/// them return together. A count left standing would let a successor graft a
/// word; an answer of *held* left standing would let a supervisor believe a
/// successor grafted a word it never saw.
pub fn reclaim_notes(io: std.Io, domain: []const u8) NoteError!void {
    // invariant: a reclamation always names the domain it takes back from
    assert(domain.len >= 1);
    try seat_note(io, domain, ".words", "");
    try seat_note(io, domain, ".given", &[_]u8{0});
    try seat_note(io, domain, ".for", &[_]u8{0});
    try seat_note(io, domain, ".held", &[_]u8{0});
    try seat_note(io, domain, ".kept", &[_]u8{0});
    try seat_note(io, domain, ".pruned", &[_]u8{0});
}

/// Records on the wire how much reach this domain's departed holder never served.
///
/// Written after the reclamation has swept the domain clean, so the count
/// survives the very act that erases every other trace of the conferral. A
/// number kept only in memory would make the abandonment the supervisor's
/// claim; a number on the wire is a fact an operator reads after the run.
pub fn abandon_note(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an abandonment always names the domain it was granted to
    assert(domain.len >= 1);
    // invariant: an abandonment never records more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".abandoned", &[_]u8{@intCast(count)});
}

/// Reads how much reach this domain's departed holder never served.
pub fn abandoned_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an abandonment is always read about the domain it names
    assert(domain.len >= 1);
    const left = read_count(io, domain, ".abandoned") catch return 0;
    // invariant: an abandonment stays inside what one line may name
    assert(left <= cycle.max_hops);
    return left;
}

/// The name a plan's own verdict is published under.
///
/// Every other note on this wire belongs to one dependent; this one belongs to
/// the run itself, so it carries a name no declared domain may take.
pub const plan_name = "plan";

/// Publishes what the plan came to, where an operator reads it after the run.
///
/// The verdict is written once the last dependent has been reaped and every
/// abandonment already answered for, so the word rests on the whole of the
/// work rather than on the part of it that had happened when the run last
/// looked.
pub fn verdict_note(io: std.Io, verdict: Verdict) NoteError!void {
    try seat_note(io, plan_name, ".verdict", &[_]u8{verdict_byte(verdict)});
}

/// Reads a plan's published verdict back, or nothing where none was published.
pub fn verdict_published(io: std.Io) ?Verdict {
    const byte = read_count(io, plan_name, ".verdict") catch return null;
    return verdict_of_byte(byte);
}

/// Publishes which phases of the plan an arc was lost on.
///
/// The verdict says *that* a plan fell short; this says *where*. It is written
/// as one glyph per phase of the record -- `x` for a phase whose absorbed arc
/// nobody served, `.` for every other -- so an operator reads the shape of the
/// loss straight off the wire, and a mend derives its second record from the
/// record rather than from a supervisor's memory of it.
///
/// One glyph per phase rather than a packed mask, because the reader here is a
/// person first. The bound is the record's own: a plan never holds more phases
/// than `max_queue_len`, so this note never grows past it.
pub fn lost_note(io: std.Io, held: u32, lost_mask: u32) NoteError!void {
    // invariant: a loss note never names more phases than one record may hold
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((lost_mask & phase_bit(at)) != 0) glyphs[at] = 'x';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".lost", glyphs[0..held]);
}

/// Reads the published loss back as the mask a mend seats from.
///
/// A mend that reads nothing here has nothing to repair, and says so with a
/// zero rather than by guessing -- the refusal that follows is `MendUnread`
/// when even the verdict is absent, and `MendOvereach` if a caller were ever
/// to propose seating work the wire never named.
pub fn lost_published(io: std.Io, held: u32) u32 {
    return ladder_checks.lost_published(@This(), io, held);
}

/// The single bit that stands for one phase of a record.
pub fn phase_bit(at: u32) u32 {
    // invariant: a record always fits inside the bits one word carries
    assert(max_queue_len <= 32);
    // invariant: a bit always names a phase inside the record's own bound
    assert(at < max_queue_len);
    const one: u32 = 1;
    return one << @intCast(at);
}

/// Publishes which of a plan's losses its author asked it to bear.
///
/// The loss note says where a plan fell short; this says which of those places
/// its author would rather leave standing. It is written in the same shape and
/// read the same way -- one glyph per phase, `b` where an arc was lost and its
/// author marked it borne -- so an operator reads the two notes side by side
/// and a repair seats from the record rather than from a supervisor's memory
/// of what the plan wanted.
pub fn bearing_note(io: std.Io, held: u32, borne_mask: u32) NoteError!void {
    // invariant: a bearing note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((borne_mask & phase_bit(at)) != 0) glyphs[at] = 'b';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".bearing", glyphs[0..held]);
}

/// Reads the published bearing back as the mask a repair spares.
///
/// A run that reads nothing here bears nothing, and says so with a zero rather
/// than by guessing -- which leaves the repair exactly where the rung below
/// left it, running every arc the plan lost.
pub fn bearing_published(io: std.Io, held: u32) u32 {
    return ladder_checks.bearing_published(@This(), io, held);
}

/// Publishes the word an operator finally reads about this plan.
///
/// The verdict note below says whether work is still standing. This says what
/// that standing work means -- carried out, short, or whole but for a loss the
/// plan itself asked to carry. Written after the repair has had its turn, and
/// read back before the report believes it.
pub fn settlement_note(io: std.Io, settlement: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".settled", &[_]u8{settlement_byte(settlement)});
}

/// Reads a plan's published settlement back, or nothing where none was written.
pub fn settlement_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".settled") catch return null;
    return settlement_of_byte(byte);
}

// =========================================================================
// The supervisor -- a record that answers for the work its conferrals never
// bought
// =========================================================================

/// One dependent already reaped, held until the whole record has drained.
const Finished = struct {
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
    code: u8,
};

/// Folds one reaped outcome into the report, or names the mismatch.
fn judge_outcome(done: Finished, report_out: *Report) RunError!void {
    // invariant: a judged dependent always names its domain
    assert(done.domain.len >= 1);
    // invariant: the report never counts more successes than dependents reaped
    assert(run_of(report_out).succeeded <= run_of(report_out).reaped);
    if (done.code != done.expect) {
        print("    {s}: expected {s}, heard {s}\n", .{
            done.domain, outcome_name(done.expect), outcome_name(done.code),
        });
        return error.OutcomeMismatch;
    }
    if (done.code == carry.Outcome.carried_ok) {
        run_of(report_out).succeeded += 1;
        if (done.verb == .home) run_of(report_out).homed += done.count;
    }
}

/// The queue's own bookkeeping for one run, over dependents whose conferrals
/// may leave with them.
pub const Table = struct {
    live: [max_in_flight]cohort.Running = undefined,
    lines: [max_in_flight]Task = undefined,
    reserves: [max_in_flight]?Task = @splat(null),
    taken: [max_in_flight]u32 = @splat(0),
    served: [max_in_flight]u32 = @splat(0),
    granted: [max_in_flight]u32 = @splat(0),
    absorbed_mask: [max_in_flight]u32 = @splat(0),
    in_flight: u32 = 0,
    done: [max_queue_len]Finished = undefined,
    finished: u32 = 0,
    started: [max_queue_len]bool = @splat(false),
    record: [max_queue_len]unhand.Phase = undefined,
    reserve_of: [max_queue_len]?Task = @splat(null),
    held: u32 = 0,
    head: u32 = 0,
    left: u32 = 0,
    lost_mask: u32 = 0,
    bear_mask: u32 = 0,
};

/// The record as it stands right now.
fn standing(table: *const Table) []const unhand.Phase {
    // invariant: a record never outgrows the queue one supervisor may hold
    assert(table.held <= max_queue_len);
    return table.record[0..table.held];
}

/// Answers whether one phase of the record is still work waiting to run.
fn waits(table: *const Table, at: u32) bool {
    // invariant: a reading always names a phase inside the record
    assert(at < table.held);
    return !table.started[at];
}

/// Moves the head past every item already started.
pub fn advance_head(table: *Table) void {
    // invariant: a head never walks past the record it reads
    assert(table.head <= table.held);
    while (table.head < table.held and !waits(table, table.head)) table.head += 1;
}

/// Answers whether a phase of a turn this pick's turn names still waits.
pub fn elder_waits(table: *const Table, pick: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    const wanted = table.record[pick].follows_turns;
    if (wanted == 0) return false;
    var i: u32 = 0;
    while (i < table.held) : (i += 1) {
        if (i == pick) continue;
        if (!waits(table, i)) continue;
        if ((wanted & turn_bit(table.record[i].turn)) != 0) return true;
    }
    // invariant: the walk read the whole record, weighing every phase in it
    assert(i == table.held);
    return false;
}

/// Answers whether a sibling of this pick's own turn still waits behind it.
pub fn sibling_waits(table: *const Table, pick: u32, sibling_mask: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    var i: u32 = 0;
    while (i < pick) : (i += 1) {
        if (!waits(table, i)) continue;
        if (table.record[i].turn != table.record[pick].turn) continue;
        if ((sibling_mask & mask.step_bit(table.record[i].step)) != 0) return true;
    }
    // invariant: the walk reached the pick, weighing every phase before it
    assert(i == pick);
    return false;
}

/// Answers whether the door admits this phase over the lines remembered.
pub fn door_admits(sys: *const system.System, table: *const Table, at: u32) RunError!bool {
    return ladder_checks.door_admits(@This(), sys, table, at);
}

/// Answers whether a phase may be admitted ahead of the record's head.
fn may_pass(
    sys: *const system.System,
    table: *const Table,
    candidate: u32,
    reading: Reading,
) bool {
    // invariant: a pass always reaches forward, never at the head itself
    assert(candidate > table.head);
    // invariant: a candidate always stands inside the record
    assert(candidate < table.held);
    var i: u32 = table.head;
    while (i < candidate) : (i += 1) {
        if (!waits(table, i)) continue;
        if (items_contend(sys, table.record[i], table.record[candidate], reading)) return false;
    }
    // invariant: the walk reached the candidate, weighing every phase before it
    assert(i == candidate);
    return true;
}

/// Chooses one phase from behind a blocked head, or answers that none may go.
pub fn choose_pass(
    sys: *const system.System,
    table: *const Table,
    reading: Reading,
) RunError!?u32 {
    // invariant: a pass is only ever sought while the head stands blocked
    assert(table.head < table.held);
    // invariant: a pass never looks past the record it reads
    assert(table.head < max_queue_len);
    var looked: u32 = 0;
    var i: u32 = table.head + 1;
    while (i < table.held and looked < max_lookahead) : (i += 1) {
        if (!waits(table, i)) continue;
        looked += 1;
        if (!try door_admits(sys, table, i)) continue;
        if (!may_pass(sys, table, i, reading)) continue;
        return i;
    }
    // invariant: the look stayed inside the bound it was given
    assert(looked <= max_lookahead);
    return null;
}

/// Answers which standing dependent could carry this phase, if any could.
pub fn confer_slot(table: *const Table, at: u32) ?u32 {
    return ladder_checks.confer_slot(@This(), table, at);
}

/// Takes back the reach one standing dependent no longer needs, from the rung
/// below -- kept whole here, since a reclamation is what happens after it.
pub fn revoke_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    keep: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.revoke_one(@This(), io, table, slot, keep, report_out);
}

/// Takes one departed dependent's conferral back whole, so a successor of its
/// domain opens its eyes on a bare wire.
///
/// The rung below reaches into a standing dependent's hands; this one reaches
/// into the wire the two of them spoke over, once the dependent that listened
/// is gone. `slot` names the reaped dependent, whose row still stands in the
/// table until the reaping closes over it.
pub fn reclaim_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reclaim_one(@This(), io, table, slot, report_out);
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
pub fn confer_one(
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *Table,
    slot: u32,
    at: u32,
    keeping: Keep,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.confer_one(@This(), io, sys, caps, table, slot, at, keeping, report_out);
}

/// Starts one phase, handing the capability words this reach calls for and
/// promising the pruning this keep calls for.
pub fn start_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?Task,
    keeping: Keep,
    wake: gap.Wake,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    return ladder_checks.start_one(@This(), allocator, io, self_path, sys, caps, phase, reserve, keeping, wake, report_out);
}

/// Admits as much of the record as the table and the reading allow, and
/// answers how many phases it took up.
fn fill_table(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!u32 {
    return ladder_checks.fill_table(
        @This(), allocator, io, self_path, sys, caps, wake, reading, keeping, table, report_out,
    );
}

/// Records one departed dependent's abandoned reach, and reads the answer back.
///
/// The reclamation above has already swept this domain clean, so the count is
/// written after it rather than before -- otherwise the very act that closes
/// the conferral would erase the only evidence of what it cost. The answer is
/// read back from the wire before the report believes it.
pub fn abandon_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    came_home: bool,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.abandon_one(@This(), io, table, slot, came_home, report_out);
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
pub fn reap_oldest(
    io: std.Io,
    table: *Table,
    answer: Answer,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError)!void {
    return ladder_checks.reap_oldest(@This(), io, table, answer, report_out);
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
pub fn seat_the_ground(
    io: std.Io,
    sys: *const system.System,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError)!capabilities.CapabilityTable {
    return ladder_checks.seat_the_ground(@This(), io, sys, report_out);
}

/// Reads a written plan into the table's own record, closed and seated.
///
/// The plan is flattened to the shape the rungs below read, weighed for order
/// and for the names it keeps, closed over its own turns, and its reserves
/// carried across -- all before a single dependent is spawned, so the record a
/// run enforces is the record its author wrote.
fn seat_the_record(base: []const Phase, table: *Table) RunError!void {
    // invariant: a record always seats a plan that names phases
    assert(base.len >= 1);
    // invariant: a record is always seated into a table that holds nothing yet
    assert(table.held == 0);
    var plainly: [max_queue_len]unhand.Phase = undefined;
    var p: u32 = 0;
    while (p < base.len) : (p += 1) plainly[p] = plain(base[p]);
    // invariant: every phase was read plainly, none skipped
    assert(p == base.len);
    const flat = plainly[0..base.len];
    if (!precede.plan_is_ordered(flat)) return error.OrderStalled;
    if (!plan_is_seated(flat)) return error.PlanUnseated;

    precede.close(flat, table.record[0..base.len]);
    table.held = @intCast(base.len);
    table.left = table.held;
    var r: u32 = 0;
    while (r < base.len) : (r += 1) {
        table.reserve_of[r] = base[r].reserve;
        // The bearing is read once, here, from the record its author wrote --
        // so every later question about which losses to carry is answered from
        // the plan rather than from anything the run learns along the way.
        if (base[r].bear) table.bear_mask |= phase_bit(r);
    }
    // invariant: every phase carried its reserve into the record, none lost
    assert(r == base.len);
    // invariant: a closed record closes to itself, so the door's work is done
    assert(precede.plan_is_closed(standing(table)));
}

/// Runs a record on the reclaiming take, answering for abandoned work as the
/// chosen answer says.
///
/// The supervisor every rung of this arc keeps -- fill the table, reap the
/// eldest, judge at the end -- with the reclaiming act folded into the reaping
/// one, as the rung below folded it, and the answering act folded in behind
/// that, so a conferral both leaves with its holder and says what its holder
/// left undone.
pub fn run_in_bearing(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    bearing: Bearing,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError || RunError || cohort.RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always reports into a fresh report
    assert(run_of(report_out).admitted == 0);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len > max_queue_len) return error.QueueFull;

    var table: Table = .{};
    try seat_the_record(base, &table);

    const caps = try seat_the_ground(io, sys, report_out);
    run_of(report_out).queued = table.held;

    while (table.left > 0 or table.in_flight > 0) {
        const took_up = try fill_table(
            allocator, io, self_path, sys, &caps, wake, reading, keeping, &table, report_out,
        );
        if (table.in_flight > run_of(report_out).peak_in_flight) {
            run_of(report_out).peak_in_flight = table.in_flight;
        }

        if (table.left > 0) {
            const free = max_in_flight - table.in_flight;
            run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) run_of(report_out).idle_turns += 1;
        }

        // With an empty table nothing conflicts, so a stall here would mean
        // the record named a domain the document does not.
        if (table.in_flight == 0) return error.OrderStalled;

        try reap_oldest(io, &table, .answered, report_out);
    }
    // invariant: the whole record was taken up, and every dependent reaped
    assert(table.left == 0);
    assert(table.in_flight == 0);
    assert(run_of(report_out).reaped == run_of(report_out).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(table.finished + abandoning_of(report_out).inner.inner.inner.inner.absorbed == table.held);

    var j: u32 = 0;
    while (j < table.finished) : (j += 1) try judge_outcome(table.done[j], report_out);
    // invariant: every reaped dependent was judged, none skipped
    assert(j == table.finished);

    // The reckoning stands exactly as the rung below wrote it, and always on
    // the reckoning ledger: a mend that repaired a plan under the assuming
    // reading would be repairing a loss it had already declared did not count.
    // What this rung adds to it is the bearing note beside the loss note.
    try reckon_the_plan(io, &table, .reckoned, report_out);

    // Every run here mends, since the question this rung asks opens inside the
    // repair rather than before it: what separates the two readings is which
    // of the plan's losses the repair is allowed to touch.
    try mend_the_plan(
        allocator, io, self_path, sys, &caps, base, wake, keeping, bearing, &table, report_out,
    );
}

/// Runs the arcs a plan lost that its author asked to have run, and answers
/// for what is left standing after.
///
/// The mend reads its own run's verdict back from the wire before it decides
/// anything, because a supervisor that repairs from memory is repairing a plan
/// it believes in rather than the one it published. A plan the wire calls
/// `carried` is refused outright -- there is nothing here to repair, and a
/// mend that ran anyway would re-do work already served.
///
/// **What this rung adds is the bearing, read from the same wire.** The loss
/// note names where the plan fell short; the bearing note names which of those
/// places its author would rather leave standing. Under `.repaired` the mend
/// seats every lost phase, exactly as the rung below does. Under `.borne` it
/// seats the lost phases the bearing spares, carries the rest as loss, and the
/// settlement says so in a word an operator can act on.
pub fn mend_the_plan(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    base: []const Phase,
    wake: gap.Wake,
    keeping: Keep,
    bearing: Bearing,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!void {
    // invariant: a mend always reads a record the run has drained
    assert(table.left == 0);
    // invariant: a mend always reads a plan the run actually held
    assert(base.len == table.held);
    const lost = abandoning_of(report_out).abandoned;
    if (lost == 0) {
        // invariant: a plan that lost nothing leaves nothing standing
        assert(below_of(report_out).unserved == 0);
        below_of(report_out).settled = .carried;
        report_out.settlement = .carried;
        return;
    }

    // The wire before the memory: what this run published about itself, read
    // back the way an operator would read it.
    const published = verdict_published(io);
    const named = lost_published(io, table.held);
    const spared = if (bearing == .borne) bearing_published(io, table.held) & named else 0;
    var seating: u32 = 0;
    var bore: u32 = 0;
    var at: u32 = 0;
    while (at < table.held) : (at += 1) {
        if ((named & phase_bit(at)) == 0) continue;
        if ((spared & phase_bit(at)) != 0) {
            bore += 1;
            continue;
        }
        seating += 1;
    }
    // invariant: the walk weighed every phase of the record, none skipped
    assert(at == table.held);
    if (bear_refusal(published, lost, bore, seating)) |why| return why;
    if (seating >= 1) {
        if (mend_refusal(published, lost, seating)) |why| return why;
    }
    report_out.bore = bore;

    var again: [max_queue_len]Phase = undefined;
    var wrote: u32 = 0;
    var seated_mask: u32 = 0;
    at = 0;
    while (at < table.held) : (at += 1) {
        if ((named & phase_bit(at)) == 0) continue;
        if ((spared & phase_bit(at)) != 0) continue;
        again[wrote] = reseated(base[at], wrote);
        seated_mask |= phase_bit(at);
        wrote += 1;
    }
    // The obedience this rung measures, taken before the repair runs rather
    // than inferred from it afterwards: arcs the plan asked to bear that the
    // repair is about to run anyway. The measurement weighs what the *plan*
    // asked, so the elder reading is counted rather than refused -- and the
    // refusal weighs what this run's own bearing *published*, so a repair that
    // reaches past the wire it read is stopped by name before it spawns, and
    // before any invariant beneath it has to catch a supervisor in the act.
    report_out.overrepaired = overrepaired(table.bear_mask & named, seated_mask);
    if (overrepaired(spared, seated_mask) >= 1) return error.BearOverrepaired;
    // invariant: the mend seated exactly the phases the wire left it
    assert(wrote == seating);

    if (wrote == 0) {
        // Every loss this plan took is loss its author asked to carry, so the
        // repair has nothing to run and the settlement says the plan is as
        // whole as it was ever asked to be.
        try settle_the_plan(io, lost, 0, report_out);
        return;
    }

    var second: Table = .{};
    try seat_the_record(again[0..wrote], &second);
    below_of(report_out).reseated += wrote;

    while (second.left > 0 or second.in_flight > 0) {
        const took_up = try fill_table(
            allocator, io, self_path, sys, caps, wake, .preceded, keeping, &second, report_out,
        );
        if (second.in_flight > run_of(report_out).peak_in_flight) {
            run_of(report_out).peak_in_flight = second.in_flight;
        }
        if (second.left > 0) {
            const free = max_in_flight - second.in_flight;
            run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) run_of(report_out).idle_turns += 1;
        }
        if (second.in_flight == 0) return error.OrderStalled;
        try reap_oldest(io, &second, .answered, report_out);
    }
    // invariant: the repair was taken up whole, and every dependent reaped
    assert(second.left == 0);
    assert(second.in_flight == 0);

    var j: u32 = 0;
    while (j < second.finished) : (j += 1) try judge_outcome(second.done[j], report_out);
    // invariant: every dependent of the repair was judged, none skipped
    assert(j == second.finished);
    // invariant: a repair never loses an arc of its own, since it confers none
    assert(second.lost_mask == 0);

    // What the repair carried is what it seated, since every phase of it was
    // judged against the outcome its own author declared and none was
    // conferred away. So the work still standing is the loss minus the repair.
    try settle_the_plan(io, lost, wrote, report_out);
}

/// Publishes what the plan came to and what that means, and reads both back.
///
/// The verdict below answers whether work is still standing; the settlement
/// answers what an operator should do about it. Both go to the wire and both
/// are read back before the report believes either, since a supervisor that
/// trusts its own memory of what it published has published nothing.
fn settle_the_plan(
    io: std.Io,
    lost: u32,
    served_again: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a settling always weighs a plan that actually lost an arc
    assert(lost >= 1);
    // invariant: a repair never carries more arcs than the plan lost
    assert(served_again <= lost);
    below_of(report_out).unserved = unserved_after(lost, served_again);
    const settled = settled_verdict(below_of(report_out).unserved);
    try verdict_note(io, settled);
    const said = verdict_published(io) orelse return error.MendUnserved;
    if (said != settled) return error.MendUnserved;
    if (said == .carried and below_of(report_out).unserved >= 1) return error.MendUnserved;
    below_of(report_out).settled = said;

    const settlement = settlement_of(below_of(report_out).unserved, report_out.bore);
    try settlement_note(io, settlement);
    const read_back = settlement_published(io) orelse return error.BearOverrepaired;
    if (read_back != settlement) return error.BearOverrepaired;
    // The answer, and the hard half of this rung: a run that re-ran an arc its
    // author asked it to bear has disobeyed the plan it serves, and a run that
    // called such a plan borne would report an obedience it never practiced.
    if (read_back == .borne and report_out.overrepaired >= 1) return error.BearOverrepaired;
    report_out.settlement = read_back;
}

/// Weighs what the plan came to, publishes the verdict and the loss, and reads
/// the verdict back.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. A plan that absorbed no phase into a
/// standing dependent is carried by the shape of its own record, and this rung
/// leaves it exactly there rather than inventing a judgment it cannot make.
///
/// What this rung adds to the one below is the **loss note beside the verdict**.
/// The verdict says that a plan fell short; a supervisor that means to repair
/// it needs to know where, and the answer lives in a table that is gone the
/// moment the run returns. So the run writes it down while it still holds it.
pub fn reckon_the_plan(
    io: std.Io,
    table: *const Table,
    ledger: Ledger,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a reckoning always reads a record the run has drained
    assert(table.left == 0);
    const absorbed = abandoning_of(report_out).inner.inner.inner.inner.absorbed;
    const lost = abandoning_of(report_out).abandoned;
    try lost_note(io, table.held, table.lost_mask);
    // The bearing rides beside the loss, written from the plan the run seated
    // rather than from anything it learned along the way: a phase asked to be
    // borne asked it before the run began.
    try bearing_note(io, table.held, table.lost_mask & table.bear_mask);
    if (absorbed == 0) {
        // invariant: a plan that absorbed nothing can have lost nothing
        assert(lost == 0);
        // invariant: a plan that lost nothing names no phase in its loss
        assert(table.lost_mask == 0);
        below_of(report_out).inner.verdict = .carried;
        below_of(report_out).settled = .carried;
        report_out.settlement = .carried;
        try verdict_note(io, .carried);
        try settlement_note(io, .carried);
        return;
    }
    if (reckon_refusal(absorbed, table.in_flight, lost)) |why| return why;

    const verdict = verdict_in(lost, ledger);
    try verdict_note(io, verdict);
    const said = verdict_published(io) orelse return error.ReckonOverclaimed;
    if (said != verdict) return error.ReckonOverclaimed;
    if (ledger == .reckoned and said == .carried and lost >= 1) return error.ReckonOverclaimed;
    below_of(report_out).inner.verdict = said;
    below_of(report_out).inner.overclaimed += overclaimed_completion(lost, said);
    // Where the run stands before any repair: the loss, entire. A mend moves
    // this number and nothing else moves it.
    below_of(report_out).unserved = lost;
    below_of(report_out).settled = said;
}

// =========================================================================
// The dependent -- a walk that reads the wire before it trusts its own hands
// =========================================================================

/// Reads the capability words a dependent was handed at its spawn into its slot.
pub fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    return ladder_checks.slot_from_argv(@This(), args, domain, cap_count);
}

/// Answers whether this dependent already holds a capability over one region.
pub fn already_holds(slot: *const capabilities.DependentSlot, region_name: []const u8) bool {
    // invariant: a holding is always asked about a named region
    assert(region_name.len >= 1);
    // invariant: a holding never reads past what one dependent may hold
    assert(slot.cap_count <= capabilities.max_caps_per_dependent);
    var i: u32 = 0;
    while (i < slot.cap_count) : (i += 1) {
        if (std.mem.eql(u8, slot.caps[i].name_slice(), region_name)) return true;
    }
    // invariant: the walk read every capability the dependent holds, none skipped
    assert(i == slot.cap_count);
    return false;
}

/// Names the word at one depth of a list, or answers that the list is shorter.
pub fn word_at(words: *const Words, index: u32) ?[]const u8 {
    // invariant: a word is only ever sought inside what one dependent may hold
    assert(index < capabilities.max_caps_per_dependent);
    var seen: u32 = 0;
    var lines = std.mem.splitScalar(u8, words.slice(), '\n');
    while (lines.next()) |one| {
        if (one.len == 0) continue;
        if (seen == index) return one;
        seen += 1;
    }
    return null;
}

/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    base: *const capabilities.DependentSlot,
    words: *const Words,
    keep: u32,
) ?capabilities.DependentSlot {
    return ladder_checks.prune_to(@This(), base, words, keep);
}

/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const Words,
    from: u32,
    to: u32,
) u32 {
    return ladder_checks.reachable_between(@This(), io, slot, words, from, to);
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of this rung, made by the party that would be lying if it were
/// wrong -- and made without touching the hands the dependent actually works
/// with. The words standing for this domain are grafted into a *copy* of those
/// hands, and each arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
pub fn inherited_at_first_breath(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    return ladder_checks.inherited_at_first_breath(@This(), io, base, domain);
}

/// One dependent's own line, read arc by arc against the count it was handed.
pub fn read_own_line(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    task: cycle.Task,
) ?u8 {
    return ladder_checks.read_own_line(@This(), io, slot, task);
}

/// Grafts every conferred word as it arrives, reads each arc, and answers for
/// what it holds.
///
/// Answers the count grafted, or an outcome code where a word or an arc did
/// not stand. The dependent answers `.held` only after reading every arc it
/// grafted, which is what lets the supervisor read that answer as work served.
pub fn graft_promised_reach(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *Words,
    carried_out: *u32,
) ?u8 {
    return ladder_checks.graft_promised_reach(@This(), io, slot, domain, task, promised, granted, carried_out);
}

/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const Words,
    carried: u32,
) ?u32 {
    return ladder_checks.return_promised_reach(@This(), io, base, slot, domain, granted, carried);
}

/// Reads the arcs this dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
pub fn stand_taking_and_returning_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    return ladder_checks.stand_taking_and_returning_reach(@This(), io, base, slot, domain, task, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
pub fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    return ladder_checks.run_dependent(@This(), io, args);
}


// =========================================================================
// The lap -- one plan run twice, once repairing every loss and once bearing
// the loss its author asked it to carry
// =========================================================================

/// The lap this rung runs, and the phase its author asked nobody to re-run is
/// the whole of it.
///
/// Both clients stand over three arcs and carry a reserve of one, and the phase
/// behind each asks that same client to peek exactly the reserved arc -- so the
/// run confers `menu` to a dependent already standing, twice. Both authors
/// declare that their dependent falls, so each grafts the word, answers for it,
/// and falls holding it: two conferrals, two arcs nobody served.
///
/// The two losses part company at the bearing. `client_b`'s peek is written
/// plainly, so its loss is repairable and both readings run it again. The peek
/// behind `client_a` is written `bear = true` -- its author would rather carry
/// that loss than have a supervisor take it up a second time. The elder reading
/// never sees the word and repairs both; this one repairs the first, bears the
/// second, and settles the plan as whole but for the loss its author chose.
const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_b", .verb = .stand, .hops = "board,ask_b,taken_b", .peers = "serial_virt,client_b", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_a", .verb = .stand, .hops = "board,ask_a,taken_a", .peers = "serial_virt,client_a", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .bear = true, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    return ladder_checks.load_one(io, path, buf);
}

/// The mend below, read straight, so this rung's own fold stands on a repair
/// that still refuses everything it always refused.
pub fn check_mending() u8 {
    // The act itself: a plan the wire calls short, one arc lost, one phase
    // seated to carry it.
    if (mend_refusal(.short, 1, 1)) |why| {
        print("  RED: a settled mend refused: {s}\n", .{@errorName(why)});
        return 1;
    }

    // The record, the plan, and the reach, exactly as the rung below weighs them.
    if (mend_refusal(null, 1, 1)) |why| {
        if (why != error.MendUnread) {
            print("  RED: an unread mend refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a mend that read no verdict was allowed to repair\n", .{});
        return 1;
    }
    if (mend_refusal(.carried, 0, 0)) |why| {
        if (why != error.MendWhole) {
            print("  RED: a whole plan refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan already carried was mended\n", .{});
        return 1;
    }
    if (mend_refusal(.short, 1, 2)) |why| {
        if (why != error.MendOvereach) {
            print("  RED: an overreaching mend refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a mend seated more phases than the plan ever lost\n", .{});
        return 1;
    }

    // What is left standing, and the verdict that follows the work.
    if (unserved_after(2, 1) != 1 or settled_verdict(1) != .short or settled_verdict(0) != .carried) {
        print("  RED: the repair below stopped counting what still stands\n", .{});
        return 1;
    }

    print("  a repair still refuses by name: unread, whole, overreaching\n", .{});
    return 0;
}

/// The bearing and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a bearing is
/// weighed, the work it weighs, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `BearOverrepaired`, belongs
/// to the run rather than the fold, since only the wire can answer what a plan
/// published about its own obedience.
pub fn check_bearing() u8 {
    // The act itself: a plan the wire calls short, two arcs lost, one borne and
    // one repaired.
    if (bear_refusal(.short, 2, 1, 1)) |why| {
        print("  RED: a settled bearing refused: {s}\n", .{@errorName(why)});
        return 1;
    }

    // The moment: a bearing weighed before the run published what it lost is
    // obeying a plan it remembers rather than the one it wrote down.
    if (bear_refusal(null, 2, 1, 1)) |why| {
        if (why != error.BearEarly) {
            print("  RED: an early bearing refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a bearing was weighed before the run published anything\n", .{});
        return 1;
    }

    // The work: a plan that lost nothing has nothing here to bear.
    if (bear_refusal(.carried, 0, 0, 0)) |why| {
        if (why != error.BearWhole) {
            print("  RED: a whole plan's bearing refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that lost nothing bore a loss all the same\n", .{});
        return 1;
    }

    // The honesty of the count, from both sides: a plan cannot bear more arcs
    // than it lost, and every lost arc is either borne or repaired.
    if (bear_refusal(.short, 1, 2, 0)) |why| {
        if (why != error.BearMiscounted) {
            print("  RED: an overborne plan refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan bore more arcs than it ever lost\n", .{});
        return 1;
    }
    if (bear_refusal(.short, 2, 1, 0)) |why| {
        if (why != error.BearMiscounted) {
            print("  RED: an unaccounted loss refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a loss was neither borne nor repaired, and nobody minded\n", .{});
        return 1;
    }

    // The number this rung moves, as a fold: an arc the plan asked to bear and
    // the repair seated anyway.
    if (overrepaired(phase_bit(3), phase_bit(3)) != 1) {
        print("  RED: a borne arc re-run counted as obedience\n", .{});
        return 1;
    }
    if (overrepaired(phase_bit(3), phase_bit(1)) != 0) {
        print("  RED: a repair of a repairable arc counted as overreach\n", .{});
        return 1;
    }
    if (overrepaired(0, phase_bit(1) | phase_bit(3)) != 0) {
        print("  RED: a plan that asked nothing was disobeyed all the same\n", .{});
        return 1;
    }

    // The settlement, and the third word two were never honest enough to carry.
    if (settlement_of(0, 0) != .carried) {
        print("  RED: a plan with nothing standing was not read as carried out\n", .{});
        return 1;
    }
    if (settlement_of(1, 1) != .borne) {
        print("  RED: a plan whose whole loss was borne was read as short\n", .{});
        return 1;
    }
    if (settlement_of(2, 1) != .short) {
        print("  RED: a plan still holding work nobody bore was read as borne\n", .{});
        return 1;
    }
    if (settlement_of(1, 0) != .short) {
        print("  RED: a loss nobody asked to bear was borne anyway\n", .{});
        return 1;
    }

    // The settlement survives the round trip through the byte it rides as.
    if (settlement_of_byte(settlement_byte(.borne)) != .borne or
        settlement_of_byte(settlement_byte(.carried)) != .carried or
        settlement_of_byte(settlement_byte(.short)) != .short)
    {
        print("  RED: a settlement did not survive the wire it rides\n", .{});
        return 1;
    }
    if (settlement_of_byte(0) != null) {
        print("  RED: a cleared note read as a settlement\n", .{});
        return 1;
    }

    // A re-seated phase carries its bearing forward, since a phase that asked
    // to be borne asks it every time it is written down.
    const again = reseated(written_queue[3], 0);
    if (!again.bear) {
        print("  RED: a re-seated phase forgot the bearing its author wrote\n", .{});
        return 1;
    }
    if (again.reserve != null or again.follows != 0 or again.follows_turns != 0) {
        print("  RED: a re-seated phase kept an arrangement its siblings no longer stand in\n", .{});
        return 1;
    }

    print("  a plan names what it expects of a phase, and what it would accept of a loss\n", .{});
    print("  three refusals stand by name: early, whole, miscounted\n", .{});
    print("  the bearing this rung keeps: {s}\n", .{bearing_words(.borne)});
    return 0;
}

/// The generalization test: a run that bears a plan losing nothing reads as the
/// rung below.
pub fn check_unlost(sys: *const system.System) u8 {
    const clients = [_]Task{
        written_queue[0].task,
        written_queue[1].task,
        written_queue[3].task,
    };
    var agreed: u32 = 0;
    var a: u32 = 0;
    while (a < clients.len) : (a += 1) {
        var live_store: [max_in_flight]cohort.Running = undefined;
        live_store[0] = .{
            .proc = undefined,
            .domain = clients[a].item.domain,
            .verb = clients[a].item.verb,
            .count = clients[a].item.count,
            .expect = clients[a].item.expect,
        };
        var handed_store: [max_in_flight]Task = undefined;
        handed_store[0] = clients[a];
        const reserve_store = [_]?Task{null};
        const taken_store = [_]u32{0};
        var b: u32 = 0;
        while (b < clients.len) : (b += 1) {
            const here = admissible_in(
                sys, live_store[0..1], handed_store[0..1], reserve_store[0..1], taken_store[0..1], clients[b],
            ) catch {
                print("  RED: a bearing run could not weigh its own door\n", .{});
                return 1;
            };
            const there = unhand.admissible_held(sys, live_store[0..1], handed_store[0..1], clients[b]);
            if (here != there) {
                print("  RED: the two readings disagreed about {s} beside {s}\n", .{
                    clients[b].item.domain, clients[a].item.domain,
                });
                return 1;
            }
            agreed += 1;
        }
        // invariant: every newcomer was weighed against this dependent, none skipped
        assert(b == clients.len);
    }
    // invariant: every line stood as the running dependent once, none skipped
    assert(a == clients.len);

    print("  a plan that loses nothing reads as the line handed, all {d} pairs\n", .{agreed});
    return 0;
}

/// Runs one queue whole under one bearing and says whether it survived.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    bearing: Bearing,
    report_out: *Report,
) bool {
    run_in_bearing(
        allocator, io, self_path, sys, plan, .when_moved, .preceded, .held_on, bearing, report_out,
    ) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Tells what the two bearings did, side by side, in an operator's own words.
fn tell_bearing_runs(repaired: *Report, borne: *Report) void {
    // invariant: a telling always reads two runs that were actually run
    assert(run_of(repaired).queued >= 1);
    // invariant: a telling never reports more dependents than a repair may add
    assert(run_of(borne).reaped <= run_of(borne).queued + max_queue_len);
    print("  phases: {d} repairing, {d} bearing\n", .{
        run_of(repaired).queued, run_of(borne).queued,
    });
    print("  dependents: {d} repairing, {d} bearing\n", .{
        run_of(repaired).reaped, run_of(borne).reaped,
    });
    print("  phases absorbed into a standing dependent: {d} repairing, {d} bearing\n", .{
        abandoning_of(repaired).inner.inner.inner.inner.absorbed,
        abandoning_of(borne).inner.inner.inner.inner.absorbed,
    });
    print("  abandoned reach, conferred and never served: {d} repairing, {d} bearing\n", .{
        abandoning_of(repaired).abandoned, abandoning_of(borne).abandoned,
    });
    print("  the plan, as the run first reports it: {s} repairing, {s} bearing\n", .{
        verdict_words(below_of(repaired).inner.verdict), verdict_words(below_of(borne).inner.verdict),
    });
    print("  phases re-seated to carry what was lost: {d} repairing, {d} bearing\n", .{
        below_of(repaired).reseated, below_of(borne).reseated,
    });
    print("  losses carried rather than repaired: {d} repairing, {d} bearing\n", .{
        repaired.bore, borne.bore,
    });
    print("  arcs re-run against the plan's own word: {d} against {d}\n", .{
        repaired.overrepaired, borne.overrepaired,
    });
    print("  work still standing when the supervisor exits: {d} repairing, {d} bearing\n", .{
        below_of(repaired).unserved, below_of(borne).unserved,
    });
    print("  the plan, as an operator finally reads it: {s} repairing, {s} bearing\n", .{
        settlement_words(repaired.settlement), settlement_words(borne.settlement),
    });
    print("  breaks a named turn: {d} repairing, {d} bearing\n", .{
        preceded_of(repaired).out_of_precede, preceded_of(borne).out_of_precede,
    });
}

/// Weighs the two bearings against each other and names the first disagreement.
///
/// The shape of the finding is one number moving and the price of moving it
/// named honestly beside it. Both runs take up the same record, confer the same
/// arcs, lose the same arcs, and report the plan short when they first weigh
/// it. What differs is obedience -- and the one dependent the elder reading
/// spends to disobey.
fn judge_bearing_runs(repaired: *Report, borne: *Report) u8 {
    // invariant: a judging always reads two runs that were actually run
    assert(run_of(repaired).queued >= 1);
    // invariant: a judging never counts a repair the plan never lost
    assert(below_of(borne).reseated <= max_queue_len);
    if (run_of(borne).queued != run_of(repaired).queued) {
        print("  RED: the two bearings ran {d} phases against {d}\n", .{
            run_of(borne).queued, run_of(repaired).queued,
        });
        return 1;
    }
    if (abandoning_of(borne).abandoned != abandoning_of(repaired).abandoned) {
        print("  RED: the two bearings lost {d} arcs against {d}\n", .{
            abandoning_of(borne).abandoned, abandoning_of(repaired).abandoned,
        });
        return 1;
    }
    if (abandoning_of(borne).abandoned < 2) {
        print("  RED: the lap lost {d} arcs, and this rung needs two to part them\n", .{
            abandoning_of(borne).abandoned,
        });
        return 1;
    }
    if (below_of(repaired).inner.verdict != .short or below_of(borne).inner.verdict != .short) {
        print("  RED: a plan that lost an arc was first weighed as carried out\n", .{});
        return 1;
    }
    if (repaired.bore != 0) {
        print("  RED: a repairing run bore {d} losses it never meant to\n", .{repaired.bore});
        return 1;
    }
    if (borne.bore != 1) {
        print("  RED: a bearing run carried {d} losses rather than the one its plan named\n", .{
            borne.bore,
        });
        return 1;
    }
    if (repaired.overrepaired != 1) {
        print("  RED: a run that repaired every loss disobeyed {d} times rather than once\n", .{
            repaired.overrepaired,
        });
        return 1;
    }
    if (borne.overrepaired != 0) {
        print("  RED: a bearing run still re-ran {d} arcs its author asked it to bear\n", .{
            borne.overrepaired,
        });
        return 1;
    }
    if (below_of(repaired).unserved != 0) {
        print("  RED: a run that repaired every loss left {d} arcs standing\n", .{
            below_of(repaired).unserved,
        });
        return 1;
    }
    if (below_of(borne).unserved != 1) {
        print("  RED: a bearing run left {d} arcs standing rather than the one it bore\n", .{
            below_of(borne).unserved,
        });
        return 1;
    }
    if (repaired.settlement != .carried) {
        print("  RED: a plan whose every lost arc was re-run settled {s}\n", .{
            settlement_words(repaired.settlement),
        });
        return 1;
    }
    if (borne.settlement != .borne) {
        print("  RED: a plan whole but for its borne loss settled {s}\n", .{
            settlement_words(borne.settlement),
        });
        return 1;
    }
    // The price of disobedience, named rather than hidden: the elder reading
    // spends exactly one more dependent, and spends it on work nobody asked for.
    if (run_of(repaired).reaped != run_of(borne).reaped + 1) {
        print("  RED: repairing a borne loss cost {d} dependents against {d}\n", .{
            run_of(repaired).reaped, run_of(borne).reaped,
        });
        return 1;
    }
    if (preceded_of(borne).out_of_precede != 0) {
        print("  RED: the bearing run broke {d} turn orders its author named\n", .{
            preceded_of(borne).out_of_precede,
        });
        return 1;
    }
    return 0;
}

/// The bearing lap: one plan run twice, once repairing every loss it took and
/// once carrying the loss its author asked it to carry.
pub fn check_bearing_runs(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
) u8 {
    var repaired: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .repaired, &repaired)) return 1;
    const repaired_said = settlement_published(io) orelse {
        print("  RED: a run published no settlement at all\n", .{});
        return 1;
    };
    if (repaired_said != .carried) {
        print("  RED: the wire read {s} where every loss was re-run\n", .{
            settlement_words(repaired_said),
        });
        return 1;
    }

    var borne: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .borne, &borne)) return 1;
    // What an operator reads is what the wire carries, read here outside the
    // run that wrote it.
    const borne_said = settlement_published(io) orelse {
        print("  RED: a bearing run published no settlement at all\n", .{});
        return 1;
    };
    if (borne_said != .borne) {
        print("  RED: the wire read {s} where a loss was carried rather than repaired\n", .{
            settlement_words(borne_said),
        });
        return 1;
    }
    const borne_named = bearing_published(io, run_of(&borne).queued);
    if (borne_named == 0) {
        print("  RED: a plan that bore a loss named no phase it bore\n", .{});
        return 1;
    }

    tell_bearing_runs(&repaired, &borne);
    const judged = judge_bearing_runs(&repaired, &borne);
    if (judged != 0) return judged;

    // invariant: a run reaps exactly the dependents it admitted, never more
    assert(run_of(&borne).reaped == run_of(&borne).admitted);
    // invariant: a plan never bears more arcs than it lost
    assert(borne.bore <= abandoning_of(&borne).abandoned);
    // invariant: a bearing run re-runs nothing its author asked it to bear
    assert(borne.overrepaired == 0);
    return 0;
}

pub fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan bear {s} -- self-test\n", .{caravan_bear_version});
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const mending = check_mending();
    if (mending != 0) return mending;
    const bearing = check_bearing();
    if (bearing != 0) return bearing;
    const unlost = check_unlost(&sys);
    if (unlost != 0) return unlost;
    const runs = check_bearing_runs(allocator, io, self_path, &sys);
    if (runs != 0) return runs;
    print("  GREEN: a plan may name the loss it would rather carry than repair\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    return ladder_checks.run_main(@This(), init);
}
