/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return forbearing_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, correct the
/// reader of a word it has since replaced, carry that correction to them, hear
/// what that reader answered back, record a disagreement it cannot resolve,
/// stand a word up beside that disagreement, put a term on how long the
/// disagreement may stand, or carry that term into the mark itself.
///
/// Five names of this rung's own, matching the five below it. `AvowUnheard` is
/// the moment a word is taken at all: a run that read no finding has nothing to
/// answer. `AvowUnfound` is whether a finding stands published on the wire to
/// answer. `OweUnsaid` is the moment a debt is booked at all: a plan that said
/// no word has conceded nothing, and a debt booked there would record an
/// admission never made. `OweUnconceded` is the same guard one step in -- a plan
/// that kept its own word owes the work nothing, and booking a debt against a
/// dissent would turn holding one's ground into an admission of fault.
/// `OweMismatched` is the whole point: a debt that does not name the finding
/// this run conceded is a debt about some older argument, and carrying it
/// forward would have a later run meeting a concession nobody made today.
/// `OweMiscounted` is the honesty of the count, and `OweMisrecorded` is the
/// record, read back from the one note that outlives the run.
pub const RunError = forbearing_rung.RunError || error{
    OweUnsaid,
    OweUnconceded,
    OweMismatched,
    OweMiscounted,
    OweMisrecorded,
    MeetUnowed,
    MeetUnsettled,
    MeetMismatched,
    MeetMiscounted,
    MeetMisrecorded,
    RedressUnmet,
    RedressUnrighted,
    RedressMismatched,
    RedressMiscounted,
    RedressMisrecorded,
    AppriseUnfound,
    AppriseUnaddressed,
    AppriseMismatched,
    AppriseMiscounted,
    AppriseMisrecorded,
    SufficeUntold,
    SufficeSilent,
    SufficeMismatched,
    SufficeMiscounted,
    SufficeMisrecorded,
    ReopenUnweighed,
    ReopenSettled,
    ReopenMismatched,
    ReopenMiscounted,
    ReopenMisrecorded,
    ReweighUnopened,
    ReweighUnsettled,
    ReweighMismatched,
    ReweighMiscounted,
    ReweighMisrecorded,
    RecountUnlooked,
    RecountUnaddressed,
    RecountMismatched,
    RecountMiscounted,
    RecountMisrecorded,
    AllayUntold,
    AllaySilent,
    AllayMismatched,
    AllayMiscounted,
    AllayMisrecorded,
    ForbearUnread,
    ForbearAllayed,
    ForbearMismatched,
    ForbearMiscounted,
    ForbearMisrecorded,
    MindUninherited,
    MindRested,
    MindMismatched,
    MindMiscounted,
    MindMisrecorded,
    DesistUnnamed,
    DesistFresh,
    DesistMismatched,
    DesistMiscounted,
    DesistMisrecorded,
    BeckonUnwalled,
    BeckonUnaddressed,
    BeckonMismatched,
    BeckonMiscounted,
    BeckonMisrecorded,
    AnswerUncalled,
    AnswerSilent,
    AnswerMismatched,
    AnswerMiscounted,
    AnswerMisrecorded,
    AbateUnopened,
    AbateUnreleased,
    AbateMismatched,
    AbateMiscounted,
    AbateMisrecorded,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = forbearing_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = forbearing_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) forbearing_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return forbearing_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = forbearing_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = forbearing_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = forbearing_rung.Words;

