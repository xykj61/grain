// =========================================================================
// The referring -- a long-standing quarrel put before a hand that is neither
// party to it
// =========================================================================

/// How many bytes one referral carries.
///
/// Three, and each is a fact a third hand needs before it can weigh anything:
/// what the plan came to, how loudly the objection against it reads, and how
/// many runs that objection has stood. A referral shorter than this would send
/// somebody a complaint with no case attached.
pub const max_referral_bytes: u32 = 3;

/// Whether a run puts a long-standing quarrel in front of anybody outside it.
///
/// `unheard` is where every rung below leaves it: the whole argument -- the
/// plan's word, the reader's objection, its age, its standing -- lives between
/// exactly two hands, the supervisor that ran and the reader that objected.
/// Neither of them can end it, since one may not grade an objection raised
/// against itself and the other has already said what they think. `referred` is
/// this rung: the case carried once, whole, to a hand that is neither.
pub const Refer = enum { unheard, referred };

/// Renders one referring as the words an operator reads.
pub fn refer_words(r: Refer) []const u8 {
    return switch (r) {
        .unheard => "a long-standing quarrel stays between the two hands that cannot end it",
        .referred => "a long-standing quarrel is put before a hand that is neither party",
    };
}

/// Answers whether an address names somebody already inside the argument.
///
/// **The whole point of the rung, written as one comparison.** A supervisor
/// that could name its own reader as the hand weighing their quarrel would have
/// referred nothing: the case would land back on a desk that has already said
/// what it thinks. The forum is read off the wire rather than chosen by a run,
/// and this refuses the one address a plan must never send a case to.
pub fn is_party(forum: []const u8, reader: []const u8) bool {
    // invariant: a forum weighed here is always an address a run may carry to
    assert(addressable(forum));
    return std.mem.eql(u8, forum, reader);
}

/// How many long-standing positions this run carries to a third hand.
///
/// A run under `.unheard` carries none, however long its position has stood --
/// which is exactly where the rung below leaves every quarrel it heralds. A run
/// under `.referred` refers the one long-standing position left over it.
pub fn referred_in(loud_count: u32, refer: Refer) u32 {
    // invariant: a plan never leaves more positions standing than one note may carry
    assert(loud_count <= 1);
    if (loud_count == 0) return 0;
    if (refer == .unheard) return 0;
    return loud_count;
}

/// How many long-standing positions this run keeps inside the argument.
///
/// The other half of the same count, and the two close on the long-standing
/// positions the run leaves behind -- never both and never neither.
pub fn unreferred_in(loud_count: u32, refer: Refer) u32 {
    // invariant: a plan never leaves more positions standing than one note may carry
    assert(loud_count <= 1);
    return loud_count - referred_in(loud_count, refer);
}

/// Answers why a run may not refer a quarrel, or that it may.
///
/// Every refusal this rung earns before a case reaches anybody's desk.
/// `loud_count` is what this run actually leaves standing long, `sent_count` is
/// how many it carries out, `held_count` is how many it keeps inside the
/// argument, `addressed` says whether a forum stands on the wire at all, and
/// `party` says whether that forum names somebody already in the argument.
///
/// The order is the rung below's order one tier out. A referral asks whether
/// anything long-standing is there before it asks where to send it, asks
/// whether a forum stands on the wire before it reads one, and asks whether
/// that forum is a party before a byte of the case leaves the plan -- because a
/// case delivered to a desk that has already spoken is worse than a case never
/// sent, wearing as it does the look of a hearing.
pub fn refer_refusal(loud_count: u32, sent_count: u32, held_count: u32, addressed: bool, party: bool) ?RunError {
    return ladder_checks.refer_refusal(@This(), loud_count, sent_count, held_count, addressed, party);
}

/// Renders the case one referral carries, in the three bytes a third hand reads.
///
/// The plan's own word first, then how loudly the objection reads, then how
/// many runs it has stood. Every one of the three comes off the wire in the run
/// that sends it, so a referral is a copy of the record rather than a summary
/// of it -- and a summary is exactly where a supervisor would get to shade the
/// case against itself.
pub fn referral_bytes(settled: Settlement, volume: Volume, age: u32) [max_referral_bytes]u8 {
    // invariant: an age carried in a case always fits the byte that carries it
    assert(age <= max_dwell_runs);
    // invariant: a case only ever travels for a quarrel that reads long-standing
    assert(volume == .loud);
    return .{ settlement_byte(settled), volume_byte(volume), @intCast(age) };
}

/// Answers whether the case in a third hand's box says what this run sent.
///
/// The record half of this rung, and the reason the box is read back before the
/// report believes a word of it. This is the one note of the whole arc that
/// lands outside both parties, so a case disagreeing with the record it was
/// copied from would mislead the only hand able to end the argument.
pub fn refer_holds(delivered: ?[max_referral_bytes]u8, expected: [max_referral_bytes]u8) bool {
    const seen = delivered orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

// =========================================================================
// The deeming -- the answer a third hand wrote, read back and published where
// the outcome is read
// =========================================================================

/// How many bytes one finding carries.
///
/// Four: the three that named the case, echoed back exactly as they were sent,
/// and one more saying what the third hand made of it. A finding that carried
/// the verdict alone would be an opinion with no argument attached to it, and a
/// plan could file it beside any quarrel at all.
pub const max_finding_bytes: u32 = max_referral_bytes + 1;

/// Whether a run reads back what the hand it referred to made of the case.
///
/// `unread` is where the rung below leaves every referral: a case travels to a
/// desk outside the argument, and nothing whatever comes home. So a plan may
/// refer the same quarrel forever, run after run, and never once be told what
/// the hand it chose thought -- which leaves the argument exactly as stuck as
/// it was, with one more document in it. `answered` is this rung: the finding
/// that hand wrote, read off their box and published where the outcome is read.
pub const Deem = enum { unread, answered };

/// Renders one deeming as the words an operator reads.
pub fn deem_words(d: Deem) []const u8 {
    return switch (d) {
        .unread => "a case carried out is never heard from again",
        .answered => "the hand the case went to is read back, and its finding published",
    };
}

/// What a third hand made of the case put in front of them.
///
/// Two answers, because a hearing that could return more than a yes and a no
/// would be a run reading a paragraph and telling an operator what it said.
/// `upholds` is the objection standing: the reader was right to raise it.
/// `overrules` is the plan's word standing: the work reads as it always read.
/// **No run ever writes either one.** A supervisor able to author the finding
/// against it has graded its own objection, which is the whole thing the
/// referral below existed to prevent.
pub const Finding = enum { upholds, overrules };

/// Renders one finding as the words an operator reads.
pub fn finding_words(f: Finding) []const u8 {
    return switch (f) {
        .upholds => "a hand outside the argument finds for the reader who objected",
        .overrules => "a hand outside the argument finds for the plan's own word",
    };
}

/// The byte one finding rides as, in the note beside the outcome.
pub fn finding_byte(f: Finding) u8 {
    return switch (f) {
        .upholds => 'u',
        .overrules => 'o',
    };
}

/// Reads one finding back from the byte it rode as, or nothing at all.
///
/// A byte no third hand of this arc would ever have written reads null rather
/// than defaulting to either answer, since guessing here would put a verdict
/// in somebody's mouth.
pub fn finding_of_byte(byte: u8) ?Finding {
    return switch (byte) {
        'u' => .upholds,
        'o' => .overrules,
        else => null,
    };
}

/// Renders one finding as the four bytes a third hand leaves in their own box.
///
/// The case first, byte for byte as it was carried, and the verdict last. The
/// echo is what makes a finding answerable to a particular argument rather than
/// to whatever quarrel a plan happens to be holding when it reads.
pub fn finding_bytes(case: [max_referral_bytes]u8, f: Finding) [max_finding_bytes]u8 {
    var out: [max_finding_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_referral_bytes) : (at += 1) out[at] = case[at];
    // invariant: a finding always leaves its last byte for the verdict itself
    assert(at == max_finding_bytes - 1);
    out[at] = finding_byte(f);
    return out;
}

/// Answers whether a finding on the wire names the case this run carried out.
///
/// **The whole point of the rung, written as one comparison.** A desk that has
/// heard this argument before may still be holding the answer to an older case
/// -- an earlier settlement, a quieter standing, a younger quarrel -- and a plan
/// that published that answer beside today's outcome would put a third hand's
/// name on a word they never said about this work.
pub fn finding_answers(seen: ?[max_finding_bytes]u8, case: [max_referral_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, bytes[0..max_referral_bytes], &case);
}

/// Reads the verdict out of a finding, or nothing at all.
pub fn finding_in(seen: ?[max_finding_bytes]u8) ?Finding {
    const bytes = seen orelse return null;
    return finding_of_byte(bytes[max_finding_bytes - 1]);
}

/// How many carried cases this run reads an answer to.
///
/// A run under `.unread` reads none, however long the finding has been sitting
/// in the box -- which is exactly where the rung below leaves every case it
/// carries. A run under `.answered` reads the one case it sent.
pub fn answered_in(sent_count: u32, deem: Deem) u32 {
    // invariant: a run never carries out more cases than one desk may hold
    assert(sent_count <= 1);
    if (sent_count == 0) return 0;
    if (deem == .unread) return 0;
    return sent_count;
}

/// How many carried cases this run leaves waiting on a third hand's answer.
///
/// The other half of the same count, and the two close on the cases this run
/// carried out -- never both and never neither.
pub fn awaiting_in(sent_count: u32, deem: Deem) u32 {
    // invariant: a run never carries out more cases than one desk may hold
    assert(sent_count <= 1);
    return sent_count - answered_in(sent_count, deem);
}

/// Answers why a run may not read a finding, or that it may.
///
/// Every refusal this rung earns before a verdict reaches the place an operator
/// opens. `sent_count` is what this run actually carried out, `heard_count` is
/// how many answers it takes up, `waiting_count` is how many it leaves standing
/// unanswered, `spoken` says whether a finding is on the wire at all, and
/// `matched` says whether that finding names the case this run sent.
///
/// The order is the rung below's order one tier out. A reading asks whether a
/// case went anywhere before it asks for an answer, asks whether an answer
/// stands on the wire before it reads one, and asks whether that answer is about
/// this case before a byte of it reaches the outcome -- because a verdict filed
/// beside the wrong argument is worse than a verdict never read, wearing as it
/// does a third hand's name.
pub fn deem_refusal(sent_count: u32, heard_count: u32, waiting_count: u32, spoken: bool, matched: bool) ?RunError {
    // invariant: a run never reads more findings than one desk may answer
    assert(heard_count <= 1);
    if (heard_count >= 1 and sent_count == 0) return error.DeemUnreferred;
    if (heard_count >= 1 and !spoken) return error.DeemSilent;
    if (heard_count >= 1 and !matched) return error.DeemMismatched;
    // Every case carried out is answered or left waiting -- never both and
    // never neither. A count that does not close is a supervisor about to quote
    // a hearing its own wire cannot account for.
    if (heard_count + waiting_count != sent_count) return error.DeemMiscounted;
    return null;
}

/// Answers whether the finding an operator reads says what the third hand said.
///
/// The record half of this rung, and the reason the plan's own note is read back
/// before the report believes a word of it. This is the one byte of the whole
/// arc that speaks in somebody else's voice, so a published finding disagreeing
/// with the finding that came in would be the plan quoting a hand outside the
/// argument saying something it never said.
pub fn deem_holds(published: ?Finding, expected: Finding) bool {
    const seen = published orelse return false;
    return seen == expected;
}

/// Counts the cases carried out that nobody is ever heard back on.
///
/// The twenty-fifth of the family, and the one that finally closes the loop the
/// rung below opened. That rung carries an old argument to a hand that is
/// neither party -- and then the run goes on exactly as it always ran, because
/// nothing in the arc asks what that hand made of it. So a plan may refer the
/// same quarrel every run for a season and never once be told.
///
/// The count is deliberately narrow. It moves only for a case this run actually
/// carried out, since a run that referred nothing is owed no answer by anybody.
pub fn unanswered_referrals(sent_count: u32, deem: Deem) u32 {
    // invariant: a run never carries out more cases than one desk may hold
    assert(sent_count <= 1);
    if (sent_count == 0) return 0;
    return if (deem == .answered) 0 else 1;
}

// =========================================================================
// The avowing -- the plan says, on the record, what it makes of the finding
// against it
// =========================================================================

/// How many bytes one avowal carries.
///
/// Two: the finding it answers, echoed back exactly as it was published, and
/// one more saying what the plan makes of it. An avowal carrying the plan's word
/// alone would be a position with no finding attached to it, and a supervisor
/// could file the same two letters beside every verdict it ever received.
pub const max_avowal_bytes: u32 = 2;

/// Whether a plan is made to say anything at all about the finding it published.
///
/// `mute` is where the rung below leaves every finding: a hand outside the
/// argument answers, the answer is read and published where the outcome is read
/// -- and the plan owes it nothing whatever. So a supervisor may print `a hand
/// outside the argument finds for the reader who objected` beside `carried out
/// whole` every run for a season, and never once let that finding touch what it
/// does next. `accepts` and `dissents` are this rung: the plan's own word on the
/// finding, stated where the finding is read.
pub const Avow = enum { mute, concedes, dissents };

/// Renders one avowing as the words an operator reads.
pub fn avow_words(a: Avow) []const u8 {
    return switch (a) {
        .mute => "a finding is published, and the plan is never made to answer it",
        .concedes => "the plan takes the finding, and says the work is owed another look",
        .dissents => "the plan keeps its own word, and says so beside the finding",
    };
}

/// The byte one avowal rides as, or nothing at all for a plan that says nothing.
///
/// **A run writes this one, and that is the whole rung.** Every note the arc has
/// reached outward for -- the reply, the finding -- is written by a hand this
/// plan does not own, precisely so a supervisor cannot grade the objection
/// against it. An avowal is the opposite kind of record: it is the plan
/// answering *for itself*, in its own hand, which is exactly what it owes a
/// finding it has published. Saying so decides nothing; it only stops the
/// silence from being free.
pub fn stance_byte(a: Avow) ?u8 {
    return switch (a) {
        .mute => null,
        .concedes => 'a',
        .dissents => 'd',
    };
}

/// Reads one avowal back from the byte it rode as, or nothing at all.
///
/// A byte no run of this arc would ever have written reads null rather than
/// defaulting to either word, since guessing here would put a position in a
/// plan's mouth as surely as guessing a verdict would put one in a third hand's.
pub fn stance_of_byte(byte: u8) ?Avow {
    return switch (byte) {
        'a' => .concedes,
        'd' => .dissents,
        else => null,
    };
}

/// Renders one avowal as the two bytes a plan publishes beside the finding.
///
/// The finding first, byte for byte as it was published, and the plan's own word
/// last. The echo is what makes an avowal answerable to a particular finding
/// rather than to whatever verdict the plan happens to be holding when it reads.
pub fn avowal_bytes(finding: Finding, a: Avow) [max_avowal_bytes]u8 {
    // invariant: only a plan with something to say ever writes an avowal
    assert(a != .mute);
    const word = stance_byte(a) orelse unreachable;
    return .{ finding_byte(finding), word };
}

/// Answers whether an avowal on the wire names the finding this run read.
///
/// **The whole point of the rung, written as one comparison.** A plan that has
/// answered this argument before may still be holding its word on an older
/// finding -- a verdict for its own word, from a run before the third hand
/// changed their mind -- and publishing that beside today's finding would tell
/// an operator the plan had answered something it never answered.
pub fn avowal_answers(seen: ?[max_avowal_bytes]u8, finding: Finding) bool {
    const bytes = seen orelse return false;
    return bytes[0] == finding_byte(finding);
}

/// Reads the plan's own word out of an avowal, or nothing at all.
pub fn stance_in(seen: ?[max_avowal_bytes]u8) ?Avow {
    const bytes = seen orelse return null;
    return stance_of_byte(bytes[max_avowal_bytes - 1]);
}

/// How many read findings this run says a word about.
///
/// A run under `.mute` says none, however plainly the finding stands against it
/// -- which is exactly where the rung below leaves every answer it reads. A run
/// under either word says the one it read.
pub fn said_in(heard_count: u32, avow: Avow) u32 {
    // invariant: a run never reads more findings than one desk may answer
    assert(heard_count <= 1);
    if (heard_count == 0) return 0;
    if (avow == .mute) return 0;
    return heard_count;
}

/// How many read findings this run leaves without a word from the plan.
///
/// The other half of the same count, and the two close on the findings this run
/// actually read -- never both and never neither.
pub fn withheld_in(heard_count: u32, avow: Avow) u32 {
    // invariant: a run never reads more findings than one desk may answer
    assert(heard_count <= 1);
    return heard_count - said_in(heard_count, avow);
}

/// Answers why a run may not avow, or that it may.
///
/// Every refusal this rung earns before the plan's own word reaches the place an
/// operator opens. `heard_count` is what this run actually read, `said_count` is
/// how many findings it speaks to, `withheld_count` is how many it leaves
/// unanswered, `published` says whether a finding stands on the wire at all, and
/// `matched` says whether the avowal names the finding this run read.
///
/// The order is the rung below's order one tier out. An avowing asks whether a
/// finding was heard before it answers one, asks whether that finding stands
/// published before it answers it, and asks whether its own word is about that
/// finding before a byte of it reaches the outcome -- because a position filed
/// beside the wrong verdict is worse than a position never taken, wearing as it
/// does the look of an answer.
pub fn avow_refusal(heard_count: u32, said_count: u32, withheld_count: u32, published: bool, matched: bool) ?RunError {
    // invariant: a run never says a word about more findings than one it read
    assert(said_count <= 1);
    if (said_count >= 1 and heard_count == 0) return error.AvowUnheard;
    if (said_count >= 1 and !published) return error.AvowUnfound;
    if (said_count >= 1 and !matched) return error.AvowMismatched;
    // Every finding read is answered or left unanswered -- never both and never
    // neither. A count that does not close is a supervisor about to claim it
    // answered a verdict its own wire cannot account for.
    if (said_count + withheld_count != heard_count) return error.AvowMiscounted;
    return null;
}

/// Answers whether the avowal an operator reads says what this run said.
///
/// The record half of this rung, and the reason the plan's own note is read back
/// before the report believes a word of it. This is the one byte of the whole
/// outer arc a run writes in its own voice, so a published avowal disagreeing
/// with the word the run took would be the plan misquoting itself in the one
/// place it was finally asked to speak.
pub fn avow_holds(published: ?[max_avowal_bytes]u8, expected: [max_avowal_bytes]u8) bool {
    const seen = published orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Counts the findings a plan published and never said one word about.
///
/// The twenty-sixth of the family, and the one that finally asks the plan to owe
/// something to the answer it went looking for. The rung below reads what a hand
/// outside the argument made of the case and publishes it right where the
/// outcome is read -- and then the run goes on exactly as it always ran, because
/// nothing in the arc asks the plan to answer it. So a supervisor may quote a
/// finding against itself forever and let it touch nothing.
///
/// The count is deliberately narrow. It moves only for a finding this run
/// actually read, since a run that heard nothing from anybody is fairly asked to
/// answer nothing.
pub fn unavowed_findings(heard_count: u32, avow: Avow) u32 {
    // invariant: a run never reads more findings than one desk may answer
    assert(heard_count <= 1);
    if (heard_count == 0) return 0;
    return if (avow == .mute) 1 else 0;
}


// =========================================================================
// The owing -- a concession the plan made reaches the run after it, rather
// than ending with the breath that spoke it
// =========================================================================

/// How many bytes one debt carries.
///
/// Two: the finding the plan conceded, echoed back exactly as it was published,
/// and the settlement the plan was publishing while it conceded. A debt carrying
/// the finding alone would tell a later run what was admitted and never under
/// which outcome, which is the fact that makes a concession worth meeting -- a
/// plan that said `carried out whole` and conceded in the same breath owes a
/// different look than one that already reported itself short.
pub const max_debt_bytes: u32 = 2;

/// Whether a concession this run made outlives the run that made it.
///
/// `free` is where the rung below leaves every concession: the plan says `the
/// work is owed another look`, the run ends, and the next run of the same plan
/// opens owing nothing at all. So a supervisor may take every finding ever put
/// to it, say the work is owed another look every single time, and never once
/// carry that admission past the sentence that made it. `books` is this rung:
/// the concession is written down where a later run reads it, in the plan's own
/// notes, and it stays there until a run meets it.
pub const Owe = enum { free, books };

/// Renders one owing as the words an operator reads.
pub fn owe_words(o: Owe) []const u8 {
    return switch (o) {
        .free => "the plan concedes, and owes nothing when the run is over",
        .books => "the plan concedes, and the debt outlives the run that made it",
    };
}

/// Renders one debt as the two bytes a later run finds standing against the plan.
///
/// The conceded finding first, byte for byte as the plan answered it, and the
/// settlement it was published beside second. A debt is a record about one
/// admission under one outcome, and both halves are what make it answerable
/// later rather than merely alarming.
pub fn debt_bytes(finding: Finding, settlement: Settlement) [max_debt_bytes]u8 {
    return .{ finding_byte(finding), settlement_byte(settlement) };
}

/// Answers whether a debt on the wire names the finding this run conceded.
///
/// **The whole point of the rung, written as one comparison.** A plan that
/// conceded some earlier argument may still be carrying that older debt, and
/// leaving it standing beside today's concession would have a later run meeting
/// an admission this plan never made about the work in front of it.
pub fn debt_answers(seen: ?[max_debt_bytes]u8, finding: Finding) bool {
    const bytes = seen orelse return false;
    return bytes[0] == finding_byte(finding);
}

/// Reads the outcome a debt was taken under, or nothing at all.
///
/// A byte no run of this arc would ever have written reads null rather than
/// defaulting to any settlement, since guessing here would tell a later run the
/// plan had reported itself whole when the wire never said so.
pub fn debt_under(seen: ?[max_debt_bytes]u8) ?Settlement {
    const bytes = seen orelse return null;
    return settlement_of_byte(bytes[max_debt_bytes - 1]);
}

/// How many concessions this run books as a debt that outlives it.
///
/// A run under `.free` books none, however plainly it conceded -- which is
/// exactly where the rung below leaves every admission it makes. A run under
/// `.books` books the one it made.
pub fn booked_in(conceded_count: u32, owe: Owe) u32 {
    // invariant: a run never concedes more findings than one desk may answer
    assert(conceded_count <= 1);
    if (conceded_count == 0) return 0;
    if (owe == .free) return 0;
    return conceded_count;
}

/// How many concessions this run leaves owing nothing to any run after it.
///
/// The other half of the same count, and the two close on the concessions this
/// run actually made -- never both and never neither.
pub fn unowed_in(conceded_count: u32, owe: Owe) u32 {
    // invariant: a run never concedes more findings than one desk may answer
    assert(conceded_count <= 1);
    return conceded_count - booked_in(conceded_count, owe);
}

/// Answers why a run may not book a debt, or that it may.
///
/// Every refusal this rung earns before a concession reaches the run after it.
/// `conceded_count` is how many findings this run took, `booked_count` is how
/// many it writes down as a debt, `unowed_count` is how many it leaves owing
/// nothing, `said` says whether the plan published any word at all, `conceded`
/// says whether that word was a concession rather than a dissent, and `matched`
/// says whether the debt names the finding the plan actually conceded.
///
/// The order is the rung below's order one tier out. An owing asks whether the
/// plan spoke before it reads what was said, asks whether what was said was a
/// concession before it books one, and asks whether its own debt is about that
/// concession before a byte of it outlives the run -- because a debt filed
/// against the wrong admission is worse than a debt never taken, since a later
/// run will meet it as though the plan had made it today.
pub fn owe_refusal(conceded_count: u32, booked_count: u32, unowed_count: u32, said: bool, conceded: bool, matched: bool) ?RunError {
    // invariant: a run never books more debts than one concession earns
    assert(booked_count <= 1);
    if (booked_count >= 1 and !said) return error.OweUnsaid;
    if (booked_count >= 1 and !conceded) return error.OweUnconceded;
    if (booked_count >= 1 and !matched) return error.OweMismatched;
    // Every concession made is booked or left owing nothing -- never both and
    // never neither. A count that does not close is a supervisor about to claim
    // it carried an admission its own wire cannot account for.
    if (booked_count + unowed_count != conceded_count) return error.OweMiscounted;
    return null;
}

/// Answers whether the debt a later run will find says what this run booked.
///
/// The record half of this rung, and the reason the plan's own debt is read back
/// before the report believes a word of it. This note is the only thing in the
/// whole arc a concession leaves behind, so a published debt disagreeing with
/// the one the run took would hand the next run an admission this plan never
/// made -- the single failure this rung exists to rule out.
pub fn debt_holds(published: ?[max_debt_bytes]u8, expected: [max_debt_bytes]u8) bool {
    const seen = published orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Counts the concessions a plan made that reach no run after them.
///
/// The twenty-seventh of the family, and the one that finally makes a concession
/// cost the plan something past the sentence that made it. The rung below asks a
/// supervisor to say what it makes of the finding against it, and a plan may
/// answer `the plan takes the finding, and says the work is owed another look`
/// -- and then the run ends, and the run after it opens owing nothing at all. So
/// an admission is free exactly as the silence beneath it was free.
///
/// The count is deliberately narrow. It moves only for a concession this run
/// actually made, since a plan that kept its own word owes the work nothing and
/// a plan that said nothing has already been counted one rung down.
pub fn unbooked_concessions(conceded_count: u32, owe: Owe) u32 {
    // invariant: a run never concedes more findings than one desk may answer
    assert(conceded_count <= 1);
    if (conceded_count == 0) return 0;
    return if (owe == .free) 1 else 0;
}


// =========================================================================
// The meeting -- the run that inherits a debt is made to meet it, rather than
// opening on it every morning and settling as though it never made one
// =========================================================================

/// How many bytes one meeting carries.
///
/// Two, and they are the inherited debt echoed back exactly: the finding an
/// earlier run conceded, and the outcome it conceded that finding under. A
/// meeting carrying fewer would say some debt had been met and never which, and
/// a later reader could not tell an answered admission from an announced one.
pub const max_met_bytes: u32 = max_debt_bytes;

/// Whether a debt this run inherited is met before the run is over.
///
/// `defers` is where the rung below leaves every debt it books: the note stands,
/// the next run opens and reads past it, and the plan settles exactly as it
/// would have settled had it never conceded anything. So a supervisor may
/// accumulate admissions it never looks at, each one permanent and each one
/// free. `meets` is this rung: the inherited debt is taken up, said so where a
/// later run reads it, and taken down.
pub const Meet = enum { defers, meets };

/// Renders one meeting as the words an operator reads.
pub fn meet_words(m: Meet) []const u8 {
    return switch (m) {
        .defers => "the plan opens holding a debt, and closes still holding it",
        .meets => "the plan meets the debt it inherited, and takes it down",
    };
}

/// Renders one meeting as the two bytes a later run finds answered.
///
/// The inherited debt, unchanged. A meeting is a record *about* a debt rather
/// than a debt of its own, so it says nothing the debt did not already say --
/// which is what lets a later reader lay the two beside each other and see at a
/// glance that the admission answered is the admission that stood.
pub fn met_bytes(owed: [max_debt_bytes]u8) [max_met_bytes]u8 {
    return owed;
}

/// Answers whether a meeting on the wire names the debt this run inherited.
///
/// **The whole point of the rung, written as one comparison.** A plan may be
/// carrying an older meeting from a run before today, and leaving that standing
/// beside a fresh debt would tell a later run an admission had been answered
/// that nobody ever looked at -- which is worse than no meeting at all, since it
/// closes the question rather than leaving it open.
pub fn met_answers(seen: ?[max_met_bytes]u8, owed: [max_debt_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &owed);
}

/// Reads the finding an inherited debt was taken over, or nothing at all.
///
/// A byte no run of this arc would ever have written reads null rather than
/// defaulting to any finding, since guessing here would have a run meeting an
/// admission the wire never recorded.
pub fn met_over(seen: ?[max_met_bytes]u8) ?Finding {
    const bytes = seen orelse return null;
    return finding_of_byte(bytes[0]);
}

/// How many inherited debts this run meets.
///
/// A run under `.defers` meets none, however plainly one stood -- which is
/// exactly where the rung below leaves every debt it books. A run under `.meets`
/// meets the one it found.
pub fn met_in(inherited_count: u32, meet: Meet) u32 {
    // invariant: a run never inherits more debts than one plan may book
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    if (meet == .defers) return 0;
    return inherited_count;
}

/// How many inherited debts this run leaves standing for the run after it.
///
/// The other half of the same count, and the two close on the debts this run
/// actually inherited -- never both and never neither.
pub fn deferred_in(inherited_count: u32, meet: Meet) u32 {
    // invariant: a run never inherits more debts than one plan may book
    assert(inherited_count <= 1);
    return inherited_count - met_in(inherited_count, meet);
}

/// Answers why a run may not meet a debt, or that it may.
///
/// Every refusal this rung earns before an inherited admission is called
/// answered. `inherited_count` is how many debts this run opened holding,
/// `met_count` is how many it meets, `deferred_count` is how many it leaves
/// standing, `stood` says whether a debt was on the wire at all, `settled` says
/// whether this run has published an outcome of its own, and `matched` says
/// whether the meeting names the debt that actually stood.
///
/// The order is the rung below's order one tier out. A meeting asks whether
/// anything stood before it reads what stood, asks whether this run has earned a
/// word about it before it answers, and asks whether its own record is about
/// that debt before a byte of it is written -- because a meeting filed against
/// the wrong admission is worse than a meeting never made, since it closes a
/// question no run ever opened.
pub fn meet_refusal(inherited_count: u32, met_count: u32, deferred_count: u32, stood: bool, settled: bool, matched: bool) ?RunError {
    // invariant: a run never meets more debts than one plan may book
    assert(met_count <= 1);
    if (met_count >= 1 and !stood) return error.MeetUnowed;
    if (met_count >= 1 and !settled) return error.MeetUnsettled;
    if (met_count >= 1 and !matched) return error.MeetMismatched;
    // Every debt inherited is met or left deferred -- never both and never
    // neither. A count that does not close is a supervisor about to claim it
    // answered an admission its own wire cannot account for.
    if (met_count + deferred_count != inherited_count) return error.MeetMiscounted;
    return null;
}

/// Answers whether the meeting a later run will find says what this run met.
///
/// The record half of this rung, and the reason the meeting is read back before
/// the report believes a word of it. A published meeting disagreeing with the
/// one the run made would hand the next run a closed question the plan never
/// closed -- the single failure this rung exists to rule out.
pub fn met_holds(published: ?[max_met_bytes]u8, expected: [max_met_bytes]u8) bool {
    const seen = published orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Answers whether the debt this run met is finally down.
///
/// The other half of the same record, and the half a later run actually feels.
/// A meeting written beside a debt still standing would have every run after
/// this one inherit an admission already answered, and each of them answer it
/// again -- so the taking down is the act, and the note is only its receipt.
pub fn debt_settled(on_wire: ?[max_debt_bytes]u8) bool {
    return on_wire == null;
}

/// Counts the debts a plan inherited that the run never met.
///
/// The twenty-eighth of the family, and the one that finally makes a standing
/// admission ask something of the run that opens on it. The rung below writes a
/// concession down where a later run will find it -- and that run finds it,
/// reads past it, and settles `carried out whole`. So a debt is permanent and
/// ignorable at once, which is the most comfortable thing an admission can be.
///
/// The count is deliberately narrow. It moves only for a debt this run actually
/// inherited, since a plan that has conceded nothing owes no look to anybody,
/// and a concession made on this very run is already counted one rung down.
pub fn unmet_debts(inherited_count: u32, meet: Meet) u32 {
    // invariant: a run never inherits more debts than one plan may book
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    return if (meet == .defers) 1 else 0;
}


// =========================================================================
// The redress -- a meeting says what it found, rather than closing the
// question in silence and changing nothing at all
// =========================================================================

/// How many bytes one redress carries.
///
/// Three: the debt met, echoed back exactly as the receipt below carries it,
/// and one byte more for the upshot. A redress carrying fewer would say some
/// meeting had found something and never which admission it was looking at, and
/// a later reader could not tell a work put right from a work found sound.
pub const max_redress_bytes: u32 = max_met_bytes + 1;

/// What the look at an inherited admission came to.
///
/// Two honest answers, and both of them close the question. `.sound` is the plan
/// looking at what it conceded and finding the work stands as it is; `.righted`
/// is the plan looking and putting the work right. Neither is the failure this
/// rung names -- the failure is a meeting that comes to neither and says so
/// nowhere.
pub const Upshot = enum { sound, righted };

/// Renders one upshot as the words an operator reads.
pub fn upshot_words(u: Upshot) []const u8 {
    return switch (u) {
        .sound => "the plan looked at what it conceded, and found the work sound",
        .righted => "the plan looked at what it conceded, and put the work right",
    };
}

/// Renders one upshot as the byte a later run reads it back by.
pub fn upshot_byte(u: Upshot) u8 {
    return switch (u) {
        .sound => 's',
        .righted => 'r',
    };
}

/// Reads one upshot back out of the byte it was written as.
pub fn upshot_of_byte(byte: u8) ?Upshot {
    return switch (byte) {
        's' => .sound,
        'r' => .righted,
        else => null,
    };
}

/// Whether a debt this run met is answered with a word about what was found.
///
/// `hollow` is where the rung below leaves every debt it meets: the receipt is
/// filed, the admission comes off the wire, the question closes -- and nothing
/// anywhere says what the look came to. So a supervisor may take up every
/// admission it ever books, change not one thing about the work, and read as
/// perfectly answerable forever. `redresses` is this rung: the meeting names its
/// upshot, in the plan's own hand, where a later run reads it.
pub const Redress = enum { hollow, redresses };

/// Renders one redress as the words an operator reads.
pub fn redress_words(r: Redress) []const u8 {
    return switch (r) {
        .hollow => "the plan meets the debt it inherited, and never says what it found",
        .redresses => "the plan meets the debt it inherited, and says what the look came to",
    };
}

/// Renders one redress as the three bytes a later run reads.
///
/// The receipt's own two bytes, unchanged, and the upshot after them. The debt
/// leads because a redress is a word *about* an admission rather than an
/// admission of its own -- which is what lets a later reader lay the receipt and
/// the redress side by side and see at a glance that the meeting reported on is
/// the meeting that happened.
pub fn redress_bytes(met: [max_met_bytes]u8, upshot: Upshot) [max_redress_bytes]u8 {
    var out: [max_redress_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_met_bytes) : (at += 1) out[at] = met[at];
    // invariant: a redress always leaves its last byte for the upshot itself
    assert(at == max_redress_bytes - 1);
    out[at] = upshot_byte(upshot);
    return out;
}

/// Answers whether a redress on the wire speaks about the debt this run met.
///
/// **The whole point of the rung, written as one comparison.** A plan may be
/// carrying an older redress from a run before today, and leaving that standing
/// beside a fresh receipt would tell a later run what some other look found --
/// which is worse than no redress at all, since it answers a question this
/// meeting never answered.
pub fn redress_answers(seen: ?[max_redress_bytes]u8, met: [max_met_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, bytes[0..max_met_bytes], &met);
}

/// Reads what a redress on the wire came to, or nothing at all.
///
/// A byte no run of this arc would ever have written reads null rather than
/// defaulting to any upshot, since guessing here would have a later run believe
/// the work was put right on a word the wire never carried.
pub fn redress_upshot(seen: ?[max_redress_bytes]u8) ?Upshot {
    const bytes = seen orelse return null;
    return upshot_of_byte(bytes[max_redress_bytes - 1]);
}

/// Answers whether a run may claim this upshot of the work it actually did.
///
/// **The stronger claim bears the burden.** Saying the work was put right is a
/// claim about this run's own doing, and a run whose outcome reports itself
/// short has put nothing right this lap, however sincerely it looked. Saying the
/// work was found sound carries no such burden: a plan may honestly report the
/// work stands as it is whatever became of today's own phases, since soundness
/// is a word about the admission rather than about the lap. A run that has
/// published no outcome at all has earned neither word.
pub fn upshot_earned(upshot: Upshot, settled: ?Settlement) bool {
    if (upshot == .sound) return settled != null;
    return settled == .carried;
}

/// How many met debts this run answers with a word about what was found.
///
/// A run under `.hollow` answers none, however plainly it met one -- which is
/// exactly where the rung below leaves every debt it takes down. A run under
/// `.redresses` answers the one it met.
pub fn redressed_in(met_count: u32, redress: Redress) u32 {
    // invariant: a run never meets more debts than one plan may book
    assert(met_count <= 1);
    if (met_count == 0) return 0;
    if (redress == .hollow) return 0;
    return met_count;
}

/// How many met debts this run closes without a word about what was found.
///
/// The other half of the same count, and the two close on the debts this run
/// actually met -- never both and never neither.
pub fn closed_bare_in(met_count: u32, redress: Redress) u32 {
    // invariant: a run never meets more debts than one plan may book
    assert(met_count <= 1);
    return met_count - redressed_in(met_count, redress);
}

/// Answers why a run may not redress a debt it met, or that it may.
///
/// Every refusal this rung earns before a meeting is called answered.
/// `met_count` is how many debts this run met, `redressed_count` is how many it
/// speaks about, `bare_count` is how many it closes in silence, `receipted` says
/// whether a receipt for a meeting stands on the wire at all, `earned` says
/// whether this run may make the claim it is making, and `matched` says whether
/// the redress speaks about the meeting that actually happened.
///
/// The order is the rung below's order one tier out. A redress asks whether any
/// meeting happened before it reports on one, asks whether this run has earned
/// the word it is about to say, and asks whether its own record is about that
/// meeting before a byte of it is written -- because a finding filed against the
/// wrong meeting is worse than a finding never made, since it answers a question
/// this look never asked.
pub fn redress_refusal(met_count: u32, redressed_count: u32, bare_count: u32, receipted: bool, earned: bool, matched: bool) ?RunError {
    // invariant: a run never redresses more debts than it met
    assert(redressed_count <= 1);
    if (redressed_count >= 1 and !receipted) return error.RedressUnmet;
    if (redressed_count >= 1 and !earned) return error.RedressUnrighted;
    if (redressed_count >= 1 and !matched) return error.RedressMismatched;
    // Every debt met is redressed or left bare -- never both and never neither.
    // A count that does not close is a supervisor about to claim it said what a
    // look found when its own wire cannot account for the looking.
    if (redressed_count + bare_count != met_count) return error.RedressMiscounted;
    return null;
}

/// Answers whether the redress a later run will find says what this run found.
///
/// The record half of this rung, and the reason the redress is read back before
/// the report believes a word of it. A published redress disagreeing with the
/// one the run made would hand the next run a finding the plan never reached --
/// the single failure this rung exists to rule out.
pub fn redress_holds(published: ?[max_redress_bytes]u8, expected: [max_redress_bytes]u8) bool {
    const seen = published orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Counts the debts a plan met whose meeting never said what it found.
///
/// The twenty-ninth of the family, and the one that finally makes a meeting cost
/// the work something. The rung below ends the standing admission being
/// ignorable: the debt is taken up, receipted, and taken down. **And the receipt
/// says nothing whatever about what the look found.** So a plan may meet every
/// debt it ever books, change not one thing about the work, and read as
/// perfectly answerable forever -- the admission answered, the question closed,
/// and the ledger silent on whether anything was actually put right.
///
/// The count is deliberately narrow. It moves only for a debt this run actually
/// met, since a run that met nothing has no look to report on, and an admission
/// nobody looked at is already counted one rung down.
pub fn hollow_meetings(met_count: u32, redress: Redress) u32 {
    // invariant: a run never meets more debts than one plan may book
    assert(met_count <= 1);
    if (met_count == 0) return 0;
    return if (redress == .hollow) 1 else 0;
}

// =========================================================================
// The apprising -- what the reader who won an admission is finally told
// =========================================================================

/// How many bytes one delivered finding carries.
///
/// Three, and the same three: the finding standing on the plan's own wire,
/// unchanged. A delivery that carried a summary of itself would let the box and
/// the record drift apart, and the whole worth of the act is that they cannot.
pub const max_found_bytes: u32 = max_redress_bytes;

/// Whether a finding this run reached is carried to the reader who won it.
///
/// `withheld` is where the rung below leaves every finding it reaches: the
/// upshot is written down, the record is complete, the next run of the plan will
/// read it -- and the person whose objection began this whole arc hears nothing.
/// `apprises` is this rung: the same three bytes, carried to the box that reader
/// already knows.
pub const Apprise = enum { withheld, apprises };

/// Renders one apprising as the words an operator reads.
pub fn apprise_words(a: Apprise) []const u8 {
    return switch (a) {
        .withheld => "the plan says what its look found, and tells nobody who asked",
        .apprises => "the plan says what its look found, and carries it to the reader who won it",
    };
}

/// Renders the three bytes one delivery carries, from the finding it reports.
///
/// A copy rather than a summary, and deliberately so: the reader opens exactly
/// what the next run of the plan will open. Rendering it here rather than
/// handing the finding straight through gives the comparison below something
/// real to compare, so a delivery that ever stopped matching its finding would
/// be caught rather than assumed away.
pub fn found_bytes(finding: [max_redress_bytes]u8) [max_found_bytes]u8 {
    var out: [max_found_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_redress_bytes) : (at += 1) out[at] = finding[at];
    // invariant: a delivery carries the whole finding and nothing besides
    assert(at == max_found_bytes);
    return out;
}

/// Answers whether a finding in a reader's box is the finding this run reached.
///
/// **The whole point of the rung, written as one comparison.** A reader may
/// already be holding a delivery from a run before today, and leaving that
/// standing would tell them some other look's answer to some other admission --
/// which is worse than telling them nothing, since it answers an argument that
/// was never theirs.
pub fn found_answers(seen: ?[max_found_bytes]u8, finding: [max_found_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &finding);
}

/// How many findings this run reached are carried to the reader who won them.
///
/// A run under `.withheld` carries none, however plainly it reached one -- which
/// is exactly where the rung below leaves every finding it writes. A run under
/// `.apprises` carries the one it reached.
pub fn apprised_in(redressed_count: u32, apprise: Apprise) u32 {
    // invariant: a run never reaches more findings than one meeting earns
    assert(redressed_count <= 1);
    if (redressed_count == 0) return 0;
    if (apprise == .withheld) return 0;
    return redressed_count;
}

/// How many findings this run reached stay inside the plan's own notes.
///
/// The other half of the same count, and the two close on the findings this run
/// actually reached -- never both and never neither.
pub fn unsent_in(redressed_count: u32, apprise: Apprise) u32 {
    // invariant: a run never reaches more findings than one meeting earns
    assert(redressed_count <= 1);
    return redressed_count - apprised_in(redressed_count, apprise);
}

/// Answers why a run may not carry a finding to its reader, or that it may.
///
/// Every refusal this rung earns before a delivery is called made.
/// `redressed_count` is how many findings this run reached, `apprised_count` is
/// how many it carries out, `withheld_count` is how many it keeps, `found` says
/// whether a finding stands on the plan's own wire at all, `addressed` says
/// whether the plan ever wrote down where its reader is, and `matched` says
/// whether the delivery carries the finding that actually stands.
///
/// The order is the rung below's order one tier out. A delivery asks whether
/// there is a finding to carry before it carries one, asks whether there is a
/// person to carry it to, and asks whether what it carries is that finding
/// before a byte of it reaches a box -- because a raiser told the wrong answer
/// is worse than a raiser told nothing, since it closes a question they never
/// asked.
pub fn apprise_refusal(redressed_count: u32, apprised_count: u32, withheld_count: u32, found: bool, addressed: bool, matched: bool) ?RunError {
    // invariant: a run never carries out more findings than it reached
    assert(apprised_count <= 1);
    if (apprised_count >= 1 and !found) return error.AppriseUnfound;
    if (apprised_count >= 1 and !addressed) return error.AppriseUnaddressed;
    if (apprised_count >= 1 and !matched) return error.AppriseMismatched;
    // Every finding reached is carried or withheld -- never both and never
    // neither. A count that does not close is a supervisor about to claim it
    // told somebody when its own wire cannot account for the telling.
    if (apprised_count + withheld_count != redressed_count) return error.AppriseMiscounted;
    return null;
}

/// Answers whether the finding a reader will open says what this run found.
///
/// The record half of this rung, and the reason the box is read back before the
/// report believes anybody was told. A delivery disagreeing with the finding
/// this run reached would hand its reader an answer the plan never came to --
/// the single failure this rung exists to rule out.
pub fn apprise_holds(delivered: ?[max_found_bytes]u8, expected: [max_found_bytes]u8) bool {
    const seen = delivered orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Counts the findings a plan reached whose raiser was never told.
///
/// The thirtieth of the family, and the one that finally carries this arc's
/// answer back out to the person it began with. The rung below ends the meeting
/// being empty: the admission is taken up and the look says what it came to.
/// **And every byte of that finding is written where only the plan looks.** So a
/// reader may raise a quarrel, win an admission, and never once hear that the
/// admission was acted on -- the whole arc run to its end for somebody who is
/// told none of it.
///
/// The count is deliberately narrow. It moves only for a finding this run
/// actually reached, since a run that reported on nothing has nothing to carry,
/// and a meeting closed in silence is already counted one rung down.
pub fn unheard_findings(redressed_count: u32, apprise: Apprise) u32 {
    // invariant: a run never reaches more findings than one meeting earns
    assert(redressed_count <= 1);
    if (redressed_count == 0) return 0;
    return if (apprise == .withheld) 1 else 0;
}

// =========================================================================
// The weighing -- what the reader told an answer makes of it
// =========================================================================

/// How many bytes one reader's word about an answer carries.
///
/// Four: the three that were carried to them echoed back exactly, and one more
/// saying what they make of it. The echo is what lets a word name the answer it
/// weighs, so a verdict left over from an earlier look can never be read as
/// today's.
pub const max_suits_bytes: u32 = max_found_bytes + 1;

/// What a reader makes of the answer they were carried.
///
/// `settles` is that reader saying the answer closes the matter; `wanting` is
/// that reader saying it falls short. The plan may prefer neither, and this rung
/// asks for neither -- what it ends is nobody ever being asked.
pub const Worth = enum { settles, wanting };

/// Renders one reader's word as the sentence an operator reads.
pub fn worth_words(w: Worth) []const u8 {
    return switch (w) {
        .settles => "the reader who was told says the answer settles the matter",
        .wanting => "the reader who was told says the answer falls short",
    };
}

/// The byte one reader's word is carried by, on the wire.
pub fn worth_byte(w: Worth) u8 {
    return switch (w) {
        .settles => 's',
        .wanting => 'w',
    };
}

/// Reads one reader's word back off the wire, or answers that no word stands.
pub fn worth_of_byte(byte: u8) ?Worth {
    if (byte == 's') return .settles;
    if (byte == 'w') return .wanting;
    return null;
}

/// Whether a run reads what its reader made of the answer it carried.
///
/// `unasked` is where the rung below leaves every delivery it makes: the answer
/// lands in the reader's box, complete and correct, and the run ends without one
/// word about whether it settled anything. `asks` is this rung: the reader's own
/// verdict, read off the wire and published where the outcome is read.
pub const Suffice = enum { unasked, asks };

/// Renders one weighing as the words an operator reads.
pub fn suffice_words(s: Suffice) []const u8 {
    return switch (s) {
        .unasked => "the plan tells the reader who won the admission, and never asks what they make of it",
        .asks => "the plan tells the reader who won the admission, and reads what they make of it",
    };
}

/// Renders the four bytes one reader's word carries, from the answer it weighs.
///
/// Written by the reader rather than by any run -- this renders the shape their
/// hand fills, so a harness may stand in for a real correspondent and so the
/// comparison below has something exact to compare.
pub fn suits_bytes(carried: [max_found_bytes]u8, worth: Worth) [max_suits_bytes]u8 {
    var out: [max_suits_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_found_bytes) : (at += 1) out[at] = carried[at];
    // invariant: a word leaves exactly one byte for what its reader makes of it
    assert(at == max_suits_bytes - 1);
    out[at] = worth_byte(worth);
    return out;
}

/// Answers whether a word in a reader's box weighs the answer this run carried.
///
/// **The whole point of the rung, written as one comparison.** A reader may
/// still be holding their verdict on an earlier look at an earlier admission,
/// and reading that as today's word would credit this run with a satisfaction
/// nobody ever expressed about it.
pub fn suits_answers(seen: ?[max_suits_bytes]u8, carried: [max_found_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, bytes[0..max_found_bytes], &carried);
}

/// Reads what a reader made of the answer, out of the word they wrote.
pub fn suits_worth(seen: ?[max_suits_bytes]u8) ?Worth {
    const bytes = seen orelse return null;
    return worth_of_byte(bytes[max_suits_bytes - 1]);
}

/// How many answers this run carried are weighed by the reader who got them.
///
/// A run under `.unasked` weighs none, however plainly it carried one -- which
/// is exactly where the rung below leaves every delivery it makes. A run under
/// `.asks` weighs the one it carried.
pub fn weighed_in(apprised_count: u32, suffice: Suffice) u32 {
    // invariant: a run never carries more answers than one finding earns
    assert(apprised_count <= 1);
    if (apprised_count == 0) return 0;
    if (suffice == .unasked) return 0;
    return apprised_count;
}

/// How many answers this run carried go out with nobody asked about them.
///
/// The other half of the same count, and the two close on the answers this run
/// actually carried -- never both and never neither.
pub fn unasked_in(apprised_count: u32, suffice: Suffice) u32 {
    // invariant: a run never carries more answers than one finding earns
    assert(apprised_count <= 1);
    return apprised_count - weighed_in(apprised_count, suffice);
}

/// Answers why a run may not read what its reader makes of an answer, or that
/// it may.
///
/// Every refusal this rung earns before a weighing is called done.
/// `apprised_count` is how many answers this run carried, `weighed_count` is how
/// many it weighs, `unweighed_count` is how many it leaves unasked, `told` says
/// whether a delivery to that reader stands at all, `spoken` says whether their
/// box holds a word, and `matched` says whether that word weighs the answer this
/// run actually carried.
///
/// The order is the rung below's order one tier out. A weighing asks whether
/// anybody was told before it asks what they thought, asks whether they have
/// said anything at all, and asks whether what they said is about this answer
/// before a byte of it is published -- because a plan crediting itself with a
/// satisfaction expressed about some other look has graded its own answer, which
/// is the one thing this whole arc exists to prevent.
pub fn suffice_refusal(apprised_count: u32, weighed_count: u32, unweighed_count: u32, told: bool, spoken: bool, matched: bool) ?RunError {
    // invariant: a run never weighs more answers than it carried
    assert(weighed_count <= 1);
    if (weighed_count >= 1 and !told) return error.SufficeUntold;
    if (weighed_count >= 1 and !spoken) return error.SufficeSilent;
    if (weighed_count >= 1 and !matched) return error.SufficeMismatched;
    // Every answer carried is weighed or left unweighed -- never both and never
    // neither. A count that does not close is a supervisor about to report what
    // its reader thought when its own wire cannot account for the asking.
    if (weighed_count + unweighed_count != apprised_count) return error.SufficeMiscounted;
    return null;
}

/// Answers whether the word an operator will read says what the reader said.
///
/// The record half of this rung, and the reason the note is read back before the
/// report believes anybody was asked. A published word disagreeing with the
/// reader's own would put a satisfaction in their mouth -- the single failure
/// this rung exists to rule out.
pub fn suffice_holds(published: ?Worth, expected: Worth) bool {
    const seen = published orelse return false;
    return seen == expected;
}

/// Counts the answers a plan carried whose worth it never learned.
///
/// The thirty-first of the family, and the one that finally lets the person this
/// arc was for say whether any of it helped. The rung below ends the finding
/// being private: the answer a plan reached is carried to the reader who won it,
/// byte for byte, into the box they already know. **And then the arc asks that
/// reader nothing.** So a plan may put work right, tell the person who asked for
/// it, and never once learn whether that answer settled the thing or left them
/// exactly as unhappy as before.
///
/// The count is deliberately narrow. It moves only for an answer this run
/// actually carried, since a run that told nobody has asked nobody, and a
/// finding kept inside the plan's own notes is already counted one rung down.
pub fn unmeasured_answers(apprised_count: u32, suffice: Suffice) u32 {
    // invariant: a run never carries more answers than one finding earns
    assert(apprised_count <= 1);
    if (apprised_count == 0) return 0;
    return if (suffice == .unasked) 1 else 0;
}

// =========================================================================
// The taking up -- what a plan owes a reader who says the answer falls short
// =========================================================================

/// How many bytes the note of a reopened matter carries.
///
/// Four: the reader's own word echoed back exactly, whole. A matter is reopened
/// by a particular verdict about a particular answer, so the note carries that
/// verdict rather than a summary of it -- the same discipline every carrying
/// rung of this arc keeps.
pub const max_again_bytes: u32 = max_suits_bytes;

/// Whether a run takes a matter up again when its reader says it falls short.
///
/// `closes` is where the rung below leaves every `wanting` word it reads: the
/// plan learns its answer settled nothing, publishes that fact honestly, and
/// goes on exactly as it always ran. `takes_up` is this rung -- the matter
/// booked open again, in a note addressed to the run that has not started yet.
pub const Reopen = enum { closes, takes_up };

/// Renders one taking up as the words an operator reads.
pub fn reopen_words(r: Reopen) []const u8 {
    return switch (r) {
        .closes => "the plan reads that its answer falls short, and takes nothing up again",
        .takes_up => "the plan reads that its answer falls short, and takes the matter up again",
    };
}

/// Renders the four bytes a reopening note carries, from the word it reopens.
///
/// The reader's own verdict, byte for byte. A note carrying anything else would
/// tell the next run that some other answer is still owed a look, which is the
/// one thing this rung must never do.
pub fn again_bytes(word: [max_suits_bytes]u8) [max_again_bytes]u8 {
    var out: [max_again_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_suits_bytes) : (at += 1) out[at] = word[at];
    // invariant: a reopening note is written exactly as long as the word it
    // carries
    assert(at == max_again_bytes);
    return out;
}

/// Answers whether a standing note reopens the word this run actually read.
///
/// **The whole point of the rung, written as one comparison.** A note left over
/// from an earlier lap may be reopening an older answer entirely, and taking
/// that as today's reopening would tell an operator this run acted on a verdict
/// it never read.
pub fn again_carries(seen: ?[max_again_bytes]u8, word: [max_suits_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &word);
}

/// How many words calling an answer short this run takes up again.
///
/// A run under `.closes` takes up none, however plainly its reader said the
/// answer falls short -- which is exactly where the rung below leaves every such
/// word. A run under `.takes_up` takes up the one it read.
///
/// **A reader who says the answer settles the matter leaves nothing to take
/// up.** The count holds at zero there under either reading, because booking a
/// matter open against a satisfied reader would punish a plan for asking and
/// teach every supervisor never to ask at all.
pub fn taken_up_in(short_count: u32, reopen: Reopen) u32 {
    // invariant: a run never reads more words than one answer earns
    assert(short_count <= 1);
    if (short_count == 0) return 0;
    if (reopen == .closes) return 0;
    return short_count;
}

/// How many words calling an answer short go out having opened nothing.
///
/// The other half of the same count, and the two close on the short words this
/// run actually read -- never both and never neither.
pub fn left_closed_in(short_count: u32, reopen: Reopen) u32 {
    // invariant: a run never reads more words than one answer earns
    assert(short_count <= 1);
    return short_count - taken_up_in(short_count, reopen);
}

/// Answers why a run may not take a matter up again, or that it may.
///
/// Every refusal this rung earns before a reopening is called done.
/// `short_count` is how many words calling the answer short this run read,
/// `taken_count` is how many it takes up, `closed_count` is how many it leaves
/// closed, `weighed` says whether a word was read at all, `wanting` says whether
/// that word calls the answer short, and `matched` says whether the note that
/// landed carries the word this run actually read.
///
/// The order is the rung below's order one tier out. A reopening asks whether
/// anybody was asked before it asks what they said, asks whether what they said
/// calls the answer short before it books anything, and asks whether the note
/// names that very word before a byte of it is believed.
pub fn reopen_refusal(short_count: u32, taken_count: u32, closed_count: u32, weighed: bool, wanting: bool, matched: bool) ?RunError {
    // invariant: a run never takes up more matters than one word earns
    assert(taken_count <= 1);
    if (taken_count >= 1 and !weighed) return error.ReopenUnweighed;
    if (taken_count >= 1 and !wanting) return error.ReopenSettled;
    if (taken_count >= 1 and !matched) return error.ReopenMismatched;
    // Every short word read is taken up or left closed -- never both and never
    // neither. A count that does not close is a supervisor about to report a
    // matter reopened when its own wire cannot account for the booking.
    if (taken_count + closed_count != short_count) return error.ReopenMiscounted;
    return null;
}

/// Answers whether the note a later run will find reopens the word this run
/// read.
///
/// The record half of this rung, and the reason the note is read back before the
/// report believes anything was taken up. A note standing for some other verdict
/// would hand the next run a matter nobody ever called short.
pub fn reopen_holds(booked: ?[max_again_bytes]u8, expected: [max_suits_bytes]u8) bool {
    return again_carries(booked, expected);
}

/// Counts the words a reader wrote calling an answer short that opened nothing.
///
/// The thirty-second of the family, and the first in the whole arc where a hand
/// outside the plan may open a matter the plan itself had closed. Every rung
/// below reaches outward to be **told** something; this one lets what it is told
/// cost the plan a look it did not choose to take.
///
/// The count is deliberately narrow. It moves only for a word this run actually
/// read that actually calls the answer short, since a reader who was never asked
/// has said nothing, and a reader who says the answer settles the matter has
/// asked for nothing.
pub fn unheeded_words(short_count: u32, reopen: Reopen) u32 {
    // invariant: a run never reads more words than one answer earns
    assert(short_count <= 1);
    if (short_count == 0) return 0;
    return if (reopen == .closes) 1 else 0;
}

// =========================================================================
// The second look -- what a run owes a matter its reader reopened
// =========================================================================

/// How many bytes the receipt of a second look carries.
///
/// Four: the reopened matter, unchanged. A second look is a record *about* a
/// reopening rather than a reopening of its own, so it says nothing the note did
/// not already say -- which is what lets a later reader lay the two beside each
/// other and see at a glance that the matter answered is the matter that stood.
pub const max_anew_bytes: u32 = max_again_bytes;

/// Whether a matter this run inherited as reopened is looked at again.
///
/// `passes` is where the rung below leaves every matter it books: the note
/// stands, the next run opens and reads past it, and the plan settles exactly as
/// it would have settled had its reader never called the answer short. So a
/// supervisor may accumulate reopenings it never looks at, each one permanent
/// and each one free. `looks` is this rung: the inherited matter is taken up a
/// second time, said so where a later run reads it, and taken down.
pub const Reweigh = enum { passes, looks };

/// Renders one second look as the words an operator reads.
pub fn reweigh_words(r: Reweigh) []const u8 {
    return switch (r) {
        .passes => "the plan opens holding a reopened matter, and closes still holding it",
        .looks => "the plan looks again at the matter its reader reopened, and takes it down",
    };
}

/// Renders the four bytes a second look's receipt carries, from the matter it
/// answers.
pub fn anew_bytes(opened: [max_again_bytes]u8) [max_anew_bytes]u8 {
    return opened;
}

/// Answers whether a receipt on the wire names the matter this run inherited.
///
/// **The whole point of the rung, written as one comparison.** A plan may be
/// carrying an older second look from a run before today, and leaving that
/// standing beside a freshly reopened matter would tell a later run a question
/// had been looked at again which nobody ever reopened -- worse than no receipt
/// at all, since it closes the matter rather than leaving it open.
pub fn anew_answers(seen: ?[max_anew_bytes]u8, opened: [max_again_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &opened);
}

/// How many inherited reopenings this run looks at again.
///
/// A run under `.passes` looks at none, however plainly one stood -- which is
/// exactly where the rung below leaves every matter it books. A run under
/// `.looks` looks at the one it found.
pub fn looked_in(inherited_count: u32, reweigh: Reweigh) u32 {
    // invariant: a run never inherits more matters than one reader may reopen
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    if (reweigh == .passes) return 0;
    return inherited_count;
}

/// How many inherited reopenings this run leaves standing for the run after it.
///
/// The other half of the same count, and the two close on the matters this run
/// actually inherited -- never both and never neither.
pub fn passed_in(inherited_count: u32, reweigh: Reweigh) u32 {
    // invariant: a run never inherits more matters than one reader may reopen
    assert(inherited_count <= 1);
    return inherited_count - looked_in(inherited_count, reweigh);
}

/// Answers why a run may not look at a reopened matter again, or that it may.
///
/// Every refusal this rung earns before a second look is called made.
/// `inherited_count` is how many reopened matters this run opened holding,
/// `looked_count` is how many it looks at again, `passed_count` is how many it
/// leaves standing, `stood` says whether a matter was on the wire at all,
/// `settled` says whether this run has published an outcome of its own, and
/// `matched` says whether the receipt names the matter that actually stood.
///
/// The order is the rung below's order one tier out. A second look asks whether
/// anything stood before it reads what stood, asks whether this run has finished
/// its own look before it makes another, and asks whether its own receipt is
/// about that matter before a byte of it is written.
pub fn reweigh_refusal(inherited_count: u32, looked_count: u32, passed_count: u32, stood: bool, settled: bool, matched: bool) ?RunError {
    // invariant: a run never looks again at more matters than one reader reopened
    assert(looked_count <= 1);
    if (looked_count >= 1 and !stood) return error.ReweighUnopened;
    if (looked_count >= 1 and !settled) return error.ReweighUnsettled;
    if (looked_count >= 1 and !matched) return error.ReweighMismatched;
    // Every matter inherited is looked at again or passed over -- never both and
    // never neither. A count that does not close is a supervisor about to claim
    // it re-answered a question its own wire cannot account for.
    if (looked_count + passed_count != inherited_count) return error.ReweighMiscounted;
    return null;
}

/// Answers whether the receipt a later run will find says what this run looked
/// at again.
///
/// The record half of this rung, and the reason the receipt is read back before
/// the report believes a word of it.
pub fn reweigh_holds(published: ?[max_anew_bytes]u8, expected: [max_anew_bytes]u8) bool {
    const seen = published orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Answers whether the matter this run looked at again is finally down.
///
/// The other half of the same record, and the half a later run actually feels. A
/// receipt written beside a matter still standing open would have every run after
/// this one inherit a reopening already answered, and each of them answer it
/// again -- so the taking down is the act, and the receipt is only its record.
pub fn matter_closed(on_wire: ?[max_again_bytes]u8) bool {
    return on_wire == null;
}

/// Counts the reopened matters a plan inherited that the run never looked at
/// again.
///
/// The thirty-third of the family, and the one that makes a reader's own
/// reopening finally ask something of the run that opens on it. The rung below
/// writes a matter open where a later run will find it -- and that run finds it,
/// reads past it, and settles `carried out whole`. So a reopening is permanent
/// and ignorable at once, which is the most comfortable thing an open question
/// can be.
///
/// The count is deliberately narrow. It moves only for a matter this run
/// actually inherited, since a plan nobody reopened owes no second look to
/// anybody, and a reopening booked on this very run is already counted one rung
/// down.
pub fn unlooked_matters(inherited_count: u32, reweigh: Reweigh) u32 {
    // invariant: a run never inherits more matters than one reader may reopen
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    return if (reweigh == .passes) 1 else 0;
}

// =========================================================================
// The telling -- what a second look owes the reader who asked for it
// =========================================================================

/// How many bytes one telling carries.
///
/// Four: the matter the second look answered, unchanged. A telling is a copy of
/// the receipt rather than a second judgment, so it says nothing the receipt did
/// not already say -- which is what lets a reader lay it beside the word they
/// wrote and see at a glance that the matter answered is the matter they
/// reopened.
pub const max_knows_bytes: u32 = max_anew_bytes;

/// Whether the reader who reopened a matter is told what the second look found.
///
/// `withholds` is where the rung below leaves every second look it makes: the
/// receipt lands among the plan's own notes, where only a later run of this plan
/// ever opens it, and the reader who asked for the look holds a box exactly as
/// empty as before. `tells` is this rung: the same four bytes carried out to
/// that reader's own box, where the person who asked actually reads.
pub const Recount = enum { withholds, tells };

/// Renders one telling as the words an operator reads.
pub fn recount_words(r: Recount) []const u8 {
    return switch (r) {
        .withholds => "the plan looks again at the matter, and leaves its reader to come find out",
        .tells => "the plan looks again at the matter, and carries what it found to the reader who asked",
    };
}

/// Renders the four bytes one telling carries, from the receipt it copies.
pub fn knows_bytes(receipt: [max_anew_bytes]u8) [max_knows_bytes]u8 {
    return receipt;
}

/// Answers whether a telling in a reader's box names the matter this run looked
/// at again.
///
/// **The whole point of the rung, written as one comparison.** A reader may
/// already hold a telling from a run before today, and leaving that standing
/// beside a fresh second look would tell them their newest reopening had been
/// answered by an older run's work -- worse than an empty box, since a box that
/// says nothing at least says nothing false.
pub fn knows_answers(seen: ?[max_knows_bytes]u8, receipt: [max_anew_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &receipt);
}

/// How many second looks this run tells their reader about.
///
/// A run under `.withholds` tells none, however plainly it looked -- which is
/// exactly where the rung below leaves every second look it makes. A run under
/// `.tells` tells the one it made.
pub fn recounted_in(looked_count: u32, recount: Recount) u32 {
    // invariant: a run never makes more second looks than one reader reopened
    assert(looked_count <= 1);
    if (looked_count == 0) return 0;
    if (recount == .withholds) return 0;
    return looked_count;
}

/// How many second looks this run keeps inside its own notes.
///
/// The other half of the same count, and the two close on the second looks this
/// run actually made -- never both and never neither.
pub fn unsent_looks_in(looked_count: u32, recount: Recount) u32 {
    // invariant: a run never makes more second looks than one reader reopened
    assert(looked_count <= 1);
    return looked_count - recounted_in(looked_count, recount);
}

/// Answers why a run may not tell its reader what the second look came to, or
/// that it may.
///
/// Every refusal this rung earns before a telling is called made.
/// `looked_count` is how many second looks this run made, `told_count` is how
/// many it carries out, `kept_count` is how many it keeps, `looked` says whether
/// a receipt of this run's own stands on the wire at all, `addressed` says
/// whether there is a reader to carry it to, and `matched` says whether the
/// telling names the matter that receipt answered.
///
/// The order is the rung below's order one tier out. A telling asks whether
/// anything was looked at before it reads what was found, asks whether anybody
/// is waiting before it sets out, and asks whether what it carries is about
/// today's matter before a byte of it leaves the plan.
pub fn recount_refusal(looked_count: u32, told_count: u32, kept_count: u32, looked: bool, addressed: bool, matched: bool) ?RunError {
    // invariant: a run never tells of more second looks than it made
    assert(told_count <= 1);
    if (told_count >= 1 and !looked) return error.RecountUnlooked;
    if (told_count >= 1 and !addressed) return error.RecountUnaddressed;
    if (told_count >= 1 and !matched) return error.RecountMismatched;
    // Every second look made is told or kept -- never both and never neither. A
    // count that does not close is a supervisor about to report a reader told
    // whom its own wire cannot account for.
    if (told_count + kept_count != looked_count) return error.RecountMiscounted;
    return null;
}

/// Answers whether the telling in a reader's own box says what this run looked
/// at again.
///
/// The record half of this rung, and the reason the box is opened again before
/// the report believes anybody was told. A telling disagreeing with the receipt
/// it copies is a letter about some other question entirely.
pub fn recount_holds(carried: ?[max_knows_bytes]u8, expected: [max_knows_bytes]u8) bool {
    const seen = carried orelse return false;
    return std.mem.eql(u8, &seen, &expected);
}

/// Counts the second looks a run made whose reader was never told of them.
///
/// The thirty-fourth of the family, and the one that carries the second look out
/// to the person who asked for it. The rung below takes the matter up again,
/// receipts it, and takes it down -- all inside the plan's own notes, where only
/// a later run of this plan ever looks. So the reader who said the answer fell
/// short gets exactly what they got before they said it: nothing.
///
/// The count is deliberately narrow. It moves only for a second look this run
/// actually made, since a run that looked at nothing owes nobody an account of
/// it, and a matter merely standing open is already counted one rung down.
pub fn untold_looks(looked_count: u32, recount: Recount) u32 {
    // invariant: a run never makes more second looks than one reader reopened
    assert(looked_count <= 1);
    if (looked_count == 0) return 0;
    return if (recount == .withholds) 1 else 0;
}

// =========================================================================
// The reply -- what a reader makes of the second look they were told about
// =========================================================================

/// How many bytes the word one reader keeps about a telling carries.
///
/// Five: the telling they were carried, echoed back whole, and one byte for
/// what they make of it. A word carrying only the verdict would be an opinion
/// with no question attached to it, and a plan reading it could not tell which
/// second look it was about.
pub const max_rests_bytes: u32 = max_knows_bytes + 1;

/// What a reader says a second look did to the matter they reopened.
///
/// The two honest answers, and no third. A matter either comes to rest on what
/// the second look found, or it stands exactly where it stood -- and a reader
/// who says nothing at all is a silence rather than a word, which this rung
/// reports as a silence.
pub const Rest = enum { allays, stands };

/// Renders one reader's word as the words an operator reads.
pub fn rest_words(r: Rest) []const u8 {
    return switch (r) {
        .allays => "the reader who was told says the second look puts the matter to rest",
        .stands => "the reader who was told says the matter stands exactly where it stood",
    };
}

/// The one byte a reader's word rides as, so their note is a single glyph
/// beside the telling it answers.
pub fn rest_byte(r: Rest) u8 {
    return switch (r) {
        .allays => 'a',
        .stands => 's',
    };
}

/// Reads one reader's word back from the byte it rode as, or nothing at all.
///
/// A byte this rung does not know is nothing rather than a guess, since reading
/// an unknown glyph as either answer would put a word in a reader's mouth.
pub fn rest_of_byte(byte: u8) ?Rest {
    return switch (byte) {
        'a' => .allays,
        's' => .stands,
        else => null,
    };
}

/// Renders the five bytes a reader's own word carries.
///
/// The telling first, byte for byte as they were carried it, and the word last.
/// A reader answering this way names the question and the answer in one note,
/// so no run has to remember which second look a lone glyph belonged to.
pub fn rests_bytes(told: [max_knows_bytes]u8, rest: Rest) [max_rests_bytes]u8 {
    var bytes: [max_rests_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_knows_bytes) : (at += 1) bytes[at] = told[at];
    // invariant: a reader's word always leaves its last byte for the word itself
    assert(at == max_rests_bytes - 1);
    bytes[at] = rest_byte(rest);
    return bytes;
}

/// Reads the word out of a reader's own note, or nothing at all.
pub fn rests_rest(seen: ?[max_rests_bytes]u8) ?Rest {
    const bytes = seen orelse return null;
    return rest_of_byte(bytes[max_rests_bytes - 1]);
}

/// Answers whether a reader's standing word is about the telling this run made.
///
/// The whole point of the rung, written as one comparison. A reader may still
/// hold a reply to a telling from a run before today, and reading that as
/// today's reply would publish a verdict about a second look nobody made this
/// morning.
pub fn rests_answers(seen: ?[max_rests_bytes]u8, told: [max_knows_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, bytes[0..max_knows_bytes], &told);
}

/// Whether a run reads the word its reader keeps about the telling it made.
///
/// The rung below carries a second look home and stops there. A plan that
/// never opens the reply settles `carried out whole` while the matter it
/// reopened may be standing open still, and nobody reading the outcome can
/// tell the difference.
pub const Allay = enum { unread, reads };

/// Renders one reading as the words an operator reads.
pub fn allay_words(a: Allay) []const u8 {
    return switch (a) {
        .unread => "the plan tells the reader what the second look found, and never reads their reply",
        .reads => "the plan tells the reader what the second look found, and reads what they make of it",
    };
}

/// How many tellings this run reads its reader's own word on.
///
/// Narrow on purpose: a reading is about a telling this run actually made, so a
/// plan that told nobody anything reads nothing, however willing it was.
pub fn read_back_in(told_count: u32, allay: Allay) u32 {
    // invariant: a run never makes more tellings than one second look earns
    assert(told_count <= 1);
    if (told_count == 0) return 0;
    if (allay == .unread) return 0;
    return told_count;
}

/// How many tellings this run leaves with nobody's reply read.
pub fn unread_in(told_count: u32, allay: Allay) u32 {
    // invariant: a run never makes more tellings than one second look earns
    assert(told_count <= 1);
    return told_count - read_back_in(told_count, allay);
}

/// Every refusal this rung earns before a reader's word reaches the outcome.
///
/// The order is the rung below's order one tier out. A reading asks whether
/// there was a telling to reply to, whether the reader has said anything at
/// all, and whether what they said is about this telling -- because a word
/// published beside the wrong second look is worse than a word never read,
/// wearing as it does the authority of a reply.
pub fn allay_refusal(told_count: u32, replies_read: u32, unread_count: u32, told: bool, spoken: bool, matched: bool) ?RunError {
    // invariant: a run never reads more replies than one telling earns
    assert(replies_read <= 1);
    if (replies_read >= 1 and !told) return error.AllayUntold;
    if (replies_read >= 1 and !spoken) return error.AllaySilent;
    if (replies_read >= 1 and !matched) return error.AllayMismatched;
    // invariant: a reading never counts more replies than there were tellings
    assert(replies_read + unread_count <= told_count + 1);
    if (replies_read + unread_count != told_count) return error.AllayMiscounted;
    return null;
}

/// Answers whether the word this plan published is the word its reader wrote.
///
/// The record half of this rung, and the reason the plan's own notes are read
/// again before the report believes anything was published. A published word
/// disagreeing with the reader's own is a plan grading its own second look.
pub fn allay_holds(published: ?Rest, expected: Rest) bool {
    const seen = published orelse return false;
    return seen == expected;
}

/// Counts the tellings a run made whose reader's word was never read back.
///
/// The thirty-fifth of the family, and the one that closes the correspondence.
/// The rung below carries the second look out to the reader who asked for it;
/// this one opens the reply that reader already wrote. A matter reopened once
/// may be reopened again, and a plan that never reads the answer cannot tell a
/// question finally put to rest from one still standing.
pub fn unheard_replies(told_count: u32, allay: Allay) u32 {
    // invariant: a run never makes more tellings than one second look earns
    assert(told_count <= 1);
    if (told_count == 0) return 0;
    return if (allay == .unread) 1 else 0;
}

// =========================================================================
// The forbearance -- what a run hands on when its reader says the matter stands
// =========================================================================

/// How many bytes one forbearance carries.
///
/// Five: the telling its reader refused, echoed whole, and the one byte of the
/// word they refused it with. A forbearance carrying only "still standing"
/// would be an impasse with no matter attached to it, and the run inheriting it
/// could not tell which question it was being spared.
pub const max_holds_bytes: u32 = max_rests_bytes;

/// Whether a run hands on the matter its reader left standing.
///
/// The rung below reads the reader's word and publishes it beside the
/// settlement. A run that stops there lets a twice-refused matter die with it,
/// so the next run opens the same question from nothing -- reopening a matter
/// already reopened, looking again at a look already taken, and carrying home
/// an answer this reader has already called insufficient.
pub const Forbear = enum { opens, forbears };

/// Renders one forbearance as the words an operator reads.
pub fn forbear_words(f: Forbear) []const u8 {
    return switch (f) {
        .opens => "the plan reads that the matter still stands, and hands the impasse to nobody",
        .forbears => "the plan reads that the matter still stands, and hands the impasse to the run after it",
    };
}

/// Renders the five bytes one forbearance carries.
///
/// The reader's own reply, copied whole. A forbearance is the plan declining to
/// re-ask a question rather than the plan making a new statement, so the bytes
/// it hands on are the bytes it was answered with -- copied, never composed.
pub fn holds_bytes(reply: [max_rests_bytes]u8) [max_holds_bytes]u8 {
    var out: [max_holds_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_rests_bytes) : (at += 1) out[at] = reply[at];
    // invariant: a forbearance carries the whole reply it holds back on
    assert(at == max_holds_bytes);
    return out;
}

/// Answers whether a standing forbearance is about the matter this run read.
///
/// The whole point of the rung, written as one comparison. A run may still find
/// a forbearance left by a run before today, and handing that on as this run's
/// would spare the next run a question nobody refused this morning.
pub fn holds_carries(seen: ?[max_holds_bytes]u8, reply: [max_rests_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &holds_bytes(reply));
}

/// Reads the word out of a standing forbearance, or nothing at all.
pub fn holds_rest(seen: ?[max_holds_bytes]u8) ?Rest {
    const bytes = seen orelse return null;
    return rest_of_byte(bytes[max_holds_bytes - 1]);
}

/// How many standing matters this run hands to the run that comes after it.
///
/// Narrow on purpose: a forbearance is about a word this run actually read, so
/// a plan that opened no reply hands on nothing, however willing it was.
pub fn forborne_in(standing_count: u32, forbear: Forbear) u32 {
    // invariant: a run never reads more standing words than one reply carries
    assert(standing_count <= 1);
    if (standing_count == 0) return 0;
    if (forbear == .opens) return 0;
    return standing_count;
}

/// How many standing matters this run leaves for the next run to open afresh.
pub fn opened_in(standing_count: u32, forbear: Forbear) u32 {
    // invariant: a run never reads more standing words than one reply carries
    assert(standing_count <= 1);
    return standing_count - forborne_in(standing_count, forbear);
}

/// Every refusal this rung earns before a forbearance reaches the next run.
///
/// The order is the rung below's order one tier out. A forbearance asks whether
/// there was a reply to hold back on, whether that reply actually leaves the
/// matter standing, and whether the note handed on names it -- because an
/// impasse handed on about the wrong matter is worse than one never handed on
/// at all, wearing as it does the authority of an inheritance.
pub fn forbear_refusal(standing_count: u32, forborne_count: u32, opened_count: u32, opened: bool, stands: bool, matched: bool) ?RunError {
    // invariant: a run never hands on more matters than one reply leaves standing
    assert(forborne_count <= 1);
    if (forborne_count >= 1 and !opened) return error.ForbearUnread;
    if (forborne_count >= 1 and !stands) return error.ForbearAllayed;
    if (forborne_count >= 1 and !matched) return error.ForbearMismatched;
    // invariant: a forbearing never counts more matters than there were words
    assert(forborne_count + opened_count <= standing_count + 1);
    if (forborne_count + opened_count != standing_count) return error.ForbearMiscounted;
    return null;
}

/// Answers whether the forbearance now standing is the one this run wrote.
///
/// The record half of this rung, and the reason the inherited note is read
/// again before the report believes anything was handed on. A note disagreeing
/// with the reply this run read is a plan sparing the next run a question it
/// never actually asked.
pub fn forbear_holds(booked: ?[max_holds_bytes]u8, expected: [max_holds_bytes]u8) bool {
    const bytes = booked orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the matters a run left standing with nothing handed on.
///
/// The thirty-sixth of the family, and the one that ends the loop. The rung
/// below opens the reply a reader wrote; this one keeps what that reply refused,
/// so the run after it inherits an impasse rather than a blank page. A matter
/// twice refused and never handed on is a whole correspondence spent to arrive
/// exactly where it started.
pub fn unhanded_matters(standing_count: u32, forbear: Forbear) u32 {
    // invariant: a run never reads more standing words than one reply carries
    assert(standing_count <= 1);
    if (standing_count == 0) return 0;
    return if (forbear == .opens) 1 else 0;
}

// =========================================================================
// The minding -- what a run does with the impasse it opened holding
// =========================================================================

/// How many bytes one minding carries.
///
/// Six: the forbearance it was handed, echoed whole, and one byte saying this
/// run opened holding it. A mark carrying only "minded" would name no matter at
/// all, and an operator reading the outcome could not tell which impasse the
/// run inherited.
pub const max_minds_bytes: u32 = max_holds_bytes + 1;

/// The byte a minding run writes last, so a mark says what it is.
pub const minded_byte: u8 = 'm';

/// Whether a run names the impasse it opened holding.
///
/// The rung below hands a twice-refused matter to the run after it. A run that
/// inherits one and says nothing has been spared the question and begins the
/// correspondence again from nothing anyway -- so the whole exchange the arc
/// spent arrives exactly where it started, one lap later.
pub const Mind = enum { begins, minds };

/// Renders one minding as the words an operator reads.
pub fn mind_words(m: Mind) []const u8 {
    return switch (m) {
        .begins => "the plan opens holding an impasse and begins the matter again from nothing",
        .minds => "the plan opens holding an impasse, names it where the outcome is read, and takes it down",
    };
}

/// Renders the six bytes one minding carries.
///
/// The forbearance copied whole, with this run's own byte last. A minding is a
/// run saying what it inherited rather than a run making a fresh claim, so the
/// bytes it publishes are the bytes it was handed -- copied, never composed.
pub fn minds_bytes(hold: [max_holds_bytes]u8) [max_minds_bytes]u8 {
    var out: [max_minds_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_holds_bytes) : (at += 1) out[at] = hold[at];
    out[max_minds_bytes - 1] = minded_byte;
    // invariant: a minding carries the whole forbearance it was handed
    assert(at == max_holds_bytes);
    return out;
}

/// Answers whether a standing mark is about the impasse this run inherited.
///
/// The whole point of the rung, written as one comparison. A run may still find
/// a mark left by a run before today, and reading that as this run's would tell
/// an operator the plan had named an impasse nobody handed it this morning.
pub fn minds_carries(seen: ?[max_minds_bytes]u8, hold: [max_holds_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &minds_bytes(hold));
}

/// Reads the word out of a standing mark, or nothing at all.
///
/// A mark echoes the forbearance whole, and a forbearance ends on the reader's
/// own verdict -- so the word an operator reads out of the mark is the word that
/// reader wrote, carried two tiers without a supervisor's hand on it.
pub fn minds_rest(seen: ?[max_minds_bytes]u8) ?Rest {
    const bytes = seen orelse return null;
    return rest_of_byte(bytes[max_holds_bytes - 1]);
}

/// How many inherited impasses this run names where the outcome is read.
///
/// Narrow on purpose: a minding is about a forbearance actually handed to this
/// run, so a plan opening holding nothing names nothing, however willing it was.
pub fn minded_in(inherited_count: u32, mind: Mind) u32 {
    // invariant: a run never inherits more impasses than one forbearance carries
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    if (mind == .begins) return 0;
    return inherited_count;
}

/// How many inherited impasses this run leaves unnamed at the outcome.
pub fn begun_in(inherited_count: u32, mind: Mind) u32 {
    // invariant: a run never inherits more impasses than one forbearance carries
    assert(inherited_count <= 1);
    return inherited_count - minded_in(inherited_count, mind);
}

/// Every refusal this rung earns before a minding reaches the outcome.
///
/// The order is the rung below's order one tier out. A minding asks whether
/// there was a forbearance to open holding, whether the word it carries still
/// leaves the matter standing, and whether the mark published names it --
/// because a mark about the wrong impasse is worse than no mark at all, wearing
/// as it does the authority of an inheritance.
pub fn mind_refusal(inherited_count: u32, minded_count: u32, begun_count: u32, was_handed: bool, stands: bool, matched: bool) ?RunError {
    // invariant: a run never names more impasses than one forbearance carries
    assert(minded_count <= 1);
    if (minded_count >= 1 and !was_handed) return error.MindUninherited;
    if (minded_count >= 1 and !stands) return error.MindRested;
    if (minded_count >= 1 and !matched) return error.MindMismatched;
    // invariant: a minding never counts more impasses than there were handed on
    assert(minded_count + begun_count <= inherited_count + 1);
    if (minded_count + begun_count != inherited_count) return error.MindMiscounted;
    return null;
}

/// Answers whether the mark now standing is the one this run published.
///
/// The record half of this rung, and the reason the note is read again before
/// the report believes anything was named. A mark disagreeing with the
/// forbearance this run inherited is a plan telling an operator about an impasse
/// it never actually opened holding.
pub fn mind_holds(booked: ?[max_minds_bytes]u8, expected: [max_minds_bytes]u8) bool {
    const bytes = booked orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the impasses a run opened holding and never named.
///
/// The thirty-seventh of the family, and the one that answers the loop's own
/// close. The rung below hands a twice-refused matter to the run that comes
/// next; this one makes that run say so, rather than quietly starting the whole
/// correspondence over. An impasse inherited in silence buys the next run
/// nothing at all.
pub fn unminded_impasses(inherited_count: u32, mind: Mind) u32 {
    // invariant: a run never inherits more impasses than one forbearance carries
    assert(inherited_count <= 1);
    if (inherited_count == 0) return 0;
    return if (mind == .begins) 1 else 0;
}

/// Everything a run does about the quarrel standing over its plan, in one word.
///
/// Seven answers that all speak to one position, gathered so a supervisor's own
/// signature stops growing a line per rung: whether a pressed quarrel outlives
/// this run, whether the plan's word reads under one it inherited, whether a
/// withdrawn one comes down, whether the standing one is dated, how loudly it
/// reads where the outcome is read, whether it is put before a hand that is
/// neither party, whether what that hand answered comes home, whether a
/// concession the plan makes outlives the run that made it, whether a debt it
/// opened holding is met before the run is over, and whether that meeting ever
/// says what it found.
pub const Quarrel = struct {
    endurance: Endurance,
    heed: Heed,
    relent: Relent,
    dwell: Dwell,
    swell: Swell,
    refer: Refer,
    deem: Deem,
    avow: Avow,
    owe: Owe,
    meet: Meet,
    redress: Redress,
    upshot: Upshot,
    apprise: Apprise,
    suffice: Suffice,
    reopen: Reopen,
    reweigh: Reweigh,
    recount: Recount,
    allay: Allay,
    forbear: Forbear,
    mind: Mind,
    desist: Desist,
    beckon: Beckon,
    answer: Opening,
    abate: Abate,
};

/// Counts the long-standing quarrels nobody outside the argument ever sees.
///
/// The twenty-fourth of the family, and the one that finally asks the plan to
/// do something about a standing it has already published. The rung below
/// prints how loudly an objection reads, right where the outcome is read -- and
/// then the run goes on exactly as it always ran. So a supervisor may announce
/// an old objection forever, and the two hands holding the argument stay the
/// two hands that cannot end it.
///
/// The count is deliberately narrow. It moves only for a position still
/// standing when the run is over **and old enough to count**, since a quarrel
/// raised this morning is fairly left with the people having it, and a plan
/// nobody pressed has no case to carry anywhere.
pub fn unheard_outside(standing_count: u32, age: u32, refer: Refer) u32 {
    // invariant: a plan never leaves more positions standing than one note may carry
    assert(standing_count <= 1);
    if (standing_count == 0) return 0;
    if (stands_loud(age) == .quiet) return 0;
    return if (refer == .referred) 0 else 1;
}

// =========================================================================
// The bounding -- where a correspondence that cannot settle stops running
// =========================================================================

/// How many bytes one wall carries.
///
/// Seven: the mark this run made, echoed whole, and one byte saying the
/// correspondence stops here. A wall carrying only "walled" would bound no
/// matter at all, and an operator reading the outcome could not tell which
/// question the plan had stopped asking.
pub const max_walls_bytes: u32 = max_minds_bytes + 1;

/// The byte a bounding run writes last, so a wall says what it is.
pub const walled_byte: u8 = 'w';

/// Whether a plan stops relaying a matter that has come round twice.
///
/// The rung below names the impasse a run opened holding, and then the run
/// forbears once more -- so the next run inherits the same refusal and does the
/// same faithful thing with it. A plan that relays forever asks nothing of
/// anybody outside the loop, however plainly each run speaks.
pub const Desist = enum { relays, bounds };

/// Renders one bounding as the words an operator reads.
pub fn desist_words(d: Desist) []const u8 {
    return switch (d) {
        .relays => "the plan hands a twice-refused matter on again, and the correspondence runs another lap",
        .bounds => "the plan stands a wall where the correspondence used to run, and hands the matter to nobody",
    };
}

/// Renders the seven bytes one wall carries.
///
/// The mark copied whole, with this run's own byte last. A wall is a plan
/// saying a matter it already named has come round again rather than a plan
/// making a fresh claim, so the bytes it publishes are the bytes it named --
/// copied, never composed.
pub fn walls_bytes(mark: [max_minds_bytes]u8) [max_walls_bytes]u8 {
    var out: [max_walls_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_minds_bytes) : (at += 1) out[at] = mark[at];
    out[max_walls_bytes - 1] = walled_byte;
    // invariant: a wall carries the whole mark the run made of the matter
    assert(at == max_minds_bytes);
    return out;
}

/// Answers whether a standing wall bounds the matter this run named.
///
/// The whole point of the rung, written as one comparison. A run may still find
/// a wall left by a run before today, and reading that as this run's would tell
/// an operator the plan had bounded a matter nobody carried here this morning.
pub fn walls_carries(seen: ?[max_walls_bytes]u8, mark: [max_minds_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &walls_bytes(mark));
}

/// Reads the word out of a standing wall, or nothing at all.
///
/// A wall echoes the mark whole, a mark echoes the forbearance whole, and a
/// forbearance ends on the reader's own verdict -- so the word an operator
/// reads out of a wall is the word that reader wrote, carried three tiers
/// without a supervisor's hand on it.
pub fn walls_rest(seen: ?[max_walls_bytes]u8) ?Rest {
    const bytes = seen orelse return null;
    return rest_of_byte(bytes[max_holds_bytes - 1]);
}

/// Answers whether the matter this run named has come round before today.
///
/// A run bounds on evidence rather than on suspicion, and the only honest
/// evidence is the mark the run before it left: a matter named twice by two
/// runs is a matter the correspondence has carried twice without moving it.
pub fn came_round_twice(named_before: ?[max_minds_bytes]u8, mark: [max_minds_bytes]u8) bool {
    const elder = named_before orelse return false;
    return std.mem.eql(u8, &elder, &mark);
}

/// How many twice-round impasses this run stands a wall around.
///
/// Narrow on purpose: a bounding is about a matter this run actually named and
/// a run before it named too, so a plan carrying a matter for the first time
/// bounds nothing, however willing it was.
pub fn walled_in(round_count: u32, desist: Desist) u32 {
    // invariant: a run never bounds more matters than one mark carries
    assert(round_count <= 1);
    if (round_count == 0) return 0;
    if (desist == .relays) return 0;
    return round_count;
}

/// How many twice-round impasses this run hands on again anyway.
pub fn relayed_in(round_count: u32, desist: Desist) u32 {
    // invariant: a run never bounds more matters than one mark carries
    assert(round_count <= 1);
    return round_count - walled_in(round_count, desist);
}

/// Every refusal this rung earns before a wall reaches the outcome.
///
/// The order is the rung below's order one tier out. A bounding asks whether
/// this run named an impasse at all, whether the matter it named has come round
/// before today, and whether the wall published bounds it -- because a wall
/// around the wrong matter is worse than no wall at all, wearing as it does the
/// authority of an exhausted correspondence.
pub fn desist_refusal(round_count: u32, walled_count: u32, relayed_count: u32, was_named: bool, twice: bool, matched: bool) ?RunError {
    // invariant: a run never bounds more matters than one mark carries
    assert(walled_count <= 1);
    if (walled_count >= 1 and !was_named) return error.DesistUnnamed;
    if (walled_count >= 1 and !twice) return error.DesistFresh;
    if (walled_count >= 1 and !matched) return error.DesistMismatched;
    // invariant: a bounding never counts more matters than there were carried
    assert(walled_count + relayed_count <= round_count + 1);
    if (walled_count + relayed_count != round_count) return error.DesistMiscounted;
    return null;
}

/// Answers whether the wall now standing is the one this run published.
///
/// The record half of this rung, and the reason the note is read again before
/// the report believes anything was bounded. A wall disagreeing with the mark
/// this run made is a plan telling an operator about a boundary it never stood.
pub fn desist_holds(booked: ?[max_walls_bytes]u8, expected: [max_walls_bytes]u8) bool {
    const bytes = booked orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the impasses a plan carried round twice and relayed anyway.
///
/// The thirty-eighth of the family, and the one that ends the arc's own loop.
/// The rung below makes a run say what impasse it opened holding; this one
/// makes the plan stop opening under the same one forever. A matter relayed a
/// third time buys the run that inherits it exactly what the second relay
/// bought: another faithful lap and no motion at all.
pub fn unbounded_relays(round_count: u32, desist: Desist) u32 {
    // invariant: a run never carries more twice-round matters than one mark holds
    assert(round_count <= 1);
    if (round_count == 0) return 0;
    return if (desist == .relays) 1 else 0;
}

// =========================================================================
// The beckoning -- where a bounded matter leaves the drawer and reaches a hand
// =========================================================================

/// How many bytes one call carries.
///
/// Eight: the wall this run stood, echoed whole, and one byte saying a person
/// is being called to it. A call carrying only "called" would summon a reader
/// to nothing they could name, and a reader who cannot name the matter cannot
/// answer it.
pub const max_calls_bytes: u32 = max_walls_bytes + 1;

/// The byte a beckoning run writes last, so a call says what it is.
pub const called_byte: u8 = 'b';

/// Whether a plan carries the wall it stood out to the person who can act on it.
///
/// The rung below stands a wall where a correspondence used to run, and stands
/// it among the plan's own notes -- where an operator learns of it only by
/// coming to look. A plan that bounds a matter and tells nobody has ended the
/// loop and kept the ending to itself.
pub const Beckon = enum { keeps, beckons };

/// Renders one beckoning as the words an operator reads.
pub fn beckon_words(b: Beckon) []const u8 {
    return switch (b) {
        .keeps => "the plan bounds the matter and leaves the wall in a drawer only the plan opens",
        .beckons => "the plan carries the wall it stood to the box its reader already reads, and calls a person to it",
    };
}

/// Renders the eight bytes one call carries.
///
/// The wall copied whole, with this run's own byte last. A call is a plan
/// carrying a boundary it already stood rather than making a fresh claim, so
/// the bytes it delivers are the bytes it published -- copied, never composed.
pub fn calls_bytes(wall: [max_walls_bytes]u8) [max_calls_bytes]u8 {
    var out: [max_calls_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_walls_bytes) : (at += 1) out[at] = wall[at];
    out[max_calls_bytes - 1] = called_byte;
    // invariant: a call carries the whole wall it calls a person to
    assert(at == max_walls_bytes);
    return out;
}

/// Answers whether a delivered call names the wall this run stood.
///
/// The whole point of the rung, written as one comparison. A reader's box may
/// still hold a call left by a run before today, and reading that as this run's
/// would tell an operator a person had been reached about a boundary nobody
/// stood this morning.
pub fn calls_carries(seen: ?[max_calls_bytes]u8, wall: [max_walls_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &calls_bytes(wall));
}

/// Reads the word out of a delivered call, or nothing at all.
///
/// A call echoes the wall whole, a wall echoes the mark, a mark echoes the
/// forbearance, and a forbearance ends on the reader's own verdict -- so the
/// word a person reads in their own box is the word they wrote themselves,
/// carried four tiers without a supervisor's hand on it.
pub fn calls_rest(seen: ?[max_calls_bytes]u8) ?Rest {
    const bytes = seen orelse return null;
    return rest_of_byte(bytes[max_holds_bytes - 1]);
}

/// How many stood walls this run carries out to a person.
///
/// Narrow on purpose: a beckoning is about a wall this run actually stood, so a
/// plan that bounded nothing calls nobody, however willing it was.
pub fn beckoned_in(walled_count: u32, beckon: Beckon) u32 {
    // invariant: a run never calls about more walls than one mark earns
    assert(walled_count <= 1);
    if (walled_count == 0) return 0;
    if (beckon == .keeps) return 0;
    return walled_count;
}

/// How many stood walls this run keeps in its own drawer.
pub fn drawered_in(walled_count: u32, beckon: Beckon) u32 {
    // invariant: a run never calls about more walls than one mark earns
    assert(walled_count <= 1);
    return walled_count - beckoned_in(walled_count, beckon);
}

/// Every refusal this rung earns before a call reaches the outcome.
///
/// The order is the rung below's order one tier out. A beckoning asks whether
/// this run stood a wall at all, whether the reader left an address a run may
/// carry to, and whether the call delivered names that wall -- because calling a
/// person to the wrong boundary is worse than calling nobody, wearing as it does
/// the authority of a matter finally closed.
pub fn beckon_refusal(walled_count: u32, beckoned_count: u32, kept_count: u32, stood: bool, addressed: bool, matched: bool) ?RunError {
    // invariant: a run never calls about more walls than one mark earns
    assert(beckoned_count <= 1);
    if (beckoned_count >= 1 and !stood) return error.BeckonUnwalled;
    if (beckoned_count >= 1 and !addressed) return error.BeckonUnaddressed;
    if (beckoned_count >= 1 and !matched) return error.BeckonMismatched;
    // invariant: a beckoning never counts more walls than there were stood
    assert(beckoned_count + kept_count <= walled_count + 1);
    if (beckoned_count + kept_count != walled_count) return error.BeckonMiscounted;
    return null;
}

/// Answers whether the call now standing in a reader's box is this run's own.
///
/// The record half of this rung, and the reason the box is opened again before
/// the report believes anybody was called. A call disagreeing with the wall this
/// run stood is a plan telling an operator about a person it never reached.
pub fn beckon_holds(delivered: ?[max_calls_bytes]u8, expected: [max_calls_bytes]u8) bool {
    const bytes = delivered orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the walls a plan stood and told nobody about.
///
/// The thirty-ninth of the family, and the one where the arc finally leaves the
/// plan and reaches a person. The rung below ends the correspondence going
/// round forever; this one ends the ending being kept in a drawer. A wall an
/// operator never opens bounds the matter exactly as well as no wall at all, for
/// everyone save the plan that stood it.
pub fn unheralded_walls(walled_count: u32, beckon: Beckon) u32 {
    // invariant: a run never stands more walls than one mark earns
    assert(walled_count <= 1);
    if (walled_count == 0) return 0;
    return if (beckon == .keeps) 1 else 0;
}

// =========================================================================
// The answer -- what a person handed back, opened where they left it
// =========================================================================

/// How many bytes one reader's answer carries.
///
/// Nine: the call this run carried, echoed whole, and one byte saying what the
/// person makes of the boundary. An answer carrying only a word would reply to
/// nothing anybody could name, and a reply nobody can place answers every call
/// at once.
pub const max_hands_bytes: u32 = max_calls_bytes + 1;

/// How many bytes the record of one opened answer carries.
///
/// Ten: the answer echoed whole, and this run's own byte last -- so an operator
/// reading the outcome reads the reader's own word rather than a summary of it.
pub const max_answers_bytes: u32 = max_hands_bytes + 1;

/// The byte an opening run writes last, so a record says what it is.
pub const opened_byte: u8 = 'o';

/// What a reader called to a wall says they will do with it.
///
/// Two words and no more, because a boundary offers exactly two honest answers:
/// the person lets it stand and the matter ends with them, or they take it up
/// themselves, outside a plan that has stopped carrying it. Neither answer asks
/// the plan for another lap -- the wall below stands under both.
pub const Hand = enum { accepts, takes_up };

/// The byte one reader's own word is written as.
pub fn hand_byte(hand: Hand) u8 {
    return switch (hand) {
        .accepts => 'y',
        .takes_up => 'u',
    };
}

/// Reads one reader's own word out of the byte they wrote, or nothing at all.
pub fn hand_of_byte(byte: u8) ?Hand {
    if (byte == 'y') return .accepts;
    if (byte == 'u') return .takes_up;
    return null;
}

/// Renders one reader's word as the words an operator reads.
pub fn hand_words(hand: Hand) []const u8 {
    return switch (hand) {
        .accepts => "the reader lets the wall stand, and the matter ends with them",
        .takes_up => "the reader takes the matter up themselves, outside the plan that stopped carrying it",
    };
}

/// Renders the nine bytes one reader's answer carries.
///
/// The call copied whole, with the reader's own byte last. An answer is a person
/// replying to a boundary they were shown rather than opening a fresh matter, so
/// the bytes it carries are the bytes they were called with -- copied, never
/// composed.
pub fn hands_bytes(call: [max_calls_bytes]u8, hand: Hand) [max_hands_bytes]u8 {
    var out: [max_hands_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_calls_bytes) : (at += 1) out[at] = call[at];
    out[max_hands_bytes - 1] = hand_byte(hand);
    // invariant: an answer carries the whole call it replies to
    assert(at == max_calls_bytes);
    return out;
}

/// Answers whether a reader's answer replies to the call this run carried.
///
/// A box may still hold a word left about a boundary from a run before today,
/// and reading that as this one's would report a person answering a wall nobody
/// stood here.
pub fn hands_answers(seen: ?[max_hands_bytes]u8, call: [max_calls_bytes]u8) bool {
    const bytes = seen orelse return false;
    var at: u32 = 0;
    while (at < max_calls_bytes) : (at += 1) {
        if (bytes[at] != call[at]) return false;
    }
    // invariant: an answer is weighed over the whole call it names
    assert(at == max_calls_bytes);
    return hand_of_byte(bytes[max_hands_bytes - 1]) != null;
}

/// Reads the reader's own word out of an answer, or nothing at all.
pub fn hands_hand(seen: ?[max_hands_bytes]u8) ?Hand {
    const bytes = seen orelse return null;
    return hand_of_byte(bytes[max_hands_bytes - 1]);
}

/// Whether a plan opens the word its reader handed back.
///
/// The rung below carries a wall out to the person who can act on it, and then
/// the plan's part is done -- so whatever that person writes back sits in their
/// box, answering a correspondence nobody is reading any more.
pub const Opening = enum { leaves, hears };

/// Renders one opening as the words an operator reads.
pub fn answer_words(a: Opening) []const u8 {
    return switch (a) {
        .leaves => "the plan calls a person to the wall and leaves whatever they write back unopened",
        .hears => "the plan hears the answer its reader handed back, and records what a person said about the boundary",
    };
}

/// Renders the ten bytes one opened answer is recorded as.
///
/// The answer copied whole, with this run's own byte last. A record is a plan
/// carrying a person's own word to where an operator reads rather than making a
/// claim of its own, so the bytes it keeps are the bytes that person wrote.
pub fn answers_bytes(hand: [max_hands_bytes]u8) [max_answers_bytes]u8 {
    var out: [max_answers_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_hands_bytes) : (at += 1) out[at] = hand[at];
    out[max_answers_bytes - 1] = opened_byte;
    // invariant: a record carries the whole answer it reports
    assert(at == max_hands_bytes);
    return out;
}

/// Answers whether a recorded answer carries the reply this run opened.
pub fn answers_carries(seen: ?[max_answers_bytes]u8, hand: [max_hands_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &answers_bytes(hand));
}

/// Reads the reader's own word out of a recorded answer, or nothing at all.
///
/// An answer echoes the call, a call echoes the wall, a wall echoes the mark,
/// and a mark echoes the forbearance -- so an operator reading this record reads
/// five tiers of a correspondence and the person's own word at the end of it.
pub fn answers_hand(seen: ?[max_answers_bytes]u8) ?Hand {
    const bytes = seen orelse return null;
    return hand_of_byte(bytes[max_hands_bytes - 1]);
}

/// How many carried calls this run opens the answer to.
///
/// Narrow on purpose: an opening is about a call this run actually carried, so
/// a plan that beckoned nobody opens nothing, however willing it was.
pub fn hearing_in(called_count: u32, answer: Opening) u32 {
    // invariant: a run never opens more answers than one call earns
    assert(called_count <= 1);
    if (called_count == 0) return 0;
    if (answer == .leaves) return 0;
    return called_count;
}

/// How many carried calls this run leaves the answer to standing unopened.
pub fn shutting_in(called_count: u32, answer: Opening) u32 {
    // invariant: a run never opens more answers than one call earns
    assert(called_count <= 1);
    return called_count - hearing_in(called_count, answer);
}

/// Every refusal this rung earns before an opening reaches the outcome.
///
/// The order is the rung below's order one tier out. An opening asks whether
/// this run carried a call at all, whether the reader wrote anything back, and
/// whether what they wrote replies to that call -- because recording the wrong
/// answer is worse than recording none, wearing as it does the authority of a
/// person's own word.
pub fn answer_refusal(called_count: u32, opened_count: u32, left_count: u32, called: bool, spoken: bool, matched: bool) ?RunError {
    // invariant: a run never opens more answers than one call earns
    assert(opened_count <= 1);
    if (opened_count >= 1 and !called) return error.AnswerUncalled;
    if (opened_count >= 1 and !spoken) return error.AnswerSilent;
    if (opened_count >= 1 and !matched) return error.AnswerMismatched;
    // invariant: an opening never counts more calls than there were carried
    assert(opened_count + left_count <= called_count + 1);
    if (opened_count + left_count != called_count) return error.AnswerMiscounted;
    return null;
}

/// Answers whether the record now standing in the plan's notes is this run's own.
///
/// The record half of this rung, and the reason the note is read again before
/// the report believes anybody was heard. A record disagreeing with the answer
/// this run opened is a plan telling an operator what a person never said.
pub fn answer_holds(recorded: ?[max_answers_bytes]u8, expected: [max_answers_bytes]u8) bool {
    const bytes = recorded orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the answers a reader wrote back that a plan never opened.
///
/// The fortieth of the family, and the one where the arc finally hears the
/// person it reached. The rung below ends a boundary being kept where only the
/// plan reads; this one ends the reply being left where only the reader reads. A
/// word nobody opens answers the matter exactly as well as silence, for everyone
/// save the person who wrote it.
pub fn unopened_answers(called_count: u32, answer: Opening) u32 {
    // invariant: a run never carries more calls than one wall earns
    assert(called_count <= 1);
    if (called_count == 0) return 0;
    return if (answer == .leaves) 1 else 0;
}

// =========================================================================
// The abatement -- a wall taken down on the word of the reader who released it
// =========================================================================

/// How many bytes one abatement carries.
///
/// Eleven: the recorded answer echoed whole, and one byte saying that a plan
/// acted on it. An abatement carrying only a byte would take down a wall nobody
/// could name, and a release nobody can place releases every boundary at once.
pub const max_abates_bytes: u32 = max_answers_bytes + 1;

/// The byte an abating run writes last, so an abatement says what it is.
pub const abated_byte: u8 = 'b';

/// Whether a plan takes its own wall down on the word its reader handed back.
///
/// The rung below opens that word and records it, and then the plan's part is
/// done -- so a boundary a person has released stands run after run, outliving
/// both the correspondence it ended and the release that ended it.
pub const Abate = enum { holds, abates };

/// Renders one abating as the words an operator reads.
pub fn abate_words(a: Abate) []const u8 {
    return switch (a) {
        .holds => "the plan reads its reader's release and holds the wall standing all the same",
        .abates => "the plan takes the wall down on the word of the reader who released it",
    };
}

/// Answers whether one reader's word releases the plan from its own wall.
///
/// Exactly one of the two answers does. A reader who takes the matter up has
/// said it leaves with them, and a boundary held against a person already
/// carrying it serves nobody. A reader who lets the wall stand has asked for
/// nothing, and reading a release into their acceptance would take a word they
/// wrote and mean more by it than they did.
pub fn releases(hand: Hand) bool {
    return hand == .takes_up;
}

/// Renders the eleven bytes one abatement carries.
///
/// The record copied whole, with this run's own byte last. An abatement is a
/// plan acting on a person's word rather than reaching a finding of its own, so
/// the bytes it carries are the bytes that person's answer arrived in --
/// copied, never composed.
pub fn abates_bytes(record: [max_answers_bytes]u8) [max_abates_bytes]u8 {
    var out: [max_abates_bytes]u8 = @splat(0);
    var at: u32 = 0;
    while (at < max_answers_bytes) : (at += 1) out[at] = record[at];
    out[max_abates_bytes - 1] = abated_byte;
    // invariant: an abatement carries the whole record it acts on
    assert(at == max_answers_bytes);
    return out;
}

/// Answers whether a standing abatement carries the record this run opened.
pub fn abates_carries(seen: ?[max_abates_bytes]u8, record: [max_answers_bytes]u8) bool {
    const bytes = seen orelse return false;
    return std.mem.eql(u8, &bytes, &abates_bytes(record));
}

/// Reads the reader's own word out of a standing abatement, or nothing at all.
///
/// An abatement echoes the record, a record echoes the answer, an answer echoes
/// the call, a call echoes the wall, and a wall echoes the mark -- so an
/// operator reading these eleven bytes reads six tiers of a correspondence and
/// the release that ended it.
pub fn abates_hand(seen: ?[max_abates_bytes]u8) ?Hand {
    const bytes = seen orelse return null;
    return hand_of_byte(bytes[max_hands_bytes - 1]);
}

/// Answers whether a recorded answer replies about the wall now standing.
///
/// The record opens with the very bytes of the wall it descends from, so this
/// reads one against the other rather than trusting that a plan standing one
/// boundary is standing the one its reader answered about.
pub fn abates_wall(record: [max_answers_bytes]u8, wall: ?[max_walls_bytes]u8) bool {
    const bytes = wall orelse return false;
    var at: u32 = 0;
    while (at < max_walls_bytes) : (at += 1) {
        if (record[at] != bytes[at]) return false;
    }
    // invariant: an abatement is weighed over the whole wall it takes down
    assert(at == max_walls_bytes);
    return true;
}

/// How many opened answers this run takes its own wall down on.
///
/// Narrow twice over: an abating is about an answer this run actually opened,
/// and about a reader who actually released the plan -- so a run that heard
/// nobody abates nothing, and a run whose reader let the wall stand abates
/// nothing either, however willing it was.
pub fn abated_in(opened_count: u32, released: bool, abate: Abate) u32 {
    // invariant: a run never abates more walls than one answer earns
    assert(opened_count <= 1);
    if (opened_count == 0) return 0;
    if (!released) return 0;
    if (abate == .holds) return 0;
    return opened_count;
}

/// How many opened answers this run holds its own wall standing against.
pub fn withheld_walls_in(opened_count: u32, released: bool, abate: Abate) u32 {
    // invariant: a run never abates more walls than one answer earns
    assert(opened_count <= 1);
    return opened_count - abated_in(opened_count, released, abate);
}

/// Every refusal this rung earns before an abating reaches the outcome.
///
/// The order is the rung below's order one tier out. An abating asks whether
/// this run opened an answer at all, whether the reader's word released the
/// plan, and whether the wall now standing is the one they answered about --
/// because taking down the wrong boundary is worse than holding the right one,
/// wearing as it does the authority of a person's own release.
pub fn abate_refusal(opened_count: u32, abated_count: u32, held_count: u32, opened: bool, released: bool, matched: bool) ?RunError {
    // invariant: a run never abates more walls than one answer earns
    assert(abated_count <= 1);
    if (abated_count >= 1 and !opened) return error.AbateUnopened;
    if (abated_count >= 1 and !released) return error.AbateUnreleased;
    if (abated_count >= 1 and !matched) return error.AbateMismatched;
    // invariant: an abating never counts more answers than there were opened
    assert(abated_count + held_count <= opened_count + 1);
    if (abated_count + held_count != opened_count) return error.AbateMiscounted;
    return null;
}

/// Answers whether the abatement now standing in the plan's notes is this run's.
///
/// The record half of this rung, and the reason the note is read again before
/// the wall is allowed to fall. An abatement disagreeing with the answer this
/// run opened is a plan taking down a boundary on a word nobody gave it.
pub fn abate_holds(recorded: ?[max_abates_bytes]u8, expected: [max_abates_bytes]u8) bool {
    const bytes = recorded orelse return false;
    return std.mem.eql(u8, &bytes, &expected);
}

/// Counts the walls a plan kept standing after their reader took the matter up.
///
/// The forty-first of the family, and the one where a person's word finally
/// moves a plan. The rung below ends a reply being left where only the reader
/// reads; this one ends the reply, once read, changing nothing. A release that
/// leaves the boundary exactly where it found it is a courtesy rather than an
/// act, for everyone save the person who granted it.
pub fn standing_walls(opened_count: u32, released: bool, abate: Abate) u32 {
    // invariant: a run never opens more answers than one call earns
    assert(opened_count <= 1);
    if (opened_count == 0) return 0;
    // A reader who lets the wall stand has asked for nothing, so a plan holding
    // it costs the count nothing -- the harm this rung names is the boundary
    // held against a person who actually released it.
    if (!released) return 0;
    return if (abate == .holds) 1 else 0;
}

// =========================================================================
// The door -- unchanged, since this rung weighs a record rather than a line
// =========================================================================

/// Answers whether the head may enter, over the lines the run remembers.
///
/// The door is `revoke.admissible_in` exactly: a widened line is weighed the
/// same way whether a correction travels or waits. What this rung changes
/// happens after the last dependent has already gone home.
pub fn admissible_in(
    sys: *const system.System,
    live: []const cohort.Running,
    handed: []const Task,
    reserves: []const ?Task,
    taken: []const u32,
    head: Task,
) RunError!bool {
    return forbearing_rung.admissible_in(sys, live, handed, reserves, taken, head);
}

// =========================================================================
// The notes -- what a run publishes, and the answers it reads back
// =========================================================================

/// Why a conferral could not be published, read, confirmed, or reclaimed.
pub const NoteError = forbearing_rung.NoteError;

/// Writes the path of one dependent's note.
pub fn note_path(buf: *[max_note_path_len]u8, domain: []const u8, suffix: []const u8) NoteError![]const u8 {
    return ladder_checks.note_path(@This(), buf, domain, suffix);
}

/// Writes bytes into a note, creating it fresh.
pub fn seat_note(io: std.Io, domain: []const u8, suffix: []const u8, bytes: []const u8) NoteError!void {
    return ladder_checks.seat_note(@This(), io, domain, suffix, bytes);
}

/// Reads the one byte a counting note carries.
pub fn read_count(io: std.Io, domain: []const u8, suffix: []const u8) NoteError!u8 {
    return ladder_checks.read_count(@This(), io, domain, suffix);
}

/// Reads the word list a dependent's domain has been handed so far.
pub fn read_words(io: std.Io, domain: []const u8, out: *Words) NoteError!void {
    return ladder_checks.read_words(@This(), io, domain, out);
}

/// Provisions one set of notes per declared domain, all standing at nothing.
///
/// Every run starts with no reach conferred, none revoked, and no conferral
/// standing anywhere, so a word a dependent finds at its first breath was left
/// by this run's own supervisor rather than by the last.
pub fn provision_notes(io: std.Io, sys: *const system.System) NoteError!u32 {
    return ladder_checks.provision_notes(@This(), io, sys);
}

/// Tells one dependent how much reach may yet arrive for it.
pub fn offer(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    return ladder_checks.offer(@This(), io, domain, depth);
}

/// Reads how much reach this dependent was told may yet arrive.
pub fn offered(io: std.Io, domain: []const u8) NoteError!u32 {
    // invariant: an offer is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = try read_count(io, domain, ".offered");
    // invariant: an offer stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Tells one dependent whether a pruning will come for it at all.
pub fn promise_pruning(io: std.Io, domain: []const u8, keep: Keep) NoteError!void {
    return ladder_checks.promise_pruning(@This(), io, domain, keep);
}

/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(io: std.Io, domain: []const u8) bool {
    return ladder_checks.pruning_promised(@This(), io, domain);
}

/// Tells this dependent how its author declared it would end.
///
/// A plan already names the outcome it expects of every phase, and until now
/// only the supervisor read that word. The dependent needs it too, since the
/// window this rung studies opens inside the dependent's own life -- after it
/// grafts a conferral and before it carries the work. So the declaration rides
/// the same wire as the pruning promise, written before the spawn.
pub fn promise_falling(io: std.Io, domain: []const u8, falling: bool) NoteError!void {
    return ladder_checks.promise_falling(@This(), io, domain, falling);
}

/// Answers whether this dependent's author declared that it falls.
pub fn falling_promised(io: std.Io, domain: []const u8) bool {
    // invariant: a declaration is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".falls") catch return false;
    return seen != 0;
}

/// Publishes one conferral: the generation it is meant for, the words
/// themselves, then the count that makes them live.
///
/// The generation is what lets a dependent tell a word meant for it from a
/// word left standing by the dependent before it. It is a **measurement**
/// rather than a guard: a careless successor may graft a foreign word all the
/// same, which is exactly why the conferral is reclaimed rather than merely
/// labelled.
pub fn confer_words(io: std.Io, domain: []const u8, words: *const Words, depth: u32) NoteError!void {
    // invariant: a conferral always names the dependent it is handed to
    assert(domain.len >= 1);
    // invariant: a conferral never hands more than one line may name
    assert(depth <= cycle.max_hops);
    const generation = read_count(io, domain, ".epoch") catch 0;
    try seat_note(io, domain, ".for", &[_]u8{generation});
    try seat_note(io, domain, ".words", words.slice());
    try seat_note(io, domain, ".given", &[_]u8{@intCast(depth)});
}

/// Opens one generation of a domain, and answers which it is.
///
/// A domain outlives every dependent that stands in it, so each start counts
/// one further. The number is seated before the spawn, so a dependent always
/// finds its own generation waiting for it.
pub fn open_generation(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.open_generation(@This(), io, domain);
}

/// Tells the run this dependent has grafted the reach it was conferred.
pub fn holds(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never grafts more than one line may name
    assert(depth <= cycle.max_hops);
    try seat_note(io, domain, ".held", &[_]u8{@intCast(depth)});
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(io: std.Io, domain: []const u8, depth: u32) bool {
    return ladder_checks.confirm(@This(), io, domain, depth);
}

/// Publishes one revocation: how many conferred words remain live.
pub fn revoke(io: std.Io, domain: []const u8, keep: u32) NoteError!void {
    // invariant: a revocation always names the dependent it is asked of
    assert(domain.len >= 1);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    try seat_note(io, domain, ".kept", &[_]u8{@intCast(keep)});
}

/// Reads how many conferred words this dependent may still hold.
pub fn kept(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.kept(@This(), io, domain);
}

/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    return ladder_checks.pruned(@This(), io, domain, count);
}

/// Waits, bounded, until this revocation has been pruned.
pub fn confirm_pruned(io: std.Io, domain: []const u8, count: u32) bool {
    return ladder_checks.confirm_pruned(@This(), io, domain, count);
}

/// Tells the run how much reach this dependent found standing at its first breath.
pub fn inherited(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never inherits more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".inherited", &[_]u8{@intCast(count)});
}

/// Reads how much reach this dependent found standing at its first breath.
pub fn inherited_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an answer is always read about the dependent that gave it
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".inherited") catch return 0;
    // invariant: an inheritance stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Takes one conferral back whole, so nothing of it stands for a successor.
///
/// The words, the count that makes them live, and every answer given about
/// them return together. A count left standing would let a successor graft a
/// word; an answer of *held* left standing would let a supervisor believe a
/// successor grafted a word it never saw.
pub fn reclaim_notes(io: std.Io, domain: []const u8) NoteError!void {
    // invariant: a reclamation always names the domain it takes back from
    assert(domain.len >= 1);
    try seat_note(io, domain, ".words", "");
    try seat_note(io, domain, ".given", &[_]u8{0});
    try seat_note(io, domain, ".for", &[_]u8{0});
    try seat_note(io, domain, ".held", &[_]u8{0});
    try seat_note(io, domain, ".kept", &[_]u8{0});
    try seat_note(io, domain, ".pruned", &[_]u8{0});
}

/// Records on the wire how much reach this domain's departed holder never served.
///
/// Written after the reclamation has swept the domain clean, so the count
/// survives the very act that erases every other trace of the conferral. A
/// number kept only in memory would make the abandonment the supervisor's
/// claim; a number on the wire is a fact an operator reads after the run.
pub fn abandon_note(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an abandonment always names the domain it was granted to
    assert(domain.len >= 1);
    // invariant: an abandonment never records more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".abandoned", &[_]u8{@intCast(count)});
}

/// Reads how much reach this domain's departed holder never served.
pub fn abandoned_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an abandonment is always read about the domain it names
    assert(domain.len >= 1);
    const left = read_count(io, domain, ".abandoned") catch return 0;
    // invariant: an abandonment stays inside what one line may name
    assert(left <= cycle.max_hops);
    return left;
}

/// The name a plan's own verdict is published under.
///
/// Every other note on this wire belongs to one dependent; this one belongs to
/// the run itself, so it carries a name no declared domain may take.
pub const plan_name = "plan";

/// Publishes what the plan came to, where an operator reads it after the run.
///
/// The verdict is written once the last dependent has been reaped and every
/// abandonment already answered for, so the word rests on the whole of the
/// work rather than on the part of it that had happened when the run last
/// looked.
pub fn verdict_note(io: std.Io, verdict: Verdict) NoteError!void {
    try seat_note(io, plan_name, ".verdict", &[_]u8{verdict_byte(verdict)});
}

/// Reads a plan's published verdict back, or nothing where none was published.
pub fn verdict_published(io: std.Io) ?Verdict {
    const byte = read_count(io, plan_name, ".verdict") catch return null;
    return verdict_of_byte(byte);
}

/// Publishes which phases of the plan an arc was lost on.
///
/// The verdict says *that* a plan fell short; this says *where*. It is written
/// as one glyph per phase of the record -- `x` for a phase whose absorbed arc
/// nobody served, `.` for every other -- so an operator reads the shape of the
/// loss straight off the wire, and a mend derives its second record from the
/// record rather than from a supervisor's memory of it.
///
/// One glyph per phase rather than a packed mask, because the reader here is a
/// person first. The bound is the record's own: a plan never holds more phases
/// than `max_queue_len`, so this note never grows past it.
pub fn lost_note(io: std.Io, held: u32, lost_mask: u32) NoteError!void {
    // invariant: a loss note never names more phases than one record may hold
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((lost_mask & phase_bit(at)) != 0) glyphs[at] = 'x';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".lost", glyphs[0..held]);
}

/// Reads the published loss back as the mask a mend seats from.
///
/// A mend that reads nothing here has nothing to repair, and says so with a
/// zero rather than by guessing -- the refusal that follows is `MendUnread`
/// when even the verdict is absent, and `MendOvereach` if a caller were ever
/// to propose seating work the wire never named.
pub fn lost_published(io: std.Io, held: u32) u32 {
    return ladder_checks.lost_published(@This(), io, held);
}

/// The single bit that stands for one phase of a record.
pub fn phase_bit(at: u32) u32 {
    // invariant: a record always fits inside the bits one word carries
    assert(max_queue_len <= 32);
    // invariant: a bit always names a phase inside the record's own bound
    assert(at < max_queue_len);
    const one: u32 = 1;
    return one << @intCast(at);
}

/// Publishes which of a plan's losses its author asked it to bear.
///
/// The loss note says where a plan fell short; this says which of those places
/// its author would rather leave standing. It is written in the same shape and
/// read the same way -- one glyph per phase, `b` where an arc was lost and its
/// author marked it borne -- so an operator reads the two notes side by side
/// and a repair seats from the record rather than from a supervisor's memory
/// of what the plan wanted.
pub fn bearing_note(io: std.Io, held: u32, borne_mask: u32) NoteError!void {
    // invariant: a bearing note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((borne_mask & phase_bit(at)) != 0) glyphs[at] = 'b';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".bearing", glyphs[0..held]);
}

/// Reads the published bearing back as the mask a repair spares.
///
/// A run that reads nothing here bears nothing, and says so with a zero rather
/// than by guessing -- which leaves the repair exactly where the rung below
/// left it, running every arc the plan lost.
pub fn bearing_published(io: std.Io, held: u32) u32 {
    return ladder_checks.bearing_published(@This(), io, held);
}

/// Publishes which of a plan's unmarked losses this run weighed as spent.
///
/// The bearing note above names what an author asked to carry; this names what
/// the run judged the plan had got past. One glyph per phase, `w` where an
/// unmarked loss was weighed spent, written while the run still holds the
/// evidence and read back before the repair seats anything -- since a
/// supervisor that appraised from memory would be applying a standard it
/// believes in rather than the one its plan published.
pub fn appraisal_note(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: an appraisal note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((weighed_mask & phase_bit(at)) != 0) glyphs[at] = 'w';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".appraisal", glyphs[0..held]);
}

/// Reads back which phases this run weighed as spent, straight off the wire.
pub fn appraisal_published(io: std.Io, held: u32) u32 {
    return ladder_checks.appraisal_published(@This(), io, held);
}

/// Seats a judgment on the wire as the record a run before this one left.
///
/// The appraisal is the one note a run does not clear, so a standing judgment
/// arrives the only way it ever could: written, and waiting. This names that
/// act plainly for a caller that means to stand a record up mid-history, and it
/// makes the directory first, since a judgment may be waiting before any run of
/// this plan has provisioned a thing.
pub fn seat_standing_appraisal(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: a seated judgment never names more phases than one record holds
    assert(held <= max_queue_len);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try appraisal_note(io, held, weighed_mask);
}

/// Publishes which standing judgments this run took back.
///
/// The appraisal note above names what a run judged the plan had got past; this
/// names which of those judgments a later run's own evidence declines to keep.
/// One glyph per phase, `r` where a standing judgment was recanted, written
/// while the run still holds the record that disproves it and read back before
/// the repair seats a single phase on its strength.
pub fn recant_note(io: std.Io, held: u32, taken_back_mask: u32) NoteError!void {
    // invariant: a recant note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((taken_back_mask & phase_bit(at)) != 0) glyphs[at] = 'r';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".recant", glyphs[0..held]);
}

/// Reads back which standing judgments this run took back, straight off the wire.
pub fn recant_published(io: std.Io, held: u32) u32 {
    return ladder_checks.recant_published(@This(), io, held);
}

/// Publishes the word an operator finally reads about this plan.
///
/// The verdict note below says whether work is still standing. This says what
/// that standing work means -- carried out, short, or whole but for a loss the
/// plan itself asked to carry. Written after the repair has had its turn, and
/// read back before the report believes it.
pub fn settlement_note(io: std.Io, settlement: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".settled", &[_]u8{settlement_byte(settlement)});
}

/// Reads a plan's published settlement back, or nothing where none was written.
pub fn settlement_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".settled") catch return null;
    return settlement_of_byte(byte);
}

/// Reads the word an operator was last told about this plan, or nothing at all.
///
/// The settlement note above is what the wire says now; this is what somebody
/// carried away. The two are the same word right up until a later run moves
/// one of them, and this rung exists for the moment they part.
pub fn reading_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".read") catch return null;
    return settlement_of_byte(byte);
}

/// Seats a reading on the wire as the word an operator carried away.
///
/// The reading is the second note a run does not clear, so a standing reading
/// arrives the only way it ever could: written, and waiting. This names that act
/// plainly for a caller that means to stand a reader up mid-history, and it
/// makes the directory first, since somebody may have read this plan before any
/// run of it has provisioned a thing.
pub fn seat_standing_reading(io: std.Io, reading: Settlement) NoteError!void {
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".read", &[_]u8{settlement_byte(reading)});
}

/// Publishes the correction addressed to whoever read the elder word.
///
/// The first note of this arc written to a **person** rather than about a phase,
/// so it is written about the plan whole rather than one glyph per phase: two
/// bytes, the reading superseded and the reading that supersedes it, so `bc`
/// reads *you were told the plan was borne; it is carried out whole*. Written
/// while the run still holds both words, and read back before the report
/// believes anybody was reached.
pub fn amend_note(io: std.Io, was: Settlement, now: Settlement) NoteError!void {
    // invariant: an amendment always names two readings that actually differ
    assert(was != now);
    try seat_note(io, plan_name, ".amend", &[_]u8{ settlement_byte(was), settlement_byte(now) });
}

/// Reads the published amendment back as the two readings it names.
///
/// A run that reads nothing here corrected nobody, and says so with a null
/// rather than by guessing -- which leaves a reader exactly where the rung below
/// leaves them, holding a word the plan no longer stands behind.
pub fn amend_published(io: std.Io) ?[2]Settlement {
    return ladder_checks.amend_published(@This(), io);
}

/// Records the disagreement between what this run stands behind and what its
/// reader answered.
///
/// The first note of this arc that writes a **reader's own word** into the
/// plan's record: two bytes, the reading this run carried and the reading their
/// hand named, so `cb` reads *the plan holds carried out whole; its reader holds
/// borne*. The pair is written and left there. A supervisor that went on to
/// settle the disagreement in its own favor would be recording a quarrel and
/// calling it a verdict.
pub fn dispute_note(io: std.Io, ours: Settlement, theirs: Settlement) NoteError!void {
    // invariant: a dispute always names two readings that actually differ
    assert(ours != theirs);
    try seat_note(io, plan_name, ".dispute", &[_]u8{ settlement_byte(ours), settlement_byte(theirs) });
}

/// Reads the recorded disagreement back as the two readings it names.
///
/// A run that reads nothing here recorded no disagreement, and says so with a
/// null rather than by guessing -- which leaves the record exactly where the
/// rung below leaves it, reading as one voice whatever its reader answered.
pub fn dispute_recorded(io: std.Io) ?[2]Settlement {
    return ladder_checks.dispute_recorded(@This(), io);
}

/// Stands the published word up beside the reading recorded against it.
///
/// One byte, written where the settlement is read rather than where the record
/// is kept: `plan.beside` holds the reader's own reading, so an operator opening
/// `plan.settled` finds the objection in the same reach. The plan's own word is
/// already there and stays exactly as it was written -- an escort adds a voice
/// beside a sentence rather than editing the sentence.
pub fn abide_note(io: std.Io, marked: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".beside", &[_]u8{settlement_byte(marked)});
}

/// Reads the mark standing beside the published word, or nothing at all.
///
/// A run that reads nothing here escorted nothing, and says so with a null
/// rather than by guessing -- which leaves the word exactly where the rung below
/// leaves it, reading alone however plainly its reader objected.
pub fn escort_written(io: std.Io) ?Settlement {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".beside") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a mark never outgrows the one reading it quotes
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Reads the address the standing reading was taken at, or nothing at all.
///
/// A reader who took a word away is somewhere, and the plan either wrote that
/// down or it did not. This answers which -- plainly, with a null where no
/// address stands, so a run never has to guess where a person is.
pub fn address_published(io: std.Io, out: *[max_address_len]u8) ?[]const u8 {
    return ladder_checks.address_published(@This(), io, out);
}

/// Seats the address a reader was reached at, beside the reading they took.
///
/// The reading and the address arrive together, since a word carried away and
/// the place it was carried to are one fact about one person. This names that
/// act plainly for a caller standing a reader up mid-history, and it makes the
/// directory first, since somebody may have read this plan before any run of it
/// has provisioned a thing.
pub fn seat_standing_address(io: std.Io, address: []const u8) NoteError!void {
    // invariant: a run only ever seats an address a correction could reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".at", address);
}

/// Writes the path of one reader's own box.
///
/// The one path this rung builds outside `note_dir`, and the shape of its whole
/// claim: a delivery lands where the reader is rather than where the record
/// lives. The address is bounded and checked before a byte of it reaches a path.
fn box_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.box_path(@This(), buf, address);
}

/// Carries one correction to the reader's own box, in the words they read.
///
/// The outward reach of the whole arc, and it is deliberately the same two
/// bytes the wire carries: the reading superseded and the reading that
/// supersedes it, so `bc` reads *you were told the plan was borne; it is
/// carried out whole* wherever a person finds it. The box is made here, since a
/// reader's address is a place this plan has never written to before.
pub fn deliver(io: std.Io, address: []const u8, was: Settlement, now: Settlement) NoteError!void {
    return ladder_checks.deliver(@This(), io, address, was, now);
}

/// Reads one reader's box back as the two readings it carries.
///
/// The hard half of this rung, read from the box rather than from the run's own
/// memory of writing to it. A run that reads nothing here delivered nothing,
/// and says so with a null rather than by believing its own report -- which is
/// the difference between a delivery and a claim about one.
pub fn delivered_to(io: std.Io, address: []const u8) ?[2]Settlement {
    return ladder_checks.delivered_to(@This(), io, address);
}

/// Clears one reader's box, so a lap begins with a reader who has been told
/// nothing at all.
///
/// A box outlives every run, exactly as a reader's own copy does, so a lap that
/// means to prove a delivery must start from a reader who is genuinely waiting.
pub fn empty_box(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = box_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the hand one reader answers with.
///
/// The reader's own box holds two files and they face opposite ways: `.told` is
/// what the plan carried to them, and `.said` is what they wrote back. A run
/// writes the first and only ever reads the second, which is the whole
/// difference between a delivery and an acknowledgement.
fn hand_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.hand_path(@This(), buf, address);
}

/// Reads one reader's own hand as the reading they say they now hold.
///
/// The only reach a run ever makes toward this file, and it is a read. A run
/// that finds nothing here has heard nothing, and says so with a null rather
/// than by believing its own delivery -- since a letter that arrived and a
/// reader who answered are two facts, and only the second one is about a
/// person.
pub fn answered_by(io: std.Io, address: []const u8) ?Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an answer never outgrows the one reading it names
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Answers as the reader themself, in the one byte they would write.
///
/// **No run ever calls this**, and that restraint is the rung. An
/// acknowledgement a supervisor could write for its reader acknowledges
/// nothing at all -- it is the plan agreeing with the plan. The hand belongs to
/// an operator, to a tool at their desk, or to a lap that means to stand a
/// reader up on the wire the way `seat_standing_reading` stands one up
/// mid-history; the supervisor's whole part is to read what it finds and to
/// report honestly when it finds nothing.
pub fn answer_as_reader(io: std.Io, address: []const u8, now_holds: Settlement) NoteError!void {
    // invariant: a hand is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try hand_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{settlement_byte(now_holds)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's hand, so a lap begins with a reader who has said
/// nothing at all.
///
/// A hand outlives every run, exactly as a reader's own copy does, so a lap
/// that means to prove a hearing must start from a reader whose word this run
/// genuinely finds rather than one an earlier run left lying there.
pub fn clear_hand(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the question one reader is asked again.
fn ask_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.ask_path(@This(), buf, address);
}

/// Writes the path of the second hand one reader may raise their objection with.
fn renew_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.renew_path(@This(), buf, address);
}

/// Puts the standing objection back to the reader who raised it.
///
/// Two bytes, written where that reader is rather than where the record is kept:
/// the plan's own word and the word this reader holds against it, exactly as the
/// record names them. A question that named only one of the two would be asking
/// somebody to remember which quarrel this was.
///
/// This is the act that earns the right to call a later silence silence. A term
/// without it is a clock nobody was shown.
pub fn ask_again(io: std.Io, address: []const u8, held: [2]Settlement) NoteError!void {
    // invariant: a question is only ever asked of an address a run may carry to
    assert(addressable(address));
    // invariant: a question always names two readings that actually differ
    assert(held[0] != held[1]);
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try ask_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{ settlement_byte(held[0]), settlement_byte(held[1]) };
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Reads back the question this reader was asked, or nothing at all.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// asked by reading the question out of the reader's own box, never by
/// remembering having written it. A supervisor that believed its own asking
/// could publish a lapse over a question that never left the building.
pub fn asked_of(io: std.Io, address: []const u8) ?[2]Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = ask_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a question never outgrows the two readings it names
    assert(got <= 2);
    if (got < 2) return null;
    const ours = settlement_of_byte(bytes[0]) orelse return null;
    const theirs = settlement_of_byte(bytes[1]) orelse return null;
    return .{ ours, theirs };
}

/// Reads one reader's second hand as the objection they say they still hold.
///
/// The only reach a run ever makes toward this file, and it is a read. A run
/// that finds nothing here has been answered with silence, and says so with a
/// null rather than by assuming either way -- since a question that was asked
/// and an objection that still stands are two facts, and only the second one is
/// about a person's present mind.
pub fn renewed_by(io: std.Io, address: []const u8) ?Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = renew_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a renewal never outgrows the one objection it raises
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Raises the objection again as the reader themself, in the one byte they
/// would write.
///
/// **No run ever calls this**, and that restraint is the rung. A renewal a
/// supervisor could write for its reader renews nothing at all -- it is the plan
/// objecting to the plan, and then agreeing that the objection stands. Silence
/// belongs to the person who is silent; the supervisor's whole part is to ask
/// plainly, read what it finds, and report honestly when it finds nothing.
pub fn renew_as_reader(io: std.Io, address: []const u8, still_holds: Settlement) NoteError!void {
    // invariant: a renewal is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try renew_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{settlement_byte(still_holds)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's second hand, so a lap begins with a reader who has not
/// yet been asked to say whether they still object.
pub fn clear_renewal(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = renew_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Clears the question one reader was asked, so a lap begins unasked.
pub fn clear_question(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = ask_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what became of the objection standing beside this plan's word.
///
/// One byte, written where the settlement and its escort are read rather than
/// where the correspondence lives: `plan.term` holds `r` for an objection its
/// reader raised again and `l` for one nobody renewed. The escort in
/// `plan.beside` stays exactly as it was written -- a term reports on an
/// objection rather than withdrawing it, and a run that erased the mark because
/// its reader went quiet would be winning the quarrel by outlasting them.
pub fn lapse_note(io: std.Io, life: Life) NoteError!void {
    try seat_note(io, plan_name, ".term", &[_]u8{life_byte(life)});
}

/// Reads the term standing on the published objection, or nothing at all.
///
/// A run that reads nothing here put no term on anything, and says so with a
/// null rather than by guessing -- which leaves the objection exactly where the
/// rung below leaves it, standing for as long as the record does.
pub fn term_written(io: std.Io) ?Life {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".term") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a term never outgrows the one life it names
    assert(got <= 1);
    if (got < 1) return null;
    return life_of_byte(bytes[0]);
}

/// Carries the term's own answer into the mark an operator actually opens.
///
/// Two bytes into `plan.beside`, where the rung below wrote one: the reading its
/// reader holds first, byte for byte as they earned it, and the standing of that
/// objection second. There is no second note to know about, which is the whole
/// point -- a reader who opens the file the objection lives in cannot read the
/// objection without also reading whether anybody is still behind it.
///
/// The mark's first byte is written again exactly as it read, so every elder
/// reader of that file still reads the mark it always read, and no run ever
/// takes an escort down. A repose reports on an objection rather than
/// withdrawing it.
pub fn repose_note(io: std.Io, marked: Settlement, stand: Stand) NoteError!void {
    try seat_note(io, plan_name, ".beside", &[_]u8{ settlement_byte(marked), stand_byte(stand) });
}

/// Reads the standing the mark carries, or nothing at all.
///
/// A run that reads nothing here left its mark exactly as the rung below wrote
/// it, and says so with a null rather than by guessing -- which leaves every
/// operator reading a live quarrel however long ago its reader let it go.
pub fn standing_written(io: std.Io) ?Stand {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".beside") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a mark never outgrows the reading and the standing it names
    assert(got <= 2);
    if (got < 2) return null;
    return stand_of_byte(bytes[1]);
}

/// Writes the path of the answer one reader is owed about their own quarrel.
pub fn tell_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.tell_path(@This(), buf, address);
}

/// Tells the reader who raised a quarrel how it came out.
///
/// One byte, written where that reader is rather than where the record is kept:
/// `m` for a word their objection stood against that reads differently now, `t`
/// for one that reads exactly as it read. It lands beside the letter this arc
/// already carried them and the question it already asked them, in the same box,
/// so a reader who has heard from this plan twice hears from it a third time in
/// the place they already look.
///
/// Every note beneath this one is written where a word is read. This is the only
/// one written where the person who objected can find it.
pub fn tell_outcome(io: std.Io, address: []const u8, result: Result) NoteError!void {
    return ladder_checks.tell_outcome(@This(), io, address, result);
}

/// Reads back what this reader was told about their own quarrel, or nothing.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// wrote back by reading the answer out of the reader's own box, never by
/// remembering having written it. A supervisor that believed its own telling
/// could report a raiser reached whose box was never opened.
pub fn told_of(io: std.Io, address: []const u8) ?Result {
    return ladder_checks.told_of(@This(), io, address);
}

/// Writes the path of the finding one reader is owed about the admission they
/// won.
fn found_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a finding is only ever written to an address a run may carry to
    assert(addressable(address));
    const suffix = ".found";
    // invariant: a finding is left in the same box every other word to this
    // reader was left in
    comptime assert(suffix.len == ".outof".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a finding path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Carries the finding to the reader who won the admission it answers.
///
/// The finding's own three bytes, unchanged, written where that reader is rather
/// than where the record is kept. It lands beside the letter this arc carried
/// them, the question it asked them, and the word it already sent about how
/// their quarrel came out, so a reader who has heard from this plan three times
/// hears from it a fourth in the place they already look.
///
/// Every note this arc writes about a finding is written where the plan reads.
/// This is the only one written where the person who won it can find it.
pub fn apprise_note(io: std.Io, address: []const u8, finding: [max_found_bytes]u8) NoteError!void {
    // invariant: a finding is only ever carried to an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try found_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &finding, 0) catch return error.NoteUnavailable;
}

/// Reads back what this reader was carried about the admission they won.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// carried a finding by reading it out of the reader's own box, never by
/// remembering having written it. A supervisor that believed its own delivery
/// could report a raiser told whose box was never opened.
pub fn apprised_of(io: std.Io, address: []const u8) ?[max_found_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = found_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_found_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a delivered finding never outgrows the finding it carries
    assert(got <= max_found_bytes);
    if (got < max_found_bytes) return null;
    return bytes;
}

/// Clears what one reader was carried, so a lap begins with a reader who has
/// heard nothing about what the look at their admission found.
pub fn clear_apprise(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = found_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the telling one reader is carried about a second look.
///
/// It sits in the same box every other word to and from this reader sits in, so
/// the whole correspondence reads as one exchange rather than as a plan's notes
/// with a letter tucked among them.
fn knows_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a telling is only ever carried to an address a run may reach
    assert(addressable(address));
    const suffix = ".knows";
    // invariant: a telling is left in the same box every other word to this
    // reader is left in
    comptime assert(suffix.len == ".found".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a telling path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Carries one telling out to the reader who reopened the matter.
///
/// Four bytes into `<address>.knows`, in that reader's own box rather than among
/// the plan's notes -- because the whole harm this rung names is a second look
/// filed where only the plan itself ever reads.
pub fn recount_note(io: std.Io, address: []const u8, receipt: [max_anew_bytes]u8) NoteError!void {
    // invariant: a telling is only ever carried to an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try knows_path(&path_buf, address);
    const bytes = knows_bytes(receipt);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Reads what one reader was told about the second look, or nothing.
///
/// The wire before the memory: a run proves its reader was told by opening that
/// reader's own box, never by remembering having written to it. A supervisor
/// that believed its own telling could report a reader answered whose box was
/// never opened.
pub fn recounted_to(io: std.Io, address: []const u8) ?[max_knows_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = knows_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_knows_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a telling never outgrows the receipt it copies
    assert(got <= max_knows_bytes);
    if (got < max_knows_bytes) return null;
    return bytes;
}

/// Clears what one reader was told, so a lap begins with a reader who has heard
/// nothing about what the second look came to.
pub fn clear_recount(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = knows_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the word one reader keeps about the answer they were
/// carried.
fn suits_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a word is only ever sought at an address a run may reach
    assert(addressable(address));
    const suffix = ".suits";
    // invariant: a reader's word is kept in the same box every other word to and
    // from this reader is kept in
    comptime assert(suffix.len == ".found".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a word path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Writes one reader's own word about the answer they were carried.
///
/// **No run of this plan ever calls this.** It stands for the hand outside the
/// argument the same way `press_as_reader` does: a real correspondent opening
/// their box, reading what the look came to, and saying what they make of it. A
/// supervisor able to write here would be authoring its own reader's
/// satisfaction, which is the whole harm this rung is built against.
pub fn weigh_as_reader(io: std.Io, address: []const u8, word: [max_suits_bytes]u8) NoteError!void {
    // invariant: a word is only ever left at an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try suits_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &word, 0) catch return error.NoteUnavailable;
}

/// Reads what one reader made of the answer they were carried, or nothing.
///
/// The wire before the memory: a run learns what its reader thought by opening
/// that reader's own box, never by assuming an answer nobody wrote. A box
/// holding nothing answers with a null rather than with a satisfaction, since
/// silence is no consent here.
pub fn worth_written(io: std.Io, address: []const u8) ?[max_suits_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = suits_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_suits_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a reader's word never outgrows the answer it weighs
    assert(got <= max_suits_bytes);
    if (got < max_suits_bytes) return null;
    return bytes;
}

/// Clears one reader's word, so a lap begins with a reader who has said nothing
/// about the answer they were carried.
pub fn clear_suits(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = suits_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what this plan's reader made of the answer it carried them.
///
/// One byte into `plan.worth`, seated among the plan's own notes rather than in
/// the reader's box, because the person this is written for is the operator who
/// opens the outcome. The reader keeps their own word where they wrote it; this
/// is the plan carrying it home to where the settlement is read.
pub fn suffice_note(io: std.Io, worth: Worth) NoteError!void {
    try seat_note(io, plan_name, ".worth", &[_]u8{worth_byte(worth)});
}

/// Reads what this plan published of its reader's word, or nothing at all.
///
/// The read an operator makes beside the settlement, and the read this run makes
/// of its own note before the report believes anybody was asked.
pub fn worth_published(io: std.Io) ?Worth {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".worth") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a published word never outgrows the one verdict it names
    assert(got <= 1);
    if (got < 1) return null;
    return worth_of_byte(bytes[0]);
}

/// Takes down the published word, because the answer it weighed is gone.
pub fn clear_suffice(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".worth") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the word one reader keeps about the telling they were
/// carried.
fn rests_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a reply is only ever sought at an address a run may reach
    assert(addressable(address));
    const suffix = ".rests";
    // invariant: a reply is kept in the same box every other word to and from
    // this reader is kept in
    comptime assert(suffix.len == ".knows".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a reply path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Writes one reader's own word about the telling they were carried.
///
/// **No run of this plan ever calls this.** It stands for the hand outside the
/// argument the same way `weigh_as_reader` does one tier down: a real
/// correspondent opening their box, reading what the second look came to, and
/// saying whether it puts the matter to rest. A supervisor able to write here
/// would be authoring its own reader's satisfaction twice over, which is the
/// whole harm this rung is built against.
pub fn rest_as_reader(io: std.Io, address: []const u8, word: [max_rests_bytes]u8) NoteError!void {
    // invariant: a reply is only ever left at an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try rests_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &word, 0) catch return error.NoteUnavailable;
}

/// Reads what one reader made of the telling they were carried, or nothing.
///
/// The wire before the memory, one tier further out again: a run learns what
/// its reader thought of the second look by opening that reader's own box,
/// never by assuming an answer nobody wrote. A box holding nothing answers with
/// a null rather than with a satisfaction, since silence is no consent here
/// either.
pub fn rest_written(io: std.Io, address: []const u8) ?[max_rests_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = rests_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_rests_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a reply never outgrows the telling it answers
    assert(got <= max_rests_bytes);
    if (got < max_rests_bytes) return null;
    return bytes;
}

/// Clears one reader's reply, so a lap begins with a reader who has said
/// nothing about the telling they were carried.
pub fn clear_rests(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = rests_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what this plan's reader made of the telling it carried them.
///
/// One byte into `plan.rest`, seated among the plan's own notes rather than in
/// the reader's box, because the person this is written for is the operator who
/// opens the outcome. The reader keeps their own word where they wrote it; this
/// is the plan carrying it home to where the settlement is read.
pub fn allay_note(io: std.Io, rest: Rest) NoteError!void {
    try seat_note(io, plan_name, ".rest", &[_]u8{rest_byte(rest)});
}

/// Reads what this plan published of its reader's reply, or nothing at all.
///
/// The read an operator makes beside the settlement, and the read this run
/// makes of its own record before it believes it published anything.
pub fn rest_published(io: std.Io) ?Rest {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".rest") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a published reply never outgrows the one word it names
    assert(got <= 1);
    if (got < 1) return null;
    return rest_of_byte(bytes[0]);
}

/// Takes down this plan's copy of its reader's reply, so a lap begins with an
/// outcome that says nothing about whether the matter rests.
pub fn clear_allay(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".rest") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Hands one forbearance on, in a note addressed to the run after this one.
///
/// Five bytes into `plan.hold`, seated among the plan's own notes, because the
/// run that inherits an impasse is this plan's own next run. It joins `.again`
/// and `.debt` as the third note in the arc written for a run that has not
/// started -- and it is the first whose whole content came from a person
/// outside the plan, copied word for word rather than composed.
pub fn forbear_note(io: std.Io, reply: [max_rests_bytes]u8) NoteError!void {
    const bytes = holds_bytes(reply);
    try seat_note(io, plan_name, ".hold", &bytes);
}

/// Reads the forbearance standing for the next run, or nothing at all.
///
/// The read the run after this one makes at its own first breath, and the read
/// this run makes of its own record before it believes it handed anything on.
pub fn hold_standing(io: std.Io) ?[max_holds_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".hold") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_holds_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a forbearance never outgrows the reply it holds back on
    assert(got <= max_holds_bytes);
    if (got < max_holds_bytes) return null;
    return bytes;
}

/// Takes down a standing forbearance, so a lap begins with a run inheriting
/// no impasse at all.
pub fn clear_forbear(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".hold") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what this run opened holding, where the outcome is read.
///
/// Six bytes into `plan.mind`, beside `plan.rest` and `plan.worth`, because an
/// operator reading an outcome is owed the fact that this run began under a
/// matter the run before it could not settle. It is a word about an
/// inheritance, never a fresh claim: every byte save the last came from the
/// forbearance itself.
pub fn mind_note(io: std.Io, hold: [max_holds_bytes]u8) NoteError!void {
    const bytes = minds_bytes(hold);
    try seat_note(io, plan_name, ".mind", &bytes);
}

/// Reads the mark this run published, or nothing at all.
///
/// The read an operator makes of the outcome, and the read this run makes of
/// its own record before it believes it named anything.
pub fn mind_published(io: std.Io) ?[max_minds_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".mind") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_minds_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a minding never outgrows the forbearance it was handed
    assert(got <= max_minds_bytes);
    if (got < max_minds_bytes) return null;
    return bytes;
}

/// Takes down a standing mark, so a lap begins with an outcome naming nothing.
pub fn clear_mind(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".mind") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Stands a wall where the correspondence used to run.
///
/// Seven bytes into `plan.wall`, beside `plan.mind` and the settlement, because
/// an operator reading an outcome is owed the fact that this matter has come
/// round twice and will not come round again. It is a word about a mark the run
/// itself made, never a fresh claim: every byte save the last was copied from
/// the mark, which copied it from the forbearance, which copied it from the
/// reader.
pub fn wall_note(io: std.Io, mark: [max_minds_bytes]u8) NoteError!void {
    const bytes = walls_bytes(mark);
    try seat_note(io, plan_name, ".wall", &bytes);
}

/// Reads the wall this run stood, or nothing at all.
///
/// The read an operator makes of the outcome, and the read this run makes of
/// its own record before it believes it bounded anything.
pub fn wall_standing(io: std.Io) ?[max_walls_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".wall") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_walls_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a wall never outgrows the mark it bounds
    assert(got <= max_walls_bytes);
    if (got < max_walls_bytes) return null;
    return bytes;
}

/// Takes down a standing wall, so a lap begins with a correspondence still
/// free to run.
pub fn clear_desist(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".wall") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the call one reader is owed about a bounded matter.
fn call_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a call is only ever written to an address a run may carry to
    assert(addressable(address));
    const suffix = ".walls";
    // invariant: a call is left in the same box every other word to this reader
    // was left in
    comptime assert(suffix.len == ".rests".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a call path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Calls a person to the wall this run stood.
///
/// Eight bytes, written where that reader is rather than where the record is
/// kept: the wall echoed whole and this run's own byte last. It lands beside
/// every other word this arc has carried them, in the same box, so the reader
/// who refused the telling learns from the place they already look that the
/// plan has stopped asking.
///
/// The wall beneath this one is written where a plan keeps its records. This is
/// the one written where the person who can act on it will find it.
pub fn call_reader(io: std.Io, address: []const u8, wall: [max_walls_bytes]u8) NoteError!void {
    // invariant: a call is only ever carried to an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try call_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = calls_bytes(wall);
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Reads back the call standing in one reader's box, or nothing at all.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// reached a person by opening that person's box, never by remembering having
/// written to it. A supervisor that believed its own calling could report a
/// matter carried to a hand that was never told.
pub fn called_of(io: std.Io, address: []const u8) ?[max_calls_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = call_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_calls_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a call never outgrows the wall it calls a person to
    assert(got <= max_calls_bytes);
    if (got < max_calls_bytes) return null;
    return bytes;
}

/// Takes down a call, so a lap begins with a reader's box holding no summons.
pub fn clear_calls(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = call_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the answer one reader hands back about a bounded matter.
fn hands_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: an answer is only ever read from an address a run may carry to
    assert(addressable(address));
    const suffix = ".hands";
    // invariant: an answer is left in the same box every other word to this
    // reader was left in
    comptime assert(suffix.len == ".walls".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: an answer path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Reads the answer one reader handed back, or nothing at all.
///
/// The reader's own hand, in the reader's own box, outside this plan's wire
/// entirely -- nine bytes the plan may read and may never write. Every rung of
/// this arc that hears a person hears them exactly this way.
pub fn hands_written(io: std.Io, address: []const u8) ?[max_hands_bytes]u8 {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hands_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_hands_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an answer never outgrows the call it replies to
    assert(got <= max_hands_bytes);
    if (got < max_hands_bytes) return null;
    return bytes;
}

/// Seats the answer a reader hands back, standing in for that reader's own hand.
///
/// The harness's own half, and never a run's: a plan that could write the reply
/// it reads would be answering its own call. This exists so a lap can stand a
/// world up before a run finds it, exactly as an operator or a correspondent
/// would have left it.
pub fn seat_hands(io: std.Io, address: []const u8, hand: [max_hands_bytes]u8) NoteError!void {
    // invariant: an answer is only ever seated at an address a run may reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try hands_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &hand, 0) catch return error.NoteUnavailable;
}

/// Takes down a reader's answer, so a lap begins with a box holding no reply.
pub fn clear_hands(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hands_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Records the answer a reader handed back, where an operator reads the outcome.
///
/// Ten bytes into `plan.answer`, beside `plan.wall` and the settlement, because
/// an operator reading an outcome is owed the word the person they called wrote
/// back. It is a record of somebody else's word, never a claim of the plan's
/// own: every byte save the last was copied from the reader's own hand.
pub fn answer_note(io: std.Io, hand: [max_hands_bytes]u8) NoteError!void {
    const bytes = answers_bytes(hand);
    try seat_note(io, plan_name, ".answer", &bytes);
}

/// Reads the answer this run recorded, or nothing at all.
///
/// The read an operator makes of the outcome, and the read this run makes of its
/// own record before it believes it heard anybody.
pub fn answer_standing(io: std.Io) ?[max_answers_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".answer") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_answers_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a record never outgrows the answer it reports
    assert(got <= max_answers_bytes);
    if (got < max_answers_bytes) return null;
    return bytes;
}

/// Takes down a recorded answer, so a lap begins with the outcome silent.
pub fn clear_answer(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".answer") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Records that this run took its own wall down on its reader's release.
///
/// Eleven bytes into the plan's own notes, beside the record they act on and the
/// settlement they leave untouched -- so an operator opening the outcome learns
/// both that a person released the plan and that the plan actually moved. The
/// record is copied whole; only the last byte is this run's own, since a plan
/// able to author the release it obeys would be releasing itself.
pub fn abate_note(io: std.Io, record: [max_answers_bytes]u8) NoteError!void {
    const bytes = abates_bytes(record);
    try seat_note(io, plan_name, ".abate", &bytes);
}

/// Reads the abatement this run wrote, or nothing at all.
///
/// The read an operator makes of the outcome, and the read this run makes of its
/// own note before it lets a single wall fall.
pub fn abate_standing(io: std.Io) ?[max_abates_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".abate") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_abates_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an abatement never outgrows the record it acts on
    assert(got <= max_abates_bytes);
    if (got < max_abates_bytes) return null;
    return bytes;
}

/// Takes down a recorded abatement, so a lap begins with the outcome silent.
pub fn clear_abate(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".abate") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Books a matter open again, in a note addressed to the run after this one.
///
/// Four bytes into `plan.again`, seated among the plan's own notes, because the
/// run that inherits it is this plan's own next run. It is the second note in
/// the whole arc written for a run that has not started -- and the first whose
/// content came from outside the plan entirely.
pub fn reopen_note(io: std.Io, word: [max_suits_bytes]u8) NoteError!void {
    const bytes = again_bytes(word);
    try seat_note(io, plan_name, ".again", &bytes);
}

/// Reads the matter a run inherits as reopened, or nothing at all.
///
/// The read an operator makes beside the settlement, and the read this run makes
/// of its own note before the report believes anything was taken up.
pub fn again_standing(io: std.Io) ?[max_again_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".again") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_again_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a reopening note never outgrows the word it carries
    assert(got <= max_again_bytes);
    if (got < max_again_bytes) return null;
    return bytes;
}

/// Takes down the reopening note, because the word it carries is gone.
pub fn clear_reopen(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".again") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the receipt of a second look, where a later run reads it.
///
/// Four bytes into `plan.anew`, seated among the plan's own notes beside the
/// reopening it answers. The receipt is a record about a matter rather than a
/// matter of its own, so it carries the reopened word unchanged.
pub fn reweigh_note(io: std.Io, opened: [max_again_bytes]u8) NoteError!void {
    const bytes = anew_bytes(opened);
    try seat_note(io, plan_name, ".anew", &bytes);
}

/// Reads the second look a later run finds, or nothing at all.
pub fn anew_standing(io: std.Io) ?[max_anew_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".anew") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_anew_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a second look's receipt never outgrows the matter it answers
    assert(got <= max_anew_bytes);
    if (got < max_anew_bytes) return null;
    return bytes;
}

/// Takes down the receipt, because the matter it answers is gone.
pub fn clear_reweigh(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".anew") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Clears what one reader was told, so a lap begins with a reader who has heard
/// nothing about how their quarrel came out.
pub fn clear_tidings(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = tell_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}


/// Writes the path of the reply one reader may leave to the answer they were
/// given.
pub fn press_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.press_path(@This(), buf, address);
}

/// Reads what one reader says to the answer they were given, or nothing at all.
///
/// The one act of this rung that reaches into a reader's own box, and it only
/// ever reads. A run learns a person's position by opening what that person
/// wrote, never by remembering what it expected them to write.
pub fn pressed_by(io: std.Io, address: []const u8) ?Plea {
    return ladder_checks.pressed_by(@This(), io, address);
}

/// Seats one reader's reply, in that reader's own hand.
///
/// **No run ever calls this**, and that restraint is the rung. A plea a
/// supervisor could file for its reader settles nothing at all -- it is the plan
/// answering the plan, and then reading its own handwriting back as consent. The
/// supervisor's whole part is to send the outcome plainly, open the box, and
/// report honestly when it finds it empty.
pub fn press_as_reader(io: std.Io, address: []const u8, plea: Plea) NoteError!void {
    // invariant: a reply is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try press_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{plea_byte(plea)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's reply, so a lap begins with a reader who has said nothing
/// about how their quarrel came out.
pub fn clear_press(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = press_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes where the reader who raised the quarrel stands once it is over.
///
/// One byte into `plan.appeal`, written where an operator opens the plan rather
/// than where the correspondence lives: `a` for an outcome its reader accepts
/// and `p` for a quarrel they press still. Every other note of this arc that an
/// operator reads carries the plan's own findings; this one carries a living
/// person's position, quoted rather than composed.
pub fn appeal_note(io: std.Io, plea: Plea) NoteError!void {
    try seat_note(io, plan_name, ".appeal", &[_]u8{plea_byte(plea)});
}

/// Reads the plea standing on this plan's own answer, or nothing at all.
///
/// A run that reads nothing here heard nobody, and says so with a null rather
/// than by guessing -- which leaves the record exactly where the rung below
/// leaves it, silent about whether anybody accepted a word of it.
pub fn appeal_published(io: std.Io) ?Plea {
    return ladder_checks.appeal_published(@This(), io);
}

/// Carries one position past the run that heard it.
///
/// One byte into `plan.standing`, which is the only note of this arc a
/// provisioning leaves alone. Every other note an operator opens is a finding of
/// the run that wrote it; this one is a living person's statement that the
/// matter is not over, quoted rather than composed, and it is written here so
/// the run after this one opens already knowing.
pub fn standing_note(io: std.Io, plea: Plea) NoteError!void {
    return ladder_checks.standing_note(@This(), io, plea);
}

/// Reads the position standing over this plan from any run at all, or nothing.
///
/// The one read of this arc that may answer with a word no run of this plan
/// wrote. A run opening this note is reading what somebody told an earlier run,
/// which is the whole point -- and it says so with a null rather than by
/// guessing when nobody has ever pressed anything here.
pub fn position_standing(io: std.Io) ?Plea {
    return ladder_checks.position_standing(@This(), io);
}

/// Clears the standing position, so a lap begins with a plan nobody has pressed
/// a quarrel against.
///
/// **No run of this plan ever calls this.** A supervisor that could drop a
/// standing position would be closing a quarrel on its holder's behalf, which is
/// exactly the forgetting this rung exists to end. The selftest harness calls it
/// to open a lap honestly, standing in for a fresh tree.
pub fn clear_standing(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".standing") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Takes down a standing position, because its holder let it go.
///
/// The one act of this whole arc that closes a quarrel, and it is the same
/// single gesture `clear_standing` makes -- deliberately, since a withdrawal
/// leaves exactly the note a fresh tree leaves, with nothing standing and
/// nothing claimed. What separates them is entirely who asked: the harness call
/// above stands in for a fresh tree, and this one runs only where a living
/// person's own hand has written that the matter is over.
///
/// **No run reaches this on its own reading.** The caller weighs the holder's
/// box first, refuses by name where that box says otherwise, and reads the note
/// back afterward before believing a word of it.
pub fn release_standing(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".standing") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
    // **The age falls with the quarrel.** A count of runs stood through is a
    // fact about one position, so it leaves with that position rather than
    // outliving it -- and a quarrel raised tomorrow begins at nothing, as every
    // new quarrel should.
    clear_dwell(io);
    // **And the standing falls with it too.** A herald says how loudly one
    // position reads; a position that is over reads at no volume at all, and a
    // byte left behind beside the outcome would go on shouting for a quarrel
    // its own holder let go.
    clear_swell(io);
}

/// Writes how long the position standing over this plan has stood, in runs.
///
/// One byte into `plan.dwell`, seated beside the standing note and living
/// exactly as long as it does. A provisioning leaves both alone, since the age
/// of a quarrel belongs to the quarrel rather than to any run that met it; a
/// withdrawal takes both down together.
pub fn dwell_note(io: std.Io, runs: u32) NoteError!void {
    return ladder_checks.dwell_note(@This(), io, runs);
}

/// Reads how long the position standing over this plan has stood, or nothing.
///
/// A run that reads nothing here has met a quarrel no run has yet dated, and
/// says so with a null rather than by calling it new -- which is the honest
/// reading, since an undated position may have stood since long before this
/// wire learned to count.
pub fn dwell_published(io: std.Io) ?u32 {
    return ladder_checks.dwell_published(@This(), io);
}

/// Takes down the age beside a position, because the position itself is gone.
///
/// The harness call a fresh tree stands in for, and the same gesture
/// `release_standing` makes above -- kept separate so a test may clear an age
/// without closing anybody's quarrel.
pub fn clear_dwell(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".dwell") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes how loudly the quarrel standing over this plan reads.
///
/// One byte into `plan.swell`, seated among the plan's own notes beside the
/// settlement and the regard -- the place an operator actually opens to learn
/// what the run came to. The age itself keeps its own note; this says what that
/// age amounts to, where the reading costs nobody a second file to know about.
pub fn swell_note(io: std.Io, volume: Volume) NoteError!void {
    try seat_note(io, plan_name, ".swell", &[_]u8{volume_byte(volume)});
}

/// Reads how loudly the quarrel standing over this plan reads, or nothing.
///
/// A run that reads nothing here has met a plan whose standing no run has yet
/// published, and says so with a null rather than by calling it quiet -- which
/// is the honest reading, since an unpublished position may have outlasted a
/// season.
pub fn swell_published(io: std.Io) ?Volume {
    return ladder_checks.swell_published(@This(), io);
}

/// Takes down the standing beside a position, because the position is gone.
///
/// The harness call a fresh tree stands in for, and the same gesture
/// `release_standing` makes above -- kept separate so a test may quiet a plan
/// without closing anybody's quarrel.
pub fn clear_swell(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".swell") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Reads the forum a long-standing quarrel is referred to, or nothing at all.
///
/// **No run ever writes this**, and that restraint is the rung. A supervisor
/// that could name the hand weighing an objection against it has named its own
/// judge, and the naming is the whole of what a judge does. The address stands
/// on the wire in `plan.forum`, seated by an operator before any quarrel
/// existed, and a run's entire part is to read it and to say plainly when it
/// finds nothing.
pub fn forum_published(io: std.Io, out: *[max_address_len]u8) ?[]const u8 {
    return ladder_checks.forum_published(@This(), io, out);
}

/// Seats the forum a long-standing quarrel would be referred to.
///
/// The operator's hand, and a lap standing one up mid-history -- never a run's.
/// It is named here so the wire a run reads can be written honestly by somebody
/// outside the argument, and so a plan with no forum at all is a real
/// configuration rather than an impossible one.
pub fn seat_forum(io: std.Io, forum: []const u8) NoteError!void {
    // invariant: a forum is only ever seated for an address a run may carry to
    assert(addressable(forum));
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".forum", forum);
}

/// Takes down the forum, so a lap may run a plan that names no third hand.
pub fn clear_forum(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".forum") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the case one forum is handed.
///
/// A box outside `note_dir`, exactly as a reader's own box is, and for the same
/// reason one tier further out: a referral lands where the third hand is rather
/// than where either party keeps its records. The address is bounded and
/// checked before a byte of it reaches a path.
pub fn case_path(buf: *[max_note_path_len]u8, forum: []const u8) NoteError![]const u8 {
    // invariant: a case is only ever built for an address a run may carry to
    assert(addressable(forum));
    const suffix = ".case";
    const total = reader_dir.len + 1 + forum.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (forum) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a case path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Carries the case to the forum's own box, outside both parties entirely.
///
/// The one reach this rung makes past the argument, and the shape of its whole
/// claim: three bytes copied off the wire land on a desk that has said nothing
/// yet. The directory is made first, since a forum may be named long before any
/// run of this plan has provisioned a thing.
pub fn refer_note(io: std.Io, forum: []const u8, case: [max_referral_bytes]u8) NoteError!void {
    return ladder_checks.refer_note(@This(), io, forum, case);
}

/// Reads the case standing in one forum's box, or nothing at all.
///
/// A run that reads nothing here has referred nothing, and says so with a null
/// rather than by believing its own delivery -- since a case sent and a case
/// standing on somebody's desk are two facts, and only the second one is about
/// a hand outside the argument.
pub fn case_delivered(io: std.Io, forum: []const u8) ?[max_referral_bytes]u8 {
    return ladder_checks.case_delivered(@This(), io, forum);
}

/// Clears one forum's box, so a lap begins with a hand that holds no case.
pub fn clear_case(io: std.Io, forum: []const u8) void {
    if (!addressable(forum)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = case_path(&path_buf, forum) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the box one forum leaves its finding in.
///
/// Beside the case it answers, in the same box outside both parties, so a third
/// hand keeps the argument and its own answer to it in one place. The address is
/// bounded and checked before a byte of it reaches a path.
fn finding_path(buf: *[max_note_path_len]u8, forum: []const u8) NoteError![]const u8 {
    // invariant: a finding box is only ever built for an address a run may read
    assert(addressable(forum));
    const suffix = ".deem";
    const total = reader_dir.len + 1 + forum.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (forum) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a finding path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// The third hand's own answer, written in their box by their own hand.
///
/// **No run of this plan ever calls this**, and that restraint is the rung. It
/// is named here so a hand outside the argument can answer honestly on the same
/// wire, and so a plan facing a desk that has said nothing yet is a real
/// configuration rather than an impossible one.
pub fn answer_as_forum(io: std.Io, forum: []const u8, finding: [max_finding_bytes]u8) NoteError!void {
    // invariant: a finding is only ever left at an address a run may read
    assert(addressable(forum));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try finding_path(&path_buf, forum);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &finding, 0) catch return error.NoteUnavailable;
}

/// Reads the finding standing in one forum's box, or nothing at all.
///
/// A run that reads nothing here has been answered by nobody, and says so with
/// a null rather than by supplying a verdict of its own -- since a case sent and
/// a case answered are two facts, and only the second one is about what a hand
/// outside the argument actually thinks.
pub fn finding_written(io: std.Io, forum: []const u8) ?[max_finding_bytes]u8 {
    if (!addressable(forum)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = finding_path(&path_buf, forum) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_finding_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a finding never outgrows the case and the verdict it carries
    assert(got <= max_finding_bytes);
    if (got < max_finding_bytes) return null;
    return bytes;
}

/// Clears one forum's finding, so a lap begins with a desk that has said nothing.
pub fn clear_finding(io: std.Io, forum: []const u8) void {
    if (!addressable(forum)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = finding_path(&path_buf, forum) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what a hand outside the argument made of this plan's case.
///
/// One byte into `plan.deem`, seated among the plan's own notes beside the
/// settlement, the regard, and the standing -- the place an operator actually
/// opens to learn what the run came to. The case keeps its own box on a third
/// hand's desk; this says what came back from it, where the reading costs nobody
/// a second file to know about.
pub fn deem_note(io: std.Io, finding: Finding) NoteError!void {
    try seat_note(io, plan_name, ".deem", &[_]u8{finding_byte(finding)});
}

/// Reads what a hand outside the argument made of this plan's case, or nothing.
///
/// A run that reads nothing here has met a plan nobody outside the argument has
/// answered, and says so with a null rather than by calling the word upheld or
/// overruled -- which is the honest reading, since an unanswered case may be
/// sitting on a desk that simply has not opened it yet.
pub fn deem_published(io: std.Io) ?Finding {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".deem") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a finding never outgrows the one byte it is published in
    assert(got <= 1);
    if (got < 1) return null;
    return finding_of_byte(bytes[0]);
}

/// Takes down the finding beside a plan, because the argument it answered is gone.
pub fn clear_deem(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".deem") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what this plan makes of the finding standing against it.
///
/// Two bytes into `plan.avow`, seated among the plan's own notes beside the
/// settlement, the standing, and the finding itself -- the place an operator
/// actually opens to learn what the run came to. The finding keeps its own box
/// on a third hand's desk and its own published byte beside the outcome; this
/// says what the plan answered to it, in the plan's own hand and nobody else's.
pub fn avow_note(io: std.Io, finding: Finding, avow: Avow) NoteError!void {
    // invariant: only a plan with something to say ever writes an avowal
    assert(avow != .mute);
    const bytes = avowal_bytes(finding, avow);
    try seat_note(io, plan_name, ".avow", &bytes);
}

/// Reads what this plan answered to the finding against it, or nothing at all.
///
/// A run that reads nothing here has met a plan that has said nothing about the
/// verdict it published, and says so with a null rather than by calling that
/// silence agreement -- which is the honest reading, since a plan that never
/// spoke has taken no position whatever.
pub fn avow_written(io: std.Io) ?[max_avowal_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".avow") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_avowal_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an avowal never outgrows the finding and the word it carries
    assert(got <= max_avowal_bytes);
    if (got < max_avowal_bytes) return null;
    return bytes;
}

/// Takes down the plan's own word, because the finding it answered is gone.
pub fn clear_avow(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".avow") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Books the debt this plan's own concession leaves for the run after it.
///
/// Two bytes into `plan.owe`, seated among the plan's own notes beside the
/// settlement, the finding, and the word the plan answered with. Everything else
/// this arc writes is a record *of* the run that wrote it; this one is written
/// for a run that has not started yet, which is the whole reason it exists.
pub fn owe_note(io: std.Io, finding: Finding, settlement: Settlement) NoteError!void {
    const bytes = debt_bytes(finding, settlement);
    try seat_note(io, plan_name, ".owe", &bytes);
}

/// Reads the debt standing against this plan, or nothing at all.
///
/// A run that reads nothing here has met a plan owing the work no further look,
/// and says so with a null rather than by calling that silence a clean record --
/// which is the honest reading, since a plan that never conceded has admitted
/// nothing to meet.
pub fn debt_standing(io: std.Io) ?[max_debt_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".owe") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_debt_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a debt never outgrows the finding and the outcome it names
    assert(got <= max_debt_bytes);
    if (got < max_debt_bytes) return null;
    return bytes;
}

/// Takes down the debt, because the concession it carries is gone.
pub fn clear_owe(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".owe") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Records that this run met the debt it opened holding.
///
/// Two bytes into `plan.met`, seated among the plan's own notes beside the debt
/// it answers. The debt itself comes down in the same breath, and the order
/// matters: the receipt is written first, so a run that fell between the two
/// acts leaves a question still open rather than an admission quietly gone.
pub fn met_note(io: std.Io, owed: [max_debt_bytes]u8) NoteError!void {
    const bytes = met_bytes(owed);
    try seat_note(io, plan_name, ".met", &bytes);
}

/// Reads what this plan met of the debt it inherited, or nothing at all.
///
/// A run that reads nothing here has met a plan that has looked at no standing
/// admission, and says so with a null rather than by calling that silence an
/// answer -- which is the honest reading, since a plan that never met a debt has
/// closed no question whatever.
pub fn meeting_written(io: std.Io) ?[max_met_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".met") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_met_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a meeting never outgrows the debt it answers
    assert(got <= max_met_bytes);
    if (got < max_met_bytes) return null;
    return bytes;
}

/// Takes down the meeting, because the debt it answered is gone.
pub fn clear_met(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".met") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Records what this run's look at the debt it met came to.
///
/// Three bytes into `plan.redress`, seated among the plan's own notes beside the
/// receipt it speaks about. The receipt stays exactly where the rung below wrote
/// it, since a redress reports on a meeting rather than replacing one -- so a
/// later reader may lay the two side by side and see both that the admission was
/// looked at and what the look found.
pub fn redress_note(io: std.Io, met: [max_met_bytes]u8, upshot: Upshot) NoteError!void {
    const bytes = redress_bytes(met, upshot);
    try seat_note(io, plan_name, ".redress", &bytes);
}

/// Reads what this plan made of the debt it met, or nothing at all.
///
/// A run that reads nothing here has met a plan that closed its admission in
/// silence, and says so with a null rather than by calling that silence a
/// finding -- which is the honest reading, since a meeting nobody reported on
/// has told the work nothing whatever.
pub fn redress_written(io: std.Io) ?[max_redress_bytes]u8 {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".redress") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [max_redress_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a redress never outgrows the meeting it reports on
    assert(got <= max_redress_bytes);
    if (got < max_redress_bytes) return null;
    return bytes;
}

/// Takes down the redress, because the meeting it reported on is gone.
pub fn clear_redress(io: std.Io) void {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".redress") catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what this plan's own word stands in, beside the word itself.
///
/// One byte into `plan.regard`, seated among the plan's own notes rather than in
/// any reader's box, because the person this is written for is the operator who
/// opens the outcome. The settlement says what the work came to; this says what
/// company that word keeps.
pub fn regard_note(io: std.Io, regard: Regard) NoteError!void {
    return ladder_checks.regard_note(@This(), io, regard);
}

/// Reads what this plan's word stands in, or nothing at all.
///
/// The read an operator makes beside the settlement, and the read this run makes
/// of its own note before the report believes a word of it. A plan nobody has
/// pressed a quarrel against answers with a null rather than by claiming its
/// word stands alone, since the honest reading of an empty note is that no run
/// has said anything yet.
pub fn regard_published(io: std.Io) ?Regard {
    return ladder_checks.regard_published(@This(), io);
}
// =========================================================================
// The supervisor -- a record that answers for the work its conferrals never
// bought
// =========================================================================

/// One dependent already reaped, held until the whole record has drained.
const Finished = struct {
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
    code: u8,
};

/// Folds one reaped outcome into the report, or names the mismatch.
pub fn judge_outcome(done: Finished, report_out: *Report) RunError!void {
    // invariant: a judged dependent always names its domain
    assert(done.domain.len >= 1);
    // invariant: the report never counts more successes than dependents reaped
    assert(run_of(report_out).succeeded <= run_of(report_out).reaped);
    if (done.code != done.expect) {
        print("    {s}: expected {s}, heard {s}\n", .{
            done.domain, outcome_name(done.expect), outcome_name(done.code),
        });
        return error.OutcomeMismatch;
    }
    if (done.code == carry.Outcome.carried_ok) {
        run_of(report_out).succeeded += 1;
        if (done.verb == .home) run_of(report_out).homed += done.count;
    }
}

/// The queue's own bookkeeping for one run, over dependents whose conferrals
/// may leave with them.
pub const Table = struct {
    live: [max_in_flight]cohort.Running = undefined,
    lines: [max_in_flight]Task = undefined,
    reserves: [max_in_flight]?Task = @splat(null),
    taken: [max_in_flight]u32 = @splat(0),
    served: [max_in_flight]u32 = @splat(0),
    granted: [max_in_flight]u32 = @splat(0),
    absorbed_mask: [max_in_flight]u32 = @splat(0),
    in_flight: u32 = 0,
    done: [max_queue_len]Finished = undefined,
    finished: u32 = 0,
    started: [max_queue_len]bool = @splat(false),
    record: [max_queue_len]unhand.Phase = undefined,
    reserve_of: [max_queue_len]?Task = @splat(null),
    held: u32 = 0,
    head: u32 = 0,
    left: u32 = 0,
    lost_mask: u32 = 0,
    bear_mask: u32 = 0,
};

/// The record as it stands right now.
pub fn standing(table: *const Table) []const unhand.Phase {
    // invariant: a record never outgrows the queue one supervisor may hold
    assert(table.held <= max_queue_len);
    return table.record[0..table.held];
}

/// Answers whether one phase of the record is still work waiting to run.
fn waits(table: *const Table, at: u32) bool {
    // invariant: a reading always names a phase inside the record
    assert(at < table.held);
    return !table.started[at];
}

/// Moves the head past every item already started.
pub fn advance_head(table: *Table) void {
    // invariant: a head never walks past the record it reads
    assert(table.head <= table.held);
    while (table.head < table.held and !waits(table, table.head)) table.head += 1;
}

/// Answers whether a phase of a turn this pick's turn names still waits.
pub fn elder_waits(table: *const Table, pick: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    const wanted = table.record[pick].follows_turns;
    if (wanted == 0) return false;
    var i: u32 = 0;
    while (i < table.held) : (i += 1) {
        if (i == pick) continue;
        if (!waits(table, i)) continue;
        if ((wanted & turn_bit(table.record[i].turn)) != 0) return true;
    }
    // invariant: the walk read the whole record, weighing every phase in it
    assert(i == table.held);
    return false;
}

/// Answers whether a sibling of this pick's own turn still waits behind it.
pub fn sibling_waits(table: *const Table, pick: u32, sibling_mask: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    var i: u32 = 0;
    while (i < pick) : (i += 1) {
        if (!waits(table, i)) continue;
        if (table.record[i].turn != table.record[pick].turn) continue;
        if ((sibling_mask & mask.step_bit(table.record[i].step)) != 0) return true;
    }
    // invariant: the walk reached the pick, weighing every phase before it
    assert(i == pick);
    return false;
}

/// Answers whether the door admits this phase over the lines remembered.
pub fn door_admits(sys: *const system.System, table: *const Table, at: u32) RunError!bool {
    // invariant: a candidate always stands inside the record
    assert(at < table.held);
    // invariant: a run never remembers more lines than it may hold
    assert(table.in_flight <= max_in_flight);
    return admissible_in(
        sys,
        table.live[0..table.in_flight],
        table.lines[0..table.in_flight],
        table.reserves[0..table.in_flight],
        table.taken[0..table.in_flight],
        table.record[at].task,
    );
}

/// Answers whether a phase may be admitted ahead of the record's head.
fn may_pass(
    sys: *const system.System,
    table: *const Table,
    candidate: u32,
    reading: Reading,
) bool {
    // invariant: a pass always reaches forward, never at the head itself
    assert(candidate > table.head);
    // invariant: a candidate always stands inside the record
    assert(candidate < table.held);
    var i: u32 = table.head;
    while (i < candidate) : (i += 1) {
        if (!waits(table, i)) continue;
        if (items_contend(sys, table.record[i], table.record[candidate], reading)) return false;
    }
    // invariant: the walk reached the candidate, weighing every phase before it
    assert(i == candidate);
    return true;
}

/// Chooses one phase from behind a blocked head, or answers that none may go.
pub fn choose_pass(
    sys: *const system.System,
    table: *const Table,
    reading: Reading,
) RunError!?u32 {
    // invariant: a pass is only ever sought while the head stands blocked
    assert(table.head < table.held);
    // invariant: a pass never looks past the record it reads
    assert(table.head < max_queue_len);
    var looked: u32 = 0;
    var i: u32 = table.head + 1;
    while (i < table.held and looked < max_lookahead) : (i += 1) {
        if (!waits(table, i)) continue;
        looked += 1;
        if (!try door_admits(sys, table, i)) continue;
        if (!may_pass(sys, table, i, reading)) continue;
        return i;
    }
    // invariant: the look stayed inside the bound it was given
    assert(looked <= max_lookahead);
    return null;
}

/// Answers which standing dependent could carry this phase, if any could.
pub fn confer_slot(table: *const Table, at: u32) ?u32 {
    return ladder_checks.confer_slot(@This(), table, at);
}

/// Takes back the reach one standing dependent no longer needs, from the rung
/// below -- kept whole here, since a reclamation is what happens after it.
pub fn revoke_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    keep: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a revocation always names a dependent the run is holding
    assert(slot < table.in_flight);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    if (revoke_rung.revoke_refusal(table.taken[slot], table.served[slot], keep)) |why| return why;
    const returning = table.taken[slot] - keep;
    // invariant: a revocation that reaches this point always returns reach
    assert(returning >= 1);
    try revoke(io, table.live[slot].domain, keep);
    if (!confirm_pruned(io, table.live[slot].domain, returning)) return error.RevokeUnpruned;
    table.taken[slot] = keep;
    table.served[slot] = keep;
    abandoning_of(report_out).inner.inner.revoked += returning;
}

/// Takes one departed dependent's conferral back whole, so a successor of its
/// domain opens its eyes on a bare wire.
///
/// The rung below reaches into a standing dependent's hands; this one reaches
/// into the wire the two of them spoke over, once the dependent that listened
/// is gone. `slot` names the reaped dependent, whose row still stands in the
/// table until the reaping closes over it.
pub fn reclaim_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reclaim_one(@This(), io, table, slot, report_out);
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
pub fn confer_one(
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *Table,
    slot: u32,
    at: u32,
    keeping: Keep,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.confer_one(@This(), io, sys, caps, table, slot, at, keeping, report_out);
}

/// Starts one phase, handing the capability words this reach calls for and
/// promising the pruning this keep calls for.
pub fn start_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?Task,
    keeping: Keep,
    wake: gap.Wake,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    return ladder_checks.start_one(@This(), allocator, io, self_path, sys, caps, phase, reserve, keeping, wake, report_out);
}

/// Admits as much of the record as the table and the reading allow, and
/// answers how many phases it took up.
pub fn fill_table(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!u32 {
    return ladder_checks.fill_table(
        @This(), allocator, io, self_path, sys, caps, wake, reading, keeping, table, report_out,
    );
}

/// Records one departed dependent's abandoned reach, and reads the answer back.
///
/// The reclamation above has already swept this domain clean, so the count is
/// written after it rather than before -- otherwise the very act that closes
/// the conferral would erase the only evidence of what it cost. The answer is
/// read back from the wire before the report believes it.
pub fn abandon_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    came_home: bool,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.abandon_one(@This(), io, table, slot, came_home, report_out);
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
pub fn reap_oldest(
    io: std.Io,
    table: *Table,
    answer: Answer,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError)!void {
    return ladder_checks.reap_oldest(@This(), io, table, answer, report_out);
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
pub fn seat_the_ground(
    io: std.Io,
    sys: *const system.System,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError)!capabilities.CapabilityTable {
    return ladder_checks.seat_the_ground(@This(), io, sys, report_out);
}

/// Reads a written plan into the table's own record, closed and seated.
///
/// The plan is flattened to the shape the rungs below read, weighed for order
/// and for the names it keeps, closed over its own turns, and its reserves
/// carried across -- all before a single dependent is spawned, so the record a
/// run enforces is the record its author wrote.
pub fn seat_the_record(base: []const Phase, table: *Table) RunError!void {
    return ladder_checks.seat_the_record(@This(), base, table);
}


/// Carries the finding this run reached to the reader who won the admission.
///
/// **It runs after the redress above it, and it reads that redress's own note.**
/// Only a finding actually written can be carried, so this rung takes its
/// subject off the wire rather than from anything the plan asked for -- and a
/// run that reported on nothing carries nothing at all, which is the honest
/// ending rather than a letter with nothing in it.
///
/// The wire before the memory, exactly as the rungs beneath it: this run reads
/// the finding actually standing rather than remembering one, reads the address
/// out of the note that names it, writes the same three bytes into that reader's
/// own box, and reads the box back before the report believes anybody was told.
///
/// **The plan's own note stays exactly where the redress left it.** An apprising
/// carries a finding outward rather than moving one, so both stand together:
/// the record where the next run reads it, and the delivery where its reader
/// does. The number it moves is the finding a plan reached whose raiser was
/// never told.
pub fn apprise_the_raiser(io: std.Io, apprise: Apprise, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.apprise_the_raiser(@This(), io, apprise, report_out);
}

/// Reads what the reader carried this run's answer makes of it.
///
/// **It runs after the apprising above it, and it reads that apprising's own
/// delivery.** Only an answer actually carried can be weighed, so this rung
/// takes its subject off the wire rather than from anything the plan asked for
/// -- and a run that told nobody weighs nothing at all, which is the honest
/// ending rather than a verdict about a letter never sent.
///
/// **The word itself comes from the reader and never from the run.** This run
/// opens that reader's own box, finds the word their hand left there, checks it
/// weighs the answer this run actually carried, and publishes it where the
/// settlement is read. A supervisor able to author this byte would be grading
/// its own answer, which is the harm the whole arc is built against.
///
/// **The reader keeps their own word exactly where they wrote it.** A weighing
/// carries a verdict inward rather than moving one, so both stand together: the
/// word in the reader's hand, and the plan's copy where an operator opens it.
/// The number it moves is the answer a plan carried whose worth it never
/// learned.
pub fn weigh_the_answer(io: std.Io, suffice: Suffice, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.weigh_the_answer(@This(), io, suffice, report_out);
}

/// Takes the matter up again when this run's reader says the answer falls short.
///
/// **It runs after the weighing above it, and it reads that weighing's own
/// word.** Only a verdict actually read can reopen anything, so this rung takes
/// its subject off the wire rather than from anything the plan asked for -- and
/// a run whose reader was never asked takes up nothing at all, which is the
/// honest ending rather than a booking about a word nobody spoke.
///
/// **A reader who says the answer settles the matter leaves nothing to take
/// up.** Booking a matter open there would punish a plan for asking and teach
/// every supervisor never to ask, which would undo the rung below in a single
/// lap. So satisfaction costs nothing, and dissatisfaction costs exactly one
/// more look.
///
/// **The note is addressed forward, and its content came from outside.** It is
/// the second note in the arc written for a run that has not started, and the
/// first whose every byte was written by a hand the plan does not own. That is
/// the whole rung: a reader may open a matter the plan itself had closed.
///
/// **Booking is not answering.** The note says the matter is owed another look
/// and never decides what that look finds -- the settlement, the quarrel, its
/// age, its standing, the case on the desk, the finding, the plan's own word,
/// the concession, the meeting, the redress, the delivery, and the reader's own
/// verdict each come out of a reopening run exactly as they went in.
pub fn take_up_again(io: std.Io, reopen: Reopen, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.take_up_again(@This(), io, reopen, report_out);
}

/// Says what this run's look at the debt it met came to.
///
/// **It runs after the meeting above it, and it reads that meeting's own
/// receipt.** Only a debt actually met can have an upshot, so this rung takes
/// its subject off the wire rather than from anything the plan asked for -- and
/// a run that met nothing writes nothing at all, which is the honest ending
/// rather than a silence dressed as a finding.
///
/// The wire before the memory, exactly as the rungs beneath it: this run reads
/// the receipt actually standing rather than remembering one, weighs its own
/// outcome before making the stronger of the two claims, writes the finding
/// where a later run will read it, and reads that note back before the report
/// believes a byte of it.
///
/// **The receipt stays exactly where the meeting left it.** A redress reports on
/// a meeting rather than replacing one, so both notes stand together: one saying
/// the admission was looked at, the other saying what the look found. The number
/// it moves is the debt a plan met whose meeting never said what it found.
pub fn redress_the_meeting(io: std.Io, redress: Redress, upshot: Upshot, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.redress_the_meeting(@This(), io, redress, upshot, report_out);
}

/// Meets the debt this run opened holding, before it books one of its own.
///
/// **It runs ahead of the booking above it, and the ordering is the rung.** The
/// debt on the wire is the debt this run inherited right up until the moment
/// this run writes its own -- so a run that booked first would meet today's
/// concession and call yesterday's answered. Everything else in `close_the
/// _quarrel` is ordered by what reads well; this one is ordered by what is true.
///
/// The wire before the memory, exactly as the rungs beneath it: this run reads
/// the debt actually standing rather than remembering one, weighs its own
/// settlement before claiming to have met anything, writes the receipt where a
/// later run will find it, takes the debt down, and reads both notes back before
/// the report believes a byte of it.
///
/// **A plan inheriting nothing meets nothing** -- an ending this rung reaches by
/// writing nothing at all, since only a standing admission can be answered. The
/// number it moves is the debt a plan inherited that the run never met.
pub fn meet_the_debt(io: std.Io, meet: Meet, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.meet_the_debt(@This(), io, meet, report_out);
}

/// Looks again at a matter this run inherited as reopened.
///
/// **It runs after the reopening below it, and it reads that reopening's own
/// note.** Only a matter actually standing on the wire can be looked at again,
/// so this rung takes its subject off the wire rather than from anything the
/// plan asked for -- and a run that inherited nothing looks at nothing at all,
/// which is the honest ending rather than a receipt about a question nobody
/// reopened.
///
/// **A run earns the second look by finishing its own.** A supervisor that has
/// published no outcome has nothing to weigh the reopened matter against, and
/// calling that a second look would file a fresh answer over a question this run
/// never actually re-asked. `ReweighUnsettled` refuses by name.
///
/// **The taking down is the act, and the receipt is only its record.** A second
/// look written beside a matter still standing open would have every run after
/// this one inherit a reopening already answered, and answer it again forever.
///
/// **Looking again is not deciding again.** The receipt says the matter was
/// taken up a second time and never rewrites what the first look found -- the
/// settlement, the quarrel, its age, its standing, the case on the desk, the
/// finding, the plan's own word, the concession, the meeting, the redress, the
/// delivery, and the reader's own verdict each come out of a reweighing run
/// exactly as they went in.
pub fn look_again(io: std.Io, reweigh: Reweigh, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.look_again(@This(), io, reweigh, report_out);
}

/// Carries what the second look came to out to the reader who asked for it.
///
/// **It runs after the looking below it, and it reads that looking's own
/// receipt.** Only a second look actually receipted can be told of, so this rung
/// takes its subject off the wire rather than from anything the plan asked for
/// -- and a run that looked at nothing tells nobody anything, which is the
/// honest ending rather than a letter about a question nobody re-asked.
///
/// **The telling lands where the reader is.** Every note of this second look so
/// far lives among the plan's own records, in a place only a later run of this
/// plan opens; this one leaves for the reader's own box, which is what makes it
/// a telling rather than another entry in the file.
///
/// **Telling is not deciding.** The telling copies the receipt and rewrites
/// nothing -- the settlement, the quarrel, its age, its standing, the case on
/// the desk, the finding, the plan's own word, the concession, the meeting, the
/// redress, the delivery, the reader's own verdict, and the second look itself
/// each come out of a telling run exactly as they went in.
pub fn tell_the_reopener(io: std.Io, recount: Recount, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.tell_the_reopener(@This(), io, recount, report_out);
}

/// Reads what the reader made of the telling this run carried them.
///
/// **The reply is read where its writer left it, and published where the
/// settlement is read.** A run that stopped at the telling would leave an
/// operator an outcome silent about whether the matter it reopened is finally
/// closed -- and the reader's own answer sitting unopened in a box the whole
/// time, which is what makes the silence a cost rather than an impossibility.
///
/// **A run reads a reply only to a telling it actually made.** The telling
/// comes off the wire rather than out of the run's memory of having made one,
/// so a plan that carried nothing home reads nothing and says so.
/// `AllayUntold` refuses by name.
///
/// **A reader who wrote nothing is reported as silent**, never as content:
/// `AllaySilent`. And the word they did write must name this telling, since a
/// reply to a second look from a run before today would publish a verdict about
/// a question nobody re-asked this morning: `AllayMismatched`.
///
/// **Reading is not deciding.** The plan copies the byte its reader wrote and
/// rewrites nothing -- the telling stands, the receipt stands, the reader's
/// first verdict stands, and the settlement each run reaches is its own.
pub fn read_the_reply(io: std.Io, allay: Allay, report_out: *Report) (RunError || NoteError)!void {
    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const on_wire = if (addressable(where)) recounted_to(io, where) else null;
    const told_count: u32 = if (on_wire != null) 1 else 0;
    if (told_count == 0) {
        // invariant: a run that told nobody reads no reply
        assert(allay_of(report_out).read_back == 0);
        // invariant: a run that told nobody leaves no reply unheard
        assert(allay_of(report_out).unheard == 0);
        return;
    }

    // The measurement this rung moves, weighed against the telling actually
    // made rather than against anything the plan asked for, so a reply nobody
    // opens is counted rather than refused.
    allay_of(report_out).unheard = unheard_replies(told_count, allay);
    const replies_read = read_back_in(told_count, allay);
    const unread_count = unread_in(told_count, allay);
    if (allay == .unread) {
        // invariant: an unreading run opens nothing, however plainly it told
        assert(replies_read == 0);
        allay_of(report_out).unread = unread_count;
        return;
    }

    // The reader's own box before the plan's memory, and the telling before the
    // reply: both reads supply the ladder rather than short-circuiting it, so
    // every refusal below is reached by argument and named in its own order.
    const told = on_wire orelse return error.AllayUntold;
    const carried = true;
    const reply = rest_written(io, where);
    const spoken = rests_rest(reply) != null;
    const matched = rests_answers(reply, told);
    if (allay_refusal(told_count, replies_read, unread_count, carried, spoken, matched)) |why| return why;

    // invariant: a reading run has a word of its reader's to publish
    const word = rests_rest(reply) orelse return error.AllaySilent;
    // invariant: a reading run reads the one reply its telling earned
    assert(replies_read == 1);
    try allay_note(io, word);
    // The wire before the memory: the plan's own notes are read again before
    // the report believes it published anything at all.
    if (!allay_holds(rest_published(io), word)) return error.AllayMisrecorded;
    allay_of(report_out).read_back = replies_read;
    allay_of(report_out).unread = unread_count;
    // invariant: a reading run leaves no telling of its own unheard
    assert(allay_of(report_out).unheard == 0);
}

/// Hands the matter its reader left standing to the run that comes after.
///
/// **It runs after the reading below it, and it reads that reading's own
/// word.** Only a reply actually opened can be held back on, so this rung takes
/// its subject off the wire rather than from anything the plan asked for -- and
/// a run whose reader says the matter rests hands on nothing at all, which is
/// the honest ending rather than an argument kept alive past its close.
///
/// The wire before the memory, one tier further out than the reading above it:
/// this run opens the reader's own box, weighs the word standing there for a
/// matter still open rather than assuming one, writes what it declines to
/// re-ask into the note a provisioning leaves alone, and reads that note back
/// before the report believes a forbearance stands anywhere.
///
/// **Forbearing is holding back, and holding back is a record.** The run
/// decides nothing, overturns nothing, and answers nobody again -- it declines
/// to open the same question a third time from nothing, and leaves the decline
/// where the next run reads its inheritance.
pub fn hold_the_matter(io: std.Io, forbear: Forbear, report_out: *Report) (RunError || NoteError)!void {
    if (desist_of(report_out).walled >= 1) {
        // The wall stands, so the relay is stayed: a matter this correspondence
        // has carried twice without moving is handed to nobody. It is neither
        // forborne nor left unhanded -- it is bounded, which is this rung's own
        // third answer and the reason the count above stays honest.
        // invariant: a bounding run hands its walled matter on to nobody
        assert(forbear_of(report_out).forborne == 0);
        // invariant: a bounded matter is counted as walled rather than unhanded
        assert(forbear_of(report_out).unhanded == 0);
        return;
    }
    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const on_wire = if (addressable(where)) recounted_to(io, where) else null;
    const reply = if (on_wire != null) rest_written(io, where) else null;
    const word = rests_rest(reply);
    const standing_count: u32 = if (word) |said| (if (said == .stands) @as(u32, 1) else 0) else 0;
    if (standing_count == 0) {
        // invariant: a run reading no standing word hands on no forbearance
        assert(forbear_of(report_out).forborne == 0);
        // invariant: a run reading no standing word leaves no matter unhanded
        assert(forbear_of(report_out).unhanded == 0);
        return;
    }

    // The measurement this rung moves, weighed against the word actually
    // standing rather than against anything the plan asked for, so an impasse
    // nobody carries is counted rather than refused.
    forbear_of(report_out).unhanded = unhanded_matters(standing_count, forbear);
    const forborne_count = forborne_in(standing_count, forbear);
    const opened_count = opened_in(standing_count, forbear);
    if (forbear == .opens) {
        // invariant: an opening run hands on nothing, however plainly it read
        assert(forborne_count == 0);
        forbear_of(report_out).opened = opened_count;
        return;
    }

    // The reading before the word, and the word before the note: all three
    // reads supply the ladder rather than short-circuiting it, so every refusal
    // below is reached by argument and named in its own order.
    const opened_reply = allay_of(report_out).read_back >= 1;
    const stands = if (word) |said| said == .stands else false;
    const answered = reply orelse return error.ForbearUnread;
    const matched = rests_answers(reply, on_wire orelse return error.ForbearUnread);
    if (forbear_refusal(standing_count, forborne_count, opened_count, opened_reply, stands, matched)) |why| return why;

    // invariant: a forbearing run hands on the one matter its reader left standing
    assert(forborne_count == 1);
    try forbear_note(io, answered);
    // The wire before the memory, once more: the note the next run will open is
    // read back, and only then does the report believe a forbearance stands.
    if (!forbear_holds(hold_standing(io), holds_bytes(answered))) return error.ForbearMisrecorded;
    forbear_of(report_out).forborne = forborne_count;
    forbear_of(report_out).opened = opened_count;
    // invariant: a forbearing run leaves no matter of its own unhanded
    assert(forbear_of(report_out).unhanded == 0);
}

/// Names the impasse this run opened holding, where the outcome is read.
///
/// **It runs before the forbearing beneath it, and it reads that rung's own
/// note.** The forbearance a run inherits is on the wire the moment the run
/// begins; this rung opens it, publishes what it says beside the settlement,
/// and takes it down -- so the run may hand on a fresh impasse of its own
/// afterward without an operator ever confusing the two.
///
/// The wire before the memory, one tier further out than the forbearing above
/// it: this run opens the note the run before it addressed forward, weighs the
/// word standing in it rather than assuming one, publishes the mark among the
/// plan's own notes, and reads that mark back before the report believes it
/// named anything.
///
/// **The naming is the act, and the taking down is only its close.** The mark
/// lands first and the forbearance comes down after, so a run that falls
/// between the two leaves an impasse standing for the next hand rather than one
/// quietly gone.
pub fn mind_the_impasse(io: std.Io, mind: Mind, report_out: *Report) (RunError || NoteError)!void {
    const handed = hold_standing(io);
    const word = holds_rest(handed);
    const inherited_count: u32 = if (word) |said| (if (said == .stands) @as(u32, 1) else 0) else 0;
    if (inherited_count == 0) {
        // invariant: a run opening holding nothing names no impasse
        assert(mind_of(report_out).minded == 0);
        // invariant: a run opening holding nothing leaves no impasse unnamed
        assert(mind_of(report_out).unminded == 0);
        return;
    }

    // The measurement this rung moves, weighed against the forbearance actually
    // standing rather than against anything the plan asked for, so an impasse
    // nobody names is counted rather than refused.
    mind_of(report_out).unminded = unminded_impasses(inherited_count, mind);
    const minded_count = minded_in(inherited_count, mind);
    const begun_count = begun_in(inherited_count, mind);
    if (mind == .begins) {
        // invariant: a beginning run names nothing, however plainly it read
        assert(minded_count == 0);
        mind_of(report_out).begun = begun_count;
        return;
    }

    // The note before the word, and the word before the mark: all three reads
    // supply the ladder rather than short-circuiting it, so every refusal below
    // is reached by argument and named in its own order.
    const hold = handed orelse return error.MindUninherited;
    const stands = if (word) |said| said == .stands else false;
    // The mark names the matter it is about, and the only honest source for
    // that is the reader's own reply -- read where its writer left it, exactly
    // as the forbearing beneath it reads.
    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const reply = if (addressable(where)) rest_written(io, where) else null;
    const matched = if (reply) |said| holds_carries(handed, said) else false;
    if (mind_refusal(inherited_count, minded_count, begun_count, handed != null, stands, matched)) |why| return why;

    // invariant: a minding run names the one impasse it opened holding
    assert(minded_count == 1);
    try mind_note(io, hold);
    // The wire before the memory, once more: the mark an operator will read is
    // read back, and only then does the report believe an impasse was named.
    if (!mind_holds(mind_published(io), minds_bytes(hold))) return error.MindMisrecorded;
    // And only then does the inheritance come down, since a mark that never
    // landed would leave the next hand with neither the impasse nor the word.
    clear_forbear(io);
    mind_of(report_out).minded = minded_count;
    mind_of(report_out).begun = begun_count;
    // invariant: a minding run leaves no impasse of its own unnamed
    assert(mind_of(report_out).unminded == 0);
}

/// Stands a wall around the matter this run named for the second time.
///
/// **It runs after the minding beneath it, and it reads that rung's own
/// mark.** Only a matter actually named can be bounded, so this rung takes its
/// subject off the wire rather than from anything the plan asked for -- and it
/// weighs that mark against the one the run before today left, since a matter
/// two runs have named is a matter the correspondence has carried twice
/// without moving it.
///
/// The wire before the memory, one tier further out than the minding above it:
/// this run opens the mark it just published, weighs it against the elder mark
/// read before the minding wrote over it, confirms against the reader's own
/// word that the mark bounds the matter that reader refused, stands the wall
/// among the plan's own notes, and reads that wall back before the report
/// believes a boundary stands anywhere.
///
/// **The wall stands before the relay is stayed.** The boundary lands first and
/// the forbearing is withheld after, so a run that falls between the two hands
/// the matter on exactly as the rung below it always did.
pub fn bound_the_relay(io: std.Io, named_before: ?[max_minds_bytes]u8, desist: Desist, report_out: *Report) (RunError || NoteError)!void {
    const mark = mind_published(io);
    const named = mind_of(report_out).minded >= 1 and mark != null;
    if (!named) {
        // invariant: a run that named no impasse bounds nothing
        assert(desist_of(report_out).walled == 0);
        // invariant: a run that named no impasse leaves no relay unbounded
        assert(desist_of(report_out).unbounded == 0);
        return;
    }
    const this_mark = mark orelse return error.DesistUnnamed;
    const twice = came_round_twice(named_before, this_mark);
    const round_count: u32 = if (twice) 1 else 0;
    if (round_count == 0) {
        // The matter is on its first round, and the next run is owed its look.
        // invariant: a matter on its first round is relayed rather than walled
        assert(desist_of(report_out).walled == 0);
        // invariant: a first round leaves no twice-carried relay unbounded
        assert(desist_of(report_out).unbounded == 0);
        return;
    }

    // The measurement this rung moves, weighed against the marks actually
    // standing rather than against anything the plan asked for, so a matter
    // nobody bounds is counted rather than refused.
    desist_of(report_out).unbounded = unbounded_relays(round_count, desist);
    const walled_count = walled_in(round_count, desist);
    const relayed_count = relayed_in(round_count, desist);
    if (desist == .relays) {
        // invariant: a relaying run stands no wall, however plainly it read
        assert(walled_count == 0);
        desist_of(report_out).relayed = relayed_count;
        return;
    }

    // The mark before the elder, and the elder before the reader's own word:
    // all three reads supply the ladder rather than short-circuiting it, so
    // every refusal below is reached by argument and named in its own order.
    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const reply = if (addressable(where)) rest_written(io, where) else null;
    const matched = if (reply) |said| minds_carries(this_mark, holds_bytes(said)) else false;
    if (desist_refusal(round_count, walled_count, relayed_count, named, twice, matched)) |why| return why;

    // invariant: a bounding run walls the one matter it named twice over
    assert(walled_count == 1);
    try wall_note(io, this_mark);
    // The wire before the memory, once more: the wall an operator will read is
    // read back, and only then does the report believe a boundary stands.
    if (!desist_holds(wall_standing(io), walls_bytes(this_mark))) return error.DesistMisrecorded;
    desist_of(report_out).walled = walled_count;
    desist_of(report_out).relayed = relayed_count;
    // invariant: a bounding run leaves no relay of its own unbounded
    assert(desist_of(report_out).unbounded == 0);
}

/// Carries the wall this run stood out to the reader who can act on it.
///
/// **It runs after the bounding below it, and it reads that bounding's own
/// note.** Only a wall actually stood can be carried, so this rung takes its
/// subject off the wire rather than from anything the plan asked for -- and a
/// run that bounded nothing calls nobody at all, which is the honest ending
/// rather than a summons about a correspondence still running.
///
/// The wire before the memory, one tier further out than the bounding above it:
/// this run reads back the wall it just published, opens the reader's own box,
/// writes the call there, and reads that call back before the report believes a
/// person was reached.
///
/// **Beckoning is carrying, and carrying is a record.** The run decides nothing
/// and rewrites nothing -- it moves a boundary already stood from the drawer
/// only the plan opens into the box a person already reads.
pub fn carry_the_wall(io: std.Io, beckon: Beckon, report_out: *Report) (RunError || NoteError)!void {
    const wall = wall_standing(io);
    const stood = desist_of(report_out).walled >= 1 and wall != null;
    if (!stood) {
        // invariant: a run that stood no wall calls nobody
        assert(beckon_of(report_out).beckoned == 0);
        // invariant: a run that stood no wall leaves no wall unheralded
        assert(beckon_of(report_out).unheralded == 0);
        return;
    }
    const this_wall = wall orelse return error.BeckonUnwalled;

    // The measurement this rung moves, weighed against the wall actually
    // standing rather than against anything the plan asked for, so a boundary
    // nobody carries is counted rather than refused.
    const walled_count: u32 = 1;
    beckon_of(report_out).unheralded = unheralded_walls(walled_count, beckon);
    const beckoned_count = beckoned_in(walled_count, beckon);
    const kept_count = drawered_in(walled_count, beckon);
    if (beckon == .keeps) {
        // invariant: a keeping run calls nobody, however plainly the wall stands
        assert(beckoned_count == 0);
        beckon_of(report_out).kept = kept_count;
        return;
    }

    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const addressed = addressable(where);
    const matched = calls_carries(calls_bytes(this_wall), this_wall);
    if (beckon_refusal(walled_count, beckoned_count, kept_count, stood, addressed, matched)) |why| return why;

    // invariant: a beckoning run calls a person to the one wall it stood
    assert(beckoned_count == 1);
    try call_reader(io, where, this_wall);
    // The wire before the memory, once more: the call a person will read is
    // read back out of their own box, and only then does the report believe
    // anybody was reached.
    if (!beckon_holds(called_of(io, where), calls_bytes(this_wall))) return error.BeckonMisrecorded;
    beckon_of(report_out).beckoned = beckoned_count;
    beckon_of(report_out).kept = kept_count;
    // invariant: a beckoning run leaves no wall of its own unheralded
    assert(beckon_of(report_out).unheralded == 0);
}

/// Opens the word this run's reader handed back about the wall it carried them.
///
/// **It runs after the beckoning below it, and it reads that beckoning's own
/// call.** Only an answer to a call actually carried can be opened, so this rung
/// takes its subject off the wire rather than from anything the plan asked for
/// -- and a run that called nobody opens nothing at all, which is the honest
/// ending rather than a record of a word nobody spoke to it.
///
/// The wire before the memory, one tier further out than the beckoning above it:
/// this run reads back the call it just carried, opens the reader's own box,
/// weighs what stands there against that call, records the reader's word where
/// an operator reads, and reads that record back before the report believes a
/// person was heard.
///
/// **Opening is reading, and reading changes nothing a person wrote.** The
/// reader's own answer stays exactly where they left it; the plan copies it to
/// where an operator reads and rewrites not one byte of it.
pub fn open_the_answer(io: std.Io, answer: Opening, report_out: *Report) (RunError || NoteError)!void {
    var address_buf: [max_address_len]u8 = @splat(0);
    const where = address_published(io, &address_buf) orelse "";
    const carried = if (addressable(where)) called_of(io, where) else null;
    const called = beckon_of(report_out).beckoned >= 1 and carried != null;
    if (!called) {
        // invariant: a run that carried no call opens no answer
        assert(answer_of(report_out).opened == 0);
        // invariant: a run that carried no call leaves no answer unopened
        assert(answer_of(report_out).unopened == 0);
        return;
    }
    const this_call = carried orelse return error.AnswerUncalled;

    // The measurement this rung moves, weighed against the call actually
    // carried rather than against anything the plan asked for, so a reply
    // nobody opens is counted rather than refused.
    const called_count: u32 = 1;
    answer_of(report_out).unopened = unopened_answers(called_count, answer);
    const opened_count = hearing_in(called_count, answer);
    const left_count = shutting_in(called_count, answer);
    if (answer == .leaves) {
        // invariant: a leaving run opens nothing, however plainly a word stands
        assert(opened_count == 0);
        answer_of(report_out).left = left_count;
        return;
    }

    // The reader's own word comes off the wire, in their own box, since what an
    // operator is owed is what that person actually wrote and never a word a run
    // supplied for them.
    const handed = hands_written(io, where);
    const spoken = handed != null;
    const matched = if (handed) |said| hands_answers(said, this_call) else false;
    if (answer_refusal(called_count, opened_count, left_count, called, spoken, matched)) |why| return why;

    // invariant: an opening run records the one answer it opened
    assert(opened_count == 1);
    const said = handed orelse return error.AnswerSilent;
    try answer_note(io, said);
    // The wire before the memory, once more: the record an operator will read is
    // read back, and only then does the report believe anybody was heard.
    if (!answer_holds(answer_standing(io), answers_bytes(said))) return error.AnswerMisrecorded;
    answer_of(report_out).opened = opened_count;
    answer_of(report_out).left = left_count;
    // invariant: an opening run leaves no answer of its own unopened
    assert(answer_of(report_out).unopened == 0);
}

/// Takes this run's own wall down on the word its reader handed back.
///
/// **It runs after the opening below it, and it reads that opening's own
/// record.** Only a release actually opened can be acted on, so this rung takes
/// its subject off the wire rather than from anything the plan asked for -- and
/// a run that heard nobody abates nothing at all, which is the honest ending
/// rather than a boundary taken down on a word nobody spoke to it.
///
/// The wire before the memory, one tier further out than the opening above it:
/// this run reads back the record it just wrote, reads the reader's own word out
/// of it, weighs the wall now standing against the wall that word answered,
/// writes the abatement where an operator reads, reads that note back, and only
/// then lets the boundary fall -- reading once more to be sure it did.
///
/// **The record lands before the wall falls.** A run that stops between the two
/// leaves a wall standing beside a note saying it should not, which is the state
/// the rung below always left; the other order would leave a boundary gone with
/// nothing on the wire naming who released it.
pub fn abate_the_wall(io: std.Io, abate: Abate, report_out: *Report) (RunError || NoteError)!void {
    const recorded = answer_standing(io);
    const opened = answer_of(report_out).opened >= 1 and recorded != null;
    if (!opened) {
        // invariant: a run that opened no answer abates no wall
        assert(report_out.abated == 0);
        // invariant: a run that opened no answer leaves no wall standing against a release
        assert(report_out.unabated == 0);
        return;
    }
    const this_record = recorded orelse return error.AbateUnopened;

    // The reader's own word comes out of the record rather than out of anything
    // the plan asked for, since the whole question this rung answers is what a
    // person actually granted.
    const released = if (answers_hand(this_record)) |hand| releases(hand) else false;

    // The measurement this rung moves, weighed against the answer actually
    // opened rather than against anything the plan asked for, so a release
    // nobody acts on is counted rather than refused.
    const opened_count: u32 = 1;
    report_out.unabated = standing_walls(opened_count, released, abate);
    const abated_count = abated_in(opened_count, released, abate);
    const held_count = withheld_walls_in(opened_count, released, abate);
    if (abated_count == 0) {
        // invariant: a holding run takes down nothing, however plainly a release stands
        assert(abate == .holds or !released);
        report_out.held = held_count;
        return;
    }

    const matched = abates_wall(this_record, wall_standing(io));
    if (abate_refusal(opened_count, abated_count, held_count, opened, released, matched)) |why| return why;

    // invariant: an abating run takes down the one wall it was released from
    assert(abated_count == 1);
    try abate_note(io, this_record);
    // The wire before the memory, once more: the abatement an operator will read
    // is read back, and only then is the wall allowed to fall.
    if (!abate_holds(abate_standing(io), abates_bytes(this_record))) return error.AbateMisrecorded;
    clear_desist(io);
    // And the fall is read too, rather than assumed from having asked for it.
    if (wall_standing(io) != null) return error.AbateMisrecorded;
    report_out.abated = abated_count;
    report_out.held = held_count;
    // invariant: an abating run leaves no released wall of its own standing
    assert(report_out.unabated == 0);
}

/// Books what the plan's own concession owes the run that comes after it.
///
/// It runs last of all, after the avowing below it, because the concession a
/// debt carries is the concession that avowing just published -- and because a
/// run that said nothing, or kept its own word, has admitted nothing to carry.
///
/// The wire before the memory, one tier further out than the avowing above it:
/// this run reads back the word it just published, weighs it for a concession
/// rather than assuming one, reads the settlement the outcome actually carries,
/// writes the debt where a later run will find it, and reads that note back
/// before the report believes a byte of it.
///
/// **A plan that says nothing books nothing, and a plan that keeps its own word
/// books nothing** -- each is an ending this rung reaches by writing nothing at
/// all, since only an admission can be owed. The number it moves is the
/// concession a plan made that reaches no run after it.
pub fn book_the_debt(io: std.Io, owe: Owe, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.book_the_debt(@This(), io, owe, report_out);
}

/// Reads back what the hand this run referred to made of the case.
///
/// It runs last of all, after the referring below it, because the case a finding
/// is weighed against is the case that referring just carried -- and because a
/// run that carried nothing out is owed no answer by anybody.
///
/// The wire before the memory, one tier further out than the referring above it:
/// this run opens the forum it was told to carry to, reads whatever that hand
/// left in their own box, weighs the case echoed there against the case actually
/// sent, publishes the verdict where the outcome is read, and reads that note
/// back before the report believes a word of it.
///
/// A run that referred nothing has no answer coming, a desk that has said
/// nothing yet leaves the case honestly waiting, and a finding about some older
/// argument is refused by name rather than filed beside today's word -- each is
/// an ending this rung reaches by publishing nothing. The number it moves is the
/// case carried out that nobody is ever heard back on.
pub fn read_the_finding(io: std.Io, deem: Deem, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.read_the_finding(@This(), io, deem, report_out);
}

/// Says, on the record, what this plan makes of the finding against it.
///
/// It runs last of all, after the reading below it, because the finding a plan
/// answers is the finding that reading just published -- and because a run that
/// heard nothing from anybody is fairly asked to answer nothing.
///
/// The wire before the memory, one tier further out than the reading above it:
/// this run opens the finding its own plan published, weighs its own word
/// against that verdict, publishes the two bytes where the outcome is read, and
/// reads that note back before the report believes a word of it.
///
/// A run that read no finding has nothing to answer, a plan told to stay mute
/// leaves the finding standing unanswered, and a word about some older verdict
/// is refused by name rather than filed beside today's finding -- each is an
/// ending this rung reaches by publishing nothing. The number it moves is the
/// finding a plan published and never said one word about.
pub fn say_the_word(io: std.Io, avow: Avow, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.say_the_word(@This(), io, avow, report_out);
}

/// Puts a long-standing quarrel before a hand that is neither party to it.
///
/// It runs last of all, after the heralding below it, because the standing this
/// rung carries out is the standing that heralding just published -- and
/// because the relenting at the top of the run may already have taken down the
/// very quarrel a case would be built from.
///
/// The wire before the memory, one tier further out than the heralding above
/// it: this run opens whatever position survived it, reads the age actually
/// written beside it, weighs that age against the bound below, reads the forum
/// off the wire rather than choosing one, refuses by name a forum that names
/// somebody already in the argument, copies three facts off the record into
/// that forum's own box, and reads the box back before the report believes a
/// word of it.
///
/// A run with nothing standing has no case to carry, a byte no endurance of
/// this arc would ever have written is no quarrel to refer, and a quarrel young
/// enough that its age is the whole story is fairly left with the people having
/// it -- each is an ending this rung reaches by carrying nothing. The number it
/// moves is the long-standing quarrel nobody outside the argument ever sees.
pub fn refer_the_quarrel(io: std.Io, refer: Refer, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.refer_the_quarrel(@This(), io, refer, report_out);
}

/// Publishes, beside the outcome, how loudly the quarrel standing here reads.
///
/// It runs last of all, after the dating below it, because the age this rung
/// reads is the age that dating just left on the wire -- and because the
/// relenting at the top of the run may already have taken down the very
/// position a standing would speak about.
///
/// The wire before the memory, one tier further out than the dating above it:
/// this run opens whatever position survived it, reads the age actually on the
/// wire rather than any age it believes it wrote, weighs that age against a
/// bound no run may move, writes the reading beside the settlement an operator
/// opens, and reads it back before the report believes a word of it.
///
/// A run with nothing standing has no quarrel to herald, and a byte no
/// endurance of this arc would ever have written is no position to speak for;
/// each is an ending this rung reaches by publishing nothing. A quarrel young
/// enough that its age is the whole story is heralded honestly as quiet, and
/// costs the count nothing -- the number this rung moves is the long-standing
/// position an operator reads no louder than a fresh one.
pub fn herald_the_standing(io: std.Io, swell: Swell, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.herald_the_standing(@This(), io, swell, report_out);
}

/// Says how long the position still standing over this plan has stood.
///
/// It runs last of all, because a position has stood through this run only once
/// the run is over -- and because the relenting at the top of the run may
/// already have taken down the very note an age would be written beside.
///
/// The wire before the memory, one tier further out than the relenting above
/// it: this run opens whatever position survived it, reads the age already on
/// the wire, climbs that age by the run just finished, refuses by name an age
/// that would forget runs already counted, writes it, and reads it back before
/// the report believes a word of it. A plan reporting an age from memory of
/// having written one would hand every later operator a number the wire never
/// carried.
///
/// A run with nothing standing has no age to write, and a byte no endurance of
/// this arc would ever have written is no position to date; each is an ending
/// this rung reaches by writing nothing rather than by dating a quarrel nobody
/// holds. A standing quarrel whose note says nothing at all about how long it
/// has stood is the number this rung moves.
pub fn date_the_standing(io: std.Io, dwell: Dwell, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.date_the_standing(@This(), io, dwell, report_out);
}

/// Lets a standing quarrel go, on the word of the person who raised it.
///
/// The wire before the memory, one tier further out than the weighing below it:
/// this run opens the position standing over its plan, reads the box of the
/// reader that position belongs to, weighs whether that hand has since let the
/// matter go, takes the note down, and reads it back before the report believes
/// a word of it. A plan that reported a withdrawal from memory of having made
/// one would be telling every run after it a quarrel is over on the strength of
/// its own expectation.
///
/// A run with nothing standing has nothing to let go, a wire naming nobody's box
/// has no hand to read, and a byte no endurance of this arc would ever have
/// written is no position at all; each is an ending this rung reaches by
/// clearing nothing rather than by closing a quarrel on its holder's behalf. A
/// withdrawn quarrel that went on standing over the plan anyway is the number
/// this rung moves.
pub fn release_the_standing(io: std.Io, relent: Relent, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.release_the_standing(@This(), io, relent, report_out);
}

/// Weighs the quarrel this run inherited into the word an operator will read.
///
/// The wire before the memory, one tier further out than the carrying below it:
/// this run takes the position it read before its record was ever opened, takes
/// the settlement it has since published, weighs whether that word ought to
/// stand alone, writes the regard beside the settlement, and reads that byte
/// back before the report believes it. A plan that published a regard from
/// memory of having written one would be telling every operator its outcome is
/// qualified on the strength of its own expectation.
///
/// A run nobody has pressed a quarrel against has nothing to weigh, and a plan
/// that came up short already tells its reader the work is unfinished; both are
/// outcomes this rung reaches by weighing nothing rather than by publishing a
/// qualification nobody is owed. A plan reported carried while an inherited
/// quarrel stood against it is the number this rung moves.
pub fn weigh_the_standing(io: std.Io, taken_up: ?Plea, heed: Heed, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.weigh_the_standing(@This(), io, taken_up, heed, report_out);
}

/// Carries a pressed quarrel past the run that heard it, or lets it end there.
///
/// The wire before the memory, one tier further out than the reading below it:
/// this run reads the plea it just published, weighs whether that plea is one a
/// run may carry, writes it into the standing note the next provisioning leaves
/// alone, and reads that note back before the report believes a word of it. A
/// plan that carried a position from memory of having written one would be
/// handing every run after it a quarrel on the strength of its own expectation.
///
/// A run that heard nobody has nothing to carry, and a reader content with how
/// their quarrel came out has nothing that ought to survive them; both are
/// endings this rung reaches for by weighing nothing rather than by inventing a
/// position. A pressed quarrel a run heard and the run after it began without is
/// the number this rung moves.
pub fn carry_the_position(io: std.Io, endurance: Endurance, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.carry_the_position(@This(), io, endurance, report_out);
}

/// Reads what the reader says to the answer this plan just gave them.
///
/// The wire before the memory, one tier further out than the telling below it:
/// this run reads the address out of the note that names it, reads its own
/// tiding out of that reader's box to learn anybody was told at all, opens the
/// reply the reader left in their own hand, publishes it where an operator opens
/// the plan, and reads that note back before the report believes a word of it. A
/// plan that published a position from memory of having read one would be
/// telling every future operator where a living person stands on the strength of
/// its own expectation.
///
/// A run that told nobody has nobody to read, and a reader who wrote nothing has
/// left nothing to read; both are silences no appeal can fill, and each says so
/// by weighing nothing rather than by composing a plea. A reader who answered
/// how their quarrel came out and whom no run ever read is the number this rung
/// moves.
pub fn read_the_appeal(io: std.Io, appeal: Appeal, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.read_the_appeal(@This(), io, appeal, report_out);
}

/// Tells the reader who raised the quarrel how it came out.
///
/// The wire before the memory, one tier further out than the standing below it:
/// this run reads the quarrel out of the record that keeps it, reads the term
/// out of the note that decided it, reads the word it finally settled out of the
/// note an operator opens, reads the address out of the note that names it,
/// writes the result into that reader's own box, and reads the box back before
/// the report believes anybody was told. A plan that reported a raiser reached
/// from memory of having written to them would be counting a letter it never
/// sent.
///
/// A run holding no quarrel has nobody to write to, a quarrel nobody decided has
/// no outcome to carry, and a reader who left no address cannot be reached at
/// all; each is a silence no tiding can fill, and each says so by weighing
/// nothing rather than by inventing a correspondent. A quarrel weighed whose
/// raiser was never told how it came out is the number this rung moves.
pub fn tell_the_reader(io: std.Io, tidings: Tidings, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.tell_the_reader(@This(), io, tidings, report_out);
}

/// Carries the term's own answer into the mark an operator actually opens.
///
/// The wire before the memory, one tier further out than the term below it:
/// this run reads its own mark out of the note an operator would open, reads
/// the term out of the note that decided it, writes both into that same mark,
/// and reads the mark back before the report believes a word of it. A plan that
/// reported a standing from memory of having weighed one would be telling every
/// future reader something its own wire never carried.
///
/// A run that escorted nothing has no mark to speak for, and an objection nobody
/// asked about has no standing to carry; both are silences no standing can fill,
/// and each says so by weighing nothing rather than by inventing a finding. A
/// mark that names an objection and never says whether anybody still holds it --
/// read live by every operator, however long ago the quarrel was let go -- is the
/// number this rung moves.
pub fn stand_the_mark(io: std.Io, mark: Mark, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.stand_the_mark(@This(), io, mark, report_out);
}

/// Asks the reader who raised the standing objection whether they still hold it,
/// and publishes what they answered.
///
/// The wire before the memory, one tier further out than the escort below it:
/// this run reads its own mark out of the note an operator would open, reads the
/// disagreement out of the note that keeps it, writes the question into the
/// reader's own box, reads that question back out of the box, and only then
/// reads the reader's second hand. A plan that published a lapse from memory of
/// having asked would be calling a silence an answer to a question that never
/// left the building.
///
/// A run that escorted nothing bounds nothing, and a record holding no quarrel
/// has nothing to put a term on; both are silences no term can fill, and each
/// says so by weighing nothing rather than by inventing a correspondent. An
/// objection published beside a word with no term on it at all -- standing on
/// every future reader, unasked -- is the number this rung moves.
pub fn weigh_the_term(io: std.Io, term: Term, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.weigh_the_term(@This(), io, term, report_out);
}

/// Reads back what the reader answered, and says whether the plan ever
/// listened.
///
/// The wire before the memory, one tier further out than every rung below:
/// this run reads the letter it carried out of the reader's own box, and then
/// reads that same reader's hand out of the box beside it. Neither reach
/// touches what the supervisor remembers doing, because a plan that heard its
/// reader agree from its own memory has agreed with itself.
///
/// A run that carried nothing owes nobody a hearing, and says so by weighing
/// nothing rather than by inventing a correspondent. A reader who wrote back
/// where the plan never listened is the number this rung moves; a reader who
/// never wrote at all is a silence no run can close, counted nowhere and
/// refused only where a run claims to have heard it.
pub fn hear_the_reader(io: std.Io, receipt: Receipt, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.hear_the_reader(@This(), io, receipt, report_out);
}

/// Records the disagreement its reader answered with, or sets that answer aside.
///
/// The wire before the memory, one tier further out than the hearing below it:
/// this run reads the letter out of the reader's own box, reads that reader's
/// own hand beside it, and writes the pair into its own record without ever
/// touching what the supervisor remembers doing. A plan that recorded its
/// reader's objection from its own memory of the correspondence would be
/// putting words in a person's mouth.
///
/// A run that carried nothing owes nobody a record, and says so by weighing
/// nothing rather than by inventing a quarrel. A reader who agreed is left
/// exactly as the rung below leaves them, agreed with and undisputed. Only a
/// reader who answered in a word this plan cannot accept is written down -- and
/// under `.settled` even that one is set aside, which is where the rung below
/// leaves every reader and precisely the number this rung moves.
pub fn record_the_dispute(
    io: std.Io,
    receipt: Receipt,
    record: Standing,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.record_the_dispute(@This(), io, receipt, record, report_out);
}

/// Stands the word this run published up beside the reading recorded against it.
///
/// The wire before the memory, one tier further out than the record below it:
/// this run reads its own published settlement out of the note an operator would
/// open, reads the disagreement out of the note that keeps it, and writes the
/// mark from those two rather than from anything the supervisor remembers doing.
/// A plan that escorted its word from memory of a quarrel would be quoting a
/// reader it never read.
///
/// A run that published nothing marks nothing, and a record holding no quarrel
/// has nothing to quote; both are silences no mark can fill, and each says so by
/// weighing nothing rather than by inventing an objector. A word published over
/// a disagreement that stands recorded, read by an operator who finds no sign of
/// it, is the number this rung moves.
pub fn escort_the_word(io: std.Io, escort: Escort, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.escort_the_word(@This(), io, escort, report_out);
}

/// Answers the reader of a settlement this run has since replaced.
///
/// The wire before the memory, twice over: the word this run finally published
/// and the word an operator carried away are both read back here, outside the
/// folds that produced either, exactly as a person would read them. A supervisor
/// that corrected a reader from its own memory of the outcome would be writing a
/// second word nobody can check.
///
/// A plan nobody read owes nobody a correction, and says so by weighing nothing
/// rather than by inventing an audience. A reading this run still stands behind
/// is confirmed and left exactly where it is. Only a reading the settlement
/// contradicts is answered -- and under `.silent` even that one is left standing,
/// which is where the rung below leaves every reader and precisely the number
/// this rung moves.
pub fn post_the_amendment(io: std.Io, notice: Notice, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.post_the_amendment(@This(), io, notice, report_out);
}

/// Carries the correction this run posted to the place its reader was reached.
///
/// The wire before the memory, once more and one tier further out: the
/// correction this run published and the address its reader left are both read
/// back here, outside the fold that wrote either, exactly as the person each
/// was written for would read a letter and its envelope before setting out.
///
/// A run that posted no correction carries nothing, and says so by weighing
/// nothing rather than by inventing an errand. A reader who left no address
/// cannot be reached, and the run refuses by name rather than choosing a
/// destination on their behalf. Only a posted correction with somewhere to go
/// travels -- and under `.waiting` even that one stays where it was written,
/// which is where the rung below leaves every reader who does not come back,
/// and precisely the number this rung moves.
pub fn carry_the_amendment(io: std.Io, dispatch: Dispatch, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.carry_the_amendment(@This(), io, dispatch, report_out);
}

/// Runs the arcs a plan lost that nobody spared, and answers for what is left
/// standing after.
///
/// The mend reads its own run's verdict back from the wire before it decides
/// anything, because a supervisor that repairs from memory is repairing a plan
/// it believes in rather than the one it published. A plan the wire calls
/// `carried` is refused outright -- there is nothing here to repair, and a
/// mend that ran anyway would re-do work already served.
///
/// **What this rung adds is the recantation, read from the same wire.** The
/// appraisal note names which losses a judgment spared -- and under `.stand`
/// that judgment may be older than this run, since the note is the one a run
/// never clears. The recant note names which of those judgments this run's own
/// record disproves. Under `.stand` the mend spares every appraised loss,
/// exactly as the rung below does. Under `.revisit` the recanted ones come back
/// into the repair, and the settlement moves with them -- from `borne`, which
/// tells an operator there is nothing left to do, to `carried`, which is true.
pub fn mend_the_plan(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    base: []const Phase,
    wake: gap.Wake,
    keeping: Keep,
    bearing: Bearing,
    standard: Standard,
    review: Review,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!void {
    return ladder_checks.mend_the_plan(
        @This(), allocator, io, self_path, sys, caps, base, wake, keeping, bearing, standard, review, table, report_out,
    );
}

/// Publishes what the plan came to and what that means, and reads both back.
///
/// The verdict below answers whether work is still standing; the settlement
/// answers what an operator should do about it. Both go to the wire and both
/// are read back before the report believes either, since a supervisor that
/// trusts its own memory of what it published has published nothing.
pub fn settle_the_plan(
    io: std.Io,
    lost: u32,
    served_again: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.settle_the_plan(@This(), io, lost, served_again, report_out);
}

/// Weighs what the plan came to, publishes the verdict and the loss, and reads
/// the verdict back.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. A plan that absorbed no phase into a
/// standing dependent is carried by the shape of its own record, and this rung
/// leaves it exactly there rather than inventing a judgment it cannot make.
///
/// What this rung adds to the one below is the **recantation beside the
/// appraisal**. The judgment already on the wire is read here, before anything
/// this run learned is written over it, and weighed against the judgment this
/// run's own record supports. Whichever way the plan asks its history to be
/// read, that reading is published while the run still holds the evidence for
/// it, and read back before the repair spares or seats a single phase.
pub fn reckon_the_plan(
    io: std.Io,
    table: *const Table,
    ledger: Ledger,
    review: Review,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reckon_the_plan(@This(), io, table, ledger, review, report_out);
}

// =========================================================================
// The dependent -- a walk that reads the wire before it trusts its own hands
// =========================================================================

/// Reads the capability words a dependent was handed at its spawn into its slot.
pub fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    return ladder_checks.slot_from_argv(@This(), args, domain, cap_count);
}

/// Answers whether this dependent already holds a capability over one region.
pub fn already_holds(slot: *const capabilities.DependentSlot, region_name: []const u8) bool {
    // invariant: a holding is always asked about a named region
    assert(region_name.len >= 1);
    // invariant: a holding never reads past what one dependent may hold
    assert(slot.cap_count <= capabilities.max_caps_per_dependent);
    var i: u32 = 0;
    while (i < slot.cap_count) : (i += 1) {
        if (std.mem.eql(u8, slot.caps[i].name_slice(), region_name)) return true;
    }
    // invariant: the walk read every capability the dependent holds, none skipped
    assert(i == slot.cap_count);
    return false;
}

/// Names the word at one depth of a list, or answers that the list is shorter.
pub fn word_at(words: *const Words, index: u32) ?[]const u8 {
    // invariant: a word is only ever sought inside what one dependent may hold
    assert(index < capabilities.max_caps_per_dependent);
    var seen: u32 = 0;
    var lines = std.mem.splitScalar(u8, words.slice(), '\n');
    while (lines.next()) |one| {
        if (one.len == 0) continue;
        if (seen == index) return one;
        seen += 1;
    }
    return null;
}

/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    base: *const capabilities.DependentSlot,
    words: *const Words,
    keep: u32,
) ?capabilities.DependentSlot {
    return ladder_checks.prune_to(@This(), base, words, keep);
}

/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const Words,
    from: u32,
    to: u32,
) u32 {
    return ladder_checks.reachable_between(@This(), io, slot, words, from, to);
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of this rung, made by the party that would be lying if it were
/// wrong -- and made without touching the hands the dependent actually works
/// with. The words standing for this domain are grafted into a *copy* of those
/// hands, and each arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
pub fn inherited_at_first_breath(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    return ladder_checks.inherited_at_first_breath(@This(), io, base, domain);
}

/// One dependent's own line, read arc by arc against the count it was handed.
pub fn read_own_line(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    task: cycle.Task,
) ?u8 {
    return ladder_checks.read_own_line(@This(), io, slot, task);
}

/// Grafts every conferred word as it arrives, reads each arc, and answers for
/// what it holds.
///
/// Answers the count grafted, or an outcome code where a word or an arc did
/// not stand. The dependent answers `.held` only after reading every arc it
/// grafted, which is what lets the supervisor read that answer as work served.
pub fn graft_promised_reach(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *Words,
    carried_out: *u32,
) ?u8 {
    return ladder_checks.graft_promised_reach(@This(), io, slot, domain, task, promised, granted, carried_out);
}

/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const Words,
    carried: u32,
) ?u32 {
    return ladder_checks.return_promised_reach(@This(), io, base, slot, domain, granted, carried);
}

/// Reads the arcs this dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
pub fn stand_taking_and_returning_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    return ladder_checks.stand_taking_and_returning_reach(@This(), io, base, slot, domain, task, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
pub fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    return ladder_checks.run_dependent(@This(), io, args);
}

// =========================================================================
// The lap -- one plan run twice against a reader who never comes back, once
// leaving the correction on the wire and once carrying it to them
// =========================================================================

/// The lap this rung runs, and the word read alone is the whole of it.
///
/// Three clients stand over three arcs and carry a reserve of one, and the
/// phase behind each asks that same client to peek exactly the reserved arc --
/// so the run confers `menu` to a dependent already standing, three times.
/// Every author declares that their dependent falls, so each grafts the word,
/// answers for it, and falls holding it: three conferrals, three arcs nobody
/// served. None is marked, so the bearing has nothing to say about any of them.
///
/// The wire meets this plan already carrying a judgment -- `client_b`'s lost
/// peek, weighed spent by a run that is over -- and this run's own evidence
/// says otherwise, since the phase that would have spoken for that loss falls
/// holding its conferral. So both runs of this lap weigh the judgment again,
/// take it back, repair all three arcs, and settle the plan `carried`.
///
/// **And the wire meets this plan already carrying a reader who left an
/// address.** An operator read the elder run's settlement, carried away one
/// word -- `borne`, which says there is nothing left to do -- and left `desk` as
/// the place they could be found. Both runs post the correction in that
/// operator's own words, carry it to their box, read the hand they answer with,
/// and write the disagreement into the record in both voices. The rung below is
/// fully satisfied by either.
///
/// **What parts them is where that disagreement can be read.** Left alone, it
/// rests in `plan.dispute` among the plan's own notes, while the settlement an
/// operator opens reads exactly as it would have read had nobody objected.
/// Escorted, one byte lands in `plan.beside` -- the reader's own reading,
/// standing where the word is read -- so the same reach that finds the outcome
/// finds the objection.
///
/// **The price is one byte.** Both runs spend the same six dependents, repair
/// the same three arcs, post and carry the same correction, read the same
/// answer, record the same disagreement, and settle the same word. What parts
/// them is whether anybody reading that word ever learns of it.
pub const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_b", .verb = .stand, .hops = "board,ask_b,taken_b", .peers = "serial_virt,client_b", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_a", .verb = .stand, .hops = "board,ask_a,taken_a", .peers = "serial_virt,client_a", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 4, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_c", .verb = .stand, .hops = "board,ask_c,taken_c", .peers = "serial_virt,client_c", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 5, .step = 0, .follows = 0, .follows_turns = 2, .task = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

/// The judgment the wire already carries when this lap begins.
///
/// `client_b`'s lost peek, weighed spent by a run that is over. It is seated as
/// the record it is rather than produced by a first run of this plan, because
/// what a run does with a judgment it did not make is the whole subject here --
/// and because a judgment arrives on the wire exactly this way whether the run
/// that wrote it finished a minute ago or a season ago.
const standing_judgment: u32 = 1 << 1;

/// The word an operator already carried away when this lap begins.
///
/// `borne` -- whole but for a loss the plan itself asked to carry, which tells a
/// reader there is nothing left to do. It is exactly what the rung below's
/// standing review published, and it is seated as the record it is rather than
/// produced by a first run of this plan, because what a run owes a reader it
/// did not write to is the whole subject here -- and because a reading arrives
/// on the wire exactly this way whether the person who took it read a minute ago
/// or a season ago.
const standing_reading: Settlement = .borne;

/// The place the reader who took that word can be found.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading is: an address arrives on the wire beside a reading
/// whether the person who left it read a minute ago or a season ago. `desk`
/// names a place outside this plan's own wire, which is the entire distance
/// this rung exists to close.
pub const standing_address = "desk";

/// Where the hand that is neither party sits, in this lap's own wire.
///
/// A second address, and deliberately a different one: the whole rung is the
/// distance between this name and the one above it. An operator seats it before
/// any quarrel exists, and no run of this plan ever writes it.
pub const standing_forum = "bench";

/// The word this lap's plan comes to every run, named so a third hand may
/// honestly answer the case before the run that carries it exists.
pub const standing_settlement: Settlement = .carried;

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    return ladder_checks.load_one(io, path, buf);
}

/// The mend below, read straight, so this rung's own fold stands on a repair
/// that still refuses everything it always refused.
pub fn check_mending() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_mending();
}

/// The bearing and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a bearing is
/// weighed, the work it weighs, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `BearOverrepaired`, belongs
/// to the run rather than the fold, since only the wire can answer what a plan
/// published about its own obedience.
pub fn check_bearing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_bearing();
}

/// The recantation and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a standing
/// judgment is weighed again, the supply it may reach, and the honesty of its
/// count answered as a pure fold -- the closed record, the loss, the judgment on
/// the wire, and the judgment this run supports are the whole of the input, and
/// no process appears anywhere. The fourth refusal, `RecantUnspoken`, belongs to
/// the run rather than the fold, since only the wire can answer what a run
/// published about its own reversal.
pub fn check_recantation() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_recantation();
}

/// The amendment and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a reading is
/// answered, the supply it may reach, and the honesty of its count answered as a
/// pure fold -- the word an operator holds and the word this run settled are the
/// whole of the input, and no process appears anywhere. The fourth refusal,
/// `AmendUnspoken`, belongs to the run rather than the fold, since only the wire
/// can answer whether a correction actually reached the place it was read.
pub fn check_amendment() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_amendment();
}

/// The delivery and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a correction is
/// carried, the address it may be carried to, and the honesty of its count
/// answered as a pure fold -- no process anywhere. The fourth refusal,
/// `CourierUndelivered`, belongs to the run rather than the fold, since only a
/// reader's own box can answer whether anything actually arrived in it.
pub fn check_delivery() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_delivery();
}


/// The reading the reader answers with, in their own hand.
///
/// `short` -- a word neither this run's correction nor their own elder reading
/// names. The operator was told `borne`, this run carried them `carried`, and
/// they answered that they hold the plan **short**: whole work was left undone.
/// That is a reader disagreeing plainly, in their own vocabulary, about the one
/// thing the correspondence was ever about.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading and the address are: a hand arrives in a reader's box
/// whether that person answered a minute ago or a season ago, and **no run of
/// this plan ever writes it**. A supervisor that wrote its reader's answer for
/// them would be agreeing with itself.
const standing_hand: Settlement = .short;

/// The debt this lap's measured runs open holding, booked by a run before today.
///
/// Deliberately unlike anything either measured run would book of its own: an
/// admission taken over a finding that went *for* the plan, under an outcome
/// that already reported itself short. So a receipt naming these two bytes can
/// only be a receipt for the inherited debt, never a run quietly answering its
/// own concession -- which is the difference this rung is built to prove.
///
/// Seated by the harness, standing in for the run that booked it, for the same
/// reason the reading and the address are seated: an inheritance arrives in a
/// plan's notes from a run that has already ended, and **no run of this plan
/// ever writes its own**.
pub const inherited_debt: [max_debt_bytes]u8 = .{ finding_byte(.overrules), settlement_byte(.short) };

/// The matter a run before today reopened, standing in this plan's notes.
///
/// The four bytes `reopen.rye` writes: a reader's own word about the answer that
/// run carried them, echoed back whole -- the finding, what the look came to,
/// and the verdict `wanting` at its tail. Reading it back proves the receipt
/// this rung writes can only be about the inherited matter, never a run quietly
/// answering a reopening it booked itself.
///
/// Seated by the harness, standing in for the run that booked it, for the same
/// reason the debt above is seated: an inheritance arrives in a plan's notes
/// from a run that has already ended, and **no run of this plan ever writes its
/// own**.
pub const inherited_matter: [max_again_bytes]u8 = again_bytes(
    suits_bytes(found_bytes(redress_bytes(met_bytes(inherited_debt), .righted)), .wanting),
);

/// The impasse a run before today handed forward, seated by the harness.
///
/// The reader was told what the second look came to, refused it a second time,
/// and the run that heard that refusal declined to open the question a third
/// time from nothing -- writing exactly these five bytes where the run after it
/// reads its own inheritance. Every measured run of this lap opens holding it.
const inherited_impasse: [max_holds_bytes]u8 = holds_bytes(
    rests_bytes(knows_bytes(anew_bytes(inherited_matter)), .stands),
);

/// The mark a run before today left when it named this very matter, seated by
/// the harness.
///
/// The run before this one inherited the same impasse, named it faithfully
/// where its outcome is read, took the inheritance down, and forbore once more
/// -- so the matter arrives here on its second round with the record of its
/// first still standing. This is the evidence a bounding run weighs, and **no
/// run of this plan ever writes its own**.
const elder_mark: [max_minds_bytes]u8 = minds_bytes(inherited_impasse);

/// The hearing below, still weighed, and now under the stricter question this
/// rung hands it.
///
/// Every rung of this arc keeps weighing the rungs beneath it, so a change that
/// quietly stopped one of them moving is caught in the same breath as the new
/// work. What this fold reads is the rung below's own count with `agreed` in
/// place of `answered`: an agreeing hand closes the correspondence, and a
/// disagreeing one leaves the hearing exactly where it stood.
pub fn check_hearing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_hearing();
}

/// The record and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a run records,
/// the hand it records for, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `DisputeUnfounded`, is
/// answered here too, since whether two readings differ is a question two words
/// can settle between themselves.
pub fn check_dispute() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_dispute();
}

/// The escort and its four refusals, read straight, before any dependent runs.
///
/// The happy zone of this rung: every question about the moment a word is
/// marked, the record it is marked from, the honesty of the count, and whether
/// the mark quotes its reader truly, answered as a pure fold -- no process
/// anywhere.
pub fn check_abide() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_abide();
}

/// The term and its four refusals, read straight, before any dependent runs.
///
/// The happy zone of this rung: every question about the moment a term is
/// weighed, whether anybody was asked before a silence was called silence, the
/// honesty of the count, and whether a renewal renews the objection actually
/// standing, answered as a pure fold -- no process anywhere.
pub fn check_lapse() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_lapse();
}

/// Weighs this rung's own folds, before any dependent runs.
pub fn check_standing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return answering_rung.check_standing();
}

/// Runs one queue whole under one relenting, against a judgment, a reading, an
/// address, a reader's own hand, and a quarrel already standing, and says
/// whether it survived.
///
/// Every one of them is seated before the run rather than after, since each is a
/// record a run does not make and a run must find them exactly where the hand
/// that wrote them left them. **The standing position is seated here too**, and
/// it is the record this rung turns on: an earlier run heard a living person
/// press their quarrel and carried it into the one note a provisioning leaves
/// alone, so this run opens already holding an objection it did not make and
/// cannot resolve. The reader of *this* run accepts the outcome, on purpose --
/// so nothing this run hears of its own could account for the regard it
/// publishes, and the position it stands under can only be the inherited one.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    heed: Heed,
    relent: Relent,
    dwell: Dwell,
    swell: Swell,
    refer: Refer,
    deem: Deem,
    avow: Avow,
    owe: Owe,
    meet: Meet,
    redress: Redress,
    upshot: Upshot,
    apprise: Apprise,
    suffice: Suffice,
    reopen: Reopen,
    reweigh: Reweigh,
    recount: Recount,
    allay: Allay,
    forbear: Forbear,
    mind: Mind,
    desist: Desist,
    beckon: Beckon,
    answer: Opening,
    abate: Abate,
    stands: ?Plea,
    stood: u32,
    replies: Plea,
    answers: ?Finding,
    owes: ?[max_debt_bytes]u8,
    weighs: ?Worth,
    opens: ?[max_again_bytes]u8,
    rests: ?Rest,
    handed_on: ?[max_holds_bytes]u8,
    named_before: ?[max_minds_bytes]u8,
    report_out: *Report,
) bool {
    if (!seat_the_wire(io, @intCast(plan.len), stands, stood, replies, answers, owes, weighs, opens, rests, handed_on, named_before)) return false;
    ladder_checks.run_in_forbear(
        @This(),
        allocator, io, self_path, sys, plan, .when_moved, .preceded, .held_on, .borne, .weighed, .revisit, .posted, .carried, .asked, .open, .escorted, .bounded, .standing, .returned, .open, .{ .endurance = .kept, .heed = heed, .relent = relent, .dwell = dwell, .swell = swell, .refer = refer, .deem = deem, .avow = avow, .owe = owe, .meet = meet, .redress = redress, .upshot = upshot, .apprise = apprise, .suffice = suffice, .reopen = reopen, .reweigh = reweigh, .recount = recount, .allay = allay, .forbear = forbear, .mind = mind, .desist = desist, .beckon = beckon, .answer = answer, .abate = abate }, report_out,
    ) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Seats every byte this lap's runs will find already on the wire.
///
/// The harness's own half, kept apart from the run it precedes so the two read
/// as what they are: a world stood up by hands outside this plan -- an operator,
/// a reader, the runs that met this quarrel before today -- and then one run
/// that finds it. Nothing here is a supervisor writing its own history.
fn seat_the_wire(
    io: std.Io,
    held: u32,
    stands: ?Plea,
    stood: u32,
    replies: Plea,
    answers: ?Finding,
    owes: ?[max_debt_bytes]u8,
    weighs: ?Worth,
    opens: ?[max_again_bytes]u8,
    rests: ?Rest,
    handed_on: ?[max_holds_bytes]u8,
    named_before: ?[max_minds_bytes]u8,
) bool {
    seat_standing_appraisal(io, held, standing_judgment) catch |err| {
        print("  RED: a judgment could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_reading(io, standing_reading) catch |err| {
        print("  RED: a reading could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_address(io, standing_address) catch |err| {
        print("  RED: an address could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    empty_box(io, standing_address);
    // The reader's own hand, written by the reader rather than by any run.
    answer_as_reader(io, standing_address, standing_hand) catch |err| {
        print("  RED: a reader could not answer in their own hand: {s}\n", .{@errorName(err)});
        return false;
    };
    clear_question(io, standing_address);
    clear_renewal(io, standing_address);
    clear_tidings(io, standing_address);
    clear_press(io, standing_address);
    // The reader's own hand, and the whole hinge of this rung. A reader who now
    // accepts has withdrawn the quarrel they once pressed, in the only hand the
    // arc has ever taken as closing one -- and a reader still pressing has said
    // nothing new, so their position stands. Either way the run finds this byte
    // where its holder left it, never where a supervisor put it.
    press_as_reader(io, standing_address, replies) catch |err| {
        print("  RED: a reader could not reply in their own hand: {s}\n", .{@errorName(err)});
        return false;
    };
    clear_this_laps_notes(io);
    // And then, where this lap wants one, the matter an earlier run reopened is
    // seated exactly as that run would have left it -- by the harness, standing
    // in for the run before today. No supervisor writes its own inheritance.
    if (opens) |opened| {
        seat_note(io, plan_name, ".again", &opened) catch |err| {
            print("  RED: an earlier run's reopening could not be seated: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    // And the impasse an earlier run handed forward, seated the same way -- by
    // the harness, standing in for the run before today. A forbearance a
    // supervisor wrote for itself would be a plan inheriting its own argument.
    clear_forbear(io);
    if (handed_on) |handed| {
        seat_note(io, plan_name, ".hold", &handed) catch |err| {
            print("  RED: an earlier run's forbearance could not be seated: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    // And the mark an earlier run left when it named this same matter, seated
    // the same way -- by the harness, standing in for the run before today. A
    // mark a supervisor wrote for itself would be a plan bounding its own
    // correspondence on evidence it manufactured.
    clear_mind(io);
    if (named_before) |named| {
        seat_note(io, plan_name, ".mind", &named) catch |err| {
            print("  RED: an earlier run's mark could not be seated: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    if (!seat_the_readers_words(io, weighs, rests)) return false;
    return seat_the_history(io, stands, stood, answers, owes);
}

/// Seats the words this lap's reader has already written, in their own hand.
///
/// Kept apart from the wire above it now that the correspondence runs two
/// letters deep -- the verdict on the answer they were carried, and the reply
/// to the telling of the second look. Both are a person's own words: a lap that
/// seats one stands in for a correspondent who has opened their box and said
/// what they make of what they found, and a lap that seats none leaves a box
/// that says nothing, which is exactly what an unasked reader looks like on the
/// wire. No supervisor writes either of them.
/// Takes down every note this lap's own runs will write, before they write it.
///
/// One reason, said once for the whole family: a note read back must be one
/// this lap's own run actually wrote, never one an earlier lap left standing.
/// The correspondence now runs six notes deep -- the delivery, the plan's copy
/// of its reader's verdict, the matter a run may take up again, the receipt of
/// the second look, the telling that copies it, and the plan's copy of the
/// reply to that telling -- so the clearing earns a name of its own.
fn clear_this_laps_notes(io: std.Io) void {
    clear_apprise(io, standing_address);
    clear_suffice(io);
    clear_reopen(io);
    clear_reweigh(io);
    clear_recount(io, standing_address);
    clear_allay(io);
    clear_mind(io);
    clear_desist(io);
    clear_answer(io);
}

fn seat_the_readers_words(io: std.Io, weighs: ?Worth, rests: ?Rest) bool {
    clear_suits(io, standing_address);
    clear_rests(io, standing_address);
    if (rests) |rest| {
        const carried_home = knows_bytes(anew_bytes(inherited_matter));
        rest_as_reader(io, standing_address, rests_bytes(carried_home, rest)) catch |err| {
            print("  RED: a reader could not reply to the telling in their own hand: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    if (weighs) |worth| {
        const owed = found_bytes(redress_bytes(met_bytes(inherited_debt), .righted));
        weigh_as_reader(io, standing_address, suits_bytes(owed, worth)) catch |err| {
            print("  RED: a reader could not weigh the answer in their own hand: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    // And the word this reader hands back about the boundary they were called
    // to. It is seated here, in the harness's own half, because no run of this
    // plan may ever write it: a plan that could compose the release it obeys
    // would be releasing itself. **The reader takes the matter up**, which is
    // the one answer that asks the plan for anything at all -- and this rung is
    // about what the plan does with the asking.
    clear_hands(io, standing_address);
    const called_to = calls_bytes(walls_bytes(elder_mark));
    seat_hands(io, standing_address, hands_bytes(called_to, .takes_up)) catch |err| {
        print("  RED: a reader could not answer the call in their own hand: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Seats the quarrel's own history -- the position, its age, and its standing.
///
/// Kept apart from the reader's own hand above it, since these are records about
/// a position rather than words from a person. No run of this plan ever writes
/// them; the harness stands in for the runs that met this quarrel before today.
fn seat_the_history(io: std.Io, stands: ?Plea, stood: u32, answers: ?Finding, owes: ?[max_debt_bytes]u8) bool {
    return ladder_checks.seat_the_history(@This(), io, stands, stood, answers, owes);
}

/// Tells what the two marks did, side by side, in an operator's own words.
fn tell_desist_runs(bare_run: *Report, under_run: *Report) void {
    return ladder_checks.tell_desist_runs(@This(), "holding", "abating", bare_run, under_run);
}

/// Tells what the two runs did about the standing quarrel itself, in an
/// operator's own words.
///
/// The seam is this rung's own: everything above belongs to the rungs beneath it
/// and stands still under both plans, and everything here turns on whether a
/// quarrel its holder let go is finally allowed to end.
fn tell_desist_half(bare_run: *Report, under_run: *Report) void {
    return ladder_checks.tell_desist_half(@This(), "holding", "abating", bare_run, under_run);
}

/// Prints this rung's own three numbers, and the plan an operator finally reads.
///
/// Split from the half above at the seam where the arc's inherited counts end
/// and this lap's own begin, so neither reading grows past the length a person
/// takes in at one glance.
pub fn tell_desist_tail(bare_run: *Report, under_run: *Report) void {
    ladder_checks.tell_desist_tail(@This(), "holding", "abating", bare_run, under_run);
    tell_beckon_own(bare_run, under_run);
}

/// Weighs the two marks against each other and names the first disagreement.
///
/// The shape of the finding is two numbers moving together and the price of
/// moving them named honestly beside it -- and here the price is one note taken
/// down, at no cost in work at all. Both runs take up the same record, confer
/// the same arcs, lose the same arcs, take the same judgment back, repair the
/// same three phases, spend the same dependents, post the same correction, carry
/// it to the same reader, record the same disagreement, escort the same
/// published word, stand the same mark, wall the same twice-carried matter,
/// call the same person to it, read that person's own releasing answer, and
/// settle the plan `carried`. What differs is whether the plan does anything
/// about the release -- **and the reader wrote the same word under both plans**,
/// which is exactly what makes the holding a cost rather than an impossibility.
fn judge_abate_runs(bare_run: *Report, under_run: *Report) u8 {
    // invariant: a judging always reads two runs that were actually run
    assert(run_of(bare_run).queued >= 1);
    // invariant: a judging never counts more walls than one answer releases
    assert(under_run.abated <= 1);
    // The measurement this rung moves, and the only number the two runs
    // disagree on: a wall two readers both released, held standing by one plan
    // and taken down by the other.
    if (bare_run.unabated != 1 or under_run.unabated != 0) {
        print("  RED: the two plans held {d} released walls standing against {d}\n", .{
            bare_run.unabated, under_run.unabated,
        });
        return 1;
    }
    if (bare_run.abated != 0 or under_run.abated != 1) {
        print("  RED: the two plans abated {d} walls against {d}\n", .{
            bare_run.abated, under_run.abated,
        });
        return 1;
    }
    if (bare_run.held != 1 or under_run.held != 0) {
        print("  RED: the other half of the count did not close: {d} against {d}\n", .{
            bare_run.held, under_run.held,
        });
        return 1;
    }
    // The opening below now moves the same under both plans, since abating acts
    // on a word already read rather than reading one. Both runs open the same
    // reader's release; only what the plan does about it parts them.
    if (bare_run.inner.opened != 1 or under_run.inner.opened != 1) {
        print("  RED: the two plans opened {d} answers against {d}\n", .{
            bare_run.inner.opened, under_run.inner.opened,
        });
        return 1;
    }
    if (bare_run.inner.unopened != 0 or under_run.inner.unopened != 0) {
        print("  RED: the two plans left {d} answers unopened against {d}\n", .{
            bare_run.inner.unopened, under_run.inner.unopened,
        });
        return 1;
    }
    if (bare_run.inner.left != 0 or under_run.inner.left != 0) {
        print("  RED: the opening below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.left, under_run.inner.left,
        });
        return 1;
    }
    // The beckoning below now moves the same under both plans, since opening an
    // answer reads a reply to a call already carried rather than carrying one.
    // Both runs call the same person to the same wall; only whether the plan
    // ever opens what they wrote back parts them.
    if (bare_run.inner.inner.beckoned != 1 or under_run.inner.inner.beckoned != 1) {
        print("  RED: the two plans called a person to {d} walls against {d}\n", .{
            bare_run.inner.inner.beckoned, under_run.inner.inner.beckoned,
        });
        return 1;
    }
    if (bare_run.inner.inner.unheralded != 0 or under_run.inner.inner.unheralded != 0) {
        print("  RED: the two plans left {d} walls unheralded against {d}\n", .{
            bare_run.inner.inner.unheralded, under_run.inner.inner.unheralded,
        });
        return 1;
    }
    if (bare_run.inner.inner.kept != 0 or under_run.inner.inner.kept != 0) {
        print("  RED: the beckoning below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.kept, under_run.inner.inner.kept,
        });
        return 1;
    }
    // The bounding below now moves the same under both plans, since beckoning
    // carries a wall already stood rather than standing one of its own. Both
    // runs bound the same twice-carried matter; only whether a person is ever
    // called to that boundary parts them.
    if (bare_run.inner.inner.inner.walled != 1 or under_run.inner.inner.inner.walled != 1) {
        print("  RED: the two plans stood {d} walls against {d}\n", .{
            bare_run.inner.inner.inner.walled, under_run.inner.inner.inner.walled,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.unbounded != 0 or under_run.inner.inner.inner.unbounded != 0) {
        print("  RED: the two plans relayed {d} twice-carried impasses unbounded against {d}\n", .{
            bare_run.inner.inner.inner.unbounded, under_run.inner.inner.inner.unbounded,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.relayed != 0 or under_run.inner.inner.inner.relayed != 0) {
        print("  RED: the bounding below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.relayed, under_run.inner.inner.inner.relayed,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.minded != 1 or under_run.inner.inner.inner.inner.minded != 1) {
        print("  RED: the two plans named {d} inherited impasses against {d}\n", .{
            bare_run.inner.inner.inner.inner.minded, under_run.inner.inner.inner.inner.minded,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.unminded != 0 or under_run.inner.inner.inner.inner.unminded != 0) {
        print("  RED: the two plans left {d} impasses inherited in silence against {d}\n", .{
            bare_run.inner.inner.inner.inner.unminded, under_run.inner.inner.inner.inner.unminded,
        });
        return 1;
    }
    // The forbearing three tiers down stands still under both plans now: both
    // stood the wall, so both stayed the relay, and a bounded matter is counted
    // as walled rather than unhanded under either.
    if (bare_run.inner.inner.inner.inner.inner.forborne != 0 or under_run.inner.inner.inner.inner.inner.forborne != 0) {
        print("  RED: the two plans handed on {d} standing matters against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.forborne, under_run.inner.inner.inner.inner.inner.forborne,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.unhanded != 0 or under_run.inner.inner.inner.inner.inner.unhanded != 0) {
        print("  RED: the two plans left {d} matters standing with nothing handed on against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.unhanded, under_run.inner.inner.inner.inner.inner.unhanded,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.opened != 0 or under_run.inner.inner.inner.inner.inner.opened != 0) {
        print("  RED: the forbearing below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.opened, under_run.inner.inner.inner.inner.inner.opened,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.read_back != 1 or under_run.inner.inner.inner.inner.inner.inner.read_back != 1) {
        print("  RED: the two marks read their reader's word on {d} tellings against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.read_back, under_run.inner.inner.inner.inner.inner.inner.read_back,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.unheard != 0 or under_run.inner.inner.inner.inner.inner.inner.unheard != 0) {
        print("  RED: the two marks left {d} tellings unheard against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.unheard, under_run.inner.inner.inner.inner.inner.inner.unheard,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.unread != 0 or under_run.inner.inner.inner.inner.inner.inner.unread != 0) {
        print("  RED: the reading below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.unread, under_run.inner.inner.inner.inner.inner.inner.unread,
        });
        return 1;
    }
    // The telling below now moves the same under both marks, since reading a
    // reply acts on a telling already carried rather than carrying one of its
    // own. Both runs look again, both receipt it, and both carry it home -- so
    // the harm the rung below names stands answered in each, and only whether
    // anybody opens the answer parts them.
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.recounted != 1 or under_run.inner.inner.inner.inner.inner.inner.inner.recounted != 1) {
        print("  RED: the two marks told their reader of {d} second looks against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.recounted, under_run.inner.inner.inner.inner.inner.inner.inner.recounted,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.untold != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.untold != 0) {
        print("  RED: the two marks left {d} second looks untold against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.untold, under_run.inner.inner.inner.inner.inner.inner.inner.untold,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.withheld != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.withheld != 0) {
        print("  RED: the telling below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.withheld, under_run.inner.inner.inner.inner.inner.inner.inner.withheld,
        });
        return 1;
    }
    // The looking below now moves the same under both marks, since carrying a
    // second look home acts on a receipt already written rather than making a
    // second look of its own. Both runs inherit the same matter, take the same
    // look, and take it down -- so the harm the rung below names stands answered
    // in each, and only whether anybody hears of it parts them.
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.looked != 1 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.looked != 1) {
        print("  RED: the two marks looked again at {d} matters against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.looked, under_run.inner.inner.inner.inner.inner.inner.inner.inner.looked,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.unlooked != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.unlooked != 0) {
        print("  RED: the two marks left {d} reopened matters unlooked-at against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.unlooked, under_run.inner.inner.inner.inner.inner.inner.inner.inner.unlooked,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.passed != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.passed != 0) {
        print("  RED: the looking below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.passed, under_run.inner.inner.inner.inner.inner.inner.inner.inner.passed,
        });
        return 1;
    }
    // The reopening below still moves the same under both marks, since looking
    // again answers a matter already booked rather than booking a second one.
    // Both runs read their reader's short word, publish it, and book nothing --
    // so the harm the rung below names stands equally in each, and only what
    // becomes of the matter they inherited parts them.
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.taken_up != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.taken_up != 0) {
        print("  RED: the two marks took up {d} matters again against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.taken_up, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.taken_up,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.unheeded != 1 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.unheeded != 1) {
        print("  RED: the two marks left {d} short words unheeded against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.unheeded, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.unheeded,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.left_closed != 1 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.left_closed != 1) {
        print("  RED: the reopening below stopped closing its count: {d} against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.left_closed, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.left_closed,
        });
        return 1;
    }
    // The weighing below still moves the same under both marks, since looking
    // again at a matter acts on a reader's word rather than reading a second one.
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.weighed != 1 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.weighed != 1) {
        print("  RED: the two marks read their reader's word on {d} answers against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.weighed, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.weighed,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unmeasured != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unmeasured != 0) {
        print("  RED: the two marks left {d} answers unmeasured against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unmeasured, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unmeasured,
        });
        return 1;
    }
    if (bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unweighed != 0 or under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unweighed != 0) {
        print("  RED: the two marks left {d} answers unasked against {d}\n", .{
            bare_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unweighed, under_run.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.unweighed,
        });
        return 1;
    }
    // The apprising below still moves the same under both marks, since asking a
    // reader what they make of an answer is a question rather than a second
    // delivery.
    if (apprise_of(bare_run).apprised != 1 or apprise_of(under_run).apprised != 1) {
        print("  RED: the two marks carried {d} findings to their reader against {d}\n", .{
            apprise_of(bare_run).apprised, apprise_of(under_run).apprised,
        });
        return 1;
    }
    if (apprise_of(bare_run).unheard != 0 or apprise_of(under_run).unheard != 0) {
        print("  RED: the two marks left {d} raisers untold against {d}\n", .{
            apprise_of(bare_run).unheard, apprise_of(under_run).unheard,
        });
        return 1;
    }
    if (apprise_of(bare_run).withheld != 0 or apprise_of(under_run).withheld != 0) {
        print("  RED: the two marks kept {d} findings to themselves against {d}\n", .{
            apprise_of(bare_run).withheld, apprise_of(under_run).withheld,
        });
        return 1;
    }
    // The redress below still moves the same under both marks, since carrying a
    // finding to its reader is a delivery rather than a second finding.
    if (redress_of(bare_run).redressed != 1 or redress_of(under_run).redressed != 1) {
        print("  RED: the two marks said what {d} meetings found against {d}\n", .{
            redress_of(bare_run).redressed, redress_of(under_run).redressed,
        });
        return 1;
    }
    if (redress_of(bare_run).hollow != 0 or redress_of(under_run).hollow != 0) {
        print("  RED: the two marks closed {d} meetings in silence against {d}\n", .{
            redress_of(bare_run).hollow, redress_of(under_run).hollow,
        });
        return 1;
    }
    if (redress_of(bare_run).bare != 0 or redress_of(under_run).bare != 0) {
        print("  RED: the two marks left {d} meetings wordless against {d}\n", .{
            redress_of(bare_run).bare, redress_of(under_run).bare,
        });
        return 1;
    }
    // The meeting below still moves the same under both marks, since saying what
    // a look found is a word about a meeting rather than a second meeting.
    if (meet_of(bare_run).met != 1 or meet_of(under_run).met != 1) {
        print("  RED: the two marks met {d} inherited debts against {d}\n", .{
            meet_of(bare_run).met, meet_of(under_run).met,
        });
        return 1;
    }
    if (meet_of(bare_run).unmet != 0 or meet_of(under_run).unmet != 0) {
        print("  RED: the two marks left {d} inherited debts unmet against {d}\n", .{
            meet_of(bare_run).unmet, meet_of(under_run).unmet,
        });
        return 1;
    }
    // The owing below still moves the same under both marks, since saying what a
    // meeting found says nothing whatever about today's own word.
    if (owe_of(bare_run).unbooked != 1 or owe_of(under_run).unbooked != 1) {
        print("  RED: the two marks left {d} concessions carrying nowhere against {d}\n", .{
            owe_of(bare_run).unbooked, owe_of(under_run).unbooked,
        });
        return 1;
    }
    // Every rung below still moves under both marks, since a debt carries a
    // concession forward rather than changing the concession itself.
    if (avow_of(bare_run).said != 1 or avow_of(under_run).said != 1) {
        print("  RED: the two marks answered {d} findings against {d}\n", .{
            avow_of(bare_run).said, avow_of(under_run).said,
        });
        return 1;
    }
    if (deem_of(bare_run).answered != 1 or deem_of(under_run).answered != 1) {
        print("  RED: the two marks read {d} findings against {d}\n", .{
            deem_of(bare_run).answered, deem_of(under_run).answered,
        });
        return 1;
    }
    // invariant: a judging never counts a repair the plan never lost
    assert(below_of(under_run).reseated <= max_queue_len);
    if (run_of(under_run).queued != run_of(bare_run).queued) {
        print("  RED: the two marks ran {d} phases against {d}\n", .{
            run_of(under_run).queued, run_of(bare_run).queued,
        });
        return 1;
    }
    if (abandoning_of(under_run).abandoned != abandoning_of(bare_run).abandoned) {
        print("  RED: the two marks lost {d} arcs against {d}\n", .{
            abandoning_of(under_run).abandoned, abandoning_of(bare_run).abandoned,
        });
        return 1;
    }
    if (abandoning_of(under_run).abandoned < 3) {
        print("  RED: the lap lost {d} arcs, and this rung needs three beneath it\n", .{
            abandoning_of(under_run).abandoned,
        });
        return 1;
    }
    // Every rung below still moves under both marks, since a regard reports on a
    // quarrel rather than making one.
    if (recanting_of(bare_run).recanted != 1 or recanting_of(under_run).recanted != 1) {
        print("  RED: a revisiting run took back {d} judgments against {d}\n", .{
            recanting_of(bare_run).recanted, recanting_of(under_run).recanted,
        });
        return 1;
    }
    if (amending_of(bare_run).amended != 1 or amending_of(under_run).amended != 1) {
        print("  RED: a posting run corrected {d} readings against {d}\n", .{
            amending_of(bare_run).amended, amending_of(under_run).amended,
        });
        return 1;
    }
    if (couriering_of(bare_run).delivered != 1 or couriering_of(under_run).delivered != 1) {
        print("  RED: a carrying run delivered {d} corrections against {d}\n", .{
            couriering_of(bare_run).delivered, couriering_of(under_run).delivered,
        });
        return 1;
    }
    if (disputing_of(bare_run).recorded != 1 or disputing_of(under_run).recorded != 1) {
        print("  RED: an open record held {d} disagreements against {d}\n", .{
            disputing_of(bare_run).recorded, disputing_of(under_run).recorded,
        });
        return 1;
    }
    if (abiding_of(bare_run).escorted != 1 or abiding_of(under_run).escorted != 1) {
        print("  RED: an escorting run marked {d} words against {d}\n", .{
            abiding_of(bare_run).escorted, abiding_of(under_run).escorted,
        });
        return 1;
    }
    if (lapsing_of(bare_run).asked != 1 or lapsing_of(under_run).asked != 1) {
        print("  RED: a bounded run asked about {d} objections against {d}\n", .{
            lapsing_of(bare_run).asked, lapsing_of(under_run).asked,
        });
        return 1;
    }
    if (below_of(bare_run).reseated != below_of(under_run).reseated) {
        print("  RED: the two marks repaired {d} phases against {d}\n", .{
            below_of(bare_run).reseated, below_of(under_run).reseated,
        });
        return 1;
    }
    if (below_of(bare_run).unserved != 0 or below_of(under_run).unserved != 0) {
        print("  RED: a run that repaired every disproved loss left work standing\n", .{});
        return 1;
    }
    if (bearing_of(bare_run).settlement != .carried or bearing_of(under_run).settlement != .carried) {
        print("  RED: a plan whose every lost arc was served settled {s}\n", .{
            settlement_words(bearing_of(under_run).settlement),
        });
        return 1;
    }
    if (reposing_of(bare_run).stood != 1 or reposing_of(under_run).stood != 1) {
        print("  RED: a standing run spoke for {d} marks against {d}\n", .{
            reposing_of(bare_run).stood, reposing_of(under_run).stood,
        });
        return 1;
    }
    if (tidings_of(bare_run).told != 1 or tidings_of(under_run).told != 1) {
        print("  RED: the two runs wrote to {d} raisers against {d}\n", .{
            tidings_of(bare_run).told, tidings_of(under_run).told,
        });
        return 1;
    }
    if (appeal_of(bare_run).heard_back != 1 or appeal_of(under_run).heard_back != 1) {
        print("  RED: the two runs read {d} replies against {d}\n", .{
            appeal_of(bare_run).heard_back, appeal_of(under_run).heard_back,
        });
        return 1;
    }
    // The endurance below, which both runs reach for identically: this lap's
    // reader is still pressing, so each run carries their position past itself
    // into the note the next run will open. That is the premise this rung
    // studies -- a quarrel nobody closes keeps standing -- and it stands the
    // same under both readings, since an age says nothing about whether a
    // position endures.
    if (endure_of(bare_run).kept != 1 or endure_of(under_run).kept != 1) {
        print("  RED: a run whose reader is still pressing carried {d} positions forward\n", .{
            endure_of(under_run).kept,
        });
        return 1;
    }
    // The relenting below, which neither run reaches for: the holder of this
    // quarrel never returns, so their position stands rightly through both runs
    // and the rung below leaves it exactly where it found it. That is the whole
    // premise of this rung -- a quarrel nobody closes is a quarrel that keeps
    // standing, and the only honest question left is for how long.
    if (relent_of(bare_run).withdrawn != 0 or relent_of(under_run).withdrawn != 0) {
        print("  RED: a run let {d} positions go that nobody had withdrawn\n", .{
            relent_of(under_run).withdrawn,
        });
        return 1;
    }
    if (relent_of(bare_run).standing != 1 or relent_of(under_run).standing != 1) {
        print("  RED: a run left {d} positions standing rather than the one\n", .{
            relent_of(under_run).standing,
        });
        return 1;
    }
    // The heeding below, which both runs reach for identically: the quarrel
    // stands, so both words stand under it. Dating a position says nothing
    // whatever about whether the plan's own word answers for it.
    if (heed_of(bare_run).heeded != 1 or heed_of(under_run).heeded != 1) {
        print("  RED: a plan under a live quarrel weighed {d} positions\n", .{
            heed_of(under_run).heeded,
        });
        return 1;
    }
    // The dwelling below, which both runs reach for identically: each dates the
    // position standing over it, and the age is exactly what this rung reads
    // from. Publishing how loudly a quarrel reads says nothing whatever about
    // how long it has stood.
    if (dwell_of(bare_run).aged != 1 or dwell_of(under_run).aged != 1) {
        print("  RED: a dating run dated {d} positions against {d}\n", .{
            dwell_of(bare_run).aged, dwell_of(under_run).aged,
        });
        return 1;
    }
    if (dwell_of(bare_run).ageless != 0 or dwell_of(under_run).ageless != 0) {
        print("  RED: a dating run left {d} standing quarrels undated\n", .{
            dwell_of(under_run).ageless,
        });
        return 1;
    }
    // The swelling below, which both runs reach for identically: each publishes
    // the standing of the position over it, right where the outcome is read.
    // Carrying a case out to a third hand says nothing whatever about how
    // loudly the objection reads to the two hands already holding it.
    if (swell_of(bare_run).heralded != 1 or swell_of(under_run).heralded != 1) {
        print("  RED: a heralding run published {d} standings against {d}\n", .{
            swell_of(bare_run).heralded, swell_of(under_run).heralded,
        });
        return 1;
    }
    if (swell_of(bare_run).unheralded != 0 or swell_of(under_run).unheralded != 0) {
        print("  RED: a heralding run left {d} quarrels reading quietly\n", .{
            swell_of(under_run).unheralded,
        });
        return 1;
    }
    // The referring below, which both runs reach for identically: each carries
    // the same case to the same desk outside the argument. Reading an answer
    // says nothing whatever about whether the argument travelled.
    if (refer_of(bare_run).referred != 1 or refer_of(under_run).referred != 1) {
        print("  RED: a referring run carried {d} cases out against {d}\n", .{
            refer_of(bare_run).referred, refer_of(under_run).referred,
        });
        return 1;
    }
    if (refer_of(bare_run).unheard != 0 or refer_of(under_run).unheard != 0) {
        print("  RED: a referring run left {d} quarrels unheard outside\n", .{
            refer_of(under_run).unheard,
        });
        return 1;
    }
    // The reading below, which both marks now do alike -- the finding comes home
    // under either plan, and only the answering to it parts them.
    if (deem_of(bare_run).awaited_in != 0 or deem_of(under_run).awaited_in != 0) {
        print("  RED: a forbearing run still left {d} cases waiting on an answer\n", .{
            deem_of(under_run).awaited_in,
        });
        return 1;
    }
    if (deem_of(bare_run).unanswered != 0 or deem_of(under_run).unanswered != 0) {
        print("  RED: a forbearing run left {d} cases nobody was heard back on\n", .{
            deem_of(under_run).unanswered,
        });
        return 1;
    }
    // The price of the plan answering for itself, named rather than hidden: no
    // work at all, and two bytes beside the finding.
    if (run_of(under_run).reaped != run_of(bare_run).reaped) {
        print("  RED: reading a finding cost {d} dependents against {d}\n", .{
            run_of(under_run).reaped, run_of(bare_run).reaped,
        });
        return 1;
    }
    if (preceded_of(under_run).out_of_precede != 0) {
        print("  RED: the forbearing run broke {d} turn orders its author named\n", .{
            preceded_of(under_run).out_of_precede,
        });
        return 1;
    }
    return 0;
}

