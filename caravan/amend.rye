//! Caravan amend -- a settlement an operator already read is corrected where
//! they read it, rather than quietly replaced by a run they never saw.
//!
//! `recant.rye` taught a run to take back a judgment its own evidence
//! disproves, repair the arc that judgment spared, and settle the plan
//! `carried` where the elder reading settled `borne`. Every word of that
//! correction goes to the wire, and every word of it is true. Yet the person
//! the elder word was written for has already read it and gone. A reader who
//! was told there is nothing left to do carries that sentence away with them,
//! and nothing below this rung ever reaches them again.
//!
//! **The measurement is readings left standing on a settlement this run
//! superseded.** The rung below weighs a record against itself: a judgment one
//! run made and a later run's evidence disproves. This one weighs a record
//! against its **reader** -- the word an operator holds, against the word the
//! plan now stands behind. A run that supersedes a reading in silence leaves a
//! true wire and a false belief, and the belief is the one somebody acts on.
//!
//! **A plan publishes whether its own corrections are addressed.** A record
//! written `notice = .posted` says: a settlement this run supersedes is
//! corrected on the wire, in words naming both the reading it replaces and the
//! reading that replaces it. `notice = .silent` is where the rung below leaves
//! it -- the settlement is overwritten, and whoever read the elder word keeps
//! it. The word sits at the plan beside the review, since it instructs about
//! who a record answers to rather than about any one phase.
//!
//! **The standing reading is the second note a run does not clear.** The
//! appraisal survives a run because a judgment that vanished with its run was
//! never a record. The reading survives for a plainer reason still: a reader's
//! copy survives the run, whatever the wire does, so a wire that forgets what it
//! last told somebody has no way to notice it changed its mind.
//!
//! **An amendment is bounded by the reading it corrects.** Only a reading some
//! run actually published may be amended, and every standing reading this run
//! can weigh is confirmed or amended -- never both and never neither. A run
//! that amended a reading nobody took would be correcting a reader who does not
//! exist, which is the same overreach as taking back a judgment nobody made.
//!
//! **The amendment stands on the wire in an operator's own words.** It is the
//! first note of this arc addressed to a **person** rather than to a phase, so
//! it is written about the plan whole rather than one glyph per phase: two
//! bytes, the reading superseded and the reading that supersedes it, so `bc`
//! reads *you were told the plan was borne; it is carried out whole*. The
//! standing reading leaves the wire in the same breath, since a reading that
//! has been answered is no longer waiting for an answer.
//!
//! **The rung earns four refusals, and each is about the notice rather than
//! the correction it carries.** `AmendEarly` is the moment: a reading corrected
//! before this run published its own settlement is correcting from memory.
//! `AmendUnread` is the supply: an amendment addressed to a reading nobody ever
//! took has corrected nobody. `AmendMiscounted` is the honesty of the count:
//! every standing reading is confirmed or amended, and never two of those and
//! never none. `AmendUnspoken` is the answer -- the hard half -- since a run
//! that superseded a reading and published no amendment corrected in private,
//! and a report read on that silence would tell an operator the reader had been
//! reached when nobody reached them.
//!
//! **A plan the wire holds no reading about reads as the rung below.** With no
//! standing reading to correct, the notice is refused before it weighs
//! anything, each line stands at the width it was handed, and the door answers
//! `unhand.admissible_held` pair for pair -- this arc's standing generalization
//! test, one tier further out.
//!
//! Usage:
//!   amend            Run the self-test (default)
//!   amend selftest   Same as default
//!   amend dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
const queue_store = @import("queue.rye");
const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const bearing_rung = @import("bear.rye");
const recanting_rung = @import("recant.rye");
const appraising_rung = @import("appraise.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");
const ladder_checks = @import("ladder_checks.rye");

const Dir = std.Io.Dir;

const caravan_amend_version = "20260820.045047";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = recanting_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = recanting_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = recanting_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = recanting_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = recanting_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = recanting_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.amends";

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = recanting_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = recanting_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = recanting_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = recanting_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = recanting_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = recanting_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = recanting_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the recanting notes
    assert(!std.mem.eql(u8, note_dir, recanting_rung.note_dir));
    // invariant: this rung's notes never collide with the appraising notes
    assert(!std.mem.eql(u8, note_dir, appraising_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return recanting_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, or correct the
/// reader of a word it has since replaced.
///
/// Four names of this rung's own, and each is about the notice rather than the
/// correction it carries: the moment a standing reading is answered, the supply
/// it may reach, the honesty of the count, and the amendment it publishes once
/// the settlement is written.
pub const RunError = recanting_rung.RunError || error{
    AmendEarly,
    AmendUnread,
    AmendMiscounted,
    AmendUnspoken,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = recanting_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = recanting_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) recanting_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return recanting_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = recanting_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = recanting_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = recanting_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = recanting_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return recanting_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return recanting_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return recanting_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return recanting_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return recanting_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = recanting_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return recanting_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return recanting_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the correction it addressed added.
///
/// `superseded_unposted` is the number this rung moves: readings an operator
/// carries away that this run's own settlement contradicts, left standing
/// because nobody wrote to them. `amended` is what it corrected instead,
/// published on the wire in words a person reads.
pub const Report = struct {
    inner: recanting_rung.Report = .{},
    amended: u32 = 0,
    superseded_unposted: u32 = 0,
};

/// The recanting rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
pub fn recanting_of(report_out: *Report) *recanting_rung.Report {
    return &report_out.inner;
}

/// The appraising rung's tally, one tier further down.
pub fn appraising_of(report_out: *Report) *appraising_rung.Report {
    return &report_out.inner.inner;
}

/// The bearing rung's tally, two tiers further down.
pub fn bearing_of(report_out: *Report) *bearing_rung.Report {
    return &report_out.inner.inner.inner;
}

/// The mending rung's tally, three tiers further down.
pub fn below_of(report_out: *Report) *mending_rung.Report {
    return &report_out.inner.inner.inner.inner;
}

/// The abandoning rung's tally, six tiers further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return recanting_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return recanting_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return recanting_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return recanting_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return recanting_rung.reserve_depth(reserve);
}

