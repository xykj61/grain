//! Caravan arrive -- a phase may arrive after the plan is seated, and the
//! queue answers it in one bounded pass.
//!
//! `arrange.rye` let a plan be written in any order and derived the sequence
//! its own names imply, so an author no longer writes the lawful order by
//! hand. Every rung in this arc up to here reasons over a queue handed
//! **whole** before the first dependent starts: the door reads the plan once,
//! seats it once, and the supervisor spends what it was given. So work that
//! shows up after the plan is seated has no door at all -- the only honest
//! answer available was to seat the whole plan again from the top.
//!
//! **An arrival is a claim about one phase, so it costs one pass.** A phase
//! may join a seated plan at the tail exactly when nothing already placed
//! was waiting for it: no phase in the plan names the newcomer's turn, the
//! newcomer's step is the next step its turn has open, and a turn already in
//! the plan says the same thing about what it follows as the newcomer does.
//! Those are three facts about the plan, all readable in one walk -- so an
//! arrival is answered in at most `max_arrival_tests` tests where a seating
//! spends `max_seating_tests`, the queue's length against its square.
//!
//! **A refusal is a name, never a surprise.** A newcomer some placed phase
//! was waiting for would have had to stand *ahead* of work already granted
//! its place, so the door answers `ArrivalUnseated` rather than quietly
//! re-ordering a plan someone is already counting on. A queue with no room
//! left answers `QueueFull`, and both answers arrive before a single dependent
//! of the newcomer starts.
//!
//! **A plan grown one arrival at a time is the plan written whole.** Handed
//! its own phases in order, one at a time, the growing plan reproduces the
//! author's plan exactly -- phase for phase, name for name -- and runs to
//! the same end under the same reading. So this rung generalizes `arrange`
//! rather than rivalling it, the same way an empty turn mask was the sibling
//! mask and a seated plan arranged to itself.
//!
//! **The limit is named plainly.** What this rung answers is whether a phase
//! may join a plan and what the answer costs; the arrivals are admitted at
//! the door, before the run begins. Carrying an arrival into a supervisor
//! with dependents already in flight is the next rung's question, and this
//! reading is what it will stand on.
//!
//! Usage:
//!   arrive selftest                  Run the readings against each other
//!   arrive                           Same as selftest
//!   arrive dependent <domain> <plan> ... Run as a supervised dependent (internal)

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const cohort = @import("cohort.rye");
const gap = @import("gap.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const arrange = @import("arrange.rye");

const caravan_arrive_version = "20260819.213000";

// =========================================================================
// Bounds, carried from the rung below
// =========================================================================

/// The declaration this rung exercises, unchanged.
pub const declaration_path = arrange.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = arrange.max_in_flight;

/// How many items one ordered queue carries.
pub const max_queue_len: u32 = arrange.max_queue_len;

/// How many still-waiting items past the head one turn may weigh.
pub const max_lookahead: u32 = arrange.max_lookahead;

/// A dependent's fixed argv, unchanged from the rungs below.
pub const fixed_argv_words: u32 = arrange.fixed_argv_words;

/// How many turns one queue may cut its work into.
pub const max_turns: u32 = arrange.max_turns;

/// How many pair tests one seating may ever spend.
pub const max_seating_tests: u32 = arrange.max_seating_tests;

/// How many tests one arrival may ever spend.
///
/// An arrival weighs the newcomer against each phase already placed exactly
/// once, gathering all three of its questions in that single walk, so the
/// whole cost is the length of the queue rather than its square. Stated here
/// rather than left for a reader to work out.
pub const max_arrival_tests: u32 = max_queue_len;

comptime {
    // invariant: an arrival always weighs every phase a full queue may hold
    assert(max_arrival_tests >= max_queue_len);
    // invariant: an arrival costs strictly less than seating the plan again
    assert(max_arrival_tests < max_seating_tests);
}

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return arrange.outcome_name(code);
}

/// Why a queue may not take the work handed to it.
///
/// `ArrivalUnseated` and `QueueFull` are this rung's own: a newcomer some
/// placed phase was waiting for, and a queue with no room left. Both are
/// answered at the door, with nothing of the newcomer started.
pub const RunError = arrange.RunError || error{ ArrivalUnseated, QueueFull };

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = arrange.Task;

/// One phase, its turn, its step, and the two masks it carries, unchanged.
pub const Phase = arrange.Phase;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = arrange.Reading;

/// Renders one reading as the words an operator reads.
pub fn reading_words(r: Reading) []const u8 {
    return arrange.reading_words(r);
}

/// What one run did, reported whole, unchanged from the rung below.
pub const Report = arrange.Report;

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return arrange.turn_bit(turn);
}

// =========================================================================
// The arrival -- three facts about a plan, gathered in one walk
// =========================================================================

/// What one walk of the plan learned about a newcomer.
///
/// Three questions share a walk because each of them is a fact about the
/// same phases: whether anyone was waiting for this turn, how many steps of
/// it already stand, and what those steps said about the turns they follow.
const Standing = struct {
    /// Some phase already placed names the newcomer's turn.
    awaited: bool = false,
    /// How many steps of the newcomer's own turn already stand in the plan.
    steps: u32 = 0,
    /// Whether the newcomer's turn already stands in the plan.
    present: bool = false,
    /// What the newcomer's turn already said about the turns it follows.
    said: u32 = 0,
};

/// Reads a plan once and answers where a newcomer would stand in it.
///
/// The scan reads the masks the author declared rather than their closing,
/// and that is enough: a turn reaches the newcomer's turn transitively only
/// through some turn that names it outright, and any such turn either stands
/// in this plan -- where the scan sees its own declaration -- or stands
/// outside it, where it holds nothing.
fn stand(plan: []const Phase, turn: u32) Standing {
    // invariant: a newcomer always names a turn inside the bound
    assert(turn < max_turns);
    // invariant: a scan stays inside the queue one supervisor may hold
    assert(plan.len <= max_queue_len);
    var out: Standing = .{};
    var i: u32 = 0;
    while (i < plan.len) : (i += 1) {
        if (plan[i].turn == turn) {
            out.steps += 1;
            if (!out.present) {
                out.present = true;
                out.said = plan[i].follows_turns;
            }
            continue;
        }
        if ((plan[i].follows_turns & turn_bit(turn)) != 0) out.awaited = true;
    }
    // invariant: the walk read the whole plan, weighing every phase in it
    assert(i == plan.len);
    // invariant: a scan never counts more steps than the queue holds phases
    assert(out.steps <= plan.len);
    return out;
}

/// Answers whether a newcomer may take the tail of a plan already seated.
///
/// Three facts, and only three. Nobody placed was waiting for the newcomer's
/// turn, since such a phase would have had to stand behind it. The
/// newcomer's step is the next one its turn has open, so a turn's steps keep
/// arriving in the order they are written. And a turn already standing says
/// the same thing the newcomer says about what it follows, so a plan never
/// holds two answers to one question.
pub fn arrival_admits(plan: []const Phase, newcomer: Phase) bool {
    // invariant: a plan always carries work before anything joins it
    assert(plan.len >= 1);
    // invariant: an arrival stays inside the queue one supervisor may hold
    assert(plan.len <= max_queue_len);
    if (plan.len == max_queue_len) return false;
    if (!precede.turns_are_sound(newcomer)) return false;
    if (!mask.mask_is_sound(precede.as_mask(newcomer))) return false;

    const where = stand(plan, newcomer.turn);
    if (where.awaited) return false;
    if (newcomer.step != where.steps) return false;
    if (where.present and where.said != newcomer.follows_turns) return false;
    return true;
}

/// Writes a plan with the newcomer standing at its tail, or refuses.
///
/// The plan is copied phase for phase exactly as its author wrote it, so an
/// arrival adds work and moves nothing: every phase already placed keeps the
/// name, the turn, the step, and the masks it arrived with.
pub fn arrive(plan: []const Phase, newcomer: Phase, out: []Phase) bool {
    // invariant: an arrival always has room for the plan it grows
    assert(out.len == plan.len + 1);
    // invariant: an arrival stays inside the queue one supervisor may hold
    assert(out.len <= max_queue_len);
    if (!arrival_admits(plan, newcomer)) return false;
    var i: u32 = 0;
    while (i < plan.len) : (i += 1) out[i] = plan[i];
    // invariant: every phase already placed was carried over, none dropped
    assert(i == plan.len);
    out[plan.len] = newcomer;
    return true;
}

/// Grows a whole plan from arrivals, one phase at a time, and answers how
/// many stood.
///
/// The first phase opens the plan; every phase after it arrives at the tail
/// of what already stands. A plan its author wrote in a lawful order grows
/// back to itself this way, which is what makes an arrival a generalization
/// of a seating rather than a rival reading of it.
pub fn grow(phases: []const Phase, out: []Phase) ?u32 {
    // invariant: a growing plan always has room for every phase it takes
    assert(out.len == phases.len);
    // invariant: a growing plan stays inside the queue one supervisor holds
    assert(phases.len <= max_queue_len);
    // invariant: a plan always carries work
    assert(phases.len >= 1);
    if (!precede.plan_is_ordered(phases[0..1])) return null;
    out[0] = phases[0];
    var placed: u32 = 1;
    while (placed < phases.len) : (placed += 1) {
        var grown: [max_queue_len]Phase = undefined;
        if (!arrive(out[0..placed], phases[placed], grown[0 .. placed + 1])) return null;
        var i: u32 = 0;
        while (i <= placed) : (i += 1) out[i] = grown[i];
        // invariant: the grown plan was written back whole, none lost
        assert(i == placed + 1);
    }
    // invariant: every phase offered was taken, none skipped
    assert(placed == phases.len);
    return placed;
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const Phase) bool {
    return arrange.plan_is_seated(plan);
}

/// Seats a plan in an order its own names imply.
pub fn seat(plan: []const Phase, out: []Phase) bool {
    return arrange.arrange(plan, out);
}

/// Answers whether two plans hold the same phases in the same places.
pub fn plans_match(a: []const Phase, b: []const Phase) bool {
    return arrange.plans_match(a, b);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: Phase, b: Phase, reading: Reading) bool {
    return arrange.items_contend(sys, a, b, reading);
}

/// Answers whether the head may enter beside the dependents running now.
pub fn admissible(
    sys: *const system.System,
    live: []const cohort.Running,
    head: Phase,
    reading: Reading,
) bool {
    return arrange.admissible(sys, live, head, reading);
}

// =========================================================================
// The door -- arrivals answered by name, before any dependent starts
// =========================================================================

/// Runs a plan grown from a base and the phases that arrive after it.
///
/// The supervisor itself is `arrange.run_queue`, asked rather than restated,
/// so every number this rung's laps report stands beside every rung before
/// it. What this rung adds stands entirely at the door: each arrival is
/// weighed against the plan as it stands, and a newcomer some placed phase
/// was waiting for is answered with `ArrivalUnseated` while no dependent has
/// started.
pub fn run_with_arrivals(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    arrivals: []const Phase,
    wake: gap.Wake,
    reading: Reading,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || RunError || cohort.RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len + arrivals.len > max_queue_len) return error.QueueFull;

    var plan_store: [max_queue_len]Phase = undefined;
    var held: u32 = 0;
    while (held < base.len) : (held += 1) plan_store[held] = base[held];
    // invariant: the base plan was taken whole, none dropped
    assert(held == base.len);

    var a: u32 = 0;
    while (a < arrivals.len) : (a += 1) {
        if (!arrival_admits(plan_store[0..held], arrivals[a])) return error.ArrivalUnseated;
        plan_store[held] = arrivals[a];
        held += 1;
    }
    // invariant: every arrival was weighed, none waved through
    assert(a == arrivals.len);
    // invariant: the grown plan holds exactly the work it was handed
    assert(held == base.len + arrivals.len);

    const plan = plan_store[0..held];
    // invariant: a plan grown by arrivals keeps every name its author wrote
    assert(precede.plan_is_ordered(plan));
    assert(plan_is_seated(plan));
    return arrange.run_queue(allocator, io, self_path, sys, plan, wake, reading, report_out);
}

// =========================================================================
// The lap -- one plan, handed whole and handed one phase at a time
// =========================================================================

/// The lap every rung in this arc runs, written in the order its names imply.
///
/// One busy domain makes the room: `client_a` opens with a place and three
/// more turns of the same domain queue behind it, so the head stands blocked
/// and a pass is the only way forward. Turn 4 has `client_b` place into
/// `ask_b` and names turn 3; turn 5 has `client_c` peek the published `menu`
/// and names turn 4 alone; turn 6 names nothing at all.
const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "w", .item = .{ .domain = "client_a", .verb = .place, .hops = "ask_a", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.carried_ok } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "back_a", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "taken_a", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 4, .step = 0, .follows = 0, .follows_turns = 8, .task = .{ .effects = "w", .item = .{ .domain = "client_b", .verb = .place, .hops = "ask_b", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.carried_ok } } },
    .{ .turn = 5, .step = 0, .follows = 0, .follows_turns = 16, .task = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 6, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "back_b", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

/// The same lap with the turn everyone waits on left out.
///
/// Turn 5 names turn 4, and turn 4 is missing -- so a phase of turn 4
/// arriving here would have had to stand ahead of work already placed. That
/// is exactly the arrival the door refuses by name.
const awaited_queue = [_]Phase{
    written_queue[0],
    written_queue[1],
    written_queue[2],
    written_queue[3],
    written_queue[5],
};

/// A newcomer of a turn already standing, carrying a different answer about
/// what that turn follows.
const forked_turn = Phase{
    .turn = 5,
    .step = 1,
    .follows = 0,
    .follows_turns = 0,
    .task = written_queue[5].task,
};

/// A newcomer of a turn already standing, skipping the step it has open.
const skipped_step = Phase{
    .turn = 6,
    .step = 2,
    .follows = 0,
    .follows_turns = 0,
    .task = written_queue[6].task,
};

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    const parsed = read.load(io, path, buf) catch |err| {
        print("  RED: {s} refused: {s}\n", .{ path, @errorName(err) });
        return null;
    };
    if (parsed.verify() != .whole) {
        print("  RED: {s} did not read whole\n", .{path});
        return null;
    }
    return parsed;
}

/// The arrival read straight, before any supervisor spends it.
///
/// The happy zone of this rung: every question here is a pure fold over the
/// plan, answered instantly, with no dependent started and no store touched. The
/// thin edge comes after, where only real processes can tell the truth.
pub fn check_arrival() u8 {
    // A plan grown one phase at a time is the plan its author wrote.
    var grown_store: [max_queue_len]Phase = undefined;
    const grown = grown_store[0..written_queue.len];
    const placed = grow(&written_queue, grown) orelse {
        print("  RED: a plan could not be grown from its own phases\n", .{});
        return 1;
    };
    if (placed != written_queue.len) {
        print("  RED: growing the plan seated {d} of {d} phases\n", .{ placed, written_queue.len });
        return 1;
    }
    if (!plans_match(grown, &written_queue)) {
        print("  RED: a plan grown by arrival moved a phase its author placed\n", .{});
        return 1;
    }
    if (!plan_is_seated(grown)) {
        print("  RED: a plan grown by arrival read as unseated\n", .{});
        return 1;
    }
    // invariant: a grown plan is still a plan every elder rung may read
    assert(precede.plan_is_ordered(grown));

    // And it seats to itself, so the rung below reads it unchanged.
    var seated_store: [max_queue_len]Phase = undefined;
    const seated = seated_store[0..grown.len];
    if (!seat(grown, seated) or !plans_match(seated, grown)) {
        print("  RED: seating a plan grown by arrival moved a phase\n", .{});
        return 1;
    }

    // A newcomer someone was waiting for is refused rather than placed.
    if (arrival_admits(&awaited_queue, written_queue[4])) {
        print("  RED: a turn a placed phase was waiting for arrived at the tail\n", .{});
        return 1;
    }
    // The same phase arriving before its waiter is welcome, so the refusal
    // names a real order rather than a shy reading.
    if (!arrival_admits(written_queue[0..4], written_queue[4])) {
        print("  RED: a turn nobody waits on was refused the tail\n", .{});
        return 1;
    }

    // A turn's steps keep arriving in the order they are written.
    if (arrival_admits(&written_queue, skipped_step)) {
        print("  RED: a phase skipped the step its own turn had open\n", .{});
        return 1;
    }

    // And a plan never holds two answers about what one turn follows.
    if (arrival_admits(&written_queue, forked_turn)) {
        print("  RED: a turn arrived carrying a second answer about what it follows\n", .{});
        return 1;
    }

    const arrivals: u32 = written_queue.len - 1;
    print("  a plan grown one arrival at a time is the plan written whole, {d} phases\n", .{placed});
    print("  {d} arrivals cost at most {d} tests, against {d} to seat the plan again each time\n", .{
        arrivals, arrivals * max_arrival_tests, arrivals * max_seating_tests,
    });
    print("  a newcomer a placed phase was waiting for is refused by name\n", .{});
    return 0;
}

/// Runs one queue whole and answers its report.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    reading: Reading,
    report_out: *Report,
) bool {
    arrange.run_queue(allocator, io, self_path, sys, plan, .when_moved, reading, report_out) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Runs one queue grown from arrivals and answers its report.
fn run_grown(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    arrivals: []const Phase,
    reading: Reading,
    report_out: *Report,
) bool {
    run_with_arrivals(
        allocator, io, self_path, sys, base, arrivals, .when_moved, reading, report_out,
    ) catch |err| {
        print("  RED: a grown queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// The arrival lap: one plan run twice, handed whole and handed one at a time.
pub fn check_order(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    // The door answers before a single dependent starts.
    var refused: Report = .{};
    const answer = run_with_arrivals(
        allocator, io, self_path, &sys, &awaited_queue, written_queue[4..5],
        .when_moved, .preceded, &refused,
    );
    if (answer) |_| {
        print("  RED: a newcomer a placed phase was waiting for ran anyway\n", .{});
        return 1;
    } else |err| {
        if (err != error.ArrivalUnseated) {
            print("  RED: the door refused for the wrong reason: {s}\n", .{@errorName(err)});
            return 1;
        }
    }
    if (refused.inner.run.admitted != 0) {
        print("  RED: the refusal started {d} dependents before answering\n", .{
            refused.inner.run.admitted,
        });
        return 1;
    }

    var whole: Report = .{};
    if (!run_one(allocator, io, self_path, &sys, &written_queue, .preceded, &whole)) return 1;
    var grown: Report = .{};
    if (!run_grown(
        allocator, io, self_path, &sys, written_queue[0..1], written_queue[1..], .preceded, &grown,
    )) return 1;

    print("  a newcomer a placed phase was waiting for is refused at the door, {d} dependents started\n", .{
        refused.inner.run.admitted,
    });
    print("  breaks a named turn: {d} handed whole, {d} grown by arrival\n", .{
        whole.out_of_precede, grown.out_of_precede,
    });
    print("  passes: {d} handed whole, {d} grown by arrival\n", .{
        whole.inner.run.passes, grown.inner.run.passes,
    });
    print("  slots unspent: {d} handed whole, {d} grown by arrival\n", .{
        whole.inner.run.slots_unspent, grown.inner.run.slots_unspent,
    });
    print("  {d} dependents run to the same end under both hands\n", .{grown.inner.run.reaped});

    if (grown.out_of_precede != 0) {
        print("  RED: the grown run broke {d} turn orders its author named\n", .{
            grown.out_of_precede,
        });
        return 1;
    }
    if (grown.inner.run.passes != whole.inner.run.passes) {
        print("  RED: the grown queue took {d} passes against {d} handed whole\n", .{
            grown.inner.run.passes, whole.inner.run.passes,
        });
        return 1;
    }
    if (grown.inner.run.slots_unspent != whole.inner.run.slots_unspent) {
        print("  RED: the grown queue spent its slots differently from the whole one\n", .{});
        return 1;
    }
    // invariant: the two hands ran the same queue to the same end
    assert(whole.inner.run.reaped == grown.inner.run.reaped);
    assert(whole.inner.run.succeeded == grown.inner.run.succeeded);
    assert(grown.inner.run.reaped == written_queue.len);
    // invariant: growing a plan by arrival recovers the whole run, measure for measure
    assert(whole.inner.run.peak_in_flight == grown.inner.run.peak_in_flight);
    assert(whole.inner.out_of_mask == grown.inner.out_of_mask);

    return 0;
}

fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan arrive {s} -- self-test\n", .{caravan_arrive_version});
    const arrival = check_arrival();
    if (arrival != 0) return arrival;
    const order = check_order(allocator, io, self_path);
    if (order != 0) return order;
    print("  GREEN: a phase may arrive after the plan is seated, in one bounded pass\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return cohort.run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return run_self_test(allocator, io, self_path);
}
