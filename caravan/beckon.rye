// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return forbearing_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, correct the
/// reader of a word it has since replaced, carry that correction to them, hear
/// what that reader answered back, record a disagreement it cannot resolve,
/// stand a word up beside that disagreement, put a term on how long the
/// disagreement may stand, or carry that term into the mark itself.
///
/// Five names of this rung's own, matching the five below it. `AvowUnheard` is
/// the moment a word is taken at all: a run that read no finding has nothing to
/// answer. `AvowUnfound` is whether a finding stands published on the wire to
/// answer. `OweUnsaid` is the moment a debt is booked at all: a plan that said
/// no word has conceded nothing, and a debt booked there would record an
/// admission never made. `OweUnconceded` is the same guard one step in -- a plan
/// that kept its own word owes the work nothing, and booking a debt against a
/// dissent would turn holding one's ground into an admission of fault.
/// `OweMismatched` is the whole point: a debt that does not name the finding
/// this run conceded is a debt about some older argument, and carrying it
/// forward would have a later run meeting a concession nobody made today.
/// `OweMiscounted` is the honesty of the count, and `OweMisrecorded` is the
/// record, read back from the one note that outlives the run.
pub const RunError = forbearing_rung.RunError || error{
    OweUnsaid,
    OweUnconceded,
    OweMismatched,
    OweMiscounted,
    OweMisrecorded,
    MeetUnowed,
    MeetUnsettled,
    MeetMismatched,
    MeetMiscounted,
    MeetMisrecorded,
    RedressUnmet,
    RedressUnrighted,
    RedressMismatched,
    RedressMiscounted,
    RedressMisrecorded,
    AppriseUnfound,
    AppriseUnaddressed,
    AppriseMismatched,
    AppriseMiscounted,
    AppriseMisrecorded,
    SufficeUntold,
    SufficeSilent,
    SufficeMismatched,
    SufficeMiscounted,
    SufficeMisrecorded,
    ReopenUnweighed,
    ReopenSettled,
    ReopenMismatched,
    ReopenMiscounted,
    ReopenMisrecorded,
    ReweighUnopened,
    ReweighUnsettled,
    ReweighMismatched,
    ReweighMiscounted,
    ReweighMisrecorded,
    RecountUnlooked,
    RecountUnaddressed,
    RecountMismatched,
    RecountMiscounted,
    RecountMisrecorded,
    AllayUntold,
    AllaySilent,
    AllayMismatched,
    AllayMiscounted,
    AllayMisrecorded,
    ForbearUnread,
    ForbearAllayed,
    ForbearMismatched,
    ForbearMiscounted,
    ForbearMisrecorded,
    MindUninherited,
    MindRested,
    MindMismatched,
    MindMiscounted,
    MindMisrecorded,
    DesistUnnamed,
    DesistFresh,
    DesistMismatched,
    DesistMiscounted,
    DesistMisrecorded,
    BeckonUnwalled,
    BeckonUnaddressed,
    BeckonMismatched,
    BeckonMiscounted,
    BeckonMisrecorded,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = forbearing_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = forbearing_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) forbearing_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return forbearing_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = forbearing_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = forbearing_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = forbearing_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = forbearing_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return forbearing_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return forbearing_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return forbearing_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return forbearing_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return forbearing_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = forbearing_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return forbearing_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return forbearing_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with what it carried out to a person.
///
/// `unheralded` is the number this rung moves: walls a plan stood and told
/// nobody about, so a correspondence exhausts itself in a drawer only the plan
/// opens. `beckoned` is what this rung does instead -- the wall carried to the
/// box the reader already reads, where a person finds it without coming to look.
/// `kept` is the other half of the same count, and the two close on the walls
/// this run actually stood, exactly.
pub const Report = struct {
    inner: desisting_rung.Report = .{},
    beckoned: u32 = 0,
    kept: u32 = 0,
    unheralded: u32 = 0,
};

/// The desist rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
pub fn desist_of(report_out: *Report) *desisting_rung.Report {
    return &report_out.inner;
}

