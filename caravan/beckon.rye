// =========================================================================
// The reclamation -- carried whole from the rung below, since this rung
// always reclaims and asks a different question about the same act
// =========================================================================

/// What becomes of a conferral when its holder is reaped, from the rung below.
pub const Take = forbearing_rung.Take;

/// Renders one take as the words an operator reads.
