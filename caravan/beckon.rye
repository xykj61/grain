// =========================================================================
// The swelling -- carried whole from the rung below, and read here
// =========================================================================

/// How many runs a position stands through before it counts as long-standing.
pub const long_standing_runs: u32 = forbearing_rung.long_standing_runs;

/// Whether a run publishes the standing of the quarrel beside its outcome.
pub const Swell = forbearing_rung.Swell;

/// Renders one swelling as the words an operator reads.
pub fn swell_words(s: Swell) []const u8 {
    return forbearing_rung.swell_words(s);
}

/// How loudly one standing quarrel reads, from the age it has actually stood.
pub const Volume = forbearing_rung.Volume;

/// Renders one volume as the words an operator reads.
pub fn volume_words(v: Volume) []const u8 {
    return forbearing_rung.volume_words(v);
}

/// The byte one volume rides as, in the note beside the outcome.
