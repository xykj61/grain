/// Weighs the number this rung moves, as a pure fold.
pub fn check_beckon_measure() u8 {
    if (unheralded_walls(1, .keeps) != 1) {
        print("  RED: a wall stood and told to nobody went uncounted\n", .{});
        return 1;
    }
    if (unheralded_walls(1, .beckons) != 0) {
        print("  RED: a wall carried to a person still counted as one told to nobody\n", .{});
        return 1;
    }
    // A run that stood no wall has no boundary to carry, so it costs the count
    // nothing -- the harm this rung names is the wall actually stood and the
    // person never called to it.
    if (unheralded_walls(0, .keeps) != 0) {
        print("  RED: a run that bounded nothing was charged an unheralded wall\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unwalled, unaddressed, mismatched, miscounted, misrecorded\n", .{});
    print("  the beckoning this rung keeps: {s}\n", .{beckon_words(.beckons)});
    print("  what a keeping plan tells an operator: {s}\n", .{beckon_words(.keeps)});
    print("  a call carries eight bytes: the wall it names, echoed whole, and this run's own byte last\n", .{});
    return 0;
}


/// A call across a provisioning, proven outside any run.
///
/// The lap below proves the beckoning end to end under a real plan. This proves
/// the two properties that make a call worth carrying: it survives a
/// provisioning, since a summons swept every morning would leave the person who
/// can act on the matter exactly as uncalled as before -- **and the call lands
/// in a box outside this plan's wire**, so taking down every note the plan keeps
/// leaves the reader holding what they were told.
pub fn check_beckon_wire(io: std.Io, sys: *const system.System) u8 {
    clear_calls(io, standing_address);
    clear_desist(io);
    clear_mind(io);
    if (called_of(io, standing_address) != null) {
        print("  RED: a call stood in a box nobody had written to\n", .{});
        return 1;
    }
    const held = holds_bytes(rests_bytes(knows_bytes(anew_bytes(inherited_matter)), .stands));
    const mark = minds_bytes(held);
    const wall = walls_bytes(mark);
    // The run before today, standing in for itself: it stood this wall among
    // the plan's own notes, exactly as the rung below leaves a wire.
    wall_note(io, mark) catch |err| {
        print("  RED: a wall could not be stood: {s}\n", .{@errorName(err)});
        return 1;
    };
    call_reader(io, standing_address, wall) catch |err| {
        print("  RED: a call could not be carried: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = called_of(io, standing_address) orelse {
        print("  RED: a provisioning cleared the call a person reads\n", .{});
        return 1;
    };
    if (!calls_carries(survived, wall)) {
        print("  RED: a call carried past a provisioning stopped naming its wall\n", .{});
        return 1;
    }
    if (calls_rest(survived) != .stands) {
        print("  RED: a call carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And the call outlives the plan's own drawer, which is the whole point of
    // writing it where the reader is rather than where the record is kept.
    clear_desist(io);
    if (called_of(io, standing_address) == null) {
        print("  RED: a call fell with the wall it was only carrying\n", .{});
        return 1;
    }
    clear_calls(io, standing_address);
    if (called_of(io, standing_address) != null) {
        print("  RED: a call outlived the taking down of the reader's own note\n", .{});
        return 1;
    }
    clear_mind(io);
    print("  a call survives a provisioning, and outlives the drawer the wall it names was kept in\n", .{});
    return 0;
}


/// The reading lap: one plan run twice over a quarrel already carried out to a
/// hand that is neither party, with that hand's own answer sitting in their box
/// the whole time -- once left unread, and once read and published beside the
/// outcome.
pub fn check_suffice_runs(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
) u8 {
    // The other answers the same question admits, proven on the same wire before
    // the two measured runs rather than only as a fold. A quarrel raised on this
    // very run travels nowhere, so there is nobody who owes it a word -- and a
    // run owed no word publishes none, however willing it was to read one.
    var fresh_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .concedes, .books, .meets, .hollow, .sound, .withheld, .unasked, .closes, .passes, .withholds, .unread, .opens, .begins, .relays, .keeps, .presses, 0, .presses, .upholds, null, null, null, null, null, null, &fresh_run)) return 1;
    if (deem_of(&fresh_run).answered != 0 or deem_of(&fresh_run).unanswered != 0) {
        print("  RED: a quarrel raised this morning was answered {d} times\n", .{deem_of(&fresh_run).answered});
        return 1;
    }
    if (deem_published(io) != null) {
        print("  RED: a plan that carried no case out published a finding anyway\n", .{});
        return 1;
    }
    print("  a run owed no word from anybody publishes none\n", .{});

    // The other ending: a plan nobody ever pressed a quarrel against refers
    // nothing anywhere, so no third hand's word is ever about it.
    var clear_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .concedes, .books, .meets, .hollow, .sound, .withheld, .unasked, .closes, .passes, .withholds, .unread, .opens, .begins, .relays, .keeps, null, 0, .accepts, .upholds, null, null, null, null, null, null, &clear_run)) return 1;
    if (deem_of(&clear_run).answered != 0 or deem_of(&clear_run).awaited_in != 0 or deem_of(&clear_run).unanswered != 0) {
        print("  RED: a plan nobody pressed read {d} findings\n", .{deem_of(&clear_run).answered});
        return 1;
    }
    if (deem_published(io) != null) {
        print("  RED: a plan nobody pressed published a third hand's word all the same\n", .{});
        return 1;
    }
    print("  a plan nobody ever pressed a quarrel against is answered by nobody\n", .{});

    // And the honest middle: a desk that simply has not opened the case yet
    // leaves it waiting, which is a different fact from a plan that never asks.
    var silent_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .unread, .concedes, .books, .meets, .hollow, .sound, .withheld, .unasked, .closes, .passes, .withholds, .unread, .opens, .begins, .relays, .keeps, .presses, long_standing_runs, .presses, null, null, null, null, null, null, null, &silent_run)) return 1;
    if (deem_of(&silent_run).awaited_in != 1 or deem_of(&silent_run).unanswered != 1) {
        print("  RED: a case on a desk that has said nothing counted as {d} waiting\n", .{
            deem_of(&silent_run).awaited_in,
        });
        return 1;
    }
    if (finding_written(io, standing_forum) != null) {
        print("  RED: a run wrote a third hand's answer for them\n", .{});
        return 1;
    }
    if (deem_published(io) != null) {
        print("  RED: a plan published a finding out of an empty box\n", .{});
        return 1;
    }
    print("  a desk that has said nothing yet leaves the case honestly waiting\n", .{});

    // The plan that keeps its own word says so, proven on the wire before the
    // two measured runs. An avowal is the plan's own position and never an
    // agreement extracted from it -- a supervisor made to answer is not a
    // supervisor made to yield, and a plan holding to its word on the record is
    // as honest an answer as taking the finding.
    var held_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .dissents, .books, .meets, .hollow, .sound, .withheld, .unasked, .closes, .passes, .withholds, .unread, .opens, .begins, .relays, .keeps, .presses, long_standing_runs, .presses, .upholds, null, null, null, null, null, null, &held_run)) return 1;
    if (avow_of(&held_run).said != 1 or avow_of(&held_run).unavowed != 0) {
        print("  RED: a plan keeping its own word said {d} of them\n", .{avow_of(&held_run).said});
        return 1;
    }
    if (stance_in(avow_written(io)) != .dissents) {
        print("  RED: a plan keeping its own word published some other answer\n", .{});
        return 1;
    }
    if (settlement_published(io) != .carried) {
        print("  RED: a dissenting run rewrote what the work came to\n", .{});
        return 1;
    }
    if (debt_standing(io) != null) {
        print("  RED: a plan keeping its own word was made to owe the work a look\n", .{});
        return 1;
    }
    print("  a plan keeping its own word owes the work nothing, and books nothing\n", .{});

    // And the ending one rung further down: a plan that says nothing has
    // conceded nothing, so there is no admission to carry anywhere. Silence is
    // already counted by the rung below; this rung declines to read it as one.
    var mute_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .mute, .books, .meets, .hollow, .sound, .withheld, .unasked, .closes, .passes, .withholds, .unread, .opens, .begins, .relays, .keeps, .presses, long_standing_runs, .presses, .upholds, null, null, null, null, null, null, &mute_run)) return 1;
    if (owe_of(&mute_run).booked != 0 or owe_of(&mute_run).unbooked != 0) {
        print("  RED: a mute run booked {d} debts out of a word it never said\n", .{owe_of(&mute_run).booked});
        return 1;
    }
    if (debt_standing(io) != null) {
        print("  RED: a plan that said nothing left a debt standing anyway\n", .{});
        return 1;
    }
    print("  a plan that says nothing concedes nothing, and books nothing\n", .{});

    // And this rung's own ending, reached on the same run: that plan opened
    // holding nothing, so however willing it was to meet a debt, there was no
    // admission on the wire for it to answer.
    if (meet_of(&mute_run).met != 0 or meet_of(&mute_run).unmet != 0 or meet_of(&mute_run).deferred != 0) {
        print("  RED: a plan inheriting nothing met {d} debts\n", .{meet_of(&mute_run).met});
        return 1;
    }
    if (meeting_written(io) != null) {
        print("  RED: a plan inheriting nothing wrote a receipt all the same\n", .{});
        return 1;
    }
    print("  a plan inheriting nothing meets nothing, and writes no receipt\n", .{});

    // The two measured runs. Both open holding the same debt an earlier run
    // booked, both carry the same case to the same desk, both read the same
    // hand's answer, both publish the same finding, both take that finding on
    // the record in the same words, and both meet the admission they opened
    // holding and take it down. What parts them is whether the meeting ever says
    // what it found.
    var bare_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .concedes, .free, .meets, .redresses, .righted, .apprises, .asks, .closes, .looks, .tells, .reads, .forbears, .minds, .bounds, .keeps, .presses, long_standing_runs, .presses, .upholds, inherited_debt, .wanting, inherited_matter, .stands, inherited_impasse, elder_mark, &bare_run)) return 1;
    const bare_said = settlement_published(io) orelse {
        print("  RED: a run published no settlement at all\n", .{});
        return 1;
    };
    if (bare_said != .carried) {
        print("  RED: the wire read {s} where every lost arc was served\n", .{
            settlement_words(bare_said),
        });
        return 1;
    }
    const bare_mark = escort_written(io) orelse {
        print("  RED: an escorting run left its published word standing alone\n", .{});
        return 1;
    };
    const left_standing = position_standing(io) orelse {
        print("  RED: an unread run took down a note nobody withdrew\n", .{});
        return 1;
    };
    if (left_standing != .presses) {
        print("  RED: a quarrel left standing read back as {s}\n", .{plea_words(left_standing)});
        return 1;
    }
    const bare_age = dwell_published(io) orelse {
        print("  RED: a dating run left the standing quarrel with no age at all\n", .{});
        return 1;
    };
    if (bare_age != long_standing_runs + 1) {
        print("  RED: a quarrel of {d} runs that stood one more read back as {d}\n", .{
            long_standing_runs, bare_age,
        });
        return 1;
    }
    if (swell_published(io) != .loud) {
        print("  RED: a heralding run left the outcome silent about a long-standing quarrel\n", .{});
        return 1;
    }
    const bare_case = case_delivered(io, standing_forum) orelse {
        print("  RED: an unread run never carried the case out at all\n", .{});
        return 1;
    };
    // The whole harm this rung repairs, read straight off the wire: the case is
    // on the desk, the hand at that desk has written their answer into their own
    // box -- and the place an operator opens says nothing whatever about it.
    if (finding_in(finding_written(io, standing_forum)) != .upholds) {
        print("  RED: the hand this lap seated never answered in their own box\n", .{});
        return 1;
    }
    // The whole harm this rung repairs, read straight off the wire: the finding
    // stands published beside the outcome, in a hand that found against the
    // plan -- and the plan is never made to say one word about it.
    if (deem_published(io) != .upholds) {
        print("  RED: a free run never published the finding it read\n", .{});
        return 1;
    }
    if (stance_in(avow_written(io)) != .concedes) {
        print("  RED: a conceding run published some other answer\n", .{});
        return 1;
    }
    // The meeting below, made in full: the plan opened holding an admission an
    // earlier run booked, took it up, receipted it, took it down, and said what
    // the look came to.
    const bare_receipt = meeting_written(io) orelse {
        print("  RED: an unasking run left the inherited debt unmet after all\n", .{});
        return 1;
    };
    if (!met_answers(bare_receipt, inherited_debt)) {
        print("  RED: an unasking run met some admission other than the one it opened holding\n", .{});
        return 1;
    }
    if (!debt_settled(debt_standing(io))) {
        print("  RED: an unasking run wrote a receipt and left the debt standing\n", .{});
        return 1;
    }
    const bare_finding = redress_written(io) orelse {
        print("  RED: an unasking run never said what its look found\n", .{});
        return 1;
    };
    if (!redress_answers(bare_finding, bare_receipt)) {
        print("  RED: an unasking run reported on some meeting other than its own\n", .{});
        return 1;
    }
    // The apprising below, made in full: the answer went home to the reader who
    // won it, byte for byte.
    const bare_carried = apprised_of(io, standing_address) orelse {
        print("  RED: an unasking run left the raiser with nothing after all\n", .{});
        return 1;
    };
    if (!apprise_holds(bare_carried, found_bytes(bare_finding))) {
        print("  RED: an unasking run carried something other than the finding it reached\n", .{});
        return 1;
    }
    // The whole harm this rung repairs, read straight off the wire: the reader
    // has opened their box, read what the look came to, written down that it
    // falls short of settling anything -- and the place an operator opens says
    // not one word about it.
    if (!suits_answers(worth_written(io, standing_address), bare_carried)) {
        print("  RED: the reader this lap seated never weighed the answer in their own box\n", .{});
        return 1;
    }
    if (worth_published(io) != .wanting) {
        print("  RED: a closing run never published the word its reader wrote\n", .{});
        return 1;
    }
    // The looking below, made in full: the run opened holding a matter its own
    // reader had reopened, took the look again, receipted it, and took the
    // matter down. Both measured runs do exactly this much.
    const bare_second = anew_standing(io) orelse {
        print("  RED: a withholding run never looked again at all\n", .{});
        return 1;
    };
    if (!reweigh_holds(bare_second, inherited_matter)) {
        print("  RED: a withholding run receipted some matter other than the one it inherited\n", .{});
        return 1;
    }
    if (!matter_closed(again_standing(io))) {
        print("  RED: a withholding run wrote a receipt and left the matter standing\n", .{});
        return 1;
    }
    // The telling below, made in full: the second look went home to the reader
    // who asked for it, byte for byte. Both measured runs do exactly this much.
    const bare_told = recounted_to(io, standing_address) orelse {
        print("  RED: an unreading run left its reader with nothing after all\n", .{});
        return 1;
    };
    if (!recount_holds(bare_told, knows_bytes(bare_second))) {
        print("  RED: an unreading run carried something other than the look it made\n", .{});
        return 1;
    }
    // The reading below, made in full: the reply this lap's reader wrote is
    // opened and published where the settlement is read. Both measured runs do
    // exactly this much, and both read the same word -- the matter still
    // stands.
    if (!rests_answers(rest_written(io, standing_address), bare_told)) {
        print("  RED: the reader this lap seated never replied to the telling in their own box\n", .{});
        return 1;
    }
    if (rest_published(io) != .stands) {
        print("  RED: an opening run never published the standing word its reader wrote\n", .{});
        return 1;
    }
    // The minding below, made in full: this run opened holding an impasse a run
    // before today handed forward and named it where its outcome is read. Both
    // measured runs do exactly this much.
    const bare_marked = mind_published(io) orelse {
        print("  RED: a relaying run never named the impasse it opened holding\n", .{});
        return 1;
    };
    if (!minds_carries(bare_marked, inherited_impasse)) {
        print("  RED: a relaying run marked some matter other than the one it inherited\n", .{});
        return 1;
    }
    // The bounding below, made in full: the matter has now been named by two
    // runs in a row, and this one stands a wall where the correspondence used to
    // run. Both measured runs do exactly this much, and both stay the relay.
    const bare_wall = wall_standing(io) orelse {
        print("  RED: a keeping run stood no wall at all\n", .{});
        return 1;
    };
    if (!walls_carries(bare_wall, elder_mark)) {
        print("  RED: a keeping run bounded some matter other than the one it named\n", .{});
        return 1;
    }
    if (hold_standing(io) != null) {
        print("  RED: a keeping run handed the walled matter on after all\n", .{});
        return 1;
    }
    // The whole harm this rung repairs, read straight off the wire: the wall
    // stands in the drawer only the plan opens, and the box the reader actually
    // reads holds no word of it at all.
    if (called_of(io, standing_address) != null) {
        print("  RED: a keeping run called a person to the wall after all\n", .{});
        return 1;
    }

    var under_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .weighed, .released, .told, .heralded, .referred, .answered, .concedes, .free, .meets, .redresses, .righted, .apprises, .asks, .closes, .looks, .tells, .reads, .forbears, .minds, .bounds, .beckons, .presses, long_standing_runs, .presses, .upholds, inherited_debt, .wanting, inherited_matter, .stands, inherited_impasse, elder_mark, &under_run)) return 1;
    const under_said = settlement_published(io) orelse {
        print("  RED: a reading run published no settlement at all\n", .{});
        return 1;
    };
    // The word itself, untouched: reading what a third hand made of the case
    // changes what an operator knows about the argument, never what the work
    // came to. **A finding for the reader leaves the plan carried out whole.**
    if (under_said != bare_said) {
        print("  RED: a reading run settled {s} where the unread run settled {s}\n", .{
            settlement_words(under_said), settlement_words(bare_said),
        });
        return 1;
    }
    if (escort_written(io) != bare_mark) {
        print("  RED: a reading run rewrote the reading its reader holds\n", .{});
        return 1;
    }
    // The quarrel itself, untouched: a hand outside the argument says what they
    // make of it, and never whether it stands.
    if (position_standing(io) != .presses) {
        print("  RED: a reading run closed the quarrel a third hand only weighed\n", .{});
        return 1;
    }
    if (dwell_published(io) != bare_age) {
        print("  RED: a reading run rewrote the age it was only asked to read\n", .{});
        return 1;
    }
    if (swell_published(io) != .loud) {
        print("  RED: a reading run rewrote the standing it was only asked to read\n", .{});
        return 1;
    }
    // The case below, untouched by the answer taken from beside it.
    if (!refer_holds(case_delivered(io, standing_forum), bare_case)) {
        print("  RED: a reading run rewrote the case it had already carried out\n", .{});
        return 1;
    }
    // The note this rung writes, read outside the run that wrote it: one byte
    // beside the settlement, in a hand that is neither party's.
    const published = deem_published(io) orelse {
        print("  RED: a reading run left the outcome silent about the answer it got\n", .{});
        return 1;
    };
    if (published != .upholds) {
        print("  RED: a finding for the reader was published as {s}\n", .{
            finding_words(published),
        });
        return 1;
    }
    // And the third hand still holds their own word, in their own box, exactly
    // as they wrote it. A plan that could edit the answer it quotes would be
    // grading the objection against it after all.
    if (finding_in(finding_written(io, standing_forum)) != .upholds) {
        print("  RED: a reading run rewrote the word it was only asked to read\n", .{});
        return 1;
    }
    if (regard_published(io) == null) {
        print("  RED: an answered quarrel stopped standing over the plan's own word\n", .{});
        return 1;
    }
    // The note this rung writes, read outside the run that wrote it: two bytes
    // beside the finding, in the plan's own hand and nobody else's.
    const spoken = avow_written(io) orelse {
        print("  RED: an avowing run left the outcome silent about its own answer\n", .{});
        return 1;
    };
    if (!avowal_answers(spoken, .upholds)) {
        print("  RED: a plan answered some verdict other than the one it published\n", .{});
        return 1;
    }
    if (stance_in(spoken) != .concedes) {
        print("  RED: a plan taking the finding published {s}\n", .{
            avow_words(stance_in(spoken) orelse .mute),
        });
        return 1;
    }
    // The note this rung writes, read outside the run that wrote it: the debt
    // this run opened holding, echoed back exactly, in the plan's own hand --
    // the receipt for an admission finally looked at.
    const receipt = meeting_written(io) orelse {
        print("  RED: a meeting run left the inherited debt unanswered after all\n", .{});
        return 1;
    };
    if (!met_answers(receipt, inherited_debt)) {
        print("  RED: a run met some admission other than the one it opened holding\n", .{});
        return 1;
    }
    if (met_over(receipt) != .overrules) {
        print("  RED: a receipt forgot the finding its debt was taken over\n", .{});
        return 1;
    }
    // And the act the receipt is only the record of: the debt is finally down,
    // so no run after this one inherits an admission already answered.
    if (!debt_settled(debt_standing(io))) {
        print("  RED: a meeting run wrote a receipt and left the debt standing\n", .{});
        return 1;
    }

    // The note this rung writes, read outside the run that wrote it: what the
    // look at that admission actually came to, in the plan's own hand, standing
    // beside the receipt rather than in place of it.
    const finding = redress_written(io) orelse {
        print("  RED: a redressing run closed its meeting in silence after all\n", .{});
        return 1;
    };
    if (!redress_answers(finding, receipt)) {
        print("  RED: a run reported on some meeting other than the one it made\n", .{});
        return 1;
    }
    if (redress_upshot(finding) != .righted) {
        print("  RED: a finding forgot what the look it reports on came to\n", .{});
        return 1;
    }
    // And the receipt it reports on, still standing: a redress is a word about a
    // meeting rather than a meeting written over.
    if (meeting_written(io) == null) {
        print("  RED: a redressing run wrote over the receipt it was reporting on\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made it
    // and outside the plan's wire entirely: the same three bytes, in the box the
    // reader who raised the quarrel already knows.
    const carried_home = apprised_of(io, standing_address) orelse {
        print("  RED: an apprising run left the raiser with nothing after all\n", .{});
        return 1;
    };
    if (!apprise_holds(carried_home, found_bytes(finding))) {
        print("  RED: the reader was carried something other than the finding this run reached\n", .{});
        return 1;
    }
    // And the plan's own note, still standing exactly where the redress left it:
    // an apprising carries a finding outward rather than moving one.
    if (redress_written(io) == null) {
        print("  RED: an apprising run carried its own finding out of its own notes\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made
    // it: the reader's own verdict on the answer they were carried, published
    // where the settlement is read rather than left in a box only they open.
    const learned = worth_published(io) orelse {
        print("  RED: an asking run left the outcome silent about its reader's word\n", .{});
        return 1;
    };
    if (learned != .wanting) {
        print("  RED: a reader saying the answer falls short was published as {s}\n", .{
            worth_words(learned),
        });
        return 1;
    }
    // And the reader still holds their own word, in their own box, exactly as
    // they wrote it. A plan that could edit the verdict it quotes would be
    // grading its own answer after all.
    if (!suits_answers(worth_written(io, standing_address), carried_home)) {
        print("  RED: an asking run rewrote the word it was only asked to read\n", .{});
        return 1;
    }
    // And the delivery it weighs, still standing: a weighing reads an answer
    // rather than spending one.
    if (apprised_of(io, standing_address) == null) {
        print("  RED: an asking run took down the answer its reader had weighed\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made
    // it: the matter its reader reopened, looked at a second time, receipted
    // where a later run reads it -- and taken down, so no run after this one
    // inherits a question already answered.
    const receipted = anew_standing(io) orelse {
        print("  RED: a looking run left no receipt of its second look at all\n", .{});
        return 1;
    };
    if (!reweigh_holds(receipted, inherited_matter)) {
        print("  RED: a looking run receipted some matter other than the one it inherited\n", .{});
        return 1;
    }
    if (!matter_closed(again_standing(io))) {
        print("  RED: a looking run wrote a receipt and left the matter standing\n", .{});
        return 1;
    }
    // And the reader keeps their own word exactly where they wrote it -- a
    // second look answers a verdict rather than moving one.
    if (worth_written(io, standing_address) == null) {
        print("  RED: a looking run reached into its reader's box\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read where the reader opens it:
    // the second look carried out of the plan's own notes and into the box of
    // the person who asked for it -- four bytes, the matter echoed back whole.
    const told = recounted_to(io, standing_address) orelse {
        print("  RED: a telling run left its reader with nothing after all\n", .{});
        return 1;
    };
    if (!recount_holds(told, knows_bytes(receipted))) {
        print("  RED: a telling run carried something other than the look it made\n", .{});
        return 1;
    }
    // And the receipt it copies is still standing among the plan's own notes: a
    // telling carries a record outward rather than moving one.
    if (anew_standing(io) == null) {
        print("  RED: a telling run carried its own receipt out of its own notes\n", .{});
        return 1;
    }
    // And the reader's own word is still exactly where they wrote it, since
    // telling somebody what a look found is no license to edit what they said.
    if (!suits_answers(worth_written(io, standing_address), apprised_of(io, standing_address) orelse [_]u8{0} ** max_found_bytes)) {
        print("  RED: a telling run rewrote the word it was only asked to answer\n", .{});
        return 1;
    }

    // The reading below it, made in full and untouched: the reader's own word
    // about the second look, published where the settlement is read.
    const rested = rest_published(io) orelse {
        print("  RED: a forbearing run left the outcome silent about its reader's reply\n", .{});
        return 1;
    };
    if (rested != .stands) {
        print("  RED: a reader saying the matter still stands was published as {s}\n", .{
            rest_words(rested),
        });
        return 1;
    }
    // And the reader still holds their own reply, in their own box, exactly as
    // they wrote it. A plan that could edit the word it quotes would be grading
    // its own second look after all.
    if (!rests_answers(rest_written(io, standing_address), told)) {
        print("  RED: a reading run rewrote the reply it was only asked to read\n", .{});
        return 1;
    }
    // And the telling it answers, still standing: a reading opens a reply
    // rather than spending a telling.
    if (recounted_to(io, standing_address) == null) {
        print("  RED: a reading run took down the telling its reader had answered\n", .{});
        return 1;
    }

    // The forbearing below, still weighed and now answered rather than repeated:
    // the reader's own reply is still exactly where they wrote it, and the
    // matter it refuses is handed to nobody at all.
    const answered = rest_written(io, standing_address) orelse {
        print("  RED: the reader this lap seated kept no reply of their own\n", .{});
        return 1;
    };
    if (holds_rest(holds_bytes(answered)) != .stands) {
        print("  RED: the reader this lap seated left the matter anywhere but standing\n", .{});
        return 1;
    }
    // And the telling their refusal answers is still standing: bounding keeps
    // every record beneath it rather than spending one.
    if (recounted_to(io, standing_address) == null) {
        print("  RED: a bounding run took down the telling its reader refused\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made
    // it: the impasse this run opened holding, named where an operator reads
    // the outcome rather than left as a note only the next run of this plan
    // would ever open.
    const marked = mind_published(io) orelse {
        print("  RED: a minding run left the outcome silent about what it opened holding\n", .{});
        return 1;
    };
    if (!minds_carries(marked, inherited_impasse)) {
        print("  RED: a minding run named some impasse other than the one it opened holding\n", .{});
        return 1;
    }
    if (minds_rest(marked) != .stands) {
        print("  RED: a mark carried a word other than the refusal it was handed\n", .{});
        return 1;
    }
    // And the reader's own reply is still exactly where they wrote it: a
    // minding reads an inheritance rather than rewriting anybody's word.
    if (!rests_answers(rest_written(io, standing_address), told)) {
        print("  RED: a minding run rewrote the reply its inheritance was made of\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made
    // it: the wall this run stood around a matter two runs have now named,
    // seated beside the mark it bounds where an operator reads the outcome.
    const bounded = wall_standing(io) orelse {
        print("  RED: a bounding run stood no wall at all\n", .{});
        return 1;
    };
    if (!walls_carries(bounded, marked)) {
        print("  RED: a bounding run walled some matter other than the one it named\n", .{});
        return 1;
    }
    if (walls_rest(bounded) != .stands) {
        print("  RED: a wall carried a word other than the refusal it was built on\n", .{});
        return 1;
    }
    // And the relay is stayed, read straight off the wire: the run that comes
    // after this one opens holding neither the matter nor the pretense that
    // another lap will settle it.
    if (hold_standing(io) != null) {
        print("  RED: a bounding run handed the walled matter on after all\n", .{});
        return 1;
    }

    // The act this rung is the whole point of, read outside the run that made
    // it and outside this plan's wire entirely: the call standing in the box
    // the reader already reads, naming the wall the plan stood.
    const called = called_of(io, standing_address) orelse {
        print("  RED: a beckoning run called nobody at all\n", .{});
        return 1;
    };
    if (!calls_carries(called, bounded)) {
        print("  RED: a beckoning run called a person to some other wall\n", .{});
        return 1;
    }
    if (calls_rest(called) != .stands) {
        print("  RED: a call carried a word other than the refusal it was built on\n", .{});
        return 1;
    }
    // And the wall it names still stands exactly where the rung below left it:
    // a call reports on a boundary rather than replacing one, so both facts
    // read at once.
    if (wall_standing(io) == null) {
        print("  RED: a beckoning run took down the wall it was only carrying\n", .{});
        return 1;
    }

    tell_desist_runs(&bare_run, &under_run);
    const judged = judge_beckon_runs(&bare_run, &under_run);
    if (judged != 0) return judged;

    // invariant: a run reaps exactly the dependents it admitted, never more
    assert(run_of(&under_run).reaped == run_of(&under_run).admitted);
    // invariant: a run never reads more findings than one case may earn
    assert(deem_of(&under_run).answered <= 1);
    // invariant: a reading run leaves no carried case unanswered
    assert(deem_of(&under_run).unanswered == 0);
    // invariant: a run never answers more findings than one it read
    assert(avow_of(&under_run).said <= 1);
    // invariant: an avowing run leaves no read finding unanswered
    assert(avow_of(&under_run).unavowed == 0);
    // invariant: a run never meets more debts than one plan may book
    assert(meet_of(&under_run).met <= 1);
    // invariant: a meeting run leaves no inherited debt unmet
    assert(meet_of(&under_run).unmet == 0);
    // invariant: a run never redresses more meetings than it made
    assert(redress_of(&under_run).redressed <= 1);
    // invariant: a redressing run leaves no meeting of its own hollow
    assert(redress_of(&under_run).hollow == 0);
    // invariant: a run never carries out more findings than it reached
    assert(apprise_of(&under_run).apprised <= 1);
    // invariant: an apprising run leaves no raiser of its own unheard
    assert(apprise_of(&under_run).unheard == 0);
    // invariant: a run never weighs more answers than it carried
    assert(under_run.inner.inner.inner.inner.inner.inner.inner.inner.weighed <= 1);
    // invariant: an asking run leaves no answer of its own unmeasured
    assert(under_run.inner.inner.inner.inner.inner.inner.inner.inner.unmeasured == 0);
    // invariant: a run never takes up more matters than one word earns
    assert(under_run.inner.inner.inner.inner.inner.inner.inner.taken_up <= 1);
    // invariant: a run never looks again at more matters than one reader reopened
    assert(under_run.inner.inner.inner.inner.inner.inner.looked <= 1);
    // invariant: a looking run leaves no inherited matter unlooked-at
    assert(under_run.inner.inner.inner.inner.inner.inner.unlooked == 0);
    // invariant: a run never tells of more second looks than it made
    assert(under_run.inner.inner.inner.inner.inner.recounted <= 1);
    // invariant: a telling run leaves no second look of its own untold
    assert(under_run.inner.inner.inner.inner.inner.untold == 0);
    // invariant: a run never reads more replies than one telling earns
    assert(under_run.inner.inner.inner.inner.read_back <= 1);
    // invariant: a reading run leaves no telling of its own unheard
    assert(under_run.inner.inner.inner.inner.unheard == 0);
    // invariant: a run never forbears on more matters than one word leaves standing
    assert(under_run.inner.inner.inner.forborne <= 1);
    // invariant: a forbearing run hands on every matter it left standing
    assert(under_run.inner.inner.inner.unhanded == 0);
    // invariant: a run never names more impasses than one forbearance carries
    assert(under_run.inner.inner.minded <= 1);
    // invariant: a minding run leaves no impasse it opened holding unnamed
    assert(under_run.inner.inner.unminded == 0);
    return 0;
}

fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan beckon {s} -- self-test\n", .{caravan_beckon_version});
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const mending = check_mending();
    if (mending != 0) return mending;
    const bearing = check_bearing();
    if (bearing != 0) return bearing;
    const recanting = check_recantation();
    if (recanting != 0) return recanting;
    const amending = check_amendment();
    if (amending != 0) return amending;
    const delivering = check_delivery();
    if (delivering != 0) return delivering;
    const hearing = check_hearing();
    if (hearing != 0) return hearing;
    const unlost = ladder_checks.check_unlost(@This(), &sys);
    if (unlost != 0) return unlost;
    const disputing = check_dispute();
    if (disputing != 0) return disputing;
    const abiding = check_abide();
    if (abiding != 0) return abiding;
    const lapsing = check_lapse();
    if (lapsing != 0) return lapsing;
    const reposing = check_standing();
    if (reposing != 0) return reposing;
    const tiding = check_tidings();
    if (tiding != 0) return tiding;
    const wired = ladder_checks.check_tidings_wire(@This(), io);
    if (wired != 0) return wired;
    const appealing = check_appeal();
    if (appealing != 0) return appealing;
    const pleaded = ladder_checks.check_appeal_wire(@This(), io);
    if (pleaded != 0) return pleaded;
    const enduring = check_endure();
    if (enduring != 0) return enduring;
    const survived = ladder_checks.check_endure_wire(@This(), io, &sys);
    if (survived != 0) return survived;
    const heeding = check_heed();
    if (heeding != 0) return heeding;
    const regarded = ladder_checks.check_heed_wire(@This(), io, &sys);
    if (regarded != 0) return regarded;
    const relenting = check_relent();
    if (relenting != 0) return relenting;
    const released = ladder_checks.check_relent_wire(@This(), io, &sys);
    if (released != 0) return released;
    const dwelling = check_dwell();
    if (dwelling != 0) return dwelling;
    const aged = ladder_checks.check_dwell_wire(@This(), io, &sys);
    if (aged != 0) return aged;
    const referring = check_swell();
    if (referring != 0) return referring;
    const published = ladder_checks.check_swell_wire(@This(), io, &sys);
    if (published != 0) return published;
    const carried = ladder_checks.check_refer_wire(@This(), io, &sys);
    if (carried != 0) return carried;
    const answered = ladder_checks.check_deem_wire(@This(), io, &sys);
    if (answered != 0) return answered;
    const spoken = ladder_checks.check_avow_wire(@This(), io, &sys);
    if (spoken != 0) return spoken;
    const meeting = ladder_checks.check_meet(@This());
    if (meeting != 0) return meeting;
    const receipted = ladder_checks.check_meet_wire(@This(), io, &sys);
    if (receipted != 0) return receipted;
    const runs = check_suffice_runs(allocator, io, self_path, &sys);
    if (runs != 0) return runs;
    print("  GREEN: a plan carries the wall it stood out to the person who can act on it, rather than keeping the ending in a drawer\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return run_self_test(allocator, io, self_path);
}

/// Prints the tiers whose correspondence closes the loop: the second look
/// carried home, the reply that reader wrote back, the impasse this run hands
/// to the next one, and the impasse it opened holding.
///
/// Split from the telling above it because the arc grew past the length a
/// reader holds in one glance, and a line the eye skips is a line nobody
/// checks. The numbers are unchanged; only where they are printed moved.
fn tell_beckon_own(bare_run: *Report, under_run: *Report) void {
    // invariant: a telling always reads two runs that were actually run
    assert(run_of(bare_run).queued >= 1);
    // invariant: a telling never names more impasses than one forbearance carries
    assert(under_run.inner.inner.minded <= 1);
    print("  second looks this run carried home to the reader who asked: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.inner.inner.recounted, under_run.inner.inner.inner.inner.inner.recounted,
    });
    print("  second looks this run kept inside its own notes: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.inner.inner.withheld, under_run.inner.inner.inner.inner.inner.withheld,
    });
    print("  second looks a run made whose reader was never told: {d} against {d}\n", .{
        bare_run.inner.inner.inner.inner.inner.untold, under_run.inner.inner.inner.inner.inner.untold,
    });
    print("  tellings this run read its reader's own word on: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.inner.read_back, under_run.inner.inner.inner.inner.read_back,
    });
    print("  tellings this run made with nobody's reply opened: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.inner.unread, under_run.inner.inner.inner.inner.unread,
    });
    print("  tellings a run made whose reader's word was never read back: {d} against {d}\n", .{
        bare_run.inner.inner.inner.inner.unheard, under_run.inner.inner.inner.inner.unheard,
    });
    print("  standing matters this run handed to the run after it: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.forborne, under_run.inner.inner.inner.forborne,
    });
    print("  standing matters this run left for the next run to open afresh: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.inner.opened, under_run.inner.inner.inner.opened,
    });
    print("  matters a run left standing with nothing handed on: {d} against {d}\n", .{
        bare_run.inner.inner.inner.unhanded, under_run.inner.inner.inner.unhanded,
    });
    print("  inherited impasses this run named where the outcome is read: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.minded, under_run.inner.inner.minded,
    });
    print("  inherited impasses this run began the matter again from: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.inner.begun, under_run.inner.inner.begun,
    });
    print("  impasses a run opened holding and never named: {d} against {d}\n", .{
        bare_run.inner.inner.unminded, under_run.inner.inner.unminded,
    });
    print("  twice-carried impasses this run stood a wall around: {d} keeping, {d} beckoning\n", .{
        bare_run.inner.walled, under_run.inner.walled,
    });
    print("  impasses a plan carried round twice and relayed anyway: {d} against {d}\n", .{
        bare_run.inner.unbounded, under_run.inner.unbounded,
    });
    print("  stood walls this run carried out to the person who can act on it: {d} keeping, {d} beckoning\n", .{
        bare_run.beckoned, under_run.beckoned,
    });
    print("  stood walls this run kept in the plan's own drawer: {d} keeping, {d} beckoning\n", .{
        bare_run.kept, under_run.kept,
    });
    print("  walls a plan stood and told nobody about: {d} against {d}\n", .{
        bare_run.unheralded, under_run.unheralded,
    });
    print("  work still standing when the supervisor exits: {d} keeping, {d} beckoning\n", .{
        below_of(bare_run).unserved, below_of(under_run).unserved,
    });
    print("  the plan, as an operator finally reads it: {s} keeping, {s} beckoning\n", .{
        settlement_words(bearing_of(bare_run).settlement), settlement_words(bearing_of(under_run).settlement),
    });
    print("  breaks a named turn: {d} keeping, {d} beckoning\n", .{
        preceded_of(bare_run).out_of_precede, preceded_of(under_run).out_of_precede,
    });
}


