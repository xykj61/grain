//! Caravan cohort -- the widest set of domains a document may run at once,
//! derived rather than chosen.
//!
//! `concurrent.rye` spawned two dependents of one ring before either was
//! reaped, and answered the pair question exactly: two domains may run
//! together when they share no region and no channel. It closed on the
//! arithmetic of a ring -- every domain adjacent to two others, so the
//! non-adjacent pairs number `n * (n - 3) / 2`, zero at three and two at
//! four -- and it left the next question standing. A supervisor holding
//! three slots wants the widest **set** it may run, and a pair is only the
//! smallest such set.
//!
//! **A set may run together exactly when every pair in it may.** Both
//! hazards are relations between two domains -- a region one may write
//! while the other reads, a bell one may ring while the other clears -- so
//! a set carries no hazard its pairs do not already carry. That is why the
//! pair predicate `concurrent.rye` proved is reused whole here rather than
//! restated one size up.
//!
//! **A ring has no room for three.** Its widest set is `floor(n / 2)` --
//! one at three, two at four -- so a non-adjacent triple wants a ring of
//! six, past the four dependents one supervisor holds. The shape with room
//! for three is not a ring at all; it is the most ordinary shape in this
//! tree, one server and its clients. `serve.rye` proved two clients never
//! hear each other's bell, and `serial_three_clients.bron` turns that
//! isolation into room a supervisor can spend.
//!
//! **The widest set is not what you get by taking the first domain that
//! fits.** In that document the virtualiser is declared first and touches
//! every client, so first-fit takes it and runs one dependent, while the widest
//! set is the three clients. The two answers differ by three-fold on the
//! plainest shape in the tree, which is why the derivation is exhaustive
//! rather than greedy.
//!
//! **The cost of exhaustive is named rather than hidden.** Weighing every
//! subset costs `2^n`, and `n` is bounded at `channels.max_domains`, so the
//! search is bounded at 256 subsets by the same constant that bounds the
//! roster. A supervisor bounds its roster; it never bounds its search and
//! calls the narrower answer the widest.
//!
//! **The room comes from privacy, and privacy costs a shape verdict.** Each
//! client keeps a tail region no other domain may reach, which is what lets
//! three clients hold the machine together. A region only one domain can
//! reach carries no direction, so the declaration answers `no directed flow
//! to derive` rather than naming a ring -- the same kind of price
//! `serial_cycle_wide_mute.bron` paid for silent sharing, stated here
//! rather than hidden.
//!
//! **And the answer belongs to the document.** Subsets are weighed in
//! ascending order and a tie leaves the standing answer alone, so two
//! supervisors reading the same declaration derive the same cohort without
//! ever speaking to one another.
//!
//! Hosted ground: real processes, real files, pure policy, no kernel
//! underneath it yet.
//!
//! Usage:
//!   cohort selftest                  Run a lap with three in flight
//!   cohort                           Same as selftest
//!   cohort dependent <domain> <plan> ... Run as a supervised dependent (internal)

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const channels = @import("channels.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const restart = @import("restart.rye");
const gap = @import("gap.rye");
const standby = @import("standby.rye");
const concurrent = @import("concurrent.rye");
const tally_parse_int = @import("parse_int.rye");

const caravan_cohort_version = "20260819.175639";

// =========================================================================
// The bounds -- one server, its clients, and the search that weighs them
// =========================================================================

/// One virtualiser and three clients: the first shape in this arc with room
/// for three domains at the same moment.
pub const declaration_path = "caravan/systems/serial_three_clients.bron";

/// The ring of four, kept here to be measured rather than run: its widest
/// set is a pair, which is what sent this rung looking past a ring.
pub const ring_path = concurrent.declaration_path;

/// The ring of three, whose widest set is a single domain.
pub const serial_path = concurrent.serial_path;

/// How many dependents of one document this supervisor holds unreaped at once.
///
/// Three, because three is the widest set the shape below has room for and
/// a bound that fell short of the document's own room would make the
/// derivation decorative.
pub const max_in_flight: u32 = 3;

/// How many subsets a derivation weighs at most.
///
/// The search is exhaustive, so it costs one pass per subset of the roster
/// -- `2^n`. Naming the ceiling here binds it to the roster bound rather
/// than leaving it to the shape of whatever document arrives.
pub const max_subsets: u32 = @as(u32, 1) << @intCast(channels.max_domains);

/// A dependent's fixed argv: the program, the marker, its domain, its plan, the
/// point it may be dropped at, how it wakes its successor, and how many
/// capability words follow. The same seven words `gap.rye` proved.
pub const fixed_argv_words: u32 = gap.fixed_argv_words;

comptime {
    // invariant: a cohort is wider than the pair `concurrent.rye` proved
    assert(max_in_flight > concurrent.max_in_flight);
    // invariant: a stage never asks for more dependents than one table holds
    assert(max_in_flight <= capabilities.max_dependents);
    // invariant: the search stays bounded by the roster it searches
    assert(max_subsets == 256);
    // invariant: a whole dependent argv stays within what one run builds
    assert(fixed_argv_words + capabilities.max_caps_per_dependent + notify.max_peers_per_dependent <= 32);
}

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return concurrent.outcome_name(code);
}

// =========================================================================
// The cohort -- a set of domains, and what a document says about it
// =========================================================================

/// A set of declared domains, held as one word of bits.
///
/// A bit set rather than a list, because the whole derivation walks subsets
/// and a subset of a bounded roster is exactly a number below `2^n`.
pub const Cohort = struct {
    /// Bit `d` stands when domain `d` belongs to the set.
    mask: u32 = 0,
    /// How many bits stand, carried rather than recounted.
    count: u32 = 0,

    /// Answers whether a domain belongs to this set.
    pub fn holds(self: Cohort, d: u32) bool {
        // invariant: a membership question addresses a domain a roster can hold
        assert(d < channels.max_domains);
        return (self.mask & (@as(u32, 1) << @intCast(d))) != 0;
    }

    /// Answers this set with one more domain in it.
    pub fn with(self: Cohort, d: u32) Cohort {
        // invariant: a set only grows by a domain a roster can hold
        assert(d < channels.max_domains);
        // invariant: a domain joins a set once, never twice
        assert(!self.holds(d));
        return .{ .mask = self.mask | (@as(u32, 1) << @intCast(d)), .count = self.count + 1 };
    }
};

/// Builds the set a subset number names, over a roster of `domain_count`.
pub fn cohort_of(mask: u32, domain_count: u32) Cohort {
    // invariant: a subset number addresses only the roster declared
    assert(domain_count <= channels.max_domains);
    assert(mask < (@as(u32, 1) << @intCast(domain_count)));
    var built: Cohort = .{};
    var d: u32 = 0;
    while (d < domain_count) : (d += 1) {
        if ((mask & (@as(u32, 1) << @intCast(d))) != 0) built = built.with(d);
    }
    // invariant: the whole roster was weighed, none skipped
    assert(d == domain_count);
    // invariant: the built set is exactly the subset it was asked for
    assert(built.mask == mask);
    return built;
}

/// Why a set of domains may not hold the machine at the same moment.
pub const Conflict = struct {
    /// The lower-numbered domain of the offending pair.
    a: u32,
    /// The higher-numbered domain of the offending pair.
    b: u32,
    /// Which of the two hazards refused them, in `concurrent.rye`'s words.
    verdict: concurrent.PairVerdict,
};

/// Reads a set and answers the first pair in it that may not run together.
///
/// A set carries no hazard its pairs do not already carry, since both
/// hazards are relations between exactly two domains. So this walks pairs
/// and reuses the predicate `concurrent.rye` proved rather than growing a
/// second reading of the same declaration.
pub fn conflict_in(sys: *const system.System, set: Cohort) ?Conflict {
    // invariant: a judged set addresses only the roster declared
    assert(sys.graph.domain_count <= channels.max_domains);
    var a: u32 = 0;
    while (a < sys.graph.domain_count) : (a += 1) {
        if (!set.holds(a)) continue;
        var b: u32 = a + 1;
        while (b < sys.graph.domain_count) : (b += 1) {
            if (!set.holds(b)) continue;
            const verdict = concurrent.judge_pair(sys, a, b);
            if (verdict != .may_run_together) return .{ .a = a, .b = b, .verdict = verdict };
        }
    }
    // invariant: the whole roster was walked, none skipped
    assert(a == sys.graph.domain_count);
    return null;
}

/// Answers whether every pair of a set may run together.
pub fn cohort_is_clear(sys: *const system.System, set: Cohort) bool {
    return conflict_in(sys, set) == null;
}

/// Derives the widest set of this declaration's domains that may run at once.
///
/// Exhaustive on purpose. Subsets are weighed in ascending order and a tie
/// leaves the standing answer alone, so the result is a pure function of
/// the bytes -- two supervisors reading one document derive one cohort
/// without speaking. The cost is `2^n` passes, bounded above by
/// `max_subsets`, and `weighed_out` carries the true number so a caller can
/// print what the search actually spent rather than what it might have.
pub fn widest_cohort(sys: *const system.System, weighed_out: *u32) Cohort {
    // invariant: a derivation addresses only the roster declared
    assert(sys.graph.domain_count <= channels.max_domains);
    const subsets = @as(u32, 1) << @intCast(sys.graph.domain_count);
    // invariant: the search stays inside the ceiling the roster bound sets
    assert(subsets <= max_subsets);
    var widest: Cohort = .{};
    var mask: u32 = 0;
    while (mask < subsets) : (mask += 1) {
        const candidate = cohort_of(mask, sys.graph.domain_count);
        if (candidate.count <= widest.count) continue;
        if (cohort_is_clear(sys, candidate)) widest = candidate;
    }
    // invariant: every subset of the roster was weighed
    assert(mask == subsets);
    weighed_out.* = subsets;
    // invariant: the answer is itself a set that may run together
    assert(cohort_is_clear(sys, widest));
    // invariant: a roster with any domain in it runs at least one at a time
    assert(widest.count >= 1 or sys.graph.domain_count == 0);
    return widest;
}

/// Derives a set by taking each domain in declaration order that still fits.
///
/// This is the reading a supervisor reaches for first, and it stands in the
/// module to be proven narrower. It answers a set that may genuinely run
/// together -- it is never unsafe -- and on the plainest shape in the tree
/// it answers one where the widest answers three.
pub fn first_fit_cohort(sys: *const system.System) Cohort {
    // invariant: a first fit addresses only the roster declared
    assert(sys.graph.domain_count <= channels.max_domains);
    var taken: Cohort = .{};
    var d: u32 = 0;
    while (d < sys.graph.domain_count) : (d += 1) {
        const grown = taken.with(d);
        if (cohort_is_clear(sys, grown)) taken = grown;
    }
    // invariant: the whole roster was offered, none skipped
    assert(d == sys.graph.domain_count);
    // invariant: a first fit is safe even where it is narrow
    assert(cohort_is_clear(sys, taken));
    return taken;
}

/// The widest set a ring of `n` domains permits, by the ring's own shape.
///
/// Every domain in a ring is adjacent to two others, so a set may hold no
/// two neighbors and the most it can hold is every other domain around the
/// circuit -- `floor(n / 2)`. Stated here as a claim the derivation above
/// is free to disagree with.
pub fn ring_widest(n: u32) u32 {
    // invariant: a ring needs at least three domains to close
    assert(n >= 3);
    return n / 2;
}

// =========================================================================
// The dependent -- one process, one arc, and the words it was handed at spawn
// =========================================================================

/// Reads the capability words a dependent was handed into its own slot.
fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    // invariant: a dependent always knows which domain it is
    assert(domain.len >= 1);
    // invariant: the count stays within what one dependent may hold
    assert(cap_count <= capabilities.max_caps_per_dependent);
    var slot = capabilities.DependentSlot.init(domain);
    var i: u32 = 0;
    while (i < cap_count) : (i += 1) {
        const cap = boot.read_cap_word(args[fixed_argv_words + i]) orelse return null;
        slot.grant(cap) catch return null;
    }
    // invariant: the dependent holds exactly the capability words it was handed
    assert(slot.cap_count == cap_count);
    return slot;
}

/// Runs as one supervised dependent, holding exactly the capabilities and
/// neighbors it was handed at spawn.
///
/// Nothing here knows two siblings are running. Isolation is proven on the
/// declaration before any spawn, so a dependent of a cohort needs no lock, no
/// wait, and no notion that it is one of three.
fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    // invariant: a dependent always receives its marker, domain, plan, fall, wake, and count
    assert(args.len >= fixed_argv_words);
    const domain = args[2];
    const plan = args[3];
    // invariant: a dependent always knows which domain it is
    assert(domain.len >= 1);

    const fall = gap.read_fall(args[4]) orelse {
        print("    {s}: refused a fall word it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };
    const wake = gap.read_wake(args[5]) orelse {
        print("    {s}: refused a wake word it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };

    const cap_count = tally_parse_int.parse_int(u32, args[6], .{}) catch {
        print("    {s}: refused an unreadable capability count\n", .{domain});
        return carry.Outcome.malformed;
    };
    if (cap_count > capabilities.max_caps_per_dependent) {
        print("    {s}: more capabilities than one dependent holds\n", .{domain});
        return carry.Outcome.malformed;
    }
    if (fixed_argv_words + cap_count > args.len) {
        print("    {s}: a capability count past the words it was handed\n", .{domain});
        return carry.Outcome.malformed;
    }

    var slot = slot_from_argv(args, domain, cap_count) orelse {
        print("    {s}: refused a malformed capability word\n", .{domain});
        return carry.Outcome.malformed;
    };

    var peers: notify.PeerList = .{};
    var p: usize = fixed_argv_words + cap_count;
    while (p < args.len) : (p += 1) {
        peers.add(args[p]) catch {
            print("    {s}: more peers than one dependent holds\n", .{domain});
            return carry.Outcome.malformed;
        };
    }
    // invariant: the dependent holds exactly the peer words it was handed
    assert(peers.count == args.len - fixed_argv_words - cap_count);

    const task = cycle.read_plan(plan) orelse {
        print("    {s}: refused a plan it could not read\n", .{domain});
        return carry.Outcome.malformed;
    };
    const code = gap.attempt(io, &slot, &peers, domain, task, fall, wake);
    print("    {s}: {s}\n", .{ domain, outcome_name(code) });
    return code;
}

// =========================================================================
// The supervisor -- a stage of one dependent, or a stage of a whole cohort
// =========================================================================

/// One declared step: a domain, the arc it works, and what it should answer.
pub const Assignment = concurrent.Assignment;

/// One stage of a lap: every step in it runs at the same moment.
pub const Stage = struct {
    steps: []const Assignment,
};

/// When a supervisor reaps the dependents of a stage.
///
/// `whole` is the module's own reading and the only safe one. `first_only`
/// exists to be proven wrong: with three in flight it reports the first
/// outcome the instant it arrives, leaving two siblings running behind the
/// report rather than one.
pub const Reaping = enum { whole, first_only };

/// What one run did, reported whole.
pub const Report = struct {
    stages: u32 = 0,
    /// Stages that held more than one dependent at the same moment.
    cohort_stages: u32 = 0,
    spawned: u32 = 0,
    reaped: u32 = 0,
    succeeded: u32 = 0,
    homed: u32 = 0,
    bells: u32 = 0,
    /// The most dependents this run held unreaped at one instant -- the whole
    /// claim of the module, counted rather than asserted.
    peak_in_flight: u32 = 0,
    /// How many dependents were still running when a verdict was reported.
    /// The safe reading holds this at zero for every stage.
    unreaped_at_report: u32 = 0,
    /// Dependents reaped after a report had already gone out -- hygiene the
    /// unsafe reading needs and the safe one never does.
    reaped_late: u32 = 0,
};

/// Named ways a run declines rather than reporting a hollow success.
pub const RunError = error{
    SpawnFailed,
    UnknownDomain,
    PlanTooLong,
    DeclarationUnreadable,
    OutcomeMismatch,
    SharedRegion,
    SharedChannel,
    CohortTooWide,
    EmptyStage,
};

/// One dependent of a stage, held from its spawn to its reaping.
const Running = struct {
    proc: std.process.Child,
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
};

/// Spawns one dependent against the document standing now, and returns without
/// waiting on it.
fn spawn_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    table: *const capabilities.CapabilityTable,
    step: Assignment,
    wake: gap.Wake,
) (RunError || boot.BootError)!Running {
    // invariant: a step always names a domain, its arcs, and its peers
    assert(step.domain.len >= 1);
    assert(step.hops.len >= 1);
    assert(step.peers.len >= 1);

    const slot = table.find_dependent(step.domain) orelse return error.UnknownDomain;
    // invariant: the line handed out agrees with the declaration it came from
    assert(boot.line_agrees(sys, slot));

    var peers: notify.PeerList = .{};
    notify.peers_of(sys, step.domain, &peers);

    const plan = std.fmt.allocPrint(allocator, "{s}:{s}:{s}:{d}", .{
        cycle.verb_word(step.verb), step.hops, step.peers, step.count,
    }) catch return error.PlanTooLong;
    if (plan.len > cycle.max_plan_len) return error.PlanTooLong;

    const count_word = std.fmt.allocPrint(allocator, "{d}", .{slot.cap_count}) catch
        return error.PlanTooLong;

    // A stage holds a whole cohort at once, so every word each dependent was
    // handed must outlive the spawn of the ones after it. The arena carries
    // them all rather than a stack buffer the next spawn would reuse.
    const argv = allocator.alloc(
        []const u8,
        fixed_argv_words + slot.cap_count + peers.count,
    ) catch return error.SpawnFailed;
    argv[0] = self_path;
    argv[1] = "dependent";
    argv[2] = slot.label_slice();
    argv[3] = plan;
    argv[4] = gap.fall_word(.none);
    argv[5] = gap.wake_word(wake);
    argv[6] = count_word;
    var c: u32 = 0;
    while (c < slot.cap_count) : (c += 1) {
        assert(c < capabilities.max_caps_per_dependent); // invariant: the walk stays in the array
        const word = allocator.alloc(u8, boot.max_cap_word_len) catch return error.SpawnFailed;
        argv[fixed_argv_words + c] = try boot.write_cap_word(word, &slot.caps[c]);
    }
    var q: u32 = 0;
    while (q < peers.count) : (q += 1) {
        argv[fixed_argv_words + slot.cap_count + q] = peers.name_at(q);
    }
    // invariant: every capability and every peer became one handed word
    assert(c == slot.cap_count);
    assert(q == peers.count);

    const proc = std.process.spawn(io, .{ .argv = argv }) catch return error.SpawnFailed;
    return .{
        .proc = proc,
        .domain = step.domain,
        .verb = step.verb,
        .count = step.count,
        .expect = step.expect,
    };
}

/// Waits on one running dependent and answers the code it exited with.
fn reap_one(io: std.Io, dependent: *Running) RunError!u8 {
    // invariant: a reaping always names the domain it is waiting on
    assert(dependent.domain.len >= 1);
    // invariant: a reaping always knows what it expected to hear
    assert(dependent.expect <= 255);
    const term = dependent.proc.wait(io) catch return error.SpawnFailed;
    return switch (term) {
        .exited => |code| code,
        else => restart.fell,
    };
}

/// Folds one reaped outcome into the report, or names the mismatch.
fn judge_outcome(dependent: *const Running, code: u8, report_out: *Report) RunError!void {
    // invariant: a judged dependent always names its domain
    assert(dependent.domain.len >= 1);
    // invariant: the report never counts more successes than dependents reaped
    assert(report_out.succeeded <= report_out.reaped);
    if (code != dependent.expect) {
        print("    {s}: expected {s}, heard {s}\n", .{
            dependent.domain, outcome_name(dependent.expect), outcome_name(code),
        });
        return error.OutcomeMismatch;
    }
    if (code == carry.Outcome.carried_ok) {
        report_out.succeeded += 1;
        if (dependent.verb == .home) report_out.homed += dependent.count;
    }
}

/// Clears a whole stage to run at once, or names the pair that forbids it.
///
/// This stands before any spawn on purpose. A document that gives two of
/// these domains a region or a bell in common never reaches the point where
/// their processes are running together, so the isolation is a property
/// proven on the declaration rather than a race the supervisor survives.
fn clear_cohort(sys: *const system.System, steps: []const Assignment) RunError!Cohort {
    if (steps.len == 0) return error.EmptyStage;
    if (steps.len > max_in_flight) return error.CohortTooWide;
    var set: Cohort = .{};
    var i: u32 = 0;
    while (i < steps.len) : (i += 1) {
        // invariant: a step of a stage always names its domain
        assert(steps[i].domain.len >= 1);
        const d = sys.graph.find_domain(steps[i].domain) orelse return error.UnknownDomain;
        if (set.holds(d)) return error.SharedRegion;
        set = set.with(d);
    }
    // invariant: every step of the stage joined the set exactly once
    assert(set.count == steps.len);
    if (set.count == 1) return set;

    if (conflict_in(sys, set)) |clash| {
        print("  {s} beside {s}: {s}\n", .{
            sys.graph.domains[clash.a].name_slice(),
            sys.graph.domains[clash.b].name_slice(),
            concurrent.pair_words(clash.verdict),
        });
        return switch (clash.verdict) {
            .shares_a_region => error.SharedRegion,
            .shares_a_channel => error.SharedChannel,
            .may_run_together => unreachable,
        };
    }
    print("  a cohort of {d} clears: no region and no channel in common\n", .{set.count});
    return set;
}

/// Runs one stage: every dependent spawned before any of them is reaped.
///
/// The cohort is cleared before the first spawn, above. What this adds is
/// the second half of the module's claim: every dependent it starts is waited
/// on before any verdict leaves it, which matters more with three in flight
/// than with two, since one refusal can now strand a pair.
fn run_stage(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    table: *const capabilities.CapabilityTable,
    stage: Stage,
    wake: gap.Wake,
    reaping: Reaping,
    report_out: *Report,
) (RunError || boot.BootError)!void {
    const set = try clear_cohort(sys, stage.steps);
    // invariant: the cleared set names exactly the dependents about to spawn
    assert(set.count == stage.steps.len);

    var live: [max_in_flight]Running = undefined;
    var in_flight: u32 = 0;
    var i: u32 = 0;
    while (i < stage.steps.len) : (i += 1) {
        live[i] = try spawn_one(allocator, io, self_path, sys, table, stage.steps[i], wake);
        report_out.spawned += 1;
        in_flight += 1;
    }
    // invariant: every step of the stage became a running dependent
    assert(in_flight == stage.steps.len);
    if (in_flight > report_out.peak_in_flight) report_out.peak_in_flight = in_flight;
    if (in_flight > 1) report_out.cohort_stages += 1;

    var codes: [max_in_flight]u8 = undefined;
    var first_code: u8 = 0;
    var r: u32 = 0;
    while (r < stage.steps.len) : (r += 1) {
        codes[r] = try reap_one(io, &live[r]);
        report_out.reaped += 1;
        in_flight -= 1;
        if (r == 0) first_code = codes[0];

        // The unsafe reading reports here, with the rest of the cohort still
        // running behind the verdict. It stands in the module only so the
        // safe reading below has something to be proven against.
        if (r == 0 and reaping == .first_only) {
            judge_outcome(&live[0], first_code, report_out) catch |err| {
                report_out.unreaped_at_report += in_flight;
                var late: u32 = 1;
                while (late < stage.steps.len) : (late += 1) {
                    _ = reap_one(io, &live[late]) catch {};
                    report_out.reaped_late += 1;
                }
                return err;
            };
        }
    }
    // invariant: every dependent this stage started was waited on before any verdict
    assert(in_flight == 0);
    assert(r == stage.steps.len);

    var j: u32 = 0;
    while (j < stage.steps.len) : (j += 1) {
        if (j == 0 and reaping == .first_only) continue;
        try judge_outcome(&live[j], codes[j], report_out);
    }
    // invariant: the whole stage was judged, none skipped
    assert(j == stage.steps.len);
    report_out.stages += 1;
}

/// Runs a whole ordered lap, deriving the document once and spending every
/// cohort the shape has room for.
pub fn run_lap(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Stage,
    wake: gap.Wake,
    reaping: Reaping,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always carries at least one stage
    assert(plan.len >= 1);

    const provisioned = try exercise.provision(io, sys);
    // invariant: every declared region has a backing store before any dependent runs
    assert(provisioned == sys.map.region_count);
    report_out.bells = try roundtrip.provision_directed(io, sys);

    const table = try roster.from_system(sys);
    // invariant: the derived table enforces exactly what the document permits
    assert(roster.agrees(sys, &table));

    var i: u32 = 0;
    while (i < plan.len) : (i += 1) {
        try run_stage(allocator, io, self_path, sys, &table, plan[i], wake, reaping, report_out);
    }
    // invariant: every stage of the plan ran, none half-counted
    assert(report_out.stages == plan.len);
    // invariant: a safe lap reaped every dependent it started
    assert(report_out.reaped == report_out.spawned);
}

// =========================================================================
// Self-test -- a server and three clients, spending the whole cohort twice
// =========================================================================

/// The lap that carries. All three clients place their asks at the same
/// moment, since no region and no bell joins any of them. The virtualiser
/// then answers each in turn, which is serial because it touches every one
/// of them. Then the whole cohort runs again to take the answers home.
const cohort_plan = [_]Stage{
    .{ .steps = &.{
        .{ .domain = "client_a", .verb = .place, .hops = "ask_a", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
        .{ .domain = "client_b", .verb = .place, .hops = "ask_b", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
        .{ .domain = "client_c", .verb = .place, .hops = "ask_c", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
    } },
    .{ .steps = &.{
        .{ .domain = "serial_virt", .verb = .pass, .hops = "ask_a,back_a", .peers = "client_a,client_a", .count = 2, .expect = carry.Outcome.carried_ok },
    } },
    .{ .steps = &.{
        .{ .domain = "serial_virt", .verb = .pass, .hops = "ask_b,back_b", .peers = "client_b,client_b", .count = 2, .expect = carry.Outcome.carried_ok },
    } },
    .{ .steps = &.{
        .{ .domain = "serial_virt", .verb = .pass, .hops = "ask_c,back_c", .peers = "client_c,client_c", .count = 2, .expect = carry.Outcome.carried_ok },
    } },
    .{ .steps = &.{
        .{ .domain = "client_a", .verb = .home, .hops = "back_a,taken_a", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
        .{ .domain = "client_b", .verb = .home, .hops = "back_b,taken_b", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
        .{ .domain = "client_c", .verb = .home, .hops = "back_c,taken_c", .peers = "serial_virt", .count = 2, .expect = carry.Outcome.carried_ok },
    } },
};

/// The virtualiser asked to run beside a client it shares a region with --
/// refused before any of the three is spawned.
const touching_probe = [_]Stage{
    .{ .steps = &.{
        .{ .domain = "client_a", .verb = .place, .hops = "ask_a", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.malformed },
        .{ .domain = "client_b", .verb = .place, .hops = "ask_b", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.malformed },
        .{ .domain = "serial_virt", .verb = .stand, .hops = "ask_a", .peers = "client_a", .count = 1, .expect = carry.Outcome.malformed },
    } },
};

/// A stage of three whose first dependent answers other than the plan expected.
///
/// Every dependent carries a plan whose shape its verb does not take, so each is
/// refused at its own door and none touches a region or a bell. The probe
/// measures the reaping alone, and the document's state after it stands
/// exactly where the lap left it.
const reaping_probe = [_]Stage{
    .{ .steps = &.{
        .{ .domain = "client_a", .verb = .stand, .hops = "ask_a", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.carried_ok },
        .{ .domain = "client_b", .verb = .stand, .hops = "ask_b", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.malformed },
        .{ .domain = "client_c", .verb = .stand, .hops = "ask_c", .peers = "serial_virt", .count = 1, .expect = carry.Outcome.malformed },
    } },
};

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    const parsed = read.load(io, path, buf) catch |err| {
        print("  RED: {s} refused: {s}\n", .{ path, @errorName(err) });
        return null;
    };
    if (parsed.verify() != .whole) {
        print("  RED: {s} did not read whole\n", .{path});
        return null;
    }
    return parsed;
}

/// Proves a set is judged by its pairs, and that one bad pair refuses it.
fn check_wire(io: std.Io) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const virt = sys.graph.find_domain("serial_virt") orelse return 1;
    const a = sys.graph.find_domain("client_a") orelse return 1;
    const b = sys.graph.find_domain("client_b") orelse return 1;
    const c = sys.graph.find_domain("client_c") orelse return 1;

    const clients = (Cohort{}).with(a).with(b).with(c);
    if (!cohort_is_clear(&sys, clients)) {
        print("  RED: three domains sharing nothing were refused as a set\n", .{});
        return 1;
    }
    const with_virt = clients.with(virt);
    const clash = conflict_in(&sys, with_virt) orelse {
        print("  RED: a set holding the virtualiser and its clients was waved through\n", .{});
        return 1;
    };
    if (clash.verdict != .shares_a_region) {
        print("  RED: the virtualiser was refused as {s}\n", .{concurrent.pair_words(clash.verdict)});
        return 1;
    }
    // invariant: a set is clear only when every pair in it is
    assert(clients.count == 3);
    assert(with_virt.count == 4);
    print("  a set of {d} clears and the same set plus the virtualiser refuses on a pair\n", .{
        clients.count,
    });
    return 0;
}

/// Measures the widest set each shape has room for, ring first.
fn check_room(io: std.Io) u8 {
    var serial_buf: [read.read_buffer_bytes]u8 = undefined;
    const serial = load_one(io, serial_path, &serial_buf) orelse return 1;
    var ring_buf: [read.read_buffer_bytes]u8 = undefined;
    const ring = load_one(io, ring_path, &ring_buf) orelse return 1;

    if (standby.shape_of(&serial) != .ring or standby.shape_of(&ring) != .ring) {
        print("  RED: a document measured for room did not read as a ring\n", .{});
        return 1;
    }

    var narrow_weighed: u32 = 0;
    const narrow = widest_cohort(&serial, &narrow_weighed);
    var wide_weighed: u32 = 0;
    const wide = widest_cohort(&ring, &wide_weighed);

    if (narrow.count != ring_widest(serial.graph.domain_count)) {
        print("  RED: a ring of {d} derived a widest set of {d}, not {d}\n", .{
            serial.graph.domain_count, narrow.count, ring_widest(serial.graph.domain_count),
        });
        return 1;
    }
    if (wide.count != ring_widest(ring.graph.domain_count)) {
        print("  RED: a ring of {d} derived a widest set of {d}, not {d}\n", .{
            ring.graph.domain_count, wide.count, ring_widest(ring.graph.domain_count),
        });
        return 1;
    }
    // invariant: a ring of three runs one domain at a time, by its own grants
    assert(narrow.count == 1);
    // invariant: a ring of four has room for a pair and never a triple
    assert(wide.count == 2);
    print("  a ring of {d} runs {d} at once; a ring of {d} runs {d}, never three\n", .{
        serial.graph.domain_count, narrow.count, ring.graph.domain_count, wide.count,
    });
    return 0;
}

/// The shape with room for three, and the first fit that finds only one.
fn check_widest(io: std.Io) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    if (standby.shape_of(&sys) == .ring) {
        print("  RED: the shape with room for three read back as a ring\n", .{});
        return 1;
    }

    var weighed: u32 = 0;
    const widest = widest_cohort(&sys, &weighed);
    const first = first_fit_cohort(&sys);

    if (widest.count != max_in_flight) {
        print("  RED: the widest set derived {d}, not {d}\n", .{ widest.count, max_in_flight });
        return 1;
    }
    if (first.count >= widest.count) {
        print("  RED: the first fit found {d}, so the derivation proves nothing\n", .{first.count});
        return 1;
    }
    if (widest.holds(sys.graph.find_domain("serial_virt") orelse return 1)) {
        print("  RED: the widest set held the domain that touches every other\n", .{});
        return 1;
    }
    // invariant: a first fit is safe wherever it is narrow
    assert(cohort_is_clear(&sys, first));
    // invariant: the whole roster's subsets were weighed, and no more
    assert(weighed == 16);
    assert(weighed <= max_subsets);

    var again: u32 = 0;
    const twice = widest_cohort(&sys, &again);
    if (twice.mask != widest.mask) {
        print("  RED: one document derived two different widest sets\n", .{});
        return 1;
    }
    print("  weighing {d} subsets derives a widest set of {d} where the first fit takes {d}\n", .{
        weighed, widest.count, first.count,
    });
    print("  the shape with room for three reads back as {s}, never a ring\n", .{
        standby.verdict_words(standby.shape_of(&sys)),
    });
    return 0;
}

/// The lap that carries, spending the whole cohort twice.
fn check_lap(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    var done: Report = .{};
    run_lap(allocator, io, self_path, &sys, &cohort_plan, .when_moved, .whole, &done) catch |err| {
        print("  RED: the lap did not survive three dependents at once: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: the whole cohort was spent twice
    assert(done.cohort_stages == 2);
    // invariant: three dependents stood unreaped at once, and never four
    assert(done.peak_in_flight == max_in_flight);
    // invariant: every dependent started was reaped, and none behind a report
    assert(done.reaped == done.spawned);
    assert(done.unreaped_at_report == 0);
    // invariant: every step of the lap carried
    assert(done.succeeded == done.spawned);
    // invariant: every ask each client placed came home to the client that wrote it
    assert(done.homed == 6);
    print("  {d} dependents ran across {d} stages, {d} of them holding three at once\n", .{
        done.spawned, done.stages, done.cohort_stages,
    });
    print("  {d} dependents stood unreaped at the peak, {d} reaped, {d} reported behind\n", .{
        done.peak_in_flight, done.reaped, done.unreaped_at_report,
    });
    print("  {d} asks come home over a shape that spent its whole cohort twice\n", .{done.homed});
    return 0;
}

/// A cohort holding the one domain that touches every other -- refused
/// before any of the three is spawned.
fn check_touching(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    var done: Report = .{};
    run_lap(allocator, io, self_path, &sys, &touching_probe, .every_pass, .whole, &done) catch |err| {
        if (err != error.SharedRegion) {
            print("  RED: the virtualiser was refused as {s} rather than SharedRegion\n", .{
                @errorName(err),
            });
            return 1;
        }
        if (done.spawned != 0) {
            print("  RED: {d} dependents were spawned before the cohort was judged\n", .{done.spawned});
            return 1;
        }
        print("  a cohort holding the virtualiser is refused SharedRegion with 0 dependents spawned\n", .{});
        return 0;
    };
    print("  RED: a domain sharing a region with the cohort ran beside it\n", .{});
    return 1;
}

/// A refusal that arrives while two siblings are still running, and the
/// reading that never lets it.
fn check_reaping(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    var loose: Report = .{};
    run_lap(allocator, io, self_path, &sys, &reaping_probe, .every_pass, .first_only, &loose) catch |err| {
        if (err != error.OutcomeMismatch) {
            print("  RED: the loose reading refused as {s} rather than OutcomeMismatch\n", .{
                @errorName(err),
            });
            return 1;
        }
    };
    if (loose.unreaped_at_report != 2) {
        print("  RED: the loose reading reported with {d} dependents running, not 2\n", .{
            loose.unreaped_at_report,
        });
        return 1;
    }
    // invariant: the loose reading needed the late reapings the safe one never does
    assert(loose.reaped_late == 2);
    print("  reporting on the first outcome leaves {d} dependents running behind the verdict\n", .{
        loose.unreaped_at_report,
    });

    var safe: Report = .{};
    run_lap(allocator, io, self_path, &sys, &reaping_probe, .every_pass, .whole, &safe) catch |err| {
        if (err != error.OutcomeMismatch) {
            print("  RED: the safe reading refused as {s} rather than OutcomeMismatch\n", .{
                @errorName(err),
            });
            return 1;
        }
    };
    if (safe.unreaped_at_report != 0 or safe.reaped != safe.spawned) {
        print("  RED: the safe reading left {d} dependents running behind its verdict\n", .{
            safe.unreaped_at_report,
        });
        return 1;
    }
    // invariant: the safe reading never needs a late reaping
    assert(safe.reaped_late == 0);
    print("  reaping the whole cohort first reports the same refusal with {d} running\n", .{
        safe.unreaped_at_report,
    });
    return 0;
}

fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan cohort {s} -- self-test\n", .{caravan_cohort_version});
    const wire = check_wire(io);
    if (wire != 0) return wire;
    const room = check_room(io);
    if (room != 0) return room;
    const widest = check_widest(io);
    if (widest != 0) return widest;
    const lap = check_lap(allocator, io, self_path);
    if (lap != 0) return lap;
    const touching = check_touching(allocator, io, self_path);
    if (touching != 0) return touching;
    const reaping = check_reaping(allocator, io, self_path);
    if (reaping != 0) return reaping;
    print("  GREEN: the widest set a document may run is derived, never chosen\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return run_self_test(allocator, io, self_path);
}
