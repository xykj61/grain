//! Caravan reckon -- a plan that lost an arc is reported short, rather than
//! carried out, and the verdict stands on the wire where an operator reads it.
//!
//! `confer.rye` closed the gap at the front of a dependent's life, `revoke.rye`
//! the gap at the back of a standing one, `reclaim.rye` the gap after its
//! holder is gone, and `abandon.rye` counted what a fallen holder's conferral
//! never bought. Four rungs about one dependent at a time. **None of them asks
//! what the plan itself amounts to.**
//!
//! **A run counts the loss and reports success anyway, and that is the hole
//! this rung closes.** `abandon.rye` writes the abandoned reach into the
//! departed domain's own notes and reads it back, so the number is a fact. Yet
//! the run that wrote it still returns cleanly: the record drained, every
//! outcome matched the word its author declared, and the report reads four
//! phases queued, three dependents reaped, one absorbed. An operator reads
//! that as a plan carried out, with the abandoned count sitting quietly beside
//! it as one more number among a dozen that nobody has to look at.
//!
//! **The measurement is overclaimed completion** -- a plan reported carried
//! out while an arc it absorbed bought nothing. The four counts before it
//! measure reach a dependent held; this one measures a **claim the supervisor
//! made**, and it is the first number in this arc that weighs the report
//! rather than the run. Assuming completion holds it at one; reckoning it
//! drives it to zero, with the same work carried by the same dependents.
//!
//! **Completion becomes a verdict the run earns.** A plan is `carried` when
//! every phase it absorbed into a standing dependent was actually served, and
//! `short` when any of them was not. The verdict is derived from the work
//! rather than from the shape of the record, so a drained queue is evidence of
//! nothing on its own.
//!
//! **The verdict stands on the wire, and the run reads it back before it
//! believes itself.** A plan-level note carries the word after the last
//! dependent is reaped, so an operator can read the plan's own verdict when
//! the supervisor that formed it has exited. A judgment held only in a process
//! that is gone is a claim; a judgment on disk is a fact.
//!
//! **The rung earns four refusals, and each is about the plan rather than one
//! dependent.** `ReckonEarly` is the moment: a plan with a dependent still in
//! flight has not finished, and a verdict taken there would judge work that
//! may yet be carried. `ReckonUnabsorbed` is the supply: a plan that absorbed
//! no phase into a standing dependent has nothing this rung can weigh.
//! `ReckonMiscounted` is the honesty of the count: a plan cannot lose more
//! arcs than it absorbed, and a measurement that overstates its own loss is as
//! useless as one that hides it. `ReckonOverclaimed` is the answer -- the hard
//! half -- since a run that read back a verdict of *carried* while an arc it
//! absorbed bought nothing would report a plan carried out that nobody carried
//! out.
//!
//! **A plan that lost nothing reads as the rung below.** With every absorbed
//! phase served, the verdict is `carried` under either ledger, each line
//! stands at the width it was handed, and the door answers
//! `unhand.admissible_held` pair for pair -- this arc's standing
//! generalization test, one tier further out.
//!
//! Usage:
//!   reckon            Run the self-test (default)
//!   reckon selftest   Same as default
//!   reckon dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const ladder_checks = @import("ladder_checks.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const tally_parse_int = @import("parse_int.rye");

const Dir = std.Io.Dir;

const caravan_reckon_version = "20260820.022039";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = abandon_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = abandon_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = abandon_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = abandon_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = abandon_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = abandon_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.reckons";

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = abandon_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = abandon_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = abandon_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = abandon_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = abandon_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = abandon_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = abandon_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the abandoning notes
    assert(!std.mem.eql(u8, note_dir, abandon_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return abandon_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, or claim it is done.
///
/// Four names of this rung's own, and each is about the plan rather than one
/// dependent: the moment a verdict is taken, the work it weighs, the honesty
/// of the count it rests on, and the claim it publishes.
pub const RunError = abandon_rung.RunError || error{
    ReckonEarly,
    ReckonUnabsorbed,
    ReckonMiscounted,
    ReckonOverclaimed,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = abandon_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = abandon_rung.Reading;

/// One phase, its turn, its step, its masks, and the reserve it may be
/// entrusted -- exactly the shape the rung below reads.
pub const Phase = abandon_rung.Phase;

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return abandon_rung.plain(phase);
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = abandon_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = abandon_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = abandon_rung.Words;

/// What one run did, reported whole, with the completion it overclaimed added.
pub const Report = struct {
    inner: abandon_rung.Report = .{},
    overclaimed: u32 = 0,
    verdict: Verdict = .carried,
};

/// The abandoning rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
/// The abandoning tally, named the way every rung above this one names it.
///
/// `reckon.rye` stands one rung above `abandon.rye`, so the tier the ladder
/// reaches through a long nesting is simply the neighbor below. Naming it by the
/// shared word costs three lines and folds this rung's start with the rest.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return below_of(report_out);
}

fn below_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return abandon_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return abandon_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return abandon_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return abandon_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return abandon_rung.reserve_depth(reserve);
}

// =========================================================================
// The reclamation -- carried whole from the rung below, since this rung
// always reclaims and asks a different question about the same act
// =========================================================================

/// What becomes of a conferral when its holder is reaped, from the rung below.
pub const Take = abandon_rung.Take;

/// Renders one take as the words an operator reads.
pub fn take_words(t: Take) []const u8 {
    return abandon_rung.take_words(t);
}

/// Answers why one conferral may not be reclaimed, or that it may.
pub fn reclaim_refusal(conferred: u32, in_flight: bool, already: bool) ?RunError {
    return abandon_rung.reclaim_refusal(conferred, in_flight, already);
}

/// Counts the reach a successor finds waiting at its first breath.
pub fn inherited_reach(conferred: u32, take: Take) u32 {
    return abandon_rung.inherited_reach(conferred, take);
}

// =========================================================================
// The abandonment -- carried whole from the rung below, since this rung
// always answers for lost work and asks what the plan is worth afterwards
// =========================================================================

/// Whether a run answers for the work a fallen holder's conferral never
/// served, from the rung below. This rung always answers.
pub const Answer = abandon_rung.Answer;

/// Answers why one abandonment may not be recorded, or that it may.
pub fn abandon_refusal(granted: u32, in_flight: bool, came_home: bool) ?RunError {
    return abandon_rung.abandon_refusal(granted, in_flight, came_home);
}

/// Counts the reach a run conferred that nobody ever served.
pub fn abandoned_reach(granted: u32, came_home: bool, answer: Answer) u32 {
    return abandon_rung.abandoned_reach(granted, came_home, answer);
}

// =========================================================================
// The reckoning -- what a plan amounts to once every dependent is home or gone
// =========================================================================

/// What a run says its plan came to.
///
/// `carried` is a plan whose every absorbed phase was actually served.
/// `short` is a plan that absorbed a phase into a dependent which fell holding
/// the reach that phase called for, so an arc of the plan happened to nobody.
pub const Verdict = enum { carried, short };

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return switch (v) {
        .carried => "carried out whole",
        .short => "short by the work nobody served",
    };
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return switch (v) {
        .carried => 'c',
        .short => 's',
    };
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    if (byte == 'c') return .carried;
    if (byte == 's') return .short;
    return null;
}

/// How a run decides whether its plan was carried out.
///
/// `assumed` is where the rung below left it: the record drained and every
/// outcome matched the word its author declared, so the plan is complete by
/// the shape of the run. `reckoned` is this rung: completion is derived from
/// the work actually served, so a plan that absorbed a phase nobody served is
/// reported short however tidily its queue emptied.
pub const Ledger = enum { assumed, reckoned };

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return switch (l) {
        .assumed => "a record that drained is a plan carried out",
        .reckoned => "a plan that lost an arc is reported short, and the run says so",
    };
}

/// Answers why one reckoning may not be taken, or that it may.
///
/// The whole fold of this rung, and every refusal it earns before a verdict is
/// ever written. `absorbed` is how many phases this run handed to a dependent
/// already standing, `in_flight` is how many dependents are still out, and
/// `lost` is the reach those absorbed phases called for that nobody served.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    // invariant: a reckoning never weighs more phases than one record may hold
    assert(absorbed <= max_queue_len);
    // invariant: a reckoning never counts more dependents than a run may hold
    assert(in_flight <= max_in_flight);
    if (in_flight != 0) return error.ReckonEarly;
    if (absorbed == 0) return error.ReckonUnabsorbed;
    if (lost > absorbed) return error.ReckonMiscounted;
    return null;
}

/// Answers what a plan came to, under one ledger.
///
/// The `assumed` reading never looks at the loss at all, which is precisely
/// the reading this rung exists to replace: a drained record is evidence that
/// every phase was taken up, and taking a phase up is a different act from
/// serving it.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    // invariant: a verdict never weighs more loss than one record may hold
    assert(lost <= max_queue_len);
    if (ledger == .assumed) return .carried;
    if (lost == 0) return .carried;
    return .short;
}

/// Counts the completion a run claimed that its own work does not support.
///
/// The fifth of the family and the first that weighs the *report* rather than
/// the run: dark reach, stale reach, inherited reach, and abandoned reach each
/// count arcs a dependent held, while this counts a claim a supervisor made.
/// A plan that lost nothing overclaims nothing under either ledger, which is
/// what keeps the number a finding rather than a difference of habit.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    // invariant: an overclaim never weighs more loss than one record may hold
    assert(lost <= max_queue_len);
    if (lost == 0) return 0;
    if (verdict == .carried) return 1;
    return 0;
}

// =========================================================================
// The door -- unchanged, since this rung moves a conferral rather than a line
// =========================================================================

/// Answers whether the head may enter, over the lines the run remembers.
///
/// The door is `revoke.admissible_in` exactly: a widened line is weighed the
/// same way whether a departed dependent's conferral stands or leaves with it.
/// What this rung changes stands entirely on the wire between the two.
pub fn admissible_in(
    sys: *const system.System,
    live: []const cohort.Running,
    handed: []const Task,
    reserves: []const ?Task,
    taken: []const u32,
    head: Task,
) RunError!bool {
    return abandon_rung.admissible_in(sys, live, handed, reserves, taken, head);
}

// =========================================================================
// The notes -- what a run publishes, and the answers it reads back
// =========================================================================

/// Why a conferral could not be published, read, confirmed, or reclaimed.
pub const NoteError = abandon_rung.NoteError;

/// Writes the path of one dependent's note.
pub fn note_path(buf: *[max_note_path_len]u8, domain: []const u8, suffix: []const u8) NoteError![]const u8 {
    return ladder_checks.note_path(@This(), buf, domain, suffix);
}

/// Writes bytes into a note, creating it fresh.
pub fn seat_note(io: std.Io, domain: []const u8, suffix: []const u8, bytes: []const u8) NoteError!void {
    return ladder_checks.seat_note(@This(), io, domain, suffix, bytes);
}

/// Reads the one byte a counting note carries.
pub fn read_count(io: std.Io, domain: []const u8, suffix: []const u8) NoteError!u8 {
    return ladder_checks.read_count(@This(), io, domain, suffix);
}

/// Reads the word list a dependent's domain has been handed so far.
pub fn read_words(io: std.Io, domain: []const u8, out: *Words) NoteError!void {
    return ladder_checks.read_words(@This(), io, domain, out);
}

/// Provisions one set of notes per declared domain, all standing at nothing.
///
/// Every run starts with no reach conferred, none revoked, and no conferral
/// standing anywhere, so a word a dependent finds at its first breath was left
/// by this run's own supervisor rather than by the last.
pub fn provision_notes(io: std.Io, sys: *const system.System) NoteError!u32 {
    // invariant: the domain roster stays within its bound
    assert(sys.graph.domain_count >= 1);
    // invariant: a run always provisions into a declaration that read whole
    assert(sys.map.region_count >= 1);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    var i: u32 = 0;
    while (i < sys.graph.domain_count) : (i += 1) {
        const name = sys.graph.domains[i].name_slice();
        try seat_note(io, name, ".given", &[_]u8{0});
        try seat_note(io, name, ".held", &[_]u8{0});
        try seat_note(io, name, ".offered", &[_]u8{0});
        try seat_note(io, name, ".words", "");
        try seat_note(io, name, ".pruning", &[_]u8{0});
        try seat_note(io, name, ".kept", &[_]u8{0});
        try seat_note(io, name, ".pruned", &[_]u8{0});
        try seat_note(io, name, ".inherited", &[_]u8{0});
        try seat_note(io, name, ".epoch", &[_]u8{0});
        try seat_note(io, name, ".for", &[_]u8{0});
        try seat_note(io, name, ".falls", &[_]u8{0});
        try seat_note(io, name, ".abandoned", &[_]u8{0});
    }
    // The plan's own verdict is cleared with them, so no run ever reads the
    // last run's judgment of a plan this one has not finished.
    try seat_note(io, plan_name, ".verdict", &[_]u8{0});
    // invariant: a fresh provisioning leaves no verdict standing to be read
    assert(verdict_published(io) == null);
    // invariant: every declared domain got its notes, none invented
    assert(i == sys.graph.domain_count);
    return i;
}

/// Tells one dependent how much reach may yet arrive for it.
pub fn offer(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    return ladder_checks.offer(@This(), io, domain, depth);
}

/// Reads how much reach this dependent was told may yet arrive.
pub fn offered(io: std.Io, domain: []const u8) NoteError!u32 {
    // invariant: an offer is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = try read_count(io, domain, ".offered");
    // invariant: an offer stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Tells one dependent whether a pruning will come for it at all.
pub fn promise_pruning(io: std.Io, domain: []const u8, keep: Keep) NoteError!void {
    return ladder_checks.promise_pruning(@This(), io, domain, keep);
}

/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(io: std.Io, domain: []const u8) bool {
    return ladder_checks.pruning_promised(@This(), io, domain);
}

/// Tells this dependent how its author declared it would end.
///
/// A plan already names the outcome it expects of every phase, and until now
/// only the supervisor read that word. The dependent needs it too, since the
/// window this rung studies opens inside the dependent's own life -- after it
/// grafts a conferral and before it carries the work. So the declaration rides
/// the same wire as the pruning promise, written before the spawn.
pub fn promise_falling(io: std.Io, domain: []const u8, falling: bool) NoteError!void {
    return ladder_checks.promise_falling(@This(), io, domain, falling);
}

/// Answers whether this dependent's author declared that it falls.
pub fn falling_promised(io: std.Io, domain: []const u8) bool {
    // invariant: a declaration is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".falls") catch return false;
    return seen != 0;
}

/// Publishes one conferral: the generation it is meant for, the words
/// themselves, then the count that makes them live.
///
/// The generation is what lets a dependent tell a word meant for it from a
/// word left standing by the dependent before it. It is a **measurement**
/// rather than a guard: a careless successor may graft a foreign word all the
/// same, which is exactly why the conferral is reclaimed rather than merely
/// labelled.
pub fn confer_words(io: std.Io, domain: []const u8, words: *const Words, depth: u32) NoteError!void {
    // invariant: a conferral always names the dependent it is handed to
    assert(domain.len >= 1);
    // invariant: a conferral never hands more than one line may name
    assert(depth <= cycle.max_hops);
    const generation = read_count(io, domain, ".epoch") catch 0;
    try seat_note(io, domain, ".for", &[_]u8{generation});
    try seat_note(io, domain, ".words", words.slice());
    try seat_note(io, domain, ".given", &[_]u8{@intCast(depth)});
}

/// Opens one generation of a domain, and answers which it is.
///
/// A domain outlives every dependent that stands in it, so each start counts
/// one further. The number is seated before the spawn, so a dependent always
/// finds its own generation waiting for it.
pub fn open_generation(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.open_generation(@This(), io, domain);
}

/// Tells the run this dependent has grafted the reach it was conferred.
pub fn holds(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never grafts more than one line may name
    assert(depth <= cycle.max_hops);
    try seat_note(io, domain, ".held", &[_]u8{@intCast(depth)});
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(io: std.Io, domain: []const u8, depth: u32) bool {
    return ladder_checks.confirm(@This(), io, domain, depth);
}

/// Publishes one revocation: how many conferred words remain live.
pub fn revoke(io: std.Io, domain: []const u8, keep: u32) NoteError!void {
    // invariant: a revocation always names the dependent it is asked of
    assert(domain.len >= 1);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    try seat_note(io, domain, ".kept", &[_]u8{@intCast(keep)});
}

/// Reads how many conferred words this dependent may still hold.
pub fn kept(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.kept(@This(), io, domain);
}

/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    return ladder_checks.pruned(@This(), io, domain, count);
}

/// Waits, bounded, until this revocation has been pruned.
pub fn confirm_pruned(io: std.Io, domain: []const u8, count: u32) bool {
    return ladder_checks.confirm_pruned(@This(), io, domain, count);
}

/// Tells the run how much reach this dependent found standing at its first breath.
pub fn inherited(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never inherits more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".inherited", &[_]u8{@intCast(count)});
}

/// Reads how much reach this dependent found standing at its first breath.
pub fn inherited_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an answer is always read about the dependent that gave it
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".inherited") catch return 0;
    // invariant: an inheritance stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Takes one conferral back whole, so nothing of it stands for a successor.
///
/// The words, the count that makes them live, and every answer given about
/// them return together. A count left standing would let a successor graft a
/// word; an answer of *held* left standing would let a supervisor believe a
/// successor grafted a word it never saw.
pub fn reclaim_notes(io: std.Io, domain: []const u8) NoteError!void {
    // invariant: a reclamation always names the domain it takes back from
    assert(domain.len >= 1);
    try seat_note(io, domain, ".words", "");
    try seat_note(io, domain, ".given", &[_]u8{0});
    try seat_note(io, domain, ".for", &[_]u8{0});
    try seat_note(io, domain, ".held", &[_]u8{0});
    try seat_note(io, domain, ".kept", &[_]u8{0});
    try seat_note(io, domain, ".pruned", &[_]u8{0});
}

/// Records on the wire how much reach this domain's departed holder never served.
///
/// Written after the reclamation has swept the domain clean, so the count
/// survives the very act that erases every other trace of the conferral. A
/// number kept only in memory would make the abandonment the supervisor's
/// claim; a number on the wire is a fact an operator reads after the run.
pub fn abandon_note(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an abandonment always names the domain it was granted to
    assert(domain.len >= 1);
    // invariant: an abandonment never records more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".abandoned", &[_]u8{@intCast(count)});
}

/// Reads how much reach this domain's departed holder never served.
pub fn abandoned_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an abandonment is always read about the domain it names
    assert(domain.len >= 1);
    const left = read_count(io, domain, ".abandoned") catch return 0;
    // invariant: an abandonment stays inside what one line may name
    assert(left <= cycle.max_hops);
    return left;
}

/// The name a plan's own verdict is published under.
///
/// Every other note on this wire belongs to one dependent; this one belongs to
/// the run itself, so it carries a name no declared domain may take.
pub const plan_name = "plan";

/// Publishes what the plan came to, where an operator reads it after the run.
///
/// The verdict is written once the last dependent has been reaped and every
/// abandonment already answered for, so the word rests on the whole of the
/// work rather than on the part of it that had happened when the run last
/// looked.
pub fn verdict_note(io: std.Io, verdict: Verdict) NoteError!void {
    try seat_note(io, plan_name, ".verdict", &[_]u8{verdict_byte(verdict)});
}

/// Reads a plan's published verdict back, or nothing where none was published.
pub fn verdict_published(io: std.Io) ?Verdict {
    const byte = read_count(io, plan_name, ".verdict") catch return null;
    return verdict_of_byte(byte);
}

// =========================================================================
// The supervisor -- a record that answers for the work its conferrals never
// bought
// =========================================================================

/// One dependent already reaped, held until the whole record has drained.
const Finished = struct {
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
    code: u8,
};

/// Folds one reaped outcome into the report, or names the mismatch.
fn judge_outcome(done: Finished, report_out: *Report) RunError!void {
    // invariant: a judged dependent always names its domain
    assert(done.domain.len >= 1);
    // invariant: the report never counts more successes than dependents reaped
    assert(run_of(report_out).succeeded <= run_of(report_out).reaped);
    if (done.code != done.expect) {
        print("    {s}: expected {s}, heard {s}\n", .{
            done.domain, outcome_name(done.expect), outcome_name(done.code),
        });
        return error.OutcomeMismatch;
    }
    if (done.code == carry.Outcome.carried_ok) {
        run_of(report_out).succeeded += 1;
        if (done.verb == .home) run_of(report_out).homed += done.count;
    }
}

/// The queue's own bookkeeping for one run, over dependents whose conferrals
/// may leave with them.
pub const Table = struct {
    live: [max_in_flight]cohort.Running = undefined,
    lines: [max_in_flight]Task = undefined,
    reserves: [max_in_flight]?Task = @splat(null),
    taken: [max_in_flight]u32 = @splat(0),
    served: [max_in_flight]u32 = @splat(0),
    granted: [max_in_flight]u32 = @splat(0),
    in_flight: u32 = 0,
    done: [max_queue_len]Finished = undefined,
    finished: u32 = 0,
    started: [max_queue_len]bool = @splat(false),
    record: [max_queue_len]unhand.Phase = undefined,
    reserve_of: [max_queue_len]?Task = @splat(null),
    held: u32 = 0,
    head: u32 = 0,
    left: u32 = 0,
};

/// The record as it stands right now.
fn standing(table: *const Table) []const unhand.Phase {
    // invariant: a record never outgrows the queue one supervisor may hold
    assert(table.held <= max_queue_len);
    return table.record[0..table.held];
}

/// Answers whether one phase of the record is still work waiting to run.
fn waits(table: *const Table, at: u32) bool {
    return ladder_checks.waits(@This(), table, at);
}

/// Moves the head past every item already started.
pub fn advance_head(table: *Table) void {
    // invariant: a head never walks past the record it reads
    assert(table.head <= table.held);
    while (table.head < table.held and !waits(table, table.head)) table.head += 1;
}

/// Answers whether a phase of a turn this pick's turn names still waits.
pub fn elder_waits(table: *const Table, pick: u32) bool {
    return ladder_checks.elder_waits(@This(), table, pick);
}

/// Answers whether a sibling of this pick's own turn still waits behind it.
pub fn sibling_waits(table: *const Table, pick: u32, sibling_mask: u32) bool {
    return ladder_checks.sibling_waits(@This(), table, pick, sibling_mask);
}

/// Answers whether the door admits this phase over the lines remembered.
pub fn door_admits(sys: *const system.System, table: *const Table, at: u32) RunError!bool {
    return ladder_checks.door_admits(@This(), sys, table, at);
}

/// Answers whether a phase may be admitted ahead of the record's head.
fn may_pass(
    sys: *const system.System,
    table: *const Table,
    candidate: u32,
    reading: Reading,
) bool {
    return ladder_checks.may_pass(@This(), sys, table, candidate, reading);
}

/// Chooses one phase from behind a blocked head, or answers that none may go.
pub fn choose_pass(
    sys: *const system.System,
    table: *const Table,
    reading: Reading,
) RunError!?u32 {
    return ladder_checks.choose_pass(@This(), sys, table, reading);
}

/// Answers which standing dependent could carry this phase, if any could.
pub fn confer_slot(table: *const Table, at: u32) ?u32 {
    return ladder_checks.confer_slot(@This(), table, at);
}

/// Takes back the reach one standing dependent no longer needs, from the rung
/// below -- kept whole here, since a reclamation is what happens after it.
fn revoke_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    keep: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a revocation always names a dependent the run is holding
    assert(slot < table.in_flight);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    if (revoke_rung.revoke_refusal(table.taken[slot], table.served[slot], keep)) |why| return why;
    const returning = table.taken[slot] - keep;
    // invariant: a revocation that reaches this point always returns reach
    assert(returning >= 1);
    try revoke(io, table.live[slot].domain, keep);
    if (!confirm_pruned(io, table.live[slot].domain, returning)) return error.RevokeUnpruned;
    table.taken[slot] = keep;
    table.served[slot] = keep;
    below_of(report_out).inner.inner.revoked += returning;
}

/// Takes one departed dependent's conferral back whole, so a successor of its
/// domain opens its eyes on a bare wire.
///
/// The rung below reaches into a standing dependent's hands; this one reaches
/// into the wire the two of them spoke over, once the dependent that listened
/// is gone. `slot` names the reaped dependent, whose row still stands in the
/// table until the reaping closes over it.
fn reclaim_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a reclamation always names a row the table still holds
    assert(slot < max_in_flight);
    // invariant: a reclamation never takes back more than one line may name
    assert(table.granted[slot] <= cycle.max_hops);
    const domain = table.live[slot].domain;
    const already = (read_count(io, domain, ".given") catch 0) == 0;
    if (reclaim_refusal(table.granted[slot], false, already)) |why| return why;
    try reclaim_notes(io, domain);
    below_of(report_out).inner.reclaimed += table.granted[slot];
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
pub fn confer_one(
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *Table,
    slot: u32,
    at: u32,
    keeping: Keep,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a conferral always names a dependent the run is holding
    assert(slot < table.in_flight);
    // invariant: a conferral always names a phase inside the record
    assert(at < table.held);
    const grown = table.taken[slot] + hop_count(table.record[at].task);
    var line: entrust.Line = .{};
    if (entrust.entrust_refusal(
        sys,
        table.lines[0..table.in_flight],
        table.reserves[0..table.in_flight],
        slot,
        table.taken[slot],
        grown,
        &line,
    )) |why| return why;

    var words: Words = .{};
    try confer.write_words(
        caps,
        table.reserves[slot],
        grown,
        hop_count(table.lines[slot]),
        &words,
    );
    try confer_words(io, table.live[slot].domain, &words, grown);
    if (!confirm(io, table.live[slot].domain, grown)) return error.ConferUnheld;
    table.granted[slot] += grown - table.taken[slot];
    table.taken[slot] = grown;
    // The dependent answers `.held` only after it has read every arc it grafted,
    // so the work this reach served is carried by the time the run reads it.
    table.served[slot] = grown;
    below_of(report_out).inner.inner.inner.conferred += 1;
    below_of(report_out).inner.inner.inner.inner.entrusted += 1;
    below_of(report_out).inner.inner.inner.inner.absorbed += 1;

    if (keeping == .pruned) try revoke_one(io, table, slot, 0, report_out);
}

/// Starts one phase, handing the capability words this reach calls for and
/// promising the pruning this keep calls for.
pub fn start_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?Task,
    keeping: Keep,
    wake: gap.Wake,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    return ladder_checks.start_one(@This(), allocator, io, self_path, sys, caps, phase, reserve, keeping, wake, report_out);
}

/// Admits as much of the record as the table and the reading allow, and
/// answers how many phases it took up.
fn fill_table(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!u32 {
    return ladder_checks.fill_table(
        @This(), allocator, io, self_path, sys, caps, wake, reading, keeping, table, report_out,
    );
}

/// Records one departed dependent's abandoned reach, and reads the answer back.
///
/// The reclamation above has already swept this domain clean, so the count is
/// written after it rather than before -- otherwise the very act that closes
/// the conferral would erase the only evidence of what it cost. The answer is
/// read back from the wire before the report believes it.
fn abandon_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    came_home: bool,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: an abandonment always names a row the table still holds
    assert(slot < max_in_flight);
    // invariant: an abandonment never records more than one line may name
    assert(table.granted[slot] <= cycle.max_hops);
    const domain = table.live[slot].domain;
    if (abandon_refusal(table.granted[slot], false, came_home)) |why| return why;
    const left = abandoned_reach(table.granted[slot], came_home, .answered);
    // invariant: an abandonment that reaches this point always names lost work
    assert(left >= 1);
    try abandon_note(io, domain, left);
    if (abandoned_by(io, domain) != left) return error.AbandonUncounted;
    below_of(report_out).abandoned += left;
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
fn reap_oldest(
    io: std.Io,
    table: *Table,
    answer: Answer,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError)!void {
    // invariant: a reaping always has a dependent to wait on
    assert(table.in_flight >= 1);
    // invariant: a reaping never overruns the record it is kept in
    assert(table.finished < max_queue_len);
    const code = try cohort.reap_one(io, &table.live[0]);
    const found = inherited_by(io, table.live[0].domain);
    below_of(report_out).inner.inherited_at_home += found;
    if (found != 0) return error.ReclaimInherited;
    const came_home = code == carry.Outcome.carried_ok;
    if (table.granted[0] >= 1) try reclaim_one(io, table, 0, report_out);
    if (answer == .answered and table.granted[0] >= 1 and !came_home) {
        try abandon_one(io, table, 0, came_home, report_out);
    }
    table.done[table.finished] = .{
        .domain = table.live[0].domain,
        .verb = table.live[0].verb,
        .count = table.live[0].count,
        .expect = table.live[0].expect,
        .code = code,
    };
    table.finished += 1;
    table.in_flight -= 1;
    run_of(report_out).reaped += 1;
    run_of(report_out).turns += 1;

    var s: u32 = 0;
    while (s < table.in_flight) : (s += 1) {
        table.live[s] = table.live[s + 1];
        table.lines[s] = table.lines[s + 1];
        table.reserves[s] = table.reserves[s + 1];
        table.taken[s] = table.taken[s + 1];
        table.served[s] = table.served[s + 1];
        table.granted[s] = table.granted[s + 1];
    }
    // invariant: the table closed over the reaped dependent, none lost
    assert(s == table.in_flight);
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
pub fn seat_the_ground(
    io: std.Io,
    sys: *const system.System,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError)!capabilities.CapabilityTable {
    return ladder_checks.seat_the_ground(@This(), io, sys, report_out);
}

/// Reads a written plan into the table's own record, closed and seated.
///
/// The plan is flattened to the shape the rungs below read, weighed for order
/// and for the names it keeps, closed over its own turns, and its reserves
/// carried across -- all before a single dependent is spawned, so the record a
/// run enforces is the record its author wrote.
fn seat_the_record(base: []const Phase, table: *Table) RunError!void {
    // invariant: a record always seats a plan that names phases
    assert(base.len >= 1);
    // invariant: a record is always seated into a table that holds nothing yet
    assert(table.held == 0);
    var plainly: [max_queue_len]unhand.Phase = undefined;
    var p: u32 = 0;
    while (p < base.len) : (p += 1) plainly[p] = plain(base[p]);
    // invariant: every phase was read plainly, none skipped
    assert(p == base.len);
    const flat = plainly[0..base.len];
    if (!precede.plan_is_ordered(flat)) return error.OrderStalled;
    if (!plan_is_seated(flat)) return error.PlanUnseated;

    precede.close(flat, table.record[0..base.len]);
    table.held = @intCast(base.len);
    table.left = table.held;
    var r: u32 = 0;
    while (r < base.len) : (r += 1) table.reserve_of[r] = base[r].reserve;
    // invariant: every phase carried its reserve into the record, none lost
    assert(r == base.len);
    // invariant: a closed record closes to itself, so the door's work is done
    assert(precede.plan_is_closed(standing(table)));
}

/// Runs a record on the reclaiming take, answering for abandoned work as the
/// chosen answer says.
///
/// The supervisor every rung of this arc keeps -- fill the table, reap the
/// eldest, judge at the end -- with the reclaiming act folded into the reaping
/// one, as the rung below folded it, and the answering act folded in behind
/// that, so a conferral both leaves with its holder and says what its holder
/// left undone.
pub fn run_in_ledger(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    ledger: Ledger,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError || RunError || cohort.RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always reports into a fresh report
    assert(run_of(report_out).admitted == 0);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len > max_queue_len) return error.QueueFull;

    var table: Table = .{};
    try seat_the_record(base, &table);

    const caps = try seat_the_ground(io, sys, report_out);
    run_of(report_out).queued = table.held;

    while (table.left > 0 or table.in_flight > 0) {
        const took_up = try fill_table(
            allocator, io, self_path, sys, &caps, wake, reading, keeping, &table, report_out,
        );
        if (table.in_flight > run_of(report_out).peak_in_flight) {
            run_of(report_out).peak_in_flight = table.in_flight;
        }

        if (table.left > 0) {
            const free = max_in_flight - table.in_flight;
            run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) run_of(report_out).idle_turns += 1;
        }

        // With an empty table nothing conflicts, so a stall here would mean
        // the record named a domain the document does not.
        if (table.in_flight == 0) return error.OrderStalled;

        try reap_oldest(io, &table, .answered, report_out);
    }
    // invariant: the whole record was taken up, and every dependent reaped
    assert(table.left == 0);
    assert(table.in_flight == 0);
    assert(run_of(report_out).reaped == run_of(report_out).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(table.finished + below_of(report_out).inner.inner.inner.inner.absorbed == table.held);

    var j: u32 = 0;
    while (j < table.finished) : (j += 1) try judge_outcome(table.done[j], report_out);
    // invariant: every reaped dependent was judged, none skipped
    assert(j == table.finished);

    try reckon_the_plan(io, &table, ledger, report_out);
}

/// Weighs what the plan came to, publishes the verdict, and reads it back.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. A plan that absorbed no phase into a
/// standing dependent is carried by the shape of its own record, and this rung
/// leaves it exactly there rather than inventing a judgment it cannot make.
pub fn reckon_the_plan(
    io: std.Io,
    table: *const Table,
    ledger: Ledger,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a reckoning always reads a record the run has drained
    assert(table.left == 0);
    const absorbed = below_of(report_out).inner.inner.inner.inner.absorbed;
    const lost = below_of(report_out).abandoned;
    if (absorbed == 0) {
        // invariant: a plan that absorbed nothing can have lost nothing
        assert(lost == 0);
        report_out.verdict = .carried;
        try verdict_note(io, .carried);
        return;
    }
    if (reckon_refusal(absorbed, table.in_flight, lost)) |why| return why;

    const verdict = verdict_in(lost, ledger);
    try verdict_note(io, verdict);
    const said = verdict_published(io) orelse return error.ReckonOverclaimed;
    if (said != verdict) return error.ReckonOverclaimed;
    if (ledger == .reckoned and said == .carried and lost >= 1) return error.ReckonOverclaimed;
    report_out.verdict = said;
    report_out.overclaimed += overclaimed_completion(lost, said);
}

// =========================================================================
// The dependent -- a walk that reads the wire before it trusts its own hands
// =========================================================================

/// Reads the capability words a dependent was handed at its spawn into its slot.
pub fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    return ladder_checks.slot_from_argv(@This(), args, domain, cap_count);
}

/// Answers whether this dependent already holds a capability over one region.
pub fn already_holds(slot: *const capabilities.DependentSlot, region_name: []const u8) bool {
    return ladder_checks.already_holds(slot, region_name);
}

/// Names the word at one depth of a list, or answers that the list is shorter.
pub fn word_at(words: *const Words, index: u32) ?[]const u8 {
    return ladder_checks.word_at(@This(), words, index);
}

/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    base: *const capabilities.DependentSlot,
    words: *const Words,
    keep: u32,
) ?capabilities.DependentSlot {
    return ladder_checks.prune_to(@This(), base, words, keep);
}

/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const Words,
    from: u32,
    to: u32,
) u32 {
    return ladder_checks.reachable_between(@This(), io, slot, words, from, to);
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of this rung, made by the party that would be lying if it were
/// wrong -- and made without touching the hands the dependent actually works
/// with. The words standing for this domain are grafted into a *copy* of those
/// hands, and each arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
pub fn inherited_at_first_breath(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    return ladder_checks.inherited_at_first_breath(@This(), io, base, domain);
}

/// One dependent's own line, read arc by arc against the count it was handed.
pub fn read_own_line(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    task: cycle.Task,
) ?u8 {
    return ladder_checks.read_own_line(@This(), io, slot, task);
}

/// Grafts every conferred word as it arrives, reads each arc, and answers for
/// what it holds.
///
/// Answers the count grafted, or an outcome code where a word or an arc did
/// not stand. The dependent answers `.held` only after reading every arc it
/// grafted, which is what lets the supervisor read that answer as work served.
pub fn graft_promised_reach(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *Words,
    carried_out: *u32,
) ?u8 {
    return ladder_checks.graft_promised_reach(@This(), io, slot, domain, task, promised, granted, carried_out);
}

/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const Words,
    carried: u32,
) ?u32 {
    return ladder_checks.return_promised_reach(@This(), io, base, slot, domain, granted, carried);
}

/// Reads the arcs this dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
pub fn stand_taking_and_returning_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    return ladder_checks.stand_taking_and_returning_reach(@This(), io, base, slot, domain, task, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
pub fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    return ladder_checks.run_dependent(@This(), io, args);
}

// =========================================================================
// The lap -- one plan run twice, once assuming a drained record is a plan
// carried out, and once reckoning the plan against the work that was served
// =========================================================================

/// The lap this rung runs, and the dependent that falls is the whole of it.
///
/// `client_b` stands over three arcs and carries a reserve of one, and the
/// phase behind it asks `client_b` to peek exactly that reserved arc -- so the
/// run confers `menu` to the dependent already standing. Its author declares
/// that it falls, so it grafts the word, answers for it, and falls holding it:
/// the work that conferral was granted for never happens at all. Then
/// `client_a` stands the same way and carries its own work home, so the record
/// drains tidily either way, and the two ledgers are told apart by what the
/// run says the plan came to rather than by anything the run did.
const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_b", .verb = .stand, .hops = "board,ask_b,taken_b", .peers = "serial_virt,client_b", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "w,w,w", .item = .{ .domain = "client_a", .verb = .stand, .hops = "board,ask_a,taken_a", .peers = "serial_virt,client_a", .count = 0, .expect = carry.Outcome.carried_ok } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    return ladder_checks.load_one(io, path, buf);
}

/// The reckoning and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment, the work a
/// verdict weighs, and the honesty of the count answered as a pure fold -- no
/// process anywhere. The fourth refusal, `ReckonOverclaimed`, belongs to the
/// run rather than the fold, since only the wire can answer what a plan
/// published about itself.
pub fn check_reckoning() u8 {
    // The act itself: a drained record that absorbed one phase and lost the
    // arc it called for, reckoned once every dependent is gone.
    if (reckon_refusal(1, 0, 1)) |why| {
        print("  RED: a settled reckoning refused: {s}\n", .{@errorName(why)});
        return 1;
    }

    // The moment: a plan with a dependent still out may yet carry every arc.
    if (reckon_refusal(1, 1, 1)) |why| {
        if (why != error.ReckonEarly) {
            print("  RED: an early reckoning refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan was judged while a dependent still stood\n", .{});
        return 1;
    }

    // The work: a plan that absorbed no phase has nothing this rung weighs.
    if (reckon_refusal(0, 0, 0)) |why| {
        if (why != error.ReckonUnabsorbed) {
            print("  RED: an unabsorbed reckoning refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that absorbed nothing was reckoned all the same\n", .{});
        return 1;
    }

    // The honesty of the count: a plan cannot lose more arcs than it absorbed.
    if (reckon_refusal(1, 0, 2)) |why| {
        if (why != error.ReckonMiscounted) {
            print("  RED: a miscounted reckoning refused for the wrong reason: {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan lost more arcs than it ever absorbed\n", .{});
        return 1;
    }

    // The verdict itself, under both ledgers, over a plan that lost an arc.
    if (verdict_in(1, .assumed) != .carried or verdict_in(1, .reckoned) != .short) {
        print("  RED: a plan that lost an arc read {s} and {s}\n", .{
            verdict_words(verdict_in(1, .assumed)), verdict_words(verdict_in(1, .reckoned)),
        });
        return 1;
    }

    // And a plan that lost nothing is carried out under either ledger.
    if (verdict_in(0, .assumed) != .carried or verdict_in(0, .reckoned) != .carried) {
        print("  RED: a plan that lost nothing was reported short\n", .{});
        return 1;
    }

    // The number the two rooms disagree on, read as a fold.
    if (overclaimed_completion(1, .carried) != 1 or overclaimed_completion(1, .short) != 0) {
        print("  RED: a lost arc overclaimed {d} completions and {d}\n", .{
            overclaimed_completion(1, .carried), overclaimed_completion(1, .short),
        });
        return 1;
    }

    // A plan that lost nothing overclaims nothing, however it was judged.
    if (overclaimed_completion(0, .carried) != 0) {
        print("  RED: a plan that lost nothing overclaimed its own completion\n", .{});
        return 1;
    }

    // The verdict survives the round trip through the byte it rides as.
    if (verdict_of_byte(verdict_byte(.short)) != .short or
        verdict_of_byte(verdict_byte(.carried)) != .carried)
    {
        print("  RED: a verdict did not survive the wire it rides\n", .{});
        return 1;
    }
    if (verdict_of_byte(0) != null) {
        print("  RED: a cleared note read as a verdict\n", .{});
        return 1;
    }

    print("  a drained record says every phase was taken up, never that every phase was served\n", .{});
    print("  three refusals stand by name: early, unabsorbed, miscounted\n", .{});
    print("  the ledger this rung keeps: {s}\n", .{ledger_words(.reckoned)});
    return 0;
}

/// The generalization test: a run that reckons a plan losing nothing reads as
/// the rung below.
pub fn check_unlost(sys: *const system.System) u8 {
    const clients = [_]Task{
        written_queue[0].task,
        written_queue[1].task,
        written_queue[3].task,
    };
    var agreed: u32 = 0;
    var a: u32 = 0;
    while (a < clients.len) : (a += 1) {
        var live_store: [max_in_flight]cohort.Running = undefined;
        live_store[0] = .{
            .proc = undefined,
            .domain = clients[a].item.domain,
            .verb = clients[a].item.verb,
            .count = clients[a].item.count,
            .expect = clients[a].item.expect,
        };
        var handed_store: [max_in_flight]Task = undefined;
        handed_store[0] = clients[a];
        const reserve_store = [_]?Task{null};
        const taken_store = [_]u32{0};
        var b: u32 = 0;
        while (b < clients.len) : (b += 1) {
            const here = admissible_in(
                sys, live_store[0..1], handed_store[0..1], reserve_store[0..1], taken_store[0..1], clients[b],
            ) catch {
                print("  RED: a reckoned run could not weigh its own door\n", .{});
                return 1;
            };
            const there = unhand.admissible_held(sys, live_store[0..1], handed_store[0..1], clients[b]);
            if (here != there) {
                print("  RED: the two readings disagreed about {s} beside {s}\n", .{
                    clients[b].item.domain, clients[a].item.domain,
                });
                return 1;
            }
            agreed += 1;
        }
        // invariant: every newcomer was weighed against this dependent, none skipped
        assert(b == clients.len);
    }
    // invariant: every line stood as the running dependent once, none skipped
    assert(a == clients.len);

    print("  a plan that loses nothing reads as the line handed, all {d} pairs\n", .{agreed});
    return 0;
}

/// Runs one queue whole under one ledger and says whether it survived.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    ledger: Ledger,
    report_out: *Report,
) bool {
    run_in_ledger(
        allocator, io, self_path, sys, plan, .when_moved, .preceded, .held_on, ledger, report_out,
    ) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Tells what the two ledgers did, side by side, in an operator's own words.
fn tell_ledger_runs(assumed: *Report, reckoned: *Report) void {
    // invariant: a telling always reads two runs that were actually run
    assert(run_of(assumed).queued >= 1);
    // invariant: a telling never reports more dependents than phases
    assert(run_of(reckoned).reaped <= run_of(reckoned).queued);
    print("  phases: {d} assuming, {d} reckoning\n", .{
        run_of(assumed).queued, run_of(reckoned).queued,
    });
    print("  dependents: {d} assuming, {d} reckoning\n", .{
        run_of(assumed).reaped, run_of(reckoned).reaped,
    });
    print("  carried home as handed: {d} assuming, {d} reckoning\n", .{
        run_of(assumed).succeeded, run_of(reckoned).succeeded,
    });
    print("  reach conferred: {d} assuming, {d} reckoning\n", .{
        assumed.inner.inner.inner.inner.conferred, reckoned.inner.inner.inner.inner.conferred,
    });
    print("  conferrals reclaimed: {d} assuming, {d} reckoning\n", .{
        assumed.inner.inner.reclaimed, reckoned.inner.inner.reclaimed,
    });
    print("  phases absorbed into a standing dependent: {d} assuming, {d} reckoning\n", .{
        assumed.inner.inner.inner.inner.inner.absorbed, reckoned.inner.inner.inner.inner.inner.absorbed,
    });
    print("  abandoned reach, conferred and never served: {d} assuming, {d} reckoning\n", .{
        assumed.inner.abandoned, reckoned.inner.abandoned,
    });
    print("  the plan, as the run reports it: {s} assuming, {s} reckoning\n", .{
        verdict_words(assumed.verdict), verdict_words(reckoned.verdict),
    });
    print("  completion claimed and not served: {d} against {d}\n", .{
        assumed.overclaimed, reckoned.overclaimed,
    });
    print("  breaks a named turn: {d} assuming, {d} reckoning\n", .{
        preceded_of(assumed).out_of_precede, preceded_of(reckoned).out_of_precede,
    });
}

/// Weighs the two ledgers against each other and names the first disagreement.
fn judge_ledger_runs(assumed: *Report, reckoned: *Report) u8 {
    // invariant: a judging always reads two runs that were actually run
    assert(run_of(assumed).queued >= 1);
    // invariant: a judging never counts a completion no plan ever claimed
    assert(assumed.overclaimed <= 1);
    if (run_of(reckoned).queued != run_of(assumed).queued) {
        print("  RED: the two ledgers ran {d} phases against {d}\n", .{
            run_of(reckoned).queued, run_of(assumed).queued,
        });
        return 1;
    }
    if (run_of(reckoned).reaped != run_of(assumed).reaped) {
        print("  RED: the two ledgers reaped {d} dependents against {d}\n", .{
            run_of(reckoned).reaped, run_of(assumed).reaped,
        });
        return 1;
    }
    if (run_of(reckoned).succeeded != run_of(assumed).succeeded) {
        print("  RED: the two ledgers carried {d} dependents home against {d}\n", .{
            run_of(reckoned).succeeded, run_of(assumed).succeeded,
        });
        return 1;
    }
    if (reckoned.inner.inner.inner.inner.conferred != assumed.inner.inner.inner.inner.conferred) {
        print("  RED: the two ledgers conferred {d} against {d}\n", .{
            reckoned.inner.inner.inner.inner.conferred, assumed.inner.inner.inner.inner.conferred,
        });
        return 1;
    }
    if (reckoned.inner.inner.reclaimed != assumed.inner.inner.reclaimed) {
        print("  RED: the two ledgers reclaimed {d} conferrals against {d}\n", .{
            reckoned.inner.inner.reclaimed, assumed.inner.inner.reclaimed,
        });
        return 1;
    }
    if (reckoned.inner.abandoned != assumed.inner.abandoned) {
        print("  RED: the two ledgers lost {d} arcs against {d}\n", .{
            reckoned.inner.abandoned, assumed.inner.abandoned,
        });
        return 1;
    }
    if (reckoned.inner.abandoned == 0) {
        print("  RED: a fallen holder's conferral bought work after all\n", .{});
        return 1;
    }
    if (assumed.verdict != .carried) {
        print("  RED: a run assuming completion still reported its plan short\n", .{});
        return 1;
    }
    if (reckoned.verdict != .short) {
        print("  RED: a plan that lost an arc was reported carried out\n", .{});
        return 1;
    }
    if (assumed.overclaimed != 1) {
        print("  RED: a plan reported carried over lost work overclaimed {d}\n", .{
            assumed.overclaimed,
        });
        return 1;
    }
    if (reckoned.overclaimed != 0) {
        print("  RED: a plan reported short still overclaimed {d} completions\n", .{
            reckoned.overclaimed,
        });
        return 1;
    }
    if (preceded_of(reckoned).out_of_precede != 0) {
        print("  RED: the reckoning run broke {d} turn orders its author named\n", .{
            preceded_of(reckoned).out_of_precede,
        });
        return 1;
    }
    return 0;
}

/// The reckoning lap: one plan run twice, once assuming a drained record is a
/// plan carried out and once weighing the plan against the work that was
/// served.
pub fn check_ledger_runs(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
) u8 {
    var assumed: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .assumed, &assumed)) return 1;
    // The verdict an operator reads after the run is the one the run published,
    // rather than the one it remembers -- read here from the wire itself.
    const assumed_said = verdict_published(io) orelse {
        print("  RED: a run published no verdict at all\n", .{});
        return 1;
    };
    if (assumed_said != assumed.verdict) {
        print("  RED: the wire read {s} where the run reported {s}\n", .{
            verdict_words(assumed_said), verdict_words(assumed.verdict),
        });
        return 1;
    }

    var reckoned: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .reckoned, &reckoned)) return 1;
    const reckoned_said = verdict_published(io) orelse {
        print("  RED: a reckoning run published no verdict at all\n", .{});
        return 1;
    };
    if (reckoned_said != .short) {
        print("  RED: the wire read {s} where the plan lost an arc\n", .{
            verdict_words(reckoned_said),
        });
        return 1;
    }

    tell_ledger_runs(&assumed, &reckoned);
    const judged = judge_ledger_runs(&assumed, &reckoned);
    if (judged != 0) return judged;

    // invariant: a run reaps exactly the dependents it admitted, never more
    assert(run_of(&reckoned).reaped == run_of(&reckoned).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(run_of(&reckoned).reaped + reckoned.inner.inner.inner.inner.inner.absorbed == run_of(&reckoned).queued);
    // invariant: a plan never loses more arcs than the phases it absorbed
    assert(reckoned.inner.abandoned <= reckoned.inner.inner.inner.inner.inner.absorbed);
    return 0;
}

pub fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan reckon {s} -- self-test\n", .{caravan_reckon_version});
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const reckoning = check_reckoning();
    if (reckoning != 0) return reckoning;
    const unlost = check_unlost(&sys);
    if (unlost != 0) return unlost;
    const runs = check_ledger_runs(allocator, io, self_path, &sys);
    if (runs != 0) return runs;
    print("  GREEN: a plan that lost an arc is reported short, and the run says so\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    return ladder_checks.run_main(@This(), init);
}
