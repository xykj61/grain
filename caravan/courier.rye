// =========================================================================

/// What becomes of a conferral when its holder is reaped, from the rung below.
pub const Take = amending_rung.Take;

/// Renders one take as the words an operator reads.
pub fn take_words(t: Take) []const u8 {
    return amending_rung.take_words(t);
}

/// Answers why one conferral may not be reclaimed, or that it may.
pub fn reclaim_refusal(conferred: u32, in_flight: bool, already: bool) ?RunError {
    return amending_rung.reclaim_refusal(conferred, in_flight, already);
}

/// Counts the reach a successor finds waiting at its first breath.
pub fn inherited_reach(conferred: u32, take: Take) u32 {
    return amending_rung.inherited_reach(conferred, take);
}

// =========================================================================
// The abandonment -- carried whole from the rung below, since this rung
// always answers for lost work and asks what the plan is worth afterwards
// =========================================================================

/// Whether a run answers for the work a fallen holder's conferral never
/// served, from the rung below. This rung always answers.
pub const Answer = amending_rung.Answer;

/// Answers why one abandonment may not be recorded, or that it may.
pub fn abandon_refusal(granted: u32, in_flight: bool, came_home: bool) ?RunError {
    return amending_rung.abandon_refusal(granted, in_flight, came_home);
}

/// Counts the reach a run conferred that nobody ever served.
pub fn abandoned_reach(granted: u32, came_home: bool, answer: Answer) u32 {
    return amending_rung.abandoned_reach(granted, came_home, answer);
}

// =========================================================================
// The mend -- carried whole from the rung below, since this rung repairs the
// same way and asks a different question about which arcs to repair at all
// =========================================================================

/// Answers why one mend may not be attempted, or that it may.
pub fn mend_refusal(published: ?Verdict, lost: u32, seating: u32) ?RunError {
    return amending_rung.mend_refusal(published, lost, seating);
}

/// Counts the work still standing when the supervisor exits.
pub fn unserved_after(lost: u32, served_again: u32) u32 {
    return amending_rung.unserved_after(lost, served_again);
}

/// Answers what the plan came to once the mend has had its turn, from below.
pub fn settled_verdict(unserved: u32) Verdict {
    return amending_rung.settled_verdict(unserved);
}

/// Reads one phase back as the work it names, freed of the plan it belonged to.
///
/// The rung below sheds the arrangement and keeps the work. This one keeps the
/// bearing too, since a phase that asked to be borne asks it every time it is
/// written down -- a repair that quietly dropped the word would be free to
/// re-run the arc on its next pass.
pub fn reseated(phase: Phase, at: u32) Phase {
    // invariant: a re-seated phase always keeps the domain its author named
    assert(phase.task.item.domain.len >= 1);
    // invariant: a re-seat never numbers a turn past the plan's own bound
    assert(at < max_turns);
    const beneath = amending_rung.reseated(below(phase), at);
    return .{
        .turn = beneath.turn,
        .step = beneath.step,
        .follows = beneath.follows,
        .follows_turns = beneath.follows_turns,
        .reserve = beneath.reserve,
        .bear = phase.bear,
        .task = beneath.task,
    };
}

// =========================================================================
// The bearing -- carried whole from the rung below, since a marked loss is
// answered there and this rung only ever weighs the unmarked ones
// =========================================================================

/// How a run answers the losses its own plan asked it to bear.
pub const Bearing = amending_rung.Bearing;

/// Renders one bearing as the words an operator reads.
pub fn bearing_words(b: Bearing) []const u8 {
    return amending_rung.bearing_words(b);
}

/// What an operator finally reads about a plan, once the repair is over.
///
/// Three words still, and the third widens rather than splits: a plan whole
/// but for a loss it chose to carry reads `borne` whether its author named
/// that loss outright or published the standard by which it was weighed. The
/// author chose it either way -- once by naming the arc, once by naming the
/// rule -- and the wire keeps the two apart glyph by glyph. The word an
/// operator acts on stays one word, because the action is one action: there is
/// nothing left here to do.
pub const Settlement = amending_rung.Settlement;

/// Renders one settlement as the words an operator reads.
pub fn settlement_words(s: Settlement) []const u8 {
    return amending_rung.settlement_words(s);
}

/// The one byte a settlement rides as, so an operator's note is a single glyph.
pub fn settlement_byte(s: Settlement) u8 {
    return amending_rung.settlement_byte(s);
}

/// Reads one settlement back from the byte it rode as, or nothing at all.
pub fn settlement_of_byte(byte: u8) ?Settlement {
    return amending_rung.settlement_of_byte(byte);
}

/// Answers why one bearing may not be weighed, or that it may.
pub fn bear_refusal(published: ?Verdict, lost: u32, borne: u32, repairing: u32) ?RunError {
    return amending_rung.bear_refusal(published, lost, borne, repairing);
}

/// Counts the arcs a run re-ran after its author asked it to bear them.
pub fn overrepaired(borne_mask: u32, seated_mask: u32) u32 {
    return amending_rung.overrepaired(borne_mask, seated_mask);
}

/// Answers what an operator finally reads, once the repair has had its turn.
pub fn settlement_of(unserved: u32, bore: u32) Settlement {
    return amending_rung.settlement_of(unserved, bore);
}

