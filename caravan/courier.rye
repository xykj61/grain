//! Caravan courier -- a correction is carried to the reader who never comes
//! back, rather than left standing on a wire they have already left.
//!
//! `amend.rye` taught a run to answer the operator whose word it replaced: the
//! settlement superseded, the settlement that supersedes it, both readings named
//! in two bytes on the wire, and the standing reading cleared in the same
//! breath. It is a true correction, honestly published, and it waits.
//!
//! **Waiting is the whole of what is left wrong.** A correction published on the
//! wire reaches whoever comes back to read the wire. The operator this rung
//! studies is the one who does not -- who read `borne`, understood there was
//! nothing left to do, and went about the rest of their day. Every note below
//! this rung answers a reader who returns. Nobody has yet answered the reader
//! who does not.
//!
//! **The measurement is corrections left waiting for a reader who never
//! returns.** The rung below weighs a record against its reader and writes the
//! answer down. This one weighs the answer against the **distance** between
//! where it was written and where the reader actually is. A correction that
//! never travels is a letter written, sealed, and left in the writer's own
//! drawer -- entirely honest, and read by nobody.
//!
//! **A reader leaves an address, or they leave nothing.** A reading arrives on
//! the wire beside the place its reader was reached at, since a person who took
//! a word away is somewhere, and the plan either wrote that down or it did not.
//! An amendment whose reading names no address has nowhere to go, and this rung
//! says so by refusing rather than by inventing a destination.
//!
//! **A plan publishes whether its own corrections travel.** A record written
//! `dispatch = .carried` says: a correction this run posts is carried to the
//! address its reading was taken at. `dispatch = .waiting` is where the rung
//! below leaves it -- the correction stands on the wire, correct and unread. The
//! word sits at the plan beside the notice, since it instructs about how far a
//! record reaches rather than about any one phase.
//!
//! **The delivery lands outside this plan's own wire, and that is the point.**
//! Every note of this arc so far has been written into the plan's own note
//! directory, where a reader must come looking. A delivery is written into the
//! **reader's** box instead, under a directory this plan does not otherwise
//! touch, so the first outward reach of the whole arc is visible as exactly
//! that: a record leaving the place records are kept.
//!
//! **A delivery is bounded by the correction it carries.** Only an amendment
//! this run actually posted may be carried, and every posted amendment is
//! carried or held -- never both and never neither. A run that delivered a
//! correction nobody wrote would be handing a reader a blank page.
//!
//! **The rung earns four refusals, and each is about the journey rather than
//! the correction it carries.** `CourierEarly` is the moment: a correction
//! carried before this run posted one is delivering from memory. `CourierUnaddressed`
//! is the supply: an amendment whose reading was taken at no address has nowhere
//! to be carried. `CourierMiscounted` is the honesty of the count: every posted
//! amendment is carried or held, and never two of those and never none.
//! `CourierUndelivered` is the answer -- the hard half -- since a run that says it
//! reached a reader whose box holds nothing has made a claim rather than a
//! delivery, and a report read on that claim is worse than the silence below it.
//!
//! **A plan the wire holds no reading about reads as the rung below.** With no
//! standing reading, no amendment is posted, nothing is carried, each line
//! stands at the width it was handed, and the door answers
//! `unhand.admissible_held` pair for pair -- this arc's standing generalization
//! test, one tier further out.
//!
//! Usage:
//!   courier            Run the self-test (default)
//!   courier selftest   Same as default
//!   courier dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const bearing_rung = @import("bear.rye");
const amending_rung = @import("amend.rye");
const recanting_rung = @import("recant.rye");
const appraising_rung = @import("appraise.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");
const ladder_checks = @import("ladder_checks.rye");

const Dir = std.Io.Dir;

const caravan_courier_version = "20260820.051057";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = amending_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = amending_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = amending_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = amending_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = amending_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = amending_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.couriers";

/// Where a reader's own box lives, outside this plan's wire entirely.
///
/// The whole point of the rung, written as a path. Every note of this arc so
/// far has landed under `note_dir`, where a reader must come looking; a
/// delivery lands here instead, so the first outward reach of the arc is
/// visible as a record leaving the place records are kept.
pub const reader_dir = "caravan/.readers";

/// The longest address a reader may leave, in bytes.
///
/// Bounded like every other word this wire carries: an address is a short
/// name for a place a person is, never a path a run could be talked into
/// walking somewhere unintended.
pub const max_address_len: u32 = 16;

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = amending_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = amending_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = amending_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = amending_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = amending_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = amending_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = amending_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the amending notes
    assert(!std.mem.eql(u8, note_dir, amending_rung.note_dir));
    // invariant: this rung's notes never collide with the recanting notes
    assert(!std.mem.eql(u8, note_dir, recanting_rung.note_dir));
    // invariant: a delivery always leaves the place this plan keeps its records
    assert(!std.mem.eql(u8, note_dir, reader_dir));
    // invariant: a reader's box path leaves room for the address it is named by
    assert(max_note_path_len > reader_dir.len + max_address_len);
    // invariant: this rung's notes never collide with the appraising notes
    assert(!std.mem.eql(u8, note_dir, appraising_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return amending_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, correct the
/// reader of a word it has since replaced, or carry that correction to them.
///
/// Four names of this rung's own, and each is about the journey rather than the
/// correction it carries: the moment a delivery is made, the address it may be
/// carried to, the honesty of the count, and the box it leaves the correction in.
pub const RunError = amending_rung.RunError || error{
    CourierEarly,
    CourierUnaddressed,
    CourierMiscounted,
    CourierUndelivered,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = amending_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = amending_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) amending_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return amending_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = amending_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = amending_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = amending_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = amending_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return amending_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return amending_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return amending_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return amending_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return amending_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = amending_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return amending_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return amending_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the journey its correction made added.
///
/// `unreached` is the number this rung moves: corrections this run posted and
/// left standing on the wire, waiting for a reader who never comes back to it.
/// `delivered` is what it carried instead, written into the reader's own box at
/// the address their reading was taken at.
pub const Report = struct {
    inner: amending_rung.Report = .{},
    delivered: u32 = 0,
    unreached: u32 = 0,
};

/// This rung's own tally, reached the way every rung above reaches it.
///
/// Every rung above this one finds the couriering through `couriering_of`,
/// climbing a nesting of `inner` to arrive here. This rung *is* that tier, so
/// the reach is the report itself -- and naming it anyway is what lets the one
/// body every rung of this arc runs stand byte for byte in this rung too,
/// rather than nearly. An accessor born for the tier a rung owns costs three
/// lines and folds forty-one.
pub fn couriering_of(report_out: *Report) *Report {
    return report_out;
}

/// The amending rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
pub fn amending_of(report_out: *Report) *amending_rung.Report {
    return &report_out.inner;
}

/// The recanting rung's tally, one tier further down.
pub fn recanting_of(report_out: *Report) *recanting_rung.Report {
    return &report_out.inner.inner;
}

/// The appraising rung's tally, two tiers further down.
pub fn appraising_of(report_out: *Report) *appraising_rung.Report {
    return &report_out.inner.inner.inner;
}

/// The bearing rung's tally, three tiers further down.
pub fn bearing_of(report_out: *Report) *bearing_rung.Report {
    return &report_out.inner.inner.inner.inner;
}

/// The mending rung's tally, four tiers further down.
pub fn below_of(report_out: *Report) *mending_rung.Report {
    return &report_out.inner.inner.inner.inner.inner;
}

/// The abandoning rung's tally, seven tiers further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return amending_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return amending_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return amending_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return amending_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return amending_rung.reserve_depth(reserve);
}

