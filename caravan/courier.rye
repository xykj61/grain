// =========================================================================
// The recantation -- carried whole from the rung below, since this rung
// corrects the reader of a settlement the reversal beneath it moved
// =========================================================================

/// Whether a plan's own published judgments answer to a later run's evidence.
pub const Review = amending_rung.Review;

/// Renders one review as the words an operator reads.
pub fn review_words(r: Review) []const u8 {
    return amending_rung.review_words(r);
}

/// Which standing judgments this run's own evidence no longer supports.
pub fn recanted_in(standing_mask: u32, evidenced_mask: u32, lost_mask: u32) u32 {
    return amending_rung.recanted_in(standing_mask, evidenced_mask, lost_mask);
}

/// Which standing judgments this run's own evidence stands behind.
