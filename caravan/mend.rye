//! Caravan mend -- a plan reported short is run again for exactly what it
//! lost, and never for what it carried.
//!
//! `reckon.rye` taught a run to weigh its own plan and say `short` when an arc
//! it absorbed bought nothing. The verdict goes to the wire, an operator can
//! read it after the supervisor exits, and the run returns. **Nobody acts on
//! it.** A supervisor that reads its own short verdict and does nothing has
//! learned the truth and changed nothing by learning it -- the plan is still
//! short, and now it is short on the record.
//!
//! **The measurement is work still standing when the supervisor exits.** The
//! five counts before it weigh reach a dependent held or a claim a supervisor
//! made; this one weighs an arc of a plan that nobody carried. It differs from
//! overclaimed completion in the way that matters most: an overclaim is a
//! sentence a supervisor should not have written, and is repaired by saying
//! less. Unserved work is repaired only by doing more.
//!
//! **A mend seats from the record, never from memory.** The verdict says *that*
//! a plan fell short; a repair needs to know *where*, and the answer lives in a
//! table that is gone the moment the run returns. So the run writes a loss note
//! beside the verdict -- one glyph per phase, `x` where an absorbed arc was
//! never served -- and the mend reads its own run's published verdict back
//! before it decides anything. A supervisor that repairs from memory is
//! repairing a plan it believes in rather than the one it published.
//!
//! **The repair is bounded by the loss.** It seats exactly the phases the wire
//! names, each freed of the arrangement it was written for: the dependent those
//! phases were conferred into is gone, so the work stands on its own line now.
//! The order a phase named was an order among siblings, and by the time a mend
//! runs there are none left to keep it with. A repair that could grow into a
//! re-run would quietly redo work the plan actually carried, which is the whole
//! of what `MendOvereach` refuses.
//!
//! **The price is named rather than hidden.** A repair costs exactly the
//! dependents its lost phases call for -- one here, never two -- and the lap
//! asserts that cost rather than reporting it quietly. Every other number holds
//! still: both runs take up 4 phases, confer 1 arc, reclaim 1 conferral, absorb
//! 1 phase, lose 1 arc, and both report the plan short when they first weigh
//! it. What moves is the work left standing at the end, from 1 to 0.
//!
//! **The rung earns four refusals, and each is about the mend rather than the
//! plan it repairs.** `MendUnread` is the record: a mend that read no verdict
//! at all is acting on memory. `MendWhole` is the plan: a plan the wire calls
//! carried has nothing here to repair. `MendOvereach` is the reach: a repair
//! may never seat more than the plan lost. `MendUnserved` is the answer -- the
//! hard half -- since a run that published `carried` with an arc still standing
//! would report a repair nobody made.
//!
//! **A plan that lost nothing reads as the rung below.** With every absorbed
//! phase served, the mend is refused before it seats anything, each line stands
//! at the width it was handed, and the door answers `unhand.admissible_held`
//! pair for pair -- this arc's standing generalization test, one tier further
//! out.
//!
//! Usage:
//!   mend            Run the self-test (default)
//!   mend selftest   Same as default
//!   mend dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const ladder_checks = @import("ladder_checks.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const reckoning_rung = @import("reckon.rye");
const tally_parse_int = @import("parse_int.rye");

const Dir = std.Io.Dir;

const caravan_mend_version = "20260820.031204";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = reckoning_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = reckoning_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = reckoning_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = reckoning_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = reckoning_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = reckoning_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.mends";

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = reckoning_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = reckoning_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = reckoning_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = reckoning_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = reckoning_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = reckoning_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = reckoning_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the abandoning notes
    assert(!std.mem.eql(u8, note_dir, reckoning_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return reckoning_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, or repair it.
///
/// Four names of this rung's own, and each is about the mend rather than the
/// plan it repairs: the plan it is offered, the record it reads it from, the
/// reach it seats, and the answer it publishes when the repair is over.
pub const RunError = reckoning_rung.RunError || error{
    MendWhole,
    MendUnread,
    MendOvereach,
    MendUnserved,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = reckoning_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = reckoning_rung.Reading;

/// One phase, its turn, its step, its masks, and the reserve it may be
/// entrusted -- exactly the shape the rung below reads.
pub const Phase = reckoning_rung.Phase;

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return reckoning_rung.plain(phase);
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = reckoning_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = reckoning_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = reckoning_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = reckoning_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return reckoning_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return reckoning_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return reckoning_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return reckoning_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return reckoning_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = reckoning_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return reckoning_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return reckoning_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the repair it made added.
///
/// `unserved` is the number this rung moves: work a plan absorbed and nobody
/// carried, still standing when the supervisor exits. `reseated` is the price
/// it pays for moving it, counted in phases the mend put back on the record.
pub const Report = struct {
    inner: reckoning_rung.Report = .{},
    unserved: u32 = 0,
    reseated: u32 = 0,
    settled: Verdict = .carried,
};

/// The reckoning rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
fn below_of(report_out: *Report) *reckoning_rung.Report {
    return &report_out.inner;
}

/// The abandoning rung's tally, one tier further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return reckoning_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return reckoning_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return reckoning_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return reckoning_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return reckoning_rung.reserve_depth(reserve);
}

