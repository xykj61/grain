//! Caravan appraise -- a loss its author left unmarked is weighed by what came
//! home after it, under a standard the plan published rather than a preference
//! the supervisor holds.
//!
//! `bear.rye` taught a plan to name the loss it would rather carry than repair.
//! That word is a judgment made **before** the run, and it is the right place
//! for it: an author knows which of their own arcs is worth doing twice. Yet a
//! bearing can only ever speak about what its author could foresee, and some
//! losses reveal what they were worth only after the run is over. A plan that
//! left a loss unmarked said nothing about it -- and the rung below reads that
//! silence as `repair`, every time, whatever the run went on to learn.
//!
//! **The measurement is arcs re-run for work the plan already got past.** The
//! rung below weighs obedience: work a run did after its author asked it not
//! to. This one weighs **judgment**: work a run did that its author never
//! spoke to, and that the run's own evidence says nobody needed. A plan comes
//! out complete under the elder reading either way, and one more dependent is
//! what it spent to get there.
//!
//! **A plan publishes the standard by which its silences are read.** A record
//! written `standard = .weighed` says: where I left a loss unmarked, weigh it
//! by what came home after it. `standard = .repair` is the rung below exactly
//! -- every unmarked loss is run again. The standard is plan-level, since it
//! is a statement about how a whole record's silences should be read, and one
//! word an author writes once is a word an author can mean.
//!
//! **The evidence is the plan's own downstream, and only the run can produce
//! it.** A lost arc whose followers all came home is an arc the plan got past:
//! the work behind it stood up without it, which is a fact about this run and
//! never about the record. A lost arc that took its followers down with it, or
//! that has no follower at all to speak for it, is repaired -- silence about
//! an arc nothing depended on is no evidence, and custody-first reads no
//! evidence as repair.
//!
//! **The appraisal stands on the wire beside the loss and the bearing.** One
//! glyph per phase, `w` where an unmarked loss was weighed and found spent, so
//! `.w...` names which phase of five the run judged the plan had got past --
//! and the repair reads it back before it seats anything. A supervisor that
//! appraised from memory would be applying a standard it believes in rather
//! than the one its plan published.
//!
//! **The rung earns four refusals, and each is about the judgment rather than
//! the repair it bounds.** `AppraiseEarly` is the moment: a standard applied
//! before the run published what it lost is judging from memory. `AppraiseMarked`
//! is the authority: a phase its author marked never reaches the standard,
//! since an author's own word outranks any rule about their silences.
//! `AppraiseMiscounted` is the honesty of the count: every lost arc is marked,
//! weighed, or repaired, and never two of those and never none.
//! `AppraiseUnweighed` is the answer -- the hard half -- since a run that
//! carried an appraised loss the wire does not name, or published a settlement
//! the wire does not carry, would report a judgment it never made in the open.
//!
//! **A plan that loses nothing reads as the rung below.** With every absorbed
//! phase served, the standard is refused before it weighs anything, each line
//! stands at the width it was handed, and the door answers
//! `unhand.admissible_held` pair for pair -- this arc's standing generalization
//! test, one tier further out.
//!
//! Usage:
//!   appraise            Run the self-test (default)
//!   appraise selftest   Same as default
//!   appraise dependent ...  Run as one supervised dependent (spawned by the run)
const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const bearing_rung = @import("bear.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");
const ladder_checks = @import("ladder_checks.rye");

const Dir = std.Io.Dir;

const caravan_appraise_version = "20260820.035835";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = bearing_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = bearing_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = bearing_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = bearing_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = bearing_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = bearing_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.appraisals";

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = bearing_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = bearing_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = bearing_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = bearing_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = bearing_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = bearing_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = bearing_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the abandoning notes
    assert(!std.mem.eql(u8, note_dir, bearing_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return bearing_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, or weigh the loss its author
/// left unmarked.
///
/// Four names of this rung's own, and each is about the judgment rather than
/// the repair it bounds: the moment the standard is applied, the authority it
/// yields to, the honesty of the count, and the judgment it publishes once the
/// repair is over.
pub const RunError = bearing_rung.RunError || error{
    AppraiseEarly,
    AppraiseMarked,
    AppraiseMiscounted,
    AppraiseUnweighed,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = bearing_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = bearing_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here, and that is the whole of its claim: what it
/// weighs is the phases whose authors wrote **nothing**. The standard by which
/// a silence is read is a statement about a whole record, so it lives at the
/// plan rather than the phase -- one word an author writes once is a word an
/// author can mean.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) bearing_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return bearing_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = bearing_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = bearing_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = bearing_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = bearing_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return bearing_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return bearing_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return bearing_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return bearing_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return bearing_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = bearing_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return bearing_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return bearing_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the judgment it made added.
///
/// `repaired_spent` is the number this rung moves: arcs a run re-ran for work
/// its own plan had already got past, and that its author never spoke to
/// either way. `weighed` is what it carried as a loss instead, under the
/// standard the plan published.
pub const Report = struct {
    inner: bearing_rung.Report = .{},
    weighed: u32 = 0,
    repaired_spent: u32 = 0,
};

/// The bearing rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
fn bearing_of(report_out: *Report) *bearing_rung.Report {
    return &report_out.inner;
}

/// The mending rung's tally, one tier further down.
fn below_of(report_out: *Report) *mending_rung.Report {
    return &report_out.inner.inner;
}

/// The abandoning rung's tally, four tiers further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The single bit that stands for one turn of a plan.
pub fn turn_bit(turn: u32) u32 {
    return bearing_rung.turn_bit(turn);
}

/// Answers whether the plan's written sequence keeps every name it carries.
pub fn plan_is_seated(plan: []const unhand.Phase) bool {
    return bearing_rung.plan_is_seated(plan);
}

/// Answers whether two phases must keep the order the queue wrote them in.
pub fn items_contend(sys: *const system.System, a: unhand.Phase, b: unhand.Phase, reading: Reading) bool {
    return bearing_rung.items_contend(sys, a, b, reading);
}

/// Counts the arcs one line names.
pub fn hop_count(task: Task) u32 {
    return bearing_rung.hop_count(task);
}

/// Counts the arcs a reserve offers, or zero where a phase named none.
pub fn reserve_depth(reserve: ?Task) u32 {
    return bearing_rung.reserve_depth(reserve);
}

