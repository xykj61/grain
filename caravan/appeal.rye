/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = tidings_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return tidings_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return tidings_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the pleas its readers write back.
///
/// `unread` is the number this rung moves: readers who answered how their own
/// quarrel came out and whom no run ever read, because every note of this arc
/// travels one direction and the plan never looks back. `heard_back` is what
/// this rung records instead -- the reader's own byte, read out of their own
/// box and published where an operator opens the plan. `unheard_back` is the
/// other half of the same count, and the two close on the readers this run told
/// exactly.
pub const Report = struct {
    inner: tidings_rung.Report = .{},
    heard_back: u32 = 0,
    unheard_back: u32 = 0,
    unread: u32 = 0,
};

/// The tidings rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
pub fn tidings_of(report_out: *Report) *tidings_rung.Report {
    return &report_out.inner;
}

