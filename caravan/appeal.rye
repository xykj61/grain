    return tidings_rung.standard_words(s);
}

/// Which phases of a closed record follow this one, one bit each.
pub fn followers_of(record: []const unhand.Phase, at: u32) u32 {
    return tidings_rung.followers_of(record, at);
}

/// Which of a plan's unmarked losses this run's own evidence says it got past.
///
/// The fold the rung below built, and the whole of what this rung weighs a
/// standing judgment against. It is pure, so a later run folds it over its own
/// record and gets an answer about *this* run rather than about the one that
/// published the appraisal now on the wire.
pub fn appraised_in(record: []const unhand.Phase, lost_mask: u32, bear_mask: u32) u32 {
    return tidings_rung.appraised_in(record, lost_mask, bear_mask);
}

/// Answers why one appraisal may not be made, or that it may.
pub fn appraise_refusal(
    published: ?Verdict,
    lost: u32,
    marked: u32,
    weighed: u32,
    repairing: u32,
) ?RunError {
    return tidings_rung.appraise_refusal(published, lost, marked, weighed, repairing);
}

/// Refuses a standard that reached a loss its author had already marked.
pub fn marked_reach(bear_mask: u32, weighed_mask: u32) ?RunError {
    return tidings_rung.marked_reach(bear_mask, weighed_mask);
}

/// Counts the arcs a run re-ran for work its own plan had already got past.
pub fn repaired_spent(weighed_mask: u32, seated_mask: u32) u32 {
    return tidings_rung.repaired_spent(weighed_mask, seated_mask);
}

// =========================================================================
// The recantation -- carried whole from the rung below, since this rung
// corrects the reader of a settlement the reversal beneath it moved
// =========================================================================

/// Whether a plan's own published judgments answer to a later run's evidence.
pub const Review = tidings_rung.Review;

/// Renders one review as the words an operator reads.
pub fn review_words(r: Review) []const u8 {
    return tidings_rung.review_words(r);
}

/// Which standing judgments this run's own evidence no longer supports.
pub fn recanted_in(standing_mask: u32, evidenced_mask: u32, lost_mask: u32) u32 {
    return tidings_rung.recanted_in(standing_mask, evidenced_mask, lost_mask);
}

/// Which standing judgments this run's own evidence stands behind.
pub fn upheld_in(standing_mask: u32, evidenced_mask: u32, lost_mask: u32) u32 {
    return tidings_rung.upheld_in(standing_mask, evidenced_mask, lost_mask);
}

/// Answers why one recantation may not be made, or that it may.
pub fn recant_refusal(
    published: ?Verdict,
    judged: u32,
    upheld: u32,
    taken_back: u32,
) ?RunError {
    return tidings_rung.recant_refusal(published, judged, upheld, taken_back);
}

/// Refuses a recantation that reached an arc no appraisal ever spared.
pub fn unappraised_reach(standing_mask: u32, taken_back_mask: u32) ?RunError {
    return tidings_rung.unappraised_reach(standing_mask, taken_back_mask);
}

/// Counts the arcs a run spared on a judgment its own evidence disproves.
pub fn spared_disproved(spared_mask: u32, evidenced_mask: u32) u32 {
    return tidings_rung.spared_disproved(spared_mask, evidenced_mask);
}

// =========================================================================
// The amendment -- carried whole from the rung below, since this rung carries
// a correction rather than composing one
// =========================================================================

/// Whether a plan's own corrections are addressed to whoever read the elder
/// word, or merely written over it.
pub const Notice = tidings_rung.Notice;

/// Renders one notice as the words an operator reads.
pub fn notice_words(n: Notice) []const u8 {
    return tidings_rung.notice_words(n);
}

/// Whether the word an operator carries away disagrees with what this run
/// settled.
pub fn superseded(reading: ?Settlement, settled: Settlement) bool {
    return tidings_rung.superseded(reading, settled);
}

/// Which standing reading this run corrects, counted as the one it can be.
pub fn amended_in(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return tidings_rung.amended_in(reading, settled, notice);
}

/// Which standing reading this run stands behind unchanged.
pub fn confirmed_in(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return tidings_rung.confirmed_in(reading, settled, notice);
}

/// Answers why one amendment may not be posted, or that it may.
pub fn amend_refusal(
    published: ?Settlement,
    on_the_wire: u32,
    confirmed: u32,
    amended: u32,
) ?RunError {
    return tidings_rung.amend_refusal(published, on_the_wire, confirmed, amended);
}

/// Refuses an amendment addressed to a reading nobody ever took.
pub fn unread_reach(reading: ?Settlement, amended: u32) ?RunError {
    return tidings_rung.unread_reach(reading, amended);
}

/// Counts the readings an operator holds that this run's settlement contradicts
/// and nobody wrote to.
pub fn superseded_unposted(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return tidings_rung.superseded_unposted(reading, settled, notice);
}

// =========================================================================
// The delivery -- how far a run carries the correction it has written
// =========================================================================

/// Whether a plan's own corrections travel to the reader, or wait on the wire
/// for a reader who may never come back.
///
/// `waiting` is where the rung below leaves it: the correction stands on the
/// wire, entirely truthful, read by whoever returns and by nobody else.
/// `carried` is this rung: a correction this run posts is carried to the address
/// its reading was taken at, written into the reader's own box, and read back
/// from that box before the report believes anybody was reached.
///
/// The word sits at the plan beside the notice, and for the same reason: it
/// instructs about how far a record reaches rather than about any one phase.
pub const Dispatch = enum { waiting, carried };

/// Renders one dispatch as the words an operator reads.
pub fn dispatch_words(d: Dispatch) []const u8 {
    return switch (d) {
        .waiting => "a correction is published where the record lives, and waits",
        .carried => "a correction is carried to the place its reader was reached",
    };
}

/// Whether an address names a place a correction may actually be carried to.
///
/// Bounded and plain: a reader's address is a short name, never empty and never
/// longer than the wire's own bound, and never a path a run could be talked into
/// walking somewhere it was not asked to go. A run that cannot name where a
/// reader is refuses rather than guessing.
pub fn addressable(address: []const u8) bool {
    return ladder_checks.addressable(@This(), address);
}

/// Which posted correction this run carries, counted as the one it can be.
///
/// A run under `.waiting` carries none, however truly it corrected the wire --
/// which is exactly where the rung below leaves a reader who does not return. A
/// run under `.carried` carries the one correction it posted, and only where the
/// reading it answers left an address to carry it to.
pub fn carried_in(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.carried_in(@This(), amended, addressed, dispatch);
}

/// Which posted correction this run leaves standing where it wrote it.
///
/// The other half of the same count, named rather than inferred, so the honesty
/// of the count reads straight as an equality: every posted correction is
/// carried or held.
pub fn held_in(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.held_in(@This(), amended, addressed, dispatch);
}

/// Answers why one correction may not be carried, or that it may.
///
/// Every refusal this rung earns before a correction leaves the wire. `posted`
/// is the amendment this run read back from its own record, `addressed` is
/// whether the reading it answers named a place to carry it to, `held` is how
/// many corrections stay where they were written, and `carried` is how many
/// travel.
///
/// The order is the rung below's order one tier out. A delivery asks whether
/// there is a correction to carry before it asks where to carry it, because a
/// courier setting out with an empty satchel is delivering from memory of a
/// letter nobody wrote.
pub fn carry_refusal(posted: ?[2]Settlement, addressed: bool, held: u32, carried: u32) ?RunError {
    return ladder_checks.carry_refusal(@This(), posted, addressed, held, carried);
}

/// Refuses a delivery bound for a reader who left no address.
///
/// The supply this rung is bounded by, stated as its own refusal so it can be
/// read straight rather than inferred from a count. Carrying a correction to a
/// reader nobody can name invents a destination, which is the same overreach as
/// correcting a reader who never read.
pub fn unaddressed_reach(addressed: bool, carried: u32) ?RunError {
    return ladder_checks.unaddressed_reach(@This(), addressed, carried);
}

/// Counts the corrections this run wrote and left waiting for a reader who
/// never comes back.
///
/// The eleventh of the family, and the first that weighs a record against the
/// **distance** between where it was written and where its reader actually is.
/// The count before it names the sentence a person carried away and the answer
/// this run owed them; this names that answer, written honestly, sitting in the
/// writer's own drawer. Every note below this rung reaches a reader who returns,
/// and this is the first that reaches one who does not.
///
/// The measurement reaches only a correction whose reading left an address. A
/// reader who can be named and was not written to is a loss this run could have
/// prevented; a reader who left no way to be found is a duty nobody can
/// discharge, and counting it would be measuring the weather.
pub fn posted_unreached(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.posted_unreached(@This(), amended, addressed, dispatch);
}

// =========================================================================
// The hearing -- carried whole from the rung below, since this rung records
// what that hearing may not accept
// =========================================================================

/// Whether a plan listens for the answer its own correction earned, unchanged.
pub const Receipt = tidings_rung.Receipt;

/// Renders one receipt as the words an operator reads.
pub fn receipt_words(r: Receipt) []const u8 {
    return tidings_rung.receipt_words(r);
}

/// Which carried correction this run hears an answer to.
///
/// The rung below's own count, and this rung hands it a stricter question than
/// the rung below ever asked. Below, `agreed` was simply whether any hand stood
/// in the reader's box; here it is whether that hand named the reading the
/// letter carries. An answer a plan cannot accept is not an answer it heard,
/// and calling it one would be the exact overreach `HearMisheard` refuses.
pub fn heard_in(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return tidings_rung.heard_in(carried, agreed, receipt);
}

/// Which carried correction this run leaves without ever hearing its answer.
pub fn unheard_in(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return tidings_rung.unheard_in(carried, agreed, receipt);
}

/// Answers why one answer may not be heard, or that it may.
pub fn hear_refusal(
    carried: ?[2]Settlement,
    agreed: bool,
    unheard: u32,
    heard: u32,
) ?RunError {
    return tidings_rung.hear_refusal(carried, agreed, unheard, heard);
}

/// Refuses a hearing where no hand ever agreed.
pub fn unanswered_reach(agreed: bool, heard: u32) ?RunError {
    return tidings_rung.unanswered_reach(agreed, heard);
}

/// Answers whether one reader's hand agrees with the correction it answers.
///
/// The consensus season's law, carried whole: a reading is never lifted off the
/// word it was true for. Below this rung the answer was the end of the matter,
/// since a hand that failed this test ended the run. Here it is the fork -- an
/// agreeing hand closes the correspondence, and a disagreeing one opens the
/// record this rung exists to keep.
pub fn hand_agrees(letter: [2]Settlement, hand: Settlement) bool {
    return tidings_rung.hand_agrees(letter, hand);
}

/// Counts the corrections a run carried whose reader answered into silence.
pub fn carried_unheard(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return tidings_rung.carried_unheard(carried, agreed, receipt);
}

// =========================================================================
// The dispute -- carried whole from the rung below, since this rung always
// records and asks who ever reads what the record holds
// =========================================================================

/// Whether a plan's record may hold a disagreement, or keeps a single voice.
pub const Standing = tidings_rung.Standing;

/// Renders one standing as the words an operator reads.
pub fn standing_words(s: Standing) []const u8 {
    return tidings_rung.standing_words(s);
}

/// Which read answer this run records as a dispute, from the rung below.
pub fn recorded_in(answered: u32, agreed: bool, record: Standing) u32 {
    return tidings_rung.recorded_in(answered, agreed, record);
}

/// Which read answer this run keeps no record of at all.
pub fn unwritten_in(answered: u32, agreed: bool, record: Standing) u32 {
    return tidings_rung.unwritten_in(answered, agreed, record);
}

/// Answers whether the pair a run would write is a disagreement at all.
pub fn founded(pair: [2]Settlement) bool {
    return tidings_rung.founded(pair);
}

/// Answers why one disagreement may not be recorded, or that it may.
pub fn dispute_refusal(
    answer: ?Settlement,
    agreed: bool,
    unwritten: u32,
    recorded: u32,
) ?RunError {
    return tidings_rung.dispute_refusal(answer, agreed, unwritten, recorded);
}

/// Refuses a record of a disagreement nobody ever voiced.
pub fn unheard_record(answered: bool, recorded: u32) ?RunError {
    return tidings_rung.unheard_record(answered, recorded);
}

/// Counts the answers a run read and set aside without a record.
pub fn answered_unrecorded(answered: u32, agreed: bool, record: Standing) u32 {
    return tidings_rung.answered_unrecorded(answered, agreed, record);
}

// =========================================================================
// The escort -- carried whole from the rung below, since this rung always
// escorts and asks how long the objection it escorts may stand
// =========================================================================

/// Whether the word an operator reads travels alone, or beside the reading
/// standing against it.
pub const Escort = tidings_rung.Escort;

/// Renders one escort as the words an operator reads.
pub fn escort_words(e: Escort) []const u8 {
    return tidings_rung.escort_words(e);
}

/// Which published word this run stands up beside its objection.
pub fn escorted_in(published: u32, disputed: bool, escort: Escort) u32 {
    return tidings_rung.escorted_in(published, disputed, escort);
}

/// Which published word this run leaves standing on its own.
pub fn alone_in(published: u32, disputed: bool, escort: Escort) u32 {
    return tidings_rung.alone_in(published, disputed, escort);
}

/// Answers whether a mark quotes the reading its reader actually holds.
pub fn quotes(marked: Settlement, disputed: [2]Settlement) bool {
    return tidings_rung.quotes(marked, disputed);
}

/// Answers why one word may not be stood beside its objection, or that it may.
pub fn abide_refusal(
    record: ?[2]Settlement,
    alone_count: u32,
    escorted: u32,
) ?RunError {
    return tidings_rung.abide_refusal(record, alone_count, escorted);
}

/// Refuses a mark standing beside a disagreement no record ever kept.
pub fn unrecorded_escort(disputed: bool, escorted: u32) ?RunError {
    return tidings_rung.unrecorded_escort(disputed, escorted);
}

/// Counts the words an operator reads as settled while a disagreement stands
/// recorded against them, carrying no sign of it.
pub fn published_unattended(published: u32, disputed: bool, escort: Escort) u32 {
    return tidings_rung.published_unattended(published, disputed, escort);
}

// =========================================================================
// The term -- carried whole from the rung below, since this rung always bounds
// its objections and asks what the mark itself says about them
// =========================================================================

/// Whether an objection this plan publishes carries a term, or stands forever.
pub const Term = tidings_rung.Term;

/// Renders one term as the words an operator reads.
pub fn term_words(t: Term) []const u8 {
    return tidings_rung.term_words(t);
}

/// What became of one objection once its reader was asked again.
pub const Life = tidings_rung.Life;

/// Renders one life as the words an operator reads.
pub fn life_words(l: Life) []const u8 {
    return tidings_rung.life_words(l);
}

/// The one byte a life rides as, so an operator's note is a single glyph.
pub fn life_byte(l: Life) u8 {
    return tidings_rung.life_byte(l);
}

/// Reads one life back from the byte it rode as, or nothing at all.
pub fn life_of_byte(byte: u8) ?Life {
    return tidings_rung.life_of_byte(byte);
}

/// How many standing objections this run puts back to the reader who raised them.
pub fn asked_in(escorted: u32, disputed: bool, term: Term) u32 {
    return tidings_rung.asked_in(escorted, disputed, term);
}

/// How many asked objections their own reader raised again.
pub fn renewed_in(asked: u32, again: bool) u32 {
    return tidings_rung.renewed_in(asked, again);
}

/// How many asked objections passed out of standing, unrenewed.
pub fn lapsed_in(asked: u32, again: bool) u32 {
    return tidings_rung.lapsed_in(asked, again);
}

/// Answers whether a second hand raises the objection actually standing.
pub fn renews(again: Settlement, held: [2]Settlement) bool {
    return tidings_rung.renews(again, held);
}

/// Answers why one objection may not be given a term, or that it may.
pub fn lapse_refusal(
    record: ?[2]Settlement,
    renewed_count: u32,
    lapsed: u32,
) ?RunError {
    return tidings_rung.lapse_refusal(record, renewed_count, lapsed);
}

/// Refuses a silence nobody ever listened for.
pub fn unasked_lapse(asked: u32, lapsed: u32) ?RunError {
    return tidings_rung.unasked_lapse(asked, lapsed);
}

/// Counts the objections this run publishes beside a word with no term at all.
pub fn objection_unbounded(escorted: u32, disputed: bool, term: Term) u32 {
    return tidings_rung.objection_unbounded(escorted, disputed, term);
}

// =========================================================================
// The standing -- carried whole from the rung below, since this rung reports
// on a quarrel the mark already carries the standing of
// =========================================================================

/// Whether the mark this plan publishes carries the standing of its objection.
pub const Mark = tidings_rung.Mark;

/// Renders one mark as the words an operator reads.
pub fn mark_words(m: Mark) []const u8 {
    return tidings_rung.mark_words(m);
}

/// What a mark says about the objection standing beside the word.
pub const Stand = tidings_rung.Stand;

/// Renders one standing as the words an operator reads.
pub fn stand_words(s: Stand) []const u8 {
    return tidings_rung.stand_words(s);
}

/// The one byte a standing rides as, appended to the mark it speaks for.
pub fn stand_byte(s: Stand) u8 {
    return tidings_rung.stand_byte(s);
}

/// Reads one standing back from the byte it rode as, or nothing at all.
pub fn stand_of_byte(byte: u8) ?Stand {
    return tidings_rung.stand_of_byte(byte);
}

/// Reads one term's own answer as the standing a mark carries.
pub fn stands_as(life: Life) Stand {
    return tidings_rung.stands_as(life);
}

/// Answers whether a standing says what the wire's own term says.
pub fn agrees(stand: Stand, life: Life) bool {
    return tidings_rung.agrees(stand, life);
}

/// How many marks this run publishes a standing for.
pub fn read_in(escorted: u32, weighed: bool, mark: Mark) u32 {
    return tidings_rung.read_in(escorted, weighed, mark);
}

/// How many marks this run leaves reading exactly as the rung below wrote them.
pub fn bare_in(escorted: u32, weighed: bool, mark: Mark) u32 {
    return tidings_rung.bare_in(escorted, weighed, mark);
}

/// Answers why a mark may not carry a standing, or that it may.
pub fn repose_refusal(escorted: u32, stood_count: u32, bare_count: u32) ?RunError {
    return tidings_rung.repose_refusal(escorted, stood_count, bare_count);
}

/// Refuses a standing published for an objection nobody ever weighed.
pub fn unweighed_stand(weighed: u32, stood_count: u32) ?RunError {
    return tidings_rung.unweighed_stand(weighed, stood_count);
}

/// Counts the objections escorted whose standing an operator cannot read.
pub fn mark_unstanding(escorted: u32, weighed: bool, mark: Mark) u32 {
    return tidings_rung.mark_unstanding(escorted, weighed, mark);
}

// =========================================================================
// The tidings -- delegated whole, since a reply reads a telling it never makes
// =========================================================================

/// Whether a run writes back to the reader who raised an objection.
pub const Tidings = tidings_rung.Tidings;

/// Renders one tidings as the words an operator reads.
pub fn tidings_words(t: Tidings) []const u8 {
    return tidings_rung.tidings_words(t);
}

/// How the quarrel came out, in the one thing its raiser asked about.
pub const Result = tidings_rung.Result;

/// Renders one result as the words an operator reads.
pub fn result_words(r: Result) []const u8 {
    return tidings_rung.result_words(r);
}

/// The one byte a result rides as, so a reader's own note is a single glyph.
pub fn result_byte(r: Result) u8 {
    return tidings_rung.result_byte(r);
}

/// Reads one result back from the byte it rode as, or nothing at all.
pub fn result_of_byte(byte: u8) ?Result {
    return tidings_rung.result_of_byte(byte);
}

/// Reads the word a reader objected to and the word the plan settled as the
/// result their quarrel came to.
pub fn results_as(objected_to: Settlement, settled: Settlement) Result {
    return tidings_rung.results_as(objected_to, settled);
}

/// Answers whether a result says what the wire's own two words say.
pub fn tells_true(result: Result, objected_to: Settlement, settled: Settlement) bool {
    return tidings_rung.tells_true(result, objected_to, settled);
}

/// How many raisers this run writes back to.
pub fn told_in(raised: u32, weighed: bool, tidings: Tidings) u32 {
    return tidings_rung.told_in(raised, weighed, tidings);
}

/// How many raisers this run leaves exactly as the rung below leaves them.
pub fn untold_in(raised: u32, weighed: bool, tidings: Tidings) u32 {
    return tidings_rung.untold_in(raised, weighed, tidings);
}

/// Answers why a run may not write back, or that it may.
pub fn tidings_refusal(raised: u32, told_count: u32, untold_count: u32) ?RunError {
    return tidings_rung.tidings_refusal(raised, told_count, untold_count);
}

/// Refuses a tiding sent about a quarrel nobody ever weighed.
pub fn unweighed_tidings(weighed: u32, told_count: u32) ?RunError {
    return tidings_rung.unweighed_tidings(weighed, told_count);
}

/// Counts the objections weighed whose raiser was never told how it came out.
pub fn objection_untold(raised: u32, weighed: bool, tidings: Tidings) u32 {
    return tidings_rung.objection_untold(raised, weighed, tidings);
}

// =========================================================================
// The appeal -- what a run owes a reader it has just answered
// =========================================================================

/// Whether a run reads what its reader says back, or sends the outcome and
/// never looks at their box again.
///
/// `closed` is where the rung below leaves it: the tiding written, the reply
/// unread, the record silent about whether anybody accepted a word of it.
/// `open` is this rung -- the reader's own byte read out of their own box and
/// published where an operator opens the plan.
///
/// The word sits at the plan beside the tidings, and for the same reason: it
/// instructs about who a record listens to rather than about any one phase.
pub const Appeal = enum { closed, open };

/// Renders one appeal as the words an operator reads.
pub fn appeal_words(a: Appeal) []const u8 {
    return switch (a) {
        .closed => "a run answers its reader and never reads what they say back",
        .open => "a run reads what its reader says to the answer it sent",
    };
}

/// What a reader says to the outcome they were told.
///
/// Two pleas and no third, because a person handed an answer to their own
/// quarrel does one of two things with it: they let it stand, or they say it is
/// still wrong. A plea grades nothing and reopens nothing -- it records where
/// the person who raised the quarrel actually stands once the season is over.
pub const Plea = enum { accepts, presses };

/// Renders one plea as the words an operator reads.
pub fn plea_words(p: Plea) []const u8 {
    return switch (p) {
        .accepts => "the reader accepts how their quarrel came out",
        .presses => "the reader presses their quarrel still",
    };
}

/// The one byte a plea rides as, so a reader's own reply is a single glyph.
///
/// `a` and `p` rather than any byte already spoken on this wire: the reading
/// rides as `s`, the term as `r` and `l`, the standing as `h` and `q`, the
/// outcome as `m` and `t`. A reader writing their own reply writes a glyph that
/// belongs to no other note in the arc.
pub fn plea_byte(p: Plea) u8 {
    return switch (p) {
        .accepts => 'a',
        .presses => 'p',
    };
}

/// Reads one plea back from the byte it rode as, or nothing at all.
pub fn plea_of_byte(byte: u8) ?Plea {
    return switch (byte) {
        'a' => .accepts,
        'p' => .presses,
        else => null,
    };
}

/// Answers whether a published plea says what the reader's own hand says.
///
/// The record half of this rung, and the reason the plea is read back before
/// the report believes it. An operator opening `plan.appeal` reads a living
/// person's position on a quarrel they raised; a byte that disagrees with the
/// one in their box tells that operator the wrong thing about somebody who is
/// still there to be asked.
pub fn quotes_plea(published: Plea, wrote: Plea) bool {
    return published == wrote;
}

/// How many readers this run hears back from.
///
/// A run under `.closed` hears from none, however plainly the reader wrote --
/// which is exactly where the rung below leaves every person it answers. A run
/// under `.open` hears from the one reader it actually told, and only where
/// that reader actually replied; a reader who has said nothing has nothing to
/// be heard, and inventing a plea for them would be filing their objection on
/// their behalf.
pub fn appeal_heard_in(told: u32, replied: bool, appeal: Appeal) u32 {
    // invariant: a run never tells more readers than a wire may carry
    assert(told <= 1);
    if (appeal == .closed) return 0;
    if (!replied) return 0;
    return told;
}

/// How many readers this run leaves exactly as the rung below leaves them.
///
/// The other half of the same count, named rather than inferred, so the honesty
/// of the count reads straight as an equality: every reader this run told is
/// heard again or left unheard.
pub fn appeal_unheard_in(told: u32, replied: bool, appeal: Appeal) u32 {
    // invariant: a run never tells more readers than a wire may carry
    assert(told <= 1);
    return told - appeal_heard_in(told, replied, appeal);
}

/// Answers why a run may not read a reply back, or that it may.
///
/// Every refusal this rung earns before a plea reaches the record. `told` is
/// the reader this run actually wrote to, `heard_count` is how many replies it
/// records, and `unheard_count` is how many readers it leaves as they were.
///
/// The order is the rung below's order one tier out. An appeal asks whether
/// anybody was told before it asks what they said, because a run reading a plea
/// where nothing was ever sent is hearing a reply to a letter it never wrote.
pub fn appeal_refusal(told: u32, heard_count: u32, unheard_count: u32) ?RunError {
    // invariant: a run never hears from more readers than a wire may carry
    assert(heard_count <= 1);
    // invariant: a run never leaves more readers unheard than a wire may carry
    assert(unheard_count <= 1);
    if (heard_count >= 1 and told == 0) return error.AppealEarly;
    // Every reader this run told is heard again or left unheard -- never both
    // and never neither. A count that does not close is a supervisor about to
    // publish a position its own wire cannot support.
    if (heard_count + unheard_count != told) return error.AppealMiscounted;
    return null;
}

/// Refuses a plea published where the reader's own hand wrote nothing.
///
/// The hard half of the whole rung, stated as its own refusal so it can be read
/// straight rather than inferred from a count. A plea is published for one
/// honest reason -- the reader actually wrote it -- and a run that files one
/// where the box is empty has invented a person's position and then read its
/// own handwriting back as their consent.
pub fn unvoiced_appeal(replied: u32, heard_count: u32) ?RunError {
    // invariant: a run never hears from more readers than a wire may carry
    assert(heard_count <= 1);
    if (heard_count >= 1 and replied == 0) return error.AppealUnvoiced;
    return null;
}

/// Counts the readers who answered how their quarrel came out and whom no run
/// ever read.
///
/// The eighteenth of the family, and the first that weighs what a reader
/// reached back. Every rung beneath this one moves a finding outward -- to the
/// record, to the mark, to the term, and finally to the person themselves --
/// and each one of them travels a single direction. A reply written into a box
/// nobody opens is a person answering a season of work into silence.
///
/// The measurement reaches only a reader this run actually told who actually
/// wrote back. A run that told nobody has nobody to read, and a reader who said
/// nothing has left nothing unread; both are silences no appeal can fill.
pub fn answer_unread(told: u32, replied: bool, appeal: Appeal) u32 {
    // invariant: a run never tells more readers than a wire may carry
    assert(told <= 1);
    if (told == 0 or !replied) return 0;
    return if (appeal == .open) 0 else 1;
}
// =========================================================================
// The door -- unchanged, since this rung carries a record rather than a line
// =========================================================================

/// Answers whether the head may enter, over the lines the run remembers.
///
/// The door is `revoke.admissible_in` exactly: a widened line is weighed the
/// same way whether a correction travels or waits. What this rung changes
/// happens after the last dependent has already gone home.
pub fn admissible_in(
    sys: *const system.System,
    live: []const cohort.Running,
    handed: []const Task,
    reserves: []const ?Task,
    taken: []const u32,
    head: Task,
) RunError!bool {
    return tidings_rung.admissible_in(sys, live, handed, reserves, taken, head);
}

// =========================================================================
// The notes -- what a run publishes, and the answers it reads back
// =========================================================================

/// Why a conferral could not be published, read, confirmed, or reclaimed.
pub const NoteError = tidings_rung.NoteError;

/// Writes the path of one dependent's note.
pub fn note_path(buf: *[max_note_path_len]u8, domain: []const u8, suffix: []const u8) NoteError![]const u8 {
    return ladder_checks.note_path(@This(), buf, domain, suffix);
}

/// Writes bytes into a note, creating it fresh.
pub fn seat_note(io: std.Io, domain: []const u8, suffix: []const u8, bytes: []const u8) NoteError!void {
    return ladder_checks.seat_note(@This(), io, domain, suffix, bytes);
}

/// Reads the one byte a counting note carries.
pub fn read_count(io: std.Io, domain: []const u8, suffix: []const u8) NoteError!u8 {
    return ladder_checks.read_count(@This(), io, domain, suffix);
}

/// Reads the word list a dependent's domain has been handed so far.
pub fn read_words(io: std.Io, domain: []const u8, out: *Words) NoteError!void {
    return ladder_checks.read_words(@This(), io, domain, out);
}

/// Provisions one set of notes per declared domain, all standing at nothing.
///
/// Every run starts with no reach conferred, none revoked, and no conferral
/// standing anywhere, so a word a dependent finds at its first breath was left
/// by this run's own supervisor rather than by the last.
pub fn provision_notes(io: std.Io, sys: *const system.System) NoteError!u32 {
    // invariant: the domain roster stays within its bound
    assert(sys.graph.domain_count >= 1);
    // invariant: a run always provisions into a declaration that read whole
    assert(sys.map.region_count >= 1);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    var i: u32 = 0;
    while (i < sys.graph.domain_count) : (i += 1) {
        const name = sys.graph.domains[i].name_slice();
        try seat_note(io, name, ".given", &[_]u8{0});
        try seat_note(io, name, ".held", &[_]u8{0});
        try seat_note(io, name, ".offered", &[_]u8{0});
        try seat_note(io, name, ".words", "");
        try seat_note(io, name, ".pruning", &[_]u8{0});
        try seat_note(io, name, ".kept", &[_]u8{0});
        try seat_note(io, name, ".pruned", &[_]u8{0});
        try seat_note(io, name, ".inherited", &[_]u8{0});
        try seat_note(io, name, ".epoch", &[_]u8{0});
        try seat_note(io, name, ".for", &[_]u8{0});
        try seat_note(io, name, ".falls", &[_]u8{0});
        try seat_note(io, name, ".abandoned", &[_]u8{0});
    }
    // The plan's own verdict is cleared with them, so no run ever reads the
    // last run's judgment of a plan this one has not finished. Its bearing and
    // its settlement clear beside it, for exactly the same reason: a repair
    // that read the last run's bearing would spare an arc this plan never
    // asked it to spare.
    try seat_note(io, plan_name, ".verdict", &[_]u8{0});
    try seat_note(io, plan_name, ".bearing", "");
    try seat_note(io, plan_name, ".settled", &[_]u8{0});
    // The recantation clears with them, since a reversal belongs to the run
    // that made it and answers for that run's own evidence alone.
    //
    // **The appraisal stays.** It is the one note a run leaves exactly where it
    // found it, because a judgment that vanished with its run was never a
    // record -- and because what a run does with a judgment it did not make is
    // the whole subject of this rung.
    try seat_note(io, plan_name, ".recant", "");
    // The amendment clears with them, since a correction belongs to the run that
    // posted it and answers for that run's own settlement alone.
    //
    // **The reading stays**, beside the appraisal, and for a plainer reason than
    // the appraisal's: a reader's copy survives the run whatever the wire does,
    // so a wire that forgot what it last told somebody could never notice it had
    // changed its mind.
    try seat_note(io, plan_name, ".amend", "");
    // The recorded disagreement clears with them, since a dispute belongs to
    // the run that read it and answers for the answer that run itself heard.
    // A record that kept the last run's quarrel would be holding a reader to a
    // word they wrote about a plan that has since been run again.
    try seat_note(io, plan_name, ".dispute", "");
    // The published plea clears with them, and for the same reason one tier
    // out: a position belongs to the run that read it, and a record holding the
    // last run's plea would be holding a living person to what they said about
    // a plan that has since been run again.
    try seat_note(io, plan_name, ".appeal", &[_]u8{0});
    // invariant: a fresh provisioning leaves no plea standing to be read
    assert(appeal_published(io) == null);
    // invariant: a fresh provisioning leaves no amendment standing to be read
    assert(amend_published(io) == null);
    // invariant: a fresh provisioning leaves no disagreement standing to be read
    assert(dispute_recorded(io) == null);
    // invariant: a fresh provisioning leaves no verdict standing to be read
    assert(verdict_published(io) == null);
    // invariant: a fresh provisioning leaves no settlement standing to be read
    assert(settlement_published(io) == null);
    // invariant: every declared domain got its notes, none invented
    assert(i == sys.graph.domain_count);
    return i;
}

/// Tells one dependent how much reach may yet arrive for it.
pub fn offer(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    return ladder_checks.offer(@This(), io, domain, depth);
}

/// Reads how much reach this dependent was told may yet arrive.
pub fn offered(io: std.Io, domain: []const u8) NoteError!u32 {
    // invariant: an offer is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = try read_count(io, domain, ".offered");
    // invariant: an offer stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Tells one dependent whether a pruning will come for it at all.
pub fn promise_pruning(io: std.Io, domain: []const u8, keep: Keep) NoteError!void {
    return ladder_checks.promise_pruning(@This(), io, domain, keep);
}

/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(io: std.Io, domain: []const u8) bool {
    return ladder_checks.pruning_promised(@This(), io, domain);
}

/// Tells this dependent how its author declared it would end.
///
/// A plan already names the outcome it expects of every phase, and until now
/// only the supervisor read that word. The dependent needs it too, since the
/// window this rung studies opens inside the dependent's own life -- after it
/// grafts a conferral and before it carries the work. So the declaration rides
/// the same wire as the pruning promise, written before the spawn.
pub fn promise_falling(io: std.Io, domain: []const u8, falling: bool) NoteError!void {
    return ladder_checks.promise_falling(@This(), io, domain, falling);
}

/// Answers whether this dependent's author declared that it falls.
pub fn falling_promised(io: std.Io, domain: []const u8) bool {
    // invariant: a declaration is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".falls") catch return false;
    return seen != 0;
}

/// Publishes one conferral: the generation it is meant for, the words
/// themselves, then the count that makes them live.
///
/// The generation is what lets a dependent tell a word meant for it from a
/// word left standing by the dependent before it. It is a **measurement**
/// rather than a guard: a careless successor may graft a foreign word all the
/// same, which is exactly why the conferral is reclaimed rather than merely
/// labelled.
pub fn confer_words(io: std.Io, domain: []const u8, words: *const Words, depth: u32) NoteError!void {
    // invariant: a conferral always names the dependent it is handed to
    assert(domain.len >= 1);
    // invariant: a conferral never hands more than one line may name
    assert(depth <= cycle.max_hops);
    const generation = read_count(io, domain, ".epoch") catch 0;
    try seat_note(io, domain, ".for", &[_]u8{generation});
    try seat_note(io, domain, ".words", words.slice());
    try seat_note(io, domain, ".given", &[_]u8{@intCast(depth)});
}

/// Opens one generation of a domain, and answers which it is.
///
/// A domain outlives every dependent that stands in it, so each start counts
/// one further. The number is seated before the spawn, so a dependent always
/// finds its own generation waiting for it.
pub fn open_generation(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.open_generation(@This(), io, domain);
}

/// Tells the run this dependent has grafted the reach it was conferred.
pub fn holds(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never grafts more than one line may name
    assert(depth <= cycle.max_hops);
    try seat_note(io, domain, ".held", &[_]u8{@intCast(depth)});
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(io: std.Io, domain: []const u8, depth: u32) bool {
    return ladder_checks.confirm(@This(), io, domain, depth);
}

/// Publishes one revocation: how many conferred words remain live.
pub fn revoke(io: std.Io, domain: []const u8, keep: u32) NoteError!void {
    // invariant: a revocation always names the dependent it is asked of
    assert(domain.len >= 1);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    try seat_note(io, domain, ".kept", &[_]u8{@intCast(keep)});
}

/// Reads how many conferred words this dependent may still hold.
pub fn kept(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.kept(@This(), io, domain);
}

/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    return ladder_checks.pruned(@This(), io, domain, count);
}

/// Waits, bounded, until this revocation has been pruned.
pub fn confirm_pruned(io: std.Io, domain: []const u8, count: u32) bool {
    return ladder_checks.confirm_pruned(@This(), io, domain, count);
}

/// Tells the run how much reach this dependent found standing at its first breath.
pub fn inherited(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never inherits more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".inherited", &[_]u8{@intCast(count)});
}

/// Reads how much reach this dependent found standing at its first breath.
pub fn inherited_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an answer is always read about the dependent that gave it
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".inherited") catch return 0;
    // invariant: an inheritance stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Takes one conferral back whole, so nothing of it stands for a successor.
///
/// The words, the count that makes them live, and every answer given about
/// them return together. A count left standing would let a successor graft a
/// word; an answer of *held* left standing would let a supervisor believe a
/// successor grafted a word it never saw.
pub fn reclaim_notes(io: std.Io, domain: []const u8) NoteError!void {
    // invariant: a reclamation always names the domain it takes back from
    assert(domain.len >= 1);
    try seat_note(io, domain, ".words", "");
    try seat_note(io, domain, ".given", &[_]u8{0});
    try seat_note(io, domain, ".for", &[_]u8{0});
    try seat_note(io, domain, ".held", &[_]u8{0});
    try seat_note(io, domain, ".kept", &[_]u8{0});
    try seat_note(io, domain, ".pruned", &[_]u8{0});
}

/// Records on the wire how much reach this domain's departed holder never served.
///
/// Written after the reclamation has swept the domain clean, so the count
/// survives the very act that erases every other trace of the conferral. A
/// number kept only in memory would make the abandonment the supervisor's
/// claim; a number on the wire is a fact an operator reads after the run.
pub fn abandon_note(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an abandonment always names the domain it was granted to
    assert(domain.len >= 1);
    // invariant: an abandonment never records more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".abandoned", &[_]u8{@intCast(count)});
}

/// Reads how much reach this domain's departed holder never served.
pub fn abandoned_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an abandonment is always read about the domain it names
    assert(domain.len >= 1);
    const left = read_count(io, domain, ".abandoned") catch return 0;
    // invariant: an abandonment stays inside what one line may name
    assert(left <= cycle.max_hops);
    return left;
}

/// The name a plan's own verdict is published under.
///
/// Every other note on this wire belongs to one dependent; this one belongs to
/// the run itself, so it carries a name no declared domain may take.
pub const plan_name = "plan";

/// Publishes what the plan came to, where an operator reads it after the run.
///
/// The verdict is written once the last dependent has been reaped and every
/// abandonment already answered for, so the word rests on the whole of the
/// work rather than on the part of it that had happened when the run last
/// looked.
pub fn verdict_note(io: std.Io, verdict: Verdict) NoteError!void {
    try seat_note(io, plan_name, ".verdict", &[_]u8{verdict_byte(verdict)});
}

/// Reads a plan's published verdict back, or nothing where none was published.
pub fn verdict_published(io: std.Io) ?Verdict {
    const byte = read_count(io, plan_name, ".verdict") catch return null;
    return verdict_of_byte(byte);
}

/// Publishes which phases of the plan an arc was lost on.
pub fn lost_note(io: std.Io, held: u32, lost_mask: u32) NoteError!void {
    return ladder_checks.lost_note(@This(), io, held, lost_mask);
}

/// Reads the published loss back as the mask a mend seats from.
///
/// A mend that reads nothing here has nothing to repair, and says so with a
/// zero rather than by guessing -- the refusal that follows is `MendUnread`
/// when even the verdict is absent, and `MendOvereach` if a caller were ever
/// to propose seating work the wire never named.
pub fn lost_published(io: std.Io, held: u32) u32 {
    return ladder_checks.lost_published(@This(), io, held);
}

/// The single bit that stands for one phase of a record.
pub fn phase_bit(at: u32) u32 {
    // invariant: a record always fits inside the bits one word carries
    assert(max_queue_len <= 32);
    // invariant: a bit always names a phase inside the record's own bound
    assert(at < max_queue_len);
    const one: u32 = 1;
    return one << @intCast(at);
}

/// Publishes which of a plan's losses its author asked it to bear.
///
/// The loss note says where a plan fell short; this says which of those places
/// its author would rather leave standing. It is written in the same shape and
/// read the same way -- one glyph per phase, `b` where an arc was lost and its
/// author marked it borne -- so an operator reads the two notes side by side
/// and a repair seats from the record rather than from a supervisor's memory
/// of what the plan wanted.
pub fn bearing_note(io: std.Io, held: u32, borne_mask: u32) NoteError!void {
    // invariant: a bearing note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((borne_mask & phase_bit(at)) != 0) glyphs[at] = 'b';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".bearing", glyphs[0..held]);
}

/// Reads the published bearing back as the mask a repair spares.
///
/// A run that reads nothing here bears nothing, and says so with a zero rather
/// than by guessing -- which leaves the repair exactly where the rung below
/// left it, running every arc the plan lost.
pub fn bearing_published(io: std.Io, held: u32) u32 {
    return ladder_checks.bearing_published(@This(), io, held);
}

/// Publishes which of a plan's unmarked losses this run weighed as spent.
///
/// The bearing note above names what an author asked to carry; this names what
/// the run judged the plan had got past. One glyph per phase, `w` where an
/// unmarked loss was weighed spent, written while the run still holds the
/// evidence and read back before the repair seats anything -- since a
/// supervisor that appraised from memory would be applying a standard it
/// believes in rather than the one its plan published.
pub fn appraisal_note(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: an appraisal note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((weighed_mask & phase_bit(at)) != 0) glyphs[at] = 'w';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".appraisal", glyphs[0..held]);
}

/// Reads back which phases this run weighed as spent, straight off the wire.
pub fn appraisal_published(io: std.Io, held: u32) u32 {
    return ladder_checks.appraisal_published(@This(), io, held);
}

/// Seats a judgment on the wire as the record a run before this one left.
///
/// The appraisal is the one note a run does not clear, so a standing judgment
/// arrives the only way it ever could: written, and waiting. This names that
/// act plainly for a caller that means to stand a record up mid-history, and it
/// makes the directory first, since a judgment may be waiting before any run of
/// this plan has provisioned a thing.
pub fn seat_standing_appraisal(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: a seated judgment never names more phases than one record holds
    assert(held <= max_queue_len);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try appraisal_note(io, held, weighed_mask);
}

/// Publishes which standing judgments this run took back.
///
/// The appraisal note above names what a run judged the plan had got past; this
/// names which of those judgments a later run's own evidence declines to keep.
/// One glyph per phase, `r` where a standing judgment was recanted, written
/// while the run still holds the record that disproves it and read back before
/// the repair seats a single phase on its strength.
pub fn recant_note(io: std.Io, held: u32, taken_back_mask: u32) NoteError!void {
    // invariant: a recant note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((taken_back_mask & phase_bit(at)) != 0) glyphs[at] = 'r';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".recant", glyphs[0..held]);
}

/// Reads back which standing judgments this run took back, straight off the wire.
pub fn recant_published(io: std.Io, held: u32) u32 {
    return ladder_checks.recant_published(@This(), io, held);
}

/// Publishes the word an operator finally reads about this plan.
///
/// The verdict note below says whether work is still standing. This says what
/// that standing work means -- carried out, short, or whole but for a loss the
/// plan itself asked to carry. Written after the repair has had its turn, and
/// read back before the report believes it.
pub fn settlement_note(io: std.Io, settlement: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".settled", &[_]u8{settlement_byte(settlement)});
}

/// Reads a plan's published settlement back, or nothing where none was written.
pub fn settlement_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".settled") catch return null;
    return settlement_of_byte(byte);
}

/// Reads the word an operator was last told about this plan, or nothing at all.
///
/// The settlement note above is what the wire says now; this is what somebody
/// carried away. The two are the same word right up until a later run moves
/// one of them, and this rung exists for the moment they part.
pub fn reading_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".read") catch return null;
    return settlement_of_byte(byte);
}

/// Seats a reading on the wire as the word an operator carried away.
///
/// The reading is the second note a run does not clear, so a standing reading
/// arrives the only way it ever could: written, and waiting. This names that act
/// plainly for a caller that means to stand a reader up mid-history, and it
/// makes the directory first, since somebody may have read this plan before any
/// run of it has provisioned a thing.
pub fn seat_standing_reading(io: std.Io, reading: Settlement) NoteError!void {
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".read", &[_]u8{settlement_byte(reading)});
}

/// Publishes the correction addressed to whoever read the elder word.
///
/// The first note of this arc written to a **person** rather than about a phase,
/// so it is written about the plan whole rather than one glyph per phase: two
/// bytes, the reading superseded and the reading that supersedes it, so `bc`
/// reads *you were told the plan was borne; it is carried out whole*. Written
/// while the run still holds both words, and read back before the report
/// believes anybody was reached.
pub fn amend_note(io: std.Io, was: Settlement, now: Settlement) NoteError!void {
    // invariant: an amendment always names two readings that actually differ
    assert(was != now);
    try seat_note(io, plan_name, ".amend", &[_]u8{ settlement_byte(was), settlement_byte(now) });
}

/// Reads the published amendment back as the two readings it names.
///
/// A run that reads nothing here corrected nobody, and says so with a null
/// rather than by guessing -- which leaves a reader exactly where the rung below
/// leaves them, holding a word the plan no longer stands behind.
pub fn amend_published(io: std.Io) ?[2]Settlement {
    return ladder_checks.amend_published(@This(), io);
}

/// Records the disagreement between what this run stands behind and what its
/// reader answered.
///
/// The first note of this arc that writes a **reader's own word** into the
/// plan's record: two bytes, the reading this run carried and the reading their
/// hand named, so `cb` reads *the plan holds carried out whole; its reader holds
/// borne*. The pair is written and left there. A supervisor that went on to
/// settle the disagreement in its own favor would be recording a quarrel and
/// calling it a verdict.
pub fn dispute_note(io: std.Io, ours: Settlement, theirs: Settlement) NoteError!void {
    // invariant: a dispute always names two readings that actually differ
    assert(ours != theirs);
    try seat_note(io, plan_name, ".dispute", &[_]u8{ settlement_byte(ours), settlement_byte(theirs) });
}

/// Reads the recorded disagreement back as the two readings it names.
///
/// A run that reads nothing here recorded no disagreement, and says so with a
/// null rather than by guessing -- which leaves the record exactly where the
/// rung below leaves it, reading as one voice whatever its reader answered.
pub fn dispute_recorded(io: std.Io) ?[2]Settlement {
    return ladder_checks.dispute_recorded(@This(), io);
}

/// Stands the published word up beside the reading recorded against it.
///
/// One byte, written where the settlement is read rather than where the record
/// is kept: `plan.beside` holds the reader's own reading, so an operator opening
/// `plan.settled` finds the objection in the same reach. The plan's own word is
/// already there and stays exactly as it was written -- an escort adds a voice
/// beside a sentence rather than editing the sentence.
pub fn abide_note(io: std.Io, marked: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".beside", &[_]u8{settlement_byte(marked)});
}

/// Reads the mark standing beside the published word, or nothing at all.
///
/// A run that reads nothing here escorted nothing, and says so with a null
/// rather than by guessing -- which leaves the word exactly where the rung below
/// leaves it, reading alone however plainly its reader objected.
pub fn escort_written(io: std.Io) ?Settlement {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".beside") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a mark never outgrows the one reading it quotes
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Reads the address the standing reading was taken at, or nothing at all.
///
/// A reader who took a word away is somewhere, and the plan either wrote that
/// down or it did not. This answers which -- plainly, with a null where no
/// address stands, so a run never has to guess where a person is.
pub fn address_published(io: std.Io, out: *[max_address_len]u8) ?[]const u8 {
    return ladder_checks.address_published(@This(), io, out);
}

/// Seats the address a reader was reached at, beside the reading they took.
///
/// The reading and the address arrive together, since a word carried away and
/// the place it was carried to are one fact about one person. This names that
/// act plainly for a caller standing a reader up mid-history, and it makes the
/// directory first, since somebody may have read this plan before any run of it
/// has provisioned a thing.
pub fn seat_standing_address(io: std.Io, address: []const u8) NoteError!void {
    // invariant: a run only ever seats an address a correction could reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".at", address);
}

/// Writes the path of one reader's own box.
///
/// The one path this rung builds outside `note_dir`, and the shape of its whole
/// claim: a delivery lands where the reader is rather than where the record
/// lives. The address is bounded and checked before a byte of it reaches a path.
fn box_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.box_path(@This(), buf, address);
}

/// Carries one correction to the reader's own box, in the words they read.
///
/// The outward reach of the whole arc, and it is deliberately the same two
/// bytes the wire carries: the reading superseded and the reading that
/// supersedes it, so `bc` reads *you were told the plan was borne; it is
/// carried out whole* wherever a person finds it. The box is made here, since a
/// reader's address is a place this plan has never written to before.
pub fn deliver(io: std.Io, address: []const u8, was: Settlement, now: Settlement) NoteError!void {
    return ladder_checks.deliver(@This(), io, address, was, now);
}

/// Reads one reader's box back as the two readings it carries.
///
/// The hard half of this rung, read from the box rather than from the run's own
/// memory of writing to it. A run that reads nothing here delivered nothing,
/// and says so with a null rather than by believing its own report -- which is
/// the difference between a delivery and a claim about one.
pub fn delivered_to(io: std.Io, address: []const u8) ?[2]Settlement {
    return ladder_checks.delivered_to(@This(), io, address);
}

/// Clears one reader's box, so a lap begins with a reader who has been told
/// nothing at all.
///
/// A box outlives every run, exactly as a reader's own copy does, so a lap that
/// means to prove a delivery must start from a reader who is genuinely waiting.
pub fn empty_box(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = box_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the hand one reader answers with.
///
/// The reader's own box holds two files and they face opposite ways: `.told` is
/// what the plan carried to them, and `.said` is what they wrote back. A run
/// writes the first and only ever reads the second, which is the whole
/// difference between a delivery and an acknowledgement.
fn hand_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.hand_path(@This(), buf, address);
}

/// Reads one reader's own hand as the reading they say they now hold.
///
/// The only reach a run ever makes toward this file, and it is a read. A run
/// that finds nothing here has heard nothing, and says so with a null rather
/// than by believing its own delivery -- since a letter that arrived and a
/// reader who answered are two facts, and only the second one is about a
/// person.
pub fn answered_by(io: std.Io, address: []const u8) ?Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an answer never outgrows the one reading it names
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Answers as the reader themself, in the one byte they would write.
///
/// **No run ever calls this**, and that restraint is the rung. An
/// acknowledgement a supervisor could write for its reader acknowledges
/// nothing at all -- it is the plan agreeing with the plan. The hand belongs to
/// an operator, to a tool at their desk, or to a lap that means to stand a
/// reader up on the wire the way `seat_standing_reading` stands one up
/// mid-history; the supervisor's whole part is to read what it finds and to
/// report honestly when it finds nothing.
pub fn answer_as_reader(io: std.Io, address: []const u8, now_holds: Settlement) NoteError!void {
    // invariant: a hand is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try hand_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{settlement_byte(now_holds)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's hand, so a lap begins with a reader who has said
/// nothing at all.
///
/// A hand outlives every run, exactly as a reader's own copy does, so a lap
/// that means to prove a hearing must start from a reader whose word this run
/// genuinely finds rather than one an earlier run left lying there.
pub fn clear_hand(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the question one reader is asked again.
fn ask_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.ask_path(@This(), buf, address);
}

/// Writes the path of the second hand one reader may raise their objection with.
fn renew_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.renew_path(@This(), buf, address);
}

/// Puts the standing objection back to the reader who raised it.
///
/// Two bytes, written where that reader is rather than where the record is kept:
/// the plan's own word and the word this reader holds against it, exactly as the
/// record names them. A question that named only one of the two would be asking
/// somebody to remember which quarrel this was.
///
/// This is the act that earns the right to call a later silence silence. A term
/// without it is a clock nobody was shown.
pub fn ask_again(io: std.Io, address: []const u8, held: [2]Settlement) NoteError!void {
    // invariant: a question is only ever asked of an address a run may carry to
    assert(addressable(address));
    // invariant: a question always names two readings that actually differ
    assert(held[0] != held[1]);
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try ask_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{ settlement_byte(held[0]), settlement_byte(held[1]) };
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Reads back the question this reader was asked, or nothing at all.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// asked by reading the question out of the reader's own box, never by
/// remembering having written it. A supervisor that believed its own asking
/// could publish a lapse over a question that never left the building.
pub fn asked_of(io: std.Io, address: []const u8) ?[2]Settlement {
    return ladder_checks.asked_of(@This(), io, address);
}

/// Reads one reader's second hand as the objection they say they still hold.
///
/// The only reach a run ever makes toward this file, and it is a read. A run
/// that finds nothing here has been answered with silence, and says so with a
/// null rather than by assuming either way -- since a question that was asked
/// and an objection that still stands are two facts, and only the second one is
/// about a person's present mind.
pub fn renewed_by(io: std.Io, address: []const u8) ?Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = renew_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a renewal never outgrows the one objection it raises
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Raises the objection again as the reader themself, in the one byte they
/// would write.
///
/// **No run ever calls this**, and that restraint is the rung. A renewal a
/// supervisor could write for its reader renews nothing at all -- it is the plan
/// objecting to the plan, and then agreeing that the objection stands. Silence
/// belongs to the person who is silent; the supervisor's whole part is to ask
/// plainly, read what it finds, and report honestly when it finds nothing.
pub fn renew_as_reader(io: std.Io, address: []const u8, still_holds: Settlement) NoteError!void {
    // invariant: a renewal is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try renew_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{settlement_byte(still_holds)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's second hand, so a lap begins with a reader who has not
/// yet been asked to say whether they still object.
pub fn clear_renewal(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = renew_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Clears the question one reader was asked, so a lap begins unasked.
pub fn clear_question(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = ask_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes what became of the objection standing beside this plan's word.
///
/// One byte, written where the settlement and its escort are read rather than
/// where the correspondence lives: `plan.term` holds `r` for an objection its
/// reader raised again and `l` for one nobody renewed. The escort in
/// `plan.beside` stays exactly as it was written -- a term reports on an
/// objection rather than withdrawing it, and a run that erased the mark because
/// its reader went quiet would be winning the quarrel by outlasting them.
pub fn lapse_note(io: std.Io, life: Life) NoteError!void {
    try seat_note(io, plan_name, ".term", &[_]u8{life_byte(life)});
}

/// Reads the term standing on the published objection, or nothing at all.
///
/// A run that reads nothing here put no term on anything, and says so with a
/// null rather than by guessing -- which leaves the objection exactly where the
/// rung below leaves it, standing for as long as the record does.
pub fn term_written(io: std.Io) ?Life {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".term") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a term never outgrows the one life it names
    assert(got <= 1);
    if (got < 1) return null;
    return life_of_byte(bytes[0]);
}

/// Carries the term's own answer into the mark an operator actually opens.
///
/// Two bytes into `plan.beside`, where the rung below wrote one: the reading its
/// reader holds first, byte for byte as they earned it, and the standing of that
/// objection second. There is no second note to know about, which is the whole
/// point -- a reader who opens the file the objection lives in cannot read the
/// objection without also reading whether anybody is still behind it.
///
/// The mark's first byte is written again exactly as it read, so every elder
/// reader of that file still reads the mark it always read, and no run ever
/// takes an escort down. A repose reports on an objection rather than
/// withdrawing it.
pub fn repose_note(io: std.Io, marked: Settlement, stand: Stand) NoteError!void {
    try seat_note(io, plan_name, ".beside", &[_]u8{ settlement_byte(marked), stand_byte(stand) });
}

/// Reads the standing the mark carries, or nothing at all.
///
/// A run that reads nothing here left its mark exactly as the rung below wrote
/// it, and says so with a null rather than by guessing -- which leaves every
/// operator reading a live quarrel however long ago its reader let it go.
pub fn standing_written(io: std.Io) ?Stand {
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".beside") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a mark never outgrows the reading and the standing it names
    assert(got <= 2);
    if (got < 2) return null;
    return stand_of_byte(bytes[1]);
}

/// Writes the path of the answer one reader is owed about their own quarrel.
pub fn tell_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.tell_path(@This(), buf, address);
}

/// Tells the reader who raised a quarrel how it came out.
///
/// One byte, written where that reader is rather than where the record is kept:
/// `m` for a word their objection stood against that reads differently now, `t`
/// for one that reads exactly as it read. It lands beside the letter this arc
/// already carried them and the question it already asked them, in the same box,
/// so a reader who has heard from this plan twice hears from it a third time in
/// the place they already look.
///
/// Every note beneath this one is written where a word is read. This is the only
/// one written where the person who objected can find it.
pub fn tell_outcome(io: std.Io, address: []const u8, result: Result) NoteError!void {
    return ladder_checks.tell_outcome(@This(), io, address, result);
}

/// Reads back what this reader was told about their own quarrel, or nothing.
///
/// The wire before the memory, one tier further out again: a run learns that it
/// wrote back by reading the answer out of the reader's own box, never by
/// remembering having written it. A supervisor that believed its own telling
/// could report a raiser reached whose box was never opened.
pub fn told_of(io: std.Io, address: []const u8) ?Result {
    return ladder_checks.told_of(@This(), io, address);
}

/// Clears what one reader was told, so a lap begins with a reader who has heard
/// nothing about how their quarrel came out.
pub fn clear_tidings(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = tell_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}


/// Writes the path of the reply one reader may leave to the answer they were
/// given.
pub fn press_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.press_path(@This(), buf, address);
}

/// Reads what one reader says to the answer they were given, or nothing at all.
///
/// The one act of this rung that reaches into a reader's own box, and it only
/// ever reads. A run learns a person's position by opening what that person
/// wrote, never by remembering what it expected them to write.
pub fn pressed_by(io: std.Io, address: []const u8) ?Plea {
    return ladder_checks.pressed_by(@This(), io, address);
}

/// Seats one reader's reply, in that reader's own hand.
///
/// **No run ever calls this**, and that restraint is the rung. A plea a
/// supervisor could file for its reader settles nothing at all -- it is the plan
/// answering the plan, and then reading its own handwriting back as consent. The
/// supervisor's whole part is to send the outcome plainly, open the box, and
/// report honestly when it finds it empty.
pub fn press_as_reader(io: std.Io, address: []const u8, plea: Plea) NoteError!void {
    // invariant: a reply is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try press_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{plea_byte(plea)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's reply, so a lap begins with a reader who has said nothing
/// about how their quarrel came out.
pub fn clear_press(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = press_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Publishes where the reader who raised the quarrel stands once it is over.
///
/// One byte into `plan.appeal`, written where an operator opens the plan rather
/// than where the correspondence lives: `a` for an outcome its reader accepts
/// and `p` for a quarrel they press still. Every other note of this arc that an
/// operator reads carries the plan's own findings; this one carries a living
/// person's position, quoted rather than composed.
pub fn appeal_note(io: std.Io, plea: Plea) NoteError!void {
    try seat_note(io, plan_name, ".appeal", &[_]u8{plea_byte(plea)});
}

/// Reads the plea standing on this plan's own answer, or nothing at all.
///
/// A run that reads nothing here heard nobody, and says so with a null rather
/// than by guessing -- which leaves the record exactly where the rung below
/// leaves it, silent about whether anybody accepted a word of it.
pub fn appeal_published(io: std.Io) ?Plea {
    return ladder_checks.appeal_published(@This(), io);
}
// =========================================================================
// The supervisor -- a record that answers for the work its conferrals never
// bought
// =========================================================================

/// One dependent already reaped, held until the whole record has drained.
pub const Finished = struct {
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
    code: u8,
};

/// Folds one reaped outcome into the report, or names the mismatch.
pub fn judge_outcome(done: Finished, report_out: *Report) RunError!void {
    return ladder_checks.judge_outcome(@This(), done, report_out);
}

/// The queue's own bookkeeping for one run, over dependents whose conferrals
/// may leave with them.
pub const Table = struct {
    live: [max_in_flight]cohort.Running = undefined,
    lines: [max_in_flight]Task = undefined,
    reserves: [max_in_flight]?Task = @splat(null),
    taken: [max_in_flight]u32 = @splat(0),
    served: [max_in_flight]u32 = @splat(0),
    granted: [max_in_flight]u32 = @splat(0),
    absorbed_mask: [max_in_flight]u32 = @splat(0),
    in_flight: u32 = 0,
    done: [max_queue_len]Finished = undefined,
    finished: u32 = 0,
    started: [max_queue_len]bool = @splat(false),
    record: [max_queue_len]unhand.Phase = undefined,
    reserve_of: [max_queue_len]?Task = @splat(null),
    held: u32 = 0,
    head: u32 = 0,
    left: u32 = 0,
    lost_mask: u32 = 0,
    bear_mask: u32 = 0,
};

/// The record as it stands right now.
pub fn standing(table: *const Table) []const unhand.Phase {
    // invariant: a record never outgrows the queue one supervisor may hold
    assert(table.held <= max_queue_len);
    return table.record[0..table.held];
}

/// Answers whether one phase of the record is still work waiting to run.
fn waits(table: *const Table, at: u32) bool {
    return ladder_checks.waits(@This(), table, at);
}

/// Moves the head past every item already started.
pub fn advance_head(table: *Table) void {
    // invariant: a head never walks past the record it reads
    assert(table.head <= table.held);
    while (table.head < table.held and !waits(table, table.head)) table.head += 1;
}

/// Answers whether a phase of a turn this pick's turn names still waits.
pub fn elder_waits(table: *const Table, pick: u32) bool {
    return ladder_checks.elder_waits(@This(), table, pick);
}

/// Answers whether a sibling of this pick's own turn still waits behind it.
pub fn sibling_waits(table: *const Table, pick: u32, sibling_mask: u32) bool {
    return ladder_checks.sibling_waits(@This(), table, pick, sibling_mask);
}

/// Answers whether the door admits this phase over the lines remembered.
pub fn door_admits(sys: *const system.System, table: *const Table, at: u32) RunError!bool {
    return ladder_checks.door_admits(@This(), sys, table, at);
}

/// Answers whether a phase may be admitted ahead of the record's head.
fn may_pass(
    sys: *const system.System,
    table: *const Table,
    candidate: u32,
    reading: Reading,
) bool {
    return ladder_checks.may_pass(@This(), sys, table, candidate, reading);
}

/// Chooses one phase from behind a blocked head, or answers that none may go.
pub fn choose_pass(
    sys: *const system.System,
    table: *const Table,
    reading: Reading,
) RunError!?u32 {
    return ladder_checks.choose_pass(@This(), sys, table, reading);
}

/// Answers which standing dependent could carry this phase, if any could.
pub fn confer_slot(table: *const Table, at: u32) ?u32 {
    return ladder_checks.confer_slot(@This(), table, at);
}

/// Takes back the reach one standing dependent no longer needs, from the rung
/// below -- kept whole here, since a reclamation is what happens after it.
pub fn revoke_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    keep: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.revoke_one(@This(), io, table, slot, keep, report_out);
}

/// Takes one departed dependent's conferral back whole, so a successor of its
/// domain opens its eyes on a bare wire.
///
/// The rung below reaches into a standing dependent's hands; this one reaches
/// into the wire the two of them spoke over, once the dependent that listened
/// is gone. `slot` names the reaped dependent, whose row still stands in the
/// table until the reaping closes over it.
pub fn reclaim_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reclaim_one(@This(), io, table, slot, report_out);
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
pub fn confer_one(
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *Table,
    slot: u32,
    at: u32,
    keeping: Keep,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.confer_one(@This(), io, sys, caps, table, slot, at, keeping, report_out);
}

/// Starts one phase, handing the capability words this reach calls for and
/// promising the pruning this keep calls for.
pub fn start_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?Task,
    keeping: Keep,
    wake: gap.Wake,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    return ladder_checks.start_one(@This(), allocator, io, self_path, sys, caps, phase, reserve, keeping, wake, report_out);
}

/// Admits as much of the record as the table and the reading allow, and
/// answers how many phases it took up.
pub fn fill_table(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!u32 {
    return ladder_checks.fill_table(
        @This(), allocator, io, self_path, sys, caps, wake, reading, keeping, table, report_out,
    );
}

/// Records one departed dependent's abandoned reach, and reads the answer back.
///
/// The reclamation above has already swept this domain clean, so the count is
/// written after it rather than before -- otherwise the very act that closes
/// the conferral would erase the only evidence of what it cost. The answer is
/// read back from the wire before the report believes it.
pub fn abandon_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    came_home: bool,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.abandon_one(@This(), io, table, slot, came_home, report_out);
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
pub fn reap_oldest(
    io: std.Io,
    table: *Table,
    answer: Answer,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError)!void {
    return ladder_checks.reap_oldest(@This(), io, table, answer, report_out);
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
pub fn seat_the_ground(
    io: std.Io,
    sys: *const system.System,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError)!capabilities.CapabilityTable {
    return ladder_checks.seat_the_ground(@This(), io, sys, report_out);
}

/// Reads a written plan into the table's own record, closed and seated.
///
/// The plan is flattened to the shape the rungs below read, weighed for order
/// and for the names it keeps, closed over its own turns, and its reserves
/// carried across -- all before a single dependent is spawned, so the record a
/// run enforces is the record its author wrote.
pub fn seat_the_record(base: []const Phase, table: *Table) RunError!void {
    return ladder_checks.seat_the_record(@This(), base, table);
}

/// Runs a record on the chosen mark, answering for abandoned work as the chosen
/// answer says.
///
/// The supervisor every rung of this arc keeps -- fill the table, reap the
/// eldest, judge at the end -- with each later act folded in behind the one
/// below it, so a plan repairs what it lost, settles, corrects the reader that
/// settlement replaced, carries the correction to them, reads what that reader
/// answered back, records the disagreement, stands its own published word up
/// beside it, asks the reader who raised that objection whether they still hold
/// it, and finally carries that answer into the mark an operator opens.
pub fn run_in_appeal(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    bearing: Bearing,
    standard: Standard,
    review: Review,
    notice: Notice,
    dispatch: Dispatch,
    receipt: Receipt,
    record: Standing,
    escort: Escort,
    term: Term,
    mark: Mark,
    tidings: Tidings,
    appeal: Appeal,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError || RunError || cohort.RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always reports into a fresh report
    assert(run_of(report_out).admitted == 0);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len > max_queue_len) return error.QueueFull;

    var table: Table = .{};
    try seat_the_record(base, &table);

    const caps = try seat_the_ground(io, sys, report_out);
    run_of(report_out).queued = table.held;

    while (table.left > 0 or table.in_flight > 0) {
        const took_up = try fill_table(
            allocator, io, self_path, sys, &caps, wake, reading, keeping, &table, report_out,
        );
        if (table.in_flight > run_of(report_out).peak_in_flight) {
            run_of(report_out).peak_in_flight = table.in_flight;
        }

        if (table.left > 0) {
            const free = max_in_flight - table.in_flight;
            run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) run_of(report_out).idle_turns += 1;
        }

        // With an empty table nothing conflicts, so a stall here would mean
        // the record named a domain the document does not.
        if (table.in_flight == 0) return error.OrderStalled;

        try reap_oldest(io, &table, .answered, report_out);
    }
    // invariant: the whole record was taken up, and every dependent reaped
    assert(table.left == 0);
    assert(table.in_flight == 0);
    assert(run_of(report_out).reaped == run_of(report_out).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(table.finished + abandoning_of(report_out).inner.inner.inner.inner.absorbed == table.held);

    var j: u32 = 0;
    while (j < table.finished) : (j += 1) try judge_outcome(table.done[j], report_out);
    // invariant: every reaped dependent was judged, none skipped
    assert(j == table.finished);

    // The reckoning stands exactly as the rung below wrote it, and always on
    // the reckoning ledger: a mend that repaired a plan under the assuming
    // reading would be repairing a loss it had already declared did not count.
    // What this rung adds to it is the recantation, weighed against the
    // judgment already standing on the wire before this run touches it.
    try reckon_the_plan(io, &table, .reckoned, review, report_out);

    // Every run here mends, since the question this rung asks opens inside the
    // repair rather than before it: what separates the two readings is which
    // of the plan's losses the repair is allowed to touch.
    try mend_the_plan(
        allocator, io, self_path, sys, &caps, base, wake, keeping, bearing, standard, review, &table, report_out,
    );

    // The correction the rung below writes, unchanged and still last of the
    // record's own work: a reader is owed the word the run actually ended on
    // rather than the word it held halfway through.
    try post_the_amendment(io, notice, report_out);

    // The journey the rung below makes, unchanged: a correction with somewhere
    // to go is carried to the place its reader was actually reached.
    try carry_the_amendment(io, dispatch, report_out);

    // The hearing the rung below makes, with one word changed: an answer counts
    // as heard only where the hand actually agrees, since an answer a plan
    // cannot accept is not an answer it heard.
    try hear_the_reader(io, receipt, report_out);

    // The record the rung below keeps, unchanged: a reader who answered in a
    // word this plan cannot accept is written down in both voices.
    try record_the_dispute(io, receipt, record, report_out);

    // The escort the rung below writes, unchanged: an operator reading this
    // plan's word reads the objection standing against it in the same reach.
    try escort_the_word(io, escort, report_out);

    // The term the rung below weighs, unchanged: the objection standing beside
    // this plan's word is put back to the reader who raised it, and answered or
    // let go.
    try weigh_the_term(io, term, report_out);

    // The standing the rung below carries into the mark, unchanged: an operator
    // opening the objection reads whether anybody is still behind it.
    try stand_the_mark(io, mark, report_out);

    // The tidings the rung below writes, unchanged: the reader who raised the
    // quarrel is told how it came out, in the box they already know.
    try tell_the_reader(io, tidings, report_out);

    // The appeal, and the whole of what this rung adds. It runs last of all,
    // because there is nothing for a reader to answer until they have been
    // answered, and this is the first note of the arc that travels inward.
    try read_the_appeal(io, appeal, report_out);
}

/// Reads what the reader says to the answer this plan just gave them.
///
/// The wire before the memory, one tier further out than the telling below it:
/// this run reads the address out of the note that names it, reads its own
/// tiding out of that reader's box to learn anybody was told at all, opens the
/// reply the reader left in their own hand, publishes it where an operator opens
/// the plan, and reads that note back before the report believes a word of it. A
/// plan that published a position from memory of having read one would be
/// telling every future operator where a living person stands on the strength of
/// its own expectation.
///
/// A run that told nobody has nobody to read, and a reader who wrote nothing has
/// left nothing to read; both are silences no appeal can fill, and each says so
/// by weighing nothing rather than by composing a plea. A reader who answered
/// how their quarrel came out and whom no run ever read is the number this rung
/// moves.
pub fn read_the_appeal(io: std.Io, appeal: Appeal, report_out: *Report) (RunError || NoteError)!void {
    var address_buf: [max_address_len]u8 = undefined;
    const address = address_published(io, &address_buf) orelse {
        // invariant: a run with nobody to read leaves no reader unread
        assert(report_out.unread == 0);
        return;
    };
    const told: u32 = if (told_of(io, address) == null) 0 else 1;
    if (told == 0) {
        // invariant: a run that told nobody leaves no reader unread
        assert(report_out.unread == 0);
        return;
    }
    const wrote = pressed_by(io, address);
    const replied = wrote != null;

    // The measurement this rung moves, weighed against what the reader's own box
    // actually carries rather than against what any plan asked for, so an answer
    // left sitting unread is counted rather than refused.
    report_out.unread = answer_unread(told, replied, appeal);
    const heard_count = appeal_heard_in(told, replied, appeal);
    const unheard_count = appeal_unheard_in(told, replied, appeal);
    if (appeal == .closed) {
        // invariant: a closed run reads nobody, however plainly they wrote
        assert(heard_count == 0);
        report_out.unheard_back = unheard_count;
        return;
    }
    if (!replied) {
        // A reader who said nothing has nothing to publish, and the wire says so
        // by leaving the record exactly as it reads.
        //
        // invariant: an unanswered telling is never published as a position
        assert(heard_count == 0);
        report_out.unheard_back = unheard_count;
        return;
    }
    // The supply, refused by name while the reply it read is still in hand: a
    // run publishes a position only where the reader actually wrote one.
    if (unvoiced_appeal(if (replied) 1 else 0, heard_count)) |why| return why;
    if (appeal_refusal(told, heard_count, unheard_count)) |why| return why;
    // invariant: a run that reached the appeal refuses nothing it must read
    assert(heard_count == 1);
    const plea = wrote orelse return error.AppealUnvoiced;
    try appeal_note(io, plea);
    // The wire before the memory, once more: the position is read back out of
    // the plan's own note, and only then does the report believe it.
    const standing_plea = appeal_published(io) orelse return error.AppealMisrecorded;
    // The record half of this rung: an operator reads where a living person
    // stands, so it must be where they actually stand.
    if (!quotes_plea(standing_plea, plea)) return error.AppealMisrecorded;
    report_out.heard_back = heard_count;
    report_out.unheard_back = unheard_count;
    // invariant: an open run leaves no answered reader unread
    assert(report_out.unread == 0);
}

/// Tells the reader who raised the quarrel how it came out.
///
/// The wire before the memory, one tier further out than the standing below it:
/// this run reads the quarrel out of the record that keeps it, reads the term
/// out of the note that decided it, reads the word it finally settled out of the
/// note an operator opens, reads the address out of the note that names it,
/// writes the result into that reader's own box, and reads the box back before
/// the report believes anybody was told. A plan that reported a raiser reached
/// from memory of having written to them would be counting a letter it never
/// sent.
///
/// A run holding no quarrel has nobody to write to, a quarrel nobody decided has
/// no outcome to carry, and a reader who left no address cannot be reached at
/// all; each is a silence no tiding can fill, and each says so by weighing
/// nothing rather than by inventing a correspondent. A quarrel weighed whose
/// raiser was never told how it came out is the number this rung moves.
pub fn tell_the_reader(io: std.Io, tidings: Tidings, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.tell_the_reader(@This(), io, tidings, report_out);
}

/// Carries the term's own answer into the mark an operator actually opens.
///
/// The wire before the memory, one tier further out than the term below it:
/// this run reads its own mark out of the note an operator would open, reads
/// the term out of the note that decided it, writes both into that same mark,
/// and reads the mark back before the report believes a word of it. A plan that
/// reported a standing from memory of having weighed one would be telling every
/// future reader something its own wire never carried.
///
/// A run that escorted nothing has no mark to speak for, and an objection nobody
/// asked about has no standing to carry; both are silences no standing can fill,
/// and each says so by weighing nothing rather than by inventing a finding. A
/// mark that names an objection and never says whether anybody still holds it --
/// read live by every operator, however long ago the quarrel was let go -- is the
/// number this rung moves.
pub fn stand_the_mark(io: std.Io, mark: Mark, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.stand_the_mark(@This(), io, mark, report_out);
}

/// Asks the reader who raised the standing objection whether they still hold it,
/// and publishes what they answered.
///
/// The wire before the memory, one tier further out than the escort below it:
/// this run reads its own mark out of the note an operator would open, reads the
/// disagreement out of the note that keeps it, writes the question into the
/// reader's own box, reads that question back out of the box, and only then
/// reads the reader's second hand. A plan that published a lapse from memory of
/// having asked would be calling a silence an answer to a question that never
/// left the building.
///
/// A run that escorted nothing bounds nothing, and a record holding no quarrel
/// has nothing to put a term on; both are silences no term can fill, and each
/// says so by weighing nothing rather than by inventing a correspondent. An
/// objection published beside a word with no term on it at all -- standing on
/// every future reader, unasked -- is the number this rung moves.
pub fn weigh_the_term(io: std.Io, term: Term, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.weigh_the_term(@This(), io, term, report_out);
}

/// Reads back what the reader answered, and says whether the plan ever
/// listened.
///
/// The wire before the memory, one tier further out than every rung below:
/// this run reads the letter it carried out of the reader's own box, and then
/// reads that same reader's hand out of the box beside it. Neither reach
/// touches what the supervisor remembers doing, because a plan that heard its
/// reader agree from its own memory has agreed with itself.
///
/// A run that carried nothing owes nobody a hearing, and says so by weighing
/// nothing rather than by inventing a correspondent. A reader who wrote back
/// where the plan never listened is the number this rung moves; a reader who
/// never wrote at all is a silence no run can close, counted nowhere and
/// refused only where a run claims to have heard it.
pub fn hear_the_reader(io: std.Io, receipt: Receipt, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.hear_the_reader(@This(), io, receipt, report_out);
}

/// Records the disagreement its reader answered with, or sets that answer aside.
///
/// The wire before the memory, one tier further out than the hearing below it:
/// this run reads the letter out of the reader's own box, reads that reader's
/// own hand beside it, and writes the pair into its own record without ever
/// touching what the supervisor remembers doing. A plan that recorded its
/// reader's objection from its own memory of the correspondence would be
/// putting words in a person's mouth.
///
/// A run that carried nothing owes nobody a record, and says so by weighing
/// nothing rather than by inventing a quarrel. A reader who agreed is left
/// exactly as the rung below leaves them, agreed with and undisputed. Only a
/// reader who answered in a word this plan cannot accept is written down -- and
/// under `.settled` even that one is set aside, which is where the rung below
/// leaves every reader and precisely the number this rung moves.
pub fn record_the_dispute(
    io: std.Io,
    receipt: Receipt,
    record: Standing,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.record_the_dispute(@This(), io, receipt, record, report_out);
}

/// Stands the word this run published up beside the reading recorded against it.
///
/// The wire before the memory, one tier further out than the record below it:
/// this run reads its own published settlement out of the note an operator would
/// open, reads the disagreement out of the note that keeps it, and writes the
/// mark from those two rather than from anything the supervisor remembers doing.
/// A plan that escorted its word from memory of a quarrel would be quoting a
/// reader it never read.
///
/// A run that published nothing marks nothing, and a record holding no quarrel
/// has nothing to quote; both are silences no mark can fill, and each says so by
/// weighing nothing rather than by inventing an objector. A word published over
/// a disagreement that stands recorded, read by an operator who finds no sign of
/// it, is the number this rung moves.
pub fn escort_the_word(io: std.Io, escort: Escort, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.escort_the_word(@This(), io, escort, report_out);
}

/// Answers the reader of a settlement this run has since replaced.
///
/// The wire before the memory, twice over: the word this run finally published
/// and the word an operator carried away are both read back here, outside the
/// folds that produced either, exactly as a person would read them. A supervisor
/// that corrected a reader from its own memory of the outcome would be writing a
/// second word nobody can check.
///
/// A plan nobody read owes nobody a correction, and says so by weighing nothing
/// rather than by inventing an audience. A reading this run still stands behind
/// is confirmed and left exactly where it is. Only a reading the settlement
/// contradicts is answered -- and under `.silent` even that one is left standing,
/// which is where the rung below leaves every reader and precisely the number
/// this rung moves.
pub fn post_the_amendment(io: std.Io, notice: Notice, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.post_the_amendment(@This(), io, notice, report_out);
}

/// Carries the correction this run posted to the place its reader was reached.
///
/// The wire before the memory, once more and one tier further out: the
/// correction this run published and the address its reader left are both read
/// back here, outside the fold that wrote either, exactly as the person each
/// was written for would read a letter and its envelope before setting out.
///
/// A run that posted no correction carries nothing, and says so by weighing
/// nothing rather than by inventing an errand. A reader who left no address
/// cannot be reached, and the run refuses by name rather than choosing a
/// destination on their behalf. Only a posted correction with somewhere to go
/// travels -- and under `.waiting` even that one stays where it was written,
/// which is where the rung below leaves every reader who does not come back,
/// and precisely the number this rung moves.
pub fn carry_the_amendment(io: std.Io, dispatch: Dispatch, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.carry_the_amendment(@This(), io, dispatch, report_out);
}

/// Runs the arcs a plan lost that nobody spared, and answers for what is left
/// standing after.
///
/// The mend reads its own run's verdict back from the wire before it decides
/// anything, because a supervisor that repairs from memory is repairing a plan
/// it believes in rather than the one it published. A plan the wire calls
/// `carried` is refused outright -- there is nothing here to repair, and a
/// mend that ran anyway would re-do work already served.
///
/// **What this rung adds is the recantation, read from the same wire.** The
/// appraisal note names which losses a judgment spared -- and under `.stand`
/// that judgment may be older than this run, since the note is the one a run
/// never clears. The recant note names which of those judgments this run's own
/// record disproves. Under `.stand` the mend spares every appraised loss,
/// exactly as the rung below does. Under `.revisit` the recanted ones come back
/// into the repair, and the settlement moves with them -- from `borne`, which
/// tells an operator there is nothing left to do, to `carried`, which is true.
pub fn mend_the_plan(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    base: []const Phase,
    wake: gap.Wake,
    keeping: Keep,
    bearing: Bearing,
    standard: Standard,
    review: Review,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!void {
    return ladder_checks.mend_the_plan(
        @This(), allocator, io, self_path, sys, caps, base, wake, keeping, bearing, standard, review, table, report_out,
    );
}

/// Publishes what the plan came to and what that means, and reads both back.
///
/// The verdict below answers whether work is still standing; the settlement
/// answers what an operator should do about it. Both go to the wire and both
/// are read back before the report believes either, since a supervisor that
/// trusts its own memory of what it published has published nothing.
pub fn settle_the_plan(
    io: std.Io,
    lost: u32,
    served_again: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.settle_the_plan(@This(), io, lost, served_again, report_out);
}

/// Weighs what the plan came to, publishes the verdict and the loss, and reads
/// the verdict back.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. A plan that absorbed no phase into a
/// standing dependent is carried by the shape of its own record, and this rung
/// leaves it exactly there rather than inventing a judgment it cannot make.
///
/// What this rung adds to the one below is the **recantation beside the
/// appraisal**. The judgment already on the wire is read here, before anything
/// this run learned is written over it, and weighed against the judgment this
/// run's own record supports. Whichever way the plan asks its history to be
/// read, that reading is published while the run still holds the evidence for
/// it, and read back before the repair spares or seats a single phase.
pub fn reckon_the_plan(
    io: std.Io,
    table: *const Table,
    ledger: Ledger,
    review: Review,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reckon_the_plan(@This(), io, table, ledger, review, report_out);
}

// =========================================================================
// The dependent -- a walk that reads the wire before it trusts its own hands
// =========================================================================

/// Reads the capability words a dependent was handed at its spawn into its slot.
pub fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    return ladder_checks.slot_from_argv(@This(), args, domain, cap_count);
}

/// Answers whether this dependent already holds a capability over one region.
pub fn already_holds(slot: *const capabilities.DependentSlot, region_name: []const u8) bool {
    return ladder_checks.already_holds(slot, region_name);
}

/// Names the word at one depth of a list, or answers that the list is shorter.
pub fn word_at(words: *const Words, index: u32) ?[]const u8 {
    return ladder_checks.word_at(@This(), words, index);
}

/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    base: *const capabilities.DependentSlot,
    words: *const Words,
    keep: u32,
) ?capabilities.DependentSlot {
    return ladder_checks.prune_to(@This(), base, words, keep);
}

/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const Words,
    from: u32,
    to: u32,
) u32 {
    return ladder_checks.reachable_between(@This(), io, slot, words, from, to);
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of this rung, made by the party that would be lying if it were
/// wrong -- and made without touching the hands the dependent actually works
/// with. The words standing for this domain are grafted into a *copy* of those
/// hands, and each arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
pub fn inherited_at_first_breath(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    return ladder_checks.inherited_at_first_breath(@This(), io, base, domain);
}

/// One dependent's own line, read arc by arc against the count it was handed.
pub fn read_own_line(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    task: cycle.Task,
) ?u8 {
    return ladder_checks.read_own_line(@This(), io, slot, task);
}

/// Grafts every conferred word as it arrives, reads each arc, and answers for
/// what it holds.
///
/// Answers the count grafted, or an outcome code where a word or an arc did
/// not stand. The dependent answers `.held` only after reading every arc it
/// grafted, which is what lets the supervisor read that answer as work served.
pub fn graft_promised_reach(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *Words,
    carried_out: *u32,
) ?u8 {
    return ladder_checks.graft_promised_reach(@This(), io, slot, domain, task, promised, granted, carried_out);
}

/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const Words,
    carried: u32,
) ?u32 {
    return ladder_checks.return_promised_reach(@This(), io, base, slot, domain, granted, carried);
}

/// Reads the arcs this dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
pub fn stand_taking_and_returning_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    return ladder_checks.stand_taking_and_returning_reach(@This(), io, base, slot, domain, task, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
pub fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    return ladder_checks.run_dependent(@This(), io, args);
}

// =========================================================================
// The lap -- one plan run twice against a reader who never comes back, once
// leaving the correction on the wire and once carrying it to them
// =========================================================================

/// The lap this rung runs, and the word read alone is the whole of it.
///
/// Three clients stand over three arcs and carry a reserve of one, and the
/// phase behind each asks that same client to peek exactly the reserved arc --
/// so the run confers `menu` to a dependent already standing, three times.
/// Every author declares that their dependent falls, so each grafts the word,
/// answers for it, and falls holding it: three conferrals, three arcs nobody
/// served. None is marked, so the bearing has nothing to say about any of them.
///
/// The wire meets this plan already carrying a judgment -- `client_b`'s lost
/// peek, weighed spent by a run that is over -- and this run's own evidence
/// says otherwise, since the phase that would have spoken for that loss falls
/// holding its conferral. So both runs of this lap weigh the judgment again,
/// take it back, repair all three arcs, and settle the plan `carried`.
///
/// **And the wire meets this plan already carrying a reader who left an
/// address.** An operator read the elder run's settlement, carried away one
/// word -- `borne`, which says there is nothing left to do -- and left `desk` as
/// the place they could be found. Both runs post the correction in that
/// operator's own words, carry it to their box, read the hand they answer with,
/// and write the disagreement into the record in both voices. The rung below is
/// fully satisfied by either.
///
/// **What parts them is where that disagreement can be read.** Left alone, it
/// rests in `plan.dispute` among the plan's own notes, while the settlement an
/// operator opens reads exactly as it would have read had nobody objected.
/// Escorted, one byte lands in `plan.beside` -- the reader's own reading,
/// standing where the word is read -- so the same reach that finds the outcome
/// finds the objection.
///
/// **The price is one byte.** Both runs spend the same six dependents, repair
/// the same three arcs, post and carry the same correction, read the same
/// answer, record the same disagreement, and settle the same word. What parts
/// them is whether anybody reading that word ever learns of it.
pub const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_b", .verb = .stand, .hops = "board,ask_b,taken_b", .peers = "serial_virt,client_b", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_a", .verb = .stand, .hops = "board,ask_a,taken_a", .peers = "serial_virt,client_a", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 4, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_c", .verb = .stand, .hops = "board,ask_c,taken_c", .peers = "serial_virt,client_c", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 5, .step = 0, .follows = 0, .follows_turns = 2, .task = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

/// The judgment the wire already carries when this lap begins.
///
/// `client_b`'s lost peek, weighed spent by a run that is over. It is seated as
/// the record it is rather than produced by a first run of this plan, because
/// what a run does with a judgment it did not make is the whole subject here --
/// and because a judgment arrives on the wire exactly this way whether the run
/// that wrote it finished a minute ago or a season ago.
const standing_judgment: u32 = 1 << 1;

/// The word an operator already carried away when this lap begins.
///
/// `borne` -- whole but for a loss the plan itself asked to carry, which tells a
/// reader there is nothing left to do. It is exactly what the rung below's
/// standing review published, and it is seated as the record it is rather than
/// produced by a first run of this plan, because what a run owes a reader it
/// did not write to is the whole subject here -- and because a reading arrives
/// on the wire exactly this way whether the person who took it read a minute ago
/// or a season ago.
const standing_reading: Settlement = .borne;

/// The place the reader who took that word can be found.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading is: an address arrives on the wire beside a reading
/// whether the person who left it read a minute ago or a season ago. `desk`
/// names a place outside this plan's own wire, which is the entire distance
/// this rung exists to close.
const standing_address = "desk";

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    return ladder_checks.load_one(io, path, buf);
}

/// The mend below, read straight, so this rung's own fold stands on a repair
/// that still refuses everything it always refused.
pub fn check_mending() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_mending();
}

/// The bearing and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a bearing is
/// weighed, the work it weighs, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `BearOverrepaired`, belongs
/// to the run rather than the fold, since only the wire can answer what a plan
/// published about its own obedience.
pub fn check_bearing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_bearing();
}

/// The recantation and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a standing
/// judgment is weighed again, the supply it may reach, and the honesty of its
/// count answered as a pure fold -- the closed record, the loss, the judgment on
/// the wire, and the judgment this run supports are the whole of the input, and
/// no process appears anywhere. The fourth refusal, `RecantUnspoken`, belongs to
/// the run rather than the fold, since only the wire can answer what a run
/// published about its own reversal.
pub fn check_recantation() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_recantation();
}

/// The amendment and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a reading is
/// answered, the supply it may reach, and the honesty of its count answered as a
/// pure fold -- the word an operator holds and the word this run settled are the
/// whole of the input, and no process appears anywhere. The fourth refusal,
/// `AmendUnspoken`, belongs to the run rather than the fold, since only the wire
/// can answer whether a correction actually reached the place it was read.
pub fn check_amendment() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_amendment();
}

/// The delivery and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a correction is
/// carried, the address it may be carried to, and the honesty of its count
/// answered as a pure fold -- no process anywhere. The fourth refusal,
/// `CourierUndelivered`, belongs to the run rather than the fold, since only a
/// reader's own box can answer whether anything actually arrived in it.
pub fn check_delivery() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_delivery();
}


/// The reading the reader answers with, in their own hand.
///
/// `short` -- a word neither this run's correction nor their own elder reading
/// names. The operator was told `borne`, this run carried them `carried`, and
/// they answered that they hold the plan **short**: whole work was left undone.
/// That is a reader disagreeing plainly, in their own vocabulary, about the one
/// thing the correspondence was ever about.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading and the address are: a hand arrives in a reader's box
/// whether that person answered a minute ago or a season ago, and **no run of
/// this plan ever writes it**. A supervisor that wrote its reader's answer for
/// them would be agreeing with itself.
const standing_hand: Settlement = .short;

/// The hearing below, still weighed, and now under the stricter question this
/// rung hands it.
///
/// Every rung of this arc keeps weighing the rungs beneath it, so a change that
/// quietly stopped one of them moving is caught in the same breath as the new
/// work. What this fold reads is the rung below's own count with `agreed` in
/// place of `answered`: an agreeing hand closes the correspondence, and a
/// disagreeing one leaves the hearing exactly where it stood.
pub fn check_hearing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_hearing();
}

/// The record and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a run records,
/// the hand it records for, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `DisputeUnfounded`, is
/// answered here too, since whether two readings differ is a question two words
/// can settle between themselves.
pub fn check_dispute() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_dispute();
}

/// The escort and its four refusals, read straight, before any dependent runs.
///
/// The happy zone of this rung: every question about the moment a word is
/// marked, the record it is marked from, the honesty of the count, and whether
/// the mark quotes its reader truly, answered as a pure fold -- no process
/// anywhere.
pub fn check_abide() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_abide();
}

/// The term and its four refusals, read straight, before any dependent runs.
///
/// The happy zone of this rung: every question about the moment a term is
/// weighed, whether anybody was asked before a silence was called silence, the
/// honesty of the count, and whether a renewal renews the objection actually
/// standing, answered as a pure fold -- no process anywhere.
pub fn check_lapse() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_lapse();
}

/// Weighs this rung's own folds, before any dependent runs.
pub fn check_standing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_standing();
}

/// Runs one queue whole under one standing, against a judgment, a reading, an
/// address, and a reader's own hand all four already standing, and says whether
/// it survived.
///
/// All four are seated before the run rather than after, since each is a record
/// a run does not clear and a run must find them exactly where the hand that
/// wrote them left them. The reader's box is emptied of the plan's own letter
/// first, so a lap that means to prove a delivery starts from a reader who is
/// genuinely waiting -- and the reader's answer is seated **by this harness
/// standing in for them**, never by the supervisor, since a plan that writes
/// its own objection has quarrelled with itself. Every run of this lap revisits
/// the judgment, posts the correction, carries it, and listens; what the two
/// runs disagree about is whether the mark itself ever says what came of it.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    tidings: Tidings,
    appeal: Appeal,
    renews_it: bool,
    presses_it: ?Plea,
    report_out: *Report,
) bool {
    seat_standing_appraisal(io, @intCast(plan.len), standing_judgment) catch |err| {
        print("  RED: a judgment could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_reading(io, standing_reading) catch |err| {
        print("  RED: a reading could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_address(io, standing_address) catch |err| {
        print("  RED: an address could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    empty_box(io, standing_address);
    // The reader's own hand, written by the reader rather than by any run.
    answer_as_reader(io, standing_address, standing_hand) catch |err| {
        print("  RED: a reader could not answer in their own hand: {s}\n", .{@errorName(err)});
        return false;
    };
    // The question and the second hand both start clean, so a lap that means to
    // prove an asking starts from a reader nobody has asked yet, and a lap that
    // means to read a silence reads this run's silence rather than an earlier
    // run's leavings.
    clear_question(io, standing_address);
    clear_renewal(io, standing_address);
    // What this reader was told last time goes with them, so a lap that means to
    // prove a writing-back starts from a raiser who has heard nothing at all.
    clear_tidings(io, standing_address);
    // And whatever this reader last said about how it came out goes with them,
    // so a lap that means to prove a reading-back starts from a reader who has
    // answered nothing at all.
    clear_press(io, standing_address);
    if (presses_it) |plea| {
        // The reader's own reply to the answer they were given, written by the
        // reader rather than by any run of this plan.
        press_as_reader(io, standing_address, plea) catch |err| {
            print("  RED: a reader could not reply in their own hand: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    if (renews_it) {
        // The reader raising their own objection again, in their own hand, and
        // never by any run of this plan.
        renew_as_reader(io, standing_address, standing_hand) catch |err| {
            print("  RED: a reader could not raise their objection again: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    run_in_appeal(
        allocator, io, self_path, sys, plan, .when_moved, .preceded, .held_on, .borne, .weighed, .revisit, .posted, .carried, .asked, .open, .escorted, .bounded, .standing, tidings, appeal, report_out,
    ) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Tells what the two marks did, side by side, in an operator's own words.
fn tell_appeal_runs(closed_run: *Report, open_run: *Report) void {
    // invariant: a telling always reads two runs that were actually run
    assert(run_of(closed_run).queued >= 1);
    // invariant: a telling never reports more dependents than a repair may add
    assert(run_of(open_run).reaped <= run_of(open_run).queued + max_queue_len);
    print("  phases: {d} closed, {d} open\n", .{
        run_of(closed_run).queued, run_of(open_run).queued,
    });
    print("  dependents: {d} closed, {d} open\n", .{
        run_of(closed_run).reaped, run_of(open_run).reaped,
    });
    print("  phases absorbed into a standing dependent: {d} closed, {d} open\n", .{
        abandoning_of(closed_run).inner.inner.inner.inner.absorbed,
        abandoning_of(open_run).inner.inner.inner.inner.absorbed,
    });
    print("  abandoned reach, conferred and never served: {d} closed, {d} open\n", .{
        abandoning_of(closed_run).abandoned, abandoning_of(open_run).abandoned,
    });
    print("  phases re-seated to carry what was lost: {d} closed, {d} open\n", .{
        below_of(closed_run).reseated, below_of(open_run).reseated,
    });
    print("  standing judgments taken back on this run's own evidence: {d} closed, {d} open\n", .{
        recanting_of(closed_run).recanted, recanting_of(open_run).recanted,
    });
    print("  readings corrected where they were read: {d} closed, {d} open\n", .{
        amending_of(closed_run).amended, amending_of(open_run).amended,
    });
    print("  corrections carried to the place their reader was reached: {d} closed, {d} open\n", .{
        couriering_of(closed_run).delivered, couriering_of(open_run).delivered,
    });
    print("  disagreements written into the record: {d} closed, {d} open\n", .{
        disputing_of(closed_run).recorded, disputing_of(open_run).recorded,
    });
    print("  published words standing beside the reading against them: {d} closed, {d} open\n", .{
        abiding_of(closed_run).escorted, abiding_of(open_run).escorted,
    });
    print("  standing objections put back to the reader who raised them: {d} closed, {d} open\n", .{
        lapsing_of(closed_run).asked, lapsing_of(open_run).asked,
    });
    print("  objections nobody renewed, let go rather than resolved: {d} closed, {d} open\n", .{
        lapsing_of(closed_run).lapsed, lapsing_of(open_run).lapsed,
    });
    print("  marks carrying the standing of the objection they quote: {d} closed, {d} open\n", .{
        reposing_of(closed_run).stood, reposing_of(open_run).stood,
    });
    print("  raisers told how their own quarrel came out: {d} closed, {d} open\n", .{
        tidings_of(closed_run).told, tidings_of(open_run).told,
    });
    print("  raisers left exactly as the rung below leaves them: {d} closed, {d} open\n", .{
        tidings_of(closed_run).untold, tidings_of(open_run).untold,
    });
    print("  objections weighed whose raiser was never told how it came out: {d} closed, {d} open\n", .{
        tidings_of(closed_run).unreturned, tidings_of(open_run).unreturned,
    });
    tell_appeal_half(closed_run, open_run);
}

/// Tells what the two runs did about the reply itself, in an operator's own
/// words.
///
/// The seam is this rung's own: everything above belongs to the rungs beneath
/// it and stands still under both plans, and everything here is the reading
/// back the two plans actually disagree about.
fn tell_appeal_half(closed_run: *Report, open_run: *Report) void {
    // invariant: a telling never reads more replies than a wire may carry
    assert(closed_run.heard_back <= 1);
    // invariant: a telling never leaves more readers unread than a wire may carry
    assert(open_run.unread <= 1);
    print("  readers whose reply to the answer was read back: {d} closed, {d} open\n", .{
        closed_run.heard_back, open_run.heard_back,
    });
    print("  readers left exactly as the rung below leaves them: {d} closed, {d} open\n", .{
        closed_run.unheard_back, open_run.unheard_back,
    });
    print("  readers who answered how their quarrel came out and were never read: {d} against {d}\n", .{
        closed_run.unread, open_run.unread,
    });
    print("  work still standing when the supervisor exits: {d} closed, {d} open\n", .{
        below_of(closed_run).unserved, below_of(open_run).unserved,
    });
    print("  the plan, as an operator finally reads it: {s} closed, {s} open\n", .{
        settlement_words(bearing_of(closed_run).settlement), settlement_words(bearing_of(open_run).settlement),
    });
    print("  breaks a named turn: {d} closed, {d} open\n", .{
        preceded_of(closed_run).out_of_precede, preceded_of(open_run).out_of_precede,
    });
}

/// Weighs the two marks against each other and names the first disagreement.
///
/// The shape of the finding is one number moving and the price of moving it
/// named honestly beside it -- and here the price is one byte appended to a note
/// the run had already written. Both runs take up the same record, confer the
/// same arcs, lose the same arcs, take the same judgment back, repair the same
/// three phases, spend the same dependents, post the same correction, carry it
/// to the same reader, read that reader's own answer, record the same
/// disagreement, escort the same published word, ask the same reader whether
/// they still object, read the same silence, and settle the plan `carried`. What
/// differs is whether the mark an operator opens ever learns what that asking
/// came to.
fn judge_appeal_runs(closed_run: *Report, open_run: *Report) u8 {
    // invariant: a judging always reads two runs that were actually run
    assert(run_of(closed_run).queued >= 1);
    // invariant: a judging never counts a repair the plan never lost
    assert(below_of(open_run).reseated <= max_queue_len);
    if (run_of(open_run).queued != run_of(closed_run).queued) {
        print("  RED: the two marks ran {d} phases against {d}\n", .{
            run_of(open_run).queued, run_of(closed_run).queued,
        });
        return 1;
    }
    if (abandoning_of(open_run).abandoned != abandoning_of(closed_run).abandoned) {
        print("  RED: the two marks lost {d} arcs against {d}\n", .{
            abandoning_of(open_run).abandoned, abandoning_of(closed_run).abandoned,
        });
        return 1;
    }
    if (abandoning_of(open_run).abandoned < 3) {
        print("  RED: the lap lost {d} arcs, and this rung needs three beneath it\n", .{
            abandoning_of(open_run).abandoned,
        });
        return 1;
    }
    // Every rung below still moves under both marks, since a standing carries a
    // finding rather than making one.
    if (recanting_of(closed_run).recanted != 1 or recanting_of(open_run).recanted != 1) {
        print("  RED: a revisiting run took back {d} judgments against {d}\n", .{
            recanting_of(closed_run).recanted, recanting_of(open_run).recanted,
        });
        return 1;
    }
    if (amending_of(closed_run).amended != 1 or amending_of(open_run).amended != 1) {
        print("  RED: a posting run corrected {d} readings against {d}\n", .{
            amending_of(closed_run).amended, amending_of(open_run).amended,
        });
        return 1;
    }
    if (couriering_of(closed_run).delivered != 1 or couriering_of(open_run).delivered != 1) {
        print("  RED: a carrying run delivered {d} corrections against {d}\n", .{
            couriering_of(closed_run).delivered, couriering_of(open_run).delivered,
        });
        return 1;
    }
    if (disputing_of(closed_run).recorded != 1 or disputing_of(open_run).recorded != 1) {
        print("  RED: an open record held {d} disagreements against {d}\n", .{
            disputing_of(closed_run).recorded, disputing_of(open_run).recorded,
        });
        return 1;
    }
    if (abiding_of(closed_run).escorted != 1 or abiding_of(open_run).escorted != 1) {
        print("  RED: an escorting run marked {d} words against {d}\n", .{
            abiding_of(closed_run).escorted, abiding_of(open_run).escorted,
        });
        return 1;
    }
    // The term below, which both runs weigh: what parts them stands one tier
    // further out, at the note an operator actually opens.
    if (lapsing_of(closed_run).asked != 1 or lapsing_of(open_run).asked != 1) {
        print("  RED: a bounded run asked about {d} objections against {d}\n", .{
            lapsing_of(closed_run).asked, lapsing_of(open_run).asked,
        });
        return 1;
    }
    if (lapsing_of(closed_run).lapsed != 1 or lapsing_of(open_run).lapsed != 1) {
        print("  RED: a reader's silence let go of {d} objections against {d}\n", .{
            lapsing_of(closed_run).lapsed, lapsing_of(open_run).lapsed,
        });
        return 1;
    }
    if (below_of(closed_run).reseated != below_of(open_run).reseated) {
        print("  RED: the two marks repaired {d} phases against {d}\n", .{
            below_of(closed_run).reseated, below_of(open_run).reseated,
        });
        return 1;
    }
    if (below_of(closed_run).unserved != 0 or below_of(open_run).unserved != 0) {
        print("  RED: a run that repaired every disproved loss left work standing\n", .{});
        return 1;
    }
    if (bearing_of(closed_run).settlement != .carried or bearing_of(open_run).settlement != .carried) {
        print("  RED: a plan whose every lost arc was served settled {s}\n", .{
            settlement_words(bearing_of(open_run).settlement),
        });
        return 1;
    }
    // The standing below, which both runs carry into the mark: what parts them
    // stands one tier further out again, in the box of the person who objected.
    if (reposing_of(closed_run).stood != 1 or reposing_of(open_run).stood != 1) {
        print("  RED: a standing run spoke for {d} marks against {d}\n", .{
            reposing_of(closed_run).stood, reposing_of(open_run).stood,
        });
        return 1;
    }
    if (reposing_of(closed_run).unstanding != 0 or reposing_of(open_run).unstanding != 0) {
        print("  RED: a standing run left {d} marks an operator cannot read against {d}\n", .{
            reposing_of(closed_run).unstanding, reposing_of(open_run).unstanding,
        });
        return 1;
    }
    // The tidings below, which both runs now write: what parts them stands one
    // tier further out, in the reply the reader writes back.
    if (tidings_of(closed_run).told != 1 or tidings_of(open_run).told != 1) {
        print("  RED: the two runs wrote to {d} raisers against {d}\n", .{
            tidings_of(closed_run).told, tidings_of(open_run).told,
        });
        return 1;
    }
    if (tidings_of(closed_run).untold != 0 or tidings_of(open_run).untold != 0) {
        print("  RED: the two runs left {d} raisers untold against {d}\n", .{
            tidings_of(closed_run).untold, tidings_of(open_run).untold,
        });
        return 1;
    }
    // The number below, which both runs now move: what parts them stands one
    // tier further out, in the reply the reader wrote back.
    if (tidings_of(closed_run).unreturned != 0 or tidings_of(open_run).unreturned != 0) {
        print("  RED: a returning run still left {d} raisers never written to against {d}\n", .{
            tidings_of(closed_run).unreturned, tidings_of(open_run).unreturned,
        });
        return 1;
    }
    // The appeal itself, and the two halves it closes on.
    if (closed_run.heard_back != 0) {
        print("  RED: a closed run read {d} replies all the same\n", .{closed_run.heard_back});
        return 1;
    }
    if (open_run.heard_back != 1) {
        print("  RED: an open run read {d} replies rather than the one\n", .{
            open_run.heard_back,
        });
        return 1;
    }
    if (closed_run.unheard_back != 1) {
        print("  RED: a closed run left {d} readers exactly as it found them\n", .{
            closed_run.unheard_back,
        });
        return 1;
    }
    if (open_run.unheard_back != 0) {
        print("  RED: an open run still left {d} readers unheard\n", .{open_run.unheard_back});
        return 1;
    }
    // The number this rung moves.
    if (closed_run.unread != 1) {
        print("  RED: a reader answering into silence counted as {d}\n", .{closed_run.unread});
        return 1;
    }
    if (open_run.unread != 0) {
        print("  RED: an open run still left {d} readers answering into silence\n", .{
            open_run.unread,
        });
        return 1;
    }
    // The price of listening once more after the last dependent is home, named
    // rather than hidden: no work at all, and one byte into a note an operator
    // already opens.
    if (run_of(open_run).reaped != run_of(closed_run).reaped) {
        print("  RED: standing a mark cost {d} dependents against {d}\n", .{
            run_of(open_run).reaped, run_of(closed_run).reaped,
        });
        return 1;
    }
    if (preceded_of(open_run).out_of_precede != 0) {
        print("  RED: the standing run broke {d} turn orders its author named\n", .{
            preceded_of(open_run).out_of_precede,
        });
        return 1;
    }
    return 0;
}

/// Weighs this rung's own folds, before any dependent runs.
///
/// The happy zone of this rung: every question about who a run owes a word to,
/// what that word says, and the honesty of the count answered as a pure fold --
/// no process anywhere.
pub fn check_tidings() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return tidings_rung.check_tidings();
}


/// Weighs this rung's own folds, before any dependent runs.
///
/// The happy zone of this rung: every question about who a run listens to, what
/// a reader's word means, and the honesty of the count answered as a pure fold
/// -- no process anywhere.
pub fn check_appeal() u8 {
    // The count, which every later number closes on.
    if (appeal_heard_in(1, true, .open) != 1) {
        print("  RED: a reader who answered went unread\n", .{});
        return 1;
    }
    if (appeal_heard_in(1, true, .closed) != 0) {
        print("  RED: a closed run read a reply all the same\n", .{});
        return 1;
    }
    if (appeal_heard_in(1, false, .open) != 0) {
        print("  RED: a reader who said nothing was read anyway\n", .{});
        return 1;
    }
    if (appeal_heard_in(0, true, .open) != 0) {
        print("  RED: a run that told nobody read somebody\n", .{});
        return 1;
    }
    if (appeal_unheard_in(1, true, .closed) != 1) {
        print("  RED: a reader answering into silence counted as heard\n", .{});
        return 1;
    }
    if (appeal_unheard_in(1, true, .open) != 0) {
        print("  RED: a reader who was read still counted as unheard\n", .{});
        return 1;
    }
    if (appeal_unheard_in(0, true, .closed) != 0) {
        print("  RED: a run that told nobody left a reader unheard\n", .{});
        return 1;
    }

    // The plea survives the round trip through the byte it rides as.
    if (plea_of_byte(plea_byte(.accepts)) != .accepts) {
        print("  RED: an accepted outcome did not survive the wire it rides\n", .{});
        return 1;
    }
    if (plea_of_byte(plea_byte(.presses)) != .presses) {
        print("  RED: a pressed quarrel did not survive the wire it rides\n", .{});
        return 1;
    }
    if (plea_of_byte(0) != null) {
        print("  RED: a cleared box read as a reply\n", .{});
        return 1;
    }

    // The record half, read straight rather than inferred from a count.
    if (!quotes_plea(.presses, .presses)) {
        print("  RED: a quoted plea was read as somebody else's\n", .{});
        return 1;
    }
    if (quotes_plea(.accepts, .presses)) {
        print("  RED: a reader still pressing was published as content\n", .{});
        return 1;
    }

    // The moment: a run reading a plea where nothing was ever sent is hearing a
    // reply to a letter it never wrote.
    if (appeal_refusal(0, 1, 0)) |why| {
        if (why != error.AppealEarly) {
            print("  RED: an early appeal refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run read a reply to a letter it never sent\n", .{});
        return 1;
    }

    // The honesty of the count, from both sides.
    if (appeal_refusal(1, 1, 1)) |why| {
        if (why != error.AppealMiscounted) {
            print("  RED: a reader counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reader heard and left unheard at once went uncounted\n", .{});
        return 1;
    }
    if (appeal_refusal(1, 0, 0)) |why| {
        if (why != error.AppealMiscounted) {
            print("  RED: a reader counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reader neither heard nor left unheard went uncounted\n", .{});
        return 1;
    }
    if (appeal_refusal(1, 1, 0)) |why| {
        print("  RED: an appeal inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }

    // The hard half as its own refusal: a position nobody ever wrote.
    if (unvoiced_appeal(0, 1)) |why| {
        if (why != error.AppealUnvoiced) {
            print("  RED: an unvoiced appeal refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run filed a plea its reader never wrote\n", .{});
        return 1;
    }
    if (unvoiced_appeal(1, 1)) |why| {
        print("  RED: a voiced appeal refused with {s}\n", .{@errorName(why)});
        return 1;
    }

    // The number this rung moves, as a fold.
    if (answer_unread(1, true, .closed) != 1) {
        print("  RED: a reader answering into silence went uncounted\n", .{});
        return 1;
    }
    if (answer_unread(1, true, .open) != 0) {
        print("  RED: a reader who was read still counted as answering into silence\n", .{});
        return 1;
    }
    if (answer_unread(0, true, .closed) != 0) {
        print("  RED: a run that told nobody owed somebody a reading\n", .{});
        return 1;
    }
    if (answer_unread(1, false, .closed) != 0) {
        print("  RED: a reader who said nothing was owed a reading\n", .{});
        return 1;
    }

    print("  a plan publishes whether it reads what its reader says back\n", .{});
    print("  three refusals stand by name: early, unvoiced, miscounted\n", .{});
    print("  the appeal this rung keeps: {s}\n", .{appeal_words(.open)});
    print("  what a reader still pressing reads as: {s}\n", .{plea_words(.presses)});
    return 0;
}


/// The appeal lap: one plan run twice over a reader who answered the outcome it
/// sent them, once leaving that answer sitting unread in their own box and once
/// reading it back and publishing where they stand.
pub fn check_appeal_runs(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
) u8 {
    var closed_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .returned, .closed, false, .presses, &closed_run)) return 1;
    // What an operator reads is what the wire carries, read here outside the run
    // that wrote it.
    const bare_said = settlement_published(io) orelse {
        print("  RED: a run published no settlement at all\n", .{});
        return 1;
    };
    if (bare_said != .carried) {
        print("  RED: the wire read {s} where every lost arc was served\n", .{
            settlement_words(bare_said),
        });
        return 1;
    }
    // The escort and the term below both stand under either mark: the reader
    // objected, the plan wrote both readings down, the mark stands where the
    // settlement reads, and the question went back to the reader who raised it.
    const bare_mark = escort_written(io) orelse {
        print("  RED: an escorting run left its published word standing alone\n", .{});
        return 1;
    };
    const bare_pair = dispute_recorded(io) orelse {
        print("  RED: an open record kept no disagreement at all\n", .{});
        return 1;
    };
    if (!quotes(bare_mark, bare_pair)) {
        print("  RED: the mark named a reading its reader never held\n", .{});
        return 1;
    }
    const bare_life = term_written(io) orelse {
        print("  RED: a bounded run published no term an operator could read\n", .{});
        return 1;
    };
    if (bare_life != .lapsed) {
        print("  RED: a reader who wrote nothing had their objection read as {s}\n", .{
            life_words(bare_life),
        });
        return 1;
    }
    // The standing below stands under either run, since a tiding carries a
    // finding rather than making one.
    if (standing_written(io) == null) {
        print("  RED: a run left its mark saying nothing about the quarrel\n", .{});
        return 1;
    }
    // The tidings below stands under either run, since an appeal reads a
    // telling rather than making one: this reader was answered.
    if (told_of(io, standing_address) == null) {
        print("  RED: a run left its raiser never told at all\n", .{});
        return 1;
    }
    // The whole harm this rung repairs, read straight off the wire: the reader
    // was answered, they wrote back in their own hand, their reply is sitting in
    // their own box, and the record an operator opens says nothing about it.
    if (pressed_by(io, standing_address) == null) {
        print("  RED: the reader this lap depends on replied nothing at all\n", .{});
        return 1;
    }
    if (appeal_published(io) != null) {
        print("  RED: a closed run published a plea all the same\n", .{});
        return 1;
    }

    var open_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .returned, .open, false, .presses, &open_run)) return 1;
    const standing_said = settlement_published(io) orelse {
        print("  RED: a standing run published no settlement at all\n", .{});
        return 1;
    };
    if (standing_said != .carried) {
        print("  RED: the wire read {s} where every lost arc was served\n", .{
            settlement_words(standing_said),
        });
        return 1;
    }
    // The standing this rung exists to carry, read outside the run that wrote
    // it, in the one note the objection itself lives in.
    const stood = standing_written(io) orelse {
        print("  RED: a standing run left its mark saying nothing about the quarrel\n", .{});
        return 1;
    };
    const standing_life = term_written(io) orelse {
        print("  RED: a standing run published no term an operator could read\n", .{});
        return 1;
    };
    if (!agrees(stood, standing_life)) {
        print("  RED: the mark read {s} where the term read {s}\n", .{
            stand_words(stood), life_words(standing_life),
        });
        return 1;
    }
    if (stood != .quiet) {
        print("  RED: an objection nobody renewed read as {s}\n", .{stand_words(stood)});
        return 1;
    }
    // The mark its reader earned, untouched beneath it: a repose reports on an
    // objection rather than withdrawing it, and a run that erased the mark
    // because the quarrel went quiet would be winning it by outlasting them.
    const standing_mark = escort_written(io) orelse {
        print("  RED: a standing run withdrew the mark its reader earned\n", .{});
        return 1;
    };
    if (standing_mark != bare_mark) {
        print("  RED: a standing run rewrote the objection it reported on\n", .{});
        return 1;
    }
    if (settlement_published(io) != .carried) {
        print("  RED: a standing run rewrote the word the objection stands beside\n", .{});
        return 1;
    }
    // The reader's first hand still stands in their own box, in their own word:
    // a run quotes an answer and never edits one.
    const standing_hand_read = answered_by(io, standing_address) orelse {
        print("  RED: a standing run emptied the hand it read\n", .{});
        return 1;
    };
    if (standing_hand_read != standing_hand) {
        print("  RED: a standing run rewrote its reader's own answer\n", .{});
        return 1;
    }
    // And the second hand is still the reader's to write: this run wrote none.
    if (renewed_by(io, standing_address) != null) {
        print("  RED: a run raised its reader's objection for them\n", .{});
        return 1;
    }

    // The tidings this rung exists to carry, read outside the run that wrote it,
    // in the one place the person who objected would ever look -- their own box.
    const reached = told_of(io, standing_address) orelse {
        print("  RED: a returning run told its raiser nothing at all\n", .{});
        return 1;
    };
    if (!tells_true(reached, bare_pair[0], standing_said)) {
        print("  RED: the box read {s} where the wire settled {s}\n", .{
            result_words(reached), settlement_words(standing_said),
        });
        return 1;
    }
    if (reached != .stood) {
        print("  RED: a word that never moved was reported as {s}\n", .{result_words(reached)});
        return 1;
    }

    // The appeal this rung exists to read, taken outside the run that published
    // it: the reader's own reply, and the record an operator opens beside it.
    const wrote_back = pressed_by(io, standing_address) orelse {
        print("  RED: an open run emptied the reply it read\n", .{});
        return 1;
    };
    const published_plea = appeal_published(io) orelse {
        print("  RED: an open run published no plea an operator could read\n", .{});
        return 1;
    };
    if (!quotes_plea(published_plea, wrote_back)) {
        print("  RED: the record read {s} where the reader wrote {s}\n", .{
            plea_words(published_plea), plea_words(wrote_back),
        });
        return 1;
    }
    if (published_plea != .presses) {
        print("  RED: a reader still pressing their quarrel was published as {s}\n", .{
            plea_words(published_plea),
        });
        return 1;
    }

    tell_appeal_runs(&closed_run, &open_run);
    const judged = judge_appeal_runs(&closed_run, &open_run);
    if (judged != 0) return judged;

    // The other answer the same question admits, proven on the same wire rather
    // than only as a fold: a reader who does raise their objection again has the
    // mark itself say so, and the reading they hold stands exactly as before.
    var pressing_run: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .returned, .open, true, .accepts, &pressing_run)) return 1;
    if (reposing_of(&pressing_run).stood != 1 or reposing_of(&pressing_run).unstanding != 0) {
        print("  RED: a renewing run left {d} marks an operator cannot read\n", .{
            reposing_of(&pressing_run).unstanding,
        });
        return 1;
    }
    const raised_stand = standing_written(io) orelse {
        print("  RED: a renewing run left its mark saying nothing about the quarrel\n", .{});
        return 1;
    };
    if (raised_stand != .held) {
        print("  RED: a reader who raised their objection again had it read as {s}\n", .{
            stand_words(raised_stand),
        });
        return 1;
    }
    if (escort_written(io) != bare_mark) {
        print("  RED: a renewing run rewrote the reading its reader holds\n", .{});
        return 1;
    }
    print("  a reader who raises their objection again has the mark say so: {s}\n", .{
        stand_words(raised_stand),
    });
    // The other plea the same question admits, proven on the same wire rather
    // than only as a fold: a reader content with how their quarrel came out has
    // the record say so, in their own word.
    const accepting = appeal_published(io) orelse {
        print("  RED: an accepting reader had no plea published at all\n", .{});
        return 1;
    };
    if (accepting != .accepts or pressing_run.heard_back != 1 or pressing_run.unread != 0) {
        print("  RED: a reader who accepts the outcome was published as {s}\n", .{
            plea_words(accepting),
        });
        return 1;
    }
    print("  a reader content with the outcome has the record say so: {s}\n", .{
        plea_words(accepting),
    });

    // invariant: a run reaps exactly the dependents it admitted, never more
    assert(run_of(&open_run).reaped == run_of(&open_run).admitted);
    // invariant: a run never hears from more readers than a wire may carry
    assert(open_run.heard_back <= 1);
    // invariant: an open run leaves no answered reader unread
    assert(open_run.unread == 0);
    return 0;
}

pub fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan appeal {s} -- self-test\n", .{caravan_appeal_version});
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const mending = check_mending();
    if (mending != 0) return mending;
    const bearing = check_bearing();
    if (bearing != 0) return bearing;
    const recanting = check_recantation();
    if (recanting != 0) return recanting;
    const amending = check_amendment();
    if (amending != 0) return amending;
    const delivering = check_delivery();
    if (delivering != 0) return delivering;
    const hearing = check_hearing();
    if (hearing != 0) return hearing;
    const unlost = ladder_checks.check_unlost(@This(), &sys);
    if (unlost != 0) return unlost;
    const disputing = check_dispute();
    if (disputing != 0) return disputing;
    const abiding = check_abide();
    if (abiding != 0) return abiding;
    const lapsing = check_lapse();
    if (lapsing != 0) return lapsing;
    const reposing = check_standing();
    if (reposing != 0) return reposing;
    const tiding = check_tidings();
    if (tiding != 0) return tiding;
    const wired = ladder_checks.check_tidings_wire(@This(), io);
    if (wired != 0) return wired;
    const appealing = check_appeal();
    if (appealing != 0) return appealing;
    const pleaded = ladder_checks.check_appeal_wire(@This(), io);
    if (pleaded != 0) return pleaded;
    const runs = check_appeal_runs(allocator, io, self_path, &sys);
    if (runs != 0) return runs;
    print("  GREEN: a run reads what the reader says to the answer it sent\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    return ladder_checks.run_main(@This(), init);
}
