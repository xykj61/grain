pub fn settlement_byte(s: Settlement) u8 {
    return reposing_rung.settlement_byte(s);
}

/// Reads one settlement back from the byte it rode as, or nothing at all.
pub fn settlement_of_byte(byte: u8) ?Settlement {
    return reposing_rung.settlement_of_byte(byte);
}

/// Answers why one bearing may not be weighed, or that it may.
pub fn bear_refusal(published: ?Verdict, lost: u32, borne: u32, repairing: u32) ?RunError {
    return reposing_rung.bear_refusal(published, lost, borne, repairing);
}

