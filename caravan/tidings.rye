//! Caravan tidings -- the reader who raised a quarrel is told how it came out,
//! rather than left to find out for themselves.
//!
//! `repose.rye` taught a mark to carry the standing of the objection it quotes:
//! one byte appended to the escort, so an operator opening the objection reads
//! whether anybody is still behind it. That finding is exactly right, and it
//! lands exactly where every other finding of this arc lands -- at the place a
//! word is read.
//!
//! **Nothing has ever gone back to the person who raised the quarrel.** The
//! record keeps their disagreement, the escort stands their objection beside the
//! word, the term puts the question back to them, and the mark publishes what
//! became of it. Every one of those notes is written where an operator reads.
//! The reader who objected is written to once, early, with a correction -- and
//! then hears nothing again, however the season turns out.
//!
//! **The measurement is objections weighed whose raiser was never told how it
//! came out.** The rung below weighs what a finding ever reached at the mark.
//! This one weighs what the whole arc ever reached at the person it began with:
//! a quarrel decided in its raiser's absence, which is a season of work done on
//! somebody's behalf and never reported to them.
//!
//! **A tiding is written where the reader is, in the box they already know.**
//! The act is one byte into that reader's own `.outof`, beside the letter this
//! arc already carried them and the question it already asked them: `m` for a
//! word their objection stood against that reads differently now, `t` for one
//! that reads exactly as it read. A reader who has heard from this plan twice
//! hears from it a third time in the place they already look.
//!
//! **A tiding reports, and never argues.** It never grades the objection and
//! never says who was right. It reads the word the reader stood against and the
//! word the plan finally settled, and says whether they are the same -- which is
//! the one thing a person who objected to a word actually asked.
//!
//! **A plan publishes whether it writes back at all.** A record written
//! `tidings = .returned` says: whoever raised a quarrel here learns what came of
//! it. `tidings = .silent` is where the rung below leaves it -- every finding
//! filed, none of it delivered to the one person who asked. The word sits at the
//! plan beside the mark, since it instructs about who a record reaches rather
//! than about any one phase.
//!
//! **The rung earns four refusals, and each is about the writing back rather
//! than the quarrel it reports on.** `TidingsEarly` is the moment: a run writing
//! to a raiser it never heard from is answering a letter that never arrived.
//! `TidingsUnweighed` is the hard half -- a run that tells somebody how a
//! quarrel came out where nothing ever came of it has invented a season's work
//! on their behalf. `TidingsMiscounted` is the honesty of the count: every
//! quarrel this run holds is told or left untold, never both and never neither.
//! `TidingsMisread` is the record -- an answer that disagrees with the two words
//! the wire itself carries sends a reader away believing the wrong season.
//!
//! **A plan the wire holds no quarrel about reads as the rung below.** With no
//! disagreement recorded, nobody is written to, no standing is published, no
//! amendment is posted, nothing is carried, nothing is heard, nothing is
//! escorted, nothing is asked, each line stands at the width it was handed, and
//! the door answers `unhand.admissible_held` pair for pair -- this arc's
//! standing generalization test, one tier further out.
//!
//! Usage:
//!   tidings            Run the self-test (default)
//!   tidings selftest   Same as default
//!   tidings dependent ...  Run as one supervised dependent (spawned by the run)

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
const queue_store = @import("queue.rye");
const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const bearing_rung = @import("bear.rye");
const couriering_rung = @import("courier.rye");
const hearing_rung = @import("hear.rye");
const disputing_rung = @import("dispute.rye");
const abiding_rung = @import("abide.rye");
const lapsing_rung = @import("lapse.rye");
const reposing_rung = @import("repose.rye");
const amending_rung = @import("amend.rye");
const recanting_rung = @import("recant.rye");
const appraising_rung = @import("appraise.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");
const ladder_checks = @import("ladder_checks.rye");

const Dir = std.Io.Dir;

const caravan_tidings_version = "20260820.071202";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = reposing_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = reposing_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = reposing_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = reposing_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = reposing_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = reposing_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.tidings";

/// Where a reader's own box lives, outside this plan's wire entirely.
///
/// The whole point of the rung, written as a path. Every note of this arc so
/// far has landed under `note_dir`, where a reader must come looking; a
/// delivery lands here instead, so the first outward reach of the arc is
/// visible as a record leaving the place records are kept.
pub const reader_dir = "caravan/.readers";

/// The longest address a reader may leave, in bytes.
///
/// Bounded like every other word this wire carries: an address is a short
/// name for a place a person is, never a path a run could be talked into
/// walking somewhere unintended.
pub const max_address_len: u32 = 16;

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = reposing_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = reposing_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = reposing_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = reposing_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = reposing_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = reposing_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = reposing_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the lapsing notes
    assert(!std.mem.eql(u8, note_dir, reposing_rung.note_dir));
    // invariant: this rung's notes never collide with the abiding notes
    assert(!std.mem.eql(u8, note_dir, abiding_rung.note_dir));
    // invariant: this rung's notes never collide with the disputing notes
    assert(!std.mem.eql(u8, note_dir, disputing_rung.note_dir));
    // invariant: this rung's notes never collide with the hearing notes
    assert(!std.mem.eql(u8, note_dir, hearing_rung.note_dir));
    // invariant: this rung's notes never collide with the recanting notes
    assert(!std.mem.eql(u8, note_dir, recanting_rung.note_dir));
    // invariant: a delivery always leaves the place this plan keeps its records
    assert(!std.mem.eql(u8, note_dir, reader_dir));
    // invariant: a reader's box path leaves room for the address it is named by
    assert(max_note_path_len > reader_dir.len + max_address_len);
    // invariant: this rung's notes never collide with the appraising notes
    assert(!std.mem.eql(u8, note_dir, appraising_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return reposing_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, correct the
/// reader of a word it has since replaced, carry that correction to them, hear
/// what that reader answered back, record a disagreement it cannot resolve,
/// stand a word up beside that disagreement, put a term on how long the
/// disagreement may stand, or carry that term into the mark itself.
///
/// Four names of this rung's own, and each is about the writing back rather
/// than the quarrel it reports on: the moment a run writes to a raiser, whether
/// anybody ever weighed the quarrel it reports, the honesty of the count, and
/// whether the result agrees with the two words the wire itself carries.
pub const RunError = reposing_rung.RunError || error{
    TidingsEarly,
    TidingsUnweighed,
    TidingsMiscounted,
    TidingsMisread,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = reposing_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = reposing_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) reposing_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return reposing_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = reposing_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = reposing_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = reposing_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = reposing_rung.Verdict;

/// Renders one verdict as the words an operator reads.
pub fn verdict_words(v: Verdict) []const u8 {
    return reposing_rung.verdict_words(v);
}

/// The one byte a verdict rides as, so an operator's note is a single glyph.
pub fn verdict_byte(v: Verdict) u8 {
    return reposing_rung.verdict_byte(v);
}

/// Reads one verdict back from the byte it rode as, or nothing at all.
pub fn verdict_of_byte(byte: u8) ?Verdict {
    return reposing_rung.verdict_of_byte(byte);
}

/// Answers why one reckoning may not be taken, or that it may.
pub fn reckon_refusal(absorbed: u32, in_flight: u32, lost: u32) ?RunError {
    return reposing_rung.reckon_refusal(absorbed, in_flight, lost);
}

/// Counts the completion a run claimed that its own work does not support.
pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return reposing_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = reposing_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return reposing_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return reposing_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the tidings its quarrels earn.
///
/// `unreturned` is the number this rung moves: objections weighed whose raiser
/// was never told how it came out, because every finding of this arc travels to
/// the place a word is read and none of it travels back to the person who
/// raised the quarrel. `told` is what this rung writes instead -- one byte into
/// that reader's own box, naming whether the word they objected to reads
/// differently now or reads exactly as it read. `untold` is the other half of
/// the same count, and the two close on the objections this run held exactly.
pub const Report = struct {
    inner: reposing_rung.Report = .{},
    told: u32 = 0,
    untold: u32 = 0,
    unreturned: u32 = 0,
};

/// The lapsing rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
fn reposing_of(report_out: *Report) *reposing_rung.Report {
    return &report_out.inner;
}

/// The lapsing rung's tally, one tier further down.
fn lapsing_of(report_out: *Report) *lapsing_rung.Report {
    return &report_out.inner.inner;
}

/// The abiding rung's tally, one tier further down.
fn abiding_of(report_out: *Report) *abiding_rung.Report {
    return &report_out.inner.inner.inner;
}

/// The disputing rung's tally, one tier further down.
fn disputing_of(report_out: *Report) *disputing_rung.Report {
    return &report_out.inner.inner.inner.inner;
}

/// The hearing rung's tally, one tier further down.
fn hearing_of(report_out: *Report) *hearing_rung.Report {
    return &report_out.inner.inner.inner.inner.inner;
}

/// The couriering rung's tally, one tier further down.
fn couriering_of(report_out: *Report) *couriering_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner;
}

/// The amending rung's tally, two tiers further down.
fn amending_of(report_out: *Report) *amending_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner;
}

/// The recanting rung's tally, three tiers further down.
pub fn recanting_of(report_out: *Report) *recanting_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The appraising rung's tally, four tiers further down.
pub fn appraising_of(report_out: *Report) *appraising_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The bearing rung's tally, five tiers further down.
pub fn bearing_of(report_out: *Report) *bearing_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The mending rung's tally, six tiers further down.
pub fn below_of(report_out: *Report) *mending_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The abandoning rung's tally, nine tiers further down.
pub fn abandoning_of(report_out: *Report) *abandon_rung.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The run's own tally, reached without spelling the whole nesting each time.
pub fn run_of(report_out: *Report) *overtake.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.run;
}

/// The sibling-order counters, reached the same way.
pub fn masked_of(report_out: *Report) *mask.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

/// The turn-order counters, reached the same way.
pub fn preceded_of(report_out: *Report) *precede.Report {
    return &report_out.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner;
}

