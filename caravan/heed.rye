/// Refuses a standing published for an objection nobody ever weighed.
pub fn unweighed_stand(weighed: u32, stood_count: u32) ?RunError {
    return endure_rung.unweighed_stand(weighed, stood_count);
}

/// Counts the objections escorted whose standing an operator cannot read.
pub fn mark_unstanding(escorted: u32, weighed: bool, mark: Mark) u32 {
