    return endure_rung.alone_in(published, disputed, escort);
}

/// Answers whether a mark quotes the reading its reader actually holds.
pub fn quotes(marked: Settlement, disputed: [2]Settlement) bool {
    return endure_rung.quotes(marked, disputed);
