    return endure_rung.objection_unbounded(escorted, disputed, term);
}

// =========================================================================
// The standing -- carried whole from the rung below, since this rung reports
// on a quarrel the mark already carries the standing of
// =========================================================================

/// Whether the mark this plan publishes carries the standing of its objection.
pub const Mark = endure_rung.Mark;

/// Renders one mark as the words an operator reads.
pub fn mark_words(m: Mark) []const u8 {
    return endure_rung.mark_words(m);
}

/// What a mark says about the objection standing beside the word.
