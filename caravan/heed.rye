pub fn overclaimed_completion(lost: u32, verdict: Verdict) u32 {
    return endure_rung.overclaimed_completion(lost, verdict);
}

/// How a run decides whether its plan was carried out, from the rung below.
///
/// This rung settles that question rather than reopening it: every run here
/// reckons, because a mend that repaired a plan under the assuming reading
/// would be repairing a loss it had already declared did not matter.
pub const Ledger = endure_rung.Ledger;

/// Renders one ledger as the words an operator reads.
pub fn ledger_words(l: Ledger) []const u8 {
    return endure_rung.ledger_words(l);
}

/// Answers what a plan came to, under one ledger.
pub fn verdict_in(lost: u32, ledger: Ledger) Verdict {
    return endure_rung.verdict_in(lost, ledger);
}

/// What one run did, reported whole, with the quarrel it inherited weighed in.
///
/// `unheeded` is the number this rung moves: plans that reported carried while a
/// quarrel inherited from an earlier run stood against them. `heeded` is what
/// this rung writes instead -- one byte saying the plan's word stands under a
/// position it did not resolve, published where an operator reads the outcome.
/// `unweighed` is the other half of the same count, and the two close on the
/// positions this run actually inherited, exactly.
pub const Report = struct {
    inner: endure_rung.Report = .{},
    heeded: u32 = 0,
    unweighed: u32 = 0,
    unheeded: u32 = 0,
};

/// This rung's own tally, reached the way every rung above reaches it.
///
/// Every rung above this one finds the heeding through `heed_of`, climbing a
/// nesting of `inner` to arrive here. This rung *is* that tier, so the reach is
/// the report itself -- and naming it anyway is what lets the one body every
/// rung of this arc runs stand byte for byte in this rung too, rather than
/// nearly. An accessor born for the tier a rung owns costs three lines and
/// folds fifty-seven.
pub fn heed_of(report_out: *Report) *Report {
    return report_out;
}

/// The endure rung's own tally, which this one wraps.
///
/// Every rung of this arc wraps the report of the rung below it, so one named
/// reach per tier keeps the supervisor readable and keeps a miscount from
/// hiding inside a chain of `inner`.
pub fn endure_of(report_out: *Report) *endure_rung.Report {
    return &report_out.inner;
}

/// The appeal rung's tally, one tier further down.
pub fn appeal_of(report_out: *Report) *appeal_rung.Report {
    return &report_out.inner.inner;
}

