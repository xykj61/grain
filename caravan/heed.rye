// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = endure_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = endure_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = endure_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = endure_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = endure_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = endure_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.heeds";

/// Where a reader's own box lives, outside this plan's wire entirely.
///
/// The whole point of the rung, written as a path. Every note of this arc so
/// far has landed under `note_dir`, where a reader must come looking; a
/// delivery lands here instead, so the first outward reach of the arc is
/// visible as a record leaving the place records are kept.
pub const reader_dir = "caravan/.readers";

/// The longest address a reader may leave, in bytes.
///
/// Bounded like every other word this wire carries: an address is a short
/// name for a place a person is, never a path a run could be talked into
/// walking somewhere unintended.
pub const max_address_len: u32 = 16;

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = endure_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = endure_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = endure_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = endure_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = endure_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = endure_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = endure_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the enduring notes
    assert(!std.mem.eql(u8, note_dir, endure_rung.note_dir));
    // invariant: this rung's notes never collide with the appealing notes
    assert(!std.mem.eql(u8, note_dir, appeal_rung.note_dir));
    // invariant: this rung's notes never collide with the abiding notes
    assert(!std.mem.eql(u8, note_dir, abiding_rung.note_dir));
    // invariant: this rung's notes never collide with the disputing notes
    assert(!std.mem.eql(u8, note_dir, disputing_rung.note_dir));
    // invariant: this rung's notes never collide with the hearing notes
    assert(!std.mem.eql(u8, note_dir, hearing_rung.note_dir));
    // invariant: this rung's notes never collide with the recanting notes
    assert(!std.mem.eql(u8, note_dir, recanting_rung.note_dir));
    // invariant: a delivery always leaves the place this plan keeps its records
    assert(!std.mem.eql(u8, note_dir, reader_dir));
    // invariant: a reader's box path leaves room for the address it is named by
    assert(max_note_path_len > reader_dir.len + max_address_len);
    // invariant: this rung's notes never collide with the appraising notes
    assert(!std.mem.eql(u8, note_dir, appraising_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

// =========================================================================
// The shapes -- carried whole from the rung below
// =========================================================================

/// Renders one outcome code as the words an operator reads.
pub fn outcome_name(code: u8) []const u8 {
    return endure_rung.outcome_name(code);
}

/// Why a queue may not take, correct, understudy, unhand, taper, entrust,
/// confer, revoke, reclaim, answer for its work, claim it is done, repair it,
/// carry the loss its author asked it to bear, weigh the loss its author left
/// unmarked, take back a judgment its own evidence disproves, correct the
/// reader of a word it has since replaced, carry that correction to them, hear
/// what that reader answered back, record a disagreement it cannot resolve,
/// stand a word up beside that disagreement, put a term on how long the
/// disagreement may stand, or carry that term into the mark itself.
///
/// Four names of this rung's own, and each is about what a run owes a quarrel it
/// inherited: the moment a run publishes a regard, whether anybody ever pressed
/// the position it stands under, the honesty of the count, and whether the
/// regard an operator reads is the one this plan truly stands in.
pub const RunError = endure_rung.RunError || error{
    HeedEarly,
    HeedUnpressed,
    HeedMiscounted,
    HeedMisrecorded,
};

/// One queued item and the letters it declares, carried from `intent.rye`.
pub const Task = endure_rung.Task;

/// How deeply a reading looks at the queue's own authorship, unchanged.
pub const Reading = endure_rung.Reading;

/// One phase, its turn, its step, its masks, the reserve it may be entrusted,
/// and the bearing its author may write beside it.
///
/// This rung adds no word here either, and for the same reason the rung below
/// added none: what it weighs is a judgment made about a phase rather than
/// anything the phase's author wrote. Whether a record's own judgments answer
/// to a later run's evidence is a statement about the whole record, so it lives
/// at the plan beside the standard.
pub const Phase = struct {
    turn: u32 = 0,
    step: u32 = 0,
    follows: u32 = 0,
    follows_turns: u32 = 0,
    reserve: ?Task = null,
    bear: bool = false,
    task: Task,
};

/// The phase as the rung below reads it, bearing and all, since the rung below
/// already knows that word and this one adds none.
pub fn below(phase: Phase) endure_rung.Phase {
    // invariant: a phase always names the domain its author wrote
    assert(phase.task.item.domain.len >= 1);
    return .{
        .turn = phase.turn,
        .step = phase.step,
        .follows = phase.follows,
        .follows_turns = phase.follows_turns,
        .reserve = phase.reserve,
        .bear = phase.bear,
        .task = phase.task,
    };
}

/// The phase as the rungs below read it, without the reserve they never had.
pub fn plain(phase: Phase) unhand.Phase {
    return endure_rung.plain(below(phase));
}

/// When a dependent comes to hold the arcs of its reserve, from the rung below.
pub const Reach = endure_rung.Reach;

/// What becomes of a conferred word while its holder still stands.
pub const Keep = endure_rung.Keep;

/// One bounded word list, exactly as the conferring wire renders it.
pub const Words = endure_rung.Words;

/// What a run says its plan came to, carried whole from the rung below.
pub const Verdict = endure_rung.Verdict;

