pub fn recant_published(comptime rung: type, io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= rung.max_queue_len);
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".recant") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
