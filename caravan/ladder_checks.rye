//! Caravan ladder checks -- the harness a rung hands itself to.
//!
//! Every rung of the Caravan arc imports the rung beneath it and proves one new
//! thing about a supervised run. For eighty-odd rungs each rung also carried a
//! fresh copy of every check beneath it, because a private function cannot be
//! called from above. The `20260820.131713` design call measured that carry, and
//! its option A folded most of it: a check is public now, and a rung whose check
//! is byte-for-byte the rung below's runs it there rather than keeping a copy.
//!
//! Two residues stayed home, and both had one cause. A check that reaches the
//! wire cannot run in the rung below, since each rung keeps its notes in its own
//! directory and the rung below would provision its own and leave this one cold.
//! Nor can a check run below when the helpers it names are ones each rung writes
//! over its own report -- the body would weigh the wrong plan.
//!
//! **This is option B, and it answers both at once.** A check lifted here takes
//! the rung as a comptime parameter and reaches every helper through it, so one
//! body runs against whichever rung handed itself in: that rung's own report,
//! its own helpers, its own wire. Where a hundred lines of copy stood, the rung
//! keeps a three-line call.
//!
//! **The contract is one word: `rung`.** A rung passes `@This()` and promises
//! that every symbol a lifted check names stands public on it. Nothing here
//! holds state, opens a store, or knows any rung by name -- so a rung is free to
//! measure the wire wherever it keeps it.
//!
//! **The loop turns twice.** Outward, a rung's self-test walks its checks in
//! order, each check the ladder ever proved standing in the one it climbs to.
//! Inward, a lifted check reaches back into the rung it was handed and runs that
//! rung's own measure. Harness and rung call each other, and the recursion
//! bottoms out where every check in this arc does -- on a number read off a plan
//! that actually ran.
//!
//! **The door came here too.** A rung's entry point is not a check, yet it is
//! the same shape of carry: every rung of this arc answers three asks at its
//! door, and seventy-nine wrote that answer out byte for byte. `run_main` holds
//! it once, reaching `run_dependent`, `run_self_test`, and `fixed_argv_words`
//! through whichever rung handed itself in -- so the two cohorts that once
//! differed by a single qualifier now share one body.
//!
//! Brief: `../active-designing/date/20260820/20260820-131713_caravan-ladder-shared-harness.md`
//! Meter: `../tools/caravan_ladder_copy_witness.rish`

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cohort = @import("cohort.rye");
const system = @import("system.rye");
const unhand = @import("unhand.rye");
const precede = @import("precede.rye");
const capabilities = @import("capabilities.rye");
const cycle = @import("cycle.rye");
const carry = @import("carry.rye");
const gap = @import("gap.rye");
const mask = @import("mask.rye");
const confer = @import("confer.rye");
const intent = @import("intent.rye");
const boot = @import("boot.rye");
const tally_parse_int = @import("parse_int.rye");
const entrust = @import("entrust.rye");
const roster = @import("roster.rye");
const exercise = @import("exercise.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const Dir = std.Io.Dir;

const harness = @This();

/// Reaches a chained link the way the ladder means it -- the rung's own body
/// when that rung wrote one, and this harness's body when it wrote none.
///
/// A rung publishes a link only to *change* it, so silence means "run the body
/// the harness already holds." That lets a rung pay five lines for a check it
/// altered and nothing at all for a check it merely climbs to. The test is
/// `comptime`, so the untaken branch is never analyzed and a name this harness
/// does not hold can only be reached for by a rung that declares it.
fn link(comptime rung: type, comptime name: []const u8) u8 {
    // invariant: a link always names a check, never some other decl
    comptime assert(std.mem.startsWith(u8, name, "check_"));
    if (comptime @hasDecl(rung, name)) return @field(rung, name)();
    return @field(harness, name)(rung);
}

/// The same reach for a link that measures a wire, which needs the rung's own
/// notes to read from and the declaration they were provisioned under.
fn link_wire(comptime rung: type, comptime name: []const u8, io: std.Io, sys: *const system.System) u8 {
    // invariant: a link always names a check, never some other decl
    comptime assert(std.mem.startsWith(u8, name, "check_"));
    if (comptime @hasDecl(rung, name)) return @field(rung, name)(io, sys);
    return @field(harness, name)(rung, io, sys);
}



pub fn check_allay(comptime rung: type) u8 {
    const told = rung.knows_bytes(rung.anew_bytes(rung.inherited_matter));
    const reply = rung.rests_bytes(told, .allays);
    if (!rung.rests_answers(reply, told)) {
        print("  RED: a reply refused the very telling it was written from\n", .{});
        return 1;
    }
    if (rung.rests_rest(reply) != .allays) {
        print("  RED: a reader's own word came back as some other answer\n", .{});
        return 1;
    }
    if (rung.rests_rest(rung.rests_bytes(told, .stands)) != .stands) {
        print("  RED: a reader saying the matter stands was read as content\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a reply left over from an earlier
    // lap answers an older telling, and reading it as today's would publish a
    // verdict about a second look nobody made this morning.
    const elder = rung.knows_bytes(rung.anew_bytes(rung.again_bytes(rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting))));
    if (rung.rests_answers(rung.rests_bytes(elder, .allays), told)) {
        print("  RED: a reply about an older telling was read as today's\n", .{});
        return 1;
    }
    if (rung.rests_answers(null, told)) {
        print("  RED: an empty box read as a reader who answered\n", .{});
        return 1;
    }
    if (rung.rests_rest(null) != null) {
        print("  RED: a silence was read as a word\n", .{});
        return 1;
    }
    if (rung.rest_of_byte('x') != null) {
        print("  RED: a byte this rung does not know was read as an answer\n", .{});
        return 1;
    }
    if (!rung.allay_holds(.allays, .allays) or rung.allay_holds(.stands, .allays) or rung.allay_holds(null, .allays)) {
        print("  RED: the record half of this rung did not hold\n", .{});
        return 1;
    }
    if (rung.read_back_in(1, .reads) != 1 or rung.read_back_in(1, .unread) != 0) {
        print("  RED: a telling was read back under the wrong reading\n", .{});
        return 1;
    }
    if (rung.read_back_in(0, .reads) != 0) {
        print("  RED: a run that told nobody read a reply anyway\n", .{});
        return 1;
    }
    if (rung.unread_in(1, .unread) != 1 or rung.unread_in(1, .reads) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.unread_in(0, .unread) != 0) {
        print("  RED: a run that told nobody left a reply unread anyway\n", .{});
        return 1;
    }
    return link(rung, "check_allay_refusals");
}


pub fn check_allay_measure(comptime rung: type) u8 {
    if (rung.unheard_replies(1, .unread) != 1) {
        print("  RED: a reply nobody opened went uncounted\n", .{});
        return 1;
    }
    if (rung.unheard_replies(1, .reads) != 0) {
        print("  RED: a reply read back still counted as one nobody opened\n", .{});
        return 1;
    }
    // A run that told nobody anything is owed no reply, so it costs the count
    // nothing -- the harm this rung names is the telling actually carried and
    // the answer to it left unopened.
    if (rung.unheard_replies(0, .unread) != 0) {
        print("  RED: a run that told nobody was charged an unheard reply\n", .{});
        return 1;
    }

    print("  five refusals stand by name: untold, silent, mismatched, miscounted, misrecorded\n", .{});
    print("  the reading this rung keeps: {s}\n", .{rung.allay_words(.reads)});
    print("  what an unreading plan never learns: {s}\n", .{rung.allay_words(.unread)});
    print("  {s}\n", .{rung.rest_words(.allays)});
    print("  {s}\n", .{rung.rest_words(.stands)});
    print("  a reply carries five bytes: the telling they were carried, and what they make of it\n", .{});
    return link(rung, "check_forbear");
}


pub fn check_allay_refusals(comptime rung: type) u8 {
    if (rung.allay_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.AllayUntold) {
            print("  RED: a run that told nobody refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that told nobody read a reply all the same\n", .{});
        return 1;
    }
    if (rung.allay_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.AllaySilent) {
            print("  RED: a reader who wrote nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a silence was published as a reader's word\n", .{});
        return 1;
    }
    if (rung.allay_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.AllayMismatched) {
            print("  RED: a reply about some other telling refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reply about some other telling was published as today's\n", .{});
        return 1;
    }
    if (rung.allay_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.AllayMiscounted) {
            print("  RED: a telling both read and unread refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a telling counted twice passed the count\n", .{});
        return 1;
    }
    if (rung.allay_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.AllayMiscounted) {
            print("  RED: a telling counted neither way refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a telling counted neither way passed the count\n", .{});
        return 1;
    }
    if (rung.allay_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest reading refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_allay_measure");
}


pub fn check_allay_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_rests(io, rung.standing_address);
    rung.clear_allay(io);
    rung.clear_recount(io, rung.standing_address);
    rung.clear_reweigh(io);
    rung.reweigh_note(io, rung.inherited_matter) catch |err| {
        print("  RED: a second look could not be receipted at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.anew_standing(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    rung.recount_note(io, rung.standing_address, receipt) catch |err| {
        print("  RED: a telling could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const told = rung.recounted_to(io, rung.standing_address) orelse {
        print("  RED: a carried telling could not be read back at all\n", .{});
        return 1;
    };
    // The reader's own hand, written by the reader rather than by any run.
    rung.rest_as_reader(io, rung.standing_address, rung.rests_bytes(told, .allays)) catch |err| {
        print("  RED: a reader could not reply in their own hand: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.allay_note(io, .allays) catch |err| {
        print("  RED: a reader's word could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.rest_written(io, rung.standing_address) orelse {
        print("  RED: a provisioning cleared the reply a reader wrote\n", .{});
        return 1;
    };
    if (!rung.rests_answers(survived, told)) {
        print("  RED: a reply carried past a provisioning stopped naming its telling\n", .{});
        return 1;
    }
    if (!rung.allay_holds(rung.rest_published(io), .allays)) {
        print("  RED: a published word carried past a provisioning stopped naming its answer\n", .{});
        return 1;
    }
    if (rung.recounted_to(io, rung.standing_address) == null) {
        print("  RED: reading a reader's reply took down the telling it answers\n", .{});
        return 1;
    }
    // The plan's copy falls with the telling it answers, proven on the wire the
    // plan leaves when the telling beneath it comes down.
    rung.clear_recount(io, rung.standing_address);
    rung.clear_allay(io);
    if (rung.rest_published(io) != null) {
        print("  RED: a published word outlived the telling it answered\n", .{});
        return 1;
    }
    if (rung.rest_written(io, rung.standing_address) == null) {
        print("  RED: a plan reached into its reader's box to take their word back\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.rest_published(io) != null) {
        print("  RED: a published word came back with the next provisioning\n", .{});
        return 1;
    }
    rung.clear_rests(io, rung.standing_address);
    print("  a reader's reply survives a provisioning, and the plan's copy falls with the telling it answers\n", .{});
    return link_wire(rung, "check_forbear_wire", io, sys);
}


pub fn check_appeal_wire(comptime rung: type, io: std.Io) u8 {
    const shelf = "shelf";
    rung.clear_press(io, shelf);
    rung.press_as_reader(io, shelf, .accepts) catch |err| {
        print("  RED: a reader could not reply at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const read_back = rung.pressed_by(io, shelf) orelse {
        print("  RED: a reader's own box carried no reply back\n", .{});
        return 1;
    };
    if (read_back != .accepts) {
        print("  RED: an accepted outcome was read back as {s}\n", .{rung.plea_words(read_back)});
        return 1;
    }
    rung.clear_press(io, shelf);
    if (rung.pressed_by(io, shelf) != null) {
        print("  RED: a cleared box still replied\n", .{});
        return 1;
    }
    print("  both pleas ride the wire: {s}\n", .{rung.plea_words(.accepts)});
    return 0;
}


pub fn check_apprise(comptime rung: type) u8 {
    if (rung.apprised_in(1, .withheld) != 0) {
        print("  RED: a withholding run carried a finding to somebody after all\n", .{});
        return 1;
    }
    if (rung.apprised_in(1, .apprises) != 1) {
        print("  RED: an apprising run carried {d} findings out\n", .{rung.apprised_in(1, .apprises)});
        return 1;
    }
    if (rung.apprised_in(0, .apprises) != 0) {
        print("  RED: a run that reached no finding carried one out anyway\n", .{});
        return 1;
    }
    if (rung.unsent_in(1, .withheld) != 1 or rung.unsent_in(1, .apprises) != 0) {
        print("  RED: the other half of the count did not close on one finding\n", .{});
        return 1;
    }

    // The delivery's own three bytes, read back against the finding they carry.
    const met = rung.met_bytes(rung.debt_bytes(.overrules, .short));
    const finding = rung.redress_bytes(met, .righted);
    const delivered = rung.found_bytes(finding);
    if (!rung.found_answers(delivered, finding)) {
        print("  RED: a delivery did not read back as the finding it carries\n", .{});
        return 1;
    }
    if (rung.found_answers(delivered, rung.redress_bytes(met, .sound))) {
        print("  RED: a work put right read back in its reader's box as one found sound\n", .{});
        return 1;
    }
    if (rung.found_answers(null, finding)) {
        print("  RED: an unopened box read back as a reader who had been told\n", .{});
        return 1;
    }
    if (!rung.apprise_holds(delivered, finding)) {
        print("  RED: a carried finding did not read back as the finding it was\n", .{});
        return 1;
    }
    if (rung.apprise_holds(rung.found_bytes(rung.redress_bytes(met, .sound)), finding)) {
        print("  RED: a reader told one answer read back as told another\n", .{});
        return 1;
    }
    if (rung.apprise_holds(null, finding)) {
        print("  RED: a box holding nothing read back as a finding delivered\n", .{});
        return 1;
    }
    return link(rung, "check_apprise_refusals");
}


pub fn check_apprise_measure(comptime rung: type) u8 {
    if (rung.unheard_findings(1, .withheld) != 1) {
        print("  RED: a finding its raiser never heard went uncounted\n", .{});
        return 1;
    }
    if (rung.unheard_findings(1, .apprises) != 0) {
        print("  RED: a finding carried to its reader still counted as one never told\n", .{});
        return 1;
    }
    // A run that reached no finding has nothing to carry, so it costs the count
    // nothing -- the harm this rung names is the answer reached, written down,
    // and never once carried to the person who won it.
    if (rung.unheard_findings(0, .withheld) != 0) {
        print("  RED: a run that reached no finding was charged an untold raiser\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unfound, unaddressed, mismatched, miscounted, misrecorded\n", .{});
    print("  the delivery this rung keeps: {s}\n", .{rung.apprise_words(.apprises)});
    print("  what a withholding plan leaves its reader: {s}\n", .{rung.apprise_words(.withheld)});
    print("  a delivery carries the finding whole: the meeting reported on, and what the look came to\n", .{});
    return link(rung, "check_suffice");
}


pub fn check_apprise_refusals(comptime rung: type) u8 {
    // A run whose wire carries no finding has nothing to carry to anybody.
    if (rung.apprise_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.AppriseUnfound) {
            print("  RED: a delivery with no finding behind it refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that reached no finding was credited with telling somebody\n", .{});
        return 1;
    }
    // A finding reaches a person or it reaches nobody: a plan that never wrote
    // down where its reader was has no box to carry anything to.
    if (rung.apprise_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.AppriseUnaddressed) {
            print("  RED: a delivery with nowhere to go refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run carried a finding to a reader it could not name\n", .{});
        return 1;
    }
    // The rung itself: a raiser told some other look's answer, about an argument
    // that was never theirs.
    if (rung.apprise_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.AppriseMismatched) {
            print("  RED: a delivery of another finding refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run reached one finding and carried out another\n", .{});
        return 1;
    }
    // The honesty of the count: every finding reached is carried or withheld --
    // never both and never neither.
    if (rung.apprise_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.AppriseMiscounted) {
            print("  RED: a finding counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a finding carried and kept at once went uncounted\n", .{});
        return 1;
    }
    if (rung.apprise_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.AppriseMiscounted) {
            print("  RED: a finding counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a finding neither carried nor kept went uncounted\n", .{});
        return 1;
    }
    if (rung.apprise_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: a delivery inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_apprise_measure");
}


pub fn check_apprise_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_apprise(io, rung.standing_address);
    rung.clear_met(io);
    rung.clear_redress(io);
    rung.met_note(io, rung.inherited_debt) catch |err| {
        print("  RED: a receipt could not be seated at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.meeting_written(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    rung.redress_note(io, receipt, .righted) catch |err| {
        print("  RED: a finding could not be written at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const finding = rung.redress_written(io) orelse {
        print("  RED: a seated finding could not be read back at all\n", .{});
        return 1;
    };
    rung.apprise_note(io, rung.standing_address, rung.found_bytes(finding)) catch |err| {
        print("  RED: a finding could not be carried to its reader at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const delivered = rung.apprised_of(io, rung.standing_address) orelse {
        print("  RED: a provisioning emptied the box a finding was carried to\n", .{});
        return 1;
    };
    if (!rung.apprise_holds(delivered, rung.found_bytes(finding))) {
        print("  RED: a delivery carried past a provisioning stopped naming its finding\n", .{});
        return 1;
    }
    if (rung.redress_written(io) == null) {
        print("  RED: carrying a finding out moved it out of the plan's own notes\n", .{});
        return 1;
    }
    // The delivery comes down when the reader's box is cleared, so a lap always
    // opens on a reader who has been told nothing yet.
    rung.clear_apprise(io, rung.standing_address);
    if (rung.apprised_of(io, rung.standing_address) != null) {
        print("  RED: a cleared box still held the finding it was carried\n", .{});
        return 1;
    }
    rung.clear_met(io);
    rung.clear_redress(io);
    print("  a delivery survives a provisioning, and leaves the note it copies where it stands\n", .{});
    return link_wire(rung, "check_suffice_wire", io, sys);
}


pub fn check_avow(comptime rung: type) u8 {
    // The count, which every later number closes on.
    if (rung.said_in(1, .concedes) != 1) {
        print("  RED: an avowing run left the finding it read unanswered\n", .{});
        return 1;
    }
    if (rung.said_in(1, .dissents) != 1) {
        print("  RED: a plan keeping its own word said nothing at all\n", .{});
        return 1;
    }
    if (rung.said_in(1, .mute) != 0) {
        print("  RED: a mute run answered a finding all the same\n", .{});
        return 1;
    }
    if (rung.said_in(0, .concedes) != 0) {
        print("  RED: a run that read no finding answered one anyway\n", .{});
        return 1;
    }
    if (rung.withheld_in(1, .mute) != 1) {
        print("  RED: a finding left unanswered counted as one answered\n", .{});
        return 1;
    }
    if (rung.withheld_in(1, .concedes) != 0) {
        print("  RED: an answered finding still counted as one withheld\n", .{});
        return 1;
    }

    // The one comparison this rung exists to make, in both directions. A plan
    // that answered this argument before may still hold its word on an older
    // verdict, and filing that beside today's finding tells an operator the plan
    // spoke to something it never spoke to.
    const word = rung.avowal_bytes(.upholds, .concedes);
    if (!rung.avowal_answers(word, .upholds)) {
        print("  RED: an avowal did not read back as an answer to its own finding\n", .{});
        return 1;
    }
    if (rung.avowal_answers(word, .overrules)) {
        print("  RED: a word about another verdict answered this one\n", .{});
        return 1;
    }
    if (rung.avowal_answers(null, .upholds)) {
        print("  RED: a plan holding nothing read back as one that had spoken\n", .{});
        return 1;
    }

    // The plan's own word, read out of the avowal rather than assumed of it.
    if (rung.stance_in(word) != .concedes) {
        print("  RED: a plan taking the finding read back as some other word\n", .{});
        return 1;
    }
    if (rung.stance_in(rung.avowal_bytes(.upholds, .dissents)) != .dissents) {
        print("  RED: a plan keeping its word read back as some other word\n", .{});
        return 1;
    }
    if (rung.stance_in(null) != null) {
        print("  RED: a plan that said nothing was read as having said something\n", .{});
        return 1;
    }
    if (rung.stance_byte(.mute) != null) {
        print("  RED: silence was published as a word of its own\n", .{});
        return 1;
    }

    // The record half, in both directions.
    if (!rung.avow_holds(word, word)) {
        print("  RED: a published avowal did not read back as the word it was\n", .{});
        return 1;
    }
    if (rung.avow_holds(rung.avowal_bytes(.upholds, .dissents), word)) {
        print("  RED: a plan published one word and read back another\n", .{});
        return 1;
    }
    if (rung.avow_holds(null, word)) {
        print("  RED: a note holding nothing read back as a published avowal\n", .{});
        return 1;
    }
    return link(rung, "check_avow_refusals");
}


pub fn check_avow_refusals(comptime rung: type) u8 {
    if (rung.avow_refusal(0, 1, 0, true, true)) |why| {
        if (why != error.AvowUnheard) {
            print("  RED: an unheard avowing refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run answered a finding it never read\n", .{});
        return 1;
    }
    if (rung.avow_refusal(1, 1, 0, false, false)) |why| {
        if (why != error.AvowUnfound) {
            print("  RED: an avowing over an unpublished finding refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run answered a verdict its own wire never carried\n", .{});
        return 1;
    }
    // The rung itself, refused by name: a word about some other verdict
    // published beside this finding tells an operator the plan answered
    // something it never answered.
    if (rung.avow_refusal(1, 1, 0, true, false)) |why| {
        if (why != error.AvowMismatched) {
            print("  RED: a word about another finding refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run filed an older verdict's answer beside today's finding\n", .{});
        return 1;
    }
    // The honesty of the count: every finding read is answered or left
    // unanswered -- never both and never neither.
    if (rung.avow_refusal(1, 1, 1, true, true)) |why| {
        if (why != error.AvowMiscounted) {
            print("  RED: a finding counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a finding answered and withheld at once went uncounted\n", .{});
        return 1;
    }
    if (rung.avow_refusal(1, 0, 0, true, true)) |why| {
        if (why != error.AvowMiscounted) {
            print("  RED: a finding counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a finding neither answered nor withheld went uncounted\n", .{});
        return 1;
    }
    if (rung.avow_refusal(1, 1, 0, true, true)) |why| {
        print("  RED: an avowing inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_avow_measure");
}


pub fn check_avow_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_deem(io);
    rung.clear_avow(io);
    rung.deem_note(io, .upholds) catch |err| {
        print("  RED: a finding could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.avow_note(io, .upholds, .concedes) catch |err| {
        print("  RED: a plan could not answer at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.avow_written(io) orelse {
        print("  RED: a provisioning cleared the word it was told to leave\n", .{});
        return 1;
    };
    if (!rung.avowal_answers(survived, .upholds)) {
        print("  RED: a word carried past a provisioning stopped naming its finding\n", .{});
        return 1;
    }
    if (rung.stance_in(survived) != .concedes) {
        print("  RED: a word carried past a provisioning read back as another\n", .{});
        return 1;
    }
    // The word falls with the finding, proven on the wire the plan leaves when
    // it takes its own published verdict down.
    rung.clear_deem(io);
    rung.clear_avow(io);
    if (rung.avow_written(io) != null) {
        print("  RED: a word outlived the finding it was answering\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.avow_written(io) != null) {
        print("  RED: a word came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a word survives a provisioning, and falls with the finding it answers\n", .{});
    return link_wire(rung, "check_owe_wire", io, sys);
}


pub fn check_beckon(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const call = rung.calls_bytes(wall);
    if (!rung.calls_carries(call, wall)) {
        print("  RED: a call did not name the wall it was built from\n", .{});
        return 1;
    }
    if (rung.calls_rest(call) != .stands) {
        print("  RED: a call lost the reader's own word four tiers down\n", .{});
        return 1;
    }
    if (call[rung.max_calls_bytes - 1] != rung.called_byte) {
        print("  RED: a call did not say what it is in its own last byte\n", .{});
        return 1;
    }
    // A call built from some other wall names some other matter, and reading it
    // as this one's would report a person reached about a boundary nobody stood.
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.calls_carries(rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(elder))), wall)) {
        print("  RED: a call about some other wall read as this one's\n", .{});
        return 1;
    }
    if (rung.calls_carries(null, wall)) {
        print("  RED: a plan that called nobody read as one that had\n", .{});
        return 1;
    }
    if (rung.calls_rest(null) != null) {
        print("  RED: an absent call answered with a word\n", .{});
        return 1;
    }
    if (!rung.beckon_holds(call, call) or rung.beckon_holds(null, call)) {
        print("  RED: a call read back out of a reader's box did not answer for itself\n", .{});
        return 1;
    }
    if (rung.beckoned_in(1, .beckons) != 1 or rung.beckoned_in(1, .keeps) != 0) {
        print("  RED: a beckoning was counted as a keeping, or the other way about\n", .{});
        return 1;
    }
    if (rung.beckoned_in(0, .beckons) != 0) {
        print("  RED: a run that stood no wall was counted as calling a person\n", .{});
        return 1;
    }
    if (rung.drawered_in(1, .keeps) != 1 or rung.drawered_in(1, .beckons) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    return link(rung, "check_beckon_refusals");
}


pub fn check_beckon_refusals(comptime rung: type) u8 {
    if (rung.beckon_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.BeckonUnwalled) {
            print("  RED: a call from a run that stood no wall refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a call from a run that stood no wall was allowed\n", .{});
        return 1;
    }
    if (rung.beckon_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.BeckonUnaddressed) {
            print("  RED: a call to a reader who left no address refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a call to a reader who left no address was allowed\n", .{});
        return 1;
    }
    if (rung.beckon_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.BeckonMismatched) {
            print("  RED: a call naming some other wall refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a call naming some other wall was allowed\n", .{});
        return 1;
    }
    if (rung.beckon_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.BeckonMiscounted) {
            print("  RED: a wall both carried and kept refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a wall both carried and kept was allowed\n", .{});
        return 1;
    }
    if (rung.beckon_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.BeckonMiscounted) {
            print("  RED: a wall neither carried nor kept refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a wall neither carried nor kept was allowed\n", .{});
        return 1;
    }
    // And the honest pass: a wall stood once, carried once, counted once.
    if (rung.beckon_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest beckoning refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_beckon_measure");
}


pub fn check_deem(comptime rung: type) u8 {
    // The count, which every later number closes on.
    if (rung.answered_in(1, .answered) != 1) {
        print("  RED: a reading run left its one carried case unanswered\n", .{});
        return 1;
    }
    if (rung.answered_in(1, .unread) != 0) {
        print("  RED: an unread run published a finding all the same\n", .{});
        return 1;
    }
    if (rung.answered_in(0, .answered) != 0) {
        print("  RED: a run that carried no case out read an answer anyway\n", .{});
        return 1;
    }
    if (rung.awaiting_in(1, .unread) != 1) {
        print("  RED: a case left waiting counted as one answered\n", .{});
        return 1;
    }
    if (rung.awaiting_in(1, .answered) != 0) {
        print("  RED: an answered case still counted as one waiting\n", .{});
        return 1;
    }

    // The one comparison this rung exists to make, in both directions. A desk
    // that has heard this argument before may still hold the answer to an older
    // case, and filing that beside today's outcome quotes a hand outside the
    // argument saying something they never said about this work.
    const case = rung.referral_bytes(.carried, .loud, 4);
    const answer = rung.finding_bytes(case, .upholds);
    if (!rung.finding_answers(answer, case)) {
        print("  RED: a finding did not read back as an answer to its own case\n", .{});
        return 1;
    }
    if (rung.finding_answers(answer, rung.referral_bytes(.short, .loud, 4))) {
        print("  RED: a finding about another settlement answered this one\n", .{});
        return 1;
    }
    if (rung.finding_answers(answer, rung.referral_bytes(.carried, .loud, 3))) {
        print("  RED: a finding about a younger quarrel answered this one\n", .{});
        return 1;
    }
    if (rung.finding_answers(null, case)) {
        print("  RED: a desk holding nothing read back as one that had answered\n", .{});
        return 1;
    }

    // The verdict half, read out of the finding rather than supplied by a run.
    if (rung.finding_in(answer) != .upholds) {
        print("  RED: a finding for the reader read back as some other word\n", .{});
        return 1;
    }
    if (rung.finding_in(rung.finding_bytes(case, .overrules)) != .overrules) {
        print("  RED: a finding for the plan read back as some other word\n", .{});
        return 1;
    }
    if (rung.finding_in(null) != null) {
        print("  RED: a desk that said nothing was read as having said something\n", .{});
        return 1;
    }

    // The record half, in both directions.
    if (!rung.deem_holds(.upholds, .upholds)) {
        print("  RED: a published finding did not read back as the finding it was\n", .{});
        return 1;
    }
    if (rung.deem_holds(.overrules, .upholds)) {
        print("  RED: a plan published one verdict and read back another\n", .{});
        return 1;
    }
    if (rung.deem_holds(null, .upholds)) {
        print("  RED: a note holding nothing read back as a published finding\n", .{});
        return 1;
    }
    return link(rung, "check_deem_refusals");
}


pub fn check_deem_measure(comptime rung: type) u8 {
    if (rung.unanswered_referrals(1, .unread) != 1) {
        print("  RED: a case nobody was ever heard back on went uncounted\n", .{});
        return 1;
    }
    if (rung.unanswered_referrals(1, .answered) != 0) {
        print("  RED: an answered case still counted as one nobody replied to\n", .{});
        return 1;
    }
    // A run that carried nothing out is owed an answer by nobody, so it costs
    // the count nothing -- the harm this rung names is the case that travelled
    // and was never heard from again.
    if (rung.unanswered_referrals(0, .unread) != 0) {
        print("  RED: a run that referred nothing was owed a third hand's word\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unreferred, silent, mismatched, miscounted, misrecorded\n", .{});
    print("  the reading this rung keeps: {s}\n", .{rung.deem_words(.answered)});
    print("  what a bare plan leaves an operator: {s}\n", .{rung.deem_words(.unread)});
    print("  a finding carries four bytes: the case it answers, and the word on it\n", .{});
    print("  finding for the reader reads as {s}\n", .{rung.finding_words(.upholds)});
    print("  finding for the plan reads as {s}\n", .{rung.finding_words(.overrules)});
    return link(rung, "check_avow");
}


pub fn check_deem_refusals(comptime rung: type) u8 {
    if (rung.deem_refusal(0, 1, 0, true, true)) |why| {
        if (why != error.DeemUnreferred) {
            print("  RED: an unreferred reading refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run took an answer to a case it never carried out\n", .{});
        return 1;
    }
    if (rung.deem_refusal(1, 1, 0, false, false)) |why| {
        if (why != error.DeemSilent) {
            print("  RED: a reading of an empty desk refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run published a finding nobody had written\n", .{});
        return 1;
    }
    // The rung itself, refused by name: a finding about some other argument
    // published beside this outcome puts a third hand's name on a word they
    // never said about this work.
    if (rung.deem_refusal(1, 1, 0, true, false)) |why| {
        if (why != error.DeemMismatched) {
            print("  RED: a finding about another case refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run filed an older argument's answer beside today's word\n", .{});
        return 1;
    }
    // The honesty of the count: every case carried out is answered or left
    // waiting -- never both and never neither.
    if (rung.deem_refusal(1, 1, 1, true, true)) |why| {
        if (why != error.DeemMiscounted) {
            print("  RED: a case counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a case answered and waiting at once went uncounted\n", .{});
        return 1;
    }
    if (rung.deem_refusal(1, 0, 0, true, true)) |why| {
        if (why != error.DeemMiscounted) {
            print("  RED: a case counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a case neither answered nor waiting went uncounted\n", .{});
        return 1;
    }
    if (rung.deem_refusal(1, 1, 0, true, true)) |why| {
        print("  RED: a reading inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_deem_measure");
}


pub fn check_deem_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_finding(io, rung.standing_forum);
    rung.clear_deem(io);
    const case = rung.referral_bytes(.carried, .loud, rung.long_standing_runs + 1);
    const answer = rung.finding_bytes(case, .upholds);
    rung.answer_as_forum(io, rung.standing_forum, answer) catch |err| {
        print("  RED: a third hand could not answer at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.deem_note(io, .upholds) catch |err| {
        print("  RED: a finding could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    if (!rung.finding_answers(rung.finding_written(io, rung.standing_forum), case)) {
        print("  RED: a provisioning swept a finding off a desk it never owned\n", .{});
        return 1;
    }
    // The finding outlives the quarrel exactly as the case it answers does,
    // which is what a word from outside the argument is for.
    rung.release_standing(io);
    if (rung.finding_in(rung.finding_written(io, rung.standing_forum)) != .upholds) {
        print("  RED: a withdrawal reached onto a third hand's desk and took their word back\n", .{});
        return 1;
    }
    // And the plan's own copy is the plan's: taking it down leaves the hand that
    // wrote it holding their answer still.
    rung.clear_deem(io);
    if (rung.deem_published(io) != null) {
        print("  RED: a plan that took down its own copy still published a finding\n", .{});
        return 1;
    }
    if (rung.finding_in(rung.finding_written(io, rung.standing_forum)) != .upholds) {
        print("  RED: a plan clearing its own note reached onto a third hand's desk\n", .{});
        return 1;
    }
    rung.clear_finding(io, rung.standing_forum);
    if (rung.finding_written(io, rung.standing_forum) != null) {
        print("  RED: a desk cleared by its own hand still held a finding\n", .{});
        return 1;
    }
    print("  a finding survives a provisioning, and belongs to the hand that wrote it\n", .{});
    return 0;
}


pub fn check_desist(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    if (!rung.walls_carries(wall, mark)) {
        print("  RED: a wall did not bound the mark it was built from\n", .{});
        return 1;
    }
    if (rung.walls_rest(wall) != .stands) {
        print("  RED: a wall lost the reader's own word three tiers down\n", .{});
        return 1;
    }
    if (wall[rung.max_walls_bytes - 1] != rung.walled_byte) {
        print("  RED: a wall did not say what it was\n", .{});
        return 1;
    }
    // A wall built from some other mark bounds some other matter, and reading
    // it as this one's would report a boundary nobody stood here.
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.walls_carries(rung.walls_bytes(rung.minds_bytes(elder)), mark)) {
        print("  RED: a wall about another matter read as this one's\n", .{});
        return 1;
    }
    if (rung.walls_carries(null, mark)) {
        print("  RED: a plan that stood no wall read as one that had\n", .{});
        return 1;
    }
    if (rung.walls_rest(null) != null) {
        print("  RED: an absent wall answered with a word\n", .{});
        return 1;
    }
    // The evidence a bounding run weighs: two runs naming one matter.
    if (!rung.came_round_twice(mark, mark)) {
        print("  RED: a matter two runs named read as one carried once\n", .{});
        return 1;
    }
    if (rung.came_round_twice(rung.minds_bytes(elder), mark)) {
        print("  RED: a mark about another matter counted as this one's second round\n", .{});
        return 1;
    }
    if (rung.came_round_twice(null, mark)) {
        print("  RED: a matter on its first round read as one carried twice\n", .{});
        return 1;
    }
    if (!rung.desist_holds(wall, wall) or rung.desist_holds(rung.walls_bytes(rung.minds_bytes(elder)), wall) or rung.desist_holds(null, wall)) {
        print("  RED: a wall read back out of the notes did not answer for itself\n", .{});
        return 1;
    }
    if (rung.walled_in(1, .bounds) != 1 or rung.walled_in(1, .relays) != 0) {
        print("  RED: a bounding was counted as a relaying, or the other way about\n", .{});
        return 1;
    }
    if (rung.walled_in(0, .bounds) != 0) {
        print("  RED: a matter on its first round was counted as walled\n", .{});
        return 1;
    }
    if (rung.relayed_in(1, .relays) != 1 or rung.relayed_in(1, .bounds) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    return link(rung, "check_desist_refusals");
}


pub fn check_desist_measure(comptime rung: type) u8 {
    if (rung.unbounded_relays(1, .relays) != 1) {
        print("  RED: a twice-carried impasse relayed again went uncounted\n", .{});
        return 1;
    }
    if (rung.unbounded_relays(1, .bounds) != 0) {
        print("  RED: a bounded matter still counted as one relayed again\n", .{});
        return 1;
    }
    // A matter on its first round is owed the next run's look, so it costs the
    // count nothing -- the harm this rung names is the second relay and every
    // relay after it.
    if (rung.unbounded_relays(0, .relays) != 0) {
        print("  RED: a first-round matter was charged an unbounded relay\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unnamed, fresh, mismatched, miscounted, misrecorded\n", .{});
    print("  the bounding this rung keeps: {s}\n", .{rung.desist_words(.bounds)});
    print("  what a relaying plan tells an operator: {s}\n", .{rung.desist_words(.relays)});
    print("  a wall carries seven bytes: the mark it bounds, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_beckon");
}


pub fn check_desist_refusals(comptime rung: type) u8 {
    if (rung.desist_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.DesistUnnamed) {
            print("  RED: a wall from a run that named nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a wall from a run that named nothing was allowed\n", .{});
        return 1;
    }
    if (rung.desist_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.DesistFresh) {
            print("  RED: a wall around a first-round matter refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a wall around a first-round matter was allowed\n", .{});
        return 1;
    }
    if (rung.desist_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.DesistMismatched) {
            print("  RED: a wall around a matter the reader never refused refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a wall around a matter the reader never refused was allowed\n", .{});
        return 1;
    }
    if (rung.desist_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.DesistMiscounted) {
            print("  RED: a matter both walled and relayed refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter both walled and relayed was allowed\n", .{});
        return 1;
    }
    if (rung.desist_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.DesistMiscounted) {
            print("  RED: a matter neither walled nor relayed refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter neither walled nor relayed was allowed\n", .{});
        return 1;
    }
    // And the honest pass: a matter named twice, walled once, counted once.
    if (rung.desist_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest bounding refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_desist_measure");
}


pub fn check_desist_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_desist(io);
    rung.clear_forbear(io);
    rung.clear_mind(io);
    if (rung.wall_standing(io) != null) {
        print("  RED: a wall stood where none had been built\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    // The run before today, standing in for itself: it named this matter and
    // handed it on, exactly as the rung below leaves a wire.
    rung.mind_note(io, held) catch |err| {
        print("  RED: an elder mark could not be seated: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.forbear_note(io, rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands)) catch |err| {
        print("  RED: an inherited impasse could not be seated: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.wall_note(io, mark) catch |err| {
        print("  RED: a wall could not be stood: {s}\n", .{@errorName(err)});
        return 1;
    };
    // The wall lands first, and the relay is stayed only after it stands.
    if (rung.hold_standing(io) == null) {
        print("  RED: a relay was stayed before the wall that bounds it stood\n", .{});
        return 1;
    }
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.wall_standing(io) orelse {
        print("  RED: a provisioning cleared the wall an operator reads\n", .{});
        return 1;
    };
    if (!rung.walls_carries(survived, mark)) {
        print("  RED: a wall carried past a provisioning stopped bounding its matter\n", .{});
        return 1;
    }
    if (rung.walls_rest(survived) != .stands) {
        print("  RED: a wall carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And only then is the relay stayed, which is the close rather than the act.
    rung.clear_forbear(io);
    if (rung.wall_standing(io) == null) {
        print("  RED: a wall fell with the relay it was only staying\n", .{});
        return 1;
    }
    rung.clear_desist(io);
    if (rung.wall_standing(io) != null) {
        print("  RED: a wall outlived the taking down of its own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  a wall survives a provisioning, and lands before the relay it stays comes down\n", .{});
    return link_wire(rung, "check_beckon_wire", io, sys);
}


pub fn check_dwell_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.dwell_note(io, 1) catch |err| {
        print("  RED: an age could not be written at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.dwell_published(io) orelse {
        print("  RED: a provisioning cleared the age it was told to leave\n", .{});
        return 1;
    };
    if (survived != 1) {
        print("  RED: an age carried past a provisioning read back as {d}\n", .{survived});
        return 1;
    }
    // A second season of standing, written the way a run writes it: read the
    // wire, climb by the run just stood, write, read back.
    const climbed = rung.stood_longer(survived);
    rung.dwell_note(io, climbed) catch |err| {
        print("  RED: a second season could not be written: {s}\n", .{@errorName(err)});
        return 1;
    };
    if (!rung.dwell_holds(rung.dwell_published(io), 2)) {
        print("  RED: a quarrel that stood two runs did not read as two\n", .{});
        return 1;
    }
    // The age falls with the quarrel, proven on the wire the withdrawal leaves.
    rung.release_standing(io);
    if (rung.dwell_published(io) != null) {
        print("  RED: an age outlived the quarrel it was counting\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.dwell_published(io) != null) {
        print("  RED: an age came back with the next provisioning\n", .{});
        return 1;
    }
    print("  an age survives a provisioning, and falls with the quarrel it counts\n", .{});
    return 0;
}


pub fn check_endure_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    // The notes are seated once first, so this fold writes into a plan that
    // exists rather than into a directory no run has opened yet.
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    if (rung.position_standing(io) != null) {
        print("  RED: a cleared plan still carried a quarrel\n", .{});
        return 1;
    }
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    // The whole point of the rung, read straight: every other note this
    // provisioning touched now stands at nothing, and this one stands where its
    // holder left it.
    if (rung.appeal_published(io) != null) {
        print("  RED: a provisioning left the last run's plea standing\n", .{});
        return 1;
    }
    const survived = rung.position_standing(io) orelse {
        print("  RED: a provisioning cleared the position it was told to leave\n", .{});
        return 1;
    };
    if (survived != .presses) {
        print("  RED: a carried position read back as {s}\n", .{rung.plea_words(survived)});
        return 1;
    }
    rung.clear_standing(io);
    if (rung.position_standing(io) != null) {
        print("  RED: a cleared position still stood\n", .{});
        return 1;
    }
    print("  a pressed quarrel survives a provisioning: {s}\n", .{rung.plea_words(.presses)});
    return 0;
}


pub fn check_forbear(comptime rung: type) u8 {
    const told = rung.knows_bytes(rung.anew_bytes(rung.inherited_matter));
    const refused = rung.rests_bytes(told, .stands);
    const held = rung.holds_bytes(refused);
    if (!rung.holds_carries(held, refused)) {
        print("  RED: a forbearance refused the very reply it was written from\n", .{});
        return 1;
    }
    if (rung.holds_rest(held) != .stands) {
        print("  RED: a forbearance carried a word other than the refusal that earned it\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a forbearance left over from an
    // earlier lap holds back on an older matter, and handing it on as today's
    // would spare the next run a question nobody refused this morning.
    const elder = rung.knows_bytes(rung.anew_bytes(rung.again_bytes(rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting))));
    if (rung.holds_carries(rung.holds_bytes(rung.rests_bytes(elder, .stands)), refused)) {
        print("  RED: a forbearance about an older matter was read as today's\n", .{});
        return 1;
    }
    if (rung.holds_carries(null, refused)) {
        print("  RED: an empty note read as a run that handed something on\n", .{});
        return 1;
    }
    if (rung.holds_rest(null) != null) {
        print("  RED: a note that was never written was read as a forbearance\n", .{});
        return 1;
    }
    if (!rung.forbear_holds(held, held) or rung.forbear_holds(rung.holds_bytes(rung.rests_bytes(told, .allays)), held) or rung.forbear_holds(null, held)) {
        print("  RED: the record half of this rung did not hold\n", .{});
        return 1;
    }
    if (rung.forborne_in(1, .forbears) != 1 or rung.forborne_in(1, .opens) != 0) {
        print("  RED: a standing matter was handed on under the wrong word\n", .{});
        return 1;
    }
    if (rung.forborne_in(0, .forbears) != 0) {
        print("  RED: a run reading no standing word handed one on anyway\n", .{});
        return 1;
    }
    if (rung.opened_in(1, .opens) != 1 or rung.opened_in(1, .forbears) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.opened_in(0, .opens) != 0) {
        print("  RED: a run reading no standing word left one open anyway\n", .{});
        return 1;
    }
    return link(rung, "check_forbear_refusals");
}


pub fn check_forbear_measure(comptime rung: type) u8 {
    if (rung.unhanded_matters(1, .opens) != 1) {
        print("  RED: a matter left standing with nothing handed on went uncounted\n", .{});
        return 1;
    }
    if (rung.unhanded_matters(1, .forbears) != 0) {
        print("  RED: a matter handed on still counted as one left standing\n", .{});
        return 1;
    }
    // A run whose reader put the matter to rest has no impasse to hand on, so
    // it costs the count nothing -- the harm this rung names is the refusal
    // actually read and the next run left to meet it from nothing.
    if (rung.unhanded_matters(0, .opens) != 0) {
        print("  RED: a run whose matter came to rest was charged an unhanded one\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unread, allayed, mismatched, miscounted, misrecorded\n", .{});
    print("  the forbearance this rung keeps: {s}\n", .{rung.forbear_words(.forbears)});
    print("  what an opening plan hands the next run: {s}\n", .{rung.forbear_words(.opens)});
    print("  a forbearance carries five bytes: the reply it holds back on, echoed back whole\n", .{});
    return link(rung, "check_mind");
}


pub fn check_forbear_refusals(comptime rung: type) u8 {
    if (rung.forbear_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.ForbearUnread) {
            print("  RED: a run that opened no reply refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that opened no reply handed an impasse on all the same\n", .{});
        return 1;
    }
    if (rung.forbear_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.ForbearAllayed) {
            print("  RED: a matter its reader put to rest refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a question already settled was handed on as an impasse\n", .{});
        return 1;
    }
    if (rung.forbear_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.ForbearMismatched) {
            print("  RED: a forbearance about some other matter refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a forbearance about some other matter was handed on as today's\n", .{});
        return 1;
    }
    if (rung.forbear_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.ForbearMiscounted) {
            print("  RED: a matter both handed on and left open refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter counted twice passed the count\n", .{});
        return 1;
    }
    if (rung.forbear_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.ForbearMiscounted) {
            print("  RED: a matter counted neither way refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter counted neither way passed the count\n", .{});
        return 1;
    }
    if (rung.forbear_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest forbearance refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_forbear_measure");
}


pub fn check_forbear_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_forbear(io);
    rung.clear_rests(io, rung.standing_address);
    rung.clear_recount(io, rung.standing_address);
    rung.clear_reweigh(io);
    rung.reweigh_note(io, rung.inherited_matter) catch |err| {
        print("  RED: a second look could not be receipted at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.anew_standing(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    const told = rung.knows_bytes(receipt);
    rung.recount_note(io, rung.standing_address, told) catch |err| {
        print("  RED: a reader could not be told at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    // The reader's own hand, written by the reader rather than by any run --
    // and this time the word is a refusal, which is what earns a forbearance.
    const refused = rung.rests_bytes(told, .stands);
    rung.rest_as_reader(io, rung.standing_address, refused) catch |err| {
        print("  RED: a reader could not reply in their own hand: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.forbear_note(io, refused) catch |err| {
        print("  RED: a forbearance could not be handed on at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.hold_standing(io) orelse {
        print("  RED: a provisioning cleared the forbearance a run handed on\n", .{});
        return 1;
    };
    if (!rung.holds_carries(survived, refused)) {
        print("  RED: a forbearance carried past a provisioning stopped naming its matter\n", .{});
        return 1;
    }
    if (rung.holds_rest(survived) != .stands) {
        print("  RED: a forbearance carried past a provisioning stopped naming its refusal\n", .{});
        return 1;
    }
    if (rung.rest_written(io, rung.standing_address) == null) {
        print("  RED: handing an impasse on took the reply it holds back on out of its reader's box\n", .{});
        return 1;
    }
    // And it comes down only on the word of the run that inherits it, never on
    // a provisioning and never on the falling of the telling beneath it.
    rung.clear_recount(io, rung.standing_address);
    if (rung.hold_standing(io) == null) {
        print("  RED: a forbearance fell with the telling its reader refused\n", .{});
        return 1;
    }
    rung.clear_forbear(io);
    if (rung.hold_standing(io) != null) {
        print("  RED: a forbearance stood after the run inheriting it took it down\n", .{});
        return 1;
    }
    rung.clear_rests(io, rung.standing_address);
    print("  a forbearance survives a provisioning, and comes down only on the word of the run that inherits it\n", .{});
    return link_wire(rung, "check_mind_wire", io, sys);
}


pub fn check_heed_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    if (rung.regard_published(io) != null) {
        print("  RED: a fresh plan already stood under a quarrel\n", .{});
        return 1;
    }
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.regard_note(io, .under) catch |err| {
        print("  RED: a regard could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const written = rung.regard_published(io) orelse {
        print("  RED: a published regard could not be read back\n", .{});
        return 1;
    };
    if (written != .under) {
        print("  RED: a published regard read back as {s}\n", .{rung.regard_words(written)});
        return 1;
    }
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    // The whole seam of this rung, read straight: the quarrel outlives the
    // provisioning and the word about it does not.
    if (rung.regard_published(io) != null) {
        print("  RED: a provisioning left the last run's regard standing\n", .{});
        return 1;
    }
    const survived = rung.position_standing(io) orelse {
        print("  RED: a provisioning cleared the position it was told to leave\n", .{});
        return 1;
    };
    if (survived != .presses) {
        print("  RED: a carried position read back as {s}\n", .{rung.plea_words(survived)});
        return 1;
    }
    rung.clear_standing(io);
    print("  a quarrel survives a provisioning and the word about it does not\n", .{});
    return 0;
}


pub fn check_meet(comptime rung: type) u8 {
    if (rung.met_in(1, .defers) != 0) {
        print("  RED: a deferring run met a debt it never looked at\n", .{});
        return 1;
    }
    if (rung.met_in(1, .meets) != 1) {
        print("  RED: a meeting run met {d} inherited debts\n", .{rung.met_in(1, .meets)});
        return 1;
    }
    if (rung.met_in(0, .meets) != 0) {
        print("  RED: a run inheriting nothing met a debt anyway\n", .{});
        return 1;
    }
    if (rung.deferred_in(1, .defers) != 1 or rung.deferred_in(1, .meets) != 0) {
        print("  RED: the other half of the count did not close on one debt\n", .{});
        return 1;
    }

    // The receipt's own two bytes, read back out of the debt they answer.
    const owed = rung.debt_bytes(.overrules, .short);
    const receipt = rung.met_bytes(owed);
    if (!rung.met_answers(receipt, owed)) {
        print("  RED: a receipt did not read back as one for its own debt\n", .{});
        return 1;
    }
    if (rung.met_answers(receipt, rung.debt_bytes(.upholds, .carried))) {
        print("  RED: a receipt for one admission read back as one for another\n", .{});
        return 1;
    }
    if (rung.met_answers(null, owed)) {
        print("  RED: a wire holding nothing read back as a debt met\n", .{});
        return 1;
    }
    // The finding a debt was taken over, read out of the receipt rather than
    // assumed of it, since a receipt that could not name its own finding would
    // tell a later run only that something had been answered.
    if (rung.met_over(receipt) != .overrules) {
        print("  RED: a receipt named some finding other than the one owed\n", .{});
        return 1;
    }
    if (rung.met_over(null) != null) {
        print("  RED: a wire holding nothing named a finding all the same\n", .{});
        return 1;
    }
    if (!rung.met_holds(receipt, receipt)) {
        print("  RED: a written receipt did not read back as the receipt it was\n", .{});
        return 1;
    }
    if (rung.met_holds(rung.met_bytes(rung.debt_bytes(.upholds, .carried)), receipt)) {
        print("  RED: a receipt for another admission read back as this one\n", .{});
        return 1;
    }
    if (rung.met_holds(null, receipt)) {
        print("  RED: a note holding nothing read back as a debt met\n", .{});
        return 1;
    }
    // And the act the receipt records: the debt is down, or it is not.
    if (!rung.debt_settled(null)) {
        print("  RED: a wire holding no debt read back as one still standing\n", .{});
        return 1;
    }
    if (rung.debt_settled(owed)) {
        print("  RED: a debt still on the wire read back as one taken down\n", .{});
        return 1;
    }
    return link(rung, "check_meet_refusals");
}


pub fn check_meet_measure(comptime rung: type) u8 {
    if (rung.unmet_debts(1, .defers) != 1) {
        print("  RED: an admission nobody looked at went uncounted\n", .{});
        return 1;
    }
    if (rung.unmet_debts(1, .meets) != 0) {
        print("  RED: a debt met still counted as one nobody looked at\n", .{});
        return 1;
    }
    // A run that inherited nothing owes the work no look, so it costs the count
    // nothing -- the harm this rung names is the admission a plan opened
    // holding and then read straight past.
    if (rung.unmet_debts(0, .defers) != 0) {
        print("  RED: a run inheriting nothing was charged an unmet debt\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unowed, unsettled, mismatched, miscounted, misrecorded\n", .{});
    print("  the meeting this rung keeps: {s}\n", .{rung.meet_words(.meets)});
    print("  what a bare plan leaves an operator: {s}\n", .{rung.meet_words(.defers)});
    print("  a receipt carries two bytes: the debt met, echoed back exactly as it stood\n", .{});
    return link(rung, "check_redress");
}


pub fn check_meet_refusals(comptime rung: type) u8 {
    // A run that inherited nothing has no admission to answer, and recording
    // one there would close a question no run ever opened.
    if (rung.meet_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.MeetUnowed) {
            print("  RED: a meeting over an empty wire refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan inheriting nothing was credited with meeting a debt\n", .{});
        return 1;
    }
    // Meeting is a claim about the work this run did, so a run with no outcome
    // of its own on the wire has met nothing, however willing it was.
    if (rung.meet_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.MeetUnsettled) {
            print("  RED: a meeting before any outcome refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that had settled nothing was credited with meeting a debt\n", .{});
        return 1;
    }
    // The rung itself: a receipt filed against some other admission, closing a
    // question nobody ever looked at.
    if (rung.meet_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.MeetMismatched) {
            print("  RED: a receipt for another admission refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run met one admission and closed the question on another\n", .{});
        return 1;
    }
    // The honesty of the count: every debt inherited is met or left deferred --
    // never both and never neither.
    if (rung.meet_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.MeetMiscounted) {
            print("  RED: a debt counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a debt met and deferred at once went uncounted\n", .{});
        return 1;
    }
    if (rung.meet_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.MeetMiscounted) {
            print("  RED: a debt counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a debt neither met nor deferred went uncounted\n", .{});
        return 1;
    }
    if (rung.meet_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: a meeting inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_meet_measure");
}


pub fn check_meet_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_owe(io);
    rung.clear_met(io);
    rung.seat_note(io, rung.plan_name, ".owe", &rung.inherited_debt) catch |err| {
        print("  RED: an earlier run's debt could not be seated at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const seated = rung.debt_standing(io) orelse {
        print("  RED: a seated debt could not be read back at all\n", .{});
        return 1;
    };
    rung.met_note(io, seated) catch |err| {
        print("  RED: a receipt could not be written at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_owe(io);
    if (!rung.debt_settled(rung.debt_standing(io))) {
        print("  RED: a met debt went on standing on the wire\n", .{});
        return 1;
    }
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.meeting_written(io) orelse {
        print("  RED: a provisioning cleared the receipt for a debt already met\n", .{});
        return 1;
    };
    if (!rung.met_answers(survived, rung.inherited_debt)) {
        print("  RED: a receipt carried past a provisioning stopped naming its debt\n", .{});
        return 1;
    }
    if (!rung.debt_settled(rung.debt_standing(io))) {
        print("  RED: a provisioning brought back a debt already met\n", .{});
        return 1;
    }
    // The receipt falls with the debt it answers, proven on the wire the plan
    // leaves when the whole argument beneath it comes down.
    rung.clear_met(io);
    if (rung.meeting_written(io) != null) {
        print("  RED: a receipt outlived the debt it was answering\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.meeting_written(io) != null) {
        print("  RED: a receipt came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a receipt survives a provisioning, and the debt it answers stays down\n", .{});
    return link_wire(rung, "check_redress_wire", io, sys);
}


pub fn check_mind(comptime rung: type) u8 {
    const told = rung.knows_bytes(rung.anew_bytes(rung.inherited_matter));
    const refused = rung.rests_bytes(told, .stands);
    const held = rung.holds_bytes(refused);
    const mark = rung.minds_bytes(held);
    if (!rung.minds_carries(mark, held)) {
        print("  RED: a mark refused the very forbearance it was written from\n", .{});
        return 1;
    }
    if (rung.minds_rest(mark) != .stands) {
        print("  RED: a mark carried a word other than the refusal it was handed\n", .{});
        return 1;
    }
    if (mark[rung.max_minds_bytes - 1] != rung.minded_byte) {
        print("  RED: a mark did not say it was one\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a mark left over from an earlier
    // lap names an older impasse, and reading that as today's would tell an
    // operator the plan opened holding a matter nobody handed it this morning.
    const elder = rung.knows_bytes(rung.anew_bytes(rung.again_bytes(rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting))));
    if (rung.minds_carries(rung.minds_bytes(rung.holds_bytes(rung.rests_bytes(elder, .stands))), held)) {
        print("  RED: a mark about an older impasse was read as today's\n", .{});
        return 1;
    }
    if (rung.minds_carries(null, held)) {
        print("  RED: an outcome naming nothing was read as naming an impasse\n", .{});
        return 1;
    }
    if (rung.minds_rest(null) != null) {
        print("  RED: an outcome naming nothing carried a word all the same\n", .{});
        return 1;
    }
    if (!rung.mind_holds(mark, mark) or rung.mind_holds(rung.minds_bytes(rung.holds_bytes(rung.rests_bytes(told, .allays))), mark) or rung.mind_holds(null, mark)) {
        print("  RED: a run believed a mark other than the one it published\n", .{});
        return 1;
    }
    if (rung.minded_in(1, .minds) != 1 or rung.minded_in(1, .begins) != 0) {
        print("  RED: a minding was counted as though nothing were named\n", .{});
        return 1;
    }
    if (rung.minded_in(0, .minds) != 0) {
        print("  RED: a run opening holding nothing named an impasse anyway\n", .{});
        return 1;
    }
    if (rung.begun_in(1, .begins) != 1 or rung.begun_in(1, .minds) != 0) {
        print("  RED: the other half of the count did not close as a fold\n", .{});
        return 1;
    }
    if (rung.begun_in(0, .begins) != 0) {
        print("  RED: a run opening holding nothing began a matter all the same\n", .{});
        return 1;
    }
    return link(rung, "check_mind_refusals");
}


pub fn check_mind_measure(comptime rung: type) u8 {
    if (rung.unminded_impasses(1, .begins) != 1) {
        print("  RED: an impasse inherited in silence went uncounted\n", .{});
        return 1;
    }
    if (rung.unminded_impasses(1, .minds) != 0) {
        print("  RED: an impasse named still counted as one inherited in silence\n", .{});
        return 1;
    }
    // A run the last one handed nothing has no impasse to name, so it costs the
    // count nothing -- the harm this rung names is the forbearance actually
    // inherited and the operator never told of it.
    if (rung.unminded_impasses(0, .begins) != 0) {
        print("  RED: a run handed no impasse was charged an unnamed one\n", .{});
        return 1;
    }

    print("  five refusals stand by name: uninherited, rested, mismatched, miscounted, misrecorded\n", .{});
    print("  the minding this rung keeps: {s}\n", .{rung.mind_words(.minds)});
    print("  what a beginning plan tells an operator: {s}\n", .{rung.mind_words(.begins)});
    print("  a mark carries six bytes: the forbearance it was handed, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_desist");
}


pub fn check_mind_refusals(comptime rung: type) u8 {
    if (rung.mind_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.MindUninherited) {
            print("  RED: a mark with no forbearance behind it refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run named an impasse nobody handed it\n", .{});
        return 1;
    }
    if (rung.mind_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.MindRested) {
            print("  RED: a settled matter named as an impasse refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run carried a closed argument forward as an impasse\n", .{});
        return 1;
    }
    if (rung.mind_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.MindMismatched) {
            print("  RED: a mark about another matter refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run named an impasse other than the one it opened holding\n", .{});
        return 1;
    }
    if (rung.mind_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.MindMiscounted) {
            print("  RED: an impasse counted twice refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an impasse both named and begun closed its count\n", .{});
        return 1;
    }
    if (rung.mind_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.MindMiscounted) {
            print("  RED: an impasse counted neither way refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an impasse neither named nor begun closed its count\n", .{});
        return 1;
    }
    if (rung.mind_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest minding was refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_mind_measure");
}


pub fn check_mind_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_mind(io);
    rung.clear_forbear(io);
    rung.clear_rests(io, rung.standing_address);
    rung.clear_recount(io, rung.standing_address);
    rung.clear_reweigh(io);
    rung.reweigh_note(io, rung.inherited_matter) catch |err| {
        print("  RED: a second look could not be receipted at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.anew_standing(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    const told = rung.knows_bytes(receipt);
    rung.recount_note(io, rung.standing_address, told) catch |err| {
        print("  RED: a telling could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    // The run before this one, standing in: a reader refused a second time, and
    // that run handed the impasse forward rather than letting it die.
    const refused = rung.rests_bytes(told, .stands);
    rung.rest_as_reader(io, rung.standing_address, refused) catch |err| {
        print("  RED: a reader could not reply in their own hand: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.forbear_note(io, refused) catch |err| {
        print("  RED: an impasse could not be handed on at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const handed = rung.hold_standing(io) orelse {
        print("  RED: a seated forbearance could not be read back at all\n", .{});
        return 1;
    };
    rung.mind_note(io, handed) catch |err| {
        print("  RED: an inherited impasse could not be named at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    // The order that makes the naming safe, read on the wire: the mark stands
    // while the forbearance it names still stands, so nothing is ever gone
    // before it is recorded.
    if (rung.hold_standing(io) == null) {
        print("  RED: a forbearance came down before the mark that names it landed\n", .{});
        return 1;
    }
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.mind_published(io) orelse {
        print("  RED: a provisioning cleared the mark an operator reads\n", .{});
        return 1;
    };
    if (!rung.minds_carries(survived, handed)) {
        print("  RED: a mark carried past a provisioning stopped naming its impasse\n", .{});
        return 1;
    }
    if (rung.minds_rest(survived) != .stands) {
        print("  RED: a mark carried past a provisioning forgot the word it was handed\n", .{});
        return 1;
    }
    // And only then does the inheritance come down, which is the close rather
    // than the act.
    rung.clear_forbear(io);
    if (rung.mind_published(io) == null) {
        print("  RED: a mark fell with the forbearance it was only reporting on\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    if (rung.mind_published(io) != null) {
        print("  RED: a mark outlived the taking down of its own note\n", .{});
        return 1;
    }
    rung.clear_rests(io, rung.standing_address);
    print("  a mark survives a provisioning, and lands before the impasse it names comes down\n", .{});
    return link_wire(rung, "check_desist_wire", io, sys);
}


pub fn check_owe_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_deem(io);
    rung.clear_avow(io);
    rung.clear_owe(io);
    rung.deem_note(io, .upholds) catch |err| {
        print("  RED: a finding could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.avow_note(io, .upholds, .concedes) catch |err| {
        print("  RED: a plan could not concede at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.owe_note(io, .upholds, .carried) catch |err| {
        print("  RED: a debt could not be booked at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.debt_standing(io) orelse {
        print("  RED: a provisioning cleared the debt a run booked to outlive it\n", .{});
        return 1;
    };
    if (!rung.debt_answers(survived, .upholds)) {
        print("  RED: a debt carried past a provisioning stopped naming its concession\n", .{});
        return 1;
    }
    if (rung.debt_under(survived) != .carried) {
        print("  RED: a debt carried past a provisioning forgot the outcome it was taken under\n", .{});
        return 1;
    }
    // The debt falls with the concession, proven on the wire the plan leaves
    // when it takes its own word and the finding beneath it down.
    rung.clear_deem(io);
    rung.clear_avow(io);
    rung.clear_owe(io);
    if (rung.debt_standing(io) != null) {
        print("  RED: a debt outlived the concession it was carrying\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.debt_standing(io) != null) {
        print("  RED: a debt came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a debt survives a provisioning, and falls with the concession it carries\n", .{});
    return 0;
}


pub fn check_recount(comptime rung: type) u8 {
    const receipt = rung.anew_bytes(rung.inherited_matter);
    const carried = rung.knows_bytes(receipt);
    if (!rung.knows_answers(carried, receipt)) {
        print("  RED: a telling refused the very receipt it was written from\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a telling left over from an
    // earlier lap names an older matter, and reading it as today's would tell a
    // reader their newest reopening had been answered by a run before today.
    const elder = rung.anew_bytes(rung.again_bytes(rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting)));
    if (rung.knows_answers(rung.knows_bytes(elder), receipt)) {
        print("  RED: a telling about an older matter was read as today's\n", .{});
        return 1;
    }
    if (rung.knows_answers(null, receipt)) {
        print("  RED: an empty box read as a reader told\n", .{});
        return 1;
    }
    if (!rung.recount_holds(carried, carried) or rung.recount_holds(rung.knows_bytes(elder), carried)) {
        print("  RED: the record half of this rung did not hold\n", .{});
        return 1;
    }
    if (rung.recounted_in(1, .tells) != 1 or rung.recounted_in(1, .withholds) != 0) {
        print("  RED: a second look was told of under the wrong reading\n", .{});
        return 1;
    }
    if (rung.recounted_in(0, .tells) != 0) {
        print("  RED: a run that looked at nothing told somebody anyway\n", .{});
        return 1;
    }
    if (rung.unsent_looks_in(1, .withholds) != 1 or rung.unsent_looks_in(1, .tells) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.unsent_looks_in(0, .withholds) != 0) {
        print("  RED: a run that looked at nothing kept a telling back anyway\n", .{});
        return 1;
    }
    return link(rung, "check_recount_refusals");
}


pub fn check_recount_measure(comptime rung: type) u8 {
    if (rung.untold_looks(1, .withholds) != 1) {
        print("  RED: a second look nobody heard of went uncounted\n", .{});
        return 1;
    }
    if (rung.untold_looks(1, .tells) != 0) {
        print("  RED: a look carried home still counted as one nobody heard of\n", .{});
        return 1;
    }
    // A run that looked at nothing owes nobody an account of it, so it costs the
    // count nothing -- the harm this rung names is the look actually made and
    // filed where only this plan ever reads.
    if (rung.untold_looks(0, .withholds) != 0) {
        print("  RED: a run that looked at nothing was charged an untold look\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unlooked, unaddressed, mismatched, miscounted, misrecorded\n", .{});
    print("  the telling this rung keeps: {s}\n", .{rung.recount_words(.tells)});
    print("  what a withholding plan never owes: {s}\n", .{rung.recount_words(.withholds)});
    print("  a telling carries four bytes: the matter looked at again, echoed back whole\n", .{});
    return link(rung, "check_allay");
}


pub fn check_recount_refusals(comptime rung: type) u8 {
    if (rung.recount_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.RecountUnlooked) {
            print("  RED: a run that looked at nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that looked at nothing told somebody anyway\n", .{});
        return 1;
    }
    if (rung.recount_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.RecountUnaddressed) {
            print("  RED: a telling with nowhere to go refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a telling bound nowhere set out all the same\n", .{});
        return 1;
    }
    if (rung.recount_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.RecountMismatched) {
            print("  RED: a telling about some other matter refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a telling about some other matter was carried as today's\n", .{});
        return 1;
    }
    if (rung.recount_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.RecountMiscounted) {
            print("  RED: a look both told of and kept refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a look counted twice passed the count\n", .{});
        return 1;
    }
    if (rung.recount_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.RecountMiscounted) {
            print("  RED: a look counted neither way refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a look counted neither way passed the count\n", .{});
        return 1;
    }
    if (rung.recount_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest telling refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_recount_measure");
}


pub fn check_recount_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_recount(io, rung.standing_address);
    rung.clear_reweigh(io);
    rung.reweigh_note(io, rung.inherited_matter) catch |err| {
        print("  RED: a second look could not be receipted at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.anew_standing(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    rung.recount_note(io, rung.standing_address, receipt) catch |err| {
        print("  RED: a telling could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.recounted_to(io, rung.standing_address) orelse {
        print("  RED: a provisioning cleared the telling a reader was carried\n", .{});
        return 1;
    };
    if (!rung.knows_answers(survived, receipt)) {
        print("  RED: a telling carried past a provisioning stopped naming its look\n", .{});
        return 1;
    }
    if (rung.anew_standing(io) == null) {
        print("  RED: a provisioning swept the receipt a telling copies\n", .{});
        return 1;
    }
    // The telling falls with the receipt it copies, proven on the wire the plan
    // leaves when the second look beneath it comes down.
    rung.clear_reweigh(io);
    rung.clear_recount(io, rung.standing_address);
    if (rung.recounted_to(io, rung.standing_address) != null) {
        print("  RED: a telling outlived the second look it was copying\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.recounted_to(io, rung.standing_address) != null) {
        print("  RED: a telling came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a telling survives a provisioning, and falls with the second look it copies\n", .{});
    return link_wire(rung, "check_allay_wire", io, sys);
}


pub fn check_redress(comptime rung: type) u8 {
    if (rung.redressed_in(1, .hollow) != 0) {
        print("  RED: a hollow run said what a look found after all\n", .{});
        return 1;
    }
    if (rung.redressed_in(1, .redresses) != 1) {
        print("  RED: a redressing run spoke for {d} meetings\n", .{rung.redressed_in(1, .redresses)});
        return 1;
    }
    if (rung.redressed_in(0, .redresses) != 0) {
        print("  RED: a run that met nothing reported on a look anyway\n", .{});
        return 1;
    }
    if (rung.closed_bare_in(1, .hollow) != 1 or rung.closed_bare_in(1, .redresses) != 0) {
        print("  RED: the other half of the count did not close on one meeting\n", .{});
        return 1;
    }

    // The two upshots, each surviving the byte it rides as.
    if (rung.upshot_of_byte(rung.upshot_byte(.sound)) != .sound) {
        print("  RED: a work found sound did not survive the byte it rides as\n", .{});
        return 1;
    }
    if (rung.upshot_of_byte(rung.upshot_byte(.righted)) != .righted) {
        print("  RED: a work put right did not survive the byte it rides as\n", .{});
        return 1;
    }
    if (rung.upshot_of_byte('x') != null) {
        print("  RED: a byte naming no upshot at all read as one\n", .{});
        return 1;
    }

    // The redress's own three bytes, read back out of the meeting they report on.
    const met = rung.met_bytes(rung.debt_bytes(.overrules, .short));
    const spoken = rung.redress_bytes(met, .righted);
    if (!rung.redress_answers(spoken, met)) {
        print("  RED: a finding did not read back as one about its own meeting\n", .{});
        return 1;
    }
    if (rung.redress_answers(spoken, rung.met_bytes(rung.debt_bytes(.upholds, .carried)))) {
        print("  RED: a finding about one meeting read back as one about another\n", .{});
        return 1;
    }
    if (rung.redress_answers(null, met)) {
        print("  RED: a wire holding nothing read back as a meeting reported on\n", .{});
        return 1;
    }
    if (rung.redress_upshot(spoken) != .righted) {
        print("  RED: a finding named some upshot other than the one reached\n", .{});
        return 1;
    }
    if (rung.redress_upshot(null) != null) {
        print("  RED: a wire holding nothing named an upshot all the same\n", .{});
        return 1;
    }
    if (!rung.redress_holds(spoken, spoken)) {
        print("  RED: a written finding did not read back as the finding it was\n", .{});
        return 1;
    }
    if (rung.redress_holds(rung.redress_bytes(met, .sound), spoken)) {
        print("  RED: a work found sound read back as a work put right\n", .{});
        return 1;
    }
    if (rung.redress_holds(null, spoken)) {
        print("  RED: a note holding nothing read back as a meeting reported on\n", .{});
        return 1;
    }

    // The stronger claim and its burden, weighed as a fold of its own.
    if (!rung.upshot_earned(.righted, .carried)) {
        print("  RED: a run that carried its plan out could not say it put the work right\n", .{});
        return 1;
    }
    if (rung.upshot_earned(.righted, .short)) {
        print("  RED: a run reporting itself short claimed it had put the work right\n", .{});
        return 1;
    }
    if (!rung.upshot_earned(.sound, .short)) {
        print("  RED: a run reporting itself short could not say the work stands sound\n", .{});
        return 1;
    }
    if (rung.upshot_earned(.sound, null) or rung.upshot_earned(.righted, null)) {
        print("  RED: a run that published no outcome at all said what its look found\n", .{});
        return 1;
    }
    return link(rung, "check_redress_refusals");
}


pub fn check_redress_measure(comptime rung: type) u8 {
    if (rung.hollow_meetings(1, .hollow) != 1) {
        print("  RED: a meeting that said nothing went uncounted\n", .{});
        return 1;
    }
    if (rung.hollow_meetings(1, .redresses) != 0) {
        print("  RED: a meeting spoken for still counted as one closed in silence\n", .{});
        return 1;
    }
    // A run that met nothing has no look to report on, so it costs the count
    // nothing -- the harm this rung names is the admission taken up, closed, and
    // never once reported on.
    if (rung.hollow_meetings(0, .hollow) != 0) {
        print("  RED: a run that met nothing was charged a hollow meeting\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unmet, unrighted, mismatched, miscounted, misrecorded\n", .{});
    print("  the finding this rung keeps: {s}\n", .{rung.redress_words(.redresses)});
    print("  what a bare plan leaves an operator: {s}\n", .{rung.redress_words(.hollow)});
    print("  a redress carries three bytes: the meeting reported on, and what the look came to\n", .{});
    print("  the stronger of the two upshots: {s}\n", .{rung.upshot_words(.righted)});
    print("  the honest other: {s}\n", .{rung.upshot_words(.sound)});
    return link(rung, "check_apprise");
}


pub fn check_redress_refusals(comptime rung: type) u8 {
    // A run that met nothing has no look to report on, and a finding filed there
    // would answer a question this plan never asked.
    if (rung.redress_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.RedressUnmet) {
            print("  RED: a finding over an unmet debt refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that met nothing was credited with saying what it found\n", .{});
        return 1;
    }
    // The stronger of the two claims bears its own burden: a run that came up
    // short has put nothing right this lap, however sincerely it looked.
    if (rung.redress_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.RedressUnrighted) {
            print("  RED: an unearned claim refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that carried nothing out claimed it had put the work right\n", .{});
        return 1;
    }
    // The rung itself: a finding filed against some other meeting, answering a
    // question this look never asked.
    if (rung.redress_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.RedressMismatched) {
            print("  RED: a finding about another meeting refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run reported on one meeting and answered for another\n", .{});
        return 1;
    }
    // The honesty of the count: every debt met is redressed or left bare --
    // never both and never neither.
    if (rung.redress_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.RedressMiscounted) {
            print("  RED: a meeting counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a meeting spoken for and left silent at once went uncounted\n", .{});
        return 1;
    }
    if (rung.redress_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.RedressMiscounted) {
            print("  RED: a meeting counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a meeting neither spoken for nor left bare went uncounted\n", .{});
        return 1;
    }
    if (rung.redress_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: a finding inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_redress_measure");
}


pub fn check_redress_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_met(io);
    rung.clear_redress(io);
    rung.met_note(io, rung.inherited_debt) catch |err| {
        print("  RED: a receipt could not be seated at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const receipt = rung.meeting_written(io) orelse {
        print("  RED: a seated receipt could not be read back at all\n", .{});
        return 1;
    };
    rung.redress_note(io, receipt, .righted) catch |err| {
        print("  RED: a finding could not be written at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.redress_written(io) orelse {
        print("  RED: a provisioning cleared the finding for a meeting already made\n", .{});
        return 1;
    };
    if (!rung.redress_answers(survived, receipt)) {
        print("  RED: a finding carried past a provisioning stopped naming its meeting\n", .{});
        return 1;
    }
    if (rung.redress_upshot(survived) != .righted) {
        print("  RED: a finding carried past a provisioning forgot what the look came to\n", .{});
        return 1;
    }
    if (rung.meeting_written(io) == null) {
        print("  RED: a provisioning swept the receipt a finding reports on\n", .{});
        return 1;
    }
    // The finding falls with the meeting it reports on, proven on the wire the
    // plan leaves when the whole argument beneath it comes down.
    rung.clear_met(io);
    rung.clear_redress(io);
    if (rung.redress_written(io) != null) {
        print("  RED: a finding outlived the meeting it was reporting on\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.redress_written(io) != null) {
        print("  RED: a finding came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a finding survives a provisioning, and falls with the meeting it reports on\n", .{});
    return link_wire(rung, "check_apprise_wire", io, sys);
}


pub fn check_refer(comptime rung: type) u8 {
    // The count, which every later number closes on.
    if (rung.referred_in(1, .referred) != 1) {
        print("  RED: a referring run kept its one long-standing quarrel inside\n", .{});
        return 1;
    }
    if (rung.referred_in(1, .unheard) != 0) {
        print("  RED: an unheard run carried a case out all the same\n", .{});
        return 1;
    }
    if (rung.referred_in(0, .referred) != 0) {
        print("  RED: a run with nothing standing long carried a case out\n", .{});
        return 1;
    }
    if (rung.unreferred_in(1, .unheard) != 1) {
        print("  RED: a quarrel kept inside the argument counted as carried out\n", .{});
        return 1;
    }
    if (rung.unreferred_in(1, .referred) != 0) {
        print("  RED: a referred quarrel still counted as kept inside\n", .{});
        return 1;
    }

    // The one comparison this rung exists to make, in both directions.
    if (!rung.is_party("desk", "desk")) {
        print("  RED: a forum naming the reader themself read as a third hand\n", .{});
        return 1;
    }
    if (rung.is_party("bench", "desk")) {
        print("  RED: a hand outside the argument read as a party to it\n", .{});
        return 1;
    }

    // The record half, in all three directions.
    const case = rung.referral_bytes(.carried, .loud, 4);
    if (!rung.refer_holds(case, case)) {
        print("  RED: a case did not read back as the case it was\n", .{});
        return 1;
    }
    if (rung.refer_holds(rung.referral_bytes(.short, .loud, 4), case)) {
        print("  RED: a case naming another settlement read back as this one\n", .{});
        return 1;
    }
    if (rung.refer_holds(null, case)) {
        print("  RED: a desk holding nothing read back as one holding the case\n", .{});
        return 1;
    }
    return link(rung, "check_refer_refusals");
}


pub fn check_refer_measure(comptime rung: type) u8 {
    if (rung.unheard_outside(1, rung.long_standing_runs, .unheard) != 1) {
        print("  RED: a long-standing quarrel nobody outside saw went uncounted\n", .{});
        return 1;
    }
    if (rung.unheard_outside(1, rung.long_standing_runs, .referred) != 0) {
        print("  RED: a referred quarrel still counted as unheard outside\n", .{});
        return 1;
    }
    // A quarrel raised this morning is fairly left with the people having it,
    // so it costs the count nothing -- the harm this rung names is the old
    // position no third hand ever sees.
    if (rung.unheard_outside(1, 0, .unheard) != 0) {
        print("  RED: a quarrel of no age at all counted as unheard outside\n", .{});
        return 1;
    }
    if (rung.unheard_outside(0, rung.max_dwell_runs, .unheard) != 0) {
        print("  RED: a run with nothing standing owed a third hand a case\n", .{});
        return 1;
    }

    print("  five refusals stand by name: early, unaddressed, party, miscounted, misrecorded\n", .{});
    print("  the referring this rung keeps: {s}\n", .{rung.refer_words(.referred)});
    print("  a case carries three facts: the plan's word, the standing, and the age\n", .{});
    return link(rung, "check_deem");
}


pub fn check_refer_refusals(comptime rung: type) u8 {
    if (rung.refer_refusal(0, 1, 0, true, false)) |why| {
        if (why != error.ReferEarly) {
            print("  RED: an early referral refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run referred a quarrel nobody holds\n", .{});
        return 1;
    }
    if (rung.refer_refusal(1, 1, 0, false, false)) |why| {
        if (why != error.ReferUnaddressed) {
            print("  RED: an unaddressed referral refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run carried a case to a forum nobody named\n", .{});
        return 1;
    }
    // The rung itself, refused by name: a forum naming somebody already in the
    // argument has heard nothing, and a case landing there wears the look of a
    // hearing while being none.
    if (rung.refer_refusal(1, 1, 0, true, true)) |why| {
        if (why != error.ReferParty) {
            print("  RED: a referral to a party refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run referred a quarrel to somebody already holding it\n", .{});
        return 1;
    }
    // The honesty of the count: every long-standing position is referred or
    // kept inside the argument -- never both and never neither.
    if (rung.refer_refusal(1, 1, 1, true, false)) |why| {
        if (why != error.ReferMiscounted) {
            print("  RED: a quarrel counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a quarrel referred and kept at once went uncounted\n", .{});
        return 1;
    }
    if (rung.refer_refusal(1, 0, 0, true, false)) |why| {
        if (why != error.ReferMiscounted) {
            print("  RED: a quarrel counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a quarrel neither referred nor kept went uncounted\n", .{});
        return 1;
    }
    if (rung.refer_refusal(1, 1, 0, true, false)) |why| {
        print("  RED: a referral inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_refer_measure");
}


pub fn check_refer_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    rung.clear_case(io, rung.standing_forum);
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const case = rung.referral_bytes(.carried, .loud, rung.long_standing_runs + 1);
    rung.refer_note(io, rung.standing_forum, case) catch |err| {
        print("  RED: a case could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    if (!rung.refer_holds(rung.case_delivered(io, rung.standing_forum), case)) {
        print("  RED: a provisioning swept a case off a desk it never owned\n", .{});
        return 1;
    }
    // The case outlives the quarrel, which is the whole difference between a
    // record kept by a party and a record handed to somebody who is not one.
    rung.release_standing(io);
    if (!rung.refer_holds(rung.case_delivered(io, rung.standing_forum), case)) {
        print("  RED: a withdrawal reached onto a third hand's desk and took the case back\n", .{});
        return 1;
    }
    rung.clear_case(io, rung.standing_forum);
    if (rung.case_delivered(io, rung.standing_forum) != null) {
        print("  RED: a desk cleared by its own hand still held the case\n", .{});
        return 1;
    }
    print("  a case survives a provisioning, and outlives the quarrel it was built from\n", .{});
    return 0;
}


pub fn check_relent_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.position_standing(io) orelse {
        print("  RED: a provisioning cleared the position it was told to leave\n", .{});
        return 1;
    };
    if (survived != .presses) {
        print("  RED: a carried position read back as {s}\n", .{rung.plea_words(survived)});
        return 1;
    }
    rung.release_standing(io);
    if (!rung.note_cleared(rung.position_standing(io))) {
        print("  RED: a withdrawn quarrel was still standing where it was taken down\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (!rung.note_cleared(rung.position_standing(io))) {
        print("  RED: a withdrawn quarrel came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a quarrel survives a provisioning, and its withdrawal survives one too\n", .{});
    return 0;
}


pub fn check_reopen(comptime rung: type) u8 {
    const word = rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 'c' }), .righted)), .wanting);
    const booked = rung.again_bytes(word);
    if (!rung.again_carries(booked, word)) {
        print("  RED: a note refused the very word it was written from\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a note left over from an earlier
    // lap reopens an older answer, and reading it as today's would tell an
    // operator this run acted on a verdict it never read.
    const elder = rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting);
    if (rung.again_carries(rung.again_bytes(elder), word)) {
        print("  RED: a note about an older answer was read as today's\n", .{});
        return 1;
    }
    // Two honest words, and only one of them opens anything.
    const settled = rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 'c' }), .righted)), .settles);
    if (rung.again_carries(rung.again_bytes(settled), word)) {
        print("  RED: a satisfied reader's word was read as a short one\n", .{});
        return 1;
    }
    if (rung.again_carries(null, word)) {
        print("  RED: a matter with no note at all read as taken up\n", .{});
        return 1;
    }
    if (!rung.reopen_holds(booked, word) or rung.reopen_holds(rung.again_bytes(elder), word)) {
        print("  RED: the record half of this rung did not hold\n", .{});
        return 1;
    }
    if (rung.taken_up_in(1, .takes_up) != 1 or rung.taken_up_in(1, .closes) != 0) {
        print("  RED: a short word was taken up under the wrong reading\n", .{});
        return 1;
    }
    if (rung.taken_up_in(0, .takes_up) != 0) {
        print("  RED: a run nobody called short took a matter up anyway\n", .{});
        return 1;
    }
    if (rung.left_closed_in(1, .closes) != 1 or rung.left_closed_in(1, .takes_up) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.left_closed_in(0, .closes) != 0) {
        print("  RED: a run nobody called short left a word closed anyway\n", .{});
        return 1;
    }
    return link(rung, "check_reopen_refusals");
}


pub fn check_reopen_measure(comptime rung: type) u8 {
    if (rung.unheeded_words(1, .closes) != 1) {
        print("  RED: a short word that opened nothing went uncounted\n", .{});
        return 1;
    }
    if (rung.unheeded_words(1, .takes_up) != 0) {
        print("  RED: a short word taken up still counted as one that opened nothing\n", .{});
        return 1;
    }
    // A reader who says the answer settles the matter has asked for nothing, so
    // it costs the count nothing -- the harm this rung names is the word calling
    // an answer short and costing the plan not one further look.
    if (rung.unheeded_words(0, .closes) != 0) {
        print("  RED: a satisfied reader was charged an unheeded word\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unweighed, settled, mismatched, miscounted, misrecorded\n", .{});
    print("  the reading this rung keeps: {s}\n", .{rung.reopen_words(.takes_up)});
    print("  what a closing plan never owes: {s}\n", .{rung.reopen_words(.closes)});
    print("  a reopening note carries four bytes: the reader's own word, echoed back whole\n", .{});
    return link(rung, "check_reweigh");
}


pub fn check_reopen_refusals(comptime rung: type) u8 {
    if (rung.reopen_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.ReopenUnweighed) {
            print("  RED: a run that asked nobody refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that asked nobody took a matter up anyway\n", .{});
        return 1;
    }
    if (rung.reopen_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.ReopenSettled) {
            print("  RED: a satisfied reader's word refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a satisfied reader's word opened a matter anyway\n", .{});
        return 1;
    }
    if (rung.reopen_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.ReopenMismatched) {
            print("  RED: a note about some other word refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a note about some other word was taken as today's\n", .{});
        return 1;
    }
    if (rung.reopen_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.ReopenMiscounted) {
            print("  RED: a word both taken up and left closed refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a word counted twice passed the count\n", .{});
        return 1;
    }
    if (rung.reopen_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.ReopenMiscounted) {
            print("  RED: a word neither taken up nor left closed refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a word counted neither way passed the count\n", .{});
        return 1;
    }
    if (rung.reopen_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest reopening refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_reopen_measure");
}


pub fn check_reopen_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_suits(io, rung.standing_address);
    rung.clear_reopen(io);
    rung.clear_apprise(io, rung.standing_address);
    const carried = rung.found_bytes(rung.redress_bytes(rung.met_bytes(rung.inherited_debt), .righted));
    rung.apprise_note(io, rung.standing_address, carried) catch |err| {
        print("  RED: a finding could not be carried to its reader at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.weigh_as_reader(io, rung.standing_address, rung.suits_bytes(carried, .wanting)) catch |err| {
        print("  RED: a reader could not weigh the answer at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const said = rung.worth_written(io, rung.standing_address) orelse {
        print("  RED: a reader's own short word could not be read back at all\n", .{});
        return 1;
    };
    rung.reopen_note(io, said) catch |err| {
        print("  RED: a matter could not be taken up again at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    if (!rung.reopen_holds(rung.again_standing(io), said)) {
        print("  RED: a matter carried past a provisioning stopped naming its word\n", .{});
        return 1;
    }
    if (rung.worth_written(io, rung.standing_address) == null) {
        print("  RED: taking a matter up again reached into its reader's box\n", .{});
        return 1;
    }
    // The note comes down with the word it carries, so a later run never inherits
    // a matter opened by a verdict this wire has forgotten.
    rung.clear_suits(io, rung.standing_address);
    rung.clear_reopen(io);
    if (rung.again_standing(io) != null) {
        print("  RED: a reopened matter outlived the word that opened it\n", .{});
        return 1;
    }
    rung.clear_apprise(io, rung.standing_address);
    print("  a reopened matter survives a provisioning, and falls with the word that opened it\n", .{});
    return link_wire(rung, "check_reweigh_wire", io, sys);
}


pub fn check_reweigh(comptime rung: type) u8 {
    const opened = rung.inherited_matter;
    const receipt = rung.anew_bytes(opened);
    if (!rung.anew_answers(receipt, opened)) {
        print("  RED: a receipt refused the very matter it was written from\n", .{});
        return 1;
    }
    // The whole point of the rung, as a fold: a receipt left over from an earlier
    // lap answers an older matter, and reading it as today's would tell an
    // operator this run looked again at a question nobody reopened.
    const elder = rung.again_bytes(rung.suits_bytes(rung.found_bytes(rung.redress_bytes(rung.met_bytes([_]u8{ 'd', 's' }), .righted)), .wanting));
    if (rung.anew_answers(rung.anew_bytes(elder), opened)) {
        print("  RED: a receipt about an older matter was read as today's\n", .{});
        return 1;
    }
    if (rung.anew_answers(null, opened)) {
        print("  RED: a matter with no receipt at all read as looked at again\n", .{});
        return 1;
    }
    if (!rung.reweigh_holds(receipt, receipt) or rung.reweigh_holds(rung.anew_bytes(elder), receipt)) {
        print("  RED: the record half of this rung did not hold\n", .{});
        return 1;
    }
    // The taking down is the act, and the receipt is only its record.
    if (!rung.matter_closed(null) or rung.matter_closed(opened)) {
        print("  RED: a matter still standing read as taken down\n", .{});
        return 1;
    }
    if (rung.looked_in(1, .looks) != 1 or rung.looked_in(1, .passes) != 0) {
        print("  RED: a reopened matter was looked at under the wrong reading\n", .{});
        return 1;
    }
    if (rung.looked_in(0, .looks) != 0) {
        print("  RED: a run inheriting nothing looked again anyway\n", .{});
        return 1;
    }
    if (rung.passed_in(1, .passes) != 1 or rung.passed_in(1, .looks) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.passed_in(0, .passes) != 0) {
        print("  RED: a run inheriting nothing passed a matter over anyway\n", .{});
        return 1;
    }
    return link(rung, "check_reweigh_refusals");
}


pub fn check_reweigh_measure(comptime rung: type) u8 {
    if (rung.unlooked_matters(1, .passes) != 1) {
        print("  RED: a reopened matter nobody looked at went uncounted\n", .{});
        return 1;
    }
    if (rung.unlooked_matters(1, .looks) != 0) {
        print("  RED: a matter looked at again still counted as one nobody looked at\n", .{});
        return 1;
    }
    // A plan nobody reopened owes no second look to anybody, so it costs the
    // count nothing -- the harm this rung names is the matter standing open in a
    // plan's own notes and costing the run that finds it not one further look.
    if (rung.unlooked_matters(0, .passes) != 0) {
        print("  RED: a plan nobody reopened was charged an unlooked-at matter\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unopened, unsettled, mismatched, miscounted, misrecorded\n", .{});
    print("  the reading this rung keeps: {s}\n", .{rung.reweigh_words(.looks)});
    print("  what a passing plan never owes: {s}\n", .{rung.reweigh_words(.passes)});
    print("  a second look's receipt carries four bytes: the reopened matter, echoed back whole\n", .{});
    return link(rung, "check_recount");
}


pub fn check_reweigh_refusals(comptime rung: type) u8 {
    if (rung.reweigh_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.ReweighUnopened) {
            print("  RED: a run inheriting nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run inheriting nothing looked again anyway\n", .{});
        return 1;
    }
    if (rung.reweigh_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.ReweighUnsettled) {
            print("  RED: a run that finished nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run that finished nothing filed a second look anyway\n", .{});
        return 1;
    }
    if (rung.reweigh_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.ReweighMismatched) {
            print("  RED: a receipt about some other matter refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a receipt about some other matter was taken as today's\n", .{});
        return 1;
    }
    if (rung.reweigh_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.ReweighMiscounted) {
            print("  RED: a matter both looked at and passed over refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter counted twice passed the count\n", .{});
        return 1;
    }
    if (rung.reweigh_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.ReweighMiscounted) {
            print("  RED: a matter neither looked at nor passed over refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a matter counted neither way passed the count\n", .{});
        return 1;
    }
    if (rung.reweigh_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest second look refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_reweigh_measure");
}


pub fn check_reweigh_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_reweigh(io);
    rung.clear_reopen(io);
    rung.reopen_note(io, rung.inherited_matter) catch |err| {
        print("  RED: a matter could not be seated as reopened at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const opened = rung.again_standing(io) orelse {
        print("  RED: a reopened matter could not be read back at all\n", .{});
        return 1;
    };
    rung.reweigh_note(io, opened) catch |err| {
        print("  RED: a second look could not be receipted at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_reopen(io);
    if (!rung.matter_closed(rung.again_standing(io))) {
        print("  RED: a matter answered by a receipt stayed standing\n", .{});
        return 1;
    }
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    if (!rung.reweigh_holds(rung.anew_standing(io), rung.anew_bytes(opened))) {
        print("  RED: a receipt carried past a provisioning stopped naming its matter\n", .{});
        return 1;
    }
    if (!rung.matter_closed(rung.again_standing(io))) {
        print("  RED: a matter taken down came back with a provisioning\n", .{});
        return 1;
    }
    rung.clear_reweigh(io);
    if (rung.anew_standing(io) != null) {
        print("  RED: a second look's receipt outlived the matter it answered\n", .{});
        return 1;
    }
    print("  a second look survives a provisioning, and the matter it answers stays down\n", .{});
    return link_wire(rung, "check_recount_wire", io, sys);
}


pub fn check_suffice(comptime rung: type) u8 {
    if (rung.weighed_in(1, .unasked) != 0) {
        print("  RED: an unasking run read somebody's word after all\n", .{});
        return 1;
    }
    if (rung.weighed_in(1, .asks) != 1) {
        print("  RED: an asking run weighed {d} answers\n", .{rung.weighed_in(1, .asks)});
        return 1;
    }
    if (rung.weighed_in(0, .asks) != 0) {
        print("  RED: a run that told nobody weighed an answer anyway\n", .{});
        return 1;
    }
    if (rung.unasked_in(1, .unasked) != 1 or rung.unasked_in(1, .asks) != 0) {
        print("  RED: the other half of the count did not close on one answer\n", .{});
        return 1;
    }

    // The reader's own four bytes, read back against the answer they weigh.
    const met = rung.met_bytes(rung.debt_bytes(.overrules, .short));
    const carried = rung.found_bytes(rung.redress_bytes(met, .righted));
    const said = rung.suits_bytes(carried, .wanting);
    if (!rung.suits_answers(said, carried)) {
        print("  RED: a reader's word did not read back as weighing the answer it names\n", .{});
        return 1;
    }
    if (rung.suits_answers(said, rung.found_bytes(rung.redress_bytes(met, .sound)))) {
        print("  RED: a word about one answer read back as a word about another\n", .{});
        return 1;
    }
    if (rung.suits_answers(null, carried)) {
        print("  RED: an empty box read back as a reader who had spoken\n", .{});
        return 1;
    }
    if (rung.suits_worth(said) != .wanting) {
        print("  RED: a reader saying the answer falls short read back as saying otherwise\n", .{});
        return 1;
    }
    if (rung.suits_worth(rung.suits_bytes(carried, .settles)) != .settles) {
        print("  RED: a reader saying the answer settles the matter read back as saying otherwise\n", .{});
        return 1;
    }
    if (rung.suits_worth(null) != null) {
        print("  RED: a box holding nothing read back as a verdict\n", .{});
        return 1;
    }
    if (!rung.suffice_holds(.wanting, .wanting) or rung.suffice_holds(.settles, .wanting)) {
        print("  RED: a published word did not read back as the word it was\n", .{});
        return 1;
    }
    if (rung.suffice_holds(null, .wanting)) {
        print("  RED: a note holding nothing read back as a reader asked\n", .{});
        return 1;
    }
    return link(rung, "check_suffice_refusals");
}


pub fn check_suffice_measure(comptime rung: type) u8 {
    if (rung.unmeasured_answers(1, .unasked) != 1) {
        print("  RED: an answer nobody was asked about went uncounted\n", .{});
        return 1;
    }
    if (rung.unmeasured_answers(1, .asks) != 0) {
        print("  RED: an answer its reader weighed still counted as one never asked about\n", .{});
        return 1;
    }
    // A run that told nobody has asked nobody, so it costs the count nothing --
    // the harm this rung names is the answer carried home and never once
    // followed by a question.
    if (rung.unmeasured_answers(0, .unasked) != 0) {
        print("  RED: a run that told nobody was charged an unmeasured answer\n", .{});
        return 1;
    }

    print("  five refusals stand by name: untold, silent, mismatched, miscounted, misrecorded\n", .{});
    print("  the reading this rung keeps: {s}\n", .{rung.suffice_words(.asks)});
    print("  what an unasking plan never learns: {s}\n", .{rung.suffice_words(.unasked)});
    print("  {s}\n", .{rung.worth_words(.wanting)});
    print("  {s}\n", .{rung.worth_words(.settles)});
    print("  a reader's word carries four bytes: the answer they were carried, and what they make of it\n", .{});
    return link(rung, "check_reopen");
}


pub fn check_suffice_refusals(comptime rung: type) u8 {
    // A run that carried nothing to anybody has asked nobody anything.
    if (rung.suffice_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.SufficeUntold) {
            print("  RED: a weighing with no delivery behind it refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a plan that told nobody was credited with reading their word\n", .{});
        return 1;
    }
    // The hard half: silence is no consent here, exactly as it was not when a
    // quarrel was withdrawn.
    if (rung.suffice_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.SufficeSilent) {
            print("  RED: a weighing over an empty box refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reader who said nothing was read as having answered\n", .{});
        return 1;
    }
    // The rung itself: a verdict about some other look, read as today's word.
    if (rung.suffice_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.SufficeMismatched) {
            print("  RED: a word about another answer refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run carried one answer and read a word about another\n", .{});
        return 1;
    }
    // The honesty of the count: every answer carried is weighed or left unasked
    // -- never both and never neither.
    if (rung.suffice_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.SufficeMiscounted) {
            print("  RED: an answer counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer weighed and left unasked at once went uncounted\n", .{});
        return 1;
    }
    if (rung.suffice_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.SufficeMiscounted) {
            print("  RED: an answer counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer neither weighed nor left unasked went uncounted\n", .{});
        return 1;
    }
    if (rung.suffice_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: a weighing inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_suffice_measure");
}


pub fn check_suffice_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_suits(io, rung.standing_address);
    rung.clear_suffice(io);
    rung.clear_apprise(io, rung.standing_address);
    const carried = rung.found_bytes(rung.redress_bytes(rung.met_bytes(rung.inherited_debt), .righted));
    rung.apprise_note(io, rung.standing_address, carried) catch |err| {
        print("  RED: a finding could not be carried to its reader at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.weigh_as_reader(io, rung.standing_address, rung.suits_bytes(carried, .wanting)) catch |err| {
        print("  RED: a reader could not weigh the answer at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const said = rung.worth_written(io, rung.standing_address) orelse {
        print("  RED: a reader's own word could not be read back at all\n", .{});
        return 1;
    };
    if (!rung.suits_answers(said, carried)) {
        print("  RED: a reader's word stopped naming the answer it weighs\n", .{});
        return 1;
    }
    const worth = rung.suits_worth(said) orelse {
        print("  RED: a reader's word carried no verdict at all\n", .{});
        return 1;
    };
    rung.suffice_note(io, worth) catch |err| {
        print("  RED: a reader's word could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    if (!rung.suits_answers(rung.worth_written(io, rung.standing_address), carried)) {
        print("  RED: a provisioning emptied the box a reader wrote their word in\n", .{});
        return 1;
    }
    if (!rung.suffice_holds(rung.worth_published(io), .wanting)) {
        print("  RED: a published word carried past a provisioning stopped naming its verdict\n", .{});
        return 1;
    }
    if (rung.apprised_of(io, rung.standing_address) == null) {
        print("  RED: reading a reader's word took down the answer it weighs\n", .{});
        return 1;
    }
    // The plan's copy comes down with the answer it weighed, so a later run never
    // reads a satisfaction about a delivery this wire has forgotten.
    rung.clear_apprise(io, rung.standing_address);
    rung.clear_suffice(io);
    if (rung.worth_published(io) != null) {
        print("  RED: a published word outlived the answer it was weighing\n", .{});
        return 1;
    }
    // And the reader keeps their own word where they wrote it, which no run of
    // this plan ever reaches for.
    if (rung.worth_written(io, rung.standing_address) == null) {
        print("  RED: a plan taking down its own copy reached into its reader's box\n", .{});
        return 1;
    }
    rung.clear_suits(io, rung.standing_address);
    print("  a reader's word survives a provisioning, and the plan's copy falls with the answer it weighs\n", .{});
    return link_wire(rung, "check_reopen_wire", io, sys);
}


pub fn check_swell(comptime rung: type) u8 {
    // The reading itself, weighed against a bound no run may move. The
    // threshold is inclusive, since a position that has stood the named number
    // of runs has already outlasted them.
    if (rung.stands_loud(rung.long_standing_runs) != .loud) {
        print("  RED: a quarrel at the bound read quiet\n", .{});
        return 1;
    }
    if (rung.stands_loud(rung.long_standing_runs - 1) != .quiet) {
        print("  RED: a quarrel one run short of the bound read loud\n", .{});
        return 1;
    }
    if (rung.stands_loud(0) != .quiet) {
        print("  RED: a quarrel of no age at all read loud\n", .{});
        return 1;
    }
    if (rung.stands_loud(rung.max_dwell_runs) != .loud) {
        print("  RED: the oldest quarrel one note may carry read quiet\n", .{});
        return 1;
    }
    // The byte an operator reads, and the reading it comes back as. A note
    // carrying anything else is no reading at all rather than a quiet one.
    if (rung.volume_of_byte(rung.volume_byte(.loud)) != .loud) {
        print("  RED: a loud standing did not survive its own byte\n", .{});
        return 1;
    }
    if (rung.volume_of_byte(rung.volume_byte(.quiet)) != .quiet) {
        print("  RED: a quiet standing did not survive its own byte\n", .{});
        return 1;
    }
    if (rung.volume_of_byte('z') != null) {
        print("  RED: a byte no herald ever wrote read back as a standing\n", .{});
        return 1;
    }
    // The count, which every later number closes on.
    if (rung.heralded_in(1, .heralded) != 1) {
        print("  RED: a heralding run left its one standing position unpublished\n", .{});
        return 1;
    }
    if (rung.heralded_in(1, .hushed) != 0) {
        print("  RED: a hushed run published a standing all the same\n", .{});
        return 1;
    }
    if (rung.heralded_in(0, .heralded) != 0) {
        print("  RED: a run holding no quarrel published a standing for one\n", .{});
        return 1;
    }
    if (rung.unpublished_in(1, .hushed) != 1) {
        print("  RED: a hushed run counted its unpublished position as nothing\n", .{});
        return 1;
    }
    if (rung.unpublished_in(1, .heralded) != 0) {
        print("  RED: a heralding run still counted a position unpublished\n", .{});
        return 1;
    }
    // The record half, answered by the byte itself.
    if (!rung.swell_holds(.loud, .loud)) {
        print("  RED: a note carrying the standing just written did not hold\n", .{});
        return 1;
    }
    if (rung.swell_holds(.quiet, .loud)) {
        print("  RED: a note reading quiet held for a loud standing\n", .{});
        return 1;
    }
    if (rung.swell_holds(null, .quiet)) {
        print("  RED: a note that does not exist held for a quiet standing\n", .{});
        return 1;
    }
    return link(rung, "check_swell_refusals");
}


pub fn check_swell_measure(comptime rung: type) u8 {
    if (rung.standing_unheralded(1, rung.long_standing_runs, .hushed) != 1) {
        print("  RED: a long-standing quarrel nobody published went uncounted\n", .{});
        return 1;
    }
    if (rung.standing_unheralded(1, rung.long_standing_runs, .heralded) != 0) {
        print("  RED: a published quarrel still counted as unheralded\n", .{});
        return 1;
    }
    // A quarrel raised this morning is fairly read at its own volume, so it
    // costs the count nothing -- the harm this rung names is the old position
    // reading no louder than a fresh one.
    if (rung.standing_unheralded(1, 0, .hushed) != 0) {
        print("  RED: a quarrel of no age at all counted as unheralded\n", .{});
        return 1;
    }
    if (rung.standing_unheralded(0, rung.max_dwell_runs, .hushed) != 0) {
        print("  RED: a run with nothing standing left a standing unpublished\n", .{});
        return 1;
    }

    print("  a quarrel counts as long-standing at {d} runs, and no run may move that bound\n", .{
        rung.long_standing_runs,
    });
    print("  a plan publishes whether a long-standing quarrel reads where the outcome is read\n", .{});
    print("  loud reads as {s}\n", .{rung.volume_words(.loud)});
    print("  quiet reads as {s}\n", .{rung.volume_words(.quiet)});
    return link(rung, "check_refer");
}


pub fn check_swell_refusals(comptime rung: type) u8 {
    // The moment: a run publishing a standing where nothing stands tells an
    // operator how loudly a quarrel that is over reads.
    if (rung.swell_refusal(0, 1, 0, true)) |why| {
        if (why != error.SwellEarly) {
            print("  RED: an early heralding refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run heralded a quarrel nobody holds\n", .{});
        return 1;
    }
    // The hard half: a standing read off an age no run ever wrote is a guess
    // wearing a measurement's clothes, and it would read loudest of all.
    if (rung.swell_refusal(1, 1, 0, false)) |why| {
        if (why != error.SwellUndated) {
            print("  RED: an undated heralding refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run published a standing for a quarrel it never dated\n", .{});
        return 1;
    }
    // The honesty of the count: every position still standing is heralded or
    // left unpublished, never both and never neither.
    if (rung.swell_refusal(1, 1, 1, true)) |why| {
        if (why != error.SwellMiscounted) {
            print("  RED: a doubled count refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: one position counted as both published and unpublished stood\n", .{});
        return 1;
    }
    if (rung.swell_refusal(1, 0, 0, true)) |why| {
        if (why != error.SwellMiscounted) {
            print("  RED: an empty count refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a standing position counted as neither published nor unpublished stood\n", .{});
        return 1;
    }
    // And the honest reading passes, which is the half a refusal-only test
    // never proves.
    if (rung.swell_refusal(1, 1, 0, true)) |why| {
        print("  RED: a heralding inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_swell_measure");
}


pub fn check_swell_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    _ = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.clear_standing(io);
    rung.clear_swell(io);
    rung.standing_note(io, .presses) catch |err| {
        print("  RED: a position could not be carried at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.swell_note(io, .loud) catch |err| {
        print("  RED: a standing could not be published at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.swell_published(io) orelse {
        print("  RED: a provisioning cleared the standing it was told to leave\n", .{});
        return 1;
    };
    if (survived != .loud) {
        print("  RED: a standing carried past a provisioning read back as {s}\n", .{
            rung.volume_words(survived),
        });
        return 1;
    }
    // The standing falls with the quarrel, proven on the wire the withdrawal
    // leaves.
    rung.release_standing(io);
    if (rung.swell_published(io) != null) {
        print("  RED: a standing outlived the quarrel it was speaking for\n", .{});
        return 1;
    }
    const again = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(again == sys.graph.domain_count);
    if (rung.swell_published(io) != null) {
        print("  RED: a standing came back with the next provisioning\n", .{});
        return 1;
    }
    print("  a standing survives a provisioning, and falls with the quarrel it speaks for\n", .{});
    return 0;
}


pub fn check_tidings_wire(comptime rung: type, io: std.Io) u8 {
    const shelf = "shelf";
    rung.clear_tidings(io, shelf);
    rung.tell_outcome(io, shelf, .moved) catch |err| {
        print("  RED: a reader could not be told at all: {s}\n", .{@errorName(err)});
        return 1;
    };
    const read_back = rung.told_of(io, shelf) orelse {
        print("  RED: a reader's own box carried nothing back\n", .{});
        return 1;
    };
    if (read_back != .moved) {
        print("  RED: a word that moved was read back as {s}\n", .{rung.result_words(read_back)});
        return 1;
    }
    rung.clear_tidings(io, shelf);
    if (rung.told_of(io, shelf) != null) {
        print("  RED: a cleared box still answered\n", .{});
        return 1;
    }
    print("  both answers ride the wire: {s}\n", .{rung.result_words(.moved)});
    return 0;
}


pub fn check_unlost(comptime rung: type, sys: *const system.System) u8 {
    const clients = [_]rung.Task{
        rung.written_queue[0].task,
        rung.written_queue[1].task,
        rung.written_queue[3].task,
        rung.written_queue[4].task,
    };
    var agreed: u32 = 0;
    var a: u32 = 0;
    while (a < clients.len) : (a += 1) {
        var live_store: [rung.max_in_flight]cohort.Running = undefined;
        live_store[0] = .{
            .proc = undefined,
            .domain = clients[a].item.domain,
            .verb = clients[a].item.verb,
            .count = clients[a].item.count,
            .expect = clients[a].item.expect,
        };
        var handed_store: [rung.max_in_flight]rung.Task = undefined;
        handed_store[0] = clients[a];
        const reserve_store = [_]?rung.Task{null};
        const taken_store = [_]u32{0};
        var b: u32 = 0;
        while (b < clients.len) : (b += 1) {
            const here = rung.admissible_in(
                sys, live_store[0..1], handed_store[0..1], reserve_store[0..1], taken_store[0..1], clients[b],
            ) catch {
                print("  RED: an appraising run could not weigh its own door\n", .{});
                return 1;
            };
            const there = unhand.admissible_held(sys, live_store[0..1], handed_store[0..1], clients[b]);
            if (here != there) {
                print("  RED: the two readings disagreed about {s} beside {s}\n", .{
                    clients[b].item.domain, clients[a].item.domain,
                });
                return 1;
            }
            agreed += 1;
        }
        // invariant: every newcomer was weighed against this dependent, none skipped
        assert(b == clients.len);
    }
    // invariant: every line stood as the running dependent once, none skipped
    assert(a == clients.len);

    print("  a plan that loses nothing reads as the line handed, all {d} pairs\n", .{agreed});
    return 0;
}

/// Weighs the number this rung moves, as a pure fold.
pub fn check_beckon_measure(comptime rung: type) u8 {
    if (rung.unheralded_walls(1, .keeps) != 1) {
        print("  RED: a wall stood and told to nobody went uncounted\n", .{});
        return 1;
    }
    if (rung.unheralded_walls(1, .beckons) != 0) {
        print("  RED: a wall carried to a person still counted as one told to nobody\n", .{});
        return 1;
    }
    // A run that stood no wall has no boundary to carry, so it costs the count
    // nothing -- the harm this rung names is the wall actually stood and the
    // person never called to it.
    if (rung.unheralded_walls(0, .keeps) != 0) {
        print("  RED: a run that bounded nothing was charged an unheralded wall\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unwalled, unaddressed, mismatched, miscounted, misrecorded\n", .{});
    print("  the beckoning this rung keeps: {s}\n", .{rung.beckon_words(.beckons)});
    print("  what a keeping plan tells an operator: {s}\n", .{rung.beckon_words(.keeps)});
    print("  a call carries eight bytes: the wall it names, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_answer");
}


/// A call across a provisioning, proven outside any run.
///
/// The lap below proves the beckoning end to end under a real plan. This proves
/// the two properties that make a call worth carrying: it survives a
/// provisioning, since a summons swept every morning would leave the person who
/// can act on the matter exactly as uncalled as before -- **and the call lands
/// in a box outside this plan's wire**, so taking down every note the plan keeps
/// leaves the reader holding what they were told.
pub fn check_beckon_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_calls(io, rung.standing_address);
    rung.clear_desist(io);
    rung.clear_mind(io);
    if (rung.called_of(io, rung.standing_address) != null) {
        print("  RED: a call stood in a box nobody had written to\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    // The run before today, standing in for itself: it stood this wall among
    // the plan's own notes, exactly as the rung below leaves a wire.
    rung.wall_note(io, mark) catch |err| {
        print("  RED: a wall could not be stood: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.call_reader(io, rung.standing_address, wall) catch |err| {
        print("  RED: a call could not be carried: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.called_of(io, rung.standing_address) orelse {
        print("  RED: a provisioning cleared the call a person reads\n", .{});
        return 1;
    };
    if (!rung.calls_carries(survived, wall)) {
        print("  RED: a call carried past a provisioning stopped naming its wall\n", .{});
        return 1;
    }
    if (rung.calls_rest(survived) != .stands) {
        print("  RED: a call carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And the call outlives the plan's own drawer, which is the whole point of
    // writing it where the reader is rather than where the record is kept.
    rung.clear_desist(io);
    if (rung.called_of(io, rung.standing_address) == null) {
        print("  RED: a call fell with the wall it was only carrying\n", .{});
        return 1;
    }
    rung.clear_calls(io, rung.standing_address);
    if (rung.called_of(io, rung.standing_address) != null) {
        print("  RED: a call outlived the taking down of the reader's own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  a call survives a provisioning, and outlives the drawer the wall it names was kept in\n", .{});
    return link_wire(rung, "check_answer_wire", io, sys);
}

/// Weighs the opening this rung adds, as a pure fold.
pub fn check_answer(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const call = rung.calls_bytes(wall);
    const hand = rung.hands_bytes(call, .accepts);
    if (!rung.hands_answers(hand, call)) {
        print("  RED: an answer did not reply to the call it was built from\n", .{});
        return 1;
    }
    if (rung.hands_hand(hand) != .accepts) {
        print("  RED: an answer lost the reader's own word about the wall\n", .{});
        return 1;
    }
    // An answer built on some other call replies to some other matter, and
    // reading it as this one's would report a person answering a boundary
    // nobody stood here.
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    const elder_call = rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(elder)));
    if (rung.hands_answers(rung.hands_bytes(elder_call, .accepts), call)) {
        print("  RED: an answer to some other call read as this one's\n", .{});
        return 1;
    }
    if (rung.hands_answers(null, call)) {
        print("  RED: a reader who wrote nothing read as one who had answered\n", .{});
        return 1;
    }
    if (rung.hands_hand(null) != null) {
        print("  RED: an absent answer carried a word all the same\n", .{});
        return 1;
    }
    const record = rung.answers_bytes(hand);
    if (!rung.answers_carries(record, hand)) {
        print("  RED: a record did not carry the answer it was built from\n", .{});
        return 1;
    }
    if (rung.answers_hand(record) != .accepts) {
        print("  RED: a record lost the reader's own word five tiers down\n", .{});
        return 1;
    }
    if (record[rung.max_answers_bytes - 1] != rung.opened_byte) {
        print("  RED: a record did not say what it is in its own last byte\n", .{});
        return 1;
    }
    if (rung.answers_carries(rung.answers_bytes(rung.hands_bytes(call, .takes_up)), hand)) {
        print("  RED: a record of some other word read as this one's\n", .{});
        return 1;
    }
    if (!rung.answer_holds(record, record) or rung.answer_holds(null, record)) {
        print("  RED: a record read back out of the plan's notes did not answer for itself\n", .{});
        return 1;
    }
    if (rung.hearing_in(1, .hears) != 1 or rung.hearing_in(1, .leaves) != 0) {
        print("  RED: a hearing was counted as a leaving, or the other way about\n", .{});
        return 1;
    }
    if (rung.hearing_in(0, .hears) != 0) {
        print("  RED: a run that carried no call was counted as hearing a person\n", .{});
        return 1;
    }
    if (rung.shutting_in(1, .leaves) != 1 or rung.shutting_in(1, .hears) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    return link(rung, "check_answer_refusals");
}

/// Weighs every refusal this rung earns, as a pure fold.
pub fn check_answer_refusals(comptime rung: type) u8 {
    if (rung.answer_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.AnswerUncalled) {
            print("  RED: an opening by a run that carried no call refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an opening by a run that carried no call was allowed\n", .{});
        return 1;
    }
    if (rung.answer_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.AnswerSilent) {
            print("  RED: an opening of a box holding nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an opening of a box holding nothing was allowed\n", .{});
        return 1;
    }
    if (rung.answer_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.AnswerMismatched) {
            print("  RED: an answer to some other call refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer to some other call was allowed\n", .{});
        return 1;
    }
    if (rung.answer_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.AnswerMiscounted) {
            print("  RED: a call both opened and left refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a call both opened and left was allowed\n", .{});
        return 1;
    }
    if (rung.answer_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.AnswerMiscounted) {
            print("  RED: a call neither opened nor left refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a call neither opened nor left was allowed\n", .{});
        return 1;
    }
    // And the honest pass: a call carried once, opened once, counted once.
    if (rung.answer_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest opening refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_answer_measure");
}

/// Weighs the number this rung moves, as a pure fold.
pub fn check_answer_measure(comptime rung: type) u8 {
    if (rung.unopened_answers(1, .leaves) != 1) {
        print("  RED: an answer written back and never opened went uncounted\n", .{});
        return 1;
    }
    if (rung.unopened_answers(1, .hears) != 0) {
        print("  RED: an answer the plan heard still counted as one nobody opened\n", .{});
        return 1;
    }
    // A run that carried no call has no correspondence to read a reply in, so it
    // costs the count nothing -- the harm this rung names is the person actually
    // called and then never heard.
    if (rung.unopened_answers(0, .leaves) != 0) {
        print("  RED: a run that called nobody was charged an unopened answer\n", .{});
        return 1;
    }

    print("  five refusals stand by name: uncalled, silent, mismatched, miscounted, misrecorded\n", .{});
    print("  the hearing this rung keeps: {s}\n", .{rung.answer_words(.hears)});
    print("  what a leaving plan tells an operator: {s}\n", .{rung.answer_words(.leaves)});
    print("  a reader who lets the wall stand: {s}\n", .{rung.hand_words(.accepts)});
    print("  a reader who takes the matter up: {s}\n", .{rung.hand_words(.takes_up)});
    print("  an answer carries nine bytes: the call it replies to, echoed whole, and the reader's own byte last\n", .{});
    return link(rung, "check_abate");
}

/// A recorded answer across a provisioning, proven outside any run.
///
/// The lap below proves the opening end to end under a real plan. This proves
/// the two properties that make a record worth writing: it survives a
/// provisioning, since an outcome swept every morning would leave an operator
/// reading a call nobody ever answered -- **and the reader's own word stands
/// exactly where they left it**, so taking down every note the plan keeps leaves
/// the person still holding what they said.
pub fn check_answer_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_answer(io);
    rung.clear_hands(io, rung.standing_address);
    rung.clear_calls(io, rung.standing_address);
    rung.clear_desist(io);
    rung.clear_mind(io);
    if (rung.answer_standing(io) != null) {
        print("  RED: an answer stood recorded where none had been opened\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const call = rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(held)));
    const hand = rung.hands_bytes(call, .accepts);
    // The reader before this run, standing in for themselves: they were called
    // to the wall and wrote back, exactly as the rung below leaves a wire.
    rung.seat_hands(io, rung.standing_address, hand) catch |err| {
        print("  RED: a reader's own answer could not be seated: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.answer_note(io, hand) catch |err| {
        print("  RED: an answer could not be recorded: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.answer_standing(io) orelse {
        print("  RED: a provisioning cleared the answer an operator reads\n", .{});
        return 1;
    };
    if (!rung.answers_carries(survived, hand)) {
        print("  RED: a record carried past a provisioning stopped naming its answer\n", .{});
        return 1;
    }
    if (rung.answers_hand(survived) != .accepts) {
        print("  RED: a record carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And the reader's own word outlives the plan's own record, which is the
    // whole point of reading it where they wrote it rather than moving it.
    rung.clear_answer(io);
    if (rung.hands_written(io, rung.standing_address) == null) {
        print("  RED: a reader's own answer fell with the record that only quoted it\n", .{});
        return 1;
    }
    rung.clear_hands(io, rung.standing_address);
    if (rung.hands_written(io, rung.standing_address) != null) {
        print("  RED: an answer outlived the taking down of the reader's own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  a record survives a provisioning, and leaves the reader's own word standing where they wrote it\n", .{});
    return link_wire(rung, "check_abate_wire", io, sys);
}



/// Weighs the abating this rung adds, as a pure fold.
pub fn check_abate(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const call = rung.calls_bytes(wall);
    const released = rung.answers_bytes(rung.hands_bytes(call, .takes_up));
    const abatement = rung.abates_bytes(released);
    if (!rung.abates_carries(abatement, released)) {
        print("  RED: an abatement did not carry the record it was built from\n", .{});
        return 1;
    }
    if (rung.abates_hand(abatement) != .takes_up) {
        print("  RED: an abatement lost the release it was granted six tiers down\n", .{});
        return 1;
    }
    if (abatement[rung.max_abates_bytes - 1] != rung.abated_byte) {
        print("  RED: an abatement did not say what it is in its own last byte\n", .{});
        return 1;
    }
    // The consent, as a fold: exactly one of the two answers a reader may give
    // releases a plan from its own wall, and the other asks for nothing.
    if (!rung.releases(.takes_up) or rung.releases(.accepts)) {
        print("  RED: a reader letting the wall stand read as one releasing it\n", .{});
        return 1;
    }
    // An abatement built on some other record acts on some other correspondence,
    // and reading it as this one's would take down a boundary nobody released.
    const accepted = rung.answers_bytes(rung.hands_bytes(call, .accepts));
    if (rung.abates_carries(rung.abates_bytes(accepted), released)) {
        print("  RED: an abatement of some other record read as this one's\n", .{});
        return 1;
    }
    if (rung.abates_carries(null, released)) {
        print("  RED: a plan that took nothing down read as one that had\n", .{});
        return 1;
    }
    if (rung.abates_hand(null) != null) {
        print("  RED: an absent abatement carried a release all the same\n", .{});
        return 1;
    }
    // The wall the release actually names, weighed against the wall standing --
    // the whole point of the rung, since taking down the wrong boundary wears
    // the authority of a word nobody spent on it.
    if (!rung.abates_wall(released, wall)) {
        print("  RED: a record refused the very wall its correspondence was built on\n", .{});
        return 1;
    }
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.abates_wall(released, rung.walls_bytes(rung.minds_bytes(elder)))) {
        print("  RED: a release about one wall read as covering another\n", .{});
        return 1;
    }
    if (rung.abates_wall(released, null)) {
        print("  RED: a plan standing no wall at all read as one with a wall to take down\n", .{});
        return 1;
    }
    if (!rung.abate_holds(abatement, abatement) or rung.abate_holds(null, abatement)) {
        print("  RED: an abatement read back out of the plan's notes did not answer for itself\n", .{});
        return 1;
    }
    if (rung.abated_in(1, true, .abates) != 1 or rung.abated_in(1, true, .holds) != 0) {
        print("  RED: an abating was counted as a holding, or the other way about\n", .{});
        return 1;
    }
    if (rung.abated_in(1, false, .abates) != 0) {
        print("  RED: a plan took a wall down on a reader who released nothing\n", .{});
        return 1;
    }
    if (rung.abated_in(0, true, .abates) != 0) {
        print("  RED: a run that opened no answer was counted as abating a wall\n", .{});
        return 1;
    }
    if (rung.withheld_walls_in(1, true, .holds) != 1 or rung.withheld_walls_in(1, true, .abates) != 0) {
        print("  RED: the other half of the count did not close\n", .{});
        return 1;
    }
    if (rung.withheld_walls_in(1, false, .abates) != 1) {
        print("  RED: a wall left standing for want of a release went uncounted as held\n", .{});
        return 1;
    }
    return link(rung, "check_abate_refusals");
}

/// Weighs every refusal this rung earns, as a pure fold.
pub fn check_abate_refusals(comptime rung: type) u8 {
    if (rung.abate_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.AbateUnopened) {
            print("  RED: an abating by a run that opened no answer refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an abating by a run that opened no answer was allowed\n", .{});
        return 1;
    }
    if (rung.abate_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.AbateUnreleased) {
            print("  RED: an abating on a reader who released nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an abating on a reader who released nothing was allowed\n", .{});
        return 1;
    }
    if (rung.abate_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.AbateMismatched) {
            print("  RED: an abating of some other wall refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an abating of some other wall was allowed\n", .{});
        return 1;
    }
    if (rung.abate_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.AbateMiscounted) {
            print("  RED: an answer both abated and held refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer both abated and held was allowed\n", .{});
        return 1;
    }
    if (rung.abate_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.AbateMiscounted) {
            print("  RED: an answer neither abated nor held refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer neither abated nor held was allowed\n", .{});
        return 1;
    }
    // And the honest pass: one answer opened, one release acted on, counted once.
    if (rung.abate_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest abating refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_abate_measure");
}

/// Weighs the number this rung moves, as a pure fold.
pub fn check_abate_measure(comptime rung: type) u8 {
    if (rung.standing_walls(1, true, .holds) != 1) {
        print("  RED: a wall held against a reader who released it went uncounted\n", .{});
        return 1;
    }
    if (rung.standing_walls(1, true, .abates) != 0) {
        print("  RED: a wall taken down still counted as one held against its reader\n", .{});
        return 1;
    }
    // A reader who let the wall stand asked for nothing, so a plan keeping it
    // costs the count nothing -- the harm this rung names is the boundary held
    // against a person who actually released the plan from it.
    if (rung.standing_walls(1, false, .holds) != 0) {
        print("  RED: a plan was charged for holding a wall its reader never released\n", .{});
        return 1;
    }
    // And a run that heard nobody has no release to act on at all.
    if (rung.standing_walls(0, true, .holds) != 0) {
        print("  RED: a run that opened no answer was charged a wall held\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unopened, unreleased, mismatched, miscounted, misrecorded\n", .{});
    print("  the abating this rung keeps: {s}\n", .{rung.abate_words(.abates)});
    print("  what a holding plan tells an operator: {s}\n", .{rung.abate_words(.holds)});
    print("  an abatement carries eleven bytes: the record it acts on, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_conclude");
}

/// An abatement across a provisioning, proven outside any run.
///
/// The lap below proves the abating end to end under a real plan. This proves
/// the two properties that make an abatement worth writing: it survives a
/// provisioning, since a note swept every morning would leave an operator unable
/// to say who released the plan -- **and the wall it took down stays down**, so
/// a boundary that returned with the next morning would make the release a
/// courtesy rather than an act.
pub fn check_abate_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_abate(io);
    rung.clear_answer(io);
    rung.clear_hands(io, rung.standing_address);
    rung.clear_calls(io, rung.standing_address);
    rung.clear_desist(io);
    rung.clear_mind(io);
    if (rung.abate_standing(io) != null) {
        print("  RED: an abatement stood recorded where no wall had come down\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const record = rung.answers_bytes(rung.hands_bytes(rung.calls_bytes(wall), .takes_up));
    // The run before this one, standing in for itself: it stood this wall and
    // recorded its reader's release, exactly as the rung below leaves a wire.
    rung.wall_note(io, mark) catch |err| {
        print("  RED: a wall could not be stood: {s}\n", .{@errorName(err)});
        return 1;
    };
    // The wall standing is the one this record names, read off the wire rather
    // than assumed from having just written both.
    if (!rung.abates_wall(record, rung.wall_standing(io))) {
        print("  RED: a record and the wall standing beside it named different matters\n", .{});
        return 1;
    }
    rung.abate_note(io, record) catch |err| {
        print("  RED: an abatement could not be recorded: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.abate_standing(io) orelse {
        print("  RED: a provisioning cleared the abatement an operator reads\n", .{});
        return 1;
    };
    if (!rung.abates_carries(survived, record)) {
        print("  RED: an abatement carried past a provisioning stopped naming its record\n", .{});
        return 1;
    }
    if (rung.abates_hand(survived) != .takes_up) {
        print("  RED: an abatement carried past a provisioning forgot the release it acted on\n", .{});
        return 1;
    }
    // And the wall it took down stays down across the same provisioning, which
    // is what makes the release an act rather than a courtesy.
    rung.clear_desist(io);
    if (rung.wall_standing(io) != null) {
        print("  RED: a wall stood again where a reader had released it\n", .{});
        return 1;
    }
    const after = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned again: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(after == sys.graph.domain_count);
    if (rung.wall_standing(io) != null) {
        print("  RED: a provisioning stood back up a wall its reader had released\n", .{});
        return 1;
    }
    rung.clear_abate(io);
    if (rung.abate_standing(io) != null) {
        print("  RED: an abatement outlived the taking down of the plan's own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  an abatement survives a provisioning, and the wall it took down stays down across another\n", .{});
    return link_wire(rung, "check_conclude_wire", io, sys);
}

/// Weighs the concluding this rung adds, as a pure fold.
pub fn check_conclude(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const call = rung.calls_bytes(wall);
    const accepted = rung.answers_bytes(rung.hands_bytes(call, .accepts));
    const closure = rung.closes_bytes(accepted);
    if (!rung.closes_carries(closure, accepted)) {
        print("  RED: a closure lost the record it was built from\n", .{});
        return 1;
    }
    if (rung.closes_hand(closure) != .accepts) {
        print("  RED: a closure lost the reader's own word about the wall\n", .{});
        return 1;
    }
    if (closure[rung.max_closes_bytes - 1] != rung.closed_byte) {
        print("  RED: a closure did not say what it was\n", .{});
        return 1;
    }
    // A closure built on some other record ends some other correspondence, and
    // handing it to a later run would report a person closing a matter they
    // never heard of.
    const taken = rung.answers_bytes(rung.hands_bytes(call, .takes_up));
    if (rung.closes_carries(rung.closes_bytes(taken), accepted)) {
        print("  RED: a closure over some other reader's word passed as this one's\n", .{});
        return 1;
    }
    if (rung.closes_carries(null, accepted)) {
        print("  RED: an absent closure carried a record all the same\n", .{});
        return 1;
    }
    // The call-match, which is what keeps a closure from ending the wrong
    // correspondence: the record opens with the very bytes of the call it
    // descends from.
    if (!rung.closes_call(accepted, call)) {
        print("  RED: a record did not reply to the call it was built from\n", .{});
        return 1;
    }
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.closes_call(accepted, rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(elder))))) {
        print("  RED: a record replied to a call about some older matter entirely\n", .{});
        return 1;
    }
    if (rung.closes_call(accepted, null)) {
        print("  RED: a record replied to a call nobody ever carried\n", .{});
        return 1;
    }
    // The two words a reader may hand back are spent, and each moves the plan
    // its own way: a release takes the wall down, an acceptance closes the
    // matter. Neither does the other's work.
    if (rung.ends(.accepts) != true or rung.ends(.takes_up) != false) {
        print("  RED: the reader's two words stopped partitioning the plan's answer\n", .{});
        return 1;
    }
    if (rung.ends(.takes_up) == rung.releases(.takes_up) and rung.ends(.accepts) == rung.releases(.accepts)) {
        print("  RED: ending and releasing read a reader's word the same way\n", .{});
        return 1;
    }
    return link(rung, "check_conclude_refusals");
}

/// Weighs every refusal this rung earns, as a pure fold.
pub fn check_conclude_refusals(comptime rung: type) u8 {
    if (rung.conclude_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.ConcludeUnopened) {
            print("  RED: a concluding by a run that opened no answer refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a concluding by a run that opened no answer was allowed\n", .{});
        return 1;
    }
    if (rung.conclude_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.ConcludeUnended) {
            print("  RED: a concluding over a reader who took the matter up refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a concluding over a reader who took the matter up was allowed\n", .{});
        return 1;
    }
    if (rung.conclude_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.ConcludeMismatched) {
            print("  RED: a closure over some other call refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a closure over some other call was allowed\n", .{});
        return 1;
    }
    if (rung.conclude_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.ConcludeMiscounted) {
            print("  RED: an answer both closed and left open refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer both closed and left open was allowed\n", .{});
        return 1;
    }
    if (rung.conclude_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.ConcludeMiscounted) {
            print("  RED: an answer neither closed nor left open refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer neither closed nor left open was allowed\n", .{});
        return 1;
    }
    // And the honest pass: one answer opened, one correspondence closed, counted once.
    if (rung.conclude_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest concluding refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_conclude_measure");
}

/// Weighs the number this rung moves, as a pure fold.
pub fn check_conclude_measure(comptime rung: type) u8 {
    if (rung.unclosed_endings(1, true, .leaves) != 1) {
        print("  RED: an ending a reader made and nobody kept went uncounted\n", .{});
        return 1;
    }
    if (rung.unclosed_endings(1, true, .concludes) != 0) {
        print("  RED: an ending written down still counted as one nobody kept\n", .{});
        return 1;
    }
    // A reader who took the matter up left with it rather than ending it, so a
    // plan writing nothing costs the count nothing -- the harm this rung names
    // is the ending a person actually made and the plan let fall.
    if (rung.unclosed_endings(1, false, .leaves) != 0) {
        print("  RED: a plan was charged for an ending its reader never made\n", .{});
        return 1;
    }
    // And a run that heard nobody has no ending to keep at all.
    if (rung.unclosed_endings(0, true, .leaves) != 0) {
        print("  RED: a run that opened no answer was charged an ending unkept\n", .{});
        return 1;
    }
    if (rung.closed_in(1, true, .concludes) != 1 or rung.left_open_in(1, true, .concludes) != 0) {
        print("  RED: a concluding run miscounted the one correspondence it closed\n", .{});
        return 1;
    }
    if (rung.closed_in(1, true, .leaves) != 0 or rung.left_open_in(1, true, .leaves) != 1) {
        print("  RED: a leaving run miscounted the correspondence it handed on open\n", .{});
        return 1;
    }

    print("  five refusals stand by name: unopened, unended, mismatched, miscounted, misrecorded\n", .{});
    print("  the concluding this rung keeps: {s}\n", .{rung.conclude_words(.concludes)});
    print("  what a leaving plan tells an operator: {s}\n", .{rung.conclude_words(.leaves)});
    print("  a closure carries eleven bytes: the record it ends on, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_respect");
}

/// A closure across a provisioning, proven outside any run.
///
/// The lap below proves the concluding end to end under a real plan. This
/// proves the one property that makes a closure worth writing at all: **it
/// survives a provisioning**, and it survives the taking down of every record
/// beneath it. A closure is addressed to a run that has not started, so a note
/// swept with the lap that wrote it would leave the next run exactly as unable
/// to tell a closed correspondence from an absent one as before.
pub fn check_conclude_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_close(io);
    rung.clear_abate(io);
    rung.clear_answer(io);
    rung.clear_hands(io, rung.standing_address);
    rung.clear_calls(io, rung.standing_address);
    rung.clear_desist(io);
    rung.clear_mind(io);
    if (rung.close_standing(io) != null) {
        print("  RED: a closure stood in a plan that had written none\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const mark = rung.minds_bytes(held);
    const wall = rung.walls_bytes(mark);
    const call = rung.calls_bytes(wall);
    const accepted = rung.answers_bytes(rung.hands_bytes(call, .accepts));
    // The run before today, standing in for itself: it opened this record among
    // the plan's own notes, exactly as the rung below leaves a wire.
    rung.answer_note(io, rung.hands_bytes(call, .accepts)) catch |err| {
        print("  RED: a record could not be opened: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.conclude_note(io, accepted) catch |err| {
        print("  RED: a closure could not be written: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.close_standing(io) orelse {
        print("  RED: a provisioning cleared the closure a later run inherits\n", .{});
        return 1;
    };
    if (!rung.closes_carries(survived, accepted)) {
        print("  RED: a closure carried past a provisioning stopped naming its record\n", .{});
        return 1;
    }
    if (rung.closes_hand(survived) != .accepts) {
        print("  RED: a closure carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And the closure outlives the records beneath it, which is the whole point
    // of writing it for a run that has not started: the record it quotes may
    // fall with this lap, and the ending it keeps must not.
    rung.clear_answer(io);
    if (rung.close_standing(io) == null) {
        print("  RED: a closure fell with the record it was only quoting\n", .{});
        return 1;
    }
    rung.clear_close(io);
    if (rung.close_standing(io) != null) {
        print("  RED: a closure outlived the taking down of the plan's own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  a closure survives a provisioning, and outlives the record it quotes\n", .{});
    return link_wire(rung, "check_respect_wire", io, sys);
}

/// Weighs the respecting this rung adds, as a pure fold.
pub fn check_respect(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const call = rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(held)));
    const hand = rung.hands_bytes(call, .accepts);
    const closure = rung.closes_bytes(rung.answers_bytes(hand));
    const mark = rung.respects_bytes(closure);
    if (!rung.respects_carries(mark, closure)) {
        print("  RED: a mark lost the closure it was built from\n", .{});
        return 1;
    }
    if (rung.respects_hand(mark) != .accepts) {
        print("  RED: a mark lost the reader's own word seven tiers down\n", .{});
        return 1;
    }
    if (mark[rung.max_respects_bytes - 1] != rung.respected_byte) {
        print("  RED: a mark did not say what it was\n", .{});
        return 1;
    }
    // A mark built on some other closure names some other ending, and reading
    // it as this one's would tell an operator a person had closed a matter they
    // never heard of.
    const taken = rung.closes_bytes(rung.answers_bytes(rung.hands_bytes(call, .takes_up)));
    if (rung.respects_carries(rung.respects_bytes(taken), closure)) {
        print("  RED: a mark over some other ending passed as this one's\n", .{});
        return 1;
    }
    if (rung.respects_carries(null, closure)) {
        print("  RED: an absent mark carried a closure all the same\n", .{});
        return 1;
    }
    if (rung.respects_hand(null) != null) {
        print("  RED: an absent mark carried a reader's word all the same\n", .{});
        return 1;
    }
    // The reader-match, which is what keeps a mark from naming the wrong
    // ending: the closure opens with the very bytes its reader wrote, read
    // where that reader left them.
    if (!rung.respects_reader(closure, hand)) {
        print("  RED: a closure did not carry the word its reader wrote\n", .{});
        return 1;
    }
    if (rung.respects_reader(closure, rung.hands_bytes(call, .takes_up))) {
        print("  RED: a closure built on one word read as built on the other\n", .{});
        return 1;
    }
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.respects_reader(closure, rung.hands_bytes(rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(elder))), .accepts))) {
        print("  RED: a closure read as built on a word about some older matter entirely\n", .{});
        return 1;
    }
    if (rung.respects_reader(closure, null)) {
        print("  RED: a closure read as built on a word nobody ever wrote\n", .{});
        return 1;
    }
    return link(rung, "check_respect_refusals");
}

/// Weighs every refusal this rung earns, as a pure fold.
pub fn check_respect_refusals(comptime rung: type) u8 {
    if (rung.respect_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.RespectUninherited) {
            print("  RED: a respecting by a run that inherited nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a respecting by a run that inherited nothing was allowed\n", .{});
        return 1;
    }
    if (rung.respect_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.RespectUnended) {
            print("  RED: a respecting over a word that ended nothing refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a respecting over a word that ended nothing was allowed\n", .{});
        return 1;
    }
    if (rung.respect_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.RespectMismatched) {
            print("  RED: a mark over some other reader's word refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a mark over some other reader's word was allowed\n", .{});
        return 1;
    }
    if (rung.respect_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.RespectMiscounted) {
            print("  RED: an ending both named and begun again refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an ending both named and begun again was allowed\n", .{});
        return 1;
    }
    if (rung.respect_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.RespectMiscounted) {
            print("  RED: an ending neither named nor begun again refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an ending neither named nor begun again was allowed\n", .{});
        return 1;
    }
    // And the honest pass: one ending inherited, one ending named, counted once.
    if (rung.respect_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest respecting refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_respect_measure");
}

/// Weighs the number this rung moves, as a pure fold.
pub fn check_respect_measure(comptime rung: type) u8 {
    if (rung.unrespected_endings(1, .reopens) != 1) {
        print("  RED: an ending a run opened holding and never named went uncounted\n", .{});
        return 1;
    }
    if (rung.unrespected_endings(1, .respects) != 0) {
        print("  RED: an ending named where the outcome is read still counted as one nobody named\n", .{});
        return 1;
    }
    // A run opening on empty notes inherited nothing, so it costs the count
    // nothing -- the harm this rung names is the ending actually handed forward
    // and then never read.
    if (rung.unrespected_endings(0, .reopens) != 0) {
        print("  RED: a run that inherited nothing was charged an ending unnamed\n", .{});
        return 1;
    }
    if (rung.respected_in(1, .respects) != 1 or rung.reopened_in(1, .respects) != 0) {
        print("  RED: a respecting run miscounted the one ending it named\n", .{});
        return 1;
    }
    if (rung.respected_in(1, .reopens) != 0 or rung.reopened_in(1, .reopens) != 1) {
        print("  RED: a reopening run miscounted the ending it began again from\n", .{});
        return 1;
    }

    print("  five refusals stand by name: uninherited, unended, mismatched, miscounted, misrecorded\n", .{});
    print("  the respecting this rung keeps: {s}\n", .{rung.respect_words(.respects)});
    print("  what a reopening plan tells an operator: {s}\n", .{rung.respect_words(.reopens)});
    print("  a mark carries twelve bytes: the closure it was handed, echoed whole, and this run's own byte last\n", .{});
    return link(rung, "check_refrain");
}

/// A published mark across a provisioning, proven outside any run.
///
/// The lap below proves the respecting end to end under a real plan. This
/// proves the two properties that make the mark worth publishing: **it survives
/// a provisioning**, since an outcome swept every morning would leave an
/// operator reading a plan that named nothing -- and **the inheritance it names
/// comes down**, since a closure that returned every morning would make the
/// naming a courtesy rather than an act.
pub fn check_respect_wire(comptime rung: type, io: std.Io, sys: *const system.System) u8 {
    rung.clear_respect(io);
    rung.clear_close(io);
    rung.clear_abate(io);
    rung.clear_answer(io);
    rung.clear_hands(io, rung.standing_address);
    rung.clear_calls(io, rung.standing_address);
    rung.clear_desist(io);
    rung.clear_mind(io);
    if (rung.respect_published(io) != null) {
        print("  RED: a mark stood in a plan that had named nothing\n", .{});
        return 1;
    }
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const call = rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(held)));
    const accepted = rung.answers_bytes(rung.hands_bytes(call, .accepts));
    const closure = rung.closes_bytes(accepted);
    // The run before today, standing in for itself: it heard this reader out
    // and wrote the ending down, exactly as the rung below leaves a wire.
    rung.conclude_note(io, accepted) catch |err| {
        print("  RED: an earlier run's closure could not be written: {s}\n", .{@errorName(err)});
        return 1;
    };
    rung.respect_note(io, closure) catch |err| {
        print("  RED: a mark could not be published: {s}\n", .{@errorName(err)});
        return 1;
    };
    const provisioned = rung.provision_notes(io, sys) catch |err| {
        print("  RED: a plan could not be provisioned: {s}\n", .{@errorName(err)});
        return 1;
    };
    // invariant: a provisioning always seats the domains the declaration names
    assert(provisioned == sys.graph.domain_count);
    const survived = rung.respect_published(io) orelse {
        print("  RED: a provisioning cleared the mark an operator reads\n", .{});
        return 1;
    };
    if (!rung.respects_carries(survived, closure)) {
        print("  RED: a mark carried past a provisioning stopped naming its closure\n", .{});
        return 1;
    }
    if (rung.respects_hand(survived) != .accepts) {
        print("  RED: a mark carried past a provisioning forgot the word it was built on\n", .{});
        return 1;
    }
    // And the mark outlives the inheritance it names, which is the whole reason
    // the taking down comes second: the closure may fall, and the naming of it
    // must not.
    rung.clear_close(io);
    if (rung.respect_published(io) == null) {
        print("  RED: a mark fell with the closure it was only naming\n", .{});
        return 1;
    }
    rung.clear_respect(io);
    if (rung.respect_published(io) != null) {
        print("  RED: a mark outlived the taking down of the plan's own note\n", .{});
        return 1;
    }
    rung.clear_mind(io);
    print("  a mark survives a provisioning, and outlives the closure it names\n", .{});
    return link_wire(rung, "check_refrain_wire", io, sys);
}

/// Weighs the refraining this rung adds, as a pure fold.
pub fn check_refrain(comptime rung: type) u8 {
    const held = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .stands));
    const call = rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(held)));
    const hand = rung.hands_bytes(call, .accepts);
    const mark = rung.respects_bytes(rung.closes_bytes(rung.answers_bytes(hand)));
    const record = rung.refrains_bytes(mark);
    if (!rung.refrains_carries(record, mark)) {
        print("  RED: a record lost the mark it was built from\n", .{});
        return 1;
    }
    if (rung.refrains_hand(record) != .accepts) {
        print("  RED: a record lost the reader's own word eight tiers down\n", .{});
        return 1;
    }
    if (record[rung.max_refrains_bytes - 1] != rung.refrained_byte) {
        print("  RED: a record did not say what it was\n", .{});
        return 1;
    }
    // A record built on some other mark spares some other reader, and reading it
    // as this one's would tell an operator a person had been left alone about a
    // matter they never heard of.
    const taken = rung.respects_bytes(rung.closes_bytes(rung.answers_bytes(rung.hands_bytes(call, .takes_up))));
    if (rung.refrains_carries(rung.refrains_bytes(taken), mark)) {
        print("  RED: a record over some other ending passed as this one's\n", .{});
        return 1;
    }
    if (rung.refrains_carries(null, mark)) {
        print("  RED: an absent record carried a mark all the same\n", .{});
        return 1;
    }
    if (rung.refrains_hand(null) != null) {
        print("  RED: an absent record carried a reader's word all the same\n", .{});
        return 1;
    }
    // The reader-match, which is what keeps a sparing from taking down the wrong
    // summons: the mark opens with the very bytes its reader wrote, read where
    // that reader left them.
    if (!rung.refrains_reader(mark, hand)) {
        print("  RED: a mark did not carry the word its reader wrote\n", .{});
        return 1;
    }
    if (rung.refrains_reader(mark, rung.hands_bytes(call, .takes_up))) {
        print("  RED: a mark built on one word read as built on the other\n", .{});
        return 1;
    }
    const elder = rung.holds_bytes(rung.rests_bytes(rung.knows_bytes(rung.anew_bytes(rung.inherited_matter)), .allays));
    if (rung.refrains_reader(mark, rung.hands_bytes(rung.calls_bytes(rung.walls_bytes(rung.minds_bytes(elder))), .accepts))) {
        print("  RED: a mark read as built on a word about some older matter entirely\n", .{});
        return 1;
    }
    if (rung.refrains_reader(mark, null)) {
        print("  RED: a mark read as built on a word nobody ever wrote\n", .{});
        return 1;
    }
    return link(rung, "check_refrain_refusals");
}

/// Weighs every refusal this rung earns, as a pure fold.
pub fn check_refrain_refusals(comptime rung: type) u8 {
    if (rung.refrain_refusal(1, 1, 0, false, true, true)) |why| {
        if (why != error.RefrainUnnamed) {
            print("  RED: a sparing by a run that named no ending refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a sparing by a run that named no ending was allowed\n", .{});
        return 1;
    }
    if (rung.refrain_refusal(1, 1, 0, true, false, true)) |why| {
        if (why != error.RefrainTakenUp) {
            print("  RED: a sparing over a reader who took the matter up refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a sparing over a reader who took the matter up was allowed\n", .{});
        return 1;
    }
    if (rung.refrain_refusal(1, 1, 0, true, true, false)) |why| {
        if (why != error.RefrainMismatched) {
            print("  RED: a record over some other reader's word refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a record over some other reader's word was allowed\n", .{});
        return 1;
    }
    if (rung.refrain_refusal(1, 1, 1, true, true, true)) |why| {
        if (why != error.RefrainMiscounted) {
            print("  RED: a reader both spared and summoned again refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reader both spared and summoned again was allowed\n", .{});
        return 1;
    }
    if (rung.refrain_refusal(1, 0, 0, true, true, true)) |why| {
        if (why != error.RefrainMiscounted) {
            print("  RED: a reader neither spared nor summoned again refused as {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a reader neither spared nor summoned again was allowed\n", .{});
        return 1;
    }
    // And the honest pass: one ending named, one reader spared, counted once.
    if (rung.refrain_refusal(1, 1, 0, true, true, true)) |why| {
        print("  RED: an honest refraining refused as {s}\n", .{@errorName(why)});
        return 1;
    }
    return link(rung, "check_refrain_measure");
}

// ---------------------------------------------------------------------------
// The orchestration spine -- fold D.
//
// Every rung of the correspondence arc runs the whole exchange in order, and
// until this fold every rung wrote that order out by hand. A rung born from the
// rung beneath it copied its neighbor's whole function and inserted one step, so
// the lengths formed an exact staircase -- sixteen lines at `refer`, three more
// at each rung, eighty-six at `refrain`. Because no two of those bodies were
// byte-identical, the copy meter beside them read zero over the whole spine, and
// a thousand lines of orchestration rode free past it. The spine meter measured
// the real number on `20260820.204641`: 106 distinct lines standing 1,003 times,
// 897 of them a line the ladder had already written.
//
// The spine lives here now, in one body, and a rung keeps none of it. The order
// is one canonical sequence of twenty-five steps; a rung runs the steps it
// declares, in that order, and the staircase becomes a property this harness
// derives rather than twenty-one hand-copies of it. Adding a step to the arc is
// three lines in this file rather than a fresh copy of everything beneath it.
//
// Brief: `../active-designing/date/20260820/20260820-204641_caravan-ladder-the-spine-the-meter-cannot-see.md`
// Meter: `../tools/caravan_ladder_spine_witness.rish`
// ---------------------------------------------------------------------------

/// Reads a step's tally the same way from every rung.
///
/// A rung's own newest step writes its count into that rung's own report, so the
/// rung reads it as a plain field. Every step a rung inherited keeps its count in
/// the report of the rung beneath, reached through a named accessor. One
/// `comptime` test tells the two apart -- the same reach `link` already uses for
/// a check body -- so one assert serves the rung that owns a step and the twenty
/// that climb to it.
fn tally(
    comptime rung: type,
    comptime accessor: []const u8,
    comptime field: []const u8,
    report_out: anytype,
) u32 {
    // invariant: a tally always names an accessor, never some other decl
    comptime assert(std.mem.endsWith(u8, accessor, "_of"));
    if (comptime @hasDecl(rung, accessor)) {
        return @field(@field(rung, accessor)(report_out), field);
    }
    return @field(report_out.*, field);
}

/// The standing -- what a run owes the quarrel still standing over its plan.
///
/// The order is the order the arc grew, and every step of it is load-bearing.
/// The endurance runs first, because there is nothing to carry past a run until
/// that run has heard everything it is going to hear. The heeding follows, since
/// a regard qualifies a settlement and there is no settlement to qualify until
/// the plan has finished reckoning itself. The dating comes after, because a
/// position has stood through this run only once the run is over. The heralding
/// reads the age that dating just wrote. And the referring carries out the very
/// standing the heralding just published.
///
/// This movement finished growing at `refer`, the foot of the spine, so every
/// rung holding a spine at all holds all five of these steps. It needs no gate.
fn the_standing(
    comptime rung: type,
    io: std.Io,
    taken_up: anytype,
    quarrel: anytype,
    report_out: anytype,
) !void {
    try rung.carry_the_position(io, quarrel.endurance, report_out);
    try rung.weigh_the_standing(io, taken_up, quarrel.heed, report_out);
    try rung.date_the_standing(io, quarrel.dwell, report_out);
    try rung.herald_the_standing(io, quarrel.swell, report_out);
    try rung.refer_the_quarrel(io, quarrel.refer, report_out);
    // invariant: a run never refers more positions than one case holds
    assert(tally(rung, "refer_of", "referred", report_out) <= 1);
}

/// The finding -- a case is read, answered, met, redressed, and carried home.
///
/// The reading comes first, because the case a finding is weighed against is the
/// case the referring just carried. The word follows the finding it answers, the
/// meeting follows the word it keeps, the redress follows the meeting it makes
/// good, the apprising carries that redress to the person who raised the matter,
/// and the weighing reads what they made of it. This movement finished growing
/// at `suffice`.
fn the_finding(
    comptime rung: type,
    io: std.Io,
    quarrel: anytype,
    report_out: anytype,
) !void {
    if (comptime @hasDecl(rung, "read_the_finding")) {
        try rung.read_the_finding(io, quarrel.deem, report_out);
        // invariant: a run never reads more findings than one case may earn
        assert(tally(rung, "deem_of", "answered", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "say_the_word")) {
        try rung.say_the_word(io, quarrel.avow, report_out);
        // invariant: a run never answers more findings than one it read
        assert(tally(rung, "avow_of", "said", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "meet_the_debt")) {
        try rung.meet_the_debt(io, quarrel.meet, report_out);
        // invariant: a run never meets more debts than one plan may book
        assert(tally(rung, "meet_of", "met", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "redress_the_meeting")) {
        try rung.redress_the_meeting(io, quarrel.redress, quarrel.upshot, report_out);
        // invariant: a run never redresses more meetings than it made
        assert(tally(rung, "redress_of", "redressed", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "apprise_the_raiser")) {
        try rung.apprise_the_raiser(io, quarrel.apprise, report_out);
        // invariant: a run never carries out more findings than it reached
        assert(tally(rung, "apprise_of", "apprised", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "weigh_the_answer")) {
        try rung.weigh_the_answer(io, quarrel.suffice, report_out);
        // invariant: a run never weighs more answers than it carried
        assert(tally(rung, "suffice_of", "weighed", report_out) <= 1);
    }
}

/// The second look -- a reader reopens the matter and the plan looks again.
///
/// The taking up comes first, since a reader's short word is what opens the
/// matter at all. The looking answers it, the telling carries that second look
/// back to the reader who asked for it, and the reading opens the reply they
/// wrote. This movement finished growing at `allay`.
fn the_second_look(
    comptime rung: type,
    io: std.Io,
    quarrel: anytype,
    report_out: anytype,
) !void {
    if (comptime @hasDecl(rung, "take_up_again")) {
        try rung.take_up_again(io, quarrel.reopen, report_out);
        // invariant: a run never takes up more matters than one word earns
        assert(tally(rung, "reopen_of", "taken_up", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "look_again")) {
        try rung.look_again(io, quarrel.reweigh, report_out);
        // invariant: a run never looks again at more matters than one reader reopened
        assert(tally(rung, "reweigh_of", "looked", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "tell_the_reopener")) {
        try rung.tell_the_reopener(io, quarrel.recount, report_out);
        // invariant: a run never tells of more second looks than it made
        assert(tally(rung, "recount_of", "recounted", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "read_the_reply")) {
        try rung.read_the_reply(io, quarrel.allay, report_out);
        // invariant: a run never reads more replies than one telling earns
        assert(tally(rung, "allay_of", "read_back", report_out) <= 1);
    }
}

/// The correspondence -- the movement still growing, and the reason for a rung.
///
/// A matter that comes round twice meets a wall, a person outside the plan is
/// called about it, that person answers, and their word moves the plan: the wall
/// comes down, or the ending they named spares them the next letter. Every rung
/// born from here forward extends this movement, which is exactly why it is the
/// one worth reading in order.
fn the_correspondence(
    comptime rung: type,
    io: std.Io,
    quarrel: anytype,
    report_out: anytype,
) !void {
    if (comptime @hasDecl(rung, "bound_the_relay")) {
        // The mark the run before this one left, read before this run's own
        // minding writes over it. This is the only moment a run can see whether
        // the matter it is about to name is one the correspondence has already
        // carried, so the reading stands ahead of the naming rather than beside it.
        const named_before = rung.mind_published(io);
        try rung.mind_the_impasse(io, quarrel.mind, report_out);
        // invariant: a run never names more impasses than one forbearance carries
        assert(tally(rung, "mind_of", "minded", report_out) <= 1);
        try rung.bound_the_relay(io, named_before, quarrel.desist, report_out);
        // invariant: a run never bounds more matters than one mark carries
        assert(tally(rung, "desist_of", "walled", report_out) <= 1);
    } else if (comptime @hasDecl(rung, "mind_the_impasse")) {
        try rung.mind_the_impasse(io, quarrel.mind, report_out);
        // invariant: a run never names more impasses than one forbearance carries
        assert(tally(rung, "mind_of", "minded", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "carry_the_wall")) {
        try rung.carry_the_wall(io, quarrel.beckon, report_out);
        // invariant: a run never calls a person about more walls than it stood
        assert(tally(rung, "beckon_of", "beckoned", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "open_the_answer")) {
        try rung.open_the_answer(io, quarrel.answer, report_out);
        // invariant: a run never opens more answers than one call it carried
        assert(tally(rung, "answer_of", "opened", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "abate_the_wall")) {
        try rung.abate_the_wall(io, quarrel.abate, report_out);
        // invariant: a run never abates more walls than one answer releases
        assert(tally(rung, "abate_of", "abated", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "bid_the_farewell")) {
        try rung.bid_the_farewell(io, quarrel.farewell, report_out);
        // invariant: a run never tells more readers than one record spared
        assert(tally(rung, "farewell_of", "bidden", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "refrain_from_calling")) {
        try rung.refrain_from_calling(io, quarrel.refrain, report_out);
        // invariant: a run never spares more readers than one mark names
        assert(tally(rung, "refrain_of", "refrained", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "respect_the_ending")) {
        try rung.respect_the_ending(io, quarrel.respect, report_out);
        // invariant: a run never names more endings than one closure carries
        assert(tally(rung, "respect_of", "respected", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "close_the_matter")) {
        try rung.close_the_matter(io, quarrel.conclude, report_out);
        // invariant: a run never closes more correspondences than one answer ends
        assert(tally(rung, "conclude_of", "closed", report_out) <= 1);
    }
    if (comptime @hasDecl(rung, "hold_the_matter")) {
        try rung.hold_the_matter(io, quarrel.forbear, report_out);
        // invariant: a run never forbears on more matters than one word leaves standing
        assert(tally(rung, "forbear_of", "forborne", report_out) <= 1);
    }
}

/// Closes every act a run owes the quarrel still standing over its plan.
///
/// One body, twenty-one rungs. The steps run in one canonical order, and a rung
/// runs the ones it declares -- so the rung holding five steps and the rung
/// holding twenty-five reach the same spine, and each gets exactly its own.
///
/// The order reads as four movements and a closing line. **The standing** is what
/// a run owes a position that outlived it. **The finding** is a case read,
/// answered, met, and carried home to whoever raised it. **The second look** is
/// what a reader's short word costs the plan that answered them. **The
/// correspondence** is the movement still growing, where a matter that comes
/// round twice meets a wall and a person outside the plan finally gets a say in
/// it. **The booking comes last of all**, because a debt is what remains once
/// everything a run could do about a matter has been done.
pub fn close_the_quarrel(
    comptime rung: type,
    io: std.Io,
    taken_up: anytype,
    quarrel: anytype,
    report_out: anytype,
) !void {
    // invariant: a run closes a quarrel only after its own record is settled
    assert(rung.settlement_published(io) != null or rung.run_of(report_out).reaped == 0);
    try the_standing(rung, io, taken_up, quarrel, report_out);
    try the_finding(rung, io, quarrel, report_out);
    try the_second_look(rung, io, quarrel, report_out);
    try the_correspondence(rung, io, quarrel, report_out);
    if (comptime @hasDecl(rung, "book_the_debt")) {
        try rung.book_the_debt(io, quarrel.owe, report_out);
        // invariant: a run never books more debts than one concession earns
        assert(tally(rung, "owe_of", "booked", report_out) <= 1);
    }
}

/// Writes the path of the note a run leaves about one dependent.

///
/// Forty-seven rungs held this body, in three families that differed by a
/// keyword and a single comment word rather than by a line of work: a run names
/// its notes the same way everywhere, because the name *is* the contract -- the
/// run's own directory, the dependent the note belongs to, and the suffix that
/// says which note this is. Lifted here, one body serves all forty-seven, and
/// each rung reaches its own directory, its own ceiling, and its own error set
/// through the type it hands in, so a rung that moves its notes elsewhere moves
/// the paths it writes with them.

///
/// Visibility stays exactly as each rung wrote it. Thirty-six publish, because
/// the harness reaches their notes through the type handed in; eleven keep the
/// name private, because only their own body ever asks for it. That split is
/// meaning rather than drift, and a lift preserves what it finds.

///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn note_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, domain: []const u8, suffix: []const u8) rung.NoteError![]const u8 {
    // invariant: a note always names the dependent it belongs to
    assert(domain.len >= 1);
    // invariant: a note always carries one of the suffixes
    assert(suffix.len >= 1);
    const total = rung.note_dir.len + 1 + domain.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var w: u32 = 0;
    for (rung.note_dir) |c| {
        buf[w] = c;
        w += 1;
    }
    buf[w] = '/';
    w += 1;
    for (domain) |c| {
        buf[w] = c;
        w += 1;
    }
    for (suffix) |c| {
        buf[w] = c;
        w += 1;
    }
    // invariant: the path written is exactly the length computed for it
    assert(w == total);
    return buf[0..w];
}

/// Writes the path of one reader's own hand -- the reading they say they hold.
///
/// Thirty-four rungs held this body byte for byte, at twenty-seven lines over a
/// one-line signature, which is why it led the queue by realized fall while two
/// wider families ranked above it by carried lines. The address a reader's hand
/// is read at never varies across the arc: a name under the readers' own
/// directory, wearing the suffix that says the reader spoke. Lifted here, one
/// body serves them all, and each rung reaches its own ceiling, its own
/// directory, its own address test, and its own error set through the type it
/// hands in.
///
/// Sibling of `tell_path` above, and deliberately NOT merged with it. The two
/// differ in their suffix and in the companion each pairs with, and that pairing
/// is the meaning rather than the accident: an answer is left in the same box a
/// question is asked in, and a hand is left in the same box a correction is. A
/// merged body taking both as comptime parameters would keep both asserts and is
/// worth its own lap; folding it in here would widen this one across a second
/// family of twenty-nine.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn hand_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: a hand is only ever read for an address a run may carry to
    assert(rung.addressable(address));
    const suffix = ".said";
    // invariant: an answer is read from the same box a correction is left in
    comptime assert(suffix.len == ".told".len);
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a hand path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Writes the path of the answer one reader is owed about their own quarrel.
///
/// Twenty-nine rungs held this body byte for byte, because the address a reader
/// is answered at is the one thing the whole correspondence arc never varies:
/// a name under the readers' own directory, wearing the suffix that says the
/// matter came out. Lifted here, one body serves them all, and each rung reaches
/// its own ceiling, its own directory, and its own error set through the type it
/// hands in -- so a rung that widens the ceiling widens the path it writes.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: an answer is only ever written to an address a run may carry to
    assert(rung.addressable(address));
    const suffix = ".outof";
    // invariant: an answer is left in the same box a question is asked in
    comptime assert(suffix.len == ".again".len);
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: an answer path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Writes the path of the second hand one reader may raise their objection with.
///
/// Thirty-one rungs held this body byte for byte -- a member of the reader-box
/// path family, beside `hand_path`, `tell_path`, and `ask_path`. All four name
/// an address under the readers' own directory and dress it in a suffix; what
/// differs is which box the note lands in and which companion it
/// pairs with, and that pairing carries the meaning: a renewal is left in the
/// same box a question is, so a reader who was asked once is asked again where
/// they already look. Lifted here, one body serves all thirty-one, and each rung
/// reaches its own ceiling, its own directory, and its own error set through the
/// type it hands in -- so a rung that widens the ceiling widens the path it writes.
///
/// Every symbol this body reaches already stood public in all thirty-one rungs,
/// so the lift widens nothing. Measured rather than read: `REACH_OK
/// family=renew_path folding=31 widens=0 stub=3 fall=720` from
/// `../tools/fixtures/ladder_reach_visibility_scan.sh`.
pub fn renew_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: a renewal is only ever read for an address a run may carry to
    assert(rung.addressable(address));
    const suffix = ".still";
    // invariant: a renewal is read from the same box a question is left in
    comptime assert(suffix.len == ".again".len);
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a renewal path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Writes the path of the question one reader is asked again.
///
/// Thirty-one rungs held this body byte for byte -- the fourth member of the
/// reader-box path family, beside `hand_path`, `tell_path`, and `renew_path`.
/// All four name an address under the readers' own directory and dress it in a
/// short suffix -- `.said`, `.outof`, `.still`, `.again`; what differs is which
/// box the note lands in and which
/// companion it pairs with. This one is the question a plan writes, and its
/// renewal is read back from the same box, so a reader who was asked once is
/// asked again where they already look. Lifted here, one body serves all
/// thirty-one, and each rung reaches its own ceiling, its own directory, and its
/// own error set through the type it hands in -- so a rung that widens the
/// ceiling widens the path it writes.
///
/// Every symbol this body reaches already stood public in all thirty-one rungs,
/// so the lift widens nothing. Measured rather than read: `REACH_OK
/// family=ask_path folding=31 widens=0 stub=3 fall=660` from
/// `../tools/fixtures/ladder_reach_visibility_scan.sh`.
pub fn ask_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: a question is only ever asked of an address a run may carry to
    assert(rung.addressable(address));
    const suffix = ".again";
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a question path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Tells the reader who raised a quarrel how it came out.
///
/// One byte, written where that reader is rather than where the record is kept:
/// `m` for a word their objection stood against that reads differently now, `t`
/// for one that reads exactly as it read. It lands beside the letter this arc
/// already carried them and the question it already asked them, in the same box,
/// so a reader who has heard from this plan twice hears from it a third time in
/// the place they already look.
///
/// Every note beneath this one is written where a word is read. This is the only
/// one written where the person who objected can find it. Twenty-nine rungs
/// wrote it identically, and each one now writes it into its own box, since the
/// directory, the result shape, and the byte that names an outcome all arrive
/// with the type handed in.
pub fn tell_outcome(comptime rung: type, io: std.Io, address: []const u8, result: rung.Result) rung.NoteError!void {
    // invariant: an answer is only ever carried to an address a run may reach
    assert(rung.addressable(address));
    Dir.cwd().createDirPath(io, rung.reader_dir) catch return error.NoteUnavailable;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = try tell_path(rung, &path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{rung.result_byte(result)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Tells the reader who raised the quarrel how it came out.
///
/// The wire before the memory, one tier further out than the standing below it:
/// this run reads the quarrel out of the record that keeps it, reads the term
/// out of the note that decided it, reads the word it finally settled out of the
/// note an operator opens, reads the address out of the note that names it,
/// writes the result into that reader's own box, and reads the box back before
/// the report believes anybody was told. A plan that reported a raiser reached
/// from memory of having written to them would be counting a letter it never
/// sent.
///
/// A run holding no quarrel has nobody to write to, a quarrel nobody decided has
/// no outcome to carry, and a reader who left no address cannot be reached at
/// all; each is a silence no tiding can fill, and each says so by weighing
/// nothing rather than by inventing a correspondent. A quarrel weighed whose
/// raiser was never told how it came out is the number this tier moves.
///
/// Twenty-eight rungs held this body byte for byte. It lifts here whole, and
/// each one still reads its own record, its own term, its own address ceiling,
/// and its own box, because every symbol it names arrives with the type handed
/// in -- including the accessor that finds this tier's own report inside a
/// report nested as deep as that rung stands. The staircase beneath the
/// accessor stays where it is written; only the body above it is written once.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_the_reader(
    comptime rung: type,
    io: std.Io,
    tidings: rung.Tidings,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const quarrel = rung.dispute_recorded(io);
    const raised: u32 = if (quarrel == null) 0 else 1;
    if (raised == 0) {
        // invariant: a run holding no quarrel leaves no raiser unreturned
        assert(rung.tidings_of(report_out).unreturned == 0);
        return;
    }
    const life = rung.term_written(io);
    const weighed = life != null;

    // The measurement this tier moves, weighed against what the wire actually
    // carries rather than against what any plan asked for, so a raiser left in
    // the dark is counted rather than refused.
    rung.tidings_of(report_out).unreturned = rung.objection_untold(raised, weighed, tidings);
    const told_count = rung.told_in(raised, weighed, tidings);
    const untold_count = rung.untold_in(raised, weighed, tidings);
    if (tidings == .silent) {
        // invariant: a silent run writes to nobody, however plainly its own
        // wire weighed the quarrel
        assert(told_count == 0);
        rung.tidings_of(report_out).untold = untold_count;
        return;
    }
    if (!weighed) {
        // A quarrel nobody decided has no outcome to report, and the wire says
        // so by leaving the reader's box exactly as it reads.
        //
        // invariant: an unweighed quarrel is never reported on
        assert(told_count == 0);
        rung.tidings_of(report_out).untold = untold_count;
        return;
    }
    // The supply, refused by name while the term it read is still in hand: a run
    // writes back only where somebody actually decided the quarrel.
    if (rung.unweighed_tidings(if (weighed) 1 else 0, told_count)) |why| return why;
    if (rung.tidings_refusal(raised, told_count, untold_count)) |why| return why;
    // invariant: a run that reached the tidings refuses nothing it must write
    assert(told_count == 1);
    const held = quarrel orelse return error.TidingsEarly;
    const settled = rung.settlement_published(io) orelse return error.TidingsUnweighed;
    var address_buf: [rung.max_address_len]u8 = undefined;
    const address = rung.address_published(io, &address_buf) orelse return error.TidingsEarly;
    // The word this reader stood against is the plan's own reading at the time
    // of the quarrel, which the record names first.
    const objected_to = held[0];
    const result = rung.results_as(objected_to, settled);
    // The hard half of this tier: a tiding carries one finding to the one person
    // who asked for it, so it must be that finding.
    if (!rung.tells_true(result, objected_to, settled)) return error.TidingsMisread;
    try rung.tell_outcome(io, address, result);
    // The wire before the memory, once more: the answer is read back out of the
    // reader's own box, and only then does the report believe it.
    const reached = rung.told_of(io, address) orelse return error.TidingsMisread;
    if (!rung.tells_true(reached, objected_to, settled)) return error.TidingsMisread;
    rung.tidings_of(report_out).told = told_count;
    rung.tidings_of(report_out).untold = untold_count;
    // invariant: a returning run leaves no weighed quarrel unreturned
    assert(rung.tidings_of(report_out).unreturned == 0);
}

/// Carries what the second look came to out to the reader who asked for it.
///
/// **It runs after the looking below it, and it reads that looking's own
/// receipt.** Only a second look actually receipted can be told of, so this tier
/// takes its subject off the wire rather than from anything the plan asked for
/// -- and a run that looked at nothing tells nobody anything, which is the
/// honest ending rather than a letter about a question nobody re-asked.
///
/// **The telling lands where the reader is.** Every note of this second look so
/// far lives among the plan's own records, in a place only a later run of this
/// plan opens; this one leaves for the reader's own box, which is what makes it
/// a telling rather than another entry in the file.
///
/// **Telling is not deciding.** The telling copies the receipt and rewrites
/// nothing -- the settlement, the quarrel, its age, its standing, the case on
/// the desk, the finding, the plan's own word, the concession, the meeting, the
/// redress, the delivery, the reader's own verdict, and the second look itself
/// each come out of a telling run exactly as they went in.
///
/// Eleven rungs held this body byte for byte, and every symbol it reaches
/// already stood public in all eleven, so it lifts here whole without widening a
/// single word. Each rung still reads its own wire, its own address ceiling, and
/// its own box, because every name arrives with the type handed in -- including
/// the accessor that finds this tier's own report wherever that rung nests it.
/// The rung the family was born on writes the body differently and is left
/// alone.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_the_reopener(
    comptime rung: type,
    io: std.Io,
    recount: rung.Recount,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const on_wire = rung.anew_standing(io);
    const looked_count: u32 = if (on_wire != null) 1 else 0;
    if (looked_count == 0) {
        // invariant: a run that made no second look tells of none
        assert(rung.recount_of(report_out).recounted == 0);
        // invariant: a run that made no second look leaves none untold
        assert(rung.recount_of(report_out).untold == 0);
        return;
    }

    // The measurement this tier moves, weighed against the second look actually
    // made rather than against anything the plan asked for, so a look nobody
    // hears of is counted rather than refused.
    rung.recount_of(report_out).untold = rung.untold_looks(looked_count, recount);
    const told_count = rung.recounted_in(looked_count, recount);
    const kept_count = rung.unsent_looks_in(looked_count, recount);
    if (recount == .withholds) {
        // invariant: a withholding run tells nobody, however plainly it looked
        assert(told_count == 0);
        rung.recount_of(report_out).withheld = kept_count;
        return;
    }

    // The receipt comes off the wire, since the second look a telling reports is
    // the one standing published and never one a run remembered. The reads
    // supply the ladder rather than short-circuiting it, so every refusal below
    // is reached by argument and named in its own order.
    const receipt = on_wire orelse return error.RecountUnlooked;
    const looked = true;
    var address_buf: [rung.max_address_len]u8 = @splat(0);
    const where = rung.address_published(io, &address_buf) orelse "";
    const addressed = rung.addressable(where);
    const carried = rung.knows_bytes(receipt);
    const matched = rung.knows_answers(carried, receipt);
    if (rung.recount_refusal(looked_count, told_count, kept_count, looked, addressed, matched)) |why| return why;

    // invariant: a telling run carries the one second look it made
    assert(told_count == 1);
    try rung.recount_note(io, where, receipt);
    // The wire before the memory: the reader's own box is opened again before
    // the report believes anybody was told a word.
    if (!rung.recount_holds(rung.recounted_to(io, where), carried)) return error.RecountMisrecorded;
    rung.recount_of(report_out).recounted = told_count;
    rung.recount_of(report_out).withheld = kept_count;
    // invariant: a telling run leaves no second look of its own untold
    assert(rung.recount_of(report_out).untold == 0);
}

/// Tells what two runs did with the phases themselves, and with every reach a
/// phase conferred and never served.
///
/// The seam is the run's own: this is the movement that counts phases and
/// dependents before the telling turns to the quarrel the desisting rung holds.
///
/// Eight rungs held this body at fifty lines apiece, and masked for the pair of
/// words naming which plan each column reports, all eight collapse to one hash
/// -- byte-identical otherwise, nesting depth included, so no staircase hides
/// here. The pair arrives as comptime text, so each printed line comes out
/// exactly as its rung wrote it while the body is written once.
///
/// One raw reach remains, and it is named rather than hidden: the absorbed tally
/// sits four levels below `abandoning_of`, since no rung publishes an accessor
/// that reaches it. The chain stood at the same depth in all eight rungs, and it
/// stands once here now, where a single reading governs every rung that calls in.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_desist_runs(
    comptime rung: type,
    comptime bare_word: []const u8,
    comptime under_word: []const u8,
    bare_run: *rung.Report,
    under_run: *rung.Report,
) void {
    const pair = " {d} " ++ bare_word ++ ", {d} " ++ under_word ++ "\n";
    // invariant: a telling always reads two runs that were actually run
    assert(rung.run_of(bare_run).queued >= 1);
    // invariant: a telling never reports more dependents than a repair may add
    assert(rung.run_of(under_run).reaped <= rung.run_of(under_run).queued + rung.max_queue_len);
    print("  phases:" ++ pair, .{
        rung.run_of(bare_run).queued, rung.run_of(under_run).queued,
    });
    print("  dependents:" ++ pair, .{
        rung.run_of(bare_run).reaped, rung.run_of(under_run).reaped,
    });
    print("  phases absorbed into a standing dependent:" ++ pair, .{
        rung.abandoning_of(bare_run).inner.inner.inner.inner.absorbed,
        rung.abandoning_of(under_run).inner.inner.inner.inner.absorbed,
    });
    print("  abandoned reach, conferred and never served:" ++ pair, .{
        rung.abandoning_of(bare_run).abandoned, rung.abandoning_of(under_run).abandoned,
    });
    print("  phases re-seated to carry what was lost:" ++ pair, .{
        rung.below_of(bare_run).reseated, rung.below_of(under_run).reseated,
    });
    print("  standing judgments taken back on this run's own evidence:" ++ pair, .{
        rung.recanting_of(bare_run).recanted, rung.recanting_of(under_run).recanted,
    });
    print("  readings corrected where they were read:" ++ pair, .{
        rung.amending_of(bare_run).amended, rung.amending_of(under_run).amended,
    });
    print("  corrections carried to the place their reader was reached:" ++ pair, .{
        rung.couriering_of(bare_run).delivered, rung.couriering_of(under_run).delivered,
    });
    print("  disagreements written into the record:" ++ pair, .{
        rung.disputing_of(bare_run).recorded, rung.disputing_of(under_run).recorded,
    });
    print("  published words standing beside the reading against them:" ++ pair, .{
        rung.abiding_of(bare_run).escorted, rung.abiding_of(under_run).escorted,
    });
    print("  standing objections put back to the reader who raised them:" ++ pair, .{
        rung.lapsing_of(bare_run).asked, rung.lapsing_of(under_run).asked,
    });
    print("  marks carrying the standing of the objection they quote:" ++ pair, .{
        rung.reposing_of(bare_run).stood, rung.reposing_of(under_run).stood,
    });
    print("  raisers told how their own quarrel came out:" ++ pair, .{
        rung.tidings_of(bare_run).told, rung.tidings_of(under_run).told,
    });
    print("  readers whose reply to the answer was read back:" ++ pair, .{
        rung.appeal_of(bare_run).heard_back, rung.appeal_of(under_run).heard_back,
    });
    tell_desist_half(rung, bare_word, under_word, bare_run, under_run);
}

/// Tells what two runs did about the standing quarrel itself, in an operator's
/// own words.
///
/// The seam is the desisting rung's own: everything above belongs to the rungs
/// beneath it and stands still under both plans, and everything here turns on
/// whether a quarrel its holder let go is finally allowed to end.
///
/// Eight rungs held this body, and it read the same in every one save two words
/// -- the pair naming which plan each column reports. Those two arrive as
/// comptime text, so the printed line comes out exactly as each rung wrote it
/// while the body is written once. Every accessor it names arrives with the type
/// handed in, so each rung still reads its own report wherever that rung nests
/// it.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_desist_half(
    comptime rung: type,
    comptime bare_word: []const u8,
    comptime under_word: []const u8,
    bare_run: *rung.Report,
    under_run: *rung.Report,
) void {
    const pair = " {d} " ++ bare_word ++ ", {d} " ++ under_word ++ "\n";
    // invariant: a reading never publishes more findings than one case earns
    assert(rung.deem_of(bare_run).answered <= 1);
    // invariant: a reading never leaves more cases unanswered than one desk holds
    assert(rung.deem_of(under_run).unanswered <= 1);
    print("  positions carried past the run that heard them:" ++ pair, .{
        rung.endure_of(bare_run).kept, rung.endure_of(under_run).kept,
    });
    print("  inherited positions weighed into the run's own word:" ++ pair, .{
        rung.heed_of(bare_run).heeded, rung.heed_of(under_run).heeded,
    });
    print("  standing positions let go on their holder's own word:" ++ pair, .{
        rung.relent_of(bare_run).withdrawn, rung.relent_of(under_run).withdrawn,
    });
    print("  standing positions left exactly where they were found:" ++ pair, .{
        rung.relent_of(bare_run).standing, rung.relent_of(under_run).standing,
    });
    print("  withdrawn quarrels still standing over the plan:" ++ pair, .{
        rung.relent_of(bare_run).uncleared, rung.relent_of(under_run).uncleared,
    });
    print("  standing positions this run said the age of:" ++ pair, .{
        rung.dwell_of(bare_run).aged, rung.dwell_of(under_run).aged,
    });
    print("  standing positions left with no age at all:" ++ pair, .{
        rung.dwell_of(bare_run).undated, rung.dwell_of(under_run).undated,
    });
    print("  standing quarrels whose note never said how long:" ++ pair, .{
        rung.dwell_of(bare_run).ageless, rung.dwell_of(under_run).ageless,
    });
    print("  standing quarrels published where the outcome is read:" ++ pair, .{
        rung.swell_of(bare_run).heralded, rung.swell_of(under_run).heralded,
    });
    print("  standing quarrels left unpublished at the outcome:" ++ pair, .{
        rung.swell_of(bare_run).unpublished, rung.swell_of(under_run).unpublished,
    });
    print("  long-standing quarrels an operator reads no louder than a fresh one: {d} against {d}\n", .{
        rung.swell_of(bare_run).unheralded, rung.swell_of(under_run).unheralded,
    });
    tell_desist_third(rung, bare_word, under_word, bare_run, under_run);
}

/// Prints what a hand outside the argument was given, and what the plan said.
///
/// The third of the telling, split at the seam where the quarrel's own record
/// ends and the case carried outside it begins, so no one reading grows past the
/// length a person takes in at one glance.
///
/// Eight rungs held this body too, identical save the same two words, and it
/// lifts here beside the half it follows. Its own tail lifted next, and the
/// staircase beneath it -- once thought to want an accessor born -- turned out
/// to have every accessor it needed already standing, so `tell_beckon_own` folded
/// as a comptime table each rung reads its own share of.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_desist_third(
    comptime rung: type,
    comptime bare_word: []const u8,
    comptime under_word: []const u8,
    bare_run: *rung.Report,
    under_run: *rung.Report,
) void {
    const pair = " {d} " ++ bare_word ++ ", {d} " ++ under_word ++ "\n";
    // invariant: a telling always reads two runs that were actually run
    assert(rung.run_of(bare_run).queued >= 1);
    // invariant: a telling never reads more findings than one case may earn
    assert(rung.deem_of(under_run).answered <= 1);
    print("  long-standing quarrels carried to a hand that is neither party:" ++ pair, .{
        rung.refer_of(bare_run).referred, rung.refer_of(under_run).referred,
    });
    print("  long-standing quarrels kept inside the argument:" ++ pair, .{
        rung.refer_of(bare_run).kept_in, rung.refer_of(under_run).kept_in,
    });
    print("  long-standing quarrels nobody outside the argument ever sees: {d} against {d}\n", .{
        rung.refer_of(bare_run).unheard, rung.refer_of(under_run).unheard,
    });
    print("  carried cases whose answer was read and published:" ++ pair, .{
        rung.deem_of(bare_run).answered, rung.deem_of(under_run).answered,
    });
    print("  carried cases still waiting on a third hand's word:" ++ pair, .{
        rung.deem_of(bare_run).awaited_in, rung.deem_of(under_run).awaited_in,
    });
    print("  cases carried out that nobody is ever heard back on: {d} against {d}\n", .{
        rung.deem_of(bare_run).unanswered, rung.deem_of(under_run).unanswered,
    });
    print("  published findings the plan answered on the record:" ++ pair, .{
        rung.avow_of(bare_run).said, rung.avow_of(under_run).said,
    });
    print("  published findings left without a word from the plan:" ++ pair, .{
        rung.avow_of(bare_run).withheld, rung.avow_of(under_run).withheld,
    });
    print("  findings a plan published and never said one word about: {d} against {d}\n", .{
        rung.avow_of(bare_run).unavowed, rung.avow_of(under_run).unavowed,
    });
    print("  concessions booked as a debt the next run finds:" ++ pair, .{
        rung.owe_of(bare_run).booked, rung.owe_of(under_run).booked,
    });
    print("  concessions left owing nothing to any run after:" ++ pair, .{
        rung.owe_of(bare_run).unowed, rung.owe_of(under_run).unowed,
    });
    print("  concessions a plan made that reach no run after them: {d} against {d}\n", .{
        rung.owe_of(bare_run).unbooked, rung.owe_of(under_run).unbooked,
    });
    print("  inherited debts this run met and took down:" ++ pair, .{
        rung.meet_of(bare_run).met, rung.meet_of(under_run).met,
    });
    print("  inherited debts left standing for the run after:" ++ pair, .{
        rung.meet_of(bare_run).deferred, rung.meet_of(under_run).deferred,
    });
    print("  debts a plan inherited that the run never met: {d} against {d}\n", .{
        rung.meet_of(bare_run).unmet, rung.meet_of(under_run).unmet,
    });
    rung.tell_desist_tail(bare_run, under_run);
}

/// The desisting telling's last movement, standing once for the eight rungs
/// that print it. Six of the symbols it reaches already stood public across all
/// eight, and the three deepest tiers -- sufficing, reopening, reweighing -- are
/// reached through each rung's own accessor rather than through raw nesting, so
/// the staircase stays written where each rung writes it. Each rung's own next
/// hop stays in the rung's delegate, since one rung of the eight hands on
/// somewhere the other seven do not.
pub fn tell_desist_tail(
    comptime rung: type,
    comptime bare_word: []const u8,
    comptime under_word: []const u8,
    bare_run: *rung.Report,
    under_run: *rung.Report,
) void {
    const pair = " {d} " ++ bare_word ++ ", {d} " ++ under_word ++ "\n";
    // invariant: a telling always reads two runs that were actually run
    assert(rung.run_of(bare_run).queued >= 1);
    // invariant: a telling never reads more deliveries than one finding earns
    assert(rung.apprise_of(under_run).apprised <= 1);
    print("  meetings this run said the upshot of:" ++ pair, .{
        rung.redress_of(bare_run).redressed, rung.redress_of(under_run).redressed,
    });
    print("  meetings this run closed without a word:" ++ pair, .{
        rung.redress_of(bare_run).bare, rung.redress_of(under_run).bare,
    });
    print("  debts a plan met whose meeting never said what it found: {d} against {d}\n", .{
        rung.redress_of(bare_run).hollow, rung.redress_of(under_run).hollow,
    });
    print("  findings this run carried to the reader who won them:" ++ pair, .{
        rung.apprise_of(bare_run).apprised, rung.apprise_of(under_run).apprised,
    });
    print("  findings this run kept inside its own notes:" ++ pair, .{
        rung.apprise_of(bare_run).withheld, rung.apprise_of(under_run).withheld,
    });
    print("  findings a plan reached whose raiser was never told: {d} against {d}\n", .{
        rung.apprise_of(bare_run).unheard, rung.apprise_of(under_run).unheard,
    });
    print("  answers this run read its reader's own word on:" ++ pair, .{
        rung.suffice_of(bare_run).weighed, rung.suffice_of(under_run).weighed,
    });
    print("  answers this run carried with nobody asked about them:" ++ pair, .{
        rung.suffice_of(bare_run).unweighed, rung.suffice_of(under_run).unweighed,
    });
    print("  answers a plan carried whose worth it never learned: {d} against {d}\n", .{
        rung.suffice_of(bare_run).unmeasured, rung.suffice_of(under_run).unmeasured,
    });
    print("  matters this run took up again on its reader's word:" ++ pair, .{
        rung.reopen_of(bare_run).taken_up, rung.reopen_of(under_run).taken_up,
    });
    print("  short words this run read and left closed:" ++ pair, .{
        rung.reopen_of(bare_run).left_closed, rung.reopen_of(under_run).left_closed,
    });
    print("  words calling an answer short that opened nothing:" ++ pair, .{
        rung.reopen_of(bare_run).unheeded, rung.reopen_of(under_run).unheeded,
    });
    print("  reopened matters this run looked at again and took down:" ++ pair, .{
        rung.reweigh_of(bare_run).looked, rung.reweigh_of(under_run).looked,
    });
    print("  reopened matters left standing for the run after:" ++ pair, .{
        rung.reweigh_of(bare_run).passed, rung.reweigh_of(under_run).passed,
    });
    print("  reopened matters a plan inherited that the run never looked at: {d} against {d}\n", .{
        rung.reweigh_of(bare_run).unlooked, rung.reweigh_of(under_run).unlooked,
    });
}

/// One line of the own-telling -- what it says, which counter it reads, and
/// whether it reads that counter under this rung's own two words or as the bare
/// against-line every tier closes on.
const TellLine = struct {
    said: []const u8,
    count: []const u8,
    paired: bool = true,
};

/// One tier of the own-telling -- the accessor a rung above this tier reaches it
/// through, the counter standing directly on this tier's own report, and the
/// lines the tier says about itself.
///
/// A rung reaches a tier below it through `of` and its own tier through `mine`,
/// and exactly one of the two answers for any given rung. So a rung's share of
/// the staircase is *derived* from the accessors it declares rather than kept in
/// a list somebody maintains by hand (REDS %102's lesson).
const TellTier = struct {
    of: []const u8,
    mine: []const u8,
    lines: []const TellLine,
};

/// The whole staircase of the own-telling, deepest tier first.
///
/// Seven rungs -- beckon, answer, abate, conclude, respect, refrain, farewell --
/// each printed the share of this staircase reaching from the recount tier up to
/// its own, and every one of them wrote that share out longhand through a raw
/// chain of `inner`. Read together they are one sequence in strict prefix order:
/// beckon says the first seventeen lines, answer the first twenty, and farewell
/// all thirty-five, each line for line identical save the two words naming which
/// plan a column reports. It stands here once.
const own_telling = [_]TellTier{
    .{ .of = "recount_of", .mine = "untold", .lines = &.{
        .{ .said = "  second looks this run carried home to the reader who asked:", .count = "recounted" },
        .{ .said = "  second looks this run kept inside its own notes:", .count = "withheld" },
        .{ .said = "  second looks a run made whose reader was never told:", .count = "untold", .paired = false },
    } },
    .{ .of = "allay_of", .mine = "unheard", .lines = &.{
        .{ .said = "  tellings this run read its reader's own word on:", .count = "read_back" },
        .{ .said = "  tellings this run made with nobody's reply opened:", .count = "unread" },
        .{ .said = "  tellings a run made whose reader's word was never read back:", .count = "unheard", .paired = false },
    } },
    .{ .of = "forbear_of", .mine = "unhanded", .lines = &.{
        .{ .said = "  standing matters this run handed to the run after it:", .count = "forborne" },
        .{ .said = "  standing matters this run left for the next run to open afresh:", .count = "opened" },
        .{ .said = "  matters a run left standing with nothing handed on:", .count = "unhanded", .paired = false },
    } },
    .{ .of = "mind_of", .mine = "unminded", .lines = &.{
        .{ .said = "  inherited impasses this run named where the outcome is read:", .count = "minded" },
        .{ .said = "  inherited impasses this run began the matter again from:", .count = "begun" },
        .{ .said = "  impasses a run opened holding and never named:", .count = "unminded", .paired = false },
    } },
    .{ .of = "desist_of", .mine = "unbounded", .lines = &.{
        .{ .said = "  twice-carried impasses this run stood a wall around:", .count = "walled" },
        .{ .said = "  impasses a plan carried round twice and relayed anyway:", .count = "unbounded", .paired = false },
    } },
    .{ .of = "beckon_of", .mine = "unheralded", .lines = &.{
        .{ .said = "  stood walls this run carried out to the person who can act on it:", .count = "beckoned" },
        .{ .said = "  stood walls this run kept in the plan's own drawer:", .count = "kept" },
        .{ .said = "  walls a plan stood and told nobody about:", .count = "unheralded", .paired = false },
    } },
    .{ .of = "answer_of", .mine = "unopened", .lines = &.{
        .{ .said = "  carried calls this run opened its reader's own answer to:", .count = "opened" },
        .{ .said = "  carried calls this run left the reader's answer to standing shut:", .count = "left" },
        .{ .said = "  answers a reader wrote back that the plan never opened:", .count = "unopened", .paired = false },
    } },
    .{ .of = "abate_of", .mine = "unabated", .lines = &.{
        .{ .said = "  opened releases this run took its own wall down on:", .count = "abated" },
        .{ .said = "  opened releases this run held its own wall standing against:", .count = "held" },
        .{ .said = "  walls a plan kept standing after their reader took the matter up:", .count = "unabated", .paired = false },
    } },
    .{ .of = "conclude_of", .mine = "unclosed", .lines = &.{
        .{ .said = "  opened answers this run wrote a closure for:", .count = "closed" },
        .{ .said = "  opened answers this run handed on with nothing written:", .count = "left_open" },
        .{ .said = "  correspondences a reader ended that no later run could tell from one merely stopped:", .count = "unclosed", .paired = false },
    } },
    .{ .of = "respect_of", .mine = "unrespected", .lines = &.{
        .{ .said = "  inherited endings this run named where the outcome is read:", .count = "respected" },
        .{ .said = "  inherited endings this run began the matter again from:", .count = "reopened" },
        .{ .said = "  endings a run opened holding and never named:", .count = "unrespected", .paired = false },
    } },
    .{ .of = "refrain_of", .mine = "unspared", .lines = &.{
        .{ .said = "  readers of a named ending this run finally left alone:", .count = "refrained" },
        .{ .said = "  readers of a named ending this run summoned about the matter again:", .count = "recalled" },
        .{ .said = "  readers a plan summoned again about a matter it had already named as ended:", .count = "unspared", .paired = false },
    } },
    .{ .of = "farewell_of", .mine = "unsaid", .lines = &.{
        .{ .said = "  spared readers this run finally told the plan had stopped writing:", .count = "bidden" },
        .{ .said = "  spared readers this run left to interpret a silence:", .count = "withheld_parting" },
        .{ .said = "  readers a plan stopped writing to without ever saying so:", .count = "unsaid", .paired = false },
    } },
};

/// Tells what a run carried, tier by tier, from the recount tier up to the
/// rung's own -- and then the three lines every rung of this family closes on.
///
/// This is the staircase the desisting fold left standing, and the accessor it
/// was said to want turned out to be **already born**: every rung of this arc
/// publishes one named reach per tier it wraps, and those reaches form an exact
/// triangle -- farewell declares eleven, refrain ten, beckon five -- so a rung's
/// share of the staircase is read off the accessors it declares. Nothing here
/// counts nesting, and no rung widened an accessor to be folded.
///
/// The two words are `comptime`, the way the desisting telling takes them, so
/// each rung hands in the pair naming which plan its two columns report.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn tell_beckon_own(
    comptime rung: type,
    comptime bare_word: []const u8,
    comptime under_word: []const u8,
    bare_run: *rung.Report,
    under_run: *rung.Report,
) void {
    const pair = " {d} " ++ bare_word ++ ", {d} " ++ under_word ++ "\n";
    // invariant: a telling always reads two runs that were actually run
    assert(rung.run_of(bare_run).queued >= 1);
    // invariant: a telling never names more impasses than one forbearance carries
    assert(rung.mind_of(under_run).minded <= 1);
    inline for (own_telling) |tier| {
        const below = comptime @hasDecl(rung, tier.of);
        const own = comptime @hasField(rung.Report, tier.mine);
        const ways: u32 = @intFromBool(below) + @intFromBool(own);
        // invariant: a rung reaches a tier exactly one way, or skips it entirely
        comptime assert(ways <= 1);
        if (comptime below or own) {
            const bare = if (comptime below) @field(rung, tier.of)(bare_run) else bare_run;
            const under = if (comptime below) @field(rung, tier.of)(under_run) else under_run;
            inline for (tier.lines) |line| {
                const said = comptime if (line.paired) line.said ++ pair else line.said ++ " {d} against {d}\n";
                print(said, .{ @field(bare, line.count), @field(under, line.count) });
            }
        }
    }
    print("  work still standing when the supervisor exits:" ++ pair, .{
        rung.below_of(bare_run).unserved, rung.below_of(under_run).unserved,
    });
    print("  the plan, as an operator finally reads it: {s} " ++ bare_word ++ ", {s} " ++ under_word ++ "\n", .{
        rung.settlement_words(rung.bearing_of(bare_run).settlement), rung.settlement_words(rung.bearing_of(under_run).settlement),
    });
    print("  breaks a named turn:" ++ pair, .{
        rung.preceded_of(bare_run).out_of_precede, rung.preceded_of(under_run).out_of_precede,
    });
}

/// Reads the arcs one dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
///
/// Forty-two rungs held this body, byte for byte, at forty-four lines apiece --
/// the largest single carry this arc has folded, and the one that stayed
/// invisible through six folds because every meter before it read the `tell_`
/// family and this body opens on `stand_`. Asking the masked question of every
/// printing body rather than one family's is what found it (`REDS %102`: a
/// reading that sees a subset answers in the voice of the whole).
///
/// Nothing here varies between rungs, so nothing arrives as comptime text. The
/// body lifts exactly as a check lifts: the rung hands itself in, and every
/// helper this window walks -- the line a dependent reads of its own, the graft,
/// the return, the probe that asks what is still reachable, and the plan's own
/// declaration that this dependent falls -- is reached through that rung, so
/// each rung still measures its own report and its own store.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn stand_taking_and_returning_reach(
    comptime rung: type,
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    // invariant: a standing dependent always knows which domain it is
    assert(domain.len >= 1);
    // invariant: a standing dependent always reads at least one arc
    assert(task.hops.count >= 1);
    if (rung.read_own_line(io, slot, task)) |code| return code;

    const promised = rung.offered(io, domain) catch 0;
    // invariant: a promise never names more reach than one line may hold
    assert(promised <= cycle.max_hops);

    var granted: rung.Words = .{};
    var carried: u32 = 0;
    if (rung.graft_promised_reach(io, slot, domain, task, promised, &granted, &carried)) |code| return code;

    // The return, when a pruning was promised: the reach comes back and the
    // dependent answers how much of it it gave up.
    const gave_back = rung.return_promised_reach(io, base, slot, domain, &granted, carried) orelse
        return carry.Outcome.malformed;

    const reachable = rung.reachable_between(io, slot, &granted, 0, carried);
    print("    {s}: read {d} arcs of its own, {d} inherited at its first breath, {d} conferred, {d} returned, {d} still reachable at home\n", .{
        domain, task.hops.count, found, carried, gave_back, reachable,
    });

    // A plan declares how each dependent ends, and this rung honors that
    // declaration here -- after the conferral is grafted and answered for, and
    // before the work it was granted for is carried. That window is the whole
    // subject of the rung: a dependent that falls holding conferred reach.
    if (rung.falling_promised(io, domain)) {
        print("    {s}: falls as its author declared, holding {d} conferred arcs it never served\n", .{
            domain, carried,
        });
        return carry.Outcome.bytes_differed;
    }
    return carry.Outcome.carried_ok;
}

/// Repairs the losses a plan took that its author never asked it to carry, and
/// settles what the repair could not reach.
///
/// Thirty-seven rungs held this body, byte for byte, at a hundred and
/// seventy-eight lines apiece -- 6,408 carried lines, the largest single fold
/// this arc has taken and half again the fold before it. The whole-body meter
/// named it on the lap that meter was born, so this fold was chosen by
/// measurement rather than by which family somebody happened to look at
/// (`../tools/fixtures/caravan_ladder_carry_scan.sh`).
///
/// Thirty-six of the thirty-seven stood identical on their own. The
/// thirty-seventh is `recant.rye`, the rung that *owns* the recanting tier: it
/// reached its own tally directly where every rung above reaches it through
/// `recanting_of`, so the body was nearly alike rather than exactly. Naming
/// that accessor there -- three lines, returning the report itself -- brought
/// the last rung into the fold. Fold J learned this lesson on the staircase,
/// and it holds again: an accessor born for the tier a rung owns is the cheapest
/// line in the arc.
///
/// Nothing varies between rungs, so nothing arrives as comptime text. The rung
/// hands itself in, and every symbol this body names -- its plan's phases, its
/// own report and the tiers beneath it, the wire it published its judgment to,
/// each refusal it may raise, and the four spine bodies the repair runs
/// (`seat_the_record`, `fill_table`, `reap_oldest`, `judge_outcome`) -- is
/// reached through that rung. So each rung still mends its own plan, weighed
/// against its own wire, into its own report.
///
/// Widening those four spine bodies is a fold's own compounding: `fill_table`
/// carries 2,898 lines across 43 rungs and `reap_oldest` 1,716 across 40, and
/// both now stand public for the folds that come for them.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn mend_the_plan(
    comptime rung: type,
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    base: []const rung.Phase,
    wake: gap.Wake,
    keeping: rung.Keep,
    bearing: rung.Bearing,
    standard: rung.Standard,
    review: rung.Review,
    table: *rung.Table,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError || cohort.RunError || boot.BootError)!void {
    // invariant: a mend always reads a record the run has drained
    assert(table.left == 0);
    // invariant: a mend always reads a plan the run actually held
    assert(base.len == table.held);
    const lost = rung.abandoning_of(report_out).abandoned;
    if (lost == 0) {
        // invariant: a plan that lost nothing leaves nothing standing
        assert(rung.below_of(report_out).unserved == 0);
        rung.below_of(report_out).settled = .carried;
        rung.bearing_of(report_out).settlement = .carried;
        return;
    }

    // The wire before the memory: what this run published about itself, read
    // back the way an operator would read it.
    const published = rung.verdict_published(io);
    const named = rung.lost_published(io, table.held);
    const marked = if (bearing == .borne) rung.bearing_published(io, table.held) & named else 0;
    // The judgment, read from the wire the run wrote it to rather than folded
    // again here. A standard applied twice is a standard nobody published.
    const judged = if (standard == .weighed) rung.appraisal_published(io, table.held) & named else 0;
    if (rung.marked_reach(marked, judged)) |why| return why;
    // The reversal, read from the same wire and never folded again here. Under
    // `.stand` the run published none, so this is zero and every appraised loss
    // is spared exactly as the rung below spares it.
    const taken_back = if (review == .revisit) rung.recant_published(io, table.held) & named else 0;
    // A judgment is kept or taken back, never both -- the honesty of the count,
    // read straight off the two notes rather than inferred from either.
    if ((judged & taken_back) != 0) return error.RecantMiscounted;
    const on_the_wire = judged | taken_back;
    if (on_the_wire != 0) {
        if (rung.recant_refusal(
            published,
            @popCount(on_the_wire),
            @popCount(judged),
            @popCount(taken_back),
        )) |why| return why;
    }
    const spared = marked | judged;
    var seating: u32 = 0;
    var bore: u32 = 0;
    var weighed: u32 = 0;
    var at: u32 = 0;
    while (at < table.held) : (at += 1) {
        if ((named & rung.phase_bit(at)) == 0) continue;
        if ((judged & rung.phase_bit(at)) != 0) {
            weighed += 1;
            bore += 1;
            continue;
        }
        if ((marked & rung.phase_bit(at)) != 0) {
            bore += 1;
            continue;
        }
        seating += 1;
    }
    // invariant: the walk weighed every phase of the record, none skipped
    assert(at == table.held);
    // invariant: a run never weighs more loss than it carried in all
    assert(weighed <= bore);
    if (rung.appraise_refusal(published, lost, bore - weighed, weighed, seating)) |why| return why;
    if (rung.bear_refusal(published, lost, bore, seating)) |why| return why;
    if (seating >= 1) {
        if (rung.mend_refusal(published, lost, seating)) |why| return why;
    }
    rung.bearing_of(report_out).bore = bore;
    rung.appraising_of(report_out).weighed = weighed;

    var again: [rung.max_queue_len]rung.Phase = undefined;
    var wrote: u32 = 0;
    var seated_mask: u32 = 0;
    at = 0;
    while (at < table.held) : (at += 1) {
        if ((named & rung.phase_bit(at)) == 0) continue;
        if ((spared & rung.phase_bit(at)) != 0) continue;
        again[wrote] = rung.reseated(base[at], wrote);
        seated_mask |= rung.phase_bit(at);
        wrote += 1;
    }
    // The obedience this rung measures, taken before the repair runs rather
    // than inferred from it afterwards: arcs the plan asked to bear that the
    // repair is about to run anyway. The measurement weighs what the *plan*
    // asked, so the elder reading is counted rather than refused -- and the
    // refusal weighs what this run's own bearing *published*, so a repair that
    // reaches past the wire it read is stopped by name before it spawns, and
    // before any invariant beneath it has to catch a supervisor in the act.
    rung.bearing_of(report_out).overrepaired = rung.overrepaired(table.bear_mask & named, seated_mask);
    if (rung.overrepaired(marked, seated_mask) >= 1) return error.BearOverrepaired;
    // This rung's own name for the same overreach, one tier out: a repair that
    // seats a phase its run's own appraisal spared has reached past the wire it
    // read, and it is stopped here -- before it spawns, and before any invariant
    // beneath it has to catch a supervisor in the act.
    if (rung.repaired_spent(judged, seated_mask) >= 1) return error.AppraiseUnweighed;
    // The judgment this rung measures, taken the same way and at the same
    // moment: arcs the run's own evidence said the plan had got past, that the
    // repair is about to run anyway. The measurement weighs what the *run
    // learned*, so the elder reading is counted rather than refused, while the
    // refusal above weighs what this run's own appraisal published.
    rung.appraising_of(report_out).repaired_spent = rung.repaired_spent(
        rung.appraised_in(rung.standing(table), named, table.bear_mask),
        seated_mask,
    );
    // The answer of this rung, taken at the same moment and in the same shape:
    // a recanted arc that the repair then declines to run has published a
    // reversal it never carried out, and it is stopped here -- before it spawns,
    // and before an operator reads a settlement the wire does not support.
    if (@popCount(taken_back & ~seated_mask) >= 1) return error.RecantUnspoken;
    rung.recanting_of(report_out).recanted = @popCount(taken_back);
    // The measurement this rung moves, weighed against what the *run learned*
    // rather than what any wire said, so the elder reading is counted rather
    // than refused: arcs a judgment spared while this run's own evidence
    // declines to weigh them spent. A marked loss stays outside it, since no
    // judgment was ever made about an arc its author named.
    rung.recanting_of(report_out).spared_disproved = rung.spared_disproved(
        judged,
        rung.appraised_in(rung.standing(table), named, table.bear_mask),
    );
    // invariant: the mend seated exactly the phases the wire left it
    assert(wrote == seating);

    if (wrote == 0) {
        // Every loss this plan took is loss its author asked to carry, so the
        // repair has nothing to run and the settlement says the plan is as
        // whole as it was ever asked to be.
        try rung.settle_the_plan(io, lost, 0, report_out);
        return;
    }

    var second: rung.Table = .{};
    try rung.seat_the_record(again[0..wrote], &second);
    rung.below_of(report_out).reseated += wrote;

    while (second.left > 0 or second.in_flight > 0) {
        const took_up = try rung.fill_table(
            allocator, io, self_path, sys, caps, wake, .preceded, keeping, &second, report_out,
        );
        if (second.in_flight > rung.run_of(report_out).peak_in_flight) {
            rung.run_of(report_out).peak_in_flight = second.in_flight;
        }
        if (second.left > 0) {
            const free = rung.max_in_flight - second.in_flight;
            rung.run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) rung.run_of(report_out).idle_turns += 1;
        }
        if (second.in_flight == 0) return error.OrderStalled;
        try rung.reap_oldest(io, &second, .answered, report_out);
    }
    // invariant: the repair was taken up whole, and every dependent reaped
    assert(second.left == 0);
    assert(second.in_flight == 0);

    var j: u32 = 0;
    while (j < second.finished) : (j += 1) try rung.judge_outcome(second.done[j], report_out);
    // invariant: every dependent of the repair was judged, none skipped
    assert(j == second.finished);
    // invariant: a repair never loses an arc of its own, since it confers none
    assert(second.lost_mask == 0);

    // What the repair carried is what it seated, since every phase of it was
    // judged against the outcome its own author declared and none was
    // conferred away. So the work still standing is the loss minus the repair.
    try rung.settle_the_plan(io, lost, wrote, report_out);
}

/// Publishes what a run came to, weighs the judgments standing on its own
/// wire, and leaves the report holding exactly the loss a repair must answer.
///
/// Thirty-seven rungs held this body byte for byte at seventy-five lines
/// apiece -- 2,700 carried lines, the largest family standing on the ladder
/// once `mend_the_plan` was lifted, and named here by the whole-body meter
/// rather than by which name somebody happened to look at
/// (`../tools/fixtures/caravan_ladder_carry_scan.sh`).
///
/// All thirty-seven stood identical on their own, and every one of the
/// eighteen symbols this body reaches -- its own report and the tiers beneath
/// it, the four notes it writes to the wire and the three it reads back, the
/// two masks it folds, and each refusal it may raise -- already stood public
/// on all thirty-seven. So this fold cost no accessor at all, which is what a
/// ladder looks like after eleven folds have taught it to publish what it
/// shares.
///
/// Four elder rungs keep a body of their own -- `reckon.rye` at 27 lines,
/// `mend.rye` at 35, `bear.rye` at 41, and `appraise.rye` at 51 -- because
/// each is the rung where a tier grew and its body genuinely differs. A fold
/// that swept them in would have folded four different meanings into one, so
/// they stay home and the meter keeps counting them apart.
///
/// Nothing varies between the thirty-seven, so nothing arrives as comptime
/// text. The rung hands itself in, and each still reckons its own plan,
/// against its own wire, into its own report.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn reckon_the_plan(
    comptime rung: type,
    io: std.Io,
    table: *const rung.Table,
    ledger: rung.Ledger,
    review: rung.Review,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    // invariant: a reckoning always reads a record the run has drained
    assert(table.left == 0);
    const absorbed = rung.abandoning_of(report_out).inner.inner.inner.inner.absorbed;
    const lost = rung.abandoning_of(report_out).abandoned;
    try rung.lost_note(io, table.held, table.lost_mask);
    // The bearing rides beside the loss, written from the plan the run seated
    // rather than from anything it learned along the way: a phase asked to be
    // borne asked it before the run began.
    try rung.bearing_note(io, table.held, table.lost_mask & table.bear_mask);
    // The appraisal rides beside both, and unlike either it is written from
    // what the run learned: which of the losses its author left unmarked this
    // run's own downstream says the plan got past. Written here, while the run
    // still holds the record that proves it, and read back before the repair
    // spares a single phase on its word.
    // The judgment already standing on the wire, read before this run writes a
    // word over it. It may have been left by a run that is over, since the
    // appraisal is the one note a run never clears.
    const held_before = rung.appraisal_published(io, table.held);
    // What this run's own record supports, folded fresh from the evidence it
    // still holds.
    const evidenced = rung.appraised_in(rung.standing(table), table.lost_mask, table.bear_mask);
    // The reversal, and the whole of what this rung adds: which standing
    // judgments this run lost the same arc for and declines to weigh spent.
    // Under `.stand` a run publishes none, since it never weighs what it found.
    const taken_back = if (review == .revisit)
        rung.recanted_in(held_before, evidenced, table.lost_mask)
    else
        0;
    // The supply, refused by name while the judgment it must answer to is still
    // in hand: a recantation may reach only an arc some appraisal spared.
    if (rung.unappraised_reach(held_before, taken_back)) |why| return why;
    try rung.recant_note(io, table.held, taken_back);
    // The appraisal rides beside both. Under `.revisit` it is exactly what this
    // run's evidence supports, so a recanted judgment leaves the wire in the
    // same breath it is taken back. Under `.stand` this run's reading joins the
    // one it found rather than weighing it -- which is where the rung below
    // leaves a record, and why a plan the wire holds no judgment about reads
    // there exactly.
    try rung.appraisal_note(io, table.held, switch (review) {
        .stand => held_before | evidenced,
        .revisit => evidenced,
    });
    if (absorbed == 0) {
        // invariant: a plan that absorbed nothing can have lost nothing
        assert(lost == 0);
        // invariant: a plan that lost nothing names no phase in its loss
        assert(table.lost_mask == 0);
        rung.below_of(report_out).inner.verdict = .carried;
        rung.below_of(report_out).settled = .carried;
        rung.bearing_of(report_out).settlement = .carried;
        try rung.verdict_note(io, .carried);
        try rung.settlement_note(io, .carried);
        return;
    }
    if (rung.reckon_refusal(absorbed, table.in_flight, lost)) |why| return why;

    const verdict = rung.verdict_in(lost, ledger);
    try rung.verdict_note(io, verdict);
    const said = rung.verdict_published(io) orelse return error.ReckonOverclaimed;
    if (said != verdict) return error.ReckonOverclaimed;
    if (ledger == .reckoned and said == .carried and lost >= 1) return error.ReckonOverclaimed;
    rung.below_of(report_out).inner.verdict = said;
    rung.below_of(report_out).inner.overclaimed += rung.overclaimed_completion(lost, said);
    // Where the run stands before any repair: the loss, entire. A mend moves
    // this number and nothing else moves it.
    rung.below_of(report_out).unserved = lost;
    rung.below_of(report_out).settled = said;
}

/// Takes up every phase a run may start right now -- conferring the slots that
/// are owed, admitting what the doors allow, and recording each turn, fence,
/// mask, and precedence a pick stepped past on the way.
///
/// **This is the largest family the ladder has ever folded, and finding its
/// true size took reading past the meter's own answer.** The carry scan names
/// families by exact text, so `fill_table` printed as thirty-seven rungs at
/// sixty-nine lines. Forty-three rungs hold this body, and the six the queue
/// left out differ from the other thirty-seven **by the word `pub` and nothing
/// else** -- one line of a sixty-nine-line body. Fold M had already measured it
/// at 2,898 lines across forty-three and written that number down beside the
/// four spine bodies it widened for exactly this fold; the queue, reading text
/// rather than meaning, could only see 2,484 of it.
///
/// So a fold queue is a lead rather than a verdict: it names where to look, and
/// the reading that follows is what says how much is actually there. A family
/// split by one keyword is one family.
///
/// Every symbol this body reaches -- the five bodies that move the table
/// (`advance_head`, `confer_slot`, `confer_one`, `choose_pass`, `start_one`),
/// the three that weigh a pick (`door_admits`, `sibling_waits`, `elder_waits`),
/// the three report reaches (`run_of`, `masked_of`, `preceded_of`), and the
/// shapes and bounds it names -- is reached through the rung handed in, so each
/// rung still fills its own table, against its own doors, into its own report.
///
/// `mask.prefix_mask` and `mask.fence_after` stay module-level, since a mask is
/// the same arithmetic for every rung on the ladder rather than something a
/// rung writes over its own report.
///
/// Nothing varies between the forty-three, so nothing arrives as comptime text.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn fill_table(
    comptime rung: type,
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: rung.Reading,
    keeping: rung.Keep,
    table: *rung.Table,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError || cohort.RunError || boot.BootError)!u32 {
    // invariant: a fill always reads a record the run has seated
    assert(table.held >= 1);
    // invariant: a run never remembers more lines than it may hold
    assert(table.in_flight <= rung.max_in_flight);
    var took_up: u32 = 0;
    while (table.left > 0) {
        rung.advance_head(table);
        // invariant: work still waiting always leaves a head to weigh
        assert(table.head < table.held);

        if (rung.confer_slot(table, table.head)) |slot| {
            try rung.confer_one(io, sys, caps, table, slot, table.head, keeping, report_out);
            table.started[table.head] = true;
            table.left -= 1;
            took_up += 1;
            continue;
        }

        if (table.in_flight >= rung.max_in_flight) break;

        var pick: u32 = table.head;
        if (!try rung.door_admits(sys, table, table.head)) {
            pick = try rung.choose_pass(sys, table, reading) orelse break;
            rung.run_of(report_out).passes += 1;
            const gained = pick - table.head;
            if (gained > rung.run_of(report_out).pass_reach) rung.run_of(report_out).pass_reach = gained;
        }
        const chosen = table.record[pick];
        if (rung.sibling_waits(table, pick, mask.prefix_mask(chosen.step))) {
            rung.masked_of(report_out).out_of_turn += 1;
        }
        if (rung.sibling_waits(table, pick, mask.prefix_mask(mask.fence_after(chosen.follows)))) {
            rung.masked_of(report_out).out_of_fence += 1;
        }
        if (rung.sibling_waits(table, pick, chosen.follows)) rung.masked_of(report_out).out_of_mask += 1;
        if (rung.elder_waits(table, pick)) rung.preceded_of(report_out).out_of_precede += 1;

        table.live[table.in_flight] = try rung.start_one(
            allocator, io, self_path, sys, caps, chosen, table.reserve_of[pick], keeping, wake, report_out,
        );
        table.lines[table.in_flight] = chosen.task;
        table.reserves[table.in_flight] = table.reserve_of[pick];
        table.taken[table.in_flight] = 0;
        table.served[table.in_flight] = 0;
        table.granted[table.in_flight] = 0;
        table.in_flight += 1;
        table.started[pick] = true;
        table.left -= 1;
        took_up += 1;
        rung.run_of(report_out).admitted += 1;
    }
    // invariant: a fill never overruns the table it fills
    assert(table.in_flight <= rung.max_in_flight);
    // invariant: a preceded reading never runs a phase past a turn its turn named
    assert(reading != .preceded or rung.preceded_of(report_out).out_of_precede == 0);
    return took_up;
}

/// Answers which standing dependent could carry this phase, if any could --
/// matching the phase's domain against a live dependent's, weighing the hops it
/// declares against the reach that dependent still holds in reserve, and
/// checking every arc it would walk for both name and write intent.
///
/// **Fold O prepared this fold entirely, and it shows in the cost: zero.** The
/// five bodies fold O widened to reach `fill_table` through the rung were the
/// same five this body needs -- `hop_count`, `reserve_depth`, `Table`,
/// `max_in_flight`, and the harness import itself already stood public in all
/// forty-three rungs before this round opened a file. A fold that widens for
/// one family often pays for the next several, and this is the first time the
/// arc has measured that debt coming back whole.
///
/// The queue's number was right this time: forty-three rungs, thirty-nine lines
/// apiece, 1,638 carried -- one body free and forty-two copies. Hashing the
/// family before folding it confirmed the count rather than correcting it,
/// which is what makes the check worth running either way.
///
/// Two elder rungs keep their own copies, and the reasons are real rather than
/// stylistic. `caravan/confer.rye` **owns** `reserve_arc_at`, so it calls that
/// body unqualified where every folded rung reaches it through this module --
/// and a fold would ask the module this harness imports to import the harness
/// back. `caravan/revoke.rye` predates the in-flight invariant and states one
/// assert fewer, so folding it would quietly add a check rather than move a
/// body. Both differences are two lines, and both stay home honestly.
///
/// `confer.reserve_arc_at`, `intent.declares_write`, and `cycle.max_hops` stay
/// module-level, since a reserve's arcs, an arc's write intent, and the bound
/// on how many hops one item may name are the same for every rung on the ladder.
///
/// Nothing varies between the forty-three, so nothing arrives as comptime text.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn confer_slot(comptime rung: type, table: *const rung.Table, at: u32) ?u32 {
    // invariant: a candidate always stands inside the record
    assert(at < table.held);
    // invariant: a run never remembers more lines than it may hold
    assert(table.in_flight <= rung.max_in_flight);
    const wanted = table.record[at].task;
    var i: u32 = 0;
    while (i < table.in_flight) : (i += 1) {
        if (!std.mem.eql(u8, table.live[i].domain, wanted.item.domain)) continue;
        const held = table.reserves[i] orelse continue;
        const depth = rung.hop_count(wanted);
        if (table.taken[i] + depth > rung.reserve_depth(held)) continue;
        var matched: u32 = 0;
        var wanted_arcs = std.mem.splitScalar(u8, wanted.item.hops, ',');
        var fits = true;
        while (wanted_arcs.next()) |hop| {
            // invariant: the walk stays inside the hops one item may name
            assert(matched < cycle.max_hops);
            const at_reserve = table.taken[i] + matched;
            const on_offer = confer.reserve_arc_at(held, at_reserve) orelse {
                fits = false;
                break;
            };
            if (!std.mem.eql(u8, on_offer, hop)) fits = false;
            if (intent.declares_write(held, at_reserve) != intent.declares_write(wanted, matched)) {
                fits = false;
            }
            if (!fits) break;
            matched += 1;
        }
        if (!fits) continue;
        // invariant: every arc the phase names was weighed against the reserve
        assert(matched == depth);
        return i;
    }
    // invariant: the walk read every dependent standing, none skipped
    assert(i == table.in_flight);
    return null;
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
///
/// A conferral is the moment the run stops starting things and starts *reusing*
/// one. The phase's hops are added to what this dependent has already taken, the
/// grown reach is offered to `entrust` for refusal, the words are written, the
/// dependent is asked, and only an answer read back off the wire lets the table
/// believe the reach was carried. Then the report counts it three ways and the
/// slot remembers which phase it absorbed, so a later mend can name the arc it
/// lost rather than re-running the plan whole.
///
/// **Forty rungs hold this body byte for byte, and the queue said so exactly.**
/// Fold O taught that a queue is a lead rather than a verdict, so every one of
/// the forty-five bodies named `confer_one` was hashed before a line moved. The
/// reading agreed with the meter: forty share one text at fifty-three lines,
/// 2,067 carried. A check that confirms is still a check worth running.
///
/// **The five that stand apart are the ladder's own fossil record.** Every one
/// of them differs in exactly one place -- how deep it reaches into the report
/// -- and read in ladder order they climb a staircase: `confer.rye` writes
/// `report_out.conferred`, `revoke.rye` one `inner` down, `reclaim.rye` two.
/// At `abandon.rye` the ladder stops counting hops and names the reach instead,
/// through `below_of`; `reckon.rye` settles the depth at three; and from
/// `amend.rye` upward the accessor's name settles too, as `abandoning_of`.
/// After that nothing about the reach is a per-rung fact any more, which is
/// precisely why the forty above are identical and the five below cannot be.
/// A family's absentees are worth reading, since they say when the shape they
/// refuse was born.
///
/// The two eldest also predate whole lines rather than a depth: `confer.rye` and
/// `revoke.rye` were written before a conferral granted, served, or pruned, so
/// folding either would quietly add behavior rather than move a body. Both stay
/// home named.
///
/// Every symbol this body reaches through the rung -- `hop_count`, `Words`,
/// `confer_words`, `confirm`, `abandoning_of`, `phase_bit`, and `revoke_one` --
/// belongs to the rung, since each is a body a rung writes over its own report
/// or its own wire. `entrust.entrust_refusal`, `entrust.Line`, and
/// `confer.write_words` stay module-level, since a refusal's arithmetic and the
/// words a conferral writes are the same for every rung on the ladder.
///
/// Nothing varies between the forty, so nothing arrives as comptime text.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn confer_one(
    comptime rung: type,
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *rung.Table,
    slot: u32,
    at: u32,
    keeping: rung.Keep,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    // invariant: a conferral always names a dependent the run is holding
    assert(slot < table.in_flight);
    // invariant: a conferral always names a phase inside the record
    assert(at < table.held);
    const grown = table.taken[slot] + rung.hop_count(table.record[at].task);
    var line: entrust.Line = .{};
    if (entrust.entrust_refusal(
        sys,
        table.lines[0..table.in_flight],
        table.reserves[0..table.in_flight],
        slot,
        table.taken[slot],
        grown,
        &line,
    )) |why| return why;

    var words: rung.Words = .{};
    try confer.write_words(
        caps,
        table.reserves[slot],
        grown,
        rung.hop_count(table.lines[slot]),
        &words,
    );
    try rung.confer_words(io, table.live[slot].domain, &words, grown);
    if (!rung.confirm(io, table.live[slot].domain, grown)) return error.ConferUnheld;
    table.granted[slot] += grown - table.taken[slot];
    table.taken[slot] = grown;
    // The dependent answers `.held` only after it has read every arc it grafted,
    // so the work this reach served is carried by the time the run reads it.
    table.served[slot] = grown;
    rung.abandoning_of(report_out).inner.inner.inner.conferred += 1;
    rung.abandoning_of(report_out).inner.inner.inner.inner.entrusted += 1;
    rung.abandoning_of(report_out).inner.inner.inner.inner.absorbed += 1;
    // Which phase this conferral carried, remembered against the slot that
    // took it up. A reclamation later sweeps the dependent's notes clean and
    // the report keeps only a count, so without this the run knows an arc was
    // lost and never which one -- and a mend that cannot name the phase can
    // only re-run the plan whole, which is the thing `MendOvereach` refuses.
    table.absorbed_mask[slot] |= rung.phase_bit(at);

    if (keeping == .pruned) try rung.revoke_one(io, table, slot, 0, report_out);
}


/// Weighs one published objection against the term the run was given -- asking
/// the reader again where a term can expire, and reading their silence as a
/// letting-go only where somebody was actually asked.
///
/// A term is the run's answer to the question an objection leaves open: how long
/// does a recorded disagreement stand? A perpetual term never asks, so nothing
/// expires and nothing is counted; every other term reaches the reader's own
/// published box, puts the question there, reads it back before weighing a word
/// of the answer, and refuses a second hand that names any other quarrel. Past
/// that refusal a hand at all is the objection raised again, and silence is the
/// objection let go.
///
/// **Thirty-one rungs hold this body byte for byte, and the queue could see
/// thirty of them.** Fold O taught that a queue is a lead rather than a verdict,
/// so every body named `weigh_the_term` was hashed before a line moved. Thirty
/// stood alike at sixty-nine lines; the thirty-first, `lapse.rye`, differed in
/// six places and every one of them was the same difference -- it *owns* the
/// lapsing tier, so it reached its own report directly where every rung above
/// reaches it through `lapsing_of`. A three-line identity accessor, born the way
/// fold M and fold J each taught, folds all sixty-nine.
///
/// **The fold cost twenty-two widenings and gave back nothing to a family.**
/// Fourteen of the sixteen symbols this body names stood public in all thirty-one
/// rungs already, paid for by the folds before it -- a fold pays its successors.
/// Only `lapsing_of` needed widening, and every one of its thirty bodies is a
/// distinct text, since each reaches a different depth, so widening splits no
/// family and hands back no carry.
pub fn weigh_the_term(
    comptime rung: type,
    io: std.Io,
    term: rung.Term,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const marked = rung.escort_written(io);
    const escorted: u32 = if (marked == null) 0 else 1;
    if (escorted == 0) {
        // invariant: a run that escorted nothing leaves no objection unbounded
        assert(rung.lapsing_of(report_out).unbounded == 0);
        return;
    }
    const held = rung.dispute_recorded(io);
    const disputed = held != null;

    // The measurement this rung moves, weighed against what the wire actually
    // carries rather than against what any term asked for, so an objection left
    // standing forever is counted rather than refused.
    rung.lapsing_of(report_out).unbounded = rung.objection_unbounded(escorted, disputed, term);
    const asked = rung.asked_in(escorted, disputed, term);
    if (term == .perpetual) {
        // invariant: an objection that stands forever was never asked about
        assert(asked == 0);
        return;
    }
    if (!disputed) {
        // A record holding no disagreement has nothing to put a term on, and the
        // wire says so by leaving the escort exactly as it reads.
        //
        // invariant: an unquarrelled word is never asked about
        assert(asked == 0);
        return;
    }
    const record = held orelse return error.LapseEarly;

    // The asking, and the act that earns the right to read a later silence as
    // silence. It reaches the reader's own box, and it is read back out of that
    // box before a single word of the answer is weighed.
    var address_buf: [rung.max_address_len]u8 = @splat(0);
    const address = rung.address_published(io, &address_buf) orelse return error.CourierUnaddressed;
    try rung.ask_again(io, address, record);
    const question = rung.asked_of(io, address) orelse return error.LapseUnasked;
    // A question naming any other quarrel would put a term on an objection this
    // reader never raised, which is the same overreach as quoting them wrongly.
    if (question[0] != record[0] or question[1] != record[1]) return error.LapseMisrenewed;
    rung.lapsing_of(report_out).asked = asked;

    // The reader's own second hand, or its absence. Neither is guessed at, and
    // the supervisor writes neither.
    const again = rung.renewed_by(io, address);
    // The hard half of this rung: a hand naming any other reading raises a
    // different quarrel entirely, and counting it as a renewal would keep a word
    // standing that its reader let go.
    if (again) |said| {
        if (!rung.renews(said, record)) return error.LapseMisrenewed;
    }
    // Past that refusal, a second hand at all is this objection raised again.
    const raised = again != null;
    const renewed_count = rung.renewed_in(asked, raised);
    const lapsed = rung.lapsed_in(asked, raised);
    // The silence, refused by name while the question it followed is still in
    // hand: a run calls an objection let go only where somebody was asked.
    if (rung.unasked_lapse(asked, lapsed)) |why| return why;
    if (rung.lapse_refusal(held, renewed_count, lapsed)) |why| return why;
    // invariant: a run that reached the term refuses nothing it must write
    assert(renewed_count + lapsed == 1);
    const life: rung.Life = if (raised) .renewed else .lapsed;
    try rung.lapse_note(io, life);
    rung.lapsing_of(report_out).renewed = renewed_count;
    rung.lapsing_of(report_out).lapsed = lapsed;
    // invariant: a bounded run leaves no published objection unbounded
    assert(rung.lapsing_of(report_out).unbounded == 0);
}

/// Records the disagreement a reader answered with, or sets that answer aside.
///
/// The wire before the memory, one tier further out than the hearing below it:
/// this run reads the letter out of the reader's own box, reads that reader's
/// own hand beside it, and writes the pair into its own record without ever
/// touching what the supervisor remembers doing. A plan that recorded its
/// reader's objection from its own memory of the correspondence would be
/// putting words in a person's mouth.
///
/// A run that carried nothing owes nobody a record, and says so by weighing
/// nothing rather than by inventing a quarrel. A reader who agreed is left
/// exactly as the rung below leaves them, agreed with and undisputed. Only a
/// reader who answered in a word this plan cannot accept is written down -- and
/// under `.settled` even that one is set aside.
///
/// **Thirty-three rungs hold this body, and the queue could see thirty-two.**
/// Every body named `record_the_dispute` was hashed before a line moved. Thirty
/// two stood alike at sixty-one lines; the thirty-third, `dispute.rye`, differed
/// in five places and every one of them was the same difference -- it *owns* the
/// disputing tier, so it reached its own report directly where every rung above
/// reaches it through `disputing_of`. A three-line identity accessor folds all
/// sixty-one, which is fold R's reading holding for a second family.
///
/// **The fold cost forty-nine widenings and split no family.** Fourteen of the
/// sixteen symbols this body names stood public in all thirty-three rungs
/// already, paid for by the folds before it. Only `couriering_of` and
/// `disputing_of` needed widening, and every one of their bodies is a distinct
/// text naming its own rung's report type, so the widening hands back no carry.
pub fn record_the_dispute(
    comptime rung: type,
    io: std.Io,
    receipt: rung.Receipt,
    record: rung.Standing,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const carried = rung.couriering_of(report_out).delivered;
    if (carried == 0 or receipt == .unasked) {
        // invariant: a run that heard nothing sets no answer aside
        assert(rung.disputing_of(report_out).unrecorded == 0);
        return;
    }
    var address_buf: [rung.max_address_len]u8 = @splat(0);
    const address = rung.address_published(io, &address_buf) orelse return error.CourierUnaddressed;
    const hand = rung.answered_by(io, address);
    if (hand == null) {
        // invariant: a reader who never wrote leaves no answer to record
        assert(rung.disputing_of(report_out).unrecorded == 0);
        return;
    }
    const letter = rung.delivered_to(io, address) orelse return error.DisputeEarly;
    const said = hand orelse return error.DisputeUnheard;
    const agreed = rung.hand_agrees(letter, said);
    const answered: u32 = 1;

    // The measurement this rung moves, weighed against what the reader actually
    // wrote rather than against what any standing asked for, so an answer set
    // aside is counted rather than refused.
    rung.disputing_of(report_out).unrecorded = rung.answered_unrecorded(answered, agreed, record);
    const recorded = rung.recorded_in(answered, agreed, record);
    const unwritten = rung.unwritten_in(answered, agreed, record);
    if (record == .settled) {
        // invariant: a settled record holds no disagreement, however plainly
        // its reader objected
        assert(recorded == 0);
        return;
    }
    if (agreed) {
        // A reader who agreed has nothing to dispute, and the record says so by
        // holding one voice rather than manufacturing a second.
        //
        // invariant: an agreeing reader is never written down as disputing
        assert(recorded == 0);
        return;
    }
    // The supply, refused by name while the box it read is still in hand: a run
    // records a disagreement only where a hand actually answered.
    if (rung.unheard_record(hand != null, recorded)) |why| return why;
    if (rung.dispute_refusal(said, agreed, unwritten, recorded)) |why| return why;
    // invariant: a run that reached the record refuses nothing it must write
    assert(recorded == 1);
    const ours = letter[1];
    // The record, and the hard half of this rung: a pair naming one reading
    // twice is agreement wearing a quarrel's clothes, and writing it down would
    // manufacture a disagreement nobody ever had.
    if (!rung.founded(.{ ours, said })) return error.DisputeUnfounded;
    try rung.dispute_note(io, ours, said);
    rung.disputing_of(report_out).recorded = recorded;
    // invariant: an open record sets no answer of its reader aside
    assert(rung.disputing_of(report_out).unrecorded == 0);
}

/// Grafts the reach a supervisor promised a dependent, one word at a time, and
/// answers how much of it the dependent actually took into its own hands.
///
/// A promise is a number on the wire and nothing more; the reach itself arrives
/// as words a dependent must read, name, hold, and then stand up against its own
/// store before any of it counts. So this body waits inside a bound rather than
/// forever, reads only what has actually been given, grants only what it does
/// not already hold, and proves each arc it took stands at the count the task
/// names. A word that cannot be read back into a capability ends the graft by
/// name rather than quietly carrying less than it claims.
///
/// **Forty-two rungs held this body byte for byte, and the queue saw all
/// forty-two.** Every body named `graft_promised_reach` was hashed before a line
/// moved, exactly as folds R and S taught, and this family came back whole --
/// one text, forty-three lines, no absentee and no tier-owner standing apart.
/// The two prior laps each found a rung the queue's line count could not see;
/// this lap found none, which is the same discipline reporting a clean family
/// rather than a discipline that stopped paying.
///
/// **The fold widened six symbols, and widened each one everywhere it stands.**
/// `word_at`, `read_count`, `read_words`, and `already_holds` are each a fold
/// family in their own right -- forty-five copies apiece, and the carry meter
/// reads a body by its exact text, so widening the forty-two here and leaving
/// three private would have split a family a later fold means to lift. Widening
/// all forty-five keeps each family whole, and the same reasoning carries the
/// two imports, `queue_store` and `serve`. A fold pays its successors, and it
/// pays them best by never handing them a split.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn graft_promised_reach(
    comptime rung: type,
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *rung.Words,
    carried_out: *u32,
) ?u8 {
    // invariant: a graft always names the dependent doing it
    assert(domain.len >= 1);
    // invariant: a promise never names more reach than one line may hold
    assert(promised <= cycle.max_hops);
    var carried: u32 = 0;
    var looks: u32 = 0;
    while (carried < promised and looks < rung.max_patience_looks) : (looks += 1) {
        const given: u32 = rung.read_count(io, domain, ".given") catch break;
        if (given <= carried) {
            std.Io.sleep(io, std.Io.Duration.fromMilliseconds(rung.note_rest_ms), .awake) catch {};
            continue;
        }
        granted.len = 0;
        rung.read_words(io, domain, granted) catch return carry.Outcome.malformed;
        while (carried < given and carried < promised) : (carried += 1) {
            const word = rung.word_at(granted, carried) orelse return carry.Outcome.malformed;
            const cap = boot.read_cap_word(word) orelse return carry.Outcome.malformed;
            const name = cap.name_slice();
            if (!rung.already_holds(slot, name)) {
                slot.grant(cap) catch return carry.Outcome.malformed;
            }
            const stood = rung.queue_store.read_index(io, slot, name) catch |err|
                return rung.serve.reach_code(err);
            if (stood != task.count) return carry.Outcome.bytes_differed;
        }
        rung.holds(io, domain, carried) catch return carry.Outcome.malformed;
    }
    // invariant: the waiting stayed inside the bound it was given
    assert(looks <= rung.max_patience_looks);
    // invariant: a dependent never grafts more reach than it was promised
    assert(carried <= promised);
    carried_out.* = carried;
    return null;
}

/// Reads back what the reader answered, and says whether the plan ever
/// listened -- one body for every rung that asks it.
///
/// The wire before the memory: the run reads the letter it carried out of the
/// reader's own box, then reads that reader's hand out of the box beside it.
/// Neither reach touches what the supervisor remembers doing, because a plan
/// that heard its reader agree from its own memory has agreed with itself. A
/// run that carried nothing owes nobody a hearing. A reader who answered in a
/// word this plan cannot accept leaves the hearing exactly where it stood --
/// nothing heard, the correction still owed an answer -- and that is a record
/// rather than a refusal.
///
/// **Fold U -- thirty-three rungs, and the absentee that stays home.** Every
/// body named `hear_the_reader` was hashed before a line moved, as folds R, S
/// and T taught. Thirty-three came back one text at fifty-four lines, and a
/// thirty-fourth stood apart: `hear.rye`, which owns the hearing tier. That one
/// is the **first** kind of absentee fold R named -- a body genuinely dated by a
/// shape born after it, rather than one an accessor brings home. It ends its run
/// on a disagreeing hand where every rung above records that disagreement and
/// carries on, so it stays home named rather than folded into a shape it
/// predates.
///
/// **The fold widened one symbol, and it split nothing.** `hearing_of` is a
/// three-line accessor whose thirty-three copies are each a different nesting
/// depth, so it is no fold family at all and widening it costs its thirty-three
/// and no more. Every other symbol this body reaches already stood public.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn hear_the_reader(
    comptime rung: type,
    io: std.Io,
    receipt: rung.Receipt,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const carried = rung.couriering_of(report_out).delivered;
    if (carried == 0) {
        // invariant: a run that carried nothing leaves no answer unheard
        assert(rung.hearing_of(report_out).unheard == 0);
        return;
    }
    var address_buf: [rung.max_address_len]u8 = @splat(0);
    const address = rung.address_published(io, &address_buf) orelse return error.CourierUnaddressed;
    const hand = rung.answered_by(io, address);
    const letter = rung.delivered_to(io, address) orelse return error.HearEarly;
    // The stricter question this rung asks of the same hearing: a hand agrees
    // when it names the reading the letter carried, and a hand that names any
    // other reading has answered without agreeing. Below this rung the second
    // case ended the run; here it is simply not an agreement, and the record
    // that follows is where it goes.
    const agreed = if (hand) |said| rung.hand_agrees(letter, said) else false;

    // The rung below's measurement, weighed against what the reader actually
    // agreed to rather than against what any receipt asked for, so an answer
    // nobody read is counted rather than refused.
    rung.hearing_of(report_out).unheard = rung.carried_unheard(carried, agreed, receipt);
    const heard = rung.heard_in(carried, agreed, receipt);
    const left = rung.unheard_in(carried, agreed, receipt);
    if (receipt == .unasked) {
        // invariant: an unasking run hears nothing, however plainly its reader
        // wrote back
        assert(heard == 0);
        return;
    }
    if (!agreed) {
        // A reader who answered in a word this plan cannot accept leaves the
        // hearing exactly where it stood: nothing heard, and the correction
        // still owed an answer. What that reader said is this rung's business,
        // and the step below reaches for it next.
        //
        // invariant: a run hearing no agreement claims none
        assert(heard == 0);
        // The rung below's own refusal, kept live rather than retired: a run
        // that counted a disagreeing hand as agreement would report a consent
        // nobody gave, and it refuses by the name it has always refused by.
        if (heard >= 1) return error.HearMisheard;
        return;
    }
    // The supply, refused by name while the box it must read is still in hand:
    // a run hears an answer only where an agreeing hand actually stands in it.
    if (rung.unanswered_reach(agreed, heard)) |why| return why;
    if (rung.hear_refusal(letter, agreed, left, heard)) |why| return why;
    // invariant: a run that reached the hearing refuses nothing it must hear
    assert(heard == 1);
    rung.hearing_of(report_out).heard = heard;
    // invariant: a hearing run leaves no reader's answer unread
    assert(rung.hearing_of(report_out).unheard == 0);
}

/// Weighs what a plan came to, publishes the verdict and the settlement, and
/// reads both back -- one body for every rung that asks it.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. Every claim it makes it first writes to
/// the wire and then reads back, because a settlement a run believes from its
/// own memory has agreed with itself. Four refusals stand in it, each naming a
/// story the wire cannot support: a loss called carried while an arc stands
/// unserved, a plan called borne that re-ran what its author asked it to bear,
/// a judgment weighed in private, and a recantation never spoken aloud.
///
/// **Fold V -- thirty-seven rungs, and two absentees that are the ladder's own
/// fossil record.** Every body named `settle_the_plan` was hashed before a line
/// moved, as folds R through U taught. Thirty-six came back one text at
/// forty-seven lines; `recant.rye`, which owns the recanting tier, stood apart
/// by two lines reaching its own report directly -- fold R's **second** kind of
/// absentee, and the accessor that brings it home, `recanting_of`, had already
/// been born at fold M. It came home for two words and the family became
/// thirty-seven.
///
/// Two more stand apart, and they stay home: `bear.rye` at twenty-eight lines
/// and `appraise.rye` at thirty-five. Both are fold R's **first** kind -- bodies
/// genuinely dated by shapes born after them. `bear.rye` predates the appraisal
/// check and the recantation checks alike; `appraise.rye` carries the appraisal
/// and predates the recantation. Read together with the folded body's
/// forty-seven, the three depths are a staircase naming the two laps on which
/// settling learned to weigh an appraisal and then a recantation. **An absentee
/// can wear both kinds at once, and the first kind wins:** each of these two
/// also reaches its own report directly, exactly as `recant.rye` did, yet no
/// accessor can give a body back a check it never had.
///
/// **The fold cost nothing.** All thirteen symbols it reaches and all three
/// types already stood public across every one of the thirty-seven, interest
/// paid in full by the folds before it. This is the arc's second zero-widening
/// fold after fold P, and it says the same thing from the other side: a fold's
/// price is set by what its predecessors already made public.
///
/// Measured by `../tools/fixtures/caravan_ladder_carry_scan.sh`.
pub fn settle_the_plan(
    comptime rung: type,
    io: std.Io,
    lost: u32,
    served_again: u32,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    // invariant: a settling always weighs a plan that actually lost an arc
    assert(lost >= 1);
    // invariant: a repair never carries more arcs than the plan lost
    assert(served_again <= lost);
    rung.below_of(report_out).unserved = rung.unserved_after(lost, served_again);
    const settled = rung.settled_verdict(rung.below_of(report_out).unserved);
    try rung.verdict_note(io, settled);
    const said = rung.verdict_published(io) orelse return error.MendUnserved;
    if (said != settled) return error.MendUnserved;
    if (said == .carried and rung.below_of(report_out).unserved >= 1) return error.MendUnserved;
    rung.below_of(report_out).settled = said;

    const settlement = rung.settlement_of(rung.below_of(report_out).unserved, rung.bearing_of(report_out).bore);
    try rung.settlement_note(io, settlement);
    const read_back = rung.settlement_published(io) orelse return error.BearOverrepaired;
    if (read_back != settlement) return error.BearOverrepaired;
    // The answer, and the hard half of this rung: a run that re-ran an arc its
    // author asked it to bear has disobeyed the plan it serves, and a run that
    // called such a plan borne would report an obedience it never practiced.
    if (read_back == .borne and rung.bearing_of(report_out).overrepaired >= 1) return error.BearOverrepaired;
    // The answer of this rung, weighed the same way one tier out: a run that
    // carried a loss no note of its own names has judged in private, and a run
    // that called such a plan borne would report a judgment it never made in
    // the open.
    if (rung.appraising_of(report_out).weighed >= 1 and rung.appraisal_published(io, rung.max_queue_len) == 0) {
        return error.AppraiseUnweighed;
    }
    // The answer of this rung, weighed the same way one tier out: a run that
    // took a judgment back and published no recantation reversed it in private,
    // and a settlement read on that silence would tell an operator a story the
    // wire cannot support.
    if (rung.recanting_of(report_out).recanted >= 1 and rung.recant_published(io, rung.max_queue_len) == 0) {
        return error.RecantUnspoken;
    }
    // A plan whose judgment this run disproved and left standing all the same
    // reads `borne`, which says there is nothing left to do while an arc of the
    // plan stands unserved. Under `.revisit` that never happens, and this names
    // it rather than trusting that it cannot.
    if (read_back == .carried and rung.recanting_of(report_out).spared_disproved >= 1) return error.RecantUnspoken;
    rung.bearing_of(report_out).settlement = read_back;
}

/// Provisions one set of notes per declared domain, all standing at nothing --
/// the largest single carry this arc has folded, and the first that reaches a
/// rung's own wire from end to end.
///
/// Every note here is seated through the rung handed in, so a body that opens
/// the note directory and writes under the plan name provisions whichever rung
/// called it rather than the one that happens to hold the text. That is the
/// whole of option B: the wire stays the rung's, the words become the ladder's.
///
/// **What clears, and what stays, is the reading this body carries.** A run
/// clears every note that answers for the run that wrote it, and leaves
/// standing every note that belongs to somebody else -- the appraisal a run did
/// not make, the reading a reader already holds, the position a person pressed,
/// and the age that position has stood. Twenty-four rungs wrote that judgment
/// identically; twenty-three elders wrote it at thirteen shallower depths, each
/// one a lap on which the ladder had not yet learned the next note, and every
/// one of those stays home as the shape it predates.
pub fn provision_notes(
    comptime rung: type,
    io: std.Io,
    sys: *const system.System,
) rung.NoteError!u32 {
    // invariant: the domain roster stays within its bound
    assert(sys.graph.domain_count >= 1);
    // invariant: a run always provisions into a declaration that read whole
    assert(sys.map.region_count >= 1);
    Dir.cwd().createDirPath(io, rung.note_dir) catch return error.NoteUnavailable;
    var i: u32 = 0;
    while (i < sys.graph.domain_count) : (i += 1) {
        const name = sys.graph.domains[i].name_slice();
        try rung.seat_note(io, name, ".given", &[_]u8{0});
        try rung.seat_note(io, name, ".held", &[_]u8{0});
        try rung.seat_note(io, name, ".offered", &[_]u8{0});
        try rung.seat_note(io, name, ".words", "");
        try rung.seat_note(io, name, ".pruning", &[_]u8{0});
        try rung.seat_note(io, name, ".kept", &[_]u8{0});
        try rung.seat_note(io, name, ".pruned", &[_]u8{0});
        try rung.seat_note(io, name, ".inherited", &[_]u8{0});
        try rung.seat_note(io, name, ".epoch", &[_]u8{0});
        try rung.seat_note(io, name, ".for", &[_]u8{0});
        try rung.seat_note(io, name, ".falls", &[_]u8{0});
        try rung.seat_note(io, name, ".abandoned", &[_]u8{0});
    }
    // The plan's own verdict is cleared with them, so no run ever reads the
    // last run's judgment of a plan this one has not finished. Its bearing and
    // its settlement clear beside it, for exactly the same reason: a repair
    // that read the last run's bearing would spare an arc this plan never
    // asked it to spare.
    try rung.seat_note(io, rung.plan_name, ".verdict", &[_]u8{0});
    try rung.seat_note(io, rung.plan_name, ".bearing", "");
    try rung.seat_note(io, rung.plan_name, ".settled", &[_]u8{0});
    // The recantation clears with them, since a reversal belongs to the run
    // that made it and answers for that run's own evidence alone.
    //
    // **The appraisal stays.** It is the one note a run leaves exactly where it
    // found it, because a judgment that vanished with its run was never a
    // record -- and because what a run does with a judgment it did not make is
    // the whole subject of this rung.
    try rung.seat_note(io, rung.plan_name, ".recant", "");
    // The amendment clears with them, since a correction belongs to the run that
    // posted it and answers for that run's own settlement alone.
    //
    // **The reading stays**, beside the appraisal, and for a plainer reason than
    // the appraisal's: a reader's copy survives the run whatever the wire does,
    // so a wire that forgot what it last told somebody could never notice it had
    // changed its mind.
    try rung.seat_note(io, rung.plan_name, ".amend", "");
    // The recorded disagreement clears with them, since a dispute belongs to
    // the run that read it and answers for the answer that run itself heard.
    // A record that kept the last run's quarrel would be holding a reader to a
    // word they wrote about a plan that has since been run again.
    try rung.seat_note(io, rung.plan_name, ".dispute", "");
    // The published plea clears with them, and for the same reason one tier
    // out: a position belongs to the run that read it, and a record holding the
    // last run's plea would be holding a living person to what they said about
    // a plan that has since been run again.
    try rung.seat_note(io, rung.plan_name, ".appeal", &[_]u8{0});
    // **The standing position stays**, and it is the first note of this whole
    // arc that a provisioning leaves alone. Every other note here answers for
    // the run that wrote it, and clearing them is what keeps one run from
    // wearing another's findings. A pressed quarrel is not a finding: it is a
    // living person's statement that the matter is not over, and it stands until
    // that person says otherwise. Clearing it would open every run on a reader
    // whose position the plan has already forgotten.
    //
    // The regard clears with the findings, and never with the position. What a
    // run says about a quarrel is that run's own word about its own outcome; the
    // quarrel itself belongs to the person holding it. A wire that kept the last
    // run's regard would publish a qualification over a settlement this run has
    // not reached yet.
    try rung.seat_note(io, rung.plan_name, ".regard", &[_]u8{0});
    // **The age stays**, beside the position it counts and for the same reason.
    // A quarrel's age is a fact about that quarrel rather than a finding of any
    // run that met it, so a provisioning that reset it to nothing would make
    // every position on the wire look raised this morning.
    //
    // invariant: a fresh provisioning leaves no regard standing to be read
    assert(rung.regard_published(io) == null);
    // invariant: a fresh provisioning leaves no plea standing to be read
    assert(rung.appeal_published(io) == null);
    // invariant: a fresh provisioning leaves no amendment standing to be read
    assert(rung.amend_published(io) == null);
    // invariant: a fresh provisioning leaves no disagreement standing to be read
    assert(rung.dispute_recorded(io) == null);
    // invariant: a fresh provisioning leaves no verdict standing to be read
    assert(rung.verdict_published(io) == null);
    // invariant: a fresh provisioning leaves no settlement standing to be read
    assert(rung.settlement_published(io) == null);
    // invariant: every declared domain got its notes, none invented
    assert(i == sys.graph.domain_count);
    return i;
}


/// Releases the one standing position a run inherited, where and only where the
/// person holding it actually let it go.
///
/// A quarrel is a living person's statement that the matter is not over, so this
/// body reads the wire before it believes anything: the note that stands, the
/// endurance that would have written it, the box its holder published, and the
/// hand that box actually carries. A holding run clears nothing however plainly
/// its holder moved on, silence is never read as a withdrawal, and a position
/// whose holder cannot be reached stands rightly until they can be.
///
/// **The wire before the memory, at both ends.** The note is read back after the
/// release, and only a wire that reads clear lets the report say the position
/// came down -- because a note still naming a quarrel after its holder let it go
/// hands every future run an objection nobody holds.
///
/// Every reach here is seated through the rung handed in, so one text releases
/// whichever rung called it. `relent.rye` owns the relenting tier and reached
/// its own report directly; three lines of identity accessor brought its
/// seventy-one home with the rest, so the family folded whole at twenty-five.
pub fn release_the_standing(
    comptime rung: type,
    io: std.Io,
    relent: rung.Relent,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const stood_plea = rung.position_standing(io) orelse {
        // invariant: a run with nothing standing lets no position go
        assert(rung.relent_of(report_out).withdrawn == 0);
        // invariant: a run with nothing standing leaves none uncleared
        assert(rung.relent_of(report_out).uncleared == 0);
        return;
    };
    const stood: u32 = 1;
    if (!rung.endures(stood_plea)) {
        // A byte no endurance of this arc would ever have written is no
        // position to take down, and the wire says so by leaving it exactly as
        // it reads.
        //
        // invariant: a quarrel nobody pressed is never withdrawn on their behalf
        assert(rung.relent_of(report_out).withdrawn == 0);
        rung.relent_of(report_out).standing = stood;
        return;
    }
    var address_buf: [rung.max_address_len]u8 = undefined;
    const address = rung.address_published(io, &address_buf) orelse {
        // A wire naming nobody's box has no hand to read, and a position whose
        // holder cannot be reached stands rightly until they can be.
        //
        // invariant: a run that can reach nobody withdraws nothing
        assert(rung.relent_of(report_out).withdrawn == 0);
        rung.relent_of(report_out).standing = stood;
        return;
    };
    const hand = rung.pressed_by(io, address);

    // The measurement this rung moves, weighed against the hand the reader's own
    // box actually carries rather than against what any plan asked for, so a
    // quarrel left standing past its own withdrawal is counted rather than
    // refused.
    rung.relent_of(report_out).uncleared = rung.withdrawn_still_standing(stood, hand, relent);
    const cleared_count = rung.withdrawn_in(stood, hand, relent);
    const left_count = rung.standing_in(stood, hand, relent);
    if (relent == .held) {
        // invariant: a holding run clears nothing, however plainly its holder moved on
        assert(cleared_count == 0);
        rung.relent_of(report_out).standing = left_count;
        return;
    }
    if (!rung.withdraws(hand)) {
        // A reader still pressing, or one who has written nothing at all, has
        // withdrawn nothing -- and the wire says so by leaving the note standing.
        //
        // invariant: silence is never read as a withdrawal
        assert(cleared_count == 0);
        rung.relent_of(report_out).standing = left_count;
        return;
    }
    // The supply, refused by name while the hand it read is still in view: a run
    // takes a position down only where its holder actually let it go.
    if (rung.unwithdrawn_clearing(if (rung.withdraws(hand)) 1 else 0, cleared_count)) |why| return why;
    if (rung.relent_refusal(stood, cleared_count, left_count)) |why| return why;
    // invariant: a releasing run lets go of the one position it inherited
    assert(cleared_count == 1);
    rung.release_standing(io);
    // The wire before the memory, once more: the note every run after this one
    // opens is read back, and only then does the report believe it came down.
    const after = rung.position_standing(io);
    // The record half of this rung: a note still reading a quarrel after its
    // holder let it go hands every future run an objection nobody holds.
    if (!rung.note_cleared(after)) return error.RelentMisrecorded;
    rung.relent_of(report_out).withdrawn = cleared_count;
    rung.relent_of(report_out).standing = left_count;
    // invariant: a releasing run leaves no withdrawn quarrel standing
    assert(rung.relent_of(report_out).uncleared == 0);
}


/// Carries the term's own answer into the mark an operator actually opens.
///
/// The wire before the memory, one tier further out than the term below it: this
/// run reads its own mark out of the note an operator would open, reads the term
/// out of the note that decided it, writes both into that same mark, and reads
/// the mark back before the report believes a word of it. A plan that reported a
/// standing from memory of having weighed one would be telling every future
/// reader something its own wire never carried.
///
/// A run that escorted nothing has no mark to speak for, and an objection nobody
/// asked about has no standing to carry; both are silences no standing can fill,
/// and each says so by weighing nothing rather than by inventing a finding. A
/// mark that names an objection and never says whether anybody still holds it --
/// read live by every operator, however long ago the quarrel was let go -- is the
/// number this rung moves.
///
/// Every reach here is seated through the rung handed in, so one text stands the
/// mark for whichever rung called it. `repose.rye` owns the reposing tier and
/// reached its own report directly; three lines of identity accessor brought its
/// fifty-eight home with the rest, so the family folded whole at thirty.
pub fn stand_the_mark(
    comptime rung: type,
    io: std.Io,
    mark: rung.Mark,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const marked = rung.escort_written(io);
    const escorted: u32 = if (marked == null) 0 else 1;
    if (escorted == 0) {
        // invariant: a run that escorted nothing leaves no mark unstanding
        assert(rung.reposing_of(report_out).unstanding == 0);
        return;
    }
    const life = rung.term_written(io);
    const weighed = life != null;

    // The measurement this rung moves, weighed against what the wire actually
    // carries rather than against what any mark asked for, so a mark left
    // reading live is counted rather than refused.
    rung.reposing_of(report_out).unstanding = rung.mark_unstanding(escorted, weighed, mark);
    const stood_count = rung.read_in(escorted, weighed, mark);
    const bare_count = rung.bare_in(escorted, weighed, mark);
    if (mark == .bare) {
        // invariant: a bare mark carries no standing, however plainly its term
        // weighed the objection
        assert(stood_count == 0);
        rung.reposing_of(report_out).bare = bare_count;
        return;
    }
    if (!weighed) {
        // An objection nobody asked about has no standing to report, and the
        // wire says so by leaving the mark exactly as it reads.
        //
        // invariant: an unweighed objection is never spoken for
        assert(stood_count == 0);
        rung.reposing_of(report_out).bare = bare_count;
        return;
    }
    // The supply, refused by name while the term it read is still in hand: a run
    // speaks for a mark only where somebody actually weighed the objection.
    if (rung.unweighed_stand(if (weighed) 1 else 0, stood_count)) |why| return why;
    if (rung.repose_refusal(escorted, stood_count, bare_count)) |why| return why;
    // invariant: a run that reached the standing refuses nothing it must write
    assert(stood_count == 1);
    const answer = life orelse return error.ReposeUnweighed;
    const quoted = marked orelse return error.ReposeEarly;
    const stand = rung.stands_as(answer);
    // The hard half of this rung: a standing carries one finding to the place a
    // person reads, so it must be that finding.
    if (!rung.agrees(stand, answer)) return error.ReposeMisread;
    try rung.repose_note(io, quoted, stand);
    // The wire before the memory, once more: the mark is read back out of the
    // note an operator would open, and only then does the report believe it.
    const published = rung.standing_written(io) orelse return error.ReposeMisread;
    if (!rung.agrees(published, answer)) return error.ReposeMisread;
    // The mark its reader earned, still exactly as they earned it. A repose
    // reports on an objection rather than withdrawing it.
    if (rung.escort_written(io) != quoted) return error.ReposeMisread;
    rung.reposing_of(report_out).stood = stood_count;
    rung.reposing_of(report_out).bare = bare_count;
    // invariant: a standing run leaves no escorted mark unstanding
    assert(rung.reposing_of(report_out).unstanding == 0);
}

/// Takes back the reach one standing dependent no longer needs, and records what
/// came home.
///
/// The smallest of the reap cluster, and the one the other two are built over: a
/// reclamation names a row the table still holds, refuses by name where the
/// conferral was never made or the reach never given, writes the notes that let
/// the wire say so, and adds what it took back to the plan's own account.
///
/// Every reach here is seated through the rung handed in, so one text reclaims
/// for whichever rung called it.
pub fn reclaim_one(
    comptime rung: type,
    io: std.Io,
    table: *rung.Table,
    slot: u32,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    // invariant: a reclamation always names a row the table still holds
    assert(slot < rung.max_in_flight);
    // invariant: a reclamation never takes back more than one line may name
    assert(table.granted[slot] <= cycle.max_hops);
    const domain = table.live[slot].domain;
    const already = (rung.read_count(io, domain, ".given") catch 0) == 0;
    if (rung.reclaim_refusal(table.granted[slot], false, already)) |why| return why;
    try rung.reclaim_notes(io, domain);
    rung.abandoning_of(report_out).inner.reclaimed += table.granted[slot];
}

/// Answers for the work a conferral bought and the dependent never served.
///
/// The middle of the reap cluster: an abandonment names lost work only where
/// there is lost work to name, writes it where an operator would read it, reads
/// it straight back off the wire before believing it, and gathers the phases
/// this dependent took up and never served into the plan's own loss.
///
/// Every reach here is seated through the rung handed in, so one text answers
/// for whichever rung called it.
pub fn abandon_one(
    comptime rung: type,
    io: std.Io,
    table: *rung.Table,
    slot: u32,
    came_home: bool,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    // invariant: an abandonment always names a row the table still holds
    assert(slot < rung.max_in_flight);
    // invariant: an abandonment never records more than one line may name
    assert(table.granted[slot] <= cycle.max_hops);
    const domain = table.live[slot].domain;
    if (rung.abandon_refusal(table.granted[slot], false, came_home)) |why| return why;
    const left = rung.abandoned_reach(table.granted[slot], came_home, .answered);
    // invariant: an abandonment that reaches this point always names lost work
    assert(left >= 1);
    try rung.abandon_note(io, domain, left);
    if (rung.abandoned_by(io, domain) != left) return error.AbandonUncounted;
    rung.abandoning_of(report_out).abandoned += left;
    // The phases this dependent took up and never served, gathered into the
    // plan's own loss while the slot that held them is still standing. After
    // the table closes over this row the mask moves with the shuffle, and once
    // the reaping is done it is gone -- so the plan learns where it fell short
    // at the one moment the answer is still in reach.
    table.lost_mask |= table.absorbed_mask[slot];
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
///
/// The largest of the reap cluster, and the reason the two above stand here: a
/// reaping reaches both of them, so lifting it lifted them. An heir found at
/// home refuses the whole reaping rather than reporting around it, since a
/// dependent whose children outlive it was never reaped at all.
///
/// Every reach here is seated through the rung handed in, so one text reaps for
/// whichever rung called it -- that rung's own table, its own helpers, its own
/// report.
pub fn reap_oldest(
    comptime rung: type,
    io: std.Io,
    table: *rung.Table,
    answer: rung.Answer,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError || cohort.RunError)!void {
    // invariant: a reaping always has a dependent to wait on
    assert(table.in_flight >= 1);
    // invariant: a reaping never overruns the record it is kept in
    assert(table.finished < rung.max_queue_len);
    const code = try cohort.reap_one(io, &table.live[0]);
    const found = rung.inherited_by(io, table.live[0].domain);
    rung.abandoning_of(report_out).inner.inherited_at_home += found;
    if (found != 0) return error.ReclaimInherited;
    const came_home = code == carry.Outcome.carried_ok;
    if (table.granted[0] >= 1) try rung.reclaim_one(io, table, 0, report_out);
    if (answer == .answered and table.granted[0] >= 1 and !came_home) {
        try rung.abandon_one(io, table, 0, came_home, report_out);
    }
    table.done[table.finished] = .{
        .domain = table.live[0].domain,
        .verb = table.live[0].verb,
        .count = table.live[0].count,
        .expect = table.live[0].expect,
        .code = code,
    };
    table.finished += 1;
    table.in_flight -= 1;
    rung.run_of(report_out).reaped += 1;
    rung.run_of(report_out).turns += 1;

    var s: u32 = 0;
    while (s < table.in_flight) : (s += 1) {
        table.live[s] = table.live[s + 1];
        table.lines[s] = table.lines[s + 1];
        table.reserves[s] = table.reserves[s + 1];
        table.taken[s] = table.taken[s + 1];
        table.served[s] = table.served[s + 1];
        table.granted[s] = table.granted[s + 1];
        table.absorbed_mask[s] = table.absorbed_mask[s + 1];
    }
    // invariant: the table closed over the reaped dependent, none lost
    assert(s == table.in_flight);
}

/// Publishes the amendment a settled run owes whoever is still holding the
/// reading it replaced, and reports what was corrected.
///
/// The arc's correspondence half, stated once. A run measures the readings its
/// own settlement contradicts, refuses by name where an amendment would reach a
/// reading nobody took, writes the note, clears the reading off the wire in the
/// same breath it is answered, and believes its own report only after reading
/// the posting back out of the place an operator would open.
///
/// Every reach here is seated through the rung handed in, so one text amends for
/// whichever rung called it -- that rung's own wire, its own refusals, its own
/// report.
pub fn post_the_amendment(
    comptime rung: type,
    io: std.Io,
    notice: rung.Notice,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const published = rung.settlement_published(io);
    const reading = rung.reading_published(io);
    const on_the_wire: u32 = if (reading == null) 0 else 1;
    if (on_the_wire == 0) {
        // invariant: a plan nobody read leaves no reader holding a stale word
        assert(rung.amending_of(report_out).superseded_unposted == 0);
        return;
    }
    const settled = published orelse return error.AmendEarly;
    // The measurement this rung moves, weighed against what the run *settled*
    // rather than against what any notice asked for, so the elder reading is
    // counted rather than refused: a word an operator holds that this run's own
    // settlement contradicts, left standing because nobody wrote to them.
    rung.amending_of(report_out).superseded_unposted = rung.superseded_unposted(reading, settled, notice);
    const amended = rung.amended_in(reading, settled, notice);
    const confirmed = rung.confirmed_in(reading, settled, notice);
    if (notice == .silent) {
        // invariant: a silent run corrects nobody, whatever it settled
        assert(amended == 0);
        return;
    }
    // The supply, refused by name while the reading it must answer to is still
    // in hand: an amendment may reach only a reading somebody actually took.
    if (rung.unread_reach(reading, amended)) |why| return why;
    if (rung.amend_refusal(published, on_the_wire, confirmed, amended)) |why| return why;
    if (amended == 0) {
        // invariant: a reading left uncorrected is one this run still stands behind
        assert(confirmed == 1);
        return;
    }
    const was = reading orelse return error.AmendUnread;
    try rung.amend_note(io, was, settled);
    // The reading leaves the wire in the same breath it is answered, since a
    // reading that has had its reply is no longer waiting for one.
    try rung.seat_note(io, rung.plan_name, ".read", &[_]u8{0});
    // The answer the rung below earns: a run that superseded a reading and
    // published no amendment corrected in private, and a report read on that
    // silence would say a reader was written to when nobody wrote to them.
    const posted = rung.amend_published(io) orelse return error.AmendUnspoken;
    if (posted[0] != was or posted[1] != settled) return error.AmendUnspoken;
    rung.amending_of(report_out).amended = amended;
    // invariant: a posted run leaves no reader holding a word it has replaced
    assert(rung.amending_of(report_out).superseded_unposted == 0);
}

/// Reads the capability words a dependent was handed at its spawn into its slot.
///
/// Every reach is seated through the rung handed in, so one text reads the argv
/// line for whichever rung called it -- that rung's own fixed word count.
pub fn slot_from_argv(
    comptime rung: type,
    args: []const [:0]const u8,
    domain: []const u8,
    cap_count: u32,
) ?capabilities.DependentSlot {
    // invariant: a dependent always knows which domain it is
    assert(domain.len >= 1);
    // invariant: the count stays within what one dependent may hold
    assert(cap_count <= capabilities.max_caps_per_dependent);
    var slot = capabilities.DependentSlot.init(domain);
    var i: u32 = 0;
    while (i < cap_count) : (i += 1) {
        const cap = boot.read_cap_word(args[rung.fixed_argv_words + i]) orelse return null;
        slot.grant(cap) catch return null;
    }
    // invariant: the dependent holds exactly the capability words it was handed
    assert(slot.cap_count == cap_count);
    return slot;
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of the party that would be lying if it were wrong -- and made
/// without touching the hands the dependent actually works with. The words
/// standing for this domain are grafted into a *copy* of those hands, and each
/// arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
///
/// Every reach here is seated through the rung handed in, so one text counts
/// for whichever rung called it -- that rung's own notes, its own words, its
/// own reachability.
pub fn inherited_at_first_breath(
    comptime rung: type,
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    // invariant: a first breath always names the dependent drawing it
    assert(domain.len >= 1);
    // invariant: a first breath reads hands that hold their own line
    assert(base.cap_count <= capabilities.max_caps_per_dependent);
    const found: u32 = rung.read_count(io, domain, ".given") catch return 0;
    if (found == 0) return 0;
    const mine: u32 = rung.read_count(io, domain, ".epoch") catch return 0;
    const meant_for: u32 = rung.read_count(io, domain, ".for") catch return 0;
    // invariant: a conferral is never addressed past the generation standing now
    assert(meant_for <= mine);
    if (meant_for == mine) return 0;
    // invariant: a conferral never stands wider than one line may name
    assert(found <= cycle.max_hops);
    var words: rung.Words = .{};
    rung.read_words(io, domain, &words) catch return 0;
    var probe = base.*;
    var i: u32 = 0;
    while (i < found) : (i += 1) {
        const word = rung.word_at(&words, i) orelse break;
        const cap = boot.read_cap_word(word) orelse break;
        if (rung.already_holds(&probe, cap.name_slice())) continue;
        probe.grant(cap) catch break;
    }
    return rung.reachable_between(io, &probe, &words, 0, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
///
/// The whole dependent half of the arc, stated once. A dependent reads the plan
/// it was handed, defers to the rung below for any verb this rung does not own,
/// refuses an unreadable or over-wide capability count by name, rebuilds its own
/// hands from the words on its argv line, counts the reach it inherited at its
/// first breath before touching those hands, answers for that finding on the
/// wire, and only then stands -- taking and returning the reach the run asks.
///
/// Every reach here is seated through the rung handed in, so one text runs as
/// whichever rung handed itself in -- that rung's own argv shape, its own
/// helpers, its own name for the outcome it came home with.
pub fn run_dependent(comptime rung: type, io: std.Io, args: []const [:0]const u8) u8 {
    // invariant: a dependent always receives its marker, domain, plan, and count
    assert(args.len >= rung.fixed_argv_words);
    // invariant: a dependent always knows which domain it is
    assert(args[2].len >= 1);
    const domain = args[2];
    const task = cycle.read_plan(args[3]) orelse return cohort.run_dependent(io, args);
    if (task.verb != .stand) return cohort.run_dependent(io, args);

    const cap_count = tally_parse_int.parse_int(u32, args[6], .{}) catch {
        print("    {s}: refused an unreadable capability count\n", .{domain});
        return carry.Outcome.malformed;
    };
    if (cap_count > capabilities.max_caps_per_dependent) {
        print("    {s}: more capabilities than one dependent holds\n", .{domain});
        return carry.Outcome.malformed;
    }
    if (rung.fixed_argv_words + cap_count > args.len) {
        print("    {s}: a capability count past the words it was handed\n", .{domain});
        return carry.Outcome.malformed;
    }
    var slot = rung.slot_from_argv(args, domain, cap_count) orelse {
        print("    {s}: refused a malformed capability word\n", .{domain});
        return carry.Outcome.malformed;
    };
    const base = slot;
    const found = rung.inherited_at_first_breath(io, &base, domain);
    rung.inherited(io, domain, found) catch {
        print("    {s}: could not answer for what it found on the wire\n", .{domain});
        return carry.Outcome.malformed;
    };
    const code = rung.stand_taking_and_returning_reach(io, &base, &slot, domain, task, found);
    print("    {s}: {s}\n", .{ domain, rung.outcome_name(code) });
    return code;
}

/// Reads the wire for the address a reader published, bounded by the rung's own
/// address ceiling.
///
/// One text for the whole correspondence tier: the note is opened through the
/// rung's own path builder and its own plan name, so a rung keeps its notes
/// wherever it keeps them and still reads them with this body.
pub fn address_published(comptime rung: type, io: std.Io, out: *[rung.max_address_len]u8) ?[]const u8 {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".at") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    const got = file.readPositionalAll(io, out, 0) catch return null;
    // invariant: an address never outgrows the bound its wire carries
    assert(got <= rung.max_address_len);
    var len: u32 = 0;
    while (len < got and out[len] != 0 and out[len] != '\n') : (len += 1) {}
    const address = out[0..len];
    return if (rung.addressable(address)) address else null;
}

/// Reads back the one result a reader at this address was told, or nothing when
/// nobody was told at all.
pub fn told_of(comptime rung: type, io: std.Io, address: []const u8) ?rung.Result {
    if (!rung.addressable(address)) return null;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.tell_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an answer never outgrows the one result it names
    assert(got <= 1);
    if (got < 1) return null;
    return rung.result_of_byte(bytes[0]);
}

/// Reads back the one plea a reader at this address pressed, or nothing when
/// they wrote nothing.
pub fn pressed_by(comptime rung: type, io: std.Io, address: []const u8) ?rung.Plea {
    if (!rung.addressable(address)) return null;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.press_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a reply never outgrows the one plea it names
    assert(got <= 1);
    if (got < 1) return null;
    return rung.plea_of_byte(bytes[0]);
}

/// Reads back the position this run published, out of the place an operator
/// would open to find it.
pub fn appeal_published(comptime rung: type, io: std.Io) ?rung.Plea {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".appeal") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a plea never outgrows the one position it names
    assert(got <= 1);
    if (got < 1) return null;
    return rung.plea_of_byte(bytes[0]);
}

/// Reads where a living person stands and publishes it, then believes the report
/// only after reading the posting back off the wire.
///
/// The arc's appeal half, stated once. A run finds the reader's address, counts
/// what an unread answer costs, refuses by name where a position would be
/// published that nobody voiced, writes the note, and reads it back out of the
/// place an operator would open before the report believes a word of it.
///
/// Every reach here is seated through the rung handed in, so one text reads the
/// appeal for whichever rung called it -- that rung's own wire, its own
/// refusals, its own report.
pub fn read_the_appeal(
    comptime rung: type,
    io: std.Io,
    appeal: rung.Appeal,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    var address_buf: [rung.max_address_len]u8 = undefined;
    const address = rung.address_published(io, &address_buf) orelse {
        // invariant: a run with nobody to read leaves no reader unread
        assert(rung.appeal_of(report_out).unread == 0);
        return;
    };
    const told: u32 = if (rung.told_of(io, address) == null) 0 else 1;
    if (told == 0) {
        // invariant: a run that told nobody leaves no reader unread
        assert(rung.appeal_of(report_out).unread == 0);
        return;
    }
    const wrote = rung.pressed_by(io, address);
    const replied = wrote != null;

    // The measurement this rung moves, weighed against what the reader's own box
    // actually carries rather than against what any plan asked for, so an answer
    // left sitting unread is counted rather than refused.
    rung.appeal_of(report_out).unread = rung.answer_unread(told, replied, appeal);
    const heard_count = rung.appeal_heard_in(told, replied, appeal);
    const unheard_count = rung.appeal_unheard_in(told, replied, appeal);
    if (appeal == .closed) {
        // invariant: a closed run reads nobody, however plainly they wrote
        assert(heard_count == 0);
        rung.appeal_of(report_out).unheard_back = unheard_count;
        return;
    }
    if (!replied) {
        // A reader who said nothing has nothing to publish, and the wire says so
        // by leaving the record exactly as it reads.
        //
        // invariant: an unanswered telling is never published as a position
        assert(heard_count == 0);
        rung.appeal_of(report_out).unheard_back = unheard_count;
        return;
    }
    // The supply, refused by name while the reply it read is still in hand: a
    // run publishes a position only where the reader actually wrote one.
    if (rung.unvoiced_appeal(if (replied) 1 else 0, heard_count)) |why| return why;
    if (rung.appeal_refusal(told, heard_count, unheard_count)) |why| return why;
    // invariant: a run that reached the appeal refuses nothing it must read
    assert(heard_count == 1);
    const plea = wrote orelse return error.AppealUnvoiced;
    try rung.appeal_note(io, plea);
    // The wire before the memory, once more: the position is read back out of
    // the plan's own note, and only then does the report believe it.
    const standing_plea = rung.appeal_published(io) orelse return error.AppealMisrecorded;
    // The record half of this rung: an operator reads where a living person
    // stands, so it must be where they actually stand.
    if (!rung.quotes_plea(standing_plea, plea)) return error.AppealMisrecorded;
    rung.appeal_of(report_out).heard_back = heard_count;
    rung.appeal_of(report_out).unheard_back = unheard_count;
    // invariant: an open run leaves no answered reader unread
    assert(rung.appeal_of(report_out).unread == 0);
}

/// Reads the wire for the position a run left standing, or nothing when nobody
/// has left one.
///
/// One text for the whole quarrel tier: the note opens through the rung's own
/// path builder and its own plan name, so a rung keeps its standing wherever it
/// keeps its notes and still reads it with this body.
pub fn position_standing(comptime rung: type, io: std.Io) ?rung.Plea {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".standing") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a standing position never outgrows the one quarrel it names
    assert(got <= 1);
    if (got < 1) return null;
    return rung.plea_of_byte(bytes[0]);
}

/// Reads back how long a position has stood, in runs, off the wire rather than
/// out of anything a run believes it wrote.
pub fn dwell_published(comptime rung: type, io: std.Io) ?u32 {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".dwell") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an age never outgrows the one byte it is written in
    assert(got <= 1);
    if (got < 1) return null;
    const seen: u32 = bytes[0];
    if (seen == 0) return null;
    // invariant: an age read off the wire stands within the byte carrying it
    assert(seen <= rung.max_dwell_runs);
    return seen;
}

/// Reads the wire for the forum a quarrel may be referred to, bounded by the
/// rung's own address ceiling.
pub fn forum_published(comptime rung: type, io: std.Io, out: *[rung.max_address_len]u8) ?[]const u8 {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".forum") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    const got = file.readPositionalAll(io, out, 0) catch return null;
    // invariant: a forum never outgrows the bound its wire carries
    assert(got <= rung.max_address_len);
    var len: u32 = 0;
    while (len < got and out[len] != 0 and out[len] != '\n') : (len += 1) {}
    const forum = out[0..len];
    return if (rung.addressable(forum)) forum else null;
}

/// Refuses by name every way a referral could be claimed that the run's own
/// counts cannot account for.
pub fn refer_refusal(
    comptime rung: type,
    loud_count: u32,
    sent_count: u32,
    held_count: u32,
    addressed: bool,
    party: bool,
) ?rung.RunError {
    // invariant: a run never refers more positions than one note may carry
    assert(sent_count <= 1);
    if (sent_count >= 1 and loud_count == 0) return error.ReferEarly;
    if (sent_count >= 1 and !addressed) return error.ReferUnaddressed;
    if (sent_count >= 1 and party) return error.ReferParty;
    // Every long-standing position is referred or kept inside the argument --
    // never both and never neither. A count that does not close is a supervisor
    // about to claim a hearing its own wire cannot account for.
    if (sent_count + held_count != loud_count) return error.ReferMiscounted;
    return null;
}

/// Reads back the case a third hand would open at this forum, or nothing when
/// the box holds no whole case.
pub fn case_delivered(comptime rung: type, io: std.Io, forum: []const u8) ?[rung.max_referral_bytes]u8 {
    if (!rung.addressable(forum)) return null;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.case_path(&path_buf, forum) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [rung.max_referral_bytes]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a case never outgrows the three facts it carries
    assert(got <= rung.max_referral_bytes);
    if (got < rung.max_referral_bytes) return null;
    return bytes;
}

/// Carries a case to a forum outside both parties, written whole into the box a
/// third hand opens.
pub fn refer_note(comptime rung: type, io: std.Io, forum: []const u8, case: [rung.max_referral_bytes]u8) rung.NoteError!void {
    // invariant: a case is only ever carried to an address a run may carry to
    assert(rung.addressable(forum));
    Dir.cwd().createDirPath(io, rung.reader_dir) catch return error.NoteUnavailable;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = try rung.case_path(&path_buf, forum);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    file.writePositionalAll(io, &case, 0) catch return error.NoteUnavailable;
}

/// Refers a long-standing quarrel to a forum outside both parties, and believes
/// the report only after reading the case back out of the box a third hand opens.
///
/// The arc's referral half, stated once. A run reads what stands, refuses to act
/// on a quarrel nobody presses, dates the position off the wire, counts what a
/// carried-nowhere quarrel costs, leaves this morning's argument with the people
/// having it, refuses by name where a referral would go unaddressed or land back
/// inside the argument, copies the case off the record rather than summarizing
/// it, writes the note, and reads it back before the report believes a word.
///
/// Every reach here is seated through the rung handed in, so one text refers the
/// quarrel for whichever rung called it -- that rung's own wire, its own
/// refusals, its own report.
pub fn refer_the_quarrel(
    comptime rung: type,
    io: std.Io,
    refer: rung.Refer,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const stood_plea = rung.position_standing(io) orelse {
        // invariant: a run with nothing standing refers no quarrel
        assert(rung.refer_of(report_out).referred == 0);
        // invariant: a run with nothing standing leaves none unheard
        assert(rung.refer_of(report_out).unheard == 0);
        return;
    };
    if (!rung.endures(stood_plea)) {
        // invariant: a quarrel nobody presses is never referred on their behalf
        assert(rung.refer_of(report_out).referred == 0);
        return;
    }
    const standing_count: u32 = 1;

    // The age this rung reads is the age on the wire, never the age it believes
    // it wrote. A position no run has dated reads null, and an undated quarrel
    // is honestly nothing to build a case from -- so it stays where it is.
    const age = rung.dwell_published(io) orelse 0;

    // The measurement this rung moves, weighed against the position actually
    // left standing rather than against anything the plan asked for, so a
    // long-standing quarrel carried nowhere is counted rather than refused.
    rung.refer_of(report_out).unheard = rung.unheard_outside(standing_count, age, refer);
    const volume = rung.stands_loud(age);
    if (volume == .quiet) {
        // invariant: a quarrel raised this morning is left with the people having it
        assert(rung.refer_of(report_out).referred == 0);
        return;
    }
    const loud_count: u32 = 1;
    const sent_count = rung.referred_in(loud_count, refer);
    const kept_count = rung.unreferred_in(loud_count, refer);
    if (refer == .unheard) {
        // invariant: an unheard run refers nothing, however long the quarrel stood
        assert(sent_count == 0);
        rung.refer_of(report_out).kept_in = kept_count;
        return;
    }

    // The forum comes off the wire, and the reader's own address beside it, so
    // the one comparison this rung exists to make is made against two facts a
    // run found rather than two a run chose.
    var forum_buf: [rung.max_address_len]u8 = @splat(0);
    const named = rung.forum_published(io, &forum_buf);
    var reader_buf: [rung.max_address_len]u8 = @splat(0);
    const reader = rung.address_published(io, &reader_buf);
    const addressed = named != null;
    const party = if (named) |forum| (if (reader) |at| rung.is_party(forum, at) else false) else false;
    if (rung.refer_refusal(loud_count, sent_count, kept_count, addressed, party)) |why| return why;
    const forum = named orelse return error.ReferUnaddressed;

    // The case is copied off the record in the run that sends it, never
    // summarized: a summary is exactly where a supervisor would get to shade
    // the argument against itself.
    const settled = rung.settlement_published(io) orelse return error.ReferEarly;
    const case = rung.referral_bytes(settled, volume, age);
    // invariant: a referring run carries the one long-standing position it left
    assert(sent_count == 1);
    try rung.refer_note(io, forum, case);
    // The wire before the memory, once more: the box a third hand opens is read
    // back, and only then does the report believe the case arrived.
    const standing_case = rung.case_delivered(io, forum);
    // The record half of this rung: this is the one note of the whole arc that
    // lands outside both parties, so a case disagreeing with the record it was
    // copied from would mislead the only hand able to end the argument.
    if (!rung.refer_holds(standing_case, case)) return error.ReferMisrecorded;
    rung.refer_of(report_out).referred = sent_count;
    rung.refer_of(report_out).kept_in = kept_count;
    // invariant: a referring run leaves no long-standing quarrel unheard
    assert(rung.refer_of(report_out).unheard == 0);
}


/// Stands the word this run published up beside the reading recorded against it.
///
/// The wire before the memory, one tier further out than the record below it:
/// this run reads its own published settlement out of the note an operator would
/// open, reads the disagreement out of the note that keeps it, and writes the
/// mark from those two rather than from anything the supervisor remembers doing.
/// A plan that escorted its word from memory of a quarrel would be quoting a
/// reader it never read.
///
/// A run that published nothing marks nothing, and a record holding no quarrel
/// has nothing to quote; both are silences no mark can fill, and each says so by
/// weighing nothing rather than by inventing an objector. A word published over
/// a disagreement that stands recorded, read by an operator who finds no sign of
/// it, is the number this rung moves.
///
/// Every reach here is seated through the rung handed in, so one text escorts
/// whichever rung called it. `abide.rye` owns the abiding tier and reached its
/// own report directly; three lines of identity accessor brought its forty-seven
/// home with the rest, so the family folded whole at thirty-two.
pub fn escort_the_word(
    comptime rung: type,
    io: std.Io,
    escort: rung.Escort,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const said = rung.settlement_published(io);
    const published: u32 = if (said == null) 0 else 1;
    if (published == 0) {
        // invariant: a run that published nothing leaves no word unattended
        assert(rung.abiding_of(report_out).unattended == 0);
        return;
    }
    const held = rung.dispute_recorded(io);
    const disputed = held != null;

    // The measurement this rung moves, weighed against what the wire actually
    // carries rather than against what any escort asked for, so a word left
    // standing alone is counted rather than refused.
    rung.abiding_of(report_out).unattended = rung.published_unattended(published, disputed, escort);
    const escorted = rung.escorted_in(published, disputed, escort);
    const alone_count = rung.alone_in(published, disputed, escort);
    if (escort == .alone) {
        // invariant: a word read alone carries no mark, however plainly its
        // reader objected
        assert(escorted == 0);
        return;
    }
    if (!disputed) {
        // A record holding no disagreement has nothing to stand beside the word,
        // and the wire says so by leaving the settlement exactly as it reads.
        //
        // invariant: an unquarrelled word is never escorted
        assert(escorted == 0);
        return;
    }
    // The supply, refused by name while the record it read is still in hand: a
    // run escorts a word only where a disagreement actually stands.
    if (rung.unrecorded_escort(disputed, escorted)) |why| return why;
    if (rung.abide_refusal(held, alone_count, escorted)) |why| return why;
    // invariant: a run that reached the escort refuses nothing it must write
    assert(escorted == 1);
    const record = held orelse return error.AbideUnrecorded;
    const marked = record[1];
    // The mark, and the hard half of this rung: an escort carries one person's
    // word to whoever reads another, so it must be that person's word.
    if (!rung.quotes(marked, record)) return error.AbideMisquoted;
    try rung.abide_note(io, marked);
    rung.abiding_of(report_out).escorted = escorted;
    // invariant: an escorting run leaves no published word unattended
    assert(rung.abiding_of(report_out).unattended == 0);
}


/// Reads the recorded disagreement back as the two readings it names.
///
/// A run that reads nothing here recorded no disagreement, and says so with a
/// null rather than by guessing -- which leaves the record exactly where the
/// rung below leaves it, reading as one voice whatever its reader answered.
///
/// The rung handed in carries its own path builder and its own plan name, so a
/// rung keeps its notes wherever it keeps them and still reads them here.
pub fn dispute_recorded(comptime rung: type, io: std.Io) ?[2]rung.Settlement {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".dispute") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a dispute never outgrows the two readings it names
    assert(got <= 2);
    if (got < 2) return null;
    const ours = rung.settlement_of_byte(bytes[0]) orelse return null;
    const theirs = rung.settlement_of_byte(bytes[1]) orelse return null;
    return .{ ours, theirs };
}


/// Starts one dependent, from the entrustment it may claim to the generation it
/// will stand in.
///
/// The whole opening of a run reads here in one sequence, and the order is the
/// meaning. A start first asks what the line may still claim, since a dependent
/// entrusted with nothing has no business opening a generation at all. It then
/// narrows the grant to the one domain this task names, so what the document
/// allows and what the run reaches are the same set rather than two sets that
/// happen to agree today.
///
/// Only then do the notes land, each a promise a later hand reads back off the
/// wire rather than out of anyone's memory: the generation this dependent stands
/// in, the depth it was offered, whether its reserve is held on or pruned, and
/// whether the run expects it to fall. A start that seated a spawn before those
/// notes would leave a dependent running under promises nothing had recorded.
///
/// Every reach is seated through the rung handed in, so one text starts whichever
/// rung called it. Two rungs stood apart from the forty and both came home: the
/// tier owner `abandon.rye` reaches its own report directly, and `reckon.rye`
/// stands one rung above it and reaches through the neighbor it names, so three
/// lines of accessor apiece folded their thirty-five with the rest and the family
/// closed whole at forty-two.
pub fn start_one(
    comptime rung: type,
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?rung.Task,
    keeping: rung.Keep,
    wake: gap.Wake,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    // invariant: a start always names the domain it starts
    assert(phase.task.item.domain.len >= 1);
    // invariant: a start always hands a line that names arcs
    assert(phase.task.item.hops.len >= 1);
    var line: entrust.Line = .{};
    const widest = entrust.entrusted_task(phase.task, reserve, rung.reserve_depth(reserve), &line) orelse
        return error.EntrustExhausted;
    if (!entrust.entrust_granted(sys, widest)) return error.EntrustUngranted;
    const narrowed = intent.narrow(caps, phase.task) orelse return error.UnknownDomain;
    const slot = narrowed.find_dependent(phase.task.item.domain) orelse return error.UnknownDomain;
    // invariant: a narrowed line stays inside what the document grants
    assert(boot.line_within(sys, slot));
    const generation = try rung.open_generation(io, phase.task.item.domain);
    // invariant: every dependent stands in a generation of its own
    assert(generation >= 1);
    try rung.offer(io, phase.task.item.domain, rung.reserve_depth(reserve));
    try rung.promise_pruning(io, phase.task.item.domain, keeping);
    try rung.promise_falling(io, phase.task.item.domain, phase.task.item.expect != carry.Outcome.carried_ok);
    rung.abandoning_of(report_out).inner.inner.stale_at_home += rung.revoke_rung.stale_reach(rung.reserve_depth(reserve), keeping);
    return cohort.spawn_one_within(
        allocator, io, self_path, sys, &narrowed, phase.task.item, wake, &.{},
    );
}


/// Opens the generation a dependent will stand in, and hands back its number.
///
/// A generation is read off the wire and written back one higher, so the count a
/// later hand reads is the count this run actually opened rather than a number
/// anyone carried in memory. A domain with no epoch note yet reads as zero and
/// opens at one, which is how a first run and a resumed run tell themselves
/// apart without either asking.
pub fn open_generation(comptime rung: type, io: std.Io, domain: []const u8) rung.NoteError!u32 {
    // invariant: a generation always names the domain it opens in
    assert(domain.len >= 1);
    const standing_now = rung.read_count(io, domain, ".epoch") catch 0;
    // invariant: a run never opens more generations than one byte may name
    assert(standing_now < 255);
    const opened: u8 = standing_now + 1;
    try rung.seat_note(io, domain, ".epoch", &[_]u8{opened});
    return opened;
}


/// Records the depth a dependent was offered, as a note a later hand reads back.
///
/// The offer lands on the wire before the spawn, so a dependent never runs under
/// a depth nothing recorded. A depth past what one line may name is refused here
/// rather than truncated into a note that would read as a smaller promise than
/// the one the run made.
pub fn offer(comptime rung: type, io: std.Io, domain: []const u8, depth: u32) rung.NoteError!void {
    // invariant: an offer always names the dependent it is made to
    assert(domain.len >= 1);
    // invariant: an offer never promises more than one line may name
    assert(depth <= cycle.max_hops);
    try rung.seat_note(io, domain, ".offered", &[_]u8{@intCast(depth)});
}


/// Promises whether a dependent's reserve is held on or pruned.
///
/// The two the keep may carry are written as the two bytes a reader knows, so the
/// note says which of them stands rather than leaving a later hand to infer it
/// from the absence of the other.
pub fn promise_pruning(comptime rung: type, io: std.Io, domain: []const u8, keep: rung.Keep) rung.NoteError!void {
    // invariant: a promise always names the dependent it is made to
    assert(domain.len >= 1);
    const byte: u8 = switch (keep) {
        .held_on => 0,
        .pruned => 1,
    };
    // invariant: a promise is always one of the two the keep may carry
    assert(byte <= 1);
    try rung.seat_note(io, domain, ".pruning", &[_]u8{byte});
}


/// Declares whether the run expects this dependent to fall.
///
/// A dependent that ends the way its plan expected and one that ends any other
/// way are the two endings a supervisor must tell apart, and this note is where
/// the expectation is written down before either happens -- so the reading later
/// is a comparison rather than a recollection.
pub fn promise_falling(comptime rung: type, io: std.Io, domain: []const u8, falling: bool) rung.NoteError!void {
    // invariant: a declaration always names the dependent it is made to
    assert(domain.len >= 1);
    const byte: u8 = if (falling) 1 else 0;
    // invariant: a declaration is always one of the two ways a dependent ends
    assert(byte <= 1);
    try rung.seat_note(io, domain, ".falls", &[_]u8{byte});
}


/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    comptime rung: type,
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const rung.Words,
    carried: u32,
) ?u32 {
    // invariant: a return always names the dependent making it
    assert(domain.len >= 1);
    // invariant: a return never gives back more than one dependent may hold
    assert(carried <= capabilities.max_caps_per_dependent);
    if (carried == 0 or !rung.pruning_promised(io, domain)) return 0;
    var gave_back: u32 = 0;
    var prunes: u32 = 0;
    while (prunes < rung.max_prune_looks) : (prunes += 1) {
        const remaining = rung.kept(io, domain) catch break;
        if (remaining >= carried) {
            std.Io.sleep(io, std.Io.Duration.fromMilliseconds(rung.note_rest_ms), .awake) catch {};
            continue;
        }
        slot.* = rung.prune_to(base, granted, remaining) orelse return null;
        if (rung.reachable_between(io, slot, granted, remaining, carried) != 0) break;
        gave_back = carried - remaining;
        rung.pruned(io, domain, gave_back) catch return null;
        break;
    }
    // invariant: the waiting stayed inside the bound it was given
    assert(prunes <= rung.max_prune_looks);
    // invariant: a dependent never returns more reach than it grafted
    assert(gave_back <= carried);
    return gave_back;
}


/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    comptime rung: type,
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const rung.Words,
    from: u32,
    to: u32,
) u32 {
    // invariant: a probe always reads a range that runs forward
    assert(from <= to);
    // invariant: a probe never reaches past what one dependent may hold
    assert(to <= capabilities.max_caps_per_dependent);
    var reachable: u32 = 0;
    var i: u32 = from;
    while (i < to) : (i += 1) {
        const word = rung.word_at(words, i) orelse break;
        const cap = boot.read_cap_word(word) orelse break;
        if (rung.queue_store.read_index(io, slot, cap.name_slice())) |_| {
            reachable += 1;
        } else |_| {}
    }
    // invariant: no arc counts as reachable that was never in the range
    assert(reachable <= to - from);
    return reachable;
}


/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    comptime rung: type,
    base: *const capabilities.DependentSlot,
    words: *const rung.Words,
    keep: u32,
) ?capabilities.DependentSlot {
    // invariant: a pruning never keeps more than one dependent may hold
    assert(keep <= capabilities.max_caps_per_dependent);
    // invariant: a pruning always rebuilds from hands that hold their own line
    assert(base.cap_count <= capabilities.max_caps_per_dependent);
    var rebuilt = base.*;
    var i: u32 = 0;
    while (i < keep) : (i += 1) {
        const word = rung.word_at(words, i) orelse return null;
        const cap = boot.read_cap_word(word) orelse return null;
        if (rung.already_holds(&rebuilt, cap.name_slice())) continue;
        rebuilt.grant(cap) catch return null;
    }
    // invariant: every kept word was read back into the dependent's hands
    assert(i == keep);
    // invariant: a rebuilt slot never holds less than the line it was spawned with
    assert(rebuilt.cap_count >= base.cap_count);
    return rebuilt;
}


/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(comptime rung: type, io: std.Io, domain: []const u8) bool {
    // invariant: a promise is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = rung.read_count(io, domain, ".pruning") catch return false;
    return seen != 0;
}


/// Reads how many conferred words this dependent may still hold.
pub fn kept(comptime rung: type, io: std.Io, domain: []const u8) rung.NoteError!u32 {
    // invariant: a keeping is always read by the dependent that listens
    assert(domain.len >= 1);
    const seen = try rung.read_count(io, domain, ".kept");
    // invariant: a keeping stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}


/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(comptime rung: type, io: std.Io, domain: []const u8, count: u32) rung.NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never prunes more than one line may name
    assert(count <= cycle.max_hops);
    try rung.seat_note(io, domain, ".pruned", &[_]u8{@intCast(count)});
}

/// Whether an address names a place a correction may actually be carried to.
///
/// Bounded and plain: a reader's address is a short name, never empty and never
/// longer than the wire's own bound, and never a path a run could be talked into
/// walking somewhere it was not asked to go. A run that cannot name where a
/// reader is refuses rather than guessing.
///
/// Thirty-five rungs held this body byte for byte. It lifts here whole, and each
/// one still measures against its own ceiling, because the bound arrives with
/// the type handed in.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn addressable(comptime rung: type, address: []const u8) bool {
    if (address.len == 0) return false;
    if (address.len > rung.max_address_len) return false;
    for (address) |byte| {
        const lower = byte >= 'a' and byte <= 'z';
        const upper = byte >= 'A' and byte <= 'Z';
        const digit = byte >= '0' and byte <= '9';
        if (!(lower or upper or digit or byte == '_')) return false;
    }
    return true;
}


/// Writes the path of one reader's own box.
///
/// The one path this tier builds outside `note_dir`, and the shape of its whole
/// claim: a delivery lands where the reader is rather than where the record
/// lives. The address is bounded and checked before a byte of it reaches a path.
///
/// Thirty-five rungs held this body byte for byte, and each of them now reaches
/// its own readers' directory and its own path ceiling through the type it hands
/// in -- so a rung that moves where its readers live moves the box it writes.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn box_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: a box is only ever built for an address a run may carry to
    assert(addressable(rung, address));
    const suffix = ".told";
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a box path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}


/// Reads the published amendment back as the two readings it names.
///
/// A run that reads nothing here corrected nobody, and says so with a null
/// rather than by guessing -- which leaves a reader exactly where the rung below
/// leaves them, holding a word the plan no longer stands behind.
///
/// Thirty-six rungs held this body byte for byte, one of them the amending tier
/// that owns the note. Each still opens its own plan's own drawer, because the
/// path builder and the plan name both arrive with the type handed in.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn amend_published(comptime rung: type, io: std.Io) ?[2]rung.Settlement {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".amend") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an amendment never outgrows the two readings it names
    assert(got <= 2);
    if (got < 2) return null;
    const was = rung.settlement_of_byte(bytes[0]) orelse return null;
    const now = rung.settlement_of_byte(bytes[1]) orelse return null;
    return .{ was, now };
}


/// Carries one correction to the reader's own box, in the words they read.
///
/// The outward reach of the whole arc, and it is deliberately the same two
/// bytes the wire carries: the reading superseded and the reading that
/// supersedes it, so `bc` reads *you were told the plan was borne; it is
/// carried out whole* wherever a person finds it. The box is made here, since a
/// reader's address is a place this plan has never written to before.
///
/// Thirty-five rungs held this body byte for byte, and each still writes into
/// its own readers' directory in its own settlement alphabet.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn deliver(comptime rung: type, io: std.Io, address: []const u8, was: rung.Settlement, now: rung.Settlement) rung.NoteError!void {
    // invariant: a delivery always names two readings that actually differ
    assert(was != now);
    // invariant: a delivery is only ever carried to an address a run may reach
    assert(addressable(rung, address));
    Dir.cwd().createDirPath(io, rung.reader_dir) catch return error.NoteUnavailable;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = try box_path(rung, &path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{ rung.settlement_byte(was), rung.settlement_byte(now) };
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}


/// Reads one reader's box back as the two readings it carries.
///
/// The hard half of this tier, read from the box rather than from the run's own
/// memory of writing to it. A run that reads nothing here delivered nothing,
/// and says so with a null rather than by believing its own report -- which is
/// the difference between a delivery and a claim about one.
///
/// Thirty-five rungs held this body byte for byte, and each still reads back out
/// of the box it just wrote into, since the box and the alphabet both arrive
/// with the type handed in.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn delivered_to(comptime rung: type, io: std.Io, address: []const u8) ?[2]rung.Settlement {
    if (!addressable(rung, address)) return null;
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = box_path(rung, &path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [2]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a delivery never outgrows the two readings it names
    assert(got <= 2);
    if (got < 2) return null;
    const was = rung.settlement_of_byte(bytes[0]) orelse return null;
    const now = rung.settlement_of_byte(bytes[1]) orelse return null;
    return .{ was, now };
}


/// Which posted correction this run carries, counted as the one it can be.
///
/// A run under `.waiting` carries none, however truly it corrected the wire --
/// which is exactly where the rung below leaves a reader who does not return. A
/// run under `.carried` carries the one correction it posted, and only where the
/// reading it answers left an address to carry it to.
///
/// Thirty-five rungs held this body byte for byte, each reading its own dispatch
/// alphabet through the type handed in.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn carried_in(comptime rung: type, amended: u32, addressed: bool, dispatch: rung.Dispatch) u32 {
    // invariant: a run never posts more corrections than a wire may hold
    assert(amended <= 1);
    if (dispatch == .waiting) return 0;
    if (!addressed) return 0;
    return amended;
}


/// Which posted correction this run leaves standing where it wrote it.
///
/// The other half of the same count, named rather than inferred, so the honesty
/// of the count reads straight as an equality: every posted correction is
/// carried or held.
///
/// Thirty-five rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn held_in(comptime rung: type, amended: u32, addressed: bool, dispatch: rung.Dispatch) u32 {
    // invariant: a run never posts more corrections than a wire may hold
    assert(amended <= 1);
    return amended - carried_in(rung, amended, addressed, dispatch);
}


/// Counts the corrections this run wrote and left waiting for a reader who
/// never comes back.
///
/// The first measurement in this family that weighs a record against the
/// **distance** between where it was written and where its reader actually is.
/// The count before it names the sentence a person carried away and the answer
/// this run owed them; this names that answer, written honestly, sitting in the
/// writer's own drawer. Every note below this tier reaches a reader who returns,
/// and this is the first that reaches one who does not.
///
/// The measurement reaches only a correction whose reading left an address. A
/// reader who can be named and was not written to is a loss this run could have
/// prevented; a reader who left no way to be found is a duty nobody can
/// discharge, and counting it would be measuring the weather.
///
/// Thirty-five rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn posted_unreached(comptime rung: type, amended: u32, addressed: bool, dispatch: rung.Dispatch) u32 {
    // invariant: a run never posts more corrections than a wire may hold
    assert(amended <= 1);
    if (amended == 0 or !addressed) return 0;
    return if (dispatch == .carried) 0 else 1;
}


/// Refuses a delivery bound for a reader who left no address.
///
/// The supply this tier is bounded by, stated as its own refusal so it can be
/// read straight rather than inferred from a count. Carrying a correction to a
/// reader nobody can name invents a destination, which is the same overreach as
/// correcting a reader who never read.
///
/// Thirty-five rungs held this body byte for byte, each naming the refusal out
/// of its own error set.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn unaddressed_reach(comptime rung: type, addressed: bool, carried: u32) ?rung.RunError {
    // invariant: a run never carries more corrections than it posted
    assert(carried <= 1);
    if (carried >= 1 and !addressed) return error.CourierUnaddressed;
    return null;
}


/// Answers why one correction may not be carried, or that it may.
///
/// Every refusal this tier earns before a correction leaves the wire. `posted`
/// is the amendment this run read back from its own record, `addressed` is
/// whether the reading it answers named a place to carry it to, `held` is how
/// many corrections stay where they were written, and `carried` is how many
/// travel.
///
/// The order is the rung below's order one tier out. A delivery asks whether
/// there is a correction to carry before it asks where to carry it, because a
/// courier setting out with an empty satchel is delivering from memory of a
/// letter nobody wrote.
///
/// Thirty-five rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn carry_refusal(
    comptime rung: type,
    posted: ?[2]rung.Settlement,
    addressed: bool,
    held: u32,
    carried: u32,
) ?rung.RunError {
    // invariant: a run never carries more corrections than it posted
    assert(carried <= 1);
    // invariant: a run never holds more corrections than a wire may hold
    assert(held <= 1);
    _ = posted orelse return error.CourierEarly;
    if (!addressed) return error.CourierUnaddressed;
    if (held + carried > 1) return error.CourierMiscounted;
    // Every posted correction is carried or held -- never both and never
    // neither. A count that does not close is a supervisor about to report a
    // journey its own record cannot support.
    if (held + carried != 1) return error.CourierMiscounted;
    return null;
}


/// Carries the run's own correction to the reader who is owed it.
///
/// A run that posted no correction carries nothing, and says so by weighing
/// nothing rather than by inventing an errand. A reader who left no address
/// cannot be reached, and the run refuses by name rather than choosing a
/// destination on their behalf. Only a posted correction with somewhere to go
/// travels -- and under `.waiting` even that one stays where it was written,
/// which is where the rung below leaves every reader who does not come back,
/// and precisely the number this tier moves.
///
/// Thirty-four rungs held this body byte for byte, and the couriering tier owner
/// held it too once the identity accessor it never needed was named -- so the
/// family folds whole at thirty-five. Each rung still reads its own record, its
/// own address ceiling, and its own box, because every symbol it reaches arrives
/// with the type handed in, including the accessor that finds this tier's own
/// report inside a report nested as deep as that rung stands.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn carry_the_amendment(
    comptime rung: type,
    io: std.Io,
    dispatch: rung.Dispatch,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const amended = rung.amending_of(report_out).amended;
    if (amended == 0) {
        // invariant: a run that corrected nobody leaves no correction waiting
        assert(rung.couriering_of(report_out).unreached == 0);
        return;
    }
    var address_buf: [rung.max_address_len]u8 = @splat(0);
    const address = address_published(rung, io, &address_buf);
    const addressed = address != null;

    // The measurement this tier moves, weighed against what the run actually
    // posted rather than against what any dispatch asked for, so a correction
    // left in the drawer is counted rather than refused.
    rung.couriering_of(report_out).unreached = posted_unreached(rung, amended, addressed, dispatch);
    const carried = carried_in(rung, amended, addressed, dispatch);
    const held = held_in(rung, amended, addressed, dispatch);
    if (dispatch == .waiting) {
        // invariant: a waiting run carries nothing, however truly it corrected
        assert(carried == 0);
        return;
    }
    // The supply, refused by name while the address it must reach is still in
    // hand: a correction may travel only to a place a reader actually left.
    if (unaddressed_reach(rung, addressed, carried)) |why| return why;
    const posted = amend_published(rung, io);
    if (carry_refusal(rung, posted, addressed, held, carried)) |why| return why;
    // invariant: a run that reached the carrying refuses nothing it must carry
    assert(carried == 1);
    const letter = posted orelse return error.CourierEarly;
    const where = address orelse return error.CourierUnaddressed;
    try deliver(rung, io, where, letter[0], letter[1]);
    // The answer, and the hard half of this tier: a run that reports a reader
    // reached whose box holds nothing has made a claim rather than a delivery,
    // and a report read on that claim is worse than the silence below it.
    const in_the_box = delivered_to(rung, io, where) orelse return error.CourierUndelivered;
    if (in_the_box[0] != letter[0] or in_the_box[1] != letter[1]) return error.CourierUndelivered;
    rung.couriering_of(report_out).delivered = carried;
    // invariant: a carrying run leaves no correction waiting for its reader
    assert(rung.couriering_of(report_out).unreached == 0);
}


/// Reads what this plan's word stands in, or nothing at all.
///
/// The read an operator makes beside the settlement, and the read this run makes
/// of its own note before the report believes a word of it. A plan nobody has
/// pressed a quarrel against answers with a null rather than by claiming its
/// word stands alone, since the honest reading of an empty note is that no run
/// has said anything yet.
///
/// Twenty-six rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn regard_published(comptime rung: type, io: std.Io) ?rung.Regard {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".regard") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a regard never outgrows the one word it names
    assert(got <= 1);
    if (got < 1) return null;
    return rung.regard_of_byte(bytes[0]);
}


/// Publishes what this plan's own word stands in, beside the word itself.
///
/// One byte into `plan.regard`, seated among the plan's own notes rather than in
/// any reader's box, because the person this is written for is the operator who
/// opens the outcome. The settlement says what the work came to; this says what
/// company that word keeps.
///
/// Twenty-six rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn regard_note(comptime rung: type, io: std.Io, regard: rung.Regard) rung.NoteError!void {
    // invariant: only a word standing under a quarrel is ever published as one
    assert(regard == .under);
    try rung.seat_note(io, rung.plan_name, ".regard", &[_]u8{rung.regard_byte(regard)});
}


/// Carries one position past the run that heard it.
///
/// One byte into `plan.standing`, which is the only note of this arc a
/// provisioning leaves alone. Every other note an operator opens is a finding of
/// the run that wrote it; this one is a living person's statement that the
/// matter is not over, quoted rather than composed, and it is written here so
/// the run after this one opens already knowing.
///
/// Twenty-seven rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn standing_note(comptime rung: type, io: std.Io, plea: rung.Plea) rung.NoteError!void {
    // invariant: only a pressed quarrel is ever carried past its own run
    assert(rung.endures(plea));
    try rung.seat_note(io, rung.plan_name, ".standing", &[_]u8{rung.plea_byte(plea)});
}


/// Writes how long the position standing over this plan has stood, in runs.
///
/// One byte into `plan.dwell`, seated beside the standing note and living
/// exactly as long as it does. A provisioning leaves both alone, since the age
/// of a quarrel belongs to the quarrel rather than to any run that met it; a
/// withdrawal takes both down together.
///
/// Twenty-four rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn dwell_note(comptime rung: type, io: std.Io, runs: u32) rung.NoteError!void {
    // invariant: an age only ever reaches the wire once it has stood a run
    assert(runs >= 1);
    // invariant: an age always fits the single byte that carries it
    assert(runs <= rung.max_dwell_runs);
    try rung.seat_note(io, rung.plan_name, ".dwell", &[_]u8{@intCast(runs)});
}


/// Reads how loudly the quarrel standing over this plan reads, or nothing.
///
/// A run that reads nothing here has met a plan whose standing no run has yet
/// published, and says so with a null rather than by calling it quiet -- which
/// is the honest reading, since an unpublished position may have outlasted a
/// season.
///
/// Twenty-three rungs held this body byte for byte.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn swell_published(comptime rung: type, io: std.Io) ?rung.Volume {
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".swell") catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: a standing never outgrows the one byte it is written in
    assert(got <= 1);
    if (got < 1) return null;
    return rung.volume_of_byte(bytes[0]);
}


/// Carries a pressed quarrel past the run that heard it, or lets it end there.
///
/// The wire before the memory, one tier further out than the reading below it:
/// this run reads the plea it just published, weighs whether that plea is one a
/// run may carry, writes it into the standing note the next provisioning leaves
/// alone, and reads that note back before the report believes a word of it. A
/// plan that carried a position from memory of having written one would be
/// handing every run after it a quarrel on the strength of its own expectation.
///
/// A run that heard nobody has nothing to carry, and a reader content with how
/// their quarrel came out has nothing that ought to survive them; both are
/// endings this rung reaches for by weighing nothing rather than by inventing a
/// position. A pressed quarrel a run heard and the run after it began without is
/// the number this rung moves.
///
/// Twenty-two rungs held this body byte for byte, four more differed only by the word
/// `pub`, and the enduring tier owner came home on three lines of identity accessor.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn carry_the_position(
    comptime rung: type,
    io: std.Io,
    endurance: rung.Endurance,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const plea = rung.appeal_published(io) orelse {
        // invariant: a run that heard nobody carries no position forward
        assert(rung.endure_of(report_out).kept == 0);
        // invariant: a run that heard nobody drops no position either
        assert(rung.endure_of(report_out).dropped == 0);
        return;
    };
    const heard: u32 = 1;

    // The measurement this rung moves, weighed against the plea the wire itself
    // carries rather than against what any plan asked for, so a quarrel left to
    // die with its run is counted rather than refused.
    rung.endure_of(report_out).dropped = rung.position_dropped(heard, plea, endurance);
    const kept_count = rung.kept_in(heard, plea, endurance);
    const spent_count = rung.spent_in(heard, plea, endurance);
    if (endurance == .spent) {
        // invariant: a spending run carries nothing, however plainly its reader pressed
        assert(kept_count == 0);
        rung.endure_of(report_out).spent = spent_count;
        return;
    }
    if (!rung.endures(plea)) {
        // A reader content with the outcome has closed their own quarrel, and
        // the wire says so by leaving the standing note exactly as it reads.
        //
        // invariant: a contentment is never carried past the run that earned it
        assert(kept_count == 0);
        rung.endure_of(report_out).spent = spent_count;
        return;
    }
    // The supply, refused by name while the plea it read is still in hand: a run
    // carries a position only where its holder actually pressed one.
    if (rung.unpressed_endurance(if (rung.endures(plea)) 1 else 0, kept_count)) |why| return why;
    if (rung.endure_refusal(heard, kept_count, spent_count)) |why| return why;
    // invariant: a run that reached the endurance carries the one position it heard
    assert(kept_count == 1);
    try standing_note(rung, io, plea);
    // The wire before the memory, once more: the position is read back out of
    // the note the next run will open, and only then does the report believe it.
    const carried = rung.position_standing(io) orelse return error.EndureMisremembered;
    // The record half of this rung: the next run opens this byte and begins its
    // whole season believing a person is still in a quarrel, so it must be the
    // quarrel this run actually heard.
    if (!rung.quotes_standing(carried, plea)) return error.EndureMisremembered;
    rung.endure_of(report_out).kept = kept_count;
    rung.endure_of(report_out).spent = spent_count;
    // invariant: a keeping run drops no position it heard
    assert(rung.endure_of(report_out).dropped == 0);
}


/// Weighs the quarrel this run inherited into the word an operator will read.
///
/// The wire before the memory, one tier further out than the carrying below it:
/// this run takes the position it read before its record was ever opened, takes
/// the settlement it has since published, weighs whether that word ought to
/// stand alone, writes the regard beside the settlement, and reads that byte
/// back before the report believes it. A plan that published a regard from
/// memory of having written one would be telling every operator its outcome is
/// qualified on the strength of its own expectation.
///
/// A run nobody has pressed a quarrel against has nothing to weigh, and a plan
/// that came up short already tells its reader the work is unfinished; both are
/// outcomes this rung reaches by weighing nothing rather than by publishing a
/// qualification nobody is owed. A plan reported carried while an inherited
/// quarrel stood against it is the number this rung moves.
///
/// Twenty-two rungs held this body byte for byte, three more held it differing only by
/// the word `pub`, and the heeding tier owner held it too once the identity accessor
/// it never needed was named -- so the family reads as one text across twenty-six.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn weigh_the_standing(
    comptime rung: type,
    io: std.Io,
    taken_up: ?rung.Plea,
    heed: rung.Heed,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const pressed = taken_up orelse {
        // invariant: a run nobody pressed a quarrel against weighs no position
        assert(rung.heed_of(report_out).heeded == 0);
        // invariant: a run nobody pressed a quarrel against leaves none unweighed
        assert(rung.heed_of(report_out).unheeded == 0);
        return;
    };
    const stood: u32 = 1;
    const settled = rung.settlement_published(io) orelse return error.HeedEarly;

    // The measurement this rung moves, weighed against the position the wire
    // itself carried and the word this run itself published, so a quarrel left
    // to stand unanswered is counted rather than refused.
    rung.heed_of(report_out).unheeded = rung.standing_unweighed(stood, pressed, settled, heed);
    const weighed_count = rung.heeded_in(stood, pressed, heed);
    const left_count = rung.unweighed_in(stood, pressed, heed);
    if (heed == .unweighed) {
        // invariant: an unweighing run publishes nothing, however plainly the quarrel stands
        assert(weighed_count == 0);
        rung.heed_of(report_out).unweighed = left_count;
        return;
    }
    if (!rung.endures(pressed)) {
        // A byte no endurance of this arc would ever have written is no position
        // to stand under, and the wire says so by leaving the regard unwritten.
        //
        // invariant: a word never stands under a quarrel nobody pressed
        assert(weighed_count == 0);
        rung.heed_of(report_out).unweighed = left_count;
        return;
    }
    // The supply, refused by name while the position it read is still in hand: a
    // run stands under a quarrel only where a living person actually pressed one.
    if (rung.unpressed_regard(if (rung.endures(pressed)) 1 else 0, weighed_count)) |why| return why;
    if (rung.heed_refusal(stood, weighed_count, left_count)) |why| return why;
    // invariant: a run that reached the heeding weighs the one position it inherited
    assert(weighed_count == 1);
    try regard_note(rung, io, .under);
    // The wire before the memory, once more: the regard is read back out of the
    // note an operator opens beside the settlement, and only then does the report
    // believe it.
    const published = regard_published(rung, io) orelse return error.HeedMisrecorded;
    // The record half of this rung: an operator takes that byte and the
    // settlement together as the whole outcome, so it must be the regard this
    // plan truly stands in.
    if (!rung.regard_holds(published, pressed)) return error.HeedMisrecorded;
    rung.heed_of(report_out).heeded = weighed_count;
    rung.heed_of(report_out).unweighed = left_count;
    // invariant: a weighing run leaves no inherited quarrel unanswered
    assert(rung.heed_of(report_out).unheeded == 0);
}


/// Says how long the position still standing over this plan has stood.
///
/// It runs last of all, because a position has stood through this run only once
/// the run is over -- and because the relenting at the top of the run may
/// already have taken down the very note an age would be written beside.
///
/// The wire before the memory, one tier further out than the relenting above
/// it: this run opens whatever position survived it, reads the age already on
/// the wire, climbs that age by the run just finished, refuses by name an age
/// that would forget runs already counted, writes it, and reads it back before
/// the report believes a word of it. A plan reporting an age from memory of
/// having written one would hand every later operator a number the wire never
/// carried.
///
/// A run with nothing standing has no age to write, and a byte no endurance of
/// this arc would ever have written is no position to date; each is an ending
/// this rung reaches by writing nothing rather than by dating a quarrel nobody
/// holds. A standing quarrel whose note says nothing at all about how long it
/// has stood is the number this rung moves.
///
/// Twenty-two rungs held this body byte for byte, one more differed only by the word
/// `pub`, and the dating tier owner came home on three lines of identity accessor.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn date_the_standing(
    comptime rung: type,
    io: std.Io,
    dwell: rung.Dwell,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const stood_plea = rung.position_standing(io) orelse {
        // invariant: a run with nothing standing dates no position
        assert(rung.dwell_of(report_out).aged == 0);
        // invariant: a run with nothing standing leaves none ageless
        assert(rung.dwell_of(report_out).ageless == 0);
        return;
    };
    if (!rung.endures(stood_plea)) {
        // A byte no endurance of this arc would ever have written is no
        // position to date, and the wire says so by leaving it exactly as it
        // reads.
        //
        // invariant: a quarrel nobody pressed is never dated on their behalf
        assert(rung.dwell_of(report_out).aged == 0);
        return;
    }
    const standing_count: u32 = 1;

    // The measurement this rung moves, weighed against the position actually
    // left standing rather than against anything the plan asked for, so a
    // quarrel standing undated is counted rather than refused.
    rung.dwell_of(report_out).ageless = rung.standing_ageless(standing_count, dwell);
    const told_count = rung.aged_in(standing_count, dwell);
    const undated_count = rung.undated_in(standing_count, dwell);
    if (dwell == .untold) {
        // invariant: an untelling run dates nothing, however long the quarrel stood
        assert(told_count == 0);
        rung.dwell_of(report_out).undated = undated_count;
        return;
    }
    if (rung.dwell_refusal(standing_count, told_count, undated_count)) |why| return why;

    // The age already on the wire, read before a byte of it is replaced. A
    // quarrel no run has yet dated reads null, and null is honestly nothing --
    // this run is the first to count it, and it counts one.
    const before = rung.dwell_published(io) orelse 0;
    const now = rung.stood_longer(before);
    // The hard half, refused by name while the byte it read is still in view: an
    // age only ever climbs, since the runs a position stood through already
    // happened and no later run can unhappen them.
    if (rung.forgotten_dwell(before, now)) |why| return why;
    // invariant: a telling run dates the one position it left standing
    assert(told_count == 1);
    try dwell_note(rung, io, now);
    // The wire before the memory, once more: the note every run after this one
    // opens is read back, and only then does the report believe it was written.
    const after = rung.dwell_published(io);
    // The record half of this rung: a note disagreeing with the age this run
    // actually stood hands every future operator a number that means nothing.
    if (!rung.dwell_holds(after, now)) return error.DwellMisrecorded;
    rung.dwell_of(report_out).aged = told_count;
    rung.dwell_of(report_out).undated = undated_count;
    // invariant: a telling run leaves no standing quarrel undated
    assert(rung.dwell_of(report_out).ageless == 0);
}


/// Publishes, beside the outcome, how loudly the quarrel standing here reads.
///
/// It runs last of all, after the dating below it, because the age this rung
/// reads is the age that dating just left on the wire -- and because the
/// relenting at the top of the run may already have taken down the very
/// position a standing would speak about.
///
/// The wire before the memory, one tier further out than the dating above it:
/// this run opens whatever position survived it, reads the age actually on the
/// wire rather than any age it believes it wrote, weighs that age against a
/// bound no run may move, writes the reading beside the settlement an operator
/// opens, and reads it back before the report believes a word of it.
///
/// A run with nothing standing has no quarrel to herald, and a byte no
/// endurance of this arc would ever have written is no position to speak for;
/// each is an ending this rung reaches by publishing nothing. A quarrel young
/// enough that its age is the whole story is heralded honestly as quiet, and
/// costs the count nothing -- the number this rung moves is the long-standing
/// position an operator reads no louder than a fresh one.
///
/// Twenty-two rungs held this body byte for byte, and the heralding tier owner came
/// home on three lines of identity accessor.
///
/// Measured by `../tools/fixtures/caravan_ladder_print_scan.sh`.
pub fn herald_the_standing(
    comptime rung: type,
    io: std.Io,
    swell: rung.Swell,
    report_out: *rung.Report,
) (rung.RunError || rung.NoteError)!void {
    const stood_plea = rung.position_standing(io) orelse {
        // invariant: a run with nothing standing heralds no position
        assert(rung.swell_of(report_out).heralded == 0);
        // invariant: a run with nothing standing leaves none unheralded
        assert(rung.swell_of(report_out).unheralded == 0);
        return;
    };
    if (!rung.endures(stood_plea)) {
        // invariant: a quarrel nobody pressed is never heralded on their behalf
        assert(rung.swell_of(report_out).heralded == 0);
        return;
    }
    const standing_count: u32 = 1;

    // The age this run reads is the age on the wire, never the age it believes
    // it wrote. A position no run has dated reads null, and null is honestly
    // nothing to speak from -- so the reading refuses by name rather than
    // guessing at a volume.
    const age = rung.dwell_published(io) orelse 0;
    const dated = rung.dwell_published(io) != null;

    // The measurement this rung moves, weighed against the position actually
    // left standing rather than against anything the plan asked for, so a
    // long-standing quarrel published nowhere is counted rather than refused.
    rung.swell_of(report_out).unheralded = rung.standing_unheralded(standing_count, age, swell);
    const loud_count = rung.heralded_in(standing_count, swell);
    const quiet_count = rung.unpublished_in(standing_count, swell);
    if (swell == .hushed) {
        // invariant: a hushed run heralds nothing, however long the quarrel stood
        assert(loud_count == 0);
        rung.swell_of(report_out).unpublished = quiet_count;
        return;
    }
    if (rung.swell_refusal(standing_count, loud_count, quiet_count, dated)) |why| return why;

    const reading = rung.stands_loud(age);
    // invariant: a heralding run speaks for the one position it left standing
    assert(loud_count == 1);
    try rung.swell_note(io, reading);
    // The wire before the memory, once more: the note an operator opens beside
    // the settlement is read back, and only then does the report believe it was
    // written.
    const after = swell_published(rung, io);
    // The record half of this rung: this byte sits where the outcome is read,
    // so a note disagreeing with the standing this run actually weighed would
    // be the loudest wrong word on the wire.
    if (!rung.swell_holds(after, reading)) return error.SwellMisrecorded;
    rung.swell_of(report_out).heralded = loud_count;
    rung.swell_of(report_out).unpublished = quiet_count;
    // invariant: a heralding run leaves no long-standing quarrel unheralded
    assert(rung.swell_of(report_out).unheralded == 0);
}

/// Runs a whole supervised plan the way the forbearing arc means it, from an
/// empty table to a closed quarrel.
///
/// Ten rungs held this body byte for byte -- the largest single carry the
/// ladder ever measured, at a hundred and thirty-seven lines apiece. What it
/// is, plainly: a run seats its record, takes the ground, reads the position an
/// earlier run left standing, fills and reaps its table until nothing is left in
/// flight, judges every dependent it reaped, reckons and mends the plan, and
/// then walks the whole correspondence a quarrel is owed -- amendment, hearing,
/// dispute, escort, term, mark, tidings, appeal -- before closing the quarrel
/// itself.
///
/// **The order is the arc, and the order is why it lifts whole.** Each step here
/// was added by the rung that first proved it, and every rung after it inherited
/// the sequence unchanged. So the body varies in nothing: ten rungs, one hash.
/// Handed in through `rung`, one body runs against whichever rung called it --
/// that rung's own report, its own ceilings, its own wire.
///
/// **What a rung still owns.** Every named step remains the rung's own body, so
/// a rung that wants a different reckoning writes a different `reckon_the_plan`
/// and this spine reaches it. Lifted here is the sequence, never the substance.
///
/// Measured by `../tools/caravan_ladder_carry_witness.rish`.
pub fn run_in_forbear(
    comptime rung: type,
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const rung.Phase,
    wake: gap.Wake,
    reading: anytype,
    keeping: anytype,
    bearing: anytype,
    standard: anytype,
    review: anytype,
    notice: anytype,
    dispatch: anytype,
    receipt: anytype,
    record: anytype,
    escort: anytype,
    term: anytype,
    mark: anytype,
    tidings: anytype,
    appeal: anytype,
    quarrel: anytype,
    report_out: *rung.Report,
) !void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always reports into a fresh report
    assert(rung.run_of(report_out).admitted == 0);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len > rung.max_queue_len) return error.QueueFull;

    var table: rung.Table = .{};
    try rung.seat_the_record(base, &table);

    const caps = try rung.seat_the_ground(io, sys, report_out);

    // The relenting: the note it may take down is the one every step here reads.
    try rung.release_the_standing(io, quarrel.relent, report_out);

    // The quarrel this run inherits, read here and nowhere later: read before a
    // single phase is taken up, it can only be a position an earlier run
    // carried. The rungs below write that same note at the very end of a run, so
    // a plan reading it afterward would be reading its own handwriting back as
    // somebody else's judgment.
    const taken_up = rung.position_standing(io);
    rung.run_of(report_out).queued = table.held;

    while (table.left > 0 or table.in_flight > 0) {
        const took_up = try rung.fill_table(
            allocator, io, self_path, sys, &caps, wake, reading, keeping, &table, report_out,
        );
        if (table.in_flight > rung.run_of(report_out).peak_in_flight) {
            rung.run_of(report_out).peak_in_flight = table.in_flight;
        }

        if (table.left > 0) {
            const free = rung.max_in_flight - table.in_flight;
            rung.run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) rung.run_of(report_out).idle_turns += 1;
        }

        // With an empty table nothing conflicts, so a stall here would mean
        // the record named a domain the document does not.
        if (table.in_flight == 0) return error.OrderStalled;

        try rung.reap_oldest(io, &table, .answered, report_out);
    }
    // invariant: the whole record was taken up, and every dependent reaped
    assert(table.left == 0);
    assert(table.in_flight == 0);
    assert(rung.run_of(report_out).reaped == rung.run_of(report_out).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(table.finished + rung.abandoning_of(report_out).inner.inner.inner.inner.absorbed == table.held);

    var j: u32 = 0;
    while (j < table.finished) : (j += 1) try rung.judge_outcome(table.done[j], report_out);
    // invariant: every reaped dependent was judged, none skipped
    assert(j == table.finished);

    // The reckoning stands exactly as the rung below wrote it, and always on
    // the reckoning ledger: a mend that repaired a plan under the assuming
    // reading would be repairing a loss it had already declared did not count.
    // What this rung adds to it is the recantation, weighed against the
    // judgment already standing on the wire before this run touches it.
    try rung.reckon_the_plan(io, &table, .reckoned, review, report_out);

    // Every run here mends, since the question this rung asks opens inside the
    // repair rather than before it: what separates the two readings is which
    // of the plan's losses the repair is allowed to touch.
    try rung.mend_the_plan(
        allocator, io, self_path, sys, &caps, base, wake, keeping, bearing, standard, review, &table, report_out,
    );

    // The correction the rung below writes, unchanged and still last of the
    // record's own work: a reader is owed the word the run actually ended on
    // rather than the word it held halfway through.
    try rung.post_the_amendment(io, notice, report_out);

    // The journey the rung below makes, unchanged: a correction with somewhere
    // to go is carried to the place its reader was actually reached.
    try rung.carry_the_amendment(io, dispatch, report_out);

    // The hearing the rung below makes, with one word changed: an answer counts
    // as heard only where the hand actually agrees, since an answer a plan
    // cannot accept is not an answer it heard.
    try rung.hear_the_reader(io, receipt, report_out);

    // The record the rung below keeps, unchanged: a reader who answered in a
    // word this plan cannot accept is written down in both voices.
    try rung.record_the_dispute(io, receipt, record, report_out);

    // The escort the rung below writes, unchanged: an operator reading this
    // plan's word reads the objection standing against it in the same reach.
    try rung.escort_the_word(io, escort, report_out);

    // The term the rung below weighs, unchanged: the objection standing beside
    // this plan's word is put back to the reader who raised it, and answered or
    // let go.
    try rung.weigh_the_term(io, term, report_out);

    // The standing the rung below carries into the mark, unchanged: an operator
    // opening the objection reads whether anybody is still behind it.
    try rung.stand_the_mark(io, mark, report_out);

    // The tidings the rung below writes, unchanged: the reader who raised the
    // quarrel is told how it came out, in the box they already know.
    try rung.tell_the_reader(io, tidings, report_out);

    // The appeal the rung below reads, unchanged: the reader who was answered
    // may answer that answering, and the record says where they stand.
    try rung.read_the_appeal(io, appeal, report_out);

    // Every act a run owes the quarrel standing over it, in the order the
    // arc grew.
    try close_the_quarrel(rung, io, taken_up, quarrel, report_out);
}

/// The entry point every rung of this arc shares, lifted here once.
///
/// A supervised program on this ladder answers three asks at its door: run a
/// dependent child when the parent names one, run the self-test when a reader
/// says so, and run the self-test again when a reader says nothing at all. That
/// door stood byte for byte in seventy-nine files, differing across the whole
/// arc by a single qualifier -- whether the dependent body was written in the
/// file or reached through `cohort`. Publishing that body under one name in
/// every rung erases the difference, so one door serves the arc.
///
/// The contract is three symbols standing public on the caller: `run_dependent`
/// for a child the parent named, `run_self_test` for the walk a reader asks
/// for, and `fixed_argv_words` for how many words a dependent invocation
/// carries. Nothing here holds state or knows any caller by name.
pub fn run_main(comptime rung: type, init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= rung.fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return rung.run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return rung.run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return rung.run_self_test(allocator, io, self_path);
}

/// Seats the quarrel's own history on the wire -- the position, its age, the
/// third hand's answer, and any debt an earlier run left standing.
///
/// This body stood byte for byte in seventeen rungs at seventy-two lines
/// apiece, the deepest family the carry meter still named. Every line of it is
/// the harness standing in for the runs that met a quarrel before today: no run
/// of any plan writes its own history, so the writing belongs here, once, rather
/// than in each rung that needs a history seated before it runs.
///
/// The contract is the vocabulary a rung already publishes for its own wire --
/// the eight `clear_` erasures, `seat_forum` and `seat_note`, the referral and
/// finding shapes, `standing_note` and `dwell_note`, and the three names
/// `plan_name`, `standing_forum`, and `standing_settlement`. Nothing here holds
/// state, and the harness never learns a caller by name.
pub fn seat_the_history(comptime rung: type, io: std.Io, stands: ?rung.Plea, stood: u32, answers: ?rung.Finding, owes: ?[rung.max_debt_bytes]u8) bool {
    rung.clear_standing(io);
    // The age clears with the position the harness seats, so each measured run
    // meets a quarrel of a known age rather than one carrying whatever the last
    // lap left on the wire.
    rung.clear_dwell(io);
    // The standing clears too, for the same reason: a herald this lap reads must
    // be one this lap published.
    rung.clear_swell(io);
    // The forum's own box clears with it, so a case this lap reads back is one
    // this lap carried rather than one an earlier lap left standing on a desk.
    rung.clear_case(io, rung.standing_forum);
    // The forum itself is seated by the harness, standing in for the operator
    // who named a third hand before any quarrel existed. No run writes it.
    rung.seat_forum(io, rung.standing_forum) catch |err| {
        print("  RED: a forum could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    // The plan's own published finding clears with everything else, so a verdict
    // this lap reads is one this lap's own run published.
    rung.clear_deem(io);
    // And the plan's own word on it clears too, for the same reason: an avowal
    // this lap reads back must be one this lap's own run actually said.
    rung.clear_avow(io);
    // And the debt that word may leave clears with it, so a concession a later
    // run would find standing is one this lap's own run actually booked.
    rung.clear_owe(io);
    // The receipt for a debt met clears too, so a meeting this lap reads back is
    // one this lap's own run actually made.
    rung.clear_met(io);
    // And the word about what that meeting found, for the same reason: a finding
    // this lap reads back is one this lap's own run reached.
    rung.clear_redress(io);
    // And then, where this lap wants one, the debt an earlier run booked is
    // seated exactly as that run would have left it -- by the harness, standing
    // in for the run before today. No supervisor writes its own inheritance.
    if (owes) |owed| {
        rung.seat_note(io, rung.plan_name, ".owe", &owed) catch |err| {
            print("  RED: an earlier run's debt could not be seated: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    // The third hand's own answer, written in their hand rather than by any run.
    // A desk that has said nothing yet is seated as exactly that: an empty box.
    rung.clear_finding(io, rung.standing_forum);
    if (answers) |finding| {
        // The case a third hand answers is the case this plan carries every run
        // -- the same word, the same standing, the same age -- so the answer they
        // wrote on a previous lap is honestly an answer to this one.
        const case = rung.referral_bytes(rung.standing_settlement, .loud, stood + 1);
        rung.answer_as_forum(io, rung.standing_forum, rung.finding_bytes(case, finding)) catch |err| {
            print("  RED: a third hand could not answer in their own hand: {s}\n", .{@errorName(err)});
            return false;
        };
    }
    if (stands) |plea| {
        rung.standing_note(io, plea) catch |err| {
            print("  RED: an earlier run's position could not be seated: {s}\n", .{@errorName(err)});
            return false;
        };
        // The runs this position already stood through, seated as the record
        // they are. No run of this plan writes its own history; the harness
        // stands in for the runs that met this quarrel before today.
        if (stood >= 1) {
            rung.dwell_note(io, stood) catch |err| {
                print("  RED: a quarrel's own history could not be seated: {s}\n", .{@errorName(err)});
                return false;
            };
        }
    }
    return true;
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
///
/// This body stood byte for byte in forty-three rungs at twenty-one lines
/// apiece. Every rung seats its ground the same way because the seating is the
/// ladder's own contract rather than any rung's own idea: the order is what is
/// being promised -- stores, then bells, then notes, then the derived table --
/// and a rung that reordered it would be a different ladder.
///
/// The contract is four symbols every rung already publishes: `Report` and
/// `NoteError` for the shapes, `run_of` for the reading, and `provision_notes`
/// for the one step a rung performs over its own directory. The harness reaches
/// `exercise`, `roundtrip`, `roster`, `notify`, and `capabilities` through its
/// own imports, since all five are the ladder's shared modules rather than
/// anything a rung owns.
pub fn seat_the_ground(
    comptime rung: type,
    io: std.Io,
    sys: *const system.System,
    report_out: *rung.Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || rung.NoteError)!capabilities.CapabilityTable {
    // invariant: a run always seats a declaration that names regions
    assert(sys.map.region_count >= 1);
    // invariant: a run always seats a declaration that names domains
    assert(sys.graph.domain_count >= 1);
    const provisioned = try exercise.provision(io, sys);
    // invariant: every declared region has a backing store before any dependent runs
    assert(provisioned == sys.map.region_count);
    rung.run_of(report_out).bells = try roundtrip.provision_directed(io, sys);
    const noted = try rung.provision_notes(io, sys);
    // invariant: every declared domain has its notes before any conferral
    assert(noted == sys.graph.domain_count);
    const caps = try roster.from_system(sys);
    // invariant: the derived table enforces exactly what the document permits
    assert(roster.agrees(sys, &caps));
    return caps;
}

/// Seats a plan's phases into the table a run reads from -- the record's own
/// door, and the one place a plan becomes a run's ordered ground.
///
/// This body stood byte for byte in thirty-seven rungs at thirty lines apiece,
/// the widest family the carry meter named after the front door left it. Every
/// rung seats its record the same way because the seating is the ladder's own
/// contract rather than any rung's own idea: read each phase plainly, refuse a
/// plan whose order stalls or whose seats are unfilled, close the record, and
/// carry each phase's reserve and bearing into the table exactly once.
///
/// The contract is the vocabulary a rung already publishes: `Phase`, `Table`,
/// and `RunError` for the shapes, `max_queue_len` for the bound, and `plain`,
/// `plan_is_seated`, `phase_bit`, and `standing` for the four readings. The
/// harness reaches `precede` and `unhand` through its own imports, since both
/// are the ladder's shared modules rather than anything a rung owns.
pub fn seat_the_record(comptime rung: type, base: []const rung.Phase, table: *rung.Table) rung.RunError!void {
    // invariant: a record always seats a plan that names phases
    assert(base.len >= 1);
    // invariant: a record is always seated into a table that holds nothing yet
    assert(table.held == 0);
    var plainly: [rung.max_queue_len]unhand.Phase = undefined;
    var p: u32 = 0;
    while (p < base.len) : (p += 1) plainly[p] = rung.plain(base[p]);
    // invariant: every phase was read plainly, none skipped
    assert(p == base.len);
    const flat = plainly[0..base.len];
    if (!precede.plan_is_ordered(flat)) return error.OrderStalled;
    if (!rung.plan_is_seated(flat)) return error.PlanUnseated;

    precede.close(flat, table.record[0..base.len]);
    table.held = @intCast(base.len);
    table.left = table.held;
    var r: u32 = 0;
    while (r < base.len) : (r += 1) {
        table.reserve_of[r] = base[r].reserve;
        // The bearing is read once, here, from the record its author wrote --
        // so every later question about which losses to carry is answered from
        // the plan rather than from anything the run learns along the way.
        if (base[r].bear) table.bear_mask |= rung.phase_bit(r);
    }
    // invariant: every phase carried its reserve into the record, none lost
    assert(r == base.len);
    // invariant: a closed record closes to itself, so the door's work is done
    assert(precede.plan_is_closed(rung.standing(table)));
}

/// Reads the finding a third hand wrote back, and publishes it as the run's own
/// answer -- the last step of a referral, where a case that travelled comes home
/// weighed or comes home unanswered.
///
/// This body stood byte for byte in twenty rungs at fifty-five lines apiece.
/// Its whole shape is a boundary: the wire before the memory. The forum comes
/// off the wire rather than out of anything the run remembered, the case is
/// rebuilt from the same three facts the referring copied, and the note an
/// operator opens is read back before the report believes the finding arrived.
/// A boundary written twenty times is a boundary twenty files may drift across;
/// written once, it holds for every rung that calls it.
///
/// The contract is the vocabulary every rung already publishes -- `Deem`,
/// `Report`, `RunError`, and `NoteError` for the shapes, the two bounds
/// `max_address_len` and `max_referral_bytes`, and the readings from
/// `refer_of` through `deem_published`. Nothing here holds state, and no rung
/// widened a declaration to make this fold possible.
pub fn read_the_finding(comptime rung: type, io: std.Io, deem: rung.Deem, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const sent_count = rung.refer_of(report_out).referred;
    if (sent_count == 0) {
        // invariant: a run that carried no case reads no finding
        assert(rung.deem_of(report_out).answered == 0);
        // invariant: a run that carried no case leaves none unanswered
        assert(rung.deem_of(report_out).unanswered == 0);
        return;
    }

    // The measurement this rung moves, weighed against the case actually carried
    // rather than against anything the plan asked for, so a referral nobody
    // answers is counted rather than refused.
    rung.deem_of(report_out).unanswered = rung.unanswered_referrals(sent_count, deem);
    const heard_count = rung.answered_in(sent_count, deem);
    const waiting_count = rung.awaiting_in(sent_count, deem);
    if (deem == .unread) {
        // invariant: an unread run publishes no finding, however long one stood
        assert(heard_count == 0);
        rung.deem_of(report_out).awaited_in = waiting_count;
        return;
    }

    // The forum comes off the wire once more, since the desk a finding is read
    // from is the desk the case went to and never one a run picked afterward.
    var forum_buf: [rung.max_address_len]u8 = @splat(0);
    const named = rung.forum_published(io, &forum_buf) orelse return error.DeemSilent;
    const settled = rung.settlement_published(io) orelse return error.DeemUnreferred;
    const age = rung.dwell_published(io) orelse 0;
    // The case is rebuilt from the same three facts the referring copied, so a
    // finding is weighed against the argument that actually travelled. A run
    // that carried nothing out has no case to build, and says so with a null
    // rather than by asserting its way into one.
    const volume = rung.stands_loud(age);
    const case: ?[rung.max_referral_bytes]u8 = if (sent_count >= 1 and volume == .loud)
        rung.referral_bytes(settled, volume, age)
    else
        null;
    const seen = rung.finding_written(io, named);
    const spoken = seen != null;
    const matched = if (case) |sent| rung.finding_answers(seen, sent) else false;
    if (rung.deem_refusal(sent_count, heard_count, waiting_count, spoken, matched)) |why| return why;
    const found = rung.finding_in(seen) orelse return error.DeemSilent;

    // invariant: a reading run publishes the one finding its own case earned
    assert(heard_count == 1);
    try rung.deem_note(io, found);
    // The wire before the memory, once more: the note an operator opens is read
    // back, and only then does the report believe the finding arrived.
    if (!rung.deem_holds(rung.deem_published(io), found)) return error.DeemMisrecorded;
    rung.deem_of(report_out).answered = heard_count;
    rung.deem_of(report_out).awaited_in = waiting_count;
    // invariant: a reading run leaves no carried case unanswered
    assert(rung.deem_of(report_out).unanswered == 0);
}

/// Books the debt a run's own concession earned, and records it where a later
/// run will read it -- the step where an admission stops being a word and
/// becomes a number somebody is answerable for.
///
/// This body stood byte for byte in eighteen rungs at fifty-four lines apiece.
/// Its shape is the ladder's own accounting: nothing is booked that was never
/// conceded, a free run books nothing however plainly it conceded, and every
/// refusal below the concession is reached by argument rather than by an early
/// return -- so the reads supply the ladder rather than short-circuiting it.
/// The wire before the memory holds here too: the note a later run will open is
/// read back before this report believes the debt stands.
///
/// The contract is the vocabulary every rung already publishes -- `Owe`,
/// `Report`, `RunError`, and `NoteError` for the shapes, the bound
/// `max_debt_bytes`, and the readings from `avow_written` through
/// `debt_standing`. All nineteen already stood public in all eighteen rungs, so
/// this fold widened no declaration anywhere on the ladder.
///
/// `owe.rye`, the rung that owns this measure, keeps its own body: its report
/// *is* the owe report, so it writes each field directly where every rung above
/// it reaches through `owe_of`. That is meaning rather than drift, and it stays.
pub fn book_the_debt(comptime rung: type, io: std.Io, owe: rung.Owe, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const spoken = rung.avow_written(io);
    const stance = rung.stance_in(spoken);
    const conceded_count: u32 = if (stance == .concedes) 1 else 0;
    if (conceded_count == 0) {
        // invariant: a run that conceded nothing books no debt against itself
        assert(rung.owe_of(report_out).booked == 0);
        // invariant: a run that conceded nothing leaves no concession unbooked
        assert(rung.owe_of(report_out).unbooked == 0);
        return;
    }

    // The measurement this rung moves, weighed against the concession actually
    // made rather than against anything the plan asked for, so an admission
    // nobody carries is counted rather than refused.
    rung.owe_of(report_out).unbooked = rung.unbooked_concessions(conceded_count, owe);
    const booked_count = rung.booked_in(conceded_count, owe);
    const unowed_count = rung.unowed_in(conceded_count, owe);
    if (owe == .free) {
        // invariant: a free run books no debt, however plainly it conceded
        assert(booked_count == 0);
        rung.owe_of(report_out).unowed = unowed_count;
        return;
    }

    // The finding and the outcome both come off the wire, since the concession a
    // debt carries is the one standing published and never one a run remembered.
    // The reads supply the ladder rather than short-circuiting it, so every
    // refusal below is reached by argument and named in its own order.
    const found = rung.deem_published(io);
    const under = rung.settlement_published(io);
    const said = spoken != null;
    const conceded = stance == .concedes;
    const debt: ?[rung.max_debt_bytes]u8 = if (found) |verdict| blk: {
        const outcome = under orelse break :blk null;
        break :blk rung.debt_bytes(verdict, outcome);
    } else null;
    const matched = if (found) |verdict| rung.debt_answers(debt, verdict) else false;
    if (rung.owe_refusal(conceded_count, booked_count, unowed_count, said, conceded, matched)) |why| return why;
    const verdict = found orelse return error.OweMismatched;
    const outcome = under orelse return error.OweMismatched;
    const owed = debt orelse return error.OweMismatched;

    // invariant: an owing run books the one debt its own concession earned
    assert(booked_count == 1);
    try rung.owe_note(io, verdict, outcome);
    // The wire before the memory, once more: the note a later run will open is
    // read back, and only then does the report believe the debt actually stands.
    if (!rung.debt_holds(rung.debt_standing(io), owed)) return error.OweMisrecorded;
    rung.owe_of(report_out).booked = booked_count;
    rung.owe_of(report_out).unowed = unowed_count;
    // invariant: an owing run leaves no concession of its own unbooked
    assert(rung.owe_of(report_out).unbooked == 0);
}

pub fn say_the_word(comptime rung: type, io: std.Io, avow: rung.Avow, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const heard_count = rung.deem_of(report_out).answered;
    if (heard_count == 0) {
        // invariant: a run that read no finding says no word about one
        assert(rung.avow_of(report_out).said == 0);
        // invariant: a run that read no finding leaves none unanswered
        assert(rung.avow_of(report_out).unavowed == 0);
        return;
    }

    // The measurement this rung moves, weighed against the finding actually
    // read rather than against anything the plan asked for, so a verdict nobody
    // answers is counted rather than refused.
    rung.avow_of(report_out).unavowed = rung.unavowed_findings(heard_count, avow);
    const said_count = rung.said_in(heard_count, avow);
    const withheld_count = rung.withheld_in(heard_count, avow);
    if (avow == .mute) {
        // invariant: a mute run publishes no word, however plainly one stood
        assert(said_count == 0);
        rung.avow_of(report_out).withheld = withheld_count;
        return;
    }

    // The finding comes off the wire once more, since the verdict a plan
    // answers is the verdict standing published and never one a run remembered.
    // The read supplies the ladder rather than short-circuiting it, so every
    // refusal below is reached by argument and named in its own order.
    const found = rung.deem_published(io);
    const published = found != null;
    const word: ?[rung.max_avowal_bytes]u8 = if (found) |verdict| rung.avowal_bytes(verdict, avow) else null;
    const matched = if (found) |verdict| rung.avowal_answers(word, verdict) else false;
    if (rung.avow_refusal(heard_count, said_count, withheld_count, published, matched)) |why| return why;
    const verdict = found orelse return error.AvowUnfound;
    const said = word orelse return error.AvowUnfound;

    // invariant: an avowing run publishes the one word its own finding earned
    assert(said_count == 1);
    try rung.avow_note(io, verdict, avow);
    // The wire before the memory, once more: the note an operator opens is read
    // back, and only then does the report believe the plan actually spoke.
    if (!rung.avow_holds(rung.avow_written(io), said)) return error.AvowMisrecorded;
    rung.avow_of(report_out).said = said_count;
    rung.avow_of(report_out).withheld = withheld_count;
    // invariant: an avowing run leaves no read finding unanswered
    assert(rung.avow_of(report_out).unavowed == 0);
}

pub fn meet_the_debt(comptime rung: type, io: std.Io, meet: rung.Meet, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const on_wire = rung.debt_standing(io);
    const inherited_count: u32 = if (on_wire != null) 1 else 0;
    if (inherited_count == 0) {
        // invariant: a run inheriting no debt meets none
        assert(rung.meet_of(report_out).met == 0);
        // invariant: a run inheriting no debt leaves none unmet
        assert(rung.meet_of(report_out).unmet == 0);
        return;
    }

    // The measurement this rung moves, weighed against the debt actually
    // inherited rather than against anything the plan asked for, so an
    // admission nobody looks at is counted rather than refused.
    rung.meet_of(report_out).unmet = rung.unmet_debts(inherited_count, meet);
    const met_count = rung.met_in(inherited_count, meet);
    const deferred_count = rung.deferred_in(inherited_count, meet);
    if (meet == .defers) {
        // invariant: a deferring run meets no debt, however plainly one stood
        assert(met_count == 0);
        rung.meet_of(report_out).deferred = deferred_count;
        return;
    }

    // The debt comes off the wire, since the admission a meeting answers is the
    // one standing published and never one a run remembered. The reads supply
    // the ladder rather than short-circuiting it, so every refusal below is
    // reached by argument and named in its own order.
    const owed = on_wire orelse return error.MeetUnowed;
    const stood = true;
    const settled = rung.settlement_published(io) != null;
    const receipt = rung.met_bytes(owed);
    const matched = rung.met_answers(receipt, owed);
    if (rung.meet_refusal(inherited_count, met_count, deferred_count, stood, settled, matched)) |why| return why;

    // invariant: a meeting run meets the one debt it opened holding
    assert(met_count == 1);
    try rung.met_note(io, owed);
    // The receipt before the taking down, so a run that falls between the two
    // acts leaves a question still open rather than an admission quietly gone.
    if (!rung.met_holds(rung.meeting_written(io), receipt)) return error.MeetMisrecorded;
    rung.clear_owe(io);
    // The wire before the memory, once more: the debt is read back down before
    // the report believes the admission was actually answered.
    if (!rung.debt_settled(rung.debt_standing(io))) return error.MeetMisrecorded;
    rung.meet_of(report_out).met = met_count;
    rung.meet_of(report_out).deferred = deferred_count;
    // invariant: a meeting run leaves no inherited debt unmet
    assert(rung.meet_of(report_out).unmet == 0);
}

/// Tells the raiser of a finding that the finding was reached.
///
/// Fifteen rungs held this body byte for byte, and a sixteenth wrote its own:
/// `apprise.rye` is the rung where the apprise report *is* the report, so it
/// names `report_out.apprised` directly where the fifteen above it reach through
/// `apprise_of(report_out)`. That one difference is the whole difference, and it
/// keeps `apprise.rye` home rather than shrinking it to a stub.
///
/// The wire before the memory, exactly as the rungs beneath it: this run reads
/// the finding actually standing rather than remembering one, reads the address
/// out of the note that names it, writes the same three bytes into that reader's
/// own box, and reads the box back before the report believes anybody was told.
/// Lifted here, one body serves all fifteen, and each rung reaches its own
/// helpers, its own report shape, and its own error set through the type it
/// hands in.
///
/// Every symbol this body reaches already stood public in all fifteen, so the
/// lift widens nothing. Measured rather than read: `REACH_OK
/// family=apprise_the_raiser folding=15 widens=0 stub=3 fall=658` from
/// `../tools/fixtures/ladder_reach_visibility_scan.sh`.
pub fn apprise_the_raiser(comptime rung: type, io: std.Io, apprise: rung.Apprise, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const finding = rung.redress_written(io);
    const redressed_count: u32 = if (finding != null) 1 else 0;
    if (redressed_count == 0) {
        // invariant: a run that reached no finding carries none
        assert(rung.apprise_of(report_out).apprised == 0);
        // invariant: a run that reached no finding leaves no raiser unheard
        assert(rung.apprise_of(report_out).unheard == 0);
        return;
    }

    // The measurement this rung moves, weighed against the finding actually
    // written rather than against anything the plan asked for, so a raiser left
    // in the dark is counted rather than refused.
    rung.apprise_of(report_out).unheard = rung.unheard_findings(redressed_count, apprise);
    const apprised_count = rung.apprised_in(redressed_count, apprise);
    const withheld_count = rung.unsent_in(redressed_count, apprise);
    if (apprise == .withheld) {
        // invariant: a withholding run tells nobody, however plainly it reached
        // a finding of its own
        assert(apprised_count == 0);
        rung.apprise_of(report_out).withheld = withheld_count;
        return;
    }

    // The finding comes off the wire, since what a reader is owed is the answer
    // the plan actually reached and never one a run remembered. The reads supply
    // the ladder rather than short-circuiting it, so every refusal below is
    // reached by argument and named in its own order.
    const carried = finding orelse return error.AppriseUnfound;
    const found = true;
    var address_buf: [rung.max_address_len]u8 = undefined;
    const address = rung.address_published(io, &address_buf);
    const addressed = address != null;
    const delivery = rung.found_bytes(carried);
    const matched = rung.found_answers(delivery, carried);
    if (rung.apprise_refusal(redressed_count, apprised_count, withheld_count, found, addressed, matched)) |why| return why;

    // invariant: an apprising run carries the one finding it reached
    assert(apprised_count == 1);
    const box = address orelse return error.AppriseUnaddressed;
    try rung.apprise_note(io, box, delivery);
    // The wire before the memory, once more: the finding is read back out of the
    // reader's own box before the report believes anybody was ever told.
    if (!rung.apprise_holds(rung.apprised_of(io, box), delivery)) return error.AppriseMisrecorded;
    rung.apprise_of(report_out).apprised = apprised_count;
    rung.apprise_of(report_out).withheld = withheld_count;
    // invariant: an apprising run leaves no raiser of its own unheard
    assert(rung.apprise_of(report_out).unheard == 0);
}

pub fn redress_the_meeting(comptime rung: type, io: std.Io, redress: rung.Redress, upshot: rung.Upshot, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    const receipt = rung.meeting_written(io);
    const met_count: u32 = if (receipt != null) 1 else 0;
    if (met_count == 0) {
        // invariant: a run that met no debt redresses none
        assert(rung.redress_of(report_out).redressed == 0);
        // invariant: a run that met no debt leaves no meeting hollow
        assert(rung.redress_of(report_out).hollow == 0);
        return;
    }

    // The measurement this rung moves, weighed against the meeting actually
    // made rather than against anything the plan asked for, so a look nobody
    // reports on is counted rather than refused.
    rung.redress_of(report_out).hollow = rung.hollow_meetings(met_count, redress);
    const redressed_count = rung.redressed_in(met_count, redress);
    const bare_count = rung.closed_bare_in(met_count, redress);
    if (redress == .hollow) {
        // invariant: a hollow run says nothing, however plainly it met a debt
        assert(redressed_count == 0);
        rung.redress_of(report_out).bare = bare_count;
        return;
    }

    // The meeting comes off the wire, since the look a redress reports on is the
    // one standing receipted and never one a run remembered. The reads supply
    // the ladder rather than short-circuiting it, so every refusal below is
    // reached by argument and named in its own order.
    const met = receipt orelse return error.RedressUnmet;
    const receipted = true;
    const earned = rung.upshot_earned(upshot, rung.settlement_published(io));
    const expected = rung.redress_bytes(met, upshot);
    const matched = rung.redress_answers(expected, met);
    if (rung.redress_refusal(met_count, redressed_count, bare_count, receipted, earned, matched)) |why| return why;

    // invariant: a redressing run speaks about the one meeting it made
    assert(redressed_count == 1);
    try rung.redress_note(io, met, upshot);
    // The wire before the memory, once more: the finding is read back out of the
    // plan's own notes before the report believes the look was ever reported on.
    if (!rung.redress_holds(rung.redress_written(io), expected)) return error.RedressMisrecorded;
    rung.redress_of(report_out).redressed = redressed_count;
    rung.redress_of(report_out).bare = bare_count;
    // invariant: a redressing run leaves no meeting of its own hollow
    assert(rung.redress_of(report_out).hollow == 0);
}

pub fn lost_published(comptime rung: type, io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= rung.max_queue_len);
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".lost") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [rung.max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: a loss note never outgrows the record it describes
    assert(got <= rung.max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'x') found |= rung.phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

pub fn press_path(comptime rung: type, buf: *[rung.max_note_path_len]u8, address: []const u8) rung.NoteError![]const u8 {
    // invariant: a reply is only ever read for an address a run may carry to
    assert(rung.addressable(address));
    const suffix = ".press";
    // invariant: a reply is left in the same box the answer was left in
    comptime assert(suffix.len == ".again".len);
    const total = rung.reader_dir.len + 1 + address.len + suffix.len;
    if (total > rung.max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (rung.reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a reply path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

pub fn bearing_published(comptime rung: type, io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= rung.max_queue_len);
    var path_buf: [rung.max_note_path_len]u8 = undefined;
    const path = rung.note_path(&path_buf, rung.plan_name, ".bearing") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [rung.max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: a bearing note never outgrows the record it describes
    assert(got <= rung.max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'b') found |= rung.phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

