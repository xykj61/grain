    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'r') found |= rung.phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(comptime rung: type, io: std.Io, domain: []const u8, depth: u32) bool {
    // invariant: a confirmation always names the dependent it waits on
    assert(domain.len >= 1);
    // invariant: a confirmation always waits on reach actually handed over
    assert(depth >= 1);
    var looks: u32 = 0;
    while (looks < rung.max_confirm_looks) : (looks += 1) {
        const answered = rung.read_count(io, domain, ".held") catch return false;
        if (answered >= depth) return true;
        std.Io.sleep(io, std.Io.Duration.fromMilliseconds(rung.note_rest_ms), .awake) catch {};
    }
    // invariant: the confirmation stayed inside the bound it was given
    assert(looks == rung.max_confirm_looks);
    return false;
}

/// Weighs the answer this run carried against the word its reader wrote back.
///
/// Fourteen rungs held this body byte for byte, and a fifteenth wrote its own:
/// `suffice.rye` is the rung where the suffice report *is* the report, so it
/// names `report_out.weighed` directly where the fourteen above it reach through
/// `suffice_of(report_out)`. That one difference is the whole difference, and it
/// keeps `suffice.rye` home rather than shrinking it to a stub.
///
/// The wire before the memory, exactly as the rungs beneath it: this run reads
/// the address actually published, reads the answer carried to that box, reads
/// the reader's own word off the wire rather than supposing one, writes the
/// verdict into the plan's note, and reads that note back before the report
/// believes anybody was ever asked. Lifted here, one body serves all fourteen,
/// and each rung reaches its own helpers, its own report shape, and its own
/// error set through the type it hands in.
///
/// Every symbol this body reaches already stood public in all fourteen, so the
/// lift widens nothing. Measured rather than read: `REACH_OK
/// family=weigh_the_answer folding=14 widens=0 stub=3 fall=624` from
/// `../tools/fixtures/ladder_reach_visibility_scan.sh`.
pub fn weigh_the_answer(comptime rung: type, io: std.Io, suffice: rung.Suffice, report_out: *rung.Report) (rung.RunError || rung.NoteError)!void {
    var address_buf: [rung.max_address_len]u8 = undefined;
    const address = rung.address_published(io, &address_buf);
    const carried = if (address) |box| rung.apprised_of(io, box) else null;
    const apprised_count: u32 = if (carried != null) 1 else 0;
    if (apprised_count == 0) {
        // invariant: a run that told nobody weighs nothing
        assert(rung.suffice_of(report_out).weighed == 0);
        // invariant: a run that told nobody leaves no answer unmeasured
        assert(rung.suffice_of(report_out).unmeasured == 0);
        return;
    }

    // The measurement this rung moves, weighed against the delivery actually
    // standing rather than against anything the plan asked for, so an answer
    // nobody was ever asked about is counted rather than refused.
    rung.suffice_of(report_out).unmeasured = rung.unmeasured_answers(apprised_count, suffice);
    const weighed_count = rung.weighed_in(apprised_count, suffice);
    const unweighed_count = rung.unasked_in(apprised_count, suffice);
    if (suffice == .unasked) {
        // invariant: an unasking run reads nobody's word, however plainly it
        // carried an answer of its own
        assert(weighed_count == 0);
        rung.suffice_of(report_out).unweighed = unweighed_count;
        return;
    }

    // The reader's own word comes off the wire, since what an operator is owed
    // is the verdict that reader actually wrote and never one a run supposed.
    // The reads supply the ladder rather than short-circuiting it, so every
    // refusal below is reached by argument and named in its own order.
    const delivery = carried orelse return error.SufficeUntold;
    const told = true;
    const box = address orelse return error.SufficeUntold;
    const spoken_word = rung.worth_written(io, box);
    const spoken = spoken_word != null;
    const matched = rung.suits_answers(spoken_word, delivery);
    if (rung.suffice_refusal(apprised_count, weighed_count, unweighed_count, told, spoken, matched)) |why| return why;

    // invariant: a weighing run reads the one word its own answer earned
    assert(weighed_count == 1);
    const worth = rung.suits_worth(spoken_word) orelse return error.SufficeSilent;
    try rung.suffice_note(io, worth);
    // The wire before the memory, once more: the word is read back out of the
    // plan's own note before the report believes anybody was ever asked.
    if (!rung.suffice_holds(rung.worth_published(io), worth)) return error.SufficeMisrecorded;
    rung.suffice_of(report_out).weighed = weighed_count;
    rung.suffice_of(report_out).unweighed = unweighed_count;
    // invariant: a weighing run leaves no answer of its own unmeasured
    assert(rung.suffice_of(report_out).unmeasured == 0);
}

/// Waits, bounded, until this dependent's prune has been counted.
///
/// All forty-four rungs that declare this wrote the same body byte for byte,
/// so this is the first family of the arc with no rung staying home. Six
/// families before it split on a single qualifier and each split turned out to
/// carry meaning; this one simply says the same thing forty-four times.
///
/// The shape is the bounded wait the ladder uses everywhere: look at most
/// `max_confirm_looks` times, rest `note_rest_ms` between looks, and answer
/// false rather than waiting forever. Lifted here, one body serves all
/// forty-four, and each rung reaches its own bound, its own reader, and its own
/// rest through the type it hands in.
///
/// The body reaches three symbols and every one already stood public in all
/// forty-four, so the lift widens nothing. Measured rather than read: `REACH_OK
/// family=confirm_pruned folding=44 widens=0 stub=3 fall=516` from
/// `../tools/fixtures/ladder_reach_visibility_scan.sh`.
pub fn confirm_pruned(comptime rung: type, io: std.Io, domain: []const u8, count: u32) bool {
    // invariant: a confirmation always names the dependent it waits on
    assert(domain.len >= 1);
    // invariant: a confirmation always waits on reach actually taken back
    assert(count >= 1);
    var looks: u32 = 0;
    while (looks < rung.max_confirm_looks) : (looks += 1) {
        const answered = rung.read_count(io, domain, ".pruned") catch return false;
        if (answered >= count) return true;
        std.Io.sleep(io, std.Io.Duration.fromMilliseconds(rung.note_rest_ms), .awake) catch {};
    }
    // invariant: the confirmation stayed inside the bound it was given
    assert(looks == rung.max_confirm_looks);
    return false;
}
