//! Caravan dispute -- a reader who answers something other than agreement is
//! recorded, rather than set aside in silence.
//!
//! `hear.rye` taught a run to read what its reader answered back: the letter
//! carried into the reader's own box, the reader's own hand read out of the box
//! beside it, and an answer bound to the reading it answers, so a hand naming
//! any other reading never counts as agreement. That binding is exactly right,
//! and it is where the listening stops.
//!
//! **A reader who disagrees is heard and then dropped.** Below this rung a hand
//! naming a different reading earns `HearMisheard` and nothing else: honest
//! about what it refuses, and entirely silent about what that reader actually
//! meant. The person answered in their own word, the plan declined to call it
//! agreement, and the record kept no trace that anybody ever disagreed.
//!
//! **The measurement is answers set aside without a record.** The rung below
//! weighs a correction against the hand that answered it. This one weighs the
//! record against the answers that hand gave and the plan threw away -- a
//! reader who wrote back plainly, in a word the plan could not accept, into a
//! record that now reads as though the correspondence had closed.
//!
//! **A dispute names both readings, and resolves neither.** The wire carries
//! two bytes: the reading this run stands behind, and the reading its reader
//! holds. A run writes the pair and stops there, because a supervisor that
//! settled the disagreement in its own favor would be recording a quarrel and
//! calling it a verdict.
//!
//! **A plan publishes whether its record may hold a disagreement.** A record
//! written `standing = .open` says: an answer this run cannot accept is kept in
//! both voices. `standing = .settled` is where the rung below leaves it -- the
//! answer is set aside, counted nowhere, and the record reads as one voice. The
//! word sits at the plan beside the receipt, since it instructs about what a
//! record may hold rather than about any one phase.
//!
//! **A dispute is bounded by the answer that earned it.** Only a hand this run
//! actually read may be disputed, and every answered hand is agreed or disputed
//! -- never both and never neither. A run that recorded a disagreement with a
//! reader who never wrote is quarrelling with itself.
//!
//! **The rung earns four refusals, and each is about the record rather than the
//! answer that earned it.** `DisputeEarly` is the moment: a run recording a
//! disagreement before it has read any hand is writing from memory of an answer
//! nobody gave. `DisputeUnheard` is the supply: a box holding no hand disputes
//! nothing. `DisputeMiscounted` is the honesty of the count: every answered
//! hand is agreed or disputed, and never two of those and never none.
//! `DisputeUnfounded` is the record -- the hard half -- since a pair naming one
//! reading twice is agreement wearing a quarrel's clothes, and a record built on
//! it would manufacture a disagreement nobody ever had.
//!
//! **A plan the wire holds no reading about reads as the rung below.** With no
//! standing reading, no amendment is posted, nothing is carried, nothing is
//! heard, nothing is disputed, each line stands at the width it was handed, and
//! the door answers `unhand.admissible_held` pair for pair -- this arc's
//! standing generalization test, one tier further out.
//!
//! Usage:
//!   dispute            Run the self-test (default)
//!   dispute selftest   Same as default
//!   dispute dependent ...  Run as one supervised dependent (spawned by the run)

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const system = @import("system.rye");
const capabilities = @import("capabilities.rye");
const roster = @import("roster.rye");
const read = @import("read.rye");
const boot = @import("boot.rye");
const exercise = @import("exercise.rye");
const carry = @import("carry.rye");
const notify = @import("notify.rye");
const roundtrip = @import("roundtrip.rye");
const cycle = @import("cycle.rye");
const regions = @import("regions.rye");
pub const queue_store = @import("queue.rye");
pub const serve = @import("serve.rye");
const gap = @import("gap.rye");
const cohort = @import("cohort.rye");
const intent = @import("intent.rye");
const mask = @import("mask.rye");
const precede = @import("precede.rye");
const overtake = @import("overtake.rye");
const unhand = @import("unhand.rye");
const entrust = @import("entrust.rye");
const confer = @import("confer.rye");
pub const revoke_rung = @import("revoke.rye");
const reclaim_rung = @import("reclaim.rye");
const abandon_rung = @import("abandon.rye");
const bearing_rung = @import("bear.rye");
const couriering_rung = @import("courier.rye");
const hearing_rung = @import("hear.rye");
const amending_rung = @import("amend.rye");
const recanting_rung = @import("recant.rye");
const appraising_rung = @import("appraise.rye");
const mending_rung = @import("mend.rye");
const tally_parse_int = @import("parse_int.rye");
const ladder_checks = @import("ladder_checks.rye");

const Dir = std.Io.Dir;

const caravan_dispute_version = "20260820.054833";

// =========================================================================
// The bounds -- carried whole from the rung below, with the reclaiming's own
// =========================================================================

/// The declaration this rung runs over, unchanged.
pub const declaration_path = hearing_rung.declaration_path;

/// How many dependents one supervisor holds at once.
pub const max_in_flight: u32 = hearing_rung.max_in_flight;

/// How many phases one record may hold.
pub const max_queue_len: u32 = hearing_rung.max_queue_len;

/// How far past a blocked head a run may look for a phase that may pass.
pub const max_lookahead: u32 = hearing_rung.max_lookahead;

/// How many words a dependent receives before its capability words begin.
pub const fixed_argv_words: u32 = hearing_rung.fixed_argv_words;

/// How many turns one plan may name.
pub const max_turns: u32 = hearing_rung.max_turns;

/// Where the reckoning notes live, kept apart from every other rung's.
pub const note_dir = "caravan/.disputes";

/// Where a reader's own box lives, outside this plan's wire entirely.
///
/// The whole point of the rung, written as a path. Every note of this arc so
/// far has landed under `note_dir`, where a reader must come looking; a
/// delivery lands here instead, so the first outward reach of the arc is
/// visible as a record leaving the place records are kept.
pub const reader_dir = "caravan/.readers";

/// The longest address a reader may leave, in bytes.
///
/// Bounded like every other word this wire carries: an address is a short
/// name for a place a person is, never a path a run could be talked into
/// walking somewhere unintended.
pub const max_address_len: u32 = 16;

/// The longest note path this rung ever writes.
pub const max_note_path_len: u32 = hearing_rung.max_note_path_len;

/// The longest capability word this wire carries, from the spawn's own bound.
pub const max_word_bytes: u32 = hearing_rung.max_word_bytes;

/// The longest word list one dependent is ever handed, one word per line.
pub const max_words_bytes: u32 = hearing_rung.max_words_bytes;

/// How long a look rests before looking again.
pub const note_rest_ms: u32 = hearing_rung.note_rest_ms;

/// How many times a supervisor looks for a dependent's answer before refusing.
pub const max_confirm_looks: u32 = hearing_rung.max_confirm_looks;

/// How many times a dependent looks for more reach before it comes home.
pub const max_patience_looks: u32 = hearing_rung.max_patience_looks;

/// How many times a dependent looks for a pruning before it comes home.
pub const max_prune_looks: u32 = hearing_rung.max_prune_looks;

comptime {
    // invariant: a run always has a slot to remember a live dependent's line by
    assert(max_in_flight >= 1);
    // invariant: an abandoned word list still fits the wire that carries it
    assert(max_words_bytes >= max_word_bytes + 1);
    // invariant: a note path leaves room for the directory and a name
    assert(max_note_path_len > note_dir.len + regions.max_name_len);
    // invariant: this rung's notes never collide with the amending notes
    assert(!std.mem.eql(u8, note_dir, hearing_rung.note_dir));
    // invariant: this rung's notes never collide with the recanting notes
    assert(!std.mem.eql(u8, note_dir, recanting_rung.note_dir));
    // invariant: a delivery always leaves the place this plan keeps its records
    assert(!std.mem.eql(u8, note_dir, reader_dir));
    // invariant: a reader's box path leaves room for the address it is named by
    assert(max_note_path_len > reader_dir.len + max_address_len);
    // invariant: this rung's notes never collide with the appraising notes
    assert(!std.mem.eql(u8, note_dir, appraising_rung.note_dir));
    // invariant: this rung's notes never collide with the reclaiming notes
    assert(!std.mem.eql(u8, note_dir, reclaim_rung.note_dir));
    // invariant: this rung's notes never collide with the revoking notes
    assert(!std.mem.eql(u8, note_dir, revoke_rung.note_dir));
    // invariant: this rung's notes never collide with the conferring notes
    assert(!std.mem.eql(u8, note_dir, confer.note_dir));
    // invariant: a dependent always has room to look for the reach it is owed
    assert(max_patience_looks >= 1);
}

