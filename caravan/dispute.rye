    return hearing_rung.upheld_in(standing_mask, evidenced_mask, lost_mask);
}

/// Answers why one recantation may not be made, or that it may.
pub fn recant_refusal(
    published: ?Verdict,
    judged: u32,
    upheld: u32,
    taken_back: u32,
) ?RunError {
    return hearing_rung.recant_refusal(published, judged, upheld, taken_back);
}

/// Refuses a recantation that reached an arc no appraisal ever spared.
pub fn unappraised_reach(standing_mask: u32, taken_back_mask: u32) ?RunError {
    return hearing_rung.unappraised_reach(standing_mask, taken_back_mask);
}

/// Counts the arcs a run spared on a judgment its own evidence disproves.
pub fn spared_disproved(spared_mask: u32, evidenced_mask: u32) u32 {
    return hearing_rung.spared_disproved(spared_mask, evidenced_mask);
}

// =========================================================================
// The amendment -- carried whole from the rung below, since this rung carries
// a correction rather than composing one
// =========================================================================

/// Whether a plan's own corrections are addressed to whoever read the elder
/// word, or merely written over it.
pub const Notice = hearing_rung.Notice;

/// Renders one notice as the words an operator reads.
pub fn notice_words(n: Notice) []const u8 {
    return hearing_rung.notice_words(n);
}

/// Whether the word an operator carries away disagrees with what this run
/// settled.
pub fn superseded(reading: ?Settlement, settled: Settlement) bool {
    return hearing_rung.superseded(reading, settled);
}

/// Which standing reading this run corrects, counted as the one it can be.
pub fn amended_in(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return hearing_rung.amended_in(reading, settled, notice);
}

/// Which standing reading this run stands behind unchanged.
pub fn confirmed_in(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return hearing_rung.confirmed_in(reading, settled, notice);
}

/// Answers why one amendment may not be posted, or that it may.
pub fn amend_refusal(
    published: ?Settlement,
    on_the_wire: u32,
    confirmed: u32,
    amended: u32,
) ?RunError {
    return hearing_rung.amend_refusal(published, on_the_wire, confirmed, amended);
}

/// Refuses an amendment addressed to a reading nobody ever took.
pub fn unread_reach(reading: ?Settlement, amended: u32) ?RunError {
    return hearing_rung.unread_reach(reading, amended);
}

/// Counts the readings an operator holds that this run's settlement contradicts
/// and nobody wrote to.
pub fn superseded_unposted(reading: ?Settlement, settled: Settlement, notice: Notice) u32 {
    return hearing_rung.superseded_unposted(reading, settled, notice);
}

// =========================================================================
// The delivery -- how far a run carries the correction it has written
// =========================================================================

/// Whether a plan's own corrections travel to the reader, or wait on the wire
/// for a reader who may never come back.
///
/// `waiting` is where the rung below leaves it: the correction stands on the
/// wire, entirely truthful, read by whoever returns and by nobody else.
/// `carried` is this rung: a correction this run posts is carried to the address
/// its reading was taken at, written into the reader's own box, and read back
/// from that box before the report believes anybody was reached.
///
/// The word sits at the plan beside the notice, and for the same reason: it
/// instructs about how far a record reaches rather than about any one phase.
pub const Dispatch = enum { waiting, carried };

/// Renders one dispatch as the words an operator reads.
pub fn dispatch_words(d: Dispatch) []const u8 {
    return switch (d) {
        .waiting => "a correction is published where the record lives, and waits",
        .carried => "a correction is carried to the place its reader was reached",
    };
}

/// Whether an address names a place a correction may actually be carried to.
///
/// Bounded and plain: a reader's address is a short name, never empty and never
/// longer than the wire's own bound, and never a path a run could be talked into
/// walking somewhere it was not asked to go. A run that cannot name where a
/// reader is refuses rather than guessing.
pub fn addressable(address: []const u8) bool {
    return ladder_checks.addressable(@This(), address);
}

/// Which posted correction this run carries, counted as the one it can be.
///
/// A run under `.waiting` carries none, however truly it corrected the wire --
/// which is exactly where the rung below leaves a reader who does not return. A
/// run under `.carried` carries the one correction it posted, and only where the
/// reading it answers left an address to carry it to.
pub fn carried_in(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.carried_in(@This(), amended, addressed, dispatch);
}

/// Which posted correction this run leaves standing where it wrote it.
///
/// The other half of the same count, named rather than inferred, so the honesty
/// of the count reads straight as an equality: every posted correction is
/// carried or held.
pub fn held_in(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.held_in(@This(), amended, addressed, dispatch);
}

/// Answers why one correction may not be carried, or that it may.
///
/// Every refusal this rung earns before a correction leaves the wire. `posted`
/// is the amendment this run read back from its own record, `addressed` is
/// whether the reading it answers named a place to carry it to, `held` is how
/// many corrections stay where they were written, and `carried` is how many
/// travel.
///
/// The order is the rung below's order one tier out. A delivery asks whether
/// there is a correction to carry before it asks where to carry it, because a
/// courier setting out with an empty satchel is delivering from memory of a
/// letter nobody wrote.
pub fn carry_refusal(posted: ?[2]Settlement, addressed: bool, held: u32, carried: u32) ?RunError {
    return ladder_checks.carry_refusal(@This(), posted, addressed, held, carried);
}

/// Refuses a delivery bound for a reader who left no address.
///
/// The supply this rung is bounded by, stated as its own refusal so it can be
/// read straight rather than inferred from a count. Carrying a correction to a
/// reader nobody can name invents a destination, which is the same overreach as
/// correcting a reader who never read.
pub fn unaddressed_reach(addressed: bool, carried: u32) ?RunError {
    return ladder_checks.unaddressed_reach(@This(), addressed, carried);
}

/// Counts the corrections this run wrote and left waiting for a reader who
/// never comes back.
///
/// The eleventh of the family, and the first that weighs a record against the
/// **distance** between where it was written and where its reader actually is.
/// The count before it names the sentence a person carried away and the answer
/// this run owed them; this names that answer, written honestly, sitting in the
/// writer's own drawer. Every note below this rung reaches a reader who returns,
/// and this is the first that reaches one who does not.
///
/// The measurement reaches only a correction whose reading left an address. A
/// reader who can be named and was not written to is a loss this run could have
/// prevented; a reader who left no way to be found is a duty nobody can
/// discharge, and counting it would be measuring the weather.
pub fn posted_unreached(amended: u32, addressed: bool, dispatch: Dispatch) u32 {
    return ladder_checks.posted_unreached(@This(), amended, addressed, dispatch);
}

// =========================================================================
// The hearing -- carried whole from the rung below, since this rung records
// what that hearing may not accept
// =========================================================================

/// Whether a plan listens for the answer its own correction earned, unchanged.
pub const Receipt = hearing_rung.Receipt;

/// Renders one receipt as the words an operator reads.
pub fn receipt_words(r: Receipt) []const u8 {
    return hearing_rung.receipt_words(r);
}

/// Which carried correction this run hears an answer to.
///
/// The rung below's own count, and this rung hands it a stricter question than
/// the rung below ever asked. Below, `agreed` was simply whether any hand stood
/// in the reader's box; here it is whether that hand named the reading the
/// letter carries. An answer a plan cannot accept is not an answer it heard,
/// and calling it one would be the exact overreach `HearMisheard` refuses.
pub fn heard_in(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return hearing_rung.heard_in(carried, agreed, receipt);
}

/// Which carried correction this run leaves without ever hearing its answer.
pub fn unheard_in(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return hearing_rung.unheard_in(carried, agreed, receipt);
}

/// Answers why one answer may not be heard, or that it may.
pub fn hear_refusal(
    carried: ?[2]Settlement,
    agreed: bool,
    unheard: u32,
    heard: u32,
) ?RunError {
    return hearing_rung.hear_refusal(carried, agreed, unheard, heard);
}

/// Refuses a hearing where no hand ever agreed.
pub fn unanswered_reach(agreed: bool, heard: u32) ?RunError {
    return hearing_rung.unanswered_reach(agreed, heard);
}

/// Answers whether one reader's hand agrees with the correction it answers.
///
/// The consensus season's law, carried whole: a reading is never lifted off the
/// word it was true for. Below this rung the answer was the end of the matter,
/// since a hand that failed this test ended the run. Here it is the fork -- an
/// agreeing hand closes the correspondence, and a disagreeing one opens the
/// record this rung exists to keep.
pub fn hand_agrees(letter: [2]Settlement, hand: Settlement) bool {
    return hearing_rung.hand_agrees(letter, hand);
}

/// Counts the corrections a run carried whose reader answered into silence.
pub fn carried_unheard(carried: u32, agreed: bool, receipt: Receipt) u32 {
    return hearing_rung.carried_unheard(carried, agreed, receipt);
}

// =========================================================================
// The dispute -- whether a record may hold a disagreement it cannot resolve
// =========================================================================

/// Whether a plan's record may hold a disagreement, or keeps a single voice.
///
/// `settled` is where the rung below leaves it: a hand naming a reading this
/// run cannot accept is set aside, counted nowhere, and the record afterward
/// reads as though the correspondence had closed in agreement. `open` is this
/// rung: the same hand is written down beside the reading it answers, in both
/// voices, and the record plainly holds a disagreement nobody has resolved.
///
/// The word sits at the plan beside the receipt, and for the same reason: it
/// instructs about what a record may hold rather than about any one phase.
pub const Standing = enum { settled, open };

/// Renders one standing as the words an operator reads.
pub fn standing_words(s: Standing) []const u8 {
    return switch (s) {
        .settled => "a record keeps one voice, and an answer it cannot accept is set aside",
        .open => "a record holds a disagreement, in both voices, resolved by neither",
    };
}

/// Which read answer this run records as a dispute, counted as the one it can be.
///
/// A run under `.settled` records none, however plainly its reader disagreed --
/// which is exactly where the rung below leaves every reader who answers in a
/// word the plan cannot accept. A run under `.open` records the one answer it
/// read, and only where that hand actually names a different reading.
pub fn recorded_in(answered: u32, agreed: bool, record: Standing) u32 {
    // invariant: a run never reads more answers than a wire may hold
    assert(answered <= 1);
    if (record == .settled) return 0;
    if (agreed) return 0;
    return answered;
}

/// Which read answer this run keeps no record of at all.
///
/// The other half of the same count, named rather than inferred, so the honesty
/// of the count reads straight as an equality: every answer this run read is
/// recorded or agreed away.
pub fn unwritten_in(answered: u32, agreed: bool, record: Standing) u32 {
    // invariant: a run never reads more answers than a wire may hold
    assert(answered <= 1);
    return answered - recorded_in(answered, agreed, record);
}

/// Answers whether the pair a run would write is a disagreement at all.
///
/// The hard half of this rung. A dispute names two readings and resolves
/// neither, which means the two must actually differ: a pair naming one reading
/// twice is agreement wearing a quarrel's clothes, and a record built on it
/// would manufacture a disagreement nobody ever had.
pub fn founded(pair: [2]Settlement) bool {
    return pair[0] != pair[1];
}

/// Answers why one disagreement may not be recorded, or that it may.
///
/// Every refusal this rung earns before a disagreement enters the record.
/// `answer` is the hand this run read out of the reader's own box, `agreed` is
/// whether that hand names the reading the letter carried, `unwritten` is how
/// many answers this run keeps no record of, and `recorded` is how many it
/// writes down.
///
/// The order is the rung below's order one tier out. A record asks whether an
/// answer was read before it asks what that answer said, because a run
/// recording a disagreement with a reader who never wrote is quarrelling with
/// itself.
pub fn dispute_refusal(
    answer: ?Settlement,
    agreed: bool,
    unwritten: u32,
    recorded: u32,
) ?RunError {
    // invariant: a run never records more disputes than answers it read
    assert(recorded <= 1);
    // invariant: a run never leaves more unwritten than a wire may hold
    assert(unwritten <= 1);
    _ = answer orelse return error.DisputeEarly;
    if (agreed) return error.DisputeUnfounded;
    if (unwritten + recorded > 1) return error.DisputeMiscounted;
    // Every answer this run read is recorded or agreed away -- never both and
    // never neither. A count that does not close is a supervisor about to
    // report a record its own correspondence cannot support.
    if (unwritten + recorded != 1) return error.DisputeMiscounted;
    return null;
}

/// Refuses a record of a disagreement nobody ever voiced.
///
/// The supply this rung is bounded by, stated as its own refusal so it can be
/// read straight rather than inferred from a count. Recording a dispute where
/// no hand answered invents a reader's objection, which is the same overreach
/// as hearing an agreement nobody gave.
pub fn unheard_record(answered: bool, recorded: u32) ?RunError {
    // invariant: a run never records more disputes than answers it read
    assert(recorded <= 1);
    if (recorded >= 1 and !answered) return error.DisputeUnheard;
    return null;
}

/// Counts the answers a run read in a reader's own hand and set aside without
/// a record.
///
/// The thirteenth of the family, and the first that weighs a record against the
/// answers it declined to keep. The count below it proves a reader was heard,
/// and hears only agreement; a hand naming any other reading ends the
/// correspondence there, honestly and silently, so the record afterward cannot
/// tell a reader who consented from one who objected in plain words.
///
/// The measurement reaches only an answer this run actually read. A reader who
/// never wrote back is a silence no record can hold, and counting it would be
/// measuring the weather; a reader who disagreed into a record that kept no
/// trace is a loss this run could have prevented, and it is the whole of what
/// this rung moves.
pub fn answered_unrecorded(answered: u32, agreed: bool, record: Standing) u32 {
    // invariant: a run never reads more answers than a wire may hold
    assert(answered <= 1);
    if (answered == 0 or agreed) return 0;
    return if (record == .open) 0 else 1;
}

// =========================================================================
// The door -- unchanged, since this rung carries a record rather than a line
// =========================================================================

/// Answers whether the head may enter, over the lines the run remembers.
///
/// The door is `revoke.admissible_in` exactly: a widened line is weighed the
/// same way whether a correction travels or waits. What this rung changes
/// happens after the last dependent has already gone home.
pub fn admissible_in(
    sys: *const system.System,
    live: []const cohort.Running,
    handed: []const Task,
    reserves: []const ?Task,
    taken: []const u32,
    head: Task,
) RunError!bool {
    return hearing_rung.admissible_in(sys, live, handed, reserves, taken, head);
}

// =========================================================================
// The notes -- what a run publishes, and the answers it reads back
// =========================================================================

/// Why a conferral could not be published, read, confirmed, or reclaimed.
pub const NoteError = hearing_rung.NoteError;

/// Writes the path of one dependent's note.
pub fn note_path(buf: *[max_note_path_len]u8, domain: []const u8, suffix: []const u8) NoteError![]const u8 {
    // invariant: a note always names the dependent it belongs to
    assert(domain.len >= 1);
    // invariant: a note always carries one of the suffixes
    assert(suffix.len >= 1);
    const total = note_dir.len + 1 + domain.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var w: u32 = 0;
    for (note_dir) |c| {
        buf[w] = c;
        w += 1;
    }
    buf[w] = '/';
    w += 1;
    for (domain) |c| {
        buf[w] = c;
        w += 1;
    }
    for (suffix) |c| {
        buf[w] = c;
        w += 1;
    }
    // invariant: the path written is exactly the length computed for it
    assert(w == total);
    return buf[0..w];
}

/// Writes bytes into a note, creating it fresh.
pub fn seat_note(io: std.Io, domain: []const u8, suffix: []const u8, bytes: []const u8) NoteError!void {
    // invariant: a note always names the dependent it belongs to
    assert(domain.len >= 1);
    // invariant: a note always carries one of the suffixes
    assert(suffix.len >= 1);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try note_path(&path_buf, domain, suffix);
    // invariant: a written path always carries the directory it lives in
    assert(path.len > note_dir.len);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch
        return error.NoteUnavailable;
    defer file.close(io);
    if (bytes.len == 0) return;
    file.writePositionalAll(io, bytes, 0) catch return error.NoteUnavailable;
}

/// Reads the one byte a counting note carries.
pub fn read_count(io: std.Io, domain: []const u8, suffix: []const u8) NoteError!u8 {
    // invariant: a note always names the dependent it belongs to
    assert(domain.len >= 1);
    // invariant: a note always carries one of the suffixes
    assert(suffix.len >= 1);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try note_path(&path_buf, domain, suffix);
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch
        return error.NoteUnavailable;
    defer file.close(io);
    var seen = [_]u8{0};
    _ = file.readPositionalAll(io, &seen, 0) catch return error.NoteUnavailable;
    return seen[0];
}

/// Reads the word list a dependent's domain has been handed so far.
pub fn read_words(io: std.Io, domain: []const u8, out: *Words) NoteError!void {
    // invariant: a word list always names the dependent that listens
    assert(domain.len >= 1);
    // invariant: a word list is always read into a list that starts empty
    assert(out.len == 0);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try note_path(&path_buf, domain, ".words");
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch
        return error.NoteUnavailable;
    defer file.close(io);
    const got = file.readPositionalAll(io, &out.bytes, 0) catch return error.NoteUnavailable;
    // invariant: a word list read never outgrows the wire that carries it
    assert(got <= max_words_bytes);
    out.len = @intCast(got);
}

/// Provisions one set of notes per declared domain, all standing at nothing.
///
/// Every run starts with no reach conferred, none revoked, and no conferral
/// standing anywhere, so a word a dependent finds at its first breath was left
/// by this run's own supervisor rather than by the last.
pub fn provision_notes(io: std.Io, sys: *const system.System) NoteError!u32 {
    // invariant: the domain roster stays within its bound
    assert(sys.graph.domain_count >= 1);
    // invariant: a run always provisions into a declaration that read whole
    assert(sys.map.region_count >= 1);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    var i: u32 = 0;
    while (i < sys.graph.domain_count) : (i += 1) {
        const name = sys.graph.domains[i].name_slice();
        try seat_note(io, name, ".given", &[_]u8{0});
        try seat_note(io, name, ".held", &[_]u8{0});
        try seat_note(io, name, ".offered", &[_]u8{0});
        try seat_note(io, name, ".words", "");
        try seat_note(io, name, ".pruning", &[_]u8{0});
        try seat_note(io, name, ".kept", &[_]u8{0});
        try seat_note(io, name, ".pruned", &[_]u8{0});
        try seat_note(io, name, ".inherited", &[_]u8{0});
        try seat_note(io, name, ".epoch", &[_]u8{0});
        try seat_note(io, name, ".for", &[_]u8{0});
        try seat_note(io, name, ".falls", &[_]u8{0});
        try seat_note(io, name, ".abandoned", &[_]u8{0});
    }
    // The plan's own verdict is cleared with them, so no run ever reads the
    // last run's judgment of a plan this one has not finished. Its bearing and
    // its settlement clear beside it, for exactly the same reason: a repair
    // that read the last run's bearing would spare an arc this plan never
    // asked it to spare.
    try seat_note(io, plan_name, ".verdict", &[_]u8{0});
    try seat_note(io, plan_name, ".bearing", "");
    try seat_note(io, plan_name, ".settled", &[_]u8{0});
    // The recantation clears with them, since a reversal belongs to the run
    // that made it and answers for that run's own evidence alone.
    //
    // **The appraisal stays.** It is the one note a run leaves exactly where it
    // found it, because a judgment that vanished with its run was never a
    // record -- and because what a run does with a judgment it did not make is
    // the whole subject of this rung.
    try seat_note(io, plan_name, ".recant", "");
    // The amendment clears with them, since a correction belongs to the run that
    // posted it and answers for that run's own settlement alone.
    //
    // **The reading stays**, beside the appraisal, and for a plainer reason than
    // the appraisal's: a reader's copy survives the run whatever the wire does,
    // so a wire that forgot what it last told somebody could never notice it had
    // changed its mind.
    try seat_note(io, plan_name, ".amend", "");
    // The recorded disagreement clears with them, since a dispute belongs to
    // the run that read it and answers for the answer that run itself heard.
    // A record that kept the last run's quarrel would be holding a reader to a
    // word they wrote about a plan that has since been run again.
    try seat_note(io, plan_name, ".dispute", "");
    // invariant: a fresh provisioning leaves no amendment standing to be read
    assert(amend_published(io) == null);
    // invariant: a fresh provisioning leaves no disagreement standing to be read
    assert(dispute_recorded(io) == null);
    // invariant: a fresh provisioning leaves no verdict standing to be read
    assert(verdict_published(io) == null);
    // invariant: a fresh provisioning leaves no settlement standing to be read
    assert(settlement_published(io) == null);
    // invariant: every declared domain got its notes, none invented
    assert(i == sys.graph.domain_count);
    return i;
}

/// Tells one dependent how much reach may yet arrive for it.
pub fn offer(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    return ladder_checks.offer(@This(), io, domain, depth);
}

/// Reads how much reach this dependent was told may yet arrive.
pub fn offered(io: std.Io, domain: []const u8) NoteError!u32 {
    // invariant: an offer is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = try read_count(io, domain, ".offered");
    // invariant: an offer stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Tells one dependent whether a pruning will come for it at all.
pub fn promise_pruning(io: std.Io, domain: []const u8, keep: Keep) NoteError!void {
    return ladder_checks.promise_pruning(@This(), io, domain, keep);
}

/// Reads whether a pruning was promised to this dependent.
pub fn pruning_promised(io: std.Io, domain: []const u8) bool {
    return ladder_checks.pruning_promised(@This(), io, domain);
}

/// Tells this dependent how its author declared it would end.
///
/// A plan already names the outcome it expects of every phase, and until now
/// only the supervisor read that word. The dependent needs it too, since the
/// window this rung studies opens inside the dependent's own life -- after it
/// grafts a conferral and before it carries the work. So the declaration rides
/// the same wire as the pruning promise, written before the spawn.
pub fn promise_falling(io: std.Io, domain: []const u8, falling: bool) NoteError!void {
    return ladder_checks.promise_falling(@This(), io, domain, falling);
}

/// Answers whether this dependent's author declared that it falls.
pub fn falling_promised(io: std.Io, domain: []const u8) bool {
    // invariant: a declaration is always read by the dependent it names
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".falls") catch return false;
    return seen != 0;
}

/// Publishes one conferral: the generation it is meant for, the words
/// themselves, then the count that makes them live.
///
/// The generation is what lets a dependent tell a word meant for it from a
/// word left standing by the dependent before it. It is a **measurement**
/// rather than a guard: a careless successor may graft a foreign word all the
/// same, which is exactly why the conferral is reclaimed rather than merely
/// labelled.
pub fn confer_words(io: std.Io, domain: []const u8, words: *const Words, depth: u32) NoteError!void {
    // invariant: a conferral always names the dependent it is handed to
    assert(domain.len >= 1);
    // invariant: a conferral never hands more than one line may name
    assert(depth <= cycle.max_hops);
    const generation = read_count(io, domain, ".epoch") catch 0;
    try seat_note(io, domain, ".for", &[_]u8{generation});
    try seat_note(io, domain, ".words", words.slice());
    try seat_note(io, domain, ".given", &[_]u8{@intCast(depth)});
}

/// Opens one generation of a domain, and answers which it is.
///
/// A domain outlives every dependent that stands in it, so each start counts
/// one further. The number is seated before the spawn, so a dependent always
/// finds its own generation waiting for it.
pub fn open_generation(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.open_generation(@This(), io, domain);
}

/// Tells the run this dependent has grafted the reach it was conferred.
pub fn holds(io: std.Io, domain: []const u8, depth: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never grafts more than one line may name
    assert(depth <= cycle.max_hops);
    try seat_note(io, domain, ".held", &[_]u8{@intCast(depth)});
}

/// Waits, bounded, until this conferral has been grafted.
pub fn confirm(io: std.Io, domain: []const u8, depth: u32) bool {
    // invariant: a confirmation always names the dependent it waits on
    assert(domain.len >= 1);
    // invariant: a confirmation always waits on reach actually handed over
    assert(depth >= 1);
    var looks: u32 = 0;
    while (looks < max_confirm_looks) : (looks += 1) {
        const answered = read_count(io, domain, ".held") catch return false;
        if (answered >= depth) return true;
        std.Io.sleep(io, std.Io.Duration.fromMilliseconds(note_rest_ms), .awake) catch {};
    }
    // invariant: the confirmation stayed inside the bound it was given
    assert(looks == max_confirm_looks);
    return false;
}

/// Publishes one revocation: how many conferred words remain live.
pub fn revoke(io: std.Io, domain: []const u8, keep: u32) NoteError!void {
    // invariant: a revocation always names the dependent it is asked of
    assert(domain.len >= 1);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    try seat_note(io, domain, ".kept", &[_]u8{@intCast(keep)});
}

/// Reads how many conferred words this dependent may still hold.
pub fn kept(io: std.Io, domain: []const u8) NoteError!u32 {
    return ladder_checks.kept(@This(), io, domain);
}

/// Tells the run this dependent has pruned the reach it returned.
pub fn pruned(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    return ladder_checks.pruned(@This(), io, domain, count);
}

/// Waits, bounded, until this revocation has been pruned.
pub fn confirm_pruned(io: std.Io, domain: []const u8, count: u32) bool {
    // invariant: a confirmation always names the dependent it waits on
    assert(domain.len >= 1);
    // invariant: a confirmation always waits on reach actually taken back
    assert(count >= 1);
    var looks: u32 = 0;
    while (looks < max_confirm_looks) : (looks += 1) {
        const answered = read_count(io, domain, ".pruned") catch return false;
        if (answered >= count) return true;
        std.Io.sleep(io, std.Io.Duration.fromMilliseconds(note_rest_ms), .awake) catch {};
    }
    // invariant: the confirmation stayed inside the bound it was given
    assert(looks == max_confirm_looks);
    return false;
}

/// Tells the run how much reach this dependent found standing at its first breath.
pub fn inherited(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an answer always names the dependent that gives it
    assert(domain.len >= 1);
    // invariant: a dependent never inherits more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".inherited", &[_]u8{@intCast(count)});
}

/// Reads how much reach this dependent found standing at its first breath.
pub fn inherited_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an answer is always read about the dependent that gave it
    assert(domain.len >= 1);
    const seen = read_count(io, domain, ".inherited") catch return 0;
    // invariant: an inheritance stays inside what one line may name
    assert(seen <= cycle.max_hops);
    return seen;
}

/// Takes one conferral back whole, so nothing of it stands for a successor.
///
/// The words, the count that makes them live, and every answer given about
/// them return together. A count left standing would let a successor graft a
/// word; an answer of *held* left standing would let a supervisor believe a
/// successor grafted a word it never saw.
pub fn reclaim_notes(io: std.Io, domain: []const u8) NoteError!void {
    // invariant: a reclamation always names the domain it takes back from
    assert(domain.len >= 1);
    try seat_note(io, domain, ".words", "");
    try seat_note(io, domain, ".given", &[_]u8{0});
    try seat_note(io, domain, ".for", &[_]u8{0});
    try seat_note(io, domain, ".held", &[_]u8{0});
    try seat_note(io, domain, ".kept", &[_]u8{0});
    try seat_note(io, domain, ".pruned", &[_]u8{0});
}

/// Records on the wire how much reach this domain's departed holder never served.
///
/// Written after the reclamation has swept the domain clean, so the count
/// survives the very act that erases every other trace of the conferral. A
/// number kept only in memory would make the abandonment the supervisor's
/// claim; a number on the wire is a fact an operator reads after the run.
pub fn abandon_note(io: std.Io, domain: []const u8, count: u32) NoteError!void {
    // invariant: an abandonment always names the domain it was granted to
    assert(domain.len >= 1);
    // invariant: an abandonment never records more than one line may name
    assert(count <= cycle.max_hops);
    try seat_note(io, domain, ".abandoned", &[_]u8{@intCast(count)});
}

/// Reads how much reach this domain's departed holder never served.
pub fn abandoned_by(io: std.Io, domain: []const u8) u32 {
    // invariant: an abandonment is always read about the domain it names
    assert(domain.len >= 1);
    const left = read_count(io, domain, ".abandoned") catch return 0;
    // invariant: an abandonment stays inside what one line may name
    assert(left <= cycle.max_hops);
    return left;
}

/// The name a plan's own verdict is published under.
///
/// Every other note on this wire belongs to one dependent; this one belongs to
/// the run itself, so it carries a name no declared domain may take.
pub const plan_name = "plan";

/// Publishes what the plan came to, where an operator reads it after the run.
///
/// The verdict is written once the last dependent has been reaped and every
/// abandonment already answered for, so the word rests on the whole of the
/// work rather than on the part of it that had happened when the run last
/// looked.
pub fn verdict_note(io: std.Io, verdict: Verdict) NoteError!void {
    try seat_note(io, plan_name, ".verdict", &[_]u8{verdict_byte(verdict)});
}

/// Reads a plan's published verdict back, or nothing where none was published.
pub fn verdict_published(io: std.Io) ?Verdict {
    const byte = read_count(io, plan_name, ".verdict") catch return null;
    return verdict_of_byte(byte);
}

/// Publishes which phases of the plan an arc was lost on.
///
/// The verdict says *that* a plan fell short; this says *where*. It is written
/// as one glyph per phase of the record -- `x` for a phase whose absorbed arc
/// nobody served, `.` for every other -- so an operator reads the shape of the
/// loss straight off the wire, and a mend derives its second record from the
/// record rather than from a supervisor's memory of it.
///
/// One glyph per phase rather than a packed mask, because the reader here is a
/// person first. The bound is the record's own: a plan never holds more phases
/// than `max_queue_len`, so this note never grows past it.
pub fn lost_note(io: std.Io, held: u32, lost_mask: u32) NoteError!void {
    // invariant: a loss note never names more phases than one record may hold
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((lost_mask & phase_bit(at)) != 0) glyphs[at] = 'x';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".lost", glyphs[0..held]);
}

/// Reads the published loss back as the mask a mend seats from.
///
/// A mend that reads nothing here has nothing to repair, and says so with a
/// zero rather than by guessing -- the refusal that follows is `MendUnread`
/// when even the verdict is absent, and `MendOvereach` if a caller were ever
/// to propose seating work the wire never named.
pub fn lost_published(io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= max_queue_len);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".lost") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: a loss note never outgrows the record it describes
    assert(got <= max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'x') found |= phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

/// The single bit that stands for one phase of a record.
pub fn phase_bit(at: u32) u32 {
    // invariant: a record always fits inside the bits one word carries
    assert(max_queue_len <= 32);
    // invariant: a bit always names a phase inside the record's own bound
    assert(at < max_queue_len);
    const one: u32 = 1;
    return one << @intCast(at);
}

/// Publishes which of a plan's losses its author asked it to bear.
///
/// The loss note says where a plan fell short; this says which of those places
/// its author would rather leave standing. It is written in the same shape and
/// read the same way -- one glyph per phase, `b` where an arc was lost and its
/// author marked it borne -- so an operator reads the two notes side by side
/// and a repair seats from the record rather than from a supervisor's memory
/// of what the plan wanted.
pub fn bearing_note(io: std.Io, held: u32, borne_mask: u32) NoteError!void {
    // invariant: a bearing note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((borne_mask & phase_bit(at)) != 0) glyphs[at] = 'b';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".bearing", glyphs[0..held]);
}

/// Reads the published bearing back as the mask a repair spares.
///
/// A run that reads nothing here bears nothing, and says so with a zero rather
/// than by guessing -- which leaves the repair exactly where the rung below
/// left it, running every arc the plan lost.
pub fn bearing_published(io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= max_queue_len);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".bearing") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: a bearing note never outgrows the record it describes
    assert(got <= max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'b') found |= phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

/// Publishes which of a plan's unmarked losses this run weighed as spent.
///
/// The bearing note above names what an author asked to carry; this names what
/// the run judged the plan had got past. One glyph per phase, `w` where an
/// unmarked loss was weighed spent, written while the run still holds the
/// evidence and read back before the repair seats anything -- since a
/// supervisor that appraised from memory would be applying a standard it
/// believes in rather than the one its plan published.
pub fn appraisal_note(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: an appraisal note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((weighed_mask & phase_bit(at)) != 0) glyphs[at] = 'w';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".appraisal", glyphs[0..held]);
}

/// Reads back which phases this run weighed as spent, straight off the wire.
pub fn appraisal_published(io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= max_queue_len);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".appraisal") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: an appraisal note never outgrows the record it describes
    assert(got <= max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'w') found |= phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

/// Seats a judgment on the wire as the record a run before this one left.
///
/// The appraisal is the one note a run does not clear, so a standing judgment
/// arrives the only way it ever could: written, and waiting. This names that
/// act plainly for a caller that means to stand a record up mid-history, and it
/// makes the directory first, since a judgment may be waiting before any run of
/// this plan has provisioned a thing.
pub fn seat_standing_appraisal(io: std.Io, held: u32, weighed_mask: u32) NoteError!void {
    // invariant: a seated judgment never names more phases than one record holds
    assert(held <= max_queue_len);
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try appraisal_note(io, held, weighed_mask);
}

/// Publishes which standing judgments this run took back.
///
/// The appraisal note above names what a run judged the plan had got past; this
/// names which of those judgments a later run's own evidence declines to keep.
/// One glyph per phase, `r` where a standing judgment was recanted, written
/// while the run still holds the record that disproves it and read back before
/// the repair seats a single phase on its strength.
pub fn recant_note(io: std.Io, held: u32, taken_back_mask: u32) NoteError!void {
    // invariant: a recant note never names more phases than one record holds
    assert(held <= max_queue_len);
    var glyphs: [max_queue_len]u8 = @splat('.');
    var at: u32 = 0;
    while (at < held) : (at += 1) {
        if ((taken_back_mask & phase_bit(at)) != 0) glyphs[at] = 'r';
    }
    // invariant: every phase of the record was written, none skipped
    assert(at == held);
    try seat_note(io, plan_name, ".recant", glyphs[0..held]);
}

/// Reads back which standing judgments this run took back, straight off the wire.
pub fn recant_published(io: std.Io, held: u32) u32 {
    // invariant: a reading never names more phases than one record may hold
    assert(held <= max_queue_len);
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = note_path(&path_buf, plan_name, ".recant") catch return 0;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return 0;
    defer file.close(io);
    var glyphs: [max_queue_len]u8 = @splat('.');
    const got = file.readPositionalAll(io, &glyphs, 0) catch return 0;
    // invariant: a recant note never outgrows the record it describes
    assert(got <= max_queue_len);
    var found: u32 = 0;
    var at: u32 = 0;
    while (at < held and at < got) : (at += 1) {
        if (glyphs[at] == 'r') found |= phase_bit(at);
    }
    // invariant: the walk never read a phase outside the record
    assert(at <= held);
    return found;
}

/// Publishes the word an operator finally reads about this plan.
///
/// The verdict note below says whether work is still standing. This says what
/// that standing work means -- carried out, short, or whole but for a loss the
/// plan itself asked to carry. Written after the repair has had its turn, and
/// read back before the report believes it.
pub fn settlement_note(io: std.Io, settlement: Settlement) NoteError!void {
    try seat_note(io, plan_name, ".settled", &[_]u8{settlement_byte(settlement)});
}

/// Reads a plan's published settlement back, or nothing where none was written.
pub fn settlement_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".settled") catch return null;
    return settlement_of_byte(byte);
}

/// Reads the word an operator was last told about this plan, or nothing at all.
///
/// The settlement note above is what the wire says now; this is what somebody
/// carried away. The two are the same word right up until a later run moves
/// one of them, and this rung exists for the moment they part.
pub fn reading_published(io: std.Io) ?Settlement {
    const byte = read_count(io, plan_name, ".read") catch return null;
    return settlement_of_byte(byte);
}

/// Seats a reading on the wire as the word an operator carried away.
///
/// The reading is the second note a run does not clear, so a standing reading
/// arrives the only way it ever could: written, and waiting. This names that act
/// plainly for a caller that means to stand a reader up mid-history, and it
/// makes the directory first, since somebody may have read this plan before any
/// run of it has provisioned a thing.
pub fn seat_standing_reading(io: std.Io, reading: Settlement) NoteError!void {
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".read", &[_]u8{settlement_byte(reading)});
}

/// Publishes the correction addressed to whoever read the elder word.
///
/// The first note of this arc written to a **person** rather than about a phase,
/// so it is written about the plan whole rather than one glyph per phase: two
/// bytes, the reading superseded and the reading that supersedes it, so `bc`
/// reads *you were told the plan was borne; it is carried out whole*. Written
/// while the run still holds both words, and read back before the report
/// believes anybody was reached.
pub fn amend_note(io: std.Io, was: Settlement, now: Settlement) NoteError!void {
    // invariant: an amendment always names two readings that actually differ
    assert(was != now);
    try seat_note(io, plan_name, ".amend", &[_]u8{ settlement_byte(was), settlement_byte(now) });
}

/// Reads the published amendment back as the two readings it names.
///
/// A run that reads nothing here corrected nobody, and says so with a null
/// rather than by guessing -- which leaves a reader exactly where the rung below
/// leaves them, holding a word the plan no longer stands behind.
pub fn amend_published(io: std.Io) ?[2]Settlement {
    return ladder_checks.amend_published(@This(), io);
}

/// Records the disagreement between what this run stands behind and what its
/// reader answered.
///
/// The first note of this arc that writes a **reader's own word** into the
/// plan's record: two bytes, the reading this run carried and the reading their
/// hand named, so `cb` reads *the plan holds carried out whole; its reader holds
/// borne*. The pair is written and left there. A supervisor that went on to
/// settle the disagreement in its own favor would be recording a quarrel and
/// calling it a verdict.
pub fn dispute_note(io: std.Io, ours: Settlement, theirs: Settlement) NoteError!void {
    // invariant: a dispute always names two readings that actually differ
    assert(ours != theirs);
    try seat_note(io, plan_name, ".dispute", &[_]u8{ settlement_byte(ours), settlement_byte(theirs) });
}

/// Reads the recorded disagreement back as the two readings it names.
///
/// A run that reads nothing here recorded no disagreement, and says so with a
/// null rather than by guessing -- which leaves the record exactly where the
/// rung below leaves it, reading as one voice whatever its reader answered.
pub fn dispute_recorded(io: std.Io) ?[2]Settlement {
    return ladder_checks.dispute_recorded(@This(), io);
}

/// Reads the address the standing reading was taken at, or nothing at all.
///
/// A reader who took a word away is somewhere, and the plan either wrote that
/// down or it did not. This answers which -- plainly, with a null where no
/// address stands, so a run never has to guess where a person is.
pub fn address_published(io: std.Io, out: *[max_address_len]u8) ?[]const u8 {
    return ladder_checks.address_published(@This(), io, out);
}

/// Seats the address a reader was reached at, beside the reading they took.
///
/// The reading and the address arrive together, since a word carried away and
/// the place it was carried to are one fact about one person. This names that
/// act plainly for a caller standing a reader up mid-history, and it makes the
/// directory first, since somebody may have read this plan before any run of it
/// has provisioned a thing.
pub fn seat_standing_address(io: std.Io, address: []const u8) NoteError!void {
    // invariant: a run only ever seats an address a correction could reach
    assert(addressable(address));
    Dir.cwd().createDirPath(io, note_dir) catch return error.NoteUnavailable;
    try seat_note(io, plan_name, ".at", address);
}

/// Writes the path of one reader's own box.
///
/// The one path this rung builds outside `note_dir`, and the shape of its whole
/// claim: a delivery lands where the reader is rather than where the record
/// lives. The address is bounded and checked before a byte of it reaches a path.
fn box_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    return ladder_checks.box_path(@This(), buf, address);
}

/// Carries one correction to the reader's own box, in the words they read.
///
/// The outward reach of the whole arc, and it is deliberately the same two
/// bytes the wire carries: the reading superseded and the reading that
/// supersedes it, so `bc` reads *you were told the plan was borne; it is
/// carried out whole* wherever a person finds it. The box is made here, since a
/// reader's address is a place this plan has never written to before.
pub fn deliver(io: std.Io, address: []const u8, was: Settlement, now: Settlement) NoteError!void {
    return ladder_checks.deliver(@This(), io, address, was, now);
}

/// Reads one reader's box back as the two readings it carries.
///
/// The hard half of this rung, read from the box rather than from the run's own
/// memory of writing to it. A run that reads nothing here delivered nothing,
/// and says so with a null rather than by believing its own report -- which is
/// the difference between a delivery and a claim about one.
pub fn delivered_to(io: std.Io, address: []const u8) ?[2]Settlement {
    return ladder_checks.delivered_to(@This(), io, address);
}

/// Clears one reader's box, so a lap begins with a reader who has been told
/// nothing at all.
///
/// A box outlives every run, exactly as a reader's own copy does, so a lap that
/// means to prove a delivery must start from a reader who is genuinely waiting.
pub fn empty_box(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = box_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

/// Writes the path of the hand one reader answers with.
///
/// The reader's own box holds two files and they face opposite ways: `.told` is
/// what the plan carried to them, and `.said` is what they wrote back. A run
/// writes the first and only ever reads the second, which is the whole
/// difference between a delivery and an acknowledgement.
fn hand_path(buf: *[max_note_path_len]u8, address: []const u8) NoteError![]const u8 {
    // invariant: a hand is only ever read for an address a run may carry to
    assert(addressable(address));
    const suffix = ".said";
    // invariant: an answer is read from the same box a correction is left in
    comptime assert(suffix.len == ".told".len);
    const total = reader_dir.len + 1 + address.len + suffix.len;
    if (total > max_note_path_len) return error.NotePathTooLong;
    var at: u32 = 0;
    for (reader_dir) |byte| {
        buf[at] = byte;
        at += 1;
    }
    buf[at] = '/';
    at += 1;
    for (address) |byte| {
        buf[at] = byte;
        at += 1;
    }
    for (suffix) |byte| {
        buf[at] = byte;
        at += 1;
    }
    // invariant: a hand path is written exactly as long as it was measured
    assert(at == total);
    return buf[0..at];
}

/// Reads one reader's own hand as the reading they say they now hold.
///
/// The only reach a run ever makes toward this file, and it is a read. A run
/// that finds nothing here has heard nothing, and says so with a null rather
/// than by believing its own delivery -- since a letter that arrived and a
/// reader who answered are two facts, and only the second one is about a
/// person.
pub fn answered_by(io: std.Io, address: []const u8) ?Settlement {
    if (!addressable(address)) return null;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return null;
    const file = Dir.cwd().openFile(io, path, .{ .mode = .read_only }) catch return null;
    defer file.close(io);
    var bytes: [1]u8 = @splat(0);
    const got = file.readPositionalAll(io, &bytes, 0) catch return null;
    // invariant: an answer never outgrows the one reading it names
    assert(got <= 1);
    if (got < 1) return null;
    return settlement_of_byte(bytes[0]);
}

/// Answers as the reader themself, in the one byte they would write.
///
/// **No run ever calls this**, and that restraint is the rung. An
/// acknowledgement a supervisor could write for its reader acknowledges
/// nothing at all -- it is the plan agreeing with the plan. The hand belongs to
/// an operator, to a tool at their desk, or to a lap that means to stand a
/// reader up on the wire the way `seat_standing_reading` stands one up
/// mid-history; the supervisor's whole part is to read what it finds and to
/// report honestly when it finds nothing.
pub fn answer_as_reader(io: std.Io, address: []const u8, now_holds: Settlement) NoteError!void {
    // invariant: a hand is only ever seated for an address a run may carry to
    assert(addressable(address));
    Dir.cwd().createDirPath(io, reader_dir) catch return error.NoteUnavailable;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = try hand_path(&path_buf, address);
    const file = Dir.cwd().createFile(io, path, .{ .truncate = true }) catch return error.NoteUnavailable;
    defer file.close(io);
    const bytes = [_]u8{settlement_byte(now_holds)};
    file.writePositionalAll(io, &bytes, 0) catch return error.NoteUnavailable;
}

/// Clears one reader's hand, so a lap begins with a reader who has said
/// nothing at all.
///
/// A hand outlives every run, exactly as a reader's own copy does, so a lap
/// that means to prove a hearing must start from a reader whose word this run
/// genuinely finds rather than one an earlier run left lying there.
pub fn clear_hand(io: std.Io, address: []const u8) void {
    if (!addressable(address)) return;
    var path_buf: [max_note_path_len]u8 = undefined;
    const path = hand_path(&path_buf, address) catch return;
    Dir.cwd().deleteFile(io, path) catch {};
}

// =========================================================================
// The supervisor -- a record that answers for the work its conferrals never
// bought
// =========================================================================

/// One dependent already reaped, held until the whole record has drained.
const Finished = struct {
    domain: []const u8,
    verb: cycle.Verb,
    count: u32,
    expect: u8,
    code: u8,
};

/// Folds one reaped outcome into the report, or names the mismatch.
pub fn judge_outcome(done: Finished, report_out: *Report) RunError!void {
    // invariant: a judged dependent always names its domain
    assert(done.domain.len >= 1);
    // invariant: the report never counts more successes than dependents reaped
    assert(run_of(report_out).succeeded <= run_of(report_out).reaped);
    if (done.code != done.expect) {
        print("    {s}: expected {s}, heard {s}\n", .{
            done.domain, outcome_name(done.expect), outcome_name(done.code),
        });
        return error.OutcomeMismatch;
    }
    if (done.code == carry.Outcome.carried_ok) {
        run_of(report_out).succeeded += 1;
        if (done.verb == .home) run_of(report_out).homed += done.count;
    }
}

/// The queue's own bookkeeping for one run, over dependents whose conferrals
/// may leave with them.
pub const Table = struct {
    live: [max_in_flight]cohort.Running = undefined,
    lines: [max_in_flight]Task = undefined,
    reserves: [max_in_flight]?Task = @splat(null),
    taken: [max_in_flight]u32 = @splat(0),
    served: [max_in_flight]u32 = @splat(0),
    granted: [max_in_flight]u32 = @splat(0),
    absorbed_mask: [max_in_flight]u32 = @splat(0),
    in_flight: u32 = 0,
    done: [max_queue_len]Finished = undefined,
    finished: u32 = 0,
    started: [max_queue_len]bool = @splat(false),
    record: [max_queue_len]unhand.Phase = undefined,
    reserve_of: [max_queue_len]?Task = @splat(null),
    held: u32 = 0,
    head: u32 = 0,
    left: u32 = 0,
    lost_mask: u32 = 0,
    bear_mask: u32 = 0,
};

/// The record as it stands right now.
pub fn standing(table: *const Table) []const unhand.Phase {
    // invariant: a record never outgrows the queue one supervisor may hold
    assert(table.held <= max_queue_len);
    return table.record[0..table.held];
}

/// Answers whether one phase of the record is still work waiting to run.
fn waits(table: *const Table, at: u32) bool {
    // invariant: a reading always names a phase inside the record
    assert(at < table.held);
    return !table.started[at];
}

/// Moves the head past every item already started.
pub fn advance_head(table: *Table) void {
    // invariant: a head never walks past the record it reads
    assert(table.head <= table.held);
    while (table.head < table.held and !waits(table, table.head)) table.head += 1;
}

/// Answers whether a phase of a turn this pick's turn names still waits.
pub fn elder_waits(table: *const Table, pick: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    const wanted = table.record[pick].follows_turns;
    if (wanted == 0) return false;
    var i: u32 = 0;
    while (i < table.held) : (i += 1) {
        if (i == pick) continue;
        if (!waits(table, i)) continue;
        if ((wanted & turn_bit(table.record[i].turn)) != 0) return true;
    }
    // invariant: the walk read the whole record, weighing every phase in it
    assert(i == table.held);
    return false;
}

/// Answers whether a sibling of this pick's own turn still waits behind it.
pub fn sibling_waits(table: *const Table, pick: u32, sibling_mask: u32) bool {
    // invariant: a pick always names a phase inside the record
    assert(pick < table.held);
    var i: u32 = 0;
    while (i < pick) : (i += 1) {
        if (!waits(table, i)) continue;
        if (table.record[i].turn != table.record[pick].turn) continue;
        if ((sibling_mask & mask.step_bit(table.record[i].step)) != 0) return true;
    }
    // invariant: the walk reached the pick, weighing every phase before it
    assert(i == pick);
    return false;
}

/// Answers whether the door admits this phase over the lines remembered.
pub fn door_admits(sys: *const system.System, table: *const Table, at: u32) RunError!bool {
    // invariant: a candidate always stands inside the record
    assert(at < table.held);
    // invariant: a run never remembers more lines than it may hold
    assert(table.in_flight <= max_in_flight);
    return admissible_in(
        sys,
        table.live[0..table.in_flight],
        table.lines[0..table.in_flight],
        table.reserves[0..table.in_flight],
        table.taken[0..table.in_flight],
        table.record[at].task,
    );
}

/// Answers whether a phase may be admitted ahead of the record's head.
fn may_pass(
    sys: *const system.System,
    table: *const Table,
    candidate: u32,
    reading: Reading,
) bool {
    // invariant: a pass always reaches forward, never at the head itself
    assert(candidate > table.head);
    // invariant: a candidate always stands inside the record
    assert(candidate < table.held);
    var i: u32 = table.head;
    while (i < candidate) : (i += 1) {
        if (!waits(table, i)) continue;
        if (items_contend(sys, table.record[i], table.record[candidate], reading)) return false;
    }
    // invariant: the walk reached the candidate, weighing every phase before it
    assert(i == candidate);
    return true;
}

/// Chooses one phase from behind a blocked head, or answers that none may go.
pub fn choose_pass(
    sys: *const system.System,
    table: *const Table,
    reading: Reading,
) RunError!?u32 {
    // invariant: a pass is only ever sought while the head stands blocked
    assert(table.head < table.held);
    // invariant: a pass never looks past the record it reads
    assert(table.head < max_queue_len);
    var looked: u32 = 0;
    var i: u32 = table.head + 1;
    while (i < table.held and looked < max_lookahead) : (i += 1) {
        if (!waits(table, i)) continue;
        looked += 1;
        if (!try door_admits(sys, table, i)) continue;
        if (!may_pass(sys, table, i, reading)) continue;
        return i;
    }
    // invariant: the look stayed inside the bound it was given
    assert(looked <= max_lookahead);
    return null;
}

/// Answers which standing dependent could carry this phase, if any could.
pub fn confer_slot(table: *const Table, at: u32) ?u32 {
    return ladder_checks.confer_slot(@This(), table, at);
}

/// Takes back the reach one standing dependent no longer needs, from the rung
/// below -- kept whole here, since a reclamation is what happens after it.
pub fn revoke_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    keep: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    // invariant: a revocation always names a dependent the run is holding
    assert(slot < table.in_flight);
    // invariant: a revocation never leaves more than one line may name
    assert(keep <= cycle.max_hops);
    if (revoke_rung.revoke_refusal(table.taken[slot], table.served[slot], keep)) |why| return why;
    const returning = table.taken[slot] - keep;
    // invariant: a revocation that reaches this point always returns reach
    assert(returning >= 1);
    try revoke(io, table.live[slot].domain, keep);
    if (!confirm_pruned(io, table.live[slot].domain, returning)) return error.RevokeUnpruned;
    table.taken[slot] = keep;
    table.served[slot] = keep;
    abandoning_of(report_out).inner.inner.revoked += returning;
}

/// Takes one departed dependent's conferral back whole, so a successor of its
/// domain opens its eyes on a bare wire.
///
/// The rung below reaches into a standing dependent's hands; this one reaches
/// into the wire the two of them spoke over, once the dependent that listened
/// is gone. `slot` names the reaped dependent, whose row still stands in the
/// table until the reaping closes over it.
pub fn reclaim_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reclaim_one(@This(), io, table, slot, report_out);
}

/// Hands one phase, and the reach it needs, to a dependent already standing --
/// then takes that reach back once the dependent answers that the work is done.
pub fn confer_one(
    io: std.Io,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    table: *Table,
    slot: u32,
    at: u32,
    keeping: Keep,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.confer_one(@This(), io, sys, caps, table, slot, at, keeping, report_out);
}

/// Starts one phase, handing the capability words this reach calls for and
/// promising the pruning this keep calls for.
pub fn start_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    phase: unhand.Phase,
    reserve: ?Task,
    keeping: Keep,
    wake: gap.Wake,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!cohort.Running {
    return ladder_checks.start_one(@This(), allocator, io, self_path, sys, caps, phase, reserve, keeping, wake, report_out);
}

/// Admits as much of the record as the table and the reading allow, and
/// answers how many phases it took up.
pub fn fill_table(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!u32 {
    return ladder_checks.fill_table(
        @This(), allocator, io, self_path, sys, caps, wake, reading, keeping, table, report_out,
    );
}

/// Records one departed dependent's abandoned reach, and reads the answer back.
///
/// The reclamation above has already swept this domain clean, so the count is
/// written after it rather than before -- otherwise the very act that closes
/// the conferral would erase the only evidence of what it cost. The answer is
/// read back from the wire before the report believes it.
pub fn abandon_one(
    io: std.Io,
    table: *Table,
    slot: u32,
    came_home: bool,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.abandon_one(@This(), io, table, slot, came_home, report_out);
}

/// Waits on the eldest dependent, takes back what it was conferred, answers for
/// the work that conferral never bought, and closes the table over its slot.
pub fn reap_oldest(
    io: std.Io,
    table: *Table,
    answer: Answer,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError)!void {
    return ladder_checks.reap_oldest(@This(), io, table, answer, report_out);
}

/// Seats everything a run stands on, and answers with the table it enforces.
///
/// One region store per declared region, one doorbell per declared channel,
/// one set of notes per declared domain, and the capability table derived from
/// the document itself -- all before a single dependent is spawned, so no
/// dependent ever finds a conferral, a bell, or a store left by an earlier run.
fn seat_the_ground(
    io: std.Io,
    sys: *const system.System,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError)!capabilities.CapabilityTable {
    // invariant: a run always seats a declaration that names regions
    assert(sys.map.region_count >= 1);
    // invariant: a run always seats a declaration that names domains
    assert(sys.graph.domain_count >= 1);
    const provisioned = try exercise.provision(io, sys);
    // invariant: every declared region has a backing store before any dependent runs
    assert(provisioned == sys.map.region_count);
    run_of(report_out).bells = try roundtrip.provision_directed(io, sys);
    const noted = try provision_notes(io, sys);
    // invariant: every declared domain has its notes before any conferral
    assert(noted == sys.graph.domain_count);
    const caps = try roster.from_system(sys);
    // invariant: the derived table enforces exactly what the document permits
    assert(roster.agrees(sys, &caps));
    return caps;
}

/// Reads a written plan into the table's own record, closed and seated.
///
/// The plan is flattened to the shape the rungs below read, weighed for order
/// and for the names it keeps, closed over its own turns, and its reserves
/// carried across -- all before a single dependent is spawned, so the record a
/// run enforces is the record its author wrote.
pub fn seat_the_record(base: []const Phase, table: *Table) RunError!void {
    // invariant: a record always seats a plan that names phases
    assert(base.len >= 1);
    // invariant: a record is always seated into a table that holds nothing yet
    assert(table.held == 0);
    var plainly: [max_queue_len]unhand.Phase = undefined;
    var p: u32 = 0;
    while (p < base.len) : (p += 1) plainly[p] = plain(base[p]);
    // invariant: every phase was read plainly, none skipped
    assert(p == base.len);
    const flat = plainly[0..base.len];
    if (!precede.plan_is_ordered(flat)) return error.OrderStalled;
    if (!plan_is_seated(flat)) return error.PlanUnseated;

    precede.close(flat, table.record[0..base.len]);
    table.held = @intCast(base.len);
    table.left = table.held;
    var r: u32 = 0;
    while (r < base.len) : (r += 1) {
        table.reserve_of[r] = base[r].reserve;
        // The bearing is read once, here, from the record its author wrote --
        // so every later question about which losses to carry is answered from
        // the plan rather than from anything the run learns along the way.
        if (base[r].bear) table.bear_mask |= phase_bit(r);
    }
    // invariant: every phase carried its reserve into the record, none lost
    assert(r == base.len);
    // invariant: a closed record closes to itself, so the door's work is done
    assert(precede.plan_is_closed(standing(table)));
}

/// Runs a record on the hearing receipt, answering for abandoned work as the
/// chosen answer says.
///
/// The supervisor every rung of this arc keeps -- fill the table, reap the
/// eldest, judge at the end -- with each later act folded in behind the one
/// below it, so a plan repairs what it lost, settles, corrects the reader that
/// settlement replaced, carries the correction to them, and finally reads what
/// that reader answered back.
pub fn run_in_dispute(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    base: []const Phase,
    wake: gap.Wake,
    reading: Reading,
    keeping: Keep,
    bearing: Bearing,
    standard: Standard,
    review: Review,
    notice: Notice,
    dispatch: Dispatch,
    receipt: Receipt,
    record: Standing,
    report_out: *Report,
) (roster.RosterError || exercise.ProvisionError || notify.BellError || NoteError || RunError || cohort.RunError || boot.BootError)!void {
    // invariant: a run always knows what program to spawn
    assert(self_path.len >= 1);
    // invariant: a run always reports into a fresh report
    assert(run_of(report_out).admitted == 0);
    if (base.len == 0) return error.EmptyQueue;
    if (base.len > max_queue_len) return error.QueueFull;

    var table: Table = .{};
    try seat_the_record(base, &table);

    const caps = try seat_the_ground(io, sys, report_out);
    run_of(report_out).queued = table.held;

    while (table.left > 0 or table.in_flight > 0) {
        const took_up = try fill_table(
            allocator, io, self_path, sys, &caps, wake, reading, keeping, &table, report_out,
        );
        if (table.in_flight > run_of(report_out).peak_in_flight) {
            run_of(report_out).peak_in_flight = table.in_flight;
        }

        if (table.left > 0) {
            const free = max_in_flight - table.in_flight;
            run_of(report_out).slots_unspent += free;
            if (took_up == 0 and free > 0) run_of(report_out).idle_turns += 1;
        }

        // With an empty table nothing conflicts, so a stall here would mean
        // the record named a domain the document does not.
        if (table.in_flight == 0) return error.OrderStalled;

        try reap_oldest(io, &table, .answered, report_out);
    }
    // invariant: the whole record was taken up, and every dependent reaped
    assert(table.left == 0);
    assert(table.in_flight == 0);
    assert(run_of(report_out).reaped == run_of(report_out).admitted);
    // invariant: every phase either started a dependent or was conferred to one
    assert(table.finished + abandoning_of(report_out).inner.inner.inner.inner.absorbed == table.held);

    var j: u32 = 0;
    while (j < table.finished) : (j += 1) try judge_outcome(table.done[j], report_out);
    // invariant: every reaped dependent was judged, none skipped
    assert(j == table.finished);

    // The reckoning stands exactly as the rung below wrote it, and always on
    // the reckoning ledger: a mend that repaired a plan under the assuming
    // reading would be repairing a loss it had already declared did not count.
    // What this rung adds to it is the recantation, weighed against the
    // judgment already standing on the wire before this run touches it.
    try reckon_the_plan(io, &table, .reckoned, review, report_out);

    // Every run here mends, since the question this rung asks opens inside the
    // repair rather than before it: what separates the two readings is which
    // of the plan's losses the repair is allowed to touch.
    try mend_the_plan(
        allocator, io, self_path, sys, &caps, base, wake, keeping, bearing, standard, review, &table, report_out,
    );

    // The correction the rung below writes, unchanged and still last of the
    // record's own work: a reader is owed the word the run actually ended on
    // rather than the word it held halfway through.
    try post_the_amendment(io, notice, report_out);

    // The journey the rung below makes, unchanged: a correction with somewhere
    // to go is carried to the place its reader was actually reached.
    try carry_the_amendment(io, dispatch, report_out);

    // The hearing the rung below makes, with one word changed: an answer counts
    // as heard only where the hand actually agrees, since an answer a plan
    // cannot accept is not an answer it heard.
    try hear_the_reader(io, receipt, report_out);

    // The record, and the whole of what this rung adds. It runs last of all,
    // because a run recording a disagreement before it has read any hand is
    // writing down a quarrel it invented.
    try record_the_dispute(io, receipt, record, report_out);
}

/// Reads back what the reader answered, and says whether the plan ever
/// listened.
///
/// The wire before the memory, one tier further out than every rung below:
/// this run reads the letter it carried out of the reader's own box, and then
/// reads that same reader's hand out of the box beside it. Neither reach
/// touches what the supervisor remembers doing, because a plan that heard its
/// reader agree from its own memory has agreed with itself.
///
/// A run that carried nothing owes nobody a hearing, and says so by weighing
/// nothing rather than by inventing a correspondent. A reader who wrote back
/// where the plan never listened is the number this rung moves; a reader who
/// never wrote at all is a silence no run can close, counted nowhere and
/// refused only where a run claims to have heard it.
fn hear_the_reader(io: std.Io, receipt: Receipt, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.hear_the_reader(@This(), io, receipt, report_out);
}

/// Records the disagreement its reader answered with, or sets that answer aside.
///
/// The wire before the memory, one tier further out than the hearing below it:
/// this run reads the letter out of the reader's own box, reads that reader's
/// own hand beside it, and writes the pair into its own record without ever
/// touching what the supervisor remembers doing. A plan that recorded its
/// reader's objection from its own memory of the correspondence would be
/// putting words in a person's mouth.
///
/// A run that carried nothing owes nobody a record, and says so by weighing
/// nothing rather than by inventing a quarrel. A reader who agreed is left
/// exactly as the rung below leaves them, agreed with and undisputed. Only a
/// reader who answered in a word this plan cannot accept is written down -- and
/// under `.settled` even that one is set aside, which is where the rung below
/// leaves every reader and precisely the number this rung moves.
fn record_the_dispute(
    io: std.Io,
    receipt: Receipt,
    record: Standing,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.record_the_dispute(@This(), io, receipt, record, report_out);
}

/// Answers the reader of a settlement this run has since replaced.
///
/// The wire before the memory, twice over: the word this run finally published
/// and the word an operator carried away are both read back here, outside the
/// folds that produced either, exactly as a person would read them. A supervisor
/// that corrected a reader from its own memory of the outcome would be writing a
/// second word nobody can check.
///
/// A plan nobody read owes nobody a correction, and says so by weighing nothing
/// rather than by inventing an audience. A reading this run still stands behind
/// is confirmed and left exactly where it is. Only a reading the settlement
/// contradicts is answered -- and under `.silent` even that one is left standing,
/// which is where the rung below leaves every reader and precisely the number
/// this rung moves.
fn post_the_amendment(io: std.Io, notice: Notice, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.post_the_amendment(@This(), io, notice, report_out);
}

/// Carries the correction this run posted to the place its reader was reached.
///
/// The wire before the memory, once more and one tier further out: the
/// correction this run published and the address its reader left are both read
/// back here, outside the fold that wrote either, exactly as the person each
/// was written for would read a letter and its envelope before setting out.
///
/// A run that posted no correction carries nothing, and says so by weighing
/// nothing rather than by inventing an errand. A reader who left no address
/// cannot be reached, and the run refuses by name rather than choosing a
/// destination on their behalf. Only a posted correction with somewhere to go
/// travels -- and under `.waiting` even that one stays where it was written,
/// which is where the rung below leaves every reader who does not come back,
/// and precisely the number this rung moves.
fn carry_the_amendment(io: std.Io, dispatch: Dispatch, report_out: *Report) (RunError || NoteError)!void {
    return ladder_checks.carry_the_amendment(@This(), io, dispatch, report_out);
}

/// Runs the arcs a plan lost that nobody spared, and answers for what is left
/// standing after.
///
/// The mend reads its own run's verdict back from the wire before it decides
/// anything, because a supervisor that repairs from memory is repairing a plan
/// it believes in rather than the one it published. A plan the wire calls
/// `carried` is refused outright -- there is nothing here to repair, and a
/// mend that ran anyway would re-do work already served.
///
/// **What this rung adds is the recantation, read from the same wire.** The
/// appraisal note names which losses a judgment spared -- and under `.stand`
/// that judgment may be older than this run, since the note is the one a run
/// never clears. The recant note names which of those judgments this run's own
/// record disproves. Under `.stand` the mend spares every appraised loss,
/// exactly as the rung below does. Under `.revisit` the recanted ones come back
/// into the repair, and the settlement moves with them -- from `borne`, which
/// tells an operator there is nothing left to do, to `carried`, which is true.
fn mend_the_plan(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    caps: *const capabilities.CapabilityTable,
    base: []const Phase,
    wake: gap.Wake,
    keeping: Keep,
    bearing: Bearing,
    standard: Standard,
    review: Review,
    table: *Table,
    report_out: *Report,
) (RunError || NoteError || cohort.RunError || boot.BootError)!void {
    return ladder_checks.mend_the_plan(
        @This(), allocator, io, self_path, sys, caps, base, wake, keeping, bearing, standard, review, table, report_out,
    );
}

/// Publishes what the plan came to and what that means, and reads both back.
///
/// The verdict below answers whether work is still standing; the settlement
/// answers what an operator should do about it. Both go to the wire and both
/// are read back before the report believes either, since a supervisor that
/// trusts its own memory of what it published has published nothing.
pub fn settle_the_plan(
    io: std.Io,
    lost: u32,
    served_again: u32,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.settle_the_plan(@This(), io, lost, served_again, report_out);
}

/// Weighs what the plan came to, publishes the verdict and the loss, and reads
/// the verdict back.
///
/// The reckoning waits until the last dependent has been reaped and every
/// abandonment already answered for, since a verdict taken any earlier would
/// judge work that may yet be carried. A plan that absorbed no phase into a
/// standing dependent is carried by the shape of its own record, and this rung
/// leaves it exactly there rather than inventing a judgment it cannot make.
///
/// What this rung adds to the one below is the **recantation beside the
/// appraisal**. The judgment already on the wire is read here, before anything
/// this run learned is written over it, and weighed against the judgment this
/// run's own record supports. Whichever way the plan asks its history to be
/// read, that reading is published while the run still holds the evidence for
/// it, and read back before the repair spares or seats a single phase.
fn reckon_the_plan(
    io: std.Io,
    table: *const Table,
    ledger: Ledger,
    review: Review,
    report_out: *Report,
) (RunError || NoteError)!void {
    return ladder_checks.reckon_the_plan(@This(), io, table, ledger, review, report_out);
}

// =========================================================================
// The dependent -- a walk that reads the wire before it trusts its own hands
// =========================================================================

/// Reads the capability words a dependent was handed at its spawn into its slot.
pub fn slot_from_argv(args: []const [:0]const u8, domain: []const u8, cap_count: u32) ?capabilities.DependentSlot {
    return ladder_checks.slot_from_argv(@This(), args, domain, cap_count);
}

/// Answers whether this dependent already holds a capability over one region.
pub fn already_holds(slot: *const capabilities.DependentSlot, region_name: []const u8) bool {
    // invariant: a holding is always asked about a named region
    assert(region_name.len >= 1);
    // invariant: a holding never reads past what one dependent may hold
    assert(slot.cap_count <= capabilities.max_caps_per_dependent);
    var i: u32 = 0;
    while (i < slot.cap_count) : (i += 1) {
        if (std.mem.eql(u8, slot.caps[i].name_slice(), region_name)) return true;
    }
    // invariant: the walk read every capability the dependent holds, none skipped
    assert(i == slot.cap_count);
    return false;
}

/// Names the word at one depth of a list, or answers that the list is shorter.
pub fn word_at(words: *const Words, index: u32) ?[]const u8 {
    // invariant: a word is only ever sought inside what one dependent may hold
    assert(index < capabilities.max_caps_per_dependent);
    var seen: u32 = 0;
    var lines = std.mem.splitScalar(u8, words.slice(), '\n');
    while (lines.next()) |one| {
        if (one.len == 0) continue;
        if (seen == index) return one;
        seen += 1;
    }
    return null;
}

/// Rebuilds a dependent's own hands as the line it was spawned with, plus the
/// leading `keep` conferred words.
pub fn prune_to(
    base: *const capabilities.DependentSlot,
    words: *const Words,
    keep: u32,
) ?capabilities.DependentSlot {
    return ladder_checks.prune_to(@This(), base, words, keep);
}

/// Counts the conferred arcs this dependent can touch, over one range.
pub fn reachable_between(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    words: *const Words,
    from: u32,
    to: u32,
) u32 {
    return ladder_checks.reachable_between(@This(), io, slot, words, from, to);
}

/// Counts the reach standing on the wire at this dependent's first breath.
///
/// The finding of this rung, made by the party that would be lying if it were
/// wrong -- and made without touching the hands the dependent actually works
/// with. The words standing for this domain are grafted into a *copy* of those
/// hands, and each arc is asked for.
///
/// **A conferral names the generation it was made to, and that is what makes
/// the count exact.** A supervisor may publish a word for this very dependent
/// between the spawn and this first breath, so *something standing here* is no
/// evidence at all. A word addressed to an **earlier** generation of this
/// domain is evidence, and it is the whole of what inherited reach means.
pub fn inherited_at_first_breath(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    domain: []const u8,
) u32 {
    return ladder_checks.inherited_at_first_breath(@This(), io, base, domain);
}

/// One dependent's own line, read arc by arc against the count it was handed.
///
/// Answers `null` when every arc stood as the plan said it would, and an
/// outcome code naming the first arc that did not.
pub fn read_own_line(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    task: cycle.Task,
) ?u8 {
    // invariant: a standing dependent always reads at least one arc
    assert(task.hops.count >= 1);
    // invariant: a line never names more arcs than one plan may carry
    assert(task.hops.count <= cycle.max_hops);
    var i: u32 = 0;
    while (i < task.hops.count) : (i += 1) {
        const stood = queue_store.read_index(io, slot, task.hops.name_at(i)) catch |err|
            return serve.reach_code(err);
        if (stood != task.count) return carry.Outcome.bytes_differed;
    }
    // invariant: every arc this dependent was handed was read, none skipped
    assert(i == task.hops.count);
    return null;
}

/// Grafts every conferred word as it arrives, reads each arc, and answers for
/// what it holds.
///
/// Answers the count grafted, or an outcome code where a word or an arc did
/// not stand. The dependent answers `.held` only after reading every arc it
/// grafted, which is what lets the supervisor read that answer as work served.
pub fn graft_promised_reach(
    io: std.Io,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    promised: u32,
    granted: *Words,
    carried_out: *u32,
) ?u8 {
    return ladder_checks.graft_promised_reach(@This(), io, slot, domain, task, promised, granted, carried_out);
}

/// Returns the reach a promised pruning asks back, and answers how much.
///
/// A dependent told a pruning is coming waits for the number that names it,
/// rebuilds its own hands down to that number, and answers. A `null` says the
/// words on the wire could not be read back into hands at all.
pub fn return_promised_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    granted: *const Words,
    carried: u32,
) ?u32 {
    return ladder_checks.return_promised_reach(@This(), io, base, slot, domain, granted, carried);
}

/// Reads the arcs this dependent was handed, then every arc it is conferred, and
/// returns the reach the run asks back before it comes home.
pub fn stand_taking_and_returning_reach(
    io: std.Io,
    base: *const capabilities.DependentSlot,
    slot: *capabilities.DependentSlot,
    domain: []const u8,
    task: cycle.Task,
    found: u32,
) u8 {
    return ladder_checks.stand_taking_and_returning_reach(@This(), io, base, slot, domain, task, found);
}

/// Runs as one supervised dependent, reading the wire before it trusts it.
fn run_dependent(io: std.Io, args: []const [:0]const u8) u8 {
    return ladder_checks.run_dependent(@This(), io, args);
}

// =========================================================================
// The lap -- one plan run twice against a reader who never comes back, once
// leaving the correction on the wire and once carrying it to them
// =========================================================================

/// The lap this rung runs, and the correction nobody carried is the whole of it.
///
/// Three clients stand over three arcs and carry a reserve of one, and the
/// phase behind each asks that same client to peek exactly the reserved arc --
/// so the run confers `menu` to a dependent already standing, three times.
/// Every author declares that their dependent falls, so each grafts the word,
/// answers for it, and falls holding it: three conferrals, three arcs nobody
/// served. None is marked, so the bearing has nothing to say about any of them.
///
/// The wire meets this plan already carrying a judgment -- `client_b`'s lost
/// peek, weighed spent by a run that is over -- and this run's own evidence
/// says otherwise, since the phase that would have spoken for that loss falls
/// holding its conferral. So both runs of this lap weigh the judgment again,
/// take it back, repair all three arcs, and settle the plan `carried`.
///
/// **And the wire meets this plan already carrying a reader who left an
/// address.** An operator read the elder run's settlement, carried away one
/// word -- `borne`, which says there is nothing left to do -- and left `desk`
/// as the place they could be found. Both runs of this lap post the correction
/// in that operator's own words, `bc`, and both clear the reading in the same
/// breath; the rung below is fully satisfied by either.
///
/// **What parts them is whether the correction ever travels.** Left waiting, it
/// stands on the wire where it was written, true and unread, and the operator
/// who does not come back keeps acting on a sentence the plan stopped standing
/// behind. Carried, the same two bytes land in `caravan/.readers/desk.told` --
/// outside this plan's wire entirely -- and the run reads them back out of that
/// box before it believes anybody was reached.
///
/// **The price is nothing but the walk.** Both runs spend the same six
/// dependents, repair the same three arcs, post the same correction, and settle
/// the same word. What parts them is whether it went anywhere.
pub const written_queue = [_]Phase{
    .{ .turn = 0, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_b", .verb = .stand, .hops = "board,ask_b,taken_b", .peers = "serial_virt,client_b", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 1, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_b", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 2, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_a", .verb = .stand, .hops = "board,ask_a,taken_a", .peers = "serial_virt,client_a", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 3, .step = 0, .follows = 0, .follows_turns = 0, .task = .{ .effects = "r", .item = .{ .domain = "client_a", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 4, .step = 0, .follows = 0, .follows_turns = 0, .reserve = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.carried_ok } }, .task = .{ .effects = "r,w,w", .item = .{ .domain = "client_c", .verb = .stand, .hops = "board,ask_c,taken_c", .peers = "serial_virt,client_c", .count = 0, .expect = carry.Outcome.bytes_differed } } },
    .{ .turn = 5, .step = 0, .follows = 0, .follows_turns = 2, .task = .{ .effects = "r", .item = .{ .domain = "client_c", .verb = .peek, .hops = "menu", .peers = "serial_virt", .count = 0, .expect = carry.Outcome.bytes_differed } } },
};

/// The judgment the wire already carries when this lap begins.
///
/// `client_b`'s lost peek, weighed spent by a run that is over. It is seated as
/// the record it is rather than produced by a first run of this plan, because
/// what a run does with a judgment it did not make is the whole subject here --
/// and because a judgment arrives on the wire exactly this way whether the run
/// that wrote it finished a minute ago or a season ago.
const standing_judgment: u32 = 1 << 1;

/// The word an operator already carried away when this lap begins.
///
/// `borne` -- whole but for a loss the plan itself asked to carry, which tells a
/// reader there is nothing left to do. It is exactly what the rung below's
/// standing review published, and it is seated as the record it is rather than
/// produced by a first run of this plan, because what a run owes a reader it
/// did not write to is the whole subject here -- and because a reading arrives
/// on the wire exactly this way whether the person who took it read a minute ago
/// or a season ago.
const standing_reading: Settlement = .borne;

/// The place the reader who took that word can be found.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading is: an address arrives on the wire beside a reading
/// whether the person who left it read a minute ago or a season ago. `desk`
/// names a place outside this plan's own wire, which is the entire distance
/// this rung exists to close.
const standing_address = "desk";

// =========================================================================
// Self-test
// =========================================================================

/// Loads one declaration, or names why it could not be read.
fn load_one(io: std.Io, path: []const u8, buf: []u8) ?system.System {
    const parsed = read.load(io, path, buf) catch |err| {
        print("  RED: {s} refused: {s}\n", .{ path, @errorName(err) });
        return null;
    };
    if (parsed.verify() != .whole) {
        print("  RED: {s} did not read whole\n", .{path});
        return null;
    }
    return parsed;
}

/// The mend below, read straight, so this rung's own fold stands on a repair
/// that still refuses everything it always refused.
pub fn check_mending() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return hearing_rung.check_mending();
}

/// The bearing and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a bearing is
/// weighed, the work it weighs, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `BearOverrepaired`, belongs
/// to the run rather than the fold, since only the wire can answer what a plan
/// published about its own obedience.
pub fn check_bearing() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return hearing_rung.check_bearing();
}

/// The recantation and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a standing
/// judgment is weighed again, the supply it may reach, and the honesty of its
/// count answered as a pure fold -- the closed record, the loss, the judgment on
/// the wire, and the judgment this run supports are the whole of the input, and
/// no process appears anywhere. The fourth refusal, `RecantUnspoken`, belongs to
/// the run rather than the fold, since only the wire can answer what a run
/// published about its own reversal.
pub fn check_recantation() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return hearing_rung.check_recantation();
}

/// The amendment and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a reading is
/// answered, the supply it may reach, and the honesty of its count answered as a
/// pure fold -- the word an operator holds and the word this run settled are the
/// whole of the input, and no process appears anywhere. The fourth refusal,
/// `AmendUnspoken`, belongs to the run rather than the fold, since only the wire
/// can answer whether a correction actually reached the place it was read.
pub fn check_amendment() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return hearing_rung.check_amendment();
}

/// The delivery and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a correction is
/// carried, the address it may be carried to, and the honesty of its count
/// answered as a pure fold -- no process anywhere. The fourth refusal,
/// `CourierUndelivered`, belongs to the run rather than the fold, since only a
/// reader's own box can answer whether anything actually arrived in it.
pub fn check_delivery() u8 {
    // The rung below owns this check and everything it calls, so this
    // rung runs it there rather than carrying a second copy of it.
    return hearing_rung.check_delivery();
}


/// The reading the reader answers with, in their own hand.
///
/// `short` -- a word neither this run's correction nor their own elder reading
/// names. The operator was told `borne`, this run carried them `carried`, and
/// they answered that they hold the plan **short**: whole work was left undone.
/// That is a reader disagreeing plainly, in their own vocabulary, about the one
/// thing the correspondence was ever about.
///
/// Seated as the record it is rather than produced by a run, for the same
/// reason the reading and the address are: a hand arrives in a reader's box
/// whether that person answered a minute ago or a season ago, and **no run of
/// this plan ever writes it**. A supervisor that wrote its reader's answer for
/// them would be agreeing with itself.
const standing_hand: Settlement = .short;

/// The hearing below, still weighed, and now under the stricter question this
/// rung hands it.
///
/// Every rung of this arc keeps weighing the rungs beneath it, so a change that
/// quietly stopped one of them moving is caught in the same breath as the new
/// work. What this fold reads is the rung below's own count with `agreed` in
/// place of `answered`: an agreeing hand closes the correspondence, and a
/// disagreeing one leaves the hearing exactly where it stood.
pub fn check_hearing() u8 {
    const letter = [2]Settlement{ .borne, .carried };
    if (heard_in(1, true, .asked) != 1) {
        print("  RED: an agreeing hand went unheard by a listening run\n", .{});
        return 1;
    }
    if (heard_in(1, false, .asked) != 0) {
        print("  RED: a disagreeing hand counted as an agreement\n", .{});
        return 1;
    }
    if (unheard_in(1, false, .asked) != 1) {
        print("  RED: a correction its reader disputed counted as heard\n", .{});
        return 1;
    }
    if (!hand_agrees(letter, .carried)) {
        print("  RED: a hand naming this run's own word read as disagreement\n", .{});
        return 1;
    }
    if (hand_agrees(letter, .short)) {
        print("  RED: a hand naming a word nobody carried read as agreement\n", .{});
        return 1;
    }
    // A plan that listened and could not accept what it heard has still
    // listened, so the rung below's own loss reads zero here: the harm has
    // moved up a tier, into the record this rung keeps.
    if (carried_unheard(1, false, .asked) != 0) {
        print("  RED: a listening run counted as one that never listened\n", .{});
        return 1;
    }
    if (carried_unheard(1, true, .unasked) != 1) {
        print("  RED: an answer read by nobody counted as nothing\n", .{});
        return 1;
    }
    print("  a plan publishes whether it hears what its reader answers\n", .{});
    return 0;
}

/// The record and its three standing refusals, read straight, before any
/// dependent runs.
///
/// The happy zone of this rung: every question about the moment a run records,
/// the hand it records for, and the honesty of its count answered as a pure
/// fold -- no process anywhere. The fourth refusal, `DisputeUnfounded`, is
/// answered here too, since whether two readings differ is a question two words
/// can settle between themselves.
pub fn check_dispute() u8 {
    // The two halves of the count, so the equality can be read straight.
    if (recorded_in(1, false, .open) != 1) {
        print("  RED: a reader who disagreed went unrecorded by an open record\n", .{});
        return 1;
    }
    if (recorded_in(1, false, .settled) != 0) {
        print("  RED: a settled record held a disagreement all the same\n", .{});
        return 1;
    }
    if (recorded_in(1, true, .open) != 0) {
        print("  RED: a reader who agreed was written down as disputing\n", .{});
        return 1;
    }
    if (recorded_in(0, false, .open) != 0) {
        print("  RED: a run that read no answer recorded one anyway\n", .{});
        return 1;
    }
    if (unwritten_in(1, false, .settled) != 1) {
        print("  RED: an answer set aside counted as written down\n", .{});
        return 1;
    }
    if (unwritten_in(1, false, .open) != 0) {
        print("  RED: a recorded disagreement still counted as set aside\n", .{});
        return 1;
    }

    // Whether a pair of readings is a disagreement at all.
    if (!founded(.{ .carried, .short })) {
        print("  RED: two readings that differ read as agreement\n", .{});
        return 1;
    }
    if (founded(.{ .carried, .carried })) {
        print("  RED: one reading named twice read as a disagreement\n", .{});
        return 1;
    }

    // The refusals, each reached by the shape that earns it.
    if (dispute_refusal(null, false, 1, 0)) |why| {
        if (why != error.DisputeEarly) {
            print("  RED: a record with no answer refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run recorded a quarrel with a reader who never wrote\n", .{});
        return 1;
    }
    if (dispute_refusal(.short, true, 1, 0)) |why| {
        if (why != error.DisputeUnfounded) {
            print("  RED: a record of an agreeing hand refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run recorded a disagreement its reader never had\n", .{});
        return 1;
    }
    if (dispute_refusal(.short, false, 1, 1)) |why| {
        if (why != error.DisputeMiscounted) {
            print("  RED: a record counted twice refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer recorded and set aside at once went uncounted\n", .{});
        return 1;
    }
    if (dispute_refusal(.short, false, 0, 0)) |why| {
        if (why != error.DisputeMiscounted) {
            print("  RED: a record counted nowhere refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: an answer neither recorded nor set aside went uncounted\n", .{});
        return 1;
    }
    if (dispute_refusal(.short, false, 0, 1)) |why| {
        print("  RED: a record inside its own count refused with {s}\n", .{@errorName(why)});
        return 1;
    }
    if (unheard_record(false, 1)) |why| {
        if (why != error.DisputeUnheard) {
            print("  RED: a record with no hand refused with {s}\n", .{@errorName(why)});
            return 1;
        }
    } else {
        print("  RED: a run wrote down an objection nobody voiced\n", .{});
        return 1;
    }
    if (unheard_record(true, 1)) |why| {
        print("  RED: a record inside its own supply refused with {s}\n", .{@errorName(why)});
        return 1;
    }

    // The number this rung moves, as a fold: an answer this run read in a
    // reader's own hand and set aside without a trace.
    if (answered_unrecorded(1, false, .settled) != 1) {
        print("  RED: an answer set aside counted as nothing\n", .{});
        return 1;
    }
    if (answered_unrecorded(1, false, .open) != 0) {
        print("  RED: an answer this run recorded still counted as set aside\n", .{});
        return 1;
    }
    if (answered_unrecorded(0, false, .settled) != 0) {
        print("  RED: a run that read no answer owed a record all the same\n", .{});
        return 1;
    }
    if (answered_unrecorded(1, true, .settled) != 0) {
        print("  RED: a reader who agreed counted as one this run set aside\n", .{});
        return 1;
    }

    print("  a plan publishes whether its record may hold a disagreement\n", .{});
    print("  three refusals stand by name: early, unheard, miscounted\n", .{});
    print("  the standing this rung keeps: {s}\n", .{standing_words(.open)});
    return 0;
}

/// Runs one queue whole under one standing, against a judgment, a reading, an
/// address, and a reader's own hand all four already standing, and says whether
/// it survived.
///
/// All four are seated before the run rather than after, since each is a record
/// a run does not clear and a run must find them exactly where the hand that
/// wrote them left them. The reader's box is emptied of the plan's own letter
/// first, so a lap that means to prove a delivery starts from a reader who is
/// genuinely waiting -- and the reader's answer is seated **by this harness
/// standing in for them**, never by the supervisor, since a plan that writes
/// its own objection has quarrelled with itself. Every run of this lap revisits
/// the judgment, posts the correction, carries it, and listens; what the two
/// runs disagree about is whether the record keeps what they heard.
fn run_one(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
    plan: []const Phase,
    record: Standing,
    report_out: *Report,
) bool {
    seat_standing_appraisal(io, @intCast(plan.len), standing_judgment) catch |err| {
        print("  RED: a judgment could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_reading(io, standing_reading) catch |err| {
        print("  RED: a reading could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    seat_standing_address(io, standing_address) catch |err| {
        print("  RED: an address could not be seated on the wire: {s}\n", .{@errorName(err)});
        return false;
    };
    empty_box(io, standing_address);
    // The reader's own hand, written by the reader rather than by any run.
    answer_as_reader(io, standing_address, standing_hand) catch |err| {
        print("  RED: a reader could not answer in their own hand: {s}\n", .{@errorName(err)});
        return false;
    };
    run_in_dispute(
        allocator, io, self_path, sys, plan, .when_moved, .preceded, .held_on, .borne, .weighed, .revisit, .posted, .carried, .asked, record, report_out,
    ) catch |err| {
        print("  RED: a queue did not survive its run: {s}\n", .{@errorName(err)});
        return false;
    };
    return true;
}

/// Tells what the two standings did, side by side, in an operator's own words.
fn tell_dispute_runs(settled: *Report, open_record: *Report) void {
    // invariant: a telling always reads two runs that were actually run
    assert(run_of(settled).queued >= 1);
    // invariant: a telling never reports more dependents than a repair may add
    assert(run_of(open_record).reaped <= run_of(open_record).queued + max_queue_len);
    print("  phases: {d} settled, {d} open\n", .{
        run_of(settled).queued, run_of(open_record).queued,
    });
    print("  dependents: {d} settled, {d} open\n", .{
        run_of(settled).reaped, run_of(open_record).reaped,
    });
    print("  phases absorbed into a standing dependent: {d} settled, {d} open\n", .{
        abandoning_of(settled).inner.inner.inner.inner.absorbed,
        abandoning_of(open_record).inner.inner.inner.inner.absorbed,
    });
    print("  abandoned reach, conferred and never served: {d} settled, {d} open\n", .{
        abandoning_of(settled).abandoned, abandoning_of(open_record).abandoned,
    });
    print("  phases re-seated to carry what was lost: {d} settled, {d} open\n", .{
        below_of(settled).reseated, below_of(open_record).reseated,
    });
    print("  standing judgments taken back on this run's own evidence: {d} settled, {d} open\n", .{
        recanting_of(settled).recanted, recanting_of(open_record).recanted,
    });
    print("  readings corrected where they were read: {d} settled, {d} open\n", .{
        amending_of(settled).amended, amending_of(open_record).amended,
    });
    print("  corrections carried to the place their reader was reached: {d} settled, {d} open\n", .{
        couriering_of(settled).delivered, couriering_of(open_record).delivered,
    });
    print("  answers read in the reader's own hand that this run could accept: {d} settled, {d} open\n", .{
        hearing_of(settled).heard, hearing_of(open_record).heard,
    });
    print("  disagreements written into the record: {d} settled, {d} open\n", .{
        settled.recorded, open_record.recorded,
    });
    print("  answers this run read and set aside without a record: {d} against {d}\n", .{
        settled.unrecorded, open_record.unrecorded,
    });
    print("  work still standing when the supervisor exits: {d} settled, {d} open\n", .{
        below_of(settled).unserved, below_of(open_record).unserved,
    });
    print("  the plan, as an operator finally reads it: {s} settled, {s} open\n", .{
        settlement_words(bearing_of(settled).settlement), settlement_words(bearing_of(open_record).settlement),
    });
    print("  breaks a named turn: {d} settled, {d} open\n", .{
        preceded_of(settled).out_of_precede, preceded_of(open_record).out_of_precede,
    });
}

/// Weighs the two standings against each other and names the first disagreement.
///
/// The shape of the finding is one number moving and the price of moving it
/// named honestly beside it -- and here the price is two bytes written into a
/// note the run already knew the name of. Both runs take up the same record,
/// confer the same arcs, lose the same arcs, take the same judgment back,
/// repair the same three phases, spend the same dependents, post the same
/// correction, carry it to the same reader, read that reader's own answer, and
/// settle the plan `carried`. What differs is whether the record keeps what
/// that reader said.
fn judge_dispute_runs(settled: *Report, open_record: *Report) u8 {
    // invariant: a judging always reads two runs that were actually run
    assert(run_of(settled).queued >= 1);
    // invariant: a judging never counts a repair the plan never lost
    assert(below_of(open_record).reseated <= max_queue_len);
    if (run_of(open_record).queued != run_of(settled).queued) {
        print("  RED: the two standings ran {d} phases against {d}\n", .{
            run_of(open_record).queued, run_of(settled).queued,
        });
        return 1;
    }
    if (abandoning_of(open_record).abandoned != abandoning_of(settled).abandoned) {
        print("  RED: the two standings lost {d} arcs against {d}\n", .{
            abandoning_of(open_record).abandoned, abandoning_of(settled).abandoned,
        });
        return 1;
    }
    if (abandoning_of(open_record).abandoned < 3) {
        print("  RED: the lap lost {d} arcs, and this rung needs three beneath it\n", .{
            abandoning_of(open_record).abandoned,
        });
        return 1;
    }
    // Every rung below still moves under both standings, since a record keeps
    // an answer rather than composing one.
    if (recanting_of(settled).recanted != 1 or recanting_of(open_record).recanted != 1) {
        print("  RED: a revisiting run took back {d} judgments against {d}\n", .{
            recanting_of(settled).recanted, recanting_of(open_record).recanted,
        });
        return 1;
    }
    if (amending_of(settled).amended != 1 or amending_of(open_record).amended != 1) {
        print("  RED: a posting run corrected {d} readings against {d}\n", .{
            amending_of(settled).amended, amending_of(open_record).amended,
        });
        return 1;
    }
    if (couriering_of(settled).delivered != 1 or couriering_of(open_record).delivered != 1) {
        print("  RED: a carrying run delivered {d} corrections against {d}\n", .{
            couriering_of(settled).delivered, couriering_of(open_record).delivered,
        });
        return 1;
    }
    // The hearing below, which a disagreeing hand leaves exactly where it
    // stood: an answer this plan cannot accept is not an answer it heard.
    if (hearing_of(settled).heard != 0 or hearing_of(open_record).heard != 0) {
        print("  RED: a disagreeing hand counted as {d} agreements against {d}\n", .{
            hearing_of(settled).heard, hearing_of(open_record).heard,
        });
        return 1;
    }
    if (below_of(settled).reseated != below_of(open_record).reseated) {
        print("  RED: the two standings repaired {d} phases against {d}\n", .{
            below_of(settled).reseated, below_of(open_record).reseated,
        });
        return 1;
    }
    if (below_of(settled).unserved != 0 or below_of(open_record).unserved != 0) {
        print("  RED: a run that repaired every disproved loss left work standing\n", .{});
        return 1;
    }
    if (bearing_of(settled).settlement != .carried or bearing_of(open_record).settlement != .carried) {
        print("  RED: a plan whose every lost arc was served settled {s}\n", .{
            settlement_words(bearing_of(open_record).settlement),
        });
        return 1;
    }
    // The record itself.
    if (settled.recorded != 0) {
        print("  RED: a settled record held {d} disagreements all the same\n", .{settled.recorded});
        return 1;
    }
    if (open_record.recorded != 1) {
        print("  RED: an open record held {d} disagreements rather than the one\n", .{
            open_record.recorded,
        });
        return 1;
    }
    // The number this rung moves.
    if (settled.unrecorded != 1) {
        print("  RED: an answer set aside without a record counted as {d}\n", .{settled.unrecorded});
        return 1;
    }
    if (open_record.unrecorded != 0) {
        print("  RED: an open record still set {d} answers aside\n", .{open_record.unrecorded});
        return 1;
    }
    // The price of keeping a reader's disagreement, named rather than hidden:
    // no work at all, and two bytes written into a note the run already knew
    // the name of.
    if (run_of(open_record).reaped != run_of(settled).reaped) {
        print("  RED: recording a disagreement cost {d} dependents against {d}\n", .{
            run_of(open_record).reaped, run_of(settled).reaped,
        });
        return 1;
    }
    if (preceded_of(open_record).out_of_precede != 0) {
        print("  RED: the recording run broke {d} turn orders its author named\n", .{
            preceded_of(open_record).out_of_precede,
        });
        return 1;
    }
    return 0;
}

/// The dispute lap: one plan run twice against a reader who answered in a word
/// the plan cannot accept, once setting that answer aside and once keeping it.
pub fn check_dispute_runs(
    allocator: std.mem.Allocator,
    io: std.Io,
    self_path: []const u8,
    sys: *const system.System,
) u8 {
    var settled: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .settled, &settled)) return 1;
    // What an operator reads is what the wire carries, read here outside the run
    // that wrote it.
    const settled_said = settlement_published(io) orelse {
        print("  RED: a run published no settlement at all\n", .{});
        return 1;
    };
    if (settled_said != .carried) {
        print("  RED: the wire read {s} where every lost arc was served\n", .{
            settlement_words(settled_said),
        });
        return 1;
    }
    // The correction arrived in the reader's own box under both standings, and
    // the reader answered it under both: what parts them is the record.
    const settled_box = delivered_to(io, standing_address) orelse {
        print("  RED: a settled run left the reader's box empty\n", .{});
        return 1;
    };
    if (settled_box[0] != standing_reading or settled_box[1] != .carried) {
        print("  RED: the reader's box named the wrong two readings\n", .{});
        return 1;
    }
    const settled_hand = answered_by(io, standing_address) orelse {
        print("  RED: the reader's own answer left their box\n", .{});
        return 1;
    };
    if (settled_hand != standing_hand) {
        print("  RED: a run rewrote the hand its reader answered with\n", .{});
        return 1;
    }
    // The whole harm this rung repairs, read straight off the wire: a reader
    // objected plainly, and the record kept no trace of it.
    if (dispute_recorded(io) != null) {
        print("  RED: a settled record held a disagreement on the wire\n", .{});
        return 1;
    }

    var open_record: Report = .{};
    if (!run_one(allocator, io, self_path, sys, &written_queue, .open, &open_record)) return 1;
    const open_said = settlement_published(io) orelse {
        print("  RED: a recording run published no settlement at all\n", .{});
        return 1;
    };
    if (open_said != .carried) {
        print("  RED: the wire read {s} where every lost arc was served\n", .{
            settlement_words(open_said),
        });
        return 1;
    }
    // The reader's hand still stands in their own box afterward, in their own
    // word: a run records an answer and never edits one.
    const open_hand = answered_by(io, standing_address) orelse {
        print("  RED: a recording run emptied the hand it read\n", .{});
        return 1;
    };
    if (open_hand != standing_hand) {
        print("  RED: a recording run rewrote its reader's own answer\n", .{});
        return 1;
    }
    // The record this rung exists to keep, read outside the run that wrote it:
    // two readings, the plan's and its reader's, and nothing resolving them.
    const held_pair = dispute_recorded(io) orelse {
        print("  RED: an open record kept no disagreement at all\n", .{});
        return 1;
    };
    if (held_pair[0] != .carried or held_pair[1] != standing_hand) {
        print("  RED: the record named the wrong two readings\n", .{});
        return 1;
    }
    if (!founded(held_pair)) {
        print("  RED: the record named one reading twice and called it a dispute\n", .{});
        return 1;
    }
    if (reading_published(io) != null) {
        print("  RED: a reading that had its answer was left waiting on the wire\n", .{});
        return 1;
    }

    tell_dispute_runs(&settled, &open_record);
    const judged = judge_dispute_runs(&settled, &open_record);
    if (judged != 0) return judged;

    // invariant: a run reaps exactly the dependents it admitted, never more
    assert(run_of(&open_record).reaped == run_of(&open_record).admitted);
    // invariant: a run never records more disputes than answers it read
    assert(open_record.recorded <= 1);
    // invariant: an open record sets no answer of its reader aside
    assert(open_record.unrecorded == 0);
    return 0;
}


fn run_self_test(allocator: std.mem.Allocator, io: std.Io, self_path: []const u8) u8 {
    print("Caravan dispute {s} -- self-test\n", .{caravan_dispute_version});
    var buf: [read.read_buffer_bytes]u8 = undefined;
    const sys = load_one(io, declaration_path, &buf) orelse return 1;

    const mending = check_mending();
    if (mending != 0) return mending;
    const bearing = check_bearing();
    if (bearing != 0) return bearing;
    const recanting = check_recantation();
    if (recanting != 0) return recanting;
    const amending = check_amendment();
    if (amending != 0) return amending;
    const delivering = check_delivery();
    if (delivering != 0) return delivering;
    const hearing = check_hearing();
    if (hearing != 0) return hearing;
    const unlost = ladder_checks.check_unlost(@This(), &sys);
    if (unlost != 0) return unlost;
    const disputing = check_dispute();
    if (disputing != 0) return disputing;
    const runs = check_dispute_runs(allocator, io, self_path, &sys);
    if (runs != 0) return runs;
    print("  GREEN: a reader who answers something other than agreement is recorded\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const args = try init.minimal.args.toSlice(allocator);
    const io = init.io;
    // invariant: a program always knows its own path
    assert(args.len >= 1);
    const self_path = args[0];

    if (args.len >= fixed_argv_words and std.mem.eql(u8, args[1], "dependent")) {
        return run_dependent(io, args);
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_self_test(allocator, io, self_path);
    }
    if (args.len >= 2) return 1;
    return run_self_test(allocator, io, self_path);
}
