# outside protocol, vendor, or coreutils-only verifier fixes it -- so the open question was never
# WHICH hash but whether any seal is read. Holds unread at zero, reads past dated testimony, a bare
# fingerprint, and an outsider's quoted published value.
guard sealed_digest
