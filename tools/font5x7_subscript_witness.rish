# tools/font5x7_subscript_witness.rish -- the open subscript-digits corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora and the wider-symbol corpora that opened next (the box, arrow, block, geometric, math, and currency
# witnesses) and the Greek letters (tools/font5x7_greek_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn subscript-digits corpus: the ten small digits a formula
# lowers -- the numbers a chemical formula sets below the line (H(2)O, CO(2)), a footnote marks with, or a math surface
# indexes a term by -- at their real contiguous Unicode codepoints U+2080..U+2089, each a 5x7 coverage grid drawn in
# the open as ASCII line art in image/font5x7_subscript.rye, built into a gfa1 atlas and proven on metal. A full
# round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all ten digits look up present and
# carry the shared advance while a full-height ASCII digit misses; no two digits share coverage; each reads within an
# honest legibility band; every digit sits low (the top two rows blank) so it reads as a subscript; and the family
# order holds -- the dense subscript eight out-inks the sparse subscript one. Compression is reported as a fact, never
# asserted -- the round-trip is the proof. No network, no key, no funds -- the small digits a surface sets low the day
# it prints a formula, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_subscript_witness.rish

say "font5x7-subscript: Language EN -- Season G font content; the ten subscript digits (zero through nine) drawn in the open as small low ASCII line art, built into the gfa1 atlas, the numbers a formula sets below the line (H(2)O, CO(2))."
say "font5x7-subscript: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every digit byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-subscript: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - subscript_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints derived from an explicit base and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_subscript"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_subscript.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-subscript: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-subscript: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-subscript: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-subscript' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-subscript: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-subscript: round-trip was not byte-identical"

say "font5x7-subscript: GREEN -- the open subscript-digits corpus whole; ten small low digits round-trip byte-identical, all present, distinct, legible, and lowered, the dense eight out-inking the sparse one; the font gains the numbers a surface sets below the line when it prints a formula."
