# tools/mycelium_till_bron_witness.rish — the treasury verdict travels as a record (Till r2).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · Till rung r2 — travel.
# r1 resolved a Cord's agreed order into a Till — which draws took coins, which came up short. A verdict a
# node cannot hand to another is only a local reading, so r2 lets a resolved Till cross as a
# `format till-v1` record and back, byte-for-byte, the recovered verdict reporting the identical draws and
# loss and the identical supply.
#
# The crux this witness proves: render the r1 contested verdict (two keepers each drew 700 from a treasury
# of 1000; the agreed order paid one, supply folded to 200, one draw came up short) to a record, parse it
# back, and the recovered Till gives the identical draw count, loss, coins drawn/lost, and supply; re-rendering
# is a fixed point. A purpose-built bounded reader refuses whole: a bad header (BadFormat), an unknown field
# (UnknownField), a bad hex key (BadHex), a broken supply law (BadInt), a missing supply line (BadFormat),
# an over-long verdict (TooManyDraws). Composes till.rye + fold.rye public API only. Demo keeper seeds — no key held.
#
# Scope: active-designing/20260813-064129_mycelium-till-double-spend-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_till_bron_witness.rish

say "mycelium-till-bron: Language EN — the treasury verdict crosses to a stranger as readable bytes, unchanged."
say "mycelium-till-bron: Style Radiant — the Cord wove one order through the dark; the Till read who was paid; now the reading travels whole."
say "mycelium-till-bron: Lens TAME — a purpose-built bounded reader, never a general parser; every refusal whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/till_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/till_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-till-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-till-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-till-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte" else "mycelium-till-bron: round-trip claim missing"
assert selftest.out contains "answers the identical draws and loss" else "mycelium-till-bron: verdict-unchanged claim missing"
assert selftest.out contains "each refuse" else "mycelium-till-bron: refusal claim missing"

# The Till whose verdict travels stands at the door — its own selftest proves the verdict this record carries.
let till = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/till.rye -femit-bin=mycelium/bin/till && mycelium/bin/till 2>&1"]
assert till.ok else "mycelium-till-bron: the Till whose verdict travels is not GREEN"
assert till.out contains "GREEN" else "mycelium-till-bron: the Till did not speak its GREEN"

say "mycelium-till-bron: GREEN — the resolved verdict travels as a format till-v1 record and returns byte-for-byte, the recovered draws and loss unchanged, every malformed record refused; the Till stands at the door."
