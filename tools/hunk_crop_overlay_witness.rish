# tools/hunk_crop_overlay_witness.rish — outline the crop rectangle on the picture, on metal (HUNK61).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK61.
# Design read: active-designing/date/20260813/20260813-222800_hunk-crop-gesture-exploration.md ("The road on from here").
# Teacher, thanked clean-room: the crop overlay of a photo app (iCloud Photos / Google Photos) — the picture stays
# visible and a bright rectangle frames the region a keeper will keep as they drag (concept only, siloed).
#
# HUNK60 turned a drag into a .crop edit that lived only in numbers; this rung paints it. crop_overlay down-maps the
# source into a Skate grid (HUNK2) and draws the rectangle's OUTLINE over it — border cells wear a bright slot, the
# interior keeps showing the picture. A pure read over HUNK2 down_map and HUNK60 CropGesture.rect; a degenerate
# rectangle refuses NoRect. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_crop_overlay_witness.rish

say "hunk-crop-overlay: Language EN — HUNK61 outlines the crop rectangle on the down-mapped picture; border cells wear a bright slot, the interior keeps the picture."
say "hunk-crop-overlay: Style Radiant — a keeper finally sees the region they will keep, framed on glass, before they lift; the outline is a frame, not a fill."
say "hunk-crop-overlay: Lens TAME — a pure read over HUNK2 down_map and HUNK60 CropGesture.rect; the outline lands by down_map's own partition, a degenerate rectangle refuses NoRect and a too-large grid folds GridTooLarge through; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/crop_overlay"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/crop_overlay.rye -femit-bin=${bin}"]
assert build.ok else "hunk-crop-overlay: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-crop-overlay: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe or brace in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-crop-overlay: ${out}"

assert out contains "GREEN crop-overlay" else "hunk-crop-overlay: selftest did not print the GREEN crop-overlay line"
assert out contains "every one of its 12 border cells wears crop_slot while every interior and exterior cell equals a plain down_map cell-for-cell (a frame, not a fill, no drift)" else "hunk-crop-overlay: the outline was not a drift-free frame"
assert out contains "the overlay rasterizes to a lit canvas" else "hunk-crop-overlay: the overlay did not reach the glass"
assert out contains "a one-cell-wide rectangle is all border (a thin frame)" else "hunk-crop-overlay: a thin rectangle was not all border"
assert out contains "a degenerate rectangle refuses NoRect" else "hunk-crop-overlay: a degenerate rectangle did not refuse NoRect"
assert out contains "a grid past the ceiling folds down_map's GridTooLarge through" else "hunk-crop-overlay: a too-large grid did not fold GridTooLarge through"

say "hunk-crop-overlay: GREEN — the crop rectangle is outlined over the down-mapped picture (a drift-free frame, not a fill), rasterizing lit, drawing a thin rectangle all-border, refusing a degenerate rectangle NoRect and folding down_map's GridTooLarge through; no network, no key, no funds."
