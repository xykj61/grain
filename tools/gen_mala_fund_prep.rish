# tools/gen_mala_fund_prep.rish — Constellation m1–m4: Mala fund prep generator.
#
# Affirms Aries fire seat, maintainer duty, n-of-12 plan (lexicon only),
# requires Comlink → Amphora → Glow → Aurora/AppImage host lane,
# refuses deploy / live multisig / aurora-deploy verbs,
# post-fold: amphora_lap1 + glow_run cast-u32.
#   rishi/bin/rishi run tools/gen_mala_fund_prep.rish
#   rishi/bin/rishi run tools/gen_mala_fund_prep.rish deploy         # RED
#   rishi/bin/rishi run tools/gen_mala_fund_prep.rish aurora-deploy  # RED

say "gen-mala: Language EN — Mala fund prep (Aries fire · maintainer of MALA · Aurora close)."
say "gen-mala: Style Radiant — GREEN only after Comlink, Amphora, Glow, and Aurora doors open."
say "gen-mala: Lens TAME — prep and plan only; no wallet, gas, live multisig, or aurora-deploy."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_mala_fund_prep.sh" verb]
assert prep.ok else "gen-mala REFUSE or stack door failed — see stderr for deploy/wallet/gas/multisig-live/aurora-deploy refusals"
assert prep.out contains "GREEN: gen-mala" else "gen-mala prep helper missing GREEN line"
assert prep.out contains "Framework AMD x86_64" else "gen-mala Aurora host lane unnamed"
assert prep.out contains "Mala m1–m4 CLOSED" else "gen-mala Mala arc close line missing"
say prep.out

# m2 — Amphora lap 1 post-fold
let lap1 = run ["sh" "-c" "rishi/bin/rishi run tools/amphora_lap1.rish"]
assert lap1.ok else "gen-mala Amphora door regress: amphora_lap1 left GREEN"
assert lap1.out contains "GREEN" else "gen-mala Amphora lap 1 missing GREEN"

# m3 — Glow stdlib post-fold (cast-u32)
let glow = run ["sh" "-c" "rishi/bin/rishi run tools/glow_run.rish glow/gen/cast-u32.glow"]
assert glow.ok else "gen-mala Glow door regress: cast-u32 left GREEN"
assert glow.out contains "GREEN" else "gen-mala Glow cast-u32 missing GREEN"

say "GREEN: gen-mala m4 — Mala arc closed; Amphora·Glow post-fold GREEN; Aurora/AppImage Framework lane named; aurora-deploy RED by name."
