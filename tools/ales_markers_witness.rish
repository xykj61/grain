# tools/ales_markers_witness.rish — the markers track, named positions a keeper navigates and snaps to (ALES20).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES20.
# Design read: active-designing/20260814-fill-ales20-lotus-markers.md
# Stands on: lotus/scrub.rye (ALES19) — the scrub's move_to reused whole for snap; lotus/loop.rye (ALES14) — loop.make reused whole
# for the region between two markers; lotus/pan.rye (ALES10) — the StereoClip whose two channels share one length.
#
# lotus/markers.rye turns a raw sample index into a named place — the verse, the chorus, the edit point. The crux: a markers track
# keeps its named positions SORTED and UNIQUE, so the nearest-marker query returns the true nearest named place in one ordered
# pass, and a scrub SNAPPED to it lands exactly there. Composing ALES14, the region between two markers is exactly the loop
# [pos_i, pos_j). The selftest proves: markers added out of order stay strictly ascending and unique; nearest returns the true
# nearest with ties to the lower position; a scrub snaps exactly onto the nearest marker; a marker carries its name back byte-for-
# byte; region_between drives a real armed loop; every edge refuses Duplicate / PastEnd / BadName / MarkersFull / NoMarkers /
# BadPair by name. Purely local — no network, no keys, no funds, no real device, no real meter.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_markers_witness.rish

say "ales-markers: Language EN — ALES20 turns a raw sample index into a NAMED place: a bounded, sorted track of markers a keeper navigates by name, snaps a scrub to, and loops between."
say "ales-markers: Style Radiant — the law is stated positively: a markers track keeps its named positions sorted and unique, so the nearest named place is always well-defined and a snap lands exactly there."
say "ales-markers: Lens TAME — ALES19's move_to and ALES14's loop.make reused whole (no new read, no new region math); the track is a bounded fixed array (max_markers), each name a bounded fixed array (max_name), the sorted insert and nearest scan proven to terminate; every edge refuses by name; read-only over the master; siloed to lotus/, no network, no keys, no funds, no device, no meter, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/markers"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/markers.rye -femit-bin=${bin}"]
assert build.ok else "ales-markers: build failed — ${build.err}"

let outfile = "lotus/bin/markers.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-markers: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-markers: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-markers' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-markers: selftest did not print the GREEN ales-markers line"

say "ales-markers: GREEN — a keeper reads the master by name: markers stay sorted and unique, a scrub snaps to the nearest named place, and a loop is the region between two marks. The next Lotus rung can carry markers into real time through the ALES5 clock (the twin of loop.mark_ms), offer the choice of law where a crossfade meets a marked edit, or (a module seam) a punch region armed between two markers, tying playback back to the Mikrophone's capture."
