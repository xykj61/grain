# caravan_mend_witness.rish -- Caravan mend witness.
#
# `reckon.rye` taught a run to weigh its own plan and say `short` when an arc it
# absorbed bought nothing. The verdict goes to the wire, an operator reads it
# after the supervisor exits, and the run returns. Nobody acts on it.
#
#   A PLAN REPORTED SHORT IS RUN AGAIN FOR EXACTLY WHAT IT LOST.
#
# A supervisor that reads its own short verdict and does nothing has learned the
# truth and changed nothing by learning it -- the plan is still short, and now
# it is short on the record.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO REDRESSES DISAGREE ON IS WORK STILL STANDING when the
#     supervisor exits. The five counts before it weigh reach a dependent held
#     or a claim a supervisor made; this weighs an arc of a plan nobody carried.
#     An overclaim is repaired by saying less. This is repaired only by doing
#     more. It falls from 1 to 0.
#   * EVERY OTHER NUMBER STANDS STILL, including the loss itself and the first
#     verdict. Both runs take up 4 phases, confer 1 arc, reclaim 1 conferral,
#     absorb 1 phase, lose 1 arc, and both report the plan SHORT when they
#     first weigh it -- the reckoning below is unchanged. What moves is what is
#     left standing at the end.
#   * THE PRICE IS NAMED RATHER THAN HIDDEN. A repair costs exactly the
#     dependents its lost phases call for: 3 against 4, one more, never two.
#     The lap asserts that cost rather than reporting it quietly.
#   * A MEND SEATS FROM THE RECORD, NEVER FROM MEMORY. The verdict says THAT a
#     plan fell short; a repair needs to know WHERE, and the answer lives in a
#     table that is gone the moment the run returns. So the run writes a loss
#     note beside the verdict -- one glyph per phase, `x` where an absorbed arc
#     was never served -- and this witness reads it off the wire itself.
#   * THE REPAIR IS BOUNDED BY THE LOSS. It seats exactly the phases the wire
#     names, each freed of the arrangement it was written for, since the
#     dependent they were conferred into is gone. A repair that could grow into
#     a re-run would redo work the plan actually carried.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE MEND RATHER THAN THE PLAN.
#     `MendUnread` is the record: a mend that read no verdict, or read a short
#     verdict naming no phase, is acting on memory. `MendWhole` is the plan: a
#     plan the wire calls carried has nothing here to repair. `MendOvereach` is
#     the reach: a repair may never seat more than the plan lost. `MendUnserved`
#     is the answer -- the hard half -- since a run that published CARRIED with
#     an arc still standing would report a repair nobody made.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 9 pairs -- this
#     arc's standing generalization test.
#
# Six RED paths were proven on metal before this witness claimed GREEN.
# Withhold the loss note and the plan reports short while naming no phase it
# lost. Let the mend seat from its own memory rather than the wire and it
# refuses `MendUnread`. Disarm the whole-plan refusal and a carried plan falls
# through to a mend that can seat nothing. Let the repair seat every phase
# rather than the lost ones and `unserved_after` refuses to compute a number
# from a repair that carried more than the plan ever lost. Count the loss as
# untouched while publishing CARRIED and the run refuses `MendUnserved`.
# Withhold the settled verdict from the wire and the run refuses the same way,
# rather than trusting a judgment it never read back.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ca/caravan_mend_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/mend"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/mend.rye -femit-bin=${bin}"]

assert build.ok else "caravan mend build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/mend_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/mend_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero, every bell
# starts silent, and no run reads the last run's loss note for a plan this one
# has not finished.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.mends"]
assert clean.ok else "the region stores, doorbells, and mending notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan mend selftest exited non-zero"
assert test.out contains "GREEN" else "caravan mend selftest not GREEN"
assert test.out contains "a plan reported short is run again for exactly what it lost" else "the mending finding did not close"

# The mend and its three standing refusals, read straight, before any dependent
# runs. The fourth, `MendUnserved`, belongs to the run rather than the fold,
# since only the wire can answer what a plan published once the repair is over.
assert test.out contains "a verdict says a plan fell short, never where, and a mend needs where" else "the mending fold was not weighed"
assert test.out contains "three refusals stand by name: unread, whole, overreaching" else "the three standing refusals did not stand"

# The reckoning below, unchanged and still weighed here.
assert test.out contains "a drained record says every phase was taken up, never that every phase was served" else "the reckoning below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 9 pairs" else "an unlost plan did not read as the line handed"

# The mending lap: one plan run twice, once reporting the loss it took and once
# running again for exactly the arcs it lost. Every number stands still except
# the work left standing -- and the one extra dependent the repair costs, which
# is named rather than hidden.
assert test.out contains "phases: 4 reporting, 4 mending" else "the two redresses ran different records"
assert test.out contains "dependents: 3 reporting, 4 mending" else "the repair did not cost exactly one more dependent"
assert test.out contains "reach conferred: 1 reporting, 1 mending" else "the two redresses conferred different reach"
assert test.out contains "conferrals reclaimed: 1 reporting, 1 mending" else "the two redresses reclaimed different conferrals"
assert test.out contains "phases absorbed into a standing dependent: 1 reporting, 1 mending" else "the two redresses absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 1 reporting, 1 mending" else "the two redresses lost different work"
assert test.out contains "the plan, as the run first reports it: short by the work nobody served reporting, short by the work nobody served mending" else "the two redresses first weighed the plan differently"
assert test.out contains "phases re-seated to carry what was lost: 0 reporting, 1 mending" else "the repair was not bounded by the loss"
assert test.out contains "work still standing when the supervisor exits: 1 against 0" else "the reporting run and the mending run agreed about what was left"
assert test.out contains "the plan, once the repair has had its turn: short by the work nobody served reporting, carried out whole mending" else "the repair did not settle the plan"
assert test.out contains "breaks a named turn: 0 reporting, 0 mending" else "the mending run broke an order its author named"

# What an operator reads is what the wire carries. Both notes are read here,
# outside the run that wrote them, exactly as an operator would read them.
let settled = run ["sh" "-c" "cat caravan/.mends/plan.verdict"]
assert settled.ok else "the plan published no settled verdict an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried verdict the repair earned"

let lost_note = run ["sh" "-c" "cat caravan/.mends/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.." else "the wire did not name the one phase the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the repair's own dependent stands on its own line with no
# conferral to ride in on.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "the falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent the conferral was made to did not read it as its own"
assert test.out contains "client_a: read 3 arcs of its own, 0 inherited at its first breath, 0 conferred, 0 returned, 0 still reachable at home" else "the dependent that came home read a conferral it was never made"

say "GREEN: Caravan mend witness passed."
