# caravan_replace_witness.rish -- Caravan replace witness.
#
# `withdraw.rye` gave a waiting phase a door out and named its own limit: a
# run may now grow and prune, so a plan could be corrected only by doing both
# in sequence. A correction is the commonest change there is -- this phase is
# the right phase in the wrong shape -- and it was the one change the arc
# could not make.
#
#   A RUN MAY CORRECT A PHASE IN ONE ACT, AND BOTH TRIPLES ARE WEIGHED
#   AGAINST THE RECORD THAT HOLDS NEITHER.
#
# The departure owes its three facts to the record as it stands: the phase
# still waits, its step is the last one its turn holds, and no phase in the
# record names its turn. The arrival owes its three to the RESIDUE -- the
# record holding neither the departing phase nor the newcomer.
#
# WHAT THE CORRECTION BUYS, AND WHAT IT COSTS, MEASURED:
#
#   * THE COMMONEST CORRECTION IS REFUSED BY A RECORD STILL HOLDING THE PHASE
#     IT REPLACES. Same turn, same step, different work: a plan that still
#     holds turn 2 counts one step of that turn standing, the newcomer offers
#     step zero, and the door closes on the very change it was built to make.
#     The residue takes the same newcomer without complaint. Both readings
#     are run against each other rather than asserted.
#   * A CORRECTION KEEPS THE SLOT, AND A SEQUENCE CANNOT. Correcting the
#     third of seven phases moves 0 places in one act, against 5 places moved
#     by the withdrawal-then-arrival that reaches the same set -- an arrival
#     lands at the tail, so the correction ends up behind every phase its
#     author wrote after it.
#   * THE RESIDUE SEATS ITSELF, WHICH IS WHAT MAKES THE GAP DANGEROUS. The
#     record between a withdrawal and its arrival answers every reading a
#     supervisor knows how to ask, so nothing in the machinery can tell a
#     half-finished correction from a finished plan. One act never opens it.
#   * ONE REFUSAL THIS RUNG EARNS: `ReplacementUnseated`. A phase may name
#     only turns below its own, so turn 7 following turn 6 is lawful at the
#     tail of the residue and unlawful in the third place, where it names a
#     turn standing four places after it. No reading of the newcomer alone
#     could have told. The departure's own three refusals carry through by
#     name -- `WithdrawalMissing`, `WithdrawalStarted`, `WithdrawalUnseated`.
#   * A CORRECTION COSTS TWO WALKS: 32 tests against 256 to seat the plan
#     again -- twice what an arrival, an enlistment, or a withdrawal each
#     spend. Printed from the bounds themselves rather than typed into prose.
#   * A CORRECTION MOVES NOTHING, in the strongest form this arc has reached.
#     A withdrawal keeps the length and leaves a hole; an enlistment grows
#     the tail. A correction does neither: 7 places handed whole, 7 places
#     corrected while running, and 7 dependents reaped either way -- the run
#     does different work without doing more or less of it.
#   * A PLAN CORRECTING A PHASE TO ITSELF IS THAT PLAN, all 7 phases -- this
#     arc's standing generalization test, one tier further out.
#
# THE LIMIT IS NAMED: a correction reaches only work still waiting. A dependent
# already running is never recalled and a phase already home is never
# rewritten. Whether a run may correct a phase a dependent is RUNNING -- letting
# the work in flight finish under the shape it started with while the record
# already reads the new one -- belongs to the vision room until a witness
# binds it.
#
# Both RED paths were proven on metal before this witness claimed GREEN.
# Weigh the arrival against the record still holding the phase, and the pure
# read reds at "a phase nobody waits on was refused its correction" -- the
# finding, shown as a failure. Drop the slot's own seating check, and a phase
# naming a turn behind it is seated anyway.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ca/caravan_replace_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/replace"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/replace.rye -femit-bin=${bin}"]

assert build.ok else "caravan replace build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs once ran a shared caravan/bin/read without building it, so the whole
# arc was green only on a tree some earlier run had left warm. A witness owns what it
# runs -- and, since REDS %133, the path it runs it from: eighty witnesses built that
# one reader to one name, so two running at once contended for a single file and the
# loser reddened a green tree. This one lands in caravan/bin/replace_read.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/replace_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# Nothing new is declared: a run corrects a phase rather than adding one, and
# the document still speaks only in ceilings.
let published = run ["sh" "-c" "caravan/bin/replace_read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan replace selftest exited non-zero"
assert test.out contains "GREEN" else "caravan replace selftest not GREEN"
assert test.out contains "a run may correct a phase in one act, and both triples read the record that holds neither" else "the replace finding did not close"

# The correction read straight, before any supervisor spends it.
assert test.out contains "a record still holding the phase refuses its own correction, and the residue takes it" else "the two records were not weighed against each other"
assert test.out contains "a correction costs at most 32 tests, against 256 to seat the plan again" else "the cost of a correction was not reported honestly"

# What the slot buys, measured against the sequence that reaches the same set.
assert test.out contains "a correction moves 0 places of a plan of 7, against 5 moved by the sequence" else "the slot a correction keeps was not measured"
assert test.out contains "the residue between a withdrawal and its arrival seats itself, so nothing can tell it apart" else "the lawfulness of the gap was not shown"

# The generalization test: a phase replaced by itself is the plan again.
assert test.out contains "a plan correcting a phase to itself is that plan, all 7 phases" else "a correction to itself did not return the plan"

# The correction lap: one plan run twice, handed whole and rewritten as it runs.
assert test.out contains "breaks a named turn: 0 handed whole, 0 corrected while running" else "the corrected run did not keep the order its author named"
assert test.out contains "dependents: 7 handed whole, 7 corrected while running" else "a correction changed how much work the run did"
assert test.out contains "record: 7 places handed whole, 7 places corrected while running" else "a correction changed the length of the record"
assert test.out contains "1 phases were corrected in a run already under way" else "no phase was corrected in flight"

say "GREEN: Caravan replace witness passed."
