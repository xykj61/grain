# caravan_appraise_witness.rish -- Caravan appraise witness.
#
# `bear.rye` taught a plan to name the loss it would rather carry than repair.
# That word is a judgment made BEFORE the run, and it is the right place for
# it. Yet a bearing can only speak about what its author could foresee.
#
#   A LOSS ITS AUTHOR LEFT UNMARKED IS WEIGHED BY WHAT CAME HOME AFTER IT.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO STANDARDS DISAGREE ON IS ARCS RE-RUN FOR WORK THE PLAN
#     ALREADY GOT PAST. The rung below weighs OBEDIENCE: work a run did after
#     its author asked it not to. This weighs JUDGMENT: work a run did that its
#     author never spoke to, and that the run's own evidence says nobody
#     needed. It falls from 1 to 0.
#   * THE PLAN COMES OUT COMPLETE EITHER WAY, which is exactly why nothing
#     below this rung could see it. Both runs take up 5 phases, absorb 2 into
#     standing dependents, lose 2 arcs, mark none of them, and report the plan
#     SHORT when they first weigh it. What the elder standard spent to reach
#     `carried` was one more dependent, 5 against 4.
#   * A PLAN PUBLISHES THE STANDARD BY WHICH ITS OWN SILENCES ARE READ. The
#     standard is plan-level, since it is a statement about a whole record
#     rather than one arc, and one word an author writes once is a word an
#     author can mean.
#   * THE EVIDENCE IS THE PLAN'S OWN DOWNSTREAM, AND ONLY THE RUN PRODUCES IT.
#     `client_c` waits behind turn 1 and comes home, so the work behind
#     `client_b`'s lost peek stood up without it. Nothing follows `client_a`'s
#     lost peek, so no evidence speaks for it and it is repaired -- custody
#     first reads no evidence as repair.
#   * THE APPRAISAL STANDS ON THE WIRE BESIDE THE LOSS AND THE BEARING. One
#     glyph per phase, `w` where an unmarked loss was weighed spent -- `.w...`
#     names which phase of five the run judged the plan had got past, and this
#     witness reads it there rather than trusting the run's telling.
#   * AN AUTHOR'S OWN WORD OUTRANKS ANY RULE ABOUT THEIR SILENCES. A phase its
#     author marked never reaches the standard at all.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE JUDGMENT RATHER THAN THE
#     REPAIR IT BOUNDS. `AppraiseEarly` is the moment: a standard applied
#     before the run published what it lost is judging from memory.
#     `AppraiseMarked` is the authority. `AppraiseMiscounted` is the honesty of
#     the count: every lost arc is marked, weighed, or repaired, never two of
#     those and never none. `AppraiseUnweighed` is the answer -- a repair that
#     seats a phase its own appraisal spared is stopped by name before it
#     spawns.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Six RED paths were proven on metal before this witness claimed GREEN.
# Withhold the appraisal note and the weighing run repairs every loss and
# settles carried out whole. Let the repair seat a phase its own appraisal
# spared and it refuses `AppraiseUnweighed` before it spawns anything. Let the
# count stop closing and a loss neither marked, weighed, nor repaired passes
# unminded. Disarm the moment and a standard is applied before the run
# published anything. Disarm the authority and a standard reaches a phase its
# author had already marked. Let a marked phase into the fold itself and the
# fold's own invariant fires at `appraised_in`.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ca/caravan_appraise_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/appraise"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/appraise.rye -femit-bin=${bin}"]

assert build.ok else "caravan appraise build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/appraise_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/appraise_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero, every bell
# starts silent, and no run reads the last run's appraisal for a plan this one
# has not finished.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.appraisals"]
assert clean.ok else "the region stores, doorbells, and appraisal notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan appraise selftest exited non-zero"
assert test.out contains "GREEN" else "caravan appraise selftest not GREEN"
assert test.out contains "a loss its author left unmarked is weighed by what came home after it" else "the appraisal finding did not close"

# The appraisal and its three standing refusals, read straight, before any
# dependent runs. The fourth, `AppraiseUnweighed`, belongs to the run rather
# than the fold, since only the wire can answer what a run published about its
# own judgment.
assert test.out contains "a plan publishes the standard by which its own silences are read" else "the appraisal fold was not weighed"
assert test.out contains "three refusals stand by name: early, marked, miscounted" else "the three standing refusals did not stand"

# The bearing below, unchanged and still weighed here.
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The appraising lap: one plan run twice, once repairing every unmarked loss
# and once weighing them by what came home after. Every number stands still
# except judgment -- and the one extra dependent the elder standard spends on
# work the plan had already got past.
assert test.out contains "phases: 5 repairing, 5 weighing" else "the two standards ran different records"
assert test.out contains "dependents: 5 repairing, 4 weighing" else "re-running a spent loss did not cost exactly one more dependent"
assert test.out contains "phases absorbed into a standing dependent: 2 repairing, 2 weighing" else "the two standards absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 2 repairing, 2 weighing" else "the two standards lost different work"
assert test.out contains "the plan, as the run first reports it: short by the work nobody served repairing, short by the work nobody served weighing" else "the two standards first weighed the plan differently"
assert test.out contains "phases re-seated to carry what was lost: 2 repairing, 1 weighing" else "the repair was not bounded by the appraisal"
assert test.out contains "losses its author marked, carried rather than repaired: 0 repairing, 0 weighing" else "a lap that marked nothing carried a marked loss"
assert test.out contains "losses weighed spent and carried on the run's own evidence: 0 repairing, 1 weighing" else "the weighing run carried the wrong number of losses"
assert test.out contains "arcs re-run for work the plan already got past: 1 against 0" else "the two standards agreed about judgment"
assert test.out contains "arcs re-run against the plan's own word: 0 repairing, 0 weighing" else "a lap that marked nothing disobeyed its author"
assert test.out contains "work still standing when the supervisor exits: 0 repairing, 1 weighing" else "the two standards left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole repairing, whole but for the loss its author chose to carry weighing" else "the settlement did not part the two readings"
assert test.out contains "breaks a named turn: 0 repairing, 0 weighing" else "the weighing run broke an order its author named"

# What an operator reads is what the wire carries. Every note is read here,
# outside the run that wrote it, exactly as an operator would read them.
let settled = run ["sh" "-c" "cat caravan/.appraisals/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "b" else "the wire did not carry the borne settlement the plan earned"

let appraisal_note = run ["sh" "-c" "cat caravan/.appraisals/plan.appraisal"]
assert appraisal_note.ok else "the plan published no appraisal an operator could read"
assert appraisal_note.out contains ".w..." else "the wire did not name the one phase this run weighed spent"

let borne_note = run ["sh" "-c" "cat caravan/.appraisals/plan.bearing"]
assert borne_note.ok else "the plan published no bearing an operator could read"
assert borne_note.out contains "....." else "the wire named a phase in a lap whose author marked none"

let lost_note = run ["sh" "-c" "cat caravan/.appraisals/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x." else "the wire did not name the two phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that speaks for a loss stands on its own line.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_a: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the second dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that speaks for the weighed loss never came home"

say "GREEN: Caravan appraise witness passed."
