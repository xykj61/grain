# caravan_apprise_witness.rish -- Caravan apprise witness.
#
# `redress.rye` opened the last door: a meeting finally says what it came to.
# An admission is taken up, receipted, taken down, and answered -- and every byte
# of that finding is written where only the plan looks.
#
#   THE READER WHO WON AN ADMISSION IS TOLD WHAT THE LOOK FOUND.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO PLANS DISAGREE ON IS FINDINGS A PLAN REACHED WHOSE
#     RAISER WAS NEVER TOLD. Both runs open holding the same debt an earlier run
#     booked, both carry the same case to the same desk, both read the same
#     hand's answer, both publish the same finding, both take it on the record,
#     both meet the admission and take it down, and both say what the look came
#     to. What parts them is whether the person who raised the quarrel in the
#     first place ever hears a word of it. It falls from 1 to 0.
#   * A FINDING IS CARRIED WHERE THE READER IS, in the box they already know:
#     `caravan/.readers/desk.found`, beside the letter this arc carried them, the
#     question it asked them, and the word it already sent about how their
#     quarrel came out. A reader who has heard from this plan three times hears
#     from it a fourth in the place they already look.
#   * THE FINDING TRAVELS BYTE FOR BYTE, AND NEVER A SUMMARY OF ITSELF. The
#     redress standing on the plan's own wire is what lands in the box -- the
#     meeting reported on and the upshot the plan reached, unchanged -- so the
#     reader reads the same three bytes a later run of the plan will read.
#     `AppriseMismatched` refuses a delivery carrying anything else, and it is
#     the rung itself, refused by name on metal.
#   * A FINDING REACHES A PERSON OR IT REACHES NOBODY. A plan that never wrote
#     down where its reader was cannot carry anything to them, and inventing a
#     correspondent would be worse than the silence -- `AppriseUnaddressed`
#     refuses by name on metal rather than guessing at a box.
#   * THE PLAN'S OWN NOTE STAYS EXACTLY WHERE THE REDRESS LEFT IT. An apprising
#     carries a finding outward rather than moving one, so both stand together:
#     the record where the next run reads it, and the delivery where its reader
#     does. Both are read here, side by side, and they carry the same bytes.
#   * A DELIVERY SURVIVES A PROVISIONING, AND LEAVES THE PLAN'S OWN NOTE WHERE IT
#     STANDS -- proven as its own fold, since a delivery swept every morning
#     would leave its reader holding an answer that vanished before they read it.
#   * A PLAN THAT MET NOTHING REPORTS ON NOTHING, and so carries nothing; a plan
#     inheriting nothing meets nothing; each proven on the wire as its own run.
#   * APPRISING IS NOT REDRESSING TWICE, AND IT IS NOT RE-DECIDING ANYTHING. Both
#     runs settle `carried out whole`, both leave the quarrel standing where its
#     holder left it, both leave the age at 4 and the standing loud, both leave
#     the same case on the same desk, both publish the same finding, both take it
#     on the record, both leave today's own concession owing nothing, both meet
#     the inherited debt and take it down, and both say what the look found.
#   * FIVE REFUSALS THIS RUNG EARNS, matching the five below it. `AppriseUnfound`
#     is the moment a delivery is made at all: a run whose wire carries no
#     finding has nothing to carry to anybody. `AppriseUnaddressed` is whether
#     there is a person to carry it to. `AppriseMismatched` is the whole point.
#     `AppriseMiscounted` is the honesty of the count: every finding reached is
#     carried or withheld, never both and never neither. `AppriseMisrecorded` is
#     the record, read back out of the reader's own box rather than out of the
#     plan's memory of having written it.
#   * EVERY RUNG BELOW STILL STANDS, each carried whole. A plan that loses nothing
#     still reads as the line handed, all 16 pairs, this arc's standing
#     generalization test one tier further out.
#
# Six RED paths were proven on metal before this witness claimed GREEN. Skip the
# write and keep the read-back armed and the run refuses `AppriseMisrecorded`.
# Read the finding as absent and it refuses `AppriseUnfound`. Let this rung's own
# address read empty while every rung below is satisfied and it refuses
# `AppriseUnaddressed`. Carry some other look's finding and it refuses
# `AppriseMismatched` -- the rung itself. Count one finding as both carried and
# kept and it refuses `AppriseMiscounted`. Disarm every guard at once -- the write
# skipped, the read-back dropped, and the harness's own two reads removed -- and
# the selftest calls itself GREEN while `caravan/.readers/desk.found` does not
# exist at all, so an operator would believe a reader had been told what nobody
# ever wrote to them. Seeing that is what makes the reading back a check rather
# than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ca/caravan_apprise_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/apprise"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/apprise.rye -femit-bin=${bin}"]

assert build.ok else "caravan apprise build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/apprise_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/apprise_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the boxes
# outside it. Every quarrel, every finding, and every debt this witness reads was
# seated by the lap itself, standing in for the runs that met this argument
# before today.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.apprises caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and outside boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan apprise selftest exited non-zero"
assert test.out contains "GREEN" else "caravan apprise selftest not GREEN"
assert test.out contains "the reader who won an admission is told what the look found" else "the apprise finding did not close"

# The apprising and its five refusals, read straight, before any dependent runs.
assert test.out contains "five refusals stand by name: unfound, unaddressed, mismatched, miscounted, misrecorded" else "the five apprise refusals did not stand"
assert test.out contains "the plan says what its look found, and carries it to the reader who won it" else "an apprising plan did not read as one"
assert test.out contains "the plan says what its look found, and tells nobody who asked" else "a withholding plan did not read as one"
assert test.out contains "a delivery carries the finding whole: the meeting reported on, and what the look came to" else "a delivery did not name what it carries"

# The property that makes a delivery worth making, proven as its own fold: it
# outlives the run that carried it, and it leaves the plan's own note standing.
assert test.out contains "a delivery survives a provisioning, and leaves the note it copies where it stands" else "a delivery was never proven past a provisioning"

# The redress and its five refusals, read straight, before any dependent runs.
assert test.out contains "five refusals stand by name: unmet, unrighted, mismatched, miscounted, misrecorded" else "the five redress refusals did not stand"
assert test.out contains "the plan meets the debt it inherited, and never says what it found" else "a hollow plan did not read as one"
assert test.out contains "the plan meets the debt it inherited, and says what the look came to" else "a redressing plan did not read as one"
assert test.out contains "a redress carries three bytes: the meeting reported on, and what the look came to" else "a redress did not name what it carries"
assert test.out contains "the plan looked at what it conceded, and put the work right" else "the stronger upshot did not read as one"
assert test.out contains "the plan looked at what it conceded, and found the work sound" else "the honest other upshot did not read as one"

# The property that makes a finding worth writing, proven as its own fold: it
# outlives the run that reached it, and it falls with the meeting it reports on.
assert test.out contains "a finding survives a provisioning, and falls with the meeting it reports on" else "a finding was never proven past a provisioning"

# The meeting below it, unchanged and still weighed.
assert test.out contains "five refusals stand by name: unowed, unsettled, mismatched, miscounted, misrecorded" else "the five meet refusals did not stand"
assert test.out contains "the plan opens holding a debt, and closes still holding it" else "a bare plan did not read as one"
assert test.out contains "the plan meets the debt it inherited, and takes it down" else "a meeting plan did not read as one"
assert test.out contains "a receipt carries two bytes: the debt met, echoed back exactly as it stood" else "a receipt did not name what it carries"

# The property that makes a receipt worth writing, proven as its own fold: it
# outlives the run that made it, and the debt it answers does not come back.
assert test.out contains "a receipt survives a provisioning, and the debt it answers stays down" else "a receipt was never proven past a provisioning"

# The ending this rung reaches by writing nothing at all, on the wire.
assert test.out contains "a plan inheriting nothing meets nothing, and writes no receipt" else "a plan holding no debt was credited with meeting one"

# The owing below it, unchanged and still weighed.
assert test.out contains "five refusals stand by name: unsaid, unconceded, mismatched, miscounted, misrecorded" else "the five owe refusals did not stand"
assert test.out contains "the plan concedes, and owes nothing when the run is over" else "the owing below stopped being weighed"
assert test.out contains "a debt carries two bytes: the finding conceded, and the outcome conceded under" else "a debt did not name what it carries"
assert test.out contains "a debt survives a provisioning, and falls with the concession it carries" else "a debt was never proven past a provisioning"
assert test.out contains "a plan keeping its own word owes the work nothing, and books nothing" else "a dissenting plan was made to owe the work a look"
assert test.out contains "a plan that says nothing concedes nothing, and books nothing" else "a silent plan left a debt standing anyway"

# The avowing below it, unchanged and still weighed.
assert test.out contains "five refusals stand by name: unheard, unfound, mismatched, miscounted, misrecorded" else "the five avow refusals did not stand"
assert test.out contains "an avowal carries two bytes: the finding it answers, and the plan's word on it" else "an avowal did not name what it carries"
assert test.out contains "the plan takes the finding, and says the work is owed another look" else "a plan conceding did not read as one"
assert test.out contains "a word survives a provisioning, and falls with the finding it answers" else "a word was never proven past a provisioning"

# The three endings the rungs below reach by publishing nothing, each on the wire.
assert test.out contains "a run owed no word from anybody publishes none" else "a plan that carried no case out answered a finding"
assert test.out contains "a plan nobody ever pressed a quarrel against is answered by nobody" else "a plan nobody pressed was answered all the same"
assert test.out contains "a desk that has said nothing yet leaves the case honestly waiting" else "a silent desk did not leave the case waiting"

# The reading below it, unchanged and still weighed.
assert test.out contains "the hand the case went to is read back, and its finding published" else "the reading below stopped being weighed"
assert test.out contains "a finding survives a provisioning, and belongs to the hand that wrote it" else "a finding was never proven past a provisioning"
assert test.out contains "five refusals stand by name: unreferred, silent, mismatched, miscounted, misrecorded" else "the deem refusals stopped standing"

# The referring below it, unchanged and still weighed.
assert test.out contains "a long-standing quarrel is put before a hand that is neither party" else "the referring below stopped being weighed"
assert test.out contains "a case survives a provisioning, and outlives the quarrel it was built from" else "a case was never proven past a provisioning"
assert test.out contains "five refusals stand by name: early, unaddressed, party, miscounted, misrecorded" else "the refer refusals stopped standing"

# The swelling, the dwelling, and every rung beneath them, unchanged.
assert test.out contains "a plan publishes whether a long-standing quarrel reads where the outcome is read" else "the swelling below stopped being weighed"
assert test.out contains "a standing survives a provisioning, and falls with the quarrel it speaks for" else "a standing was never proven past a provisioning"
assert test.out contains "an age climbs by the run just stood and never shortens" else "the dwelling below stopped being weighed"
assert test.out contains "an age survives a provisioning, and falls with the quarrel it counts" else "an age was never proven past a provisioning"
assert test.out contains "a quarrel comes down on its holder's word and on nobody else's" else "the relenting below stopped being weighed"
assert test.out contains "a plan publishes whether it reads under the quarrel it inherited" else "the heeding below stopped being weighed"
assert test.out contains "a plan publishes whether a pressed quarrel outlives the run that heard it" else "the endurance below stopped being weighed"
assert test.out contains "a plan publishes whether it reads what its reader says back" else "the appeal below stopped being weighed"
assert test.out contains "a plan publishes whether it writes back to the reader who objected" else "the tidings below stopped being weighed"
assert test.out contains "a plan publishes whether its marks carry the standing of their objection" else "the standing below stopped being weighed"
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term below stopped being weighed"
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test the whole arc keeps.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The meeting lap: one plan run twice over a debt an earlier run booked and left
# standing in its own notes. Every number stands still -- the work, the
# dependents, the correction, the journey, the record, the escort, the asking,
# the mark, the telling, the position carried forward, the word standing under
# it, the age, the standing, the case, the finding, the plan's own answer, the
# concession it left owing nothing, the settlement -- and only the meeting moves.
assert test.out contains "phases: 6 withheld, 6 told" else "the two plans ran different records"
assert test.out contains "dependents: 6 withheld, 6 told" else "saying what a look found cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 withheld, 3 told" else "the two plans absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 withheld, 3 told" else "the two plans lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 withheld, 3 told" else "the two plans repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 withheld, 1 told" else "the recanting rung stopped moving under both plans"
assert test.out contains "readings corrected where they were read: 1 withheld, 1 told" else "the amending rung stopped moving under both plans"
assert test.out contains "corrections carried to the place their reader was reached: 1 withheld, 1 told" else "the couriering rung stopped moving under both plans"
assert test.out contains "disagreements written into the record: 1 withheld, 1 told" else "the disputing rung stopped moving under both plans"
assert test.out contains "published words standing beside the reading against them: 1 withheld, 1 told" else "the abiding rung stopped moving under both plans"
assert test.out contains "standing objections put back to the reader who raised them: 1 withheld, 1 told" else "the lapsing rung stopped asking under both plans"
assert test.out contains "marks carrying the standing of the objection they quote: 1 withheld, 1 told" else "the standing below stopped moving under both plans"
assert test.out contains "raisers told how their own quarrel came out: 1 withheld, 1 told" else "the tidings below stopped moving under both plans"
assert test.out contains "readers whose reply to the answer was read back: 1 withheld, 1 told" else "the appeal below stopped moving under both plans"
assert test.out contains "positions carried past the run that heard them: 1 withheld, 1 told" else "a run whose reader still presses dropped their position"
assert test.out contains "inherited positions weighed into the run's own word: 1 withheld, 1 told" else "the regard stopped standing under a live quarrel"
assert test.out contains "standing positions left exactly where they were found: 1 withheld, 1 told" else "the relenting below stopped leaving the position standing"
assert test.out contains "standing positions this run said the age of: 1 withheld, 1 told" else "the dwelling below stopped dating under both plans"
assert test.out contains "standing quarrels published where the outcome is read: 1 withheld, 1 told" else "the swelling below stopped moving under both plans"
assert test.out contains "long-standing quarrels carried to a hand that is neither party: 1 withheld, 1 told" else "the referring below stopped moving under both plans"
assert test.out contains "carried cases whose answer was read and published: 1 withheld, 1 told" else "the reading below stopped moving under both plans"
assert test.out contains "published findings the plan answered on the record: 1 withheld, 1 told" else "the avowing below stopped moving under both plans"
assert test.out contains "findings a plan published and never said one word about: 0 against 0" else "a run left a finding it published unanswered"
assert test.out contains "concessions left owing nothing to any run after: 1 withheld, 1 told" else "meeting an old debt changed what today's word owed"
assert test.out contains "concessions a plan made that reach no run after them: 1 against 1" else "the two plans differed on today's own concession"
assert test.out contains "inherited debts this run met and took down: 1 withheld, 1 told" else "the meeting below stopped moving under both plans"
assert test.out contains "inherited debts left standing for the run after: 0 withheld, 0 told" else "a measured run left an admission standing"
assert test.out contains "debts a plan inherited that the run never met: 0 against 0" else "a measured run left the admission it opened holding unmet"

# The redress below, unchanged and still weighed: both runs now say what their
# look found, so the finding itself parts nothing.
assert test.out contains "meetings this run said the upshot of: 1 withheld, 1 told" else "the redress below stopped moving under both plans"
assert test.out contains "meetings this run closed without a word: 0 withheld, 0 told" else "a measured run closed its meeting in silence"
assert test.out contains "debts a plan met whose meeting never said what it found: 0 against 0" else "a measured run left its meeting hollow"

# The three numbers this rung moves. Both runs reach the same finding; only
# whether its raiser is ever told parts them.
assert test.out contains "findings this run carried to the reader who won them: 0 withheld, 1 told" else "the apprising did not part the two plans"
assert test.out contains "findings this run kept inside its own notes: 1 withheld, 0 told" else "the other half of the count did not close"
assert test.out contains "findings a plan reached whose raiser was never told: 1 against 0" else "the two plans left the same raiser in the dark"
assert test.out contains "work still standing when the supervisor exits: 0 withheld, 0 told" else "the two plans left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole withheld, carried out whole told" else "saying what a look found decided what the work came to"
assert test.out contains "breaks a named turn: 0 withheld, 0 told" else "the redressing run broke an order its author named"

# What an operator reads is what the wire carries. Every note is read here,
# outside the run that wrote it, exactly as each would be read by the person it
# was written for.
let settled = run ["sh" "-c" "cat caravan/.apprises/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The note this rung writes: the receipt for an admission finally looked at. Its
# two bytes are the inherited debt echoed back exactly -- a finding that went for
# the plan, under an outcome already reporting itself short -- which is nothing
# either measured run would ever have booked of its own.
let receipt = run ["sh" "-c" "cat caravan/.apprises/plan.met"]
assert receipt.ok else "a redressing run wrote over the receipt it was reporting on"
assert receipt.out contains "os" else "the receipt did not name the debt this run opened holding"

# The note this rung writes: what the look at that admission actually came to.
# Its three bytes are the receipt echoed back exactly -- a finding that went for
# the plan, under an outcome already reporting itself short -- and one byte more
# for the upshot the plan reached, which is that it put the work right.
let finding_note = run ["sh" "-c" "cat caravan/.apprises/plan.redress"]
assert finding_note.ok else "an apprising run carried its own finding out of its own notes"
assert finding_note.out contains "osr" else "the finding did not name the meeting it reports on, and what the look came to"

# The act this rung is the whole point of, read where the reader reads it and
# outside the plan's wire entirely: the same three bytes, in the box that reader
# already knows, beside every other word this arc has carried them.
let carried_home = run ["sh" "-c" "cat caravan/.readers/desk.found"]
assert carried_home.ok else "the reader who won the admission was never told what the look found"
assert carried_home.out contains "osr" else "the reader was carried something other than the finding the plan reached"

# And the act the receipt is only the record of: the debt is down, so no run
# after this one inherits an admission already answered.
let owed = run ["sh" "-c" "test -e caravan/.apprises/plan.owe && echo standing || echo down"]
assert owed.ok else "the debt note could not be weighed"
assert owed.out contains "down" else "a meeting run wrote a receipt and left the debt standing"

# The word below it, untouched by the old debt met beside it.
let avowal = run ["sh" "-c" "cat caravan/.apprises/plan.avow"]
assert avowal.ok else "the plan published no word of its own an operator could read"
assert avowal.out contains "ua" else "a meeting run rewrote the word it was only asked to leave alone"

# The finding below it, untouched.
let finding = run ["sh" "-c" "cat caravan/.apprises/plan.deem"]
assert finding.ok else "the plan published no finding an operator could read"
assert finding.out contains "u" else "a meeting run rewrote the finding beneath it"

# The hand that wrote it still holds their own word, in their own box.
let answer = run ["sh" "-c" "cat caravan/.readers/bench.deem"]
assert answer.ok else "the hand outside the argument kept no answer of their own"
assert answer.out contains "cl" else "a meeting run reached onto a third hand's desk"

let case = run ["sh" "-c" "cat caravan/.readers/bench.case"]
assert case.ok else "no third hand was ever handed the case"
assert case.out contains "cl" else "a meeting run rewrote the case it had already carried out"

let forum = run ["sh" "-c" "cat caravan/.apprises/plan.forum"]
assert forum.ok else "the plan named no hand outside the argument at all"
assert forum.out contains "bench" else "the wire did not name the third hand this lap seated"

# And the reader who raised the quarrel wrote no finding, which is the arc.
let unspoken = run ["sh" "-c" "test -e caravan/.readers/desk.deem && echo present || echo absent"]
assert unspoken.ok else "the reader box could not be weighed"
assert unspoken.out contains "absent" else "a party to the argument wrote the finding on it"

# The standing, the age, and the quarrel itself, each untouched.
let standing = run ["sh" "-c" "cat caravan/.apprises/plan.swell"]
assert standing.ok else "the standing note could not be read at all"
assert standing.out contains "l" else "a quarrel four runs old did not read as long-standing"

let age = run ["sh" "-c" "od -An -tu1 caravan/.apprises/plan.dwell | tr -d ' '"]
assert age.ok else "the age note could not be read at all"
assert age.out contains "4" else "a meeting run rewrote the age it was only asked to read"

let quarrel_note = run ["sh" "-c" "cat caravan/.apprises/plan.standing"]
assert quarrel_note.ok else "a meeting run took down the position it never weighed"
assert quarrel_note.out contains "p" else "the position standing over the plan changed under a meeting run"

let regard = run ["sh" "-c" "cat caravan/.apprises/plan.regard"]
assert regard.ok else "the regard note could not be read at all"
assert regard.out contains "u" else "an answered quarrel stopped standing over the plan's own word"

# The reader's own hand, in their own box, outside this plan's wire entirely --
# still pressing, which is exactly why their quarrel goes on standing.
let press = run ["sh" "-c" "cat caravan/.readers/desk.press"]
assert press.ok else "the reader replied nothing at all"
assert press.out contains "p" else "the holder of this lap's quarrel did not read as still pressing"

let plea = run ["sh" "-c" "cat caravan/.apprises/plan.appeal"]
assert plea.ok else "the plan published no plea an operator could read"
assert plea.out contains "p" else "the record and the reader's own hand read differently"

let address = run ["sh" "-c" "cat caravan/.apprises/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

let beside = run ["sh" "-c" "cat caravan/.apprises/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "s" else "the mark did not name the reading its reader holds"

let dispute = run ["sh" "-c" "cat caravan/.apprises/plan.dispute"]
assert dispute.ok else "an open record kept no disagreement at all"
assert dispute.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.apprises/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let outof = run ["sh" "-c" "cat caravan/.readers/desk.outof"]
assert outof.ok else "the raiser of the quarrel was never told how it came out"
assert outof.out contains "t" else "a word that never moved was reported to its raiser as one that did"

let recant_note = run ["sh" "-c" "cat caravan/.apprises/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.apprises/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan apprise witness passed."
