# tools/ca/caravan_dependents_a1_gate_bound_witness.rish — Ashvini a1 deciding wall (e212).
#
#   rishi/bin/rishi run tools/ca/caravan_dependents_a1_gate_bound_witness.rish

say "a1-caravan_dependents: Language EN — caravan dependents wall of four, decided in Glow (STOA331)."
say "a1-caravan_dependents: Lens TAME — both sides; the family walls stand together."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-caravan-dependents-bound-u32.glow"

let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "2"]
assert ok.ok else "a1-caravan_dependents: accept side failed"
assert ok.out contains "EXIT:0" else "a1-caravan_dependents: accept did not exit 0"
assert ok.out contains "1" else "a1-caravan_dependents: accept did not speak 1"

let over = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "5"]
assert over.ok else "a1-caravan_dependents: over side failed"
assert over.out contains "EXIT:0" else "a1-caravan_dependents: over did not exit 0"
assert over.out contains "0" else "a1-caravan_dependents: over did not speak 0"

let prior = run ["sh" "-c" "test -f src/lib/gate-tally-garden-bound-u32.glow"]
assert prior.ok else "a1-caravan_dependents: prior deciding wall missing"

say "GREEN: a1 caravan_dependents wall — decides on both sides; the ladder of walls grows."
