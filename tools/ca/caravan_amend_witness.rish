# caravan_amend_witness.rish -- Caravan amend witness.
#
# `recant.rye` taught a run to take back a judgment its own evidence disproves,
# repair the arc that judgment spared, and settle the plan `carried` where the
# elder reading settled `borne`. Every word of that correction goes to the wire,
# and every word of it is true. The person the elder word was written for has
# already read it and gone.
#
#   A SETTLEMENT AN OPERATOR ALREADY READ IS CORRECTED WHERE THEY READ IT.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO NOTICES DISAGREE ON IS READINGS LEFT STANDING ON A
#     WORD THIS RUN SUPERSEDED. The rung below weighs a RECORD AGAINST ITSELF:
#     a judgment one run made and a later run's evidence disproves. This weighs
#     a RECORD AGAINST ITS READER -- the word an operator carried away, against
#     the word the plan now stands behind. It falls from 1 to 0.
#   * THE WIRE IS TRUTHFUL THE WHOLE TIME, which is exactly why nothing below
#     this rung could see it. Every note says what is so; the belief in the room
#     says otherwise, and the belief is the one somebody acts on.
#   * THE PRICE IS NOTHING BUT THE WILLINGNESS TO SAY SO. Both runs take up 6
#     phases, absorb 3 into standing dependents, lose 3 arcs, take the same
#     judgment back, re-seat the same 3 phases, spend the same 6 dependents, and
#     settle the plan `carried`. A correction costs no work whatever.
#   * A PLAN PUBLISHES WHETHER ITS OWN CORRECTIONS ARE ADDRESSED. The notice is
#     plan-level beside the review, since it instructs about who a record
#     answers to rather than about one arc.
#   * THE READING IS THE SECOND NOTE A RUN DOES NOT CLEAR, beside the appraisal
#     and for a plainer reason: a reader's copy survives the run whatever the
#     wire does, so a wire that forgot what it last told somebody could never
#     notice it had changed its mind. This witness reads the reading still
#     standing after the run that left it there.
#   * THE AMENDMENT STANDS ON THE WIRE IN AN OPERATOR'S OWN WORDS. It is the
#     first note of this arc addressed to a PERSON rather than about a phase:
#     two bytes, `bc` -- you were told the plan was borne; it is carried out
#     whole -- and this witness reads it there rather than trusting the run's
#     telling. The reading leaves the wire in the same breath.
#   * AN AMENDMENT IS BOUNDED BY THE READING IT CORRECTS. Only a reading some
#     run actually published may be amended, and every standing reading is
#     confirmed or amended, never both and never neither.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE NOTICE RATHER THAN THE
#     CORRECTION IT CARRIES. `AmendEarly` is the moment: a reading answered
#     before the run published its settlement is correcting from memory.
#     `AmendUnread` is the supply. `AmendMiscounted` is the honesty of the
#     count. `AmendUnspoken` is the answer -- a run that superseded a reading
#     and published no amendment corrected in private.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Six RED paths were proven on metal before this witness claimed GREEN.
# Withhold the amendment from the wire and the run refuses `AmendUnspoken`.
# Leave the answered reading standing and the reader is found still waiting.
# Disarm the moment and a reader is corrected before the run published anything.
# Disarm the supply and a run corrects a reader who never read a word. Let the
# count stop closing and a standing reading is neither confirmed nor amended,
# unminded. Plant a correction addressed to a reading the wire never named and
# the armed supply guard refuses `AmendUnread` at the run.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ca/caravan_amend_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/amend"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/amend.rye -femit-bin=${bin}"]

assert build.ok else "caravan amend build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/amend_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/amend_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores and the doorbells. The notes go with them here,
# so the lap seats its own standing judgment and its own standing reading rather
# than inheriting either from a run this witness never watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.amends"]
assert clean.ok else "the region stores, doorbells, and amend notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan amend selftest exited non-zero"
assert test.out contains "GREEN" else "caravan amend selftest not GREEN"
assert test.out contains "a settlement an operator already read is corrected where they read it" else "the amendment finding did not close"

# The amendment and its three standing refusals, read straight, before any
# dependent runs. The fourth, `AmendUnspoken`, belongs to the run rather than
# the fold, since only the wire can answer whether a correction reached the
# place it was read.
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment fold was not weighed"
assert test.out contains "three refusals stand by name: early, unread, miscounted" else "the three standing refusals did not stand"

# The recantation, the bearing, and the mend below, unchanged and still weighed.
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The amending lap: one plan run twice against a reader who already went home,
# once leaving them with the word they took and once writing to them. Every
# number stands still -- the work, the dependents, the settlement -- and only the
# reader moves.
assert test.out contains "phases: 6 silent, 6 posted" else "the two notices ran different records"
assert test.out contains "dependents: 6 silent, 6 posted" else "correcting a reader cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 silent, 3 posted" else "the two notices absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 silent, 3 posted" else "the two notices lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 silent, 3 posted" else "the two notices repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 silent, 1 posted" else "the rung below stopped moving under both notices"
assert test.out contains "readings an operator holds that this run replaced: 1 silent, 1 posted" else "the two notices met different readers"
assert test.out contains "readings corrected where they were read: 0 silent, 1 posted" else "the correction did not part the two notices"
assert test.out contains "readings left standing on a word this run superseded: 1 against 0" else "the two notices left the same reader standing"
assert test.out contains "work still standing when the supervisor exits: 0 silent, 0 posted" else "the two notices left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole silent, carried out whole posted" else "the two notices settled the plan differently"
assert test.out contains "breaks a named turn: 0 silent, 0 posted" else "the posting run broke an order its author named"

# What an operator reads is what the wire carries. Every note is read here,
# outside the run that wrote it, exactly as an operator would read them.
let settled = run ["sh" "-c" "cat caravan/.amends/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

let correction = run ["sh" "-c" "cat caravan/.amends/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let reading = run ["sh" "-c" "od -An -tu1 < caravan/.amends/plan.read"]
assert reading.ok else "the plan kept no reading note at all"
assert reading.out contains "0" else "a reading that had its answer was left waiting on the wire"

let recant_note = run ["sh" "-c" "cat caravan/.amends/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.amends/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan amend witness passed."
