# launch-cursor-agent.rish — start Cursor Agent CLI inside ai-jail from the repository root.
#
# Primary Rish entry. Bash elder: tools/agent-jail.sh cursor-agent …
# Keeper pier / Linux: --private-home; auth under .cursor-agent-state/.
#
#   rishi/bin/rishi run tools/launch-cursor-agent.rish
#
# Resume / print / other agent flags: use the bash elder (Rish does not yet
# forward script argv into this launcher):
#   ./tools/agent-jail.sh agent --resume=CHAT_ID
#   ./tools/agent-jail.sh --resume=CHAT_ID agent
#   ./tools/agent-jail.sh --continue agent
#   ./tools/agent-jail.sh cursor-agent -p "what is the hostname"
#
# Shell equivalent: ./tools/agent-jail.sh cursor-agent …
# See: nixos-guide CLI-agents note · context/specs/enclosure-editors.md

let result = run ["bash" "tools/agent-jail.sh" "cursor-agent"]
say "launch-cursor-agent: agent-jail finished — ok=${result.ok}"
assert result.ok else "agent-jail failed to start cursor-agent"
