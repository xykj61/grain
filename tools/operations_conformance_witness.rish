# operations_conformance_witness.rish — the operations contract's checklist, as one suite.
#
# Development-season lap 4, completing the enforcement arc. The operations contract
# (active-designing/20260811-171509_acme-dx-operations-contract.md) names five
# operations, each with a real Mandate verb; this runs the witness that proves each,
# so the operator's checklist is green as a whole, not just claimed:
#
#   run      — <binary> selftest greens          (mandate_store_witness)
#   serve    — request in, answer out            (mandate_serve_witness)
#   serve*   — sealed over Comlink               (mandate_comlink_serve_witness)
#   persist  — one portable object, named bucket (mandate_bucket_witness)
#   recover  — snapshot + replayed WAL           (mandate_wal_witness)
#   observe  — the loom metrics field            (the session-log rule seats it)
#
#   rishi/bin/rishi run tools/operations_conformance_witness.rish

# Build the Mandate binaries the operation witnesses run.
let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "for m in store serve bucket wal comlink_serve; do env RYE_ZIG=${zig} rye/bin/rye build mandate/$m.rye -femit-bin=mandate/bin/$m || exit 1; done"]
assert build.ok else "operations: a Mandate binary did not build"

# run — the store answers its selftest.
let run_op = run ["rishi/bin/rishi" "run" "tools/mandate_store_witness.rish"]
assert run_op.ok else "operations: run — mandate store witness failed"
assert (run_op.out contains "GREEN") else "operations: run — store witness not GREEN"

# serve — a query in, the right answer out.
let serve_op = run ["rishi/bin/rishi" "run" "tools/mandate_serve_witness.rish"]
assert serve_op.ok else "operations: serve — mandate serve witness failed"
assert (serve_op.out contains "GREEN") else "operations: serve — serve witness not GREEN"

# serve sealed — the query rides Comlink sealed and verified.
let sealed_op = run ["rishi/bin/rishi" "run" "tools/mandate_comlink_serve_witness.rish"]
assert sealed_op.ok else "operations: serve* — comlink serve witness failed"
assert (sealed_op.out contains "GREEN") else "operations: serve* — comlink serve witness not GREEN"

# persist — the whole store as one object, and a named bucket of them.
let persist_op = run ["rishi/bin/rishi" "run" "tools/mandate_bucket_witness.rish"]
assert persist_op.ok else "operations: persist — mandate bucket witness failed"
assert (persist_op.out contains "GREEN") else "operations: persist — bucket witness not GREEN"

# recover — a snapshot plus a replayed write-ahead log rebuilds the live state.
let recover_op = run ["rishi/bin/rishi" "run" "tools/mandate_wal_witness.rish"]
assert recover_op.ok else "operations: recover — mandate wal witness failed"
assert (recover_op.out contains "GREEN") else "operations: recover — wal witness not GREEN"

# observe — the loom metrics field is seated in the session-log rule.
let observe_op = run ["sh" "-c" "grep -q 'loom' .claude/rules/session-logs.md"]
assert observe_op.ok else "operations: observe — the loom metrics field is not seated in the session-log rule"

say "GREEN: operations conformance — run, serve, serve-sealed, persist, recover, observe all stand; the operator's checklist is green as a whole."
