# tools/q/qa_setting_declared_witness.rish -- a page that names no setting is graded by whoever runs the tool.
#
#   rishi/bin/rishi run tools/q/qa_setting_declared_witness.rish
#
# Gauge is one style on one dial, and the dial is the SETTING. Door holds a page at one
# cross-reference per hundred words and 20 percent negative sentences; Field at three and 30; Meter
# at neither. `tools/fixtures/q/qa_report_card.sh` reads that dial from a `--setting` flag the
# CALLER hands it, and reports the page's own declaration separately as `qa_declared_setting`. When
# a page declares nothing those two facts stop agreeing, and until this census nothing counted how
# often or what it cost.
#
# THE LAW SAYS MOST PAGES KNOW THEIR OWN, and it was written for a human reader who can open a page
# and tell. The card is a machine reader and cannot, so an undeclared page hands its grade to
# whoever typed the command.
#
# THE LANTERN FIRED TWICE IN ONE LANE IN ONE MORNING -- eight points on `glow/nock/README.md` at
# `20260910.082330`, five on `MAP.md` here -- which is what earns an instrument rather than a
# repair, and turns 110 separate asks into one priced ruling.
#
# REPORTED, NEVER GATED. Gauge's own law says most pages know their own setting, so a page that
# declares none may be perfectly honest; a gate here would red on ordinary work, and a gate that
# reds on ordinary work is a gate somebody turns off. What the tree lacked was the number.

say "qa-setting-declared: Language EN -- one dial, and 110 pages that decline to set it."
say "qa-setting-declared: Style Gauge, Meter -- a census that reports rather than refuses."
say "qa-setting-declared: Lens TAME -- each bucket proven by moving a member into its neighbour."

say "qa-setting-declared: the control -- 32 behaviors on planted pages in a throwaway repository..."
let ctl = run ["sh" "tools/fixtures/q/qa_setting_declared_control.sh"]
# invariant: a refusal reports BOTH streams -- `run` returns `out` and `err` apart, and a control
# writing its reason to stderr would otherwise leave an empty reason in the roster's red file.
assert ctl.ok else "qa-setting-declared: the control refused --\n${ctl.out}\n${ctl.err}"
assert ctl.out contains "pass=32 fail=0" else "qa-setting-declared: the control did not prove 32 behaviors --\n${ctl.out}\n${ctl.err}"

say "qa-setting-declared: and the living tree answers every bucket..."
let scan = run ["sh" "tools/fixtures/q/qa_setting_declared_scan.sh"]
assert scan.ok else "qa-setting-declared: the scan refused --\n${scan.out}\n${scan.err}"
# invariant: the census reports every bucket, empty or full. A reading printing only the fault would
# leave a reader unable to tell a healthy tree from a tree the scan could not see.
assert scan.out contains "pages=" else "qa-setting-declared: the population went unreported"
assert scan.out contains "setting_named=" else "qa-setting-declared: the named count went unreported"
assert scan.out contains "setting_unnamed=" else "qa-setting-declared: the unnamed count went unreported"
assert scan.out contains "no_style_line=" else "qa-setting-declared: the no-style count went unreported"
# invariant: the census says out loud that it counts rather than gates, so no later reader mistakes
# a standing number for a wall somebody quietly lowered.
assert scan.out contains "reading=counted" else "qa-setting-declared: the census did not name itself a report"
assert scan.out contains "verdict=ok" else "qa-setting-declared: the census reached no verdict --\n${scan.out}"

say "qa-setting-declared: the population it reads is the one the ASCII wall reads..."
let shared = run ["sh" "-c" "grep -c 'yonder/\\*' tools/fixtures/a/ascii_document_scan.sh || true"]
assert shared.ok else "qa-setting-declared: the sibling population rule could not be read"
# invariant: two readings of "a living page" must not drift apart, so this census transcribes the
# ASCII wall's rule rather than writing a second one -- and the sibling must still carry it.
assert (trim shared.out) != "0" else "qa-setting-declared: the transcribed population rule left its source"

say "qa-setting-declared: and the field it counts is the one the card already prints..."
let card = run ["sh" "-c" "grep -c 'qa_declared_setting' tools/fixtures/q/qa_report_card.sh || true"]
assert card.ok else "qa-setting-declared: the report card could not be read"
# invariant: this census counts a fact the card already reports per page. If the card stopped
# printing it, the census would be measuring a gap nobody could see one page at a time.
assert (trim card.out) != "0" else "qa-setting-declared: the card no longer reports a page's own declaration"

say "GREEN: qa-setting-declared -- the unnamed setting is counted, its price is measurable, and the ruling has a population attached."
