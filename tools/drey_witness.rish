assert redact.ok else "drey: DREY10 redact witness failed"
assert (redact.out contains "GREEN drey-redact") else "drey: DREY10 redact not GREEN"

let sync = run ["rishi/bin/rishi" "run" "tools/drey_sync_witness.rish"]
assert sync.ok else "drey: DREY12 sync witness failed"
