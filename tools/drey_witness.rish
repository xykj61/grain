let carry = run ["rishi/bin/rishi" "run" "tools/drey_carry_witness.rish"]
assert carry.ok else "drey: DREY5 carry witness failed"
assert (carry.out contains "GREEN drey-carry") else "drey: DREY5 carry not GREEN"

let archive = run ["rishi/bin/rishi" "run" "tools/drey_archive_witness.rish"]
assert archive.ok else "drey: DREY6 archive witness failed"
assert (archive.out contains "GREEN drey-archive") else "drey: DREY6 archive not GREEN"

