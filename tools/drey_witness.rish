assert firmware.ok else "drey: DREY3 firmware witness failed"
assert (firmware.out contains "GREEN drey-firmware") else "drey: DREY3 firmware not GREEN"

let inbox = run ["rishi/bin/rishi" "run" "tools/drey_inbox_witness.rish"]
assert inbox.ok else "drey: DREY4 inbox witness failed"
