# caravan_swell_witness.rish -- Caravan swell witness.
#
# `dwell.rye` opened the last door: a standing quarrel says how many runs it has
# stood through, honestly and durably, in one byte beside the position itself.
# So the age exists at last, and it is exact -- and it lives in `plan.dwell`,
# which is a note you have to go looking for.
#
#   A LONG-STANDING QUARREL IS PUBLISHED WHERE THE OUTCOME IS READ.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO PLANS DISAGREE ON IS LONG-STANDING QUARRELS AN OPERATOR
#     READS NO LOUDER THAN A FRESH ONE. The place an operator actually opens --
#     the settlement, the regard, the word the plan came to -- says nothing about
#     the age beside it, so a quarrel of two hundred runs and one raised this
#     morning read exactly alike there. It falls from 1 to 0.
#   * THE BOUND IS NAMED IN THE MODULE AND NO RUN MAY MOVE IT. A threshold a plan
#     could pass in would let any plan quiet its oldest quarrel by naming a
#     larger number, which is precisely the move this rung exists to refuse -- a
#     supervisor grading the objections raised against itself. Three runs, and
#     the reading is inclusive at the bound.
#   * THE READING COMES OFF THE WIRE, NEVER OFF MEMORY. A run opens the age
#     actually written beside the position rather than the age it believes it
#     wrote a moment ago, and refuses `SwellUndated` by name where no age is
#     there at all -- a standing computed from an age nobody wrote is a guess
#     wearing a measurement's clothes, and it would read loudest of all.
#   * A STANDING SURVIVES A PROVISIONING, AND FALLS WITH THE QUARREL IT SPEAKS
#     FOR -- proven as its own fold. A byte left behind beside the outcome would
#     go on shouting for a quarrel its own holder let go, and a herald cleared
#     every morning would quiet the oldest position on the wire.
#   * THE HERALDING IS THE LAST ACT OF THE RUN, after the dating below it,
#     because the age this rung reads is the age that dating just left on the
#     wire -- and because the relenting above may already have taken down the
#     very position a standing would speak about.
#   * A HERALD REPORTS, AND NEVER ARGUES. Both runs settle `carried out whole`,
#     both leave the quarrel standing exactly where its holder left it, both
#     leave the age below untouched at 4, and both keep the word standing under
#     it. This rung says how loudly a position reads, and nothing else.
#   * THE PRICE IS ONE BYTE BESIDE THE OUTCOME, AT NO COST IN WORK AT ALL. Both
#     runs take up 6 phases, absorb 3 into standing dependents, lose 3 arcs,
#     take the same judgment back, re-seat the same 3 phases, spend the same 6
#     dependents, post and carry the same correction, read the same reply,
#     record the same disagreement, escort the same published word, ask the same
#     reader, stand the same mark, tell the same raiser, carry the same position
#     past themselves, date it to the same age, and settle the plan `carried`.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE HONESTY OF A WORD AN OPERATOR
#     READS WITHOUT GOING LOOKING. `SwellEarly` is the moment. `SwellUndated` is
#     the hard half. `SwellMiscounted` is the honesty of the count.
#     `SwellMisrecorded` is the record -- this byte sits where the outcome is
#     read, so a note disagreeing with the standing this run weighed would be the
#     loudest wrong word on the wire.
#   * A QUARREL RAISED ON THIS VERY RUN IS PUBLISHED QUIETLY AND HONESTLY, and a
#     plan nobody ever pressed a quarrel against publishes no standing at all --
#     each proven on the wire rather than only as a fold. A plan that loses
#     nothing still reads as the line handed, all 16 pairs, this arc's standing
#     generalization test one tier further out.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Skip the
# write and keep the read-back armed and the run refuses `SwellMisrecorded`.
# Walk a run with nothing standing into a heralding and it refuses `SwellEarly`
# -- reaching that on the wire takes disarming the honest fold first, since the
# fold catches it before the run can. Herald a position this run never dated and
# it refuses `SwellUndated`, a configuration reachable by argument alone, which
# is what makes that guard load-bearing. Count one position as both published and
# unpublished and it refuses `SwellMiscounted`. Disarm every guard at once -- the
# write skipped, the read-back skipped, and both harness reads of the wire -- and
# the selftest calls itself GREEN while `caravan/.swells/plan.swell` does not
# exist at all and `plan.standing` still reads `p` beside an age of 4, so an
# operator would open a quarrel four runs old and be told its standing was
# published. Seeing that once is what makes the reading back a check rather than
# decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_swell_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/swell"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/swell.rye -femit-bin=${bin}"]

assert build.ok else "caravan swell build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/swell_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/swell_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. Every quarrel this witness reads was seated by the lap
# itself, standing in for the runs that met this position before today.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.swells caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan swell selftest exited non-zero"
assert test.out contains "GREEN" else "caravan swell selftest not GREEN"
assert test.out contains "a long-standing quarrel reads where the outcome is read" else "the swell finding did not close"

# The swelling and its four refusals, read straight, before any dependent runs.
assert test.out contains "a quarrel counts as long-standing at 3 runs, and no run may move that bound" else "the bound was not weighed"
assert test.out contains "four refusals stand by name: early, undated, miscounted, misrecorded" else "the four swell refusals did not stand"
assert test.out contains "a long-standing quarrel reads no louder than one raised this morning" else "a bare plan did not read as one"
assert test.out contains "a long-standing quarrel is published where the outcome is read" else "the swelling did not read as one"
assert test.out contains "a quarrel that has outlasted the run it was raised in" else "a loud standing did not read as one"
assert test.out contains "a quarrel young enough that its age is the whole story" else "a quiet standing did not read as one"

# The two properties that make a published standing trustworthy, proven as their
# own fold: it survives a provisioning beside the position it speaks for, and it
# falls with that position the moment its holder lets the matter go.
assert test.out contains "a standing survives a provisioning, and falls with the quarrel it speaks for" else "a standing was never proven past a provisioning"

# The dwelling below it, unchanged and still weighed.
assert test.out contains "an age climbs by the run just stood and never shortens" else "the dwelling below stopped being weighed"
assert test.out contains "an age survives a provisioning, and falls with the quarrel it counts" else "an age was never proven past a provisioning"

# The relenting, the heeding, the endurance, the appeal, the tidings, the
# standing, the term, the escort, the record, the hearing, the delivery, the
# amendment, the recantation, the bearing, and the mend below, unchanged.
assert test.out contains "a quarrel comes down on its holder's word and on nobody else's" else "the relenting below stopped being weighed"
assert test.out contains "a plan publishes whether it reads under the quarrel it inherited" else "the heeding below stopped being weighed"
assert test.out contains "a plan publishes whether a pressed quarrel outlives the run that heard it" else "the endurance below stopped being weighed"
assert test.out contains "a plan publishes whether it reads what its reader says back" else "the appeal below stopped being weighed"
assert test.out contains "a plan publishes whether it writes back to the reader who objected" else "the tidings below stopped being weighed"
assert test.out contains "a plan publishes whether its marks carry the standing of their objection" else "the standing below stopped being weighed"
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term below stopped being weighed"
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization tests: a plan that loses nothing reads as the rung below, a
# quarrel raised on this very run is published quietly, and a plan nobody ever
# pressed a quarrel against publishes nothing at all.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"
assert test.out contains "a quarrel raised on this very run is published quietly and honestly" else "a fresh quarrel was published loud"
assert test.out contains "a plan nobody ever pressed a quarrel against publishes no standing at all" else "a plan nobody pressed published a standing all the same"

# The swelling lap: one plan run twice over a quarrel that has already stood
# long enough to count, once leaving the outcome silent about it and once
# publishing that standing right beside the settlement. Every number stands
# still -- the work, the dependents, the correction, the journey, the record,
# the escort, the asking, the mark, the telling, the reading back, the position
# carried forward, the word standing under it, the age itself, the settlement --
# and only the standing moves.
assert test.out contains "phases: 6 hushed, 6 heralded" else "the two plans ran different records"
assert test.out contains "dependents: 6 hushed, 6 heralded" else "heralding a quarrel cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 hushed, 3 heralded" else "the two plans absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 hushed, 3 heralded" else "the two plans lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 hushed, 3 heralded" else "the two plans repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 hushed, 1 heralded" else "the recanting rung stopped moving under both plans"
assert test.out contains "readings corrected where they were read: 1 hushed, 1 heralded" else "the amending rung stopped moving under both plans"
assert test.out contains "corrections carried to the place their reader was reached: 1 hushed, 1 heralded" else "the couriering rung stopped moving under both plans"
assert test.out contains "disagreements written into the record: 1 hushed, 1 heralded" else "the disputing rung stopped moving under both plans"
assert test.out contains "published words standing beside the reading against them: 1 hushed, 1 heralded" else "the abiding rung stopped moving under both plans"
assert test.out contains "standing objections put back to the reader who raised them: 1 hushed, 1 heralded" else "the lapsing rung stopped asking under both plans"
assert test.out contains "marks carrying the standing of the objection they quote: 1 hushed, 1 heralded" else "the standing below stopped moving under both plans"
assert test.out contains "raisers told how their own quarrel came out: 1 hushed, 1 heralded" else "the tidings below stopped moving under both plans"
assert test.out contains "readers whose reply to the answer was read back: 1 hushed, 1 heralded" else "the appeal below stopped moving under both plans"
assert test.out contains "positions carried past the run that heard them: 1 hushed, 1 heralded" else "a run whose reader still presses dropped their position"
assert test.out contains "inherited positions weighed into the run's own word: 1 hushed, 1 heralded" else "the regard stopped standing under a live quarrel"
assert test.out contains "standing positions let go on their holder's own word: 0 hushed, 0 heralded" else "a run closed a quarrel nobody had withdrawn"
assert test.out contains "standing positions left exactly where they were found: 1 hushed, 1 heralded" else "the relenting below stopped leaving the position standing"
assert test.out contains "standing positions this run said the age of: 1 hushed, 1 heralded" else "the dwelling below stopped dating under both plans"
assert test.out contains "standing quarrels whose note never said how long: 0 hushed, 0 heralded" else "a dating run left a standing quarrel undated"
assert test.out contains "standing quarrels published where the outcome is read: 0 hushed, 1 heralded" else "the swelling did not part the two plans"
assert test.out contains "standing quarrels left unpublished at the outcome: 1 hushed, 0 heralded" else "the other half of the count did not close"
assert test.out contains "long-standing quarrels an operator reads no louder than a fresh one: 1 against 0" else "the two plans left the same quarrel reading quietly"
assert test.out contains "work still standing when the supervisor exits: 0 hushed, 0 heralded" else "the two plans left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole hushed, carried out whole heralded" else "a standing decided what the work came to"
assert test.out contains "breaks a named turn: 0 hushed, 0 heralded" else "the heralding run broke an order its author named"

# What an operator reads is what the wire carries, and what a reader writes is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.swells/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The note this rung writes, beside the settlement above it. The position has
# outlasted the bound, so the wire reads loud -- the whole of what this rung
# adds, in a single byte at the place the outcome is read.
let standing = run ["sh" "-c" "cat caravan/.swells/plan.swell"]
assert standing.ok else "the standing note could not be read at all"
assert standing.out contains "l" else "a quarrel four runs old did not read as long-standing"

# The age below it, untouched by the reading taken from it.
let age = run ["sh" "-c" "od -An -tu1 caravan/.swells/plan.dwell | tr -d ' '"]
assert age.ok else "the age note could not be read at all"
assert age.out contains "4" else "a heralding run rewrote the age it was only asked to read"

# The quarrel itself, untouched: this rung says how loudly a position reads and
# never whether it stands at all.
let quarrel_note = run ["sh" "-c" "cat caravan/.swells/plan.standing"]
assert quarrel_note.ok else "a heralding run took down the position it was only asked to announce"
assert quarrel_note.out contains "p" else "the position standing over the plan changed under a heralding run"

# The word standing under it, unchanged: a standing says nothing about whether
# the plan's own word answers for the quarrel beside it.
let regard = run ["sh" "-c" "cat caravan/.swells/plan.regard"]
assert regard.ok else "the regard note could not be read at all"
assert regard.out contains "u" else "a heralded quarrel stopped standing over the plan's own word"

# The reader's own hand, in their own box, outside this plan's wire entirely --
# still pressing, which is exactly why their quarrel goes on standing.
let press = run ["sh" "-c" "cat caravan/.readers/desk.press"]
assert press.ok else "the reader replied nothing at all"
assert press.out contains "p" else "the holder of this lap's quarrel did not read as still pressing"

let plea = run ["sh" "-c" "cat caravan/.swells/plan.appeal"]
assert plea.ok else "the plan published no plea an operator could read"
assert plea.out contains "p" else "the record and the reader's own hand read differently"

let address = run ["sh" "-c" "cat caravan/.swells/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

let beside = run ["sh" "-c" "cat caravan/.swells/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "s" else "the mark did not name the reading its reader holds"

let quarrel = run ["sh" "-c" "cat caravan/.swells/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.swells/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let outof = run ["sh" "-c" "cat caravan/.readers/desk.outof"]
assert outof.ok else "the raiser of the quarrel was never told how it came out"
assert outof.out contains "t" else "a word that never moved was reported to its raiser as one that did"

let recant_note = run ["sh" "-c" "cat caravan/.swells/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.swells/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan swell witness passed."
