# tools/constel_net_topology_witness.rish — Constel dev-net harness, Rung 2: the whole fractal settles inside the fake net.
#
# Rung 1 opened a fake dev-net's galaxy from genesis under a law-safe name. This rung grows the net
# downward — a star beneath the galaxy, a planet beneath the star — each seated by settlement.mint
# under its rightful d12·d60 topology sponsor, so the whole fractal address space settles inside the
# quarantined net, every point crowned by the same law-safe name. Sponsorship is enforced, not claimed:
# a planet minted directly under the galaxy refuses WrongSponsor, and a forged spawn authority refuses
# BadAuthority — the real settlement protocol runs behind the name gate. Demo keeper seeds only — no
# real key, no network, no custody (gate #4 untouched).
#
# Law:   active-designing/20260813-022222_constel-test-network-naming-law.md
# Scope: active-designing/20260813-022908_constel-devnet-harness-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/constel_net_topology_witness.rish

say "constel-net-topology: Language EN — the whole d12·d60 fractal settles inside the fake net, all under one law-safe name."
say "constel-net-topology: Style Radiant — the safe name crowns the galaxy, its star, and its planet alike."
say "constel-net-topology: Lens TAME — sponsorship is enforced and asserted; a wrong sponsor and a forged authority each bite; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/constel-net-topology"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/constel_net_topology.rye -femit-bin=${bin}"]
assert build.ok else "constel-net-topology: constel_net_topology build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "constel-net-topology: constel_net_topology selftest exited non-zero"
assert selftest.out contains "GREEN" else "constel-net-topology: selftest did not speak GREEN"
assert selftest.out contains "the whole d12·d60 branch (galaxy 3 · star 27 · planet 267) settled inside the fake net" else "constel-net-topology: full-branch claim missing"
assert selftest.out contains "a planet minted directly under the galaxy refused WrongSponsor" else "constel-net-topology: wrong-sponsor refusal missing"
assert selftest.out contains "a forged spawn authority refused BadAuthority" else "constel-net-topology: forged-authority refusal missing"
assert selftest.out contains "the whole d12·d60 fractal settles inside the fake net, each point under its rightful sponsor" else "constel-net-topology: crux claim missing"

# Rung 1 stays its own GREEN binary — this rung composes it, never replaces it, so the named-genesis
# crux the whole harness rests on is re-proven at r2's door.
let r1 = run ["sh" "-c" "rishi/bin/rishi run tools/constel_net_witness.rish 2>&1"]
assert r1.ok else "constel-net-topology: rung one (named genesis) is not GREEN under the composing rung"
assert r1.out contains "constel-net: GREEN" else "constel-net-topology: rung one did not speak its GREEN"

say "constel-net-topology: GREEN — a star and a planet settle beneath the fake net's galaxy, each under its rightful sponsor, all quarantined by one law-safe name; rung one stands at its door."
