# caravan_lapse_witness.rish -- Caravan lapse witness.
#
# `abide.rye` taught a run to stand its published word beside the reading held
# against it: the disagreement quoted in one byte where the settlement is read,
# the plan's own word untouched beside it, and an operator who finds the
# objection in the same reach that finds the outcome. That escort is exactly
# right, and it never says for how long.
#
#   AN OBJECTION IS PUT BACK TO ITS READER, AND ANSWERED OR LET GO.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO TERMS DISAGREE ON IS OBJECTIONS PUBLISHED WITH NO TERM
#     ON THEM AT ALL. The rung below weighs a record against the place a person
#     reads. This weighs the record against the life of the person who wrote it
#     -- an objection standing on every future reader, which nobody has been
#     asked to renew and nobody may let go. It falls from 1 to 0.
#   * A MARK SAYS SOMEBODY OBJECTS, AND NEVER SAYS FOR HOW LONG, below this
#     rung. The escort in `caravan/.lapsings/plan.beside` stands on every future
#     read of that word, and nothing ever asks whether the person who raised it
#     still holds it.
#   * A TERM ASKS, AND NEVER DECIDES. The question is two bytes in the reader's
#     own `caravan/.readers/desk.again` -- `cs`, both readings of the quarrel
#     exactly as the record names them -- and the answer is one byte in
#     `caravan/.lapsings/plan.term`: `r` renewed, `l` let go.
#   * A TERM REPORTS, AND NEVER WITHDRAWS. The escort still reads `s` and the
#     settlement still reads `c` afterward, since a run that erased the mark
#     because its reader went quiet would be winning the quarrel by outlasting
#     them.
#   * SILENCE BELONGS TO THE PERSON WHO IS SILENT. The reader's own
#     `caravan/.readers/desk.still` is seated by the selftest harness standing in
#     for the reader by name, never by any run, exactly as `desk.said` is.
#   * BOTH ANSWERS ARE PROVEN ON THE WIRE, not only as folds. The bounded run
#     reads a silence and publishes `lapsed`; a third run, over a reader who
#     raises their objection again in their own hand, publishes `renewed` -- so
#     the wire's final `plan.term` reads `r`, which is that third run's word.
#   * THE PRICE IS ONE QUESTION AND ONE BYTE. Both runs take up 6 phases, absorb
#     3 into standing dependents, lose 3 arcs, take the same judgment back,
#     re-seat the same 3 phases, spend the same 6 dependents, post and carry the
#     same correction, read the same answer, record the same disagreement,
#     escort the same published word, and settle the plan `carried`.
#   * A PLAN PUBLISHES HOW LONG ITS OBJECTIONS MAY STAND. The term is plan-level
#     beside the escort, since it instructs about how long a record stands rather
#     than about one arc.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE TERM RATHER THAN THE
#     OBJECTION IT BOUNDS. `LapseEarly` is the moment. `LapseUnasked` is the hard
#     half -- a lapse published without the question ever leaving the building is
#     silence nobody listened for. `LapseMiscounted` is the honesty of the count.
#     `LapseMisrenewed` is the record -- a second hand naming any other reading
#     raises a different quarrel entirely.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Read no
# record and the run refuses `LapseEarly`. Skip the asking and it refuses
# `LapseUnasked`. Let the count stop closing and it refuses `LapseMiscounted`.
# Plant a second hand naming a reading the record never held and it refuses
# `LapseMisrenewed`. Disarm every guard at once -- the asking, its refusal, and
# the harness read that catches it -- and the run publishes an objection let go
# by a reader who was never addressed: `desk.again` never written, the question
# fabricated from the plan's own record, and the selftest still calling itself
# GREEN. Seeing that once is what makes the asking a check rather than
# decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_lapse_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/lapse"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/lapse.rye -femit-bin=${bin}"]

assert build.ok else "caravan lapse build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/lapse_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/lapse_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. The box goes with them, so the lap begins with a reader who
# has neither been told anything, nor said anything, nor been asked anything by a
# run this witness never watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.lapsings caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan lapse selftest exited non-zero"
assert test.out contains "GREEN" else "caravan lapse selftest not GREEN"
assert test.out contains "an objection is put back to its reader, and answered or let go" else "the lapse finding did not close"

# The term and its three standing refusals, read straight, before any dependent
# runs. The fourth, `LapseMisrenewed`, is answered in the same fold, since
# whether a second hand raises the standing objection is a question two words can
# settle between themselves.
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term fold was not weighed"
assert test.out contains "three refusals stand by name: early, unasked, miscounted" else "the three standing refusals did not stand"
assert test.out contains "an objection nobody renewed, let go rather than resolved" else "a let-go objection did not read as one"

# The escort, the record, the hearing, the delivery, the amendment, the
# recantation, the bearing, and the mend below, unchanged and still weighed.
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The lapse lap: one plan run twice over a reader's escorted objection, once
# leaving that objection to stand for as long as the record does and once putting
# it back to the reader who raised it. Every number stands still -- the work, the
# dependents, the correction, the journey, the record, the escort, the settlement
# -- and only the asking moves.
assert test.out contains "phases: 6 perpetual, 6 bounded" else "the two terms ran different records"
assert test.out contains "dependents: 6 perpetual, 6 bounded" else "bounding an objection cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 perpetual, 3 bounded" else "the two terms absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 perpetual, 3 bounded" else "the two terms lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 perpetual, 3 bounded" else "the two terms repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 perpetual, 1 bounded" else "the recanting rung stopped moving under both terms"
assert test.out contains "readings corrected where they were read: 1 perpetual, 1 bounded" else "the amending rung stopped moving under both terms"
assert test.out contains "corrections carried to the place their reader was reached: 1 perpetual, 1 bounded" else "the couriering rung stopped moving under both terms"
assert test.out contains "disagreements written into the record: 1 perpetual, 1 bounded" else "the disputing rung stopped moving under both terms"
assert test.out contains "published words standing beside the reading against them: 1 perpetual, 1 bounded" else "the abiding rung stopped moving under both terms"
assert test.out contains "standing objections put back to the reader who raised them: 0 perpetual, 1 bounded" else "the asking did not part the two terms"
assert test.out contains "objections their reader raised again: 0 perpetual, 0 bounded" else "a reader who wrote nothing was counted as raising an objection"
assert test.out contains "objections nobody renewed, let go rather than resolved: 0 perpetual, 1 bounded" else "the silence did not read as a let-go objection"
assert test.out contains "objections published with no term on them at all: 1 against 0" else "the two terms read the same way"
assert test.out contains "work still standing when the supervisor exits: 0 perpetual, 0 bounded" else "the two terms left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole perpetual, carried out whole bounded" else "the two terms settled the plan differently"
assert test.out contains "breaks a named turn: 0 perpetual, 0 bounded" else "the bounded run broke an order its author named"

# The other answer the same question admits, proven on the same wire rather than
# only as a fold.
assert test.out contains "a reader who raises their objection again keeps it standing" else "a renewing reader was never proven on the wire"

# What an operator reads is what the wire carries, and what a reader is asked is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.lapsings/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The escort below, untouched: a term reports on an objection rather than
# withdrawing it.
let beside = run ["sh" "-c" "cat caravan/.lapsings/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "s" else "the mark did not name the reading its reader holds"

# The question this rung exists to ask, in the reader's own box, naming both
# readings of the quarrel exactly as the record names them.
let question = run ["sh" "-c" "cat caravan/.readers/desk.again"]
assert question.ok else "a bounded run let an objection go without ever asking"
assert question.out contains "cs" else "the question named a quarrel its reader never raised"

# The term published beside the word it bounds. The wire's final word is the
# renewing run's, since that run comes last of the three.
let term = run ["sh" "-c" "cat caravan/.lapsings/plan.term"]
assert term.ok else "no term was ever published an operator could read"
assert term.out contains "r" else "a reader who raised their objection again had it let go"

# The record the term weighs, kept exactly as the rungs below write it.
let quarrel = run ["sh" "-c" "cat caravan/.lapsings/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.lapsings/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let address = run ["sh" "-c" "cat caravan/.lapsings/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

# The reader's own box, outside this plan's wire entirely -- the letter the plan
# carried, the hand they answered with, and the second hand they raised.
let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let hand = run ["sh" "-c" "cat caravan/.readers/desk.said"]
assert hand.ok else "the reader answered nothing at all"
assert hand.out contains "s" else "the reader's own hand did not name the reading they hold"

let still = run ["sh" "-c" "cat caravan/.readers/desk.still"]
assert still.ok else "the reader raised nothing again"
assert still.out contains "s" else "the second hand did not raise the objection the record holds"

let recant_note = run ["sh" "-c" "cat caravan/.lapsings/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.lapsings/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan lapse witness passed."
