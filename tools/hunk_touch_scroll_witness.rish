# tools/hunk_touch_scroll_witness.rish — the touch session: finger down · move · up become a live cursor (HUNK46).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · marketplace / Photos-app surface · rung HUNK46.
# Design read: active-designing/20260813-201244_hunk-touch-session-exploration.md.
# Teacher, thanked clean-room: the event-loop face of any touch scroll surface — a touchscreen reports finger down, a
# stream of finger move, then finger up, and ticks between frames; the surface scrolls, drags under the finger, and
# coasts when released (concept only, siloed).
#
# HUNK40–45 grew the touch-scroll journey in six clean pieces, each called separately. This rung is the driver a real
# device event loop hands raw finger events to: `pond/apps/preset_touch_scroll.rye` `TouchScroll` is a small three-phase
# state machine (idle, dragging, flinging) routing finger_down/move/up and a per-frame tick through HUNK44's pixel drag
# and HUNK45's fling — inventing no arithmetic and no new clamp. The one behaviour it adds is grab-to-stop: a fresh
# finger_down during a coast cancels the fling. The selftest drives a two-row viewport over a real five-book library by
# whole touch gestures and proves a pure drag with no fling, a flick that coasts, grab-to-stop, the inherited clamps,
# and the open-time refusals. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_touch_scroll_witness.rish

say "hunk-touch-scroll: Language EN — HUNK46 is the driver a touchscreen hands finger down, move, and up to: the surface scrolls under the finger and coasts when released, every motion clamped by the cursor beneath — no network, no key, no funds."
say "hunk-touch-scroll: Style Radiant — a touchscreen speaks three verbs and one tick; this session is the small grammar that turns them into a page that scrolls, drags, and coasts to rest."
say "hunk-touch-scroll: Lens TAME — a pure composition and a phase label over HUNK44's drag and HUNK45's fling, positive invariants per fn, deltas taken in i64 and clamped so a wild jump never wraps; the one added behaviour is grab-to-stop."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/preset_touch_scroll"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/preset_touch_scroll.rye -femit-bin=${bin}"]
assert build.ok else "hunk-touch-scroll: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-touch-scroll: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-touch-scroll: ${out}"

let green = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'GREEN preset-touch-scroll' && echo yes"]
assert (trim green.out) == "yes" else "hunk-touch-scroll: selftest did not print the GREEN preset-touch-scroll line"

let drag = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'moves the cursor and returns to idle with no fling' && echo yes"]
assert (trim drag.out) == "yes" else "hunk-touch-scroll: the pure-drag no-fling gesture was not proven"

let flick = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'flings and the coast advances the cursor to the bottom-pinned offset before settling idle' && echo yes"]
assert (trim flick.out) == "yes" else "hunk-touch-scroll: the flick-that-coasts gesture was not proven"

let grab = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'grab-to-stop (a finger_down during a coast) freezes the cursor exactly where it was caught' && echo yes"]
assert (trim grab.out) == "yes" else "hunk-touch-scroll: grab-to-stop was not proven"

let clamp = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'a hard flick lands bottom-pinned with no overshoot' && echo yes"]
assert (trim clamp.out) == "yes" else "hunk-touch-scroll: the inherited clamp was not proven"

let refuse = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'a bad cell height and a bad friction refuse at open by name' && echo yes"]
assert (trim refuse.out) == "yes" else "hunk-touch-scroll: the open-time refusals were not proven"

say "hunk-touch-scroll: GREEN — a touchscreen's finger down, move, and up drive a live cursor: a pure drag returns to idle with no fling, a flick coasts to rest, grab-to-stop freezes the cursor where caught, a hard flick clamps with no overshoot, and a bad cell or friction refuses at open. HUNK45 fling, HUNK44 drag, HUNK43 input, and HUNK40 cursor GREEN beneath."
