# tools/drey_carry_witness.rish — the carry meets: a committed device run lands in the desk inbox (DREY5).
#
# Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY5.
# Design read: active-designing/20260814-063000_drey5-carry-meets-device-loop-to-desk-inbox-exploration.md
# Stands on: mikrophone/firmware.rye (DREY3, the sending hand), mikrophone/inbox.rye (DREY4, the receiving hand).
#
# mikrophone/carry.rye composes the two proven hands into one carry: frame the recorder's committed run through the
# sending hand, accept it verify-before-trust through the receiving hand. The selftest proves: the carry meets (a
# recorded, committed run lands in the desk inbox byte-for-byte), only the committed crosses (an uncommitted tail never
# reaches the desk), a forgotten run never touches the desk (NothingToCarry, a prior keep untouched), a frame tampered
# in transit is refused at the desk (DigestMismatch, the desk keeps nothing), and both hands forget whole.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/drey_carry_witness.rish

say "drey-carry: Language EN — DREY5 joins the two proven hands of the Mikrophone carry: the device that frames only what was kept on purpose, and the desk that keeps only what it has proven whole."
say "drey-carry: Style Radiant — two hands proven alone become one carry proven whole; between them the forgetting promise holds across every seam."
say "drey-carry: Lens TAME — the join invents nothing; it composes firmware.carry_frame and inbox.accept over their public APIs; every refusal is inherited by name (NothingToCarry, DigestMismatch); the single wire is a byte slice handed function to function; no disk, no network, no key, no funds (custody gate %2 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "mikrophone/bin/carry"

let build = run ["sh" "-c" "mkdir -p mikrophone/bin && env RYE_ZIG=${zig} rye/bin/rye build mikrophone/carry.rye -femit-bin=${bin}"]
assert build.ok else "drey-carry: build failed — ${build.err}"

let outfile = "mikrophone/bin/carry.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "drey-carry: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "drey-carry: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN drey-carry' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "drey-carry: selftest did not print the GREEN drey-carry line"

say "drey-carry: GREEN — the two hands of the Mikrophone carry meet as one. DREY5 proves a committed run leaves the device and lands in the desk inbox byte-for-byte, and only such a run does."
