# tools/buhr_tablecloth_keyed_witness.rish — BUHR Journey 7, Rung 4: the owner-signed catalog.
#
# Rung one bound a human name to a content address. This rung adds provenance: a name
# does not merely pin bytes — a settled Kumara identity vouches for which bytes, and only
# that identity may publish under the catalog. The owner presents the point's Deed
# (verified against the constellation) and signs the exact publication (point · name ·
# length · content digest), so a stolen id cannot publish for another identity, a forged
# signature cannot publish at all, and a content-mismatched signature refuses before any
# byte is stored. A publication resolves to whose it is — owner_of returns the point,
# place_of resolves it to its galaxy/star/planet. Rung one stays its own green binary
# (the keyed layer wraps its Catalog unchanged; only an additive pub index_of was added).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_tablecloth_keyed_witness.rish

say "buhr7: Language EN — the artifact store owner-signed: a settled identity vouches for the bytes it publishes."
say "buhr7: Lens TAME — no new storage, no new signing; the owner presents a verified Deed and signs the exact publication; every refusal holds."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/tablecloth-keyed"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth_keyed.rye -femit-bin=${bin}"]
assert build.ok else "buhr7: tablecloth_keyed build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr7: tablecloth_keyed selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr7: selftest did not speak GREEN"
assert selftest.out contains "an artifact belongs to a settled Kumara point" else "buhr7: ownership claim missing"
assert selftest.out contains "presents the point's Deed" else "buhr7: deed-presentation missing"
assert selftest.out contains "signs the exact publication" else "buhr7: signing claim missing"
assert selftest.out contains "stolen id cannot publish for another identity" else "buhr7: stolen-id refusal missing"
assert selftest.out contains "owner_of returns the point" else "buhr7: owner resolution missing"
assert selftest.out contains "place_of resolves it to its place in the fractal" else "buhr7: place resolution missing"
assert selftest.out contains "every refusal holds" else "buhr7: refusal claim missing"
assert selftest.out contains "a non-owner, a forged signature, a content-mismatched signature" else "buhr7: the three publish refusals missing"
assert selftest.out contains "a taken name refuses, no byte stored" else "buhr7: taken-name refusal missing"

# Rung one — the named artifact store the keyed layer wraps — stays its own green binary;
# rung four adds only the signing gate and an additive pub index_of, additively.
let r1_bin = "pond/bin/tablecloth"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr7: tablecloth (r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr7: tablecloth (r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr7: tablecloth (r1) did not speak GREEN"

say "buhr7: GREEN — the artifact store is owner-signed; only a settled identity may publish under a name, and a publication resolves to whose it is."
