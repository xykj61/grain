# tools/font5x7_nordic_witness.rish -- the open Danish-Norwegian letters corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, and the five accent corpora already drawn -- the acute/cedilla corpus
# (tools/font5x7_latin1_witness.rish), the grave vowels (tools/font5x7_grave_witness.rish), the circumflex vowels
# (tools/font5x7_circumflex_witness.rish), the tilde vowels (tools/font5x7_tilde_witness.rish), and the diaeresis vowels
# (tools/font5x7_diaeresis_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Danish-Norwegian letters corpus: the three vowels an alphabet
# appends after z -- a with a ring, ae ligature, o with a stroke -- at their real Unicode codepoints U+00E5, U+00E6,
# U+00F8, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_nordic.rye, built into a gfa1
# atlas and proven on metal. A full round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all
# three letters look up present and carry the shared advance while an unaccented ASCII 'a' misses; the three carry
# distinct coverage; each reads within an honest legibility band; and the three CONSTRUCTIONS hold -- the a ring wears a
# hollow ring above its body (a mark present, its center a hole), the ae ligature carries no mark and a full crossbar
# where the a and the e join, and the o stroke inks the center of its bowl where a plain o stays hollow. With these three
# the lowercase Latin-1 letter set stands whole in our own open hand. Compression is reported as a fact, never asserted
# -- the round-trip is the proof. No network, no key, no funds -- the letters a surface reads when it prints Aero, Bjorn,
# or a Danish keeper's own name.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_nordic_witness.rish

say "font5x7-nordic: Language EN -- Season G font content; the three Danish-Norwegian letters (a ring, ae ligature, o stroke) drawn in the open as ASCII line art, built into the gfa1 atlas, the letters a civic surface prints when it spells Aero, Bjorn, or a Danish keeper's own name -- the vowels an alphabet appends after z, which the accent corpora never reached."
say "font5x7-nordic: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; three letters built three ways (a hollow ring above, a fused ligature with a crossbar, an o with a stroke through its bowl), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-nordic: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - nordic_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_nordic"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_nordic.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-nordic: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-nordic: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-nordic: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-nordic' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-nordic: selftest did not print the GREEN corpus line"

say "font5x7-nordic: GREEN -- the letters a ring, ae, o stroke stand drawn in the open, closing the lowercase Latin-1 letter set, proven on metal."
