# tools/font5x7_geometric_witness.rish -- the open geometric-shapes corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora and the wider-symbol corpora that opened next (tools/font5x7_box_witness.rish the light box marks,
# tools/font5x7_boxdouble_witness.rish the double, tools/font5x7_boxdiag_witness.rish the diagonal,
# tools/font5x7_arrow_witness.rish the arrows, tools/font5x7_block_witness.rish the block elements).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn geometric-shapes corpus: the ten marks a list points and
# selects with -- the bullet, the filled and hollow square, the four filled triangles (up, right, down, left), the
# diamond, and the hollow and filled circle -- at their real Unicode codepoints U+2022 and U+25A0..U+25CF, each a 5x7
# coverage grid drawn in the open as ASCII line art in image/font5x7_geometric.rye, built into a gfa1 atlas and proven
# on metal. These are exactly the marks Scooter and Dexter reach for as a list bullet, an unread badge, a radio dot, a
# selection caret, or a menu marker. A full round-trip recovers every codepoint, advance, and coverage byte
# byte-for-byte; all ten marks look up present and carry the shared advance while an ASCII letter misses; no two marks
# share coverage (a real shape set's glyphs differ); each mark reads within an honest legibility band; and the
# filled/hollow twins and the small/large disc pair keep their honest ink order. Compression is reported as a fact,
# never asserted -- the round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it
# wants to bullet a list, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_geometric_witness.rish

say "font5x7-geometric: Language EN -- Season G font content; the ten geometric marks (bullet, filled/hollow square, four triangles, diamond, hollow/filled circle) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a terminal surface points and selects with."
say "font5x7-geometric: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every mark byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-geometric: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - geometric_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_geometric"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_geometric.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-geometric: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-geometric: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-geometric: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-geometric' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-geometric: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-geometric: round-trip was not byte-identical"

say "font5x7-geometric: GREEN -- the open geometric-shapes corpus whole; ten marks round-trip byte-identical, all present, distinct, and legible, the filled/hollow and small/large families in honest order; the font gains the marks a list points and selects with."
