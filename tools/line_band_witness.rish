# tools/line_band_witness.rish -- read a DIRECTED line named by TWO anchor taps (from A toward B) as a CORRIDOR MARQUEE, on metal
# (Season G).
#
# Season G (Open Media Primitives) -- this rung TURNS the just-closed three-read decomposition of a directed line into a GESTURE.
# line_partition reads the cross product's SIGN (which side); line_order reads the DOT (how far along); line_distance reads the MAGNITUDE
# (how far off). A band reads that magnitude against a THRESHOLD -- the answer to "what is the distance FOR" -- so a keeper drops a line and
# lassoes a corridor of chosen half-width around it. A reading over readings, no plane of its own.
#
# The crux this witness proves on metal: a corridor is a SUBLEVEL SET of the sorted distance key, so line_band is a PREFIX of line_distance's
# nearest-to-farthest order. Over line_distance's own six-object scene the horizontal line A -> B gives distances A=0, B=0, P=3, Q=3, D=4,
# U=5, so a corridor of half-width 3 selects exactly {A, B, P, Q}, the prefix of the order. The threshold is CLOSED and EXACT (P at distance
# exactly 3 is in at width 3, out at width 2); the band NESTS (band_count nondecreasing, width 0 collapses to the on_line set); the band is
# BLIND to the drawn direction where line_partition's sides swap; nearest_outside_band names what the corridor missed, refusing BandCatchesAll
# when it holds the whole scene; refusals by name; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/line_band_witness.rish

say "line_band: Language EN -- Season G line-to-corridor; a half-width THRESHOLD on line_distance's magnitude selects the objects hugging the stroke where line_partition's SIGN split them across it, line_order's DOT ranked them along it, and line_distance's MAGNITUDE ranked them off it; NO float, NO tolerance."
say "line_band: Style Radiant -- compose not braid: this rung owns only the threshold and the prefix it induces; line_distance owns the distance magnitude, the order, and the on-line floor the corridor is built from, line_partition owns the side arbiter the direction-blind crux cross-checks, click_collinear owns click_group_center_doubled. No plane of its own, no pixel written -- a reading over readings."
say "line_band: Lens TAME -- the prefix walk runs components times under label_max_pixels; the half-width is bounded by band_max_half_width so the squared corridor bound never overflows i64, refusing BandTooWide past it; the corridor test runs in i64 so the doubled-coordinate products stay whole; two anchors sharing a group refuse SameGroup, a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds, a label past the object count refuses BadTarget, a corridor holding the whole scene refuses BandCatchesAll, each having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/line_band"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/line_band.rye -femit-bin=${bin}"]
assert build.ok else "line_band: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "line_band: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "line_band: ${out}"

assert selftest.out contains "GREEN image-line-band" else "line_band: selftest did not print the GREEN line"
assert selftest.out contains "read a DIRECTED line named by TWO anchor taps (from A toward B) as a CORRIDOR MARQUEE" else "line_band: the corridor-marquee claim did not print"
assert selftest.out contains "the test key*key <= 4*half_width*half_width*len2 so the boundary is a sharp closed threshold with no square root and no divide" else "line_band: the exact-integer threshold test did not print"
assert selftest.out contains "This TURNS the just-closed three-read decomposition into a GESTURE" else "line_band: the gesture claim did not print"
assert selftest.out contains "a corridor is a SUBLEVEL SET of the sorted distance key, so line_band is a PREFIX of line_distance's nearest-to-farthest order" else "line_band: the prefix crux did not print"
assert selftest.out contains "a corridor of half-width 3 selects exactly {A, B, P, Q}, the prefix of [A, B, P, Q, D, U]" else "line_band: the concrete prefix did not print"
assert selftest.out contains "THE THRESHOLD IS CLOSED AND EXACT" else "line_band: the closed-and-exact threshold crux did not print"
assert selftest.out contains "P at distance exactly 3 is IN at half-width 3 and OUT at half-width 2" else "line_band: the sharp-boundary claim did not print"
assert selftest.out contains "THE BAND NESTS" else "line_band: the nesting crux did not print"
assert selftest.out contains "width 0 collapses the corridor to the LINE ITSELF, line_band(0) equal to line_distance's on_line set {A, B}" else "line_band: the width-0-is-the-line claim did not print"
assert selftest.out contains "THE BAND IS BLIND TO THE DRAWN DIRECTION" else "line_band: the direction-blind crux did not print"
assert selftest.out contains "a side has a handedness, a corridor has none" else "line_band: the handedness contrast did not print"
assert selftest.out contains "nearest_outside_band names the closest object the corridor missed" else "line_band: the nearest-outside claim did not print"
assert selftest.out contains "refusing BandCatchesAll when the corridor holds the whole scene" else "line_band: the BandCatchesAll refusal did not print"
assert selftest.out contains "refuse SameGroup" else "line_band: the SameGroup refusal did not print"
assert selftest.out contains "a half-width past band_max_half_width refuses BandTooWide" else "line_band: the BandTooWide refusal did not print"
assert selftest.out contains "the same corridor reads the same band twice" else "line_band: determinism did not print"

say "line_band: GREEN on metal -- a directed line read as a corridor marquee, the distance read turned into a selection; a corridor is a prefix of the distance order (a sublevel set of a sorted key), its boundary closed and exact, its widths nesting, its selection blind to the drawn direction where line_partition's sides swap; nearest_outside_band names what the corridor missed; refusals by name, determinism. Season G open-media."
