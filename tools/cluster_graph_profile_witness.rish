# tools/cluster_graph_profile_witness.rish -- the cluster graph read as a distribution over thresholds, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/object_relation.rye reads how a PAIR of objects sit; image/scene_graph.rye joins that over every
# pair and reads each object's nearest NEIGHBOR; image/overlap_clusters.rye gathers objects into connected CLUSTERS; image/cluster_facts.rye
# reads each cluster's union FRAME; image/cluster_adjacency.rye reads how a PAIR of whole clusters sit; image/cluster_graph.rye joins that pair
# read over every cluster pair into one matrix. This rung reads that whole cluster graph as a FUNCTION of the threshold -- the distance
# HISTOGRAM (one bin per distinct true inter-cluster distance, carrying its multiplicity) and the cumulative EDGE PROFILE it generates.
# Exact integers, NO float, NO tolerance, NO bucketing by width.
#
# The crux this witness proves on metal: THE HISTOGRAM IS THE EDGE-CURVE'S DERIVATIVE AND CUMULATING IT REPRODUCES within_edges BY TWO
# INDEPENDENT PATHS -- over the three-cluster scene (distances 2, 3, 10, all distinct) cumulative_edges equals within_edges at every
# threshold, a STEP function whose jump at each distance is that distance's multiplicity; over a symmetric three-block row (two gaps of 3,
# outer gap 7) a bin of COUNT 2 makes the curve jump by two at one threshold, the multiplicity a sorted distance list could not show; the
# curve is bounded by min_pair_distance and max_pair_distance, a lone-cluster graph refuses NoPairs. Determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cluster_graph_profile_witness.rish

say "cluster_graph_profile: Language EN -- Season G cluster graph as a distribution over thresholds; distance_histogram the distinct distances with multiplicity, cumulative_edges the edge-count curve, min_pair_distance and max_pair_distance the closest gap and the diameter; NO float, NO tolerance."
say "cluster_graph_profile: Style Radiant -- compose not braid: this rung owns only the distribution reads (the histogram fold, the cumulative sum, the closest gap and diameter, the pair total); cluster_graph owns the precomputed matrix and the raw edge scan, cluster_adjacency each cluster pair's true gap, overlap_clusters the connectivity. A reading over a reading over a reading over a reading over a reading over a reading."
say "cluster_graph_profile: Lens TAME -- the unordered cluster pairs are bounded by the cluster ceiling, so the histogram holds at most one bin per distinct distance, never more than the pair count; a lone-cluster graph has no pairs, so min_pair_distance and max_pair_distance refuse NoPairs; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/cluster_graph_profile"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/cluster_graph_profile.rye -femit-bin=${bin}"]
assert build.ok else "cluster_graph_profile: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "cluster_graph_profile: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "cluster_graph_profile: ${out}"

assert selftest.out contains "GREEN image-cluster-graph-profile" else "cluster_graph_profile: selftest did not print the GREEN line"
assert selftest.out contains "CUMULATING THE HISTOGRAM REPRODUCES within_edges, BY TWO INDEPENDENT PATHS" else "cluster_graph_profile: the two-paths case did not print"
assert selftest.out contains "the edge-count curve is a STEP function" else "cluster_graph_profile: the step-function fact did not print"
assert selftest.out contains "THE MULTIPLICITY A SORTED LIST COULD NOT SHOW" else "cluster_graph_profile: the multiplicity case did not print"
assert selftest.out contains "the edge-count curve jumps by TWO at threshold 3" else "cluster_graph_profile: the height-two jump did not print"
assert selftest.out contains "THE CURVE IS BOUNDED BY THE CLOSEST GAP AND THE DIAMETER" else "cluster_graph_profile: the bounded-curve case did not print"
assert selftest.out contains "min and max refusing NoPairs" else "cluster_graph_profile: the lone-cluster refusal did not print"

say "cluster_graph_profile: GREEN on metal -- the cluster graph reads as a distribution over thresholds, the histogram the edge-curve's derivative and its cumulative sum reproducing within_edges by two independent paths, exact integers with NO float and NO tolerance."
