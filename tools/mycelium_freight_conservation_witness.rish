# tools/mycelium_freight_conservation_witness.rish — the whole fleet's state is conserved across a healing
# (r2).
#
# Season D (Kresfa & Mycelium) · Puddle fleet orchestration × Mycelium consensus · rung r2.
# r1 proved one moved world reads the byte-identical position on its new berth. r2 raises the claim from one
# world to the WHOLE FLEET: when a host departs and Puddle re-berths only the worlds it carried, the fleet's
# total state is CONSERVED — the sum of every world's position before the departure equals the sum read after,
# where every world's after-position is obtained by RECEIVING its carried freight on its new berth. A host
# failure costs ZERO state. The teeth: the law is not vacuous — a fleet that dropped the moved worlds' volumes
# reads a strictly smaller sum, short by exactly their state. Composes freight + puddle + cord + lapse +
# statement + fold + voucher + kumara public API only, editing none; demo host/world/keeper seeds — no key, no
# funds, no network, no world provisioned or moved.
#
# Scope: active-designing/20260813-121424_puddle-freight-world-state-migration-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_freight_conservation_witness.rish

say "mycelium-freight-conservation: Language EN — a fleet that reassigns pointers while losing volumes silently drops state; because each world's position is a pure function of its own carried bytes, a healing re-berths every moved world whole and the fleet's total state is conserved to the byte."
say "mycelium-freight-conservation: Style Radiant — r1 proved one world arrives whole; r2 proves the whole fleet does — the sum of every position before a departure equals the sum read after, and a dropped volume is a shortfall a keeper can catch."
say "mycelium-freight-conservation: Lens TAME — the conservation law composes freight + puddle + cord + lapse + statement + fold + voucher + kumara public API only, editing none; every claim is an integer comparison of a fleet-state sum; the position is derived, never re-declared; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/freight_conservation"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/freight_conservation.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-freight-conservation: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-freight-conservation: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-freight-conservation: selftest did not speak GREEN"
assert selftest.out contains "the whole fleet's state is conserved across a healing" else "mycelium-freight-conservation: conservation crux claim missing"
assert selftest.out contains "a host failure costs zero state" else "mycelium-freight-conservation: zero-state claim missing"
assert selftest.out contains "no world reads another's freight" else "mycelium-freight-conservation: distinctness claim missing"
assert selftest.out contains "the law is not vacuous" else "mycelium-freight-conservation: teeth claim missing"
assert selftest.out contains "Conservation stands" else "mycelium-freight-conservation: closing claim missing"

# The Freight crux r2 conserves stands on r1's own migration — its selftest proves a single moved world reads
# the byte-identical position, the per-world guarantee this round sums across the whole fleet.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/freight.rye -femit-bin=mycelium/bin/freight && mycelium/bin/freight 2>&1"]
assert r1.ok else "mycelium-freight-conservation: the Freight r1 crux this round sums over is not GREEN"
assert r1.out contains "GREEN" else "mycelium-freight-conservation: the Freight r1 crux did not speak its GREEN"

# The Puddle convergence Freight rides — the minimal-disruption heal that moves only the departed host's
# worlds — stands too; conservation is proven over exactly that healing.
let conv = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/puddle_convergence.rye -femit-bin=mycelium/bin/puddle_convergence && mycelium/bin/puddle_convergence 2>&1"]
assert conv.ok else "mycelium-freight-conservation: the Puddle convergence Freight rides is not GREEN"
assert conv.out contains "GREEN" else "mycelium-freight-conservation: the Puddle convergence did not speak its GREEN"

say "mycelium-freight-conservation: GREEN — the whole fleet's state is conserved across a healing: content-addressed freight carries every moved world's ledger whole, so a departed host costs one re-placement and zero state, no world reads another's freight, and a dropped volume is a sum a keeper can catch; the Freight r1 crux and the Puddle convergence both stand at the door. Conservation stands."
