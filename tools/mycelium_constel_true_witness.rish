# tools/mycelium_constel_true_witness.rish — a real Constel roster reads true, the receipt of the real
# constellation (r4, the Constel arc closes).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · Constel · rung r4 — reads true.
# r1 booted a named constellation and reached quorum, r2 proved its fault tolerance, r3 let it travel as a
# record — all over rosters seated in code. r4 carries the reader onto a REAL on-disk `format constel-v1`
# record a keeper can open and read — tools/fixtures/constel_roster.bron, produced reproducibly by
# mycelium/constel_fixture_gen.rye, @embedFile-bound through the mycelium/corpora/ symlink (no network).
#
# The crux this witness proves is TWO TOOLS, ONE ANSWER — the app derives the roster shape (<count>
# <firstkey8>) INDEPENDENTLY of the record text, by booting the constellation from its ship names (each key a
# pure function of its name), and that pair equals constel_roster_truth.awk's reading of the same bytes; the
# record is the receipt of the real constellation (every key self-certifies against its name, and the roster
# reaches quorum on a real order-head), its record a fixed point, its fixture reproducible, a tampered header
# refuses. Composes constel + constel_bron + constel_fixture_gen + voucher public API only; siloed dev
# fixtures — no key, no funds, no network, no real value.
#
# Scope: active-designing/date/20260813/20260813-132009_mycelium-constel-named-dev-net-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_constel_true_witness.rish

say "mycelium-constel-true: Language EN — a roster a keeper can open and read is a roster the software cannot lie about: the reader's ship count and first key match an independent boot from the ship names, and the record is provably the receipt of the real constellation."
say "mycelium-constel-true: Style Radiant — r1 named the constellation, r2 gave it fault tolerance, r3 let it travel; r4 reads a real on-disk roster true, closing the Constel agent-doable arc."
say "mycelium-constel-true: Lens TAME — the reading is cross-checked against an independent awk of the same bytes (two tools, one answer); the app boots the roster from its names and every key self-certifies; the fixture is reproducible and the record a fixed point; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/constel_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/constel_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-constel-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-constel-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-constel-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent boot from the ship names" else "mycelium-constel-true: read-true claim missing"
assert selftest.out contains "the receipt of the real constellation" else "mycelium-constel-true: real-constellation claim missing"
assert selftest.out contains "never a hand-mock" else "mycelium-constel-true: fixed-point claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-constel-true: tamper refusal missing"
assert selftest.out contains "The Constel agent-doable arc closes" else "mycelium-constel-true: arc-close claim missing"

# The crux — two tools, one answer. The app's measure pair must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-constel-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/constel_roster_truth.awk tools/fixtures/constel_roster.bron"]
assert awk.ok else "mycelium-constel-true: awk truth read failed"
assert awk.out contains "5 97f92882" else "mycelium-constel-true: awk pair not 5 97f92882"
assert app.out == awk.out else "mycelium-constel-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is reproducible — the generator re-emits byte-identical bytes, so the on-disk roster is what the
# Constel renders, never a hand-mock. Emit to a scratch path and diff (never overwrite the committed fixture).
let genbuild = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/constel_fixture_gen.rye -femit-bin=mycelium/bin/constel_fixture_gen"]
assert genbuild.ok else "mycelium-constel-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/constel_fixture_gen 2> /tmp/constel_roster_regen.bron; diff tools/fixtures/constel_roster.bron /tmp/constel_roster_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-constel-true: the regenerated fixture drifted from the committed one"
assert regen.out contains "REPRODUCIBLE" else "mycelium-constel-true: the regenerated fixture drifted from the committed one"

# The Constel r3 travel rung stands at the door — a true reading of a real roster means nothing unless the
# record round-trips and boots the identical constellation.
let r3 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/constel_bron.rye -femit-bin=mycelium/bin/constel_bron && mycelium/bin/constel_bron 2>&1"]
assert r3.ok else "mycelium-constel-true: the Constel r3 travel rung is not GREEN"
assert r3.out contains "GREEN" else "mycelium-constel-true: the Constel r3 did not speak its GREEN"

say "mycelium-constel-true: GREEN — a real Constel roster reads true (app==awk, 5 97f92882), the record the receipt of the real constellation whose keys self-certify against their names and whose roster reaches quorum on a real order-head, its record a fixed point, its fixture reproducible; the travel round stands at r4's door. The Constel agent-doable arc closes."
