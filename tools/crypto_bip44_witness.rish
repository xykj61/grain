# tools/crypto_bip44_witness.rish — BIP-44 account paths authored in pure Rye, authoring NO new cryptography. The wallet arc's account-path
# rung: the CONVENTION that gives crypto/bip32.rye's HD tree its five-level shape m/44'/coin_type'/account'/change/address_index, so every wallet
# in the world reaches the same address for the same phrase. parse_path reads the human path text a keeper copies from a wallet into the exact
# 32-bit index list; derive_path and derive_bip44 walk crypto/bip32.rye's ckd_priv down it from the master to the account leaf (crypto · Season G).
#
# Season: crypto — Season G (the Six-Season double-seat). This rung contributes only the path grammar — decimal-index parsing bounded overflow-safe
# below 2³¹, the hardened ' / h / H marker, and the fixed BIP-44 purpose/coin/change convention — over crypto/bip32.rye, already proven byte-for-byte
# on metal. Design read: active-designing/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G · the crypto parity wave).
# Clean-room: BIP-44 and its path convention are a public standard; the parsing and the walk are ours, standing on our own parity-GREEN BIP-32,
# never a copied line (.claude/rules/gratitude-licenses.md).
#
# Parity is proven at selftest the replayable way the tree favours, against BIP-32's OWN published Test Vector 1 (the spec's own known-answer,
# quoted character for character, never fabricated): all six nodes, each walked BY ITS HUMAN PATH STRING ("m", "m/0'", … "m/0'/1/2'/2/1000000000"),
# serialize to EXACTLY the spec's published xprv AND xpub — so the path parser, the hardened marker, and the walk are all proven against a real
# standard answer with no external fetch. The BIP-44 convention itself is proven: m/44'/60'/0'/0/0 parses to the exact hardened index list,
# derive_bip44 and derive_path agree byte-for-byte, and a malformed path (no master, a non-digit index, an index at 2³¹, a too-deep path, a
# trailing slash) each raises its named error. Purely local — every key is a TEST key from the spec's own seed, no network, no funds; generating
# a real wallet and signing with its key stays the custody gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/crypto_bip44_witness.rish

say "crypto-bip44: Language EN — BIP-44 account paths: the convention that gives crypto/bip32.rye's HD tree its five-level shape m/44'/coin_type'/account'/change/address_index, so every wallet reaches the same address for the same phrase. parse_path reads the human path text into the exact 32-bit index list; derive_path and derive_bip44 walk crypto/bip32.rye's ckd_priv down it from the master to the account leaf. Authors no new cryptography — the mathematics is all one rung down in the GREEN crypto/bip32.rye. With this rung the wallet arc reaches an account leaf a real address is read off: mnemonic → seed → HD tree → account."
say "crypto-bip44: Style Radiant — a keeper copies m/44'/60'/0'/0/0 from a wallet, and this rung reads that plain text into the exact indices and walks the tree to the very key that address is born from. One grammar, one walk, and the whole account path authored in the open and proven against the standard's own answers."
say "crypto-bip44: Lens TAME — every width named (a 32-bit index, a hardened offset of 2³¹, a path bounded at sixteen levels, an index token bounded at ten digits), contract asserts on the parse depth and the walk, decimal accumulation kept overflow-safe in u32; it calls no cryptography of its own, only the GREEN crypto/bip32.rye beneath. Parity holds against BIP-32's OWN published Test Vector 1: all six nodes walked by their human path strings serialize to EXACTLY the spec's published xprv and xpub. The BIP-44 convention parses to the exact hardened index list, derive_bip44 and derive_path agree byte-for-byte, and a malformed path raises its named error. Purely local — TEST keys only, no real identity key, no network, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/bip44"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/bip44.rye -femit-bin=${bin}"]
assert build.ok else "crypto-bip44: build failed — ${build.err}"

let outfile = "crypto/bin/bip44.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-bip44: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-bip44: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-bip44' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-bip44: selftest did not print the GREEN crypto-bip44 line"
