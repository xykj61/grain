# tools/wade1_brush_style_witness.rish — WADE1 authoring loop, source → pixels.
#
# Closes the seam the WADE1 bridge names
# (active-designing/20260812-000456_wade1-brush-surface-bridge-seam.md): a
# `.brush` *file* declares an OPTIONAL `style:` token block; brush_parse.rye
# reassembles it into a flat Bron token sheet; tokens.rye's infuse cascade
# resolves it; and a resolved sheet dresses a Skate grid to the declared colors.
#
# Proves the whole path from a file on disk:
#   (a) brush_parse's `style <path>` reads styled-frame.brush and reassembles its
#       declared tokens into clean flat Bron (no CSS/JS/JSON — the owned tongue);
#   (b) the end-to-end Rye test resolves that sheet through infuse and dresses a
#       Skate grid to Bark paper / Flax ink, rendering lit pixels;
#   (c) the seed fixture (no style block) still parses byte-identically and
#       reassembles to an empty sheet — the change is additive by default.
#
#   rishi/bin/rishi run tools/wade1_brush_style_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"

# --- build the parser; exercise the `style` path on the styled fixture -------

say "wade1 brush style: build brush-parse..."
let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/brush_parse.rye -femit-bin=brushstroke/bin/brush-parse"]
assert build.ok else "wade1 brush style: brush-parse build failed"

let self = run ["brushstroke/bin/brush-parse" "selftest"]
assert self.ok else "wade1 brush style: brush-parse selftest failed"
assert self.out contains "style-block" else "wade1 brush style: selftest missing style-block banner"

say "wade1 brush style: style path over styled-frame.brush..."
let style = run ["sh" "-c" "brushstroke/bin/brush-parse style brushstroke/styled-frame.brush 2>&1"]
assert style.ok else "wade1 brush style: style path failed"
assert style.out contains "at-nib=brushstroke-styled" else "wade1 brush style: styled at-nib missing"
assert style.out contains "paper 0xFF2B2620" else "wade1 brush style: declared paper token missing"
assert style.out contains "ink 0xFFF2ECDF" else "wade1 brush style: declared ink token missing"
assert style.out contains "space 4" else "wade1 brush style: declared space token missing"
assert style.out contains "GREEN: brush-parse style" else "wade1 brush style: style path not GREEN"

# The owned tongue: no CSS/JSON punctuation leaked into the reassembled sheet.
let clean = run ["sh" "-c" "if brushstroke/bin/brush-parse style brushstroke/styled-frame.brush 2>&1 | sed -n '/---sheet---/,/---end---/p' | grep -E '[;{}]' >/dev/null; then echo HIT; else echo CLEAN; fi"]
assert clean.ok else "wade1 brush style: tongue scan failed"
assert clean.out contains "CLEAN" else "wade1 brush style: CSS/JSON punctuation leaked into the sheet"

# --- the end-to-end loop: file → token sheet → infuse → dressed Skate grid ----

say "wade1 brush style: source → token sheet → infuse cascade → Skate grid..."
let loop = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run brushstroke/wade1_brush_style_test.rye 2>&1"]
assert loop.ok else "wade1 brush style: end-to-end loop failed"
assert loop.out contains "GREEN: WADE1 brush style" else "wade1 brush style: loop not GREEN"
assert loop.out contains "resolved through infuse cascade" else "wade1 brush style: missing infuse-cascade claim"
assert loop.out contains "dressed a Skate grid to the declared colors" else "wade1 brush style: missing dressing claim"

# --- additive by default: the seed fixture is untouched ----------------------

say "wade1 brush style: no-style parse is unchanged (additive default)..."
let seed = run ["sh" "-c" "brushstroke/bin/brush-parse brushstroke/seed-frame.brush 2>&1"]
assert seed.ok else "wade1 brush style: seed parse failed"
assert seed.out contains "at-nib=brushstroke-seed present=Frame max-lines=8 line-count=3" else "wade1 brush style: seed parse drifted from pre-style behavior"
let seed_style = run ["sh" "-c" "brushstroke/bin/brush-parse style brushstroke/seed-frame.brush 2>&1"]
assert seed_style.ok else "wade1 brush style: seed style path failed"
assert seed_style.out contains "style-tokens=0 sheet-bytes=0" else "wade1 brush style: seed fixture must reassemble to an empty sheet"

say "GREEN: WADE1 brush style — a .brush file's declared style parses into a token sheet, resolves through infuse, and dresses a Skate grid to the declared colors; a no-style .brush parses identically."
