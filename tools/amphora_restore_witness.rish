# tools/amphora_restore_witness.rish — Q38–Q42: the cargo's last mile home.
#
# pour · restore · four files · same-parent re-restore · planted fork refuses.
#
#   rishi/bin/rishi run tools/amphora_restore_witness.rish

let season = "tools/fixtures/cellar_ring1_tree"
let home = "/tmp/amphora_restore_witness_home"
let vessel = "/tmp/amphora_restore_witness_home/v.bron"
let out_home = "/tmp/amphora_restore_witness_home/v.bron.season"
let hello = "/tmp/amphora_restore_witness_home/v.bron.season/hello.txt"
let nested = "/tmp/amphora_restore_witness_home/v.bron.season/nested/leaf.txt"
let blob = "/tmp/amphora_restore_witness_home/v.bron.season/blob.bin"

let wipe = run ["rm" "-rf" home]
assert wipe.ok else "amphora_restore: home wipe"
let mk = run ["mkdir" "-p" home]
assert mk.ok else "amphora_restore: home mkdir"

let pour = run ["amphora/bin/amphora" "pour" season vessel]
assert pour.ok else "amphora_restore: pour must exit ok"

let restore = run ["amphora/bin/amphora" "restore" vessel]
assert restore.ok else "amphora_restore: restore must exit ok"
assert restore.err contains "restore catalog files=4" else "amphora_restore: want four cargo lines"
assert restore.err contains "restore same-parent ok" else "amphora_restore: want same-parent"
assert restore.err contains "restore complete" else "amphora_restore: want complete"

let h = run ["test" "-f" hello]
assert h.ok else "amphora_restore: hello.txt must land"
let n = run ["test" "-f" nested]
assert n.ok else "amphora_restore: nested/leaf.txt must land"
let b = run ["test" "-f" blob]
assert b.ok else "amphora_restore: blob.bin must land"

let again = run ["amphora/bin/amphora" "restore" vessel]
assert again.ok else "amphora_restore: same-parent re-restore must welcome"

let plant = run ["sh" "-c" "rm -rf /tmp/amphora_restore_witness_home/v.bron.season && mkdir -p /tmp/amphora_restore_witness_home/v.bron.season && echo other > /tmp/amphora_restore_witness_home/v.bron.season/x.txt"]
assert plant.ok else "amphora_restore: plant fork fixture"

let fork = run ["amphora/bin/amphora" "restore" vessel]
assert fork.ok == false else "amphora_restore: planted fork must refuse"
assert fork.err contains "identity fork" else "amphora_restore: want identity fork"

say "round=restored files=4 same-parent=ok reres=welcome fork=refused"
say "GREEN: amphora_restore — catalog · out-home guard · files proven · same parent · complete."
