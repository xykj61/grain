# tools/line_slice_witness.rish -- read ONE directed line, named by two anchor taps (from A toward B), as a CUT across the scene: the ordered
# sequence of objects the FINITE stroke truly pierces, front-to-back along the drawn direction, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/line_pierce.rye answers whether the finite stroke crosses each object's box yet returns an unordered
# ascending-label set; image/line_order.rye ranks EVERY object along the stroke yet includes the ones the stroke misses. line_slice is exactly
# their intersection -- the pierced set, in stroke order -- the read a surface wants the day a keeper drags a cutting stroke across a scene and
# means "what did I slice, and in what order did my stroke enter them." NO float, NO tolerance, NO square root.
#
# The crux this witness proves on metal: the slice is a FILTER of the order, not a new geometry -- it takes line_pierce's pierced_labels and
# re-sorts them by line_order's project_label with the SAME (projection, label) tie-break, so line_slice is provably the SUBSEQUENCE of line_order
# restricted to the pierced set. Over a 30x14 scene whose full order is [A, P, U, Q, B, Z], the finite stroke A -> B slices exactly [A, P, Q, B];
# U leaves the order for being OFF the line, Z for being PAST the end; reading B -> A reverses the slice while the sliced set stays invariant.
# Refusals by name; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/line_slice_witness.rish

say "line_slice: Language EN -- Season G ordered cut; a keeper drags a stroke across the scene and means what it sliced, so line_slice reads the objects the FINITE stroke pierces in the order the stroke enters them; the slice is a FILTER of line_order restricted to line_pierce's pierced set; NO float, NO tolerance, NO square root."
say "line_slice: Style Radiant -- compose not braid: this rung owns only the ordered filter -- taking the pierced labels and sorting them by the along-line key; line_pierce owns pierced_labels and the finite crossing, line_order owns project_label and the along-line projection. No crossing re-tested, no projection re-invented -- a reading over readings."
say "line_slice: Lens TAME -- the pierced set is bounded by the component count, itself under the image pixel ceiling, and the sort is an insertion sort over that same small set; two anchors sharing a group refuse SameGroup, a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds, a label past the object count refuses BadTarget, the rank of a missed object refuses NotPierced, the entry or exit of an empty cut refuses SliceEmpty, each having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/line_slice"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/line_slice.rye -femit-bin=${bin}"]
assert build.ok else "line_slice: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "line_slice: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "line_slice: ${out}"

assert selftest.out contains "GREEN image-line-slice" else "line_slice: selftest did not print the GREEN line"
assert selftest.out contains "as a CUT across the scene" else "line_slice: the cut claim did not print"
assert selftest.out contains "line_slice is exactly their intersection" else "line_slice: the intersection claim did not print"
assert selftest.out contains "the slice is a FILTER of the order, not a new geometry" else "line_slice: the filter crux did not print"
assert selftest.out contains "provably the SUBSEQUENCE of line_order restricted to the pierced set" else "line_slice: the subsequence crux did not print"
assert selftest.out contains "the finite stroke A -> B slices exactly [A, P, Q, B]" else "line_slice: the slice fact did not print"
assert selftest.out contains "TWO OBJECTS LEAVE THE ORDER FOR TWO DIFFERENT REASONS" else "line_slice: the two-reasons crux did not print"
assert selftest.out contains "one dropped for being off the line, the other for being past the end" else "line_slice: the off-line-versus-past-end fact did not print"
assert selftest.out contains "asking the slice rank of a missed object refuses NotPierced" else "line_slice: the NotPierced refusal did not print"
assert selftest.out contains "THE CUT REVERSES WITH THE STROKE, THE SELECTION DOES NOT" else "line_slice: the reversal crux did not print"
assert selftest.out contains "reverses the slice to [B, Q, P, A] exactly" else "line_slice: the reversed-slice fact did not print"
assert selftest.out contains "the sliced SET stays invariant" else "line_slice: the invariant-set fact did not print"
assert selftest.out contains "refuse SameGroup" else "line_slice: the SameGroup refusal did not print"
assert selftest.out contains "a background tap refuses EmptyClick" else "line_slice: the EmptyClick refusal did not print"
assert selftest.out contains "a point off the map refuses PointOutOfBounds" else "line_slice: the PointOutOfBounds refusal did not print"
assert selftest.out contains "a label past the object count refuses BadTarget" else "line_slice: the BadTarget refusal did not print"
assert selftest.out contains "the entry or exit of an empty cut refuses SliceEmpty" else "line_slice: the SliceEmpty refusal did not print"
assert selftest.out contains "the same stroke slices the same objects in the same order twice" else "line_slice: determinism did not print"

say "line_slice: GREEN on metal -- one directed line read as an ordered cut: the objects the finite stroke pierces, front-to-back along the drawn direction, exactly line_order restricted to line_pierce's pierced set; two objects leaving the order for two different reasons (off the line, past the end), the cut reversing with the stroke while the selection stays invariant, refusals by name, determinism. Season G open-media."
