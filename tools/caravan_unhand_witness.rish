# caravan_unhand_witness.rish -- Caravan unhand witness.
#
# `understudy.rye` proved that what a dependent was handed travels with the
# dependent: its domain, its verb, its count, its grants, and the outcome it
# owes are all fixed the moment it is spawned, so a record may say something
# else in that slot without touching the work in flight.
#
#   A DEPENDENT IS WEIGHED BY THE LINE IT HOLDS, NEVER BY THE CEILING ITS DOMAIN
#   WAS GRANTED.
#
# That proof has one more consequence, and the arc had not spent it. Every
# rung up to here asks the isolation room what the document permits each
# RUNNING DOMAIN, even though `intent.narrow` already handed each dependent a
# far smaller line -- capabilities for the arcs it names this turn, with the
# write bit dropped wherever the item declared a read. A line handed over is
# a fact about the dependent, so a run may weigh it as one.
#
# WHAT THE NARROWER ROOM BUYS, AND WHAT IT COSTS, MEASURED:
#
#   * THE TWO ROOMS WEIGHED AGAINST EACH OTHER, over one declaration and one
#     standing dependent. The ceiling refuses a reader of a board the running
#     domain may write; the held line welcomes the same newcomer, because
#     the line that dependent actually holds names neither the board nor
#     anything the newcomer touches.
#   * A RUN MUST NEVER WEIGH A DEPENDENT IT DOES NOT ITINERARY. The ceiling needs
#     only a domain name; the held reading needs the whole line, so the
#     supervisor carries one line per live dependent, shifted on every reaping.
#   * TWO REFUSALS THIS RUNG EARNS, ONE ABOUT MEMORY AND ONE ABOUT REACH.
#     `UnhandUnheld`: a forgotten dependent is an unweighed one, so a run weighs
#     by held lines only while it remembers a line for every dependent standing.
#     `UnhandWidened`: a remembered line may name only what the document
#     already grants, since a line claiming an ungranted write would admit a
#     newcomer the ceiling rightly blocks.
#   * THE CHANNEL JOINT STANDS EXACTLY WHERE IT STOOD. A channel joins two
#     domains at every instant of both, and a line narrowed to this turn's
#     arcs says nothing about it. A domain still runs one dependent at a time.
#   * THE HONEST TRADE, PRINTED FROM THE BOUNDS: 48 tests at the door by the
#     held line, against 36 by the ceiling. The narrower room reads more and
#     admits more, and both halves are reported rather than asserted.
#   * A LINE AS WIDE AS ITS OWN CEILING READS AS THE CEILING, all 9 pairs --
#     this arc's standing generalization test, one tier further out.
#   * THE ROOM MEASURED ON METAL: one plan run twice. 7 dependents either way
#     and 1 carrying home either way, with 2 at once by the ceiling against
#     3 by the lines held, and 8 slots left unspent against 1.
#
# THE LIMIT IS NAMED: a run weighs a dependent by the line it was handed at
# spawn, and that line never moves while the dependent runs. Whether a dependent may
# give back an arc it has finished with -- a line shrinking mid-flight, so
# the door widens the moment the work narrows -- belongs to the vision room
# until a witness binds it.
#
# All four RED paths were proven on metal before this witness claimed GREEN.
# Drop the memory refusal and the reading walks past the end of what it
# remembers, panicking at `index out of bounds: index 0, len 0` -- a
# forgotten dependent shown as a crash. Drop the reach refusal and a line
# claiming a write the document never granted is weighed anyway. Drop the
# channel refusal and a domain joined by a channel is admitted beside its
# peer. Answer the door by the ceiling in both runs and the finding shows as
# a failure: `the narrower room bought no room at all: 2 against 2`.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_unhand_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/unhand"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/unhand.rye -femit-bin=${bin}"]

assert build.ok else "caravan unhand build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs once ran a shared caravan/bin/read without building it, so the whole
# arc was green only on a tree some earlier run had left warm. A witness owns what it
# runs -- and, since REDS %133, the path it runs it from: eighty witnesses built that
# one reader to one name, so two running at once contended for a single file and the
# loser reddened a green tree. This one lands in caravan/bin/unhand_read.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/unhand_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# The one new declaration this arc has needed in many rungs: a board one
# client writes and its siblings read, with no channel joining any of them.
let published = run ["sh" "-c" "caravan/bin/unhand_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# The elder shape the generalization test needs, unchanged.
let narrow = run ["sh" "-c" "caravan/bin/unhand_read caravan/systems/serial_three_clients.bron 2>&1"]
assert narrow.ok else "the three-client declaration could not be read"
assert narrow.out contains "verdict: whole" else "the three-client declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan unhand selftest exited non-zero"
assert test.out contains "GREEN" else "caravan unhand selftest not GREEN"
assert test.out contains "a dependent is weighed by the line it holds, never by the ceiling its domain was granted" else "the unhand finding did not close"

# The two rooms weighed against each other, before any supervisor spends them.
assert test.out contains "the ceiling refuses what the line handed over never touches" else "the two rooms were not weighed against each other"
assert test.out contains "the isolation room costs at most 48 tests by the held line, against 36 by the ceiling" else "the cost of the narrower room was not reported honestly"
assert test.out contains "the channel joint stands unchanged" else "the standing joint was not shown to stand"

# The generalization test: the narrower room answers the wider one exactly.
assert test.out contains "a line as wide as its own ceiling reads as the ceiling, all 9 pairs" else "the two rooms did not agree about a widest line"

# The unhand lap: one plan run twice, once by the ceiling and once by the
# lines the dependents hold.
assert test.out contains "dependents: 7 by the ceiling, 7 by the line each dependent holds" else "the narrower room changed how much work the run did"
assert test.out contains "came home as handed: 1 by the ceiling, 1 by the line each dependent holds" else "a dependent did not come home as it was handed"
assert test.out contains "at once: 2 by the ceiling, 3 by the line each dependent holds" else "the narrower room bought no room at all"
assert test.out contains "slots left unspent: 8 by the ceiling, 1 by the line each dependent holds" else "the narrower room left the same slots unspent"
assert test.out contains "breaks a named turn: 0 by the ceiling, 0 by the line each dependent holds" else "the narrower room broke an order its author named"

say "GREEN: Caravan unhand witness passed."
