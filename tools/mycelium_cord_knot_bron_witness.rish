# tools/mycelium_cord_knot_bron_witness.rish — the Knot travels as a format cord-knot-v1 record (r2).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · checkpointing · rung r2 — the Knot travels.
# r1 sealed a committed Cord to a Knot and proved a continuation folds identical to the whole history.
# A checkpoint a node cannot hand to another node is only a local optimization; this rung lets a Knot
# cross as readable bytes, so a far node that never held the pruned prefix can trust the sealed supply
# and continue from it. Grown BESIDE the elder — composes cord_knot.rye + fold.rye public API only.
#
# The crux this witness proves: a Knot renders to a format cord-knot-v1 record and parses back, the
# recovered Knot verifying and carrying the byte-identical sealed supply (700 over one star); it continues
# to the identical supply as the original (issued 1300), and re-rendering is a fixed point. A tampered star
# breaks the digest so continue_verified refuses KnotCorrupt — corruption never crosses as a trusted
# checkpoint; a bad header, an unknown field, and a bad hex star each refuse. Demo keeper seeds only — no
# real key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_cord_knot_bron_witness.rish

say "mycelium-cord-knot-bron: Language EN — a Knot crosses to a stranger as readable bytes, and a tampered one never crosses as trusted."
say "mycelium-cord-knot-bron: Style Radiant — the sealed supply travels whole; what the record says is what the digest proves it is."
say "mycelium-cord-knot-bron: Lens TAME — a purpose-built bounded reader; an unknown field refuses rather than drops; a tampered checkpoint refuses whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_knot_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-knot-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-cord-knot-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-knot-bron: selftest did not speak GREEN"
assert selftest.out contains "parsed back, verifying and carrying the identical sealed supply" else "mycelium-cord-knot-bron: round-trip claim missing"
assert selftest.out contains "continues to the identical supply (issued 1300), and re-rendering is a fixed point" else "mycelium-cord-knot-bron: continuation/fixed-point claim missing"
assert selftest.out contains "a tampered star breaks the digest (KnotCorrupt)" else "mycelium-cord-knot-bron: tamper-refusal claim missing"

# The r1 Knot the record travels stays a green binary — accrete-never-break, proven by re-running its own
# selftest at this door.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot.rye -femit-bin=mycelium/bin/cord_knot && mycelium/bin/cord_knot 2>&1"]
assert r1.ok else "mycelium-cord-knot-bron: the r1 Knot is not GREEN"
assert r1.out contains "GREEN" else "mycelium-cord-knot-bron: the r1 Knot did not speak its GREEN"

say "mycelium-cord-knot-bron: GREEN — a Knot travels as a format cord-knot-v1 record byte-for-byte, the recovered Knot verifies and continues to the identical supply, a tampered checkpoint refuses whole, and the r1 Knot stands green at its door."
