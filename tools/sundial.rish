# tools/sundial.rish — sundial · recursion-prompt confidence 0–100.
#
# Lexicon shortcut: measure how well the session recursion printout still
# carries checkpoints from recent rounds. High green · low red.
#   rishi/bin/rishi run tools/sundial.rish
#   rishi/bin/rishi run tools/sundial.rish shred   # RED
#   prin sundial

say "sundial: Language EN — recursion confidence meter (percent · color band)."
say "sundial: Style Radiant — GREEN after measure; refuse shred/deploy."
say "sundial: Lens TAME — indicator only; never seats extend_or_return."

let verb = ""
if length args != 0 then let verb = args[0]

let m = run ["sh" "tools/fixtures/sundial.sh" verb]
assert m.ok else "sundial REFUSE or measure failed — see stderr"
assert m.out contains "GREEN: sundial" else "sundial missing GREEN line"
assert m.out contains "sundial=" else "sundial missing score"
assert m.out contains "band=" else "sundial missing color band"
assert m.out contains "witness:sundial GREEN" else "sundial witness missing"
say m.out

let refuse = run ["sh" "tools/fixtures/sundial.sh" "shred"]
assert (refuse.ok == false) else "sundial refuse-walk broken: shred must exit RED"

say "GREEN: sundial — confidence measured; shred refuse post-fold RED."
