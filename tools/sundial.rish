# tools/sundial.rish — accrete shim → tools/gen/season/sundial.rish (Generator Season s4)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/sundial.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/sundial.rish" args[0]]
if r.out != "" then say r.out
exit r.code
