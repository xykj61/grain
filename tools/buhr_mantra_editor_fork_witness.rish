# tools/buhr_mantra_editor_fork_witness.rish — BUHR Journey 4, Rung 3.
#
# An edit can fork a new lane, not only continue an old one. Rung one gave the editor
# commit — continue an existing lane. This rung gives it open_lane — fork a new lane by
# appending the first revision on a fresh path. Together they are the editor's "new
# file" and "edit file", both appends to the same append-only Mantra catalog. The proof:
# opening a lane grows the rendered graph by exactly one new lane line (c.txt: r1[…]),
# its lane count up by one, every existing lane byte-for-byte unchanged; the forked lane
# is then a lane like any other (a commit chains r1 -> r2); opening a path that already
# carries a leaf refuses LaneExists.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_mantra_editor_fork_witness.rish

say "buhr-j4r3: Language EN — the editor can fork a new lane (open_lane) as well as continue one (commit); both are appends to the log."
say "buhr-j4r3: Lens TAME — proven at the graph level; a fork grows the graph by one lane, existing lanes unchanged, a duplicate open refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mantra-editor-fork"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_editor_fork.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j4r3: mantra_editor_fork build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j4r3: mantra_editor_fork selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j4r3: selftest did not speak GREEN"
assert selftest.out contains "the graph gained one lane, every existing lane unchanged" else "buhr-j4r3: the fork-opens-a-lane proof is missing"
assert selftest.out contains "the forked lane is a lane like any other" else "buhr-j4r3: the forked-lane-is-a-lane proof is missing"
assert selftest.out contains "opening an existing lane refuses — LaneExists" else "buhr-j4r3: the duplicate-open refuse proof is missing"

# Rung one (editor) stays its own green binary — open_lane is additive beside commit.
let editor = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_mantra_editor_witness.rish 2>&1"]
assert editor.ok else "buhr-j4r3: the editor (rung one) witness regressed"
assert editor.out contains "GREEN: BUHR-J4r1" else "buhr-j4r3: the editor lost its green"

say "GREEN: BUHR-J4r3 — the editor forks a new lane and continues it; open and commit are the editor's two appends to one log."
