# dated_preference_auditor.rish — advisory report wrapper (e238).
# Never reds. Body: tools/dated_preference_auditor.sh
#
#   rishi/bin/rishi run tools/dated_preference_auditor.rish

say "dated-preference-auditor: Language EN — preference report, not a gate."
say "dated-preference-auditor: Lens TAME — measure the superseding-seat preference."

let body = run ["sh" "tools/dated_preference_auditor.sh"]
say body.out
assert body.ok else "dated-preference-auditor: shell failed (instrument error, not a preference red)"
say "GREEN: dated-preference-auditor — report printed; no gate."
