# lattice_reshape_witness.rish -- the Lattice reshape operation, proven on metal (landed `20260713.211127`).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/l/lattice_reshape_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "lattice/bin/lattice"

let build = run ["sh" "-c" "mkdir -p lattice/bin && env RYE_ZIG=${zig} rye/bin/rye build lattice/lattice.rye -femit-bin=${bin}"]
assert build.ok else "Lattice build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Lattice selftest exited non-zero"
assert selftest.out contains "GREEN" else "Lattice selftest not GREEN"
assert selftest.out contains "reshape 2x3" else "Lattice missing reshape welcome"
assert selftest.out contains "reshape count mismatch refused" else "Lattice missing reshape unwelcome"

say "GREEN: Lattice row-major reshape with element-count asserts."
