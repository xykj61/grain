# lattice_suite_witness.rish -- one choir for Lattice's forty bounded operations.
#
# The suite first pins the on-disk roster at forty, then runs every registered lap.
# Each lap builds the module and proves its admitted operation plus its shape refusal,
# so one GREEN closes both sides of every arithmetic seam. A new unregistered lap
# raises the disk count and refuses here rather than standing unheard.

let disk = run ["sh" "-c" "find tools/l -maxdepth 1 -type f -name 'lattice_*_witness.rish' ! -name 'lattice_suite_witness.rish' | wc -l | tr -d ' \n'"]
assert disk.ok else "lattice-suite: could not count the lap witnesses -- ${disk.err}"
assert (trim disk.out) == "40" else "lattice-suite: expected forty lap witnesses on disk -- ${disk.out}"

let witnesses = [ "tools/l/lattice_matmul_witness.rish" "tools/l/lattice_add_witness.rish" "tools/l/lattice_reshape_witness.rish" "tools/l/lattice_reduce_sum_witness.rish" "tools/l/lattice_scale_witness.rish" "tools/l/lattice_transpose_witness.rish" "tools/l/lattice_mul_witness.rish" "tools/l/lattice_fill_witness.rish" "tools/l/lattice_copy_witness.rish" "tools/l/lattice_sub_witness.rish" "tools/l/lattice_neg_witness.rish" "tools/l/lattice_div_witness.rish" "tools/l/lattice_reduce_mean_witness.rish" "tools/l/lattice_abs_witness.rish" "tools/l/lattice_clamp_witness.rish" "tools/l/lattice_reduce_max_witness.rish" "tools/l/lattice_reduce_min_witness.rish" "tools/l/lattice_sqrt_witness.rish" "tools/l/lattice_exp_witness.rish" "tools/l/lattice_log_witness.rish" "tools/l/lattice_pow_witness.rish" "tools/l/lattice_relu_witness.rish" "tools/l/lattice_sigmoid_witness.rish" "tools/l/lattice_softmax_witness.rish" "tools/l/lattice_tanh_witness.rish" "tools/l/lattice_gelu_witness.rish" "tools/l/lattice_silu_witness.rish" "tools/l/lattice_leaky_relu_witness.rish" "tools/l/lattice_softplus_witness.rish" "tools/l/lattice_maximum_witness.rish" "tools/l/lattice_minimum_witness.rish" "tools/l/lattice_elu_witness.rish" "tools/l/lattice_softsign_witness.rish" "tools/l/lattice_square_witness.rish" "tools/l/lattice_sign_witness.rish" "tools/l/lattice_reciprocal_witness.rish" "tools/l/lattice_hard_sigmoid_witness.rish" "tools/l/lattice_rsqrt_witness.rish" "tools/l/lattice_hardtanh_witness.rish" "tools/l/lattice_cube_witness.rish" ]

for-each witnesses as witness do assert (run ["rishi/bin/rishi" "run" witness]).ok else "lattice-suite: a lap witness went red -- ${witness}"

say "GREEN lattice-suite -- forty Lattice witnesses registered and run; each operation and its shape refusal proved on metal"
