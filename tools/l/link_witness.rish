# link_witness.rish -- blocking relative-markdown link completeness.
# Counsel 20260726.020825 - T0 - ROUND MODE 20260726.025120.
# Sound Chapter breach instrument (round 0 raise `20260727.221508`):
#   tools/fixtures/sound_season/README.md -- SNAPSHOT before yonder/re-point,
#   COMPARE after; no new missing targets.
#
# Positive: context/fixtures/link_witness_valid.md must PASS.
# Negative: context/fixtures/link_witness_broken.md must FAIL.
# Tree walk: LINK_WITNESS_ALLOW_BASELINE=1 for the first honest count.
# ROUND MODE (via scan env; used each T3 / Sound breach motion):
#   LINK_WITNESS_SNAPSHOT=<path>   -- capture sorted dangling set
#   LINK_WITNESS_COMPARE=<path>    -- assert AFTER is a subset of BEFORE
# ALLOW_BASELINE is IGNORED in COMPARE -- if it can suppress a red there, STOP.
#
# WHERE THE SNAPSHOT GOES, and why the example moved off `/tmp` (`20260907.191214`). The four lines
# below taught `/tmp/dangling_before.txt`, a name fixed at write time, on a pier where eight ships
# share one TMPDIR -- so a reader copying them ran the SNAPSHOT in this tree and, if a peer had run
# the same command, took the COMPARE against a dangling set from somebody else's checkout. Two
# different trees compared as one can read GREEN while a real new dangling link stands. `mktemp`
# cannot serve here, because the two commands are two shells and the file has to outlive the first;
# the tree's own answer is its per-checkout untracked window, `session-output/` (gitignored, seated
# `20260828`). REDS %549 booked the habit; this is the doc that was teaching against it.
#
#   rishi/bin/rishi run tools/l/link_witness.rish
#   mkdir -p session-output
#   LINK_WITNESS_SNAPSHOT=session-output/link-dangling-before.txt sh tools/fixtures/l/link_witness_scan.sh
#   LINK_WITNESS_COMPARE=session-output/link-dangling-before.txt  sh tools/fixtures/l/link_witness_scan.sh

say "link_witness: fixture PASS (valid relative links)…"
let pass = run ["sh" "-c" "LINK_WITNESS_FILES='context/fixtures/link_witness_valid.md' sh tools/fixtures/l/link_witness_scan.sh"]
say pass.out
assert pass.ok else "link_witness valid fixture RED — witness broken"

say "link_witness: fixture FAIL (broken relative link)…"
let fail = run ["sh" "-c" "LINK_WITNESS_FILES='context/fixtures/link_witness_broken.md' sh tools/fixtures/l/link_witness_scan.sh"]
assert fail.ok == false else "link_witness broken fixture passed — witness toothless"
assert fail.out contains "dangling" else "broken fixture must report dangling"

say "link_witness: tree walk (baseline allow)…"
# Hardcoded ALLOW_BASELINE=1 -- Rishi does not expand shell ${...} in string literals.
let walk = run ["sh" "-c" "LINK_WITNESS_ALLOW_BASELINE=1 sh tools/fixtures/l/link_witness_scan.sh"]
say walk.out
assert walk.ok else "link_witness tree walk RED"

say "link_witness: ROUND MODE self-check (snapshot · compare equal · deliberate break)…"
let round = run ["sh" "tools/fixtures/l/link_witness_round_mode_selfcheck.sh"]
say round.out
assert round.ok else "link_witness ROUND MODE self-check RED"

say "GREEN: link_witness — fixtures · tree baseline · ROUND MODE toothful."
