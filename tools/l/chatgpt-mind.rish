let git_wrapper_link = run ["test" "-L" git_wrapper_abs]
let git_zshenv_file = run ["test" "-f" git_zshenv_abs]
let git_zprofile_file = run ["test" "-f" git_zprofile_abs]
let git_zshenv_link = run ["test" "-L" git_zshenv_abs]
let git_zprofile_link = run ["test" "-L" git_zprofile_abs]
assert git_wrapper_file.ok else "REFUSE chatgpt-mind: tracked Git doorway is absent"
assert git_wrapper_exec.ok else "REFUSE chatgpt-mind: tracked Git doorway is not executable"
assert git_wrapper_link.ok == false else "REFUSE chatgpt-mind: tracked Git doorway cannot be a symlink"
assert git_zshenv_file.ok else "REFUSE chatgpt-mind: tracked zsh environment doorway is absent"
assert git_zprofile_file.ok else "REFUSE chatgpt-mind: tracked zsh profile doorway is absent"
assert git_zshenv_link.ok == false else "REFUSE chatgpt-mind: tracked zsh environment doorway cannot be a symlink"
assert git_zprofile_link.ok == false else "REFUSE chatgpt-mind: tracked zsh profile doorway cannot be a symlink"
let git_path_arg = "PATH=${repo_root}/tools/l/mind-bin:/opt/homebrew/Cellar/git/2.53.0_1/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
let git_exec_arg = "GRAIN_MIND_GIT=${git_wrapper_abs}"
let git_raw_arg = "GRAIN_MIND_GIT_RAW=${git_exec}"
let git_root_arg = "GRAIN_MIND_ROOT=${repo_root}"
let git_zdotdir_arg = "ZDOTDIR=${git_shell_abs}"
let host_home_raw = env "HOME"
assert host_home_raw != "" else "REFUSE chatgpt-mind: host HOME is absent"
let host_home_real = run ["/bin/realpath" host_home_raw]
assert host_home_real.ok else "REFUSE chatgpt-mind: host HOME could not be canonically resolved"
let host_home = trim host_home_real.out
let host_home_dir = run ["test" "-d" host_home]
let host_home_link = run ["test" "-L" host_home]
assert host_home_dir.ok else "REFUSE chatgpt-mind: canonical host HOME is not a directory"
assert host_home_link.ok == false else "REFUSE chatgpt-mind: canonical host HOME cannot be a symlink"
let host_gnupg_raw = env "GNUPGHOME"
let host_gnupg_candidate = ?: (host_gnupg_raw == "") (host_home + "/.gnupg") host_gnupg_raw
let host_gnupg_real = run ["/bin/realpath" host_gnupg_candidate]
assert host_gnupg_real.ok else "REFUSE chatgpt-mind: host GnuPG home could not be canonically resolved"
let host_gnupg = trim host_gnupg_real.out
let host_gnupg_dir = run ["test" "-d" host_gnupg]
let host_gnupg_link = run ["test" "-L" host_gnupg]
assert host_gnupg_dir.ok else "REFUSE chatgpt-mind: canonical host GnuPG home is not a directory"
assert host_gnupg_link.ok == false else "REFUSE chatgpt-mind: canonical host GnuPG home cannot be a symlink"
let host_home_arg = "HOME=${host_home}"
let host_gnupg_arg = "GNUPGHOME=${host_gnupg}"
let host_tool_path_arg = "PATH=/opt/homebrew/Cellar/gnupg/2.5.18/bin:/opt/homebrew/Cellar/git/2.53.0_1/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
let git_argv = ["/usr/bin/env" "-i" host_home_arg host_gnupg_arg host_tool_path_arg git_exec_arg git_raw_arg git_root_arg git_zdotdir_arg git_dyld_arg git_no_system_arg git_no_global_arg git_exec]
fn git-run tail: run (git_argv + tail)

let gpg_link = "/opt/homebrew/bin/gpg"
let gpg_expected = "/opt/homebrew/Cellar/gnupg/2.5.18/bin/gpg"
let gpg_real = run ["/bin/realpath" gpg_link]
assert gpg_real.ok else "REFUSE chatgpt-mind: host GPG could not be canonically resolved"
let gpg_exec = trim gpg_real.out
assert gpg_exec == gpg_expected else "REFUSE chatgpt-mind: host GPG canonical target drifted"
let gpg_exec_file = run ["test" "-f" gpg_exec]
let gpg_exec_check = run ["test" "-x" gpg_exec]
let gpg_exec_link = run ["test" "-L" gpg_exec]
assert gpg_exec_file.ok else "REFUSE chatgpt-mind: canonical host GPG is not a regular file"
assert gpg_exec_check.ok else "REFUSE chatgpt-mind: canonical host GPG is not executable"
assert gpg_exec_link.ok == false else "REFUSE chatgpt-mind: canonical host GPG remains a symlink"
let gpg_argv = ["/usr/bin/env" "-i" host_home_arg host_gnupg_arg host_tool_path_arg gpg_exec]

let signing_key_run = git-run ["-C" repo_root "config" "--local" "--get" "user.signingkey"]
let signing_format_run = git-run ["-C" repo_root "config" "--local" "--get" "gpg.format"]
let signing_program_run = git-run ["-C" repo_root "config" "--local" "--get" "gpg.program"]
let signing_required_run = git-run ["-C" repo_root "config" "--local" "--bool" "--get" "commit.gpgsign"]
let signing_name_run = git-run ["-C" repo_root "config" "--local" "--get" "user.name"]
let signing_email_run = git-run ["-C" repo_root "config" "--local" "--get" "user.email"]
let hooks_path_run = git-run ["-C" repo_root "config" "--local" "--get" "core.hooksPath"]
assert signing_key_run.ok else "REFUSE chatgpt-mind: project-local signing key is absent"
assert signing_format_run.ok else "REFUSE chatgpt-mind: project-local signing format is absent"
assert signing_program_run.ok else "REFUSE chatgpt-mind: project-local signing program is absent"
assert signing_required_run.ok else "REFUSE chatgpt-mind: project-local signed-commit law is absent"
assert signing_name_run.ok else "REFUSE chatgpt-mind: project-local author name is absent"
assert signing_email_run.ok else "REFUSE chatgpt-mind: project-local author email is absent"
assert hooks_path_run.ok else "REFUSE chatgpt-mind: project-local hooks path is absent"
let signing_key = trim signing_key_run.out
assert length signing_key == 40 else "REFUSE chatgpt-mind: project-local signing fingerprint is not forty bytes"
assert (trim signing_format_run.out) == "openpgp" else "REFUSE chatgpt-mind: project-local signing format is not OpenPGP"
assert (trim signing_program_run.out) == gpg_exec else "REFUSE chatgpt-mind: project-local signing program is not canonical host GPG"
assert (trim signing_required_run.out) == "true" else "REFUSE chatgpt-mind: project-local signed-commit law is not true"
assert (trim signing_name_run.out) != "" else "REFUSE chatgpt-mind: project-local author name is empty"
assert (trim signing_email_run.out) != "" else "REFUSE chatgpt-mind: project-local author email is empty"
assert (trim hooks_path_run.out) == "tools/hooks" else "REFUSE chatgpt-mind: project-local hooks path drifted"

let pre_commit_hook = repo_root + "/tools/hooks/pre-commit"
let commit_msg_hook = repo_root + "/tools/hooks/commit-msg"
# The seat (20260829, the fleet re-map): this supervisor serves two Codex bodies. MIND_SEAT
# selects cardinal (default -- Mind, the Surf/Skate lane) or mystery (the campaign lane), and
# BOTH seats' lane-scanner pins stay spelled here in the tracked harness -- an env-supplied
# pin would be a door beside the wall, so the env selects between pinned pairs and nothing more.
let seat_env = env "MIND_SEAT"
let seat = ?: (seat_env == "") ("cardinal") (seat_env)
assert ?| [(seat == "cardinal") (seat == "mystery")] else "REFUSE chatgpt-mind: MIND_SEAT must be cardinal or mystery"
let mind_lane_scan = ?: (seat == "mystery") (repo_root + "/tools/fixtures/c/chatgpt_mystery_lane.awk") (repo_root + "/tools/fixtures/c/chatgpt_mind_lane.awk")
let mind_lane_sha256 = ?: (seat == "mystery") ("3fed4364a13bd20d2051d91a6fa2abd48e5ec873706dd2e03b60234f5f3016df") ("62cc0dd65b0df7215ffd7e4a78274fe0e4a122b4787d8def24ef19ead2b96071")
let pre_commit_file = run ["test" "-f" pre_commit_hook]
let pre_commit_exec = run ["test" "-x" pre_commit_hook]
let pre_commit_link = run ["test" "-L" pre_commit_hook]
let commit_msg_file = run ["test" "-f" commit_msg_hook]
let commit_msg_exec = run ["test" "-x" commit_msg_hook]
let commit_msg_link = run ["test" "-L" commit_msg_hook]
let mind_lane_file = run ["test" "-f" mind_lane_scan]
let mind_lane_link = run ["test" "-L" mind_lane_scan]
let mind_lane_hash = run ["/usr/bin/shasum" "-a" "256" mind_lane_scan]
assert pre_commit_file.ok else "REFUSE chatgpt-mind: tracked pre-commit hook is absent"
assert pre_commit_exec.ok else "REFUSE chatgpt-mind: tracked pre-commit hook is not executable"
assert pre_commit_link.ok == false else "REFUSE chatgpt-mind: tracked pre-commit hook cannot be a symlink"
assert commit_msg_file.ok else "REFUSE chatgpt-mind: tracked commit-message hook is absent"
assert commit_msg_exec.ok else "REFUSE chatgpt-mind: tracked commit-message hook is not executable"
assert commit_msg_link.ok == false else "REFUSE chatgpt-mind: tracked commit-message hook cannot be a symlink"
assert mind_lane_file.ok else "REFUSE chatgpt-mind: tracked MIND lane scanner is absent"
assert mind_lane_link.ok == false else "REFUSE chatgpt-mind: tracked MIND lane scanner cannot be a symlink"
assert mind_lane_hash.ok else "REFUSE chatgpt-mind: tracked MIND lane scanner could not be hashed"
assert (trim mind_lane_hash.out) starts-with mind_lane_sha256 else "REFUSE chatgpt-mind: tracked MIND lane scanner drifted"

let git_metadata = repo_root + "/.git"
let git_metadata_dir = run ["test" "-d" git_metadata]
let git_metadata_link = run ["test" "-L" git_metadata]
assert git_metadata_dir.ok else "REFUSE chatgpt-mind: MIND needs a standalone clone with an internal .git directory"
assert git_metadata_link.ok == false else "REFUSE chatgpt-mind: standalone .git cannot be a symlink"
let git_dir_run = git-run ["-C" repo_root "rev-parse" "--path-format=absolute" "--git-dir"]
let git_common_run = git-run ["-C" repo_root "rev-parse" "--path-format=absolute" "--git-common-dir"]
assert git_dir_run.ok else "REFUSE chatgpt-mind: Homebrew Git could not resolve the repository administration path"
assert git_common_run.ok else "REFUSE chatgpt-mind: Homebrew Git could not resolve the common administration path"
assert (trim git_dir_run.out) == git_metadata else "REFUSE chatgpt-mind: Git administration escapes the standalone clone"
assert (trim git_common_run.out) == git_metadata else "REFUSE chatgpt-mind: Git common administration escapes the standalone clone"
let git_config_abs = git_metadata + "/config"
let git_head_abs = git_metadata + "/HEAD"
let git_refs_abs = git_metadata + "/refs"
let git_logs_abs = git_metadata + "/logs"
let git_packed_refs_abs = git_metadata + "/packed-refs"
let git_config_file = run ["test" "-f" git_config_abs]
let git_head_file = run ["test" "-f" git_head_abs]
let git_refs_dir = run ["test" "-d" git_refs_abs]
let git_logs_dir = run ["test" "-d" git_logs_abs]
let git_packed_refs_file = run ["test" "-f" git_packed_refs_abs]
assert git_config_file.ok else "REFUSE chatgpt-mind: standalone Git config is absent"
assert git_head_file.ok else "REFUSE chatgpt-mind: standalone Git HEAD is absent"
assert git_refs_dir.ok else "REFUSE chatgpt-mind: standalone Git refs are absent"
assert git_logs_dir.ok else "REFUSE chatgpt-mind: standalone Git logs are absent"

let state_link = run ["test" "-L" state_rel]
assert state_link.ok == false else "REFUSE chatgpt-mind: state directory cannot be a symlink"
let dirs = run ["mkdir" "-p" state_rel log_rel codex_home_rel preflight_rel signing_rel]
assert dirs.ok else "REFUSE chatgpt-mind: could not prepare bounded repository-local state"
let codex_home_link = run ["test" "-L" codex_home_rel]
let log_link = run ["test" "-L" log_rel]
let preflight_link = run ["test" "-L" preflight_rel]
let signing_link = run ["test" "-L" signing_rel]
assert codex_home_link.ok == false else "REFUSE chatgpt-mind: Codex home cannot be a symlink"
assert log_link.ok == false else "REFUSE chatgpt-mind: log directory cannot be a symlink"
assert preflight_link.ok == false else "REFUSE chatgpt-mind: preflight directory cannot be a symlink"
assert signing_link.ok == false else "REFUSE chatgpt-mind: signing directory cannot be a symlink"

let stop_err = preflight_rel + "/stop.err"
if mode == "stop" then let stop_make = run-bounded { argv: ["/usr/bin/true"], stdin: "", stdin-max: 0, stdout-path: stop_rel, stdout-max: 0, stderr-path: stop_err, stderr-max: 4096 }
if mode == "stop" then assert stop_make.ok
if mode == "stop" then say "chatgpt-mind: stop requested at ${stop_abs}"
if mode == "stop" then exit 0

let printer_err = preflight_rel + "/printer.err"
let prompt_printer = ?: (seat == "mystery") ("tools/l/print-mystery-planet-prompt.rish") ("tools/l/print-mind-cardinal-prompt.rish")
let printer = run-bounded { argv: [rishi_bin "run" prompt_printer], stdin: "", stdin-max: 0, stdout-path: prompt_rel, stdout-max: max_prompt_bytes, stderr-path: printer_err, stderr-max: 4096 }
assert printer.ok else "REFUSE chatgpt-mind: canonical Rishi prompt printer failed"
assert printer.stdout-bytes >= 1 else "REFUSE chatgpt-mind: canonical prompt is empty"

if mode == "print" then let printed_prompt = read-file prompt_rel
if mode == "print" then let printed_end = (length printed_prompt) - 1
if mode == "print" then say slice printed_prompt 0 printed_end
if mode == "print" then exit 0

let ai_override = env "MIND_AI_JAIL_BIN"
let ai_which = run ["/usr/bin/which" "ai-jail"]
let ai_found = trim ai_which.out
let ai_jail = ?: (ai_override != "") ai_override ai_found
let ai_check = run ["test" "-x" ai_jail]
assert ai_check.ok else "REFUSE chatgpt-mind: ai-jail is absent from PATH"

let codex_override = env "MIND_CODEX_BIN"
let codex_which = run ["/usr/bin/which" "codex"]
let codex_found = trim codex_which.out
let codex_candidate = ?: (codex_override != "") codex_override codex_found
let codex_bin = ?: (codex_candidate == "") "/Applications/ChatGPT.app/Contents/Resources/codex" codex_candidate
let codex_check = run ["test" "-x" codex_bin]
assert codex_check.ok else "REFUSE chatgpt-mind: Codex CLI is absent from PATH and ChatGPT.app"
let codex_real = run ["/bin/realpath" codex_bin]
assert codex_real.ok else "REFUSE chatgpt-mind: Codex CLI could not be canonically resolved"
let codex_exec = trim codex_real.out
assert codex_exec starts-with "/" else "REFUSE chatgpt-mind: canonical Codex CLI path must be absolute"
let codex_exec_check = run ["test" "-x" codex_exec]
assert codex_exec_check.ok else "REFUSE chatgpt-mind: canonical Codex CLI target is not executable"
let codex_exec_link = run ["test" "-L" codex_exec]
assert codex_exec_link.ok == false else "REFUSE chatgpt-mind: canonical Codex CLI path remains a symlink"
let packed_refs_maps = ?: git_packed_refs_file.ok (["--map" git_packed_refs_abs]) ([])
let jail_maps = ["--map" codex_exec "--map" git_exec "--map" git_pcre "--map" git_intl "--map" rishi_abs "--map" git_wrapper_abs "--map" git_zshenv_abs "--map" git_zprofile_abs "--map" pre_commit_hook "--map" commit_msg_hook "--map" mind_lane_scan "--map" git_config_abs "--map" git_head_abs "--map" git_refs_abs "--map" git_logs_abs] + packed_refs_maps

let codex_help_out = preflight_rel + "/codex-help.out"
let codex_help_err = preflight_rel + "/codex-help.err"
let codex_help_run = run-bounded { argv: [codex_exec "exec" "--help"], stdin: "", stdin-max: 0, stdout-path: codex_help_out, stdout-max: 65536, stderr-path: codex_help_err, stderr-max: 65536 }
assert codex_help_run.ok else "REFUSE chatgpt-mind: Codex exec help did not run"
let codex_help = (read-file codex_help_out) + (read-file codex_help_err)
assert codex_help contains "--disable <FEATURE>" else "REFUSE chatgpt-mind: Codex exec lacks the current feature override"
assert codex_help contains "--sandbox <SANDBOX_MODE>" else "REFUSE chatgpt-mind: Codex exec lacks the current sandbox option"
assert codex_help contains "danger-full-access" else "REFUSE chatgpt-mind: Codex exec lacks danger-full-access"

let codex_retry_feature_out = preflight_rel + "/codex-retry-feature.out"
let codex_retry_feature_err = preflight_rel + "/codex-retry-feature.err"
let codex_retry_feature_run = run-bounded { argv: ["/usr/bin/env" "CODEX_HOME=${codex_home_abs}" "TMPDIR=/private/tmp" codex_exec "--disable" "unbounded_connection_retries" "features" "list"], stdin: "", stdin-max: 0, stdout-path: codex_retry_feature_out, stdout-max: 65536, stderr-path: codex_retry_feature_err, stderr-max: 65536 }
assert codex_retry_feature_run.overflow == "" else "REFUSE chatgpt-mind: Codex feature probe crossed its byte wall"
assert codex_retry_feature_run.ok else "REFUSE chatgpt-mind: Codex lacks the required finite connection-retry override"
let codex_retry_feature_match_out = preflight_rel + "/codex-retry-feature-match.out"
let codex_retry_feature_match_err = preflight_rel + "/codex-retry-feature-match.err"
let codex_retry_feature_match_run = run-bounded { argv: ["/usr/bin/grep" "-E" "^unbounded_connection_retries[[:space:]]+[^[:space:]]+[[:space:]]+false$"], stdin: (read-file codex_retry_feature_out), stdin-max: 65536, stdout-path: codex_retry_feature_match_out, stdout-max: 4096, stderr-path: codex_retry_feature_match_err, stderr-max: 4096 }
assert codex_retry_feature_match_run.overflow == "" else "REFUSE chatgpt-mind: Codex finite-retry feature receipt crossed its byte wall"
assert codex_retry_feature_match_run.ok else "REFUSE chatgpt-mind: Codex did not confirm the finite connection-retry override"

let jail_plan_out = preflight_rel + "/jail-plan.out"
let jail_plan_err = preflight_rel + "/jail-plan.err"
let jail_plan_run = run-bounded { argv: ([ai_jail "--dry-run"] + jail_maps + ["--exec" "--private-home" "--no-save-config" "/usr/bin/true"]), stdin: "", stdin-max: 0, stdout-path: jail_plan_out, stdout-max: 65536, stderr-path: jail_plan_err, stderr-max: 65536 }
assert jail_plan_run.ok else "REFUSE chatgpt-mind: ai-jail could not render its macOS plan"
let jail_plan = (read-file jail_plan_out) + (read-file jail_plan_err)
assert jail_plan contains "sandbox-exec" else "REFUSE chatgpt-mind: outer jail did not select macOS Seatbelt"
assert jail_plan contains "(deny default)" else "REFUSE chatgpt-mind: outer jail plan is not deny-by-default"
assert jail_plan contains repo_root else "REFUSE chatgpt-mind: outer jail plan does not name this repository"
assert jail_plan contains "(allow file-write*" else "REFUSE chatgpt-mind: outer jail plan lacks an explicit write lane"
let dq = read-file "tools/fixtures/d/dquote.txt"
assert length dq == 1 else "REFUSE chatgpt-mind: quote fixture is not one byte"
assert (codex_exec contains dq) == false else "REFUSE chatgpt-mind: canonical Codex CLI path cannot be encoded safely in the jail plan"
let codex_plan_allow = "(allow file-read* (literal " + dq + codex_exec + dq + "))"
let codex_plan_deny = "(deny file-write* (literal " + dq + codex_exec + dq + "))"
let map_allow_out = preflight_rel + "/codex-map-allow.out"
let map_allow_err = preflight_rel + "/codex-map-allow.err"
let map_allow_run = run-bounded { argv: ["/usr/bin/grep" "-F" "-x" codex_plan_allow], stdin: jail_plan, stdin-max: 65536, stdout-path: map_allow_out, stdout-max: 4096, stderr-path: map_allow_err, stderr-max: 4096 }
assert map_allow_run.overflow == "" else "REFUSE chatgpt-mind: Codex map allow proof crossed its byte wall"
assert map_allow_run.ok else "REFUSE chatgpt-mind: outer jail plan does not map the canonical Codex CLI read-only"
assert trim (read-file map_allow_out) == codex_plan_allow else "REFUSE chatgpt-mind: outer jail Codex allow mapping is ambiguous"
let map_deny_out = preflight_rel + "/codex-map-deny.out"
let map_deny_err = preflight_rel + "/codex-map-deny.err"
let map_deny_run = run-bounded { argv: ["/usr/bin/grep" "-F" "-x" codex_plan_deny], stdin: jail_plan, stdin-max: 65536, stdout-path: map_deny_out, stdout-max: 4096, stderr-path: map_deny_err, stderr-max: 4096 }
assert map_deny_run.overflow == "" else "REFUSE chatgpt-mind: Codex map deny proof crossed its byte wall"
assert map_deny_run.ok else "REFUSE chatgpt-mind: outer jail plan does not deny writes to the canonical Codex CLI"
assert trim (read-file map_deny_out) == codex_plan_deny else "REFUSE chatgpt-mind: outer jail Codex deny mapping is ambiguous"
assert (git_exec contains dq) == false else "REFUSE chatgpt-mind: canonical Homebrew Git path cannot be encoded safely in the jail plan"
let git_plan_allow = "(allow file-read* (literal " + dq + git_exec + dq + "))"
let git_plan_deny = "(deny file-write* (literal " + dq + git_exec + dq + "))"
let git_map_allow_out = preflight_rel + "/git-map-allow.out"
let git_map_allow_err = preflight_rel + "/git-map-allow.err"
let git_map_allow_run = run-bounded { argv: ["/usr/bin/grep" "-F" "-x" git_plan_allow], stdin: jail_plan, stdin-max: 65536, stdout-path: git_map_allow_out, stdout-max: 4096, stderr-path: git_map_allow_err, stderr-max: 4096 }
assert git_map_allow_run.overflow == "" else "REFUSE chatgpt-mind: Git map allow proof crossed its byte wall"
assert git_map_allow_run.ok else "REFUSE chatgpt-mind: outer jail plan does not map canonical Homebrew Git read-only"
assert trim (read-file git_map_allow_out) == git_plan_allow else "REFUSE chatgpt-mind: outer jail Git allow mapping is ambiguous"
let git_map_deny_out = preflight_rel + "/git-map-deny.out"
let git_map_deny_err = preflight_rel + "/git-map-deny.err"
let git_map_deny_run = run-bounded { argv: ["/usr/bin/grep" "-F" "-x" git_plan_deny], stdin: jail_plan, stdin-max: 65536, stdout-path: git_map_deny_out, stdout-max: 4096, stderr-path: git_map_deny_err, stderr-max: 4096 }
assert git_map_deny_run.overflow == "" else "REFUSE chatgpt-mind: Git map deny proof crossed its byte wall"
assert git_map_deny_run.ok else "REFUSE chatgpt-mind: outer jail plan does not deny writes to canonical Homebrew Git"
assert trim (read-file git_map_deny_out) == git_plan_deny else "REFUSE chatgpt-mind: outer jail Git deny mapping is ambiguous"
let pcre_plan_allow = "(allow file-read* (literal " + dq + git_pcre + dq + "))"
let pcre_plan_deny = "(deny file-write* (literal " + dq + git_pcre + dq + "))"
let intl_plan_allow = "(allow file-read* (literal " + dq + git_intl + dq + "))"
let intl_plan_deny = "(deny file-write* (literal " + dq + git_intl + dq + "))"
let rishi_plan_allow = "(allow file-read* (literal " + dq + rishi_abs + dq + "))"
let rishi_plan_deny = "(deny file-write* (literal " + dq + rishi_abs + dq + "))"
let wrapper_plan_allow = "(allow file-read* (literal " + dq + git_wrapper_abs + dq + "))"
let wrapper_plan_deny = "(deny file-write* (literal " + dq + git_wrapper_abs + dq + "))"
let zshenv_plan_deny = "(deny file-write* (literal " + dq + git_zshenv_abs + dq + "))"
let zprofile_plan_deny = "(deny file-write* (literal " + dq + git_zprofile_abs + dq + "))"
let pre_commit_plan_deny = "(deny file-write* (literal " + dq + pre_commit_hook + dq + "))"
let commit_msg_plan_deny = "(deny file-write* (literal " + dq + commit_msg_hook + dq + "))"
let mind_lane_plan_deny = "(deny file-write* (literal " + dq + mind_lane_scan + dq + "))"
let config_plan_deny = "(deny file-write* (literal " + dq + git_config_abs + dq + "))"
let head_plan_deny = "(deny file-write* (literal " + dq + git_head_abs + dq + "))"
let refs_plan_deny = "(deny file-write* (subpath " + dq + git_refs_abs + dq + "))"
let logs_plan_deny = "(deny file-write* (subpath " + dq + git_logs_abs + dq + "))"
let packed_refs_plan_deny = "(deny file-write* (literal " + dq + git_packed_refs_abs + dq + "))"
assert jail_plan contains pcre_plan_allow else "REFUSE chatgpt-mind: outer jail plan lacks exact Homebrew Git PCRE2 read access"
assert jail_plan contains pcre_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact Homebrew Git PCRE2 write denial"
assert jail_plan contains intl_plan_allow else "REFUSE chatgpt-mind: outer jail plan lacks exact Homebrew Git gettext read access"
assert jail_plan contains intl_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact Homebrew Git gettext write denial"
assert jail_plan contains rishi_plan_allow else "REFUSE chatgpt-mind: outer jail plan lacks exact Rishi read access"
assert jail_plan contains rishi_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact Rishi write denial"
assert jail_plan contains wrapper_plan_allow else "REFUSE chatgpt-mind: outer jail plan lacks exact tracked Git doorway read access"
assert jail_plan contains wrapper_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact tracked Git doorway write denial"
assert jail_plan contains zshenv_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact zsh environment doorway write denial"
assert jail_plan contains zprofile_plan_deny else "REFUSE chatgpt-mind: outer jail plan lacks exact zsh profile doorway write denial"
assert jail_plan contains pre_commit_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect the pre-commit hook"
assert jail_plan contains commit_msg_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect the commit-message hook"
assert jail_plan contains mind_lane_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect the MIND lane scanner"
assert jail_plan contains config_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect project-local Git config"
assert jail_plan contains head_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect Git HEAD"
assert jail_plan contains refs_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect Git refs"
assert jail_plan contains logs_plan_deny else "REFUSE chatgpt-mind: outer jail plan does not protect Git reflogs"
assert ?| [(git_packed_refs_file.ok == false) (jail_plan contains packed_refs_plan_deny)] else "REFUSE chatgpt-mind: outer jail plan does not protect packed refs"
assert (jail_plan contains "/usr/bin/git") == false else "REFUSE chatgpt-mind: outer jail plan admitted Apple Git"
assert (jail_plan contains "/var/select") == false else "REFUSE chatgpt-mind: outer jail plan admitted the Apple developer selector"
assert (jail_plan contains gpg_exec) == false else "REFUSE chatgpt-mind: outer jail plan exposed host GPG to Codex"
assert jail_plan contains "/.ssh" else "REFUSE chatgpt-mind: private-home plan does not deny SSH state"
assert jail_plan contains "/.gnupg" else "REFUSE chatgpt-mind: private-home plan does not deny GPG state"

let ai_version_out = preflight_rel + "/ai-version.out"
let ai_version_err = preflight_rel + "/ai-version.err"
let ai_version_run = run-bounded { argv: [ai_jail "--version"], stdin: "", stdin-max: 0, stdout-path: ai_version_out, stdout-max: 4096, stderr-path: ai_version_err, stderr-max: 4096 }
assert ai_version_run.ok else "REFUSE chatgpt-mind: ai-jail version check failed"
let codex_version_out = preflight_rel + "/codex-version.out"
let codex_version_err = preflight_rel + "/codex-version.err"
let codex_version_run = run-bounded { argv: [codex_exec "--version"], stdin: "", stdin-max: 0, stdout-path: codex_version_out, stdout-max: 4096, stderr-path: codex_version_err, stderr-max: 4096 }
assert codex_version_run.ok else "REFUSE chatgpt-mind: Codex version check failed"
let git_version_out = preflight_rel + "/git-version.out"
let git_version_err = preflight_rel + "/git-version.err"
let git_version_run = run-bounded { argv: [git_exec "--version"], stdin: "", stdin-max: 0, stdout-path: git_version_out, stdout-max: 4096, stderr-path: git_version_err, stderr-max: 4096 }
assert git_version_run.ok else "REFUSE chatgpt-mind: Homebrew Git version check failed"
let git_version = trim (read-file git_version_out)
assert git_version == "git version 2.53.0" else "REFUSE chatgpt-mind: Homebrew Git version drifted"
let ai_version = trim (read-file ai_version_out)
let codex_version = trim (read-file codex_version_out)
say "chatgpt-mind: ${ai_version}"
say "chatgpt-mind: ${codex_version}"
say "chatgpt-mind: ${git_version} at ${git_exec}"
say "chatgpt-mind: standalone Git administration is held at ${git_metadata}"
say "chatgpt-mind: Codex state is project-local at ${codex_home_abs}"
say "chatgpt-mind: active serving model, effort, and tier are unverified"

let host_config = (env "HOME") + "/.codex/config.toml"
let host_config_check = run ["test" "-f" host_config]
if host_config_check.ok then let host_defaults = run ["grep" "-E" "^(model|model_reasoning_effort|service_tier)[[:space:]]*=" host_config]
if host_config_check.ok then say "chatgpt-mind: configured host defaults follow; they are not active-runtime proof"
if host_config_check.ok then say host_defaults.out

let pmset_which = run ["/usr/bin/which" "pmset"]
let pmset_bin = trim pmset_which.out
let power_source = "unknown"
let system_sleep = "unknown"
let battery_out = preflight_rel + "/power-battery.out"
let battery_err = preflight_rel + "/power-battery.err"
if pmset_bin != "" then let battery_reading = run-bounded { argv: [pmset_bin "-g" "batt"], stdin: "", stdin-max: 0, stdout-path: battery_out, stdout-max: 16384, stderr-path: battery_err, stderr-max: 4096 }
if pmset_bin != "" then let battery_text = read-file battery_out
if pmset_bin != "" then let power_source = ?: (battery_text contains "AC Power") "ac" "battery"
let custom_out = preflight_rel + "/power-custom.out"
let custom_err = preflight_rel + "/power-custom.err"
if pmset_bin != "" then let custom_reading = run-bounded { argv: [pmset_bin "-g" "custom"], stdin: "", stdin-max: 0, stdout-path: custom_out, stdout-max: 16384, stderr-path: custom_err, stderr-max: 4096 }
if pmset_bin != "" then let custom_text = read-file custom_out
let sleep_out = preflight_rel + "/power-sleep.out"
let sleep_err = preflight_rel + "/power-sleep.err"
let sleep_awk = "/^AC Power:/ { in_ac=1; next } /^[^[:space:]]/ { in_ac=0 } in_ac && $1 ~ /^sleep$/ { print $2; exit }"
if pmset_bin != "" then let sleep_parse = run-bounded { argv: ["/usr/bin/awk" sleep_awk], stdin: custom_text, stdin-max: 16384, stdout-path: sleep_out, stdout-max: 64, stderr-path: sleep_err, stderr-max: 4096 }
if pmset_bin != "" then let sleep_text = trim (read-file sleep_out)
if pmset_bin != "" then let system_sleep = ?: (sleep_text == "") "unknown" sleep_text
let battery_sleep = "unknown"
let battery_sleep_out = preflight_rel + "/power-battery-sleep.out"
let battery_sleep_err = preflight_rel + "/power-battery-sleep.err"
let battery_sleep_awk = "/^Battery Power:/ { in_battery=1; next } /^[^[:space:]]/ { in_battery=0 } in_battery && $1 ~ /^sleep$/ { print $2; exit }"
if pmset_bin != "" then let battery_sleep_parse = run-bounded { argv: ["/usr/bin/awk" battery_sleep_awk], stdin: custom_text, stdin-max: 16384, stdout-path: battery_sleep_out, stdout-max: 64, stderr-path: battery_sleep_err, stderr-max: 4096 }
if pmset_bin != "" then let battery_sleep_text = trim (read-file battery_sleep_out)
if pmset_bin != "" then let battery_sleep = ?: (battery_sleep_text == "") "unknown" battery_sleep_text
say "chatgpt-mind: power source ${power_source}; AC system sleep ${system_sleep}; battery system sleep ${battery_sleep}"
say "chatgpt-mind: AC and battery readings are telemetry only; neither grants nor refuses work"
say "chatgpt-mind: screensaver and power settings remain unchanged"

if dry_run then say "chatgpt-mind: dry-run only; Codex will not be invoked"
if dry_run then say "chatgpt-mind: bounded laps ${max_laps}, failure ceiling ${failure_ceiling}, backoff ${backoff_seconds} seconds"
if dry_run then say "chatgpt-mind: Codex unbounded connection retries are disabled so failures return to the supervisor circuit"
if dry_run then say "chatgpt-mind: planned inner command maps Codex, canonical Homebrew Git, its two runtime libraries, and the tracked dependent-shell Git doorway read-only; the inner lap stages one candidate, while the outer supervisor alone signs and verifies it with user-held host GPG"
if dry_run then exit 0

fn file-absent path: (run ["test" "!" "-e" path]).ok
fn repo-clean root: (trim (git-run ["-C" root "status" "--porcelain" "--untracked-files=normal" "--ignore-submodules=none"]).out) == ""
fn xy-remote root: (git-run ["-C" root "remote" "get-url" "xy"]).ok
fn xy-ready root: (git-run ["-C" root "show-ref" "--verify" "--quiet" "refs/remotes/xy/main"]).ok
fn xy-integrated root: (trim (git-run ["-C" root "rev-list" "--count" "HEAD..xy/main"]).out) == "0"
fn ahead-count root: parse (trim (git-run ["-C" root "rev-list" "--count" "xy/main..HEAD"]).out)
fn gitlink-held root: (git-run ["-C" root "ls-files" "-s" "gratitude/grain-sketchbook"]).out starts-with "160000 ${sketchbook_pin} "
fn signed-descendant root before after: ?& [((git-run ["-C" root "merge-base" "--is-ancestor" before after]).ok) ((trim (git-run ["-C" root "rev-list" "--count" "${before}..${after}"]).out) == "1") (?| [((trim (git-run ["-C" root "log" "-1" "--format=%G?" after]).out) == "G") ((trim (git-run ["-C" root "log" "-1" "--format=%G?" after]).out) == "U")]) ((trim (git-run ["-C" root "log" "-1" "--format=%GP" after]).out) == signing_key)]

assert file-absent transaction_abs else "REFUSE chatgpt-mind: an unfinished signing transaction requires custody"
assert xy-remote repo_root else "REFUSE chatgpt-mind: personal remote xy is not configured"
assert xy-ready repo_root else "REFUSE chatgpt-mind: local xy/main is absent"
assert gitlink-held repo_root else "REFUSE chatgpt-mind: pinned sketchbook is not a gitlink"
assert repo-clean repo_root else "REFUSE chatgpt-mind: worktree is not clean"
# The 24/7 rung (20260829): an ARMED run whose clone is simply behind the fleet takes the
# fast-forward instead of refusing at the wall below, so the busy-fleet stall heals itself.
# A pull that fails proceeds softly on the local ref -- a network blip should not open the
# circuit -- and a rewritten upstream still stops at xy-integrated, since the fetch inside
# the failed pull moved the local xy/main ref. check and dry-run stay fetch-free, exactly
# as the header's no-fetch-without-arming sentence promises.
let armed_run = ?| [(internal_lap) (arm_once) (arm_loop)]
let behind_pull = ?: (?& [(armed_run) ((ahead-count repo_root) == 0)]) (git-run ["-C" repo_root "pull" "--ff-only" "xy" "main"]) ({ok: true})
if behind_pull.ok == false then say "chatgpt-mind: fast-forward pull from xy failed; the lap proceeds on the local ref and the walls below still hold"
assert xy-integrated repo_root else "REFUSE chatgpt-mind: xy/main has unintegrated commits"
assert (ahead-count repo_root) <= max_local_ahead else "REFUSE chatgpt-mind: local commit ceiling crossed"

let outside_probe = (env "HOME") + "/.grain-mind-jail-probe"
let inside_probe = preflight_abs + "/inside"
assert file-absent outside_probe else "REFUSE chatgpt-mind: outside probe path already exists"
assert file-absent inside_probe else "REFUSE chatgpt-mind: inside probe path already exists"
let inside_probe_out = preflight_rel + "/inside-probe.out"
let inside_probe_err = preflight_rel + "/inside-probe.err"
let inside_probe_run = run-bounded { argv: [ai_jail "--exec" "--private-home" "--no-save-config" "/usr/bin/touch" inside_probe], stdin: "", stdin-max: 0, stdout-path: inside_probe_out, stdout-max: 4096, stderr-path: inside_probe_err, stderr-max: 4096 }
assert inside_probe_run.ok else "REFUSE chatgpt-mind: outer jail denied its repository-local write probe"
let outside_probe_out = preflight_rel + "/outside-probe.out"
let outside_probe_err = preflight_rel + "/outside-probe.err"
let outside_probe_run = run-bounded { argv: [ai_jail "--exec" "--private-home" "--no-save-config" "/usr/bin/touch" outside_probe], stdin: "", stdin-max: 0, stdout-path: outside_probe_out, stdout-max: 4096, stderr-path: outside_probe_err, stderr-max: 4096 }
assert outside_probe_run.ok == false else "REFUSE chatgpt-mind: outer jail allowed a write outside the repository"
assert file-absent outside_probe else "REFUSE chatgpt-mind: outer jail left an outside probe"
let probe_sweep = run ["rm" "-f" inside_probe]
assert probe_sweep.ok else "REFUSE chatgpt-mind: could not sweep the inside probe"
let enclosed_version_out = preflight_rel + "/enclosed-codex-version.out"
let enclosed_version_err = preflight_rel + "/enclosed-codex-version.err"
let enclosed_version_run = run-bounded { argv: ([ai_jail] + jail_maps + ["--exec" "--private-home" "--no-save-config" codex_exec "--version"]), stdin: "", stdin-max: 0, stdout-path: enclosed_version_out, stdout-max: 4096, stderr-path: enclosed_version_err, stderr-max: 4096 }
assert enclosed_version_run.overflow == "" else "REFUSE chatgpt-mind: enclosed Codex version output crossed its byte wall"
assert enclosed_version_run.ok else "REFUSE chatgpt-mind: outer jail could not execute the resolved Codex CLI"
let enclosed_git_out = preflight_rel + "/enclosed-git-version.out"
let enclosed_git_err = preflight_rel + "/enclosed-git-version.err"
let enclosed_git_run = run-bounded { argv: ([ai_jail] + jail_maps + ["--exec" "--private-home" "--no-save-config" "/usr/bin/env" git_path_arg git_exec_arg git_raw_arg git_root_arg git_zdotdir_arg git_dyld_arg git_no_system_arg git_no_global_arg git_wrapper_abs "--version"]), stdin: "", stdin-max: 0, stdout-path: enclosed_git_out, stdout-max: 4096, stderr-path: enclosed_git_err, stderr-max: 4096 }
assert enclosed_git_run.overflow == "" else "REFUSE chatgpt-mind: enclosed Homebrew Git version crossed its byte wall"
assert enclosed_git_run.ok else "REFUSE chatgpt-mind: outer jail could not execute canonical Homebrew Git"
assert trim (read-file enclosed_git_out) == "git version 2.53.0" else "REFUSE chatgpt-mind: enclosed Homebrew Git identity drifted"

let config_path = codex_home_abs + "/config.toml"
let config_check = run ["test" "-f" config_path]
assert config_check.ok else "REFUSE chatgpt-mind: project-local Codex config is absent"
let config_link = run ["test" "-L" config_path]
assert config_link.ok == false else "REFUSE chatgpt-mind: project-local Codex config cannot be a symlink"
let config_mode_run = run ["/usr/bin/stat" "-f" "%Lp" config_path]
assert config_mode_run.ok else "REFUSE chatgpt-mind: project-local Codex config mode is unreadable"
assert (trim config_mode_run.out) == "600" else "REFUSE chatgpt-mind: project-local Codex config mode must be 0600"
let codex_home_arg = "CODEX_HOME=${codex_home_rel}"
let codex_tmpdir_arg = "TMPDIR=/private/tmp"
let login_out = preflight_rel + "/codex-login-status.out"
let login_err = preflight_rel + "/codex-login-status.err"
let login_run = run-bounded { argv: ([ai_jail] + jail_maps + ["--exec" "--private-home" "--no-save-config" "/usr/bin/env" codex_home_arg codex_tmpdir_arg git_path_arg git_exec_arg git_raw_arg git_root_arg git_zdotdir_arg git_dyld_arg git_no_system_arg git_no_global_arg codex_exec "login" "status"]), stdin: "", stdin-max: 0, stdout-path: login_out, stdout-max: 4096, stderr-path: login_err, stderr-max: 4096 }
assert login_run.overflow == "" else "REFUSE chatgpt-mind: isolated Codex login status crossed its byte wall"
assert login_run.ok else "REFUSE chatgpt-mind: isolated Codex login is absent or unreadable"

let fingerprint_out = preflight_rel + "/signing-fingerprint.out"
let fingerprint_err = preflight_rel + "/signing-fingerprint.err"
let fingerprint_run = run-bounded { argv: ["/usr/bin/grep" "-E" "-x" "[0-9A-F]{40}"], stdin: signing_key, stdin-max: 40, stdout-path: fingerprint_out, stdout-max: 64, stderr-path: fingerprint_err, stderr-max: 4096 }
assert fingerprint_run.ok else "REFUSE chatgpt-mind: project-local signing fingerprint is not uppercase hexadecimal"
let signing_probe_rel = preflight_rel + "/signing-probe.txt"
let signing_probe_sig_rel = preflight_rel + "/signing-probe.sig"
let signing_probe_out = preflight_rel + "/signing-probe.out"
let signing_probe_err = preflight_rel + "/signing-probe.err"
let signing_verify_out = preflight_rel + "/signing-verify.out"
let signing_verify_err = preflight_rel + "/signing-verify.err"
let signing_probe_sweep = run ["rm" "-f" signing_probe_rel signing_probe_sig_rel]
assert signing_probe_sweep.ok else "REFUSE chatgpt-mind: signing probe could not clear its bounded prior files"
let signing_probe_text = run-bounded { argv: ["/usr/bin/printf" "grain-mind host signing probe\n"], stdin: "", stdin-max: 0, stdout-path: signing_probe_rel, stdout-max: 64, stderr-path: signing_probe_err, stderr-max: 4096 }
assert signing_probe_text.ok else "REFUSE chatgpt-mind: signing probe text could not be seated"
let signing_probe_run = run-bounded { argv: (gpg_argv + ["--batch" "--yes" "--pinentry-mode" "error" "--local-user" signing_key "--detach-sign" "--output" signing_probe_sig_rel signing_probe_rel]), stdin: "", stdin-max: 0, stdout-path: signing_probe_out, stdout-max: 4096, stderr-path: signing_probe_err, stderr-max: 16384 }
assert signing_probe_run.overflow == "" else "REFUSE chatgpt-mind: host signing probe crossed its byte wall"
assert signing_probe_run.ok else "REFUSE chatgpt-mind: user-held host signing key is unavailable or locked"
let signing_probe_mode = run ["chmod" "600" signing_probe_sig_rel]
assert signing_probe_mode.ok else "REFUSE chatgpt-mind: signing probe signature mode could not be narrowed"
let signing_verify_run = run-bounded { argv: (gpg_argv + ["--batch" "--status-fd" "1" "--verify" signing_probe_sig_rel signing_probe_rel]), stdin: "", stdin-max: 0, stdout-path: signing_verify_out, stdout-max: 16384, stderr-path: signing_verify_err, stderr-max: 16384 }
assert signing_verify_run.overflow == "" else "REFUSE chatgpt-mind: host signing verification crossed its byte wall"
assert signing_verify_run.ok else "REFUSE chatgpt-mind: host signing probe did not verify"
let signing_verify_text = (read-file signing_verify_out) + (read-file signing_verify_err)
assert signing_verify_text contains signing_key else "REFUSE chatgpt-mind: host signing probe did not return the configured primary fingerprint"
let signing_probe_close = run ["rm" "-f" signing_probe_rel signing_probe_sig_rel]
assert signing_probe_close.ok else "REFUSE chatgpt-mind: signing probe files could not be cleared"

if mode == "check" then say "GREEN chatgpt-mind: prompt, repository, tools, isolated credential presence, host signing, power reading, and outer jail checks passed"
if mode == "check" then exit 0

assert file-absent stop_abs else "REFUSE chatgpt-mind: STOP is present"
assert file-absent custody_abs else "REFUSE chatgpt-mind: CUSTODY is present"
assert file-absent transaction_abs else "REFUSE chatgpt-mind: an unfinished signing transaction requires custody"
# The loop rides battery as well as AC on Keaton's word (20260827): the mesh survives a dead
# battery, a home outage, or a failed pier the way Mycelium's gratitude teachers survive a lost
# node -- the repo is the durable memory, a cut lap costs only its uncommitted work, and the next
# round-open pull resumes the thread. Power source and sleep are reported above, never gated.
if ?& [(mode == "loop") (power_source != "ac")] then say "chatgpt-mind: on battery -- the loop runs; a battery death cuts one lap and the pull resumes it"
if ?& [(mode == "loop") (system_sleep != "0")] then say "chatgpt-mind: system sleep is nonzero -- a sleeping Mac pauses the loop until it wakes"
if ?& [(mode == "loop") (battery_sleep != "0")] then say "chatgpt-mind: battery sleep is observed, not changed or used as an execution gate"
if internal_lap == false then acquire-lock lock_rel

let launcher_abs = repo_root + "/tools/l/chatgpt-mind.rish"
let internal_out = log_rel + "/supervisor.out"
let internal_err = log_rel + "/supervisor.err"
let phase_values = ["supervisor reason=starting" "supervisor reason=unclassified" "lap-preflight reason=dirty-tree" "lap-preflight reason=xy-advanced" "lap-preflight reason=stop" "lap-preflight reason=custody" "lap-preflight reason=transaction" "lap-preflight reason=head" "last-message reason=initialization" "codex-exec reason=running" "codex-output reason=byte-wall" "codex-exec reason=nonzero" "custody reason=recorded" "custody reason=all-cruxes-parked" "parked reason=design-question" "git-postcondition reason=parked-ledger" "git-postcondition reason=inner-commit" "git-postcondition reason=no-candidate" "git-postcondition reason=unstaged" "git-postcondition reason=untracked" "git-postcondition reason=path-wall" "git-postcondition reason=path-ceiling" "git-postcondition reason=lane" "git-postcondition reason=forbidden-path" "git-postcondition reason=diff-wall" "git-postcondition reason=commit-message" "git-postcondition reason=config-drift" "git-postcondition reason=hook-failed" "git-postcondition reason=xy-advanced" "git-postcondition reason=transaction" "git-postcondition reason=signing-failed" "git-postcondition reason=signature" "git-postcondition reason=commit-ceiling" "git-postcondition reason=ref-update" "git-postcondition reason=post-cas" "complete reason=signed-commit"]
let newline_run = run ["/usr/bin/printf" "\n"]
assert newline_run.ok else "REFUSE chatgpt-mind: newline witness could not be rendered"
let newline = newline_run.out
assert length newline == 1 else "REFUSE chatgpt-mind: newline witness is not one byte"
fn phase-valid value: phase_values contains value
fn public-phase value: ?: (phase-valid value) value "supervisor reason=unclassified"
fn phase-file-safe ignored: ?& [((run ["test" "-f" phase_rel]).ok) ((run ["test" "-L" phase_rel]).ok == false) ((trim (run ["/usr/bin/stat" "-f" "%Lp" phase_rel]).out) == "600")]
fn phase-held value: ?& [(phase-valid value) (phase-file-safe 0) ((read-file phase_rel) == (value + newline))]
fn write-phase value: ?: (phase-valid value) (run-bounded { argv: ["/usr/bin/printf" "%s\n" value], stdin: "", stdin-max: 0, stdout-path: phase_rel, stdout-max: 128, stderr-path: phase_err, stderr-max: 4096 }) ({ok: false, overflow: ""})
let phase_seed = write-phase "supervisor reason=starting"
assert phase_seed.ok else "REFUSE chatgpt-mind: could not initialize the bounded phase receipt"
assert phase-held "supervisor reason=starting" else "REFUSE chatgpt-mind: initialized phase receipt is malformed"
fn run-one-lap lap: run-bounded { argv: ["/usr/bin/env" "MIND_INTERNAL_LAP=1" "MIND_STATE_DIR=${state_abs}" "MIND_CODEX_HOME=${codex_home_abs}" "MIND_RISHI_BIN=${rishi_bin}" "MIND_AI_JAIL_BIN=${ai_jail}" "MIND_CODEX_BIN=${codex_exec}" rishi_bin "run" launcher_abs "lap" (str lap)], stdin: "", stdin-max: 0, stdout-path: internal_out, stdout-max: max_supervisor_bytes, stderr-path: internal_err, stderr-max: max_supervisor_bytes, stdout-relay: true, stderr-relay: true }
# A parked lap exits clean with its own receipt, so the loop reads the receipt to keep the
# consecutive-park streak: 0 means the loop completed, 1 means the failure circuit opened, and
# 2 means max_consecutive_parked laps in a row parked -- no admissible crux remains.
fn lap-parked ignored: ?& [(phase-file-safe 0) ((trim (read-file phase_rel)) == "parked reason=design-question")]
# A lap that fails AFTER Codex mutated leaves leavings the next attempt's repo-clean wall
# refuses, so every retry was doomed and the ceiling opened the circuit on wreckage --
# measured 20260829, when one byte-wall refusal cascaded into repo-clean refusals to the
# ceiling. Parking is custody rather than discard: the leavings wait in a named stash for
# a hand or a later lap, and the retry meets the clean tree it needs. Dream's round-open
# heals by stashing anonymously; Mind stashes by name -- the same mercy at custody grade.
fn park-leavings lap: ?: (repo-clean repo_root) ({ok: true}) (git-run ["-C" repo_root "stash" "push" "-u" "-m" ("mind-park lap " + (str lap) + " refusal-leavings")])
fn mind-loop lap max failures ceiling delay parked: ?: (lap > max) (0) (?: ((run-one-lap lap).ok) (?: (lap-parked 0) (?: ((parked + 1) >= max_consecutive_parked) (2) (mind-loop (lap + 1) max 0 ceiling delay (parked + 1))) (mind-loop (lap + 1) max 0 ceiling delay 0)) (?: ((failures + 1) >= ceiling) (1) (?: ((park-leavings lap).ok) (?: ((run ["sleep" (str delay)]).ok) (mind-loop lap max (failures + 1) ceiling (clamp (delay * 2) 0 max_backoff_seconds) parked) (1)) (1))))

let once_result = ?: (mode == "once") (run-one-lap 1) ({ok: true, overflow: ""})
assert ?| [(mode != "once") (once_result.overflow == "")] else "REFUSE chatgpt-mind: lap failed at supervisor-output reason=byte-wall; bounded detail remains private"
assert ?| [(mode != "once") (phase-file-safe 0)] else "REFUSE chatgpt-mind: lap phase receipt is not a mode-0600 regular nonsymlink file"
let once_phase_raw = ?: (mode == "once") (trim (read-file phase_rel)) ("not-run")
assert ?| [(mode != "once") (phase-held once_phase_raw)] else "REFUSE chatgpt-mind: lap phase receipt is not one finite mode-0600 regular line"
let once_phase = ?: (mode == "once") (public-phase once_phase_raw) ("not-run")
assert ?| [(mode != "once") once_result.ok] else "REFUSE chatgpt-mind: lap failed phase=${once_phase}; bounded detail remains in ${internal_err}"
assert ?| [(mode != "once") (once_phase == "complete reason=signed-commit") (once_phase == "parked reason=design-question")] else "REFUSE chatgpt-mind: successful lap lacks its signed-commit or parked receipt"
if ?& [(mode == "once") (once_phase == "complete reason=signed-commit")] then say "chatgpt-mind: lap one complete with one signed local commit"
if ?& [(mode == "once") (once_phase == "parked reason=design-question")] then say "chatgpt-mind: lap one parked its design question; no candidate was demanded"
if mode == "once" then exit 0

let loop_result = ?: (mode == "loop") (mind-loop 1 max_laps 0 failure_ceiling backoff_seconds 0) (0)
# Three consecutive parked laps mean no admissible crux remains, and that is real custody
# rather than a soft skip: the parked set is written into CUSTODY so every later armed run
# refuses at the standing wall until a word clears it.
let custody_note_err = log_rel + "/custody-note.err"
let all_parked = ?& [(mode == "loop") (loop_result == 2)]
let custody_note = ?: all_parked ("all-cruxes-parked: ${max_consecutive_parked} consecutive laps parked their design questions; no admissible crux remains. Parked set:" + newline + (?: ((run ["test" "-f" parked_rel]).ok) (read-file parked_rel) (""))) ("")
let custody_write = ?: all_parked (run-bounded { argv: ["/usr/bin/printf" "%s" custody_note], stdin: "", stdin-max: 0, stdout-path: custody_rel, stdout-max: max_custody_note_bytes, stderr-path: custody_note_err, stderr-max: 4096 }) ({ok: true, overflow: ""})
assert custody_write.ok else "REFUSE chatgpt-mind: all-cruxes-parked custody note could not be written"
let phase_all_parked = ?: all_parked (write-phase "custody reason=all-cruxes-parked") ({ok: true, overflow: ""})
assert phase_all_parked.ok else "REFUSE chatgpt-mind: loop could not seat its all-cruxes-parked phase"
assert ?| [(mode != "loop") (phase-file-safe 0)] else "REFUSE chatgpt-mind: loop phase receipt is not a mode-0600 regular nonsymlink file"
let loop_phase_raw = ?: (mode == "loop") (trim (read-file phase_rel)) ("not-run")
assert ?| [(mode != "loop") (phase-held loop_phase_raw)] else "REFUSE chatgpt-mind: loop phase receipt is not one finite mode-0600 regular line"
let loop_phase = ?: (mode == "loop") (public-phase loop_phase_raw) ("not-run")
assert ?| [(mode != "loop") (loop_result == 0)] else "REFUSE chatgpt-mind: circuit opened phase=${loop_phase}; bounded detail remains in ${internal_err}"
assert ?| [(mode != "loop") (loop_phase == "complete reason=signed-commit") (loop_phase == "parked reason=design-question")] else "REFUSE chatgpt-mind: successful loop lacks its signed-commit or parked receipt"
if mode == "loop" then say "chatgpt-mind: bounded loop completed ${max_laps} lap(s); no push was attempted"
if mode == "loop" then exit 0

let lap_number = parse args[1]
assert lap_number >= 1 else "REFUSE chatgpt-mind: internal lap number is below one"
assert lap_number <= max_laps_hard else "REFUSE chatgpt-mind: internal lap number crossed twenty-four"
let lap_phase_start = write-phase "supervisor reason=starting"
assert lap_phase_start.ok else "REFUSE chatgpt-mind: internal lap could not initialize its bounded phase receipt"
let phase_dirty_pre = write-phase "lap-preflight reason=dirty-tree"
assert phase_dirty_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its dirty-tree phase"
assert repo-clean repo_root else "REFUSE chatgpt-mind: lap opened on a dirty tree"
let phase_xy_pre = write-phase "lap-preflight reason=xy-advanced"
assert phase_xy_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its xy phase"
assert xy-integrated repo_root else "REFUSE chatgpt-mind: xy/main advanced before the lap"
let phase_stop_pre = write-phase "lap-preflight reason=stop"
assert phase_stop_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its STOP phase"
assert file-absent stop_abs else "REFUSE chatgpt-mind: STOP observed between laps"
let phase_custody_pre = write-phase "lap-preflight reason=custody"
assert phase_custody_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its custody phase"
assert file-absent custody_abs else "REFUSE chatgpt-mind: CUSTODY observed between laps"
let phase_transaction_pre = write-phase "lap-preflight reason=transaction"
assert phase_transaction_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its transaction phase"
assert file-absent transaction_abs else "REFUSE chatgpt-mind: unfinished signing transaction observed between laps"
let phase_head_pre = write-phase "lap-preflight reason=head"
assert phase_head_pre.ok else "REFUSE chatgpt-mind: internal lap could not seat its HEAD phase"
let before_run = git-run ["-C" repo_root "rev-parse" "HEAD"]
assert before_run.ok else "REFUSE chatgpt-mind: could not read pre-lap HEAD"
let before = trim before_run.out
let lap_out = "${log_rel}/lap-${lap_number}.stdout"
let lap_err = "${log_rel}/lap-${lap_number}.stderr"
let lap_last = "${log_rel}/lap-${lap_number}.last"
let last_init_err = "${log_rel}/lap-${lap_number}.last-init.err"
let phase_last_init = write-phase "last-message reason=initialization"
assert phase_last_init.ok else "REFUSE chatgpt-mind: internal lap could not seat its last-message phase"
let last_init = run-bounded { argv: ["/usr/bin/true"], stdin: "", stdin-max: 0, stdout-path: lap_last, stdout-max: max_log_bytes, stderr-path: last_init_err, stderr-max: 4096 }
assert last_init.ok else "REFUSE chatgpt-mind: could not initialize bounded last-message file"
let message_init_err = "${log_rel}/lap-${lap_number}.message-init.err"
let message_init = run-bounded { argv: ["/usr/bin/true"], stdin: "", stdin-max: 0, stdout-path: commit_message_rel, stdout-max: max_commit_message_bytes, stderr-path: message_init_err, stderr-max: 4096 }
assert message_init.ok else "REFUSE chatgpt-mind: could not initialize the bounded commit-message file"
# PARKED before-image: the parked-ledger postcondition below tells an append from a rewrite by
# prefix, so the before bytes are held across the Codex dependent. PARKED is loop-local state under
# the untracked state directory; it is never staged and never a candidate path.
let parked_link_pre = run ["test" "-L" parked_rel]
assert parked_link_pre.ok == false else "REFUSE chatgpt-mind: PARKED cannot be a symlink"
let parked_present_pre = (run ["test" "-f" parked_rel]).ok
let parked_size_pre_run = ?: parked_present_pre (run ["/usr/bin/stat" "-f" "%z" parked_rel]) ({ok: true, out: "0"})
assert parked_size_pre_run.ok else "REFUSE chatgpt-mind: PARKED size is unreadable"
let parked_size_pre = parse (trim parked_size_pre_run.out)
assert parked_size_pre <= max_parked_bytes else "REFUSE chatgpt-mind: PARKED crossed its byte wall"
let parked_before = ?: parked_present_pre (read-file parked_rel) ("")
let prompt_text = read-file prompt_rel
let phase_codex_running = write-phase "codex-exec reason=running"
assert phase_codex_running.ok else "REFUSE chatgpt-mind: internal lap could not seat its Codex running phase"
let codex_run = run-bounded { argv: ([ai_jail] + jail_maps + ["--exec" "--private-home" "--no-save-config" "/usr/bin/env" codex_home_arg codex_tmpdir_arg git_path_arg git_exec_arg git_raw_arg git_root_arg git_zdotdir_arg git_dyld_arg git_no_system_arg git_no_global_arg codex_exec "exec" "--disable" "unbounded_connection_retries" "--sandbox" "danger-full-access" "--ephemeral" "--strict-config" "--output-last-message" lap_last "-"]), stdin: prompt_text, stdin-max: max_prompt_bytes, stdout-path: lap_out, stdout-max: max_log_bytes, stderr-path: lap_err, stderr-max: max_log_bytes, stdout-relay: true, stderr-relay: true }
let phase_codex_wall = write-phase "codex-output reason=byte-wall"
assert phase_codex_wall.ok else "REFUSE chatgpt-mind: internal lap could not seat its Codex byte-wall phase"
assert codex_run.overflow == "" else "REFUSE chatgpt-mind: Codex output crossed its byte wall"
let phase_codex_nonzero = write-phase "codex-exec reason=nonzero"
assert phase_codex_nonzero.ok else "REFUSE chatgpt-mind: internal lap could not seat its Codex exit phase"
assert codex_run.ok else "REFUSE chatgpt-mind: enclosed Codex lap exited nonzero code=${codex_run.code}"
let phase_custody = write-phase "custody reason=recorded"
assert phase_custody.ok else "REFUSE chatgpt-mind: internal lap could not seat its custody result"
assert file-absent custody_abs else "REFUSE chatgpt-mind: lap recorded a custody gate"

let phase_inner_commit = write-phase "git-postcondition reason=inner-commit"
assert phase_inner_commit.ok else "REFUSE chatgpt-mind: internal lap could not seat its inner-commit phase"
let prepared_head_run = git-run ["-C" repo_root "rev-parse" "HEAD"]
assert prepared_head_run.ok else "REFUSE chatgpt-mind: could not read candidate HEAD"
assert (trim prepared_head_run.out) == before else "REFUSE chatgpt-mind: jailed Codex created a commit instead of a staged candidate"

# Parked-ledger postcondition: bounded, regular, append-only. Hard custody was already checked
# above and keeps its exact refusal; PARKED holds only design questions the lap chose to park.
let phase_parked_ledger = write-phase "git-postcondition reason=parked-ledger"
assert phase_parked_ledger.ok else "REFUSE chatgpt-mind: internal lap could not seat its parked-ledger phase"
let parked_link_post = run ["test" "-L" parked_rel]
assert parked_link_post.ok == false else "REFUSE chatgpt-mind: PARKED cannot be a symlink"
let parked_present_post = (run ["test" "-f" parked_rel]).ok
let parked_size_post_run = ?: parked_present_post (run ["/usr/bin/stat" "-f" "%z" parked_rel]) ({ok: true, out: "0"})
assert parked_size_post_run.ok else "REFUSE chatgpt-mind: PARKED size is unreadable"
let parked_size_post = parse (trim parked_size_post_run.out)
assert parked_size_post <= max_parked_bytes else "REFUSE chatgpt-mind: PARKED crossed its byte wall"
let parked_after = ?: parked_present_post (read-file parked_rel) ("")
assert ?| [(parked_after == parked_before) (parked_before == "") (parked_after starts-with parked_before)] else "REFUSE chatgpt-mind: PARKED must grow append-only"
let parked_grew = (length parked_after) > (length parked_before)

let phase_no_candidate = write-phase "git-postcondition reason=no-candidate"
assert phase_no_candidate.ok else "REFUSE chatgpt-mind: internal lap could not seat its candidate phase"
let staged_probe = git-run ["-C" repo_root "diff" "--cached" "--quiet" "--ignore-submodules=none"]
# A lap that appended a design question and staged nothing is a CLEAN parked lap rather than a
# failure: the question waits for a word while the loop takes a different crux next lap. A lap
# that parked a question and still staged a candidate simply continues below.
let parked_lap = ?& [parked_grew (staged_probe.code == 0)]
let parked_tree_clean = ?: parked_lap (repo-clean repo_root) (true)
assert ?| [(parked_lap == false) parked_tree_clean] else "REFUSE chatgpt-mind: parked lap left a dirty tree"
let phase_parked = ?: parked_lap (write-phase "parked reason=design-question") ({ok: true, overflow: ""})
assert phase_parked.ok else "REFUSE chatgpt-mind: internal lap could not seat its parked receipt"
let parked_receipt_held = ?: parked_lap (phase-held "parked reason=design-question") (true)
assert ?| [(parked_lap == false) parked_receipt_held] else "REFUSE chatgpt-mind: parked receipt is malformed"
if parked_lap then say "chatgpt-mind: lap ${lap_number} parked its design question; no candidate was demanded"
if parked_lap then exit 0
assert staged_probe.code == 1 else "REFUSE chatgpt-mind: lap did not stage exactly one candidate"

let phase_unstaged = write-phase "git-postcondition reason=unstaged"
assert phase_unstaged.ok else "REFUSE chatgpt-mind: internal lap could not seat its unstaged phase"
let unstaged_probe = git-run ["-C" repo_root "diff" "--quiet" "--ignore-submodules=none"]
assert unstaged_probe.ok else "REFUSE chatgpt-mind: candidate left unstaged tracked changes"

let phase_untracked = write-phase "git-postcondition reason=untracked"
assert phase_untracked.ok else "REFUSE chatgpt-mind: internal lap could not seat its untracked phase"
