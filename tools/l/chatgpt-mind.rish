let phase_xy_post = write-phase "git-postcondition reason=xy-advanced"
assert phase_xy_post.ok else "REFUSE chatgpt-mind: internal lap could not seat its post-candidate xy phase"
# catch-up (20260831, Keaton's word): when xy advanced during the lap, one ff-only pull
# carries the tree forward with the staged candidate riding -- git itself refuses the
# pull when an advanced path collides with the candidate, and the assert below then
# refuses exactly as it always did. The lap base rebinds to the caught-up HEAD so the
# one-signed-commit proof still measures this lap's own work alone. Three proven
# candidates died at this line in one weekend on unrelated field commits.
let xy_catchup = ?: (xy-integrated repo_root) ({ok: true}) (git-run ["-C" repo_root "pull" "--ff-only" "xy" "main"])
let before_refresh = git-run ["-C" repo_root "rev-parse" "HEAD"]
assert before_refresh.ok else "REFUSE chatgpt-mind: could not read HEAD after the xy catch-up"
let before = trim before_refresh.out
assert xy-integrated repo_root else "REFUSE chatgpt-mind: xy/main advanced during the lap"

let phase_config = write-phase "git-postcondition reason=config-drift"
assert phase_config.ok else "REFUSE chatgpt-mind: internal lap could not seat its config phase"
let signing_key_after = git-run ["-C" repo_root "config" "--local" "--get" "user.signingkey"]
let signing_program_after = git-run ["-C" repo_root "config" "--local" "--get" "gpg.program"]
let signing_required_after = git-run ["-C" repo_root "config" "--local" "--bool" "--get" "commit.gpgsign"]
let hooks_path_after = git-run ["-C" repo_root "config" "--local" "--get" "core.hooksPath"]
assert signing_key_after.ok else "REFUSE chatgpt-mind: signing fingerprint vanished during the lap"
assert signing_program_after.ok else "REFUSE chatgpt-mind: signing program vanished during the lap"
assert signing_required_after.ok else "REFUSE chatgpt-mind: signed-commit law vanished during the lap"
assert hooks_path_after.ok else "REFUSE chatgpt-mind: hooks path vanished during the lap"
assert (trim signing_key_after.out) == signing_key else "REFUSE chatgpt-mind: signing fingerprint drifted during the lap"
assert (trim signing_program_after.out) == gpg_exec else "REFUSE chatgpt-mind: signing program drifted during the lap"
assert (trim signing_required_after.out) == "true" else "REFUSE chatgpt-mind: signed-commit law drifted during the lap"
assert (trim hooks_path_after.out) == "tools/hooks" else "REFUSE chatgpt-mind: hooks path drifted during the lap"
assert file-absent (git_config_abs + ".lock") else "REFUSE chatgpt-mind: Git config lock remains after the jailed lap"
assert file-absent (git_head_abs + ".lock") else "REFUSE chatgpt-mind: Git HEAD lock remains after the jailed lap"
assert file-absent (git_packed_refs_abs + ".lock") else "REFUSE chatgpt-mind: packed-refs lock remains after the jailed lap"
assert file-absent (git_metadata + "/index.lock") else "REFUSE chatgpt-mind: Git index lock remains after the jailed lap"

