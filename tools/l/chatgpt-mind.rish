assert (trim final_tree_run.out) == candidate_tree else "REFUSE chatgpt-mind: post-CAS tree drifted from the staged candidate"
assert (trim final_parent_run.out) == before else "REFUSE chatgpt-mind: post-CAS parent drifted from prior HEAD"
assert repo-clean repo_root else "REFUSE chatgpt-mind: post-CAS worktree is not clean"
assert gitlink-held repo_root else "REFUSE chatgpt-mind: post-CAS sketchbook gitlink moved"
assert xy-integrated repo_root else "REFUSE chatgpt-mind: xy/main advanced during post-CAS verification"
assert (ahead-count repo_root) == (ahead_before_close + 1) else "REFUSE chatgpt-mind: post-CAS local commit count is not exactly one higher"
let phase_complete = write-phase "complete reason=signed-commit"
assert phase_complete.ok else "REFUSE chatgpt-mind: internal lap could not seat its completion receipt"
assert phase-held "complete reason=signed-commit" else "REFUSE chatgpt-mind: completion receipt is malformed"
let transaction_close = run ["rmdir" transaction_rel]
assert transaction_close.ok else "REFUSE chatgpt-mind: completed signing transaction could not be cleared"
assert file-absent transaction_abs else "REFUSE chatgpt-mind: completed signing transaction remains present"
say "chatgpt-mind: lap ${lap_number} complete with one signed local commit"
