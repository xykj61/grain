let untracked_probe = run-bounded { argv: (git_argv + ["-C" repo_root "ls-files" "--others" "--exclude-standard"]), stdin: "", stdin-max: 0, stdout-path: untracked_out, stdout-max: 65536, stderr-path: untracked_err, stderr-max: 16384 }
