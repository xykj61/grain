let hook_paths_run = run-bounded { argv: (git_argv + ["-C" repo_root "diff" "--cached" "--name-only" "--no-ext-diff"]), stdin: "", stdin-max: 0, stdout-path: candidate_paths, stdout-max: 65536, stderr-path: candidate_paths_err, stderr-max: 16384 }
