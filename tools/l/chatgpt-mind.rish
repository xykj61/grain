let git_intl_real = run ["/bin/realpath" git_intl_link]
assert git_pcre_real.ok else "REFUSE chatgpt-mind: Homebrew Git PCRE2 runtime could not be resolved"
assert git_intl_real.ok else "REFUSE chatgpt-mind: Homebrew Git gettext runtime could not be resolved"
