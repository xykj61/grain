# tools/l/linengrow_receipt_offer_witness.rish -- Linengrow's readable receipt projection.
#
# This runner builds the Rye witness in a unique pen, then requires its complete
# GREEN sentence. The Rye witness walks every declaration in the projection module,
# so a public function cannot escape semantic analysis merely because this fixture
# does not call it.

let zig = "vendor/zig-toolchain/zig"
# The pen comes from the runtime rather than from `mktemp -d`, so it is released after a return,
# a refusal, an `exit`, HUP, INT, or TERM. A failing assert below ends this run where it stands,
# and the elder three-line shape left its build pen on a pier eight ships share (REDS %745).
let pen = make-pen "linengrow_receipt_offer"
let bin = "${pen}/receipt_offer_witness"

say "linengrow-receipt: Language EN -- one admitted offer projects into the receipt a holder reads."
say "linengrow-receipt: Style Gauge, Meter -- the receipt is read whole, before and after the offer expires."
say "linengrow-receipt: Lens TAME -- the projection writes no field of the admitted fact; every returned string is a slice of one it already holds."

let build = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh linengrow/receipt_offer_witness.rye -femit-bin=${bin}"]
say build.err
assert build.ok else "linengrow-receipt: the Rye witness did not build"

let proof = run ["sh" "-c" "${bin} 2>&1"]
say proof.err
assert proof.ok else "linengrow-receipt: the Rye witness exited non-zero"
assert proof.out contains "GREEN: linengrow receipt" else "linengrow-receipt: the witness did not print its complete GREEN claim"
say proof.out

let braid = run ["sh" "tools/fixtures/r/receipt_product_braid_scan.sh"]
say braid.err
say braid.out
assert braid.ok else "linengrow-receipt: the receipt product braid guard reddened"
assert braid.out contains "verdict=unbraided" else "linengrow-receipt: the two receipt products no longer read as unbraided"

say "GREEN: linengrow-receipt runner -- the tracked build compiles every declaration, proves the readable projection field for field, and holds the product braid guard green."
