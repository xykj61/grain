# tools/buhr_mantra_browser_theme_stack_witness.rish — BUHR Journey 2, Rung 5.
#
# Two .brush layers compose into one themed surface: rung four proved a single
# .brush theme recolors the living edge; this rung proves the deeper property — an
# independent mode layer (ground only) and accent layer (living edge only) compose
# through the WADE1 cascade, the top layer winning per token, the base sheet's
# untouched tokens inheriting beneath both. The proof reads back three sources at
# once: the ground from the mode layer, the head from the accent layer, and the
# edge rule from the base sheet neither layer named — three authors, one surface.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_mantra_browser_theme_stack_witness.rish

say "buhr-j2r5: Language EN — a mode layer and an accent layer, two .brush files, compose into one themed Skate surface."
say "buhr-j2r5: Lens TAME — each layer read through the real authoring loop, composed by resolve_stack, top wins, base inherits."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mantra-browser-theme-stack"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_browser_theme_stack.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j2r5: mantra_browser_theme_stack build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j2r5: mantra_browser_theme_stack selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j2r5: selftest did not speak GREEN"
assert selftest.out contains "three authors, one surface" else "buhr-j2r5: layer-composition proof (mode+accent+base) missing"
assert selftest.out contains "wins the head at the top of the cascade" else "buhr-j2r5: accent-wins-over-base proof missing"
assert selftest.out contains "stacked-accent head pixels on the canvas" else "buhr-j2r5: stacked paint did not reach the canvas"
assert selftest.out contains "a style-less layer refuses — LayerEmpty" else "buhr-j2r5: style-less refuse proof missing"

# Rung four stays its own green binary — the stacked cascade is strictly additive.
let rung4 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_mantra_browser_theme_witness.rish 2>&1"]
assert rung4.ok else "buhr-j2r5: rung four witness regressed"
assert rung4.out contains "GREEN: BUHR-J2r4" else "buhr-j2r5: rung four lost its green"

say "GREEN: BUHR-J2r5 — two .brush layers (mode + accent) compose into one themed surface; the design-system cascade stacks."
