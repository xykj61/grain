# tools/buhr_realidream_view_derived_witness.rish — BUHR Journey 5, Rung 8.
#
# The fused downstream edge, painted — a derived node lit where its read upstream sits.
# Rung five painted the whole fused scene onto one styled canvas and marked each read
# origin (a read/ lane) in the sheet's read token (Madder) — the upstream end lit, the
# downstream dark. This rung lights the other end: a derived program node (one whose
# content is a pure function of the reads upstream of it) names itself under a prog/
# path, symmetric to a read origin's read/ path, and wears the sheet's own flow token
# (Weld). So one canvas now carries the whole edge at once — the read origin upstream in
# Madder, the derived node downstream in Weld, and every lane's living edge in Ochre.
# The mark reads off the very bytes the browser renders (derived_label_span finds the
# prog/ path label), so the painted color can never point at a computed node the readable
# text does not name. The demo scene derives prog/summary from read/src through rung
# three's own derive_from_read, so the painted downstream node is a real derived node in
# the log, not a label pinned on for the picture. This rung reads no network — the read
# content is supplied in-process; a real web fetch stays a named seam behind a bounded
# reader (its own later rung, for Keaton's word).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_realidream_view_derived_witness.rish

say "buhr-j5r8: Language EN — the fused downstream edge painted; a derived node lit where its read upstream sits."
say "buhr-j5r8: Lens TAME — proven on metal; 9 styled rows, exactly 1 derived lane tinted in its own flow token, read origin and derived node share the canvas in distinct colors. No network read."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/realidream-view-derived"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/realidream_view_derived.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j5r8: realidream_view_derived build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j5r8: realidream_view_derived selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j5r8: selftest did not speak GREEN"
assert selftest.out contains "painted onto 9 styled rows" else "buhr-j5r8: the both-ends-present proof is missing"
assert selftest.out contains "on exactly 1 derived lane" else "buhr-j5r8: the derived-node-marked proof is missing"
assert selftest.out contains "share the canvas" else "buhr-j5r8: the read-and-derived-colors-on-canvas proof is missing"
assert selftest.out contains "editor and view share one graph" else "buhr-j5r8: the shared-graph proof is missing"
assert selftest.out contains "refuses read lanes, program lanes, and headers" else "buhr-j5r8: the derived_label_span proof is missing"

# The token sheet grew a flow (Weld) token; its own selftest stays green — additive.
let tokens = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/tokens.rye -femit-bin=tools/.build/brushstroke_tokens && tools/.build/brushstroke_tokens selftest 2>&1"]
assert tokens.ok else "buhr-j5r8: the token sheet regressed after growing the flow token"
assert tokens.out contains "GREEN: brushstroke tokens" else "buhr-j5r8: the token sheet lost its green"

# Rung 5 (read, program, and fused lanes painted) stays its own green binary — additive.
let rung5 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_realidream_view_witness.rish 2>&1"]
assert rung5.ok else "buhr-j5r8: the view (J5r5) witness regressed"
assert rung5.out contains "GREEN: BUHR-J5r5" else "buhr-j5r8: rung five lost its green"

# Rung 3 (a program node derived from a read) stays green — the derived scene leans on it.
let rung3 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_realidream_derive_witness.rish 2>&1"]
assert rung3.ok else "buhr-j5r8: the derive (J5r3) witness regressed"
assert rung3.out contains "GREEN: BUHR-J5r3" else "buhr-j5r8: rung three lost its green"

say "GREEN: BUHR-J5r8 — the fused downstream edge painted; the derived node marked in the flow token, the read origin in the read token, both ends of the edge on one canvas."
