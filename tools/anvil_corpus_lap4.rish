# tools/anvil_corpus_lap4.rish — accrete shim → tools/gen/anvil/anvil_corpus_lap4.rish (Surface Season p1)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/anvil/anvil_corpus_lap4.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/anvil/anvil_corpus_lap4.rish" args[0]]
if r.out != "" then say r.out
exit r.code
