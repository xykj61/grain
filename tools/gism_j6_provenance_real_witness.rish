# tools/gism_j6_provenance_real_witness.rish — GISM Journey 6 (Provenance), Rung 1.
#
# Season 2, Yield: the chain of custody stands on real data. This witness carries
# Tablecloth's owner-signed catalog onto a real tree document — a compile-time embed
# of a living waymark green-claim (symlinked, so the bytes signed are the bytes a
# keeper reads) — and proves the whole chain of custody runs GREEN over real bytes:
# a settled planet identity signs the exact real content, fetch returns it byte-for-
# byte, owner_of/place_of resolve provenance, and every tamper refuses. It also books
# Yield red #73 on metal — a real front-door document (SECURITY.md, 2689 B) refuses
# ContentTooLarge because it does not fit one 512-byte resin (the chunking horizon).
# The demo keyed catalog over doc_planet/doc_star (tablecloth_keyed) is re-run
# untouched — the provenance app is additive, composed over its public API.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gism_j6_provenance_real_witness.rish

say "gism-j6r1: Language EN — the chain of custody stands on a real tree document, red #73 booked."
say "gism-j6r1: Lens TAME — real bytes, owner-signed and content-addressed; the demo keyed catalog still GREEN."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/provenance-real"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/provenance_real.rye -femit-bin=${bin}"]
assert build.ok else "gism-j6r1: provenance_real build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j6r1: provenance_real selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j6r1: selftest did not speak GREEN"
assert selftest.out contains "real artifact — 213 bytes, owner 267 (planet), fetched byte-for-byte" else "gism-j6r1: real owner-signed fetch missing"
assert selftest.out contains "store tamper refused (DigestMismatch)" else "gism-j6r1: store-tamper refusal missing"
assert selftest.out contains "forged signature refused (BadSignature), nothing stored" else "gism-j6r1: forged-signature refusal missing"
assert selftest.out contains "content-mismatched signature refused (BadSignature)" else "gism-j6r1: content-mismatch refusal missing"
assert selftest.out contains "red #73 — real doc 2689 B > 512 B resin refuses ContentTooLarge" else "gism-j6r1: Yield red #73 proof missing"

# The demo keyed catalog over doc_planet/doc_star must still be GREEN — provenance_real
# composes its public API only, retiring nothing.
let demo_bin = "pond/bin/tablecloth-keyed"
let demo_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth_keyed.rye -femit-bin=${demo_bin}"]
assert demo_build.ok else "gism-j6r1: tablecloth_keyed (demo) rebuild failed"
let demo_selftest = run ["sh" "-c" "${demo_bin} selftest 2>&1"]
assert demo_selftest.ok else "gism-j6r1: tablecloth_keyed (demo) selftest regressed"
assert demo_selftest.out contains "GREEN" else "gism-j6r1: tablecloth_keyed (demo) did not speak GREEN"

say "GREEN: GISM-J6r1 — the chain of custody stands on a real embedded artifact; red #73 booked; the demo keyed catalog stays GREEN."
