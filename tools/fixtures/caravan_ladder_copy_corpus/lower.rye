//! Fixture rung -- the lower module of the copy-scan corpus. Two checks stand
//! here; the upper rung carries one of them forward byte for byte.

fn check_first() u8 {
    // invariant: the corpus proves counting, so the body only needs to be real lines.
    var held: u32 = 1;
    held += 1;
    return if (held == 2) 0 else 1;
}

fn check_second() u8 {
    // invariant: a second distinct body, so distinct never collapses to one.
    var held: u32 = 2;
    held += 2;
    return if (held == 4) 0 else 1;
}
