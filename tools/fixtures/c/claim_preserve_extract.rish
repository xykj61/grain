# claim_preserve_extract.rish -- emit sorted-unique claim tokens from a file.
#
# The living mutant of tools/fixtures/c/claim_preserve_extract.sh (Python -> perl ->
# Rishi molt, 20260809). No shell, no perl -- Rishi's own match/find/sort/unique.
# Token classes match the elder extractor; the PATH roster does NOT -- the elder
# tools/fixtures/c/claim_preserve_extract.sh still spells 17 rooms and has no live
# caller, so it is left as the fossil it is rather than repaired in two places.
#
# Token classes (each prefixed CLASS:):
#   STAMP  -- YYYYMMDD.HHMMSS and YYYYMMDD-HHMMSS
#   HEX    -- 8+ hex chars, not a pure 14-digit stamp; lowercased
#   FP     -- OpenPGP-style 4-hex groups; whitespace collapsed, uppercased
#   NUM    -- integers and decimals, not an 8-digit stamp fragment
#   PATH   -- a path at any tracked room, roster derived by the caller, not mid-identifier
#   PROPER -- capitalized noun runs, minus common sentence openers
#

#   rishi/bin/rishi run tools/fixtures/c/claim_preserve_extract.rish <path> <roots>
#
# <roots> is a regex alternation of this tree's tracked top-level rooms, derived by the
# caller from `git ls-files` and handed in. It is REQUIRED, and the requirement is the
# point: this class used to spell its own roster of 17 room names, so it recognized a path
# in `context/` and `tools/` and was blind to `src/`, `construction/`, `.claude/rules/`,
# `caravan/`, `comlink/`, `constel/`, and 59 more -- 65 of the tree's 82 tracked rooms,
# measured 20260828. A register pass over dated prose is supposed to hold every path
# exactly, and it held them in one room in five. Commit 9f053c662 rewrote `src/sur/` to
# `src/shape/` inside six dated files and this scan answered GREEN on all of them.
#
# Deriving the roster rather than spelling it is REDS %301's own repair, one instrument
# over: ask git for every room rather than asking the tree for the rooms already named.
# Refusing without the argument is the same discipline the QA card keeps when it cites
# `measure()` -- remove the derivation and this refuses rather than quietly guessing.
assert (length args) >= 2 else "claim_preserve_extract: usage <path> <roots> -- the room roster is derived by the caller, never spelled here"
let text = read-file args[0]
let roots = args[1]

# STAMP -- both one-clock forms. Prefixes join with `+` rather than string
# interpolation, so a nested pattern literal never closes the outer string early.
let stamp_dot = map (find text "\b\d{8}\.\d{6}\b") as t: "STAMP:" + t
let stamp_dash = map (find text "\b\d{8}-\d{6}\b") as t: "STAMP:" + t

# HEX -- 8+ hex, dropping a bare 14-digit stamp; lowercased.
let hex_raw = find text "\b(?:0x)?[0-9a-fA-F]{8,}\b"
let hex_kept = where hex_raw as h: (?! (h matches "^\d{14}$"))
let hexes = map hex_kept as h: "HEX:" + (lower h)

# FP -- fingerprint clumps; collapse whitespace to one space, uppercase.
let fp_raw = find text "\b(?:[0-9A-F]{4}\s+){3,}[0-9A-F]{4}\b"
let fps = map fp_raw as f: "FP:" + (upper (join (find f "\S+") " "))

# NUM -- numbers, dropping an 8-digit stamp fragment.
let num_raw = find text "\b\d+(?:\.\d+)?\b"
let num_kept = where num_raw as n: (?! (n matches "^\d{8}$"))
let nums = map num_kept as n: "NUM:" + n

# PATH -- a tracked room, optionally one ../ ahead, never mid-identifier. The roster
# arrives from the caller so a room born tomorrow is read on the lap it arrives.
let path_pat = "(?<![A-Za-z0-9_])(?:\.\./)?(" + roots + ")/[A-Za-z0-9_./+*-]+"
let paths = map (find text path_pat) as p: "PATH:" + p

# PROPER -- capitalized noun runs, minus the common sentence openers.
let skip = ["Language" "Status" "Stamp" "Voice" "Style" "Bound" "Room" "Counsel" "Related" "Ground" "May" "And" "The" "This" "That" "With" "From" "Into" "Over" "Under" "After" "Before" "Every" "Each" "When" "Where" "What" "How" "Why" "For" "Our" "Your"]
let proper_raw = find text "\b[A-Z][a-z]{1,}(?:\s+[A-Z][a-z]{1,}){0,3}\b"
let proper_kept = where proper_raw as g: (?! (skip contains g))
let propers = map proper_kept as g: "PROPER:" + g

let all = stamp_dot + stamp_dash + hexes + fps + nums + paths + propers
let final = unique (sort all)
for-each final as line do say line
