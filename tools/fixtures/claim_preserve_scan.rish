# claim_preserve_scan.rish -- claim-token identity for Radiant passes.
#
# Body: claim_preserve_scan.sh
# Requires CLAIM_PRESERVE_FILES in the environment (newline-separated paths).
#
#   CLAIM_PRESERVE_FILES=$'path\npath' rishi/bin/rishi run tools/fixtures/claim_preserve_scan.rish

let body = run ["sh" "tools/fixtures/claim_preserve_scan.sh"]
say body.out
assert body.ok else "claim_preserve mismatch — STOP the wave; do not resolve"
