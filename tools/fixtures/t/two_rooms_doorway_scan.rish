# two_rooms_doorway_scan.rish -- forward-facing pages name their room at the door.
#
# Native orchestration -- per-file verdict in two_rooms_doorway_scan_one.sh
# (stamp compare, head-25 Status, case-insensitive room register).
#
# WHAT CHANGED 20260906, and why the numbers moved. The roster beside this file was a shell glob
# over three rooms; `active-designing/` folded to `date/YYYYMMDD/` and a shell `*` stops at `/`,
# so 607 pages left the reach with nothing to say so. The roster reads `git ls-files` now, whose
# pathspec `*` crosses `/`. Reach 319 -> 972 files, 216 -> 880 post-seating pages, and three
# pages that name no room became visible for the first time since their room folded.
#
# THE REACH FLOOR, and what it is for. A gate held at zero cannot tell a clean collection from a
# dead instrument, since both answer zero (REDS %416). Three floors stand below, and the third is
# this defect class watching for its own return: at least one page must come from a `date/` shelf.
# Should a roster narrow to the flat room again -- a rewritten glob, a room renamed -- the folded
# count falls to zero and this refuses, where the elder simply reported a smaller clean tree.
#
# WHAT IS RATCHETED RATHER THAN GATED. Forty-five pages carry a Status that names no room, or no
# Status at all. Three of them sit on `date/` shelves and are dated testimony, which
# accrete-never-break keeps exactly as written -- so a hard gate at zero could never close, and a
# gate that can never close is one somebody turns off. The ceiling only falls, and every failing
# page is named on every pass, so a repair is one line away from the reading that found it.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/fixtures/t/two_rooms_doorway_scan.rish

let seating_env = env "TWO_ROOMS_SEATING_STAMP"
let seating = "20260705-203144"
if seating_env != "" then let seating = seating_env

# The ceiling only ever falls FROM WHAT IT PUBLISHES. Measured 20260906.161500 on the repaired
# roster at 45 -- 42 pages already inside the elder reach, plus 3 the fold had hidden since
# active-designing folded. It publishes at 46, because the lap that measured 45 died before its
# commit and one external-research page landed in the gap; a number measured on a tree that has
# since moved is REDS %341's class, and the honest reading is the one taken at the send.
#
# IT ARRIVED RED AND FELL TO 44 (`20260907.001500`). The 46 was measured on a 972-page tree at
# `20260906.161500` and published on a 974-page tree seven hours later, by which time a third
# `Proposed` page had landed and the reading stood at **47** -- a ratchet rostered at a ceiling its
# own tree already exceeded, which is a guard that reds on arrival. That is this scan's own header
# reasoning turned on itself: a number measured before the send and landed after is a number about
# a tree that has moved.
#
# The repair is not a wider gate. Three pages read `**Status:** Proposed -- external research`, and
# TWO_ROOMS.md's gloss table names four tokens -- checkable, vision, mixed, research for
# understanding -- with `proposed` among none of them, while its own prose says "what is proven as
# proven and what is proposed as proposed". Each of the three already NAMED its register in its own
# next sentence: two say the numbers are witness-bound and the design reading is proposed, which is
# `mixed` by the table's own gloss, and the third says nothing here binds a witness, which is
# `research for understanding`. So each Status gained the token its own sentence already asserted --
# no claim changed, three pages started naming their room, and the reading fell 47 to 44. Whether
# `proposed` should itself be a fifth token is still the canon's to settle rather than this
# guard's, and it is carried on the card.
let ceiling_env = env "TWO_ROOMS_DOORWAY_CEILING"
let ceiling = "44"
if ceiling_env != "" then let ceiling = ceiling_env

let roster = run ["sh" "tools/fixtures/t/two_rooms_doorway_roster.sh"]
assert roster.ok else "two_rooms doorway roster failed"
let files = where (lines roster.out) as p: p != ""

let from_research = where files as f: f starts-with "external-research/"
let from_designing = where files as f: f starts-with "active-designing/"
let from_docs = where files as f: f starts-with "docs/"
let from_shelves = where files as f: f contains "/date/"

let results = map files as f: run ["sh" "tools/fixtures/t/two_rooms_doorway_scan_one.sh" f seating]

for-each results as r do say trim r.out

let fails = where results as r: r.ok == false

say "doorway pages=${length files} research=${length from_research} designing=${length from_designing} docs=${length from_docs} folded=${length from_shelves}"
say "doorway fails=${length fails} ceiling=${ceiling} seating=${seating}"

if length from_research == 0 then say "FAIL doorway reach: external-research read no page"
if length from_designing == 0 then say "FAIL doorway reach: active-designing read no page"
if length from_docs == 0 then say "FAIL doorway reach: docs read no page"
if length from_shelves == 0 then say "FAIL doorway reach: no folded page read -- a glob has narrowed to the flat room again"

if length from_research == 0 then exit 1
if length from_designing == 0 then exit 1
if length from_docs == 0 then exit 1
if length from_shelves == 0 then exit 1

let under = run ["sh" "-c" "test ${length fails} -le ${ceiling}"]

if under.ok == false then say "FAIL doorway ratchet: ${length fails} pages name no room, above the ceiling of ${ceiling}"
if under.ok == false then exit 1

say "verdict=ok"
say "OK   doorway scan complete (seating ${seating})"
