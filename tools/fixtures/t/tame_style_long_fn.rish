# tame_style_long_fn.rish -- >70-line function ledger for tame_style_scan advise.
#
# Native orchestration -- the walk and the rank live in tame_style_long_fn_scan.sh, which calls
# tame_style_long_fn_one.sh once per authored .rye file.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/fixtures/t/tame_style_long_fn.rish
#
# WHY THE WALK IS IN THE SCAN (REDS `20260906.173013`). This file used to spawn one subprocess per file here and
# join every chunk into one string to rank it. With the counter repaired the ledger holds 321 rows
# rather than 15, and interpolating that blob into a command refuses with `StringTooLong` -- a
# bound doing its job. The scan walks once and prints a summary line ahead of the top ten, so the
# reading stays small enough to hold and matches the scan-plus-witness shape used everywhere else.

let ledger = run ["sh" "tools/fixtures/t/tame_style_long_fn_scan.sh"]
assert ledger.ok else "tame_style_long_fn scan failed"
say ledger.out
