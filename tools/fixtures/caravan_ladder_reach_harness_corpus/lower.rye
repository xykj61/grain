//! Fixture rung -- the bottom of the harness-form corpus. It invents the check,
//! so it folds into nobody.

pub fn check_first(comptime rung: type) u8 {
    // invariant: the corpus proves the reach rule, so a real body is enough.
    _ = rung;
    var held: u32 = 1;
    held += 1;
    return if (held == 2) 0 else 1;
}
