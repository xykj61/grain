# living_docs_lint_scan.rish — ratchet-advisory living-docs lint (seven duties).
#
# Native migration of living_docs_lint_scan.py. Body lives in the sibling .sh so
# size and pattern duties can lean on the run seam (wc -c · grep) — Rish's
# map-transform ceiling refuses files past 256 lines; roster docs are larger.
#
# Always prints advisories; exit 0. Outer wrapper: tools/l/living_docs_lint.rish
#
#   rishi/bin/rishi run tools/fixtures/living_docs_lint_scan.rish

let body = run ["sh" "tools/fixtures/living_docs_lint_scan.sh"]
say body.out
assert body.ok else "living_docs_lint_scan body failed unexpectedly"
