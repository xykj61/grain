# Mirror cursor_jail_macos --cursor resolution -- no sandbox-exec.
let app_bin = "/Applications/Cursor.app/Contents/MacOS/Cursor"
let cursor = ""
if (args contains "--cursor") then let cursor = flag args "--cursor"
if (args contains "--cursor") then if (cursor ends-with ".app") then let app_bin = "${cursor}/Contents/MacOS/Cursor"
if (args contains "--cursor") then if ((cursor ends-with ".app") == false) then let app_bin = cursor
say "app_bin:${app_bin}"
