# tools/line_span_witness.rish -- read a DIRECTED line named by TWO anchor taps (from A toward B) as an ALONG-SEGMENT position, on metal
# (Season G).
#
# Season G (Open Media Primitives) -- this rung is the BOUNDED twin of line_order. Every line read so far treats the two anchors as an
# INFINITE line: line_partition splits the plane, line_order ranks along the whole direction, line_distance ranks off it, line_band lassoes a
# corridor around it. Yet a keeper draws a FINITE stroke. line_span clamps line_order's unbounded projection to the segment's own two integer
# thresholds, 0 (the A end) and len2 (the B end), so the same exact dot that ranked the objects now tells the drawn stroke's inside from its
# off-the-ends. A reading over readings, no plane of its own.
#
# The crux this witness proves on metal: THE STROKE IS BOUNDED WHERE THE ORDER IS UNBOUNDED. Over a horizontal segment A -> B, X (left of A)
# reads line_order rank 0 (frontmost) and Y (right of B) reads rank 5 (backmost) on the infinite line, yet line_span classes both OFF the
# finite stroke (before_a, beyond_b), and the on_span set is exactly the contiguous middle of the order between the anchors. The span is
# ORTHOGONAL to the side and the off-line distance (X on the line yet off the stroke; N off the line yet on the stroke); reversal SWAPS the
# ends and FIXES the middle (proj' = len2 - proj); refusals by name; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/line_span_witness.rish

say "line_span: Language EN -- Season G line-to-segment; a keeper's stroke is FINITE, so line_span clamps line_order's projection to the segment's two integer thresholds 0 <= proj <= len2, splitting every object into before_a / on_span / beyond_b; NO float, NO tolerance."
say "line_span: Style Radiant -- compose not braid: this rung owns only the along-segment classification and the two thresholds it clamps to; line_order owns the along-line projection every object is cross-checked against, line_partition owns the side arbiter and line_distance the off-line magnitude the orthogonality crux reads, click_collinear owns click_group_center_doubled whose squared delta is len2. No plane of its own, no pixel written -- a reading over readings."
say "line_span: Lens TAME -- the classification walk runs components times under label_max_pixels; the projection and the squared length run in i64 so the doubled-coordinate products stay whole; two anchors sharing a group refuse SameGroup, a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds, a label past the object count refuses BadTarget, each having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/line_span"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/line_span.rye -femit-bin=${bin}"]
assert build.ok else "line_span: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "line_span: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "line_span: ${out}"

assert selftest.out contains "GREEN image-line-span" else "line_span: selftest did not print the GREEN line"
assert selftest.out contains "read a DIRECTED line named by TWO anchor taps (from A toward B) as an ALONG-SEGMENT position" else "line_span: the along-segment claim did not print"
assert selftest.out contains "This is the BOUNDED twin of line_order" else "line_span: the bounded-twin claim did not print"
assert selftest.out contains "clamps line_order's projection to the segment's two integer thresholds 0 <= proj <= len2" else "line_span: the exact-integer threshold test did not print"
assert selftest.out contains "THE STROKE IS BOUNDED WHERE THE ORDER IS UNBOUNDED" else "line_span: the bounded-vs-unbounded crux did not print"
assert selftest.out contains "line_order ranks X FRONTMOST (rank 0) and Y BACKMOST (rank 5) on the infinite line, yet line_span classes X before_a and Y beyond_b" else "line_span: the off-the-ends-rank-like-any-other crux did not print"
assert selftest.out contains "the on_span set {A, N, M, B} is exactly the CONTIGUOUS MIDDLE of the order" else "line_span: the contiguous-middle crux did not print"
assert selftest.out contains "THE SPAN IS ORTHOGONAL TO THE SIDE AND THE OFF-LINE DISTANCE" else "line_span: the orthogonality crux did not print"
assert selftest.out contains "on the line off the stroke, off the line on the stroke" else "line_span: the on-line-off-stroke contrast did not print"
assert selftest.out contains "REVERSAL SWAPS THE ENDS AND FIXES THE MIDDLE" else "line_span: the reversal crux did not print"
assert selftest.out contains "proj' = len2 - proj" else "line_span: the reflection formula did not print"
assert selftest.out contains "before_a and beyond_b TRADE PLACES while on_span is INVARIANT" else "line_span: the ends-swap-middle-fixed claim did not print"
assert selftest.out contains "refuse SameGroup" else "line_span: the SameGroup refusal did not print"
assert selftest.out contains "a background tap refuses EmptyClick" else "line_span: the EmptyClick refusal did not print"
assert selftest.out contains "a point off the map refuses PointOutOfBounds" else "line_span: the PointOutOfBounds refusal did not print"
assert selftest.out contains "a label past the object count refuses BadTarget" else "line_span: the BadTarget refusal did not print"
assert selftest.out contains "the same segment reads the same span twice" else "line_span: determinism did not print"

say "line_span: GREEN on metal -- a directed line read as a FINITE stroke, the along-line order clamped to the segment's two integer ends; the off-the-ends objects rank like any other on the infinite line yet fall off the drawn stroke, the on_span set the contiguous middle of the order; the span orthogonal to the side and the off-line distance; reversal swaps the ends and fixes the middle; refusals by name, determinism. Season G open-media."
