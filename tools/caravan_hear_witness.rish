# caravan_hear_witness.rish -- Caravan hear witness.
#
# `courier.rye` taught a run to carry its correction to the place its reader was
# actually reached: the address seated on the wire beside the reading, the letter
# written into the reader's own box, and the box read back before the report
# believes anybody was reached. The letter leaves, and that is exactly as far as
# it goes. This rung asks the question the journey cannot answer.
#
#   A CORRECTION IS FINISHED WHEN ITS READER ANSWERS, AND THE PLAN HEARS IT.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO RECEIPTS DISAGREE ON IS CORRECTIONS WHOSE READER
#     ANSWERED INTO SILENCE. The rung below weighs an answer against the
#     DISTANCE it travelled. This weighs it against the HAND THAT ANSWERED IT --
#     a reader wrote back, in their own word, into a plan that never listened.
#     It falls from 1 to 0.
#   * A LETTER THAT LEFT PROVES A JOURNEY, NEVER A READING. Both runs carry the
#     same correction to the same reader; only one of them ever looks at what
#     came back.
#   * A READER'S BOX FACES TWO WAYS, AND A RUN MAY ONLY REACH ONE OF THEM. The
#     plan writes `caravan/.readers/desk.told`, the letter it carried; the reader
#     writes `caravan/.readers/desk.said`, the reading they now hold. A run reads
#     the second and NEVER writes it -- an acknowledgement a supervisor can write
#     for its reader is the plan agreeing with the plan. The selftest harness
#     stands in for the reader by name; this witness reads both files itself.
#   * AN ANSWER IS BOUND TO THE READING IT ANSWERS -- the consensus season's own
#     law one tier out. A hand naming the reading the letter carries is an
#     agreement; a hand naming any other reading is a different sentence.
#   * THE PRICE IS ONE READ OF A FILE THE RUN ALREADY KNEW THE NAME OF. Both runs
#     take up 6 phases, absorb 3 into standing dependents, lose 3 arcs, take the
#     same judgment back, re-seat the same 3 phases, spend the same 6 dependents,
#     post the same correction, carry it to the same reader, and settle the plan
#     `carried`.
#   * A PLAN PUBLISHES WHETHER IT HEARS. The receipt is plan-level beside the
#     dispatch, since it instructs about whether a record listens rather than
#     about one arc.
#   * A HEARING IS BOUNDED BY THE CORRECTION THAT EARNED IT. Only a letter this
#     run actually carried may be heard, and every carried letter is heard or
#     unheard, never both and never neither.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE ANSWER RATHER THAN THE
#     CORRECTION THAT EARNED IT. `HearEarly` is the moment. `HearUnanswered` is
#     the supply. `HearMiscounted` is the honesty of the count. `HearMisheard` is
#     the answer -- a hand naming a different reading is a different sentence,
#     and a report claiming agreement from it is worse than the silence below it.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Plant a
# hand naming the superseded reading and the run refuses `HearMisheard`. Clear
# the hand before the listening run and it refuses `HearUnanswered` -- which also
# proves no run ever writes `.said` for its reader, since a forging supervisor
# would have found one. Let the count stop closing and it refuses
# `HearMiscounted`. Read no carried letter at all and it refuses `HearEarly`.
# Disarm the agreement check with the misheard hand still planted and the run
# reports the reader agreeing to a word they never wrote -- the exact harm the
# check prevents, seen once so the guard is known to be load-bearing.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_hear_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/hear"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/hear.rye -femit-bin=${bin}"]

assert build.ok else "caravan hear build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/hear_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/hear_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. The box goes with them, so the lap begins with a reader who
# has neither been told anything nor said anything a run this witness never
# watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.hearings caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan hear selftest exited non-zero"
assert test.out contains "GREEN" else "caravan hear selftest not GREEN"
assert test.out contains "a correction is finished when its reader answers and the plan hears it" else "the hearing finding did not close"

# The hearing and its three standing refusals, read straight, before any
# dependent runs. The fourth, `HearMisheard`, belongs to the run rather than the
# fold, since only a reader's own box can answer which reading their hand names.
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing fold was not weighed"
assert test.out contains "three refusals stand by name: early, unanswered, miscounted" else "the three standing refusals did not stand"

# The delivery, the amendment, the recantation, the bearing, and the mend below,
# unchanged and still weighed.
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The hearing lap: one plan run twice against a reader who wrote back, once never
# reading their answer and once reading it in their own hand. Every number stands
# still -- the work, the dependents, the correction, the journey, the settlement
# -- and only the listening moves.
assert test.out contains "phases: 6 unasked, 6 asked" else "the two receipts ran different records"
assert test.out contains "dependents: 6 unasked, 6 asked" else "hearing an answer cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 unasked, 3 asked" else "the two receipts absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 unasked, 3 asked" else "the two receipts lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 unasked, 3 asked" else "the two receipts repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 unasked, 1 asked" else "the recanting rung stopped moving under both receipts"
assert test.out contains "readings corrected where they were read: 1 unasked, 1 asked" else "the amending rung stopped moving under both receipts"
assert test.out contains "corrections carried to the place their reader was reached: 1 unasked, 1 asked" else "the couriering rung stopped moving under both receipts"
assert test.out contains "answers this run's reader wrote back: 1 unasked, 1 asked" else "the two receipts met different readers"
assert test.out contains "answers read in the reader's own hand: 0 unasked, 1 asked" else "the hearing did not part the two receipts"
assert test.out contains "corrections whose reader answered into silence: 1 against 0" else "the two receipts left the same answer unread"
assert test.out contains "work still standing when the supervisor exits: 0 unasked, 0 asked" else "the two receipts left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole unasked, carried out whole asked" else "the two receipts settled the plan differently"
assert test.out contains "breaks a named turn: 0 unasked, 0 asked" else "the listening run broke an order its author named"

# What an operator reads is what the wire carries, and what a reader holds is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.hearings/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

let correction = run ["sh" "-c" "cat caravan/.hearings/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let address = run ["sh" "-c" "cat caravan/.hearings/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

# The two halves of the reader's own box, outside this plan's wire entirely --
# the letter the plan carried, and the hand the reader answered with.
let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let hand = run ["sh" "-c" "cat caravan/.readers/desk.said"]
assert hand.ok else "the reader answered nothing at all"
assert hand.out contains "c" else "the reader's own hand did not name the reading they now hold"

let recant_note = run ["sh" "-c" "cat caravan/.hearings/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.hearings/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan hear witness passed."
