# tools/hunk_revert_preview_witness.rish — the Skate view of a revert on metal (HUNK15).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK15.
# Design read: active-designing/20260813-155719_hunk-photo-edits-non-destructive-exploration.md (revert horizon).
# Teachers, thanked clean-room: gratitude/qoi.md (the open codec) · the "revert to original" of iCloud Photos /
# Google Photos (concept only, siloed).
#
# HUNK13 let a keeper see a pending edit; HUNK14 let a keeper revert by dropping edits off the end of the list. This
# rung joins them: `brushstroke/revert_preview.rye` `preview_revert` drops the last k edits (photo_revert.drop_last,
# pure) and hands the shorter list to edit_preview.preview, returning the Skate grid of the earlier image — so a keeper
# sees exactly what a revert will restore before committing it. Reverting all the way previews the original (a look,
# not a reconstruction). The selftest proves the restored view equals the source's own down-map cell-for-cell, that a
# revert of zero is the full view and reverting past the count clamps to the original, that the caller's list is
# untouched and the preview deterministic, that reverting away an out-of-bounds crop rescues a refusing list to preview
# cleanly, and that an empty grid still refuses EmptyImage through the revert. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_revert_preview_witness.rish

say "hunk-revert-preview: Language EN — HUNK15 previews a revert: drop the last k edits, then down-map the earlier image so a keeper sees what a revert restores before committing it."
say "hunk-revert-preview: Style Radiant — reverting to the original is a look, not a reconstruction: no pixels stored, no history replayed backward, only the recipe shortened and re-seen on the open module the quest built."
say "hunk-revert-preview: Lens TAME — pure composition over two proven seams (drop_last, preview); the caller's list untouched, refusals named, an over-count revert clamped; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/revert_preview"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/revert_preview.rye -femit-bin=${bin}"]
assert build.ok else "hunk-revert-preview: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-revert-preview: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-revert-preview: ${out}"

assert out contains "GREEN revert-preview" else "hunk-revert-preview: selftest did not print the GREEN revert-preview line"

assert out contains "the original restored" else "hunk-revert-preview: the restored view did not equal the source down-map"

assert out contains "clamps to the original" else "hunk-revert-preview: an over-count revert did not clamp to the original"

assert out contains "input list is untouched" else "hunk-revert-preview: the caller's list was not proven untouched"

assert out contains "rescues a refusing list" else "hunk-revert-preview: reverting a bad edit did not rescue a refusing list"

say "hunk-revert-preview: GREEN — the Skate view of a revert: the earlier image seen before it is committed, the original restored by reverting all, a revert rescuing a refusing list; no network, no key, no funds."
