# caravan_withdraw_witness.rish -- Caravan withdraw witness.
#
# `enlist.rye` carried a newcomer into a supervisor with dependents already in
# flight, and named its own limit: a run may take work while it runs, and
# nothing may yet leave one. A phase queued by mistake had no door out.
#
#   A PHASE STILL WAITING MAY LEAVE A RUN, ON THE MIRROR OF THE THREE FACTS
#   AN ARRIVAL OWED THE PLAN.
#
# An arrival asks whether anybody placed waits on its turn, whether its step
# is the next one that turn has open, and whether a turn already standing
# agrees about what it follows. A withdrawal asks the mirror of each: whether
# the phase still waits, whether its step is the last one its turn holds, and
# whether any phase in the record names its turn. One walk answers all three.
#
# WHAT THE WITHDRAWAL BUYS, AND WHAT IT COSTS, MEASURED:
#
#   * LEAVING COSTS WHAT JOINING COSTS. One walk of the record: 16 tests
#     against 256 to seat the plan again -- the record's length against the
#     queue's square, and exactly what an arrival and an enlistment each
#     cost. Printed from the bounds themselves rather than typed into prose.
#   * A RUN MUST NEVER RELEASE A FOLLOWER WHOSE PREDECESSOR NEVER RAN. Turn 4
#     is refused its leave by name against a record of 7, since turn 5 names
#     it. The shy reading -- asking only whether turn 4 still waits -- lets it
#     go, and turn 5 then waits on nobody, satisfied by a turn that never came
#     home with nothing anywhere to report it. The difference is measured
#     rather than asserted.
#   * THREE REFUSALS, EACH NAMED FOR THE FACT IT PROTECTS: `WithdrawalMissing`
#     for a phase no longer in the record, `WithdrawalStarted` for a dependent
#     already running, `WithdrawalUnseated` for a plan that would not survive
#     the loss.
#   * A DEPARTURE MOVES NOTHING. The record keeps its length, so every dependent
#     already started keeps the slot, the line, and the grants it was handed
#     -- `enlist.rye`'s rule for a newcomer, read from the other side.
#   * WITHDRAWAL IS ARRIVAL'S INVERSE. A plan grown by an arrival and then
#     relieved of that same phase is the plan it was handed, all 6 phases --
#     this arc's standing generalization test, one tier further out.
#   * TWO PHASES LEFT A RUN ALREADY UNDER WAY, and the lap ran to its honest
#     end: 5 dependents against 7 handed whole, 0 named turns broken. The
#     schedule itself was corrected by metal -- an earlier draft reached for
#     turns the passes had already started, and the run refused with
#     `WithdrawalStarted` rather than pretending.
#
# THE LIMIT IS NAMED: a withdrawal reaches only work still waiting. A dependent
# already running is never recalled and a phase already home is never unrun.
# Whether a run may REPLACE a phase -- withdraw one and enlist another in one
# act -- belongs to the vision room until a witness binds it.
#
# Both RED paths were proven on metal before this witness claimed GREEN. Drop
# the check that no phase names the departing turn, and the pure read reds at
# a follower released by a predecessor that never ran -- caught in the happy
# zone, before a dependent starts. Drop the check that the phase still waits, and
# the module's own invariant fires at `caravan/withdraw.rye:624` with dependents
# in flight, so the contract is load-bearing rather than decorative.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_withdraw_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/withdraw"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/withdraw.rye -femit-bin=${bin}"]

assert build.ok else "caravan withdraw build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs once ran a shared caravan/bin/read without building it, so the whole
# arc was green only on a tree some earlier run had left warm. A witness owns what it
# runs -- and, since REDS %133, the path it runs it from: eighty witnesses built that
# one reader to one name, so two running at once contended for a single file and the
# loser reddened a green tree. This one lands in caravan/bin/withdraw_read.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/withdraw_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# Nothing new is declared: a run shrinks by releasing a phase, and the
# document still speaks only in ceilings.
let published = run ["sh" "-c" "caravan/bin/withdraw_read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan withdraw selftest exited non-zero"
assert test.out contains "GREEN" else "caravan withdraw selftest not GREEN"
assert test.out contains "a phase still waiting may leave a run, on the mirror of the three facts an arrival owed" else "the withdraw finding did not close"

# The withdrawal read straight, before any supervisor spends it.
assert test.out contains "a turn its follower names is refused its leave against a record of 7" else "the record did not refuse a turn its follower names"
assert test.out contains "the shy reading lets it go, and turn 5 then waits on nobody" else "the cost of the shy reading was not shown"
assert test.out contains "a withdrawal costs at most 16 tests, against 256 to seat the plan again" else "the cost of a withdrawal was not reported honestly"

# The inverse test: an arrival relieved of its own phase is the plan again.
assert test.out contains "a plan relieved of its own arrival is that plan, all 6 phases" else "withdrawal did not invert arrival phase for phase"

# The withdrawal lap: one plan run twice, handed whole and pruned as it runs.
assert test.out contains "breaks a named turn: 0 handed whole, 0 pruned while running" else "the shrinking run did not keep the order its author named"
assert test.out contains "dependents: 7 handed whole, 5 pruned while running" else "the shrinking queue did not release exactly the work it was asked to"
assert test.out contains "2 phases left a run already under way" else "no phase left a run in flight"

say "GREEN: Caravan withdraw witness passed."
