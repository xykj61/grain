# tools/font5x7_upper_nordic_witness.rish -- the open Danish-Norwegian CAPITALS corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), the uppercase
# companion to tools/font5x7_nordic_witness.rish. Where the lowercase corpus closed the lowercase Latin-1 letter set,
# this one draws the three CAPITALS a Danish or Norwegian alphabet appends after Z -- A with a ring, the AE ligature, O
# with a stroke -- at their real Unicode codepoints U+00C5, U+00C6, U+00D8 (each 0x20 below its lowercase twin), each a
# 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_upper_nordic.rye, built into a gfa1 atlas and
# proven on metal.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Danish-Norwegian capitals corpus: a full round-trip recovers
# every codepoint, advance, and coverage byte byte-for-byte; all three capitals look up present and carry the shared
# advance while an unaccented ASCII 'A' misses; the three carry distinct coverage; each reads within an honest legibility
# band; and the three CONSTRUCTIONS hold -- the A ring wears a hollow ring above its compressed body (a mark present, its
# center a hole), the AE ligature carries no mark and a full crossbar where the A and the E join, and the O stroke inks
# the center of its bowl where a plain O stays hollow. With these three the Scandinavian capitals stand drawn in our own
# open hand, so a civic surface prints AERO, BJORN, or a Danish keeper's own name in ALL-CAPS. Compression is reported as
# a fact, never asserted -- the round-trip is the proof. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_upper_nordic_witness.rish

say "font5x7-upper-nordic: Language EN -- Season G font content; the three Danish-Norwegian capitals (A ring, AE ligature, O stroke) drawn in the open as ASCII line art, built into the gfa1 atlas, the letters a civic surface prints at the head of a name or in ALL-CAPS -- AERO, BJORN, KOBENHAVN -- the uppercase companion to the lowercase Nordic corpus."
say "font5x7-upper-nordic: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; three capitals built three ways (a hollow ring above a compressed A, a fused AE ligature with a crossbar, an O with a stroke through its bowl), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-upper-nordic: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - upper_nordic_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_upper_nordic"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_upper_nordic.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-upper-nordic: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-upper-nordic: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-upper-nordic: ${out}"

assert selftest.out contains "GREEN image-font5x7-upper-nordic" else "font5x7-upper-nordic: selftest did not print the GREEN corpus line"

say "font5x7-upper-nordic: GREEN -- the capitals A ring, AE, O stroke stand drawn in the open, the Scandinavian capitals in our own open hand, proven on metal."
