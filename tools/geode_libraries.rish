# tools/geode_libraries.rish -- render the docs-geode library index, or write it.
#
# The page is generated in full rather than spliced between markers, because the whole thing is
# derived: the prose lives in tools/fixtures/geode_libraries_scan.sh so there is exactly one source
# for it, and a hand-edit of the page is simply overwritten on the next run.
#
#   rishi/bin/rishi run tools/geode_libraries.rish          # render to stdout, touch nothing
#   rishi/bin/rishi run tools/geode_libraries.rish write    # write docs-geode/libraries/README.md
#
# Proven by tools/geode_libraries_witness.rish. Run from the repository root.

let mode = "render"
if length args != 0 then let mode = args[0]

let census = run ["sh" "tools/fixtures/geode_libraries_scan.sh"]
assert census.ok else "geode-libraries: the census must complete before a page is written"
assert census.out contains "verdict=ok" else "geode-libraries: the census must find at least one library"
say census.out

if mode != "write" then exit exit-ok

let written = run ["sh" "-c" "sh tools/fixtures/geode_libraries_scan.sh render > docs-geode/libraries/README.md"]
assert written.ok else "geode-libraries: the page must be written"
# Counted without a bracket in the pattern: escaping a `[` through a Rishi string into a shell
# into grep is three layers of quoting to get right for a number, and the row shape is already
# unambiguous without it.
let check = run ["sh" "-c" "grep -c 'README.md)' docs-geode/libraries/README.md"]
assert check.ok else "geode-libraries: the written page must hold rows"
let rows = trim check.out
say "geode-libraries: wrote docs-geode/libraries/README.md with ${rows} rows"
