# kumara_tilak_witness.rish — the Kumara identity template: point and bind.
#
# Proves the first two tilaks of a Kumara identity are made, signed both ways, and
# verified — the load-bearing pair every other tilak hangs from. The crypto rides on
# tally/kumara.rye (Ed25519 at the seam); this witness drives the built module and
# checks both the proof and the Bron facts it emits.
#
# Build first:  rye build kumara/tilak.rye -femit-bin=kumara/bin/tilak
#   rishi/bin/rishi run tools/kumara_tilak_witness.rish

# The module's own selftest — a bind verifies both ways, a tampered bind refuses.
# Diagnostics print to stderr; the Bron facts of `emit` go to stdout.
let st = run ["kumara/bin/tilak" "selftest"]
assert st.ok else "kumara tilak selftest must exit 0"
assert (st.err contains "GREEN") else "selftest must report GREEN"
assert (st.err contains "verifies both ways") else "a bind must verify in both directions"
assert (st.err contains "tampered bind refused") else "a tampered bind must be refused"
assert (st.err contains "tier star") else "point 256 seats in tier star"

# The emitted instance is well-formed Bron — a point fact and a bind fact.
let em = run ["kumara/bin/tilak" "emit"]
assert em.ok else "emit must exit 0"
assert (em.out contains "format kumara-point-v1") else "emit a point fact"
assert (em.out contains "format kumara-bind-v1") else "emit a bind fact"
assert (em.out contains "version 1") else "a fresh point and bind begin at version 1"

# Both signatures are present and the right length (64 bytes = 128 hex chars).
let sigs = find em.out "sig_by_(key|keeper) [0-9a-f]{128}"
assert (length sigs) == 2 else "both bind signatures are present at full Ed25519 length"

# The point is kept by the keeper: its keeper hex is the bind's keeper_pubkey.
let point_keeper = find em.out "\nkeeper [0-9a-f]{64}"
let bind_keeper = find em.out "keeper_pubkey [0-9a-f]{64}"
assert (length point_keeper) == 1 else "the point names one keeper"
assert (length bind_keeper) == 1 else "the bind names one keeper key"

say "GREEN: kumara tilak — the point and bind are made, signed both ways, verified, and emitted as Bron; a tampered bind refuses."
