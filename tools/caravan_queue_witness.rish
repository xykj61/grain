# caravan_queue_witness.rish -- Caravan queue witness.
#
# Proves what a doorbell can and cannot count. Every ring before this one
# carried exactly one message at a time: a producer wrote at offset zero of
# a region and rang, so a second message written before the first was read
# would have quietly replaced it. That is correct only while no more than
# one ask is ever outstanding -- which is a schedule, and this arc has been
# retiring schedules one ring at a time.
#
# A doorbell coalesces. Rings that arrive before the receiver runs are
# indistinguishable from one, and a producer batching many asks behind a
# single ring is doing the efficient thing rather than a wrong one. So the
# ring count never answers how many asks are waiting. Two indices in shared
# memory answer it -- a head the producer owns and a tail the consumer
# owns, each living in the region its writer already holds.
#
# The claim is checkable from outside the program four ways. The walls say
# neither side can move the other's index. The batch says three asks came
# home behind one ring. The nudge says a ring with nothing behind it drains
# zero by name. And the totals say seven asks rode three rings.
#
# Both RED paths were proven on metal before this witness was written.
# Driving the drain from the bell count rather than from `head - tail`
# drained one ask of three, and `settled` caught it -- the producer read the
# consumer's own tail standing at 1 against a head of 3 and answered `bytes
# differed`. Dropping the capacity refusal let a fifth ask land in a
# four-slot queue, overwriting an unread one, and the next drain read a
# sequence number it never expected and answered `bytes differed` again.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_queue_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/queue"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/queue.rye -femit-bin=${bin}"]

assert build.ok else "caravan queue build failed"

# The declaration stands unchanged. The same pair of regions a channel
# already grants is exactly the pair a queue wants -- a head in memory the
# producer writes, a tail in memory the consumer writes.
let decl = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_two_clients.bron 2>&1"]
assert decl.ok else "the two-client declaration could not be read"
assert decl.out contains "domains 3 -- channels 2 -- regions 4 -- grants 8" else "the two-client declaration changed shape"
assert decl.out contains "verdict: whole" else "the two-client declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan queue selftest exited non-zero"
assert test.out contains "GREEN" else "caravan queue selftest not GREEN"
assert test.out contains "a ring says something happened, and the queue says how much" else "the queue claim did not close"

# The wire is a closed shape before any process runs on it: a verb this
# ring never named is refused, an unreadable count is refused, and every
# sequence number in one full queue lands in its own slot.
assert test.out contains "the plan wire reads back whole, and 4 sequence numbers land in 4 distinct slots" else "the plan wire did not read back"

# The walls that make the two indices trustworthy. A producer that could
# advance the tail would claim its asks were consumed; a consumer that
# could advance the head would invent asks nobody made.
assert test.out contains "client_a: forge on rx_a answering tx_a via serial_virt -- WriteDenied" else "a producer moved the consumer's tail"
assert test.out contains "serial_virt: forge on tx_a answering rx_a via client_a -- WriteDenied" else "a consumer moved the producer's head"
assert test.out contains "neither side moves the other's index -- both forgeries refused WriteDenied" else "the forgery wall did not close"

# An unwired announcement rings nothing, and a drain hears nothing unrung.
assert test.out contains "client_a: announce on rx_a answering tx_a via client_b -- NotWired" else "an undeclared channel carried a batch"
assert test.out contains "serial_virt: drain on tx_a answering rx_a via client_a -- Unheard" else "a drain ran on a bell that never rang"

# The crux: three asks ride behind ONE ring, and one drain carries all
# three home. A consumer draining once per ring would read a different
# number here.
assert test.out contains "client_a: 3 asks written behind 1 ring" else "the batch did not ride one ring"
assert test.out contains "serial_virt: heard 1, drained 3" else "the drain was driven by the bell rather than by the queue"

# And the producer reads that progress out of the consumer's own memory --
# which it may see and may never move.
assert test.out contains "client_a: head 3, peer drained 3" else "the queue did not settle where the producer could read it"

# The same claim inverted: a ring with nothing behind it drains zero by
# name rather than reading the last batch's slot as fresh.
assert test.out contains "client_a: nudge on rx_a answering tx_a via serial_virt -- carried" else "a nudge could not ring on its own"
assert test.out contains "serial_virt: heard 2, drained 0" else "a spurious ring invented an ask"
assert test.out contains "serial_virt: drain on tx_a answering rx_a via client_a -- nothing new" else "an empty queue did not answer by name"

# Capacity is declared rather than hoped for. A full queue refuses rather
# than overwriting a message nobody has read.
assert test.out contains "client_a: 4 outstanding leaves no room for 1 more" else "a full queue did not name what filled it"
assert test.out contains "client_a: announce on rx_a answering tx_a via serial_virt -- QueueFull" else "a fifth ask entered a four-slot queue"
assert test.out contains "serial_virt: heard 3, drained 4" else "the unread asks did not survive the refusal"
assert test.out contains "client_a: head 7, peer drained 7" else "the queue did not settle empty"

# The totals, measured across the whole run: more asks than rings is the
# whole property stated in numbers.
assert test.out contains "7 asks carried on 3 rings across 3 drains" else "the run did not carry more asks than rings"
assert test.out contains "4 directed bells provisioned silent across 2 declared channels" else "the run did not start silent both ways"

say "GREEN: Caravan queue witness passed."
