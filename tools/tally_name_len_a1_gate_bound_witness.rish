# tools/tally_name_len_a1_gate_bound_witness.rish — Ashvini a1 second wall (e215).
#
#   rishi/bin/rishi run tools/tally_name_len_a1_gate_bound_witness.rish

say "a1-tally_name_len: Language EN — tally name wall of thirty-two, decided in Glow (STOA331)."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-tally-name-len-bound-u32.glow"

let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "12"]
assert ok.ok else "a1-tally_name_len: accept side failed"
assert ok.out contains "EXIT:0" else "a1-tally_name_len: accept did not exit 0"
assert ok.out contains "1" else "a1-tally_name_len: accept did not speak 1"

let over = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "40"]
assert over.ok else "a1-tally_name_len: over side failed"
assert over.out contains "EXIT:0" else "a1-tally_name_len: over did not exit 0"
assert over.out contains "0" else "a1-tally_name_len: over did not speak 0"

let first = run ["sh" "-c" "test -f src/lib/gate-mantra-gen-floor-u32.glow"]
assert first.ok else "a1-tally_name_len: the mantra face is missing"

say "GREEN: a1 tally_name_len second wall — decides on both sides."
