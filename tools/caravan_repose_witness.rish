# caravan_repose_witness.rish -- Caravan repose witness.
#
# `lapse.rye` taught a run to put an objection back to the reader who raised it:
# the question written into that reader's own box, the answer read out of it,
# and one byte naming what became of the quarrel -- renewed, or let go. That
# term is exactly right, and it is filed where the deciding happened.
#
#   A MARK CARRIES THE STANDING OF THE OBJECTION IT QUOTES.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO MARKS DISAGREE ON IS OBJECTIONS ESCORTED WHOSE
#     STANDING AN OPERATOR CANNOT READ. The rung below weighs a record against
#     the life of the person who wrote it. This weighs what that weighing ever
#     reached -- a finding filed rather than delivered. It falls from 1 to 0.
#   * A MARK READS THE SAME WHETHER THE QUARREL IS LIVE OR LONG OVER, below this
#     rung. The escort in `caravan/.reposings/plan.beside` is one byte naming the
#     reading its reader holds, identical the day the objection is raised and the
#     season after nobody renewed it.
#   * A STANDING RIDES IN THE MARK, NEVER IN A SECOND FILE. The act is one byte
#     appended to the escort the rung below wrote, so `plan.beside` reads `sq` --
#     the reader's own reading first, exactly as they earned it, and the standing
#     of their objection second: `h` held, `q` at repose.
#   * A REPOSE REPORTS, AND NEVER WITHDRAWS. The mark's first byte still reads
#     `s` and the settlement still reads `c` afterward, since a run that erased a
#     mark because the quarrel went quiet would be winning it by outlasting the
#     person who raised it.
#   * SILENCE BELONGS TO THE PERSON WHO IS SILENT, unchanged one tier out. The
#     reader's own `caravan/.readers/desk.still` is seated by the selftest
#     harness standing in for the reader by name, never by any run.
#   * BOTH ANSWERS ARE PROVEN ON THE WIRE, not only as folds. The standing run
#     reads a silence and publishes `q`; a third run, over a reader who raises
#     their objection again in their own hand, publishes `h` -- so the wire's
#     final `plan.beside` reads `sh`, which is that third run's word.
#   * THE PRICE IS ONE BYTE APPENDED TO A NOTE THE RUN HAD ALREADY WRITTEN. Both
#     runs take up 6 phases, absorb 3 into standing dependents, lose 3 arcs, take
#     the same judgment back, re-seat the same 3 phases, spend the same 6
#     dependents, post and carry the same correction, read the same answer,
#     record the same disagreement, escort the same published word, ask the same
#     reader whether they still object, read the same silence, and settle the
#     plan `carried`.
#   * A PLAN PUBLISHES WHETHER ITS MARKS CARRY THEIR OWN STANDING. The word is
#     plan-level beside the term, since it instructs about how a record reads
#     rather than about one arc.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE STANDING RATHER THAN THE
#     OBJECTION IT REPORTS ON. `ReposeEarly` is the moment. `ReposeUnweighed` is
#     the hard half -- a standing published where nobody ever put a term on the
#     objection decides a person's mind rather than reads it. `ReposeMiscounted`
#     is the honesty of the count. `ReposeMisread` is the record -- a standing
#     that disagrees with the term the wire itself carries.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Read no
# term and disarm the guards that spare it, and the run refuses `ReposeUnweighed`.
# Publish the other finding and it refuses `ReposeMisread`. Let the count stop
# closing and it refuses `ReposeMiscounted`. Speak for a mark nobody escorted and
# it refuses `ReposeEarly`. Disarm every guard at once -- the two that spare an
# unweighed objection, the refusal, the fabricated answer, the folds, and every
# harness read that catches them -- and the run publishes `sq` beside a word whose
# reader was never asked, with `plan.term` and `desk.again` both absent from the
# wire and the selftest still calling itself GREEN. Seeing that once is what makes
# the standing a check rather than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_repose_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/repose"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/repose.rye -femit-bin=${bin}"]

assert build.ok else "caravan repose build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. The box goes with them, so the lap begins with a reader who
# has neither been told anything, nor said anything, nor been asked anything by a
# run this witness never watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.reposings caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan repose selftest exited non-zero"
assert test.out contains "GREEN" else "caravan repose selftest not GREEN"
assert test.out contains "a mark carries the standing of the objection it quotes" else "the repose finding did not close"

# The standing and its three standing refusals, read straight, before any
# dependent runs. The fourth, `ReposeMisread`, is answered in the same fold,
# since whether a standing quotes its own term is a question two words can settle
# between themselves.
assert test.out contains "a plan publishes whether its marks carry the standing of their objection" else "the standing fold was not weighed"
assert test.out contains "three refusals stand by name: early, unweighed, miscounted" else "the three standing refusals did not stand"
assert test.out contains "an objection at repose, which nobody renewed" else "an objection nobody renewed did not read as one"

# The term, the escort, the record, the hearing, the delivery, the amendment, the
# recantation, the bearing, and the mend below, unchanged and still weighed.
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term below stopped being weighed"
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The repose lap: one plan run twice over an objection its reader let go, once
# leaving the mark reading exactly as the rung below wrote it and once carrying
# the term's own answer into it. Every number stands still -- the work, the
# dependents, the correction, the journey, the record, the escort, the asking,
# the silence, the settlement -- and only the standing moves.
assert test.out contains "phases: 6 bare, 6 standing" else "the two marks ran different records"
assert test.out contains "dependents: 6 bare, 6 standing" else "standing a mark cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 bare, 3 standing" else "the two marks absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 bare, 3 standing" else "the two marks lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 bare, 3 standing" else "the two marks repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 bare, 1 standing" else "the recanting rung stopped moving under both marks"
assert test.out contains "readings corrected where they were read: 1 bare, 1 standing" else "the amending rung stopped moving under both marks"
assert test.out contains "corrections carried to the place their reader was reached: 1 bare, 1 standing" else "the couriering rung stopped moving under both marks"
assert test.out contains "disagreements written into the record: 1 bare, 1 standing" else "the disputing rung stopped moving under both marks"
assert test.out contains "published words standing beside the reading against them: 1 bare, 1 standing" else "the abiding rung stopped moving under both marks"
assert test.out contains "standing objections put back to the reader who raised them: 1 bare, 1 standing" else "the lapsing rung stopped asking under both marks"
assert test.out contains "objections nobody renewed, let go rather than resolved: 1 bare, 1 standing" else "the two marks read different silences"
assert test.out contains "marks carrying the standing of the objection they quote: 0 bare, 1 standing" else "the standing did not part the two marks"
assert test.out contains "marks left reading exactly as the rung below wrote them: 1 bare, 0 standing" else "the other half of the count did not close"
assert test.out contains "objections escorted whose standing an operator cannot read: 1 against 0" else "the two marks read the same way"
assert test.out contains "work still standing when the supervisor exits: 0 bare, 0 standing" else "the two marks left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole bare, carried out whole standing" else "the two marks settled the plan differently"
assert test.out contains "breaks a named turn: 0 bare, 0 standing" else "the standing run broke an order its author named"

# The other answer the same question admits, proven on the same wire rather than
# only as a fold.
assert test.out contains "a reader who raises their objection again has the mark say so" else "a renewing reader was never proven on the wire"

# What an operator reads is what the wire carries, and what a reader is asked is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.reposings/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The mark itself, carrying both the reading its reader holds and the standing of
# that objection. The wire's final word is the renewing run's, since that run
# comes last of the three -- so the standing reads `h` beside an untouched `s`.
let beside = run ["sh" "-c" "cat caravan/.reposings/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "sh" else "the mark did not name the reading its reader holds and the standing they hold it in"

# The term below it, published exactly as the rung below publishes it.
let term = run ["sh" "-c" "cat caravan/.reposings/plan.term"]
assert term.ok else "no term was ever published an operator could read"
assert term.out contains "r" else "a reader who raised their objection again had it let go"

# The question the rung below asks, in the reader's own box, naming both readings
# of the quarrel exactly as the record names them.
let question = run ["sh" "-c" "cat caravan/.readers/desk.again"]
assert question.ok else "a standing run let an objection go without ever asking"
assert question.out contains "cs" else "the question named a quarrel its reader never raised"

# The record the standing weighs, kept exactly as the rungs below write it.
let quarrel = run ["sh" "-c" "cat caravan/.reposings/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.reposings/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let address = run ["sh" "-c" "cat caravan/.reposings/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

# The reader's own box, outside this plan's wire entirely -- the letter the plan
# carried, the hand they answered with, and the second hand they raised.
let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let hand = run ["sh" "-c" "cat caravan/.readers/desk.said"]
assert hand.ok else "the reader answered nothing at all"
assert hand.out contains "s" else "the reader's own hand did not name the reading they hold"

let still = run ["sh" "-c" "cat caravan/.readers/desk.still"]
assert still.ok else "the reader raised nothing again"
assert still.out contains "s" else "the second hand did not raise the objection the record holds"

let recant_note = run ["sh" "-c" "cat caravan/.reposings/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.reposings/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan repose witness passed."
