# tools/gen/chapter/surface_season_p50_witness.rish -- hosted brush choir pin.
#
#   rishi/bin/rishi run tools/gen/chapter/surface_season_p50_witness.rish
#
# Needs WAYLAND_DISPLAY for the hosted brush hop.

say "surface-p50: Language EN -- hosted .brush on Wayland pinned."
say "surface-p50: Style Radiant -- one present; refuse live-five invent."
say "surface-p50: Lens TAME -- Surface Chapter p50."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-135422_surface-season-p50-hosted-brush-choir.md"]
assert counsel.ok else "surface-p50: p50 counsel missing"

let display = run ["sh" "-c" "test x$WAYLAND_DISPLAY != x"]
# AN ABSENT DISPLAY SERVER IS A FACT ABOUT THE HOST, NEVER A DEFECT (REDS %646).
# A headless pier is a correct host, and every ship in this fleet runs on one. The hard
# assert this replaces refused there, which is the same unrostable shape as the unbuilt
# artifact below: a roster row would red the whole fleet, so no row was ever written and
# the red went unheard. The skip is decided here, on the environment.
if (display.ok == false) then say "surface-p50: SKIP -- WAYLAND_DISPLAY is unset here; this witness wants a live Wayland session"
if (display.ok == false) then say "GREEN: surface-p50 -- skipped honestly, the display this witness draws on is absent"
if (display.ok == false) then exit 0

let seed_bin = "brushstroke/bin/brushstroke-wayland-seed"

# AN UNBUILT OPTIONAL ARTIFACT IS A FACT ABOUT THE CLONE, NEVER A DEFECT (REDS %646).
# Everything under `brushstroke/bin/` is a gitignored build output, so a clone that has
# yet to build it is a correct clone. The hard assert this replaces made the witness
# UNROSTABLE: a roster row would red every machine without the binary, which is why this
# witness was never rostered -- and an unrostered witness runs nowhere, so the assert
# bought a red nobody would ever hear. The skip is decided here, on the artifact; every
# claim below still refuses exactly as hard as it did before.
let have = run ["test" "-x" seed_bin]
if (have.ok == false) then say "surface-p50: SKIP -- ${seed_bin} is not built here; the module header names its build line"
if (have.ok == false) then say "GREEN: surface-p50 -- skipped honestly, the binary this witness drives is absent"
if (have.ok == false) then exit 0

say "surface-p50: headless brushtest..."
let brushtest = run ["sh" "-c" "${seed_bin} brushtest brushstroke/seed-frame.brush 2>&1"]
assert brushtest.ok else "surface-p50: brushtest failed"
assert brushtest.out contains "GREEN" else "surface-p50: brushtest not GREEN"

say "surface-p50: hosted brush present..."
let brush_cmd = run ["sh" "-c" "grep -q 'run_brush_present' brushstroke/wayland_seed.rye && grep -q ', \"brush\")' brushstroke/wayland_seed.rye && echo BRUSH_OK"]
assert brush_cmd.ok else "surface-p50: brush CLI scan failed"
assert brush_cmd.out contains "BRUSH_OK" else "surface-p50: brush CLI not named"
let hosted = run ["sh" "-c" "${seed_bin} brush brushstroke/seed-frame.brush 2>&1"]
assert hosted.ok else "surface-p50: hosted brush failed"
assert hosted.out contains "GREEN: brushstroke wayland seed -- .brush on Wayland" else "surface-p50: hosted brush missing GREEN"

let held = run ["sh" "-c" "grep -q 'live-five still' counsel/date/20260729/20260729-135422_surface-season-p50-hosted-brush-choir.md && echo HELD_OK"]
assert held.ok else "surface-p50: live-five held scan failed"
assert held.out contains "HELD_OK" else "surface-p50: live-five must stay held"

say "GREEN: surface-p50 -- brushtest - hosted brush - seed-frame on Wayland"
say "GREEN: surface-p50 -- live-five held - one present only."
