# tools/gen/chapter/oven_season_o0_witness.rish -- Oven Chapter o0 seat.
#
#   rishi/bin/rishi run tools/gen/chapter/oven_season_o0_witness.rish

say "oven-season-o0: Language EN — pause Surface; open Oven oct."
say "oven-season-o0: Style Radiant — seat the nest; refuse silent path cut."
say "oven-season-o0: Lens TAME — Oven Chapter o0."

let charter = run ["test" "-f" "counsel/date/20260728/20260728-234419_the-oven-season-oct-charter.md"]
assert charter.ok else "oven-season-o0: oct charter missing"
let bow = run ["test" "-f" "counsel/date/20260728/20260728-234419_oven-season-o0-bow-surface-paused.md"]
assert bow.ok else "oven-season-o0: o0 bow missing"
let prompt = run ["test" "-f" "expanding-prompts/date/20260728/20260728-234419_oven-season-o0-recursion-prompt.md"]
assert prompt.ok else "oven-season-o0: recursion printout missing"

let pins = run ["sh" "-c" "grep -q 'PAUSED' counsel/date/20260728/20260728-234419_the-oven-season-oct-charter.md && grep -q 'return_surface_p39' counsel/date/20260728/20260728-234419_the-oven-season-oct-charter.md && grep -q 'o0' counsel/date/20260728/20260728-234419_the-oven-season-oct-charter.md && grep -q 'oct' context/LEXICON.md && grep -q 'The Oven Chapter' context/LEXICON.md && echo O0_OK"]
assert pins.ok else "oven-season-o0: seat pin scan failed"
assert pins.out contains "O0_OK" else "oven-season-o0: oct lexicon or handback not seated"

# The o0 charter seated a chapter over a directory named oven/. The forge module answers to
# ember/ since 20260808 and the bake seat to Kiln since 20260827; the chapter keeps its own name
# as history, so this rung proves the seat's charter stands while its path reads where it went.
let held = run ["sh" "-c" "test -d ember && test ! -d oven && echo EMBER_LIVE"]
assert held.ok else "oven-season-o0: forge directory check failed"
assert held.out contains "EMBER_LIVE" else "oven-season-o0: ember/ lives and oven/ is retired"

# The o0 seat opened this chapter; prin_scope has since carried it to PAUSED at o3, which is the
# scope card doing its job. The rung reads the chapter's presence on the card rather than a phase
# it was always going to leave (REDS %292 -- an unrostered witness pinned to a passing state).
let scope = run ["sh" "-c" "grep -q 'oct:   Oven Chapter' tools/gen/chapter/prin_scope.rish && grep -q 'sept:   Surface Chapter' tools/gen/chapter/prin_scope.rish && echo SCOPE_OK"]
assert scope.ok else "oven-season-o0: prin_scope pin scan failed"
assert scope.out contains "SCOPE_OK" else "oven-season-o0: prin_scope not eight-nest"

say "GREEN: oven-season-o0 -- charter seated - Surface PAUSED - ember/ LIVE - Oven Chapter"
say "GREEN: oven-season-o0 -- o0 charter seated, its forge path proven forward."
