# tools/gen/chapter/tigerbeetle_assert_census_witness.rish -- e19 TB assert census.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_assert_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present (host clone checkpoint).
# Clean-room: counts only - never copies into rye/.

say "tb-assert-census: Language EN — assert · maybe · verify speak in counts."
say "tb-assert-census: Style Radiant — assertion density measured, never assumed."
say "tb-assert-census: Lens TAME — e19 · clean-room study · almanac seat 25."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-assert: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-assert -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_assert_census.sh"]
say census.out
assert census.ok else "tb-assert-census: census failed or thin"
assert census.out contains "CLONE=present" else "tb-assert-census: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-assert-census: want verdict=ok"
assert census.out contains "STYLE=yes" else "tb-assert-census: clone must hold docs/TIGER_STYLE.md"
assert census.out contains "MAYBE_DEF=yes" else "tb-assert-census: want stdx.maybe definition"
assert census.out contains "GUIDE_DENSITY=yes" else "tb-assert-census: want held-guide density line"

let voidish = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_void_census_witness.rish"]
# void census appends seat 24 idempotently; tolerate GREEN
assert voidish.ok else "tb-assert-census: void census elder went RED"
assert voidish.out contains "CLONE=present" else "tb-assert-census: void elder must see clone present"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_assert_census_almanac.sh"]
assert almanac.ok else "tb-assert-census: almanac append failed"
say almanac.out

say "GREEN: tb-assert-census — assert·maybe·verify density ok · void elder GREEN · almanac seat 25"
