# tools/gen/chapter/tigerbeetle_last_stage_census_witness.rish -- e54 The Last Stage.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_last_stage_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-last-stage: Language EN — the last stage keeps trying and stays small."
say "tb-last-stage: Style Radiant — thank goodness, then back to the work."
say "tb-last-stage: Lens TAME — e54 · clean-room study · almanac seat 59."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-last_stage: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-last_stage -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_last_stage_census.sh"]
say census.out
assert census.ok else "tb-last-stage: census failed or thin"
assert census.out contains "CLONE=present" else "tb-last-stage: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-last-stage: want verdict=ok"
assert census.out contains "GUIDE_LAST=yes" else "tb-last-stage: held guide must teach The Last Stage"
assert census.out contains "GUIDE_FUN=yes" else "tb-last-stage: guide must keep trying and have fun"
assert census.out contains "GUIDE_SMALL=yes" else "tb-last-stage: guide must keep the work small"
assert census.out contains "GUIDE_BILBO=yes" else "tb-last-stage: guide must close with Bilbo"
assert census.out contains "TAME_LAST=yes" else "tb-last-stage: TAME must teach The Last Stage"
assert census.out contains "STYLE=yes" else "tb-last-stage: clone docs must teach the law"
assert census.out contains "ELDER_TOOL=yes" else "tb-last-stage: tooling elder must be present"
assert census.out contains "RADIANT=yes" else "tb-last-stage: Grain Radiant Style must be present"

say "GREEN: tb-last-stage — guide·fun·small·bilbo·TAME·style·elder-tool·RADIANT ok"
