# tools/gen/chapter/tigerbeetle_golden_rule_census_witness.rish -- e21 golden rule.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_golden_rule_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence + counts only - never copies into rye/.

say "tb-golden-rule: Language EN — positive space · negative space · maybe."
say "tb-golden-rule: Style Radiant — the boundary is where bugs gather."
say "tb-golden-rule: Lens TAME — e21 · clean-room study · almanac seat 27."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-golden_rule: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-golden_rule -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_golden_rule_census.sh"]
say census.out
assert census.ok else "tb-golden-rule: census failed or thin"
assert census.out contains "CLONE=present" else "tb-golden-rule: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-golden-rule: want verdict=ok"
assert census.out contains "GUIDE_GOLDEN=yes" else "tb-golden-rule: held guide must teach golden rule"
assert census.out contains "TAME_GOLDEN=yes" else "tb-golden-rule: TAME must teach golden rule"
assert census.out contains "MAYBE_COMPLETES=yes" else "tb-golden-rule: maybe must complete the triad"

let elder = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_control_plane_census_witness.rish"]
assert elder.ok else "tb-golden-rule: control-plane elder went RED"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_golden_rule_almanac.sh"]
assert almanac.ok else "tb-golden-rule: almanac append failed"
say almanac.out

say "GREEN: tb-golden-rule — guide·TAME·maybe triad ok · control elder GREEN · almanac seat 27"
