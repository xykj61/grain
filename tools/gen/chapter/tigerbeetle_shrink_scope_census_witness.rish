# tools/gen/chapter/tigerbeetle_shrink_scope_census_witness.rish -- e46 Shrink scope / POCPOU.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_shrink_scope_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-shrink-scope: Language EN — shrink scope; keep check close to use."
say "tb-shrink-scope: Style Radiant — POCPOU stays rare; semantic distance shrinks."
say "tb-shrink-scope: Lens TAME — e46 · clean-room study · almanac seat 52."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-shrink_scope: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-shrink_scope -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_shrink_scope_census.sh"]
say census.out
assert census.ok else "tb-shrink-scope: census failed or thin"
assert census.out contains "CLONE=present" else "tb-shrink-scope: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-shrink-scope: want verdict=ok"
assert census.out contains "GUIDE_SHRINK=yes" else "tb-shrink-scope: held guide must shrink the scope"
assert census.out contains "GUIDE_POCPOU=yes" else "tb-shrink-scope: guide must name POCPOU"
assert census.out contains "TAME_SHRINK=yes" else "tb-shrink-scope: TAME must shrink scope and check close"
assert census.out contains "STYLE=yes" else "tb-shrink-scope: clone docs must teach the law"
assert census.out contains "ELDER_CACHE=yes" else "tb-shrink-scope: cache-inplace elder must be present"
assert census.out contains "RADIANT=yes" else "tb-shrink-scope: Grain Radiant Style must be present"

say "GREEN: tb-shrink-scope — guide·pocpou·TAME·style·elder-cache·RADIANT ok"
