# tools/gen/chapter/oven_handback_surface_p39_witness.rish -- Oven->Surface handback.
#
#   rishi/bin/rishi run tools/gen/chapter/oven_handback_surface_p39_witness.rish

say "oven-handback: Language EN — return Surface p39."
say "oven-handback: Style Radiant — pause Oven; open sept."
say "oven-handback: Lens TAME — handback 20260729.000500."

let hb = run ["test" "-f" "counsel/date/20260729/20260729-000500_oven-handback-return-surface-p39.md"]
assert hb.ok else "oven-handback: handback counsel missing"
let p39 = run ["test" "-f" "counsel/date/20260729/20260729-000500_surface-season-p39-resume-after-oven.md"]
assert p39.ok else "oven-handback: Surface p39 resume missing"

# Surface opened right after this handback and has since progressed and paused again (p58,
# handed into deca) -- a phase it was always going to leave. The rung reads the chapter's
# presence on the card rather than the one status word it wore the day this witness was born
# (REDS %292 -- an unrostered witness pinned to a passing state; see oven_season_o0 for the
# same repair).
let scope = run ["sh" "-c" "grep -q 'sept:   Surface Chapter' tools/gen/chapter/prin_scope.rish && grep -q 'oct:   Oven Chapter — PAUSED' tools/gen/chapter/prin_scope.rish && grep -q 'return_generator_s9' tools/gen/chapter/prin_scope.rish && echo SCOPE_OK"]
assert scope.ok else "oven-handback: prin_scope pin scan failed"
assert scope.out contains "SCOPE_OK" else "oven-handback: sept not present or oct not PAUSED"

# The forge module answers to ember/ since 20260808 (the same rename oven_season_o0 already
# reads); the chapter keeps its own name as history, so this rung proves the forge path stands
# where it went rather than where it was first named (REDS %292).
let path = run ["sh" "-c" "test -d ember && test ! -d oven && echo FORGE_LIVE"]
assert path.ok else "oven-handback: forge directory check failed"
assert path.out contains "FORGE_LIVE" else "oven-handback: ember/ lives and oven/ is retired"

say "GREEN: oven-handback — Surface present p39 · Oven PAUSED · ember/ LIVE"
say "GREEN: oven-handback — return_surface_p39 seated."
