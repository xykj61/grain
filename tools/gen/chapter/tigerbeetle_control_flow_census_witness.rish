# tools/gen/chapter/tigerbeetle_control_flow_census_witness.rish -- e35 control flow.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_control_flow_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-control-flow: Language EN — simple explicit flow; recursion stays out."
say "tb-control-flow: Style Radiant — what should be bounded stays bounded."
say "tb-control-flow: Lens TAME — e35 · clean-room study · almanac seat 41."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-control_flow: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-control_flow -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_control_flow_census.sh"]
say census.out
assert census.ok else "tb-control-flow: census failed or thin"
assert census.out contains "CLONE=present" else "tb-control-flow: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-control-flow: want verdict=ok"
assert census.out contains "GUIDE_FLOW=yes" else "tb-control-flow: held guide must ban recursion"
assert census.out contains "GUIDE_NASA=yes" else "tb-control-flow: guide must cite Power of Ten"
assert census.out contains "TAME_FLOW=yes" else "tb-control-flow: TAME must keep flow simple"
assert census.out contains "SUPPLEMENT_FLOW=yes" else "tb-control-flow: supplement must keep recursion out"
assert census.out contains "STYLE=yes" else "tb-control-flow: clone docs must teach the law"

say "GREEN: tb-control-flow — guide·NASA·limit·TAME·supplement·style ok"
