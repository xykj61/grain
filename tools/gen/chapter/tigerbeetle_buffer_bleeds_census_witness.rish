# tools/gen/chapter/tigerbeetle_buffer_bleeds_census_witness.rish -- e47 Buffer bleeds.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_buffer_bleeds_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-buffer-bleeds: Language EN — buffer bleeds; alloc meets defer."
say "tb-buffer-bleeds: Style Radiant — padding stays zeroed; leaks show."
say "tb-buffer-bleeds: Lens TAME — e47 · clean-room study · almanac seat 53."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-buffer_bleeds: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-buffer_bleeds -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_buffer_bleeds_census.sh"]
say census.out
assert census.ok else "tb-buffer-bleeds: census failed or thin"
assert census.out contains "CLONE=present" else "tb-buffer-bleeds: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-buffer-bleeds: want verdict=ok"
assert census.out contains "GUIDE_BLEED=yes" else "tb-buffer-bleeds: held guide must teach buffer bleeds"
assert census.out contains "GUIDE_GROUP=yes" else "tb-buffer-bleeds: guide must group alloc with defer"
assert census.out contains "TAME_BLEED=yes" else "tb-buffer-bleeds: TAME must teach bleeds and alloc grouping"
assert census.out contains "STYLE=yes" else "tb-buffer-bleeds: clone docs must teach the law"
assert census.out contains "ELDER_SHRINK=yes" else "tb-buffer-bleeds: shrink-scope elder must be present"
assert census.out contains "RADIANT=yes" else "tb-buffer-bleeds: Grain Radiant Style must be present"

say "GREEN: tb-buffer-bleeds — guide·group·TAME·style·elder-shrink·RADIANT ok"
