# tools/gen/chapter/wayland_from_frame_witness.rish -- Surface p48 Wayland-from-Frame.
#
#   rishi/bin/rishi run tools/gen/chapter/wayland_from_frame_witness.rish
#
# Needs WAYLAND_DISPLAY for the pond-frame metalsmoke hop.
# Live-five stays hand -- not claimed here.

say "wayland-from-frame: Language EN -- Frame is the glass; Wayland hosts it."
say "wayland-from-frame: Style Radiant -- prove living hop; refuse invent pad."
say "wayland-from-frame: Lens TAME -- Surface Chapter p50."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-134259_surface-season-p48-wayland-from-frame.md"]
assert counsel.ok else "wayland-from-frame: p48 counsel missing"
let feed = run ["test" "-f" "counsel/date/20260729/20260729-134827_surface-season-p49-brushframe-wayland-feed.md"]
assert feed.ok else "wayland-from-frame: p49 feed counsel missing"
let hosted_doc = run ["test" "-f" "counsel/date/20260729/20260729-135422_surface-season-p50-hosted-brush-choir.md"]
assert hosted_doc.ok else "wayland-from-frame: p50 hosted counsel missing"

let display = run ["sh" "-c" "test x$WAYLAND_DISPLAY != x"]
# AN ABSENT DISPLAY SERVER IS A FACT ABOUT THE HOST, NEVER A DEFECT (REDS %646).
# A headless pier is a correct host, and every ship in this fleet runs on one. The hard
# assert this replaces refused there, which is the same unrostable shape as the unbuilt
# artifact below: a roster row would red the whole fleet, so no row was ever written and
# the red went unheard. The skip is decided here, on the environment.
if (display.ok == false) then say "wayland-from-frame: SKIP -- WAYLAND_DISPLAY is unset here; this witness wants a live Wayland session"
if (display.ok == false) then say "GREEN: wayland-from-frame -- skipped honestly, the display this witness draws on is absent"
if (display.ok == false) then exit 0

say "wayland-from-frame: Glow connector hops..."
let connector = run ["rishi/bin/rishi" "run" "tools/gen/chapter/glow_connector_seam_witness.rish"]
assert connector.ok else "wayland-from-frame: glow-connector failed"
assert connector.out contains "GREEN: glow-connector" else "wayland-from-frame: glow-connector not GREEN"

say "wayland-from-frame: .brush -> BrushFrame -> skate grid..."
let parse_bin = "brushstroke/bin/brush-parse"

# AN UNBUILT OPTIONAL ARTIFACT IS A FACT ABOUT THE CLONE, NEVER A DEFECT (REDS %646).
# Everything under `brushstroke/bin/` is a gitignored build output, so a clone that has
# yet to build it is a correct clone. The hard assert this replaces made the witness
# UNROSTABLE: a roster row would red every machine without the binary, which is why this
# witness was never rostered -- and an unrostered witness runs nowhere, so the assert
# bought a red nobody would ever hear. The skip is decided here, on the artifact; every
# claim below still refuses exactly as hard as it did before.
let have_parse = run ["test" "-x" parse_bin]
if (have_parse.ok == false) then say "wayland-from-frame: SKIP -- ${parse_bin} is not built here; the module header names its build line"
if (have_parse.ok == false) then say "GREEN: wayland-from-frame -- skipped honestly, the binary this witness drives is absent"
if (have_parse.ok == false) then exit 0
let grid = run ["sh" "-c" "${parse_bin} grid brushstroke/seed-frame.brush 2>&1"]
assert grid.ok else "wayland-from-frame: brush-parse grid failed"
assert grid.out contains "GREEN: brush-parse grid" else "wayland-from-frame: brush-parse grid not GREEN"

say "wayland-from-frame: wayland_seed redrawtest..."
let seed_bin = "brushstroke/bin/brushstroke-wayland-seed"
let have_seed = run ["test" "-x" seed_bin]
if (have_seed.ok == false) then say "wayland-from-frame: SKIP -- ${seed_bin} is not built here; the module header names its build line"
if (have_seed.ok == false) then say "GREEN: wayland-from-frame -- skipped honestly, the binary this witness drives is absent"
if (have_seed.ok == false) then exit 0
let redraw = run ["sh" "-c" "${seed_bin} redrawtest 2>&1"]
assert redraw.ok else "wayland-from-frame: redrawtest failed"
assert redraw.out contains "GREEN" else "wayland-from-frame: redrawtest not GREEN"

say "wayland-from-frame: BrushFrame -> Wayland Frame feed (brushtest)..."
let feed_import = run ["sh" "-c" "grep -q 'brush_parse.rye' brushstroke/wayland_seed.rye && grep -q 'lines_from_brush_src' brushstroke/wayland_seed.rye && grep -q 'brushtest' brushstroke/wayland_seed.rye && echo FEED_OK"]
assert feed_import.ok else "wayland-from-frame: feed import scan failed"
assert feed_import.out contains "FEED_OK" else "wayland-from-frame: BrushFrame feed not named in wayland_seed"
let brushtest = run ["sh" "-c" "${seed_bin} brushtest brushstroke/seed-frame.brush 2>&1"]
assert brushtest.ok else "wayland-from-frame: brushtest failed"
assert brushtest.out contains "brush feed witness" else "wayland-from-frame: brushtest missing feed banner"
assert brushtest.out contains "GREEN" else "wayland-from-frame: brushtest not GREEN"

say "wayland-from-frame: hosted brush present (one frame)..."
let hosted = run ["sh" "-c" "${seed_bin} brush brushstroke/seed-frame.brush 2>&1"]
assert hosted.ok else "wayland-from-frame: hosted brush failed"
assert hosted.out contains "GREEN: brushstroke wayland seed -- .brush on Wayland" else "wayland-from-frame: hosted brush not GREEN"

say "wayland-from-frame: pond-frame (metalsmoke hop)..."
let pond = run ["rishi/bin/rishi" "run" "tools/gen/chapter/pond_brushstroke_frame_witness.rish"]
assert pond.ok else "wayland-from-frame: pond-frame failed"
assert pond.out contains "GREEN: pond-frame" else "wayland-from-frame: pond-frame not GREEN"

say "wayland-from-frame: Glow quiet on Wayland C..."
let glow_quiet = run ["sh" "-c" "rg -l 'wayland-client.h' src --glob '*.glow' 2>/dev/null | wc -l"]
assert glow_quiet.ok else "wayland-from-frame: Glow quiet scan failed"
let leak_count = trim glow_quiet.out
assert leak_count == "0" else "wayland-from-frame: Glow src must not speak Wayland C"

let held = run ["sh" "-c" "grep -q 'live-five' counsel/date/20260729/20260729-134259_surface-season-p48-wayland-from-frame.md && grep -q 'held' counsel/date/20260729/20260729-134259_surface-season-p48-wayland-from-frame.md && echo HELD_OK"]
assert held.ok else "wayland-from-frame: live-five held scan failed"
assert held.out contains "HELD_OK" else "wayland-from-frame: live-five must stay held this stamp"

say "GREEN: wayland-from-frame -- connector - brush-grid - redrawtest - brushtest - hosted brush - pond-frame - Surface p50"
say "GREEN: wayland-from-frame -- BrushFrame on Wayland host - live-five held."
