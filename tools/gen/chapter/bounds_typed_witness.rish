# tools/gen/chapter/bounds_typed_witness.rish -- declared bounds carry their type.
#
#   rishi/bin/rishi run tools/gen/chapter/bounds_typed_witness.rish
#
# Voice Chapter v2 - slot 2 - explicit_bounds.
#
# Why this exists: TAME root rule 2 is this tree's most-cited discipline -- every
# allocation, collection, and pipeline names its maximum size -- and the enforced
# table in TAME_GUIDANCE checks authored usize, dated artifacts, unqualified
# assert, opening lines, disjoint copies, parseInt, and error comparison. It has
# never checked a bound. This is the first witness for rule 2.
#
# Advisory ratchet: prints the count, never fails.
#
# The standing population was ONE -- brushstroke/seed.rye, `const max_lines = 8;`
# -- and it was turned to ZERO at 20260729.211500. Counsel first predicted that
# annotating it would break the build, since the bound is compared against a
# usize length; the build was run rather than the claim written, and it compiled
# clean. Prediction refuted by measurement, which is the cheaper order.
#
# The turn was taken rather than parked because the file was already open for
# that test, the change is a type annotation inside Tier 3 living code, and a
# rule's first witness lands cleaner at population zero than carrying a standing
# violation. One word reverses it. The separately parked one-liner --
# mand/tally_copy.rye becoming a symlink -- stays parked, because that one
# changes a file's identity rather than annotating a constant.

say "bounds-typed: Language EN — declared bounds carry their type."
say "bounds-typed: Style Radiant — count the population; turn the ratchet on touch."
say "bounds-typed: Lens TAME — root rule 2, witnessed for the first time."

let scan = run ["sh" "tools/fixtures/b/bounds_typed_scan.sh"]
say scan.out
assert scan.out contains "verdict=ok" else "bounds-typed: a declared bound lacks its type"
# values_apart: the scan's status and its verdict key must agree. If they ever
# disagree, a sentinel was typo'd or a path changed -- exactly the failure the
# old text-only verdict could pass silently.
assert scan.ok else "bounds-typed: the verdict reads ok while the status fails — they must agree"

let mkdir = run ["mkdir" "-p" ".lap/bounds-typed-pen"]
assert mkdir.ok else "bounds-typed: pen mkdir failed"
let write = run ["sh" "-c" "printf 'const max_widget = 5;\n' > .lap/bounds-typed-pen/untyped.rye"]
assert write.ok else "bounds-typed: pen write failed"
let red = run ["sh" "tools/fixtures/b/bounds_typed_scan.sh" ".lap/bounds-typed-pen"]
say red.out
assert (red.ok == false) else "bounds-typed: a planted untyped bound must refuse"
assert red.out contains "verdict=untyped_bounds" else "bounds-typed: prove-red wants the named verdict"
assert red.out contains "untyped-bound .lap/bounds-typed-pen/untyped.rye" else "bounds-typed: prove-red wants the named detail line"

say "bounds-typed: advisory — a declared bound reads `const max_x: u32 = N; // why`"
say "GREEN: bounds-typed — rule 2 has a witness; population zero; a planted untyped bound refuses"
