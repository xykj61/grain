# tools/gen/chapter/pond_brushstroke_frame_witness.rish -- Surface p6 - Pond-framed frame
#
#   rishi/bin/rishi run tools/gen/chapter/pond_brushstroke_frame_witness.rish
#
# Two proofs from values:
#   1) Brushstroke wayland_seed redrawtest -- Frame A->B->A signatures (headless)
#   2) Pond drawn-terminal metalsmoke -- Wayland host hop (needs WAYLAND_DISPLAY)
#
# Live-five (type - idle - ceiling - :quit) stays hand -- not claimed here.

say "pond-frame: Language EN -- Frame from values - Pond metalsmoke."
say "pond-frame: Style Radiant -- reuse seed; refuse invent stack."
say "pond-frame: Lens TAME -- Surface Chapter p6 - hardened p7."

let wayland = run ["sh" "-c" "test x$WAYLAND_DISPLAY != x"]
# AN ABSENT DISPLAY SERVER IS A FACT ABOUT THE HOST, NEVER A DEFECT (REDS %646).
# A headless pier is a correct host, and every ship in this fleet runs on one. The hard
# assert this replaces refused there, which is the same unrostable shape as the unbuilt
# artifact below: a roster row would red the whole fleet, so no row was ever written and
# the red went unheard. The skip is decided here, on the environment.
if (wayland.ok == false) then say "pond-frame: SKIP -- WAYLAND_DISPLAY is unset here; this witness wants a live Wayland session"
if (wayland.ok == false) then say "GREEN: pond-frame -- skipped honestly, the display this witness draws on is absent"
if (wayland.ok == false) then exit 0

let seed_bin = "brushstroke/bin/brushstroke-wayland-seed"

# AN UNBUILT OPTIONAL ARTIFACT IS A FACT ABOUT THE CLONE, NEVER A DEFECT (REDS %646).
# Everything under `brushstroke/bin/` is a gitignored build output, so a clone that has
# yet to build it is a correct clone. The hard assert this replaces made the witness
# UNROSTABLE: a roster row would red every machine without the binary, which is why this
# witness was never rostered -- and an unrostered witness runs nowhere, so the assert
# bought a red nobody would ever hear. The skip is decided here, on the artifact; every
# claim below still refuses exactly as hard as it did before.
let have = run ["test" "-x" seed_bin]
if (have.ok == false) then say "pond-frame: SKIP -- ${seed_bin} is not built here; the module header names its build line"
if (have.ok == false) then say "GREEN: pond-frame -- skipped honestly, the binary this witness drives is absent"
if (have.ok == false) then exit 0

say "pond-frame: Brushstroke redrawtest (Frame from values)..."
let redraw = run ["sh" "-c" "${seed_bin} redrawtest 2>&1"]
assert redraw.ok else "pond-frame: redrawtest failed"
assert redraw.out contains "GREEN" else "pond-frame: redrawtest not GREEN"

say "pond-frame: Pond metalsmoke (Wayland hop)..."
let metal = run ["rishi/bin/rishi" "run" "tools/s/slc2a_ring3_metal.rish"]
assert metal.ok else "pond-frame: metalsmoke failed"
assert metal.out contains "GREEN: SLC-2a Wayland metal smoke" else "pond-frame: metalsmoke missing GREEN"

say "pond-frame: refuse live-five claim - shred - deploy (fold only)"
say "GREEN: pond-frame -- redrawtest - metalsmoke - Surface p6"
say "GREEN: pond-frame -- Frame from values on Pond Wayland hop; live-five still hand."
