# tools/gen/chapter/anvil_path_breach_survey_witness.rish -- Surface p38 survey (historical) - o1 cut done.
#
#   rishi/bin/rishi run tools/gen/chapter/anvil_path_breach_survey_witness.rish

say "anvil-path-survey: Language EN — survey seated; path cut landed o1."
say "anvil-path-survey: Style Radiant — prove the cut; refuse silent rename."
say "anvil-path-survey: Lens TAME — Oven Chapter o1."

let counsel = "counsel/date/20260728/20260728-233638_surface-season-p38-anvil-path-breach-survey.md"
let c = run ["test" "-f" counsel]
assert c.ok else "anvil-path-survey: counsel missing"

# invariant: the o1 cut read forward -- the forge path now lives at ember/ (renamed from oven/ on 20260808), and anvil/ is gone.
let cut = run ["sh" "-c" "test -d ember && test -f ember/ember_core.rye && test ! -d anvil && echo CUT_OK"]
assert cut.ok else "anvil-path-survey: ember/ cut missing or anvil/ still present"
assert cut.out contains "CUT_OK" else "anvil-path-survey: cut not complete"

# invariant: the 14 Skate views follow the path to its current name, inference_ember_corpus*_view.rish.
let views = run ["sh" "-c" "ls tools/i/inference_ember_corpus*_view.rish | wc -l"]
assert views.ok else "anvil-path-survey: view glob failed"
let n = trim views.out
assert n == "14" else "anvil-path-survey: expected 14 inference_ember views"

let gen = run ["test" "-d" "tools/gen/ember"]
assert gen.ok else "anvil-path-survey: tools/gen/ember missing"

say "GREEN: anvil-path-survey — ember/ LIVE · anvil/ gone · 14 Skate views · Oven o1"
say "GREEN: anvil-path-survey — path cut complete."
