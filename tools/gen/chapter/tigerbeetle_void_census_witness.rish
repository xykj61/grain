# tools/gen/chapter/tigerbeetle_void_census_witness.rish -- e18 TB src void census.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_void_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present (host clone checkpoint).
# Clean-room: counts only - never copies into rye/.

say "tb-void-census: Language EN — the held clone speaks in counts."
say "tb-void-census: Style Radiant — void density measured, never assumed."
say "tb-void-census: Lens TAME — e18 · clean-room study · almanac seat 24."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-void: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-void -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_void_census.sh"]
say census.out
assert census.ok else "tb-void-census: census failed or thin"
assert census.out contains "CLONE=present" else "tb-void-census: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-void-census: want verdict=ok"
assert census.out contains "STYLE=yes" else "tb-void-census: clone must hold docs/TIGER_STYLE.md"

let guide = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerstyle_void_return_witness.rish"]
# tigerstyle witness appends seat 23 idempotently; tolerate GREEN
assert guide.ok else "tb-void-census: held-guide witness went RED"
assert guide.out contains "CLONE=present" else "tb-void-census: guide witness must see clone present"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_void_census_almanac.sh"]
assert almanac.ok else "tb-void-census: almanac append failed"
say almanac.out

say "GREEN: tb-void-census — clone present · void density ok · guide still GREEN · almanac seat 24"
