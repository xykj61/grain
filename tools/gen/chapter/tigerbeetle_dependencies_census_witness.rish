# tools/gen/chapter/tigerbeetle_dependencies_census_witness.rish -- e52 Dependencies.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_dependencies_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-dependencies: Language EN — zero dependencies beyond Zig."
say "tb-dependencies: Style Radiant — supply-chain risk stays out of the stack."
say "tb-dependencies: Lens TAME — e52 · clean-room study · almanac seat 57."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-dependencies: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-dependencies -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_dependencies_census.sh"]
say census.out
assert census.ok else "tb-dependencies: census failed or thin"
assert census.out contains "CLONE=present" else "tb-dependencies: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-dependencies: want verdict=ok"
assert census.out contains "GUIDE_DEPS=yes" else "tb-dependencies: held guide must teach Dependencies"
assert census.out contains "GUIDE_ZERO=yes" else "tb-dependencies: guide must teach zero dependencies"
assert census.out contains "GUIDE_ZIG=yes" else "tb-dependencies: guide must name Zig toolchain"
assert census.out contains "GUIDE_SUPPLY=yes" else "tb-dependencies: guide must name supply chain risk"
assert census.out contains "TAME_DEPS=yes" else "tb-dependencies: TAME must teach Dependencies"
assert census.out contains "STYLE=yes" else "tb-dependencies: clone docs must teach the law"
assert census.out contains "ELDER_STYLE=yes" else "tb-dependencies: style-numbers elder must be present"
assert census.out contains "RADIANT=yes" else "tb-dependencies: Grain Radiant Style must be present"

say "GREEN: tb-dependencies — guide·zero·zig·supply·TAME·style·elder-style·RADIANT ok"
