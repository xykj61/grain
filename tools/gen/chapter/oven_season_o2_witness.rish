# tools/gen/chapter/oven_season_o2_witness.rish -- Oven Chapter o2 residual tidy.
#
#   rishi/bin/rishi run tools/gen/chapter/oven_season_o2_witness.rish

say "oven-season-o2: Language EN — tidy living orientation after the cut."
say "oven-season-o2: Style Radiant — re-point doors; refuse fossil rewrite."
say "oven-season-o2: Lens TAME — Oven Chapter o2."

let counsel = run ["test" "-f" "counsel/date/20260728/20260728-235951_oven-season-o2-residual-tidy.md"]
assert counsel.ok else "oven-season-o2: o2 counsel missing"

let stewards = run ["sh" "-c" "grep -q 'oven/' STEWARDS.md && ! grep -q '\`anvil/\`' STEWARDS.md && echo STEWARDS_OK"]
assert stewards.ok else "oven-season-o2: STEWARDS faculty row scan failed"
assert stewards.out contains "STEWARDS_OK" else "oven-season-o2: STEWARDS still names anvil/ faculty"

let homes = run ["sh" "-c" "grep -q 'amphora/ · oven/' expanding-prompts/date/20260728/20260728-193914_surface-season-p0-recursion-prompt.md && grep -q 'amphora/ · oven/' expanding-prompts/date/20260728/20260728-233053_surface-season-p37-recursion-prompt.md && echo HOMES_OK"]
assert homes.ok else "oven-season-o2: Surface homes scan failed"
assert homes.out contains "HOMES_OK" else "oven-season-o2: Surface recursion homes not oven/"

let hammock = run ["sh" "-c" "grep -q 'oven/README.md' active-designing/yonder/date/20260710/20260710-225320_anvil-corpus-lap2-hammock.md && echo HAMMOCK_OK"]
assert hammock.ok else "oven-season-o2: hammock link scan failed"
assert hammock.out contains "HAMMOCK_OK" else "oven-season-o2: yonder hammock still points at anvil/"

let path = run ["sh" "-c" "test -d oven && test ! -d anvil && echo PATH_OK"]
assert path.ok else "oven-season-o2: path state broken"
assert path.out contains "PATH_OK" else "oven-season-o2: oven/ LIVE expected"

say "GREEN: oven-season-o2 — STEWARDS · homes · hammock · path · Oven Chapter"
say "GREEN: oven-season-o2 — residual tidy seated."
