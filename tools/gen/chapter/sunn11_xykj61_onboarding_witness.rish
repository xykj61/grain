# tools/gen/chapter/sunn11_xykj61_onboarding_witness.rish -- SUNN11 xykj61 onboarding.
#
#   rishi/bin/rishi run tools/gen/chapter/sunn11_xykj61_onboarding_witness.rish
#
# APPLY.md is root-ignored (pier-local CREATE packs) -- never assert it here.

say "sunn11: Language EN — living onboarding clones name xykj61."
say "sunn11: Style Radiant — beginner xykj61 · origin lane groupproject405 kept."
say "sunn11: Lens TAME — SUNN11 · clone lock · xy living push · roster truth."

let s = read-file "SOURCE.md"
# THE ASSERTION FOLLOWS THE LAW IT GUARDS (`20260908.183744`, Keaton's grant). SOURCE teaches the
# PUBLIC clone now -- `grain-os/grain` -- because `7191a938b` made one README serve both
# repositories and the onboarding path followed it. The elder line named the private remote, which
# a newcomer cannot reach. Nothing ran this witness, so it stood red instead of saying so (`20260908.183635`).
assert s contains "git clone https://github.com/grain-os/grain.git ~/grain" else "sunn11: SOURCE want the public grain-os clone line"
assert s contains "Living push is `xy` alone" else "sunn11: SOURCE want xy as the living push"
assert (s contains "dual-push") == false else "sunn11: SOURCE still names dual-push"
assert s contains "REMOTE_ROSTER" else "sunn11: SOURCE want REMOTE_ROSTER cite"
assert (s contains "git clone https://github.com/groupproject405/grain") == false else "sunn11: SOURCE must not clone groupproject405"
# Door stamp may leave SOURCE Status as later doors accrete; metal above stays.

let r = read-file "README.md"
assert r contains "SOURCE.md" else "sunn11: README want the SOURCE onboarding door"
# The front door routes a newcomer to the first-hour tutorial now rather than carrying a "beginner
# clone" phrase of its own, so the assertion asks what actually matters: that the door still names a
# real place to start. A guard pinned to one wording fails on a rewrite that improved the page.
assert r contains "docs-geode/tutorials/the-first-hour.md" else "sunn11: README want the first-hour door for a newcomer"

let c = read-file "CLAUDE.md"
assert c contains "xykj61/grain" else "sunn11: CLAUDE want xykj61/grain"

let w = read-file "manual/guides/apprentice-welcome.md"
assert w contains "https://github.com/xykj61/grain.git" else "sunn11: apprentice-welcome want xykj61 clone"

let e = read-file "context/specs/enclosure-editors.md"
assert e contains "https://github.com/xykj61/grain.git" else "sunn11: enclosure want xykj61 clone"

let p = read-file "tools/gen/chapter/personalize.template.brix"
assert p contains "source_pier_clone https://github.com/xykj61/grain.git" else "sunn11: personalize want xykj61 clone"
assert p contains "source_pier_agent_lane groupproject405" else "sunn11: personalize want agent lane kept"

let f = read-file "manual/guides/first-season-personalize.md"
assert f contains "xykj61/grain" else "sunn11: first-season-personalize want xykj61/grain"

let roster = read-file "context/REMOTE_ROSTER.md"
# `gp405` retired from living push `20261001`. The row stays findable by the same
# forge spelling, now in the retired table.
assert roster contains "`gp405` | GitHub `groupproject405/grain`" else "sunn11: roster want the retired gp405 row"
# Same rename: `xykj61` -> `xy`, the anointed ordering remote whose name is the spelling this tree
# actually types.
assert roster contains "`xy` | GitHub `xykj61/grain`" else "sunn11: roster want xykj61 remote"

say "GREEN: sunn11 — living onboarding clones xykj61 · xy is the living push · gp405 retired"
