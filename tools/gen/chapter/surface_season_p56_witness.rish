# tools/gen/chapter/surface_season_p56_witness.rish -- live-five idle pong.
#
#   rishi/bin/rishi run tools/gen/chapter/surface_season_p56_witness.rish
#
# Needs WAYLAND_DISPLAY for idletest. Dated counsel keeps ceiling hand at p56.

say "surface-p56: Language EN -- live-five idle pong opens."
say "surface-p56: Style Radiant -- hosted idletest; dated counsel keeps ceiling hand."
say "surface-p56: Lens TAME -- Surface Chapter p56."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-162549_surface-season-p56-live-five-idle.md"]
assert counsel.ok else "surface-p56: p56 counsel missing"

let metal = run ["sh" "-c" "grep -q 'fn run_idle_witness' brushstroke/wayland_seed.rye && grep -q 'ping_count' brushstroke/wayland_seed.rye && grep -q 'idletest' brushstroke/wayland_seed.rye && echo METAL_OK"]
assert metal.ok else "surface-p56: idle metal scan failed"
assert metal.out contains "METAL_OK" else "surface-p56: idle metal missing"

let seed_bin = "brushstroke/bin/brushstroke-wayland-seed"

# AN UNBUILT OPTIONAL ARTIFACT IS A FACT ABOUT THE CLONE, NEVER A DEFECT (REDS %646).
# Everything under `brushstroke/bin/` is a gitignored build output, so a clone that has
# yet to build it is a correct clone. The hard assert this replaces made the witness
# UNROSTABLE: a roster row would red every machine without the binary, which is why this
# witness was never rostered -- and an unrostered witness runs nowhere, so the assert
# bought a red nobody would ever hear. The skip is decided here, on the artifact; every
# claim below still refuses exactly as hard as it did before.
let have = run ["test" "-x" seed_bin]
if (have.ok == false) then say "surface-p56: SKIP -- ${seed_bin} is not built here; the module header names its build line"
if (have.ok == false) then say "GREEN: surface-p56 -- skipped honestly, the binary this witness drives is absent"
if (have.ok == false) then exit 0

let display = run ["sh" "-c" "test x$WAYLAND_DISPLAY != x && echo DISPLAY_OK"]
# THE SAME HOST FACT, ONE CLAIM LOWER (REDS %646). This witness reads the display twice;
# both readings refuse on a headless pier, and both are swept for the one reason.
if (display.ok == false) then say "surface-p56: SKIP -- WAYLAND_DISPLAY is unset here; idletest wants a live Wayland session"
if (display.ok == false) then say "GREEN: surface-p56 -- skipped honestly, the display idletest draws on is absent"
if (display.ok == false) then exit 0
assert display.out contains "DISPLAY_OK" else "surface-p56: WAYLAND_DISPLAY empty"

let livetest = run ["sh" "-c" "${seed_bin} livetest 2>&1"]
assert livetest.ok else "surface-p56: livetest failed"
assert livetest.out contains "GREEN" else "surface-p56: livetest not GREEN"

let idletest = run ["sh" "-c" "${seed_bin} idletest 2>&1"]
assert idletest.ok else "surface-p56: idletest failed"
assert idletest.out contains "live-five idle witness" else "surface-p56: idle banner missing"
assert idletest.out contains "pongs=" else "surface-p56: pong count missing"
assert idletest.out contains "GREEN" else "surface-p56: idletest not GREEN"

let hand = run ["sh" "-c" "grep -qF 'ceiling still **hand**' counsel/date/20260729/20260729-162549_surface-season-p56-live-five-idle.md && grep -qF 'No ceiling invent' counsel/date/20260729/20260729-162549_surface-season-p56-live-five-idle.md && echo HAND_OK"]
assert hand.ok else "surface-p56: ceiling hand seat scan failed"
assert hand.out contains "HAND_OK" else "surface-p56: dated p56 counsel must keep ceiling hand"

say "GREEN: surface-p56 -- idletest pong - livetest still GREEN"
say "GREEN: surface-p56 -- dated counsel keeps ceiling hand at p56."
