# tools/gen/chapter/tigerbeetle_be_explicit_census_witness.rish -- e39 be explicit.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_be_explicit_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-be-explicit: Language EN — be explicit; hot loops stand alone."
say "tb-be-explicit: Style Radiant — lean lightly on the compiler."
say "tb-be-explicit: Lens TAME — e39 · clean-room study · almanac seat 45."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-be_explicit: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-be_explicit -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_be_explicit_census.sh"]
say census.out
assert census.ok else "tb-be-explicit: census failed or thin"
assert census.out contains "CLONE=present" else "tb-be-explicit: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-be-explicit: want verdict=ok"
assert census.out contains "GUIDE_EXPLICIT=yes" else "tb-be-explicit: held guide must say Be explicit"
assert census.out contains "GUIDE_HOTLOOP=yes" else "tb-be-explicit: guide must extract hot loops"
assert census.out contains "TAME_EXPLICIT=yes" else "tb-be-explicit: TAME must lean lightly on the compiler"
assert census.out contains "STYLE=yes" else "tb-be-explicit: clone docs must teach the law"
assert census.out contains "COMPACTION=yes" else "tb-be-explicit: clone compaction path must be present"

say "GREEN: tb-be-explicit — guide·hotloop·TAME·style·compaction ok"
