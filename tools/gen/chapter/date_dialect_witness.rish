# tools/gen/chapter/date_dialect_witness.rish -- standing date-dialect instrument.
#
#   rishi/bin/rishi run tools/gen/chapter/date_dialect_witness.rish
#
# Law: a duty with no witness has no seat, and a duty with no seat never lands.
# Planted C1 proves firing; planted C2 proves discrimination; library one_dialect.
#
# A FLOOR, NOT A PIN (20261002.000949, same lesson the scan's own comment already names at
# REDS %235 one level down). This witness pinned `law_library_dated=17` and `compact=17` --
# the exact snapshot the day it was written. context/*.md gains correctly dated files on its
# own, so the library had grown to 27 by the time this ran: the scan's own `roster=honored`
# and `law_library_floor=17` lines already carry the coverage-never-shrinks property; this
# witness asserts those stable fields rather than the exact counts a growing roster outgrows.

say "date-dialect: Language EN — planted controls before library totals."
say "date-dialect: Style Radiant — carry the transformation; advance no date."
say "date-dialect: Lens TAME — standing instrument · compact Last updated."

let green = run ["sh" "tools/fixtures/d/date_dialect_scan.sh"]
say green.out
assert green.ok else "date-dialect: living scan must exit 0"
assert green.out contains "tracked_controls=honored" else "date-dialect: want tracked controls"
assert green.out contains "OK C1-hyphenated planted hyphen counted" else "date-dialect: want C1"
assert green.out contains "OK C2-compact planted compact not counted" else "date-dialect: want C2"
assert green.out contains "controls_honored=2" else "date-dialect: want 2 of 2"
assert green.out contains "hyphenated=0" else "date-dialect: want hyphenated 0"
assert green.out contains "verdict=one_dialect" else "date-dialect: want one_dialect"
assert green.out contains "roster=honored" else "date-dialect: want roster honored"
assert green.out contains "law_library_floor=17" else "date-dialect: want floor 17"
assert green.out contains "date_dialect=honored" else "date-dialect: want date_dialect honored"
assert green.out contains "date_dialect_scan=ok" else "date-dialect: want scan ok"
assert green.out contains "verdict=ok" else "date-dialect: want verdict=ok"

let red = run ["sh" "tools/fixtures/d/date_dialect_scan.sh" "prove-red"]
say red.out
assert (red.ok == false) else "date-dialect: prove-red must refuse"
assert red.out contains "RED_C2-compact" else "date-dialect: prove-red want C2 refusal"
assert red.out contains "census=withheld" else "date-dialect: prove-red want withheld"

say "GREEN: date-dialect — C1 counted · C2 not · 17 compact · one_dialect · prove-red refuses"
