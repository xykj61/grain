# tools/gen/chapter/surface_season_p49_witness.rish -- BrushFrame Wayland feed.
#
#   rishi/bin/rishi run tools/gen/chapter/surface_season_p49_witness.rish
#
# Headless feed proof (no WAYLAND_DISPLAY required). Rebuild wayland_seed first
# if brushtest is missing -- see counsel p49.

say "surface-p49: Language EN -- BrushFrame feeds Wayland Frame."
say "surface-p49: Style Radiant -- thin import; refuse live-five invent."
say "surface-p49: Lens TAME -- Surface Chapter p49."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-134827_surface-season-p49-brushframe-wayland-feed.md"]
assert counsel.ok else "surface-p49: p49 counsel missing"

let seed_bin = "brushstroke/bin/brushstroke-wayland-seed"

# AN UNBUILT OPTIONAL ARTIFACT IS A FACT ABOUT THE CLONE, NEVER A DEFECT (REDS %646).
# Everything under `brushstroke/bin/` is a gitignored build output, so a clone that has
# yet to build it is a correct clone. The hard assert this replaces made the witness
# UNROSTABLE: a roster row would red every machine without the binary, which is why this
# witness was never rostered -- and an unrostered witness runs nowhere, so the assert
# bought a red nobody would ever hear. The skip is decided here, on the artifact; every
# claim below still refuses exactly as hard as it did before.
let have = run ["test" "-x" seed_bin]
if (have.ok == false) then say "surface-p49: SKIP -- ${seed_bin} is not built here; the module header names its build line"
if (have.ok == false) then say "GREEN: surface-p49 -- skipped honestly, the binary this witness drives is absent"
if (have.ok == false) then exit 0

let named = run ["sh" "-c" "grep -q '@import(\"brush_parse.rye\")' brushstroke/wayland_seed.rye && grep -q 'fn lines_from_brush_src' brushstroke/wayland_seed.rye && grep -q 'run_brush_feed_witness' brushstroke/wayland_seed.rye && echo NAMED_OK"]
assert named.ok else "surface-p49: feed symbols scan failed"
assert named.out contains "NAMED_OK" else "surface-p49: feed symbols missing"

let brushtest = run ["sh" "-c" "${seed_bin} brushtest brushstroke/seed-frame.brush 2>&1"]
assert brushtest.ok else "surface-p49: brushtest failed"
assert brushtest.out contains "at-nib=brushstroke-seed" else "surface-p49: seed-frame nib missing"
assert brushtest.out contains "GREEN" else "surface-p49: brushtest not GREEN"

let held = run ["sh" "-c" "grep -q 'live-five still' counsel/date/20260729/20260729-134827_surface-season-p49-brushframe-wayland-feed.md && echo HELD_OK"]
assert held.ok else "surface-p49: live-five held scan failed"
assert held.out contains "HELD_OK" else "surface-p49: live-five must stay held"

say "GREEN: surface-p49 -- brushtest - BrushFrame->Wayland Frame - seed-frame"
say "GREEN: surface-p49 -- live-five held - Glow still quiet on Wayland C."
