# tools/gen/chapter/tigerbeetle_say_how_census_witness.rish -- e44 Say how.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_say_how_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-say-how: Language EN — say how; name the goal and the method."
say "tb-say-how: Style Radiant — the reader gets up to speed, or skips ahead."
say "tb-say-how: Lens TAME — e44 · clean-room study · almanac seat 50."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-say_how: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-say_how -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_say_how_census.sh"]
say census.out
assert census.ok else "tb-say-how: census failed or thin"
assert census.out contains "CLONE=present" else "tb-say-how: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-say-how: want verdict=ok"
assert census.out contains "GUIDE_HOW=yes" else "tb-say-how: held guide must say how"
assert census.out contains "GUIDE_METHOD=yes" else "tb-say-how: guide must name goal and methodology"
assert census.out contains "TAME_HOW=yes" else "tb-say-how: TAME must say how"
assert census.out contains "STYLE=yes" else "tb-say-how: clone docs must teach the law"
assert census.out contains "ELDER_WHY=yes" else "tb-say-how: say-why elder must be present"
assert census.out contains "RADIANT=yes" else "tb-say-how: Grain Radiant Style must be present"

say "GREEN: tb-say-how — guide·method·TAME·style·elder-why·RADIANT ok"
