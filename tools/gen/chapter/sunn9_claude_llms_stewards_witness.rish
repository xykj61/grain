# tools/gen/chapter/sunn9_claude_llms_stewards_witness.rish -- SUNN9 agent papers.
#
#   rishi/bin/rishi run tools/gen/chapter/sunn9_claude_llms_stewards_witness.rish

say "sunn9: Language EN — agent papers name the living pier."
say "sunn9: Style Radiant — Riyo · Livermore · ~/grain · RIYO.md first."
say "sunn9: Lens TAME -- SUNN - CLAUDE - llms - STEWARDS - Quin faculties stay."

let c = read-file "CLAUDE.md"
assert c contains "You are **Kyri**" else "sunn9: CLAUDE want You are Riyo"
assert c contains ".claude/rules/kyri.md" else "sunn9: CLAUDE want RIYO.md"
assert c contains "Keaton Dunsford" else "sunn9: CLAUDE want Keaton Dunsford"
assert c contains "~/grain" else "sunn9: CLAUDE want ~/grain"
assert c contains "xykj61/grain" else "sunn9: CLAUDE want xykj61/grain"
# THE MARK IS THE WAYMARK AND THE STAMP, never the counted rung (`20260908.183500`, Keaton's word).
# Each face already carried its one-clock stamp beside the number, so the sweep was subtraction and
# this assertion follows it: the ladder NAME must stand on the face, and the rung count retires.
assert c contains "SUNN" else "sunn9: CLAUDE want the SUNN waymark on its face"
assert c contains "fifth OS variant" else "sunn9: CLAUDE want Quin OS hat"
assert c contains "Q-vane" else "sunn9: CLAUDE want Q-vane"
assert (c contains "~/veganreyklah2") == false else "sunn9: CLAUDE must not keep veganreyklah2 path"

let l = read-file "llms.txt"
assert l contains "context/KYRI.md" else "sunn9: llms want RIYO.md"
assert l contains "context/QUIN.md" else "sunn9: llms want QUIN.md"
assert l contains "Grain — model router" else "sunn9: llms want Grain header"
assert l contains "SUNN" else "sunn9: llms want the SUNN waymark on its face"
assert (l contains "veganreyklah2") == false else "sunn9: llms must not keep veganreyklah2 header"

let s = read-file "STEWARDS.md"
assert s contains "Voice:** Kyri" else "sunn9: STEWARDS want Voice Riyo"
assert s contains "SUNN" else "sunn9: STEWARDS want the SUNN waymark on its face"
assert s contains "| **Quin** |" else "sunn9: STEWARDS want Quin faculty steward row"
assert s contains "`ember/`" else "sunn9: STEWARDS want oven faculty"

say "GREEN: sunn9 — CLAUDE · llms · STEWARDS living face · Quin faculties held"
