# tools/gen/chapter/tigerbeetle_batching_census_witness.rish -- e38 amortize by batching.
#
#   rishi/bin/rishi run tools/gen/chapter/tigerbeetle_batching_census_witness.rish
#
# Requires gratitude/tigerbeetle submodule present.
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "tb-batching: Language EN — amortize by batching; the CPU sprints."
say "tb-batching: Style Radiant — large enough chunks; costs share one bound."
say "tb-batching: Lens TAME — e38 · clean-room study · almanac seat 44."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# `gratitude/tigerbeetle` is a submodule this tree STUDIES and never links, so a clone that has not
# initialised it is a correct clone. The hard assert this replaces made the witness UNROSTABLE: a
# row would red the fleet on every machine without the checkout, which is why it was never rostered
# -- and an unrostered witness runs nowhere, so the assert bought a red nobody would ever hear.
#
# The census script already answers in three ways: exit 2 `absent`, exit 1 `thin`, exit 0 `ok`.
# Only `thin` is a defect. Reading `census.ok` cannot tell 1 from 2, so the SKIP is decided here on
# the clone and the failure is asserted below as a negative on `thin`.
let clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (clone.ok == false) then say "tb-batching: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here; run git submodule update --init gratitude/tigerbeetle to read this census"
if (clone.ok == false) then say "GREEN: tb-batching -- skipped honestly, the clone this census reads is absent"
if (clone.ok == false) then exit 0

let census = run ["sh" "tools/fixtures/t/tigerbeetle_batching_census.sh"]
say census.out
assert census.ok else "tb-batching: census failed or thin"
assert census.out contains "CLONE=present" else "tb-batching: want CLONE=present"
assert census.out contains "verdict=ok" else "tb-batching: want verdict=ok"
assert census.out contains "GUIDE_BATCH=yes" else "tb-batching: held guide must amortize by batching"
assert census.out contains "GUIDE_SPRINTER=yes" else "tb-batching: guide must name the CPU sprinter"
assert census.out contains "TAME_BATCH=yes" else "tb-batching: TAME must amortize by batching"
assert census.out contains "TAME_SPRINTER=yes" else "tb-batching: TAME must name the CPU sprinter"
assert census.out contains "STYLE=yes" else "tb-batching: clone docs must teach the law"
assert census.out contains "GRAIN_BATCH=yes" else "tb-batching: Grain resin_batch bounds must be present"

say "GREEN: tb-batching — guide·sprinter·TAME·style·grain-batch ok"
