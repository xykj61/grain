# tools/gen/chapter/prin_scope.rish — %prin scope · living season slate
#
#   rishi/bin/rishi run tools/gen/chapter/prin_scope.rish
#   rishi/bin/rishi run tools/prin.rish scope
#   prin scope
#
# Agents edit THIS file for waymark / seat / charter lines.
# Old tools/prin_scope.rish is an accrete shim (Generator Chapter s4).

say "prin-scope: Language EN — eight-nest season slate."
say "prin-scope: Style Radiant — print orientation; refuse shred/deploy."
say "prin-scope: Lens TAME — living pin; tools/gen/chapter home (s4+)."

let g = run ["git" "rev-parse" "--short=10" "HEAD"]
assert g.ok else "prin_scope: git rev-parse failed"
let nib = trim g.out
assert nib != "" else "prin_scope: empty nib"

say "Prin scope — seasons · Tally · rish vocabulary"
say "  nib:    ${nib}"
say "  scope:  named bound of work (season · Tally garden · Prin/rish view)"
say "  outer:  Constellation Chapter — PAUSED at m8 complete / m9 next"
say "  inner:  Inner Scope Chapter — PAUSED at i6 complete / i7 next (fascia)"
say "  innermost: MUR Chapter — PAUSED at u91 complete / u92 next (fascia prune · shred RED)"
say "  core:   Gren Chapter — CLOSED · handed back · lean-16 complete"
say "  fund_triad: Murr · Gren · Siya (living)"
say "  quint:  Keeh Chapter — CLOSED · handed back"
say "  sext:   Generator Chapter — PAUSED at s8 complete / s9 next"
say "  sept:   Surface Chapter — PAUSED at p38 complete / p39 next (path survey)"
say "  oct:   Kiln Chapter — OPEN · o3 complete / o4 next (queue empty)"
say "  extend_or_return: return_surface_p39 (Kiln lean · seated 20260728.234419)"
say "  surface_handback: return_generator_s9 (when sept resumes)"
say "  generator_handback: return_mur_u92 (when sext resumes)"
say "  keeh_sponsor: Kia (South Korea) honor · design seat"
say "  keeh_recommend: used 4-cyl hatch/SUV · non-CVT auto · light grey/beige cloth · CL/FB Marketplace"
say "  shyu_sponsor: Hyundai (South Korea) honor · design seat"
say "  shyu_recommend: used 4-cyl hatch/SUV · non-CVT auto · light grey/beige cloth · CL/FB Marketplace (same as Keeh)"
say "  geode:  Geode Chapter — PREP · d0 next (docs-geode · crush=compile · wave=year)"
say "  os_horizon: Genode · seL4 · SixOS · s6 · Nix — PARK (proven-seat parallel)"
say "  year:   collection of seasons · all scopes (≠ civil calendar)"
say "  wave:   fascial synonym of year"
say "  crush:  compile (MUR · Tally · weave → docs-geode)"
