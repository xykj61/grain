say "  fund7:  Shyu · Libra · dedication Wayne Hsiung · sponsor Hyundai · shyu_fund=prep"
say "  fund10: Linn · Capricorn · earth · dedication Helen Atthowe · linn_fund=prep"
say "  fund11: Keeh (was Ketu) · Aquarius · seat 11 · executive Keaton · Kia sponsor"
say "  sundial: prin sundial · tools/gen/chapter/sundial.rish — recursion confidence 0–100"
say "  L1:     MUR (was MALA) · WOV unify · retire WOV roadmap last"
