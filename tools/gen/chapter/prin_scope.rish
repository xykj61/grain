# Agents edit THIS file for waymark / seat / charter lines.
# Old tools/prin_scope.rish is an accrete shim (Generator Chapter s4).

say "prin-scope: Language EN — twelve-nest season slate."
say "prin-scope: Style Radiant — print orientation; refuse shred/deploy."
say "prin-scope: Lens TAME — living pin; nest accuracy 20260730.102700 (undeca · door 12 CHARTERED)."

let g = run ["git" "rev-parse" "--short=10" "HEAD"]
assert g.ok else "prin_scope: git rev-parse failed"
let nib = trim g.out
assert nib != "" else "prin_scope: empty nib"

