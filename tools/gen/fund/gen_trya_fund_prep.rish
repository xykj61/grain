# tools/gen/fund/gen_trya_fund_prep.rish -- Trya fund prep grow (Virgo - earth - seat 6).
#
# Affirms seat, Ariana Grande honor dedication, Trya voice file, opening page.
# Refuses deploy / wallet / gas / shred by name.
#   rishi/bin/rishi run tools/gen/fund/gen_trya_fund_prep.rish
#   rishi/bin/rishi run tools/gen/fund/gen_trya_fund_prep.rish deploy  # RED

say "gen-trya: Language EN — Trya fund prep grow (Virgo earth · seat 6)."
say "gen-trya: Style Radiant — GREEN after seat, dedication, and opening page witness."
say "gen-trya: Lens TAME — prep only; no wallet, gas, domain claim, or live deploy."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_trya_fund_prep.sh" verb]
assert prep.ok else "gen-trya REFUSE or seat door failed — see stderr"
assert prep.out contains "GREEN: gen-trya" else "gen-trya missing GREEN line"
assert prep.out contains "sign_index=5" else "gen-trya Virgo seat index unnamed"
assert prep.out contains "witness:trya-open GREEN" else "gen-trya opening witness missing"
assert prep.out contains "dedication: Ariana Grande" else "gen-trya dedication unnamed"
assert prep.out contains "trya_fund=prep" else "gen-trya prep flag missing"
say prep.out

let refuse = run ["sh" "tools/fixtures/gen_trya_fund_prep.sh" "deploy"]
assert (refuse.ok == false) else "gen-trya refuse-walk broken: deploy must exit RED"

say "GREEN: gen-trya — prep grow open; Ariana dedication seated; deploy refuse post-fold RED."
