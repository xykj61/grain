# tools/gen/fund/gen_shyu_fund_prep.rish -- Shyu fund prep (Libra - Wayne - Hyundai).
#
# Affirms Shyu seat, Wayne dedication, Hyundai sponsor, used-mobility lean.
#   rishi/bin/rishi run tools/gen/fund/gen_shyu_fund_prep.rish
#   rishi/bin/rishi run tools/gen/fund/gen_shyu_fund_prep.rish deploy  # RED

say "gen-shyu: Language EN — Shyu fund prep (Libra air · seat 7 · Wayne · Hyundai)."
say "gen-shyu: Style Radiant — GREEN after seat, dedication, sponsor, and lean witness."
say "gen-shyu: Lens TAME — prep only; design sponsor is not a paid buy."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_shyu_fund_prep.sh" verb]
assert prep.ok else "gen-shyu REFUSE or seat door failed — see stderr"
assert prep.out contains "GREEN: gen-shyu" else "gen-shyu missing GREEN line"
assert prep.out contains "sign_index=6" else "gen-shyu Libra seat index unnamed"
assert prep.out contains "witness:shyu-open GREEN" else "gen-shyu opening witness missing"
assert prep.out contains "dedication: Wayne Hsiung" else "gen-shyu dedication unnamed"
assert prep.out contains "sponsor: Hyundai" else "gen-shyu Hyundai sponsor unnamed"
assert prep.out contains "recommend: used 4-cyl" else "gen-shyu used-mobility lean unnamed"
assert prep.out contains "shyu_fund=prep" else "gen-shyu prep flag missing"
say prep.out

let refuse = run ["sh" "tools/fixtures/gen_shyu_fund_prep.sh" "deploy"]
assert (refuse.ok == false) else "gen-shyu refuse-walk broken: deploy must exit RED"

say "GREEN: gen-shyu — prep open; Wayne dedication · Hyundai sponsor · used lean; deploy refuse post-fold RED."
