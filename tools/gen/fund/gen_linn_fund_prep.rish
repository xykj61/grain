# tools/gen/fund/gen_linn_fund_prep.rish -- historical shim -> Bozo (Linn retired 20260730.150702).
#
# Keeps the Linn entry door GREEN by affirming the retired-name Lexicon row
# and forwarding the living prep witness to gen_bozo.
#   rishi/bin/rishi run tools/gen/fund/gen_linn_fund_prep.rish

say "gen-linn: Language EN — Linn is the retired name of Bozo (Capricorn 10)."
say "gen-linn: Style Radiant — forward to gen-bozo; Helen dedication kept."
say "gen-linn: Lens TAME — rename-forward · no second Capricorn seat."

let lex = read-file "context/LEXICON.md"
assert lex contains "Linn (fund) (retired name)" else "gen-linn: want Linn retired-name Lexicon row"
assert lex contains "Bozo (fund)" else "gen-linn: want living Bozo (fund)"

if length args == 0 then let prep = run ["rishi/bin/rishi" "run" "tools/gen/fund/gen_bozo_fund_prep.rish"]
if length args != 0 then let prep = run ["rishi/bin/rishi" "run" "tools/gen/fund/gen_bozo_fund_prep.rish" args[0]]
assert prep.ok else "gen-linn forward to gen-bozo failed"
if prep.out != "" then say prep.out

say "GREEN: gen-linn — retired name affirmed; living prep is gen-bozo."
