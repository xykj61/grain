# tools/gen/fund/gen_gren_fund_prep.rish -- Constellation m5-m8 - Gren (was Djin - was Twah): Gren fund prep generator.
#
# Affirms Taurus earth seat, edu steps 1-6 witnessed (refuse-walk closes arc),
# post-fold proves deploy exits RED, refuses forbidden verbs by name.
#   rishi/bin/rishi run tools/gen/fund/gen_gren_fund_prep.rish
#   rishi/bin/rishi run tools/gen/fund/gen_gren_fund_prep.rish deploy  # RED

say "gen-gren: Language EN — Gren fund prep (Taurus earth · edu gift · steps 1–6 close)."
say "gen-gren: Style Radiant — GREEN only after steps 1–6 witness and deploy refuse."
say "gen-gren: Lens TAME — prep only; no wallet, gas, domain claim, or live deploy."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_gren_fund_prep.sh" verb]
assert prep.ok else "gen-gren REFUSE or stack door failed — see stderr for deploy/wallet/gas/claim-domain refusals"
assert prep.out contains "GREEN: gen-gren" else "gen-gren prep helper missing GREEN line"
assert prep.out contains "sign_index=1" else "gen-gren Taurus seat index unnamed"
assert prep.out contains "witness:step1 GREEN" else "gen-gren step1 witness missing"
assert prep.out contains "witness:step2 GREEN" else "gen-gren step2 witness missing"
assert prep.out contains "witness:step3 GREEN" else "gen-gren step3 witness missing"
assert prep.out contains "witness:step4 GREEN" else "gen-gren step4 witness missing"
assert prep.out contains "witness:step5 GREEN" else "gen-gren step5 witness missing"
assert prep.out contains "witness:step6 GREEN" else "gen-gren step6 witness missing"
assert prep.out contains "Gren m5–m8 CLOSED" else "gen-gren Gren arc close line missing"
say prep.out

# m8 -- refuse-walk post-fold: deploy must fail
let refuse = run ["sh" "tools/fixtures/gen_gren_fund_prep.sh" "deploy"]
assert (refuse.ok == false) else "gen-gren refuse-walk broken: deploy must exit RED"

say "GREEN: gen-gren m8 — Gren arc closed; steps 1–6 witnessed; deploy refuse post-fold RED."
