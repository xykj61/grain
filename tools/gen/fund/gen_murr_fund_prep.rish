# tools/gen/fund/gen_murr_fund_prep.rish -- Murr / MUR fund prep (Aries - was Mala / MALA).
#
# Affirms Murr seat, Kyler Murray honor, MUR L1 lean, innermost season charter.
# Refuses deploy / shred / breach by name. Mass rename is u-round work.
#   rishi/bin/rishi run tools/gen/fund/gen_murr_fund_prep.rish
#   rishi/bin/rishi run tools/gen/fund/gen_murr_fund_prep.rish deploy  # RED

say "gen-murr: Language EN — Murr fund prep (Aries fire · MUR L1 · was Mala/MALA)."
say "gen-murr: Style Radiant — GREEN after seat, dedication, and season spine witness."
say "gen-murr: Lens TAME — prep only; massive overwrite walks in u-rounds with witnesses."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_murr_fund_prep.sh" verb]
assert prep.ok else "gen-murr REFUSE or seat door failed — see stderr"
assert prep.out contains "GREEN: gen-murr" else "gen-murr missing GREEN line"
assert prep.out contains "sign_index=0" else "gen-murr Aries seat index unnamed"
assert prep.out contains "witness:murr-open GREEN" else "gen-murr opening witness missing"
assert prep.out contains "dedication: Kyler Murray" else "gen-murr dedication unnamed"
assert prep.out contains "executive: Keaton Sealy Livermore" else "gen-murr Keaton executive unnamed"
assert prep.out contains "murr_fund=prep" else "gen-murr prep flag missing"
assert prep.out contains "retire WOV roadmap last" else "gen-murr WOV-last lean missing"
say prep.out

let refuse = run ["sh" "tools/fixtures/gen_murr_fund_prep.sh" "deploy"]
assert (refuse.ok == false) else "gen-murr refuse-walk broken: deploy must exit RED"

say "GREEN: gen-murr — prep open; Kyler dedication seated; deploy refuse post-fold RED."
