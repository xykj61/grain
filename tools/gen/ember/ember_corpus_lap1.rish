# tools/gen/ember/ember_corpus_lap1.rish -- Ember corpus lap 0 catalog witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gen/ember/ember_corpus_lap1.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "ember/bin/ember"

let build = run ["sh" "-c" "mkdir -p ember/bin && env RYE_ZIG=${zig} rye/bin/rye build ember/ember.rye -femit-bin=${bin}"]
assert build.ok else "Ember corpus lap 0 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Oven selftest exited non-zero"
assert selftest.out contains "GREEN" else "Oven selftest not GREEN"
assert selftest.out contains "corpus catalog" else "Oven missing catalog welcome"
assert selftest.out contains "incomplete chunk refused" else "Oven missing chunk unwelcome"

say "GREEN: Ember corpus lap 0 — rye/rish chunk catalog from our tree."
