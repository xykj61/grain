# tools/gen/kiln/oven_corpus_lap4.rish — Kiln corpus lap 2 path_suffix filter witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gen/kiln/oven_corpus_lap4.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "kiln/bin/kiln"

let build = run ["sh" "-c" "mkdir -p kiln/bin && env RYE_ZIG=${zig} rye/bin/rye build kiln/kiln.rye -femit-bin=${bin}"]
assert build.ok else "Kiln corpus lap 4 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Kiln selftest exited non-zero"
assert selftest.out contains "GREEN" else "Kiln selftest not GREEN"
assert selftest.out contains "path_suffix filter" else "Kiln missing path_suffix welcome"

say "GREEN: Kiln corpus lap 4 — path_suffix filter on corpus query."
