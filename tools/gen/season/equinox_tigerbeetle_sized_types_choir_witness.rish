# tools/gen/season/equinox_tigerbeetle_sized_types_choir_witness.rish -- e37 -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_sized_types_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-sized-types-choir: Language EN — exact widths; refuse an absent clone."
say "equinox-tb-sized-types-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-sized-types-choir: Lens TAME — e37 · sized types · almanac seat 43."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_sized_types_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-sized-types-choir: welcome RED"
assert welcome.out contains "GREEN: tb-sized-types" else "equinox-tb-sized-types-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_SIZED=yes" else "equinox-tb-sized-types-choir: want GUIDE_SIZED"
assert welcome.out contains "TAME_SIZED=yes" else "equinox-tb-sized-types-choir: want TAME_SIZED"
assert welcome.out contains "WIDTH_CHECK=yes" else "equinox-tb-sized-types-choir: want WIDTH_CHECK"

let refuse = run ["sh" "tools/fixtures/tigerbeetle_sized_types_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-sized-types-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-sized-types-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-sized-types-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_sized_types_almanac.sh"]
assert almanac.ok else "equinox-tb-sized-types-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-sized-types-choir — exact widths · usize at seam · absent refuses · almanac seat 43"
