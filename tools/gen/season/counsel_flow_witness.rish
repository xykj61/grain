# tools/gen/season/counsel_flow_witness.rish -- the communication contract holds.
#
#   rishi/bin/rishi run tools/gen/season/counsel_flow_witness.rish
#
# Voice Season v5 - slot 5 - accretion_one_clock.
#
# Keaton asked for the flow of the last several rounds to be schemed up in Brix.
# tools/gen/season/counsel_flow.brix is that descriptor: voice, register, Acme
# Audience, length ceilings, prose law, helpfulness law, attention law, and the
# waymark fields -- all measured from rounds that actually happened rather than
# invented. This witness proves the descriptor is lawful Brix and carries the
# keys without which the contract says nothing.

say "counsel-flow: Language EN — the communication contract, as data."
say "counsel-flow: Style Radiant — a descriptor describes; it never commands."
say "counsel-flow: Lens TAME — declarative only, required keys named up front."

let scan = run ["sh" "tools/fixtures/counsel_flow_scan.sh"]
say scan.out
assert scan.out contains "verdict=ok" else "counsel-flow: descriptor is not lawful Brix"
assert scan.ok else "counsel-flow: the verdict reads ok while the status fails — they must agree"

say "GREEN: counsel-flow — the contract is lawful, readable by splitLines and one split"
