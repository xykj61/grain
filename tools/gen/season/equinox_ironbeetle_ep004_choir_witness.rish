# tools/gen/season/equinox_ironbeetle_ep004_choir_witness.rish -- e62 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep004_choir_witness.rish

say "equinox-iron-ep004-choir: Language EN — IronBeetle ep004 refuses the shard."
say "equinox-iron-ep004-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep004-choir: Lens TAME — e62 · ep004 · almanac seat 67 · ch5 3/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep004_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep004-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep004" else "equinox-iron-ep004-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep004-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep004-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep004-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep004_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep004-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep004-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep004-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep004_almanac.sh"]
assert almanac.ok else "equinox-iron-ep004-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep004-choir — ep004 · clean room · absent refuses · almanac seat 67 · ch5 3/16"
