# tools/gen/season/equinox_ironbeetle_ep012_choir_witness.rish -- e69 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep012_choir_witness.rish

say "equinox-iron-ep012-choir: Language EN — IronBeetle ep012 seats the two-ring io_uring loop."
say "equinox-iron-ep012-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep012-choir: Lens TAME — e69 · ep012 · almanac seat 74 · ch5 10/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep012_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep012-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep012" else "equinox-iron-ep012-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep012-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep012-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep012-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep012_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep012-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep012-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep012-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep012_almanac.sh"]
assert almanac.ok else "equinox-iron-ep012-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep012-choir — ep012 · clean room · absent refuses · almanac seat 74 · ch5 10/16"
