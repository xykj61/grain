# tools/gen/season/equinox_ironbeetle_ep030_choir_witness.rish -- e80 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep030_choir_witness.rish

say "equinox-iron-ep030-choir: Language EN — IronBeetle ep030 seats address ownership by entry."
say "equinox-iron-ep030-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep030-choir: Lens TAME — e80 · ep030 · almanac seat 85 · ch6 5/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep030_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep030-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep030" else "equinox-iron-ep030-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep030-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep030-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep030-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep030_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep030-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep030-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep030-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep030_almanac.sh"]
assert almanac.ok else "equinox-iron-ep030-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep030-choir — ep030 · clean room · absent refuses · almanac seat 85 · ch6 5/16"
