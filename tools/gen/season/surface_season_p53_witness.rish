# tools/gen/season/surface_season_p53_witness.rish — check-in next lean.
#
#   rishi/bin/rishi run tools/gen/season/surface_season_p53_witness.rish

say "surface-p53: Language EN — check-in next lean."
say "surface-p53: Style Radiant — rank doors; refuse invent pad."
say "surface-p53: Lens TAME — Surface Season p53."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md"]
assert counsel.ok else "surface-p53: p53 counsel missing"

let lean = run ["sh" "-c" "grep -q 'live-five' counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md && grep -q 'return_generator_s9' counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md && grep -q 'Line polish' counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md && echo LEAN_OK"]
assert lean.ok else "surface-p53: lean scan failed"
assert lean.out contains "LEAN_OK" else "surface-p53: ranked leans missing"

let rec = run ["sh" "-c" "grep -q 'Recommend: live-five' counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md && echo REC_OK"]
assert rec.ok else "surface-p53: recommend scan failed"
assert rec.out contains "REC_OK" else "surface-p53: recommend live-five missing"

let held = run ["sh" "-c" "grep -q 'no live-five' counsel/date/20260729/20260729-140251_surface-season-p53-check-in-next-lean.md && echo HELD_OK"]
assert held.ok else "surface-p53: no-invent scan failed"
assert held.out contains "HELD_OK" else "surface-p53: must refuse invent this stamp"

say "GREEN: surface-p53 — live-five recommended · handback · Line polish ranked"
say "GREEN: surface-p53 — no invent metal this stamp."
