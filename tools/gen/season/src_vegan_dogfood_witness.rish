# tools/gen/season/src_vegan_dogfood_witness.rish -- easter-egg alias -> src_first_resident_witness
#
# Routine name is first resident (Surface p9). This path stays as a wink.

if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/src_first_resident_witness.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/src_first_resident_witness.rish" args[0]]
if r.out != "" then say r.out
exit r.code
