# tools/gen/season/equinox_ironbeetle_ep011_choir_witness.rish -- e68 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep011_choir_witness.rish

say "equinox-iron-ep011-choir: Language EN — IronBeetle ep011 seats the five-layer disk path."
say "equinox-iron-ep011-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep011-choir: Lens TAME — e68 · ep011 · almanac seat 73 · ch5 9/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep011_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep011-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep011" else "equinox-iron-ep011-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep011-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep011-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep011-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep011_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep011-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep011-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep011-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep011_almanac.sh"]
assert almanac.ok else "equinox-iron-ep011-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep011-choir — ep011 · clean room · absent refuses · almanac seat 73 · ch5 9/16"
