# tools/gen/season/commence_m5_recut_witness.rish — commence M5 / e96.
#
#   rishi/bin/rishi run tools/gen/season/commence_m5_recut_witness.rish
#
# Re-cuts every green in the weave behind the proven census control.
# Pinned meters (sundial · fascia · shred) stay pinned — not re-cut.
# Leaf only. Almanac seat 100 via equinox choir.

say "commence-m5: Language EN — control first; then re-cut every green."
say "commence-m5: Style Radiant — pinned meters stay pinned; invent none."
say "commence-m5: Lens TAME — e96 · commence M5 · almanac seat 100 · ch7 4/16."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "commence-m5: census control must GREEN before totals"
assert control.out contains "GREEN: census-control" else "commence-m5: want control GREEN"

let glow = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "glow/gen/cast-u32.glow"]
say glow.out
assert glow.ok else "commence-m5: glow desk RED"
assert glow.out contains "GREEN: glow_run" else "commence-m5: want glow GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "commence-m5: baton museum RED"
assert museum.out contains "census_breach_count=0" else "commence-m5: want breach 0"
assert museum.out contains "GREEN: baton-census" else "commence-m5: want museum GREEN"

let alphabet = run ["rishi/bin/rishi" "run" "tools/g/glow_rune_alphabet_witness.rish"]
say alphabet.out
assert alphabet.ok else "commence-m5: rune alphabet RED"
assert alphabet.out contains "GREEN: Glow rune alphabet" else "commence-m5: want alphabet GREEN"

let hygiene = run ["rishi/bin/rishi" "run" "tools/gen/season/glow_hygiene_pin.rish"]
say hygiene.out
assert hygiene.ok else "commence-m5: glow hygiene RED"
assert hygiene.out contains "GREEN: glow-hygiene" else "commence-m5: want hygiene GREEN"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "commence-m5: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "commence-m5: want scope GREEN"

let scan = run ["sh" "tools/fixtures/commence_m5_recut_scan.sh"]
say scan.out
assert scan.ok else "commence-m5: m5 scan must exit 0"
assert scan.out contains "control_gate=honored" else "commence-m5: want control_gate"
assert scan.out contains "advisory=honored" else "commence-m5: want advisory"
assert scan.out contains "advisory_present=11" else "commence-m5: want present 11"
assert scan.out contains "advisory_drift=11" else "commence-m5: want drift 11"
assert scan.out contains "inventory=honored" else "commence-m5: want inventory"
assert scan.out contains "inv_glow_cache_tracked=0" else "commence-m5: want cache untracked"
assert scan.out contains "verdict=ok" else "commence-m5: want verdict=ok"

say "GREEN: commence-m5 — control proven · M1+M2 greens re-cut · advisory 11/11 · inventory behind control"
