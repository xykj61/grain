# tools/gen/season/equinox_ironbeetle_ep043_choir_witness.rish -- e91 -> almanac ch6 FULL.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep043_choir_witness.rish

say "equinox-iron-ep043-choir: Language EN — IronBeetle ep043 seats Manifest as the moment of truth."
say "equinox-iron-ep043-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep043-choir: Lens TAME — e91 · ep043 · almanac seat 96 · ch6 FULL."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep043_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep043-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep043" else "equinox-iron-ep043-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep043-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep043-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep043-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep043_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep043-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep043-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep043-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep043_almanac.sh"]
assert almanac.ok else "equinox-iron-ep043-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep043-choir — ep043 · clean room · absent refuses · almanac seat 96 · ch6 FULL"
