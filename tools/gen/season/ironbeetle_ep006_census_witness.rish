# tools/gen/season/ironbeetle_ep006_census_witness.rish -- e64 IronBeetle ep006.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep006_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep006: Language EN — memory safety for code that never frees."
say "iron-ep006: Style Radiant — fit over rank; Zig where static holds."
say "iron-ep006: Lens TAME — e64 · clean-room study · almanac seat 69."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep006: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep006_census.sh"]
say census.out
assert census.ok else "iron-ep006: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep006: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep006: want verdict=ok"
assert census.out contains "EP006=yes" else "iron-ep006: ep006 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep006: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep006: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep006: teach limbs (safety·Zig·Rust·comptime) must be present"
assert census.out contains "RHYME=yes" else "iron-ep006: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep006: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep006: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep006 — honors·source·teach·rhyme·clean·matklad ok"
