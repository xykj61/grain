let scan = run ["sh" "tools/fixtures/equinox_ch5_surface_scan.sh"]
say scan.out
assert scan.ok else "equinox-ch5-surface: surface scan must exit 0"
assert scan.out contains "limbs=16" else "equinox-ch5-surface: want limbs 16"
assert scan.out contains "ch5_surface=ok" else "equinox-ch5-surface: want ch5_surface ok"
assert scan.out contains "no_almanac_seat=honored" else "equinox-ch5-surface: want no almanac seat"
assert scan.out contains "verdict=ok" else "equinox-ch5-surface: want verdict=ok"

# Refuse -- absent iron shelf
let refuse_iron = run ["sh" "tools/fixtures/ironbeetle_ep020_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse_iron.out
assert refuse_iron.ok == false else "equinox-ch5-surface: absent iron must fail"
assert refuse_iron.out contains "IRON=ABSENT" else "equinox-ch5-surface: want IRON=ABSENT"
assert refuse_iron.out contains "verdict=absent" else "equinox-ch5-surface: want verdict=absent"

say "GREEN: equinox-ch5-surface — sixteen limbs · tool · no almanac seat · absent refuses"
