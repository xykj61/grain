# tools/gen/season/equinox_ch5_surface_witness.rish -- chapter-five surface tool.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ch5_surface_witness.rish
#
# Sixteen limbs matching seats 65-80. Leaf witnesses only -- no nested surfaces.
# Twin of equinox_ch7_surface_witness.rish (e109). Claims no almanac seat of its own.
# Close-seat answer (e119): a surface witness runs over green limbs and lives as a tool.

say "equinox-ch5-surface: Language EN — chapter greens, one choir; sixteen limbs hold."
say "equinox-ch5-surface: Style Radiant — a surface witness claims no seat of its own."
say "equinox-ch5-surface: Lens TAME — e119 · ch5 surface tool · no almanac seat · census six."

# --- wire / consensus (65-cluster) ---
let ep001 = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep001_census_witness.rish"]
say ep001.out
assert ep001.ok else "equinox-ch5-surface: ep001 limb failed"
assert ep001.out contains "GREEN: iron-ep001" else "equinox-ch5-surface: ep001 not GREEN"

