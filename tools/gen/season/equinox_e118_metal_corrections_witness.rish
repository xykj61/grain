# tools/gen/season/equinox_e118_metal_corrections_witness.rish -- e118 seat.
#   rishi/bin/rishi run tools/gen/season/equinox_e118_metal_corrections_witness.rish
say "e118-metal-corrections: Language EN — two corrections against metal."
say "e118-metal-corrections: Style Radiant — closed is closed; re-cut retires stale debt."
say "e118-metal-corrections: Lens TAME — e118 · roofs CLOSED · per-bench tools · almanac 122 · ch8 10/16."

let green = run ["sh" "tools/fixtures/equinox_e118_metal_corrections_scan.sh"]
assert green.ok else "e118-metal-corrections: living scan must exit 0"
assert green.out contains "roofs_status=CLOSED" else "e118-metal-corrections: want roofs CLOSED"
assert green.out contains "stale_cloud_blocked=retired" else "e118-metal-corrections: want stale retired"
assert green.out contains "tool_presence=per_bench_recut" else "e118-metal-corrections: want per-bench"
assert green.out contains "seat_128=reserved_close_choir" else "e118-metal-corrections: want 128 reserved"
assert green.out contains "verdict=ok" else "e118-metal-corrections: want verdict ok"

let red = run ["sh" "tools/fixtures/equinox_e118_metal_corrections_scan.sh" "prove-red"]
assert (red.ok == false) else "e118-metal-corrections: prove-red must refuse"
assert red.out contains "RED_claimed_diverge_while_agree" else "e118-metal-corrections: prove-red want diverge refuse"

say "GREEN: e118-metal-corrections — roofs CLOSED · stale Cloud-blocked retired · per-bench re-cut · shred RED"
