# tools/gen/season/equinox_e108_ch7_close_choir_witness.rish -- e108 -> ch7 FULL 16/16.
#
#   rishi/bin/rishi run tools/gen/season/equinox_e108_ch7_close_choir_witness.rish

say "equinox-e108-choir: Language EN — control before the close; a close choir is a check."
say "equinox-e108-choir: Style Radiant — shred opens Chapter Eight under Keaton's word."
say "equinox-e108-choir: Lens TAME — e108 · seat 112 · REDS 34-37 · ch7 FULL."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/equinox_e108_ch7_close_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-e108-choir: welcome RED"
assert welcome.out contains "GREEN: e108-ch7-close" else "equinox-e108-choir: want GREEN"
assert welcome.out contains "seat_map_112=close_choir_this_sitting" else "equinox-e108-choir: want 112"
assert welcome.out contains "seat_map_shred=" else "equinox-e108-choir: want shred mode"
assert welcome.out contains "reds_rows=37" else "equinox-e108-choir: want rows 37"
assert welcome.out contains "census_breach_count=0" else "equinox-e108-choir: want breach 0"
assert welcome.out contains "fork_status=not_consumed" else "equinox-e108-choir: want fork waiting"

let almanac = run ["sh" "tools/gen/season/equinox_e108_ch7_close_almanac.sh"]
assert almanac.ok else "equinox-e108-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-e108-choir — ch7 close choir GREEN · almanac seat 112 · ch7 FULL 16/16"
