# tools/gen/season/ironbeetle_ep021_census_witness.rish -- e76 IronBeetle ep021.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep021_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep021: Language EN — a queue with no memory of its own."
say "iron-ep021: Style Radiant — the Grid writes; callers lend the queue its depth."
say "iron-ep021: Lens TAME — e76 · clean-room study · almanac seat 81 · ch6 open."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep021: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep021_census.sh"]
say census.out
assert census.ok else "iron-ep021: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep021: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep021: want verdict=ok"
assert census.out contains "EP021=yes" else "iron-ep021: ep021 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep021: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep021: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep021: teach limbs (Grid·write·borrowed-queue·checksum) must be present"
assert census.out contains "RHYME=yes" else "iron-ep021: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep021: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep021: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep021 — honors·source·teach·rhyme·clean·matklad ok"
