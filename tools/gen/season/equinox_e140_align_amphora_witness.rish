# tools/gen/season/equinox_e140_align_amphora_witness.rish -- e140 seat.
#   rishi/bin/rishi run tools/gen/season/equinox_e140_align_amphora_witness.rish
say "e140-align: Language EN — align Amphora CLI · commence gated · Claude pack ready."
say "e140-align: Style Radiant — nib printed · tier0 balanced · kg opens no 128."
say "e140-align: Lens TAME — e140 · REDS 49 · shred RED · 128 reserved."

let green = run ["sh" "tools/fixtures/equinox_e140_align_amphora_scan.sh"]
assert green.ok else "e140-align: living scan must exit 0"
assert green.out contains "nib_note=aa89d19443" else "e140-align: want nib"
assert green.out contains "direction=amphora_glow_tend_tame_cli" else "e140-align: want direction"
assert green.out contains "commence_note=gated_beside_reserved_close" else "e140-align: want gated commence"
assert green.out contains "claude_pack=honored" else "e140-align: want Claude pack"
assert green.out contains "amphora_cli=horizon" else "e140-align: want CLI horizon"
assert green.out contains "reds_note=row_49_breach_can_be_withdrawn" else "e140-align: want REDS 49"
assert green.out contains "kg_no_gate=honored" else "e140-align: want kg no gate"
assert green.out contains "shred=RED" else "e140-align: want shred RED"
assert green.out contains "seat_128=reserved_close_choir" else "e140-align: want 128 reserved"
assert green.out contains "verdict=ok" else "e140-align: want verdict ok"

let red = run ["sh" "tools/fixtures/equinox_e140_align_amphora_scan.sh" "prove-red"]
assert (red.ok == false) else "e140-align: prove-red must refuse"
assert red.out contains "RED_seat_128_opened_on_kg" else "e140-align: prove-red want refuse"

say "GREEN: e140-align — Amphora CLI horizon · commence gated · Claude pack · REDS 49 · 128 reserved"
