# tools/gen/season/equinox_e1_east_pack_witness.rish — Equinox e1 East pack.
#
#   rishi/bin/rishi run tools/gen/season/equinox_e1_east_pack_witness.rish
#
# Three thin utilities, each beside its own module, welcome and refuse asserted:
#   lattice.approx_equal    — witness-grade f32 agreement
#   Grid.row_cells          — reading sibling of put_line
#   brush.frame_widest_line — grid width needed before truncation bites
#   CapabilityTable.refusal_reason — a denial that can name its own reason (e2)
#   Gardens.total_capacity — the whole a remainder is measured against (e3)
#   collision_guard grep fallback — the guard runs where rg is absent (e3)
#   dep_crawl — the graph walked to leaves inside named bounds (e4)
#   Region.divide · Gardens.add_division — divisions inside the whole (e5)
#   priority_of_slot · priority_of_round — a round names its own priority (e6)
#   copy_sameness — the one real tally_copy cannot drift silently (e6)

say "equinox-e1: Language EN — East equinox, first utilities."
say "equinox-e1: Style Radiant — welcome and refuse both asserted."
say "equinox-e1: Lens TAME — bounds named; two assertions per function."

let zig = "vendor/zig-toolchain/zig"
let have_zig = run ["test" "-x" zig]
assert have_zig.ok else "equinox-e1: toolchain absent — raise rye first"

let lat = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run lattice/approx_equal_test.rye 2>&1"]
assert lat.ok else "equinox-e1: lattice approx_equal RED"
assert lat.out contains "GREEN" else "equinox-e1: lattice approx_equal not GREEN"

let bs = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run brushstroke/east_pack_test.rye 2>&1"]
assert bs.ok else "equinox-e1: brushstroke east pack RED"
assert bs.out contains "GREEN" else "equinox-e1: brushstroke east pack not GREEN"
let cv = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run caravan/refusal_reason_test.rye 2>&1"]
assert cv.ok else "equinox-e2: caravan refusal_reason RED"
assert cv.out contains "GREEN" else "equinox-e2: caravan refusal_reason not GREEN"

let tl = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run tally/total_capacity_test.rye 2>&1"]
assert tl.ok else "equinox-e3: tally total_capacity RED"
assert tl.out contains "GREEN" else "equinox-e3: tally total_capacity not GREEN"

# The guard the e1 collision slipped past — now runnable on a bare cloud raise.
let cg = run ["sh" "-c" "rishi/bin/rishi run tools/collision_guard.rish total_capacity 2>&1"]
assert cg.ok else "equinox-e3: collision_guard RED"
assert cg.out contains "GREEN" else "equinox-e3: collision_guard not GREEN"

let dv = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run tally/divisions_test.rye 2>&1"]
assert dv.ok else "equinox-e5: tally divisions RED"
assert dv.out contains "GREEN" else "equinox-e5: tally divisions not GREEN"

let dc = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/dep_crawl.rish brushstroke/east_pack_test.rye 2>&1"]
assert dc.ok else "equinox-e4: dep_crawl RED"
assert dc.out contains "verdict=ok" else "equinox-e4: dep_crawl closure did not close"

let pf = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run glow/priority_fold_test.rye 2>&1"]
assert pf.ok else "equinox-e6: priority fold RED"
assert pf.out contains "GREEN" else "equinox-e6: priority fold not GREEN"

let cs = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/copy_sameness_witness.rish 2>&1"]
assert cs.ok else "equinox-e6: copy sameness RED"
assert cs.out contains "GREEN" else "equinox-e6: copy sameness not GREEN"

# v1 safety: the bundle must refuse a non-closing round, and must never write
# a preservation artifact into tmpfs. Refuse side only -- cutting 183 MiB is
# not a per-run cost, and the accept side was witnessed at 20260729.210100.
let bref = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/equinox_bundle.rish e7 2>&1; echo EXIT=$?"]
assert bref.ok else "voice-v1: bundle refuse call failed"
assert bref.out contains "not a closing round" else "voice-v1: bundle accepted a non-closing round"

let vr = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/voice_roster_witness.rish 2>&1"]
assert vr.ok else "voice-v1: voice roster RED"
assert vr.out contains "GREEN" else "voice-v1: voice roster not GREEN"

let bt = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/bounds_typed_witness.rish 2>&1"]
assert bt.ok else "voice-v2: bounds-typed RED"
assert bt.out contains "GREEN" else "voice-v2: bounds-typed not GREEN"
assert bt.out contains "untyped_declared_bounds=0" else "voice-v2: a declared bound lost its type"

# v3 · slot 3 emphasis · happy_zone_witnesses_first: every guard's refusal side
# now fires on every run, from a fixture rather than from a hand.
let n1 = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/dep_crawl_bounds_negative_witness.rish 2>&1"]
assert n1.ok else "voice-v3: dep_crawl bounds do not bite"
assert n1.out contains "GREEN" else "voice-v3: dep_crawl negative not GREEN"

let n2 = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/voice_roster_negative_witness.rish 2>&1"]
assert n2.ok else "voice-v3: voice roster accepts an undeclared voice"
assert n2.out contains "GREEN" else "voice-v3: voice roster negative not GREEN"

let n3 = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/copy_sameness_negative_witness.rish 2>&1"]
assert n3.ok else "voice-v3: sameness guard misses a drifted copy"
assert n3.out contains "GREEN" else "voice-v3: sameness negative not GREEN"

# v4 · slot 4 · values_apart: every scan speaks one composed convention --
# key=value lines, detail: prefixed detail, a named verdict= key -- and the two
# channels are asserted to agree, so a typo'd sentinel cannot pass quietly.
let dcv = run ["sh" "-c" "sh tools/fixtures/dep_crawl_scan.sh brushstroke/east_pack_test.rye 2>&1"]
assert dcv.out contains "verdict=ok" else "voice-v4: dep_crawl scan lost its verdict key"
assert dcv.ok else "voice-v4: dep_crawl verdict and status disagree"

let csv = run ["sh" "-c" "sh tools/fixtures/copy_sameness_scan.sh 2>&1"]
assert csv.out contains "verdict=ok" else "voice-v4: sameness scan lost its verdict key"
assert csv.ok else "voice-v4: sameness verdict and status disagree"

# v5 · slot 5 · accretion_one_clock: the communication contract itself is data,
# lawful under the Brix law, with its faults observed from a fixture.
let cf = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/counsel_flow_witness.rish 2>&1"]
assert cf.ok else "voice-v5: counsel_flow RED"
assert cf.out contains "GREEN" else "voice-v5: counsel_flow not GREEN"

let cfn = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/counsel_flow_negative_witness.rish 2>&1"]
assert cfn.ok else "voice-v5: counsel_flow guard does not bite"
assert cfn.out contains "GREEN" else "voice-v5: counsel_flow negative not GREEN"

# v6 · slot 6 · galls_law_graduation: the scan-seam convention had five
# consumers and no home. Seated once at context/specs/20260729-215600; every
# roster scan cites it, elders join on touch as an advisory count.
let sc = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/scan_convention_witness.rish 2>&1"]
assert sc.ok else "voice-v6: scan convention RED"
assert sc.out contains "GREEN" else "voice-v6: scan convention not GREEN"

let scn = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/scan_convention_negative_witness.rish 2>&1"]
assert scn.ok else "voice-v6: single-home guard does not bite"
assert scn.out contains "GREEN" else "voice-v6: scan convention negative not GREEN"

# v9 · slot 9 · happy_zone_witnesses_first (second appearance this journey):
# own-reds-immediately said WHEN and never WHERE. Six reds had reached the tree
# and twenty had been owned aloud, so fourteen lessons lived only in a chat
# window. work-in-progress/REDS.md is the durable home.
let rl = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/reds_ledger_witness.rish 2>&1"]
assert rl.ok else "voice-v9: reds ledger RED"
assert rl.out contains "GREEN" else "voice-v9: reds ledger not GREEN"

let rln = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/reds_ledger_negative_witness.rish 2>&1"]
assert rln.ok else "voice-v9: reds ledger guard does not bite"
assert rln.out contains "GREEN" else "voice-v9: reds ledger negative not GREEN"

# v10 · slot 10 · sameness_as_compression: the reds-first law lives in exactly one
# home with three citers, and the crossing is whole -- named study, teachers in
# gratitude, siloed law in our own voice.
let rfw = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/reds_first_witness.rish 2>&1"]
assert rfw.ok else "voice-v10: reds-first law RED"
assert rfw.out contains "GREEN" else "voice-v10: reds-first not GREEN"
assert rfw.out contains "law_body_namings=0" else "voice-v10: the siloed law names teachers in its body"

# v11: the almanac breach, approved 20260729.225900 and executed the same stamp.
let ab = run ["sh" "-c" "rishi/bin/rishi run tools/gen/season/almanac_breach_witness.rish 2>&1"]
assert ab.ok else "voice-v11: almanac breach incomplete"
assert ab.out contains "GREEN" else "voice-v11: almanac breach not GREEN"

# v12 · slot 12 · opening_lines_and_silo: six authored .rye files now sit inside
# the elder roster, so the canonical head is proven rather than merely kept.
let ol = run ["sh" "-c" "rishi/bin/rishi run tools/opening_lines_witness.rish 2>&1"]
assert ol.ok else "voice-v12: opening lines RED"
assert ol.out contains "GREEN" else "voice-v12: opening lines not GREEN"
assert ol.out contains "all 25 hosted files" else "voice-v12: the roster lost files"

# v23: tally/stack graduated on Keaton's word — its witness rides from day one.
let ts = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run tally/stack_test.rye 2>&1"]
assert ts.ok else "voice-v23: tally stack RED"
assert ts.out contains "GREEN" else "voice-v23: tally stack not GREEN"
















say "GREEN: equinox-e1..e6 · voice v0..v12 — proven rather than merely kept, and the crossing complete"
