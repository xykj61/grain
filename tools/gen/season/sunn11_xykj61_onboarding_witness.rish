# tools/gen/season/sunn11_xykj61_onboarding_witness.rish — SUNN11 xykj61 onboarding.
#
#   rishi/bin/rishi run tools/gen/season/sunn11_xykj61_onboarding_witness.rish
#
# APPLY.md is root-ignored (pier-local CREATE packs) — never assert it here.

say "sunn11: Language EN — living onboarding clones name xykj61."
say "sunn11: Style Radiant — beginner xykj61 · origin lane groupproject405 kept."
say "sunn11: Lens TAME — SUNN11 · clone lock · dual-push named · roster truth."

let s = read-file "SOURCE.md"
assert s contains "git clone https://github.com/xykj61/grain.git ~/grain" else "sunn11: SOURCE want xykj61 clone"
assert s contains "dual-push" else "sunn11: SOURCE want dual-push language"
assert s contains "REMOTE_ROSTER" else "sunn11: SOURCE want REMOTE_ROSTER cite"
assert (s contains "git clone https://github.com/groupproject405/grain") == false else "sunn11: SOURCE must not clone groupproject405"
# Door stamp may leave SOURCE Status as later doors accrete; metal above stays.

let r = read-file "README.md"
assert r contains "xykj61/grain" else "sunn11: README want xykj61/grain"
assert r contains "beginner clone" else "sunn11: README want beginner clone phrase"

let c = read-file "CLAUDE.md"
assert c contains "xykj61/grain" else "sunn11: CLAUDE want xykj61/grain"

let w = read-file "manual/guides/apprentice-welcome.md"
assert w contains "https://github.com/xykj61/grain.git" else "sunn11: apprentice-welcome want xykj61 clone"

let e = read-file "context/specs/enclosure-editors.md"
assert e contains "https://github.com/xykj61/grain.git" else "sunn11: enclosure want xykj61 clone"

let p = read-file "tools/gen/season/personalize.template.brix"
assert p contains "source_pier_clone https://github.com/xykj61/grain.git" else "sunn11: personalize want xykj61 clone"
assert p contains "source_pier_agent_lane groupproject405" else "sunn11: personalize want agent lane kept"

let f = read-file "manual/guides/first-season-personalize.md"
assert f contains "xykj61/grain" else "sunn11: first-season-personalize want xykj61/grain"

let roster = read-file "context/REMOTE_ROSTER.md"
assert roster contains "`origin` | GitHub `groupproject405/grain`" else "sunn11: roster want origin groupproject405"
assert roster contains "`xykj61` | GitHub `xykj61/grain`" else "sunn11: roster want xykj61 remote"

say "GREEN: sunn11 — living onboarding clones xykj61 · dual-push named · roster origin kept"
