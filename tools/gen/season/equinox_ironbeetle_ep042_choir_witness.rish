# tools/gen/season/equinox_ironbeetle_ep042_choir_witness.rish -- e90 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep042_choir_witness.rish

say "equinox-iron-ep042-choir: Language EN — IronBeetle ep042 seats the compaction merge loop."
say "equinox-iron-ep042-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep042-choir: Lens TAME — e90 · ep042 · almanac seat 95 · ch6 15/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep042_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep042-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep042" else "equinox-iron-ep042-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep042-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep042-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep042-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep042_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep042-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep042-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep042-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep042_almanac.sh"]
assert almanac.ok else "equinox-iron-ep042-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep042-choir — ep042 · clean room · absent refuses · almanac seat 95 · ch6 15/16"
