# tools/gen/season/equinox_ch6_surface_witness.rish -- chapter-six surface tool.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ch6_surface_witness.rish
#
# Sixteen limbs matching seats 81-96. Leaf witnesses only -- no nested surfaces.
# Twin of equinox_ch7_surface_witness.rish (e109). Claims no almanac seat of its own.
# Close-seat answer (e119): a surface witness runs over green limbs and lives as a tool.

say "equinox-ch6-surface: Language EN — chapter greens, one choir; sixteen limbs hold."
say "equinox-ch6-surface: Style Radiant — a surface witness claims no seat of its own."
say "equinox-ch6-surface: Lens TAME — e119 · ch6 surface tool · no almanac seat · census six."

# --- Grid / durability ---
