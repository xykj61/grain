let scan = run ["sh" "tools/fixtures/equinox_ch6_surface_scan.sh"]
say scan.out
assert scan.ok else "equinox-ch6-surface: surface scan must exit 0"
assert scan.out contains "limbs=16" else "equinox-ch6-surface: want limbs 16"
assert scan.out contains "ch6_surface=ok" else "equinox-ch6-surface: want ch6_surface ok"
assert scan.out contains "no_almanac_seat=honored" else "equinox-ch6-surface: want no almanac seat"
assert scan.out contains "verdict=ok" else "equinox-ch6-surface: want verdict=ok"

# Refuse -- absent iron shelf
let refuse_iron = run ["sh" "tools/fixtures/ironbeetle_ep043_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse_iron.out
assert refuse_iron.ok == false else "equinox-ch6-surface: absent iron must fail"
assert refuse_iron.out contains "IRON=ABSENT" else "equinox-ch6-surface: want IRON=ABSENT"
assert refuse_iron.out contains "verdict=absent" else "equinox-ch6-surface: want verdict=absent"

say "GREEN: equinox-ch6-surface — sixteen limbs · tool · no almanac seat · absent refuses"
