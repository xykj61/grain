# tools/gen/season/brush_parse_witness.rish — p23–p27 · p28 BrushFrame→skate_grid
#
#   rishi/bin/rishi run tools/gen/season/brush_parse_witness.rish
#
# Builds brush_parse · selftest · parse/lower/redraw/grid paths · TAME density.
# Skate lean = stdout + headless skate_grid; no Wayland window yet.

say "brush-parse: Language EN — .brush pins read as Frame at a nib."
say "brush-parse: Style Radiant — prove parse · refuse · lower · redraw · grid."
say "brush-parse: Lens TAME — Surface Season p28."

let zig = "vendor/zig-toolchain/zig"
let mkdir = run ["mkdir" "-p" "brushstroke/bin"]
assert mkdir.ok else "brush-parse: mkdir bin failed"

say "brush-parse: build..."
let build = run ["env" "RYE_ZIG=${zig}" "rye/bin/rye" "build" "brushstroke/brush_parse.rye" "-femit-bin=brushstroke/bin/brush-parse"]
assert build.ok else "brush-parse: rye build failed"

say "brush-parse: selftest..."
let self = run ["brushstroke/bin/brush-parse" "selftest"]
assert self.ok else "brush-parse: selftest failed"
assert self.out contains "GREEN: brush-parse selftest" else "brush-parse: selftest not GREEN"
assert self.out contains "refuse-suite" else "brush-parse: refuse-suite banner missing"
assert self.out contains "lower" else "brush-parse: lower banner missing"
assert self.out contains "redraw" else "brush-parse: redraw banner missing"
assert self.out contains "skate-grid" else "brush-parse: skate-grid banner missing"

say "brush-parse: seed-frame.brush path..."
let path = run ["sh" "-c" "brushstroke/bin/brush-parse brushstroke/seed-frame.brush 2>&1"]
assert path.ok else "brush-parse: seed-frame path failed"
assert path.out contains "at-nib=brushstroke-seed" else "brush-parse: at-nib pin missing"
assert path.out contains "present=Frame" else "brush-parse: present Frame missing"
assert path.out contains "line-count=3" else "brush-parse: line-count not 3"
assert path.out contains "GREEN: brush-parse" else "brush-parse: path run not GREEN"

let seat = run ["test" "-f" "counsel/date/20260728/20260728-211918_surface-season-p23-brush-parser-begun.md"]
assert seat.ok else "brush-parse: p23 counsel seat missing"
let seat24 = run ["test" "-f" "counsel/date/20260728/20260728-212328_surface-season-p24-brush-parse-tame-tidy.md"]
assert seat24.ok else "brush-parse: p24 counsel seat missing"
let seat25 = run ["test" "-f" "counsel/date/20260728/20260728-212855_surface-season-p25-brush-refuse-suite.md"]
assert seat25.ok else "brush-parse: p25 counsel seat missing"
let seat26 = run ["test" "-f" "counsel/date/20260728/20260728-213205_surface-season-p26-brush-frame-lower.md"]
assert seat26.ok else "brush-parse: p26 counsel seat missing"
let seat27 = run ["test" "-f" "counsel/date/20260728/20260728-215052_surface-season-p27-brush-stdout-redraw.md"]
assert seat27.ok else "brush-parse: p27 counsel seat missing"
let seat28 = run ["test" "-f" "counsel/date/20260728/20260728-215608_surface-season-p28-brush-skate-grid.md"]
assert seat28.ok else "brush-parse: p28 counsel seat missing"

say "brush-parse: refuse helpers..."
let helpers = run ["sh" "-c" "grep -q 'fn assert_parse_error' brushstroke/brush_parse.rye && grep -q 'fn prove_refuse_pins' brushstroke/brush_parse.rye && grep -q 'fn prove_refuse_bounds' brushstroke/brush_parse.rye && echo REFUSE_OK"]
assert helpers.ok else "brush-parse: refuse helper scan failed"
assert helpers.out contains "REFUSE_OK" else "brush-parse: refuse suite helpers not named"

say "brush-parse: lower path..."
let lower_helpers = run ["sh" "-c" "grep -q 'pub fn lower_brush' brushstroke/brush_parse.rye && grep -q 'pub const BrushFrame' brushstroke/brush_parse.rye && echo LOWER_OK"]
assert lower_helpers.ok else "brush-parse: lower helper scan failed"
assert lower_helpers.out contains "LOWER_OK" else "brush-parse: BrushFrame / lower_brush missing"
let lower_run = run ["sh" "-c" "brushstroke/bin/brush-parse lower brushstroke/seed-frame.brush 2>&1"]
assert lower_run.ok else "brush-parse: lower path failed"
assert lower_run.out contains "GREEN: brush-parse lower" else "brush-parse: lower not GREEN"

say "brush-parse: redraw path..."
let redraw_helpers = run ["sh" "-c" "grep -q 'pub fn redraw_brush_frame' brushstroke/brush_parse.rye && grep -q 'fn prove_seed_redraw' brushstroke/brush_parse.rye && echo REDRAW_OK"]
assert redraw_helpers.ok else "brush-parse: redraw helper scan failed"
assert redraw_helpers.out contains "REDRAW_OK" else "brush-parse: redraw_brush_frame missing"
let redraw_run = run ["sh" "-c" "brushstroke/bin/brush-parse redraw brushstroke/seed-frame.brush 2>&1"]
assert redraw_run.ok else "brush-parse: redraw path failed"
assert redraw_run.out contains "brushstroke seed" else "brush-parse: redraw missing line 0"
assert redraw_run.out contains "frame drawn from values" else "brush-parse: redraw missing line 1"
assert redraw_run.out contains "(seed version string)" else "brush-parse: redraw missing line 2"
assert redraw_run.out contains "GREEN: brush-parse redraw" else "brush-parse: redraw not GREEN"
assert redraw_run.out contains "stdout Skate lean" else "brush-parse: Skate lean note missing"

say "brush-parse: grid path..."
let grid_helpers = run ["sh" "-c" "grep -q 'pub fn brush_frame_to_grid' brushstroke/brush_parse.rye && grep -q 'fn prove_seed_grid' brushstroke/brush_parse.rye && grep -q 'skate_grid.rye' brushstroke/brush_parse.rye && echo GRID_OK"]
assert grid_helpers.ok else "brush-parse: grid helper scan failed"
assert grid_helpers.out contains "GRID_OK" else "brush-parse: brush_frame_to_grid missing"
let grid_run = run ["sh" "-c" "brushstroke/bin/brush-parse grid brushstroke/seed-frame.brush 2>&1"]
assert grid_run.ok else "brush-parse: grid path failed"
assert grid_run.out contains "cols=40" else "brush-parse: grid cols not 40"
assert grid_run.out contains "rows=8" else "brush-parse: grid rows not 8"
assert grid_run.out contains "lit=" else "brush-parse: lit count missing"
assert grid_run.out contains "GREEN: brush-parse grid" else "brush-parse: grid not GREEN"

let begun = run ["sh" "-c" "grep -q 'Parser begun' brushstroke/seed-frame.brush && echo BEGUN"]
assert begun.ok else "brush-parse: fixture begun note scan failed"
assert begun.out contains "BEGUN" else "brush-parse: fixture must say Parser begun"

say "brush-parse: TAME density..."
let inv = run ["sh" "tools/gen/season/brush_parse_tame_density.sh"]
assert inv.ok else "brush-parse: need ≥20 invariant markers (TAME visible)"
assert inv.out contains "INV_OK" else "brush-parse: invariant density marker missing"
let triad = run ["sh" "-c" "head -n 30 brushstroke/brush_parse.rye | grep -q 'const assert = std.debug.assert' && head -n 30 brushstroke/brush_parse.rye | grep -q 'const print = std.debug.print' && echo TRIAD"]
assert triad.ok else "brush-parse: opening triad scan failed"
assert triad.out contains "TRIAD" else "brush-parse: opening triad missing"
let ban = run ["sh" "-c" "if grep -E '\\) == error\\.|\\) != error\\.|std\\.debug\\.assert\\(' brushstroke/brush_parse.rye >/dev/null; then echo HIT; else echo CLEAN; fi"]
assert ban.ok else "brush-parse: ban scan failed"
assert ban.out contains "CLEAN" else "brush-parse: TAME ban pattern present"
let widths = run ["sh" "-c" "grep -q 'slice_len_u32' brushstroke/brush_parse.rye && grep -q 'max_brush_bytes' brushstroke/brush_parse.rye && grep -q 'max_frame_lines' brushstroke/brush_parse.rye && echo WIDTH"]
assert widths.ok else "brush-parse: width pins scan failed"
assert widths.out contains "WIDTH" else "brush-parse: named bounds / u32 seam helper missing"

say "GREEN: brush-parse — build · selftest · refuse · lower · redraw · grid · TAME · Surface p28"
say "GREEN: brush-parse — Skate grid live (headless); Wayland window still later."
