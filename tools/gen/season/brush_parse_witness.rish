# tools/gen/season/brush_parse_witness.rish — p23 begin · p24 TAME · p25 refuse
#
#   rishi/bin/rishi run tools/gen/season/brush_parse_witness.rish
#
# Builds brush_parse · selftest GREEN · fixture path GREEN · TAME invariant density.
# Does not paint · does not open Wayland · does not lower to Skate.

say "brush-parse: Language EN — .brush pins read as Frame at a nib."
say "brush-parse: Style Radiant — prove parse · refuse missing pins."
say "brush-parse: Lens TAME — Surface Season p25."



let zig = "vendor/zig-toolchain/zig"
let mkdir = run ["mkdir" "-p" "brushstroke/bin"]
assert mkdir.ok else "brush-parse: mkdir bin failed"

say "brush-parse: build..."
let build = run ["env" "RYE_ZIG=${zig}" "rye/bin/rye" "build" "brushstroke/brush_parse.rye" "-femit-bin=brushstroke/bin/brush-parse"]
assert build.ok else "brush-parse: rye build failed"

say "brush-parse: selftest..."
let self = run ["brushstroke/bin/brush-parse" "selftest"]
assert self.ok else "brush-parse: selftest failed"
assert self.out contains "GREEN: brush-parse selftest" else "brush-parse: selftest not GREEN"
assert self.out contains "refuse-suite" else "brush-parse: refuse-suite banner missing"


say "brush-parse: seed-frame.brush path..."
# print pins on stderr; GREEN on stdout — merge for one assert stream
let path = run ["sh" "-c" "brushstroke/bin/brush-parse brushstroke/seed-frame.brush 2>&1"]
assert path.ok else "brush-parse: seed-frame path failed"
assert path.out contains "at-nib=brushstroke-seed" else "brush-parse: at-nib pin missing"
assert path.out contains "present=Frame" else "brush-parse: present Frame missing"
assert path.out contains "line-count=3" else "brush-parse: line-count not 3"
assert path.out contains "GREEN: brush-parse" else "brush-parse: path run not GREEN"

let seat = run ["test" "-f" "counsel/20260728-211918_surface-season-p23-brush-parser-begun.md"]
assert seat.ok else "brush-parse: p23 counsel seat missing"
let seat24 = run ["test" "-f" "counsel/20260728-212328_surface-season-p24-brush-parse-tame-tidy.md"]
assert seat24.ok else "brush-parse: p24 counsel seat missing"
let seat25 = run ["test" "-f" "counsel/20260728-212855_surface-season-p25-brush-refuse-suite.md"]
assert seat25.ok else "brush-parse: p25 counsel seat missing"

say "brush-parse: refuse helpers..."
let helpers = run ["sh" "-c" "grep -q 'fn assert_parse_error' brushstroke/brush_parse.rye && grep -q 'fn prove_refuse_pins' brushstroke/brush_parse.rye && grep -q 'fn prove_refuse_bounds' brushstroke/brush_parse.rye && grep -q 'error.MissingPresent' brushstroke/brush_parse.rye && grep -q 'error.TooManyLines' brushstroke/brush_parse.rye && grep -q 'error.EmptyLine' brushstroke/brush_parse.rye && echo REFUSE_OK"]
assert helpers.ok else "brush-parse: refuse helper scan failed"
assert helpers.out contains "REFUSE_OK" else "brush-parse: refuse suite helpers / errors not named"

let begun = run ["sh" "-c" "grep -q 'Parser begun' brushstroke/seed-frame.brush && echo BEGUN"]
assert begun.ok else "brush-parse: fixture begun note scan failed"
assert begun.out contains "BEGUN" else "brush-parse: fixture must say Parser begun"

say "brush-parse: TAME density..."
# Living floor — p24 tidy seats ≥20 invariant markers; raise only by accretion.
let inv = run ["sh" "tools/gen/season/brush_parse_tame_density.sh"]
assert inv.ok else "brush-parse: need ≥20 invariant markers (TAME visible)"
assert inv.out contains "INV_OK" else "brush-parse: invariant density marker missing"
let triad = run ["sh" "-c" "head -n 30 brushstroke/brush_parse.rye | grep -q 'const assert = std.debug.assert' && head -n 30 brushstroke/brush_parse.rye | grep -q 'const print = std.debug.print' && echo TRIAD"]
assert triad.ok else "brush-parse: opening triad scan failed"
assert triad.out contains "TRIAD" else "brush-parse: opening triad missing"
let ban = run ["sh" "-c" "if grep -E '\\) == error\\.|\\) != error\\.|std\\.debug\\.assert\\(' brushstroke/brush_parse.rye >/dev/null; then echo HIT; else echo CLEAN; fi"]
assert ban.ok else "brush-parse: ban scan failed"
assert ban.out contains "CLEAN" else "brush-parse: TAME ban pattern present"
let widths = run ["sh" "-c" "grep -q 'slice_len_u32' brushstroke/brush_parse.rye && grep -q 'max_brush_bytes' brushstroke/brush_parse.rye && grep -q 'max_frame_lines' brushstroke/brush_parse.rye && echo WIDTH"]
assert widths.ok else "brush-parse: width pins scan failed"
assert widths.out contains "WIDTH" else "brush-parse: named bounds / u32 seam helper missing"

say "GREEN: brush-parse — build · selftest · refuse-suite · TAME · Surface p25"
say "GREEN: brush-parse — .brush parser begun; paint and Wayland still later."

