# tools/gen/season/ironbeetle_ep044_census_witness.rish -- e93 IronBeetle ep044.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep044_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep044: Language EN — everything we know, from the first byte."
say "iron-ep044: Style Radiant — two jobs of consensus; honesty about unfinished code."
say "iron-ep044: Lens TAME — e93 · clean-room study · almanac seat 97 · ch7 open."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep044: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep044_census.sh"]
say census.out
assert census.ok else "iron-ep044: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep044: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep044: want verdict=ok"
assert census.out contains "EP044=yes" else "iron-ep044: ep044 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep044: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep044: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep044: teach limbs (first-byte·grand-recap·two-jobs·honesty·consensus·quorum) must be present"
assert census.out contains "RHYME=yes" else "iron-ep044: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep044: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep044: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep044 — honors·source·teach·rhyme·clean·matklad ok"
