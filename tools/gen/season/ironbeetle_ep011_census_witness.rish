# tools/gen/season/ironbeetle_ep011_census_witness.rish -- e68 IronBeetle ep011.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep011_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep011: Language EN — five layers down to the kernel."
say "iron-ep011: Style Radiant — checksum before trust; layers stay countable."
say "iron-ep011: Lens TAME — e68 · clean-room study · almanac seat 73."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep011: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep011_census.sh"]
say census.out
assert census.ok else "iron-ep011: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep011: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep011: want verdict=ok"
assert census.out contains "EP011=yes" else "iron-ep011: ep011 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep011: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep011: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep011: teach limbs (five-layers·journal·io_uring·checksum) must be present"
assert census.out contains "RHYME=yes" else "iron-ep011: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep011: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep011: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep011 — honors·source·teach·rhyme·clean·matklad ok"
