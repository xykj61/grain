# tools/gen/season/equinox_ironbeetle_ep035_choir_witness.rish -- e85 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep035_choir_witness.rish

say "equinox-iron-ep035-choir: Language EN — IronBeetle ep035 seats timestamp-as-key write path."
say "equinox-iron-ep035-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep035-choir: Lens TAME — e85 · ep035 · almanac seat 90 · ch6 10/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep035_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep035-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep035" else "equinox-iron-ep035-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep035-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep035-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep035-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep035_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep035-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep035-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep035-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep035_almanac.sh"]
assert almanac.ok else "equinox-iron-ep035-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep035-choir — ep035 · clean room · absent refuses · almanac seat 90 · ch6 10/16"
