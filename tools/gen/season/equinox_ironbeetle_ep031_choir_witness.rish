# tools/gen/season/equinox_ironbeetle_ep031_choir_witness.rish -- e81 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep031_choir_witness.rish

say "equinox-iron-ep031-choir: Language EN — IronBeetle ep031.5 seats journal-vs-checkpoint redundancy."
say "equinox-iron-ep031-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep031-choir: Lens TAME — e81 · ep031.5 · almanac seat 86 · ch6 6/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep031_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep031-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep031" else "equinox-iron-ep031-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep031-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep031-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep031-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep031_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep031-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep031-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep031-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep031_almanac.sh"]
assert almanac.ok else "equinox-iron-ep031-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep031-choir — ep031.5 · clean room · absent refuses · almanac seat 86 · ch6 6/16"
