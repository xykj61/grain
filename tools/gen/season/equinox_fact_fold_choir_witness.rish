# tools/gen/season/equinox_fact_fold_choir_witness.rish -- e30 fact_fold -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_fact_fold_choir_witness.rish

say "equinox-fact-fold-choir: Language EN — shape, page, metal; refuse a missing hall."
say "equinox-fact-fold-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-fact-fold-choir: Lens TAME — e30 · fact_fold · almanac seat 36."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/fact_fold_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-fact-fold-choir: welcome RED"
assert welcome.out contains "GREEN: fact-fold-census" else "equinox-fact-fold-choir: welcome missing GREEN"
assert welcome.out contains "pairs_matched=3" else "equinox-fact-fold-choir: want three pairs"
assert welcome.out contains "supply=872" else "equinox-fact-fold-choir: want supply=872"

let refuse = run ["sh" "tools/fixtures/fact_fold_census.sh" "tools/fixtures/fact_fold_ABSENT.brix"]
say refuse.out
assert refuse.ok == false else "equinox-fact-fold-choir: absent shape must fail"
assert refuse.out contains "verdict=missing_shape" else "equinox-fact-fold-choir: want missing_shape"

let almanac = run ["sh" "tools/gen/season/equinox_fact_fold_choir_almanac.sh"]
assert almanac.ok else "equinox-fact-fold-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-fact-fold-choir — three pairs · fold GREEN · missing_shape refuse · almanac seat 36"
