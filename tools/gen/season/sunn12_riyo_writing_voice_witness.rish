# tools/gen/season/sunn12_riyo_writing_voice_witness.rish -- SUNN12 living writing voice.
#
#   rishi/bin/rishi run tools/gen/season/sunn12_riyo_writing_voice_witness.rish
#
# SUNN12 seated the standing writing voice; it molted Riyo -> Kyri on 20260810
# (Keaton's word). This witness tracks the LIVING voice at every declaration
# site. Dated **Voice:** Riyo / **Voice:** Quin headers stay testimony -- never
# asserted away here. Quin OS variant + Q-vane stay named. Filename keeps its
# dated name (accrete-never-break); the body tracks the current voice.

say "sunn12: Language EN — living writing voice is Kyri (molted from Riyo)."
say "sunn12: Style Radiant — Kyri writes · Quin keeps OS + Q-vane."
say "sunn12: Lens TAME — SUNN12 seat · style · commit · session · organizing."

let r = read-file "context/RADIANT_STYLE.md"
assert r contains "The voice that writes in this style is Kyri" else "sunn12: RADIANT_STYLE want Kyri writer"
assert r contains "SUNN12" else "sunn12: RADIANT_STYLE want SUNN12"
assert r contains "KYRI.md" else "sunn12: RADIANT_STYLE want KYRI.md cite"
assert r contains "fifth OS variant" else "sunn12: RADIANT_STYLE want Quin OS hat named"
assert r contains "Q-vane" else "sunn12: RADIANT_STYLE want Q-vane named"
assert (r contains "The voice that writes in this style is Quin") == false else "sunn12: RADIANT_STYLE must not keep Quin as writer"

let c = read-file "CONTRIBUTING.md"
assert c contains "Voice:** Kyri" else "sunn12: CONTRIBUTING want Voice Kyri"
assert c contains "context/KYRI.md" else "sunn12: CONTRIBUTING want KYRI.md"
assert c contains "Kyri's Radiant Style" else "sunn12: CONTRIBUTING want Kyri Radiant Style"
assert c contains "Q-vane" else "sunn12: CONTRIBUTING want Q-vane kept"

let o = read-file "ORGANIZING.md"
assert o contains "standing writing voice" else "sunn12: ORGANIZING want standing writing voice"
assert o contains "KYRI.md" else "sunn12: ORGANIZING want KYRI.md"
assert o contains "Q-vane" else "sunn12: ORGANIZING want Q-vane"

let g = read-file "GLOW_PROFILE.template.bron"
assert g contains "Standing writing voice is" else "sunn12: GLOW_PROFILE want standing writing voice comment"
assert g contains "voice Kyri" else "sunn12: GLOW_PROFILE want voice Kyri field"

let crs = read-file ".cursor/rules/radiant-style.mdc"
assert crs contains "Voice: **Kyri**" else "sunn12: cursor radiant-style want Voice Kyri"
assert crs contains "context/KYRI.md" else "sunn12: cursor radiant-style want KYRI.md"

let clrs = read-file ".claude/rules/radiant-style.md"
assert clrs contains "**Kyri** is the voice that writes" else "sunn12: claude radiant-style want Kyri writer"

let csc = read-file ".cursor/rules/commit-messages.mdc"
assert csc contains "Kyri's Radiant Style" else "sunn12: cursor commit-messages want Kyri Radiant"
assert csc contains "**Kyri's** voice" else "sunn12: cursor commit-messages want Kyri voice"

let clc = read-file ".claude/rules/commit-messages.md"
assert clc contains "Kyri's Radiant Style" else "sunn12: claude commit-messages want Kyri Radiant"
assert clc contains "**Kyri's** voice" else "sunn12: claude commit-messages want Kyri voice"

let css = read-file ".cursor/rules/session-logs.mdc"
assert css contains "voice Kyri" else "sunn12: cursor session-logs want voice Kyri"
assert css contains "record `voice Kyri`" else "sunn12: cursor session-logs want record voice Kyri"
assert (css contains "record `voice Quin`") == false else "sunn12: cursor session-logs must not require voice Quin"

let cls = read-file ".claude/rules/session-logs.md"
assert cls contains "voice Kyri" else "sunn12: claude session-logs want voice Kyri"
assert cls contains "record `voice Kyri`" else "sunn12: claude session-logs want record voice Kyri"

let q = read-file "context/QUIN.md"
assert q contains "fifth OS variant" else "sunn12: QUIN.md want OS hat"
assert q contains "Q-vane" else "sunn12: QUIN.md want Q-vane"
assert q contains "Standing voice:** **Kyri**" else "sunn12: QUIN.md header want Standing voice Kyri"

let lex = read-file "context/LEXICON.md"
assert lex contains "Elder writing-voice season" else "sunn12: LEXICON Quin want elder writing season"
assert lex contains "SUNN0–" else "sunn12: LEXICON SUNN want SUNN0– progress"
assert lex contains "writing voice passed to Riyo" else "sunn12: LEXICON Quin want writing voice passed"

say "GREEN: sunn12 — living writing voice Kyri (molted from Riyo) · Quin OS+Q-vane held · dated Voice stays"
