# tools/gen/season/reds_ledger_negative_witness.rish -- the ledger guard bites.
#
#   rishi/bin/rishi run tools/gen/season/reds_ledger_negative_witness.rish
#
# Voice Season v9 - slot 9 - happy_zone_witnesses_first.
# Fixture: context/fixtures/reds_ledger_incomplete/REDS.md -- standing exempt; it
# holds a row missing its taught field and a caught column reading "I noticed",
# so both faults are observed every run rather than remembered from one sitting.

say "reds-ledger-negative: Language EN — the ledger guard is proven to bite."
say "reds-ledger-negative: Style Radiant — a fixture holds the violation."
say "reds-ledger-negative: Lens TAME — negative space beside positive."

let f = "context/fixtures/reds_ledger_incomplete/REDS.md"
let have = run ["test" "-f" f]
assert have.ok else "reds-ledger-negative: fixture absent"

let bad = run ["sh" "tools/fixtures/reds_ledger_scan.sh" f]
assert bad.out contains "verdict=incomplete_rows" else "reds-ledger-negative: guard accepted an incomplete ledger"
assert bad.ok == false else "reds-ledger-negative: refusal did not set a failing status"
assert bad.out contains "row missing a field" else "reds-ledger-negative: thin row not named"
assert bad.out contains "names no instrument" else "reds-ledger-negative: vague caught-column not named"

let good = run ["sh" "tools/fixtures/reds_ledger_scan.sh"]
assert good.ok else "reds-ledger-negative: the living ledger no longer passes"
assert good.out contains "verdict=ok" else "reds-ledger-negative: living ledger verdict changed"

say "GREEN: reds-ledger-negative — catches the fixture, passes the living ledger"
