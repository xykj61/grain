# tools/gen/season/equinox_ironbeetle_ep015_choir_witness.rish -- e72 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep015_choir_witness.rish

say "equinox-iron-ep015-choir: Language EN — IronBeetle ep015 seats nack proof in view change."
say "equinox-iron-ep015-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep015-choir: Lens TAME — e72 · ep015 · almanac seat 77 · ch5 13/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep015_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep015-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep015" else "equinox-iron-ep015-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep015-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep015-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep015-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep015_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep015-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep015-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep015-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep015_almanac.sh"]
assert almanac.ok else "equinox-iron-ep015-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep015-choir — ep015 · clean room · absent refuses · almanac seat 77 · ch5 13/16"
