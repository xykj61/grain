# tools/gen/season/equinox_tigerbeetle_dx_surface_witness.rish -- e56 TB DX surface.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_dx_surface_witness.rish
#
# Two TB DX leaves already GREEN alone must GREEN together. Almanac seat 61.
# Leaf witnesses only -- no nested choirs (avoids elder chains). Clean-room study.

say "equinox-tb-dx-surface: Language EN — two TB greens, one choir."
say "equinox-tb-dx-surface: Style Radiant — the DX surface holds as one."
say "equinox-tb-dx-surface: Lens TAME — e56 · almanac seat 61 · ch4 13/16."

# Limb 0 -- say why / comments (leaf)
let why = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_say_why_census_witness.rish"]
say why.out
assert why.ok else "equinox-tb-dx-surface: say-why limb failed"
assert why.out contains "GREEN: tb-say-why" else "equinox-tb-dx-surface: say-why not GREEN"

# Limb 1 -- say how / tests (leaf)
let how = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_say_how_census_witness.rish"]
say how.out
assert how.ok else "equinox-tb-dx-surface: say-how limb failed"
assert how.out contains "GREEN: tb-say-how" else "equinox-tb-dx-surface: say-how not GREEN"

# Refuse -- absent clone path
let refuse = run ["sh" "tools/fixtures/tigerbeetle_say_why_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-dx-surface: absent clone must fail"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-dx-surface: want CLONE=ABSENT"
assert refuse.out contains "verdict=absent" else "equinox-tb-dx-surface: want verdict=absent"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_dx_surface_almanac.sh"]
assert almanac.ok else "equinox-tb-dx-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-dx-surface — say-why · say-how choir · almanac seat 61"
