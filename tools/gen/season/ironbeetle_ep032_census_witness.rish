# tools/gen/season/ironbeetle_ep032_census_witness.rish -- e82 IronBeetle ep032.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep032_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep032: Language EN — programming integrated over time."
say "iron-ep032: Style Radiant — safety first, then speed, then delight."
say "iron-ep032: Lens TAME — e82 · clean-room study · almanac seat 87."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep032: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep032_census.sh"]
say census.out
assert census.ok else "iron-ep032: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep032: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep032: want verdict=ok"
assert census.out contains "EP032=yes" else "iron-ep032: ep032 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep032: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep032: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep032: teach limbs (values·safety·performance·experience) must be present"
assert census.out contains "RHYME=yes" else "iron-ep032: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep032: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep032: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep032 — honors·source·teach·rhyme·clean·matklad ok"
