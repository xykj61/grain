# tools/gen/season/oldness_census_witness.rish -- M3 oldness census home land.
#
#   rishi/bin/rishi run tools/gen/season/oldness_census_witness.rish

say "oldness-census: Language EN — control before living/dated totals."
say "oldness-census: Style Radiant — SAFE empty welcome; four fifths Tier 2."
say "oldness-census: Lens TAME — M3 home land · living header is the marker."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "oldness-census: census control must GREEN"
assert control.out contains "GREEN: census-control" else "oldness-census: want control GREEN"

let scan = run ["sh" "tools/fixtures/oldness_census_scan.sh"]
say scan.out
assert scan.ok else "oldness-census: scan must exit 0"
assert scan.out contains "control_gate=honored" else "oldness-census: want control_gate"
assert scan.out contains "oldness_living_control=honored" else "oldness-census: want living control"
assert scan.out contains "oldness_dated_control=honored" else "oldness-census: want dated control"
assert scan.out contains "oldness_safe=honored" else "oldness-census: want SAFE shape"
assert scan.out contains "oldness_safe_cycle=1" else "oldness-census: want cycle 1"
assert scan.out contains "oldness_safe_rows=0" else "oldness-census: want rows 0"
assert scan.out contains "tier2_band=four_fifths" else "oldness-census: want four fifths"
assert scan.out contains "oldness_census=ok" else "oldness-census: want ok"
assert scan.out contains "verdict=ok" else "oldness-census: want verdict=ok"

say "GREEN: oldness-census — control proven · SAFE 0/64 · four fifths Tier 2 · living header marker"
