# tools/gen/season/equinox_tigerbeetle_cache_surface_witness.rish -- e48 TB cache surface.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_cache_surface_witness.rish
#
# Three TB cache leaves already GREEN alone must GREEN together. Almanac seat 54.
# Leaf witnesses only -- no nested choirs (avoids elder chains). Clean-room study.

say "equinox-tb-cache-surface: Language EN — three TB greens, one choir."
say "equinox-tb-cache-surface: Style Radiant — the cache surface holds as one."
say "equinox-tb-cache-surface: Lens TAME — e48 · almanac seat 54 · ch4 6/16."

# Limb 0 -- cache invalidation / in-place (leaf)
let inplace = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_cache_inplace_census_witness.rish"]
say inplace.out
assert inplace.ok else "equinox-tb-cache-surface: inplace limb failed"
assert inplace.out contains "GREEN: tb-cache-inplace" else "equinox-tb-cache-surface: inplace not GREEN"

# Limb 1 -- shrink scope / POCPOU (leaf)
let shrink = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_shrink_scope_census_witness.rish"]
say shrink.out
assert shrink.ok else "equinox-tb-cache-surface: shrink limb failed"
assert shrink.out contains "GREEN: tb-shrink-scope" else "equinox-tb-cache-surface: shrink not GREEN"

# Limb 2 -- buffer bleeds / alloc grouping (leaf)
let bleeds = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_buffer_bleeds_census_witness.rish"]
say bleeds.out
assert bleeds.ok else "equinox-tb-cache-surface: bleeds limb failed"
assert bleeds.out contains "GREEN: tb-buffer-bleeds" else "equinox-tb-cache-surface: bleeds not GREEN"

# Refuse -- absent clone path (any of the three scans)
let refuse = run ["sh" "tools/fixtures/tigerbeetle_cache_inplace_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-cache-surface: absent clone must fail"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-cache-surface: want CLONE=ABSENT"
assert refuse.out contains "verdict=absent" else "equinox-tb-cache-surface: want verdict=absent"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_cache_surface_almanac.sh"]
assert almanac.ok else "equinox-tb-cache-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-cache-surface — inplace · shrink · bleeds choir · almanac seat 54"
