# tools/gen/season/equinox_e115_instrument_suite_witness.rish -- e115 suite seat.
#
#   rishi/bin/rishi run tools/gen/season/equinox_e115_instrument_suite_witness.rish
#
# Law: seat the suite; do not manufacture meters.

say "e115-instrument-suite: Language EN — the completion becomes findable."
say "e115-instrument-suite: Style Radiant — counsel proposes nothing further; the suite is the seat."
say "e115-instrument-suite: Lens TAME — e115 · instrument suite · almanac 119 · ch8 7/16."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "e115-instrument-suite: census control must GREEN"
assert control.out contains "GREEN: census-control" else "e115-instrument-suite: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "e115-instrument-suite: baton museum RED"
assert museum.out contains "census_breach_count=0" else "e115-instrument-suite: want breach 0"

let suite = run ["rishi/bin/rishi" "run" "tools/gen/season/instrument_suite_witness.rish"]
say suite.out
assert suite.ok else "e115-instrument-suite: standing suite RED"
assert suite.out contains "GREEN: instrument-suite" else "e115-instrument-suite: want suite GREEN"
assert suite.out contains "pass=10" else "e115-instrument-suite: want pass 10"
assert suite.out contains "fail=0" else "e115-instrument-suite: want fail 0"
assert suite.out contains "RED_manufactured_suite_pass" else "e115-instrument-suite: want prove-red"

let elder = run ["rishi/bin/rishi" "run" "tools/gen/season/equinox_e114_thing_not_name_witness.rish"]
say elder.out
assert elder.ok else "e115-instrument-suite: elder e114 RED"
assert elder.out contains "GREEN: e114-thing-not-name" else "e115-instrument-suite: want elder GREEN"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "e115-instrument-suite: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "e115-instrument-suite: want scope GREEN"

let scan = run ["sh" "tools/fixtures/equinox_e115_instrument_suite_scan.sh"]
say scan.out
assert scan.ok else "e115-instrument-suite: scan must exit 0"
assert scan.out contains "control_gate=honored" else "e115-instrument-suite: want control_gate"
assert scan.out contains "instruments_tracked=honored" else "e115-instrument-suite: want instruments"
assert scan.out contains "instrument_suite=honored" else "e115-instrument-suite: want suite honored"
assert scan.out contains "suite_pass=10" else "e115-instrument-suite: want suite_pass 10"
assert scan.out contains "suite_prove_red=honored" else "e115-instrument-suite: want prove-red"
assert scan.out contains "remaining=keaton_gated" else "e115-instrument-suite: want keaton_gated remainder"
assert scan.out contains "seat_128=reserved_close_choir" else "e115-instrument-suite: want 128"
assert scan.out contains "surface_count=6" else "e115-instrument-suite: want surface 6"
assert scan.out contains "fork_status=not_consumed" else "e115-instrument-suite: want fork waiting"
assert scan.out contains "e115_instrument_suite=ok" else "e115-instrument-suite: want e115 ok"
assert scan.out contains "verdict=ok" else "e115-instrument-suite: want verdict=ok"

say "GREEN: e115-instrument-suite — pass=10 · elder e114 · keaton-gated remainder · 128 reserved · census six · fork waiting · museum"
