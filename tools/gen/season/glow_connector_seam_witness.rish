# tools/gen/season/glow_connector_seam_witness.rish — Surface p5 · connector sketch pins
#
#   rishi/bin/rishi run tools/gen/season/glow_connector_seam_witness.rish
#
# Orientation only — does not open a Wayland window.

say "glow-connector: Language EN — values · Frame · Wayland hop named."
say "glow-connector: Style Radiant — sketch pins; refuse invent stack."
say "glow-connector: Lens TAME — Surface Season p5."

let sketch = run ["test" "-f" "counsel/20260728-195456_surface-season-p5-glow-connector-seam-sketch.md"]
assert sketch.ok else "glow-connector: p5 sketch counsel missing"

let seed = run ["test" "-f" "brushstroke/wayland_seed.rye"]
assert seed.ok else "glow-connector: wayland_seed.rye missing"

let desk = run ["test" "-f" "src/lib/gate-surface-double-u32.glow"]
assert desk.ok else "glow-connector: first-resident double desk missing"
let desk2 = run ["test" "-f" "src/lib/gate-surface-inc-u32.glow"]
assert desk2.ok else "glow-connector: first-resident inc desk missing"
let desk3 = run ["test" "-f" "src/sur/shape-surface-count.glow"]
assert desk3.ok else "glow-connector: first-resident sur pedestal missing"
let desk4 = run ["test" "-f" "src/til/tilak-root-count.glow"]
assert desk4.ok else "glow-connector: first-resident til pedestal missing"

let ledger = run ["test" "-f" "counsel/20260728-195228_surface-season-p4-river-zig-wayland-study-ledger.md"]
assert ledger.ok else "glow-connector: p4 Wayland ledger missing"

let hygiene = run ["test" "-f" "tools/gen/season/glow_hygiene_pin.rish"]
assert hygiene.ok else "glow-connector: glow hygiene pin missing"

let brush = run ["test" "-f" "brushstroke/seed-frame.brush"]
assert brush.ok else "glow-connector: thin .brush fixture missing"

say "GREEN: glow-connector — sketch · seed · first-resident · ledger · hygiene · .brush pins present"
say "GREEN: glow-connector — Glow never speaks Wayland; Frame is the glass contract."
