# tools/gen/season/ironbeetle_ep008_census_witness.rish -- e65 IronBeetle ep008.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep008_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep008: Language EN — everyone gets to be a dictator."
say "iron-ep008: Style Radiant — many ballots; one truth."
say "iron-ep008: Lens TAME — e65 · clean-room study · almanac seat 70."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep008: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep008_census.sh"]
say census.out
assert census.ok else "iron-ep008: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep008: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep008: want verdict=ok"
assert census.out contains "EP008=yes" else "iron-ep008: ep008 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep008: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep008: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep008: teach limbs (dictator·FLP·ballot·quorum) must be present"
assert census.out contains "RHYME=yes" else "iron-ep008: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep008: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep008: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep008 — honors·source·teach·rhyme·clean·matklad ok"
