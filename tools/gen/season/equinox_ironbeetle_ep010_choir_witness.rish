# tools/gen/season/equinox_ironbeetle_ep010_choir_witness.rish -- e67 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep010_choir_witness.rish

say "equinox-iron-ep010-choir: Language EN — IronBeetle ep010 seats the storage fault model."
say "equinox-iron-ep010-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep010-choir: Lens TAME — e67 · ep010 · almanac seat 72 · ch5 8/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep010_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep010-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep010" else "equinox-iron-ep010-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep010-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep010-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep010-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep010_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep010-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep010-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep010-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep010_almanac.sh"]
assert almanac.ok else "equinox-iron-ep010-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep010-choir — ep010 · clean room · absent refuses · almanac seat 72 · ch5 8/16"
