# tools/gen/season/oven_season_o3_witness.rish — Kiln Season o3 inference plan retarget.
#
#   rishi/bin/rishi run tools/gen/season/oven_season_o3_witness.rish

say "kiln-season-o3: Language EN — close the residual queue."
say "kiln-season-o3: Style Radiant — retarget the plan; refuse fossil rewrite."
say "kiln-season-o3: Lens TAME — Kiln Season o3."

let counsel = run ["test" "-f" "counsel/date/20260729/20260729-000258_oven-season-o3-inference-plan-retarget.md"]
assert counsel.ok else "kiln-season-o3: o3 counsel missing"

let plan = run ["sh" "-c" "grep -q 'kiln/' expanding-prompts/yonder/20260710-133500_inference-stack-lap0.md && grep -q 'oven_corpus_lap1' expanding-prompts/yonder/20260710-133500_inference-stack-lap0.md && ! grep -q '\`anvil/\`' expanding-prompts/yonder/20260710-133500_inference-stack-lap0.md && echo PLAN_OK"]
assert plan.ok else "kiln-season-o3: inference plan scan failed"
assert plan.out contains "PLAN_OK" else "kiln-season-o3: plan still names anvil/ as living step"

let path = run ["sh" "-c" "test -d kiln && test ! -d anvil && echo PATH_OK"]
assert path.ok else "kiln-season-o3: path state broken"
assert path.out contains "PATH_OK" else "kiln-season-o3: kiln/ LIVE expected"

say "GREEN: kiln-season-o3 — inference plan kiln/ · path LIVE · Kiln Season"
say "GREEN: kiln-season-o3 — path-residual queue empty."
