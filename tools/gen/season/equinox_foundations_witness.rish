# tools/gen/season/equinox_foundations_witness.rish -- e8 foundations join the map.
#
#   rishi/bin/rishi run tools/gen/season/equinox_foundations_witness.rish

say "equinox-foundations: Language EN — twelve laws, three per equinox."
say "equinox-foundations: Style Radiant — the map and the wheel agree as data."
say "equinox-foundations: Lens TAME — e8 · Glow=code · Brix=data."

let present = run ["test" "-f" "context/equinox_foundations.brix"]
assert present.ok else "equinox-foundations: descriptor missing"
let map = run ["test" "-f" "context/equinox_map.brix"]
assert map.ok else "equinox-foundations: equinox_map.brix missing"

let scan = run ["sh" "tools/fixtures/equinox_foundations_scan.sh" "context/equinox_foundations.brix" "context/equinox_map.brix"]
say scan.out
assert scan.ok else "equinox-foundations: canon scan failed"
assert scan.out contains "verdict=ok" else "equinox-foundations: canon not ok"

let bad_home = run ["sh" "tools/fixtures/equinox_foundations_scan.sh" "tools/fixtures/equinox_foundations_bad_wrong_home.brix" "context/equinox_map.brix"]
assert bad_home.ok == false else "equinox-foundations: wrong-home fixture must fail"
assert bad_home.out contains "verdict=foundations_unlawful" else "equinox-foundations: wrong-home wrong verdict"

let bad_miss = run ["sh" "tools/fixtures/equinox_foundations_scan.sh" "tools/fixtures/equinox_foundations_bad_missing.brix" "context/equinox_map.brix"]
assert bad_miss.ok == false else "equinox-foundations: missing-house fixture must fail"
assert bad_miss.out contains "verdict=foundations_unlawful" else "equinox-foundations: missing-house wrong verdict"

let almanac = run ["sh" "tools/gen/season/equinox_foundations_almanac.sh"]
assert almanac.ok else "equinox-foundations: almanac append failed"
say almanac.out

say "GREEN: equinox-foundations — 12 houses · 3 per equinox · join map flanks · negatives bite"
