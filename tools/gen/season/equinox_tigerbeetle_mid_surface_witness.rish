# tools/gen/season/equinox_tigerbeetle_mid_surface_witness.rish -- e57 TB mid surface.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_mid_surface_witness.rish
#
# Cache three + off-by-one join GREEN together. Almanac seat 62.
# Leaf witnesses only -- no nested choirs (avoids elder chains). Clean-room study.

say "equinox-tb-mid-surface: Language EN — four TB greens, one mid choir."
say "equinox-tb-mid-surface: Style Radiant — off-by-one joins the cache three."
say "equinox-tb-mid-surface: Lens TAME — e57 · almanac seat 62 · ch4 14/16."

# Limb 0 -- cache invalidation / in-place (leaf)
let inplace = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_cache_inplace_census_witness.rish"]
say inplace.out
assert inplace.ok else "equinox-tb-mid-surface: inplace limb failed"
assert inplace.out contains "GREEN: tb-cache-inplace" else "equinox-tb-mid-surface: inplace not GREEN"

# Limb 1 -- shrink scope / POCPOU (leaf)
let shrink = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_shrink_scope_census_witness.rish"]
say shrink.out
assert shrink.ok else "equinox-tb-mid-surface: shrink limb failed"
assert shrink.out contains "GREEN: tb-shrink-scope" else "equinox-tb-mid-surface: shrink not GREEN"

# Limb 2 -- buffer bleeds / alloc grouping (leaf)
let bleeds = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_buffer_bleeds_census_witness.rish"]
say bleeds.out
assert bleeds.ok else "equinox-tb-mid-surface: bleeds limb failed"
assert bleeds.out contains "GREEN: tb-buffer-bleeds" else "equinox-tb-mid-surface: bleeds not GREEN"

# Limb 3 -- off-by-one join (leaf)
let obo = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_off_by_one_census_witness.rish"]
say obo.out
assert obo.ok else "equinox-tb-mid-surface: off-by-one limb failed"
assert obo.out contains "GREEN: tb-off-by-one" else "equinox-tb-mid-surface: off-by-one not GREEN"

# Refuse -- absent clone path
let refuse = run ["sh" "tools/fixtures/tigerbeetle_off_by_one_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-mid-surface: absent clone must fail"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-mid-surface: want CLONE=ABSENT"
assert refuse.out contains "verdict=absent" else "equinox-tb-mid-surface: want verdict=absent"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_mid_surface_almanac.sh"]
assert almanac.ok else "equinox-tb-mid-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-mid-surface — inplace · shrink · bleeds · off-by-one choir · almanac seat 62"
