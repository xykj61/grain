# tools/gen/season/equinox_ironbeetle_ep033_choir_witness.rish -- e83 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep033_choir_witness.rish

say "equinox-iron-ep033-choir: Language EN — IronBeetle ep033 seats prefetch-before-execute batching."
say "equinox-iron-ep033-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep033-choir: Lens TAME — e83 · ep033 · almanac seat 88 · ch6 8/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep033_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep033-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep033" else "equinox-iron-ep033-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep033-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep033-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep033-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep033_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep033-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep033-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep033-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep033_almanac.sh"]
assert almanac.ok else "equinox-iron-ep033-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep033-choir — ep033 · clean room · absent refuses · almanac seat 88 · ch6 8/16"
