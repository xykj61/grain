# tools/gen/season/equinox_ironbeetle_ep014_choir_witness.rish -- e71 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep014_choir_witness.rish

say "equinox-iron-ep014-choir: Language EN — IronBeetle ep014 seats graduated trust for headers."
say "equinox-iron-ep014-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep014-choir: Lens TAME — e71 · ep014 · almanac seat 76 · ch5 12/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep014_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep014-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep014" else "equinox-iron-ep014-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep014-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep014-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep014-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep014_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep014-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep014-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep014-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep014_almanac.sh"]
assert almanac.ok else "equinox-iron-ep014-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep014-choir — ep014 · clean room · absent refuses · almanac seat 76 · ch5 12/16"
