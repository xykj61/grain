# tools/gen/season/equinox_e121_roots_bench_amend_witness.rish -- e121 seat.
#   rishi/bin/rishi run tools/gen/season/equinox_e121_roots_bench_amend_witness.rish
say "e121-roots-bench-amend: Language EN — roots touch the tree; a bench is a raised root."
say "e121-roots-bench-amend: Style Radiant — only a bench runs witnesses; name the root."
say "e121-roots-bench-amend: Lens TAME — e121 · Lexicon amend · almanac 125 · ch8 13/16."

let green = run ["sh" "tools/fixtures/equinox_e121_roots_bench_amend_scan.sh"]
assert green.ok else "e121-roots-bench-amend: living scan must exit 0"
assert green.out contains "roots=honored" else "e121-roots-bench-amend: want roots honored"
assert green.out contains "bench_kinship=honored" else "e121-roots-bench-amend: want bench kinship"
assert green.out contains "framework" else "e121-roots-bench-amend: want framework member"
assert green.out contains "seat_128=reserved_close_choir" else "e121-roots-bench-amend: want 128 reserved"
assert green.out contains "verdict=ok" else "e121-roots-bench-amend: want verdict ok"

let red = run ["sh" "tools/fixtures/equinox_e121_roots_bench_amend_scan.sh" "prove-red"]
assert (red.ok == false) else "e121-roots-bench-amend: prove-red must refuse"
assert red.out contains "RED_claimed_bench_not_raised_root" else "e121-roots-bench-amend: prove-red want kinship refuse"

say "GREEN: e121-roots-bench-amend — roots amended · bench = raised root · shred RED"
