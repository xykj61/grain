# tools/gen/season/ironbeetle_ep009_census_witness.rish -- e66 IronBeetle ep009.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep009_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep009: Language EN — a ledger that remembers its own parent."
say "iron-ep009: Style Radiant — hash-chained prepares; views ratchet forward."
say "iron-ep009: Lens TAME — e66 · clean-room study · almanac seat 71."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep009: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep009_census.sh"]
say census.out
assert census.ok else "iron-ep009: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep009: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep009: want verdict=ok"
assert census.out contains "EP009=yes" else "iron-ep009: ep009 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep009: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep009: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep009: teach limbs (parent·hash·prepare·view) must be present"
assert census.out contains "RHYME=yes" else "iron-ep009: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep009: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep009: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep009 — honors·source·teach·rhyme·clean·matklad ok"
