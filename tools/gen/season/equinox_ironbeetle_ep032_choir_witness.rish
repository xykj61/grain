# tools/gen/season/equinox_ironbeetle_ep032_choir_witness.rish -- e82 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep032_choir_witness.rish

say "equinox-iron-ep032-choir: Language EN — IronBeetle ep032 seats safety·performance·experience order."
say "equinox-iron-ep032-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep032-choir: Lens TAME — e82 · ep032 · almanac seat 87 · ch6 7/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep032_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep032-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep032" else "equinox-iron-ep032-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep032-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep032-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep032-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep032_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep032-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep032-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep032-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep032_almanac.sh"]
assert almanac.ok else "equinox-iron-ep032-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep032-choir — ep032 · clean room · absent refuses · almanac seat 87 · ch6 7/16"
