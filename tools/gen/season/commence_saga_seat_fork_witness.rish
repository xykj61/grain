# tools/gen/season/commence_saga_seat_fork_witness.rish -- e101 / saga seated + fork.
#
#   rishi/bin/rishi run tools/gen/season/commence_saga_seat_fork_witness.rish
#
# Seats the commence-arc prose saga behind proven control.
# Does not consume return_surface_p59. Invent none. Almanac seat 105 via choir.

say "commence-saga-seat: Language EN — control first; then seating on Keaton approve."
say "commence-saga-seat: Style Radiant — M8 witness complements narrative; fork waits."
say "commence-saga-seat: Lens TAME — e101 · saga Seated · fork named · almanac seat 105 · ch7 9/16."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "commence-saga-seat: census control must GREEN before seating"
assert control.out contains "GREEN: census-control" else "commence-saga-seat: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "commence-saga-seat: baton museum RED"
assert museum.out contains "census_breach_count=0" else "commence-saga-seat: want breach 0"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "commence-saga-seat: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "commence-saga-seat: want scope GREEN"

let scan = run ["sh" "tools/fixtures/commence_saga_seat_fork_scan.sh"]
say scan.out
assert scan.ok else "commence-saga-seat: seat fork scan must exit 0"
assert scan.out contains "control_gate=honored" else "commence-saga-seat: want control_gate"
assert scan.out contains "seat_saga=honored" else "commence-saga-seat: want seat_saga"
assert scan.out contains "seat_saga_status=SEATED" else "commence-saga-seat: want SEATED"
assert scan.out contains "seat_m9=honored" else "commence-saga-seat: want m9 complement"
assert scan.out contains "seat_fork=honored" else "commence-saga-seat: want fork"
assert scan.out contains "seat_fork_status=not_consumed" else "commence-saga-seat: want fork unconsumed"
assert scan.out contains "seat_almanac=honored" else "commence-saga-seat: want almanac"
assert scan.out contains "seat_shelf_end=ep045" else "commence-saga-seat: want shelf end"
assert scan.out contains "seat_ep046=absent" else "commence-saga-seat: want ep046 absent"
assert scan.out contains "e101_saga_seat_fork=ok" else "commence-saga-seat: want e101 ok"
assert scan.out contains "verdict=ok" else "commence-saga-seat: want verdict=ok"

say "GREEN: commence-saga-seat — control proven · saga SEATED · M9 complement · fork waiting · seats 97-104 · shelf end · museum"
