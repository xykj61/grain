# tools/gen/season/equinox_tend_hygiene_choir_witness.rish -- e31 tend_hygiene -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tend_hygiene_choir_witness.rish

say "equinox-tend-hygiene-choir: Language EN — measure without inventing; refuse a missing hall."
say "equinox-tend-hygiene-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tend-hygiene-choir: Lens TAME — e31 · tend_hygiene · almanac seat 37."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tend_hygiene_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tend-hygiene-choir: welcome RED"
assert welcome.out contains "GREEN: tend-hygiene-census" else "equinox-tend-hygiene-choir: welcome missing GREEN"
assert welcome.out contains "tend_waymarks=3" else "equinox-tend-hygiene-choir: want three waymarks"

let refuse = run ["sh" "tools/fixtures/tend_hygiene_census.sh" "tools/fixtures/tend_hygiene_ABSENT.brix"]
say refuse.out
assert refuse.ok == false else "equinox-tend-hygiene-choir: absent shape must fail"
assert refuse.out contains "verdict=missing_shape" else "equinox-tend-hygiene-choir: want missing_shape"

let almanac = run ["sh" "tools/gen/season/equinox_tend_hygiene_choir_almanac.sh"]
assert almanac.ok else "equinox-tend-hygiene-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tend-hygiene-choir — zero-code · three tends · missing_shape refuse · almanac seat 37"
