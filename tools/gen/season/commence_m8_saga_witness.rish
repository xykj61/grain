# tools/gen/season/commence_m8_saga_witness.rish -- commence M8 / e99.
#
#   rishi/bin/rishi run tools/gen/season/commence_m8_saga_witness.rish
#
# Measured commence-arc saga behind the proven census control.
# Saga != see != weave. Invent none. Leaf only. Almanac seat 103 via choir.

say "commence-m8: Language EN — control first; then the ordered saga on disk."
say "commence-m8: Style Radiant — story from waymarks and seats; invent none."
say "commence-m8: Lens TAME — e99 · commence M8 saga · almanac seat 103 · ch7 7/16."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "commence-m8: census control must GREEN before saga"
assert control.out contains "GREEN: census-control" else "commence-m8: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "commence-m8: baton museum RED"
assert museum.out contains "census_breach_count=0" else "commence-m8: want breach 0"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "commence-m8: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "commence-m8: want scope GREEN"

let scan = run ["sh" "tools/fixtures/commence_m8_saga_scan.sh"]
say scan.out
assert scan.ok else "commence-m8: m8 saga scan must exit 0"
assert scan.out contains "control_gate=honored" else "commence-m8: want control_gate"
assert scan.out contains "saga_home=honored" else "commence-m8: want saga_home"
assert scan.out contains "saga_chain=honored" else "commence-m8: want saga_chain"
assert scan.out contains "saga_beats=8" else "commence-m8: want 8 beats"
assert scan.out contains "saga_almanac=honored" else "commence-m8: want saga_almanac"
assert scan.out contains "saga_shelf_end=ep045" else "commence-m8: want shelf end"
assert scan.out contains "saga_ep046=absent" else "commence-m8: want ep046 absent"
assert scan.out contains "saga_story=" else "commence-m8: want saga_story"
assert scan.out contains "verdict=ok" else "commence-m8: want verdict=ok"

say "GREEN: commence-m8 — control proven · saga home · 8 beats · seats 97-102 · shelf end · museum"
