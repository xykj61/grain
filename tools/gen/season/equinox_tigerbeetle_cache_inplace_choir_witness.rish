# tools/gen/season/equinox_tigerbeetle_cache_inplace_choir_witness.rish -- e45 -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_cache_inplace_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-cache-inplace-choir: Language EN — cache invalidation; refuse an absent clone."
say "equinox-tb-cache-inplace-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-cache-inplace-choir: Lens TAME — e45 · in-place · almanac seat 51."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_cache_inplace_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-cache-inplace-choir: welcome RED"
assert welcome.out contains "GREEN: tb-cache-inplace" else "equinox-tb-cache-inplace-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_CACHE=yes" else "equinox-tb-cache-inplace-choir: want GUIDE_CACHE"
assert welcome.out contains "GUIDE_INPLACE=yes" else "equinox-tb-cache-inplace-choir: want GUIDE_INPLACE"
assert welcome.out contains "TAME_CACHE=yes" else "equinox-tb-cache-inplace-choir: want TAME_CACHE"
assert welcome.out contains "ELDER_HOW=yes" else "equinox-tb-cache-inplace-choir: want ELDER_HOW"

let refuse = run ["sh" "tools/fixtures/tigerbeetle_cache_inplace_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-cache-inplace-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-cache-inplace-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-cache-inplace-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_cache_inplace_almanac.sh"]
assert almanac.ok else "equinox-tb-cache-inplace-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-cache-inplace-choir — cache invalidation · in-place · elder how · absent refuses · almanac seat 51"
