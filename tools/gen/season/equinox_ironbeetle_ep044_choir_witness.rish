# tools/gen/season/equinox_ironbeetle_ep044_choir_witness.rish -- e93 -> almanac ch7 open.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep044_choir_witness.rish

say "equinox-iron-ep044-choir: Language EN — IronBeetle ep044 opens chapter seven from metal."
say "equinox-iron-ep044-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep044-choir: Lens TAME — e93 · ep044 · almanac seat 97 · ch7 open · e76 law."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep044_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep044-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep044" else "equinox-iron-ep044-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep044-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep044-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep044-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep044_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep044-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep044-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep044-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep044_almanac.sh"]
assert almanac.ok else "equinox-iron-ep044-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep044-choir — ep044 · clean room · absent refuses · almanac seat 97 · ch7 open"
