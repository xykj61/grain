# tools/gen/season/equinox_tigerbeetle_shrink_scope_choir_witness.rish -- e46 -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_shrink_scope_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-shrink-scope-choir: Language EN — shrink scope; refuse an absent clone."
say "equinox-tb-shrink-scope-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-shrink-scope-choir: Lens TAME — e46 · POCPOU · almanac seat 52."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_shrink_scope_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-shrink-scope-choir: welcome RED"
assert welcome.out contains "GREEN: tb-shrink-scope" else "equinox-tb-shrink-scope-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_SHRINK=yes" else "equinox-tb-shrink-scope-choir: want GUIDE_SHRINK"
assert welcome.out contains "GUIDE_POCPOU=yes" else "equinox-tb-shrink-scope-choir: want GUIDE_POCPOU"
assert welcome.out contains "TAME_SHRINK=yes" else "equinox-tb-shrink-scope-choir: want TAME_SHRINK"
assert welcome.out contains "ELDER_CACHE=yes" else "equinox-tb-shrink-scope-choir: want ELDER_CACHE"

let refuse = run ["sh" "tools/fixtures/tigerbeetle_shrink_scope_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-shrink-scope-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-shrink-scope-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-shrink-scope-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_shrink_scope_almanac.sh"]
assert almanac.ok else "equinox-tb-shrink-scope-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-shrink-scope-choir — shrink scope · POCPOU · elder cache · absent refuses · almanac seat 52"
