# tools/gen/season/vols_survey_witness.rish -- CION VOLS Journey 13, the derived survey census.
#
#   rishi/bin/rishi run tools/gen/season/vols_survey_witness.rish
#
# Proves the survey census (tools/fixtures/vols_survey_scan.sh) is complete BY
# CONSTRUCTION and honest about the testimony boundary -- the crux of Journey 13's r1.
# Where the module labeling guard scans a hand-listed set, this scan DERIVES its input
# from the tree, so a capability born tomorrow appears without anyone editing the tool.
#
# The controlled fixture tree (tools/fixtures/vols_survey_tree/) holds four files:
#   livemod/README.md   -- a living README naming a capability by a bare "lap <N>"
#                          ordinal (a SITE -- <N> a placeholder for the biting shape)
#   livemod/core.rye    -- a clean authored surface (no bare ordinal)
#   livemod/notes.glow  -- permitted schemes only ("lap 4b", "sub-lap 2") -- NOT a site
#   session-logs/...     -- dated testimony carrying a bare "lap <N>" ordinal -- EXCLUDED
#
# Design: active-designing/date/20260812/20260812-215153_vols-journey13-survey-complete-census-exploration.md
# Law:    context/specs/20260810-222755_chronological-semantic-labeling-and-the-cion-meta-season.md
# Output convention: context/specs/20260729-215600_scan-seam-convention.md.

say "vols-survey: Language EN — CION VOLS Journey 13 r1, the derived survey census."
say "vols-survey: Style Radiant — name every living site, keep faith with every ordinal history earned."
say "vols-survey: Lens TAME — the input set is derived, not hand-listed; the testimony boundary holds; two tools give one count."

# The census runs completely over the derived fixture set and reports honest totals.
let survey = run ["sh" "tools/fixtures/vols_survey_scan.sh" "tools/fixtures/vols_survey_tree"]
say survey.out
assert survey.out contains "verdict=ok" else "vols-survey: the census did not run completely"
assert survey.ok else "vols-survey: census verdict and status disagree"

# Completeness -- the three living surfaces are counted (README, core.rye, notes.glow);
# the dated session log is excluded structurally, so it is not among them.
assert survey.out contains "surfaces=3" else "vols-survey: the derived surface count is wrong — a living surface was missed or testimony leaked in"

# The one site is the living README naming a capability by a bare lap ordinal, and only it.
assert survey.out contains "sites=1" else "vols-survey: the site count is wrong"
assert survey.out contains "site=tools/fixtures/vols_survey_tree/livemod/README.md lap_ordinal=1" else "vols-survey: the README site was not named"

# The permitted schemes stay uncounted -- notes.glow's "lap 4b" and "sub-lap 2" are the
# law's meaningful codes, never a bare identity; the census must not flag them.
assert survey.out contains "hits=1" else "vols-survey: a permitted code (lap 4b / sub-lap) was miscounted as a bare ordinal"

# Two tools, one answer -- an independent grep -r traversal (not the scan's find-loop)
# over the same derived set, excluding the testimony dir, counts the identical hit.
let cross = run ["sh" "tools/fixtures/vols_survey_crosscount.sh" "tools/fixtures/vols_survey_tree"]
say "vols-survey: independent grep -r cross-check —"
say cross.out
assert cross.out contains "crosshits=1" else "vols-survey: the independent measure disagrees with the census hit count"
assert cross.ok else "vols-survey: cross-count verdict and status disagree"

# The testimony boundary bites -- planting a bare ordinal INSIDE the session log must not
# raise the census (the log is excluded whether or not it carries an ordinal).
let boundary = run ["sh" "-c" "grep -c 'lap [0-9]' tools/fixtures/vols_survey_tree/session-logs/20260101-000000_x.rish | tr -d ' '"]
say "vols-survey: testimony fixture carries a planted ordinal (excluded anyway) —"
say boundary.out
assert boundary.out contains "1" else "vols-survey: the testimony fixture lost its planted ordinal"
# ...and the census still reports exactly one site, proving the excluded log never counted.

# Report the LIVE source-tree census informationally -- the real map LOWE will relabel
# against. Not asserted to zero: a survey names the work; the seal proves it done.
let live = run ["sh" "tools/fixtures/vols_survey_scan.sh" "."]
let live_totals = run ["sh" "-c" "sh tools/fixtures/vols_survey_scan.sh . | grep -E '^(surfaces|sites|hits)='"]
say "vols-survey: live source-tree census —"
say live_totals.out
assert live.out contains "verdict=ok" else "vols-survey: the live census did not run completely"
assert live.ok else "vols-survey: the live census verdict and status disagree"

say "GREEN: vols-survey — the census derives its input from the tree, excludes dated testimony, keeps faith with permitted codes, and agrees with an independent count; the live source-tree map is reported for LOWE to relabel against"
