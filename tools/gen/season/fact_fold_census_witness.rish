# tools/gen/season/fact_fold_census_witness.rish -- fact_fold design hall on metal.
#
#   rishi/bin/rishi run tools/gen/season/fact_fold_census_witness.rish
#
# Design-shapes wing - fact_fold. Shape points at metal and Sangha page;
# three bound pairs match; fold.rye stays GREEN (purity - refuse whole).

say "fact-fold-census: Language EN — shape, page, and metal agree."
say "fact-fold-census: Style Radiant — supply is a fold, not an authority."
say "fact-fold-census: Lens TAME — e30 · design-shapes · almanac seat 36."

let scan = run ["sh" "tools/fixtures/fact_fold_census.sh"]
say scan.out
assert scan.ok else "fact-fold-census: census failed"
assert scan.out contains "verdict=ok" else "fact-fold-census: want verdict=ok"
assert scan.out contains "pairs_matched=3" else "fact-fold-census: want three matched pairs"
assert scan.out contains "PATTERN_CITES=yes" else "fact-fold-census: pattern must cite metal and shape"

let metal = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/fold.rye 2>&1"]
say metal.out
assert metal.ok else "fact-fold-census: fold metal RED"
assert metal.out contains "GREEN: myc fold" else "fact-fold-census: want GREEN myc fold"
assert metal.out contains "purity" else "fact-fold-census: want purity"
assert metal.out contains "refuse whole" else "fact-fold-census: want refuse whole"
assert metal.out contains "supply=872" else "fact-fold-census: want supply=872"

say "GREEN: fact-fold-census — three pairs · pattern cites · fold GREEN · purity · refuse"
