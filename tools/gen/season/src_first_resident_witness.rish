# tools/gen/season/src_first_resident_witness.rish — Surface · first residents in src/
#
#   rishi/bin/rishi run tools/gen/season/src_first_resident_witness.rish
#
# Routine name: first resident. Easter-egg alias: src_vegan_dogfood_witness.rish
# Rooms: src/lib bartises · src/sur structure pedestal

say "first-resident: Language EN — Glow desks that live in src/."
say "first-resident: Style Radiant — prove the desks; refuse shred."
say "first-resident: Lens TAME — Surface Season p20."

let zig = "vendor/zig-toolchain/zig"

say "first-resident: lib double..."
let ddesk = "src/lib/gate-surface-double-u32.glow"
let dgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" ddesk "21"]
assert dgate.ok else "first-resident: double lower/build/run failed"
assert dgate.out contains "EXIT:0" else "first-resident: double did not exit 0"
let danswer = run ["./glow/bin/gate-surface-double-u32" "21"]
assert danswer.ok else "first-resident: double binary refused sample"
let dbad = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" ddesk "21" "9"]
assert dbad.out contains "FAIL" else "first-resident: double should refuse second sample"

say "first-resident: lib inc..."
let idesk = "src/lib/gate-surface-inc-u32.glow"
let igate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" idesk "21"]
assert igate.ok else "first-resident: inc lower/build/run failed"
assert igate.out contains "EXIT:0" else "first-resident: inc did not exit 0"
let ianswer = run ["./glow/bin/gate-surface-inc-u32" "21"]
assert ianswer.ok else "first-resident: inc binary refused sample"
let ibad = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" idesk "21" "9"]
assert ibad.out contains "FAIL" else "first-resident: inc should refuse second sample"

say "first-resident: sur surface-count pedestal..."
let sdesk = "src/sur/shape-surface-count.glow"
let placard = run ["sh" "-c" "head -n 7 src/sur/shape-surface-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "first-resident: sur placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "first-resident: sur placard missing six lines"
let sgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" sdesk]
assert sgate.ok else "first-resident: sur shape lower/build/run failed"
assert sgate.out contains "EXIT:0" else "first-resident: sur shape did not exit 0"

say "first-resident: sur frame-max-lines pedestal..."
let fdesk = "src/sur/shape-frame-max-lines.glow"
let fplacard = run ["sh" "-c" "head -n 7 src/sur/shape-frame-max-lines.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert fplacard.ok else "first-resident: sur frame placard scan failed"
let fcount = trim fplacard.out
assert fcount == "6" else "first-resident: sur frame placard missing six lines"
let fbound = run ["sh" "-c" "grep -q 'example    8' src/sur/shape-frame-max-lines.glow && grep -q 'max_lines' src/sur/shape-frame-max-lines.glow && grep -q 'seed.rye' src/sur/shape-frame-max-lines.glow && grep -q 'wayland_seed.rye' src/sur/shape-frame-max-lines.glow && echo BOUND_OK"]
assert fbound.ok else "first-resident: sur frame bound notes scan failed"
assert fbound.out contains "BOUND_OK" else "first-resident: sur frame max_lines=8 not named"
let fgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" fdesk]
assert fgate.ok else "first-resident: sur frame shape lower/build/run failed"
assert fgate.out contains "EXIT:0" else "first-resident: sur frame shape did not exit 0"

say "first-resident: sur frame-seed-line-count pedestal..."
let ldesk = "src/sur/shape-frame-seed-line-count.glow"
let lplacard = run ["sh" "-c" "head -n 7 src/sur/shape-frame-seed-line-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert lplacard.ok else "first-resident: sur seed-lines placard scan failed"
let lcount = trim lplacard.out
assert lcount == "6" else "first-resident: sur seed-lines placard missing six lines"
let lnotes = run ["sh" "-c" "grep -q 'example    3' src/sur/shape-frame-seed-line-count.glow && grep -q 'seed.rye' src/sur/shape-frame-seed-line-count.glow && grep -q 'seed-frame.brush' src/sur/shape-frame-seed-line-count.glow && echo SEED_OK"]
assert lnotes.ok else "first-resident: sur seed-lines notes scan failed"
assert lnotes.out contains "SEED_OK" else "first-resident: sur seed Frame three lines not named"
let lgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" ldesk]
assert lgate.ok else "first-resident: sur seed-lines shape lower/build/run failed"
assert lgate.out contains "EXIT:0" else "first-resident: sur seed-lines shape did not exit 0"

say "first-resident: til tilak-root-count..."
let tdesk = "src/til/tilak-root-count.glow"
let tplacard = run ["sh" "-c" "head -n 7 src/til/tilak-root-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert tplacard.ok else "first-resident: til placard scan failed"
let tcount = trim tplacard.out
assert tcount == "6" else "first-resident: til placard missing six lines"
let troots = run ["sh" "-c" "grep -q 'plain-bytes' src/til/tilak-root-count.glow && grep -q 'manifest' src/til/tilak-root-count.glow && grep -q '%tile' src/til/tilak-root-count.glow && echo ROOTS_OK"]
assert troots.ok else "first-resident: til roots/%tile notes missing"
assert troots.out contains "ROOTS_OK" else "first-resident: til roots not named"
let tgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" tdesk]
assert tgate.ok else "first-resident: til shape lower/build/run failed"
assert tgate.out contains "EXIT:0" else "first-resident: til shape did not exit 0"

say "first-resident: til manifest-field-count..."
let mdesk = "src/til/shape-manifest-field-count.glow"
let mplacard = run ["sh" "-c" "head -n 7 src/til/shape-manifest-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert mplacard.ok else "first-resident: til manifest placard scan failed"
let mcount = trim mplacard.out
assert mcount == "6" else "first-resident: til manifest placard missing six lines"
let mfields = run ["sh" "-c" "grep -q 'example    3' src/til/shape-manifest-field-count.glow && grep -q 'type-mark' src/til/shape-manifest-field-count.glow && grep -q 'digest' src/til/shape-manifest-field-count.glow && grep -q 'name' src/til/shape-manifest-field-count.glow && grep -q '%tile' src/til/shape-manifest-field-count.glow && echo FIELDS_OK"]
assert mfields.ok else "first-resident: til manifest fields scan failed"
assert mfields.out contains "FIELDS_OK" else "first-resident: til manifest three fields / %tile not named"
let mgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" mdesk]
assert mgate.ok else "first-resident: til manifest shape lower/build/run failed"
assert mgate.out contains "EXIT:0" else "first-resident: til manifest shape did not exit 0"

say "first-resident: app pool-agent-slot..."
let adesk = "src/app/shape-pool-agent-slot.glow"
let aplacard = run ["sh" "-c" "head -n 7 src/app/shape-pool-agent-slot.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert aplacard.ok else "first-resident: app placard scan failed"
let acount = trim aplacard.out
assert acount == "6" else "first-resident: app placard missing six lines"
let apool = run ["sh" "-c" "grep -q 'Pool' src/app/shape-pool-agent-slot.glow && grep -q 'Gall-role' src/app/shape-pool-agent-slot.glow && grep -q 'TUBE' src/app/shape-pool-agent-slot.glow && grep -q 'pond/apps' src/app/shape-pool-agent-slot.glow && echo POOL_OK"]
assert apool.ok else "first-resident: app Pool/TUBE notes scan failed"
assert apool.out contains "POOL_OK" else "first-resident: app Pool · Gall · TUBE · pond/apps not named"
let agate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" adesk]
assert agate.ok else "first-resident: app shape lower/build/run failed"
assert agate.out contains "EXIT:0" else "first-resident: app shape did not exit 0"

say "first-resident: app tube0-manifest-field-count..."
let udesk = "src/app/shape-tube0-manifest-field-count.glow"
let uplacard = run ["sh" "-c" "head -n 7 src/app/shape-tube0-manifest-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert uplacard.ok else "first-resident: app tube0 placard scan failed"
let ucount = trim uplacard.out
assert ucount == "6" else "first-resident: app tube0 placard missing six lines"
let ufields = run ["sh" "-c" "grep -q 'example    4' src/app/shape-tube0-manifest-field-count.glow && grep -q 'name' src/app/shape-tube0-manifest-field-count.glow && grep -q 'version' src/app/shape-tube0-manifest-field-count.glow && grep -q 'capabilities' src/app/shape-tube0-manifest-field-count.glow && grep -q 'iteration-bound' src/app/shape-tube0-manifest-field-count.glow && grep -q 'APK' src/app/shape-tube0-manifest-field-count.glow && echo TUBE0_OK"]
assert ufields.ok else "first-resident: app tube0 fields scan failed"
assert ufields.out contains "TUBE0_OK" else "first-resident: app tube0 four fields / APK refuse not named"
let ugate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" udesk]
assert ugate.ok else "first-resident: app tube0 shape lower/build/run failed"
assert ugate.out contains "EXIT:0" else "first-resident: app tube0 shape did not exit 0"

say "GREEN: first-resident — lib · sur×3 · til×2 · app×2 · Surface p20"
say "GREEN: first-resident — Glow userland desks live at home first."

