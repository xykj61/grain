assert rrings.ok else "first-resident: sec mand rings scan failed"
assert rrings.out contains "MAND_OK" else "first-resident: sec Mand three rings not named"
let rgate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" rdesk]
assert rgate.ok else "first-resident: sec mand shape lower/build/run failed"
assert rgate.out contains "EXIT:0" else "first-resident: sec mand shape did not exit 0"

say "GREEN: first-resident — lib · sur×11 · til×2 · app×2 · sec×2 · Surface p45"
say "GREEN: first-resident — Glow userland desks live at home first."



