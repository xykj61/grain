# tools/gen/season/equinox_ch4_surface_witness.rish -- e59 chapter-four surface close.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ch4_surface_witness.rish
#
# Chapter pillars already GREEN alone must GREEN together. Almanac seat 64 closes ch4.
# Leaf witnesses only -- no nested surfaces (avoids elder chains). Twin of e42.

say "equinox-ch4-surface: Language EN — chapter greens, one choir; chapter four closes."
say "equinox-ch4-surface: Style Radiant — DX · mid · style · IronBeetle hold as one."
say "equinox-ch4-surface: Lens TAME — e59 · almanac seat 64 · ch4 full."

# Limb 0 -- DX leaves
let why = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_say_why_census_witness.rish"]
say why.out
assert why.ok else "equinox-ch4-surface: say-why limb failed"
assert why.out contains "GREEN: tb-say-why" else "equinox-ch4-surface: say-why not GREEN"

let how = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_say_how_census_witness.rish"]
say how.out
assert how.ok else "equinox-ch4-surface: say-how limb failed"
assert how.out contains "GREEN: tb-say-how" else "equinox-ch4-surface: say-how not GREEN"

# Limb 1 -- mid / cache leaves + off-by-one
let inplace = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_cache_inplace_census_witness.rish"]
say inplace.out
assert inplace.ok else "equinox-ch4-surface: inplace limb failed"
assert inplace.out contains "GREEN: tb-cache-inplace" else "equinox-ch4-surface: inplace not GREEN"

let shrink = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_shrink_scope_census_witness.rish"]
say shrink.out
assert shrink.ok else "equinox-ch4-surface: shrink limb failed"
assert shrink.out contains "GREEN: tb-shrink-scope" else "equinox-ch4-surface: shrink not GREEN"

let bleeds = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_buffer_bleeds_census_witness.rish"]
say bleeds.out
assert bleeds.ok else "equinox-ch4-surface: bleeds limb failed"
assert bleeds.out contains "GREEN: tb-buffer-bleeds" else "equinox-ch4-surface: bleeds not GREEN"

let obo = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_off_by_one_census_witness.rish"]
say obo.out
assert obo.ok else "equinox-ch4-surface: off-by-one limb failed"
assert obo.out contains "GREEN: tb-off-by-one" else "equinox-ch4-surface: off-by-one not GREEN"

# Limb 2 -- style leaves
let style = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_style_by_the_numbers_census_witness.rish"]
say style.out
assert style.ok else "equinox-ch4-surface: style limb failed"
assert style.out contains "GREEN: tb-style-numbers" else "equinox-ch4-surface: style not GREEN"

let deps = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_dependencies_census_witness.rish"]
say deps.out
assert deps.ok else "equinox-ch4-surface: deps limb failed"
assert deps.out contains "GREEN: tb-dependencies" else "equinox-ch4-surface: deps not GREEN"

let tooling = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_tooling_census_witness.rish"]
say tooling.out
assert tooling.ok else "equinox-ch4-surface: tooling limb failed"
assert tooling.out contains "GREEN: tb-tooling" else "equinox-ch4-surface: tooling not GREEN"

let last = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_last_stage_census_witness.rish"]
say last.out
assert last.ok else "equinox-ch4-surface: last-stage limb failed"
assert last.out contains "GREEN: tb-last-stage" else "equinox-ch4-surface: last-stage not GREEN"

# Limb 3 -- IronBeetle lesson shelf
let iron = run ["sh" "tools/fixtures/ironbeetle_shelf_census.sh"]
say iron.out
assert iron.ok else "equinox-ch4-surface: ironbeetle shelf failed or thin"
assert iron.out contains "IRON=present" else "equinox-ch4-surface: want IRON=present"
assert iron.out contains "verdict=ok" else "equinox-ch4-surface: want iron verdict=ok"

# Refuse -- absent clone
let refuse_clone = run ["sh" "tools/fixtures/tigerbeetle_say_why_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse_clone.out
assert refuse_clone.ok == false else "equinox-ch4-surface: absent clone must fail"
assert refuse_clone.out contains "CLONE=ABSENT" else "equinox-ch4-surface: want CLONE=ABSENT"
assert refuse_clone.out contains "verdict=absent" else "equinox-ch4-surface: want verdict=absent"

# Refuse -- absent iron shelf
let refuse_iron = run ["sh" "tools/fixtures/ironbeetle_shelf_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse_iron.out
assert refuse_iron.ok == false else "equinox-ch4-surface: absent iron must fail"
assert refuse_iron.out contains "IRON=ABSENT" else "equinox-ch4-surface: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ch4_surface_almanac.sh"]
assert almanac.ok else "equinox-ch4-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-ch4-surface — dx · mid · style · ironbeetle choir · almanac seat 64 · ch4 full"
