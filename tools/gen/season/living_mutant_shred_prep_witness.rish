# tools/gen/season/living_mutant_shred_prep_witness.rish -- Surface p32 habit
#
#   rishi/bin/rishi run tools/gen/season/living_mutant_shred_prep_witness.rish
#
# List - lexicon - Class H rows - no living->fossil Status links - shred RED.

say "shred-prep: Language EN — Class H fossils listed; cut not opened."
say "shred-prep: Style Radiant — crawl deps · wait seat · accrete mutants."
say "shred-prep: Lens TAME — Surface Season p34."

let list = run ["test" "-f" "construction/SHRED_PREP.md"]
assert list.ok else "shred-prep: SHRED_PREP.md missing"
let seat = run ["test" "-f" "counsel/date/20260728/20260728-224716_surface-season-p32-living-mutant-shred-prep.md"]
assert seat.ok else "shred-prep: p32 counsel seat missing"
let seat34 = run ["test" "-f" "counsel/date/20260728/20260728-225638_surface-season-p34-transitive-writing-crawl.md"]
assert seat34.ok else "shred-prep: p34 transitive crawl counsel missing"

say "shred-prep: lexicon..."
let lex = run ["sh" "-c" "grep -q 'living mutant' context/LEXICON.md && grep -q 'writing fossil' context/LEXICON.md && grep -q 'shred-prep list' context/LEXICON.md && grep -q 'transitive writing crawl' context/LEXICON.md && echo LEX_OK"]
assert lex.ok else "shred-prep: lexicon scan failed"
assert lex.out contains "LEX_OK" else "shred-prep: living mutant · writing fossil · shred-prep · transitive crawl missing"
let crawl = run ["sh" "-c" "grep -q 'transitive writing crawl' construction/SHRED_PREP.md && grep -q 'Wafer closure' construction/SHRED_PREP.md && grep -q '9 nodes' construction/SHRED_PREP.md && echo CRAWL_OK"]
assert crawl.ok else "shred-prep: wafer closure scan failed"
assert crawl.out contains "CRAWL_OK" else "shred-prep: SHRED_PREP must carry wafer closure"

say "shred-prep: Class H rows..."
let rows = run ["sh" "-c" "grep -q '20260629-063512_realidream.md' construction/SHRED_PREP.md && grep -q '20260629-063512_the-graph-beneath-the-surface.md' construction/SHRED_PREP.md && grep -q '20260629-063512_lantern-lattice-anvil.md' construction/SHRED_PREP.md && grep -q '20260728-221253_lantern-lattice-anvil.md' construction/SHRED_PREP.md && grep -q '20260629-063512_the-wafer-and-the-sovereign-coin.md' construction/SHRED_PREP.md && grep -q '20260728-232511_lantern-lattice-kiln.md' construction/SHRED_PREP.md && echo CLASS_H"]
assert rows.ok else "shred-prep: Class H scan failed"
assert rows.out contains "CLASS_H" else "shred-prep: Class H must list Kiln living + Anvil fossils"

say "shred-prep: living Status bare phrase..."
let bare = run ["sh" "-c" "grep -q '\\*\\*living mutant\\*\\*' foundations/20260728-220203_realidream.md && grep -q '\\*\\*living mutant\\*\\*' foundations/20260728-221253_the-graph-beneath-the-surface.md && grep -q '\\*\\*living mutant\\*\\*' foundations/20260728-232511_lantern-lattice-kiln.md && grep -q '\\*\\*living mutant\\*\\*' foundations/20260728-225239_the-wafer-and-the-sovereign-coin.md && echo BARE"]
assert bare.ok else "shred-prep: bare living mutant scan failed"
assert bare.out contains "BARE" else "shred-prep: living essays must mark living mutant"
let noback = run ["sh" "-c" "if grep -F 'living mutant of [' foundations/20260728-220203_realidream.md foundations/20260728-221253_the-graph-beneath-the-surface.md foundations/20260728-232511_lantern-lattice-kiln.md foundations/20260728-225239_the-wafer-and-the-sovereign-coin.md >/dev/null 2>&1; then echo HIT; else echo CLEAN; fi"]
assert noback.ok else "shred-prep: backlink ban scan failed"
assert noback.out contains "CLEAN" else "shred-prep: living Status must not link back to fossil"

say "shred-prep: shred stays RED..."
let red = run ["sh" "-c" "grep -q 'shred RED' construction/SHRED_PREP.md && grep -q 'Class H' construction/SHRED_PREP.md && echo RED_OK"]
assert red.ok else "shred-prep: RED pin scan failed"
assert red.out contains "RED_OK" else "shred-prep: list must keep shred RED and Class H"

say "GREEN: shred-prep — list · lexicon · Class H · bare living mutant · Surface p32"
say "GREEN: shred-prep — deps wait seat; no Amphora cut from this witness."
