# tools/gen/season/equinox_ironbeetle_ep008_choir_witness.rish -- e65 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep008_choir_witness.rish

say "equinox-iron-ep008-choir: Language EN — IronBeetle ep008 seats consensus by construction."
say "equinox-iron-ep008-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep008-choir: Lens TAME — e65 · ep008 · almanac seat 70 · ch5 6/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep008_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep008-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep008" else "equinox-iron-ep008-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep008-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep008-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep008-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep008_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep008-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep008-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep008-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep008_almanac.sh"]
assert almanac.ok else "equinox-iron-ep008-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep008-choir — ep008 · clean room · absent refuses · almanac seat 70 · ch5 6/16"
