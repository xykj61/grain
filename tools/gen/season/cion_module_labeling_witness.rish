# tools/gen/season/cion_module_labeling_witness.rish — CION, the widened labeling guard.
#
#   rishi/bin/rishi run tools/gen/season/cion_module_labeling_witness.rish
#
# The first CION sweep past the three living pins (which grad_seal already guards):
# module living surfaces — a module's README and its authored .rye doc-comments — carry
# no bare "lap N" capability identity. mandate/ is the first swept module; the scanned
# set grows as CION sweeps each further module. Dated session logs and specs keep the
# ordinals they recorded (testimony is never rewritten). Law addendum 20260811.130827:
# context/specs/20260810-222755_chronological-semantic-labeling-and-the-cion-meta-season.md

say "cion-module: Language EN — the labeling law, widened past the three pins to modules."
say "cion-module: Style Radiant — a capability's name is its semantic label + stamp, never a bare lap ordinal."
say "cion-module: Lens TAME — guard the living module surfaces; a planted lap ordinal must bite."

# mandate/ — the first swept module — names no capability by a bare lap ordinal.
let scan = run ["sh" "tools/fixtures/labeling_module_scan.sh" "mandate/README.md" "mandate/store.rye" "mandate/keyed.rye" "mandate/bucket.rye" "mandate/wal.rye" "mandate/serve.rye" "mandate/named_serve.rye" "mandate/comlink_serve.rye"]
say scan.out
assert scan.out contains "verdict=ok" else "cion-module: a mandate surface names a capability by a bare lap ordinal"
# values_apart: the verdict key and the exit status must agree.
assert scan.ok else "cion-module: mandate verdict and status disagree"

# The guard bites — a planted lap ordinal is caught on every run.
let neg = run ["sh" "tools/fixtures/labeling_module_scan.sh" "tools/fixtures/labeling_module_negative.md"]
say neg.out
assert neg.out contains "verdict=drift" else "cion-module: planted lap ordinal was not flagged"
assert (neg.ok == false) else "cion-module: the guard failed to bite the planted negative"

say "GREEN: cion-module — mandate names its capabilities by semantic label + stamp, no bare lap ordinal; the guard bites a planted one"
