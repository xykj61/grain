# tools/gen/season/equinox_ironbeetle_ep020_choir_witness.rish -- e75 -> almanac ch5 FULL.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep020_choir_witness.rish

say "equinox-iron-ep020-choir: Language EN — IronBeetle ep020 seats LSM shadow updates."
say "equinox-iron-ep020-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep020-choir: Lens TAME — e75 · ep020 · almanac seat 80 · ch5 16/16 FULL."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep020_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep020-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep020" else "equinox-iron-ep020-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep020-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep020-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep020-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep020_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep020-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep020-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep020-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep020_almanac.sh"]
assert almanac.ok else "equinox-iron-ep020-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep020-choir — ep020 · clean room · absent refuses · almanac seat 80 · ch5 16/16 FULL"
