# tools/gen/season/reds_ledger_monotone_witness.rish — REDS indices accrete only.
#
#   rishi/bin/rishi run tools/gen/season/reds_ledger_monotone_witness.rish
#
# Seated with the Baton Museum apply `20260730.030553`. Completeness
# (three fields) stays in reds_ledger_witness; this witness proves the
# index spine: 1..N, no gaps, no duplicates — so a bundle cannot silently
# rewrite a landed row number without the seam going red.

say "reds-monotone: Language EN — a ledger grows by accretion."
say "reds-monotone: Style Radiant — name the gap; refuse silent rewrite."
say "reds-monotone: Lens TAME — indices bounded to the living pin."

let scan = run ["sh" "tools/fixtures/reds_ledger_monotone_scan.sh"]
say scan.out
assert scan.out contains "verdict=ok" else "reds-monotone: row indices are not 1..N monotone"
assert scan.ok else "reds-monotone: the verdict reads ok while the status fails — they must agree"

say "GREEN: reds-monotone — row indices accrete 1..N with no gaps"
