# tools/gen/season/dep_crawl.rish -- bounded dependency closure, root to leaves.
#
#   rishi/bin/rishi run tools/gen/season/dep_crawl.rish <root.rye|root.rish>
#
# The code sibling of the seated transitive writing crawl (20260728.225638):
# BFS outbound @import edges until no new edges (leaves), report the closure,
# never auto-walk past the stated bounds.
#
# Bounds, named before the machine runs:
#   dep_crawl_max_nodes 256   -- the closure may not exceed this many files
#   dep_crawl_max_depth 16    -- one journey deep; deeper wants a word
# A crawl that would exceed either bound stops RED and says which bound bit.

say "dep-crawl: Language EN — bounded dependency closure."
say "dep-crawl: Style Radiant — report the closure; refuse to guess past a bound."
say "dep-crawl: Lens TAME — two bounds named up front; status before pipe."

assert length args != 0 else "dep-crawl: name a root file"
let root = args[0]

let have = run ["test" "-f" root]
assert have.ok else "dep-crawl: root file absent"

# Bounded BFS in a POSIX seam -- Rishi holds the asserts, the scan holds the
# shell variables. Rishi reads every $name in a string as interpolation, so a
# shell body cannot live inline; tools/fixtures/*_scan.sh is the seated shape.
let crawl = run ["sh" "tools/fixtures/dep_crawl_scan.sh" root]
say crawl.out
assert crawl.out contains "verdict=ok" else "dep-crawl: a bound bit before the closure closed"
# values_apart: the scan's status and its verdict key must agree. If they ever
# disagree, a sentinel was typo'd or a path changed -- exactly the failure the
# old text-only verdict could pass silently.
assert crawl.ok else "dep-crawl: the verdict reads ok while the status fails — they must agree"
assert crawl.out contains "maxn=256" else "dep-crawl: node bound is not the named 256"
assert crawl.out contains "maxd=16" else "dep-crawl: depth bound is not the named 16"

say "GREEN: dep-crawl — closure reached leaves inside both named bounds"
