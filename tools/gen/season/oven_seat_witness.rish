# tools/gen/season/oven_seat_witness.rish -- Surface p36 - Kiln seated
#
#   rishi/bin/rishi run tools/gen/season/oven_seat_witness.rish

say "kiln-seat: Language EN — Kiln living forge; Anvil tribute held."
say "kiln-seat: Style Radiant — bread not blades."
say "kiln-seat: Lens TAME — Kiln Season o1."

let seat = run ["test" "-f" "counsel/date/20260728/20260728-232511_surface-season-p36-kiln-seated.md"]
assert seat.ok else "kiln-seat: p36 counsel missing"
let living = run ["test" "-f" "foundations/20260728-232511_lantern-lattice-kiln.md"]
assert living.ok else "kiln-seat: living Kiln foundation missing"
let mid = run ["test" "-f" "foundations/20260728-221253_lantern-lattice-anvil.md"]
assert mid.ok else "kiln-seat: Anvil mid-fossil missing"

let kiln = run ["sh" "-c" "grep -q 'Kiln — Where the Model Is Baked' foundations/20260728-232511_lantern-lattice-kiln.md && grep -q '\\*\\*living mutant\\*\\*' foundations/20260728-232511_lantern-lattice-kiln.md && echo OVEN_OK"]
assert kiln.ok else "kiln-seat: Kiln body scan failed"
assert kiln.out contains "OVEN_OK" else "kiln-seat: Kiln section missing"
let lex = run ["sh" "-c" "grep -q 'Living name for the local forge' context/LEXICON.md && grep -q 'Retired living forge name' context/LEXICON.md && grep -q 'Kiln was Anvil' context/LEXICON.md && echo LEX_OK"]
assert lex.ok else "kiln-seat: lexicon scan failed"
assert lex.out contains "LEX_OK" else "kiln-seat: Kiln · Anvil rename-forward missing"
let held = run ["sh" "-c" "test -d kiln && test ! -d anvil && echo PATH_OVEN"]
assert held.ok else "kiln-seat: kiln/ directory should exist after o1 cut"
assert held.out contains "PATH_OVEN" else "kiln-seat: anvil/ must be gone after o1 cut"

say "GREEN: kiln-seat — Kiln living · Anvil fossils · lexicon · kiln/ path LIVE · Kiln Season o1"
