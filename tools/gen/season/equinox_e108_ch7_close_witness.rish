# tools/gen/season/equinox_e108_ch7_close_witness.rish -- e108 ch7 close choir leaf.
#
#   rishi/bin/rishi run tools/gen/season/equinox_e108_ch7_close_witness.rish

say "e108-ch7-close: Language EN — control first; then close the chapter as a check."
say "e108-ch7-close: Style Radiant — shred opens Chapter Eight; the bundle is a crossing."
say "e108-ch7-close: Lens TAME — e108 · seat 112 · REDS 34-37 · ch7 16/16 FULL."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "e108-ch7-close: census control must GREEN"
assert control.out contains "GREEN: census-control" else "e108-ch7-close: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "e108-ch7-close: baton museum RED"
assert museum.out contains "census_breach_count=0" else "e108-ch7-close: want breach 0"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "e108-ch7-close: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "e108-ch7-close: want scope GREEN"

let m3 = run ["rishi/bin/rishi" "run" "tools/gen/season/oldness_census_witness.rish"]
say m3.out
assert m3.ok else "e108-ch7-close: M3 RED"
assert m3.out contains "GREEN: oldness-census" else "e108-ch7-close: want M3 GREEN"

let m4 = run ["rishi/bin/rishi" "run" "tools/gen/season/radiant_h1_fence_witness.rish"]
say m4.out
assert m4.ok else "e108-ch7-close: M4 RED"
assert m4.out contains "GREEN: radiant-h1-fence" else "e108-ch7-close: want M4 GREEN"

let zero = run ["rishi/bin/rishi" "run" "tools/gen/season/zero_view_witness.rish"]
say zero.out
assert zero.ok else "e108-ch7-close: zero-view RED"
assert zero.out contains "GREEN: zero-view" else "e108-ch7-close: want zero-view GREEN"

let reds = run ["rishi/bin/rishi" "run" "tools/gen/season/reds_ledger_witness.rish"]
say reds.out
assert reds.ok else "e108-ch7-close: reds ledger RED"
assert reds.out contains "GREEN: reds-ledger" else "e108-ch7-close: want reds GREEN"

let mono = run ["rishi/bin/rishi" "run" "tools/gen/season/reds_ledger_monotone_witness.rish"]
say mono.out
assert mono.ok else "e108-ch7-close: reds monotone RED"
assert mono.out contains "GREEN: reds-monotone" else "e108-ch7-close: want monotone GREEN"

let scan = run ["sh" "tools/fixtures/equinox_e108_ch7_close_scan.sh"]
say scan.out
assert scan.ok else "e108-ch7-close: scan must exit 0"
assert scan.out contains "control_gate=honored" else "e108-ch7-close: want control_gate"
assert scan.out contains "seat_map=honored" else "e108-ch7-close: want seat_map"
assert scan.out contains "seat_map_112=close_choir_this_sitting" else "e108-ch7-close: want 112 this sitting"
assert scan.out contains "seat_map_shred=" else "e108-ch7-close: want shred mode line"
assert scan.out contains "reds_cross=honored" else "e108-ch7-close: want reds cross"
assert scan.out contains "reds_rows=37" else "e108-ch7-close: want rows 37"
assert scan.out contains "zero_view=honored" else "e108-ch7-close: want zero_view"
assert scan.out contains "m3_keep=honored" else "e108-ch7-close: want m3 keep"
assert scan.out contains "m4_keep=honored" else "e108-ch7-close: want m4 keep"
assert scan.out contains "fascia_keep=honored" else "e108-ch7-close: want fascia keep"
assert scan.out contains "fork_status=not_consumed" else "e108-ch7-close: want fork waiting"
assert scan.out contains "close_mode=check_test_prepare" else "e108-ch7-close: want close mode"
assert scan.out contains "e108_ch7_close=ok" else "e108-ch7-close: want e108 ok"
assert scan.out contains "verdict=ok" else "e108-ch7-close: want verdict=ok"

say "GREEN: e108-ch7-close — seat 112 close choir · REDS 34-37 · shred opens ch8 · fork waiting · museum"
