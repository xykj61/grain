# tools/gen/season/oven_handback_surface_p39_witness.rish -- Kiln->Surface handback.
#
#   rishi/bin/rishi run tools/gen/season/oven_handback_surface_p39_witness.rish

say "kiln-handback: Language EN — return Surface p39."
say "kiln-handback: Style Radiant — pause Kiln; open sept."
say "kiln-handback: Lens TAME — handback 20260729.000500."

let hb = run ["test" "-f" "counsel/date/20260729/20260729-000500_oven-handback-return-surface-p39.md"]
assert hb.ok else "kiln-handback: handback counsel missing"
let p39 = run ["test" "-f" "counsel/date/20260729/20260729-000500_surface-season-p39-resume-after-kiln.md"]
assert p39.ok else "kiln-handback: Surface p39 resume missing"

let scope = run ["sh" "-c" "grep -q 'sept:   Surface Season — OPEN' tools/gen/season/prin_scope.rish && grep -q 'oct:   Kiln Season — PAUSED' tools/gen/season/prin_scope.rish && grep -q 'return_generator_s9' tools/gen/season/prin_scope.rish && echo SCOPE_OK"]
assert scope.ok else "kiln-handback: prin_scope pin scan failed"
assert scope.out contains "SCOPE_OK" else "kiln-handback: sept not OPEN or oct not PAUSED"

let path = run ["sh" "-c" "test -d kiln && test ! -d anvil && echo OVEN_LIVE"]
assert path.ok else "kiln-handback: kiln/ must remain after handback"
assert path.out contains "OVEN_LIVE" else "kiln-handback: forge path broken"

say "GREEN: kiln-handback — Surface OPEN p39 · Kiln PAUSED · kiln/ LIVE"
say "GREEN: kiln-handback — return_surface_p39 seated."
