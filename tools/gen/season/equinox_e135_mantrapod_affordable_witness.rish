# tools/gen/season/equinox_e135_mantrapod_affordable_witness.rish — e135 seat.
#   rishi/bin/rishi run tools/gen/season/equinox_e135_mantrapod_affordable_witness.rish
# Pitch claim rewrite corrected at e136 — this witness keeps the speed law.
say "e135-affordable: Language EN — affordable witness law · elder pitch kept whole."
say "e135-affordable: Style Radiant — a witness nobody can afford to run stops being run."
say "e135-affordable: Lens TAME — e135 · e136 supersedes speech · shred held · 128 reserved."

let green = run ["sh" "tools/fixtures/equinox_e135_mantrapod_affordable_scan.sh"]
assert green.ok else "e135-affordable: living scan must exit 0"
assert green.out contains "elder_pitch_note=dated_testimony_kept_whole" else "e135-affordable: want elder kept"
assert green.out contains "reds_note=row_46_affordable_witness" else "e135-affordable: want REDS 46"
assert green.out contains "e112=honored" else "e135-affordable: want e112"
assert green.out contains "e115=tracked_not_nested" else "e135-affordable: want e115 not nested"
assert green.out contains "shred=RED" else "e135-affordable: want shred RED"
assert green.out contains "seat_128=reserved_close_choir" else "e135-affordable: want 128 reserved"
assert green.out contains "verdict=ok" else "e135-affordable: want verdict ok"

let red = run ["sh" "tools/fixtures/equinox_e135_mantrapod_affordable_scan.sh" "prove-red"]
assert (red.ok == false) else "e135-affordable: prove-red must refuse"
assert red.out contains "RED_affordable_witness_unseated" else "e135-affordable: prove-red want refuse"

say "GREEN: e135-affordable — REDS 46 · elder pitch kept · e112 fast · shred RED · 128 reserved"
