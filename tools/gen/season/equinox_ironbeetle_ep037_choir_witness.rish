# tools/gen/season/equinox_ironbeetle_ep037_choir_witness.rish -- e87 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep037_choir_witness.rish

say "equinox-iron-ep037-choir: Language EN — IronBeetle ep037.5 seats deterministic compaction-in-commit."
say "equinox-iron-ep037-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep037-choir: Lens TAME — e87 · ep037.5 · almanac seat 92 · ch6 12/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep037_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep037-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep037" else "equinox-iron-ep037-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep037-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep037-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep037-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep037_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep037-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep037-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep037-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep037_almanac.sh"]
assert almanac.ok else "equinox-iron-ep037-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep037-choir — ep037.5 · clean room · absent refuses · almanac seat 92 · ch6 12/16"
