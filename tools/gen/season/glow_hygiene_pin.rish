# tools/gen/season/glow_hygiene_pin.rish — Surface Season p2 · Glow happy-zone hygiene
#
#   rishi/bin/rishi run tools/gen/season/glow_hygiene_pin.rish
#   prin glow-hygiene   (via tools/gen/season/prin.rish when wired)
#
# Thin fold — not all seventy-nine glow_* witnesses. Core happy-zone floor
# before vegan-dogfood and surface invent. Measure only; refuse shred/deploy.

say "glow-hygiene: Language EN — happy-zone Glow floor pin."
say "glow-hygiene: Style Radiant — prove folds; refuse shred/deploy."
say "glow-hygiene: Lens TAME — Surface Season prep spine p2."

say "glow-hygiene: text floor..."
let text = run ["rishi/bin/rishi" "run" "tools/g/glow_text_floor_witness.rish"]
assert text.ok else "glow_hygiene: text floor failed"
assert text.out contains "GREEN" else "glow_hygiene: text floor not GREEN"

say "glow-hygiene: digraph twin..."
let digraph = run ["rishi/bin/rishi" "run" "tools/g/glow_digraph_twin_witness.rish"]
assert digraph.ok else "glow_hygiene: digraph twin failed"
assert digraph.out contains "GREEN" else "glow_hygiene: digraph twin not GREEN"

say "glow-hygiene: rune alphabet..."
let alpha = run ["rishi/bin/rishi" "run" "tools/g/glow_rune_alphabet_witness.rish"]
assert alpha.ok else "glow_hygiene: rune alphabet failed"
assert alpha.out contains "GREEN" else "glow_hygiene: rune alphabet not GREEN"

say "glow-hygiene: tokens..."
let tokens = run ["rishi/bin/rishi" "run" "tools/g/glow_tokens_witness.rish"]
assert tokens.ok else "glow_hygiene: tokens failed"
assert tokens.out contains "GREEN" else "glow_hygiene: tokens not GREEN"

say "glow-hygiene: nest expression..."
let expr = run ["rishi/bin/rishi" "run" "tools/g/glow_expr_witness.rish"]
assert expr.ok else "glow_hygiene: expr failed"
assert expr.out contains "GREEN" else "glow_hygiene: expr not GREEN"

say "glow-hygiene: compose hop..."
let compose = run ["rishi/bin/rishi" "run" "tools/g/glow_lower_compose_witness.rish"]
assert compose.ok else "glow_hygiene: compose failed"
assert compose.out contains "GREEN" else "glow_hygiene: compose not GREEN"

say "glow-hygiene: refuse shred · deploy · O3 (pin only)"
say "GREEN: glow-hygiene — text · digraph · alphabet · tokens · expr · compose · Surface p2"
say "GREEN: glow-hygiene — happy-zone floor holds; TAME on touch; shred refuse RED."
