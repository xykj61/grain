# tools/gen/season/equinox_ironbeetle_ep013_choir_witness.rish -- e70 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep013_choir_witness.rish

say "equinox-iron-ep013-choir: Language EN — IronBeetle ep013 seats Op · commit_min · commit_max."
say "equinox-iron-ep013-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep013-choir: Lens TAME — e70 · ep013 · almanac seat 75 · ch5 11/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep013_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep013-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep013" else "equinox-iron-ep013-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep013-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep013-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep013-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep013_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep013-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep013-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep013-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep013_almanac.sh"]
assert almanac.ok else "equinox-iron-ep013-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep013-choir — ep013 · clean room · absent refuses · almanac seat 75 · ch5 11/16"
