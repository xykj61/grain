# tools/gen/season/equinox_ch2_surface_witness.rish -- e26 chapter-two surface choir.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ch2_surface_witness.rish
#
# Four living limbs already GREEN alone must GREEN together. Almanac seat 32 closes ch2.
# Leaf witnesses only -- no nested choirs (avoids elder chains).

say "equinox-ch2-surface: Language EN — four greens, one choir; chapter two closes."
say "equinox-ch2-surface: Style Radiant — the living surface holds as one."
say "equinox-ch2-surface: Lens TAME — e26 · almanac seat 32 · ch2 full."

# Limb 1 -- SAFE list (leaf census; shred refuse measured inside)
let safe = run ["sh" "tools/fixtures/safe_list_census.sh"]
say safe.out
assert safe.ok else "equinox-ch2-surface: SAFE limb failed"
assert safe.out contains "verdict=ok" else "equinox-ch2-surface: SAFE not ok"
assert safe.out contains "SHRED_RED=yes" else "equinox-ch2-surface: shred must stay RED"

# Limb 2 -- reds welcome + refuse
let reds = run ["rishi/bin/rishi" "run" "tools/gen/season/reds_ledger_witness.rish"]
say reds.out
assert reds.ok else "equinox-ch2-surface: reds completeness failed"
assert reds.out contains "GREEN: reds-ledger" else "equinox-ch2-surface: reds completeness not GREEN"

let mono = run ["rishi/bin/rishi" "run" "tools/gen/season/reds_ledger_monotone_witness.rish"]
say mono.out
assert mono.ok else "equinox-ch2-surface: reds monotone failed"

let reds_neg = run ["rishi/bin/rishi" "run" "tools/gen/season/reds_ledger_negative_witness.rish"]
say reds_neg.out
assert reds_neg.ok else "equinox-ch2-surface: reds refuse failed"

# Limb 3 -- voice roster welcome + refuse
let voice = run ["rishi/bin/rishi" "run" "tools/gen/season/voice_roster_witness.rish"]
say voice.out
assert voice.ok else "equinox-ch2-surface: voice welcome failed"
assert voice.out contains "sites=6" else "equinox-ch2-surface: want six voice sites"

let voice_neg = run ["rishi/bin/rishi" "run" "tools/gen/season/voice_roster_negative_witness.rish"]
say voice_neg.out
assert voice_neg.ok else "equinox-ch2-surface: voice refuse failed"

# Limb 4 -- baton museum census welcome + refuse
let baton = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say baton.out
assert baton.ok else "equinox-ch2-surface: baton welcome failed"
assert baton.out contains "halls_expected=13" else "equinox-ch2-surface: want thirteen halls"
assert baton.out contains "census_breach_count=0" else "equinox-ch2-surface: want breach zero"

let baton_neg = run ["sh" "tools/fixtures/baton_museum_census_scan.sh" "tools/fixtures/baton_museum_ABSENT"]
say baton_neg.out
assert baton_neg.ok == false else "equinox-ch2-surface: absent museum must fail"
assert baton_neg.out contains "verdict=missing_museum" else "equinox-ch2-surface: want missing_museum"

let almanac = run ["sh" "tools/gen/season/equinox_ch2_surface_almanac.sh"]
assert almanac.ok else "equinox-ch2-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-ch2-surface — SAFE · reds · voice · baton choir · almanac seat 32 · ch2 full"
