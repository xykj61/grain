# tools/gen/season/equinox_tigerbeetle_perf_surface_witness.rish -- e40 TB performance surface.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_perf_surface_witness.rish
#
# Three TB performance leaves already GREEN alone must GREEN together. Almanac seat 46.
# Leaf witnesses only -- no nested choirs (avoids elder chains). Clean-room study.

say "equinox-tb-perf-surface: Language EN — three TB greens, one choir."
say "equinox-tb-perf-surface: Style Radiant — the performance surface holds as one."
say "equinox-tb-perf-surface: Lens TAME — e40 · almanac seat 46 · ch3 14/16."

# Limb 0 -- explicitly sized types (leaf)
let sized = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_sized_types_census_witness.rish"]
say sized.out
assert sized.ok else "equinox-tb-perf-surface: sized limb failed"
assert sized.out contains "GREEN: tb-sized-types" else "equinox-tb-perf-surface: sized not GREEN"

# Limb 1 -- amortize by batching (leaf)
let batch = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_batching_census_witness.rish"]
say batch.out
assert batch.ok else "equinox-tb-perf-surface: batching limb failed"
assert batch.out contains "GREEN: tb-batching" else "equinox-tb-perf-surface: batching not GREEN"

# Limb 2 -- be explicit / hot loops (leaf)
let explicit = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_be_explicit_census_witness.rish"]
say explicit.out
assert explicit.ok else "equinox-tb-perf-surface: be-explicit limb failed"
assert explicit.out contains "GREEN: tb-be-explicit" else "equinox-tb-perf-surface: be-explicit not GREEN"

# Refuse -- absent clone path (any of the three scans)
let refuse = run ["sh" "tools/fixtures/tigerbeetle_sized_types_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-perf-surface: absent clone must fail"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-perf-surface: want CLONE=ABSENT"
assert refuse.out contains "verdict=absent" else "equinox-tb-perf-surface: want verdict=absent"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_perf_surface_almanac.sh"]
assert almanac.ok else "equinox-tb-perf-surface: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-perf-surface — sized · batching · be-explicit choir · almanac seat 46"
