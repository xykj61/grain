# tools/gen/season/equinox_ironbeetle_ep022_choir_witness.rish -- e77 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep022_choir_witness.rish

say "equinox-iron-ep022-choir: Language EN — IronBeetle ep022 seats reads that cannot fail."
say "equinox-iron-ep022-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep022-choir: Lens TAME — e77 · ep022 · almanac seat 82 · ch6 2/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep022_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep022-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep022" else "equinox-iron-ep022-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep022-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep022-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep022-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep022_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep022-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep022-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep022-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep022_almanac.sh"]
assert almanac.ok else "equinox-iron-ep022-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep022-choir — ep022 · clean room · absent refuses · almanac seat 82 · ch6 2/16"
