# tools/gen/season/equinox_ironbeetle_ep034_choir_witness.rish -- e84 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep034_choir_witness.rish

say "equinox-iron-ep034-choir: Language EN — IronBeetle ep034 seats never-sync-callback discipline."
say "equinox-iron-ep034-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep034-choir: Lens TAME — e84 · ep034 · almanac seat 89 · ch6 9/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep034_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep034-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep034" else "equinox-iron-ep034-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep034-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep034-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep034-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep034_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep034-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep034-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep034-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep034_almanac.sh"]
assert almanac.ok else "equinox-iron-ep034-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep034-choir — ep034 · clean room · absent refuses · almanac seat 89 · ch6 9/16"
