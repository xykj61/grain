# tools/gen/season/remember_pin_history_tidy_witness.rish — Surface history tidy
#
#   rishi/bin/rishi run tools/gen/season/remember_pin_history_tidy_witness.rish
#
# Asserts the REMEMBER pin-follow-up squash for the Surface tidy range.

say "pin-tidy: Language EN — scroll history · same-commit git nib."
say "pin-tidy: Style Radiant — measure pins; refuse pin-only follow-ups."
say "pin-tidy: Lens TAME — Surface Season history tidy 20260728.205029."

let seat = run ["test" "-f" "counsel/20260728-205029_surface-season-history-tidy-remember-pin-squash.md"]
assert seat.ok else "pin-tidy: counsel seat missing"

let rule_c = run ["test" "-f" ".cursor/rules/remember-git-nib.mdc"]
assert rule_c.ok else "pin-tidy: cursor remember-git-nib rule missing"
let rule_z = run ["test" "-f" ".claude/rules/remember-git-nib.md"]
assert rule_z.ok else "pin-tidy: claude remember-git-nib rule missing"

say "pin-tidy: count pin-only subjects in Surface tidy range..."
let count = run ["sh" "-c" "git log --format=%s d3e208613a..HEAD | grep -c 'work-in-progress: pin REMEMBER git nib' || true"]
assert count.ok else "pin-tidy: git log count failed"
let n = trim count.out
assert n == "0" else "pin-tidy: expected 0 pin follow-ups in Surface tidy range; got ${n}"

let backup = run ["sh" "-c" "git show-ref --verify --quiet refs/heads/backup/pre-pin-squash-e8ad191f8d && echo BACKUP_OK"]
assert backup.ok else "pin-tidy: backup branch missing"
assert backup.out contains "BACKUP_OK" else "pin-tidy: backup/pre-pin-squash-e8ad191f8d required"

say "GREEN: pin-tidy — zero pin follow-ups · rules · counsel · backup"
say "GREEN: pin-tidy — REMEMBER git nib rides in the work commit."
