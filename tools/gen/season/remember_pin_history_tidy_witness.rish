# tools/gen/season/remember_pin_history_tidy_witness.rish — ITINERARY pin habit tidy
#
#   rishi/bin/rishi run tools/gen/season/remember_pin_history_tidy_witness.rish
#
# Asserts pure nib follow-ups are gone from the first habit through HEAD.
# Real sends that only mention pin ITINERARY in the subject may remain (few).

say "pin-tidy: Language EN — scroll history · same-commit git nib."
say "pin-tidy: Style Radiant — measure habit follow-ups; keep real sends."
say "pin-tidy: Lens TAME — full habit tidy 20260728.205833."

let seat = run ["test" "-f" "counsel/date/20260728/20260728-205833_history-tidy-remember-pin-squash-full.md"]
assert seat.ok else "pin-tidy: full tidy counsel seat missing"

let rule_c = run ["test" "-f" ".cursor/rules/remember-git-nib.mdc"]
assert rule_c.ok else "pin-tidy: cursor remember-git-nib rule missing"
let rule_z = run ["test" "-f" ".claude/rules/remember-git-nib.md"]
assert rule_z.ok else "pin-tidy: claude remember-git-nib rule missing"

say "pin-tidy: count pure habit follow-ups since first habit base..."
# Counter lives under expanding-prompts/yonder/ so tools/*.py ratchet stays clear
# (fascia f1 · 20260730.091805). Habit measure itself is unchanged.
let count = run ["python3" "expanding-prompts/yonder/remember_pin_habit_count.py"]
assert count.ok else "pin-tidy: habit count failed"
let n = trim count.out
assert n == "0" else "pin-tidy: expected 0 pure habit follow-ups; got ${n}"

let backup = run ["sh" "-c" "git show-ref --verify --quiet refs/heads/backup/pre-pin-squash-full-a036851173 && echo BACKUP_OK"]
assert backup.ok else "pin-tidy: full backup branch missing"
assert backup.out contains "BACKUP_OK" else "pin-tidy: backup/pre-pin-squash-full-a036851173 required"

say "GREEN: pin-tidy — zero pure habit follow-ups · rules · counsel · backup"
say "GREEN: pin-tidy — ITINERARY git nib rides in the work commit."
