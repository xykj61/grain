# tools/gen/season/equinox_ironbeetle_ep028_choir_witness.rish -- e79 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep028_choir_witness.rish

say "equinox-iron-ep028-choir: Language EN — IronBeetle ep028 seats FreeSet staging before reuse."
say "equinox-iron-ep028-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep028-choir: Lens TAME — e79 · ep028 · almanac seat 84 · ch6 4/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep028_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep028-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep028" else "equinox-iron-ep028-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep028-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep028-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep028-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep028_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep028-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep028-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep028-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep028_almanac.sh"]
assert almanac.ok else "equinox-iron-ep028-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep028-choir — ep028 · clean room · absent refuses · almanac seat 84 · ch6 4/16"
