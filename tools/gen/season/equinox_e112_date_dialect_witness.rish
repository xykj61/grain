# tools/gen/season/equinox_e112_date_dialect_witness.rish -- e112 planted dialect.
#
#   rishi/bin/rishi run tools/gen/season/equinox_e112_date_dialect_witness.rish
#
# Law: a duty with no witness has no seat, and a duty with no seat never lands.

say "e112-date-dialect-witness: Language EN — plant both ways; then read the library."
say "e112-date-dialect-witness: Style Radiant — the transform already sits; the witness lands."
say "e112-date-dialect-witness: Lens TAME — e112 · planted dialect · almanac 116 · ch8 4/16."

let control = run ["rishi/bin/rishi" "run" "tools/gen/season/census_control_witness.rish"]
say control.out
assert control.ok else "e112-date-dialect-witness: census control must GREEN"
assert control.out contains "GREEN: census-control" else "e112-date-dialect-witness: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/season/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "e112-date-dialect-witness: baton museum RED"
assert museum.out contains "census_breach_count=0" else "e112-date-dialect-witness: want breach 0"

let dialect = run ["rishi/bin/rishi" "run" "tools/gen/season/date_dialect_witness.rish"]
say dialect.out
assert dialect.ok else "e112-date-dialect-witness: standing dialect RED"
assert dialect.out contains "GREEN: date-dialect" else "e112-date-dialect-witness: want dialect GREEN"
assert dialect.out contains "verdict=one_dialect" else "e112-date-dialect-witness: want one_dialect"
assert dialect.out contains "hyphenated=0" else "e112-date-dialect-witness: want hyphen 0"
assert dialect.out contains "compact=17" else "e112-date-dialect-witness: want compact 17"

let elder = run ["rishi/bin/rishi" "run" "tools/gen/season/equinox_e111_date_dialect_witness.rish"]
say elder.out
assert elder.ok else "e112-date-dialect-witness: elder e111 RED"
assert elder.out contains "GREEN: e111-date-dialect" else "e112-date-dialect-witness: want elder GREEN"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/season/prin_scope.rish"]
say scope.out
assert scope.ok else "e112-date-dialect-witness: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "e112-date-dialect-witness: want scope GREEN"

let scan = run ["sh" "tools/fixtures/equinox_e112_date_dialect_witness_scan.sh"]
say scan.out
assert scan.ok else "e112-date-dialect-witness: scan must exit 0"
assert scan.out contains "control_gate=honored" else "e112-date-dialect-witness: want control_gate"
assert scan.out contains "dialect_instrument=honored" else "e112-date-dialect-witness: want dialect instrument"
assert scan.out contains "dialect_verdict=one_dialect" else "e112-date-dialect-witness: want one_dialect"
assert scan.out contains "dialect_prove_red=honored" else "e112-date-dialect-witness: want prove-red"
assert scan.out contains "elder=honored" else "e112-date-dialect-witness: want elder"
assert scan.out contains "seat_128=reserved_close_choir" else "e112-date-dialect-witness: want 128 reserved"
assert scan.out contains "surface_count=6" else "e112-date-dialect-witness: want surface 6"
assert scan.out contains "fork_status=not_consumed" else "e112-date-dialect-witness: want fork waiting"
assert scan.out contains "e112_date_dialect_witness=ok" else "e112-date-dialect-witness: want e112 ok"
assert scan.out contains "verdict=ok" else "e112-date-dialect-witness: want verdict=ok"

say "GREEN: e112-date-dialect-witness — planted C1/C2 · one_dialect · elder e111 · 128 reserved · census six · fork waiting · museum"
