# tools/gen/season/equinox_ironbeetle_ep019_choir_witness.rish -- e74 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep019_choir_witness.rish

say "equinox-iron-ep019-choir: Language EN — IronBeetle ep019 seats the sorted-array storage open."
say "equinox-iron-ep019-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep019-choir: Lens TAME — e74 · ep019 · almanac seat 79 · ch5 15/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep019_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep019-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep019" else "equinox-iron-ep019-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep019-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep019-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep019-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep019_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep019-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep019-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep019-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep019_almanac.sh"]
assert almanac.ok else "equinox-iron-ep019-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep019-choir — ep019 · clean room · absent refuses · almanac seat 79 · ch5 15/16"
