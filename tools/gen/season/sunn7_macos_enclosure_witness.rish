# tools/gen/season/sunn7_macos_enclosure_witness.rish — SUNN7 macos · enclosure leaves.
#
#   rishi/bin/rishi run tools/gen/season/sunn7_macos_enclosure_witness.rish

say "sunn7: Language EN — macos Seatbelt guide · dual-editor enclosure."
say "sunn7: Style Radiant — Riyo · ~/grain · GitHub-living."
say "sunn7: Lens TAME — presence · living face · no macOS render required."

let m = run ["test" "-f" "manual/guides/macos-ai-jail-setup.md"]
assert m.ok else "sunn7: macos-ai-jail-setup.md ABSENT"

let e = run ["test" "-f" "context/specs/enclosure-editors.md"]
assert e.ok else "sunn7: enclosure-editors.md ABSENT"

let mac = read-file "manual/guides/macos-ai-jail-setup.md"
assert mac contains "Voice:** Kyri" else "sunn7: macos want Voice Riyo"
assert mac contains "cd ~/grain" else "sunn7: macos want ~/grain"
assert mac contains "SOURCE.md" else "sunn7: macos want SOURCE cite"
assert mac contains "ssh_config_grain" else "sunn7: macos want living ssh_config_grain example"
assert (mac contains "cd ~/urbit") == false else "sunn7: macos must not launch from ~/urbit"
assert (mac contains "Voice:** Rio 3") == false else "sunn7: macos must not keep Rio 3 voice"

let enc = read-file "context/specs/enclosure-editors.md"
assert enc contains "Voice:** Kyri" else "sunn7: enclosure want Voice Riyo"
assert enc contains "Ubuntu 26.04" else "sunn7: enclosure want Ubuntu 26.04"
assert enc contains "NixOS" else "sunn7: enclosure want NixOS"
assert enc contains "xykj61/grain" else "sunn7: enclosure want xykj61 clone"
assert enc contains "KYRI.md" else "sunn7: enclosure want RIYO.md"
assert (enc contains "Reya 2") == false else "sunn7: enclosure must not keep Reya 2 as living rules voice"

let src = read-file "SOURCE.md"
assert src contains "Ubuntu 26.04" else "sunn7: SOURCE want Ubuntu 26.04"

# Door stamp lives on the macos leaf — SOURCE Status accretes later doors.
assert mac contains "SUNN7" else "sunn7: macos want SUNN7 stamp"

say "GREEN: sunn7 — macos guide · enclosure-editors · SOURCE host face"
