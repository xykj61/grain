# tools/gen/season/equinox_tigerbeetle_dependencies_choir_witness.rish -- e52 -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_dependencies_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-dependencies-choir: Language EN — zero deps; refuse an absent clone."
say "equinox-tb-dependencies-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-dependencies-choir: Lens TAME — e52 · Zig toolchain · almanac seat 57."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_dependencies_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-dependencies-choir: welcome RED"
assert welcome.out contains "GREEN: tb-dependencies" else "equinox-tb-dependencies-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_DEPS=yes" else "equinox-tb-dependencies-choir: want GUIDE_DEPS"
assert welcome.out contains "GUIDE_ZERO=yes" else "equinox-tb-dependencies-choir: want GUIDE_ZERO"
assert welcome.out contains "TAME_DEPS=yes" else "equinox-tb-dependencies-choir: want TAME_DEPS"
assert welcome.out contains "ELDER_STYLE=yes" else "equinox-tb-dependencies-choir: want ELDER_STYLE"

let refuse = run ["sh" "tools/fixtures/tigerbeetle_dependencies_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-dependencies-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-dependencies-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-dependencies-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_dependencies_almanac.sh"]
assert almanac.ok else "equinox-tb-dependencies-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-dependencies-choir — zero deps · Zig · supply · elder style · absent refuses · almanac seat 57"
