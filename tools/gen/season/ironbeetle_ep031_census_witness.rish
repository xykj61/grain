# tools/gen/season/ironbeetle_ep031_census_witness.rish -- e81 IronBeetle ep031½.
#
#   rishi/bin/rishi run tools/gen/season/ironbeetle_ep031_census_witness.rish
#
# Clean-room: presence only - never copies into rye/.
# Leaf only -- no nested elder choirs.

say "iron-ep031: Language EN — a fact kept in two different shapes."
say "iron-ep031: Style Radiant — journal and checkpoint must truly copy the same fact."
say "iron-ep031: Lens TAME — e81 · clean-room study · almanac seat 86."

let shelf = run ["test" "-d" "gratitude/ironbeetle"]
assert shelf.ok else "iron-ep031: gratitude/ironbeetle ABSENT — host shelf first"

let census = run ["sh" "tools/fixtures/ironbeetle_ep031_census.sh"]
say census.out
assert census.ok else "iron-ep031: census failed or thin"
assert census.out contains "IRON=present" else "iron-ep031: want IRON=present"
assert census.out contains "verdict=ok" else "iron-ep031: want verdict=ok"
assert census.out contains "EP031=yes" else "iron-ep031: ep031.5 file must be present"
assert census.out contains "HONORS=yes" else "iron-ep031: Honors heading must be present"
assert census.out contains "SOURCE=yes" else "iron-ep031: Source heading must be present"
assert census.out contains "TEACH=yes" else "iron-ep031: teach limbs (two shapes·journal/checkpoint·pipeline·quorum) must be present"
assert census.out contains "RHYME=yes" else "iron-ep031: rhyme section must be present"
assert census.out contains "CLEAN=yes" else "iron-ep031: Clean Room heading must be present"
assert census.out contains "MATKLAD_OK=yes" else "iron-ep031: matklad companion must cite ironbeetle/"

say "GREEN: iron-ep031 — honors·source·teach·rhyme·clean·matklad ok"
