# tools/gen/season/equinox_tigerbeetle_style_by_the_numbers_choir_witness.rish -- e51 -> almanac.
#
#   rishi/bin/rishi run tools/gen/season/equinox_tigerbeetle_style_by_the_numbers_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-style-numbers-choir: Language EN — style by the numbers; refuse an absent clone."
say "equinox-tb-style-numbers-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-style-numbers-choir: Lens TAME — e51 · fmt · 100 columns · almanac seat 56."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/tigerbeetle_style_by_the_numbers_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-style-numbers-choir: welcome RED"
assert welcome.out contains "GREEN: tb-style-numbers" else "equinox-tb-style-numbers-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_STYLE=yes" else "equinox-tb-style-numbers-choir: want GUIDE_STYLE"
assert welcome.out contains "GUIDE_COLS=yes" else "equinox-tb-style-numbers-choir: want GUIDE_COLS"
assert welcome.out contains "TAME_STYLE=yes" else "equinox-tb-style-numbers-choir: want TAME_STYLE"
assert welcome.out contains "ELDER_OBO=yes" else "equinox-tb-style-numbers-choir: want ELDER_OBO"

let refuse = run ["sh" "tools/fixtures/tigerbeetle_style_by_the_numbers_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-style-numbers-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-style-numbers-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-style-numbers-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_tigerbeetle_style_by_the_numbers_almanac.sh"]
assert almanac.ok else "equinox-tb-style-numbers-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-style-numbers-choir — style numbers · fmt · columns · elder obo · absent refuses · almanac seat 56"
