# tools/gen/season/equinox_ironbeetle_ep038_choir_witness.rish -- e88 -> almanac ch6.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep038_choir_witness.rish

say "equinox-iron-ep038-choir: Language EN — IronBeetle ep038 seats beat-number compaction routing."
say "equinox-iron-ep038-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep038-choir: Lens TAME — e88 · ep038 · almanac seat 93 · ch6 13/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep038_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep038-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep038" else "equinox-iron-ep038-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep038-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep038-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep038-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep038_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep038-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep038-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep038-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep038_almanac.sh"]
assert almanac.ok else "equinox-iron-ep038-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep038-choir — ep038 · clean room · absent refuses · almanac seat 93 · ch6 13/16"
