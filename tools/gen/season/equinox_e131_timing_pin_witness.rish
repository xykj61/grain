# tools/gen/season/equinox_e131_timing_pin_witness.rish -- e131 seat.
#   rishi/bin/rishi run tools/gen/season/equinox_e131_timing_pin_witness.rish
say "e131-timing-pin: Language EN — a timing figure is a pin; carry a range or re-cut."
say "e131-timing-pin: Style Radiant — manifest living-doc makes restore verified."
say "e131-timing-pin: Lens TAME — e131 · kg does not open shred · 128 reserved."

let green = run ["sh" "tools/fixtures/equinox_e131_timing_pin_scan.sh"]
assert green.ok else "e131-timing-pin: living scan must exit 0"
assert green.out contains "timing=honored" else "e131-timing-pin: want timing"
assert green.out contains "timing_law=figure_is_a_pin_range_or_recut" else "e131-timing-pin: want law"
assert green.out contains "manifest_limb=honored" else "e131-timing-pin: want living_doc limb"
assert green.out contains "bundles_tracked=0" else "e131-timing-pin: want untracked bundle"
assert green.out contains "reds_note=row_43_timing_figure_is_a_pin" else "e131-timing-pin: want REDS 43"
assert green.out contains "shred=RED" else "e131-timing-pin: want shred RED"
assert green.out contains "kg_opened_shred=refused" else "e131-timing-pin: want kg refuse"
assert green.out contains "seat_128=reserved_close_choir" else "e131-timing-pin: want 128 reserved"
assert green.out contains "verdict=ok" else "e131-timing-pin: want verdict ok"

let red = run ["sh" "tools/fixtures/equinox_e131_timing_pin_scan.sh" "prove-red"]
assert (red.ok == false) else "e131-timing-pin: prove-red must refuse"
assert red.out contains "RED_kg_opened_shred_without_word" else "e131-timing-pin: prove-red want refuse"

say "GREEN: e131-timing-pin — range or re-cut · living_doc verified · shred RED · 128 reserved"
