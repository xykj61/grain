# tools/gen/season/equinox_ironbeetle_ep018_choir_witness.rish -- e73 -> almanac ch5.
#
#   rishi/bin/rishi run tools/gen/season/equinox_ironbeetle_ep018_choir_witness.rish

say "equinox-iron-ep018-choir: Language EN — IronBeetle ep018 seats deterministic simulation failure."
say "equinox-iron-ep018-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-iron-ep018-choir: Lens TAME — e73 · ep018 · almanac seat 78 · ch5 14/16."

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/season/ironbeetle_ep018_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-iron-ep018-choir: welcome RED"
assert welcome.out contains "GREEN: iron-ep018" else "equinox-iron-ep018-choir: welcome missing GREEN"
assert welcome.out contains "TEACH=yes" else "equinox-iron-ep018-choir: want TEACH"
assert welcome.out contains "CLEAN=yes" else "equinox-iron-ep018-choir: want CLEAN"
assert welcome.out contains "MATKLAD_OK=yes" else "equinox-iron-ep018-choir: want MATKLAD_OK"

let refuse = run ["sh" "tools/fixtures/ironbeetle_ep018_census.sh" "tools/fixtures/ironbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-iron-ep018-choir: absent shelf must fail"
assert refuse.out contains "verdict=absent" else "equinox-iron-ep018-choir: want verdict=absent"
assert refuse.out contains "IRON=ABSENT" else "equinox-iron-ep018-choir: want IRON=ABSENT"

let almanac = run ["sh" "tools/gen/season/equinox_ironbeetle_ep018_almanac.sh"]
assert almanac.ok else "equinox-iron-ep018-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-iron-ep018-choir — ep018 · clean room · absent refuses · almanac seat 78 · ch5 14/16"
