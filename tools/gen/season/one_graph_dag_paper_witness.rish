# tools/gen/season/one_graph_dag_paper_witness.rish -- Surface p8 - DAG paper pins
#
#   rishi/bin/rishi run tools/gen/season/one_graph_dag_paper_witness.rish
#
# Orientation only -- does not run a graph engine.

say "one-graph: Language EN — Weave DAG · Mantra · Frame redraw."
say "one-graph: Style Radiant — paper pins; refuse invent stack."
say "one-graph: Lens TAME — Surface Season p8."

let paper = run ["test" "-f" "counsel/date/20260728/20260728-200159_surface-season-p8-one-graph-dag-redraw-paper.md"]
assert paper.ok else "one-graph: p8 paper counsel missing"

let graph = run ["test" "-f" "foundations/20260728-221253_the-graph-beneath-the-surface.md"]
assert graph.ok else "one-graph: living graph-beneath-surface foundation missing"
let graph_fossil = run ["test" "-f" "foundations/20260629-063512_the-graph-beneath-the-surface.md"]
assert graph_fossil.ok else "one-graph: June graph-beneath fossil missing"

let dream = run ["test" "-f" "foundations/20260728-220203_realidream.md"]
assert dream.ok else "one-graph: living realidream foundation missing"
let dream_fossil = run ["test" "-f" "foundations/20260629-063512_realidream.md"]
assert dream_fossil.ok else "one-graph: June realidream fossil missing"

let weave = run ["test" "-f" "mantra/src/weave.rye"]
assert weave.ok else "one-graph: mantra/src/weave.rye missing"

let connector = run ["test" "-f" "counsel/date/20260728/20260728-195456_surface-season-p5-glow-connector-seam-sketch.md"]
assert connector.ok else "one-graph: p5 connector sketch missing"

say "GREEN: one-graph — paper · foundations · weave · connector pins present"
say "GREEN: one-graph — redraw along edges; Frame is the fold; no second graph."
