# tools/ales_stereo_insert_join_witness.rish — the two-sided insert-join carried into stereo, both channels both seams in lockstep (ALES29).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES29.
# Design read: active-designing/20260814-fill-ales29-lotus-stereo-two-sided-insert-join.md
# Stands on: lotus/insert_join.rye (ALES28) — the mono two-sided `insert_join` run once per channel over its public API, so the
# stereo insert inherits the proven trailing-seam law and its scratch-clip atomicity rather than re-deriving either; lotus/pan.rye
# (ALES10) — the StereoClip whose two channels share one length, the lockstep this rung keeps.
#
# lotus/stereo_insert_join.rye runs ALES28's mono insert_join on each channel with the SAME at/lead/trail, so a keeper inserts a
# stereo span into the MIDDLE of a stereo master and the seam moves through ALES12's equal-power curve at BOTH seams of BOTH
# channels while the stereo image stays aligned. The crux is atomicity: because a StereoClip's channels are one length and a
# stereo span is one length, every ALES28 guard depends only on the shared dimensions (never a sample's value), so the left
# insert refuses if and only if the right would — atomically, before the second channel is touched. The selftest proves: both
# channels grow by the shared count (10,5,2,2 → 11 each) and stay one length; each channel carries its own audio through its own
# two seams (left 100→200, right 500→600); and an unequal span, a past-the-master position, a lead wider than the head, a trail
# wider than the following audio, and an overflow each refuse by name leaving both channels untouched and aligned. Purely local —
# no network, no keys, no funds, no real device, no real speaker.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_stereo_insert_join_witness.rish

say "ales-stereo-insert-join: Language EN — ALES29 carries the two-sided insert-join into stereo: ALES28's mono insert_join run on each channel with the same at/lead/trail, so a keeper inserts a stereo span mid-clip and both seams of both channels flow through ALES12's equal-power curve."
say "ales-stereo-insert-join: Style Radiant — the law is stated positively: both channels grow by the shared count and stay one length, each carrying its own audio through its own two seams — the stereo image stays aligned."
say "ales-stereo-insert-join: Lens TAME — the mono two-sided insert is reused whole over its public API (the proven trailing-seam law and its scratch-clip atomicity, not re-derived); atomic across the two channels — every ALES28 guard depends only on the shared dimensions, so left refuses iff right would; refuses BadRange / ClipFull by name; siloed to lotus/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_insert_join"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_insert_join.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-insert-join: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_insert_join.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-insert-join: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-insert-join: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-insert-join' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-insert-join: selftest did not print the GREEN ales-stereo-insert-join line"

say "ales-stereo-insert-join: GREEN — the trailing-seam law now lands in stereo the way a keeper works, both channels both seams crossed in lockstep. The next Lotus rung can offer a multi-slot clipboard rack, let the graft or paste join rather than butt by default, or carry a held span across the ALES0 audio wire (a module seam, Keaton's word)."
