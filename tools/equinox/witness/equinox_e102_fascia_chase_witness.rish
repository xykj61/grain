# tools/equinox/witness/equinox_e102_fascia_chase_witness.rish -- e102 / fascia chase.
#
#   rishi/bin/rishi run tools/equinox/witness/equinox_e102_fascia_chase_witness.rish
#
# Re-cuts fascia behind control. Clears memcpy app + signal-1 prose.
# Holds Class A paper lean (u89). Does not consume the fork. Almanac 106 via choir.

say "e102-fascia-chase: Language EN — control first; then re-cut the connective grade."
say "e102-fascia-chase: Style Radiant — pins reform when a round re-cuts; window catches falls."
say "e102-fascia-chase: Lens TAME — e102 · fascia chase · almanac seat 106 · ch7 10/16."

let fascia_control = run ["sh" "tools/fixtures/e/equinox_e102_fascia_chase_control.sh"]
say fascia_control.out
assert fascia_control.ok else "e102-fascia-chase: current/history seam control RED"
assert fascia_control.out contains "current 51 welcomed" else "e102-fascia-chase: want later living grade welcomed"
assert fascia_control.out contains "current 101 and missing seated 92 refused" else "e102-fascia-chase: want both planted refusals"

let control = run ["rishi/bin/rishi" "run" "tools/gen/chapter/census_control_witness.rish"]
say control.out
assert control.ok else "e102-fascia-chase: census control must GREEN before chase"
assert control.out contains "GREEN: census-control" else "e102-fascia-chase: want control GREEN"

let museum = run ["rishi/bin/rishi" "run" "tools/gen/chapter/baton_museum_census_witness.rish"]
say museum.out
assert museum.ok else "e102-fascia-chase: baton museum RED"
assert museum.out contains "census_breach_count=0" else "e102-fascia-chase: want breach 0"

let scope = run ["rishi/bin/rishi" "run" "tools/gen/chapter/prin_scope.rish"]
say scope.out
assert scope.ok else "e102-fascia-chase: prin_scope RED"
assert scope.out contains "GREEN: prin-scope" else "e102-fascia-chase: want scope GREEN"

let scan = run ["sh" "tools/fixtures/e/equinox_e102_fascia_chase_scan.sh"]
say scan.out
assert scan.ok else "e102-fascia-chase: chase scan must exit 0"
assert scan.out contains "control_gate=honored" else "e102-fascia-chase: want control_gate"
assert scan.out contains "chase_saga=honored" else "e102-fascia-chase: want saga seated"
assert scan.out contains "chase_memcpy=honored" else "e102-fascia-chase: want memcpy chase"
assert scan.out contains "chase_fascia=honored" else "e102-fascia-chase: want fascia chase"
assert scan.out contains "chase_fascia_grade_current=" else "e102-fascia-chase: want current fascia grade"
assert scan.out contains "chase_fascia_grade_seated=92" else "e102-fascia-chase: want seated fascia grade"
assert scan.out contains "chase_fascia_history=honored" else "e102-fascia-chase: want fascia history"
assert scan.out contains "chase_class_a_seated=4" else "e102-fascia-chase: want seated Class A reading"
assert scan.out contains "chase_fork_status=not_consumed" else "e102-fascia-chase: want fork waiting"
assert scan.out contains "chase_almanac=honored" else "e102-fascia-chase: want almanac"
assert scan.out contains "chase_shelf_end=ep045" else "e102-fascia-chase: want shelf end"
assert scan.out contains "e102_fascia_chase=ok" else "e102-fascia-chase: want e102 ok"
assert scan.out contains "verdict=ok" else "e102-fascia-chase: want verdict=ok"

say "GREEN: e102-fascia-chase -- control proven; saga SEATED; memcpy cleared; seated Class A 4 and fascia 92; current fascia reported; fork waiting; museum"
