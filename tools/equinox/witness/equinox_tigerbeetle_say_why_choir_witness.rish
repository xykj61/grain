# tools/equinox/witness/equinox_tigerbeetle_say_why_choir_witness.rish -- e43 -> almanac ch4.
#
#   rishi/bin/rishi run tools/equinox/witness/equinox_tigerbeetle_say_why_choir_witness.rish
#
# Chapter four opens from metal. Leaf welcome + refuse only -- no nested choirs.

say "equinox-tb-say-why-choir: Language EN — say why opens chapter four."
say "equinox-tb-say-why-choir: Style Radiant — a finding arrives; a theme may follow later."
say "equinox-tb-say-why-choir: Lens TAME — e43 · say why · almanac seat 49 · ch4 open."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# The welcome leg below asserts CONTENT the census prints only when `gratitude/tigerbeetle` is
# checked out, and that submodule is one this tree studies and never links, so a clone without it
# is a correct clone. The leaf census now SKIPs there rather than refusing, and this choir follows
# it: a choir asserting a leaf's content must skip wherever the leaf skips, or the repair one level
# down simply moves the red one level up.
#
# WHAT THIS TRADES, said plainly: the refuse leg further down proves the census still refuses an
# absent path, and that proof is skipped here too. On a host without the clone this choir was RED
# before today, so nothing checkable is lost; on a host WITH the clone every leg runs in full.
let tb_clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (tb_clone.ok == false) then say "equinox-tb-say_why-choir: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here"
if (tb_clone.ok == false) then say "GREEN: equinox-tb-say_why-choir -- skipped honestly, the clone its legs read is absent"
if (tb_clone.ok == false) then exit 0

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_say_why_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-say-why-choir: welcome RED"
assert welcome.out contains "GREEN: tb-say-why" else "equinox-tb-say-why-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_WHY=yes" else "equinox-tb-say-why-choir: want GUIDE_WHY"
assert welcome.out contains "TAME_RADIANT=yes" else "equinox-tb-say-why-choir: want TAME_RADIANT"
assert welcome.out contains "RADIANT=yes" else "equinox-tb-say-why-choir: want RADIANT"

let refuse = run ["sh" "tools/fixtures/t/tigerbeetle_say_why_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-say-why-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-say-why-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-say-why-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_say_why_almanac.sh"]
assert almanac.ok else "equinox-tb-say-why-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-say-why-choir — say why · comments as prose · absent refuses · almanac seat 49 · ch4 open"
