# tools/equinox/witness/equinox_tigerbeetle_off_by_one_choir_witness.rish -- e49 -> almanac.
#
#   rishi/bin/rishi run tools/equinox/witness/equinox_tigerbeetle_off_by_one_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-off-by-one-choir: Language EN — off-by-one; refuse an absent clone."
say "equinox-tb-off-by-one-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-off-by-one-choir: Lens TAME — e49 · index·count·size · almanac seat 55."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# The welcome leg below asserts CONTENT the census prints only when `gratitude/tigerbeetle` is
# checked out, and that submodule is one this tree studies and never links, so a clone without it
# is a correct clone. The leaf census now SKIPs there rather than refusing, and this choir follows
# it: a choir asserting a leaf's content must skip wherever the leaf skips, or the repair one level
# down simply moves the red one level up.
#
# WHAT THIS TRADES, said plainly: the refuse leg further down proves the census still refuses an
# absent path, and that proof is skipped here too. On a host without the clone this choir was RED
# before today, so nothing checkable is lost; on a host WITH the clone every leg runs in full.
let tb_clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (tb_clone.ok == false) then say "equinox-tb-off_by_one-choir: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here"
if (tb_clone.ok == false) then say "GREEN: equinox-tb-off_by_one-choir -- skipped honestly, the clone its legs read is absent"
if (tb_clone.ok == false) then exit 0

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_off_by_one_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-off-by-one-choir: welcome RED"
assert welcome.out contains "GREEN: tb-off-by-one" else "equinox-tb-off-by-one-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_OBO=yes" else "equinox-tb-off-by-one-choir: want GUIDE_OBO"
assert welcome.out contains "GUIDE_TYPES=yes" else "equinox-tb-off-by-one-choir: want GUIDE_TYPES"
assert welcome.out contains "TAME_OBO=yes" else "equinox-tb-off-by-one-choir: want TAME_OBO"
assert welcome.out contains "ELDER_CACHE=yes" else "equinox-tb-off-by-one-choir: want ELDER_CACHE"

let refuse = run ["sh" "tools/fixtures/t/tigerbeetle_off_by_one_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-off-by-one-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-off-by-one-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-off-by-one-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_off_by_one_almanac.sh"]
assert almanac.ok else "equinox-tb-off-by-one-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-off-by-one-choir — off-by-one · types · division · elder cache · absent refuses · almanac seat 55"
