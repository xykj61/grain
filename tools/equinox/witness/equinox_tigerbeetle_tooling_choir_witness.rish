# tools/equinox/witness/equinox_tigerbeetle_tooling_choir_witness.rish -- e53 -> almanac.
#
#   rishi/bin/rishi run tools/equinox/witness/equinox_tigerbeetle_tooling_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-tooling-choir: Language EN — tooling stays small; refuse an absent clone."
say "equinox-tb-tooling-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-tooling-choir: Lens TAME — e53 · Zig scripts · almanac seat 58."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# The welcome leg below asserts CONTENT the census prints only when `gratitude/tigerbeetle` is
# checked out, and that submodule is one this tree studies and never links, so a clone without it
# is a correct clone. The leaf census now SKIPs there rather than refusing, and this choir follows
# it: a choir asserting a leaf's content must skip wherever the leaf skips, or the repair one level
# down simply moves the red one level up.
#
# WHAT THIS TRADES, said plainly: the refuse leg further down proves the census still refuses an
# absent path, and that proof is skipped here too. On a host without the clone this choir was RED
# before today, so nothing checkable is lost; on a host WITH the clone every leg runs in full.
let tb_clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (tb_clone.ok == false) then say "equinox-tb-tooling-choir: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here"
if (tb_clone.ok == false) then say "GREEN: equinox-tb-tooling-choir -- skipped honestly, the clone its legs read is absent"
if (tb_clone.ok == false) then exit 0

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_tooling_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-tooling-choir: welcome RED"
assert welcome.out contains "GREEN: tb-tooling" else "equinox-tb-tooling-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_TOOL=yes" else "equinox-tb-tooling-choir: want GUIDE_TOOL"
assert welcome.out contains "GUIDE_SCRIPTS=yes" else "equinox-tb-tooling-choir: want GUIDE_SCRIPTS"
assert welcome.out contains "TAME_TOOL=yes" else "equinox-tb-tooling-choir: want TAME_TOOL"
assert welcome.out contains "ELDER_DEPS=yes" else "equinox-tb-tooling-choir: want ELDER_DEPS"

let refuse = run ["sh" "tools/fixtures/t/tigerbeetle_tooling_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-tooling-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-tooling-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-tooling-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_tooling_almanac.sh"]
assert almanac.ok else "equinox-tb-tooling-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-tooling-choir — tooling · Zig scripts · elder deps · absent refuses · almanac seat 58"
