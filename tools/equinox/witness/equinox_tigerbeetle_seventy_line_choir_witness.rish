# tools/equinox/witness/equinox_tigerbeetle_seventy_line_choir_witness.rish -- e34 -> almanac.
#
#   rishi/bin/rishi run tools/equinox/witness/equinox_tigerbeetle_seventy_line_choir_witness.rish
#
# Leaf welcome + refuse only -- no nested elder choirs.

say "equinox-tb-seventy-line-choir: Language EN — seventy lines; refuse an absent clone."
say "equinox-tb-seventy-line-choir: Style Radiant — welcome and refuse share one seat."
say "equinox-tb-seventy-line-choir: Lens TAME — e34 · seventy-line bound · almanac seat 40."

# AN ABSENT OPTIONAL GITLINK IS A FACT ABOUT THE HOST, NEVER A DEFECT (`20260908.202239`).
# The welcome leg below asserts CONTENT the census prints only when `gratitude/tigerbeetle` is
# checked out, and that submodule is one this tree studies and never links, so a clone without it
# is a correct clone. The leaf census now SKIPs there rather than refusing, and this choir follows
# it: a choir asserting a leaf's content must skip wherever the leaf skips, or the repair one level
# down simply moves the red one level up.
#
# WHAT THIS TRADES, said plainly: the refuse leg further down proves the census still refuses an
# absent path, and that proof is skipped here too. On a host without the clone this choir was RED
# before today, so nothing checkable is lost; on a host WITH the clone every leg runs in full.
let tb_clone = run ["test" "-d" "gratitude/tigerbeetle/src"]
if (tb_clone.ok == false) then say "equinox-tb-seventy_line-choir: SKIP -- gratitude/tigerbeetle is an uninitialised submodule here"
if (tb_clone.ok == false) then say "GREEN: equinox-tb-seventy_line-choir -- skipped honestly, the clone its legs read is absent"
if (tb_clone.ok == false) then exit 0

let welcome = run ["rishi/bin/rishi" "run" "tools/gen/chapter/tigerbeetle_seventy_line_census_witness.rish"]
say welcome.out
assert welcome.ok else "equinox-tb-seventy-line-choir: welcome RED"
assert welcome.out contains "GREEN: tb-seventy-line" else "equinox-tb-seventy-line-choir: welcome missing GREEN"
assert welcome.out contains "GUIDE_SEVENTY=yes" else "equinox-tb-seventy-line-choir: want GUIDE_SEVENTY"
assert welcome.out contains "TIDY=yes" else "equinox-tb-seventy-line-choir: want TIDY"
assert welcome.out contains "RATCHET=yes" else "equinox-tb-seventy-line-choir: want RATCHET"

let refuse = run ["sh" "tools/fixtures/t/tigerbeetle_seventy_line_census.sh" "tools/fixtures/tigerbeetle_ABSENT"]
say refuse.out
assert refuse.ok == false else "equinox-tb-seventy-line-choir: absent clone must fail"
assert refuse.out contains "verdict=absent" else "equinox-tb-seventy-line-choir: want verdict=absent"
assert refuse.out contains "CLONE=ABSENT" else "equinox-tb-seventy-line-choir: want CLONE=ABSENT"

let almanac = run ["sh" "tools/equinox/almanac/equinox_tigerbeetle_seventy_line_almanac.sh"]
assert almanac.ok else "equinox-tb-seventy-line-choir: almanac append failed"
say almanac.out

say "GREEN: equinox-tb-seventy-line-choir — seventy bound · tidy ratchet · absent refuses · almanac seat 40"
