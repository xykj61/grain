# caravan_system_witness.rish -- Caravan system-description self-test witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_system_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/system"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/system.rye -femit-bin=${bin}"]

assert build.ok else "caravan system build failed"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan system selftest exited non-zero"
assert test.out contains "GREEN" else "caravan system selftest not GREEN"
assert test.out contains "the declaration reads whole" else "caravan system selftest did not report a whole declaration"
assert test.out contains "W xor X held at the grammar" else "caravan system selftest did not hold W xor X at the grammar"

say "GREEN: Caravan system-description witness passed."
