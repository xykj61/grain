# tools/mycelium_cord_true_witness.rish — the Cord reads true (r4, the arc closes).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · rung r4 — read a real fixture true.
# r1 fixed the deterministic commit, r2 quarantined the equivocator, r3 let a committed Dag travel as a
# format cord-dag-v1 record — all over Dags seated in code. This closing rung carries the reader onto a
# real on-disk Cord record a keeper can open and walk, and proves the property the whole consensus rests
# on: the order the Cord reports is true to the bytes.
#
# tools/fixtures/cord_dag_truth.awk reads the same file independently; the witness asserts the app's triple
# (blocks·supply·stars) equals awk's — two tools, one answer (4 700 1). The fixture is genuinely
# reproducible (the generator re-emits byte-identical bytes), and the record is a genuine committed Cord
# (the app rebuilds the Dag under the Cord's own add, re-verifying every signature, and re-committing
# reproduces the file's agreed order). Demo keeper seeds only — no real key, no funds, no network, no
# custody.
#
# Additive: r1 (commit), r2 (Byzantine refusal), and r3 (travel) re-run GREEN under this one.
#
# Scope: active-designing/20260813-032851_mycelium-consensus-cord-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_cord_true_witness.rish

say "mycelium-cord-true: Language EN — the reading of a real Cord record is true to the bytes; app and awk give one answer."
say "mycelium-cord-true: Style Radiant — the cord is drawn from the ground and walked bead by bead; what it says is what a keeper can count by hand."
say "mycelium-cord-true: Lens TAME — blocks, supply, and stars cross-check against an independent awk; the Dag rebuilt under the Cord's own add; a tampered record never read as true; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-cord-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent count of the same bytes" else "mycelium-cord-true: read-true claim missing"
assert selftest.out contains "re-renders to the embedded bytes exactly, and its blocks stand in the agreed order" else "mycelium-cord-true: genuine-cord claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-cord-true: tamper refusal missing"
assert selftest.out contains "The Cord's agent-doable arc closes" else "mycelium-cord-true: arc-close claim missing"

# The crux — two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-cord-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/cord_dag_truth.awk tools/fixtures/cord_dag.bron"]
assert awk.ok else "mycelium-cord-true: awk truth read failed"
assert awk.out contains "4 700 1" else "mycelium-cord-true: awk triple not 4 700 1"
assert app.out == awk.out else "mycelium-cord-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is genuinely reproducible — the generator re-emits byte-identical bytes, so the on-disk
# record is what the Cord renders, never a hand-mock. Emit to a scratch path and diff (never overwrite
# the committed fixture in a read-only witness).
let gen = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_fixture_gen.rye -femit-bin=mycelium/bin/cord_fixture_gen"]
assert gen.ok else "mycelium-cord-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/cord_fixture_gen 2> /tmp/cord_dag_regen.bron; diff tools/fixtures/cord_dag.bron /tmp/cord_dag_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-cord-true: the fixture generator did not reproduce the committed bytes"
assert regen.out contains "REPRODUCIBLE" else "mycelium-cord-true: the regenerated fixture drifted from the committed one"

# r1, r2, and r3 stay their own GREEN binaries — this rung reads the record r3 renders, never replaces it.
let r3 = run ["sh" "-c" "rishi/bin/rishi run tools/mycelium_cord_bron_witness.rish 2>&1"]
assert r3.ok else "mycelium-cord-true: rung three (travel) is not GREEN"
assert r3.out contains "mycelium-cord-bron: GREEN" else "mycelium-cord-true: rung three did not speak its GREEN"

say "mycelium-cord-true: GREEN — a real Cord record reads true (app==awk, 4 700 1), its supply rebuilt under the Cord's own add and folded through the real Mycelium law, its blocks in the agreed order, its fixture reproducible; the travel round stands at r4's door. The Mycelium Cord's agent-doable arc closes."
