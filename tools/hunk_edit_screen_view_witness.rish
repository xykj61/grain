# tools/hunk_edit_screen_view_witness.rish — the whole Photos screen in one call on metal (HUNK53).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK53.
# Design read: active-designing/20260813-210626_hunk-screen-view-exploration.md.
# Teacher, thanked clean-room: the editing screen of a photo app (iCloud Photos / Google Photos) — the tool palette
# stacked over the picture, one surface a keeper reads top to bottom (concept only, siloed).
#
# HUNK52 painted the gesture strip as a chip row and HUNK51 paints the edited picture — two proven surfaces a caller
# still placed by hand. This rung composes them: paint_screen stacks the chip row over the picture into one Skate grid,
# so a caller paints the whole editing screen in one call. The composition adds no drift — the screen's top row equals
# paint_strip cell-for-cell and its picture region equals paint cell-for-cell, each sub-surface written into its own
# place unchanged. The selftest proves the stack, the no-drift, a tap centered on a chip editing the picture region in
# the composed screen, an unbound screen refusing EmptyStrip, and bad geometry refusing at open. No network, no key,
# no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_edit_screen_view_witness.rish

say "hunk-edit-screen-view: Language EN — HUNK53 stacks HUNK52's chip row over HUNK51's picture into one Skate grid: the whole Photos screen in one call."
say "hunk-edit-screen-view: Style Radiant — the palette above, the picture below; each sub-surface written into its own place unchanged, so the composed screen adds no drift."
say "hunk-edit-screen-view: Lens TAME — a pure composition over two proven grids; no new render primitive, no new clamp, no new refusal beyond the strip's own EmptyStrip; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/edit_screen_view"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/edit_screen_view.rye -femit-bin=${bin}"]
assert build.ok else "hunk-edit-screen-view: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-edit-screen-view: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-edit-screen-view: ${out}"

assert out contains "GREEN edit-screen-view" else "hunk-edit-screen-view: selftest did not print the GREEN edit-screen-view line"
assert out contains "stacks the chip row over the picture into one" else "hunk-edit-screen-view: the screen did not stack the palette over the picture"
assert out contains "the top row equals paint_strip cell-for-cell and the picture region equals paint cell-for-cell (no drift)" else "hunk-edit-screen-view: the composition drifted from its sub-surfaces"
assert out contains "a tap centered on chip 0 repaints the picture region blue in the composed screen" else "hunk-edit-screen-view: a tap did not edit the picture region in the composed screen"
assert out contains "an unbound screen refuses EmptyStrip" else "hunk-edit-screen-view: an unbound screen did not refuse EmptyStrip"
assert out contains "each refuse at open by name" else "hunk-edit-screen-view: bad geometry did not refuse at open"

say "hunk-edit-screen-view: GREEN — the whole Photos screen paints in one call: the chip palette stacked over the edited picture, no drift from either sub-surface, a tap on a chip editing the picture in the composed screen, and an unbound screen or bad geometry refusing by name; no network, no key, no funds."
