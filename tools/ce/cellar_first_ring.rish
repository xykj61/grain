# cellar_first_ring.rish -- Cellar first ring: export, golden digest, restore, tamper fails. - 20260801
# The golden digest came from openssl until `20260821.183500`; it now comes from this tree's own
# authored Keccak (crypto/sha3_file.rye), same SHA3-256, no external dependency (REDS %116).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ce/cellar_first_ring.rish

say "cellar first lap: export -> verify (golden digest) -> restore -> tamper must fail..."

let result = run ["sh" "tools/fixtures/cellar_ring1_witness.sh"]
say result.out

assert result.ok else "cellar first lap witness failed"
say "GREEN: cellar first lap witness passed."
