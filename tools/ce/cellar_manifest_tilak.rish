# cellar_manifest_tilak.rish — I6: cellar manifest hygiene (three-field Tilak line).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ce/cellar_manifest_tilak.rish

let result = run ["sh" "tools/fixtures/cellar_manifest_tilak_witness.sh"]
say result.out
assert result.ok else "cellar manifest tilak witness failed"
assert result.out contains "GREEN" else "cellar manifest tilak witness not GREEN"

say "GREEN: cellar manifest Tilak witness passed (legacy + tilak goldens)."
