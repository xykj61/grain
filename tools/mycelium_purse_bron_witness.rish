# tools/mycelium_purse_bron_witness.rish — the per-account verdict travels as a readable record (r2).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the per-account double-spend verdict · rung r2 — travel.
# r1 resolved a Cord's agreed order into a Purse — every account's balance, which transfers moved coins, which
# came up short. A verdict a node cannot hand to another is only a local reading, so r2 lets a resolved Purse
# cross as `format purse-v1` bytes: an `issued <total>` line, one `holds <pk> <balance>` line per account, one
# `moved <from> <to> <amount> <pos> <round>` line per winning transfer, one `short <from> <amount> <pos>
# <received-at>` line per spent-out loss. Render writes it, parse reads it back, so a round trip is a fixed
# point — and the recovered Purse reports the identical balances, counts, and totals.
#
# The record carries CONSERVATION as its own law, the way till-v1 carried the supply law: the balances a record
# claims must sum to exactly the `issued` total it names, or the reader refuses `BadInt` before the record is
# trusted — no coin appears or vanishes in the crossing. A purpose-built bounded reader refuses whole: a bad
# header (`BadFormat`), an unknown field (`UnknownField`, never dropped), a bad hex key (`BadHex`), a broken
# conservation law (`BadInt`), a missing issued line (`BadFormat`), an over-long verdict (`TooManyMoves`).
# Composes purse + fold public API only; every buffer bounded; demo keeper seeds — no key, no funds, no network,
# no custody.
#
# Scope: active-designing/20260813-070923_mycelium-purse-per-account-balances-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_purse_bron_witness.rish

say "mycelium-purse-bron: Language EN — the per-account verdict a node reached becomes readable text another node reads back unchanged."
say "mycelium-purse-bron: Style Radiant — the balances that crossed sum to exactly what genesis issued; no coin appears or vanishes in the crossing."
say "mycelium-purse-bron: Lens TAME — render and a purpose-built bounded reader compose purse + fold public API; conservation travels as the record's own law; six malformed records refuse whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/purse_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/purse_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-purse-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-purse-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-purse-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte" else "mycelium-purse-bron: round-trip claim missing"
assert selftest.out contains "conservation to" else "mycelium-purse-bron: conservation-travels claim missing"
assert selftest.out contains "each refuse" else "mycelium-purse-bron: refusal claim missing"
assert selftest.out contains "fixed point" else "mycelium-purse-bron: fixed-point claim missing"

# The Purse whose resolved verdict this record carries stands at the door — its own r1 selftest proves the
# verdict the travelling bytes render.
let purse = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/purse.rye -femit-bin=mycelium/bin/purse && mycelium/bin/purse 2>&1"]
assert purse.ok else "mycelium-purse-bron: the Purse whose verdict travels is not GREEN"
assert purse.out contains "GREEN" else "mycelium-purse-bron: the Purse did not speak its GREEN"

say "mycelium-purse-bron: GREEN — the per-account verdict renders to a format purse-v1 record and parses back byte-for-byte, the recovered balances and loss identical and conservation intact; a bad header, unknown field, bad hex, broken conservation law, missing issued, and over-long verdict each refuse; the Purse stands at the door."
