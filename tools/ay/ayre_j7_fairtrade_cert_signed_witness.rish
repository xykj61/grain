# tools/ay/ayre_j7_fairtrade_cert_signed_witness.rish -- AYRE Journey 7 (Fair-trade), Rung 2.
#
# Season 2, Yield -- trades fairly. Rung one fixed a certificate's meaning as a join; a plain
# record proves a name appears, not that a party vouched for it. pond/apps/fairtrade_cert_signed.rye
# binds each attestation to a settled Kumara identity -- the attesting party signs the exact fact
# (their point, the criterion name), and a satisfied certificate requires every required criterion's
# signature to verify against the attester's known keeper key. A forged signature, a criterion
# relabeled after signing, and an attester the keyring does not know each refuse -- so a steward
# cannot certify a criterion no party vouched for. Mirrors commerce_trade_signed's signing; composes
# rung one's certificate parse. Facts only; no funds move, no real key is held (custody gate %3
# untouched); demo keeper seeds only.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ay/ayre_j7_fairtrade_cert_signed_witness.rish

say "ayre-j7r2: Language EN — a fair-trade certificate is satisfied only when every criterion carries a known party's verifying signature."
say "ayre-j7r2: Lens TAME — a forged signature, a relabeled attestation, and an unknown attester each refuse the whole certification."

let zig = "vendor/zig-toolchain/zig"

# Rung one stays GREEN beneath the signing layer -- additive.
let bin1 = "pond/bin/fairtrade-cert"
let build1 = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/fairtrade_cert.rye -femit-bin=${bin1}"]
assert build1.ok else "ayre-j7r2: rung-one fairtrade_cert build failed"
let self1 = run ["sh" "-c" "${bin1} selftest 2>&1"]
assert self1.ok else "ayre-j7r2: rung-one selftest exited non-zero"
assert self1.out contains "GREEN" else "ayre-j7r2: rung-one did not speak GREEN"

let bin = "pond/bin/fairtrade-cert-signed"
let build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/fairtrade_cert_signed.rye -femit-bin=${bin}"]
assert build.ok else "ayre-j7r2: fairtrade_cert_signed build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "ayre-j7r2: fairtrade_cert_signed selftest exited non-zero"
assert selftest.out contains "GREEN" else "ayre-j7r2: selftest did not speak GREEN"
assert selftest.out contains "satisfied in declared order" else "ayre-j7r2: satisfied-in-order missing"
assert selftest.out contains "refused Unsatisfied" else "ayre-j7r2: unheld refusal missing"
assert selftest.out contains "refused BadAttestation — a criterion no party vouched for" else "ayre-j7r2: forged refusal missing"
assert selftest.out contains "relabeled after signing refused BadAttestation" else "ayre-j7r2: relabel refusal missing"
assert selftest.out contains "refused UnknownAttester" else "ayre-j7r2: unknown-attester refusal missing"

say "GREEN: AYRE-J7r2 fairtrade_cert_signed — a certificate is satisfied only when every criterion carries a known party's verifying signature; forgery, relabel, and unknown attester refused."
