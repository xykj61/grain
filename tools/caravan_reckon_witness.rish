# caravan_reckon_witness.rish -- Caravan reckon witness.
#
# `confer.rye` closed the gap at the front of a dependent's life, `revoke.rye`
# the gap at the back of a standing one, `reclaim.rye` the gap after its holder
# is gone, and `abandon.rye` counted what a fallen holder's conferral never
# bought. Four rungs about one dependent at a time. None of them asks what the
# PLAN itself amounts to.
#
#   A PLAN THAT LOST AN ARC IS REPORTED SHORT, AND THE RUN SAYS SO.
#
# `abandon.rye` writes the abandoned reach into the departed domain's own notes
# and reads it back, so the number is a fact. Yet the run that wrote it still
# returns cleanly: the record drained, every outcome matched the word its
# author declared, and the report reads four phases queued, three dependents
# reaped, one absorbed. An operator reads that as a plan carried out, with the
# abandoned count sitting quietly beside it as one more number among a dozen
# that nobody has to look at.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO ROOMS DISAGREE ON IS OVERCLAIMED COMPLETION -- a plan
#     reported carried out while an arc it absorbed bought nothing. The four
#     counts before it measure reach a dependent held; this one measures a
#     CLAIM the supervisor made, and it is the first number in this arc that
#     weighs the report rather than the run. It falls from 1 to 0.
#   * EVERY OTHER NUMBER STANDS STILL, including the abandoned reach itself,
#     which reads 1 under both ledgers. Both runs take up 4 phases, spend 3
#     dependents, carry 1 home, confer 1 arc, reclaim 1 conferral, absorb 1
#     phase, and lose 1 arc. Only the verdict moves, which is what makes this
#     a finding about the report rather than about the work.
#   * COMPLETION BECOMES A VERDICT THE RUN EARNS. A plan is `carried` when
#     every phase it absorbed into a standing dependent was actually served,
#     and `short` when any of them was not. A drained queue is evidence that
#     every phase was taken up, and taking a phase up is a different act from
#     serving it.
#   * THE VERDICT STANDS ON THE WIRE, and this witness reads it there rather
#     than trusting the run's own telling: the plan's note carries the word
#     after the last dependent is reaped, so an operator can read the plan's
#     verdict once the supervisor that formed it has exited.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE PLAN RATHER THAN ONE
#     DEPENDENT. `ReckonEarly` is the moment: a plan with a dependent still in
#     flight has not finished, and a verdict taken there would judge work that
#     may yet be carried. `ReckonUnabsorbed` is the work: a plan that absorbed
#     no phase into a standing dependent has nothing this rung can weigh.
#     `ReckonMiscounted` is the honesty of the count: a plan cannot lose more
#     arcs than it absorbed. `ReckonOverclaimed` is the answer -- the hard half
#     -- since a run that read back a verdict of CARRIED while an arc it
#     absorbed bought nothing would report a plan carried out that nobody
#     carried out.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 9 pairs -- this
#     arc's standing generalization test.
#
# All five RED paths were proven on metal before this witness claimed GREEN.
# Let the fold forget the moment and a plan is judged while a dependent still
# stands. Let it forget the work and a plan that absorbed nothing is reckoned
# all the same. Let it forget the honesty of the count and a plan loses more
# arcs than it ever absorbed. Withhold the verdict from the wire and the run
# refuses its own record with `ReckonOverclaimed` rather than trusting a
# judgment it never read back. And derive the verdict as if nothing were lost,
# so a reckoning run would report its plan carried out -- the guard catching
# the same gap from the other side, which is what proves it is a check rather
# than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_reckon_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/reckon"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/reckon.rye -femit-bin=${bin}"]

assert build.ok else "caravan reckon build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/reckon_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/reckon_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero, every bell
# starts silent, and no run reads the last run's verdict of a plan this one has
# not finished.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.reckons"]
assert clean.ok else "the region stores, doorbells, and reckoning notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan reckon selftest exited non-zero"
assert test.out contains "GREEN" else "caravan reckon selftest not GREEN"
assert test.out contains "a plan that lost an arc is reported short, and the run says so" else "the reckoning finding did not close"

# The reckoning and its three standing refusals, read straight, before any
# dependent runs. The fourth, `ReckonOverclaimed`, belongs to the run rather
# than the fold, since only the wire can answer what a plan published about
# itself.
assert test.out contains "a drained record says every phase was taken up, never that every phase was served" else "the reckoning fold was not weighed"
assert test.out contains "three refusals stand by name: early, unabsorbed, miscounted" else "the three standing refusals did not stand"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 9 pairs" else "an unlost plan did not read as the line handed"

# The reckoning lap: one plan run twice, once assuming a drained record is a
# plan carried out and once weighing the plan against the work that was served.
# Every number stands still, including the loss itself, which is what makes the
# verdict a finding about the report rather than about the work.
assert test.out contains "phases: 4 assuming, 4 reckoning" else "the two ledgers ran different records"
assert test.out contains "dependents: 3 assuming, 3 reckoning" else "the two ledgers spent different dependents"
assert test.out contains "carried home as handed: 1 assuming, 1 reckoning" else "a dependent did not come home as it was handed"
assert test.out contains "reach conferred: 1 assuming, 1 reckoning" else "the two ledgers conferred different reach"
assert test.out contains "conferrals reclaimed: 1 assuming, 1 reckoning" else "the two ledgers reclaimed different conferrals"
assert test.out contains "phases absorbed into a standing dependent: 1 assuming, 1 reckoning" else "the two ledgers absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 1 assuming, 1 reckoning" else "the two ledgers lost different work"
assert test.out contains "the plan, as the run reports it: carried out whole assuming, short by the work nobody served reckoning" else "the two ledgers agreed about what the plan came to"
assert test.out contains "completion claimed and not served: 1 against 0" else "the assuming run and the reckoning run agreed about the claim"
assert test.out contains "breaks a named turn: 0 assuming, 0 reckoning" else "the reckoning run broke an order its author named"

# The verdict an operator reads is the one on the wire. The plan's own note is
# read here, outside the run that wrote it, exactly as an operator would.
let published_verdict = run ["sh" "-c" "cat caravan/.reckons/plan.verdict"]
assert published_verdict.ok else "the plan published no verdict an operator could read"
assert published_verdict.out contains "s" else "the wire did not carry the short verdict the run reported"

# The dependents measure the loss in their own hands, exactly as the rung below
# left them: the holder that falls says how much conferred reach it carries
# into the fall, and the holder that comes home says nothing of the kind.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "the falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent the conferral was made to did not read it as its own"
assert test.out contains "client_a: read 3 arcs of its own, 0 inherited at its first breath, 0 conferred, 0 returned, 0 still reachable at home" else "the dependent that came home read a conferral it was never made"

say "GREEN: Caravan reckon witness passed."
