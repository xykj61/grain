# tools/hunk_part_query_witness.rish — a typed search box: parse a keeper's query text into a filter (HUNK76).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK76.
# Design read: active-designing/date/20260813/20260813-234932_hunk-part-query-typed-search-box-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's search box — a typed line reaches the narrowing sidebar (concept only, siloed).
#
# HUNK75 built the narrowing (filter_catalog turns a catalog and a Query into the sub-catalog of matches). This rung
# lets a keeper reach it by TYPING: image/part_query.rye `parse_query` reads one `key:value` line (material · prefix ·
# max · min) and returns the Query it means, so filter_catalog(cat, parse_query(text)) narrows identically to the
# hand-built query. The selftest proves parse-then-filter narrows the SAME parts in the same held order for each key,
# min:0 matches every part, and a missing colon / empty key / empty value / unknown key / non-numeric price /
# over-ceiling price / over-long token each refuse by name. A price is a fact parsed to compare, never moved.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_part_query_witness.rish

say "hunk-part-query: Language EN — HUNK76 parses a keeper's typed key:value line into a part_filter Query, so a search box reaches the narrowing the filter already proved."
say "hunk-part-query: Style Radiant — a typed line means exactly the query it reads as; the search box adds no meaning of its own, and a line that says nothing clear refuses rather than narrowing to the wrong parts."
say "hunk-part-query: Lens TAME — pure parsing over public APIs; a price token is a fact parsed to compare, never a balance moved; positive invariants per fn; every malformed line refuses by name; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/part_query"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_query.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-query: build failed — ${build.err}"

let outfile = "image/bin/part_query.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "hunk-part-query: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "hunk-part-query: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN part-query' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "hunk-part-query: selftest did not print the GREEN part-query line"

# HUNK75 stays GREEN — the filter the parser drives (filter_catalog, Query, max_query_text) is the one part_filter
# proved. A search box is only trustworthy because the filter under it is.
let filt = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_filter.rye -femit-bin=image/bin/part_filter && image/bin/part_filter selftest > image/bin/part_filter.out 2>&1"]
assert filt.ok else "hunk-part-query: HUNK75 part_filter re-run failed — see image/bin/part_filter.out"
let filt_green = run ["sh" "-c" "grep -q 'GREEN part-filter' image/bin/part_filter.out && echo yes"]
assert (trim filt_green.out) == "yes" else "hunk-part-query: HUNK75 part_filter did not stay GREEN"

say "hunk-part-query: GREEN — a keeper types a line and the marketplace narrows to exactly the parts they meant; HUNK75 filter underneath stays GREEN. HUNK76 lands."
