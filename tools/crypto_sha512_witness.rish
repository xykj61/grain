# tools/crypto_sha512_witness.rish — SHA-512 authored in pure Rye: Season G's second crypto primitive, the hash Ed25519 signs with,
# proven against the FIPS 180-4 known-answer and byte-for-byte against an independent implementation (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-180728_open-season-g-crypto-blake2b.md (the season's opening read names SHA-512 as following
# the hash foundation).
# Kin: crypto/blake2b.rye (the first primitive, GREEN). Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity TARGET, never a
# copied line — our own arithmetic, studied clean-room from the public standard (.claude/rules/gratitude-licenses.md).
#
# crypto/sha512.rye authors SHA-512 from the standard — the initial hash value, the eighty round constants, the Ch/Maj/Sigma
# functions, the eighty-round compression, FIPS 180-4 padding (0x80 marker, zeros, 128-bit big-endian bit length). The primitive calls
# no std.crypto. Parity is proven at selftest against two references runnable now: the FIPS 180-4 known-answer for "abc" and the empty
# message (hex for hex), and Zig's own std.crypto SHA-512 as an independent implementation, byte-for-byte over the empty message,
# "abc", a 111-byte input, a 112-byte input (the edge that forces a second all-padding block), and a 300-byte multi-block input. The
# vendored Monocypher source is a held network fetch, so Monocypher-source parity is an honest horizon rung. An over-long message
# refuses MessageTooLong before a byte is mixed. Purely local arithmetic — no key, no signature, no network, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/crypto_sha512_witness.rish

say "crypto-sha512: Language EN — Season G's second primitive: SHA-512, the hash Ed25519 signs with (RFC 8032 / FIPS 180-4), the direct next stone toward the Rye-native signing that unblocks the Lotus signed carry. Pure 64-bit integer arithmetic, no big-integer field math, so it is genuinely buildable in authored Rye this round, and it carries a published FIPS 180-4 known-answer that ties parity to a neutral public reference."
say "crypto-sha512: Style Radiant — the law is stated positively: sixteen big-endian words per 128-byte block expand to an eighty-word message schedule and fold through eighty rounds of the Ch/Maj/Sigma round function, every add mod 2^64, every rotation and shift a fixed constant, the message padded with a 0x80 marker and a 128-bit big-endian bit length so the same bytes always fold to the same 64-byte digest anyone can replay against the standard."
say "crypto-sha512: Lens TAME — the primitive calls no std.crypto; it is authored from the standard, bounded input (max_message_bytes), contract asserts on every function, wrapping +% where the math is mod 2^64. Parity holds against the FIPS 180-4 known-answer AND Zig's independent std.crypto SHA-512 byte-for-byte over the empty message, \"abc\", a 111-byte input, a 112-byte padding-edge input, and a multi-block input; an over-long message refuses MessageTooLong before a byte is mixed. Monocypher-source parity is a named horizon behind the held vendor fetch. Purely local — no key, no signature, no network, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/sha512"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/sha512.rye -femit-bin=${bin}"]
assert build.ok else "crypto-sha512: build failed — ${build.err}"

let outfile = "crypto/bin/sha512.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-sha512: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-sha512: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-sha512' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-sha512: selftest did not print the GREEN crypto-sha512 line"
