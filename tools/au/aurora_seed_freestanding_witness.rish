# aurora_seed_freestanding_witness.rish -- the whole boot floor compiles for metal (no QEMU).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/au/aurora_seed_freestanding_witness.rish
#
# Proves the language -> bare-metal pipeline reaches every Aurora boot stage
# entirely in-sandbox: cross-build each aurora/src/<stage>.rye freestanding for
# riscv64 via `rye build` (the Rye compiler wrapper the stack actually uses) and
# confirm every artifact is a RISC-V ELF (ELF header e_machine == 243 == EM_RISCV,
# byte 18). QEMU is needed only to WAKE a stage, never to build it -- so this gate
# is GREEN wherever the toolchain lives, independent of any emulator on the bench.
#
# Two hazards this shape avoids:
#   * The build path is `rye build`, not raw `zig build-exe`: zig does not know the
#     .rye extension, so a raw-zig gate would silently no-op and read a stale ELF
#     (a false green). Each stage is removed (rm -f) before its build, so only a
#     fresh compile can satisfy the e_machine check.
#   * Each stage's command is fully literal -- no shell $variables -- because Rishi
#     interpolates `$name`, which would collide with a shell loop variable.

# Every stage: rm the old artifact, cross-build freestanding, print e_machine of the
# fresh ELF. `&&` means a failed build never reaches `od`, so `out` will not carry 243.

let seed = run ["sh" "-c" "rm -f tools/.build/aurora_seed.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/seed.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_seed.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_seed.elf | tr -d ' \\n'"]
assert (seed.out contains "243") else "seed stage did not cross-build to a RISC-V ELF"

let relay = run ["sh" "-c" "rm -f tools/.build/aurora_relay.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/relay.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_relay.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_relay.elf | tr -d ' \\n'"]
assert (relay.out contains "243") else "relay stage did not cross-build to a RISC-V ELF"

let wire = run ["sh" "-c" "rm -f tools/.build/aurora_wire.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/wire.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_wire.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_wire.elf | tr -d ' \\n'"]
assert (wire.out contains "243") else "wire stage did not cross-build to a RISC-V ELF"

let sealed = run ["sh" "-c" "rm -f tools/.build/aurora_sealed.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/sealed.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_sealed.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_sealed.elf | tr -d ' \\n'"]
assert (sealed.out contains "243") else "sealed stage did not cross-build to a RISC-V ELF"

let posted = run ["sh" "-c" "rm -f tools/.build/aurora_posted.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/posted.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_posted.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_posted.elf | tr -d ' \\n'"]
assert (posted.out contains "243") else "posted stage did not cross-build to a RISC-V ELF"

let deciding = run ["sh" "-c" "rm -f tools/.build/aurora_deciding.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/deciding.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_deciding.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_deciding.elf | tr -d ' \\n'"]
assert (deciding.out contains "243") else "deciding stage did not cross-build to a RISC-V ELF"

let named = run ["sh" "-c" "rm -f tools/.build/aurora_named.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/named.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_named.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_named.elf | tr -d ' \\n'"]
assert (named.out contains "243") else "named stage did not cross-build to a RISC-V ELF"

let kumara = run ["sh" "-c" "rm -f tools/.build/aurora_kumara.elf; env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build aurora/src/kumara.rye -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=tools/.build/aurora_kumara.elf >/dev/null 2>&1 && od -An -tu1 -j18 -N1 tools/.build/aurora_kumara.elf | tr -d ' \\n'"]
assert (kumara.out contains "243") else "kumara stage did not cross-build to a RISC-V ELF"

say "GREEN: all eight Aurora boot stages cross-build freestanding riscv64 — RISC-V ELF (e_machine 243), no QEMU to build (seed relay wire sealed posted deciding named kumara)."
