# tools/au/aurora_a1_living_stages_eq_witness.rish -- Ashvini equality: exact 6 (STOA337).
#
#   rishi/bin/rishi run tools/au/aurora_a1_living_stages_eq_witness.rish
#
# gth speaks ceilings. eq speaks exactly. Aurora's six living stages (seed -
# relay - named - sealed - wire - posted) are the third pedestal that could
# not decide until this rune -- 6->1, neighbors->0.

say "eq-stg: Language EN — the third exact deciding gate (STOA337)."
say "eq-stg: Lens TAME — exact match; both sides; gth neighbor still stands."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-aurora-living-stages-eq-u32.glow"

say "eq-stg: exact 6 answers 1..."
let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "6"]
assert ok.ok else "eq-stg: exact case failed to run"
assert ok.out contains "EXIT:0" else "eq-stg: exact case did not exit 0"
assert ok.out contains "1" else "eq-stg: exact 6 did not speak 1"

say "eq-stg: just under (5) answers 0..."
let under = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "5"]
assert under.ok else "eq-stg: under case failed to run"
assert under.out contains "0" else "eq-stg: 5 did not speak 0"

say "eq-stg: just over (7) answers 0..."
let over = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "7"]
assert over.ok else "eq-stg: over case failed to run"
assert over.out contains "0" else "eq-stg: 7 did not speak 0"

say "eq-stg: the desk names eq, not gth..."
let verb = run ["sh" "-c" "grep -qE '^[?][:]  [(]eq ' src/lib/gate-aurora-living-stages-eq-u32.glow"]
assert verb.ok else "eq-stg: the desk stopped naming eq"

say "eq-stg: gth neighbor (aurora wire bound) still green..."
let gth = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "src/lib/gate-aurora-wire-bound-u32.glow" "128"]
assert gth.ok else "eq-stg: gth neighbor failed"
assert gth.out contains "1" else "eq-stg: gth neighbor did not speak 1"

say "GREEN: equality third — living stages=6 decide exactly; gth still stands."
