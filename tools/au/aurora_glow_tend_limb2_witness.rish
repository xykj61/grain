# tools/au/aurora_glow_tend_limb2_witness.rish — Aurora A2 in src/sur/ (e200).
#
#   rishi/bin/rishi run tools/au/aurora_glow_tend_limb2_witness.rish

say "aurora-tend-2: Language EN — second Aurora Glow Tend limb (sur museum)."
say "aurora-tend-2: Style Radiant — seed_length pedestal; boot stays in aurora/src."
say "aurora-tend-2: Lens TAME — Equinox e200 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-aurora-seed-length.glow"

say "aurora-tend-2: placard..."
let placard = run ["sh" "-c" "head -n 7 src/sur/shape-aurora-seed-length.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "aurora-tend-2: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "aurora-tend-2: placard missing six lines"

say "aurora-tend-2: example locks to rye seed_length..."
let ex = run ["sh" "-c" "grep -q 'example    32' src/sur/shape-aurora-seed-length.glow"]
assert ex.ok else "aurora-tend-2: example 32 missing"
let elder = run ["sh" "-c" "grep -q 'aurora/src/kumara.rye' src/sur/shape-aurora-seed-length.glow"]
assert elder.ok else "aurora-tend-2: kumara.rye citation missing"

say "aurora-tend-2: rye still exports seed_length and packs 32-byte seeds..."
let rye = run ["sh" "-c" "grep -q 'pub const seed_length' aurora/src/kumara.rye"]
assert rye.ok else "aurora-tend-2: pub const seed_length missing in kumara"
let doc = run ["sh" "-c" "grep -q '32-byte seed' aurora/src/kumara.rye"]
assert doc.ok else "aurora-tend-2: kumara must still name 32-byte seed"
let posted = run ["sh" "-c" "grep -Fq 'const seed_alice = [_]u8{0xA1} ** 32;' aurora/src/posted.rye"]
assert posted.ok else "aurora-tend-2: posted seed_alice must remain ** 32"

say "aurora-tend-2: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "aurora-tend-2: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "aurora-tend-2: shape did not exit 0"

say "aurora-tend-2: A1, C4, and T5 still present..."
let prior = run ["sh" "-c" "test -f src/sur/shape-aurora-wire-capacity.glow -a -f src/sur/shape-caravan-supervisor-exit-meanings.glow -a -f src/lib/shape-tally-maybe-poles.glow"]
assert prior.ok else "aurora-tend-2: A1, C4, or T5 missing"

say "GREEN: aurora Glow Tend limb 2 — seed_length=32 in src/sur/; Tend ladder kept."
