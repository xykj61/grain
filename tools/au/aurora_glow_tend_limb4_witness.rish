# tools/au/aurora_glow_tend_limb4_witness.rish -- Aurora A4 in src/sur/ (e208).
#
#   rishi/bin/rishi run tools/au/aurora_glow_tend_limb4_witness.rish

say "aurora-tend-4: Language EN — fourth Aurora Glow Tend limb (sur museum)."
say "aurora-tend-4: Style Radiant — signature_length pedestal; boot stays in aurora/src."
say "aurora-tend-4: Lens TAME — Equinox e208 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-aurora-signature-length.glow"

say "aurora-tend-4: placard..."
let placard = run ["sh" "-c" "head -n 7 src/sur/shape-aurora-signature-length.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "aurora-tend-4: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "aurora-tend-4: placard missing six lines"

say "aurora-tend-4: example locks to 64..."
let ex = run ["sh" "-c" "grep -q 'example    64' src/sur/shape-aurora-signature-length.glow"]
assert ex.ok else "aurora-tend-4: example 64 missing"
let elder = run ["sh" "-c" "grep -q 'aurora/src/kumara.rye' src/sur/shape-aurora-signature-length.glow"]
assert elder.ok else "aurora-tend-4: kumara.rye citation missing"

say "aurora-tend-4: rye still exports signature_length..."
let rye = run ["sh" "-c" "grep -q 'pub const signature_length' aurora/src/kumara.rye"]
assert rye.ok else "aurora-tend-4: pub const signature_length missing in kumara"
let encoded = run ["sh" "-c" "grep -q 'Signature.encoded_length' aurora/src/kumara.rye"]
assert encoded.ok else "aurora-tend-4: encoded_length alias missing"
# Ed25519 signatures are 64 octets -- lock via verify_bytes slice comment path
let sixtyfour = run ["sh" "-c" "grep -Fq 'sig_bytes[0..signature_length]' aurora/src/kumara.rye"]
assert sixtyfour.ok else "aurora-tend-4: verify_bytes must still slice by signature_length"

say "aurora-tend-4: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "aurora-tend-4: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "aurora-tend-4: shape did not exit 0"

say "aurora-tend-4: A3 and Mantra M4 still present..."
let prior = run ["sh" "-c" "test -f src/sur/shape-aurora-living-stages.glow -a -f src/sur/shape-mantra-store-dir-count.glow"]
assert prior.ok else "aurora-tend-4: A3 or M4 missing"

say "GREEN: aurora Glow Tend limb 4 — signature_length=64 in src/sur/; Tend ladder kept."
