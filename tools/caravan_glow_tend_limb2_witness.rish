# tools/caravan_glow_tend_limb2_witness.rish — second Caravan Glow Tend limb (e195).
#
#   rishi/bin/rishi run tools/caravan_glow_tend_limb2_witness.rish

say "caravan-tend-2: Language EN — second Caravan Glow Tend limb."
say "caravan-tend-2: Style Radiant — pedestal beside Rye; no supervisor rewrite."
say "caravan-tend-2: Lens TAME — Equinox e195 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/shape-caravan-max-caps-per-dependent.glow"

say "caravan-tend-2: placard..."
let placard = run ["sh" "-c" "head -n 7 src/lib/shape-caravan-max-caps-per-dependent.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "caravan-tend-2: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "caravan-tend-2: placard missing six lines"

say "caravan-tend-2: example locks to rye max_caps_per_dependent..."
let ex = run ["sh" "-c" "grep -q 'example    8' src/lib/shape-caravan-max-caps-per-dependent.glow"]
assert ex.ok else "caravan-tend-2: example 8 missing on pedestal"
let name = run ["sh" "-c" "grep -q 'max_caps_per_dependent' src/lib/shape-caravan-max-caps-per-dependent.glow"]
assert name.ok else "caravan-tend-2: max_caps_per_dependent name missing"
let elder = run ["sh" "-c" "grep -q 'caravan/capabilities.rye' src/lib/shape-caravan-max-caps-per-dependent.glow"]
assert elder.ok else "caravan-tend-2: capabilities.rye citation missing"
let rye = run ["sh" "-c" "grep -E '^pub const max_caps_per_dependent: u32 = 8;$' caravan/capabilities.rye"]
assert rye.ok else "caravan-tend-2: rye max_caps_per_dependent must remain 8"

say "caravan-tend-2: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk]
assert gate.ok else "caravan-tend-2: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "caravan-tend-2: shape did not exit 0"

say "caravan-tend-2: C1 still present..."
let c1 = run ["sh" "-c" "test -f src/lib/shape-caravan-max-dependents.glow"]
assert c1.ok else "caravan-tend-2: C1 pedestal missing"

say "caravan-tend-2: Tally Tend still present..."
let tally = run ["sh" "-c" "test -f src/lib/shape-tally-max-gardens.glow -a -f src/lib/shape-tally-copy-preconditions.glow"]
assert tally.ok else "caravan-tend-2: Tally pedestals missing"

say "tend-ladder: Aurora A1 may be present..."
let aurora = run ["sh" "-c" "test -f src/sur/shape-aurora-wire-capacity.glow"]
assert aurora.ok else "tend-ladder: Aurora A1 pedestal missing after e197"

say "GREEN: caravan Glow Tend limb 2 — max_caps_per_dependent=8 pedestal; C1 kept."
