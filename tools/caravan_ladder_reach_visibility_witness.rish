# tools/caravan_ladder_reach_visibility_witness.rish -- the widening cost of a
# fold is measured, never described.
#
#   rishi/bin/rishi run tools/caravan_ladder_reach_visibility_witness.rish
#
# The lift arc weighs every family by two numbers: the fall it returns, and the
# declarations it would have to widen. The first has always come off a meter.
# The second came off a hand reading a diff, and on 20260822 it was measured for
# the first time and disagreed with the record on both families it named.
#
# `confirm` was written as widening exactly one declaration, because `read_count`
# stood private in one of the forty-six rungs. `read_count` is absent from that
# rung entirely -- it is `entrust.rye`, whose `confirm` waits on a different note
# through a different reader, so it was never a fold candidate and never a cost.
#
# `renew_path` and `ask_path` were each written as widening thirty-one, because
# the family stands private in all thirty-one rungs. A family's own visibility is
# not its widening cost. The cost is what its BODY reaches, and both bodies reach
# only symbols already public in every rung -- so the largest fall on the board
# carried a price of zero and was passed over four laps running (REDS %130).
#
# So the queue's second column is a measurement now. The scan hashes every body
# under a name, takes the largest identical set, drops the rungs standing below
# the fold line, reads the identifiers the shared body reaches unqualified, and
# reports how many of those each folding rung keeps private.
#
# Both refusals are proven on metal by generated controls -- a name no rung
# declares, and a name whose every body differs -- since a scan finding nothing
# must never answer ok about its own blindness (REDS %97).

say "reach-visibility: Language EN -- what a fold must widen is read off the body, never off the family's own door."
say "reach-visibility: Style Radiant -- the measurement leads, and the queue answers to it."
say "reach-visibility: Lens TAME -- the shape is measured, the fold line is honored, and both blindnesses refuse by name."

let red = run ["sh" "tools/fixtures/ladder_reach_visibility_scan.sh" "prove-red"]
say red.out
assert red.out contains "RED_no_family_refused_rather_than_ok" else "reach-visibility: a name no rung declares answered ok -- a scan must never bless its own blindness"
assert red.out contains "RED_no_identical_refused_rather_than_ok" else "reach-visibility: a name whose every body differs answered ok -- nothing folds there"

# The family this lap lifted. Fourteen of its fifteen bodies are stubs now, the
# fifteenth staying home because `suffice.rye` writes a different body, and the
# scan reads the folded shape back: fifteen rungs still declaring the name, no
# long body left to lift, so the widening column now describes the stubs.
let folded = run ["sh" "tools/fixtures/ladder_reach_visibility_scan.sh" "weigh_the_answer"]
say folded.out
assert folded.out contains "REACH_OK family=weigh_the_answer folding=14 widens=14 stub=3 fall=0" else "reach-visibility: want weigh_the_answer standing folded, with nothing left to lift"
assert folded.ok else "reach-visibility: the lifted family must still read cleanly"

# The head of the queue as it stands, and the reading that put it there. Both
# numbers are asserted, so a lap that folds this family must come back and say
# so, and a lap that quietly widens one of the symbols it reaches cannot pass.
let head = run ["sh" "tools/fixtures/ladder_reach_visibility_scan.sh" "confirm_pruned"]
say head.out
assert head.out contains "REACH_FAMILY family=confirm_pruned declared=44 identical=44 lines=15" else "reach-visibility: want confirm_pruned standing as forty-four declarations holding forty-four identical bodies at fifteen lines"
assert head.out contains "REACH_OK family=confirm_pruned folding=44 widens=0 stub=3 fall=516" else "reach-visibility: want the queue head returning five hundred and sixteen at no widening cost"
assert head.ok else "reach-visibility: the queue head must read cleanly"

# The sibling behind it, a long ladder carrying a short body and opening three
# declarations, so the next two laps are both measured rather than inherited.
let sibling = run ["sh" "tools/fixtures/ladder_reach_visibility_scan.sh" "seat_note"]
say sibling.out
assert sibling.out contains "REACH_OK family=seat_note folding=43 widens=3 stub=3 fall=504" else "reach-visibility: want seat_note returning five hundred and four over three widened declarations"
assert sibling.ok else "reach-visibility: the sibling family must read cleanly"

say "GREEN: reach-visibility -- the widening cost of a fold is read off the body it lifts, the fold line is honored, and the queue's head stands measured at zero widening with the sibling behind it priced at three"
