# tools/drey_catalog_witness.rish — the content-addressed desk catalog: recordings keyed by content (DREY7).
#
# Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY7.
# Design read: active-designing/date/20260814/20260814-064900_drey7-content-addressed-desk-catalog-exploration.md
# Stands on: mikrophone/wire.rye (DREY1) — deframe proves a payload whole before a byte is yielded; the wire's own
# Sha256 is the content address this catalog keys by.
#
# mikrophone/catalog.rye grows the desk from DREY6's arrival-order log to a content-addressed store: the same bytes key
# to one address (idempotent — a recording deposited twice is kept once), distinct bytes key distinct addresses (both
# fetch back byte-for-byte), only proven-whole recordings land (a tampered frame refuses DigestMismatch and the catalog
# stands unchanged), both bounds refuse CatalogFull before a write, a miss returns null rather than a guess, and clear
# forgets whole.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/drey_catalog_witness.rish

say "drey-catalog: Language EN — DREY7 grows the Mikrophone desk from DREY6's arrival-order log to a content-addressed catalog that keys each recording by the Sha256 of its payload — the tree's own Tablecloth spine, brought to the desk."
say "drey-catalog: Style Radiant — a desk that knows each recording by what it is keeps it once, hands it back whole to the keeper who asks by name, and never guesses on a miss."
say "drey-catalog: Lens TAME — deposit deframes verify-before-trust FIRST and computes the address over the PROVEN payload; an address already held spends no bound (idempotent); every refusal is by name (DigestMismatch, CatalogFull); the byte sum is checked in u64 so it cannot wrap; the copy is a plain bounded loop; no disk, no network, no key, no funds (custody gate %2 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "mikrophone/bin/catalog"

let build = run ["sh" "-c" "mkdir -p mikrophone/bin && env RYE_ZIG=${zig} rye/bin/rye build mikrophone/catalog.rye -femit-bin=${bin}"]
assert build.ok else "drey-catalog: build failed — ${build.err}"

let outfile = "mikrophone/bin/catalog.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "drey-catalog: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "drey-catalog: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN drey-catalog' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "drey-catalog: selftest did not print the GREEN drey-catalog line"

say "drey-catalog: GREEN — the Mikrophone desk addresses recordings by content. DREY7 keys each recording by its Sha256, keeps it once, and hands it back whole to the keeper who asks by name."
