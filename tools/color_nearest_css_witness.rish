# tools/color_nearest_css_witness.rish -- the nearest CSS-named color to any color proves itself over 148 names (Season G).
#
# Season G (Open Media Primitives) -- the fine nearest-namer beside the coarse HTML4 nearest (image/color_nearest.rye),
# the full CSS named table (image/color_names_css.rye), the coarse family reader (image/color_name_group.rye), and the
# open color algebra (image/color.rye).
# Design read: active-designing/20260816-210735_season-g-color-algebra-crux.md (the color floor this stands on).
# Teacher, thanked clean-room: gratitude/w3c-css-color.md (the W3C CSS Color spec named-color table -- public standards only).
#
# The crux this witness proves is finer naming: where color_nearest scans the sixteen HTML4 names and a cornflower blue
# reads only "blue", this scans the full 148 CSS names and reads "cornflowerblue" exactly. Written as a single-stranded
# consumer -- color_names_css OWNS the names and color DECIDES the bytes through its own parse_hex, this module only
# MEASURES squared sRGB distance and PICKS the least. Every CSS color is its own nearest at distance zero; the payoff is
# proven against the sixteen-name sibling (the CSS reading strictly nearer and finer-named for the same color); a synonym
# color reads the earliest name; alpha is outside the metric. No new storage, codec, or maths. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/color_nearest_css_witness.rish

say "color-nearest-css: Language EN -- Season G's fine nearest-namer; a keeper reads ANY color to the closest of 148 CSS names ('cornflowerblue', not merely 'blue'), over the open algebra."
say "color-nearest-css: Style Radiant -- compose not braid; color_names_css OWNS the names, color DECIDES the bytes, this module only MEASURES distance and PICKS the least; no new table or parser."
say "color-nearest-css: Lens TAME -- the scan is the fixed 148 bounded by css_named_color_count; the squared distance never leaves u32 bounded by max_dist_sq; alpha outside the metric; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/color_nearest_css"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/color_nearest_css.rye -femit-bin=${bin}"]
assert build.ok else "color-nearest-css: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "color-nearest-css: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "color-nearest-css: ${out}"

# Honour the loom REDS %76 named: check every claim with Rishi's native `contains`, never a shell grep over interpolated
# output, so punctuation in the selftest prose can never break a check.
assert out contains "GREEN image-color-nearest-css" else "color-nearest-css: selftest did not print the GREEN color-nearest-css line"
assert out contains "every one of the 148 CSS colors is its own nearest at squared distance zero" else "color-nearest-css: a CSS color was not its own nearest at distance zero"
assert out contains "reads 'cornflowerblue' at distance zero, a name the HTML4 sixteen cannot hold" else "color-nearest-css: an exact CSS name did not read at distance zero"
assert out contains "PAYOFF proven against the sixteen-name sibling" else "color-nearest-css: the finer-than-sixteen payoff was not proven"
assert out contains "a synonym color reads the earliest name" else "color-nearest-css: a synonym color did not read the earliest name"
assert out contains "alpha is outside the metric" else "color-nearest-css: alpha was not held outside the metric"

say "color-nearest-css: GREEN -- the nearest of 148 CSS names to any color; every CSS color its own nearest at distance zero, the reading strictly finer than the HTML4 sixteen, synonyms reading the earliest name, alpha outside the metric, deterministic."
