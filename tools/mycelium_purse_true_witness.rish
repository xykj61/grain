# tools/mycelium_purse_true_witness.rish — the Purse reads a real per-account double-spend fixture true (r4).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the per-account double-spend · rung r4 — the arc closes.
# r1 fixed the per-account verdict, r2 let it travel, r3 read it across a Knot — all over Dags seated in code.
# This closing rung carries the reader onto a REAL on-disk Cord record carrying a genuine per-account
# double-spend a keeper can open and walk (tools/fixtures/purse_dag.bron, produced reproducibly by
# mycelium/purse_fixture_gen).
#
# The crux this witness proves — two tools, one answer: the app (mycelium/purse_true) parses the record,
# rebuilds the Dag under cord.add (re-verifying every signature), resolves it through the Purse, and reports
# the signer of the spent-out transfer of the contested purse, the moved count, and the short count; an
# independent awk reading of the same bytes (tools/fixtures/purse_dag_truth.awk), applying the simplest honest
# slice of the agreed order — per-account balance accounting in file order — names the SAME spent-out signer
# and the same counts. So the loser of a contested purse can never drift from an order a keeper can walk by
# hand. The fixture is reproducible (the generator re-emits byte-identical bytes), and a tampered record
# refuses BadFormat. Composes cord_bron + cord + purse public API only; demo keeper seeds — no key/funds/
# network/custody.
#
# Scope: active-designing/20260813-073500_mycelium-purse-true-real-fixture-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_purse_true_witness.rish

say "mycelium-purse-true: Language EN — the spent-out holder of a real contested purse is true to the bytes; app and awk name one loser."
say "mycelium-purse-true: Style Radiant — the Cord wove one order through the dark; a keeper can walk the block lines and name the same spent-out purse the ledger does."
say "mycelium-purse-true: Lens TAME — the loser cross-checks against an independent awk; the Dag rebuilt under the Cord's own add; a tampered record never read as true; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/purse_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/purse_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-purse-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-purse-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-purse-true: selftest did not speak GREEN"
assert selftest.out contains "the spent-out holder's purse is empty" else "mycelium-purse-true: spent-out-purse-empty claim missing"
assert selftest.out contains "conservation holds over the real bytes" else "mycelium-purse-true: conservation claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-purse-true: tamper-refusal claim missing"

# The crux — two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-purse-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/purse_dag_truth.awk tools/fixtures/purse_dag.bron"]
assert awk.ok else "mycelium-purse-true: awk truth read failed"
assert awk.out contains "bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5 2 1" else "mycelium-purse-true: awk triple not Alice's round-2 spent-out transfer · moved 2 · short 1"
assert app.out == awk.out else "mycelium-purse-true: app and awk disagree — the spent-out holder drifted from the bytes"

# The fixture is genuinely what the Cord emits, not a hand-mock — the generator re-emits byte-identical bytes.
let regen = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run mycelium/purse_fixture_gen.rye 2>/tmp/purse_regen.bron >/dev/null && diff -q tools/fixtures/purse_dag.bron /tmp/purse_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-purse-true: fixture is not reproducible — the generator drifted"
assert regen.out contains "REPRODUCIBLE" else "mycelium-purse-true: fixture regeneration did not match"

# The Purse whose verdict this rung reads from real bytes, and the cord_bron reader that rebuilds the real
# Dag, both stand at the door — their own selftests prove the machinery r4 rests on.
let purse = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/purse.rye -femit-bin=mycelium/bin/purse && mycelium/bin/purse 2>&1"]
assert purse.ok else "mycelium-purse-true: the Purse r1 the reading resolves is not GREEN"
assert purse.out contains "GREEN" else "mycelium-purse-true: the Purse r1 did not speak its GREEN"

say "mycelium-purse-true: GREEN — a real per-account double-spend record reads true (app==awk, Alice's round-2 spent-out transfer · moved 2 · short 1); the loser resolved under the Cord's own add and the agreed order, conservation whole, the fixture reproducible, a tampered record refused; the Purse stands at the door. The Mycelium Purse's agent-doable arc closes."
