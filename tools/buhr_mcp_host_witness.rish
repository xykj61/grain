# tools/buhr_mcp_host_witness.rish — BUHR Journey 3, Rung 5.
#
# The JSON host bridge, proven on metal: a JSON MCP host's whole conversation served
# over the owned Bron shapes end to end. `serve` reads a JSON-RPC request's method and
# routes it -- a `tools/list` request answers with the server's whole catalog (rung
# four), a `tools/call` request crosses into a Bron Call (rung two), dispatches to the
# real Grain tool (rung one), and crosses the Bron result back to a JSON-RPC response.
# A params-first request still routes by method; a call to an unknown tool answers a
# JSON-RPC error; an unrecognized method answers method_not_found -- never a fabricated
# result. Rungs one through four join into one honest conversation.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_mcp_host_witness.rish

say "buhr-j3r5: Language EN — a JSON MCP host's whole conversation served over the owned Bron shapes."
say "buhr-j3r5: Lens TAME — bounded, composed over public APIs only, unknown tools and methods refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-host"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_host.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j3r5: mcp_host build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j3r5: mcp_host selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j3r5: selftest did not speak GREEN"
assert selftest.out contains "a JSON tools/list request answers with the whole catalog" else "buhr-j3r5: tools/list serve missing"
assert selftest.out contains "dispatches to the real tool and answers 5" else "buhr-j3r5: tools/call serve missing"
assert selftest.out contains "a params-first request still routes by method" else "buhr-j3r5: field-order routing missing"
assert selftest.out contains "answers a JSON-RPC error, never a fake result" else "buhr-j3r5: unknown-tool error missing"
assert selftest.out contains "answers method_not_found, never a guess" else "buhr-j3r5: unknown-method error missing"

# The bridge is additive: rung four (the tools/list envelope) stays its own GREEN binary,
# and it in turn re-runs rung three.
let rung4 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_mcp_list_witness.rish 2>&1"]
assert rung4.ok else "buhr-j3r5: rung four witness regressed"
assert rung4.out contains "GREEN: BUHR-J3r4" else "buhr-j3r5: rung four green line missing"

say "GREEN: BUHR-J3r5 — the JSON host bridge serves list + call over the owned shapes; BUHR Journey 3 whole."
