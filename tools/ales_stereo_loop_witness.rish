# tools/ales_stereo_loop_witness.rish — the stereo loop: one marked region cycled through two channels (ALES16).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES16.
# Design read: active-designing/20260814-fill-ales16-lotus-stereo-loop.md
# Stands on: lotus/loop.rye (ALES14) — the Loop region and make/mark_ms/enter reused whole; lotus/stereo_transport.rye (ALES15)
# — the stereo forward read a loop OFF delegates to whole, and the BadBlock it shares; lotus/pan.rye (ALES10) — the StereoClip
# whose two channels share one length; lotus/clock.rye (ALES5) — mark_ms sets the region in real time.
#
# lotus/stereo_loop.rye carries ALES14's transport loop to two channels: one marked region [start, end) and one wrapping head
# cycle BOTH channels in lockstep, because a stereo master's two channels share one length. A loop OFF is ALES15's stereo
# forward read exactly; a loop ON cycles the region forever, both channels wrapping on the same sample every cycle so left and
# right never drift. The selftest proves: a loop off matches the stereo forward read; a region [1,4) cycles both channels
# exactly; the head stays within the region at any block size; a whole-master loop replays both channels continuously; a
# single-sample region repeats per channel; mismatched out buffers refuse BadBlock; mark_ms places the region in real time; a
# rendered StereoClip loops back its two channels exactly; the loop reads only, mutating neither channel. Purely local — no
# network, no keys, no funds, no real device, no real speaker.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_stereo_loop_witness.rish

say "ales-stereo-loop: Language EN — ALES16 carries the practice loop to stereo: one marked region cycled through two channels, round and round."
say "ales-stereo-loop: Style Radiant — the law is stated positively: one region and one head cycle BOTH channels in lockstep because a stereo master's two channels share one length, so left and right never drift out of alignment across the seam."
say "ales-stereo-loop: Lens TAME — a loop OFF delegates to ALES15's stereo read whole (the stereo loop generalizes the stereo transport); no new arithmetic; region reused from ALES14's validated make; mismatched out buffers refuse BadBlock by name; read-only, mutating neither channel; siloed to lotus/, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_loop"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_loop.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-loop: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_loop.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-loop: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-loop: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-loop' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-loop: selftest did not print the GREEN ales-stereo-loop line"

say "ales-stereo-loop: GREEN — the stereo loop cycles a marked region through both channels in lockstep, the head kept within it, a loop off reading identically to ALES15's stereo transport. The next Lotus rung can meter a stereo master during playback, name a scrub window, or a punch region tying playback back to capture."
