# cellar_first_ring.rish — Cellar first ring: export, openssl golden, restore, tamper fails. · 20260801
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cellar_first_ring.rish

say "cellar first lap: export → verify (openssl golden) → restore → tamper must fail…"

let result = run ["sh" "tools/fixtures/cellar_ring1_witness.sh"]
say result.out

assert result.ok else "cellar first lap witness failed"
say "GREEN: cellar first lap witness passed."
