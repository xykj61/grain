# tools/drey_sync_witness.rish — the desk pull loop: fetch the whole of what a far hand holds in one bounded op (DREY12).
#
# Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY12.
# Design read: active-designing/date/20260814/20260814-071500_drey12-desk-sync-pull-loop-exploration.md
# Stands on: mikrophone/manifest.rye (DREY8), mikrophone/serve.rye (DREY9), mikrophone/catalog.rye (DREY7).
#
# mikrophone/sync.rye lifts DREY9's inline convergence into one named, reusable, bounded operation: pull reads a remote
# desk's manifest verify-before-trust, then for each advertised address the local desk lacks, serves it and deposits it,
# ending with the local desk holding every address the remote advertised. The selftest proves: a fresh desk converges
# whole, a partial desk pulls only its lack, a second pull is idempotent, a tampered advertisement refuses DigestMismatch
# before any frame crosses, and a desk at its entry bound refuses CatalogFull by name.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/drey_sync_witness.rish

say "drey-sync: Language EN — DREY12 lifts the local content-addressed sync into one bounded operation; pull fetches every advertised recording a desk lacks, asking only for its lack."
say "drey-sync: Style Radiant — the desk learns to fetch the whole of what a far hand holds, asking only for what it lacks and proving every byte before it lands, so two hands meet on the same whole."
say "drey-sync: Lens TAME — pull verifies the manifest before reading a record, serves only the wanted through the one proven framing path, asserts convergence (holds every advertised address) and served == wanted; a tampered advertisement refuses DigestMismatch and a full desk refuses CatalogFull; pulling over a real transport stays the Comlink-served gate; no disk, no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "mikrophone/bin/sync"

let build = run ["sh" "-c" "mkdir -p mikrophone/bin && env RYE_ZIG=${zig} rye/bin/rye build mikrophone/sync.rye -femit-bin=${bin}"]
assert build.ok else "drey-sync: build failed — ${build.err}"

let outfile = "mikrophone/bin/sync.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "drey-sync: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "drey-sync: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN drey-sync' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "drey-sync: selftest did not print the GREEN drey-sync line"

say "drey-sync: GREEN — the Mikrophone desk pulls the whole of what a far hand holds in one bounded operation. DREY12 makes the git pull a reusable primitive; pulling over a real transport waits for the Comlink-served gate."
