# tools/ales_auto_pan_witness.rish — auto-pan: the same triangle LFO swept across the stereo field (ALES76).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES76.
# Design read: active-designing/20260814-202856_fill-ales76-lotus-auto-pan-lfo-stereo-field.md
# Stands on: lotus/pan.rye (ALES10 — the linear pan this sweeps in time and the StereoClip it renders into); lotus/chorus.rye (ALES71 — the
# triangle-LFO driver `triangle_delay_at`, now the pan position); lotus/glide.rye (ALES70 — `glide_scale`, 256 = hard right); lotus/timeline.rye
# (ALES2 — the Clip, sample_min/max, the one true saturate).
#
# lotus/auto_pan.rye points ALES71's triangle LFO at a track's PAN POSITION — the family's third and last target after delay (ALES71–73) and
# amplitude (ALES74–75). AUTO-PAN IS ALES10's LINEAR PAN SWEPT ACROSS TIME, and it strengthens ALES10's sum invariant to hold EXACTLY at every
# sample for every signal by computing the far channel as the RESIDUAL of the near: right[i] = saturate(x[i]·pos(i)/glide_scale),
# left[i] = saturate(x[i] − right[i]), so left + right == src byte-for-byte. The selftest proves the crux under a full swing including
# sample_min; a hand-computed sweep (128 → 256 → 128 → 0) matches exactly; a depth-0 auto-pan is a static pan (center splits equally, hard
# left/right route wholly to one channel); the source is read-only; each channel is an attenuation of an in-range sample, so the voice never
# exceeds the dry rail (saturate a no-op — auto-pan is the tremolo's non-negative kin, no sign flip, no two's-complement corner); a period not a
# positive multiple of four refuses BadPeriod, a negative depth or a swing past hard-left BadDepth, a swing past hard-right BadPan. Purely local
# — no delay line, no snapshot, no lookahead, no network, no keys, no funds, no real device, no real speaker, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_auto_pan_witness.rish

say "ales-auto-pan: Language EN — the modulation family began on a DELAY (chorus, vibrato, flanger) and turned onto AMPLITUDE (tremolo, ring modulator); both the tremolo and the ring modulator closed on the same named next rung: AUTO-PAN, the same LFO on the stereo field. Point ALES71's triangle at a track's PAN POSITION instead of its delay or its gain, and a steady note swings left and right across the two speakers — the family's rung on POSITION, its third and last target."
say "ales-auto-pan: Style Radiant — the law is stated positively as a recognition: AUTO-PAN IS ALES10's LINEAR PAN SWEPT ACROSS TIME, position through the stereo field and position through a triangle period one parameter. It STRENGTHENS ALES10's sum invariant to hold exactly at every sample for every signal by computing the far channel as the RESIDUAL of the near — left[i] = saturate(x[i] − right[i]) — so left + right == src BYTE-FOR-BYTE, never x − 1. No new LFO, no new sum; only the pan position moves."
say "ales-auto-pan: Lens TAME — one mono clip of i16 PCM rendered to a two-channel StereoClip, the scaled non-negative position centre/depth, and a u32 period; the position stays an attenuation weight (0 ≤ pos ≤ glide_scale), so the triangle and the two divisions run in i64 and each write saturates once — a proven no-op, since every channel is an attenuation of an in-range sample (auto-pan is the tremolo's non-negative kin, not the ring modulator's bipolar one); a period not a positive multiple of four (or past max_clip) refuses BadPeriod, a negative depth or a swing floor past hard-left BadDepth, a swing top past hard-right BadPan, all before any write, src and out untouched on refusal; there is NO BadGain, NO BadDelay, NO BadRange on a span; the source is READ-ONLY; siloed to lotus/, the position in scaled units and the period in samples, no delay line, no snapshot, no lookahead, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/auto_pan"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/auto_pan.rye -femit-bin=${bin}"]
assert build.ok else "ales-auto-pan: build failed — ${build.err}"

let outfile = "lotus/bin/auto_pan.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-auto-pan: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-auto-pan: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-auto-pan' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-auto-pan: selftest did not print the GREEN ales-auto-pan line"
