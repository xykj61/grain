# tools/hunk_sprite_store_witness.rish — the marketplace sheet is a content-addressed artifact (HUNK6).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · Open Image journey · rung HUNK6.
# Design read: active-designing/20260813-201500_hunk-sprite-marketplace-index-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's one-sprite-sheet render trick (concept only, siloed).
#
# HUNK4 made each product a bounded window into one decoded sheet; HUNK5 painted a window as a seen page; both
# trust the sheet in hand. This rung gives the sheet an identity: pond/apps/sprite_store.rye store_sheet beads
# the sprite content-addressed (HUNK1's image_artifact.store_image) and open_sheet fetches it back, proving
# every bead against its digest and the whole against its recorded address BEFORE the codec reads a pixel. So a
# tampered sheet refuses DigestMismatch and an unknown market refuses UnknownArtifact, each before a SpriteIndex
# is built or a product rendered — a marketplace can only be served from the exact bytes its name pins. The
# selftest stores a two-tone sheet, opens a market over the verified sheet and renders two products from their
# own windows, then flips one stored byte and proves the whole market refuses before any product renders. Pure
# composition over public APIs; no network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_sprite_store_witness.rish

say "hunk-sprite-store: Language EN — HUNK6 gives the marketplace sheet a content address: store_sheet beads it, open_sheet fetches it verified bead by bead before the codec reads a pixel."
say "hunk-sprite-store: Style Radiant — a market opens only over a verified sheet; a tampered sheet refuses before any SpriteIndex is built, so no product is ever served from bytes its name does not pin."
say "hunk-sprite-store: Lens TAME — pure composition over HUNK1's verified fetch and HUNK4's index; the digest check lives before decode; named refusals; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/sprite_store"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/sprite_store.rye -femit-bin=${bin}"]
assert build.ok else "hunk-sprite-store: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-sprite-store: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-sprite-store: ${out}"

assert out contains "GREEN sprite-store" else "hunk-sprite-store: selftest did not print the GREEN store line"

assert out contains "opens over the verified sheet" else "hunk-sprite-store: the selftest did not prove a market opens over the verified sheet"

assert out contains "refuses DigestMismatch" else "hunk-sprite-store: the selftest did not prove a tampered sheet refuses before a product renders"

# HUNK1 stays GREEN — the store reuses image_artifact; the verified fetch underneath must still hold.
let artifact = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/image_artifact.rye -femit-bin=pond/apps/bin/image_artifact && pond/apps/bin/image_artifact selftest 2>&1"]
assert artifact.ok else "hunk-sprite-store: HUNK1 image_artifact re-run failed — ${artifact.out}"
assert artifact.out contains "GREEN image-artifact" else "hunk-sprite-store: HUNK1 image_artifact selftest did not stay GREEN"

say "hunk-sprite-store: GREEN — the marketplace sheet is content-addressed and a tampered sheet refuses before any product renders; HUNK1 verified fetch underneath stays GREEN. HUNK6 lands."
