# scribe_dashboard_witness.rish — Scribe's reading room over the Kyri reader.
#
# Proves the dashboard reads a drawer of .kyri documents, dispatches each by its format
# onto four shelves (Logs, Batons, Inventory, Unread), keeps the Unread fall-through
# honest, and shows only each document's own zero-copy fields. Stands on reader.rye's
# format dispatch; adds no source bound of its own.
#
# Build first (the vendored toolchain):
#   mkdir -p scribe/bin
#   RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build scribe/dashboard.rye -femit-bin=scribe/bin/dashboard
#   rishi/bin/rishi run tools/scribe_dashboard_witness.rish

# The module's own selftest — three shelves fill, Unread is honest, the lens is exact.
let st = run ["scribe/bin/dashboard" "selftest"]
assert st.ok else "scribe dashboard selftest must exit 0"
assert (st.err contains "GREEN") else "selftest must report GREEN"
assert (st.err contains "four shelves") else "the dashboard must lay documents on four shelves"
assert (st.err contains "honest Unread") else "an unrecognized format must land on Unread, not vanish"

# The rendered index groups by shelf and shows each document's own stamp + title.
let em = run ["scribe/bin/dashboard" "emit"]
assert em.ok else "scribe dashboard emit must exit 0"
assert (em.out contains "format dashboard-v1") else "emit must print the dashboard-v1 format tag"
assert (em.out contains "shelf Logs 1") else "the sample drawer's log must land on Logs"
assert (em.out contains "shelf Batons 1") else "the sample drawer's baton must land on Batons"

say "GREEN: scribe dashboard witness — read a drawer, dispatch by format, lay out the lens."
