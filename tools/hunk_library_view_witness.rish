# tools/hunk_library_view_witness.rish — the Photos library painted as one wall of thumbnails, on metal (HUNK69).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK69.
# Design read: active-designing/20260813-222956_hunk-filter-picker-exploration.md ("The road on from here").
# Teacher, thanked clean-room: the grid wall of iCloud Photos / Google Photos — thumbnails tiled left to right,
# wrapping down the screen (concept only, siloed).
#
# HUNK68 built the library model — an ordered set of verified image tiles. This rung lays that set onto one
# surface: paint_wall composites every tile's thumbnail into a single Skate grid, wall_cols tiles across, wrapping
# down, a one-cell gap between them. Each tile lands at a fixed origin, so a later rung can map a pixel tap back to
# the tile under the finger. The composite is a pure cell-and-palette blit — no image is re-fetched or re-decoded;
# the library already proved every picture. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_library_view_witness.rish

say "hunk-library-view: Language EN — HUNK69 paints the Photos library (HUNK68) as one wall; paint_wall composites every tile's Skate thumbnail into a single grid, wall_cols tiles across, wrapping down with a one-cell gap."
say "hunk-library-view: Style Radiant — the ordered set of verified tiles becomes the wall a keeper sees; each tile lands at a fixed origin, so a finger can later find the picture under it."
say "hunk-library-view: Lens TAME — a pure cell-and-palette blit over the already-verified thumbnails; a ragged set refuses RaggedTiles, an empty library EmptyWall, an over-ceiling wall WallTooLarge; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/library_view"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/library_view.rye -femit-bin=${bin}"]
assert build.ok else "hunk-library-view: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-library-view: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe or brace in the GREEN line can never break a check (the loom for REDS #76).
let out = trim selftest.out
say "hunk-library-view: ${out}"

assert out contains "GREEN library-view" else "hunk-library-view: selftest did not print the GREEN library-view line"
assert out contains "five verified images paint one wall three tiles across" else "hunk-library-view: the five-image wall did not tile three across"
assert out contains "every tile landing cell-for-cell at its computed origin" else "hunk-library-view: a tile did not land faithfully at its origin"
assert out contains "the wrap is real (tile 3 sits directly under tile 0 on the second row)" else "hunk-library-view: the wall did not wrap to a second tile-row"
assert out contains "a one-image library paints a single 3x3 tile with no gap" else "hunk-library-view: a single-image wall was not one gapless tile"
assert out contains "an empty library refused EmptyWall" else "hunk-library-view: the empty-library refusal did not fire"

say "hunk-library-view: GREEN — the Photos library paints as one wall: five verified images tile three across and wrap to a second row, every tile landing cell-for-cell at its computed origin; a one-image library is a single gapless tile; an empty library refuses EmptyWall; no network, no key, no funds."
