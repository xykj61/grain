# tools/buhr_tablecloth_witness.rish — BUHR Journey 7, Rung 1: the named artifact store.
#
# Tablecloth is the equinox's last unbuilt module — the Lexicon's "Brix-facing
# application database and artifact store". It invents no storage: it is the naming
# layer over mantra/beading.rye's content-addressed BeadStore. This rung proves the
# crux — a human name binds to a content address, and fetch-by-name returns exactly the
# bytes whose digest that name pins. The same bytes are stored once and named many times
# (the dedup dividend), a tampered bead or an unknown name refuses, and the Brix-facing
# `format tablecloth-v1` manifest round-trips name, address, and length field for field.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_tablecloth_witness.rish

say "buhr7: Language EN — a name pins a content address over the content-addressed BeadStore."
say "buhr7: Lens TAME — no new storage; reassembly proves every bead by digest; tamper and unknown name refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/tablecloth"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth.rye -femit-bin=${bin}"]
assert build.ok else "buhr7: tablecloth build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr7: tablecloth selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr7: selftest did not speak GREEN"
assert selftest.out contains "one content stored once, named twice" else "buhr7: two-names-one-content missing"
assert selftest.out contains "dedup dividend - notes-copy deposited 0 beads" else "buhr7: dedup dividend missing"
assert selftest.out contains "fetch by name returned 77/77/79 bytes, each equal to what was stored" else "buhr7: fetch round-trip missing"
assert selftest.out contains "format tablecloth-v1 manifest round-tripped 3 artifacts" else "buhr7: manifest round-trip missing"
assert selftest.out contains "tampered bead, unknown name, taken name refused whole GREEN" else "buhr7: tamper/unknown/taken refusals missing"
assert selftest.out contains "empty name, overlong name, oversized content refused whole GREEN" else "buhr7: name/size refusals missing"
assert selftest.out contains "bad manifest header refused GREEN" else "buhr7: bad-manifest refusal missing"

# The content-addressed store Tablecloth names over stays its own green binary — the
# naming layer composes over beading's public deposit/reassemble/verify only.
let beading_bin = "mantra/bin/beading"
let beading_build = run ["sh" "-c" "mkdir -p mantra/bin && env RYE_ZIG=${zig} rye/bin/rye build mantra/beading.rye -femit-bin=${beading_bin}"]
assert beading_build.ok else "buhr7: beading re-build failed"
let beading_selftest = run ["sh" "-c" "${beading_bin} selftest 2>&1"]
assert beading_selftest.ok else "buhr7: beading selftest exited non-zero"
assert beading_selftest.out contains "GREEN" else "buhr7: beading did not speak GREEN"

say "buhr7: GREEN — Tablecloth binds a name to a content address; fetch returns the true bytes, tamper and unknown name refuse."
