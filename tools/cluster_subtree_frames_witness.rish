# tools/cluster_subtree_frames_witness.rish -- what the branches of a cluster skeleton HOLD, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/cluster_minimum_spanning_tree.rye grows the skeleton and names its bridge edges;
# image/cluster_mst_subtrees.rye reads the two component SIZES when a bridge is cut; image/cluster_facts.rye reads one whole cluster's union frame
# and substance. This rung is the geometric payoff of the subtree read: subtree_members names the exact cluster ids on each side of a cut,
# subtree_frame the union group-handle box that side spans, subtree_area its total foreground substance, frames_overlap whether the two limbs'
# frames intersect in the plane. Exact integers, NO float, NO tolerance.
#
# The crux this witness proves on metal: the two limbs partition the clusters cleanly, yet their frames need not. Over a STAR (hub A, arm C, arm B,
# MST edges A-C and A-B) cutting A-C leaves near {A,B} and far {C}, disjoint members, yet the near frame (1,1)-(8,8) wholly contains C so
# frames_overlap reads TRUE; cutting A-B leaves near {A,C} frame (1,1)-(8,5) and far {B} at (7,7)-(8,8), the frames DISJOINT so frames_overlap
# reads FALSE. The member partition is invariant, the frame overlap is not; a non-bridge pair refuses NotABridge. Determinism. No network, no key,
# no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cluster_subtree_frames_witness.rish

say "cluster_subtree_frames: Language EN -- Season G what the branches of a cluster skeleton hold; subtree_members names the cluster ids on each side of a cut, subtree_frame the union group-handle box, subtree_area the total foreground substance, frames_overlap whether the two limbs' frames intersect; NO float, NO tolerance."
say "cluster_subtree_frames: Style Radiant -- compose not braid: this rung owns only the limb reads; cluster_minimum_spanning_tree owns build_mst, the edges, and is_bridge, cluster_facts owns cluster_bbox and cluster_area read here over each side's members. A reading over a reading over a reading over a reading over a reading over a reading over a reading over a reading."
say "cluster_subtree_frames: Lens TAME -- the cluster count can never exceed the object ceiling, so the flood over a severed tree visits each cluster once and the member lists hold one slot per cluster; a non-bridge pair refuses NotABridge, a zero or past-the-count id BadClusterId, a self pair SameCluster; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/cluster_subtree_frames"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/cluster_subtree_frames.rye -femit-bin=${bin}"]
assert build.ok else "cluster_subtree_frames: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "cluster_subtree_frames: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "cluster_subtree_frames: ${out}"

assert selftest.out contains "GREEN image-cluster-subtree-frames" else "cluster_subtree_frames: selftest did not print the GREEN line"
assert selftest.out contains "THE MEMBER SETS ALWAYS PARTITION, THE FRAMES SOMETIMES OVERLAP" else "cluster_subtree_frames: the partition-vs-overlap case did not print"
assert selftest.out contains "OVERLAP in the (5,5)-(6,6) corner where L4 sits" else "cluster_subtree_frames: the over-claim fact did not print"
assert selftest.out contains "A CUT CAN ALSO SPLIT CLEANLY IN SPACE" else "cluster_subtree_frames: the clean-split case did not print"
assert selftest.out contains "the member partition invariant while the frame overlap is not" else "cluster_subtree_frames: the invariant-partition fact did not print"

say "cluster_subtree_frames: GREEN on metal -- the two halves a surface draws when it cuts a seam, each with its own handle box and its own substance, the member partition clean while the frames may over-claim, exact integers with NO float and NO tolerance."
