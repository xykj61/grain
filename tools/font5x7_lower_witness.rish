# tools/font5x7_lower_witness.rish -- the open lowercase corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - the third real content for the open glyph atlas image/glyph.rye (gfa1),
# set beside the numerals (tools/font5x7_witness.rish) and the uppercase (tools/font5x7_alpha_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn font corpus: the twenty-six lowercase letters 'a'-'z',
# each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_lower.rye -- ascenders and
# descenders held inside the shared body -- built into a gfa1 atlas and proven on metal. A full round-trip
# recovers every codepoint, advance, and coverage byte byte-for-byte; all twenty-six letters look up present and
# carry the shared advance while an uppercase letter misses; no two letters share coverage (a real font's glyphs
# differ); and each letter reads within an honest legibility band (neither blank nor solid). Compression is
# reported as a fact, never asserted -- real letters are busy, and the round-trip is the proof. No network, no
# key, no funds -- the letter corpus a surface reads the day it wants a word, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_lower_witness.rish

say "font5x7-lower: Language EN -- Season G's font content rung; the twenty-six lowercase letters drawn in the open as ASCII line art, built into the gfa1 atlas, verified bytes that decode within named bounds rather than painting garbage."
say "font5x7-lower: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-lower: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - letter_count - the atlas ceilings it rests on); each function states its invariants positively; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_lower"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_lower.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-lower: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-lower: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-lower: ${out}"

assert selftest.out contains "GREEN image-font5x7-lower" else "font5x7-lower: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-lower: round-trip was not byte-identical"

say "font5x7-lower: GREEN -- the open lowercase corpus whole; twenty-six letters round-trip byte-identical, all present, distinct, and legible."
