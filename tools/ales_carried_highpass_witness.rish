# tools/ales_carried_highpass_witness.rish — a carried-state high-pass: the complement gains a memory too (ALES45).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES45.
# Design read: active-designing/date/20260814/20260814-164244_fill-ales45-lotus-carried-highpass.md
# Stands on: lotus/tone.rye (ALES40, accreted with high_pass_carry) · lotus/tone_carry.rye (ALES43 Lowpass, accreted with
# Highpass) · lotus/timeline.rye (ALES2 — the Clip).
#
# ALES45 gives ALES40's high-pass a carried state, symmetric to ALES43's low-pass, so the whole split (and the shelf and stack
# built on it) can span a re-berthed region and be swept without a click. The tone_carry selftest proves, beside the Lowpass:
# a fresh Highpass (state = 0) equals ALES40's from-silence high_pass byte-for-byte; a span high-passed in two pieces with a
# carried state equals the whole high-passed once (the complement crux); a Lowpass and a Highpass at one coefficient sum back to
# the input where the difference fits (low + high = x); reset re-opens the high-pass transient; an illegal coefficient refuses
# BadCoeff leaving the state untouched, an out-of-range span BadRange leaving the clip untouched. Purely local — no network, no
# keys, no funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_carried_highpass_witness.rish

say "ales-carried-highpass: Language EN — ALES45 gives ALES40's high-pass a carried state, the complement of ALES43's low-pass, so both bands remember and a whole split spans a re-berthed region or sweeps rather than clicking at each seam."
say "ales-carried-highpass: Style Radiant — the law is stated positively: a fresh high-pass equals the from-silence high_pass byte-for-byte, a span high-passed in two pieces with a carried state equals the whole once, and the carried low and high bands sum back to the input (low + high = x)."
say "ales-carried-highpass: Lens TAME — bounded Clip, u32 span, i16 samples, full-precision i64 state carried by the caller; high_pass becomes the state = 0 case of one high_pass_carry implementation, so the carried and from-silence forms cannot drift; an illegal coefficient refuses BadCoeff, an out-of-range span BadRange, each before a write; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/tone_carry"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/tone_carry.rye -femit-bin=${bin}"]
assert build.ok else "ales-carried-highpass: build failed — ${build.err}"

let outfile = "lotus/bin/tone_carry.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-carried-highpass: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-carried-highpass: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-tone-carry' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-carried-highpass: selftest did not print the GREEN ales-tone-carry line"

# The ALES45 high-pass proof must be present in the combined GREEN line — assert its own clause, not merely the low-pass line.
let hp = run ["sh" "-c" "grep -q 'carried-state HIGH-pass' ${outfile} && echo yes"]
assert (trim hp.out) == "yes" else "ales-carried-highpass: the GREEN line did not carry the ALES45 high-pass proof clause"

# The high_pass_carry refactor must leave ALES40's tone selftest and ALES44's sweep GREEN — prove it by their green, not by claim.
let tone = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/tone.rye -femit-bin=lotus/bin/tone && lotus/bin/tone selftest 2>&1 | grep -q 'GREEN ales-tone' && echo yes"]
assert (trim tone.out) == "yes" else "ales-carried-highpass: the ALES40 tone witness regressed after the high_pass_carry refactor"

let sweep = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/sweep.rye -femit-bin=lotus/bin/sweep && lotus/bin/sweep selftest 2>&1 | grep -q 'GREEN ales-sweep' && echo yes"]
assert (trim sweep.out) == "yes" else "ales-carried-highpass: the ALES44 sweep witness regressed after the high_pass_carry refactor"

say "ales-carried-highpass: GREEN — a carried-state high-pass carries its state the same way the low-pass does, so both bands remember and a whole split spans a re-berthed region without a click; a fresh Highpass equals ALES40's from-silence high_pass byte-for-byte, a span high-passed in two pieces equals the whole once, and the carried low and high bands sum back to the input; the shipped ALES40 tone and ALES44 sweep selftests stay GREEN. The next Lotus rung can carry the shelf/stack, sweep the high-pass, or name a crossover in hertz through a real time base."
