# tools/mycelium_statement_knot_witness.rish — an account statement reads continuous across a Knot (r3).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the account-statement voice · rung r3 — across a Knot.
# r1 read one account's line out of a whole resolved ledger; r2 let it travel. Yet a ledger a family runs
# for years does not carry its whole past unbroken: the Knot ties off a committed prefix into a sealed
# supply so a bounded Dag runs forever, and the Lapse continues its deadline clock across that seal by
# carrying the epoch base. This rung reads one account's statement over a Knot-continued ledger.
#
# The crux this witness proves is A STATEMENT DOES NOT DRIFT AT THE CHECKPOINT: the statement read over the
# whole Cord and the statement read over the Knot-plus-suffix are the identical line — same position
# (balance, reserved, received), same pledge lines, same states — and it still reconciles. A pledge opened
# before the cut lapses in the suffix, and Alice's line reads the same lapsed statement on both paths. The
# honest seam this surfaces is that RECEIVED accumulates across the base, not restarts at it: Bob, absent at
# the seal and credited in the suffix (a far-deadline pledge honored across the cut), reads his whole 100
# inflow, not a restart — the continuity the epoch base keeps and the Statement reads. A Knot corrupted
# after sealing refuses whole, so no statement is ever read from a tampered checkpoint. Composes statement +
# lapse_knot + lapse + cord + fold public API only; demo keeper seeds — no key, no funds, no network, no custody.
#
# Scope: active-designing/20260813-091851_mycelium-statement-account-voice-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_statement_knot_witness.rish

say "mycelium-statement-knot: Language EN — a holder reads their own line after a checkpoint and finds exactly what the unpruned history would have shown, the hour and the inflow both unbroken."
say "mycelium-statement-knot: Style Radiant — the Knot prunes the past and the Lapse carries the clock across it; the Statement reads the continuity they keep, adding no seam of its own."
say "mycelium-statement-knot: Lens TAME — the reading composes statement + lapse_knot + lapse + cord + fold public API; a statement over the whole Cord equals a statement over the Knot-plus-suffix; received accumulates across the base; a corrupt checkpoint refuses before any line is read; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/statement_knot"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/statement_knot.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-statement-knot: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-statement-knot: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-statement-knot: selftest did not speak GREEN"
assert selftest.out contains "reads the same lapsed statement whether over the whole Cord or a sealed Knot" else "mycelium-statement-knot: no-drift-across-cut claim missing"
assert selftest.out contains "received accumulates across the cut" else "mycelium-statement-knot: received-accumulation claim missing"
assert selftest.out contains "no statement is ever read from a tampered checkpoint" else "mycelium-statement-knot: corrupt-refusal claim missing"
assert selftest.out contains "one account's line reads continuous across a Knot" else "mycelium-statement-knot: GREEN summary missing"

# The Statement r1 whose line this rung reads across a cut, and the Lapse-Knot whose checkpoint it continues,
# both stand at the door — their own selftests prove the machinery the reading rests on.
let statement = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/statement.rye -femit-bin=mycelium/bin/statement && mycelium/bin/statement 2>&1"]
assert statement.ok else "mycelium-statement-knot: the Statement r1 this rung reads across a cut is not GREEN"
assert statement.out contains "GREEN" else "mycelium-statement-knot: the Statement r1 did not speak its GREEN"

let lapse_knot = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/lapse_knot.rye -femit-bin=mycelium/bin/lapse_knot && mycelium/bin/lapse_knot 2>&1"]
assert lapse_knot.ok else "mycelium-statement-knot: the Lapse-Knot whose checkpoint the Statement continues is not GREEN"
assert lapse_knot.out contains "GREEN" else "mycelium-statement-knot: the Lapse-Knot did not speak its GREEN"

say "mycelium-statement-knot: GREEN — one account's line reads continuous across a Knot: the whole Cord and the sealed Knot-plus-suffix name the identical statement (position, lines, reconciliation unbroken), received accumulated across the epoch base, a corrupt checkpoint refused before any line is read; the Statement and the Lapse-Knot stand at the door. The Statement crosses the checkpoint whole."
