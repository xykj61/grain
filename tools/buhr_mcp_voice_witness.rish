# tools/buhr_mcp_voice_witness.rish — BUHR Journey 9, Rung 1: the intelligence, served as an MCP tool.
#
# Journey 3 spoke MCP in Bron (the owned format mcp-call-v1 / mcp-result-v1 shape); Journey 8
# gathered five voices under one Q-vane host. This rung joins them: an MCP call naming the
# intelligence tool (`ask`) crosses into a Lantern request, dispatches through the gathered
# host (routing by prompt to whichever voice knows it), and the response crosses back into a
# format mcp-result-v1 envelope a caller reads with Journey 3's own parse_result. Every
# refusal the host owns — a disallowed model, a prompt no voice knows, an artifact name the
# store lacks, a missing arg, an unknown tool — crosses back as a named MCP error, never a
# fabricated result. It reads no network (the real fetch and Comlink-served transport stay
# the held gates). mcp_bron (J3r1) and quin_host_artifact (J8r3) stay their own green binaries.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_mcp_voice_witness.rish

say "buhr9r1: Language EN — the gathered intelligence answers over the owned MCP shape; a call crosses to a real voice and back."
say "buhr9r1: Lens TAME — every voice refusal crosses back as a named MCP error; the bridge never invents a result."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-voice"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_voice.rye -femit-bin=${bin}"]
assert build.ok else "buhr9r1: mcp_voice build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr9r1: mcp_voice selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr9r1: selftest did not speak GREEN"
assert selftest.out contains "ask -> Lattice" else "buhr9r1: arithmetic voice did not answer over MCP"
assert selftest.out contains "ask -> artifact voice" else "buhr9r1: artifact voice did not answer over MCP"
assert selftest.out contains "ask -> graph voice" else "buhr9r1: graph voice did not answer over MCP"
assert selftest.out contains "unknown tool -> named MCP error 'unknown_tool'" else "buhr9r1: unknown-tool error missing"
assert selftest.out contains "disallowed model -> named MCP error 'model_not_allowed'" else "buhr9r1: model error missing"
assert selftest.out contains "no voice knows the prompt -> named MCP error 'unknown_op'" else "buhr9r1: no-voice error missing"
assert selftest.out contains "artifact the store lacks -> named MCP error 'unknown_artifact'" else "buhr9r1: unknown-artifact error missing"
assert selftest.out contains "missing prompt arg -> named MCP error 'bad_args'" else "buhr9r1: missing-arg error missing"

# The MCP shape (J3r1) and the gathered voice host (J8r3) — the two halves this rung joins —
# stay their own green binaries; this rung composes over their public API only.
let shape_bin = "pond/bin/mcp-bron"
let shape_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_bron.rye -femit-bin=${shape_bin}"]
assert shape_build.ok else "buhr9r1: mcp_bron (J3r1) re-build failed"
let shape_selftest = run ["sh" "-c" "${shape_bin} selftest 2>&1"]
assert shape_selftest.ok else "buhr9r1: mcp_bron (J3r1) selftest exited non-zero"
assert shape_selftest.out contains "GREEN" else "buhr9r1: mcp_bron (J3r1) did not speak GREEN"

let host_bin = "pond/bin/quin-host-artifact"
let host_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/quin_host_artifact.rye -femit-bin=${host_bin}"]
assert host_build.ok else "buhr9r1: quin_host_artifact (J8r3) re-build failed"
let host_selftest = run ["sh" "-c" "${host_bin} selftest 2>&1"]
assert host_selftest.ok else "buhr9r1: quin_host_artifact (J8r3) selftest exited non-zero"
assert host_selftest.out contains "GREEN" else "buhr9r1: quin_host_artifact (J8r3) did not speak GREEN"

say "buhr9r1: GREEN — the intelligence is reachable as an MCP tool; a call crosses to a real voice and back, and every refusal is a named MCP error."
