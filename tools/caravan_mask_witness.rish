# caravan_mask_witness.rish -- Caravan mask witness.
#
# `fence.rye` let a phase say how much of its own turn it follows, in one
# number: the count of leading siblings. That prefix is transitively closed
# by construction, which is exactly why it costs nothing to read -- and
# exactly what it cannot express. A prefix must reach its farthest
# dependency, so it swallows every hole on the way.
#
#   A PHASE NAMES THE SIBLINGS IT FOLLOWS, AND A TURN CLOSES THEM ONCE.
#
# The honest shape is a set, and the fear was that a set is a graph. It is
# -- yet a turn is small. `max_queue_len` is sixteen, so a whole turn fits
# inside one machine word and the set a phase names is one `u32`. The queue
# CLOSES THE WHOLE PLAN ONCE, at the door, in a single forward pass, and
# every admission after it is one bit test -- the same constant the prefix
# had.
#
# WHAT THE MASK BUYS, MEASURED:
#
#   * A TURN CUT INSIDE ONE DOMAIN COULD NEVER SHOW THIS, and the elder
#     rungs' laps are exactly that: two phases of one domain never stand at
#     one instant, so isolation already runs them in the order they were
#     written. Authorship earns its keep on a turn that SPANS DOMAINS -- a
#     request placed, read back, and answered -- which is the first lap on
#     which a fence and a mask can differ at all.
#   * Over the masked lap, whose cut turn has step 3 name step 2 alone and
#     skip step 1 entirely, the mask breaks the prefix it implies 1 time
#     where the fence breaks it 0 -- lawfully, because the author wrote the
#     hole down -- and keeps the mask unbroken where reading acts alone
#     breaks it 1 time.
#   * Slots unspent read 4 by act, 5 masked, 6 fenced, 6 linked: the mask
#     sits strictly between the act reading and the fence, which is the
#     whole claim in one number.
#   * The ISOLATION half needed nothing here either, for the reason
#     `phases.rye` gave: `commute.admissible` already refuses to stand a
#     domain beside itself, and a mask loosens an order rather than opening
#     an instant.
#
# A FULL MASK IS THE FENCE, AND THE LINK, EXACTLY -- proven pair by pair
# over the whole lap under all three readings, so this rung generalizes its
# elders rather than rivalling them. And a prefix SURVIVES THE CLOSING
# exactly, because filling a mask in only ever adds bits below its highest.
#
# THE RUN NEVER NEEDS THE CLOSING, and the lap proves why: every bit the
# closing adds is reachable through a sibling the phase named directly, so a
# phase can only be passed while a direct namer of its own still waits. The
# closing is what makes the PAIRWISE reading honest; the queue's own
# discipline carries transitivity by induction.
#
# Both RED paths were proven on metal before this witness claimed GREEN.
# Drop the mask from `items_contend` and the mask read straight reds at a
# phase inside its own closed mask being free to pass it. Keep the mask and
# hide it from the choosing alone, and the masked run's own `fill_table`
# invariant fires on metal at `caravan/mask.rye:578` -- so the assert that
# says a masked reading never runs a phase past the siblings it named is
# load-bearing rather than decorative.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_mask_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/mask"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/mask.rye -femit-bin=${bin}"]

assert build.ok else "caravan mask build failed"

# The reader this witness runs is built here rather than borrowed (REDS #92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# Nothing new is declared: the mask rides beside the phase, where authorship
# belongs, rather than in the document, where a ceiling belongs.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan mask selftest exited non-zero"
assert test.out contains "GREEN" else "caravan mask selftest not GREEN"
assert test.out contains "a phase names the siblings it follows, and a turn closes them once" else "the mask finding did not close"

# The mask read straight, before any supervisor spends it.
assert test.out contains "a full mask is the fence and the link exactly, and a hole is what no prefix can name" else "the mask did not answer the readings it generalizes"
assert test.out contains "the closing adds only what a named sibling already carries, so a run never walks it" else "the closing did not prove itself reachable through the direct names"

# The masked lap: the mask stands between reading acts alone and the fence.
assert test.out contains "the masked lap runs 2 phases past their turn by act, 2 masked, 1 fenced, 0 linked" else "the mask did not buy back the phases the link was holding"
assert test.out contains "the mask is broken 1 times by act and 0 masked" else "the mask did not keep the siblings its author named"
assert test.out contains "the implied prefix is broken 1 times by act, 1 masked, 0 fenced" else "the mask did not lawfully break the prefix it implies"
assert test.out contains "passes: 3 by act, 3 masked, 2 fenced, 1 linked" else "the mask did not free the passes the prefix was swallowing"
assert test.out contains "slots unspent: 4 by act, 5 masked, 6 fenced, 6 linked" else "the mask did not stand between the act reading and the fence"
assert test.out contains "7 dependents run to the same end under all four" else "the four readings did not run the same lap to the same end"

say "GREEN: Caravan mask witness passed."
