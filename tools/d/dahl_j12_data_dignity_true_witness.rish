# tools/d/dahl_j12_data_dignity_true_witness.rish — Season 3 Journey 12 (Data-dignity), Rung 4 (Journey 12 closes).
#
# Rungs one through three fixed the succession rule, signed each of its two proofs, and let a signed
# succession travel as Bron — all over estates seated in code. This closing rung carries the reader onto a
# real succession record a keeper can open and count. pond/apps/data_dignity_true.rye @embedFile-binds
# surf/fixtures/estate.bron (a genuine format data-dignity-v1 record with real Ed25519 directive and
# acceptance signatures — a keeper wills two holdings to the heir and rests one; produced reproducibly by
# pond/apps/data_dignity_fixture_gen.rye, demo seeds only) through a pond/apps/corpora/ symlink, parses it
# through rung three, and reports the bequeathed count, the rested count, and the heir-held count — the
# last computed by actually running the signed succession (rebuild) and resolving each item's holder. The
# crux is the cross-check: tools/fixtures/data_dignity_truth.awk reads the marks structurally and the
# witness asserts the app's triple equals awk's — two tools, one answer (2 1 2) — so a succession's outcome
# can never drift from a record a keeper can count. And the record is genuinely dignity-honest:
# still_dignity_honest re-verifies both proofs, and rebuild leaves the heir holding the bequeathed set with
# the rested holding resting. A tampered header refuses BadFormat. Additive — composes r1, r2, r3 over
# public API (all re-run GREEN); reads no network; demo keeper and heir seeds only.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dahl_j12_data_dignity_true_witness.rish

say "dahl-j12r4: Language EN — the reading of a real succession record is true to the bytes; app and awk give one answer."
say "dahl-j12r4: Lens TAME — bequeathed, rested, and heir-held cross-check against an independent awk; the record is genuinely dignity-honest."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/data-dignity-true"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/data_dignity_true.rye -femit-bin=${bin}"]
assert build.ok else "dahl-j12r4: data_dignity_true build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dahl-j12r4: data_dignity_true selftest exited non-zero"
assert selftest.out contains "GREEN" else "dahl-j12r4: selftest did not speak GREEN"
assert selftest.out contains "matches an independent count of the same bytes" else "dahl-j12r4: reading-true crux missing"
assert selftest.out contains "the rested holding resting" else "dahl-j12r4: honest-record crux missing"
assert selftest.out contains "refused BadFormat" else "dahl-j12r4: tamper refusal missing"

# The crux — two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "dahl-j12r4: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/data_dignity_truth.awk surf/fixtures/estate.bron"]
assert awk.ok else "dahl-j12r4: awk truth read failed"
assert app.out contains "2 1 2" else "dahl-j12r4: app triple not 2 1 2"
assert awk.out contains "2 1 2" else "dahl-j12r4: awk triple not 2 1 2"
assert app.out == awk.out else "dahl-j12r4: app and awk disagree — the reading drifted from the bytes"

# r1, r2, and r3 stay their own GREEN binaries — additive.
let r1 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/data_dignity.rye -femit-bin=pond/bin/data-dignity && pond/bin/data-dignity selftest 2>&1"]
assert r1.ok else "dahl-j12r4: r1 did not stay GREEN"
assert r1.out contains "GREEN" else "dahl-j12r4: r1 GREEN missing"
let r3 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/data_dignity_bron.rye -femit-bin=pond/bin/data-dignity-bron && pond/bin/data-dignity-bron selftest 2>&1"]
assert r3.ok else "dahl-j12r4: r3 did not stay GREEN"
assert r3.out contains "GREEN" else "dahl-j12r4: r3 GREEN missing"

say "GREEN: dahl-j12r4 — data_dignity_true reads a real succession record true (app==awk, 2 1 2) and the record is dignity-honest; DAHL Journey 12 closes."
