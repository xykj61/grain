let verify = run ["rishi/bin/rishi" "run" "tools/d/drey_verify_witness.rish"]
assert verify.ok else "drey: DREY16 verify witness failed"
assert (verify.out contains "GREEN drey-verify") else "drey: DREY16 verify not GREEN"

say "GREEN drey: the whole Mikrophone firmware journey holds — DREY0 session · DREY1 wire · DREY2 recorder · DREY3 firmware · DREY4 inbox · DREY5 carry · DREY6 archive · DREY7 catalog · DREY8 manifest · DREY9 serve · DREY10 redact · DREY12 sync · DREY13 forget · DREY14 push · DREY15 reconcile · DREY16 verify, all sixteen rungs proven pure before metal in one command; no disk, no network, no key, no funds."
