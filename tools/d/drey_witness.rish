# tools/d/drey_witness.rish -- the whole Mikrophone firmware journey, every rung proven in one command.
#
# Chapter A (Hardware & Right-to-Repair) - waymark DREY - Mikrophone firmware journey - aggregate witness.
# Front door: mikrophone/README.md.
#
# The Mikrophone firmware journey grew from one crux -- a session that forgets. Each rung has its own witness, and this
# one runs every rung in rung order and asserts each GREEN, so the whole journey proves from cold in a single command --
# the reference weave the front door names.
#
# THE COUNT IS NOT WRITTEN HERE, ON PURPOSE. This header once said `eleven proven rungs` and recited all eleven by name,
# and the printed banner below once named the range `DREY0` through `DREY13`. The file ran SIXTEEN rungs by then. A count
# typed into a comment stops moving the day it is typed, while the legs below keep being added -- REDS %110 and %93 taught
# that for the ledger's own headline, %385 for the session-log shelves, and %386 books it here. So the roll call lives in
# one place only: the closing GREEN line, which names each rung it just ran. To count them, ask the file rather than
# this sentence:
#   grep -c '^let .* = run \[' tools/d/drey_witness.rish
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/drey_witness.rish

say "drey: Language EN -- the whole Mikrophone firmware journey, each rung's witness run in rung order and asserted GREEN in one command; the closing line names every rung it ran."
say "drey: Style Radiant — a device that forgets on purpose, proven whole: a capture held only while powered, kept only on a deliberate commit, redacted where a keeper strikes it, carried only when committed, and received only once proven — no byte crossing that a keeper did not need, none kept that cannot be proven."
say "drey: Lens TAME — every rung is pure Rye on the bench, bounded, invariant-asserted, refusing by name; no disk, no network, no key, no funds. Serving over a real transport stays the Comlink-served gate; real hardware stays custody gate %2."

let session = run ["rishi/bin/rishi" "run" "tools/d/drey_session_witness.rish"]
assert session.ok else "drey: DREY0 session witness failed"
assert (session.out contains "GREEN drey-session") else "drey: DREY0 session not GREEN"

let wire = run ["rishi/bin/rishi" "run" "tools/d/drey_wire_witness.rish"]
assert wire.ok else "drey: DREY1 wire witness failed"
assert (wire.out contains "GREEN drey-wire") else "drey: DREY1 wire not GREEN"

let recorder = run ["rishi/bin/rishi" "run" "tools/d/drey_recorder_witness.rish"]
assert recorder.ok else "drey: DREY2 recorder witness failed"
assert (recorder.out contains "GREEN drey-recorder") else "drey: DREY2 recorder not GREEN"

let firmware = run ["rishi/bin/rishi" "run" "tools/d/drey_firmware_witness.rish"]
assert firmware.ok else "drey: DREY3 firmware witness failed"
assert (firmware.out contains "GREEN drey-firmware") else "drey: DREY3 firmware not GREEN"

let inbox = run ["rishi/bin/rishi" "run" "tools/d/drey_inbox_witness.rish"]
assert inbox.ok else "drey: DREY4 inbox witness failed"
assert (inbox.out contains "GREEN drey-inbox") else "drey: DREY4 inbox not GREEN"

let carry = run ["rishi/bin/rishi" "run" "tools/d/drey_carry_witness.rish"]
assert carry.ok else "drey: DREY5 carry witness failed"
assert (carry.out contains "GREEN drey-carry") else "drey: DREY5 carry not GREEN"

let archive = run ["rishi/bin/rishi" "run" "tools/d/drey_archive_witness.rish"]
assert archive.ok else "drey: DREY6 archive witness failed"
assert (archive.out contains "GREEN drey-archive") else "drey: DREY6 archive not GREEN"

let catalog = run ["rishi/bin/rishi" "run" "tools/d/drey_catalog_witness.rish"]
assert catalog.ok else "drey: DREY7 catalog witness failed"
assert (catalog.out contains "GREEN drey-catalog") else "drey: DREY7 catalog not GREEN"

let manifest = run ["rishi/bin/rishi" "run" "tools/d/drey_manifest_witness.rish"]
assert manifest.ok else "drey: DREY8 manifest witness failed"
assert (manifest.out contains "GREEN drey-manifest") else "drey: DREY8 manifest not GREEN"

let serve = run ["rishi/bin/rishi" "run" "tools/d/drey_serve_witness.rish"]
assert serve.ok else "drey: DREY9 serve witness failed"
assert (serve.out contains "GREEN drey-serve") else "drey: DREY9 serve not GREEN"

let redact = run ["rishi/bin/rishi" "run" "tools/d/drey_redact_witness.rish"]
assert redact.ok else "drey: DREY10 redact witness failed"
assert (redact.out contains "GREEN drey-redact") else "drey: DREY10 redact not GREEN"

let sync = run ["rishi/bin/rishi" "run" "tools/d/drey_sync_witness.rish"]
assert sync.ok else "drey: DREY12 sync witness failed"
assert (sync.out contains "GREEN drey-sync") else "drey: DREY12 sync not GREEN"

let forget = run ["rishi/bin/rishi" "run" "tools/d/drey_forget_witness.rish"]
assert forget.ok else "drey: DREY13 forget witness failed"
assert (forget.out contains "GREEN drey-forget") else "drey: DREY13 forget not GREEN"

let push = run ["rishi/bin/rishi" "run" "tools/d/drey_push_witness.rish"]
assert push.ok else "drey: DREY14 push witness failed"
assert (push.out contains "GREEN drey-push") else "drey: DREY14 push not GREEN"

