# disk_reclaim_witness.rish -- a ship clears its own rebuildable build output, checked before
# anything is removed.
#
#   rishi/bin/rishi run tools/d/disk_reclaim_witness.rish
#
# ANSWERS REDS `20260925.130901`'s own remaining question: whether a rostered tool belongs in
# tools/ so each ship reclaims its own `*/bin/` build output with one command rather than a typed
# loop naming each directory by hand and confirming it with `git check-ignore -q`.
#
# `disk_reclaim_scan.sh` reads every `.gitignore` line ending `/bin/` plus `/tools/.build`, removes
# only what `git check-ignore -q` confirms is genuinely untracked build output, and never removes
# the load-bearing toolchain (`rye/bin`, `rishi/bin`) this tree's own tools depend on to run at
# all -- excluded by name, --apply or not.
let scan = run ["sh" "tools/fixtures/d/disk_reclaim_scan.sh"]
assert scan.ok else "disk reclaim scan did not run: ${scan.err_brief}"
assert scan.out contains "verdict=reported" else "disk reclaim scan missing its verdict: ${scan.out_brief}"

# THE CONTROL IS ASSERTED BESIDE THE READING, because a scan proven only in the passing direction
# cannot be told from one that refuses nothing. Five behaviors on a throwaway git repository:
# the toolchain exclusion holds under --apply, report mode removes nothing, apply mode removes an
# ordinary candidate, a stale .gitignore line that no longer applies is refused rather than
# guessed at, and a missing candidate is skipped without a line.
let control = run ["sh" "tools/fixtures/d/disk_reclaim_control.sh"]
assert control.ok else "disk reclaim control did not reach control_verdict=ok: ${control.out_brief}"
assert control.out contains "control_verdict=ok" else "disk reclaim control verdict missing: ${control.out_brief}"
assert control.out contains "control_fail=0" else "a planted disk-reclaim behavior went unread: ${control.out_brief}"

say "GREEN: a ship reclaims its own rebuildable build output with one command, and the toolchain it runs on stays untouched."
