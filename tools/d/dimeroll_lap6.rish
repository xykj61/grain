# dimeroll_lap6.rish -- Dimeroll lap 4 cash flow fold witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dimeroll_lap6.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "dimeroll/bin/dimeroll"

let build = run ["sh" "-c" "mkdir -p dimeroll/bin && env RYE_ZIG=${zig} rye/bin/rye build dimeroll/dimeroll.rye -femit-bin=${bin}"]
assert build.ok else "Dimeroll lap 6 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Dimeroll selftest exited non-zero"
assert selftest.out contains "GREEN" else "Dimeroll selftest not GREEN"
assert selftest.out contains "cash flow" else "Dimeroll missing cash flow welcome"
assert selftest.out contains "in=1000" else "Dimeroll missing cash inflow"
assert selftest.out contains "out=200" else "Dimeroll missing cash outflow"

say "GREEN: Dimeroll lap 6 — fold_cash_flow inflow/outflow/net."
