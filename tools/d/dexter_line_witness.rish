# tools/d/dexter_line_witness.rish -- Dexter, the bounded line editor on metal.
#
# pond/apps/dexter_line.rye gives Dexter its input half: one editable line with a cursor, the primitive
# every prompt stands on, beside scooter_view.rye's drawn output frame. This witness builds the module to
# a binary and asserts its selftest speaks GREEN over the six cruxes:
#   - Insert at the cursor -- a printable byte enters at the cursor, shifting the tail right.
#   - Delete around the cursor -- backspace and delete each remove one byte, shifting the tail left.
#   - Cursor motion bounded -- left/right/home/end walk over 0..len; a step past either edge is refused.
#   - Capacity bounded -- a full line refuses a further byte (LineFull) rather than dropping one.
#   - Only printable enters -- a control byte is refused (NonPrintable), no byte landing.
#   - Clear empties -- clear wipes the line to the start, and the same keystrokes rebuild the same bytes.
#
# Facts only, custody-first: it edits a line of text and holds nothing else -- no network, no key, no funds.
# The live raw TTY and the wire between piers are later rungs; the editable line is the floor beneath them.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dexter_line_witness.rish

say "dexter-line: Language EN -- one bounded editable line with a cursor, the input half of the terminal."
say "dexter-line: Lens TAME -- insert, delete, and cursor motion all held within 0..len, only printable ASCII, no key and no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/dexter-line"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/dexter_line.rye -femit-bin=${bin}"]
assert build.ok else "dexter-line: dexter_line build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dexter-line: dexter_line selftest exited non-zero"
assert selftest.out contains "GREEN" else "dexter-line: selftest did not speak GREEN"
assert selftest.out contains "enters at the cursor, shifting the tail right" else "dexter-line: insert crux missing"
assert selftest.out contains "remove one byte around the cursor" else "dexter-line: delete crux missing"
assert selftest.out contains "a step past either edge is refused by name" else "dexter-line: cursor-motion crux missing"
assert selftest.out contains "refuses a further byte (LineFull)" else "dexter-line: capacity crux missing"
assert selftest.out contains "only printable ASCII enters" else "dexter-line: printable crux missing"
assert selftest.out contains "the same keystrokes rebuild the same bytes" else "dexter-line: clear/determinism crux missing"

say "GREEN: dexter-line -- a bounded editable line: insert, delete, cursor motion, and clear, all held within 0..len and deterministic."
