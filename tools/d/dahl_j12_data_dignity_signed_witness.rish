# tools/d/dahl_j12_data_dignity_signed_witness.rish — Season 3 Journey 12 (Data-dignity), Rung 2.
#
# Rung one fixed the succession rule as a pure state machine — a keeper wills each holding bequeathed or
# rested, seals the directive, the heir accepts, and custody passes only on both proofs. Yet a bare state
# machine trusts whoever calls it: a steward could seal a directive in a departed keeper's name or record
# an acceptance the heir never gave. pond/apps/data_dignity_signed.rye binds each of the two proofs to a
# settled Kumara identity — the keeper's seal to the keeper's key, the heir's acceptance to the heir's key.
# The directive signs a digest of the will's own marks, so a mark tampered after the keeper sealed it falls
# the signature (BadConsent) — a steward cannot rewrite the will a departed keeper meant. A forged
# directive, a forged acceptance, an unenrolled party (UnknownKeeper), and a cross-estate signature each
# refuse. Additive — composes rung one and kumara over public API (r1 re-runs GREEN); demo keeper and heir
# seeds only, no real key, no network, no real seed (the maintainer's own succession is the maintainer's
# hand).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dahl_j12_data_dignity_signed_witness.rish

say "dahl-j12r2: Language EN — the keeper's seal and the heir's acceptance are each a settled signature; neither proof can be forged, nor a sealed will rewritten."
say "dahl-j12r2: Lens TAME — a tampered will refuses BadConsent; a forged directive/acceptance refuses; an unenrolled party refuses UnknownKeeper; a cross-estate proof refuses."

let zig = "vendor/zig-toolchain/zig"

# Rung one re-runs GREEN — signing is additive over the pure rule.
let bin1 = "pond/bin/data-dignity"
let build1 = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/data_dignity.rye -femit-bin=${bin1}"]
assert build1.ok else "dahl-j12r2: rung-one data_dignity build failed"
let self1 = run ["sh" "-c" "${bin1} selftest 2>&1"]
assert self1.ok else "dahl-j12r2: rung-one selftest exited non-zero"
assert self1.out contains "GREEN" else "dahl-j12r2: rung-one did not speak GREEN"

let bin = "pond/bin/data-dignity-signed"
let build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/data_dignity_signed.rye -femit-bin=${bin}"]
assert build.ok else "dahl-j12r2: data_dignity_signed build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dahl-j12r2: data_dignity_signed selftest exited non-zero"
assert selftest.out contains "GREEN" else "dahl-j12r2: selftest did not speak GREEN"
assert selftest.out contains "the rested holding still resting" else "dahl-j12r2: signed-succession crux missing"
assert selftest.out contains "cannot rewrite the marks a departed keeper meant" else "dahl-j12r2: tampered-will crux missing"
assert selftest.out contains "neither proof can be signed by another hand" else "dahl-j12r2: forged-proof refusal missing"
assert selftest.out contains "cannot seal a succession" else "dahl-j12r2: unknown-keeper refusal missing"
assert selftest.out contains "a proof names its estate" else "dahl-j12r2: cross-estate refusal missing"

say "GREEN: dahl-j12r2 — data_dignity_signed binds each of the two succession proofs to a settled Kumara identity; a tampered will, a forged proof, an unenrolled party, and a cross-estate signature each refuse."
