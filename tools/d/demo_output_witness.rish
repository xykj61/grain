# tools/d/demo_output_witness.rish -- a page that prints a command AND its answer is a claim,
# so the claim gets run.
#
# WHY THIS RUNG. docs-geode/demos/README.md is the shipping shelf's offer that a newcomer can
# check this tree for themselves: five commands, and beside each one what it answered on the
# day the page was written. Nothing in this tree ran a single one of those five until this
# rung. tools/d/docs_command_path_witness.rish proves a printed PATH resolves, and a path that
# resolves says nothing about what the command behind it prints today.
#
# The class had already bitten one room over on `20260916`: src/gate/README.md carried a census
# bound to no witness and went false inside a fortnight. A lantern that fires twice becomes a
# loom, and this is the loom.
#
# WHAT IS PROVEN, on metal. Every command the rostered page prints is RUN from the repository
# root, and its answer is read back against the block the page shows, under whichever of three
# readings the page itself declared:
#
#   exact     -- no marker above the answer. Every byte must match. A SHA3-256 digest of five
#                bytes and a resolver's three lines are fixed-input answers, and a byte
#                comparison is the only honest reading of a promise that strong.
#   selected  -- `<!-- selected: -->`. The page gathered lines out of a longer report, so each
#                printed line must stand in the real output as a WHOLE line.
#   volatile  -- `<!-- volatile: -->`. The page declares its numbers move with the tree. Every
#                digit run goes free; every other character still binds, so a renamed key or a
#                flipped verdict reds while a climbing count does not.
#
# The two marker comments were already on the page, written by a hand telling a reader which
# figures to distrust. They are machine input now, which is the cheapest instrument there is:
# the page was already carrying its own fixture.
#
# A ROSTER OF PAGES, NAMED RATHER THAN DISCOVERED, for capability rather than tidiness. This
# rung runs what a page prints, and discovering pages would mean running whatever any page in
# the tree happens to print inside a fence. A page joins the roster when a hand has read the
# commands it prints and found them safe to run every lap.
#
# WHAT IS NOT PROVEN. That the command is worth running, or that its answer teaches anything.
# This rung asks only whether the page still speaks truly about the tree it sits in.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/demo_output_witness.rish

say "demo-output: Language EN -- a page that prints an answer has made a claim, and a claim is for running."
say "demo-output: Style Radiant -- the shelf offers a reader five checks, so the shelf runs them first."
say "demo-output: Lens TAME -- safety first: the demos page is what a newcomer runs in their first hour."

let scan = run ["sh" "tools/fixtures/d/demo_output_scan.sh"]
say scan.out
assert scan.ok else "demo-output: a rostered page no longer prints what its own commands answer -- read the scan's own lines"
assert scan.out contains "drifted=0" else "demo-output: every printed answer must still hold under its declared reading"
assert scan.out contains "errored=0" else "demo-output: a page handing a reader a command that exits nonzero has already failed them"
assert scan.out contains "verdict=ok" else "demo-output: the scan must balance before it is believed"
assert scan.out contains "roster_pages=1" else "demo-output: the standing roster is one page today, and a row added to it is heard here"
assert scan.out contains "pairs=5" else "demo-output: the demos page carries five answered commands"
assert scan.out contains "pairs_exact=2" else "demo-output: two of the five are fixed-input answers that must never move"
assert scan.out contains "pairs_volatile=2" else "demo-output: two of the five declare their numbers volatile"
assert scan.out contains "pairs_selected=1" else "demo-output: one of the five names lines out of a longer report"
say "field GREEN -- every command the shelf prints was run, and every answer read back"

let control = run ["sh" "tools/fixtures/d/demo_output_control.sh"]
say control.out
assert control.ok else "demo-output: the control must complete"
assert control.out contains "leg exact_clean_ok=yes" else "demo-output: a page whose printed answer still holds must pass free"
assert control.out contains "leg exact_drift_caught=yes" else "demo-output: a printed answer that no longer holds must be refused"
assert control.out contains "leg exact_wants_whole_output=yes" else "demo-output: an unmarked block promises the whole answer, not part of it"
assert control.out contains "leg volatile_frees_digits=yes" else "demo-output: a declared-volatile count may climb without reddening the page"
assert control.out contains "leg volatile_binds_the_key=yes" else "demo-output: a volatile block frees the digits and nothing else"
assert control.out contains "leg volatile_binds_the_verdict=yes" else "demo-output: a flipped verdict carries no digit, so a volatile block must still red"
assert control.out contains "leg selected_takes_a_subset=yes" else "demo-output: a selected block names some lines of a longer report"
assert control.out contains "leg selected_missing_caught=yes" else "demo-output: a selected line the output no longer carries must be refused"
assert control.out contains "leg selected_wants_whole_line=yes" else "demo-output: a selected line is a whole line, never a fragment of one"
assert control.out contains "leg marker_belongs_to_one_pair=yes" else "demo-output: one block's volatile comment must never free the block after it"
assert control.out contains "leg unpaired_passes_free=yes" else "demo-output: a command shown to run rather than answered passes free"
assert control.out contains "leg second_fence_takes_the_answer=yes" else "demo-output: two command fences in a row pair the answer with the second"
assert control.out contains "leg nonzero_command_gated=yes" else "demo-output: a printed command that exits nonzero must be gated"
assert control.out contains "leg empty_page_refuses=yes" else "demo-output: a rostered page holding no pair must refuse rather than read green"
assert control.out contains "leg absent_page_refuses=yes" else "demo-output: a rostered page the tree lacks must refuse by name"
assert control.out contains "leg unknown_flag_refuses=yes" else "demo-output: a flag the scan does not know must refuse rather than be read past"
assert control.out contains "leg roster_names_the_demos_page=yes" else "demo-output: the roster must name the demos page it was drawn for"
assert control.out contains "leg mutation_marker_reset_bites=yes" else "demo-output: dropping the marker reset must be caught"
assert control.out contains "leg mutation_selected_substring_bites=yes" else "demo-output: loosening a selected line to a substring must be caught"
assert control.out contains "leg mutation_errored_gate_bites=yes" else "demo-output: dropping the nonzero-exit gate must be caught"
assert control.out contains "control_failed=0" else "demo-output: every leg the control runs must read yes"
assert control.out contains "control_legs=20" else "demo-output: a leg added to the control must be heard here on the lap it lands"
assert control.out contains "control_verdict=ok" else "demo-output: the control must agree with itself"
say "RED and GREEN paths proven -- nine refusals bitten, three mutations caught, eight honest readings left free"

say "GREEN: demo-output -- every answer the shipping shelf prints was run and read back."
