# dimeroll_lap2.rish -- Dimeroll lap 2 reports + exception queue.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dimeroll_lap2.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "dimeroll/bin/dimeroll"

let build = run ["sh" "-c" "mkdir -p dimeroll/bin && env RYE_ZIG=${zig} rye/bin/rye build dimeroll/dimeroll.rye -femit-bin=${bin}"]
assert build.ok else "Dimeroll lap 2 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Dimeroll selftest exited non-zero"
assert selftest.out contains "GREEN" else "Dimeroll selftest not GREEN"
assert selftest.out contains "P&L revenue 1000" else "Dimeroll missing P&L revenue"
assert selftest.out contains "expense 200" else "Dimeroll missing P&L expense"
assert selftest.out contains "net 800" else "Dimeroll missing net income"
assert selftest.out contains "BS cash 800" else "Dimeroll missing balance-sheet cash"
assert selftest.out contains "retained 800" else "Dimeroll missing retained earnings"
assert selftest.out contains "exception queue held 2" else "Dimeroll missing exception queue"

say "GREEN: Dimeroll lap 2 — P&L, balance sheet, exception queue."
