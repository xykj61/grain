# tools/d/dahl_j9_skate_circle_witness.rish — Season 3 Journey 9 (Skate), Rung 1.
#
# Season 3, Commons — keepers meet each other with consent. Skate is the social layer over Pond
# identities; Journey 9 draws its first, load-bearing half: how two keepers come to see each other at
# all. pond/apps/skate_circle.rye fixes the crux — a Circle a keeper joins only by their own act, and
# a link between two members that exists only when both have requested it. A one-sided request holds
# (a standing offer, never a connection); the mutual pair places (links); a member is visible to
# another only when linked, so presence is never default. A link touching a non-member (NotMember), a
# self-link (SelfLink), a taken seat (AlreadyMember), a repeated offer (AlreadyRequested), and a full
# circle (CircleFull) each refuse. Pure state machine — no signing yet (r2 binds each act to a settled
# Kumara identity). Facts only; no network, no key, no real identity (serve reaches the custody gate);
# demo keeper points only.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dahl_j9_skate_circle_witness.rish

say "dahl-j9r1: Language EN — a link exists only when both keepers ask, and a member is visible only when linked."
say "dahl-j9r1: Lens TAME — presence is never default; a non-member, a self-link, a taken seat, a repeated offer, and a full circle each refuse."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/skate-circle"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/skate_circle.rye -femit-bin=${bin}"]
assert build.ok else "dahl-j9r1: skate_circle build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dahl-j9r1: skate_circle selftest exited non-zero"
assert selftest.out contains "GREEN" else "dahl-j9r1: selftest did not speak GREEN"
assert selftest.out contains "only when both asked did the link place" else "dahl-j9r1: mutual-only crux missing"
assert selftest.out contains "presence is never default" else "dahl-j9r1: presence-never-default missing"
assert selftest.out contains "refused NotMember" else "dahl-j9r1: non-member refusal missing"
assert selftest.out contains "refused SelfLink" else "dahl-j9r1: self-link refusal missing"
assert selftest.out contains "AlreadyMember" else "dahl-j9r1: taken-seat refusal missing"
assert selftest.out contains "AlreadyRequested" else "dahl-j9r1: repeated-offer refusal missing"
assert selftest.out contains "refused CircleFull" else "dahl-j9r1: full-circle refusal missing"

say "dahl-j9r1: GREEN — Skate's consent-first rule holds; mutual-only links, presence never default, every refusal held."
