# tools/d/drey_serve_witness.rish — the desk serves a wanted recording: answer a want by re-framing a held payload (DREY9).
#
# Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY9.
# Design read: active-designing/date/20260814/20260814-065650_drey9-desk-serves-a-wanted-recording-exploration.md
# Stands on: mikrophone/catalog.rye (DREY7), mikrophone/manifest.rye (DREY8), mikrophone/wire.rye (DREY1).
#
# mikrophone/serve.rye is the want-response to DREY8's have-advertisement: serve re-frames the payload the catalog holds
# under an address into exactly the wire frame that carries it, or refuses NotHeld. Together, catalog + manifest + serve
# close a complete, purely local content-addressed sync. The selftest proves: serve answers only what is held, the
# answer is content-preserving (the served frame's address equals the address asked for), the whole local loop converges
# (a far hand holding a subset ends holding exactly what the desk holds), and a tampered served frame refuses
# DigestMismatch and lands nothing.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/drey_serve_witness.rish

say "drey-serve: Language EN — DREY9 lets the Mikrophone desk answer a want by re-framing the recording it holds; catalog + manifest + serve close a complete, purely local content-addressed sync."
say "drey-serve: Style Radiant — the desk answers only what it truly holds and hands back exactly the recording asked for, so two hands meet holding the same whole — no byte crossing that a keeper did not need, none arriving that cannot be proven."
say "drey-serve: Lens TAME — serve refuses NotHeld before a frame is built, re-frames through the one proven wire path (rebuild a committed session, wire.frame), asserts the served frame is content-preserving (deframe equals the held payload, its address equals the address served); the far hand's deposit stays verify-before-trust; serving over a real transport stays the Comlink-served gate; no disk, no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "mikrophone/bin/serve"

let build = run ["sh" "-c" "mkdir -p mikrophone/bin && env RYE_ZIG=${zig} rye/bin/rye build mikrophone/serve.rye -femit-bin=${bin}"]
assert build.ok else "drey-serve: build failed — ${build.err}"

let outfile = "mikrophone/bin/serve.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "drey-serve: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "drey-serve: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN drey-serve' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "drey-serve: selftest did not print the GREEN drey-serve line"

say "drey-serve: GREEN — the Mikrophone desk answers a want by re-framing what it holds. DREY9 closes a complete local content-addressed sync; serving over a real transport waits for the Comlink-served gate."
