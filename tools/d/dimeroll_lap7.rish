# dimeroll_lap7.rish — Dimeroll lap 4 sum amounts witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dimeroll_lap7.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "dimeroll/bin/dimeroll"

let build = run ["sh" "-c" "mkdir -p dimeroll/bin && env RYE_ZIG=${zig} rye/bin/rye build dimeroll/dimeroll.rye -femit-bin=${bin}"]
assert build.ok else "Dimeroll lap 7 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Dimeroll selftest exited non-zero"
assert selftest.out contains "GREEN" else "Dimeroll selftest not GREEN"
assert selftest.out contains "sum amounts" else "Dimeroll missing sum amounts welcome"
assert selftest.out contains "all=1200" else "Dimeroll missing sum amounts total"

say "GREEN: Dimeroll lap 7 — sum_amounts over journal entries."
