# tools/d/dexter_shell_witness.rish -- Dexter, the prompt session on metal.
#
# pond/apps/dexter_shell.rye weds dexter_line.rye's editable line to dexter_history.rye's ring into the
# prompt state machine a keeper drives: type, submit (remember and clear), and walk history with up/down,
# recalling a committed line into the editable line to run or edit again. This witness builds the module to
# a binary and asserts its selftest speaks GREEN over the four cruxes:
#   - Submit remembers and clears -- the line joins history, the editable line empties for the next.
#   - Up/down recall into the line -- a committed line loads into the editable line, history untouched.
#   - The draft is stashed -- an in-progress line survives a trip up into history and returns on the way down.
#   - Recall bounds named -- a step past the oldest (NoEarlier) or past the live edge (NoLater) is refused.
#
# Facts only, custody-first: it holds a line and its history and nothing else -- no network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/d/dexter_shell_witness.rish

say "dexter-shell: Language EN -- an editable line married to its history, the prompt session a keeper drives."
say "dexter-shell: Lens TAME -- submit remembers and clears, up/down recall into the line, the draft never lost, no key and no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/dexter-shell"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/dexter_shell.rye -femit-bin=${bin}"]
assert build.ok else "dexter-shell: dexter_shell build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dexter-shell: dexter_shell selftest exited non-zero"
assert selftest.out contains "GREEN" else "dexter-shell: selftest did not speak GREEN"
assert selftest.out contains "submit remembers the line in history and clears it" else "dexter-shell: submit crux missing"
assert selftest.out contains "recall committed lines into the editable line, history untouched" else "dexter-shell: recall crux missing"
assert selftest.out contains "draft is stashed on up and restored" else "dexter-shell: draft-stash crux missing"
assert selftest.out contains "refused by name" else "dexter-shell: bounds crux missing"

say "GREEN: dexter-shell -- the prompt session: submit remembers and clears, up/down recall into the line, and an in-progress draft is stashed and restored."
