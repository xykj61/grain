# tools/caravan_suite_witness.rish -- the choir for the Microkernel Target's Caravan arc, and the guard that keeps it whole.
#
# The lantern that fires becomes a loom. Fifty-two per-rung Caravan witnesses had landed on disk, each GREEN in its own right,
# with nothing that heard them all: three consecutive rounds named this ratchet by name and left it standing. REDS %81 already
# taught the cost in the crypto library -- nine rungs landed as their own green witnesses and the choir never registered one of
# them, so a whole ladder ran unheard. This witness closes that door for Caravan.
#
# It does two things, in order. First it proves the roster is whole: every tools/caravan_*_witness.rish on disk is registered
# here, and every path registered here exists on disk -- a bijection, not a bare tally, so a rung's witness can never land
# unheard and a roster line can never point at nothing. Then it runs the whole roster and asserts each one GREEN, naming
# exactly which rung broke if any does.
#
# Season: the Lindy-priority Microkernel Target double-seat (Caravan on seL4/Genode, clean-room study; Tally on s6/skalibs).
# Design read: active-designing/date/20260816/20260816-205859_double-seat-expansion-eight-seasons.md.
# Kin: tools/crypto_suite_witness.rish (the elder choir this is shaped after), tools/crypto_count_guard_witness.rish (the
# bijection guard REDS %80 booked, folded here into one file), caravan/README.md (the rung-by-rung record).
#
# Caravan's helper modules and dependent-program fixtures -- bounded, capabilities, chain, ladder_checks, parse_int, seed, service, tally_copy,
# twin, and the supervisor_* and *_test programs a witness spawns -- carry no witness of their own on purpose: they are proven
# through the rungs that compose them, rather than in isolation. So the bijection here binds witnesses to the roster, never
# modules to witnesses; that honest asymmetry is why this guard counts what it counts.
#
# This authors no supervision -- it runs and compares. Purely local: no key, no signature, no network, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_suite_witness.rish

say "caravan-suite: Language EN -- the Caravan choir: one run that hears every per-rung witness of the Microkernel Target arc, and a guard proving the roster it sings from is whole."
say "caravan-suite: Style Radiant -- a rung is proven when a witness says so, and an arc is proven when nothing in it is unheard. The roster is checked before it is sung, so the count this witness prints is measured rather than remembered."
say "caravan-suite: Lens TAME -- every tools/caravan_*_witness.rish on disk is asserted registered here, every registration is asserted to exist on disk, and then each is asserted GREEN. RED names exactly which rung broke the bijection or the run. Purely local -- no key, no network, no funds, no device."

# The choir sings from a cold tree, always (REDS %92). Thirty-six rungs ran
# caravan/bin/read without building it, so this suite had never once proven itself
# on a clean checkout -- it passed on whatever an earlier run had left warm, and the
# day the directory was cleared it named a rung RED that was perfectly sound. Clearing
# the built binaries before every run makes cold-start self-sufficiency a fact this
# witness checks rather than a property nobody was measuring.
let mk = run ["sh" "-c" "rm -rf caravan/bin && mkdir -p caravan/bin"]
assert mk.ok else "caravan-suite: could not make a cold caravan/bin -- ${mk.err}"

# The roster lists this choir reads are private to one run (REDS %88). Two suites in flight at once --
# a hand beside a sweep -- once shared one pair of files in the tree and read each other's half-written
# rosters, so the bijection could refuse a roster that was whole. The scan below keeps its two lists in
# a directory it makes and removes for itself, which is that lesson held structurally rather than by a
# name a second run could still collide with.

let witnesses = [ "tools/caravan_abandon_witness.rish" "tools/caravan_abate_witness.rish" "tools/caravan_abide_witness.rish" "tools/caravan_amend_witness.rish" "tools/caravan_answer_witness.rish" "tools/caravan_appeal_witness.rish" "tools/caravan_apprise_witness.rish" "tools/caravan_arrange_witness.rish" "tools/caravan_appraise_witness.rish" "tools/caravan_arrive_witness.rish" "tools/caravan_avow_witness.rish" "tools/caravan_bear_witness.rish" "tools/caravan_beckon_witness.rish" "tools/caravan_boot_witness.rish" "tools/caravan_c4_exit_meanings_eq_witness.rish" "tools/caravan_caps_a1_gate_bound_witness.rish" "tools/caravan_carry_witness.rish" "tools/caravan_channels_witness.rish" "tools/caravan_dependents_a1_gate_bound_witness.rish" "tools/caravan_cohort_witness.rish" "tools/caravan_commute_witness.rish" "tools/caravan_concurrent_witness.rish" "tools/caravan_conclude_witness.rish" "tools/caravan_confer_witness.rish" "tools/caravan_courier_witness.rish" "tools/caravan_cycle_witness.rish" "tools/caravan_decline_witness.rish" "tools/caravan_deem_witness.rish" "tools/caravan_derivation_witness.rish" "tools/caravan_desist_witness.rish" "tools/caravan_dispute_witness.rish" "tools/caravan_dwell_witness.rish" "tools/caravan_edge_witness.rish" "tools/caravan_endure_witness.rish" "tools/caravan_enlist_witness.rish" "tools/caravan_entrust_witness.rish" "tools/caravan_exercise_witness.rish" "tools/caravan_fanin_witness.rish" "tools/caravan_farewell_witness.rish" "tools/caravan_fence_witness.rish" "tools/caravan_gap_witness.rish" "tools/caravan_glow_tend_limb1_witness.rish" "tools/caravan_glow_tend_limb2_witness.rish" "tools/caravan_glow_tend_limb3_witness.rish" "tools/caravan_glow_tend_limb4_witness.rish" "tools/caravan_harvest_witness.rish" "tools/caravan_hear_witness.rish" "tools/caravan_heed_witness.rish" "tools/caravan_inflight_witness.rish" "tools/caravan_intent_witness.rish" "tools/caravan_ipc_buffer_witness.rish" "tools/caravan_ladder_carry_witness.rish" "tools/caravan_ladder_copy_witness.rish" "tools/caravan_ladder_print_witness.rish" "tools/caravan_ladder_spine_witness.rish" "tools/caravan_lapse_witness.rish" "tools/caravan_mapping_witness.rish" "tools/caravan_mask_witness.rish" "tools/caravan_meet_witness.rish" "tools/caravan_mend_witness.rish" "tools/caravan_notify_witness.rish" "tools/caravan_objects_witness.rish" "tools/caravan_overtake_witness.rish" "tools/caravan_owe_witness.rish" "tools/caravan_phases_witness.rish" "tools/caravan_precede_witness.rish" "tools/caravan_queue_witness.rish" "tools/caravan_read_witness.rish" "tools/caravan_recant_witness.rish" "tools/caravan_redress_witness.rish" "tools/caravan_reckon_witness.rish" "tools/caravan_reclaim_witness.rish" "tools/caravan_refer_witness.rish" "tools/caravan_refrain_witness.rish" "tools/caravan_refusals_witness.rish" "tools/caravan_reply_witness.rish" "tools/caravan_rederive_witness.rish" "tools/caravan_regions_witness.rish" "tools/caravan_relent_witness.rish" "tools/caravan_reopen_witness.rish" "tools/caravan_reweigh_witness.rish" "tools/caravan_recount_witness.rish" "tools/caravan_allay_witness.rish" "tools/caravan_forbear_witness.rish" "tools/caravan_mind_witness.rish" "tools/caravan_relay_witness.rish" "tools/caravan_replace_witness.rish" "tools/caravan_repose_witness.rish" "tools/caravan_respect_witness.rish" "tools/caravan_restart_witness.rish" "tools/caravan_revoke_witness.rish" "tools/caravan_rolling_witness.rish" "tools/caravan_roster_witness.rish" "tools/caravan_roundtrip_witness.rish" "tools/caravan_serve_witness.rish" "tools/caravan_stall_witness.rish" "tools/caravan_standby_witness.rish" "tools/caravan_suffice_witness.rish" "tools/caravan_swell_witness.rish" "tools/caravan_system_witness.rish" "tools/caravan_taper_witness.rish" "tools/caravan_tidings_witness.rish" "tools/caravan_understudy_witness.rish" "tools/caravan_unhand_witness.rish" "tools/caravan_unprompted_witness.rish" "tools/caravan_untyped_witness.rish" "tools/caravan_withdraw_witness.rish" ]

# The bijection, read by the scan both this choir and the every-lap ladder meter pull, so the roster is
# one question answered in one place (REDS %101). Singing 98 witnesses costs minutes; asking whether the
# roster is whole costs two greps -- and it is the asking that catches a witness born unheard.
let roster = run ["sh" "tools/fixtures/caravan_roster_bijection_scan.sh"]
assert roster.ok else "caravan-suite: the roster bijection must hold before the choir sings -- ${roster.out}"
assert roster.out contains "ROSTER_OK" else "caravan-suite: want the roster whole in both directions -- ${roster.out}"

let disk_c = run ["sh" "-c" "find tools -maxdepth 1 -name 'caravan_*_witness.rish' -type f | grep -v caravan_suite_witness | wc -l | tr -d ' \n'"]
assert disk_c.ok else "caravan-suite: could not count the witnesses on disk -- ${disk_c.err}"
let n_disk = trim disk_c.out

say "caravan-suite: roster whole -- ${n_disk} per-rung witnesses on disk, each registered here and each registering a real file. Singing them now."

for-each witnesses as w do assert (run ["rishi/bin/rishi" "run" w]).ok else "caravan-suite: a per-rung witness went RED -- ${w}"

say "GREEN caravan-suite -- ${n_disk} Caravan witnesses registered and run, every rung of the Microkernel Target arc heard in one voice"
