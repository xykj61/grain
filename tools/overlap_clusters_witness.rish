# tools/overlap_clusters_witness.rish -- the connected clusters of the scene's box-overlap graph, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/scene_graph.rye joins object_relation over every pair into one matrix; image/overlap_degree.rye
# reads each object's LOCAL degree over it. This rung reads the GLOBAL shape those edges build: overlap_clusters gathers objects whose boxes
# overlap, directly or through a chain, into connected clusters, with cluster_of, same_cluster, cluster_size, and largest_cluster over them.
# Exact integers, NO float, NO tolerance.
#
# The crux this witness proves on metal, two shapes: CONNECTIVITY IS THE TRANSITIVE CLOSURE OF A NON-TRANSITIVE RELATION -- a hub overlaps
# two dots, so all three land in one cluster, the two dots connected through the hub though their own boxes never overlap, box overlap not
# being transitive while connectivity is exactly its closure; THE CLUSTER OVER-CLAIMS A TOUCHING GROUP -- every object in that cluster sits
# 2+ pixels apart from every other, a group of frames never of touching substance, and a far dot outside every box is its own singleton
# cluster, so the cluster count is fewer than the object count. Refusals by name, determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/overlap_clusters_witness.rish

say "overlap_clusters: Language EN -- Season G box-overlap-connectivity read; overlap_clusters gathers overlapping boxes into connected clusters, cluster_of the id per object, same_cluster the transitive-closure test, cluster_size the count per cluster, largest_cluster the biggest group; NO float, NO tolerance."
say "overlap_clusters: Style Radiant -- compose not braid: this rung owns only the connectivity, the union across overlap edges and the dense cluster labeling; scene_graph owns the pairwise matrix, overlap_degree owns the degree and edge count, object_relation owns each pair's overlap and exact distance, scene_manifest owns the per-object boxes. A reading over a reading over a reading."
say "overlap_clusters: Lens TAME -- the scene graph caps its object count, so the union loop runs a bounded number of pairs and every find walks a chain at most that long; a background or past-the-count object label refuses BadObjectLabel, a zero or past-the-count cluster id refuses BadClusterId, the largest read of an empty scene refuses NoObjects; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/overlap_clusters"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/overlap_clusters.rye -femit-bin=${bin}"]
assert build.ok else "overlap_clusters: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "overlap_clusters: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "overlap_clusters: ${out}"

assert selftest.out contains "GREEN image-overlap-clusters" else "overlap_clusters: selftest did not print the GREEN line"
assert selftest.out contains "CONNECTIVITY IS THE TRANSITIVE CLOSURE OF A NON-TRANSITIVE RELATION" else "overlap_clusters: the transitive-closure case did not print"
assert selftest.out contains "a cluster holds a pair that shares no edge" else "overlap_clusters: the no-edge-pair fact did not print"
assert selftest.out contains "box overlap is not transitive" else "overlap_clusters: the not-transitive fact did not print"
assert selftest.out contains "THE CLUSTER OVER-CLAIMS A TOUCHING GROUP" else "overlap_clusters: the over-claims-touch case did not print"
assert selftest.out contains "a group of frames, never of touching substance" else "overlap_clusters: the frames-not-substance fact did not print"
assert selftest.out contains "its own singleton cluster" else "overlap_clusters: the singleton-far-dot fact did not print"
assert selftest.out contains "strictly FEWER than the object count" else "overlap_clusters: the fewer-clusters fact did not print"
assert selftest.out contains "refuses BadObjectLabel" else "overlap_clusters: the bad-object-label refusal did not print"
assert selftest.out contains "refuses BadClusterId" else "overlap_clusters: the bad-cluster-id refusal did not print"
assert selftest.out contains "the same scene clusters the same way twice" else "overlap_clusters: the determinism statement did not print"

say "overlap_clusters: GREEN on metal -- the connected clusters of the box-overlap graph; connectivity the transitive closure of a non-transitive relation, the cluster a group of frames never of touching substance, a far dot its own singleton, the cluster count fewer than the object count; refusals by name, determinism. Season G open-media."
