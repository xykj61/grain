# tools/buhr_corpus_query_witness.rish — BUHR Journey 1, Rung 3.
#
# The Q-vane host pattern carried to the craft voice, proven end to end: a bounded
# Lantern-shaped request routes through Ember for a real reading of a pinned corpus
# catalog and returns a Lantern-contract-bounded response. Ember's query is genuine
# (real kind count, real line sum, real rye paths), the allow-list gates the model,
# and the length budget truncates with a length stop exactly as Lantern's own
# contract does. Rungs one (Lattice) and two (Scribble) are untouched.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_corpus_query_witness.rish

say "buhr3: Language EN — Ember + Lantern composed as one bounded corpus query."
say "buhr3: Lens TAME — real catalog reading, bounded request, bounded response; unknown op refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/corpus-query"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/corpus_query.rye -femit-bin=${bin}"]
assert build.ok else "buhr3: corpus_query build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr3: corpus_query selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr3: selftest did not speak GREEN"
assert selftest.out contains "count_rye routed to Ember — text '3'" else "buhr3: real kind-count reading missing"
assert selftest.out contains "sum_lines routed to Ember — text '160'" else "buhr3: real line-sum reading missing"
assert selftest.out contains "paths_rye routed to Ember — text 'rye/forge.rye rye/tally.rye rye/mandi.rye'" else "buhr3: real rye-paths reading missing"
assert selftest.out contains "length budget — tokens 2 length" else "buhr3: length-budget stop missing"
assert selftest.out contains "model not allowed refused" else "buhr3: allow-list gate missing"
assert selftest.out contains "unknown op refused" else "buhr3: unknown-op refusal missing (would be a fake answer)"
assert selftest.out contains "zero budget refused by Lantern contract" else "buhr3: Lantern budget gate missing"

say "GREEN: BUHR3 — Ember + Lantern composed; real corpus reading routed and returned bounded by the contract."
