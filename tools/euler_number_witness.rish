# tools/euler_number_witness.rish -- the EULER NUMBER of a segmented region, on metal (Season G).
#
# Season G (Open Media Primitives) -- every shape reader before this one measures GEOMETRY (area, hull, widths, inscribed and
# enclosing disks), and geometry is blind to TOPOLOGY. A solid block and a hollow ring share one outer contour, one hull, one
# enclosing circle. This rung reads the topological fact directly: HOW MANY holes the region has, by BIT-QUAD counting (S.B. Gray
# 1971), the exact integer E = (Q1 - Q3 - 2*QD) / 4 for the 8-connected foreground -- NO float, NO tolerance.
#
# The crux this witness proves on metal: a solid 5x5 block reads Euler 1 (one part, no hole) and a hollow 5x5 ring reads Euler 0
# (one part, one hole) though their outer contour is byte-for-byte identical -- topology SEES the hole the convex readers cannot;
# and a plus and a ring are BOTH dented, so solidity merges them, yet the plus has no hole and the ring one -- topology is the axis
# that separates a pair solidity collapses; a twice-pierced block reads Euler -1 (two holes); refusals by name and determinism. No
# network, no key, no funds -- the hole count a surface names the day it must tell a ring from a disk.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/euler_number_witness.rish

say "euler_number: Language EN -- Season G Euler number; the exact-integer TOPOLOGY (components - holes) of a segmented region by bit-quad counting, the one descriptor that COUNTS the interior hole the metric family only pointed at; NO float, NO tolerance."
say "euler_number: Style Radiant -- compose not braid: this rung owns only the bit-quad sweep and the reads over the count (hole_count, is_simply_connected, has_hole); label owns the component map and its 8-connectivity, qoi the pixel ceiling. No hull built, no distance field, no pixel written -- a reading, not a render."
say "euler_number: Lens TAME -- the sweep visits (width+1)*(height+1) windows under euler_max_windows, every tally a u32 far below the i32 ceiling and the signed numerator a multiple of four by the bit-quad theorem checked on metal; a label of zero or past the component count refuses BadLabel; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/euler_number"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/euler_number.rye -femit-bin=${bin}"]
assert build.ok else "euler_number: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "euler_number: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "euler_number: ${out}"

assert selftest.out contains "GREEN image-euler-number" else "euler_number: selftest did not print the GREEN line"
assert selftest.out contains "a solid 5x5 block reads Euler 1" else "euler_number: the block definition did not print"
assert selftest.out contains "a hollow 5x5 ring reads Euler 0" else "euler_number: the topology-sees-the-hole crux did not print"
assert selftest.out contains "topology SEES the interior hole" else "euler_number: the sees-the-hole claim did not print"
assert selftest.out contains "the ORTHOGONALITY crux" else "euler_number: the orthogonality crux did not print"
assert selftest.out contains "the Euler number the axis that separates a pair solidity collapses" else "euler_number: the separates-what-solidity-merges claim did not print"
assert selftest.out contains "reads Euler -1 (one part, two holes)" else "euler_number: the two-hole case did not print"
assert selftest.out contains "refuses BadLabel" else "euler_number: the refusal did not print"
assert selftest.out contains "reads deterministically" else "euler_number: determinism did not print"

say "euler_number: GREEN on metal -- the Euler number reads a region's exact-integer topology by bit-quad counting; a ring's hole is COUNTED where every geometry reader is blind to it, and topology separates the ring from the equally-dented plus; refusals by name, determinism. Season G open-media."
