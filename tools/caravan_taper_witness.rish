# caravan_taper_witness.rish -- Caravan taper witness.
#
# `unhand.rye` weighed a newcomer against the line each running dependent was
# actually handed rather than against everything its domain may ever reach,
# and it named its own limit plainly: that line never moves while the dependent
# runs.
#
#   A LINE ONLY EVER SHRINKS, AND THE DOOR WIDENS THE MOMENT THE WORK
#   NARROWS.
#
# A dependent that has finished an arc may give it back. The walk a `stand`
# makes is ordered -- it reads its arcs in the order its plan names them --
# so at every instant the dependent holds a SUFFIX of the line it was handed. A
# handback is therefore one number, and the run's whole memory of the
# shrinking is a single byte per dependent.
#
# WHAT THIS RUNG PROVES, AND WHAT IT COSTS, MEASURED:
#
#   * THE LINE NARROWS FROM ITS OWN FRONT, arcs and letters together, so a
#     line of three read as two the moment its first arc came back.
#   * A RUN MAY NEVER NARROW A LINE IT HAS NOT HEARD NARROWED. Each dependent
#     publishes into a note of its own, the supervisor reads the note
#     between fills, and the supervisor acknowledges what it has taken in --
#     a two-way notification, the shape a microkernel already gives a parent
#     and its protection domain. Both sides are bounded: a dependent never waits
#     forever on a reader that is not coming, and a blocked run never spins
#     past its own bound before it reaps.
#   * THREE REFUSALS THIS RUNG EARNS, AND EVERY ONE IS ABOUT THE LINE.
#     `TaperReversed` is the direction: a line only ever shrinks, so a note
#     read lower than the run remembers claims arcs already given back.
#     `TaperEmptied` is the floor: a dependent always holds at least the arc it
#     is working, and a line given back whole is a departure `withdraw.rye`
#     already answered. `TaperWidened` is the reach: what remains named must
#     be what was handed, declaring exactly what it declared at spawn.
#   * THE DOOR ITSELF NEEDS NOTHING NEW. `unhand.admissible_held` weighs a
#     newcomer against the lines a run remembers; this rung changes only
#     what those lines say. The channel joint stands exactly where it stood,
#     and a domain still runs one dependent at a time.
#   * A RUN THAT HEARS NOTHING READS AS THE RUNG BELOW, all 9 pairs -- this
#     arc's standing generalization test. Silence leaves every line at full
#     width, which is the held reading itself, so the narrower room is never
#     less safe, only sometimes wider.
#   * THE ROOM MEASURED ON METAL: one plan run twice. 5 dependents either way
#     and 1 coming home either way, with 2 at once by the line handed
#     against 3 by the line still held.
#
# THE LIMIT IS NAMED: a run widens only as far as its dependents publish, and
# it pays for the chance with a bounded listen at each blocked moment.
# Whether a supervisor may hand a running dependent a WIDER line -- work
# arriving for a dependent already in flight, rather than work leaving it --
# belongs to the vision room until a witness binds it.
#
# All five RED paths were proven on metal before this witness claimed GREEN.
# Drop the direction refusal and a line grows back an arc it had already
# given away. Let a line be given back whole and the walk panics at
# `reached unreachable` on the invariant that a narrowed line always keeps
# the arc its dependent is working. Let a narrowed line name an arc nobody
# handed it and the reach reads as within. Answer the door by the line
# handed in both runs and the finding shows as a failure: `the narrower room
# bought no room at all: 2 against 2`. Never listen at all and the run
# reports `a run of a standing dependent heard no handback at all`.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_taper_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/taper"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/taper.rye -femit-bin=${bin}"]

assert build.ok else "caravan taper build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs once ran a shared caravan/bin/read without building it, so the whole
# arc was green only on a tree some earlier run had left warm. A witness owns what it
# runs -- and, since REDS %133, the path it runs it from: eighty witnesses built that
# one reader to one name, so two running at once contended for a single file and the
# loser reddened a green tree. This one lands in caravan/bin/taper_read.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/taper_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# The board declaration the rung below opened, unchanged: a region one
# client writes and its siblings read, with no channel joining any of them.
let published = run ["sh" "-c" "caravan/bin/taper_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero, every bell
# starts silent, and every handback note starts with nothing given back.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.tapers"]
assert clean.ok else "the region stores, doorbells, and notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan taper selftest exited non-zero"
assert test.out contains "GREEN" else "caravan taper selftest not GREEN"
assert test.out contains "a line only ever shrinks, and the door widens the moment the work narrows" else "the taper finding did not close"

# The line and its three refusals, read straight, before any dependent runs.
assert test.out contains "a line only ever shrinks, and the arc given back opens the door" else "the narrowing line was not weighed at the door"
assert test.out contains "three refusals stand by name: reversed, emptied, widened" else "the three refusals did not stand"
assert test.out contains "the channel joint stands unchanged" else "the standing joint was not shown to stand"

# The generalization test: a run that hears nothing reads as the rung below.
assert test.out contains "a run that hears nothing reads as the line handed, all 9 pairs" else "silence did not read as the line handed"

# The taper lap: one plan run twice, once by the line handed at spawn and
# once by the line each dependent still holds.
assert test.out contains "dependents: 5 by the line handed, 5 by the line still held" else "the narrower room changed how much work the run did"
assert test.out contains "came home as handed: 1 by the line handed, 1 by the line still held" else "a dependent did not come home as it was handed"
assert test.out contains "at once: 2 by the line handed, 3 by the line still held" else "the narrower room bought no room at all"
assert test.out contains "breaks a named turn: 0 by the line handed, 0 by the line still held" else "the narrower room broke an order its author named"

# The handbacks themselves are reported rather than pinned to a number: how
# many a run hears depends on when it happens to be listening, and the
# selftest already refuses a run that hears none at all.
assert test.out contains "handbacks heard:" else "the run did not report what it heard"
assert test.out contains "slots left unspent:" else "the run did not report the slots it spent"

say "GREEN: Caravan taper witness passed."
