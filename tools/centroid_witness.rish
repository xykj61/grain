# tools/centroid_witness.rish -- a labeling's CENTROIDS and the nearest region to a point, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/regions.rye reads a component's area and bounding box; this rung reads the next
# fact a surface asks the moment it wants to point at a blob: WHERE is its center of mass. The centroid is the rounded mean of
# a component's pixel coordinates, a genuinely different fact from the bounding-box center; nearest_region answers the click a
# surface fields -- which blob's center lies closest to a point -- ties broken by the earliest label.
#
# The crux this witness proves on metal: a 3x3 block centers at its middle (1,1), a lone dot is its own centroid (7,4), and an
# L whose mass leans low centers at (5,1) where its box center sits at row 0 -- so a centroid is provably a different fact from
# a box center; nearest_region picks the right blob for three points and breaks a two-dot equidistant tie to the earliest
# label; refusals by name. No network, no key, no funds -- the center a surface names the day it labels a blob, on our own open
# geometry.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/centroid_witness.rish

say "centroid: Language EN -- Season G centroid reader over a LabelMap; centroids returns one center of mass per component, nearest_region finds the region whose center lies closest to a point."
say "centroid: Style Radiant -- compose not braid: this rung owns only the first-moment accumulation and the nearest-center search; label owns the LabelMap and its dense raster-ordered labels. No gather, no blend, no codec, no color, not even a pixel-writing loop."
say "centroid: Lens TAME -- the coordinate sums run in u64 so a full-image component can never wrap; the centroid slice is sized to the label count; an empty source refuses EmptySource and a nearest search over no regions refuses NoRegions up front so a refusal allocates nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/centroid"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/centroid.rye -femit-bin=${bin}"]
assert build.ok else "centroid: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "centroid: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "centroid: ${out}"

assert selftest.out contains "GREEN image-centroid" else "centroid: selftest did not print the GREEN line"

say "centroid: GREEN -- the block centers at its middle, the L's leaning mass centers off its box center, the dot is its own centroid, nearest_region picks the right blob and breaks a tie to the earliest label, the refusals fire by name, on metal."
