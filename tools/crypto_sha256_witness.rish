# tools/crypto_sha256_witness.rish — SHA-256 authored in pure Rye: Season G's 256-bit hash, the one the tree already content-addresses
# with, proven against the FIPS 180-4 known-answers and byte-for-byte against an independent implementation (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (the wave that seats Season G).
# Kin: crypto/sha512.rye (the 64-bit sibling, GREEN), crypto/sha3.rye (the Keccak hash). Monocypher does not itself ship SHA-256, so
# this hash is authored from FIPS 180-4 directly, our own arithmetic, clean-room (.claude/rules/gratitude-licenses.md).
#
# crypto/sha256.rye authors SHA-256 from the standard — the initial hash value, the sixty-four round constants, the Ch/Maj/Sigma
# functions, the sixty-four-round compression, FIPS 180-4 padding (0x80 marker, zeros, 64-bit big-endian bit length). The primitive
# calls no std.crypto. Parity is proven at selftest against two references runnable now: the FIPS 180-4 known-answers for "abc" and the
# empty message (hex for hex), and Zig's own std.crypto SHA-256 as an independent implementation, byte-for-byte over the empty message,
# "abc", a 55-byte input, a 56-byte input (the edge that forces a second all-padding block), and a 300-byte multi-block input. An
# over-long message refuses MessageTooLong before a byte is mixed. Purely local arithmetic — no key, no signature, no network, no funds,
# no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/crypto_sha256_witness.rish

say "crypto-sha256: Language EN — Season G's 256-bit hash: SHA-256 (FIPS 180-4), the one the tree already leans on through std.crypto — Tablecloth content-addresses with it, the Mycelium consensus spine places worlds by SHA-256(domain · world-id · host-pk), and the constel test network seeds ship identities from SHA-256(name). Authoring our own, parity-checked, calling no std.crypto is exactly Season G's thesis; SHA-256 is the 32-bit sibling of the GREEN SHA-512, pure integer arithmetic buildable in authored Rye and tied to a published FIPS 180-4 known-answer."
say "crypto-sha256: Style Radiant — the law is stated positively: sixteen big-endian words per 64-byte block expand to a sixty-four-word message schedule and fold through sixty-four rounds of the Ch/Maj/Sigma round function, every add mod 2^32, every rotation and shift a fixed constant, the message padded with a 0x80 marker and a 64-bit big-endian bit length so the same bytes always fold to the same 32-byte digest anyone can replay against the standard."
say "crypto-sha256: Lens TAME — the primitive calls no std.crypto; it is authored from the standard, bounded input (max_message_bytes), contract asserts on every function, wrapping +% where the math is mod 2^32. Parity holds against the FIPS 180-4 known-answers AND Zig's independent std.crypto SHA-256 byte-for-byte over the empty message, \"abc\", a 55-byte input, a 56-byte padding-edge input, and a multi-block input; an over-long message refuses MessageTooLong before a byte is mixed. Monocypher does not ship SHA-256, so the hash is authored from FIPS 180-4 directly. Purely local — no key, no signature, no network, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/sha256"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/sha256.rye -femit-bin=${bin}"]
assert build.ok else "crypto-sha256: build failed — ${build.err}"

let outfile = "crypto/bin/sha256.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-sha256: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-sha256: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-sha256' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-sha256: selftest did not print the GREEN crypto-sha256 line"
