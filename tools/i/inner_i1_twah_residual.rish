# tools/i/inner_i1_twah_residual.rish -- Inner Scope i1: Twah residual sweep witness.
#
#   rishi/bin/rishi run tools/i/inner_i1_twah_residual.rish

say "inner-i1: Language EN — Twah residual sweep (living tree)."
say "inner-i1: Style Radiant — GREEN when deleted Twah paths stay gone and Djin greens."
say "inner-i1: Lens TAME — rename-forward history allowed; broken generator ads refuse."

let sweep = run ["sh" "tools/fixtures/inner_i1_twah_residual.sh"]
assert sweep.ok else "inner-i1 residual sweep RED — see stderr"
assert sweep.out contains "GREEN: inner-i1" else "inner-i1 missing GREEN line"
say sweep.out

say "GREEN: inner-i1 — Twah residual sweep complete; gen_gren still GREEN."
