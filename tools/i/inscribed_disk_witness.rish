# tools/i/inscribed_disk_witness.rish -- the LARGEST INSCRIBED DISK (biggest round peg a shape holds) of a mask, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/min_enclosing_circle.rye reads the OUTER round bound (the smallest disk covering the
# whole silhouette, face-first) and image/min_width.rye the outer-turned EDGE-FIRST slot. This rung reads the INNER bound: the
# largest round disk that fits INSIDE the shape, taken as the DEEPEST pixel of image/distance.rye's chamfer field by an EXACT integer
# argmax and NO tolerance; only the reported radius is read in f64, as image/min_enclosing_circle.rye reports its own.
#
# The crux this witness proves on metal: a solid 5x5 block and a hollow 5x5 ring (a wall one pixel thick) trace the IDENTICAL outer
# contour, so image/convex_hull.rye and image/min_enclosing_circle.rye read the SAME hull and the SAME enclosing circle for both, yet
# the inscribed disk shrinks from radius 3 (the block's center) to radius 1 (the ring's wall) -- the inner bound SEES the interior
# hole every convex reader is blind to. And THICKNESS not REACH -- a 2x8 bar holds an inscribed disk of radius only 1 (half its
# thickness) while its enclosing circle has radius ~4.12. disk_contains and holds_round_peg both ways; refusals by name; determinism.
# No network, no key, no funds -- the inner reach a surface names the day it asks how big a round mark the shape can hold.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/i/inscribed_disk_witness.rish

say "inscribed_disk: Language EN -- Season G largest inscribed disk over image/distance.rye's chamfer field; the biggest round peg a shape holds, taken as the deepest pixel by an EXACT integer argmax and no tolerance; only the reported radius is read in f64, as image/min_enclosing_circle.rye reports its own."
say "inscribed_disk: Style Radiant -- compose not braid: this rung owns only the argmax over the distance field and the two exact reads over the disk (disk_contains, holds_round_peg); distance owns the chamfer field and its weights, qoi the RGBA buffer, convex_hull and min_enclosing_circle the outer bounds this one mirrors from the inside. No gather, no blend, no codec, no color, no pixel-writing loop -- a reading, not a render."
say "inscribed_disk: Lens TAME -- the field is measured under image/distance.rye's own pixel ceiling; a chamfer depth stays under 32768, so dist_orthogonal^2 * depth^2 stays far under 2^40 in i64 and no accumulator wraps; an all-background mask refuses NoForeground and a zero-size source EmptySource; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/inscribed_disk"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/inscribed_disk.rye -femit-bin=${bin}"]
assert build.ok else "inscribed_disk: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "inscribed_disk: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "inscribed_disk: ${out}"

assert selftest.out contains "GREEN image-inscribed-disk" else "inscribed_disk: selftest did not print the GREEN line"
assert selftest.out contains "the inner bound SEES the interior hole" else "inscribed_disk: the inner-sees-the-hole crux did not print"
assert selftest.out contains "the SAME hull and the SAME enclosing circle for both" else "inscribed_disk: the identical-outer-bounds crux did not print"
assert selftest.out contains "THICKNESS not REACH" else "inscribed_disk: the thickness-not-reach crux did not print"
assert selftest.out contains "refuses NoForeground" else "inscribed_disk: the NoForeground refusal did not print"

say "inscribed_disk: GREEN -- the largest inscribed disk on metal, the inner bound image/min_enclosing_circle.rye's outer round hole mirrors from the outside. No network, no key, no funds."
