# inference_oven_corpus_rye_dimeroll_prefix_view.rish — Anvil rye + dimeroll/ → Skate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/inference_oven_corpus_rye_dimeroll_prefix_view.rish

let bin = "pond/bin/drawn-terminal"

say "build: Ember corpus rye dimeroll prefix view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for rye dimeroll prefix view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let corpus = run ["sh" "-c" "${bin} corpusryecandyprefixviewtest 2>&1"]
assert corpus.ok else "drawn terminal corpusryecandyprefixviewtest exited non-zero"
assert corpus.out contains "rye dimeroll prefix view" else "rye dimeroll prefix view missing expected output"
assert corpus.out contains "GREEN" else "Anvil rye dimeroll prefix view not GREEN"
assert corpus.out contains "lines=5" else "rye dimeroll prefix view missing five-line frame"

say "GREEN: Ember corpus rye dimeroll prefix view — rye under dimeroll/ on Skate."
