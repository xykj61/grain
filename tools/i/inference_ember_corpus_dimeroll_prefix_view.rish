# inference_oven_corpus_dimeroll_prefix_view.rish -- Anvil dimeroll/ prefix -> Skate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/inference_oven_corpus_dimeroll_prefix_view.rish

let bin = "pond/bin/drawn-terminal"

say "build: Ember corpus dimeroll prefix view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for corpus dimeroll prefix view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let corpus = run ["sh" "-c" "${bin} corpuscandyprefixviewtest 2>&1"]
assert corpus.ok else "drawn terminal corpuscandyprefixviewtest exited non-zero"
assert corpus.out contains "corpus dimeroll prefix view" else "corpus dimeroll prefix view missing expected output"
assert corpus.out contains "GREEN" else "Ember corpus dimeroll prefix view not GREEN"
assert corpus.out contains "lines=5" else "corpus dimeroll prefix view missing five-line frame"

say "GREEN: Ember corpus dimeroll prefix view — dimeroll/ hits compose a Skate frame."
