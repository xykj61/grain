# tools/i/inner_i2_djin_prose.rish -- Inner Scope i2: Twah->Djin prose polish witness.
#
#   rishi/bin/rishi run tools/i/inner_i2_djin_prose.rish

say "inner-i2: Language EN — Twah→Djin prose polish (replies · check-ins)."
say "inner-i2: Style Radiant — GREEN when living doors name Djin, not deleted Twah paths."
say "inner-i2: Lens TAME — filenames may keep Twah stamps; adverts of gone generators refuse."

let polish = run ["sh" "tools/fixtures/inner_i2_djin_prose.sh"]
assert polish.ok else "inner-i2 prose polish RED — see stderr"
assert polish.out contains "GREEN: inner-i2" else "inner-i2 missing GREEN line"
say polish.out

say "GREEN: inner-i2 — Twah→Djin prose polish complete; gen_gren still GREEN."
