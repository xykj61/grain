# tools/i/inference_anvil_corpus_path_suffix_view.rish -- accrete shim -> tools/i/inference_ember_corpus_path_suffix_view.rish (Kiln Season o1)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/i/inference_ember_corpus_path_suffix_view.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/i/inference_ember_corpus_path_suffix_view.rish" args[0]]
if r.out != "" then say r.out
exit r.code
