# tools/tally_glow_tend_a1_gate_bound_witness.rish — Ashvini a1: the deciding gate (e210).
#
#   rishi/bin/rishi run tools/tally_glow_tend_a1_gate_bound_witness.rish

say "a1-bound: Language EN — the first conditional Tend gate (STOA331)."
say "a1-bound: Style Radiant — the garden wall of eight, decided in Glow."
say "a1-bound: Lens TAME — both sides witnessed; the malformed plant must refuse."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-tally-garden-bound-u32.glow"

say "a1-bound: within the wall (3) answers 1..."
let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "3"]
assert ok.ok else "a1-bound: accept side failed to run"
assert ok.out contains "EXIT:0" else "a1-bound: accept side did not exit 0"
assert ok.out contains "1" else "a1-bound: accept side did not speak 1"

say "a1-bound: past the wall (9) answers 0..."
let over = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "9"]
assert over.ok else "a1-bound: over side failed to run"
assert over.out contains "EXIT:0" else "a1-bound: over side did not exit 0"
assert over.out contains "0" else "a1-bound: over side did not speak 0"

say "a1-bound: the missing-arm plant must refuse (guards that can red)..."
let plant = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" "tools/fixtures/gate-count-u32.glow" "3"]
assert plant.err contains "MalformedBody" else "a1-bound: malformed plant was accepted — the grammar wall fell"

say "a1-bound: dec neighbor still green..."
let dec = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" "src/lib/gate-tally-dec-u32.glow" "21"]
assert dec.ok else "a1-bound: dec regression failed"
assert dec.out contains "EXIT:0" else "a1-bound: dec did not exit 0"

say "GREEN: a1 bound gate — decides on both sides; the plant refuses; neighbors stand."
