# tools/glow_tend_a2_suite.rish — Ashvini a2 folding suite (e246).
#
#   rishi/bin/rishi run tools/glow_tend_a2_suite.rish

say "a2-suite: Language EN — gates that fold, one lap."
say "a2-suite: Lens TAME — sumto · pair · prodto · N-sum; plants refuse."

say "a2-suite 1/4: sumto (STOA332)..."
let sumto = run ["rishi/bin/rishi" "run" "tools/tally_glow_tend_a2_gate_fold_witness.rish"]
assert sumto.ok else "a2-suite: sumto RED"
say "a2-suite 1/4 GREEN."

say "a2-suite 2/4: pair-sum (STOA333)..."
let pair = run ["rishi/bin/rishi" "run" "tools/tally_glow_tend_a2_gate_pair_sum_witness.rish"]
assert pair.ok else "a2-suite: pair-sum RED"
say "a2-suite 2/4 GREEN."

say "a2-suite 3/4: prodto (STOA334 — verb is a name)..."
let prod = run ["rishi/bin/rishi" "run" "tools/tally_a2_fold_prodto_witness.rish"]
assert prod.ok else "a2-suite: prodto RED"
say "a2-suite 3/4 GREEN."

say "a2-suite 4/4: N-sum widen (STOA335 — triple then n)..."
let nsum = run ["rishi/bin/rishi" "run" "tools/tally_a2_fold_n_sum_witness.rish"]
assert nsum.ok else "a2-suite: N-sum RED"
say "a2-suite 4/4 GREEN."

say "GREEN: a2 suite — four folding faces; the list fold widens with the shape."
