# collision_guard.rish — print every name hit with two lines of context.
#
# Practice companion to context/specs/collision-guard.md.
# Never truncates. Always reprints the three required sweeps.
#
#   rishi/bin/rishi run tools/collision_guard.rish NAME
#
# Searcher seam (accreted 20260729.201200): ripgrep when the host has it,
# POSIX grep -rn when it does not. A fresh cloud raise ships no `rg`, and the
# elder body failed hard there — so the one tool this house built to catch a
# colliding name could not run on the bench that most needs it. Same output
# discipline either way: every hit, two lines of context, never truncated.

assert length args != 0 else "usage: rishi run tools/collision_guard.rish NAME"
let name = args[0]

let probe = run ["sh" "-c" "command -v rg >/dev/null 2>&1 && echo HAVE_RG || echo NO_RG"]
assert probe.ok else "collision-guard: searcher probe failed"
let have_rg = probe.out contains "HAVE_RG"

if have_rg then say "collision-guard: searcher rg"
if have_rg == false then say "collision-guard: searcher grep (rg absent on this host)"
say "collision-guard: searching owned surfaces for '${name}' (every hit, -C 2)…"

let excl = "--exclude-dir=gratitude --exclude-dir=external-research --exclude-dir=yonder --exclude-dir=vendor --exclude-dir=archive --exclude-dir=.git"

let tree_rg = "rg -n -C 2 --glob '!gratitude/**' --glob '!external-research/**' --glob '!yonder/**' --glob '!vendor/**' --glob '!archive/**' --glob '!.git/**' -i -- '${name}' ."
let tree_gp = "grep -rn -C 2 -i ${excl} -- '${name}' ."
let tree_cmd = tree_gp
if have_rg then let tree_cmd = tree_rg

let tree = run ["sh" "-c" tree_cmd]
say tree.out
if tree.ok == false then say "(searcher exit non-zero — usually zero matches; required sweeps still print)"

say "collision-guard: required sweep — crux/ready-to-ask-claude.md"
let rtac = run ["sh" "-c" "grep -n -C 2 -i -- '${name}' crux/ready-to-ask-claude.md"]
say rtac.out
if rtac.ok == false then say "(no hits in RTAC)"

say "collision-guard: required sweep — context/specs/reserved-vocabulary.md"
let reserved = run ["sh" "-c" "grep -n -C 2 -i -- '${name}' context/specs/reserved-vocabulary.md"]
say reserved.out
if reserved.ok == false then say "(no hits in reserved-vocabulary)"

say "collision-guard: required sweep — context/LEXICON.md"
let lexicon = run ["sh" "-c" "grep -n -C 2 -i -- '${name}' context/LEXICON.md"]
say lexicon.out
if lexicon.ok == false then say "(no hits in LEXICON)"

say "collision-guard: classify each hit as teacher-quote / prose-verb / park; record the list in the seating spec."
say "GREEN: collision-guard printed every hit (classification is the human gate)."
