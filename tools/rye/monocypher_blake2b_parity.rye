//! tools/rye/monocypher_blake2b_parity.rye -- our authored crypto/blake2b.rye asked for its OWN BLAKE2b-512 over the four canonical messages, printed
//! one 128-hex-character digest per line, so tools/cr/crypto_monocypher_parity_witness.rish can diff our bytes against the vendored Monocypher's C
//! (tools/fixtures/monocypher_blake2b_harness.c) byte-for-byte. Season G (Cryptography - Rye-native, Monocypher-parity, audit-ready).
//!
//! The four messages are EXACTLY the four crypto/blake2b.rye's own selftest proves our Rye against Zig's std.crypto over -- the empty message, the
//! ASCII string "abc", one full 128-byte block (byte i = i & 0xff), and a 200-byte multi-block input (byte i = (i*7 + 1) & 0xff) -- so the parity
//! witness compares like against like: our Rye output and Monocypher's C output over identical inputs, must agree hex for hex.
//!
//! This authors NO cryptography -- it is a printing harness over the GREEN crypto/blake2b.rye (reached through the tools/rye/blake2b.rye symlink, since
//! Rye resolves imports beside the importing file). Purely local -- no key, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_blake2b_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const b2 = @import("blake2b.rye");

/// The largest canonical message this harness prints, so the working buffer is bounded at construction rather than growing per call.
const max_canonical_bytes: u32 = 200;

/// print_digest -- render one BLAKE2b-512 digest of `msg` as a line of 128 lowercase hex characters.
fn print_digest(msg: []const u8) !void {
    // invariant (precondition): every canonical message fits the module's stated ceiling, so no print exceeds the bound the buffer is sized for.
    assert(msg.len <= max_canonical_bytes);
    const digest = try b2.hash512(msg);
    const hex = b2.to_hex(digest);
    // invariant (postcondition): a BLAKE2b-512 digest always renders to exactly the fixed hex width -- two characters per digest byte.
    assert(hex.len == b2.hex_len);
    print("{s}\n", .{hex});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // 1. The empty message.
    try print_digest("");

    // 2. "abc" -- the RFC 7693 Appendix A known-answer.
    try print_digest("abc");

    // 3. Exactly one full 128-byte block: byte i = i & 0xff.
    var one_block: [128]u8 = undefined;
    var i: u32 = 0;
    // invariant: the block fills exactly its declared width before it is hashed, leaving no undefined byte in the digest input.
    while (i < 128) : (i += 1) one_block[i] = @as(u8, @truncate(i));
    try print_digest(&one_block);

    // 4. A 200-byte multi-block input: byte i = (i*7 + 1) & 0xff.
    var multi: [200]u8 = undefined;
    i = 0;
    // invariant: the multi-block buffer fills exactly its declared width before it is hashed.
    while (i < 200) : (i += 1) multi[i] = @as(u8, @truncate(i *% 7 +% 1));
    try print_digest(&multi);

    return 0;
}
