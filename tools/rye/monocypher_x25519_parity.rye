//! tools/rye/monocypher_x25519_parity.rye — our authored crypto/x25519.rye asked for its OWN X25519 public keys and shared secrets over RFC 7748
//! §6.1's Alice/Bob key exchange, printed one 64-hex-character value per line, so tools/cr/crypto_monocypher_x25519_parity_witness.rish can diff our
//! bytes against the vendored Monocypher's C (tools/fixtures/monocypher_x25519_harness.c) byte-for-byte — the key agreement the Kumara sealed door
//! (crypto/kumara_sealed.rye) rests on, proven against the audit's parity target. Season G (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//!
//! The two private scalars are RFC 7748 §6.1's own published Alice and Bob keys. The four printed lines are, in order: Alice's public key
//! (x25519_base(alice)), Bob's public key (x25519_base(bob)), the shared secret from Alice's side (x25519(alice, bob_pub)), and the shared secret
//! from Bob's side (x25519(bob, alice_pub)) — so the parity witness compares like against like over identical inputs.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/x25519.rye (reached through the tools/rye/x25519.rye and
//! tools/rye/fe25519.rye symlinks, since Rye resolves imports beside the importing file). Both our x25519 and Monocypher clamp the scalar internally
//! per RFC 7748 §5, so each is fed the raw published scalar. Purely local — no key of ours, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_x25519_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const x = @import("x25519.rye");

/// RFC 7748 §6.1 Alice private scalar (raw; x25519 clamps internally).
const alice_priv = [_]u8{
    0x77, 0x07, 0x6d, 0x0a, 0x73, 0x18, 0xa5, 0x7d, 0x3c, 0x16, 0xc1, 0x72, 0x51, 0xb2, 0x66, 0x45,
    0xdf, 0x4c, 0x2f, 0x87, 0xeb, 0xc0, 0x99, 0x2a, 0xb1, 0x77, 0xfb, 0xa5, 0x1d, 0xb9, 0x2c, 0x2a,
};

/// RFC 7748 §6.1 Bob private scalar (raw; x25519 clamps internally).
const bob_priv = [_]u8{
    0x5d, 0xab, 0x08, 0x7e, 0x62, 0x4a, 0x8a, 0x4b, 0x79, 0xe1, 0x7f, 0x8b, 0x83, 0x80, 0x0e, 0xe6,
    0x6f, 0x3b, 0xb1, 0x29, 0x26, 0x18, 0xb6, 0xfd, 0x1c, 0x2f, 0x8b, 0x27, 0xff, 0x88, 0xe0, 0xeb,
};

const hex_alphabet = "0123456789abcdef";

/// print_bytes — render a 32-byte X25519 value as a line of 64 lowercase hex characters.
fn print_bytes(b: *const [32]u8) void {
    var out: [64]u8 = undefined;
    var i: u32 = 0;
    // invariant: each of the 32 bytes renders to exactly two hex characters, filling the 64-character line exactly.
    while (i < 32) : (i += 1) {
        out[i * 2] = hex_alphabet[b[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[b[i] & 0x0f];
    }
    // invariant (postcondition): the rendered line is the fixed 64-character width — a full 32-byte value, never a truncation.
    assert(out.len == 64);
    print("{s}\n", .{out});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // invariant (construction): both published scalars are the fixed 32-byte X25519 width.
    assert(alice_priv.len == 32 and bob_priv.len == 32);

    // 1. Alice's public key: base·alice.
    const alice_pub = x.x25519_base(&alice_priv);
    print_bytes(&alice_pub);

    // 2. Bob's public key: base·bob.
    const bob_pub = x.x25519_base(&bob_priv);
    print_bytes(&bob_pub);

    // 3. Shared secret from Alice's side: x25519(alice, bob_pub).
    const shared_ab = x.x25519(&alice_priv, &bob_pub);
    print_bytes(&shared_ab);

    // 4. Shared secret from Bob's side: x25519(bob, alice_pub).
    const shared_ba = x.x25519(&bob_priv, &alice_pub);
    print_bytes(&shared_ba);

    return 0;
}
