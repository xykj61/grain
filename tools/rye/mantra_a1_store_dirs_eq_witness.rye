//! tools/rye/mantra_a1_store_dirs_eq_witness.rye — Ashvini equality: exact 3 (STOA337).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/mantra_a1_store_dirs_eq_witness.rye
//!
//! gth speaks ceilings. eq speaks exactly. A Store holds exactly three
//! directory handles (root · mantra · blobs) — the eighth pedestal, the last
//! that could not decide until this rune. The arc closes here in Rye.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const desk = "src/lib/gate-mantra-store-dirs-eq-u32.glow";
const neighbor = "src/lib/gate-mantra-gen-floor-u32.glow";
const max_worker_out_bytes: u32 = 4096; // one small answer plus an EXIT marker
const max_desk_bytes: u32 = 4096; // a desk is a dozen short lines

// Invariant: the worker exits cleanly for every lawful sample; its stdout
// carries the gate's answer and an EXIT:<code> marker.
fn run_gate(a: std.mem.Allocator, io: std.Io, desk_path: []const u8, sample: []const u8) ![]u8 {
    assert(desk_path.len > 0);
    assert(sample.len > 0);
    const result = try std.process.run(a, io, .{
        .argv = &.{ "env", "RYE_ZIG=vendor/zig-toolchain/zig", "sh", "tools/g/glow_run_worker.sh", desk_path, sample },
        .stdout_limit = .limited(max_worker_out_bytes),
    });
    const code: u8 = switch (result.term) {
        .exited => |c| c,
        else => 255,
    };
    assert(code == 0); // invariant: the worker ran the desk to completion
    assert(result.stdout.len > 0); // invariant: the gate spoke an answer
    return result.stdout;
}

fn contains(hay: []const u8, needle: []const u8) bool {
    return std.mem.indexOf(u8, hay, needle) != null;
}

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;

    print("eq-store: Language EN — the eighth exact deciding gate — the last (STOA337).\n", .{});
    print("eq-store: Lens TAME — exact match; both sides; gth neighbor still stands.\n", .{});

    print("eq-store: exact 3 answers 1...\n", .{});
    const exact_out = try run_gate(a, io, desk, "3");
    assert(contains(exact_out, "EXIT:0"));
    assert(contains(exact_out, "1"));

    print("eq-store: just under (2) answers 0...\n", .{});
    const under_out = try run_gate(a, io, desk, "2");
    assert(contains(under_out, "0"));

    print("eq-store: just over (4) answers 0...\n", .{});
    const over_out = try run_gate(a, io, desk, "4");
    assert(contains(over_out, "0"));

    print("eq-store: the desk names eq, not gth...\n", .{});
    const desk_text = try std.Io.Dir.cwd().readFileAlloc(io, desk, a, .limited(max_desk_bytes));
    assert(contains(desk_text, "\n?:  (eq ")); // positive space: the rune we mean
    assert(!contains(desk_text, "\n?:  (gth ")); // negative space: the rune we left

    print("eq-store: gth neighbor (mantra gen floor) still green...\n", .{});
    const gth_out = try run_gate(a, io, neighbor, "1");
    assert(contains(gth_out, "1"));

    print("GREEN: equality eighth — store dirs=3 decide exactly; gth still stands; the arc closes 8/8.\n", .{});
    return 0;
}
