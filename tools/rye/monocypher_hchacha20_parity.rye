//! tools/rye/monocypher_hchacha20_parity.rye — our authored crypto/xchacha20.rye asked for its OWN HChaCha20 subkey over the same six inputs the
//! Monocypher C harness (tools/fixtures/monocypher_hchacha20_harness.c) prints, so tools/cr/crypto_monocypher_hchacha20_parity_witness.rish can
//! diff our bytes against the vendored Monocypher's C byte-for-byte — the nonce-extension core the whole XChaCha line folds through, proven
//! against the audit's parity target. Season G (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//!
//! crypto/xchacha20.rye proved HChaCha20 against the draft §2.2.1 known-answer and inside the AEAD flagship, yet never STANDALONE against
//! Monocypher's own crypto_chacha20_h; this harness lets the witness close it. Six lines print, in order: the draft-irtf-cfrg-xchacha-03
//! §2.2.1 published HChaCha20 subkey (the canonical known-answer), then HChaCha20 subkeys over five deterministic (key, input) pairs — each
//! key byte i generated as (i*7 + 1 + j*13) mod 256 and each input byte i as (i*11 + 3 + j*5) mod 256 for line j.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/xchacha20.rye (reached through the tools/rye/xchacha20.rye
//! symlink, since Rye resolves imports beside the importing file). Purely local — no key of ours, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_hchacha20_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const x = @import("xchacha20.rye");

const hex_alphabet = "0123456789abcdef";

/// draft-irtf-cfrg-xchacha-03 §2.2.1 key 00 01 02 ... 1f — a public test vector, never a real secret.
const draft_key = [x.key_bytes]u8{
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
};

/// draft §2.2.1 16-byte input.
const draft_input = [16]u8{ 0x00, 0x00, 0x00, 0x09, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00, 0x31, 0x41, 0x59, 0x27 };

/// print_bytes — render n bytes as 2n lowercase hex characters, one line.
fn print_bytes(b: []const u8) void {
    // invariant: the rendered span fits the fixed hex buffer — two hex characters per byte, bounded by the 32-byte subkey.
    assert(b.len <= 32);
    var out: [64]u8 = undefined;
    var i: u32 = 0;
    while (i < b.len) : (i += 1) {
        out[i * 2] = hex_alphabet[b[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[b[i] & 0x0f];
    }
    const n: u32 = @as(u32, @intCast(b.len)) * 2;
    print("{s}\n", .{out[0..n]});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // invariant (construction): the key and input are HChaCha20's fixed widths.
    assert(draft_key.len == x.key_bytes and draft_input.len == 16);

    // 1. draft §2.2.1 published HChaCha20 known-answer.
    const sk0 = x.hchacha20(&draft_key, &draft_input);
    print_bytes(&sk0);

    // 2..6. HChaCha20 subkeys over five deterministic (key, input) pairs — key byte i = (i*7 + 1 + j*13) mod 256, input byte i = (i*11 + 3 + j*5) mod 256.
    var j: u32 = 0;
    while (j < 5) : (j += 1) {
        var key: [x.key_bytes]u8 = undefined;
        var input: [16]u8 = undefined;
        var i: u32 = 0;
        while (i < x.key_bytes) : (i += 1) key[i] = @as(u8, @truncate(i *% 7 +% 1 +% j *% 13));
        i = 0;
        while (i < 16) : (i += 1) input[i] = @as(u8, @truncate(i *% 11 +% 3 +% j *% 5));

        const sk = x.hchacha20(&key, &input);
        print_bytes(&sk);
    }

    return 0;
}
