//! tools/rye/monocypher_blake2b_keyed_parity.rye -- our authored crypto/blake2b.rye asked for its OWN KEYED BLAKE2b (hash_keyed) over six
//! (output-length, key, message) triples, printed one 2*out_len-hex-character digest per line, so
//! tools/cr/crypto_monocypher_blake2b_keyed_parity_witness.rish can diff our bytes against the vendored Monocypher's C
//! (tools/fixtures/monocypher_blake2b_keyed_harness.c) byte-for-byte. Season G (Cryptography - Rye-native, Monocypher-parity, audit-ready).
//!
//! The BLAKE2b rungs so far prove only the UNKEYED hash (full digest and variable length); this harness exercises crypto/blake2b.rye's
//! hash_keyed -- the keyed MAC mode, a message tag no one without the key can forge -- at output lengths 64/64/32/16/48/64 under keys of
//! length 64/8/32/64/10/1. The six triples, in order: (64, full 64-byte key, "abc"); (64, "keybytes", ""); (32, a 32-byte key, a 200-byte
//! multi-block input); (16, the full key, the fox pangram); (48, "hemp-linen", one full 128-byte block); (64, a one-byte key, "abc"). Both
//! harnesses feed the identical triples, so the parity compares like against like: our Rye output and Monocypher's C output over identical
//! (output-length, key, message) inputs, must agree hex for hex.
//!
//! This authors NO cryptography -- it is a printing harness over the GREEN crypto/blake2b.rye (reached through the tools/rye/blake2b.rye symlink,
//! since Rye resolves imports beside the importing file). Purely local -- no key of ours, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_blake2b_keyed_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const b2 = @import("blake2b.rye");

/// The largest canonical message this harness prints, so the working buffer is bounded at construction rather than growing per call.
const max_canonical_bytes: u32 = 200;

/// BLAKE2b carries its output length in one parameter byte, so a variable digest is meaningful only for 1..64 bytes.
const max_out_bytes: u32 = 64;

/// BLAKE2b carries its key length in one parameter byte and folds the key through one block, so a key spans 0..64 bytes.
const max_key_bytes: u32 = 64;

/// The lowercase hex alphabet, so a variable-length digest renders without reaching for to_hex (which fixes the 64-byte case alone).
const hex_alphabet = "0123456789abcdef";

/// print_keyed_digest -- render one keyed BLAKE2b digest of `msg` under `key` as a line of 2*out_len lowercase hex characters.
fn print_keyed_digest(out_len: u32, key: []const u8, msg: []const u8) !void {
    // invariant (precondition): the requested digest fits BLAKE2b's 1..64-byte output range.
    assert(out_len >= 1 and out_len <= max_out_bytes);
    // invariant (precondition): the key fits BLAKE2b's 0..64-byte key range.
    assert(key.len <= max_key_bytes);
    // invariant (precondition): every canonical message fits the module's stated ceiling, so no hash exceeds the bound the buffer is sized for.
    assert(msg.len <= max_canonical_bytes);
    var out: [max_out_bytes]u8 = undefined;
    try b2.hash_keyed(out[0..out_len], key, msg);
    var i: u32 = 0;
    while (i < out_len) : (i += 1) {
        const byte = out[i];
        print("{c}{c}", .{ hex_alphabet[byte >> 4], hex_alphabet[byte & 0x0f] });
    }
    // invariant (postcondition): the whole requested digest was rendered, two hex characters per byte.
    assert(i == out_len);
    print("\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // A full 64-byte key (byte i = i & 0xff), the standard BLAKE2 keyed-test-vector key shape.
    var full_key: [64]u8 = undefined;
    var i: u32 = 0;
    // invariant: the key fills exactly its declared width before it is used, leaving no undefined byte in the parameter block.
    while (i < 64) : (i += 1) full_key[i] = @as(u8, @truncate(i));

    // A 32-byte key (byte i = (i*3 + 5) & 0xff).
    var mid_key: [32]u8 = undefined;
    i = 0;
    while (i < 32) : (i += 1) mid_key[i] = @as(u8, @truncate(i *% 3 +% 5));

    // A 200-byte multi-block message (byte i = (i*7 + 1) & 0xff).
    var multi: [200]u8 = undefined;
    i = 0;
    while (i < 200) : (i += 1) multi[i] = @as(u8, @truncate(i *% 7 +% 1));

    // One full 128-byte block (byte i = i & 0xff).
    var one_block: [128]u8 = undefined;
    i = 0;
    while (i < 128) : (i += 1) one_block[i] = @as(u8, @truncate(i));

    // A one-byte key of 0x00 -- the key-length parameter byte at its smallest non-zero value.
    const one_byte_key = [_]u8{0x00};

    // 1. (64, full 64-byte key, "abc") -- full key, full tag.
    try print_keyed_digest(64, &full_key, "abc");

    // 2. (64, "keybytes", "") -- short key, empty message; the key block is the final block.
    try print_keyed_digest(64, "keybytes", "");

    // 3. (32, 32-byte key, a 200-byte multi-block input) -- key block, one full message block, a partial final block.
    try print_keyed_digest(32, &mid_key, &multi);

    // 4. (16, full 64-byte key, the fox pangram) -- a 128-bit tag under a full key.
    try print_keyed_digest(16, &full_key, "The quick brown fox jumps over the lazy dog");

    // 5. (48, "hemp-linen", one full 128-byte block) -- a 384-bit tag, message exactly one block.
    try print_keyed_digest(48, "hemp-linen", &one_block);

    // 6. (64, one-byte key 0x00, "abc") -- the key-length parameter byte at its smallest non-zero value.
    try print_keyed_digest(64, &one_byte_key, "abc");

    return 0;
}
