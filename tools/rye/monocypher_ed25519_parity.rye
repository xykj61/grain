//! tools/rye/monocypher_ed25519_parity.rye — our authored crypto/ed25519_sign.rye asked for its OWN Ed25519 public key and signatures, printed one
//! lowercase-hex value per line, so tools/cr/crypto_monocypher_ed25519_parity_witness.rish can diff our bytes against the vendored Monocypher's C
//! (tools/fixtures/monocypher_ed25519_harness.c) byte-for-byte — the SIGNING primitive the Lotus signed carry (and every Kumara-signed record)
//! rests on, proven against the audit's parity target. Season G (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//!
//! The seed is RFC 8032 §7.1 TEST 2's own published secret key. The three printed lines are, in order: the public key derived from the seed
//! (derive_public), the signature over the 1-byte message 0x72 (RFC 8032 §7.1 TEST 2's published message), and the signature over a longer
//! deterministic message ("grain crypto parity"), which exercises the multi-block message path — so the parity witness compares like against like
//! over identical inputs.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/ed25519_sign.rye (reached through sibling symlinks in tools/,
//! since Rye resolves imports beside the importing file). Signing is deterministic per RFC 8032. Purely local — it signs only a TEST seed: no key
//! of ours, no network, no funds, no device; signing with the maintainer's own identity key stays its own gated round.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_ed25519_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const ed = @import("ed25519_sign.rye");

/// RFC 8032 §7.1 TEST 2 secret key (seed).
const seed = [_]u8{
    0x4c, 0xcd, 0x08, 0x9b, 0x28, 0xff, 0x96, 0xda, 0x9d, 0xb6, 0xc3, 0x46, 0xec, 0x11, 0x4e, 0x0f,
    0x5b, 0x8a, 0x31, 0x9f, 0x35, 0xab, 0xa6, 0x24, 0xda, 0x8c, 0xf6, 0xed, 0x4f, 0xb8, 0xa6, 0xfb,
};

/// RFC 8032 §7.1 TEST 2 message: a single byte, 0x72.
const msg_rfc = [_]u8{0x72};

/// A longer deterministic message, exercising the multi-block SHA-512 message path beyond the 1-byte RFC vector.
const msg_long = "grain crypto parity";

const hex_alphabet = "0123456789abcdef";

/// print_bytes — render an n-byte value as a line of 2·n lowercase hex characters (n ≤ 64: a public key or a signature).
fn print_bytes(b: []const u8) void {
    // invariant (construction): the value fits the fixed 128-character line buffer — a signature (64 bytes) is the widest value printed.
    assert(b.len <= 64);
    var out: [128]u8 = undefined;
    var i: u32 = 0;
    // invariant: each byte renders to exactly two hex characters, filling the line's used span exactly.
    while (i < b.len) : (i += 1) {
        out[i * 2] = hex_alphabet[b[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[b[i] & 0x0f];
    }
    // invariant (postcondition): exactly 2·len characters were rendered, never a truncation.
    assert(i == b.len);
    print("{s}\n", .{out[0 .. b.len * 2]});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // invariant (construction): the published seed is the fixed 32-byte Ed25519 width.
    assert(seed.len == 32);

    // 1. Public key derived from the seed.
    const public_key = ed.derive_public(&seed);
    print_bytes(&public_key);

    // 2. Signature over the RFC 8032 §7.1 TEST 2 message (0x72).
    const sig_rfc = try ed.sign(&seed, &msg_rfc);
    print_bytes(&sig_rfc);

    // 3. Signature over the longer deterministic message.
    const sig_long = try ed.sign(&seed, msg_long);
    print_bytes(&sig_long);

    return 0;
}
