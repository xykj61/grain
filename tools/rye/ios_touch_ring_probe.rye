//! tools/rye/ios_touch_ring_probe.rye -- a real finger, the platform's own dispatch, and the
//! proven ring: the iOS twin story closes.
//!
//! Rung: LOCA -- the finger the ring admits (20260829.111001)
//!
//! WHY THIS PROBE EXISTS. Movement two fed macOS keys and mouse through the event ring; the iOS
//! twin wants fingers. UITouch cannot be constructed publicly and iOS posts no synthetic events
//! into a process's own queue, so the honest road is the real one: this probe is a full
//! application -- UIApplicationMain, a Rye delegate, a UIWindow with a root controller whose
//! view is the runtime-registered GrainRyeTouchView -- and a REAL tap, delivered through the
//! simulator's own input road (the bench's simulator panel, or a hand), arrives as
//! touchesBegan:withEvent: and touchesEnded:withEvent: dispatched by the platform into Rye,
//! is translated to the domain event's touch kinds, and crosses the same ring every refusal
//! already proved.
//!
//! WHAT IT PROVES, on metal, inside iOS: the registered view receives the platform's own touch
//! dispatch (this probe never sends its handlers); the seated domain event's new touch kinds
//! carry a real location; the ring preserves order under platform feeding (touch_down drains
//! before touch_up, whole); and the probe closes itself shortly after the touch, or refuses
//! honestly at its deadline if no finger ever arrives -- a waiting probe is bounded too.
//!
//! WHAT IT DOES NOT PROVE. Multi-touch, gestures, moved/cancelled phases, or pressure -- their
//! own rungs. And nothing here is a witness a bare script can rerun alone: the tap is a real
//! input a hand or the panel supplies, and the header says so rather than pretending.
//!
//! BOTH SIDES. The no-touch deadline is the refusing leg a bounded interactive probe owns
//! (exit 2, REFUSED on the console), and PROBE_PROVE_RED keeps the seam's gate at exit 134.
//!
//! Build (the iOS recipe), pack per the shell witness's bundle shape, install, launch, tap:
//!   rishi/bin/rishi run tools/i/ios_app_shell_witness.rish   # the recipe's reference
//!   xcrun simctl launch --console booted ww.grain.touch.ios

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const c = std.c;

const objc = @import("objc_seam.rye");
const ring_mod = @import("skate_event_ring.rye");
const input = @import("skate_input_event.rye");

pub extern fn UIApplicationMain(argc: c_int, argv: ?[*][*:0]u8, principal: ?objc.Id, delegate_name: ?objc.Id) c_int;

const delegate_class_name = "GrainRyeTouchDelegate";
const view_class_name = "GrainRyeTouchView";
const did_finish_types = "B@:@@";
const close_types = "v@:@";
const touch_types = "v@:@@";

// The bounded waits: a probe that needs a finger still ends -- shortly after the touch, or
// refusing at the deadline if none arrives.
const close_after_touch_seconds: f64 = 0.8;
const no_touch_deadline_seconds: f64 = 25.0;

const SendPerformAfter = *const fn (objc.Id, objc.Sel, objc.Sel, ?objc.Id, f64) callconv(.c) void;
const SendRectInit = *const fn (objc.Id, objc.Sel, objc.CGRect) callconv(.c) ?objc.Id;
const SendRect = *const fn (objc.Id, objc.Sel) callconv(.c) objc.CGRect;
const SendIdArg = *const fn (objc.Id, objc.Sel, ?objc.Id) callconv(.c) void;
const SendPointInView = *const fn (objc.Id, objc.Sel, ?objc.Id) callconv(.c) objc.CGPoint;

// The window waits this long for the platform to connect its scene: on iOS 26 a window without
// a windowScene never joins the display or the hit-testing hierarchy -- the black screen that
// taught this rung its second lesson -- and scenes connect only after launch returns.
const scene_wait_seconds: f64 = 0.4;

var ring = ring_mod.EventRing(input.InputEvent).init();
var admitted: u32 = 0;
var closed = false;
var launch_seen = false;
var delegate_ref: ?objc.Id = null;
var close_sel: objc.Sel = undefined;
var sel_any_object: objc.Sel = undefined;
var sel_location_in_view: objc.Sel = undefined;

/// Translate one platform touch to the seated domain event and admit it through the ring's own
/// walls -- the same admit shape movement two proved, with a finger where a key was.
fn admit_touch(kind: input.InputKind, touches: objc.Id, view: objc.Id) void {
    // invariant: the platform hands a real touch set and view.
    assert(@intFromPtr(touches) != 0);
    assert(@intFromPtr(view) != 0);
    const touch = objc.send(objc.SendId)(touches, sel_any_object) orelse {
        @panic("touch ring: the platform's touch set held nothing");
    };
    const at = objc.send(SendPointInView)(touch, sel_location_in_view, view);
    const event = input.make(kind, 0, @intFromFloat(at.x), @intFromFloat(at.y));
    ring.append(event) catch |err| {
        // invariant: the only refusal admission can answer is the named Full.
        assert(err == ring_mod.RingError.Full);
        @panic("touch ring: the ring refused inside the probe's own budget");
    };
    // invariant: the admitted count stays inside its named width.
    assert(admitted < std.math.maxInt(u32));
    admitted += 1;
    print("ios-touch-ring: admitted kind={d} at=({d},{d})\n", .{ @intFromEnum(kind), event.x_points, event.y_points });
}

fn touches_began(self: objc.Id, sel: objc.Sel, touches: objc.Id, event: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = event;
    // invariant: the platform hands the receiver it registered.
    assert(@intFromPtr(self) != 0);
    admit_touch(.touch_down, touches, self);
}

fn touches_moved(self: objc.Id, sel: objc.Sel, touches: objc.Id, event: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = event;
    // invariant: the platform hands the receiver it registered.
    assert(@intFromPtr(self) != 0);
    admit_touch(.touch_moved, touches, self);
}

/// The honest cancellation road: the system cancels a drag when another application takes the
/// screen mid-touch -- a real interruption, never a fake -- so this handler both admits the
/// cancelled phase and schedules the close, exactly as a lift does.
fn touches_cancelled(self: objc.Id, sel: objc.Sel, touches: objc.Id, event: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = event;
    // invariant: the platform hands the receiver it registered.
    assert(@intFromPtr(self) != 0);
    admit_touch(.touch_cancelled, touches, self);
    if (delegate_ref) |delegate| {
        objc.send(SendPerformAfter)(delegate, objc.sel_registerName("performSelector:withObject:afterDelay:"), close_sel, null, close_after_touch_seconds);
    }
}

fn touches_ended(self: objc.Id, sel: objc.Sel, touches: objc.Id, event: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = event;
    // invariant: the platform hands the receiver it registered.
    assert(@intFromPtr(self) != 0);
    admit_touch(.touch_up, touches, self);
    // The finger has lifted; the close rides the platform's timer from here.
    if (delegate_ref) |delegate| {
        objc.send(SendPerformAfter)(delegate, objc.sel_registerName("performSelector:withObject:afterDelay:"), close_sel, null, close_after_touch_seconds);
    }
}

/// The close: drain the ring, judge the crossing, and end -- GREEN after a real finger, REFUSED
/// at the deadline if none came.
fn close_probe(self: objc.Id, sel: objc.Sel, argument: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = argument;
    // invariant: the platform hands the delegate it holds.
    assert(@intFromPtr(self) != 0);
    if (closed) return;
    closed = true;
    if (admitted < 3) {
        print("ios-touch-ring: REFUSED -- the deadline passed with {d} admissions; no dragging finger arrived.\n", .{admitted});
        std.process.exit(2);
    }
    // The drain: one down, at least one moved between, one up -- the platform's own phase
    // order surviving the ring whole, which only a real drag satisfies.
    const down = ring.remove_first() orelse @panic("touch ring: the drain found an empty ring");
    // invariant: the finger lands before anything else.
    assert(down.kind == input.InputKind.touch_down);
    var moved_count: u32 = 0;
    var last = ring.remove_first() orelse @panic("touch ring: the drain found one event only");
    while (last.kind == input.InputKind.touch_moved) {
        moved_count += 1;
        last = ring.remove_first() orelse @panic("touch ring: the drag never lifted");
    }
    // invariant: a drag ends exactly two ways -- the finger lifts, or the platform cancels;
    // the phases between are moves and nothing else.
    assert(last.kind == input.InputKind.touch_up or last.kind == input.InputKind.touch_cancelled);
    // invariant: a drag moves at least once -- the rung's own claim.
    assert(moved_count >= 1);
    // invariant: the ring drained whole.
    assert(ring.is_empty());
    if (last.kind == input.InputKind.touch_up) {
        // invariant: a completed drag travels -- the lift stands apart from the landing.
        assert(down.x_points != last.x_points or down.y_points != last.y_points);
        print("ios-touch-ring: drained down=({d},{d}) moved={d} up=({d},{d}) in order\n", .{ down.x_points, down.y_points, moved_count, last.x_points, last.y_points });
        print("ios-touch-ring: GREEN -- a real drag crossed the platform's dispatch, all phases in order, through the proven ring.\n", .{});
    } else {
        print("ios-touch-ring: drained down=({d},{d}) moved={d} CANCELLED=({d},{d}) in order\n", .{ down.x_points, down.y_points, moved_count, last.x_points, last.y_points });
        print("ios-touch-ring: GREEN -- the platform cancelled a real drag mid-flight and the cancellation crossed the ring in order; the eighth door is walked.\n", .{});
    }
    std.process.exit(0);
}

var build_window_sel: objc.Sel = undefined;

fn did_finish_launching(self: objc.Id, sel: objc.Sel, application: objc.Id, options: ?objc.Id) callconv(.c) bool {
    _ = sel;
    _ = options;
    _ = application;
    // invariant: the platform hands the delegate it instantiated.
    assert(@intFromPtr(self) != 0);
    // invariant: launch arrives once.
    assert(!launch_seen);
    launch_seen = true;
    delegate_ref = self;

    // Scenes connect only after launch returns, and an iOS 26 window without a windowScene
    // never joins the display -- so the window builds a beat later, on the platform's timer,
    // and the refusing deadline rides from here regardless.
    objc.send(SendPerformAfter)(self, objc.sel_registerName("performSelector:withObject:afterDelay:"), build_window_sel, null, scene_wait_seconds);
    objc.send(SendPerformAfter)(self, objc.sel_registerName("performSelector:withObject:afterDelay:"), close_sel, null, no_touch_deadline_seconds);
    print("ios-touch-ring: launched -- the window waits {d} ms for its scene.\n", .{@as(u32, @intFromFloat(scene_wait_seconds * 1000.0))});
    return true;
}

/// The window, built once the platform has a scene to hang it on: adopt the connected
/// UIWindowScene, seat the registered view under a root controller, and go visible.
fn build_window(self: objc.Id, sel: objc.Sel, argument: ?objc.Id) callconv(.c) void {
    _ = sel;
    _ = argument;
    // invariant: the platform hands the delegate it holds.
    assert(@intFromPtr(self) != 0);

    const app_class = objc.objc_getClass("UIApplication") orelse @panic("touch ring: UIApplication absent");
    const screen_class = objc.objc_getClass("UIScreen") orelse @panic("touch ring: UIScreen absent");
    const window_class = objc.objc_getClass("UIWindow") orelse @panic("touch ring: UIWindow absent");
    const vc_class = objc.objc_getClass("UIViewController") orelse @panic("touch ring: UIViewController absent");
    const my_view_class = objc.objc_getClass(view_class_name) orelse @panic("touch ring: the registered view vanished");

    const sel_shared = objc.verify(app_class, "sharedApplication", "@@:", true);
    const sel_scenes = objc.verify(app_class, "connectedScenes", "@@:", false);
    const sel_main_screen = objc.verify(screen_class, "mainScreen", "@@:", true);
    const sel_bounds = objc.verify(screen_class, "bounds", "{CGRect={CGPoint=dd}{CGSize=dd}}@:", false);
    const sel_window_init = objc.verify(window_class, "initWithFrame:", "@@:{CGRect={CGPoint=dd}{CGSize=dd}}", false);
    const sel_set_scene = objc.verify(window_class, "setWindowScene:", "v@:@", false);
    const sel_set_root = objc.verify(window_class, "setRootViewController:", "v@:@", false);
    const sel_visible = objc.verify(window_class, "makeKeyAndVisible", "v@:", false);
    const sel_vc_init = objc.verify(vc_class, "init", "@@:", false);
    const sel_set_view = objc.verify(vc_class, "setView:", "v@:@", false);
    const sel_view_init = objc.verify(my_view_class, "initWithFrame:", "@@:{CGRect={CGPoint=dd}{CGSize=dd}}", false);
    const sel_alloc_w = objc.verify(window_class, "alloc", "@@:", true);
    const sel_alloc_vc = objc.verify(vc_class, "alloc", "@@:", true);
    const sel_alloc_v = objc.verify(my_view_class, "alloc", "@@:", true);

    const shared = objc.send(objc.SendClassId)(app_class, sel_shared) orelse @panic("touch ring: no shared application");
    const scenes = objc.send(objc.SendId)(shared, sel_scenes) orelse @panic("touch ring: no connected scenes set");
    const scene = objc.send(objc.SendId)(scenes, sel_any_object);
    // invariant: after the wait, the platform has connected the scene the window needs.
    assert(scene != null);

    const screen = objc.send(objc.SendClassId)(screen_class, sel_main_screen) orelse @panic("touch ring: no main screen");
    const bounds = objc.send(SendRect)(screen, sel_bounds);
    // invariant: the screen the platform reports has real area.
    assert(bounds.size.width > 0);
    assert(bounds.size.height > 0);

    const raw_view = objc.send(objc.SendClassId)(my_view_class, sel_alloc_v) orelse @panic("touch ring: view alloc");
    const view = objc.send(SendRectInit)(raw_view, sel_view_init, bounds) orelse @panic("touch ring: view init");
    // A colorless view over a black window is indistinguishable from no window at all -- the
    // ambiguity that cost this rung a lap -- so the view wears an unmistakable green.
    const color_class = objc.objc_getClass("UIColor") orelse @panic("touch ring: UIColor absent");
    const sel_color = objc.verify(color_class, "colorWithRed:green:blue:alpha:", "@@:dddd", true);
    const sel_set_bg = objc.verify(my_view_class, "setBackgroundColor:", "v@:@", false);
    const SendColor = *const fn (objc.Class, objc.Sel, f64, f64, f64, f64) callconv(.c) ?objc.Id;
    const green = objc.send(SendColor)(color_class, sel_color, 0.12, 0.55, 0.28, 1.0) orelse @panic("touch ring: color");
    objc.send(SendIdArg)(view, sel_set_bg, green);
    const raw_vc = objc.send(objc.SendClassId)(vc_class, sel_alloc_vc) orelse @panic("touch ring: vc alloc");
    const vc = objc.send(objc.SendId)(raw_vc, sel_vc_init) orelse @panic("touch ring: vc init");
    objc.send(SendIdArg)(vc, sel_set_view, view);
    const raw_window = objc.send(objc.SendClassId)(window_class, sel_alloc_w) orelse @panic("touch ring: window alloc");
    const window = objc.send(SendRectInit)(raw_window, sel_window_init, bounds) orelse @panic("touch ring: window init");
    objc.send(SendIdArg)(window, sel_set_scene, scene.?);
    objc.send(SendIdArg)(window, sel_set_root, vc);
    objc.send(objc.SendIdVoid)(window, sel_visible);
    print("ios-touch-ring: window up at {d}x{d} points, scene adopted; waiting for one real tap.\n", .{ @as(u32, @intFromFloat(bounds.size.width)), @as(u32, @intFromFloat(bounds.size.height)) });
}

pub fn main() !void {
    print("ios-touch-ring: Language EN -- a real finger into the proven ring, on the platform's own dispatch.\n", .{});

    const prove_red = c.getenv("PROBE_PROVE_RED") != null;

    const object_class = objc.objc_getClass("NSObject") orelse return error.NSObjectAbsent;
    const string_class = objc.objc_getClass("NSString") orelse return error.NSStringAbsent;
    const view_class = objc.objc_getClass("UIView") orelse return error.UIKitAbsent;
    const set_class = objc.objc_getClass("NSSet") orelse return error.NSSetAbsent;
    const touch_class = objc.objc_getClass("UITouch") orelse return error.UITouchAbsent;

    if (prove_red) {
        print("ios-touch-ring: prove-red -- declaring a signature the loaded UIKit does not have.\n", .{});
        _ = objc.verify(view_class, "initWithFrame:", "v@:", false);
        @panic("objc seam: prove-red reached the send, which means the gate does not gate");
    }

    const sel_utf8 = objc.verify(string_class, "stringWithUTF8String:", "@@:r*", true);
    sel_any_object = objc.verify(set_class, "anyObject", "@@:", false);
    sel_location_in_view = objc.verify(touch_class, "locationInView:", "{CGPoint=dd}@:@", false);
    // The touch handlers override UIResponder's own, so the superclass record is the inward
    // authority (the %335 lesson holds on iOS exactly as on macOS).
    _ = objc.verify(view_class, "touchesBegan:withEvent:", touch_types, false);
    _ = objc.verify(view_class, "touchesEnded:withEvent:", touch_types, false);
    _ = objc.verify(view_class, "touchesMoved:withEvent:", touch_types, false);
    _ = objc.verify(view_class, "touchesCancelled:withEvent:", touch_types, false);
    print("ios-touch-ring: seam verified against the loaded UIKit and Foundation.\n", .{});

    close_sel = objc.sel_registerName("grainCloseProbe:");
    build_window_sel = objc.sel_registerName("grainBuildWindow:");
    const my_view_class = objc.allocate_class(view_class, view_class_name);
    _ = objc.add_method(my_view_class, "touchesBegan:withEvent:", objc.imp(&touches_began), touch_types);
    _ = objc.add_method(my_view_class, "touchesEnded:withEvent:", objc.imp(&touches_ended), touch_types);
    _ = objc.add_method(my_view_class, "touchesMoved:withEvent:", objc.imp(&touches_moved), touch_types);
    _ = objc.add_method(my_view_class, "touchesCancelled:withEvent:", objc.imp(&touches_cancelled), touch_types);
    objc.objc_registerClassPair(my_view_class);
    _ = objc.verify(my_view_class, "touchesBegan:withEvent:", touch_types, false);
    _ = objc.verify(my_view_class, "touchesCancelled:withEvent:", touch_types, false);

    const my_delegate_class = objc.allocate_class(object_class, delegate_class_name);
    _ = objc.add_method(my_delegate_class, "application:didFinishLaunchingWithOptions:", objc.imp(&did_finish_launching), did_finish_types);
    _ = objc.add_method(my_delegate_class, "grainCloseProbe:", objc.imp(&close_probe), close_types);
    _ = objc.add_method(my_delegate_class, "grainBuildWindow:", objc.imp(&build_window), close_types);
    objc.objc_registerClassPair(my_delegate_class);
    _ = objc.verify(my_delegate_class, "application:didFinishLaunchingWithOptions:", did_finish_types, false);
    print("ios-touch-ring: classes {s} and {s} registered.\n", .{ view_class_name, delegate_class_name });

    const delegate_name = objc.send(objc.SendClassStr)(string_class, sel_utf8, delegate_class_name) orelse return error.NameAbsent;
    // invariant: nothing has launched before the platform owns the process.
    assert(!launch_seen);
    const status = UIApplicationMain(0, null, null, delegate_name);
    print("ios-touch-ring: REFUSED -- UIApplicationMain returned {d}.\n", .{status});
    @panic("ios touch ring: the platform's bootstrap returned instead of launching");
}
