//! tools/rye/monocypher_edx_parity.rye — our authored crypto/ed25519_to_x25519.rye asked for its OWN Edwards↔Montgomery key conversion, printed one
//! 64-hex-character value per line, so tools/cr/crypto_monocypher_edx_parity_witness.rish can diff our bytes against the vendored Monocypher's C
//! (tools/fixtures/monocypher_edx_harness.c) byte-for-byte — the identity-unification map that lets one Ed25519 key both sign and agree, proven
//! against the audit's parity target. Season G (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//!
//! The three printed lines are, in order: eddsa_to_x25519(Edwards base) — RFC 7748 §4.1 fixes it to u = 9; eddsa_to_x25519(RFC 8032 Test 1 public
//! key) — the real second-implementation oracle; and x25519_to_eddsa(X25519 base u = 9) — RFC 7748 §4.1 fixes it to the sign-0 Edwards base
//! encoding 5866…66. So the parity witness compares like against like over identical inputs.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/ed25519_to_x25519.rye (reached through the tools/*.rye symlinks,
//! since Rye resolves imports beside the importing file). Purely local — no key of ours, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_edx_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const edx = @import("ed25519_to_x25519.rye");

/// The Ed25519 base point encoding: y = 4/5, sign of x = 0 (RFC 8032 §5.1 canonical little-endian).
const ed_base = [_]u8{
    0x58, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
    0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
};

/// RFC 8032 §7.1 Test 1 Ed25519 public key (a real, published identity key; sign bit 0).
const rfc8032_pub = [_]u8{
    0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7, 0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
    0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25, 0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a,
};

/// The X25519 base u-coordinate, u = 9, little-endian.
const x_base_u = [_]u8{
    0x09, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
};

const hex_alphabet = "0123456789abcdef";

/// print_bytes — render a 32-byte value as a line of 64 lowercase hex characters.
fn print_bytes(b: *const [32]u8) void {
    var out: [64]u8 = undefined;
    var i: u32 = 0;
    // invariant: each of the 32 bytes renders to exactly two hex characters, filling the 64-character line exactly.
    while (i < 32) : (i += 1) {
        out[i * 2] = hex_alphabet[b[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[b[i] & 0x0f];
    }
    // invariant (postcondition): the rendered line is the fixed 64-character width — a full 32-byte value, never a truncation.
    assert(out.len == 64);
    print("{s}\n", .{out});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // invariant (construction): every published input is the fixed 32-byte width the maps read.
    assert(ed_base.len == 32 and rfc8032_pub.len == 32 and x_base_u.len == 32);

    // 1. Forward map of the Edwards base point: expected u = 9.
    const base_u = edx.eddsa_to_x25519(&ed_base);
    print_bytes(&base_u);

    // 2. Forward map of the RFC 8032 Test 1 public key: the real parity oracle.
    const rfc_u = edx.eddsa_to_x25519(&rfc8032_pub);
    print_bytes(&rfc_u);

    // 3. Reverse map of the X25519 base u = 9: expected the sign-0 Edwards base encoding 5866…66.
    const base_y = edx.x25519_to_eddsa(&x_base_u);
    print_bytes(&base_y);

    return 0;
}
