//! tools/rye/monocypher_aead_parity.rye -- our authored crypto/aead.rye asked for its OWN ChaCha20-Poly1305 AEAD ciphertext and tag over RFC 8439
//! §2.8.2's key, nonce, associated data, and plaintext, printed one hex value per line, so tools/cr/crypto_monocypher_aead_parity_witness.rish can
//! diff our bytes against the vendored Monocypher's C (tools/fixtures/monocypher_aead_harness.c) byte-for-byte -- the authenticated-encryption
//! seal Lotus's signed carry, Vault, and Comlink rest on, proven against the audit's parity target. Season G (Cryptography - Rye-native,
//! Monocypher-parity, audit-ready) -- the FOURTH primitive line the decision wave named, closing ChaCha/Poly against the source.
//!
//! The two printed lines are, in order: the ciphertext (114 bytes -> 228 hex characters) and the 16-byte Poly1305 tag (32 hex characters) -- the
//! same two lines the Monocypher C harness prints, so the parity witness compares like against like over identical inputs. Monocypher's IETF
//! authenticated stream (crypto_aead_init_ietf + crypto_aead_write) is byte-for-byte RFC 8439 §2.8, which is exactly what our aead.rye composes.
//!
//! This authors NO cryptography -- it is a printing harness over the GREEN crypto/aead.rye (reached through the tools/rye/aead.rye, tools/rye/chacha20.rye,
//! and tools/rye/poly1305.rye symlinks, since Rye resolves imports beside the importing file). Purely local -- the key and nonce are the RFC's public
//! vectors, no key of ours, no signature, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/rye/monocypher_aead_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const aead = @import("aead.rye");

/// RFC 8439 §2.8.2 key (0x80..0x9f).
const rfc_key = [aead.key_bytes]u8{
    0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f,
    0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f,
};

/// RFC 8439 §2.8.2 IETF nonce: the constant 07:00:00:00 then the 64-bit IV 40..47.
const rfc_nonce = [aead.nonce_bytes]u8{ 0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47 };

/// RFC 8439 §2.8.2 associated data.
const rfc_aad = [_]u8{ 0x50, 0x51, 0x52, 0x53, 0xc0, 0xc1, 0xc2, 0xc3, 0xc4, 0xc5, 0xc6, 0xc7 };

/// RFC 8439 §2.8.2 plaintext -- the sunscreen line, 114 bytes.
const rfc_plaintext = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";

const hex_alphabet = "0123456789abcdef";

/// print_hex -- render a byte slice as a line of lowercase hex, two characters per byte. Bounded by a named ceiling on the slice length.
const max_hex_bytes: u32 = 128;
fn print_hex(bytes: []const u8) void {
    // invariant: the slice fits the hex ceiling, so each byte renders to exactly two characters within a bounded line.
    assert(bytes.len <= max_hex_bytes);
    var out: [max_hex_bytes * 2]u8 = undefined;
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_alphabet[bytes[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[bytes[i] & 0x0f];
    }
    // invariant (postcondition): exactly two hex characters were written per byte -- a full rendering, never a truncation.
    const n: u32 = @as(u32, @intCast(bytes.len)) * 2;
    print("{s}\n", .{out[0..n]});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;

    // invariant (construction): the plaintext is the RFC's 114-byte vector, within the AEAD's message ceiling.
    assert(rfc_plaintext.len == 114 and rfc_plaintext.len <= aead.max_message_bytes);
    // invariant (construction): the key and nonce are the RFC's fixed AEAD widths.
    assert(rfc_key.len == aead.key_bytes and rfc_nonce.len == aead.nonce_bytes);

    var cipher: [rfc_plaintext.len]u8 = undefined;
    var tag: [aead.tag_bytes]u8 = undefined;
    try aead.seal(&cipher, &tag, rfc_plaintext, &rfc_aad, &rfc_key, &rfc_nonce);

    // 1. The ciphertext (114 bytes -> 228 hex characters).
    print_hex(&cipher);

    // 2. The 16-byte Poly1305 tag (32 hex characters).
    print_hex(&tag);

    return 0;
}
