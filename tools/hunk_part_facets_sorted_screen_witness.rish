# tools/hunk_part_facets_sorted_screen_witness.rish — the sorted screen, a header names the sort above the parts (HUNK90).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK90.
# Design read: active-designing/20260814-012818_hunk-part-facets-sorted-screen-exploration.md
# Teacher, thanked clean-room: a search box that says *sorted by price* above the parts it ordered (concept only, siloed).
#
# HUNK89 sorts the faceted result cheapest-first and HUNK88 crowns the faceted shelf with a header, yet the paged header
# sat over the held-order shelf and the sorted shelf carried no header. This rung joins them:
# brushstroke/part_facets_sorted_screen.rye `format_sorted_header` appends `  sorted by price` to HUNK88's paged header
# (only when a result exists), `sorted_header_row` draws it, and `facets_sorted_screen` stacks it over HUNK89's
# facets_sorted_shelf. The selftest proves the header names the sort, a zero-result line names neither page nor sort, no
# drift (the word `sorted by price` over the actually-sorted page, row 0 equal to sorted_header_row and the shelf region
# equal to facets_sorted_shelf cell-for-cell), and the named refusals fire. A price is echoed, compared, and reordered
# by, never moved.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_part_facets_sorted_screen_witness.rish

say "hunk-part-facets-sorted-screen: Language EN — HUNK90 names the sort above the cheapest-first parts: sorted by price appended to HUNK88's paged header, stacked over HUNK89's sorted shelf into one surface read top to bottom."
say "hunk-part-facets-sorted-screen: Style Radiant — what a keeper asked, how many were found, which page they are on, that the page is sorted by price, and the cheapest-first parts of that page; the word names the order, and a zero-result line names neither."
say "hunk-part-facets-sorted-screen: Lens TAME — pure text-and-painting over HUNK88 format_facets_header_paged and HUNK89 facets_sorted_shelf; the word `sorted by price` sits over the actually-sorted page (no drift); a price is echoed, compared, and reordered by, never moved; positive invariants per fn; a malformed clause, a bad dimension, and a bad offset each refuse by name; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/part_facets_sorted_screen"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/part_facets_sorted_screen.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-facets-sorted-screen: build failed — ${build.err}"

# Read the GREEN line from a file — it carries an apostrophe ("parser's") that breaks a shell single-quote round-trip.
let outfile = "brushstroke/bin/part_facets_sorted_screen.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "hunk-part-facets-sorted-screen: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "hunk-part-facets-sorted-screen: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN part-facets-sorted-screen' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "hunk-part-facets-sorted-screen: selftest did not print the GREEN part-facets-sorted-screen line"

# HUNK89 stays GREEN — the sorted shelf this rung crowns.
let s = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/part_facets_sort.rye -femit-bin=brushstroke/bin/part_facets_sort && brushstroke/bin/part_facets_sort selftest > brushstroke/bin/part_facets_sort.out 2>&1"]
assert s.ok else "hunk-part-facets-sorted-screen: HUNK89 part_facets_sort re-run failed — see brushstroke/bin/part_facets_sort.out"
let s_green = run ["sh" "-c" "grep -q 'GREEN part-facets-sort' brushstroke/bin/part_facets_sort.out && echo yes"]
assert (trim s_green.out) == "yes" else "hunk-part-facets-sorted-screen: HUNK89 part_facets_sort did not stay GREEN"

# HUNK88 stays GREEN — the paged header this rung appends a sort note to.
let p = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build brushstroke/part_facets_paged.rye -femit-bin=brushstroke/bin/part_facets_paged && brushstroke/bin/part_facets_paged selftest > brushstroke/bin/part_facets_paged.out 2>&1"]
assert p.ok else "hunk-part-facets-sorted-screen: HUNK88 part_facets_paged re-run failed — see brushstroke/bin/part_facets_paged.out"
let p_green = run ["sh" "-c" "grep -q 'GREEN part-facets-paged' brushstroke/bin/part_facets_paged.out && echo yes"]
assert (trim p_green.out) == "yes" else "hunk-part-facets-sorted-screen: HUNK88 part_facets_paged did not stay GREEN"

say "hunk-part-facets-sorted-screen: GREEN — a keeper reads that the faceted result is sorted by price, above the very cheapest-first parts; HUNK89 sorted shelf and HUNK88 paged header beneath stay GREEN. HUNK90 lands."
