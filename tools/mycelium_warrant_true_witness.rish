# tools/mycelium_warrant_true_witness.rish — a handoff's signed facts are true to the bytes (r4).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the Warrant · rung r4 — the arc closes.
# r1 bound a succession to a quorum of the outgoing roll; r2 let one handoff travel; r3 walked a whole
# succession chain across a checkpoint. This closing rung proves the property the whole Warrant rests on:
# the certificate's signed facts are TRUE TO THE BYTES a keeper can open and hash. Every outgoing validator
# signs a tuple binding the successor roll's CONTENT-ADDRESS — a SHA-256 over the roll's canonical
# `format muster-v1` bytes — so a keeper who renders those same bytes and hashes them with the system
# `sha256sum` recovers the exact digest the warrant carries and every validator endorsed.
#
# The crux this witness proves — TWO TOOLS, ONE ANSWER:
#   - THE DIGEST — the record's `prev`/`next` digest lines equal a system sha256sum of the same canonical
#     roll bytes the app emits (prev-bytes, next-bytes);
#   - THE COUNT — the app's reported endorsement count equals an independent grep count of the record's
#     `endorse` lines.
# Composes warrant + warrant_bron + muster + muster_bron + kumara public API only; demo validator and keeper
# seeds — no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-112420_mycelium-warrant-validator-set-rotation-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_warrant_true_witness.rish

say "mycelium-warrant-true: Language EN — a warrant does not merely assert a roll; it signs the roll's content-address, so a keeper who hashes the canonical roll bytes recovers the exact digest every validator endorsed."
say "mycelium-warrant-true: Style Radiant — the signed facts are true to the bytes a keeper can open and hash: the prev/next digests the certificate carries equal a system sha256sum of the same roll records, and the endorsement count equals an independent line count."
say "mycelium-warrant-true: Lens TAME — the app emits exactly the canonical roll bytes and the rendered certificate over warrant + muster_bron public API; two independent tools (sha256sum, grep) read the same facts; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/warrant_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/warrant_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-warrant-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-warrant-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-warrant-true: selftest did not speak GREEN"
assert selftest.out contains "its carried prev/next digests equal the content-addresses of the two canonical roll records" else "mycelium-warrant-true: in-app digest claim missing"
assert selftest.out contains "refuses DigestMismatch — the signed digest binds one roll, never a neighbor" else "mycelium-warrant-true: neighbor-refusal claim missing"
assert selftest.out contains "The Mycelium Warrant's agent-doable arc closes" else "mycelium-warrant-true: arc-close claim missing"

# The crux — two tools, one answer. The record's prev/next digest lines must equal a system sha256sum of the
# same canonical roll bytes the app emits.
let prev_hash = run ["sh" "-c" "${bin} prev-bytes 2>&1 | sha256sum | awk '{print $1}'"]
assert prev_hash.ok else "mycelium-warrant-true: prev-bytes sha256 failed"
let prev_line = run ["sh" "-c" "${bin} warrant 2>&1 | grep '^prev ' | awk '{print $2}'"]
assert prev_line.ok else "mycelium-warrant-true: reading the record prev line failed"
assert prev_hash.out == prev_line.out else "mycelium-warrant-true: the prev digest the warrant signed drifted from a sha256sum of the canonical roll bytes"

let next_hash = run ["sh" "-c" "${bin} next-bytes 2>&1 | sha256sum | awk '{print $1}'"]
assert next_hash.ok else "mycelium-warrant-true: next-bytes sha256 failed"
let next_line = run ["sh" "-c" "${bin} warrant 2>&1 | grep '^next ' | awk '{print $2}'"]
assert next_line.ok else "mycelium-warrant-true: reading the record next line failed"
assert next_hash.out == next_line.out else "mycelium-warrant-true: the next digest the warrant signed drifted from a sha256sum of the canonical roll bytes"

# The count — the record's endorse lines counted independently must equal the three the app reports.
let count = run ["sh" "-c" "${bin} warrant 2>&1 | grep -c '^endorse '"]
assert count.ok else "mycelium-warrant-true: counting endorse lines failed"
assert count.out contains "3" else "mycelium-warrant-true: the certificate did not carry the three endorsements the app reports"
assert selftest.out contains "warrant-true: endorsements=3" else "mycelium-warrant-true: the app did not report three endorsements"

# The Warrant each certificate is stands at the door — its r1 selftest proves the succession law.
let warrant = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/warrant.rye -femit-bin=mycelium/bin/warrant && mycelium/bin/warrant 2>&1"]
assert warrant.ok else "mycelium-warrant-true: the Warrant r1 is not GREEN"
assert warrant.out contains "GREEN" else "mycelium-warrant-true: the Warrant r1 did not speak its GREEN"

say "mycelium-warrant-true: GREEN — a handoff's signed facts are true to the bytes: the prev/next roll content-addresses the certificate carries and every outgoing validator endorsed equal a system sha256sum of the same canonical roll bytes, and the endorsement count equals an independent grep count of three; the Warrant r1 stands at the door. The Mycelium Warrant's agent-doable arc closes."
