# tools/co/constel_net_ledger_stars_witness.rish -- Constel dev-net ledger, Rung 2: star reservations settle beside the topology, draining supply like tax.
#
# Rung 1 proved the fake net's money folds the real Mycelium supply law and moves only by the identity
# that holds its genesis. This rung carries the third Mycelium fact kind -- star_reserve -- into that
# same sovereign ledger, mirroring the harness's own r2 (a star and a planet settling beneath the
# galaxy): the ledger's names grow beside the topology's points, every reservation paid out of the
# net's own supply. A reservation is signed only by the sovereign (NotSovereign otherwise), is unique
# (StarTaken), drains supply exactly as tax does (Overdraw beyond it), non-negativity holding. Demo
# keeper seeds only -- no real key, no funds, no network, no custody (gate %3 and gate %4 untouched).
#
# Scope: active-designing/date/20260813/20260813-030005_constel-devnet-ledger-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/co/constel_net_ledger_stars_witness.rish

say "constel-net-ledger-stars: Language EN — a fake net's star names grow beside its topology, paid from its own supply."
say "constel-net-ledger-stars: Style Radiant — the address space and the money grow together, under one sovereign hand."
say "constel-net-ledger-stars: Lens TAME — reservations are sovereign-only, unique, and drain like tax; an overdraw refuses whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/constel-net-ledger-stars"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/constel_net_ledger_stars.rye -femit-bin=${bin}"]
assert build.ok else "constel-net-ledger-stars: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "constel-net-ledger-stars: selftest exited non-zero"
assert selftest.out contains "GREEN" else "constel-net-ledger-stars: selftest did not speak GREEN"
assert selftest.out contains "drained supply to 50 over three sovereign facts" else "constel-net-ledger-stars: reservations-drain-supply claim missing"
assert selftest.out contains "refused StarTaken; supply held at 70" else "constel-net-ledger-stars: unique-reservation claim missing"
assert selftest.out contains "refused Overdraw; supply held at 40" else "constel-net-ledger-stars: overpriced-reservation claim missing"
assert selftest.out contains "refused NotSovereign before the log" else "constel-net-ledger-stars: alien-reservation refusal missing"

# Rung one stands at its door -- the sovereign ledger the reservations extend re-runs GREEN, so this
# rung's reservations rest on a ledger already proven honest.
let r1 = run ["sh" "-c" "rishi/bin/rishi run tools/co/constel_net_ledger_witness.rish 2>&1"]
assert r1.ok else "constel-net-ledger-stars: rung one (the sovereign ledger) is not GREEN"
assert r1.out contains "constel-net-ledger: GREEN" else "constel-net-ledger-stars: rung one did not speak its GREEN"

say "constel-net-ledger-stars: GREEN — star reservations settle beside the topology, drain the net's own supply like tax, and are named only by the identity that holds its genesis; rung one stands at its door."
