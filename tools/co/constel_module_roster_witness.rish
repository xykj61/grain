# tools/co/constel_module_roster_witness.rish -- the module roster names every module beside it.
#
#   rishi/bin/rishi run tools/co/constel_module_roster_witness.rish
#
# WHY, and this one differs from its three siblings. constel/README.md stood at 69,979 bytes on
# 20260824 over 109 lines, and it was the last unsplit module front door in the tree. Counted
# against the directory it already read clean: 31 of 31 modules named, 31 of 31 witnesses named,
# every tools/f/ path correct, and the highest rung it cites -- FORA30 -- matching the highest on
# disk. So this page had no miscount to repair, and the split was for length alone: two blocks
# carried nearly all of it, one 9,848-byte road-on sentence accreted rung by rung, and a 4,558-byte
# chain of twenty-three kin links.
#
# That makes this guard PREVENTION rather than repair, and it is the first of the four to be seated
# that way. The three before it were each booked by a page already wrong -- a ladder table naming 73
# of 110 (%184), a page naming 112 of 227 (%189), 83 of 240 (%190), and a library whose own count
# guard was RED and off the roster (%191). A roster that lists what a READER should find is checked
# by nobody, because a missing entry breaks only understanding, and understanding fails quietly.
# This directory is correct today; the guard is what keeps the 32nd rung from landing unlisted.
#
# ONE SCAN, FOUR DIRECTORIES. tools/fixtures/module_roster_scan.sh takes the directory as an
# argument, so image/, lotus/, crypto/, and constel/ are held by one rule rather than by four copies
# of it. A rule written four times is a rule four files may quietly come to disagree about, and this
# witness adds no scan of its own -- it is a witness file and nothing more, exactly as the itinerary
# predicted when it named this page.
#
# WHAT IS GATED, hard, at zero, in four readings:
#
#   unrostered      -- a constel/*.rye on disk with no row in constel/MODULES.md
#   phantom         -- a row naming a module that is absent from the directory
#   duplicate_rows  -- one module wearing two rows, which may come to disagree
#   mismatched_rows -- a row whose display text and link target name different modules
#
# WHAT PASSES FREE. A row in a second table on the page, which is how eleven families are rostered
# here. And a module cited in prose, which is read past on purpose: LADDER.md beside this roster
# cites its own modules constantly, and a reading that counted those would call a short table
# complete.
#
# WHAT IT DOES NOT REACH, said plainly. Whether a row's sentence is true. Each was written from that
# module's own `//!` head comment, and no grep reads whether that comment still describes the code.
# The rung's own witness proves the rung -- 31 of them stand in tools/f/ -- and this proves the
# roster.
#
# Pen: tools/fixtures/module_roster_control.sh -- sixteen behaviors on real directories in a
# throwaway pen, nine refusals bitten and seven honest readings left free, so no override exists
# and none is wanted. Run from the repository root.

say "constel-module-roster: Language EN -- the page a reader learns this directory from names every module in it, both directions, so a landed rung cannot go unlisted."
say "constel-module-roster: Style Gauge, Meter -- every count below is the scan's own output, read from the tree rather than recited here."
say "constel-module-roster: Lens TAME -- a bijection rather than a tally, and the corpus size published beside the verdict so a reading over nothing can never report clean."

let scan = run ["sh" "tools/fixtures/module_roster_scan.sh" "census" "constel"]
say scan.out
assert scan.ok else "constel-module-roster: the scan must complete -- a module has landed without a row, or a row outlived its module"
assert scan.out contains "page=constel/MODULES.md" else "constel-module-roster: the scan must read the constel roster rather than another directory's"
assert scan.out contains "unrostered=0" else "constel-module-roster: every constel/*.rye carries a row in constel/MODULES.md"
assert scan.out contains "phantom=0" else "constel-module-roster: every row in constel/MODULES.md names a module that exists in this directory"
assert scan.out contains "duplicate_rows=0" else "constel-module-roster: one module wears one row, since two rows may come to disagree"
assert scan.out contains "mismatched_rows=0" else "constel-module-roster: a row's display text and its link target name one module"
assert scan.out contains "bijection=yes" else "constel-module-roster: the table and the directory must be the same set"

# A meter reading no modules finds no fault and would report clean while measuring nothing.
assert (scan.out contains "modules_on_disk=0" == false) else "constel-module-roster: a zero-module reading would report clean over an empty directory"

let control = run ["sh" "tools/fixtures/module_roster_control.sh"]
say control.out
assert control.ok else "constel-module-roster: the control must complete"
assert control.out contains "control_fail=0" else "constel-module-roster: every planted behavior must read as written"
assert control.out contains "control_verdict=ok" else "constel-module-roster: the control must agree with itself"
assert control.out contains "2 bitten: a module on disk with no row counts against the gate" else "constel-module-roster: the gate that names this guard must bite"
assert control.out contains "3 bitten: a row naming a module absent from this directory counts against the gate" else "constel-module-roster: a row outliving its module must bite"
assert control.out contains "4 bitten: one module wearing two rows counts against the gate" else "constel-module-roster: two rows for one module must bite"
assert control.out contains "5 bitten: a row whose text and target disagree counts against the gate" else "constel-module-roster: a row naming two modules must bite"
assert control.out contains "6 bitten: a module cited only in prose beneath the table stays unrostered" else "constel-module-roster: prose citations must be read past, or a short table reads complete"
assert control.out contains "12 bitten: an empty directory reads as an empty corpus rather than clean" else "constel-module-roster: a meter over nothing must say so"
assert control.out contains "15 bitten: a page naming half its directory counts every absentee" else "constel-module-roster: the departing shape at scale must bite"
assert control.out contains "1 free: an exact bijection over three modules reads clean" else "constel-module-roster: the honest shape must pass free"
assert control.out contains "10 free: a row in a second table on the page rosters its module" else "constel-module-roster: the eleven family tables must roster the same way"
assert control.out contains "14 free: a module and its row leaving together read clean at two" else "constel-module-roster: an honest removal must pass free"

say ""
say "GREEN: constel-module-roster -- the module roster and the constel directory are one set, 31 rows against 31 modules, gated at zero in four readings and proven both ways on real directories."
