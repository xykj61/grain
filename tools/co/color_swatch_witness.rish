# tools/co/color_swatch_witness.rish -- an on-color scale pairs each tone with its legible ink, proven on metal (Season G).
#
# Season G (Open Media Primitives) -- the on-color ramp one rung above the tonal scale (image/color_scale.rye) and the
# readable-ink floor (image/color.rye readable_ink). The design read: active-designing/date/20260816/20260816-210735_season-g-color-algebra-crux.md.
# Teacher, thanked clean-room: gratitude/w3c-css-color.md (the W3C CSS Color spec + sRGB + WCAG contrast -- public standards only).
#
# The crux this witness proves is the move a design system reaches for right after a tonal scale: pair every tone with the
# ink that stays legible on it -- Material's on-primary, Tailwind's paired text color. Written single-stranded: color_scale
# DECIDES each fill and color DECIDES each ink; this module only pairs them into a Swatch, so the fills are byte-for-byte the
# ramp and the inks exactly readable_ink of their own fills. Because the ramp's lightness steps down monotonically and
# readable_ink flips at a single luminance threshold, the crossover is clean -- black on the light tones above, white on the
# dark tones below, never a black tone beneath a white -- and both endpoints clear WCAG AA. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/co/color_swatch_witness.rish

say "color-swatch: Language EN -- Season G's on-color ramp; a keeper names one seed color and reads back a whole palette where every tone already knows the black or white ink that stays legible against it."
say "color-swatch: Style Radiant -- compose not braid; color_scale DECIDES each fill and color DECIDES each ink, and this module only pairs them, so both floors' proofs carry through untouched."
say "color-swatch: Lens TAME -- u32 swatch counts bounded by swatch_max_tones (shared with the tonal scale); text ink proven opaque and the crossover monotone; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/color_swatch"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/color_swatch.rye -femit-bin=${bin}"]
assert build.ok else "color-swatch: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "color-swatch: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "color-swatch: ${out}"

# Honour the loom REDS %76 named: check every claim with Rishi's native `contains`, never a shell grep over interpolated
# output, so an apostrophe in the selftest prose can never break a check the way it broke the elder color_scale witness.
assert out contains "GREEN image-color-swatch" else "color-swatch: selftest did not print the GREEN color-swatch line"
assert out contains "each ink is color.readable_ink of its own fill" else "color-swatch: an ink was not exactly the readable pick of its own fill"
assert out contains "crossover is clean" else "color-swatch: the black-to-white ink crossover was not clean"
assert out contains "clearing WCAG AA" else "color-swatch: an endpoint ink did not clear WCAG AA"
assert out contains "refuses ScaleTooShort by name" else "color-swatch: an out-of-band length was not refused by name"
assert out contains "the general form contains the special one" else "color-swatch: the brand-pair scale did not reduce to the readable scale"

say "color-swatch: GREEN -- the on-color scale from one seed whole; each tone paired with its legible ink, the crossover clean, endpoints clearing AA, out-of-band lengths refused, determinism proven."
