# comlink_handshake_turn_witness.rish -- the live handshake, with rotation.
#
# Proves Comlink's handshake asks two questions in one breath: who are you (the
# signed introduction admits the peer to the table) and which key do I seal to
# (the peer's freshest verified turn tilak names the networking key). The two
# gates are independent -- a peer admitted by a valid introduction still routes
# only to a verified, freshest key, and a forged turn is refused while the peer
# stays known.
#
# Build first:  rye build comlink/handshake_turn.rye -femit-bin=comlink/bin/handshake-turn
#   rishi/bin/rishi run tools/co/comlink_handshake_turn_witness.rish

# Build the binary this witness proves, rather than assuming a previous lap left one behind.
# comlink/bin/ is gitignored (.gitignore:185), so a clone carries no binary at all: the "Build
# first" line above is documentation, and a comment builds nothing. Its sibling
# tools/co/comlink_topology_witness.rish already carries this repair.
let zig = "vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p comlink/bin && env RYE_ZIG=${zig} rye/bin/rye build comlink/handshake_turn.rye -femit-bin=comlink/bin/handshake-turn"]
assert build.ok else "comlink handshake-turn: build failed -- ${build.err}"

let st = run ["comlink/bin/handshake-turn" "selftest"]
assert st.ok else "comlink handshake-turn selftest must exit 0"
assert (st.err contains "GREEN") else "handshake-turn must report GREEN"
assert (st.err contains "admitted by a signed introduction") else "the introduction gate admits the peer"
assert (st.err contains "keyed to its freshest verified turn") else "the wire is keyed to the freshest verified turn"
assert (st.err contains "rotation taken") else "a newer turn rotates the wire key"
assert (st.err contains "forged turn refused") else "a forged turn is refused while the peer stays admitted"
assert (st.err contains "carried on the descriptor round-trips") else "a turn carried on the descriptor is recovered and keys the wire"

say "GREEN: comlink handshake-turn — identity and rotation gate independently; a peer is admitted by its signed introduction and the wire seals to the freshest verified turn it carries on its descriptor."
