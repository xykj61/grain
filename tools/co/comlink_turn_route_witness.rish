# comlink_turn_route_witness.rish -- routing reads the turn tilak.
#
# Proves Comlink can read a peer's rotation record (the turn tilak from
# kumara/tilak.rye) and decide which networking key to seal the wire with:
# an authentic turn is trusted, the freshest supersedes, a replay is kept out,
# and a forgery is refused. The seam where identity's rotation meets the wire.
#
# Build first:  rye build comlink/turn_route.rye -femit-bin=comlink/bin/turn-route
#   rishi/bin/rishi run tools/co/comlink_turn_route_witness.rish

# Build the binary this witness proves, rather than assuming a previous lap left one behind.
# comlink/bin/ is gitignored (.gitignore:185), so a clone carries no binary at all: the "Build
# first" line above is documentation, and a comment builds nothing. Its sibling
# tools/co/comlink_topology_witness.rish already carries this repair.
let zig = "vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p comlink/bin && env RYE_ZIG=${zig} rye/bin/rye build comlink/turn_route.rye -femit-bin=comlink/bin/turn-route"]
assert build.ok else "comlink turn-route: build failed -- ${build.err}"

let st = run ["comlink/bin/turn-route" "selftest"]
assert st.ok else "comlink turn-route selftest must exit 0"
assert (st.err contains "GREEN") else "turn-route must report GREEN"
assert (st.err contains "first turn taken") else "a first authentic turn is taken"
assert (st.err contains "fresher supersedes") else "a newer turn rotates the route key"
assert (st.err contains "reset outranks") else "a reset outranks any key rotation"
assert (st.err contains "replay kept out") else "a replayed old turn cannot roll the key back"
assert (st.err contains "forged refused") else "a forged turn is refused, keeping the last trusted key"

say "GREEN: comlink turn-route — routing reads a verified turn, rotates to the freshest networking key, and never rolls back or follows a forgery."
