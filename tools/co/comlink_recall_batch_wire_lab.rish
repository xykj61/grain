# comlink_recall_batch_wire_lab.rish -- NS-L3 batch device-wire QEMU lab (spawn / wait-for).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/co/comlink_recall_batch_wire_lab.rish
#
# Replaces the background-orchestration half of comlink/run_recall_batch_wire_lab.sh;
# the shell entry point delegates here so stable paths and citations hold.

let zig = "vendor/zig-toolchain/zig"
let build_dir = "comlink/.build"

# Sameness is the macro: build/qemu shapes named once as fns, callers spawn/run
# the returned argv (the handle law) -- full account: comlink_device_wire_lab.rish.

fn build_guest src elf: run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${src} -target riscv64-freestanding-none -mcmodel=medium -fno-entry -T aurora/layout.ld -femit-bin=${build_dir}/${elf}"]
fn qemu_rx cable elf: ["timeout" "60" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-nographic" "-global" "virtio-mmio.force-legacy=false" "-device" "virtio-net-device,netdev=net0" "-netdev" "socket,id=net0,listen=${cable}" "-kernel" "${build_dir}/${elf}"]
fn qemu_tx cable elf: ["timeout" "30" "qemu-system-riscv64" "-machine" "virt" "-bios" "none" "-nographic" "-global" "virtio-mmio.force-legacy=false" "-device" "virtio-net-device,netdev=net0" "-netdev" "socket,id=net0,connect=${cable}" "-kernel" "${build_dir}/${elf}"]
let port_request_raw = env "COMLINK_BATCH_LAB_PORT"
if port_request_raw == "" then let port_request = "15563" else let port_request = port_request_raw
let port_response_raw = env "COMLINK_BATCH_RESP_LAB_PORT"
if port_response_raw == "" then let port_response = "15564" else let port_response = port_response_raw
let sock_request = "127.0.0.1:${port_request}"
let sock_response = "127.0.0.1:${port_response}"

let prep = run ["sh" "-c" "mkdir -p ${build_dir}"]
assert prep.ok else "recall batch wire lab mkdir failed"

let build_source_rx = build_guest "comlink/guest_batch_source_rx.rye" "batch-source-rx.elf"
assert build_source_rx.ok else "batch source rx guest build failed"

let build_fetcher_tx = build_guest "comlink/guest_batch_fetcher_tx.rye" "batch-fetcher-tx.elf"
assert build_fetcher_tx.ok else "batch fetcher tx guest build failed"

let build_fetcher_rx = build_guest "comlink/guest_batch_fetcher_rx.rye" "batch-fetcher-rx.elf"
assert build_fetcher_rx.ok else "batch fetcher rx guest build failed"

let build_source_tx = build_guest "comlink/guest_batch_source_tx.rye" "batch-source-tx.elf"
assert build_source_tx.ok else "batch source tx guest build failed"

let request_rx = spawn (qemu_rx sock_request "batch-source-rx.elf")
let request_pause = run ["sleep" "1"]
assert request_pause.ok else "request hop sleep failed"
let request_tx = run (qemu_tx sock_request "batch-fetcher-tx.elf")
let request_rx_done = wait-for request_rx
assert request_rx_done.out contains "sealed batch request GREEN" else "request hop RED"

let response_rx = spawn (qemu_rx sock_response "batch-fetcher-rx.elf")
let response_pause = run ["sleep" "1"]
assert response_pause.ok else "response hop sleep failed"
let response_tx = run (qemu_tx sock_response "batch-source-tx.elf")
let response_rx_done = wait-for response_rx
assert response_rx_done.out contains "sealed beaded batch response GREEN" else "response hop RED"

say "rbw device wire lab: GREEN (request + batch)"
