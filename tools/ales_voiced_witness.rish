# tools/ales_voiced_witness.rish — the voiced/unvoiced/silent classifier: the first Lotus rung to fuse two analysis readers (ALES94).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES94.
# Design read: active-designing/date/20260814/20260814-230352_fill-ales94-lotus-voiced-unvoiced-classifier.md
# Stands on: lotus/zero_cross.rye (ALES93 — the crossing count, one feature) and lotus/meter.rye (ALES13 — the RMS energy, the other feature), the band read
# through lotus/schmitt.rye's precheck (ALES92), over lotus/timeline.rye's Clip (ALES2). ALES93 gave the suite its first analysis reader; ALES13 already carried
# the other; this rung is the first to FUSE two readers into one verdict — the oldest decision in speech processing, is this frame voiced, unvoiced, or silent?
#
# lotus/voiced.rye reads the RMS energy and the genuine crossing count over the SAME span and fuses them by one rule, the energy gate first: rms < silence_floor
# → silent; else crossings ≥ voice_split → unvoiced; else → voiced. The crux is that it invents no new measurement — its verdict equals a hand-built decision
# from count_crossings and a Meter's RMS over the same span, so it can never drift from the two readers it composes. The selftest proves it: loud-and-periodic
# reads voiced; loud-and-noisy reads unvoiced; quiet reads silent whatever the crossing rate; the floor dominates the crossing rate (a quiet many-crossing span
# is silent, not unvoiced); the verdict is exactly the two readers fused across many floors and splits (the crux); the source clip is byte-for-byte unchanged
# (read-only); the floor-zero convention holds (floor 0 disables silence, an all-zero span reads voiced); an illegal floor refuses BadFloor, an inverted band
# refuses BadThreshold, an out-of-range span refuses BadRange, the clip untouched; the span discipline holds (only [start, count) is read into the verdict).
# Purely local, read-only — a three-valued label over one span, not a phoneme or a transcript; no adaptive floor, no time windowing, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_voiced_witness.rish

say "ales-voiced: Language EN — ALES93 gave the suite its first analysis reader (a crossing count); ALES13 already carried the other (RMS energy). This rung is the first to FUSE two readers into one verdict — the oldest decision in speech processing, is this frame VOICED, UNVOICED, or SILENT? Energy separates sound from silence; the crossing rate separates the two kinds of sound above the floor — a voiced sound (vowel, note, tone) crosses FEW times, an unvoiced sound (fricative, hiss, noise) crosses MANY."
say "ales-voiced: Style Radiant — the law is stated positively and the energy gate is read FIRST: if rms < silence_floor → silent; else if crossings ≥ voice_split → unvoiced; else → voiced. The crux stands out: it invents no new measurement — its verdict equals a hand-built decision from ALES93's count_crossings and ALES13's RMS over the SAME span, so the classifier is the fusion rule, not a third reader that could disagree with the two it names."
say "ales-voiced: Lens TAME — one mono clip of i16 PCM READ over a span, never written; the band validated through ALES92's own precheck (BadThreshold on an illegal band, BadRange on a span outside the samples) and the silence floor against the peak ceiling (BadFloor) before either feature is read; both features read-only; siloed to lotus/, a three-valued label over one span (not a phoneme, not a probability), no adaptive floor, no time windowing, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/voiced"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/voiced.rye -femit-bin=${bin}"]
assert build.ok else "ales-voiced: build failed — ${build.err}"

let outfile = "lotus/bin/voiced.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-voiced: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-voiced: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-voiced' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-voiced: selftest did not print the GREEN ales-voiced line"
