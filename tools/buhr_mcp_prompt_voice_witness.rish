# tools/buhr_mcp_prompt_voice_witness.rish — BUHR Journey 11, Rung 3: a filled prompt routes to a voice.
#
# Journey 9 served the intelligence as MCP tools; Journey 11 rungs one and two served prompts (a
# template a server offers, fills, and lists). This rung joins them: a server's own prompt
# template, filled by a caller's arguments, IS a prompt a Grain voice can answer. pond/apps/
# mcp_prompt_voice.rye fills the template (rung one) and dispatches the finished text through the
# gathered Q-vane host (quin_host_artifact) — so which voice replies is chosen by the filled
# words: `matmul the pair` routes to Lattice (19 22 43 50), `lane_count the graph` to the graph
# voice. The answer crosses back in an owned format mcp-prompt-run-v1 envelope (id, voice, result)
# a caller round-trips. Every refusal crosses as a named error, never a fabricated answer — the
# fill's four refusals cross straight back, a voice refusal keeps its MCP name. Composed over
# public API only; rung one and the host stay their own green binaries. Reads no network — the
# real fetch and the Comlink-served transport stay the held gates.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_mcp_prompt_voice_witness.rish

say "buhr11r3: Language EN — a server's filled prompt template routes to a Grain voice; the equinox's two halves, the intelligence and the protocol, meet."
say "buhr11r3: Lens TAME — the fill chooses the voice; a refusal at either stage crosses back named, never a fabricated answer or a half-filled prompt."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-prompt-voice"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_prompt_voice.rye -femit-bin=${bin}"]
assert build.ok else "buhr11r3: mcp_prompt_voice build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr11r3: mcp_prompt_voice selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr11r3: selftest did not speak GREEN"
assert selftest.out contains "routed to Lattice" else "buhr11r3: the Lattice routing is missing"
assert selftest.out contains "19 22 43 50" else "buhr11r3: Lattice's real matmul answer is missing"
assert selftest.out contains "routed to the graph voice" else "buhr11r3: the graph-voice routing is missing"
assert selftest.out contains "crossed back as missing_argument (never routed)" else "buhr11r3: the fill-refusal cross-back is missing"
assert selftest.out contains "crossed back as prompt_not_found (never routed)" else "buhr11r3: the unknown-prompt cross-back is missing"
assert selftest.out contains "crossed back as unknown_op" else "buhr11r3: the no-voice cross-back is missing"
assert selftest.out contains "crossed back as model_not_allowed" else "buhr11r3: the disallowed-model cross-back is missing"
assert selftest.out contains "an unknown run field refused" else "buhr11r3: the unknown-field refusal is missing"

# Rung one (prompts/get) and the gathered host stay their own green binaries; this rung calls
# only their public API.
let r1_bin = "pond/bin/mcp-prompt"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_prompt.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr11r3: mcp_prompt (J11r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr11r3: mcp_prompt (J11r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr11r3: mcp_prompt (J11r1) did not speak GREEN"

say "buhr11r3: GREEN — a filled prompt template routes to the voice its words name, and every refusal crosses back named."
