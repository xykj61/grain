# caravan_notify_witness.rish -- Caravan notify witness.
#
# Proves a declared channel rings between two real PROCESSES: every channel
# provisioned as its own silent doorbell, the producer writing the share and
# ringing the bell before it exits, the consumer hearing the bell first and
# only then reading the share, an unwired pair refusing NotWired both ways
# with no bell touched, and a bell that never rang heard as Unheard while
# the share stays unread.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_notify_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/notify"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/notify.rye -femit-bin=${bin}"]

assert build.ok else "caravan notify build failed"

# A fresh provisioning each run, so a bell found ringing was rung by this
# run's producer rather than left standing by the last one.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan notify selftest exited non-zero"
assert test.out contains "GREEN" else "caravan notify selftest not GREEN"
assert test.out contains "notify stands beside share" else "the selftest did not close the loop"
assert test.out contains "one channel owns one bell from either side" else "a channel did not resolve to a single bell"
assert test.out contains "client_a: ring rx_a via client_b -- NotWired" else "an unwired pair rang a bell"
assert test.out contains "client_b: ring rx_b via client_a -- NotWired" else "the channel wall held only one way"
assert test.out contains "client_b: receive rx_b via serial_virt -- Unheard" else "a silent bell was heard as a delivery"
assert test.out contains "serial_virt: deliver rx_a via client_a -- carried" else "the producing process did not deliver"
assert test.out contains "client_a: receive rx_a via serial_virt -- carried" else "the consuming process did not receive"
assert test.out contains "2 declared channels provisioned silent" else "the declared channels were not provisioned"
assert test.out contains "23 bytes crossed rx_a after the bell" else "no bytes crossed after the ring"

# The doorbells stand where the declaration put them, one per declared
# channel, each holding a single counted byte.
let bells = run ["sh" "-c" "ls caravan/.channels"]
assert bells.ok else "the doorbells could not be listed"
assert bells.out contains "client_a--serial_virt.bell" else "the client_a channel has no bell"
assert bells.out contains "client_b--serial_virt.bell" else "the client_b channel has no bell"

# The bell client_a heard really rang, and the bell client_b never heard
# really stands silent -- one delivery, one silence, both on disk.
let rung = run ["sh" "-c" "od -An -tu1 -N1 caravan/.channels/client_a--serial_virt.bell"]
assert rung.ok else "the rung bell could not be measured"
assert rung.out contains "1" else "the delivered channel's bell stands silent"

say "GREEN: Caravan notify witness passed."
