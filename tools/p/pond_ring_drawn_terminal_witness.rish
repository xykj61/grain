# tools/p/pond_ring_drawn_terminal_witness.rish -- the first Pond ring: customs
# gates the drawn terminal, end to end, on the host glass.
#
#   rishi/bin/rishi run tools/p/pond_ring_drawn_terminal_witness.rish
#
# One application under policy: the manifest crosses customs at receipt; a
# place verdict admits the app and its headless session runs; a refuse
# verdict blocks placement whole, and the app stays unrun. Both spaces held.

say "ring: Language EN — the first Pond ring, one app under customs."
say "ring: Lens TAME — the gate decides first; the app runs second; refuse blocks."

let zig = "vendor/zig-toolchain/zig"

# A Wayland application on a headless pier is a machine fact, never a tree red (REDS %173).
# The build fixture exits 3, and only 3, when no graphical link seam stands here.
let gate = run ["sh" "-c" "sh tools/fixtures/p/pond_build_drawn_terminal.sh >/dev/null 2>&1; test $? -eq 3"]
if gate.ok then say "GATED: ring wants a host with a display -- no graphical link seam on this machine."
if gate.ok then say "GATED: customs and the manifests are host-free; the session lap wants glass."
if gate.ok then exit 0

say "ring: customs stands (build)..."
let bc = run ["env" "RYE_ZIG=${zig}" "rye/bin/rye" "build" "pond/customs.rye" "-femit-bin=pond/bin/customs"]
assert bc.ok else "ring: customs failed to build"

say "ring: the app stands (seated build fixture)..."
let ba = run ["rishi/bin/rishi" "run" "tools/fixtures/p/pond_build_drawn_terminal.rish"]
assert ba.ok else "ring: drawn terminal failed to build"

say "ring: manifest crosses customs — place admits..."
let ins = run ["pond/bin/customs" "inspect" "tools/fixtures/p/pond_ring_drawn_terminal_good.manifest"]
assert ins.ok else "ring: place manifest did not admit"
assert ins.err contains "verdict=place" else "ring: verdict was not place"
assert ins.err contains "admitted for placement" else "ring: admission line missing"

say "ring: admitted — the session runs headless..."
let app = run ["pond/bin/drawn-terminal" "sessiontest"]
assert app.ok else "ring: admitted app failed its session lap"
assert app.out contains "GREEN" else "ring: session lap did not speak GREEN"

say "ring: a stranger mark crosses — refuse blocks whole..."
let ref = run ["sh" "-c" "pond/bin/customs inspect tools/fixtures/p/pond_ring_drawn_terminal_refuse.manifest 2>&1; test $? -eq 2"]
assert ref.ok else "ring: refuse did not exit 2"
assert ref.out contains "REFUSE" else "ring: refuse line missing"
assert ref.out contains "verdict=refuse" else "ring: verdict was not refuse"

say "GREEN: the first Pond ring — customs gates, place runs, refuse blocks; one app under policy on the host glass."
