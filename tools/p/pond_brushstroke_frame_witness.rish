# tools/p/pond_brushstroke_frame_witness.rish -- accrete shim -> tools/gen/season/pond_brushstroke_frame_witness.rish (Surface p6)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/pond_brushstroke_frame_witness.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/pond_brushstroke_frame_witness.rish" args[0]]
if r.out != "" then say r.out
exit r.code
