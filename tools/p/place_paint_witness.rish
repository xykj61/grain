# tools/p/place_paint_witness.rish -- one source PLACED at a named anchor in a box proves itself on metal (Season G).
#
# Season G (Open Media Primitives) -- the CSS background-position sibling of tools/co/compose_tiled_witness.rish: where
# compose_tiled TILES a small pattern edge to edge to fill a box (the background-repeat gesture), this rung places ONE
# copy and anchors it -- a single source seated at a named corner, edge, or center of a rectangle (the background-position
# with no-repeat gesture: an icon pinned top-right in a panel, a logo centered in a card, a badge in a bottom corner).
# Stands on the open compositing verb (image/compose.rye paint_over_region) and the open QOI codec (image/qoi.rye),
# adding no new pixel loop.
# Design read: active-designing/date/20260816/20260816-210735_season-g-color-algebra-crux.md (the color floor this stands on).
# Teacher, thanked clean-room: gratitude/w3c-css-color.md (the W3C CSS spec -- public standards only).
#
# The crux this witness proves is that a single source seats at its anchor and stays in its box: paint_placed draws one
# copy of a source at the (ax, ay) anchor of a box, the box's remaining area left as the ground beneath. A fitting source
# seats on the slack (center), or flush to the low corner (start) or the high corner (end), or at a mixed corner; a source
# larger than the box is CLIPPED to the box, the anchor choosing which window of the source shows; a translucent source
# blends src-over uniform; the placed image round-trips through the open QOI codec byte-for-byte; a zero dimension, an empty
# source, and an out-of-bounds box each refuse by name having painted nothing. Compose not braid -- compose owns the blit,
# qoi owns the buffers; this rung only routes the anchor to its one window and its one clip. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/p/place_paint_witness.rish

say "place-paint: Language EN -- Season G's background-position verb; a keeper names a box, a source, and a horizontal and vertical anchor and reads back the source seated at that spot, on our own open geometry and codec."
say "place-paint: Style Radiant -- compose not braid; image/compose.rye paint_over_region OWNS the blit, image/qoi.rye owns both buffers, and this rung only ROUTES the anchor to its one window and its one clip so a translucent source seats over the ground beneath it."
say "place-paint: Lens TAME -- the box bound-checked ONCE up front in u64 so a far edge can never wrap; the anchor window one unsigned axis rule seen twice (fit seats on the slack, overflow clips to the box); all-or-nothing so a refusal paints nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/place_paint"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/place_paint.rye -femit-bin=${bin}"]
assert build.ok else "place-paint: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "place-paint: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "place-paint: ${out}"

# Check the GREEN claim with Rishi's native `contains`, never a shell grep over interpolated output -- an apostrophe in
# the selftest prose (the source's own window) can never close a shell quote here, the loom REDS %76 taught the tree.
assert selftest.out contains "GREEN image-place" else "place-paint: selftest did not print the GREEN place line"

say "place-paint: GREEN -- one source placed at a named anchor in a box, proven on metal: the source seated on the slack, flush to a corner, or at a mixed corner; an oversize source clipped to the box by its anchor; a translucent src-over placement; a byte-for-byte QOI round trip; and every malformed placement refused by name having painted nothing."
