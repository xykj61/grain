# tools/p/page_evict_witness.rish -- this tree's own pages drop, and no one else's, proven on metal.
#
#   rishi/bin/rishi run tools/p/page_evict_witness.rish
#
# WHAT IT GUARDS. `tools/rye/page_evict.rye` exists so a measurement of a COLD read costs no peer a
# page. The elder reading it unblocks sits in
# `active-designing/date/20260917/20260917-020034_where-the-hash-still-pays.md`, which named a falsifier --
# one cold library read against one warm one -- and declined to run it, because the only eviction
# it knew was `echo 3 > /proc/sys/vm/drop_caches`, which empties the cache for every process on
# the host.
#
# THE TWO CLAIMS. First, that the advice reaches the cache: residency is read back through `mmap`
# plus `mincore(2)` rather than trusted from the syscall's own answer, since the kernel stays free
# to keep a page it wants. Second, that a path landing outside this tree refuses -- which is the
# claim seven peer ships depend on, and the one the control plants on real paths.
#
# WHY A WITNESS RATHER THAN A PAPER'S FOOTNOTE. A measurement instrument nobody re-runs is a
# number somebody will quote after it has stopped being true. This builds the program from source
# on every run, so the binary it proves is the file a reader opens.

say "page-evict: Style Gauge, Meter -- every figure below is a reading this run took."
say "page-evict: Lens TAME -- the file bound, the path bound and the page size are named at construction."

let zig = "vendor/zig-toolchain/zig"

say "page-evict: building from source, so the binary matches the file this witness reads..."
let build = run ["sh" "-c" "mkdir -p tools/bin && env RYE_ZIG=${zig} rye/bin/rye build tools/rye/page_evict.rye -femit-bin=tools/bin/page-evict"]
assert build.ok else "page-evict: the build refused --\n${build.out_brief}\n${build.err_brief}"

# The claim lines arrive on stderr, as every hosted Rye program in this tree prints through
# `std.debug.print`; the redirect is what puts them where the asserts below can read them.
let out = run ["sh" "-c" "tools/bin/page-evict selftest 2>&1"]
# SAID BEFORE THE FIRST ASSERT ON IT: an assert stops the run, so a reader meeting a refusal
# receives the program's own lines rather than this file's sentence.
say out.out
assert out.ok else "page-evict: the selftest refused --\n${out.out_brief}\n${out.err_brief}"

# invariant: residency fell to zero on a synced file, so the advice reached the cache rather than
# being accepted and ignored.
assert out.out contains "residency fell" else "page-evict: the selftest named no residency fall"

# invariant: both refusal shapes are named -- a path plainly outside, and a sibling whose name
# merely begins the way this root does, which a prefix test alone would welcome.
assert out.out contains "no peer's pages are reachable" else "page-evict: the refusal legs did not report"

assert out.out contains "GREEN: page-evict" else "page-evict: the selftest reached no green line"

say "page-evict: the control -- every refusal planted on a real path and required to bite..."
let ctl = run ["sh" "tools/fixtures/p/page_evict_control.sh"]
say ctl.out
assert ctl.ok else "page-evict: the control refused --\n${ctl.out_brief}\n${ctl.err_brief}"
# invariant: the control ran every case it planted and none failed. Reading the verdict alone would
# pass a control that reached its last line having proven nothing.
assert ctl.out contains "fail=0" else "page-evict: a control case failed -- read its own lines above"
assert ctl.out contains "control_verdict=ok" else "page-evict: the control reached no verdict"

say "GREEN: page-evict -- this tree's pages drop on request, and every path outside it refuses."
