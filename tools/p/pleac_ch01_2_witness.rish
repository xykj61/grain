# tools/p/pleac_ch01_2_witness.rish -- PLEAC 1.2: the value finally has a voice.
#
# Positive space: the speaking gate lowers, builds, runs, and its answer
# reaches stdout -- the assert recipe 1.1 could not make now passes. Negative
# space: the runner still refuses a second sample by name.

let zig = "vendor/zig-toolchain/zig"
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "edu/pleac/ch01/gate-say-u32.glow" "21"]
assert gate.ok else "pleac 1.2: lower/build/run failed"
assert gate.out contains "EXIT:0" else "pleac 1.2: the desk did not exit 0"

let answer = run ["./glow/bin/gate-say-u32" "21"]
assert answer.ok else "pleac 1.2: the built gate refused its lawful sample"
assert answer.out contains "21" else "pleac 1.2: the gate did not speak its sample"

let bad = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "edu/pleac/ch01/gate-say-u32.glow" "21" "9"]
assert bad.out contains "FAIL" else "pleac 1.2: a second sample should refuse by name"

say "GREEN: pleac 1.2 — the gate speaks; every future witness may now assert a value."
