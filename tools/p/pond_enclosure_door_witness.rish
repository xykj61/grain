# tools/p/pond_enclosure_door_witness.rish -- the door the record cannot name, proven rather than promised.
#
#   rishi/bin/rishi run tools/p/pond_enclosure_door_witness.rish
#
# WHAT THIS HOLDS. Orbit four of the quest that retires ai-jail is "the doors" -- the launchers enter
# through Pond instead of the jail, done when a full working chapter lap runs start to finish inside a
# Pond enclosure. Three guards already read this enclosure and all three read the ROOM:
# pond_policy_launcher_witness.rish reads the flags the launcher spells, pond_enclosure_built_witness.rish
# reads the plan the jail builds, and pond_enclosure_ephemeral_witness.rish reads how long a written
# byte lasts. This one reads the DOOR -- which program walks in, carrying which environment, as which
# user -- which is the launcher's own last line and nothing the record has a key for.
#
# THE TWO LEGS. The derived leg reads Pond's record against the launcher's exec line: a host path is
# reachable inside when a `map`, `persist`, or `rw-map` destination covers it and no `mask` line
# covers it more closely, and the entry -- the one binary the enclosure exists to start -- is gated at
# zero unreachable. The metal leg starts one real enclosure and asks it the same questions, gating any
# disagreement at zero, because a reachability derived from a record and never checked against a
# kernel is a claim.
#
# THE RULE THE METAL TAUGHT: A MAP CARRIES WHAT THE HOST HAS, AND CONJURES NOTHING. Measured
# `20260829` on this pier, two of the four elements of the launcher's own search path are absent
# inside, for two different reasons -- `/nix/var/nix/profiles/default/bin` is declared by `map /nix`
# and the host never made it, while `${HOST_HOME}/.nix-profile/bin` exists on the host and
# `private-home yes` dissolves it. Only the probe tells those two apart, and the derivation predicted
# both, so the reading is the kernel's rather than the record's optimism.
#
# THE GAP, COUNTED. Three door duties -- `entry`, `env`, `user` -- have no key in the record's grammar
# at all. That is orbit four's own measure of distance: an enclosure Pond declares has to answer each
# of them, and today the record cannot state the question. The count reads zero the day it can.
#
# THE READING BESIDE IT. active-designing/20260829-064107_the-door-the-record-cannot-name.md carries
# the argument this guard only counts: the door's four parts, the metal reading element by element,
# and what seating each of the three duties would cost.
#
# WHAT THIS DOES NOT REACH. Whether the launcher's dead search-path elements SHOULD be removed.
# Repairing that line edits a script every unattended lap on this pier executes, so the count is a
# ratchet under a ceiling that only falls and the edit is a seat rather than a sweep.
#
# ACCRETE-ONLY. This reads Pond's record and the launcher's own exec line and rewrites neither. The
# probe leg starts one enclosure and writes no byte on either side of the threshold. The ENCLOSURE
# selector stays ai-jail until the switchover round lands behind its audit.

say "enclosure-door: Language EN -- a room an agent cannot enter is a room, so the reading follows the program across the threshold."
say "enclosure-door: Style Gauge, Meter -- each note names the path and why it arrives or does not, so a count becomes a line to open."
say "enclosure-door: Lens TAME -- safety first: the search path and the env roster are both bounded, both gates are proven from both sides, and the metal leg refuses to be skipped where it could have run."

let control = run ["sh" "tools/fixtures/p/pond_enclosure_door_control.sh"]
assert control.ok else "enclosure-door: the control must complete -- ${control.out}"
say control.out
assert control.out contains "control_failures=0" else "enclosure-door: every planted behavior must hold"
assert control.out contains "control_verdict=ok" else "enclosure-door: the control must report ok"
assert control.out contains "entry_undeclared_refuses=yes" else "enclosure-door: an entry under no declared subtree must refuse"
assert control.out contains "entry_declared_passes=yes" else "enclosure-door: a reachable entry must pass free"
assert control.out contains "entry_masked_refuses=yes" else "enclosure-door: a masked entry must refuse whatever maps the subtree above it"
assert control.out contains "ceiling_at_bound_passes=yes" else "enclosure-door: the ceiling must be proven from the passing side"
assert control.out contains "ceiling_one_past_refuses=yes" else "enclosure-door: the ceiling must be proven from the refusing side"
assert control.out contains "lift_no_jail_path_refuses=yes" else "enclosure-door: a launcher that stops publishing its search path must refuse rather than guess"
assert control.out contains "lift_no_exec_refuses=yes" else "enclosure-door: a launcher that stops publishing its exec line must refuse rather than guess"
assert control.out contains "duties_declared_counted=yes" else "enclosure-door: a record that grows keys for the door duties must read zero"

let scan = run ["sh" "tools/fixtures/p/pond_enclosure_door_scan.sh"]
assert scan.ok else "enclosure-door: the derived reading must complete -- ${scan.out}"
say scan.out
assert scan.out contains "entry_unreachable=0" else "enclosure-door: the enclosure must be able to start the program it exists to run"
assert scan.out contains "verdict=ok" else "enclosure-door: the derived reading must read ok"
assert scan.out contains "probe_read=no" else "enclosure-door: an ordinary run starts no enclosure"

let jail = run ["sh" "-c" "command -v ai-jail >/dev/null 2>&1 && echo JAIL_PRESENT || echo JAIL_ABSENT"]
assert jail.ok else "enclosure-door: the host reading must complete"
say jail.out
if (jail.out contains "JAIL_ABSENT") then say "enclosure-door: ai-jail is absent here, so the metal leg is skipped by the host rather than by the guard, and the derived reading above stands alone."
if (jail.out contains "JAIL_PRESENT") then say "enclosure-door: ai-jail stands here, so the reading below is the kernel's own answer and a skip refuses."

let probe = run ["sh" "tools/fixtures/p/pond_enclosure_door_scan.sh" "--probe"]
assert probe.ok else "enclosure-door: the probe run must complete -- ${probe.out}"
say probe.out
assert probe.out contains "door_disagreements=0" else "enclosure-door: the kernel and the record must agree about what the door carries"
assert probe.out contains "verdict=ok" else "enclosure-door: the probe run must read ok"

say "GREEN: pond enclosure-door -- the entry is reachable, every search-path element answers as derived, and the three duties the record cannot name are counted where a reader finds them."
