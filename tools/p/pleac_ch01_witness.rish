# tools/p/pleac_ch01_witness.rish -- PLEAC chapter one keeps its promise.
#
# Positive space: the page's desk lowers, builds, and the gate runs its one
# @u32 sample clean. Negative space: the runner refuses a second sample by
# name. The value itself answers silently today -- the page's own finding --
# so speaking it aloud is recipe 1.2's whole subject, never this assert.

let zig = "vendor/zig-toolchain/zig"
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "edu/pleac/ch01/gate-pleac-double-u32.glow" "21"]
assert gate.ok else "pleac ch01: lower/build/run failed"
assert gate.out contains "EXIT:0" else "pleac ch01: the desk did not exit 0"

let answer = run ["./glow/bin/gate-pleac-double-u32" "21"]
assert answer.ok else "pleac ch01: the built gate refused its lawful sample"

let bad = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "edu/pleac/ch01/gate-pleac-double-u32.glow" "21" "9"]
assert bad.out contains "FAIL" else "pleac ch01: a second sample should refuse by name"

say "GREEN: pleac ch01 — the first gate runs clean, refuses excess, and the cookbook is open."
