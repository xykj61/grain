# ABSENT is exit-0 with the restore line — count it; never soften a true RED.
if (receipt_verify_wasm.out contains "ABSENT: wasmtime") then say "ABSENT: wasmtime — receipt_verify_wasm counted; suite PARTIAL"
if ((receipt_verify_wasm.out contains "ABSENT: wasmtime") == false) then assert receipt_verify_wasm.ok
if ((receipt_verify_wasm.out contains "ABSENT: wasmtime") == false) then say "GREEN: receipt-verify Wasmtime guest witness passed."

