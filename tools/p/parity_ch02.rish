let _parity_cost_table = run ["env" "PARITY_COST_CHAPTER=ch02" "PARITY_COST_LOG=tools/.cache/parity-cost/current.tsv" "sh" "tools/p/parity_cost_table.sh"]
if _parity_cost_table.ok then say _parity_cost_table.out
if _parity_cost_table.ok == false then say _parity_cost_table.err
