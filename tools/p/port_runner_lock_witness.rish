# tools/p/port_runner_lock_witness.rish -- which standing guards BIND a port, and which hold a lock.
#
# WHY THIS RUNG, beside the one that counts the numbers. `tools/p/port_band_witness.rish` reads the
# port constants our modules declare and names every number two modules share. That answers *can
# two modules meet*. A fleet pass asks a different question: *does the roster run a binder at all,
# and is that run held apart from the seven other ships running the same guard on the same machine
# at the same second*. REDS %700 is the bill for leaving the second question unasked -- a rostered
# witness read red on one cold endurance run and green on a re-run over an unchanged tree, and naming the
# cause took a fortnight.
#
# THE SHARED NUMBER WAS NEVER THE WHOLE EXPOSURE, and the living reading is why. Of the three
# numbers two modules share -- 38495, 38496, 38497 -- only ONE side of one pair is rostered, so a
# roster pass never runs both claimants of any of them. What a roster pass DOES run is the SAME
# guard, on eight checkouts, against one machine. A guard binding 38498 collides with itself seven
# times over, and a reading that counts modules per number reports zero for that.
#
# THE TWO QUESTIONS CROSS, AND THE CROSSING DECIDES THE INSTRUMENT.
#   unlocked, no SO_REUSEADDR -- the kernel refuses the second bind, so the pass reds and a re-run
#     passes. LOUD. It costs a re-run, and it is held as a RATCHET that only falls.
#   unlocked, sets SO_REUSEADDR -- both sockets bind and the kernel splits the datagrams between
#     them with no refusal at all. SILENT. It costs a fortnight, because every reading of it is
#     plausible. It is held as a WALL at zero.
#
# BUILD AND RUN ARE TWO FACTS WEARING ONE WORD. A guard that writes `rye build <module>.rye
# -femit-bin=<target>` has compiled a binder and bound nothing. Only a later `run` naming that same
# target binds. `tools/am/amphora_mark_wreck_witness.rish` compiles `amphora/vessel_fetch_delivery.rye`
# to prove it still compiles and never executes it, so charging it with an exposure would be
# charging a guard for a fault it cannot have.
#
# RISHI SPELLS ONE REFERENCE TWO WAYS, and the first draft of the scan read one of them. A variable
# is `${bin}` inside a string and bare `bin` as an array element, so
# `run ["sh" "-c" "${bin} selftest"]` and `run ["sh" lock "38490" "sh" probe bin "38491"]` name the
# same binary in two forms. The interpolated-only reading called
# `tools/m/mantra_udp_reuseaddr_witness.rish` a builder that runs nothing -- and it runs, under a
# lock. That is REDS %717's lesson one room over: a roster reading one spelling reports the
# spelling, never the tree. Both the target and the lock are resolved through the file's own
# `let name = "literal"` bindings before anything is compared, and the pen proves both spellings.
#
# AND A SIBLING PATH IS NOT THE BINARY. `tools/f/fora_socket_witness.rish` writes
# `let outfile = "constel/bin/socket.out"` beside `let bin = "constel/bin/socket"`, so a bare
# substring test charged ten `cat ${outfile}` lines as executions. The target must end at a
# character that cannot continue a path.
#
# WHAT STANDS TODAY, measured `20260911` -- run the scan rather than trusting these figures, since
# only the two gated ones are held still. Five rostered guards build a constant-port binder and
# four run it; two runs are held under a lock and FOUR are open, all four of binders that set no
# SO_REUSEADDR. So the silent cell is empty and the loud cell holds four:
#   tools/co/comlink_rehearsal_wire_witness.rish  lines 31 and 41  comlink/rehearsal_wire.rye 38498
#   tools/f/fora_socket_witness.rish              lines 43 and 82  constel/socket.rye         38512
# Each repair is a choice inside another lane -- a lock, or the bind-to-zero handshake those rooms
# already know -- so the four are NAMED for their owners and left for those hands.
#
#   rishi/bin/rishi run tools/p/port_runner_lock_witness.rish

say "port-runner-lock: Language EN -- a build compiles a binder; only a run binds one."
say "port-runner-lock: Style Gauge, Meter -- refusal is the subject."
say "port-runner-lock: Lens TAME -- safety first: a silent collision outlives every reading of it."
say "port-runner-lock: eight ships run one roster against one machine, so a guard meets itself."

# THE CEILING LIVES IN THE SCAN, which is where every ratchet in this room keeps one, so a reader
# raising or lowering it edits one file. It only falls: a lane that locks one of the four lowers it
# in the same commit, and a new unlocked run makes the scan refuse on the lap it arrives.

# THE CAPTURE IS SAID ONCE, BARE, ABOVE THE ASSERTS THAT READ IT -- an interpolated `else` clause
# repeating a reading the bare `say` already printed costs Rishi's 4,096-byte compose buffer on the
# failing path and hands a reader nothing new (`tools/fixtures/s/say_compose_bound_scan.sh`).
let scan = run ["sh" "tools/fixtures/p/port_runner_lock_scan.sh" "--list"]
say scan.out
assert scan.ok else "port-runner-lock: the scan exited non-zero -- its whole reading stands above this line"
assert scan.out contains "verdict=ok" else "port-runner-lock: the scan must balance before it is believed -- its reading stands above"
assert scan.out contains "unlocked_ceiling=4" else "port-runner-lock: the ceiling moved -- read the listing above and change this line with it"
assert scan.out contains "unlocked_reusing=0" else "port-runner-lock: an unlocked run of a binder that sets SO_REUSEADDR splits its datagrams in silence -- the reading above names the line"

let control = run ["sh" "tools/fixtures/p/port_runner_lock_control.sh"]
say control.out
assert control.ok else "port-runner-lock: the control must complete -- its whole output stands above this line"
assert control.out contains "control_failed=0" else "port-runner-lock: a control leg refused, so no reading above is believable -- the failing leg names itself"
assert control.out contains "control_verdict=ok" else "port-runner-lock: the control must name its own verdict rather than merely exiting zero"

# THE LEG COUNT IS ASSERTED, so a leg written tomorrow is heard the day it lands. A control that
# reaches its last line proves only that it reached its last line.
assert control.out contains "legs=38" else "port-runner-lock: the pen's leg count moved -- read the control and raise this number with it"

# Each cell of the crossing, named, so no one of them can fall silent behind the tally.
assert control.out contains "leg: clean_verdict ok" else "port-runner-lock: a clean tree must pass free"
assert control.out contains "leg: build_only_runners ok" else "port-runner-lock: compiling a binder must charge nothing"
assert control.out contains "leg: loud_unlocked ok" else "port-runner-lock: an unlocked run must be counted"
assert control.out contains "leg: silent_wall ok" else "port-runner-lock: the wall must bite an unlocked reusing run"
assert control.out contains "leg: silent_verdict ok" else "port-runner-lock: the wall must name its verdict rather than only counting"
assert control.out contains "leg: loud_at_ceiling_free ok" else "port-runner-lock: a ratchet standing exactly at its ceiling must pass free"
assert control.out contains "leg: loud_over_ceiling_refused ok" else "port-runner-lock: a ratchet one past its ceiling must refuse"
assert control.out contains "leg: silent_lifted ok" else "port-runner-lock: lifting the plant must return the wall to zero"
assert control.out contains "leg: locked_held ok" else "port-runner-lock: a lock spelled inline must read as held"
assert control.out contains "leg: bare_held ok" else "port-runner-lock: a lock named through a bare variable must read as held"
assert control.out contains "leg: bare_runners ok" else "port-runner-lock: a binary named through a bare variable must read as run"
assert control.out contains "leg: sibling_runners ok" else "port-runner-lock: a sibling path must never read as the binary"
assert control.out contains "leg: off_roster_seated_unlocked ok" else "port-runner-lock: the filter must be the roster rather than the file"
assert control.out contains "leg: zero_port_modules ok" else "port-runner-lock: a kernel-chosen port is the cure, never the exposure"
assert control.out contains "leg: no_roster_verdict ok" else "port-runner-lock: a tree with no roster must refuse by name rather than read zero"

say "port-runner-lock: GREEN -- no unlocked run binds a socket that would share its address in silence, and the loud four stand named under a ceiling that only falls."
