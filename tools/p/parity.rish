# parity.rish — behavior regression suite (chaptered under Rishi Env[512]).
#
# Each chapter runs in a fresh Rishi process so bindings reset. The former
# monolith hit TooManyBindings (~330 user lets + exit-* prebinds) at lantern_lap23;
# Env raised 256 → 512 on 20260725 when parity_ch01 alone reached 302 lets.
#
# S0 (counsel 20260726.044729): per-witness wall times via tools/p/parity_time_one.sh;
# closing cost table (top 20 + chapter totals) via tools/p/parity_cost_table.sh;
# WIP report when PARITY_COST_REPORT=1 (default here). Zig caches seated at
# tools/.cache/zig/{local,global}. Applies to this driver and both chapters.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/p/parity.rish
#
# Host-tool preflight (counsel 20260725.223409): wasmtime ABSENT surfaces in
# seconds with the restore line. Suite summary becomes PARTIAL while any ABSENT
# stands — never suite GREEN, never a false RED for a missing host tool.

let seat = run ["sh" "tools/p/parity_zig_cache_seat.sh"]
say seat.out

let cost_init = run ["sh" "-c" "mkdir -p tools/.cache/parity-cost && : > tools/.cache/parity-cost/current.tsv && echo suite > tools/.cache/parity-cost/chapter && echo cost_init_ok"]
say cost_init.out

let preflight = run ["sh" "tools/p/parity_time_one.sh" "preflight" "--" "sh" "tools/fixtures/wasmtime_preflight.sh"]
assert preflight.ok else "wasmtime preflight script failed"
if (preflight.out != "") then say preflight.out

say "witness suite: chapter 1/2…"
let ch1 = run ["env" "PARITY_COST_RESET=0" "PARITY_COST_CHAPTER=ch01" "PARITY_COST_LOG=tools/.cache/parity-cost/current.tsv" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/p/parity_ch01.rish"]
if ch1.ok == false then say "parity chapter 1 output (failure detail):"
if ch1.ok == false then say ch1.out
if ch1.ok == false then say "parity chapter 1 stderr:"
if ch1.ok == false then say ch1.err
assert ch1.ok else "parity chapter 1 failed"
say "GREEN: parity chapter 1/2 passed."

say "witness suite: chapter 2/2…"
let ch2 = run ["env" "PARITY_COST_RESET=0" "PARITY_COST_CHAPTER=ch02" "PARITY_COST_LOG=tools/.cache/parity-cost/current.tsv" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/p/parity_ch02.rish"]
if ch2.ok == false then say "parity chapter 2 output (failure detail):"
if ch2.ok == false then say ch2.out
if ch2.ok == false then say "parity chapter 2 stderr:"
if ch2.ok == false then say ch2.err
assert ch2.ok else "parity chapter 2 failed"
say "GREEN: parity chapter 2/2 passed."

say "witness suite: Glow cell-pack demo vectors…"
let jamcue = run ["env" "PARITY_COST_CHAPTER=trail" "sh" "tools/p/parity_time_one.sh" "jamcue" "--" "env" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/g/glow_jamcue_vectors_witness.rish"]
assert jamcue.ok else "glow cell-pack demo vectors witness failed"
say "GREEN: Glow cell-pack demo vectors passed."

say "witness suite: Rishi glow mode SLC…"
let glow_repl = run ["env" "PARITY_COST_CHAPTER=trail" "sh" "tools/p/parity_time_one.sh" "glow_repl" "--" "env" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/g/glow_repl_witness.rish"]
assert glow_repl.ok else "glow repl witness failed"
say "GREEN: Rishi glow mode SLC passed."

say "witness suite: waymark derive corpus pin…"
let waymark = run ["env" "PARITY_COST_CHAPTER=trail" "sh" "tools/p/parity_time_one.sh" "waymark" "--" "env" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/w/waymark_derive_witness.rish"]
assert waymark.ok else "waymark derive witness failed"
say "GREEN: waymark derive corpus pin passed."

say "witness suite: Rishi max_list_items=1024…"
let list_bound = run ["env" "PARITY_COST_CHAPTER=trail" "sh" "tools/p/parity_time_one.sh" "list_bound" "--" "env" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/r/rishi_list_bound_witness.rish"]
assert list_bound.ok else "rishi list bound witness failed"
say "GREEN: Rishi max_list_items=1024 passed."

say "witness suite: Glow digraph-table twin…"
let digraph = run ["env" "PARITY_COST_CHAPTER=trail" "sh" "tools/p/parity_time_one.sh" "digraph" "--" "env" "ZIG_LOCAL_CACHE_DIR=tools/.cache/zig/local" "ZIG_GLOBAL_CACHE_DIR=tools/.cache/zig/global" "rishi/bin/rishi" "run" "tools/g/glow_digraph_twin_witness.rish"]
assert digraph.ok else "glow digraph twin witness failed"
say "GREEN: Glow digraph-table twin passed."

say "witness suite: suite cost table (S0)…"
let cost_table = run ["env" "PARITY_COST_REPORT=1" "PARITY_COST_LOG=tools/.cache/parity-cost/current.tsv" "sh" "tools/p/parity_cost_table.sh"]
if cost_table.ok then say cost_table.out
if cost_table.ok == false then say cost_table.err
assert cost_table.ok else "parity cost table failed"

# Third word: any ABSENT withholds suite GREEN (counsel 20260725.223409).
if (ch2.out contains "ABSENT: wasmtime") then say "PARTIAL — chapters green · 0 red · 1 absent(wasmtime)"
if (ch2.out contains "ABSENT: wasmtime") then exit 0
say "GREEN: full witness suite — chapters · jam/cue · glow REPL · waymark · list1024 · digraph twin."
