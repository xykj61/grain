# tools/mycelium_puddle_convergence_witness.rish — the Puddle heals: a host departs, and only its worlds
# re-berth (r2, convergence with minimal disruption).
#
# Season D (Kresfa & Mycelium) · Puddle fleet orchestration · rung r2 — the fleet heals.
# r1 fixed the berth (placement a pure function of the fleet, derived by highest weave-score, invariant
# under arrival order). r2 proves the property that method was CHOSEN for over hash-mod-count — MINIMAL
# DISRUPTION. When a host departs, a fleet must re-place the worlds it carried without reshuffling everyone;
# a mass migration is its own outage. Under generous capacity the berth is exactly pure HRW, so removing one
# host moves ONLY the worlds that had berthed there (their next-highest-score host receives them) and leaves
# every world on a surviving host exactly where it was. The symmetric join is minimal too — a newcomer only
# pulls the worlds it now wins, never reshuffling the hosts already there.
#
# The crux this witness proves is A HOST DEPARTS AND ONLY ITS WORLDS RE-BERTH: composes r1's public API
# only, editing r1 nothing (the r1 berth re-runs GREEN at the door); demo host and world seeds — no key, no
# funds, no network, no world provisioned.
#
# Scope: active-designing/date/20260813/20260813-114651_puddle-fleet-placement-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_puddle_convergence_witness.rish

say "mycelium-puddle-convergence: Language EN — a fleet that loses a host should lose one node's worth of work, never a whole migration: highest weave-score re-places only the worlds of the host that changed, and leaves every other world exactly where it stood."
say "mycelium-puddle-convergence: Style Radiant — r1 derived the berth; r2 shows why highest weave-score, not hash-mod-count, was the honest choice — the fleet heals around a failure with the least disturbance a placement can make."
say "mycelium-puddle-convergence: Lens TAME — the heal composes r1 public API only, editing r1 nothing; the after-fleet is built from the surviving hosts and re-berthed; every claim is a byte-comparison of host public keys; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/puddle_convergence"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/puddle_convergence.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-puddle-convergence: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-puddle-convergence: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-puddle-convergence: selftest did not speak GREEN"
assert selftest.out contains "a host departs and only its worlds re-berth" else "mycelium-puddle-convergence: departure crux claim missing"
assert selftest.out contains "every world on a surviving host stays byte-identical" else "mycelium-puddle-convergence: survivor-stays claim missing"
assert selftest.out contains "the symmetric join is minimal too" else "mycelium-puddle-convergence: join claim missing"
assert selftest.out contains "Convergence stands" else "mycelium-puddle-convergence: closing claim missing"

# The r1 berth the healing rests on stands at the door — its own selftest proves the derived placement.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/puddle.rye -femit-bin=mycelium/bin/puddle && mycelium/bin/puddle 2>&1"]
assert r1.ok else "mycelium-puddle-convergence: the r1 berth the healing rests on is not GREEN"
assert r1.out contains "GREEN" else "mycelium-puddle-convergence: the r1 berth did not speak its GREEN"

say "mycelium-puddle-convergence: GREEN — the fleet heals with minimal disruption: a departed host's worlds re-berth onto survivors, every other world stays byte-identical, and a newcomer only pulls the worlds it wins; the r1 berth stands at the door. Convergence stands."
