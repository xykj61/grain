# tools/fora_switchboard_witness.rish — a switchboard routes a whole local constellation by name (FORA6).
#
# Season: the Six-Season double-seat, Season D/F thread · waymark FORA · Constel test-network naming · rung FORA6.
# Design read: active-designing/20260814-045802_fora6-constel-switchboard-multi-pier.md
# Law kin: .claude/rules/placeholder-ship-names.md — the switchboard routes but never re-checks: a greeting routed through a
# mailbox but carrying a smuggled vowel still refuses VowelPresent at wire.deframe. The FORA3 gates keep the only trust.
#
# constel/switchboard.rye stands a bounded set of per-pier byte queues — one channel.Channel mailbox per member of a roster —
# the first rung that lets three or more fake piers meet through one shared medium. Its one new concern is routing a frame to
# the right pier by name. The selftest proves: a constellation of three stands up; two members agree routed through the
# switchboard; the bystander's mailbox stays silent; a stranger's name refuses NoSuchPier; a pier reads only its own mail; and
# the naming-law border still guards the medium. Purely local — no socket, no network, no keys, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/fora_switchboard_witness.rish

say "fora-switchboard: Language EN — FORA6 stands a switchboard, one mailbox per fake pier, the first rung that lets three or more piers meet through one shared medium; its one new concern is routing a frame to the right pier by name — the whole local constellation, proven pure before any socket."
say "fora-switchboard: Style Radiant — the switchboard is the only thing two piers share; each still holds only its own view and reads only its own mail, and the FORA3 gates keep the only trust."
say "fora-switchboard: Lens TAME — a bounded array of fixed-buffer mailboxes, every fault failing closed by name (NoSuchPier · NeedMoreBytes · ChannelFull); siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/switchboard"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/switchboard.rye -femit-bin=${bin}"]
assert build.ok else "fora-switchboard: build failed — ${build.err}"

let outfile = "constel/bin/switchboard.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "fora-switchboard: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "fora-switchboard: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN fora-switchboard' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "fora-switchboard: selftest did not print the GREEN fora-switchboard line"

say "fora-switchboard: GREEN — a whole local constellation routes by name; the gated Comlink round need only back each mailbox with a real socket (the seam-crossing that stays Keaton's check-in)."
