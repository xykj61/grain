# caravan_stall_witness.rish -- Caravan stalled-consumer witness.
#
# Proves what happens when a peer stops reading. `fanin.rye` bounded each
# sweep per stream so a busy producer could never delay a quiet one, and
# every consumer in that ring kept draining. The moment one goes silent, a
# question opens that fairness alone cannot answer: the server holds a full
# queue for a client whose tail has not moved, and another answer is ready.
#
# Three doors stand open, and only one of them is a system.
#
# Blocking is the door that looks safest and is worst -- a server waiting on
# a stalled tail hands one silent domain the power to stop every other
# domain it serves. Refusing keeps every byte: nothing written for that
# stream, the refusal reported, the next stream reached on the same pass.
# Lapsing keeps moving: written anyway, the oldest unread answers falling
# out of the window, and the consumer learning exactly how many it missed
# the moment it wakes.
#
# Which door a stream takes is declared per stream, and a pass naming fewer
# doors than it holds streams is refused rather than defaulted.
#
# Both RED paths were proven on metal before this witness was written.
# Returning `QueueFull` for the whole pass on one full stream -- the
# blocking door -- stopped the pass at `client_b` and never reached
# `client_a` at all, so a consumer with an empty queue was served zero by a
# peer it shares nothing with. Dropping the window resync in the drain made
# the loss silent: the bound assert fired first (`taking` past the queue's
# width), and with that bound relaxed too, `client_b` read the answer
# standing in slot zero, found number 4 where it expected 0, and answered
# `bytes differed` -- a mismatch instead of a count.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_stall_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/stall"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/stall.rye -femit-bin=${bin}"]

assert build.ok else "caravan stall build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# The declaration stands unchanged. A stalled consumer needs no new wiring:
# the answer direction of each channel is already granted, so the regions
# that carried asks toward the server carry answers back.
let decl = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_two_clients.bron 2>&1"]
assert decl.ok else "the two-client declaration could not be read"
assert decl.out contains "domains 3 -- channels 2 -- regions 4 -- grants 8" else "the two-client declaration changed shape"
assert decl.out contains "verdict: whole" else "the two-client declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan stall selftest exited non-zero"
assert test.out contains "GREEN" else "caravan stall selftest not GREEN"
assert test.out contains "a stalled peer costs its own stream alone, and its loss is a number" else "the stall claim did not close"

# The wire carries a declared door per stream. A stream that named no door,
# a door this ring never declared, and a stream that lost its own region are
# each refused rather than given whichever the code happened to prefer.
assert test.out contains "the answer wire pairs 2 streams whole, each with the door its plan declared" else "the answer wire did not read back"

# The stage the whole claim needs: both consumers filled to capacity, and
# then one of them stops reading and never starts again until the end.
assert test.out contains "serial_virt: wrote 4 answers to client_b" else "the consumer that goes silent was never filled"
assert test.out contains "serial_virt: answered 8 across 2 streams, refused 0, lapsed 0" else "the first pass did not serve both consumers"

# The refusing door: nothing written for the stalled stream, nothing lost,
# and the reading consumer served in full on the very same pass. The
# blocking RED probe stopped here and never reached `client_a`.
assert test.out contains "serial_virt: client_b full at 4 -- refused 2, nothing lost" else "the refusing door did not hold a full stream"
assert test.out contains "serial_virt: answered 2 across 2 streams, refused 2, lapsed 0" else "a refused stream stopped the pass"

# The lapsing door: written anyway, the oldest two falling out of the
# window, and the count named by the server as it happens.
assert test.out contains "serial_virt: client_b full at 4 -- lapsed 2 by policy" else "the lapsing door did not drop by policy"
assert test.out contains "serial_virt: answered 4 across 2 streams, refused 0, lapsed 2" else "the lapsing pass did not serve both streams"

# The crux, read from the reading consumer's own side: eight answers sent,
# eight drained, across three passes in which its sibling sat silent
# throughout. A stalled peer cost it nothing.
assert test.out contains "client_a: drained 4, lost 0" else "the reading consumer missed its first batch"
assert test.out contains "client_a: server wrote 8, drained 8" else "the reading consumer was delayed by its silent sibling"

# And the silent consumer waking: it knows its own tail, it can read the
# server's head, and a head standing further ahead than the queue is wide
# says exactly how many answers the window slid past. Arithmetic, out of
# two numbers neither side can forge.
assert test.out contains "client_b: drained 4, lost 2" else "the silent consumer did not count what it missed"
assert test.out contains "client_b: drain across 1 stream(s) -- Lapsed" else "a lapse was reported as plain success"
assert test.out contains "client_b: server wrote 6, drained 6" else "the silent consumer did not settle empty"

# The totals, measured across the whole run.
assert test.out contains "12 answers drained across 3 passes of 6 streams while one consumer slept" else "the run did not carry a stalled consumer"
assert test.out contains "4 directed bells provisioned silent across 2 declared channels" else "the run did not start silent both ways"
assert test.out contains "the reading consumer took 8 of 8 on every pass, and the silent one named the 2 it lost" else "the stall claim did not close"

# The wall that makes a lapse honest at all: a server able to advance a
# consumer's tail could mark every dropped answer read and leave nothing to
# count. It holds read alone on that region.
assert test.out contains "serial_virt: overrun across 1 stream(s) -- WriteDenied" else "a server moved a consumer's own tail"
assert test.out contains "a server holds read alone on a consumer's tail -- WriteDenied" else "the tail wall did not close"

# And the wall that keeps policy in the declaration: a pass naming fewer
# doors than streams is refused, never quietly defaulted.
assert test.out contains "serial_virt: refused a plan it could not read" else "a stream without a declared door was given one"
assert test.out contains "a pass naming fewer doors than streams is refused, never defaulted" else "the policy wall did not close"

say "GREEN: Caravan stall witness passed."
