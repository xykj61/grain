# tools/cl/cluster_tree_radius_witness.rish -- the center of a cluster skeleton and the reach from it, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/cluster_tree_diameter.rye reads the DIAMETER, the GREATEST farthest-reach of any cluster (its two
# poles the leaves), off the ECCENTRICITY of each cluster. This rung reads the same eccentricity vector from its OTHER end: its MINIMUM, the
# RADIUS, and the cluster that holds it, the CENTER. tree_radius reads the whole-tree smallest eccentricity, tree_center names the cluster reaching
# all others for the least (lowest id on a tie), is_center the center test. Exact integers, NO float, NO tolerance.
#
# The crux this witness proves on metal, three shapes: THE RADIUS MEETS THE BOTTLENECK WHILE THE DIAMETER EXCEEDS IT -- over the three-cluster star
# (edges 1-2 gap 2, 1-3 gap 3) the hub's eccentricity is its single longest bridge (3), so the radius (3) equals the bottleneck while the diameter
# (5) exceeds it, the center the hub and never a pole; THE CENTER IS INVARIANT YET THE RADIUS CLIMBS -- over the four-cluster star (arms 3, 3, 9)
# the center stays the hub while the radius climbs 3 -> 9 with the far member; THE CENTER IS A MIDDLE ID, NOT THE LOWEST -- over a symmetric path
# (chain 1-2-3, edges both gap 3) the center is the MIDDLE cluster 2, and the diameter (6) equals twice the radius (6), the upper bound met. A
# lone-cluster layout is its own center. Determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cl/cluster_tree_radius_witness.rish

say "cluster_tree_radius: Language EN -- Season G the center of a cluster skeleton and the reach from it; tree_radius reads the whole-tree smallest eccentricity, tree_center names the cluster reaching all others for the least, is_center the center test; NO float, NO tolerance."
say "cluster_tree_radius: Style Radiant -- compose not braid: this rung owns only the radius and center reads (the minimum over the eccentricities, the argmin, the center test); cluster_tree_diameter owns tree_eccentricity, tree_diameter, and is_diameter_endpoint cross-checked here never re-derived, cluster_minimum_spanning_tree owns build_mst and the bottleneck, cluster_graph owns the matrix a level below. A reading over a reading over a reading over a reading over a reading over a reading over a reading over a reading over a reading."
say "cluster_tree_radius: Lens TAME -- the cluster count can never exceed the object ceiling, so the radius scan runs one eccentricity walk per cluster, each bounded by the n-1 edges; a zero or past-the-count cluster id refuses BadClusterId, a lone-cluster layout is its own center; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/cluster_tree_radius"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/cluster_tree_radius.rye -femit-bin=${bin}"]
assert build.ok else "cluster_tree_radius: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "cluster_tree_radius: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "cluster_tree_radius: ${out}"

assert selftest.out contains "GREEN image-cluster-tree-radius" else "cluster_tree_radius: selftest did not print the GREEN line"
assert selftest.out contains "THE RADIUS MEETS THE BOTTLENECK WHILE THE DIAMETER EXCEEDS IT" else "cluster_tree_radius: the radius-meets-bottleneck case did not print"
assert selftest.out contains "is_center(1) TRUE while is_diameter_endpoint(1) FALSE" else "cluster_tree_radius: the center-never-a-pole fact did not print"
assert selftest.out contains "THE CENTER IS INVARIANT YET THE RADIUS CLIMBS" else "cluster_tree_radius: the center-invariant case did not print"
assert selftest.out contains "THE CENTER IS A MIDDLE ID, NOT THE LOWEST" else "cluster_tree_radius: the middle-id case did not print"
assert selftest.out contains "the diameter (6) EQUALS twice the radius (6)" else "cluster_tree_radius: the upper-bound-met fact did not print"

say "cluster_tree_radius: GREEN on metal -- the handle a surface hangs a connected group from, the cluster nearest to all of them at once, the smallest farthest-reach along the minimum spanning tree's bridge edges, the radius meeting the bottleneck while the diameter exceeds it, exact integers with NO float and NO tolerance; the center names the cluster a whole region hangs from, not a pole of its span."
