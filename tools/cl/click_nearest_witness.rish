# tools/cl/click_nearest_witness.rish -- the THREE-CLICK NEAREST relation on metal: turn THREE points into THREE whole-group selections (an ANCHOR tap
# plus two CANDIDATE taps), then read which candidate's group sits NEARER the anchor's group by the true inter-group gap, lifting
# image/click_relation.rye's click_pair_distance from a PAIR of taps to a TRIPLE through image/hit_test.rye and image/overlap_clusters.rye's cluster_of
# (Season G).
#
# Season G (Open Media Primitives) -- image/click_relation.rye reads how TWO tapped groups stand together (same-group, gap, frame overlap). This rung
# adds the third tap: an anchor and two candidates, answering "of these two, which is closer to that one." image/hit_test.rye names the ONE object
# under a point, image/overlap_clusters.rye's cluster_of names the connected group, image/cluster_adjacency.rye's cluster_distance reads the true gap.
# A reading over readings -- no plane of its own, no pixel written.
#
# The crux this witness proves on metal: nearness is a GROUP fact, not a PIXEL fact -- the candidate whose GROUP sits nearer the anchor's group can be
# the candidate whose tapped PIXEL sits FARTHER from the anchor's tapped pixel. Over four singleton objects (A the anchor, B a large block group gap 2,
# C a small block group gap 6, F a block group gap 2): an anchor tap on A, a candidate tap on B's far corner, and a candidate tap on C read nearer_group
# FIRST (B nearer by group) though the B tap sits Chebyshev 8 from the anchor while the C tap sits 7; tapping B's near corner reads the SAME verdict
# (invariant to the tap site); B and F tie (two distinct groups equidistant); a candidate in the anchor's own group reads gap 0; a background tap
# refuses EmptyClick; a point off the map refuses PointOutOfBounds; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cl/click_nearest_witness.rish

say "click_nearest: Language EN -- Season G three-click nearest; nearness is a GROUP fact not a PIXEL fact, so the group-nearer candidate can be the pixel-farther tap, invariant to where within each group a keeper taps; NO float, NO tolerance."
say "click_nearest: Style Radiant -- compose not braid: this rung owns only the ternary comparison of two anchor-to-candidate gaps; click_relation owns click_pair_distance (the true group gap between two taps), hit_test owns the point-to-object arbiter, overlap_clusters owns cluster_of, cluster_adjacency owns cluster_distance. No plane of its own, no pixel written -- a reading over readings."
say "click_nearest: Lens TAME -- each click resolves to at most one label through the hit test, each gap read scans the object count bounded by label_max_pixels; a candidate in the anchor's own group reads gap 0 (no refusal), a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/click_nearest"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/click_nearest.rye -femit-bin=${bin}"]
assert build.ok else "click_nearest: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "click_nearest: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "click_nearest: ${out}"

assert selftest.out contains "GREEN image-click-nearest" else "click_nearest: selftest did not print the GREEN line"
assert selftest.out contains "the THREE-CLICK NEAREST relation" else "click_nearest: the three-click-nearest claim did not print"
assert selftest.out contains "nearness is a GROUP fact, not a PIXEL fact" else "click_nearest: the decisive crux did not print"
assert selftest.out contains "THE GROUP-NEARER CANDIDATE IS THE PIXEL-FARTHER TAP" else "click_nearest: the pixel-inversion claim did not print"
assert selftest.out contains "THE VERDICT IS INVARIANT TO WHERE INSIDE A GROUP A KEEPER TAPS" else "click_nearest: the invariance claim did not print"
assert selftest.out contains "TWO DISTINCT GROUPS CAN TIE" else "click_nearest: the tie claim did not print"
assert selftest.out contains "refuses EmptyClick by name" else "click_nearest: the EmptyClick refusal did not print"
assert selftest.out contains "the same triple reads the same verdict twice" else "click_nearest: determinism did not print"

say "click_nearest: GREEN on metal -- the three-click nearest relation, an anchor tap and two candidate taps resolving to three whole groups then compared by the true inter-group gap, the group-nearer candidate the pixel-farther tap, invariant to where within each group a keeper taps, two distinct groups tying, refusals by name, determinism. Season G open-media."
