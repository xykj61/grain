# tools/cl/cluster_facts_witness.rish -- the facts of each connected cluster of the scene's box-overlap graph, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/overlap_clusters.rye partitions a scene into the connected clusters of the box-overlap graph
# (who belongs to which cluster). This rung reads WHAT each cluster is: cluster_bbox the union frame its members span, cluster_area the
# total foreground substance, cluster_holed_count the holed members, largest_in_cluster the biggest member. Exact integers, NO float, NO
# tolerance.
#
# The crux this witness proves on metal, two shapes: THE CLUSTER FRAME OVER-CLAIMS MEMBERSHIP ACROSS CLUSTERS -- two bracket-L's reaching
# apart connect into one cluster whose union frame wholly contains a lone block belonging to a different singleton cluster, so the frame is
# a hint never the membership test; THE CLUSTER IS FRAMES NOT SUBSTANCE -- object_relation proves the members sit 2+ pixels apart, so the
# cluster's total area is far less than its frame's area, the frame covering the background between them. Refusals by name, determinism.
# No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cl/cluster_facts_witness.rish

say "cluster_facts: Language EN -- Season G per-cluster join; cluster_bbox the union frame a cluster's members span, cluster_area the total foreground substance, cluster_holed_count the holed members, largest_in_cluster the biggest member; NO float, NO tolerance."
say "cluster_facts: Style Radiant -- compose not braid: this rung owns only the per-cluster join, the union of member boxes and the aggregate reads over that subset; overlap_clusters owns the connectivity and cluster labeling, scene_graph owns the manifest, scene_manifest owns the per-object boxes and areas, object_relation owns each pair's exact distance. A reading over a reading over a reading."
say "cluster_facts: Lens TAME -- the scene graph caps its object count, so every member scan runs a bounded number of objects and every area sum stays under the pixel ceiling; a zero or past-the-count cluster id refuses BadClusterId, a facts read of an empty scene refuses NoObjects; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/cluster_facts"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/cluster_facts.rye -femit-bin=${bin}"]
assert build.ok else "cluster_facts: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "cluster_facts: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "cluster_facts: ${out}"

assert selftest.out contains "GREEN image-cluster-facts" else "cluster_facts: selftest did not print the GREEN line"
assert selftest.out contains "THE CLUSTER FRAME OVER-CLAIMS MEMBERSHIP ACROSS CLUSTERS" else "cluster_facts: the over-claims-membership case did not print"
assert selftest.out contains "containment of a box is never membership of a cluster" else "cluster_facts: the containment-not-membership fact did not print"
assert selftest.out contains "only cluster_of says who belongs" else "cluster_facts: the cluster_of-decides fact did not print"
assert selftest.out contains "THE CLUSTER IS FRAMES, NOT SUBSTANCE" else "cluster_facts: the frames-not-substance case did not print"
assert selftest.out contains "far less than its frame's area 81" else "cluster_facts: the substance-less-than-frame fact did not print"
assert selftest.out contains "the largest member is the ring of area 20" else "cluster_facts: the largest-member fact did not print"
assert selftest.out contains "exactly one member is holed" else "cluster_facts: the holed-count fact did not print"
assert selftest.out contains "refuses BadClusterId" else "cluster_facts: the bad-cluster-id refusal did not print"
assert selftest.out contains "the same cluster reads the same frame and facts twice" else "cluster_facts: the determinism statement did not print"

say "cluster_facts: GREEN on metal -- the facts of each connected cluster; the cluster frame over-claims membership across clusters (a frame is never the membership test), the cluster is frames not substance (total area far less than the frame's), the joined facts read the largest and holed members over just the group; refusals by name, determinism. Season G open-media."
