# tools/roundness_witness.rish -- reconcile a shape's INNER and OUTER disk bounds in ONE convention, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/inscribed_disk.rye reads the biggest disk INSIDE a shape and image/min_enclosing_circle.rye
# the smallest disk AROUND it, yet each reports in its own coordinate convention, so read naively the two REPORTED floats FLIP on a
# compact shape: a solid 5x5 block reports an inscribed radius of 3.0 (chamfer depth 9 over the orthogonal weight 3) yet an enclosing
# radius of only sqrt(8) ~ 2.828 over the pixel CENTERS, so a naive inradius <= circumradius reads FALSE for a shape whose inscribed
# disk plainly sits inside its enclosing disk. image/roundness.rye fixes ONE convention -- doubled pixel-square coordinates -- in
# which both are measured against the region as unit SQUARES, and there the inequality holds by construction and NEVER flips.
#
# The crux this witness proves on metal: the block flips NAIVELY (3.0 > 2.828) yet reconciles EXACTLY (inner 225/9 = 25 doubled^2 <=
# outer 200/4 = 50 doubled^2, decided by exact i128 cross-multiplication, NO tolerance); the inner-sees-the-hole separation is
# preserved (a hollow ring shares the block's outer 50 doubled^2 yet its inner shrinks to 9/9 = 1); a bar's tiny inner against its
# long outer; the roundness ratio ordering; refusals by name and determinism. No network, no key, no funds -- the roundness a
# surface names the day it asks whether a shape is round or thin.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/roundness_witness.rish

say "roundness: Language EN -- Season G roundness reconciliation; the INNER inscribed bound and OUTER enclosing bound read in ONE shared doubled pixel-square convention, so inner <= outer holds EXACTLY and never flips as the naive reported floats do; NO tolerance in the decision."
say "roundness: Style Radiant -- compose not braid: this rung owns only the doubled convention, the region-corner gather, and the exact rational squared radii; inscribed_disk owns the inner disk, min_enclosing_circle owns Welzl and the support, convex_hull owns the hull. No codec, no color, no pixel written -- a reading, not a render."
say "roundness: Lens TAME -- only boundary pixels contribute corners (bounded 4*perimeter under roundness_max_corners, RegionTooLarge past it); doubled coordinates under 2^15 keep every i128 product far below the ceiling; an all-background mask refuses NoForeground and a zero-size source EmptySource before a corner is read; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/roundness"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/roundness.rye -femit-bin=${bin}"]
assert build.ok else "roundness: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "roundness: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "roundness: ${out}"

assert selftest.out contains "GREEN image-roundness" else "roundness: selftest did not print the GREEN line"
assert selftest.out contains "holds EXACTLY and NEVER flips" else "roundness: the reconciliation claim did not print"
assert selftest.out contains "a naive inradius <= circumradius reads FALSE" else "roundness: the naive-flip statement did not print"
assert selftest.out contains "225/9 = 25 doubled^2" else "roundness: the exact inner squared radius did not print"
assert selftest.out contains "200/4 = 50 doubled^2" else "roundness: the exact outer squared radius did not print"
assert selftest.out contains "inner_within_outer decides 25 <= 50 by exact i128 cross-multiplication" else "roundness: the exact reconciled decision did not print"
assert selftest.out contains "the INNER-SEES-THE-HOLE separation is preserved" else "roundness: the ring separation crux did not print"
assert selftest.out contains "its inner shrinks to 9/9 = 1 doubled^2" else "roundness: the ring inner shrink did not print"
assert selftest.out contains "roundness_ratio far below the compact block's" else "roundness: the roundness ordering did not print"
assert selftest.out contains "refuses NoForeground" else "roundness: the refusal did not print"

say "roundness: GREEN -- the inner/outer disk-bound reconciliation stands on metal; the naive flip resolved exactly in the shared doubled pixel-square convention."
