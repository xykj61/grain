# caravan_serve_witness.rish -- Caravan serve witness.
#
# Proves one virtualiser serves TWO clients in one run of real processes,
# each answered on its own channel, with neither client able to hear the
# other's bell or reach the other's memory.
#
# The crux check is the second step: the virtualiser rings `client_b` and
# nobody else, and `client_a` then collects and answers `Unheard`. A bell
# named by its sender alone -- rather than by the sender and receiver
# together -- fails exactly here, which was proven on metal before this
# witness was written.
#
# The second wall is carried in the bytes: every ask names the client it
# is for and every answer names the client that signed it, so a delivery
# addressed to the neighbor answers `bytes differed` rather than passing
# as a conversation.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_serve_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/serve"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/serve.rye -femit-bin=${bin}"]

assert build.ok else "caravan serve build failed"

# The reader this witness runs is built here rather than borrowed (REDS #92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# The two-client declaration reads whole before anything runs on it.
let decl = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_two_clients.bron 2>&1"]
assert decl.ok else "the two-client declaration could not be read"
assert decl.out contains "system serial_two_clients" else "the two-client declaration lost its name"
assert decl.out contains "domains 3 -- channels 2 -- regions 4 -- grants 8" else "the two-client declaration changed shape"
assert decl.out contains "verdict: whole" else "the two-client declaration did not read whole"

# A fresh provisioning each run, so a bell found ringing was rung by this
# run rather than left standing by the last one.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan serve selftest exited non-zero"
assert test.out contains "GREEN" else "caravan serve selftest not GREEN"
assert test.out contains "neither hears the other's bell" else "the isolation claim did not close"
assert test.out contains "one sender rings two clients on two bells" else "one sender shared a bell between clients"

# The walls two clients invite, each answered by name in its own dependent.
assert test.out contains "client_a: request rx_a then tx_a via client_b -- NotWired" else "one client rang the other"
assert test.out contains "client_a: request rx_b then tx_b via serial_virt -- NotGranted" else "a client reached the neighbor's memory"
assert test.out contains "client_a: request rx_a then tx_a via serial_virt -- WriteDenied" else "a read-only share accepted a write"

# The served run, in the order its meaning depends on.
assert test.out contains "serial_virt: request rx_b then tx_b via client_b -- carried" else "the second client was never asked"
assert test.out contains "client_a: collect rx_a then tx_a via serial_virt -- Unheard" else "a client heard a ring meant for its neighbor"
assert test.out contains "client_b: reply rx_b then tx_b via serial_virt -- carried" else "the second client did not answer"
assert test.out contains "serial_virt: collect rx_a then tx_a via client_a -- Unheard" else "a silent client was collected from"
assert test.out contains "serial_virt: collect rx_b then tx_b via client_b -- carried" else "the second client's answer did not come home"
assert test.out contains "serial_virt: request rx_a then tx_a via client_a -- carried" else "the first client was never asked"
assert test.out contains "client_a: reply rx_a then tx_a via serial_virt -- carried" else "the first client did not answer"
assert test.out contains "serial_virt: collect rx_a then tx_a via client_a -- carried" else "the first client's answer did not come home"
assert test.out contains "4 directed bells provisioned silent across 2 declared channels" else "the directions were not provisioned"
assert test.out contains "2 clients served in one run" else "the run did not serve both clients"

# The four directed bells stand where the declaration put them, two per
# declared channel, and each of the four rang exactly once.
let bells = run ["sh" "-c" "ls caravan/.channels"]
assert bells.ok else "the doorbells could not be listed"
assert bells.out contains "serial_virt.to.client_a.bell" else "the first client's inbound bell is missing"
assert bells.out contains "client_a.to.serial_virt.bell" else "the first client's outbound bell is missing"
assert bells.out contains "serial_virt.to.client_b.bell" else "the second client's inbound bell is missing"
assert bells.out contains "client_b.to.serial_virt.bell" else "the second client's outbound bell is missing"

let ask_a = run ["sh" "-c" "od -An -tu1 -N1 caravan/.channels/serial_virt.to.client_a.bell"]
assert ask_a.ok else "the first client's inbound bell could not be measured"
assert ask_a.out contains "1" else "the first client was rung the wrong number of times"
let ask_b = run ["sh" "-c" "od -An -tu1 -N1 caravan/.channels/serial_virt.to.client_b.bell"]
assert ask_b.ok else "the second client's inbound bell could not be measured"
assert ask_b.out contains "1" else "the second client was rung the wrong number of times"
let reply_a = run ["sh" "-c" "od -An -tu1 -N1 caravan/.channels/client_a.to.serial_virt.bell"]
assert reply_a.ok else "the first client's outbound bell could not be measured"
assert reply_a.out contains "1" else "the first client answered the wrong number of times"
let reply_b = run ["sh" "-c" "od -An -tu1 -N1 caravan/.channels/client_b.to.serial_virt.bell"]
assert reply_b.ok else "the second client's outbound bell could not be measured"
assert reply_b.out contains "1" else "the second client answered the wrong number of times"

# Each client's answer stands in its own region, signed by the client that
# wrote it -- measured from outside the program.
let answer_a = run ["sh" "-c" "head -c 27 caravan/.regions/tx_a.bin"]
assert answer_a.ok else "the first client's answer could not be read"
assert answer_a.out contains "serve: answer from client_a" else "the first client's answer is not its own"
let answer_b = run ["sh" "-c" "head -c 27 caravan/.regions/tx_b.bin"]
assert answer_b.ok else "the second client's answer could not be read"
assert answer_b.out contains "serve: answer from client_b" else "the second client's answer is not its own"

say "GREEN: Caravan serve witness passed."
