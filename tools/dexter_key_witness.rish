# tools/dexter_key_witness.rish -- Dexter, the keystroke decoder on metal.
#
# pond/apps/dexter_key.rye is the terminal family's missing floor: a keeper's keyboard hands a terminal
# BYTES, and a printable byte is one thing while an arrow key is the three bytes ESC '[' 'D'. This module
# decodes a byte run into bounded Key events and drives a dexter_line.rye editable line -- held pure, reading
# a byte SLICE a caller already has, never a raw TTY and never the network. The raw TTY read and the Comlink
# wire between two Constel piers are Dexter's later rungs -- they reach the serve gate, the maintainer's hand.
# This witness builds the module and asserts its selftest speaks GREEN over the eight cruxes:
#   - Printable bytes build the line at the cursor.
#   - A CSI left arrow (ESC [ D) moves the cursor, so a later byte splices mid-line.
#   - Home, End, and the Delete key (ESC [ 3 ~) decode and drive the line as named.
#   - A DEL byte (0x7f) backspaces, and a carriage return decodes to Enter.
#   - drive stops at the first Enter, so a caller submits between lines.
#   - A key at the edge (Left at start, Backspace when empty, Right at end) is a harmless no-op.
#   - Up/Down arrows and Page Up/Down decode to bounded navigation keys the line editor ignores (a read view
#     binds them to scrolling) -- the decoder names every key the terminal sends rather than dropping it.
#   - An unknown escape, a lone ESC, and a tab all decode to ignored, no byte landing.
#   - The same byte run drives the same line every time (deterministic).
#
# Facts only, custody-first: it decodes bytes and edits a line of text -- no network, no key signs, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/dexter_key_witness.rish

say "dexter-key: Language EN -- a keeper's keyboard bytes decode to bounded key events and drive a bounded line."
say "dexter-key: Lens TAME -- byte-to-key mapping held pure; boundary keys a no-op, unknown sequences ignored, no TTY, no key, no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/dexter-key"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/dexter_key.rye -femit-bin=${bin}"]
assert build.ok else "dexter-key: dexter_key build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dexter-key: dexter_key selftest exited non-zero"
assert selftest.out contains "GREEN" else "dexter-key: selftest did not speak GREEN"
assert selftest.out contains "build the line at the cursor" else "dexter-key: printable-build crux missing"
assert selftest.out contains "a CSI left arrow moves the cursor" else "dexter-key: arrow-splice crux missing"
assert selftest.out contains "Home, End, and the Delete key decode" else "dexter-key: home-end-delete crux missing"
assert selftest.out contains "a DEL byte backspaces" else "dexter-key: backspace-enter crux missing"
assert selftest.out contains "drive stops at the first Enter" else "dexter-key: enter-between-lines crux missing"
assert selftest.out contains "a harmless no-op" else "dexter-key: boundary-no-op crux missing"
assert selftest.out contains "decode to bounded navigation keys the line editor ignores" else "dexter-key: navigation crux missing"
assert selftest.out contains "decode to ignored, no byte landing" else "dexter-key: ignored-sequence crux missing"
assert selftest.out contains "the same byte run drives the same line" else "dexter-key: determinism crux missing"

say "GREEN: dexter-key -- the keystroke decoder maps keyboard bytes (printable, backspace, forward-delete, arrows, Home/End, navigation Up/Down and Page Up/Down, Enter) to bounded key events and drives a bounded line, boundary keys a no-op, navigation a line no-op, unknown sequences ignored, all pure and deterministic."
