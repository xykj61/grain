# tools/hunk_scroll_view_witness.rish — the scrollable surface: the page a keeper sees, painted beside a live scroll
# bar, on one glass grid (HUNK42).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · marketplace / Photos-app surface · rung HUNK42.
# Design read: active-designing/20260813-194607_hunk-scroll-view-exploration.md.
# Teacher, thanked clean-room: the scrollable list surface of any reader — the visible rows and a scroll thumb beside
# them, drawn together so a keeper reads their place at a glance (concept only, siloed).
#
# HUNK40 gave a keeper a ScrollCursor (a live viewport offset) and HUNK41 a ScrollBar (a pure thumb geometry). This
# rung paints them on one Skate grid: `pond/apps/preset_scroll_view.rye` `scroll_view` renders the cursor's current
# page into the left region and paints the scroll bar down a reserved right-hand column, one bar cell per viewport row,
# so a keeper SEES the books they are on and the thumb marking their place at once. A pure composition — no storage,
# no new gesture, no new render primitive. The selftest scrolls a two-row viewport through a real five-book library
# and proves the thumb walks top to bottom beside the page, the bar rasterizes genuinely lit, the view is pure, a
# fitting library fills the whole bar, and the BadBar / EmptyView refusals fire. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_scroll_view_witness.rish

say "hunk-scroll-view: Language EN — HUNK42 paints the page a keeper sees beside a live scroll bar on one glass grid, so a keeper reads the books they are on and the thumb marking their place at once — no network, no key, no funds."
say "hunk-scroll-view: Style Radiant — HUNK40 measured where the reader stands, HUNK41 measured how much fits; this rung lets a keeper see both at once, the books and their place drawn from nothing but the cursor and the listing."
say "hunk-scroll-view: Lens TAME — a pure composition over HUNK40's window and HUNK41's scroll_bar, positive invariants per fn, every buffer seam bounded and asserted; two refusals named (BadBar, EmptyView)."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/preset_scroll_view"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/preset_scroll_view.rye -femit-bin=${bin}"]
assert build.ok else "hunk-scroll-view: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-scroll-view: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-scroll-view: ${out}"

let green = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'GREEN preset-scroll-view' && echo yes"]
assert (trim green.out) == "yes" else "hunk-scroll-view: selftest did not print the GREEN preset-scroll-view line"

let left = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the cursor page fills the left' && echo yes"]
assert (trim left.out) == "yes" else "hunk-scroll-view: the page filling the left region was not proven"

let toppin = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the thumb sits on the top bar cell' && echo yes"]
assert (trim toppin.out) == "yes" else "hunk-scroll-view: the thumb-at-top seat was not proven"

let botpin = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the thumb walks to the bottom bar cell (start + len == track)' && echo yes"]
assert (trim botpin.out) == "yes" else "hunk-scroll-view: the thumb-walks-to-bottom pin was not proven"

let seen = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the bar adds pixels beyond the text alone (a scroll bar you can see)' && echo yes"]
assert (trim seen.out) == "yes" else "hunk-scroll-view: the bar-genuinely-seen guarantee was not proven"

let pure = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the view is pure and deterministic (built twice, byte-identical' && echo yes"]
assert (trim pure.out) == "yes" else "hunk-scroll-view: the pure-and-deterministic guarantee was not proven"

let fits = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'fills the whole bar (nothing to scroll)' && echo yes"]
assert (trim fits.out) == "yes" else "hunk-scroll-view: the fitting-library-fills-the-bar guarantee was not proven"

let refuse = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'refuses BadBar, a zero grid EmptyView' && echo yes"]
assert (trim refuse.out) == "yes" else "hunk-scroll-view: the BadBar / EmptyView refusals were not proven"

say "hunk-scroll-view: GREEN — a keeper sees the page they are on and a live scroll bar beside it on one glass grid; the thumb walks top to bottom with the cursor, the bar rasterizes genuinely lit, the composed surface is pure and deterministic, a fitting library fills the whole bar, and the refusals fire. HUNK40 cursor and HUNK41 scroll bar GREEN beneath."
