# pleac_numbers_witness.rish — the PLEAC numbers cookbook (clamp · parse · to_str).
#
# SOON. Proves pleac/numbers.rye: clamp bounds a value to [lo, hi]; parse reads a
# decimal to u32 and to_str writes one, inverse across the range (parse(to_str(n))==n);
# every bad input is a named refusal (empty · non-digit · past the u32 ceiling ·
# too-small buffer), never a wrapped or truncated number.
#
# Build first:  rye build pleac/numbers.rye -femit-bin=tools/.build/pleac_numbers
#   rishi/bin/rishi run tools/pleac_numbers_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} rye/bin/rye build pleac/numbers.rye -femit-bin=tools/.build/pleac_numbers"]
assert build.ok else "pleac numbers build failed"

let st = run ["tools/.build/pleac_numbers" "selftest"]
assert st.ok else "pleac numbers selftest exited non-zero"
assert (st.err contains "GREEN") else "pleac numbers selftest not GREEN"
assert (st.err contains "clamp bounds a value") else "pleac numbers missing the clamp claim"
assert (st.err contains "parse(to_str(n)) == n") else "pleac numbers missing the round-trip claim"
assert (st.err contains "named refusal") else "pleac numbers missing the total-refusal claim"
assert (st.err contains "too-small buffer are each refused") else "pleac numbers missing the bounded refusal"

say "GREEN: pleac numbers — clamp, parse, to_str: inverse and total, every bad input refused, witnessed."
