# tools/hit_test_witness.rish -- given a PIXEL, name the OBJECT under it, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/scene_manifest.rye reads a whole scene as one row per object (area, bounding box, Euler
# number, hole count) so a surface can ENUMERATE every object; this rung lets it SELECT the one object under a point -- the hit test
# a tap-handler runs. Exact integers, NO float, NO tolerance -- the label map is the arbiter, the bounding box only a prefilter.
#
# The crux this witness proves on metal: a bounding box is NECESSARY but NOT SUFFICIENT. An L and a small block tucked into its
# concavity are distinct components whose bounding boxes OVERLAP, so a point on the block falls in two boxes (bbox_candidate_count 2)
# yet hit_test names exactly one object; the concavity notch and a ring's center are BACKGROUND inside a box the object does not hold,
# so hit_test refuses NoObjectAtPoint where bbox_contains_point reads true; a plain hit resolves to its object; a point off the map
# refuses PointOutOfBounds; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hit_test_witness.rish

say "hit_test: Language EN -- Season G point-to-object hit test; the label map is the arbiter, the bounding box only a prefilter; NO float, NO tolerance."
say "hit_test: Style Radiant -- compose not braid: this rung owns only the point-to-object decision and the bounding-box prefilter reads; label owns the at arbiter, scene_manifest owns the per-object rows, regions owns the bounding box. No plane of its own, no pixel written -- a reading, not a render."
say "hit_test: Lens TAME -- the candidate scan runs components times under label_max_pixels; every point read is a single guarded array index; a point off the map refuses PointOutOfBounds, a background point refuses NoObjectAtPoint; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/hit_test"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/hit_test.rye -femit-bin=${bin}"]
assert build.ok else "hit_test: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hit_test: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "hit_test: ${out}"

assert selftest.out contains "GREEN image-hit-test" else "hit_test: selftest did not print the GREEN line"
assert selftest.out contains "the label map is the arbiter, the bounding box only a prefilter" else "hit_test: the arbiter-versus-prefilter claim did not print"
assert selftest.out contains "the DECISIVE box-is-a-prefilter crux" else "hit_test: the decisive crux did not print"
assert selftest.out contains "falls in BOTH bounding boxes (bbox_candidate_count reads 2) yet hit_test names exactly ONE object" else "hit_test: the overlap crux did not print"
assert selftest.out contains "the concavity notch (2,2) is BACKGROUND inside the L's box" else "hit_test: the concavity crux did not print"
assert selftest.out contains "hit_test refuses NoObjectAtPoint, the box claiming a point the object does not hold" else "hit_test: the box-claims-what-the-object-does-not-hold claim did not print"
assert selftest.out contains "a point in no object's box reads zero candidates and refuses" else "hit_test: the outside-every-box case did not print"
assert selftest.out contains "the same crux on a 5x5 ring whose center (3,3) sits inside its own box yet is the hole" else "hit_test: the ring-hole case did not print"
assert selftest.out contains "a point off the map refuses PointOutOfBounds having read nothing" else "hit_test: the off-map refusal did not print"
assert selftest.out contains "the same point reads the same object twice" else "hit_test: determinism did not print"

say "hit_test: GREEN on metal -- given a pixel, the hit test names the object under it exactly, resolving the ambiguity two overlapping bounding boxes leave and refusing a background point a box falsely claims; refusals by name, determinism. Season G open-media."
