# caravan_refer_witness.rish -- Caravan refer witness.
#
# `swell.rye` opened the last door: a long-standing quarrel is published right
# where an operator reads the outcome, in one byte beside the settlement. So the
# standing is visible at last -- and then the run goes on exactly as it always
# ran, with the argument still held by the only two hands that cannot end it.
#
#   A LONG-STANDING QUARREL IS PUT BEFORE A HAND THAT IS NEITHER PARTY.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO PLANS DISAGREE ON IS LONG-STANDING QUARRELS NOBODY
#     OUTSIDE THE ARGUMENT EVER SEES. A supervisor may not grade an objection
#     raised against itself, and the reader who raised it has already said what
#     they think, so a quarrel held between those two alone can stand forever.
#     It falls from 1 to 0.
#   * THE FORUM IS READ OFF THE WIRE, NEVER CHOSEN BY A RUN. A supervisor able to
#     name the hand weighing an objection against it has named its own judge, and
#     naming the judge is most of what a judge does. `plan.forum` is seated by an
#     operator before any quarrel exists; a run only ever reads it, and
#     `ReferUnaddressed` refuses by name where nothing stands there at all -- a
#     configuration reachable by argument alone, which is what makes that guard
#     load-bearing.
#   * A FORUM THAT NAMES A PARTY HAS HEARD NOTHING. `ReferParty` is the rung
#     itself, refused by name on metal: a case landing in the box of the reader
#     who raised the quarrel wears the look of a hearing while being none.
#   * THE CASE IS COPIED, NEVER SUMMARIZED. Three facts come off the wire in the
#     run that sends them -- what the plan came to, how loudly the objection
#     reads, and how many runs it has stood -- because a summary is exactly where
#     a supervisor would get to shade the argument against itself.
#   * A CASE, ONCE CARRIED, BELONGS TO THE DESK IT LANDED ON -- proven as its own
#     fold. It survives a provisioning, as every record of a quarrel does, and it
#     survives the withdrawal of the quarrel itself, which nothing else in this
#     arc does. A supervisor able to take a case back off a third hand's desk
#     would have shown somebody a document and then closed their hand around it.
#   * THE REFERRING IS THE LAST ACT OF THE RUN, after the heralding below it,
#     because the standing it carries out is the standing that heralding just
#     published -- and because the relenting above may already have taken down
#     the very quarrel a case would be built from.
#   * A REFERRAL CARRIES, AND NEVER ARGUES. Both runs settle `carried out whole`,
#     both leave the quarrel standing where its holder left it, both leave the
#     age at 4 and the standing loud, and both keep the word standing under it.
#     This rung changes who has seen the argument, and nothing else.
#   * THE PRICE IS THREE BYTES ON ONE DESK, AT NO COST IN WORK AT ALL. Both runs
#     take up 6 phases, absorb 3 into standing dependents, lose 3 arcs, take the
#     same judgment back, re-seat the same 3 phases, spend the same 6 dependents,
#     post and carry the same correction, read the same reply, record the same
#     disagreement, escort the same published word, ask the same reader, stand the
#     same mark, tell the same raiser, carry the same position past themselves,
#     date it to the same age, publish the same standing, and settle `carried`.
#   * FIVE REFUSALS THIS RUNG EARNS -- one more than the four below it, and the
#     extra one is the rung itself. `ReferEarly` is the moment a case travels at
#     all. `ReferUnaddressed` is whether a forum stands on the wire to travel to.
#     `ReferParty` is the whole point. `ReferMiscounted` is the honesty of the
#     count. `ReferMisrecorded` is the record, read back from the one box of this
#     whole arc that lands outside both parties.
#   * A QUARREL RAISED ON THIS VERY RUN IS LEFT WITH THE PEOPLE HAVING IT, and a
#     plan nobody ever pressed a quarrel against carries no case anywhere -- each
#     proven on the wire rather than only as a fold. A plan that loses nothing
#     still reads as the line handed, all 16 pairs, this arc's standing
#     generalization test one tier further out.
#
# Six RED paths were proven on metal before this witness claimed GREEN. Skip the
# write and keep the read-back armed and the run refuses `ReferMisrecorded`.
# Clear the forum and the run refuses `ReferUnaddressed`, reachable by argument
# alone. Name the reader themself as the forum and the run refuses `ReferParty`.
# Walk a run with nothing standing into a referral and it refuses `ReferEarly`
# -- reaching that on the wire takes disarming the honest fold first, since the
# fold catches it before the run can. Count one quarrel as both referred and kept
# and it refuses `ReferMiscounted`. Disarm every guard at once -- the write
# skipped, the read-back skipped, and both harness reads of the desk -- and the
# selftest calls itself GREEN while `caravan/.readers/bench.case` does not exist
# at all, beside a quarrel four runs old still reading loud on `plan.standing`,
# so an operator would believe a third hand had the case in front of them.
# Seeing that once is what makes the reading back a check rather than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_refer_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/refer"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/refer.rye -femit-bin=${bin}"]

assert build.ok else "caravan refer build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. Every quarrel this witness reads was seated by the lap
# itself, standing in for the runs that met this position before today.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.refers caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan refer selftest exited non-zero"
assert test.out contains "GREEN" else "caravan refer selftest not GREEN"
assert test.out contains "a long-standing quarrel is put before a hand that is neither party" else "the refer finding did not close"

# The referring and its five refusals, read straight, before any dependent runs.
assert test.out contains "a quarrel counts as long-standing at 3 runs, and no run may move that bound" else "the bound was not weighed"
assert test.out contains "five refusals stand by name: early, unaddressed, party, miscounted, misrecorded" else "the five refer refusals did not stand"
assert test.out contains "a long-standing quarrel stays between the two hands that cannot end it" else "a bare plan did not read as one"
assert test.out contains "a case carries three facts: the plan's word, the standing, and the age" else "a case did not name what it carries"
assert test.out contains "a quarrel that has outlasted the run it was raised in" else "a loud standing did not read as one"
assert test.out contains "a quarrel young enough that its age is the whole story" else "a quiet standing did not read as one"

# The property that makes a referral worth making, proven as its own fold: a
# case, once carried, belongs to the desk it landed on -- it survives a
# provisioning, and it outlives the withdrawal of the quarrel it was built from.
assert test.out contains "a case survives a provisioning, and outlives the quarrel it was built from" else "a case was never proven past a provisioning"

# The swelling below it, unchanged and still weighed.
assert test.out contains "a plan publishes whether a long-standing quarrel reads where the outcome is read" else "the swelling below stopped being weighed"
assert test.out contains "a standing survives a provisioning, and falls with the quarrel it speaks for" else "a standing was never proven past a provisioning"

# The dwelling below it, unchanged and still weighed.
assert test.out contains "an age climbs by the run just stood and never shortens" else "the dwelling below stopped being weighed"
assert test.out contains "an age survives a provisioning, and falls with the quarrel it counts" else "an age was never proven past a provisioning"

# The relenting, the heeding, the endurance, the appeal, the tidings, the
# standing, the term, the escort, the record, the hearing, the delivery, the
# amendment, the recantation, the bearing, and the mend below, unchanged.
assert test.out contains "a quarrel comes down on its holder's word and on nobody else's" else "the relenting below stopped being weighed"
assert test.out contains "a plan publishes whether it reads under the quarrel it inherited" else "the heeding below stopped being weighed"
assert test.out contains "a plan publishes whether a pressed quarrel outlives the run that heard it" else "the endurance below stopped being weighed"
assert test.out contains "a plan publishes whether it reads what its reader says back" else "the appeal below stopped being weighed"
assert test.out contains "a plan publishes whether it writes back to the reader who objected" else "the tidings below stopped being weighed"
assert test.out contains "a plan publishes whether its marks carry the standing of their objection" else "the standing below stopped being weighed"
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term below stopped being weighed"
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization tests: a plan that loses nothing reads as the rung below, a
# quarrel raised on this very run is published quietly, and a plan nobody ever
# pressed a quarrel against publishes nothing at all.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"
assert test.out contains "a quarrel raised on this very run is left with the people having it" else "a fresh quarrel was carried out to a third hand"
assert test.out contains "a plan nobody ever pressed a quarrel against carries no case anywhere" else "a plan nobody pressed handed somebody a case all the same"

# The referring lap: one plan run twice over a quarrel that has already stood
# long enough to count, once keeping it between the two hands that cannot end it
# and once carrying the case to a hand that is neither. Every number stands
# still -- the work, the dependents, the correction, the journey, the record,
# the escort, the asking, the mark, the telling, the reading back, the position
# carried forward, the word standing under it, the age, the standing, the
# settlement -- and only the referral moves.
assert test.out contains "phases: 6 unheard, 6 referred" else "the two plans ran different records"
assert test.out contains "dependents: 6 unheard, 6 referred" else "heralding a quarrel cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 unheard, 3 referred" else "the two plans absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 unheard, 3 referred" else "the two plans lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 unheard, 3 referred" else "the two plans repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 unheard, 1 referred" else "the recanting rung stopped moving under both plans"
assert test.out contains "readings corrected where they were read: 1 unheard, 1 referred" else "the amending rung stopped moving under both plans"
assert test.out contains "corrections carried to the place their reader was reached: 1 unheard, 1 referred" else "the couriering rung stopped moving under both plans"
assert test.out contains "disagreements written into the record: 1 unheard, 1 referred" else "the disputing rung stopped moving under both plans"
assert test.out contains "published words standing beside the reading against them: 1 unheard, 1 referred" else "the abiding rung stopped moving under both plans"
assert test.out contains "standing objections put back to the reader who raised them: 1 unheard, 1 referred" else "the lapsing rung stopped asking under both plans"
assert test.out contains "marks carrying the standing of the objection they quote: 1 unheard, 1 referred" else "the standing below stopped moving under both plans"
assert test.out contains "raisers told how their own quarrel came out: 1 unheard, 1 referred" else "the tidings below stopped moving under both plans"
assert test.out contains "readers whose reply to the answer was read back: 1 unheard, 1 referred" else "the appeal below stopped moving under both plans"
assert test.out contains "positions carried past the run that heard them: 1 unheard, 1 referred" else "a run whose reader still presses dropped their position"
assert test.out contains "inherited positions weighed into the run's own word: 1 unheard, 1 referred" else "the regard stopped standing under a live quarrel"
assert test.out contains "standing positions let go on their holder's own word: 0 unheard, 0 referred" else "a run closed a quarrel nobody had withdrawn"
assert test.out contains "standing positions left exactly where they were found: 1 unheard, 1 referred" else "the relenting below stopped leaving the position standing"
assert test.out contains "standing positions this run said the age of: 1 unheard, 1 referred" else "the dwelling below stopped dating under both plans"
assert test.out contains "standing quarrels whose note never said how long: 0 unheard, 0 referred" else "a dating run left a standing quarrel undated"
assert test.out contains "standing quarrels published where the outcome is read: 1 unheard, 1 referred" else "the swelling below stopped moving under both plans"
assert test.out contains "standing quarrels left unpublished at the outcome: 0 unheard, 0 referred" else "a heralding run left a standing unpublished"
assert test.out contains "long-standing quarrels an operator reads no louder than a fresh one: 0 against 0" else "a heralding run left a long-standing quarrel reading quietly"
assert test.out contains "long-standing quarrels carried to a hand that is neither party: 0 unheard, 1 referred" else "the referring did not part the two plans"
assert test.out contains "long-standing quarrels kept inside the argument: 1 unheard, 0 referred" else "the other half of the count did not close"
assert test.out contains "long-standing quarrels nobody outside the argument ever sees: 1 against 0" else "the two plans left the same quarrel unheard outside"
assert test.out contains "work still standing when the supervisor exits: 0 unheard, 0 referred" else "the two plans left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole unheard, carried out whole referred" else "a standing decided what the work came to"
assert test.out contains "breaks a named turn: 0 unheard, 0 referred" else "the heralding run broke an order its author named"

# What an operator reads is what the wire carries, and what a reader writes is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.refers/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The standing below it, published beside the settlement and untouched here.
let standing = run ["sh" "-c" "cat caravan/.refers/plan.swell"]
assert standing.ok else "the standing note could not be read at all"
assert standing.out contains "l" else "a quarrel four runs old did not read as long-standing"

# The note this rung writes -- and the one note of the whole arc that lands
# outside both parties, in a box named for a hand that has not spoken yet. Three
# facts copied off the wire: the plan carried, the standing reads loud, and the
# quarrel has stood four runs.
let case = run ["sh" "-c" "cat caravan/.readers/bench.case"]
assert case.ok else "no third hand was ever handed the case"
assert case.out contains "cl" else "the case did not carry the plan word and the standing it was copied from"

let case_age = run ["sh" "-c" "od -An -tu1 caravan/.readers/bench.case | tr -d ' '"]
assert case_age.ok else "the case could not be read as bytes"
assert case_age.out contains "4" else "the case did not carry the age the wire actually holds"

# The forum, read by the run and never written by it: an operator named this
# hand before any quarrel existed, which is the whole reason a run may trust it.
let forum = run ["sh" "-c" "cat caravan/.refers/plan.forum"]
assert forum.ok else "the plan named no hand outside the argument at all"
assert forum.out contains "bench" else "the wire did not name the third hand this lap seated"

# And the reader who raised the quarrel was handed no case, which is the rung.
let unhanded = run ["sh" "-c" "test -e caravan/.readers/desk.case && echo present || echo absent"]
assert unhanded.ok else "the reader box could not be weighed"
assert unhanded.out contains "absent" else "a case landed in the box of a party to the argument"

# The age below it, untouched by the reading taken from it.
let age = run ["sh" "-c" "od -An -tu1 caravan/.refers/plan.dwell | tr -d ' '"]
assert age.ok else "the age note could not be read at all"
assert age.out contains "4" else "a referring run rewrote the age it was only asked to read"

# The quarrel itself, untouched: this rung says how loudly a position reads and
# never whether it stands at all.
let quarrel_note = run ["sh" "-c" "cat caravan/.refers/plan.standing"]
assert quarrel_note.ok else "a referring run took down the position it was only asked to carry out"
assert quarrel_note.out contains "p" else "the position standing over the plan changed under a referring run"

# The word standing under it, unchanged: a standing says nothing about whether
# the plan's own word answers for the quarrel beside it.
let regard = run ["sh" "-c" "cat caravan/.refers/plan.regard"]
assert regard.ok else "the regard note could not be read at all"
assert regard.out contains "u" else "a referred quarrel stopped standing over the plan's own word"

# The reader's own hand, in their own box, outside this plan's wire entirely --
# still pressing, which is exactly why their quarrel goes on standing.
let press = run ["sh" "-c" "cat caravan/.readers/desk.press"]
assert press.ok else "the reader replied nothing at all"
assert press.out contains "p" else "the holder of this lap's quarrel did not read as still pressing"

let plea = run ["sh" "-c" "cat caravan/.refers/plan.appeal"]
assert plea.ok else "the plan published no plea an operator could read"
assert plea.out contains "p" else "the record and the reader's own hand read differently"

let address = run ["sh" "-c" "cat caravan/.refers/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

let beside = run ["sh" "-c" "cat caravan/.refers/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "s" else "the mark did not name the reading its reader holds"

let quarrel = run ["sh" "-c" "cat caravan/.refers/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.refers/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let outof = run ["sh" "-c" "cat caravan/.readers/desk.outof"]
assert outof.ok else "the raiser of the quarrel was never told how it came out"
assert outof.out contains "t" else "a word that never moved was reported to its raiser as one that did"

let recant_note = run ["sh" "-c" "cat caravan/.refers/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.refers/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan refer witness passed."
