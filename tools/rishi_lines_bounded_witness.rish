# rishi_lines_bounded_witness.rish — read bounded: lines-bounded refuses past max · 20260725.
#
#   rishi/bin/rishi run tools/rishi_lines_bounded_witness.rish

let t3 = read-file "tools/fixtures/three_lines.txt"
let lines3 = lines-bounded t3 max 5
assert (length lines3) == 3 else "lines-bounded within max failed"

let t20 = read-file "tools/fixtures/twenty_lines.txt"
let ok20 = lines-bounded t20 max 20
assert (length ok20) == 20 else "lines-bounded at exact max failed"

let bounded_fail = run ["sh" "-c" "rishi/bin/rishi run tools/fixtures/lines_bounded_fail.rish 2>&1"]
assert bounded_fail.ok == false else "lines-bounded must refuse past max"
assert bounded_fail.out contains "ListTooLong" else "lines-bounded wrong error"

say "GREEN: Rishi lines-bounded — named bound refuses past max."
