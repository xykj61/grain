# tools/ales_soft_drive_witness.rish — the soft-clip overdrive: ALES78's hard clip with its corner rounded (ALES79).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES79.
# Design read: active-designing/20260814-205812_fill-ales79-lotus-soft-clip-overdrive.md
# Stands on: lotus/drive.rye (ALES78 — the pre-gain and the ceiling pin, reused with a knee opened below the ceiling); lotus/fader.rye (ALES6 —
# the num/den gain in i64); lotus/limit.rye (ALES49 — the ceiling law the shoulder's top reuses); lotus/timeline.rye (ALES2 — the Clip,
# sample_min/max, the one true saturate).
#
# lotus/soft_drive.rye rounds ALES78's sharp clipping corner. SOFT-CLIP DRIVE IS ALES78's HARD CLIP WITH ITS CORNER ROUNDED, and a hard clip is
# the soft clip whose KNEE sits AT the ceiling: below the knee the boosted signal passes clean, between knee and ceiling the slope HALVES
# (knee + (m − knee)/2), and once that shoulder reaches the ceiling (m ≥ 2·ceil − knee) it pins — three straight segments, slope one, one-half,
# zero, each exact in integers. The selftest proves it: a knee AT the ceiling reproduces ALES78's hard drive byte-for-byte (against the real hard
# clip); a hand-computed half-slope shoulder matches exactly; a wide-knee overdrive is GENTLER than the hard clip at the same gain (the shoulder
# never louder than the pin); the shape is ODD, soft_drive(−x) = −soft_drive(x); the output never exceeds the ceiling under a heavy ×8 drive; the
# span discipline holds; a zero den / below-unity gain / oversized numerator refuses BadGain, a knee below 1 or above the ceiling BadKnee, a zero
# or over-rail ceiling BadCeiling, a span past the end BadRange, each leaving the clip untouched. The shape lands every output in [−ceil, ceil] ⊆
# the i16 rail BEFORE the write, so the shape does the clipping and the saturate is a documented no-op. Purely local — one multiply, one divide,
# one bounded piecewise map per sample; no delay line, no anti-aliasing, no network, no keys, no funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_soft_drive_witness.rish

say "ales-soft-drive: Language EN — ALES78's hard clip pins a boosted sample abruptly at the ceiling: a sharp corner, bright and buzzy, the sound of a fuzz. An overdrive is gentler — below a KNEE the boosted signal passes clean, and between the knee and the ceiling the slope HALVES, so the wave bends toward the ceiling rather than slamming into it. That rounded shoulder is the warmth of an overdriven tube or a pushed preamp — the same odd-harmonic character with the highest edges smoothed."
say "ales-soft-drive: Style Radiant — the law is stated positively as a recognition: SOFT-CLIP DRIVE IS ALES78's HARD CLIP WITH ITS CORNER ROUNDED, and a hard clip is the soft clip whose knee sits AT the ceiling. The two rungs are one waveshaper read at two knee positions: pull the knee below the ceiling and a half-slope shoulder opens; push it up to the ceiling and the shoulder vanishes, leaving ALES78's sharp pin. No new pre-gain (ALES78's, verbatim) and no new ceiling law (ALES49's at the shoulder's top); only the knee is new."
say "ales-soft-drive: Lens TAME — one mono clip of i16 PCM soft-clipped in place over a span; the shape is a piecewise-linear map on the boosted magnitude with the sign carried (odd, so odd harmonics), three exact integer segments of slope one, one-half, zero; the output lands in [−ceil, ceil] ⊆ [sample_min, sample_max] BEFORE the write, so the shape does the clipping and the saturate is a documented no-op; a zero denominator / below-unity gain / oversized numerator refuses BadGain, a knee outside [1, ceil] BadKnee, a ceiling outside [1, sample_max] BadCeiling, a span outside the samples BadRange, all before any write, the clip untouched on refusal; the shape is MEMORYLESS (every output depends only on its own input); siloed to lotus/, the gain a rational and the knee and ceiling magnitudes in sample units, no delay line, no snapshot, no anti-aliasing, no network, no keys, no funds, no device, no speaker, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/soft_drive"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/soft_drive.rye -femit-bin=${bin}"]
assert build.ok else "ales-soft-drive: build failed — ${build.err}"

let outfile = "lotus/bin/soft_drive.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-soft-drive: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-soft-drive: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-soft-drive' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-soft-drive: selftest did not print the GREEN ales-soft-drive line"
