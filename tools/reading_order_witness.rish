# tools/reading_order_witness.rish -- the whole scene's total reading order, on metal (Season G).
#
# Season G (Open Media Primitives) -- the scene-read family names a POINT's object (image/hit_test.rye), a RECTANGLE's or POLYGON's
# objects (image/region_select.rye, image/lasso_select.rye), a selection's FACTS and EXTENT (image/selection_summary.rye,
# image/selection_bounds.rye), a PAIR's spatial relation (image/object_relation.rye), and the whole scene's pairwise STRUCTURE
# (image/scene_graph.rye). This rung reads the scene as a SEQUENCE: reading_order folds the scene graph's per-pair directional flags
# into one top-to-bottom, left-to-right page order. Exact integers, NO float, NO tolerance.
#
# The crux this witness proves on metal: the box-is-a-prefilter lesson lifted from a PARTIAL relation to a TOTAL order. THE READING
# ORDER OUTRUNS THE STRICT FLAGS -- an L and a block in its concavity have overlapping boxes so every strict flag reads FALSE, yet the
# order seats the L first. THE READING ORDER REFINES, IT NEVER CONTRADICTS -- where the boxes are strictly separated the order agrees.
# THE ORDER EARNS ITS KEEP -- a flag-shaped object labeled after a small block reads before it, so the order reorders the labels.
# Antisymmetry, totality, transitivity; rank agrees with the sequence; refusals by name, determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/reading_order_witness.rish

say "reading_order: Language EN -- Season G whole-scene reading order; reading_order folds scene_graph's per-pair directional flags into one top-to-bottom, left-to-right page order; the total order refines the strict flags' partial one; NO float, NO tolerance."
say "reading_order: Style Radiant -- compose not braid: this rung owns only the total-order comparator, the permutation, and the rank; scene_graph owns the pairwise flag matrix, scene_manifest owns the per-object boxes, label owns the component map. A reading over a reading over a reading over a reading."
say "reading_order: Lens TAME -- the object count rode in under scene_graph_max_objects so the permutation and the selection sort are bounded; a background or past-the-count label and a reads-before of an object with itself refuse BadObjectLabel having read nothing; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/reading_order"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/reading_order.rye -femit-bin=${bin}"]
assert build.ok else "reading_order: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "reading_order: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "reading_order: ${out}"

assert selftest.out contains "GREEN image-reading-order" else "reading_order: selftest did not print the GREEN line"
assert selftest.out contains "fold scene_graph's per-pair directional flags into one top-to-bottom, left-to-right page order" else "reading_order: the fold rule did not print"
assert selftest.out contains "THE READING ORDER OUTRUNS THE STRICT FLAGS" else "reading_order: the outruns-the-flags case did not print"
assert selftest.out contains "the total order names a first where every strict flag is silent" else "reading_order: the flag-silent fact did not print"
assert selftest.out contains "THE READING ORDER REFINES, IT NEVER CONTRADICTS" else "reading_order: the refines-never-contradicts case did not print"
assert selftest.out contains "THE ORDER EARNS ITS KEEP" else "reading_order: the earns-its-keep case did not print"
assert selftest.out contains "genuinely reorders the raster labels 1,2,3,4" else "reading_order: the reordering fact did not print"
assert selftest.out contains "a STRICT TOTAL order" else "reading_order: the total-order claim did not print"
assert selftest.out contains "refuse BadObjectLabel" else "reading_order: the refusal did not print"

say "reading_order: GREEN on metal -- the whole scene's total reading order; the total order refines the strict flags, outrunning them where silent and never reversing them; the sequence reorders the raster labels; antisymmetry, totality, transitivity, rank agreement, refusals by name, determinism. Season G open-media."
