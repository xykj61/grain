# tools/font5x7_boxarc_witness.rish -- the open rounded-corner box set proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), the soft-corner
# companion to tools/font5x7_box_witness.rish's sharp light corners, set beside the double, diagonal, arrow, block,
# and geometric corpora.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn rounded-corner set: the four light arc corners -- arc
# down+right, down+left, up+left, up+right -- at their real Unicode codepoints U+256D..U+2570, each a 5x7 coverage
# grid drawn in the open as ASCII line art in image/font5x7_boxarc.rye, built into a gfa1 atlas and proven on metal.
# These are exactly the corners a modern terminal surface (the Dexter/Scooter family) reaches for to frame a channel
# with a soft, rounded edge rather than a hard right angle. A full round-trip recovers every codepoint, advance, and
# coverage byte byte-for-byte; all four corners look up present and carry the shared advance while an ASCII letter
# misses; no two corners share coverage (the four elbows point four ways); and each corner reads within an honest
# legibility band. Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no
# key, no funds -- the corners a surface reads the day it wants a soft frame, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_boxarc_witness.rish

say "font5x7-boxarc: Language EN -- Season G font content; the four light rounded box corners drawn in the open as ASCII line art, built into the gfa1 atlas, the soft-corner twin of the square box corners the Dexter/Scooter family frames a channel with."
say "font5x7-boxarc: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every corner byte for byte; the rounding is the honest low-resolution ease every bitmap font uses, never a claim of a true curve at 5x7."
say "font5x7-boxarc: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - boxarc_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_boxarc"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_boxarc.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-boxarc: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-boxarc: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-boxarc: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-boxarc' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-boxarc: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-boxarc: round-trip was not byte-identical"

say "font5x7-boxarc: GREEN -- the open rounded-corner box set whole; four arc corners round-trip byte-identical, all present, distinct, and legible; the box family gains its soft corners for a modern rounded frame."
