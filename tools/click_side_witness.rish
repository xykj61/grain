# tools/click_side_witness.rish -- the TWO-ANCHOR WHICH-SIDE read on metal: name a DIRECTED line by TWO anchor taps (from A toward B), then read
# which SIDE of it a THIRD query tap's group falls on -- left, on, or right -- lifting image/click_collinear.rye's cross-product SIGN from a single
# zero-or-not test to the full three-way orientation, through image/click_collinear.rye and image/click_order.rye (Season G).
#
# Season G (Open Media Primitives) -- image/click_collinear.rye reads whether three tapped groups line up (the cross product's zero test); this rung
# reads the cross product's SIGN, the orientation of the triangle. image/hit_test.rye names the ONE object under a point, image/overlap_clusters.rye's
# cluster_of names the connected group, image/click_collinear.rye's click_group_center_doubled reads a group's exact doubled frame center, its
# three_collinear the zero test this rung cross-checks its `on` against, image/click_order.rye's click_group_id resolves a tap to its group. A reading
# over readings -- no plane of its own, no pixel written.
#
# The crux this witness proves on metal: this relation is DIRECTED and role-bearing where collinearity was symmetric, so which_side is ANTISYMMETRIC in
# the two anchors (swapping A and B flips left <-> right while on stays on) where three_collinear was invariant under every permutation. The cross
# product is twice the signed triangle area and its sign the triangle's orientation, the half-plane split the box-is-a-prefilter lesson carried one step
# past collinearity. Over six singleton objects (A center-doubled (5,11), B (21,11), U (13,3), W (13,19), N (29,11), E (21,19)): on the horizontal line
# A -> B, U above reads left, W below reads right, N on it reads on -- and the on set is EXACTLY click_collinear's collinear set (is_on_line iff
# three_collinear). Antisymmetry under the anchor swap; any-slope split on the diagonal A -> E; same_side reading two queries into one half-plane,
# INVARIANT under the swap where which_side is antisymmetric, a query on the line taking no side; the query may coincide with an anchor (reads on). Two
# anchors sharing a group refuse SameGroup; a background tap refuses EmptyClick; an off-map point refuses PointOutOfBounds; determinism. No network, no
# key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/click_side_witness.rish

say "click_side: Language EN -- Season G two-anchor which-side; the cross product's SIGN read as left/on/right, a DIRECTED relation ANTISYMMETRIC in the anchors where collinearity was symmetric; NO float, NO tolerance."
say "click_side: Style Radiant -- compose not braid: this rung owns only the sign-of-the-cross-product reads and the same-side test; click_collinear owns click_group_center_doubled and three_collinear, click_order owns click_group_id, hit_test owns the point-to-object arbiter, overlap_clusters owns cluster_of. No plane of its own, no pixel written -- a reading over readings."
say "click_side: Lens TAME -- each tap resolves to at most one label through the hit test, each frame the group length bounded by label_max_pixels, the cross product in i64 so the doubled-coordinate differences never overflow; two anchors sharing a group refuse SameGroup, a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/click_side"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/click_side.rye -femit-bin=${bin}"]
assert build.ok else "click_side: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "click_side: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out

assert selftest.out contains "GREEN image-click-side" else "click_side: selftest did not print the GREEN line"
assert selftest.out contains "the TWO-ANCHOR WHICH-SIDE read" else "click_side: the two-anchor which-side claim did not print"
assert selftest.out contains "this relation is DIRECTED and ROLE-BEARING where collinearity was symmetric" else "click_side: the decisive crux did not print"
assert selftest.out contains "which_side is ANTISYMMETRIC in the anchors" else "click_side: the antisymmetry claim did not print"
assert selftest.out contains "the ON set is EXACTLY click_collinear's collinear set" else "click_side: the shared-zero-set claim did not print"
assert selftest.out contains "left/right is the orientation against the actual line, not merely above/below" else "click_side: the any-slope claim did not print"
assert selftest.out contains "same_side is INVARIANT under the anchor swap" else "click_side: the same-side invariance claim did not print"
assert selftest.out contains "a point on the divider belongs to neither open half-plane" else "click_side: the on-the-line-takes-no-side claim did not print"
assert selftest.out contains "refuse SameGroup by name" else "click_side: the SameGroup refusal did not print"
assert selftest.out contains "the same line and query read the same side twice" else "click_side: determinism did not print"

say "click_side: GREEN on metal -- the two-anchor which-side read, a directed line named by two anchor taps then a third query read as left/on/right from the cross product's sign, antisymmetric in the anchors where collinearity was symmetric, its zero set exactly the collinear set, same_side reading two queries into one half-plane and invariant under the swap, refusals by name, determinism. Season G open-media."
