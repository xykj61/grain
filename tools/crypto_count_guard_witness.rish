# tools/crypto_count_guard_witness.rish — the count-guard loom for the Season G crypto library. The lantern the reds-first law names:
# a crypto file-count claim drifted from memory twice (REDS %77, then #80 across three living docs at once), so a lantern that fires
# twice becomes a loom. This witness computes the count rather than trusting a typed word, and asserts the measures agree: every
# per-file witness the suite registers has its crypto/<name>.rye, every crypto/<name>.rye is registered in the suite, and the two
# counts match. A file and its proof can never disagree again without this going RED.
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md.
# Kin: tools/crypto_suite_witness.rish (the choir this guards), crypto/README.md and docs/CRYPTO.md (the front doors whose spelled
# counts this witness gives an authoritative number to update from). Booked at work-in-progress/REDS.md #80.
#
# This authors no cryptography — it counts and compares. Purely local: no key, no signature, no network, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/crypto_count_guard_witness.rish

say "crypto-count-guard: Language EN — the count-guard loom: the number of crypto/*.rye files and the number the suite registers must be one number, computed here rather than typed into prose. Booked by REDS %80 after a file-count claim drifted from memory twice."
say "crypto-count-guard: Style Radiant — one measure, two ways: files on disk and registrations in the choir. When they agree, the library's own front-door count is whatever this witness prints — a source of truth for the spelled numbers in crypto/README.md and docs/CRYPTO.md, so no doc need ever guess again."
say "crypto-count-guard: Lens TAME — every crypto/<name>.rye is asserted registered in the suite, and every per-file witness the suite registers (excluding the suite itself and this guard) is asserted to carry its .rye — a bijection, not a bare tally — then the two counts are asserted equal. RED names exactly which name broke the bijection. Purely local — no key, no network, no funds, no device."

let mk = run ["sh" "-c" "mkdir -p crypto/bin"]
assert mk.ok else "crypto-count-guard: could not make crypto/bin — ${mk.err}"

# The crypto/<name>.rye source names, one per line, sorted. Real files only (-type f): a cross-directory composition like
# crypto/bitcoin_address.rye imports encoding/ modules through flat-named symlink shims that live in crypto/ (rye resolves nested
# imports relative to the importing path), and those shims are not primitives the suite proves — counting them would break the bijection.
let list_files = run ["sh" "-c" "find crypto -maxdepth 1 -name '*.rye' -type f | sed 's:.*/::; s:.rye$::' | sort > crypto/bin/.cc_files.txt"]
assert list_files.ok else "crypto-count-guard: could not list crypto/*.rye — ${list_files.err}"

# The per-file witnesses the suite registers, one name per line, sorted, excluding the suite and this guard.
let list_reg = run ["sh" "-c" "grep -oE 'crypto_[a-z0-9_]+_witness' tools/crypto_suite_witness.rish | grep -vE 'suite|count_guard' | sed 's:^crypto_::; s:_witness$::' | sort -u > crypto/bin/.cc_reg.txt"]
assert list_reg.ok else "crypto-count-guard: could not read the suite registrations — ${list_reg.err}"

# Bijection A: every crypto/<name>.rye is registered in the suite (grep -Fxv returns the unmatched names; || true keeps ok on empty).
let unreg = run ["sh" "-c" "grep -Fxv -f crypto/bin/.cc_reg.txt crypto/bin/.cc_files.txt || true"]
assert unreg.ok else "crypto-count-guard: bijection scan A failed — ${unreg.err}"
assert (trim unreg.out) == "" else "crypto-count-guard: crypto/<name>.rye not registered in the suite — ${unreg.out}"

# Bijection B: every suite registration has its crypto/<name>.rye on disk.
let orphan = run ["sh" "-c" "grep -Fxv -f crypto/bin/.cc_files.txt crypto/bin/.cc_reg.txt || true"]
assert orphan.ok else "crypto-count-guard: bijection scan B failed — ${orphan.err}"
assert (trim orphan.out) == "" else "crypto-count-guard: suite registers a witness with no crypto/<name>.rye — ${orphan.out}"

# The two counts must be one number.
let files_c = run ["sh" "-c" "wc -l < crypto/bin/.cc_files.txt | tr -d ' \n'"]
assert files_c.ok else "crypto-count-guard: could not count files — ${files_c.err}"
let n_files = trim files_c.out

let reg_c = run ["sh" "-c" "wc -l < crypto/bin/.cc_reg.txt | tr -d ' \n'"]
assert reg_c.ok else "crypto-count-guard: could not count registrations — ${reg_c.err}"
let n_reg = trim reg_c.out

assert n_files == n_reg else "crypto-count-guard: crypto/*.rye files (${n_files}) != per-file witnesses the suite registers (${n_reg})"

# THE THIRD FIRING BECAME A WIDER LOOM (REDS %105). The bijection above catches a file that is not registered; it did NOT catch the suite
# RECITING a stale count in its own prose. crypto_suite_witness.rish printed "all seventy-four Season G crypto files ... the count guard
# confirms the file count" while this guard measured 81 -- a claim citing its own auditor as agreeing with it, when the auditor said
# otherwise. That is REDS %77 and %80's family a third time, so the loom widens: no count may be recited in the suite at all. The number
# lives here, computed, and every doc and claim line points at it rather than repeating it.
let recite = run ["sh" "-c" "grep -nEi '(one|two|three|four|five|six|seven|eight|nine|ten|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred|[0-9]+)[a-z-]* (season g )?(crypto )?files' tools/crypto_suite_witness.rish || true"]
assert recite.ok else "crypto-count-guard: could not scan the suite for a recited count -- ${recite.err}"
assert (trim recite.out) == "" else "crypto-count-guard: the suite RECITES a file count in its own prose, which is exactly what drifted three times -- remove the number and point at this guard instead. Offending lines: ${recite.out}"

say "GREEN crypto-count-guard — ${n_files} crypto/*.rye files, each registered in the suite and registering a real file; the library's file count is ${n_files}, and the suite recites no count of its own so none can drift (REDS %105)"
