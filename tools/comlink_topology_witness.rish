# comlink_topology_witness.rish — the d12·d60 fractal address space.
#
# Proves the JARL topology: twelve galaxies to a universe, five stars to a galaxy
# (its d5), twelve planets to a star (its d12), a galaxy leading a d60 of sixty.
# A point number decodes to a place, a place has a sponsor (planet→star→galaxy,
# the sponsor tilak's own parent link), and two places share a route counted in
# honest hops — within a galaxy, and one bridge across.
#
# Build first:  rye build comlink/topology.rye -femit-bin=comlink/bin/topology
#   rishi/bin/rishi run tools/comlink_topology_witness.rish

let st = run ["comlink/bin/topology" "selftest"]
assert st.ok else "comlink topology selftest must exit 0"
assert (st.err contains "GREEN") else "topology must report GREEN"
assert (st.err contains "12·5·12") else "the d12·d60 shape must hold"
assert (st.err contains "d60=60") else "a galaxy leads a d60 of sixty"
assert (st.err contains "792/universe") else "a universe holds 792 points"
assert (st.err contains "encode/decode inverse on every point") else "a number and its place round-trip"
assert (st.err contains "sponsor chain planet->star->galaxy") else "the sponsor chain climbs the tiers"
assert (st.err contains "routing by number") else "two places share a route by number"
assert (st.err contains "the geometry is a loadable sky") else "the geometry is a loadable sky, not a hardcoded law"
assert (st.err contains "compass_sky") else "the seated d12·d60 is the compass sky"
assert (st.err contains "council_sky (15·3·9, a d27 of 27, 465/universe)") else "a second sky of a different shape round-trips by the same law"
assert (st.err contains "load like a sky") else "a community may load a shape like a sky"

say "GREEN: comlink topology — the d12·d60 fractal address space: a number names a place, a place has a sponsor, two places share a route; and the geometry is a loadable sky, the seated compass_sky beside a different council_sky that round-trips by the same law."
