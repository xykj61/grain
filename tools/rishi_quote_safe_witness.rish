# rishi_quote_safe_witness.rish — Lap 4 quote safe: single-quoted literal dollar in run argv.
#
#   rishi/bin/rishi run tools/rishi_quote_safe_witness.rish

let out = run ['echo' '$HOME']
assert out.ok else "run with literal dollar failed"
assert out.out contains "$HOME" else "literal dollar missing from output"

let probe = run ["sh" "-c" "test -z \"$HOME\" || echo expanded"]
assert probe.out contains "expanded" else "sanity: shell has HOME set"

say "GREEN: Rishi quote safe — single-quoted argv passes literal dollar."
