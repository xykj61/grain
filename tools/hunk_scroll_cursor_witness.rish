# tools/hunk_scroll_cursor_witness.rish — the scroll cursor: a live viewport offset from a keeper's gesture (HUNK40).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · marketplace / Photos-app surface · rung HUNK40.
# Design read: active-designing/20260813-192957_hunk-scroll-cursor-exploration.md.
# Teacher, thanked clean-room: the scroll viewport of any list surface — a position walks up and down over a library
# taller than the screen, pinned at both ends (concept only, siloed).
#
# HUNK37 gave the installed-book shelf a pager; this rung holds where a keeper's viewport sits. `pond/apps/
# preset_scroll.rye` `ScrollCursor` holds { count, rows, offset } and moves the offset by gestures (line_down,
# page_up, to_top, to_bottom), clamping at both edges so it can never fall off the ends. The one law: a viewport is
# bottom-pinned — the last book reaches the bottom row, never below — so the surface never shows a blank row past the
# end. The reward the pager could not claim: a scroll cursor's window NEVER refuses BadOffset — every reachable
# offset is a real page. The selftest builds a real five-book library, scrolls a two-row viewport through it, and
# proves the top seat, reversible line walks, the bottom pin, clamp-without-under/overflow, every-offset-a-real-page,
# top-to-bottom coverage, a fitting library that never scrolls, and the EmptyViewport refusal. No network, no key,
# no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_scroll_cursor_witness.rish

say "hunk-scroll-cursor: Language EN — HUNK40 holds a keeper's scroll offset over a library larger than the screen: a live viewport that pins at both ends, so a gesture always lands on a real page — no network, no key, no funds."
say "hunk-scroll-cursor: Style Radiant — a page number is a fact about the library; a scroll offset is a fact about the reader. The cursor carries the reader's place, and the bottom always pins true."
say "hunk-scroll-cursor: Lens TAME — a pure bounded state machine over HUNK37's pager, every gesture routed through one clamp, positive invariants per fn, the offset added in u64 so a huge scroll can never wrap; one refusal named (EmptyViewport)."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/preset_scroll"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/preset_scroll.rye -femit-bin=${bin}"]
assert build.ok else "hunk-scroll-cursor: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-scroll-cursor: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-scroll-cursor: ${out}"

let green = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'GREEN preset-scroll' && echo yes"]
assert (trim green.out) == "yes" else "hunk-scroll-cursor: selftest did not print the GREEN preset-scroll line"

let top = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'a fresh cursor sits at the top' && echo yes"]
assert (trim top.out) == "yes" else "hunk-scroll-cursor: the fresh-cursor-at-top seat was not proven"

let walk = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'walk the offset reversibly' && echo yes"]
assert (trim walk.out) == "yes" else "hunk-scroll-cursor: the reversible line walk was not proven"

let pin = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'bottom-pins the last book to the bottom row' && echo yes"]
assert (trim pin.out) == "yes" else "hunk-scroll-cursor: the bottom-pin guarantee was not proven"

let clamp = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'without under/overflow' && echo yes"]
assert (trim clamp.out) == "yes" else "hunk-scroll-cursor: the clamp-without-under/overflow guarantee was not proven"

let real = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the window is a real page (never BadOffset)' && echo yes"]
assert (trim real.out) == "yes" else "hunk-scroll-cursor: the window-never-refuses guarantee was not proven"

let cover = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'paging top-to-bottom shows every one of the five books' && echo yes"]
assert (trim cover.out) == "yes" else "hunk-scroll-cursor: top-to-bottom coverage was not proven"

let fits = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'fits the screen has max_offset 0 and never scrolls' && echo yes"]
assert (trim fits.out) == "yes" else "hunk-scroll-cursor: the fitting-library-never-scrolls guarantee was not proven"

let refuse = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'refuses EmptyViewport' && echo yes"]
assert (trim refuse.out) == "yes" else "hunk-scroll-cursor: the EmptyViewport refusal was not proven"

let bar = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'HUNK41 the scrollbar' && echo yes"]
assert (trim bar.out) == "yes" else "hunk-scroll-cursor: HUNK41 the scrollbar thumb was not proven"

let barpin = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'pinned to the top edge at the top and the bottom edge at the bottom (start + len == track exactly)' && echo yes"]
assert (trim barpin.out) == "yes" else "hunk-scroll-cursor: the scrollbar edge-pin (start + len == track) was not proven"

let barmono = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'start monotone as the offset walks down and the thumb always wholly inside the track' && echo yes"]
assert (trim barmono.out) == "yes" else "hunk-scroll-cursor: the scrollbar monotone-and-inside guarantee was not proven"

let bartrack = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'a zero or over-ceiling track refuses BadTrack' && echo yes"]
assert (trim bartrack.out) == "yes" else "hunk-scroll-cursor: the BadTrack refusal was not proven"

say "hunk-scroll-cursor: GREEN — a keeper's scroll offset walks a library larger than the screen and pins at both ends; every gesture lands on a real page (the window never refuses), scrolling loses nothing, and a library that fits never scrolls. HUNK41 the scrollbar thumb reads a keeper's position honestly — proportional length, edges pinned true, monotone and always inside the track. HUNK37 pager GREEN beneath."
