# caravan_appeal_witness.rish -- Caravan appeal witness.
#
# `tidings.rye` carried the whole arc's finding back to the person it began
# with: one byte into that reader's own box, naming whether the word they
# objected to reads differently now or reads exactly as it read. That is the
# first thing this arc ever sent outward, and it is right.
#
#   THE READER WHO IS TOLD HOW A QUARREL CAME OUT MAY ANSWER THAT TELLING.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO PLANS DISAGREE ON IS READERS WHO ANSWERED HOW THEIR
#     QUARREL CAME OUT AND WHOM NO RUN EVER READ. Every note beneath this rung
#     travels one direction, from the run to the reader; this one travels inward.
#     It falls from 1 to 0.
#   * A DOOR THAT ONLY OPENS OUTWARD, below this rung. The closed run answers its
#     reader, that reader replies in their own hand, and `caravan/.appeals/plan.appeal`
#     stays exactly as the provisioning left it -- silent about whether anybody
#     accepted a word of it.
#   * AN APPEAL IS READ WHERE THE READER WROTE IT, AND RECORDED WHERE AN OPERATOR
#     READS. Two halves facing opposite ways: one byte the reader writes into
#     `caravan/.readers/desk.press`, and one byte the run writes into
#     `caravan/.appeals/plan.appeal`.
#   * A PLEA IS QUOTED, AND NEVER COMPOSED. No run of this plan writes a reader's
#     `.press`, exactly as no run writes their answer or their renewal. The
#     selftest harness seats it standing in for the reader by name.
#   * BOTH PLEAS RIDE THE WIRE, not only the fold. The lap proves `presses` end to
#     end; the accepting plea is proven twice -- once written to a reader of the
#     fold's own and read back out of their box, and once by a third run whose
#     reader accepts, so the record ends the lap reading `a`.
#   * THE PRICE IS ONE BYTE IN A NOTE AN OPERATOR ALREADY OPENS. Both runs take up
#     6 phases, absorb 3 into standing dependents, lose 3 arcs, take the same
#     judgment back, re-seat the same 3 phases, spend the same 6 dependents, post
#     and carry the same correction, read the same answer, record the same
#     disagreement, escort the same published word, ask the same reader whether
#     they still object, read the same silence, stand the same mark, tell the same
#     raiser how it came out, and settle the plan `carried`.
#   * A PLAN PUBLISHES WHETHER IT READS BACK AT ALL. The word is plan-level beside
#     the tidings, since it instructs about who a record listens to rather than
#     about one arc.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE READING BACK RATHER THAN THE
#     QUARREL IT CLOSES. `AppealEarly` is the moment. `AppealUnvoiced` is the hard
#     half -- a plea recorded where the reader's own hand wrote nothing is a
#     supervisor filing an objection on their behalf and calling it theirs.
#     `AppealMiscounted` is the honesty of the count. `AppealMisrecorded` is the
#     record -- a published plea that disagrees with the byte in the reader's box.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Publish
# the other plea and the run refuses `AppealMisrecorded`. Count one reader twice
# and it refuses `AppealMiscounted`. Read a plea where nobody was ever told and it
# refuses `AppealEarly` -- reaching that one takes disarming the count invariant
# and the closed-run invariant first, since both fire before the refusal can, and
# the asserts are doing their job. File a plea the reader never wrote and it
# refuses `AppealUnvoiced`. Disarm every guard at once -- the note never written,
# the read-back skipped, the provisioning invariant, and all three harness reads
# that catch them -- and the selftest calls itself GREEN while
# `caravan/.appeals/plan.appeal` still holds the cleared zero byte, beside a
# `desk.press` reading `a` that nobody ever opened. Seeing that once is what makes
# the reading back a check rather than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_appeal_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/appeal"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/appeal.rye -femit-bin=${bin}"]

assert build.ok else "caravan appeal build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/appeal_read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/appeal_read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. The box goes with them, so the lap begins with a reader who
# has neither been told anything, nor said anything, nor replied to anything a
# run this witness never watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.appeals caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan appeal selftest exited non-zero"
assert test.out contains "GREEN" else "caravan appeal selftest not GREEN"
assert test.out contains "a run reads what its reader says to the answer it sent" else "the appeal finding did not close"

# The appeal and its three standing refusals, read straight, before any dependent
# runs. The fourth, `AppealMisrecorded`, is answered in the same fold, since
# whether a published plea quotes its reader is a question those two bytes can
# settle between themselves.
assert test.out contains "a plan publishes whether it reads what its reader says back" else "the appeal fold was not weighed"
assert test.out contains "three refusals stand by name: early, unvoiced, miscounted" else "the three appeal refusals did not stand"
assert test.out contains "the reader presses their quarrel still" else "a pressed quarrel did not read as one"

# Both pleas ride the wire, written by a reader of the fold's own and read back
# out of their box -- never touching the box the lap depends on.
assert test.out contains "both pleas ride the wire" else "the other plea was never proven on the wire"

# The tidings below it, unchanged and still weighed.
assert test.out contains "a plan publishes whether it writes back to the reader who objected" else "the tidings below stopped being weighed"
assert test.out contains "the word you objected to reads differently now" else "a moved word did not read as one"

# The standing, the term, the escort, the record, the hearing, the delivery, the
# amendment, the recantation, the bearing, and the mend below, unchanged.
assert test.out contains "a plan publishes whether its marks carry the standing of their objection" else "the standing below stopped being weighed"
assert test.out contains "a plan publishes how long the objection beside its word may stand" else "the term below stopped being weighed"
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort below stopped being weighed"
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The appeal lap: one plan run twice over a reader who answers the outcome it
# sent them, once leaving that answer sitting unread and once reading it back.
# Every number stands still -- the work, the dependents, the correction, the
# journey, the record, the escort, the asking, the silence, the mark, the
# telling, the settlement -- and only the reading back moves.
assert test.out contains "phases: 6 closed, 6 open" else "the two plans ran different records"
assert test.out contains "dependents: 6 closed, 6 open" else "reading back cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 closed, 3 open" else "the two plans absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 closed, 3 open" else "the two plans lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 closed, 3 open" else "the two plans repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 closed, 1 open" else "the recanting rung stopped moving under both plans"
assert test.out contains "readings corrected where they were read: 1 closed, 1 open" else "the amending rung stopped moving under both plans"
assert test.out contains "corrections carried to the place their reader was reached: 1 closed, 1 open" else "the couriering rung stopped moving under both plans"
assert test.out contains "disagreements written into the record: 1 closed, 1 open" else "the disputing rung stopped moving under both plans"
assert test.out contains "published words standing beside the reading against them: 1 closed, 1 open" else "the abiding rung stopped moving under both plans"
assert test.out contains "standing objections put back to the reader who raised them: 1 closed, 1 open" else "the lapsing rung stopped asking under both plans"
assert test.out contains "objections nobody renewed, let go rather than resolved: 1 closed, 1 open" else "the two plans read different silences"
assert test.out contains "marks carrying the standing of the objection they quote: 1 closed, 1 open" else "the standing below stopped moving under both plans"
assert test.out contains "raisers told how their own quarrel came out: 1 closed, 1 open" else "the tidings below stopped moving under both plans"
assert test.out contains "objections weighed whose raiser was never told how it came out: 0 closed, 0 open" else "a raiser went untold under one of the two plans"
assert test.out contains "readers whose reply to the answer was read back: 0 closed, 1 open" else "the appeal did not part the two plans"
assert test.out contains "readers left exactly as the rung below leaves them: 1 closed, 0 open" else "the other half of the count did not close"
assert test.out contains "readers who answered how their quarrel came out and were never read: 1 against 0" else "the two plans read the same reader"
assert test.out contains "work still standing when the supervisor exits: 0 closed, 0 open" else "the two plans left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole closed, carried out whole open" else "the two plans settled the plan differently"
assert test.out contains "breaks a named turn: 0 closed, 0 open" else "the open run broke an order its author named"

# The other answers the same questions admit, proven on the same wire rather than
# only as folds.
assert test.out contains "a reader who raises their objection again has the mark say so" else "a renewing reader was never proven on the wire"
assert test.out contains "a reader content with the outcome has the record say so" else "an accepting reader was never proven on the wire"

# What an operator reads is what the wire carries, and what a reader writes is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.appeals/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The one note this rung adds, where an operator opens the plan. The wire's final
# word is the third run's, whose reader accepts how it came out -- so it reads
# `a`, quoted from that reader's own hand rather than composed by any run.
let plea = run ["sh" "-c" "cat caravan/.appeals/plan.appeal"]
assert plea.ok else "the plan published no plea an operator could read"
assert plea.out contains "a" else "a reader content with the outcome was published as one still pressing"

# The reader's own reply, in their own box, outside this plan's wire entirely.
let press = run ["sh" "-c" "cat caravan/.readers/desk.press"]
assert press.ok else "the reader replied nothing at all"
assert press.out contains "a" else "the record and the reader's own hand read differently"

# The mark itself, carrying both the reading its reader holds and the standing of
# that objection, exactly as the rungs below write it.
let beside = run ["sh" "-c" "cat caravan/.appeals/plan.beside"]
assert beside.ok else "a run withdrew the mark its reader earned"
assert beside.out contains "sh" else "the mark did not name the reading its reader holds and the standing they hold it in"

let term = run ["sh" "-c" "cat caravan/.appeals/plan.term"]
assert term.ok else "no term was ever published an operator could read"
assert term.out contains "r" else "a reader who raised their objection again had it let go"

let question = run ["sh" "-c" "cat caravan/.readers/desk.again"]
assert question.ok else "a standing run let an objection go without ever asking"
assert question.out contains "cs" else "the question named a quarrel its reader never raised"

let quarrel = run ["sh" "-c" "cat caravan/.appeals/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.appeals/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let address = run ["sh" "-c" "cat caravan/.appeals/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

# The reader's own box, outside this plan's wire entirely -- the letter the plan
# carried, the hand they answered with, the second hand they raised, and the
# outcome this arc finally told them.
let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let hand = run ["sh" "-c" "cat caravan/.readers/desk.said"]
assert hand.ok else "the reader answered nothing at all"
assert hand.out contains "s" else "the reader's own hand did not name the reading they hold"

let outof = run ["sh" "-c" "cat caravan/.readers/desk.outof"]
assert outof.ok else "the raiser of the quarrel was never told how it came out"
assert outof.out contains "t" else "a word that never moved was reported to its raiser as one that did"

let still = run ["sh" "-c" "cat caravan/.readers/desk.still"]
assert still.ok else "the reader raised nothing again"
assert still.out contains "s" else "the second hand did not raise the objection the record holds"

let recant_note = run ["sh" "-c" "cat caravan/.appeals/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.appeals/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan appeal witness passed."
