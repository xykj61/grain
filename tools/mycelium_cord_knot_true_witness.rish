# tools/mycelium_cord_knot_true_witness.rish — the Knot reads true (checkpointing r4, the arc closes).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · checkpointing · rung r4.
# r1 proved a checkpoint folds identical to the whole history, r2 let it travel, r3 measured the bound win —
# all over Knots sealed in code. This closing rung carries the reader onto a real on-disk format cord-knot-v1
# record a keeper can open and add up. The app parses the record, verifies the recovered Knot against its own
# digest, and reports the folded supply and star count; this witness cross-checks that pair against
# tools/fixtures/cord_knot_truth.awk reading the same bytes — two tools, one answer (700 1). The fixture is
# genuinely what the Knot emits (reproducible via mycelium/cord_knot_fixture_gen.rye), it verifies, it
# re-renders to the embedded bytes exactly, and a tampered record is never read as true. Demo keeper seeds
# only — no real key, no funds, no network, no custody.
#
# Scope: active-designing/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_cord_knot_true_witness.rish

say "mycelium-cord-knot-true: Language EN — the reading of a real Knot record is true to the bytes; app and awk give one answer."
say "mycelium-cord-knot-true: Style Radiant — the sealed supply is drawn from the ground and counted by hand; what it says is what a keeper can add up."
say "mycelium-cord-knot-true: Lens TAME — supply and stars cross-check against an independent awk; the Knot verified against its own digest; a tampered record never read as true; demo seeds only."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_knot_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-knot-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-cord-knot-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-knot-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent count of the same bytes" else "mycelium-cord-knot-true: truth-pair claim missing"
assert selftest.out contains "verifies, re-renders to the embedded bytes exactly, and continues to a lawful supply" else "mycelium-cord-knot-true: genuine-knot claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-cord-knot-true: tamper-refusal claim missing"

# The crux — two tools, one answer. The app's measure pair must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-cord-knot-true: measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/cord_knot_truth.awk tools/fixtures/cord_knot.bron"]
assert awk.ok else "mycelium-cord-knot-true: awk truth read failed"
assert awk.out contains "700 1" else "mycelium-cord-knot-true: awk pair not 700 1"
assert app.out == awk.out else "mycelium-cord-knot-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is genuinely what the Knot emits — regenerate and diff, proving no hand-mock.
let gen = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot_fixture_gen.rye -femit-bin=mycelium/bin/cord_knot_fixture_gen"]
assert gen.ok else "mycelium-cord-knot-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/cord_knot_fixture_gen 2> /tmp/cord_knot_regen.bron; diff tools/fixtures/cord_knot.bron /tmp/cord_knot_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-cord-knot-true: fixture regeneration failed"
assert regen.out contains "REPRODUCIBLE" else "mycelium-cord-knot-true: the regenerated fixture drifted from the committed one"

# The travel (r2) and throughput (r3) rounds the reader stands on stay GREEN at this door.
let r2 = run ["sh" "-c" "rishi/bin/rishi run tools/mycelium_cord_knot_bron_witness.rish 2>&1"]
assert r2.ok else "mycelium-cord-knot-true: the r2 travel round is not GREEN"
assert r2.out contains "GREEN" else "mycelium-cord-knot-true: the r2 travel round did not speak its GREEN"

let r3 = run ["sh" "-c" "rishi/bin/rishi run tools/mycelium_cord_knot_bench_witness.rish 2>&1"]
assert r3.ok else "mycelium-cord-knot-true: the r3 bound-win round is not GREEN"
assert r3.out contains "GREEN" else "mycelium-cord-knot-true: the r3 bound-win round did not speak its GREEN"

say "mycelium-cord-knot-true: GREEN — a real Knot record reads true (app==awk, 700 1), the recovered Knot verifies against its own digest and continues to a lawful supply, its fixture reproducible; the travel and throughput rounds stand at r4's door. The Mycelium checkpointing arc closes."
