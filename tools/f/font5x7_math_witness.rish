# tools/f/font5x7_math_witness.rish -- the open math/technical-marks corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora and the wider-symbol corpora that opened next (tools/f/font5x7_box_witness.rish the light box marks,
# tools/f/font5x7_boxdouble_witness.rish the double, tools/f/font5x7_boxdiag_witness.rish the diagonal,
# tools/f/font5x7_boxarc_witness.rish the rounded corners, tools/f/font5x7_arrow_witness.rish the arrows,
# tools/f/font5x7_block_witness.rish the block elements, tools/f/font5x7_geometric_witness.rish the geometric marks).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn math/technical-marks corpus: the ten operators a terminal
# surface shows in a readout -- the degree sign, plus-minus, multiplication and division signs, the true minus,
# infinity, approximately-equal, not-equal, and the less-than-or-equal and greater-than-or-equal comparisons -- at
# their real Unicode codepoints U+00B0, U+00B1, U+00D7, U+00F7, U+2212, U+221E, U+2248, U+2260, U+2264, U+2265, each a
# 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_math.rye, built into a gfa1 atlas and proven
# on metal. A full round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all ten marks look up
# present and carry the shared advance while an ASCII letter misses; no two marks share coverage (a real operator set's
# glyphs differ); each mark reads within an honest legibility band; and the family orders hold -- plus-minus and
# not-equal each out-ink the bare minus, and the two comparison marks mirror to equal weight. Compression is reported
# as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds -- the operators a surface
# reads the day it prints a readout, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_math_witness.rish

say "font5x7-math: Language EN -- Season G font content; the ten math/technical marks (degree, plus-minus, multiplication, division, minus, infinity, approximately-equal, not-equal, and the two comparisons) drawn in the open as ASCII line art, built into the gfa1 atlas, the operators a terminal surface prints in a readout."
say "font5x7-math: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every mark byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-math: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - math_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_math"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_math.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-math: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-math: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-math: ${out}"

assert selftest.out contains "GREEN image-font5x7-math" else "font5x7-math: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-math: round-trip was not byte-identical"

say "font5x7-math: GREEN -- the open math/technical-marks corpus whole; ten operators round-trip byte-identical, all present, distinct, and legible, the plus-minus and not-equal out-inking the bare minus and the two comparisons mirrored; the font gains the operators a terminal prints in a readout."
