# tools/f/font5x7_block_witness.rish -- the open block-elements corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - more content BEYOND printable ASCII for the open glyph atlas image/glyph.rye
# (gfa1), a sibling of the box-drawing witnesses (tools/f/font5x7_box_witness.rish, tools/f/font5x7_boxdouble_witness.rish)
# and the arrow witness (tools/f/font5x7_arrow_witness.rish), beside the five ASCII corpora.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn block-elements corpus: the four half blocks (upper, lower,
# left, right), the full block, and the three shade densities (light, medium, dark) at their real Unicode codepoints
# U+2580..U+2593, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_block.rye, built into
# a gfa1 atlas and proven on metal. These are exactly the marks a terminal surface (the Dexter/Scooter family) reaches
# for to draw a shaded panel, a progress bar, or a low-fi image preview at half-cell resolution. A full round-trip
# recovers every codepoint, advance, and coverage byte byte-for-byte; all eight blocks look up present and carry the
# shared advance while an ASCII letter misses; no two blocks share coverage; the half blocks PARTITION the cell (upper
# with lower, left with right, each pair tiling the body exactly); and the shades form a strictly rising RAMP under the
# full block (light < medium < dark < full), the grayscale ladder a surface reads. Compression is reported as a fact,
# never asserted -- the round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it
# wants to shade a cell.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_block_witness.rish

say "font5x7-block: Language EN -- Season G font content beyond ASCII; the four half blocks, the full block, and three shade densities drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a terminal surface uses to fill and shade a cell."
say "font5x7-block: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every block byte for byte; the half blocks partition the cell and the shades rise in a strict ramp; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-block: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - block_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_block"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_block.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-block: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-block: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-block: ${out}"

assert selftest.out contains "GREEN image-font5x7-block" else "font5x7-block: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-block: round-trip was not byte-identical"

assert selftest.out contains "shades ramp" else "font5x7-block: the shade ramp line was not printed"

say "font5x7-block: GREEN -- the open block-elements corpus whole; eight blocks round-trip byte-identical, present, distinct, the halves partition and the shades ramp; the font family gains its fills and shades."
