# tools/f/font5x7_currency_witness.rish -- the open currency-signs corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora and the wider-symbol corpora that opened next (tools/f/font5x7_box_witness.rish the light box marks,
# tools/f/font5x7_boxdouble_witness.rish the double, tools/f/font5x7_boxdiag_witness.rish the diagonal,
# tools/f/font5x7_boxarc_witness.rish the rounded corners, tools/f/font5x7_arrow_witness.rish the arrows,
# tools/f/font5x7_block_witness.rish the block elements, tools/f/font5x7_geometric_witness.rish the geometric marks,
# tools/f/font5x7_math_witness.rish the math/technical operators).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn currency-signs corpus: the eight marks a terminal surface
# prints when it shows a PRICE, the marks ASCII lacks -- the cent, pound, generic-currency, and yen signs of Latin-1,
# then the won, euro, Indian-rupee, and bitcoin signs of the currency-symbols block -- at their real Unicode codepoints
# U+00A2, U+00A3, U+00A4, U+00A5, U+20A9, U+20AC, U+20B9, U+20BF, each a 5x7 coverage grid drawn in the open as ASCII
# line art in image/font5x7_currency.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers every
# codepoint, advance, and coverage byte byte-for-byte; all eight signs look up present and carry the shared advance
# while an ASCII letter misses; no two signs share coverage (a real currency set's glyphs differ); each sign reads
# within an honest legibility band; and the family orders hold -- the euro out-inks the cent, and the won out-inks the
# yen. Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds --
# the marks a surface reads the day it prints a price, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_currency_witness.rish

say "font5x7-currency: Language EN -- Season G font content; the eight currency signs (cent, pound, generic-currency, yen, won, euro, Indian-rupee, bitcoin) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a terminal surface prints when it shows a price."
say "font5x7-currency: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every sign byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-currency: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - currency_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_currency"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_currency.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-currency: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-currency: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-currency: ${out}"

assert selftest.out contains "GREEN image-font5x7-currency" else "font5x7-currency: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-currency: round-trip was not byte-identical"

say "font5x7-currency: GREEN -- the open currency-signs corpus whole; eight marks round-trip byte-identical, all present, distinct, and legible, the euro out-inking the cent and the won the yen; the font gains the marks a fair-trade readout prints when it shows a price."
