# tools/f/font5x7_greek_upper_witness.rish -- the open Greek CAPITALS corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), the uppercase
# companion to tools/f/font5x7_greek_witness.rish (the capitals Delta, Sigma, Omega and the nine lowercase alpha..omega).
# Set beside the Latin CAPITAL corpora (upper_accented, upper_latin1, upper_nordic, upper_icelandic).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Greek CAPITALS corpus: the seven DISTINCT uppercase letters a
# formula sets that ASCII cannot fold (the other Greek capitals are Latin twins) -- Gamma, Theta, Lambda, Xi, Pi, Phi,
# Psi -- at their real Unicode codepoints U+0393, U+0398, U+039B, U+039E, U+03A0, U+03A6, U+03A8, each a 5x7 coverage
# grid drawn in the open as ASCII line art in image/font5x7_greek_upper.rye, built into a gfa1 atlas and proven on metal.
# A full round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all seven look up present and
# carry the shared advance while a Latin-twin ASCII 'P' misses; the seven carry distinct coverage; each reads within an
# honest legibility band; and the seven CONSTRUCTIONS hold -- Gamma's bar over a lone left stem, Theta's crossed oval,
# Lambda's spread apex, Xi's three stemless bars, Pi's two legs, Phi's crossed stem, Psi's gathering prongs. Compression
# is reported as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds -- the Greek capitals
# a science surface reads the day it prints a formula.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_greek_upper_witness.rish

say "font5x7-greek-upper: Language EN -- Season G font content; the seven distinct Greek CAPITALS (Gamma, Theta, Lambda, Xi, Pi, Phi, Psi) drawn in the open as ASCII line art, built into the gfa1 atlas, the capitals a science surface prints in a formula that ASCII cannot fold -- the uppercase Greek letters the lowercase Greek corpus never reached."
say "font5x7-greek-upper: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; seven capitals built seven ways (Gamma's bar-and-stem, Theta's crossed oval, Lambda's apex, Xi's three bars, Pi's two legs, Phi's crossed stem, Psi's prongs), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-greek-upper: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - greek_upper_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_greek_upper"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_greek_upper.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-greek-upper: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-greek-upper: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-greek-upper: ${out}"

assert selftest.out contains "GREEN image-font5x7-greek-upper" else "font5x7-greek-upper: selftest did not print the GREEN corpus line"

say "font5x7-greek-upper: GREEN -- the capitals Gamma, Theta, Lambda, Xi, Pi, Phi, Psi stand drawn in the open, extending the Greek uppercase letters ASCII cannot fold, proven on metal."
