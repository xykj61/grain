# tools/f/font5x7_german_witness.rish -- the open German letters corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora, the Greek letters, the sub/superscript and fraction corpora, and the accent
# trio: the Latin-1 acute/cedilla corpus (tools/f/font5x7_latin1_witness.rish), the grave vowels
# (tools/f/font5x7_grave_witness.rish), and the circumflex vowels (tools/f/font5x7_circumflex_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn German letters corpus: the two remaining umlaut vowels
# (a umlaut, o umlaut -- the u umlaut already lives in the acute/cedilla corpus) and the eszett (the sharp s), at their
# real Unicode codepoints U+00DF, U+00E4, U+00F6, each a 5x7 coverage grid drawn in the open as ASCII line art in
# image/font5x7_german.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint,
# advance, and coverage byte byte-for-byte; all three letters look up present and carry the shared advance while an
# ASCII letter misses; no two letters share coverage (each name is spelled with its own glyph); each letter reads within
# an honest legibility band; and the umlaut-versus-letterform placement holds -- the two umlauts each carry two separated
# dots on the top row (ink at columns 1 and 3, a gap at the center), while the eszett is a joined letterform with ink on
# the center column where an umlaut leaves a gap. Compression is reported as a fact, never asserted -- the round-trip is
# the proof. No network, no key, no funds -- the marks a surface reads the day it prints a name that ASCII cannot spell,
# on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_german_witness.rish

say "font5x7-german: Language EN -- Season G font content; the two remaining umlaut vowels (a umlaut, o umlaut) and the eszett drawn in the open as ASCII line art, built into the gfa1 atlas, the letters a civic surface prints when it spells a German keeper's own name (Muller, Schafer, Weiss)."
say "font5x7-german: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; the umlaut is two separated dots and the eszett a joined letter, our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-german: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - german_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_german"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_german.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-german: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-german: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-german: ${out}"

assert selftest.out contains "GREEN image-font5x7-german" else "font5x7-german: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-german: round-trip was not byte-identical"

assert selftest.out contains "the two umlauts two-dotted with a center gap, the eszett a joined letterform" else "font5x7-german: umlaut/eszett placement did not hold"

say "font5x7-german: GREEN -- the open German letters corpus whole; three marks round-trip byte-identical, all present, distinct, and legible, the two umlauts two-dotted and the eszett a joined letterform; with the u umlaut already drawn, the font can spell a German keeper's own name that ASCII cannot."
