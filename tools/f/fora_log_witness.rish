# tools/f/fora_log_witness.rish -- a sequence of decrees the whole sky agrees on, in order (FORA12).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium -- the tree's own consensus) - waymark FORA - rung
# FORA12. Design read: active-designing/date/20260814/20260814-054414_fora12-constel-replicated-log.md
# Law kin: .claude/rules/placeholder-ship-names.md -- the border guards every accept: a decree's replies deframe at the
# naming-law border (wire.deframe), so a real address can never enter a log entry even as an accept.
#
# constel/log.rye orders FORA11's decrees into a bounded, append-only replicated log: each entry is one committed decree, and
# because each index commits at most one value, two logs that replicate the same committed decrees are identical entry for
# entry -- no fork is possible. append grows the log in order (LogFull at the cap, NoEntry past the committed prefix);
# run_and_append runs a decree and appends only on a clean commit, leaving the log unchanged on any failure. The selftest
# proves: append grows in order and reads back, bounded; run_and_append over a real sky commits a sequence in order; two logs
# replicating the same sequence match (no fork), and a log one entry short honestly does not; a failed decree does not grow
# the log; and a full constellation of eight appends bounded.
# Purely local -- no socket, no network, no keys, no funds, no real address ever formed.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/fora_log_witness.rish

say "fora-log: Language EN — FORA12 orders FORA11's decrees into an append-only log: because each index commits at most one value, two piers replicating the same committed decrees hold an identical log entry for entry, so the ledger every consensus produces can never fork."
say "fora-log: Style Radiant — one value became a sequence, the sequence a ledger no pier can fork; the log grows only forward, index zero first, each entry committed by a majority."
say "fora-log: Lens TAME — the log is bounded (LogFull at max_entries) and append-only (a committed entry is never rewritten, exactly Mantra's order); run_and_append leaves the log unchanged on any failure, so no gap or uncommitted value; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate %2 and gate %4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/log"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/log.rye -femit-bin=${bin}"]
assert build.ok else "fora-log: build failed — ${build.err}"

let outfile = "constel/bin/log.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "fora-log: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "fora-log: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN fora-log' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "fora-log: selftest did not print the GREEN fora-log line"

say "fora-log: GREEN — the decrees become an ordered, unforkable ledger; the constel consensus track now produces the append-only log a real protocol exists to build, proven pure on the bench."
