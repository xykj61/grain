# tools/f/fora_transfer_witness.rish -- leadership transfers only to a caught-up successor, TimeoutNow (FORA23).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium -- the tree's own consensus) - waymark FORA - rung
# FORA23. Design read: active-designing/date/20260814/20260814-084700_fora23-constel-transfer-leadership.md
#
# constel/transfer.rye gives the sky an orderly HANDOFF (Raft §3.10): the prior leader stops taking entries, brings a chosen
# target fully up to date (FORA17), then sends TimeoutNow so the target campaigns immediately -- skipping the election timeout. The
# crux is safety through the handoff: a transfer is authorized ONLY to a caught-up target, so the successor holds every committed
# entry and Leader Completeness (FORA21) is preserved, not bypassed. The selftest proves: is_caught_up is an exact head match;
# may_transfer / timeout_now authorize only a caught-up in-roster target and refuse the rest (TargetNotCaughtUp, TargetOutOfRoster)
# by name; the campaign term is exactly one bump; a caught-up target wins its immediate election over vote.poll; the old leader
# steps down only on a strictly higher term; bounded. Purely local -- no socket, no network, no keys, no funds, no real address.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/fora_transfer_witness.rish

say "fora-transfer: Language EN — FORA23 gives Constel a planned leadership handoff (Raft §3.10): the leader brings a chosen successor fully current, then sends TimeoutNow so it campaigns at once — a handoff authorized only to a caught-up target, so the successor holds the sky's whole settled history."
say "fora-transfer: Style Radiant — a leader that must step aside chooses the hand that already holds everything it held, so nothing settled is ever lost across the change."
say "fora-transfer: Lens TAME — is_caught_up is an exact head match guarded by at_least_as_current (FORA21); timeout_now refuses TargetNotCaughtUp and TargetOutOfRoster by name and bumps the term by exactly one; the win is proven over vote.poll; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate %2 and gate %4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/transfer"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/transfer.rye -femit-bin=${bin}"]
assert build.ok else "fora-transfer: build failed — ${build.err}"

let outfile = "constel/bin/transfer.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "fora-transfer: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "fora-transfer: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN fora-transfer' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "fora-transfer: selftest did not print the GREEN fora-transfer line"

say "fora-transfer: GREEN — leadership transfers only to a caught-up successor; the constel consensus track now hands off the sky on purpose without ever raising a leader that lacks its settled history, proven pure on the bench."
