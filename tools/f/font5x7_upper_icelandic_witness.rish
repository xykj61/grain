# tools/f/font5x7_upper_icelandic_witness.rish -- the open Icelandic CAPITALS corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), the uppercase
# companion to tools/f/font5x7_icelandic_witness.rish (the lowercase eth, y acute, thorn). Set beside the accented and
# Danish-Norwegian CAPITAL corpora (tools/f/font5x7_upper_accented_witness.rish, tools/f/font5x7_upper_latin1_witness.rish,
# tools/f/font5x7_upper_nordic_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Icelandic CAPITALS corpus: the three uppercase letters an
# Icelandic name reaches for in ALL-CAPS that the accented and Scandinavian capital corpora never drew -- Eth, Y acute,
# Thorn -- at their real Unicode codepoints U+00D0, U+00DD, U+00DE, each a 5x7 coverage grid drawn in the open as ASCII
# line art in image/font5x7_upper_icelandic.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers
# every codepoint, advance, and coverage byte byte-for-byte; all three capitals look up present and carry the shared
# advance while a plain ASCII 'Y' misses; the three carry distinct coverage; each reads within an honest legibility band;
# and the three CONSTRUCTIONS hold -- Eth is a full-height capital D crossed by a bar (a top bar and a bottom bar closing
# the bowl, a crossbar on the middle row crossing the stem into it), Thorn stands a full-height stem open at top and
# bottom with a bowl at its middle, and Y acute leans its stroke right (top-row ink in the right half, none in the left).
# Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds -- the
# capitals a surface reads when it prints an Icelandic keeper's own name in ALL-CAPS.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_upper_icelandic_witness.rish

say "font5x7-upper-icelandic: Language EN -- Season G font content; the three Icelandic CAPITALS (Eth, Y acute, Thorn) drawn in the open as ASCII line art, built into the gfa1 atlas, the capitals a civic surface prints when it spells an Icelandic keeper's own name in ALL-CAPS -- the uppercase letters the accented and Scandinavian capital corpora never reached."
say "font5x7-upper-icelandic: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; three capitals built three ways (Eth's crossed D, Thorn's full-height stem, Y acute's right lean), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-upper-icelandic: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - upper_icelandic_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_upper_icelandic"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_upper_icelandic.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-upper-icelandic: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-upper-icelandic: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-upper-icelandic: ${out}"

assert selftest.out contains "GREEN image-font5x7-upper-icelandic" else "font5x7-upper-icelandic: selftest did not print the GREEN corpus line"

say "font5x7-upper-icelandic: GREEN -- the capitals Eth, Y acute, Thorn stand drawn in the open, closing the Icelandic uppercase letters, proven on metal."
