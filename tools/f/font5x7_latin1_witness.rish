# tools/f/font5x7_latin1_witness.rish -- the open Latin-1 accented-letters corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/f/font5x7_greek_witness.rish), and the
# sub/superscript and fraction corpora.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Latin-1 accented-letters corpus: the eight accented lowercase
# letters a real name in a Romance language reaches for -- a acute, c cedilla, e acute, i acute, n tilde, o acute,
# u acute, u diaeresis -- at their real Unicode codepoints U+00E1, U+00E7, U+00E9, U+00ED, U+00F1, U+00F3, U+00FA,
# U+00FC, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_latin1.rye, built into a gfa1
# atlas and proven on metal. A full round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all
# eight letters look up present and carry the shared advance while an unaccented ASCII letter misses; no two letters
# share coverage (each accented name is spelled with its own glyph); each letter reads within an honest legibility band;
# and the diacritic placement holds -- the seven above-marked letters each carry ink on their top row while the c
# cedilla alone leaves its top row empty and hangs its mark beneath. Compression is reported as a fact, never asserted
# -- the round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it prints a name
# that ASCII cannot spell, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_latin1_witness.rish

say "font5x7-latin1: Language EN -- Season G font content; the eight Latin-1 accented lowercase letters (a acute, c cedilla, e acute, i acute, n tilde, o acute, u acute, u diaeresis) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a civic surface prints when it spells a keeper's own name."
say "font5x7-latin1: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-latin1: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - latin1_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_latin1"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_latin1.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-latin1: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-latin1: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-latin1: ${out}"

assert selftest.out contains "GREEN image-font5x7-latin1" else "font5x7-latin1: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-latin1: round-trip was not byte-identical"

say "font5x7-latin1: GREEN -- the open Latin-1 accented-letters corpus whole; eight marks round-trip byte-identical, all present, distinct, and legible, seven marked above and the c cedilla below; the font gains the letters a civic surface needs to spell a name that ASCII cannot."
