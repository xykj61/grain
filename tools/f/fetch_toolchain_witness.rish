# tools/f/fetch_toolchain_witness.rish -- the toolchain fetch, and the refusal that makes it safe.
#
# WHY THIS RUNG. `tools/fixtures/fetch_toolchain_scan.sh` decides, on ONE comparison, whether 55
# megabytes of downloaded binary become the compiler that builds everything in this tree. It is
# the single most consequential `if` on the beginner path: a reader running it has no way to check
# the answer themselves, and every byte they compile afterward rests on it.
#
# WHAT IS PROVEN HERE, all on metal and none of it over the network.
#
#   The refusal works. Bytes that match are accepted, bytes with ONE character flipped are
#   REFUSED, and a file that is not there is refused too -- three cases whose answers are known
#   before the tool runs. The network is not the thing under test; the refusal is.
#
#   The checksums are shaped like checksums. Four platforms, each pinned to sixty-four hex
#   characters. A truncated or hand-mangled pin is caught here rather than at a stranger's first
#   download.
#
#   The plan path touches nothing, and the tool is idempotent where the toolchain already stands.
#
#   The pin is in the REPOSITORY, not fetched beside the tarball. Reading the expected hash from
#   the same host that serves the file protects against a corrupted download and nothing else --
#   whoever controls the host controls both numbers. This asserts the pins live in the tool.
#
# WHAT IS NOT PROVEN. No download happens here, so this does not prove ziglang.org is reachable or
# that the published bytes still match -- that is the network's business and it is checked the
# moment a reader actually fetches. The `minisign` leg of the seated policy
# (context/specs/20260627-102012_one-clock-naming-law.md) is not run either, because minisign is
# absent from this pier; the pinned sha256 is the protection this tool actually provides, and
# saying so is better than implying two checks where one runs.
#
# Season: the Standfast restrategizing of `20260821` -- smoothing the beginner path's roughest edge.
# Kin: tools/f/fetch_toolchain.rish - docs-geode/tutorials/the-first-hour.md - the policy at
# context/specs/20260627-102012_one-clock-naming-law.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/fetch_toolchain_witness.rish

say "fetch-toolchain: Language EN -- one comparison decides whether 55 megabytes become the compiler that builds everything here. This proves that comparison refuses."
say "fetch-toolchain: Style Radiant -- three claims. The refusal catches a single flipped character. The four pins are shaped like checksums. And planning touches nothing."
say "fetch-toolchain: Lens TAME -- nothing is extracted until the bytes are the bytes we pinned, and the pin lives in this repository rather than beside the download."

let control = run ["sh" "tools/fixtures/fetch_toolchain_control.sh"]
assert control.ok else "fetch-toolchain: the verify control must complete"
say control.out
assert control.out contains "matching_accepted=yes" else "fetch-toolchain: bytes that match the pin must be accepted"
assert control.out contains "corrupted_accepted=no" else "fetch-toolchain: ONE flipped character must be refused -- this is the whole promise"
assert control.out contains "absent_accepted=no" else "fetch-toolchain: a file that is not there must never verify"
assert control.out contains "control_verdict=ok" else "fetch-toolchain: the control must agree with itself before it is believed"
say "refusal GREEN -- matching accepted, one flipped character refused, absent refused"

# The pins are shaped like checksums, and they live here rather than beside the download.
# Unanchored on purpose: the first pin shares its line with the opening of the shell variable and
# the last one carries the closing quote, so anchoring to line start and end silently counted two
# of four -- a check that passed by measuring less than it claimed.
let pins = run ["sh" "-c" "grep -cE '[a-z0-9_]+-(linux|macos)[[:space:]]+[0-9a-f]{64}[[:space:]]+[0-9]+' tools/fixtures/fetch_toolchain_scan.sh"]
assert pins.ok else "fetch-toolchain: the pin table must be readable"
assert (trim pins.out) == "4" else "fetch-toolchain: four platforms must each carry a sixty-four-character pin and a size -- a truncated pin is caught here rather than at a stranger's first download"
say "pins GREEN -- four platforms, each sixty-four hex characters, pinned in the repository"

let plan = run ["sh" "tools/fixtures/fetch_toolchain_scan.sh" "plan"]
assert plan.ok else "fetch-toolchain: planning must succeed on a supported platform"
assert plan.out contains "version=0.16.0" else "fetch-toolchain: the plan must name the pinned version"
assert plan.out contains "sha256=" else "fetch-toolchain: the plan must show the checksum it would hold the download to"
assert plan.out contains "verdict=ok" else "fetch-toolchain: the plan must balance"
say "plan GREEN -- names the release, the URL, and the checksum, and touches nothing"

say "GREEN: fetch-toolchain -- the refusal catches a single flipped character, four platforms are pinned in this repository, and planning changes nothing."
