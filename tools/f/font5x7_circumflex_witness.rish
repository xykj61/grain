# tools/f/font5x7_circumflex_witness.rish -- the open circumflex vowels corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/f/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, the Latin-1 acute/cedilla corpus (tools/f/font5x7_latin1_witness.rish), and the
# grave vowels (tools/f/font5x7_grave_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn circumflex vowels corpus: the five circumflex lowercase
# vowels a French or Portuguese name reaches for -- a circumflex, e circumflex, i circumflex, o circumflex, u
# circumflex -- at their real Unicode codepoints U+00E2, U+00EA, U+00EE, U+00F4, U+00FB, each a 5x7 coverage grid drawn
# in the open as ASCII line art in image/font5x7_circumflex.rye, built into a gfa1 atlas and proven on metal. A full
# round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all five letters look up present and
# carry the shared advance while an unaccented ASCII vowel misses; no two letters share coverage (each accented name is
# spelled with its own glyph); each letter reads within an honest legibility band; and the circumflex placement holds as
# the CENTERED, SYMMETRIC peak that completes the accent trio -- the apex on the center column of the top row (no ink in
# either half up there), one leg in each half of the row beneath, the two legs equal, where the acute leans right and
# the grave leans left. Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no
# key, no funds -- the marks a surface reads the day it prints a name that ASCII cannot spell, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_circumflex_witness.rish

say "font5x7-circumflex: Language EN -- Season G font content; the five circumflex lowercase vowels (a, e, i, o, u circumflex) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a civic surface prints when it spells a French or Portuguese keeper's own name."
say "font5x7-circumflex: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; the circumflex is the centered peak that completes the accent trio (acute right, grave left, circumflex nowhere), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-circumflex: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - circumflex_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_circumflex"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_circumflex.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-circumflex: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-circumflex: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-circumflex: ${out}"

assert selftest.out contains "GREEN image-font5x7-circumflex" else "font5x7-circumflex: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-circumflex: round-trip was not byte-identical"

assert selftest.out contains "every caret centered and symmetric" else "font5x7-circumflex: carets were not all centered and symmetric"

say "font5x7-circumflex: GREEN -- the open circumflex vowels corpus whole; five marks round-trip byte-identical, all present, distinct, and legible, every caret centered and symmetric as the mirror axis of the acute/grave pair; the font gains the circumflex vowels a civic surface needs to spell a name that ASCII cannot."
