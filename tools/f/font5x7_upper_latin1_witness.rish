# tools/f/font5x7_upper_latin1_witness.rish -- the rest of the uppercase Latin-1 accented corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/f/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, the accented LOWERCASE family (tools/f/font5x7_latin1_witness.rish and its
# grave/circumflex/german siblings), and the acute uppercase eight (tools/f/font5x7_upper_accented_witness.rish).
#
# The crux this witness proves closes the uppercase loop: the thirteen accented capitals that complete the Latin-1 set
# beside the acute eight -- A grave, A circumflex, A tilde, A diaeresis, E grave, E circumflex, I grave, I circumflex,
# O grave, O circumflex, O diaeresis, U grave, U circumflex -- at their real Unicode codepoints U+00C0, U+00C2, U+00C3,
# U+00C4, U+00C8, U+00CA, U+00CC, U+00CE, U+00D2, U+00D4, U+00D6, U+00D9, U+00DB, each a 5x7 coverage grid drawn in the
# open as ASCII line art in image/font5x7_upper_latin1.rye, built into a gfa1 atlas and proven on metal. A full
# round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all thirteen letters look up present and
# carry the shared advance while an unaccented ASCII capital misses and an acute capital (its sibling corpus) is never
# doubled here; no two letters share coverage; each letter reads within the same honest legibility band the acute eight
# proved, so the whole uppercase family reads as one weight; every letter carries its mark above the compressed body; and
# the five grave capitals each lean left -- top-row ink in the left half, none in the right, the honest signal that
# separates a grave capital from its acute twin. Compression is reported as a fact, never asserted -- the round-trip is
# the proof. No network, no key, no funds -- the capitals a surface reads the day it prints a full name that ASCII cannot spell.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_upper_latin1_witness.rish

say "font5x7-upper-latin1: Language EN -- Season G font content; the thirteen accented capitals that complete the uppercase Latin-1 set (A grave, A circumflex, A tilde, A diaeresis, E grave, E circumflex, I grave, I circumflex, O grave, O circumflex, O diaeresis, U grave, U circumflex) drawn in the open as ASCII line art, built into the gfa1 atlas, so every accented lowercase letter the tree draws now has its capital."
say "font5x7-upper-latin1: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-upper-latin1: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - upper_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_upper_latin1"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_upper_latin1.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-upper-latin1: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-upper-latin1: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-upper-latin1: ${out}"

assert selftest.out contains "GREEN image-font5x7-upper-latin1" else "font5x7-upper-latin1: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-upper-latin1: round-trip was not byte-identical"

say "font5x7-upper-latin1: GREEN -- the uppercase accented set whole; thirteen capitals round-trip byte-identical, all present, distinct, and legible, all marked above and the grave five leaning left; every accented lowercase letter the tree draws now has its capital, so a civic surface prints a full name in all-caps with its true marks."
