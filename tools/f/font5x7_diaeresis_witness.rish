# tools/f/font5x7_diaeresis_witness.rish -- the open diaeresis-accent vowels corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/f/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, and the four accent corpora already drawn -- the acute/cedilla corpus
# (tools/f/font5x7_latin1_witness.rish), the grave vowels (tools/f/font5x7_grave_witness.rish), the circumflex vowels
# (tools/f/font5x7_circumflex_witness.rish), and the tilde vowels (tools/f/font5x7_tilde_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn diaeresis-accent vowels corpus: the three diaeresis lowercase
# vowels the German umlaut set left undrawn -- e diaeresis, i diaeresis, y diaeresis -- at their real Unicode codepoints
# U+00EB, U+00EF, U+00FF, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_diaeresis.rye,
# built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint, advance, and coverage byte
# byte-for-byte; all three letters look up present and carry the shared advance while an unaccented ASCII vowel misses;
# the three carry distinct coverage; each reads within an honest legibility band; the diaeresis placement holds as the
# FIFTH lean beside acute/grave/circumflex/tilde -- every mark is two parted dots on one row (the top row carries exactly
# two inked cells, the center column between them blank, the second mark row blank), where an acute leans right, a grave
# left, a circumflex peaks over two rows, and a tilde waves over two rows; and the mark is proven byte-identical to the
# German umlaut's own top row, so the accent family stays one consistent hand. Compression is reported as a fact, never
# asserted -- the round-trip is the proof. No network, no key, no funds -- the marks a surface reads when it prints Noel,
# naive, or a French keeper's own name.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/f/font5x7_diaeresis_witness.rish

say "font5x7-diaeresis: Language EN -- Season G font content; the three diaeresis-accent lowercase vowels (e diaeresis, i diaeresis, y diaeresis) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a civic surface prints when it spells Noel, naive, or a French keeper's own name -- the letters the German umlaut set never reached."
say "font5x7-diaeresis: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; the diaeresis is the fifth lean, two parted dots on one row where acute/grave/circumflex/tilde each mark another way, the same mark the German umlaut drew, our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-diaeresis: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - diaeresis_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_diaeresis"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_diaeresis.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-diaeresis: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-diaeresis: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-diaeresis: ${out}"

assert selftest.out contains "GREEN image-font5x7-diaeresis" else "font5x7-diaeresis: selftest did not print the GREEN corpus line"

say "font5x7-diaeresis: GREEN -- the diaeresis vowels e/i/y stand drawn in the open, the fifth lean of the accent family, proven on metal."
