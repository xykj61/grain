# tools/buhr_realidream_view_derived_theme_stack_witness.rish — BUHR Journey 5, Rung 10.
#
# Two .brush accent layers compose both ends of the fused edge at once. Rung seven proved
# two .brush layers compose the Realidream surface (a mode ground under a read accent);
# rung nine made the derived node themeable on its own flow key, mirroring rung six's
# read origin. This rung joins the two accents: a read-source layer (read token only) and
# a flow-source layer (flow token only) compose through the WADE1 cascade
# (tokens.resolve_stack), each winning the one token it names, the base sheet's untouched
# tokens (the living-edge head, the ground, the edge rule) inheriting beneath both. So a
# person themes both fused-edge ends at once by stacking two small focused .brush files —
# a warm amber read origin over a deep honey derived node. Proven by reading back three
# sources at once (read from the read accent, flow from the flow accent, head from the
# base neither named) and on the canvas (162 read + 267 flow + inherited head pixels all
# land through rung eight's paint_flow); a style-less layer refuses LayerEmpty. No network.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/buhr_realidream_view_derived_theme_stack_witness.rish

say "buhr-j5r10: Language EN — two .brush accent layers compose both ends of the fused edge at once; read origin and derived node lit together."
say "buhr-j5r10: Lens TAME — proven on metal; three authors on one sheet, both accents win their own token, both reach the canvas beside the inherited head. No network read."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/realidream-view-derived-theme-stack"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/realidream_view_derived_theme_stack.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j5r10: realidream_view_derived_theme_stack build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j5r10: realidream_view_derived_theme_stack selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j5r10: selftest did not speak GREEN"
assert selftest.out contains "three authors, one surface" else "buhr-j5r10: the compose proof is missing"
assert selftest.out contains "read amber, flow honey" else "buhr-j5r10: the accents-win proof is missing"
assert selftest.out contains "both fused-edge ends lit" else "buhr-j5r10: the canvas proof is missing"
assert selftest.out contains "LayerEmpty" else "buhr-j5r10: the style-less refusal proof is missing"

# Rung 9 (derived node themeable) stays its own green binary — additive.
let rung9 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_realidream_view_derived_theme_witness.rish 2>&1"]
assert rung9.ok else "buhr-j5r10: the derived-node theme (J5r9) witness regressed"
assert rung9.out contains "GREEN: BUHR-J5r9" else "buhr-j5r10: rung nine lost its green"

# Rung 7 (two layers compose the read origin) stays green — the symmetric read-side compose.
let rung7 = run ["sh" "-c" "rishi/bin/rishi run tools/buhr_realidream_view_theme_stack_witness.rish 2>&1"]
assert rung7.ok else "buhr-j5r10: the read-origin compose (J5r7) witness regressed"
assert rung7.out contains "GREEN: BUHR-J5r7" else "buhr-j5r10: rung seven lost its green"

say "GREEN: BUHR-J5r10 — two .brush accent layers compose both ends of the fused edge at once; the read origin and the derived node lit together on one surface, each on its own key."
