# tools/mycelium_cord_batch_bron_witness.rish — the batched Cord travels as text (fact batching r2).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · fact batching · rung r2.
# r1 proved a batched history folds to the byte-identical supply as the same facts placed
# one-per-block. This rung lets a batched Dag cross to a stranger as readable bytes: it renders a
# committed BatchDag to a `format cord-batch-v1` record (per block a block line, then one fact line
# per batched fact, then the parent lines) and parses it back, rebuilding the Dag from the bytes.
#
# The crux this witness proves: the recovered batched Dag, re-admitted under r1's own add_batch,
# commits to the byte-identical order and folds the identical supply (700 over one star) — two nodes
# agree by exchanging batched blocks alone. Re-rendering the parsed record reproduces the exact bytes.
# Every signature rides and is re-verified: a tampered fact breaks its block signature at add_batch
# (BadSignature), so corruption can never cross as consensus. A wrong header, an unknown field, a fact
# before any block, and an empty batch each refuse. Demo keeper seeds only — no key, funds, network,
# or custody.
#
# Scope: active-designing/date/20260813/20260813-043303_mycelium-fact-batching-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_cord_batch_bron_witness.rish

say "mycelium-cord-batch-bron: Language EN — the batched Cord travels; the agreed order crosses to a stranger as bytes."
say "mycelium-cord-batch-bron: Style Radiant — a record replaces the gossip; the bytes are the network, cheaper by the batch."
say "mycelium-cord-batch-bron: Lens TAME — a bounded flat-Bron reader; every signature re-verified on rebuild; a bad record refuses whole; demo seeds only."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_batch_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_batch_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-batch-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-cord-batch-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-batch-bron: selftest did not speak GREEN"
assert selftest.out contains "the recovered Dag re-admitted under add_batch commits to the byte-identical order and folds supply 700 over one star" else "mycelium-cord-batch-bron: order-travels claim missing"
assert selftest.out contains "re-rendering the parsed record reproduces the exact bytes; a tampered fact refuses BadSignature on rebuild" else "mycelium-cord-batch-bron: fixed-point/tamper claim missing"
assert selftest.out contains "a wrong header, an unknown field, a fact before any block, and an empty batch each refuse" else "mycelium-cord-batch-bron: refusal claim missing"

# r1 (the batch folds identical to single-fact) stays a green binary at this door — accrete-never-break.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_batch.rye -femit-bin=mycelium/bin/cord_batch && mycelium/bin/cord_batch 2>&1"]
assert r1.ok else "mycelium-cord-batch-bron: fact-batching r1 is not GREEN"
assert r1.out contains "GREEN" else "mycelium-cord-batch-bron: fact-batching r1 did not speak its GREEN"

# The elder single-fact cord-bron this rung grows beside stays a green binary too.
let elder = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_bron.rye -femit-bin=mycelium/bin/cord_bron && mycelium/bin/cord_bron 2>&1"]
assert elder.ok else "mycelium-cord-batch-bron: the elder single-fact cord-bron is not GREEN"
assert elder.out contains "GREEN" else "mycelium-cord-batch-bron: the elder cord-bron did not speak its GREEN"

say "mycelium-cord-batch-bron: GREEN — a batched Dag renders to a format cord-batch-v1 record and returns byte-for-byte, the recovered Dag commits to the identical order and folds the identical supply, every bad record refuses whole, and r1 and the elder cord-bron both stand green at their doors."
