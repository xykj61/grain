# tools/mycelium_portage_true_witness.rish — a real portage record reads true, and is the receipt of a real
# crossing (r4, the arc closes).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · Portage · rung r4 — reads true.
# r1 proved value crosses two worlds and the pair conserves, r2 made the crossing atomic, r3 let it travel as
# text — all over worlds seated in code. r4 carries the reader onto a REAL on-disk `format portage-v1` record a
# keeper can open and read (tools/fixtures/portage_record.bron, produced reproducibly by
# mycelium/portage_fixture_gen.rye, @embedFile-bound through the mycelium/corpora/ symlink).
#
# Two crux checks: TWO TOOLS, ONE ANSWER — the app derives the crossing's value and digest INDEPENDENTLY of the
# record's own fields (the amount by accepting the crossing against both worlds' real ledgers, the digest from
# the crossing's content seeds) and reports the pair `<amount> <digest8>`, which equals an independent awk
# reading of the same bytes; and THE RECORD IS THE RECEIPT OF A REAL CROSSING — the app rebuilds World A and
# World B from the fixture's own seeds and `accept` ties the parsed record to both real ledgers (self-certifying
# digest, both heads, matching burn). Genuineness beyond that: the record is a fixed point and the fixture is
# reproducible; a tampered header refuses. Composes portage + portage_bron + portage_fixture_gen + cord +
# kumara public API only; demo seeds — no key, no funds, no network, no value crossed.
#
# Scope: active-designing/date/20260813/20260813-124159_mycelium-portage-cross-world-transfer-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_portage_true_witness.rish

say "mycelium-portage-true: Language EN — a crossing a keeper can open and read is a crossing the software cannot lie about: the reader's value and digest match an independent reading of the same real bytes, and the record is provably the receipt of a real crossing."
say "mycelium-portage-true: Style Radiant — r1 crossed two worlds, r2 made it atomic, r3 let it travel; r4 reads a real on-disk record true, closing the Portage agent-doable arc."
say "mycelium-portage-true: Lens TAME — the reading is cross-checked against an independent awk of the same bytes (two tools, one answer); the app rebuilds both real ledgers and accept ties the record to them; the fixture is reproducible and the record a fixed point; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/portage_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/portage_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-portage-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-portage-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-portage-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent derivation" else "mycelium-portage-true: read-true claim missing"
assert selftest.out contains "the receipt of a real crossing" else "mycelium-portage-true: real-crossing claim missing"
assert selftest.out contains "never a hand-mock" else "mycelium-portage-true: fixed-point claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-portage-true: tamper refusal missing"
assert selftest.out contains "The Portage agent-doable arc closes" else "mycelium-portage-true: arc-close claim missing"

# The crux — two tools, one answer. The app's measure pair must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-portage-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/portage_record_truth.awk tools/fixtures/portage_record.bron"]
assert awk.ok else "mycelium-portage-true: awk truth read failed"
assert awk.out contains "40 d2bafdd4" else "mycelium-portage-true: awk pair not 40 d2bafdd4"
assert app.out == awk.out else "mycelium-portage-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is genuinely reproducible — the generator re-emits byte-identical bytes, so the on-disk record is
# what the Portage renders, never a hand-mock. Emit to a scratch path and diff (never overwrite the committed
# fixture in a read-only witness).
let genbuild = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/portage_fixture_gen.rye -femit-bin=mycelium/bin/portage_fixture_gen"]
assert genbuild.ok else "mycelium-portage-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/portage_fixture_gen 2> /tmp/portage_record_regen.bron; diff tools/fixtures/portage_record.bron /tmp/portage_record_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-portage-true: the fixture generator did not reproduce the committed bytes"
assert regen.out contains "REPRODUCIBLE" else "mycelium-portage-true: the regenerated fixture drifted from the committed one"

# r3 stays its own GREEN binary — this rung reads the record r3 renders, never replaces it.
let r3 = run ["sh" "-c" "rishi/bin/rishi run tools/mycelium_portage_bron_witness.rish 2>&1"]
assert r3.ok else "mycelium-portage-true: rung three (travel) is not GREEN"
assert r3.out contains "mycelium-portage-bron: GREEN" else "mycelium-portage-true: rung three did not speak its GREEN"

say "mycelium-portage-true: GREEN — a real portage record reads true (app==awk, 40 d2bafdd4), the record the receipt of a real crossing whose heads accept both real ledgers, its record a fixed point, its fixture reproducible; the travel round stands at r4's door. The Portage agent-doable arc closes."
