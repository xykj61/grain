# tools/font5x7_arrow_witness.rish -- the open arrow corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - more content BEYOND printable ASCII for the open glyph atlas image/glyph.rye
# (gfa1), a sibling of the box-drawing witnesses (tools/font5x7_box_witness.rish the light single-line set,
# tools/font5x7_boxdouble_witness.rish the double-line set) and the five ASCII corpora.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn arrow corpus: the six basic directional arrows -- left,
# up, right, down, and the two axis double-heads (left-right, up-down) -- at their real Unicode codepoints
# U+2190..U+2195, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_arrow.rye (a shaft
# with a filled-triangle head for the cardinals, outward chevrons for the double-heads), built into a gfa1 atlas and
# proven on metal. These are exactly the marks a terminal surface (the Dexter/Scooter family) reaches for to mark a
# selection, scroll a list, or point at a field. A full round-trip recovers every codepoint, advance, and coverage
# byte byte-for-byte; all six arrows look up present and carry the shared advance while an ASCII letter misses; no
# two arrows share coverage (a real set points four ways); and each reads within an honest legibility band (a chevron
# double-head is nine cells, a filled cardinal twelve). Compression is reported as a fact, never asserted -- the
# round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it wants to point.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_arrow_witness.rish

say "font5x7-arrow: Language EN -- Season G font content beyond ASCII; the six basic directional arrows drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a terminal surface uses to point and scroll."
say "font5x7-arrow: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every arrow byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-arrow: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - arrow_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_arrow"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_arrow.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-arrow: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-arrow: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-arrow: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-arrow' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-arrow: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-arrow: round-trip was not byte-identical"

say "font5x7-arrow: GREEN -- the open arrow corpus whole; six arrows round-trip byte-identical, all present, distinct, and legible; the font family gains its directional marks."
