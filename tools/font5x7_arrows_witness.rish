# tools/font5x7_arrows_witness.rish -- the whole eight-direction arrow set, unified into one open font, proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1). This is the FIRST
# unifier on the symbol side of the family, the sibling to the two letter unifiers already landed
# (tools/font5x7_ascii_witness.rish gathered the ninety-five printable ASCII glyphs, tools/font5x7_latin1_block_witness.rish
# gathered the sixty-two Latin-1 letters). Neither holds a symbol; image/font5x7_arrows.rye gathers the first symbol family
# whole -- the six basic arrows (image/font5x7_arrow.rye, U+2190..U+2195) and the four diagonals (image/font5x7_arrowdiag.rye,
# U+2196..U+2199) into ONE gfa1 atlas, the whole eight-direction arrow set in a single lookup.
#
# The crux this witness proves, beyond the round-trip and the ascending-and-unique disjointness the letter unifiers prove,
# is CONTIGUOUS BLOCK COMPLETENESS -- stronger than the Latin-1 unifier's, whose block carried two math-sign holes. The
# arrow span has NO holes: the selftest walks the whole ten-codepoint span U+2190..U+2199 and proves a hit at every step,
# the run unbroken. The merged count equals the sum of the two corpora (6 basic + 4 diagonal = 10), which with the
# strictly-ascending codepoints proves the corpora disjoint. Compression is reported as a fact, never asserted -- the
# round-trip is the proof. No network, no key, no funds -- the whole arrow set a surface reads the day it points in any of
# the eight directions on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_arrows_witness.rish

say "font5x7-arrows: Language EN -- Season G font content; the whole eight-direction arrow set (ten arrows, every codepoint U+2190..U+2199) gathered from two proven leaf corpora into one gfa1 atlas -- the whole arrow block in a single lookup, the first symbol-side unifier beside the ASCII and Latin-1 letter fonts."
say "font5x7-arrows: Style Radiant -- the two corpora each already prove their own drawings on metal; this font merges their green atlases and proves the whole is contiguously complete, ascending, and disjoint, so decode(encode(atlas)) recovers every arrow byte for byte; our own hand end to end, permissively ours, no external font to license and no web-search gate."
say "font5x7-arrows: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - block_count - the atlas ceilings it rests on); the unifying count is the sum of the two corpora's own count constants and equals the arrow span; each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_arrows"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_arrows.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-arrows: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-arrows: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-arrows: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-arrows' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-arrows: selftest did not print the GREEN corpus line"
