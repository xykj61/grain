# caravan_entrust_witness.rish -- Caravan entrust witness.
#
# `taper.rye` let a dependent give back an arc it had finished with, so the door
# widened the moment the work narrowed. It named the mirror question plainly
# and left it standing.
#
#   A LINE MAY ALSO GROW, AND GROWING IS THE HARDER HALF.
#
# A shrink is safe by construction -- the door already weighed the wider
# line when it admitted every sibling standing beside it, so narrowing can
# only free room. A widening is the opposite: it reaches for arcs the door
# never weighed, beside siblings admitted against the narrower line. So a
# widening must look in two places a shrink never had to.
#
# WHAT THIS RUNG PROVES, AND WHAT IT COSTS, MEASURED:
#
#   * THE SHAPE STAYS ONE NUMBER. A phase carries a RESERVE beside the line
#     it hands its dependent at spawn -- arcs the supervisor may entrust later,
#     written in the same grammar. The dependent is spawned holding both, the
#     run remembers only the handed line, and an entrustment is the count of
#     leading reserve arcs handed over. A line of three read as four the
#     moment one reserve arc was entrusted, arcs and letters together.
#   * THE WIN IS A DIFFERENT ONE THAN THE SHRINK BOUGHT. A taper bought
#     room -- more dependents at once. An entrustment buys the opposite
#     economy: work arriving for a domain already standing is carried by the
#     dependent already there, so the same arcs are read by FEWER DEPENDENTS.
#   * THE NOTIFICATION RUNS THE OTHER WAY. In `taper.rye` the dependent
#     published and the supervisor acknowledged; here the supervisor
#     publishes and the dependent answers. Both sides stay bounded, so neither a
#     dependent waiting for work nor a run waiting for an answer waits forever.
#   * FIVE REFUSALS THIS RUNG EARNS, TWO MORE THAN THE SHRINK.
#     `EntrustReversed` is the direction: a line only ever grows here, so an
#     entrustment lower than the run remembers claims work back.
#     `EntrustExhausted` is the supply: a reserve gives only what it holds,
#     and a widened line names no more arcs than one item may ever name.
#     `EntrustUngranted` is the reach a shrink never had to check -- a
#     narrowed line was inside the document by construction, being a suffix
#     of a line already granted, while a widened line reaches and must be
#     weighed against what the document actually grants that domain.
#     `EntrustContended` is the room: a widening is refused wherever it
#     would contend with a line another running dependent holds, since the door
#     that admitted those siblings never weighed this reach.
#     `EntrustUnheard` is the answer: a handback was a fact the run took in,
#     while an entrustment is an act the dependent must confirm.
#   * THE DOOR ITSELF NEEDS NOTHING NEW. `unhand.admissible_held` weighs a
#     newcomer against the lines a run remembers; this rung changes only
#     what those lines say -- the same finding `taper.rye` made about a line
#     that shrinks, read from the other side.
#   * A RUN THAT ENTRUSTS NOTHING READS AS THE RUNG BELOW, all 9 pairs --
#     this arc's standing generalization test.
#   * THE ROOM MEASURED ON METAL: one plan of 4 phases run twice. 4 dependents
#     with a dependent of its own for every phase against 3 with work handed to
#     the dependent already standing, 1 coming home either way, 1 phase carried
#     without a dependent of its own.
#
# THE LIMIT IS NAMED: a dependent is spawned holding its reserve capabilities,
# so this rung's isolation claim is about the WORK a dependent is permitted to
# do rather than about the reach it physically holds. A real microkernel
# hands a capability into a running dependent's cspace; a process boundary
# handed its capability words at spawn cannot. Carrying a capability over a
# channel into a dependent already running belongs to the vision room until a
# witness binds it.
#
# All six RED paths were proven on metal before this witness claimed GREEN.
# Drop the direction refusal and a line takes work back from a dependent already
# carrying it. Drop the length half of the supply guard and the depth half
# still refuses; drop both and the walk panics at `reached unreachable` on
# the invariant that exactly the entrusted prefix was taken on. Drop the
# reach refusal and a line reaching for a write the document never granted
# reads as within. Drop the room refusal and a widening reaches a region a
# sibling was already reading. Never entrust at all and the run reports that
# a standing dependent with a reserve was entrusted nothing. Entrust and never
# wait for an answer, and the run refuses the whole record with
# `EntrustUnheard` rather than believing work done that was never read.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_entrust_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/entrust"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/entrust.rye -femit-bin=${bin}"]

assert build.ok else "caravan entrust build failed"

# The board declaration the rungs below opened, unchanged: a region one
# client writes and its siblings read, with no channel joining any of them.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero, every bell
# starts silent, and every entrustment note starts with nothing handed over.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.entrusts"]
assert clean.ok else "the region stores, doorbells, and notes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan entrust selftest exited non-zero"
assert test.out contains "GREEN" else "caravan entrust selftest not GREEN"
assert test.out contains "a line may also grow, and the work arrives without a second dependent" else "the entrust finding did not close"

# The line and its four standing refusals, read straight, before any dependent
# runs. The fifth, `EntrustUnheard`, belongs to the run rather than the fold.
assert test.out contains "a line may grow, and the arc taken on carries work no second dependent had to" else "the growing line was not weighed at the door"
assert test.out contains "four refusals stand by name: reversed, exhausted, ungranted, contended" else "the four standing refusals did not stand"
assert test.out contains "the room this rung reads: more work handed to the dependent already standing" else "the entrusting room was not named"

# The generalization test: a run that entrusts nothing reads as the rung below.
assert test.out contains "a run that entrusts nothing reads as the line handed, all 9 pairs" else "an empty reserve did not read as the line handed"

# The entrust lap: one plan run twice, once with a dependent of its own for
# every phase and once with work handed to the dependent already standing.
assert test.out contains "phases: 4 by a dependent of its own, 4 by the dependent already standing" else "the two rooms ran different records"
assert test.out contains "dependents: 4 by a dependent of its own, 3 by the dependent already standing" else "the entrusting room spared no dependent"
assert test.out contains "carried home as handed: 1 by a dependent of its own, 1 by the dependent already standing" else "a dependent did not come home as it was handed"
assert test.out contains "work entrusted: 0 by a dependent of its own, 1 by the dependent already standing" else "the run did not entrust what it reported"
assert test.out contains "phases carried without a dependent of their own: 1 against 0" else "no phase was carried by a dependent already standing"
assert test.out contains "breaks a named turn: 0 by a dependent of its own, 0 by the dependent already standing" else "the entrusting room broke an order its author named"

# The dependent says what it read of its own and what it took on, so the
# entrustment is visible in the dependent's own words rather than only the run's.
assert test.out contains "read 3 arcs of its own and 1 entrusted" else "no dependent reported taking work on"

say "GREEN: Caravan entrust witness passed."
