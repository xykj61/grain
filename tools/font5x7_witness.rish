# tools/font5x7_witness.rish -- the first permissive font corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - the first real content for the open glyph atlas image/glyph.rye (gfa1).
# Design read: active-designing/20260816-230846_season-g-font5x7-corpus-crux.md
#
# The crux this witness proves is a REAL, OPEN, hand-drawn font corpus: the ten digits '0'-'9', each a 5x7
# coverage grid drawn in the open as ASCII line art in image/font5x7.rye, built into a gfa1 atlas and proven on
# metal. A full round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all ten numerals
# look up present and carry the shared advance while a non-digit misses; no two digits share coverage (a real
# font's glyphs differ); and each digit reads within an honest legibility band (neither blank nor solid).
# Compression is reported as a fact, never asserted -- real numerals are busy, and the round-trip is the proof.
# No network, no key, no funds -- the numeral corpus Dexter, Scooter, Skate, and Brushstroke read the day a
# surface wants a number, standing on our own open font no one had to ask permission to read.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_witness.rish

say "font5x7: Language EN -- Season G's font content rung; the ten digits drawn in the open as ASCII line art, built into the gfa1 atlas, verified bytes that decode within named bounds rather than painting garbage."
say "font5x7: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every numeral byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - digit_count - the atlas ceilings it rests on); each function states its invariants positively; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7.rye -femit-bin=${bin}"]
assert build.ok else "font5x7: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7: ${out}"

let green = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'GREEN image-font5x7' && echo yes"]
assert (trim green.out) == "yes" else "font5x7: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7: round-trip was not byte-identical"

say "font5x7: GREEN -- the first open font corpus whole; ten numerals round-trip byte-identical, all present, distinct, and legible."
