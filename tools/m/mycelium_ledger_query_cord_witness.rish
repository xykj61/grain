# tools/m/mycelium_ledger_query_cord_witness.rish — the Ledger Voice (r2): the voice reads the living Cord.
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the reading half, rung 2. Rung 1 read a hand-seeded
# fold.Log; a consensus ledger's whole point is that the order is agreed, not authored. This rung makes
# the voice's corpus a committed cord.Dag — the blocks ordered by the Cord's own deterministic commit,
# gathered into a fold.Log in committed order (cord.committed_log), read by rung one's unchanged
# answer_over — so the supply the voice reports (700 over one star, four facts) is exactly the supply
# consensus agreed.
#
# The crux: two different arrival permutations of the same blocks commit to one identical order and fold
# to one identical supply, so the voice reads the same 'supply=700 stars=1' either way. Arrival order is a
# network accident; the committed order is the agreement, and the voice reads only the agreement. An
# unknown op still refuses (no fake answer). Demo keeper seeds only — no key, no funds, no network, no
# custody: a node reads its own committed fold.
#
# Additive: composes ledger_query (r1), cord, and fold public API only; both rung one and the Cord stay
# their own GREEN binaries under this one.
#
# Scope: active-designing/date/20260813/20260813-053843_mycelium-ledger-voice-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_ledger_query_cord_witness.rish

say "mycelium-ledger-query-cord: Language EN — the Ledger Voice reads a committed Cord, not a hand-seeded log."
say "mycelium-ledger-query-cord: Style Radiant — the supply is the one consensus agreed; arrival order is the accident, the committed order the truth."
say "mycelium-ledger-query-cord: Lens TAME — two arrival orders fold to one supply; the voice reads only the agreement; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/ledger-query-cord"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/ledger_query_cord.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-ledger-query-cord: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-ledger-query-cord: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-ledger-query-cord: selftest did not speak GREEN"
assert selftest.out contains "supply read the committed Cord — text '700' eos" else "mycelium-ledger-query-cord: supply-over-Cord reading missing"
assert selftest.out contains "facts=4, vega held" else "mycelium-ledger-query-cord: facts/star reading missing"
assert selftest.out contains "summary read the committed Cord — text 'supply=700 stars=1'" else "mycelium-ledger-query-cord: summary reading missing"
assert selftest.out contains "two arrival orders, one agreement — the voice reads 'supply=700 stars=1' either way" else "mycelium-ledger-query-cord: arrival-order-independence (the crux) missing"
assert selftest.out contains "unknown op refused over the committed Cord (no fake answer)" else "mycelium-ledger-query-cord: no-fake-answer refusal missing"

# Rung one and the Cord both stay their own green binaries — the voice this rung feeds is r1's unchanged
# answer_over, and the order it reads is the Cord's own commit, each proven separately.
let r1 = run ["sh" "-c" "rishi/bin/rishi run tools/m/mycelium_ledger_query_witness.rish 2>&1"]
assert r1.ok else "mycelium-ledger-query-cord: rung one (the lawful-fold voice) is not GREEN"
assert r1.out contains "mycelium-ledger-query: GREEN" else "mycelium-ledger-query-cord: rung one did not speak its GREEN"

let cord = run ["sh" "-c" "rishi/bin/rishi run tools/m/mycelium_cord_witness.rish 2>&1"]
assert cord.ok else "mycelium-ledger-query-cord: the Cord is not GREEN"
assert cord.out contains "GREEN" else "mycelium-ledger-query-cord: the Cord did not speak GREEN"

say "mycelium-ledger-query-cord: GREEN — the Ledger Voice reads the committed Cord; two arrival orders fold to one supply (700, one star, four facts), so the voice reports the agreement and never the accident. The intelligence reads the living consensus."
