# tools/m/mantra_gen_floor_a1_gate_witness.rish — Ashvini a1: Mantra's deciding face (e214).
#
#   rishi/bin/rishi run tools/m/mantra_gen_floor_a1_gate_witness.rish

say "a1-mantra: Language EN — the gen floor of one, decided in Glow (STOA331)."
say "a1-mantra: Lens TAME — both sides; the four family walls stand together."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-mantra-gen-floor-u32.glow"

let alive = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "1"]
assert alive.ok else "a1-mantra: alive side failed"
assert alive.out contains "EXIT:0" else "a1-mantra: alive did not exit 0"
assert alive.out contains "1" else "a1-mantra: alive did not speak 1"

let reserved = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "0"]
assert reserved.ok else "a1-mantra: reserved side failed"
assert reserved.out contains "EXIT:0" else "a1-mantra: reserved did not exit 0"
assert reserved.out contains "0" else "a1-mantra: reserved did not speak 0"

let elder = run ["sh" "-c" "grep -q 'gen >= 1' mantra/src/weave.rye"]
assert elder.ok else "a1-mantra: the invariant left weave.rye"

let walls = run ["sh" "-c" "test -f src/lib/gate-tally-garden-bound-u32.glow -a -f src/lib/gate-caravan-dependents-bound-u32.glow -a -f src/lib/gate-aurora-wire-bound-u32.glow"]
assert walls.ok else "a1-mantra: a family wall is missing"

say "GREEN: a1 mantra gen floor — decides on both sides; four families now speak."
