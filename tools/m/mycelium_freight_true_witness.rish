# tools/m/mycelium_freight_true_witness.rish — a real freight manifest reads true, and is the freight of a real
# ledger (r4, the arc closes).
#
# Season D (Kresfa & Mycelium) · Puddle fleet orchestration × Mycelium consensus · rung r4 — reads true.
# r1 proved a moved world reads the byte-identical position on its new berth, r2 conserved the whole fleet's
# state, r3 let a world's freight travel as text — all over ledgers seated in code. r4 carries the reader onto
# a REAL on-disk `format freight-v1` record a keeper can open and read (tools/fixtures/freight_manifest.bron,
# produced reproducibly by mycelium/freight_fixture_gen.rye, @embedFile-bound through the mycelium/corpora/
# symlink).
#
# Two crux checks: TWO TOOLS, ONE ANSWER — the app's position triple (balance · reserved · received) equals an
# independent awk reading of the same bytes; and THE RECORD IS THE FREIGHT OF A REAL LEDGER — the app rebuilds
# the world's ledger from the fixture's own seeds and confirms the parsed position and head match, the head
# accepting the real blocks through receive. Genuineness beyond that: the record is a fixed point and the
# fixture is reproducible; a tampered header refuses. Composes freight + freight_bron + freight_fixture_gen +
# cord + kumara public API only; demo seeds — no key, no funds, no network, no world moved.
#
# Scope: active-designing/date/20260813/20260813-121424_puddle-freight-world-state-migration-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_freight_true_witness.rish

say "mycelium-freight-true: Language EN — a position a keeper can open and read is a position the software cannot lie about: the reader's balance, reserved, and received match an independent reading of the same real bytes, and the record is provably the freight of a real ledger."
say "mycelium-freight-true: Style Radiant — r1 read the moved world, r2 conserved the fleet, r3 let the freight travel; r4 reads a real on-disk record true, closing the Freight agent-doable arc."
say "mycelium-freight-true: Lens TAME — the reading is cross-checked against an independent awk of the same bytes (two tools, one answer); the app rebuilds the real ledger and the head accepts the real blocks; the fixture is reproducible and the record a fixed point; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/freight_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/freight_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-freight-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-freight-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-freight-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent count of the same bytes" else "mycelium-freight-true: read-true claim missing"
assert selftest.out contains "the freight of a real ledger" else "mycelium-freight-true: real-ledger claim missing"
assert selftest.out contains "never a hand-mock" else "mycelium-freight-true: fixed-point claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-freight-true: tamper refusal missing"
assert selftest.out contains "The Freight agent-doable arc closes" else "mycelium-freight-true: arc-close claim missing"

# The crux — two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-freight-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/freight_manifest_truth.awk tools/fixtures/freight_manifest.bron"]
assert awk.ok else "mycelium-freight-true: awk truth read failed"
assert awk.out contains "60 40 100" else "mycelium-freight-true: awk triple not 60 40 100"
assert app.out == awk.out else "mycelium-freight-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is genuinely reproducible — the generator re-emits byte-identical bytes, so the on-disk record
# is what the Freight renders, never a hand-mock. Emit to a scratch path and diff (never overwrite the
# committed fixture in a read-only witness).
let genbuild = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/freight_fixture_gen.rye -femit-bin=mycelium/bin/freight_fixture_gen"]
assert genbuild.ok else "mycelium-freight-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/freight_fixture_gen 2> /tmp/freight_manifest_regen.bron; diff tools/fixtures/freight_manifest.bron /tmp/freight_manifest_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-freight-true: the fixture generator did not reproduce the committed bytes"
assert regen.out contains "REPRODUCIBLE" else "mycelium-freight-true: the regenerated fixture drifted from the committed one"

# r3 stays its own GREEN binary — this rung reads the record r3 renders, never replaces it.
let r3 = run ["sh" "-c" "rishi/bin/rishi run tools/m/mycelium_freight_bron_witness.rish 2>&1"]
assert r3.ok else "mycelium-freight-true: rung three (travel) is not GREEN"
assert r3.out contains "mycelium-freight-bron: GREEN" else "mycelium-freight-true: rung three did not speak its GREEN"

say "mycelium-freight-true: GREEN — a real freight manifest reads true (app==awk, 60 40 100), the record the freight of a real ledger whose head accepts the real blocks, its record a fixed point, its fixture reproducible; the travel round stands at r4's door. The Freight agent-doable arc closes."
