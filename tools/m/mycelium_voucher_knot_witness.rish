# tools/m/mycelium_voucher_knot_witness.rish -- a voucher's position survives a checkpoint (r3).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - the Voucher - rung r3 -- across a Knot.
# r1 made a node's signed attestation bind an account's position to a named order-head, checkable against
# the ledger it vouches; r2 let the proof travel as bytes. Yet a ledger a family runs for years does not
# carry its whole past unbroken: the Knot ties off a committed prefix into a sealed supply so a bounded Dag
# runs forever, and the Lapse continues its deadline clock across that seal by carrying the epoch base. This
# rung reads a voucher over a ledger resolved across an epoch cut.
#
# The crux this witness proves is A VOUCHER'S POSITION SURVIVES A CHECKPOINT: a node vouches Alice's position
# against the whole Cord, and a counterparty who has already checkpointed -- sealed the prefix into a Knot,
# discarded the base blocks, continued only the live suffix -- reads the identical vouched position (balance,
# reserved, received) from that Knot-continued ledger. A pledge opened before the cut lapses in the suffix,
# and the voucher reads true on both paths; a far-deadline pledge honors in the suffix and RECEIVED
# accumulates across the base, not restarts at it, so Bob's whole 100 inflow is vouched true to the pruned
# history. The honest seam this surfaces is that the ORDER-HEAD is the whole-history fingerprint -- base
# included, distinct from the prefix-only head -- so a party that pruned the base checks the position, not the
# head. A flipped position and a wrong signer each fail the offline verify and match no checkpoint; a corrupt
# Knot refuses whole, so no position is ever read from a tampered checkpoint. Composes voucher + statement +
# lapse_knot + lapse + cord + fold public API only; demo keeper seeds -- no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-095216_mycelium-voucher-attested-statement-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_voucher_knot_witness.rish

say "mycelium-voucher-knot: Language EN — a holder's proof of standing stays true after a checkpoint, read true by a counterparty who pruned the base and kept only the sealed Knot and its live suffix."
say "mycelium-voucher-knot: Style Radiant — the Knot prunes the past and the Lapse carries the clock across it; the Voucher's signed position reads the continuity they keep, and the order-head still binds the whole history base included."
say "mycelium-voucher-knot: Lens TAME — the reading composes voucher + statement + lapse_knot + lapse + cord + fold public API; a voucher signed against the whole Cord reads true to a Knot-continued ledger; received accumulates across the base; the whole-history order-head differs from the prefix; a broken proof and a corrupt checkpoint each refuse; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/voucher_knot"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/voucher_knot.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-voucher-knot: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-voucher-knot: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-voucher-knot: selftest did not speak GREEN"
assert selftest.out contains "reads true to a party who checkpointed the prefix" else "mycelium-voucher-knot: position-survives-cut claim missing"
assert selftest.out contains "received accumulates across the cut" else "mycelium-voucher-knot: received-accumulation claim missing"
assert selftest.out contains "the order-head is the whole-history fingerprint, base included" else "mycelium-voucher-knot: order-head base-inclusion claim missing"
assert selftest.out contains "no position is read from a tampered checkpoint" else "mycelium-voucher-knot: corrupt-refusal claim missing"
assert selftest.out contains "a voucher's vouched position survives a checkpoint" else "mycelium-voucher-knot: GREEN summary missing"

# The Voucher r1 whose attestation this rung reads across a cut, and the Lapse-Knot whose checkpoint it
# continues, both stand at the door -- their own selftests prove the machinery the reading rests on.
let voucher = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/voucher.rye -femit-bin=mycelium/bin/voucher && mycelium/bin/voucher 2>&1"]
assert voucher.ok else "mycelium-voucher-knot: the Voucher r1 this rung reads across a cut is not GREEN"
assert voucher.out contains "GREEN" else "mycelium-voucher-knot: the Voucher r1 did not speak its GREEN"

let lapse_knot = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/lapse_knot.rye -femit-bin=mycelium/bin/lapse_knot && mycelium/bin/lapse_knot 2>&1"]
assert lapse_knot.ok else "mycelium-voucher-knot: the Lapse-Knot whose checkpoint the Voucher continues is not GREEN"
assert lapse_knot.out contains "GREEN" else "mycelium-voucher-knot: the Lapse-Knot did not speak its GREEN"

say "mycelium-voucher-knot: GREEN — a voucher's vouched position survives a checkpoint: signed against the whole Cord, it reads true to a Knot-continued ledger (lapse and honor both, received accumulated across the epoch base), the order-head a whole-history fingerprint base included, a broken proof and a corrupt checkpoint refused; the Voucher and the Lapse-Knot stand at the door. The proof of position crosses the checkpoint whole."
