# tools/m/mycelium_constel_witness.rish — a named, reproducible dev-net constellation reaches quorum
# (r1, the Constel crux).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · Constel · rung r1.
# Every consensus witness before this conjured its nodes inline — seeded(0x11), seeded(0x22), anonymous
# keypairs made up for one proof and forgotten. No round gave the dev-net a NAME and a ROSTER: a stable,
# reproducible constellation of fake ships a keeper boots to run the whole stack as a network of named
# nodes. A CONSTEL is that named test constellation — the sovereign-lane echo of elder Urbit's fake-galaxy
# dev networks, run from inside the jailed pier under quarantined demo identities. A ship's identity is a
# PURE FUNCTION of its name (seed = SHA-256(name)), so the whole constellation — every key, the Muster it
# seats, the quorum it reaches — is determined by the list of names alone: boot it twice, read it the same.
#
# The crux this witness proves is REPRODUCIBLE, NAMED QUORUM — the named roster boots to byte-identical keys,
# seats as a Muster, and reaches quorum on the account's TRUE order-head, with the teeth that a stranger ship
# never counts (NotMember) and a quorum too thin for the Byzantine threshold is not believed (BelowQuorum).
# Ship names obey the always-on placeholder-ship-names rule (single tokens, no `~`, length != 3/6/12, never a
# valid @p). Composes kumara + cord + fold + voucher + chorus + muster public API only, editing none; demo
# ship and keeper seeds — no key, no funds, no network, no real value.
#
# Scope: active-designing/date/20260813/20260813-132009_mycelium-constel-named-dev-net-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_constel_witness.rish

say "mycelium-constel: Language EN — every consensus witness so far made up its nodes inline; a Constel gives the dev-net a name and a roster, each ship's identity a pure function of its name, so the whole constellation is the same every boot."
say "mycelium-constel: Style Radiant — name the ships and the constellation is reproducible: boot the same names twice and every key matches, seat them as a Muster, and the named quorum believes the account's true reading — an outsider's voice never passes for one of its own."
say "mycelium-constel: Lens TAME — the named-quorum law composes kumara + cord + fold + voucher + chorus + muster public API only, editing none; a ship's seed is SHA-256 of its name; every claim is a byte-comparison of a key or an integer comparison of a quorum count; the ship names can never parse as a live-network @p; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/constel"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/constel.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-constel: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-constel: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-constel: selftest did not speak GREEN"
assert selftest.out contains "boots reproducibly" else "mycelium-constel: the reproducibility claim missing"
assert selftest.out contains "byte-identical keys" else "mycelium-constel: the pure-function-of-names claim missing"
assert selftest.out contains "reaches quorum on the account's true order-head" else "mycelium-constel: the named-quorum crux claim missing"
assert selftest.out contains "NotMember" else "mycelium-constel: the stranger-ship refusal claim missing"
assert selftest.out contains "BelowQuorum" else "mycelium-constel: the thin-quorum refusal claim missing"

# The Chorus whose quorum a Constel gathers stands at the door — a constellation reaches agreement by the
# very distinct-voice attestation the Chorus proves.
let chorus = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/chorus.rye -femit-bin=mycelium/bin/chorus && mycelium/bin/chorus 2>&1"]
assert chorus.ok else "mycelium-constel: the Chorus quorum a Constel gathers is not GREEN"
assert chorus.out contains "GREEN" else "mycelium-constel: the Chorus did not speak its GREEN"

# The Muster whose roll a Constel seats stands too — a named constellation is believed only when its voices
# are all enrolled and their count meets the roll's Byzantine threshold.
let muster = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/muster.rye -femit-bin=mycelium/bin/muster && mycelium/bin/muster 2>&1"]
assert muster.ok else "mycelium-constel: the Muster roll a Constel seats is not GREEN"
assert muster.out contains "GREEN" else "mycelium-constel: the Muster did not speak its GREEN"

say "mycelium-constel: GREEN — a named dev-net constellation boots reproducibly (same names, byte-identical keys, distinct ships), seats as a Muster, and reaches quorum on the account's true order-head; a stranger ship refuses NotMember, a thin quorum refuses BelowQuorum; the Chorus and the Muster both stand at the door. The dev-net has a name and a roster."
