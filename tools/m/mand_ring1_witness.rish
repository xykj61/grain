# mand_ring1_witness.rish — Mand ring-1: grant and refuse at one seam.
#
# Seam: may this reader see this record, under this named authority,
# written to the audit log?
#
#   rishi/bin/rishi run tools/m/mand_ring1_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "mand/bin/mand_ring1_witness"

let build = run ["sh" "-c" "mkdir -p mand/bin && env RYE_ZIG=${zig} rye/bin/rye build mand/mand_ring1_witness.rye -femit-bin=${bin}"]
assert build.ok else "Mand ring-1 witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "Mand ring-1 witness exited non-zero"
assert selftest.out contains "GREEN" else "Mand ring-1 witness not GREEN"
assert selftest.out contains "granted path" else "Mand ring-1 missing grant welcome path"
assert selftest.out contains "refused path" else "Mand ring-1 missing refuse unwelcome path"
assert selftest.out contains "audit written" else "Mand ring-1 missing audit-on-grant claim"
assert selftest.out contains "audit unchanged" else "Mand ring-1 missing audit-stable-on-refuse claim"

say "GREEN: Mand ring-1 capability witness passed (grant + refuse)."
