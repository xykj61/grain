# markdown_structure_witness.rish -- blocking structural integrity for Radiant passes.
# Seated 20260725.114400 - Quin relay repair.
# Lesson 20260725.120701 -- every blocking witness earns a known-good PASS
# fixture beside its known-bad FAIL fixture; compare table COLUMN counts, not
# raw pipe counts; mask inline code and fenced blocks before splitting cells.
#
# Positive: context/fixtures/markdown_structure_valid_table.md must PASS.
# Negative: context/fixtures/markdown_structure_broken_table.md must FAIL.
#
#   MARKDOWN_STRUCTURE_FILES=$'path\npath' rishi/bin/rishi run tools/m/markdown_structure_witness.rish

say "markdown_structure: fixture PASS (valid four-column table)…"
let pass_files = "context/fixtures/markdown_structure_valid_table.md"
let pass = run ["sh" "-c" "MARKDOWN_STRUCTURE_FILES='context/fixtures/markdown_structure_valid_table.md' sh tools/fixtures/markdown_structure_scan.sh"]
say pass.out
assert pass.ok else "markdown_structure valid-table fixture RED — witness broken"

say "markdown_structure: fixture FAIL (broken table)…"
let fail = run ["sh" "-c" "MARKDOWN_STRUCTURE_FILES='context/fixtures/markdown_structure_broken_table.md' sh tools/fixtures/markdown_structure_scan.sh"]
assert fail.ok == false else "markdown_structure broken-table fixture passed — witness toothless"
assert fail.out contains "column mismatch" else "broken fixture must fail on column mismatch"

say "markdown_structure: tables · fences · links · headings…"
let scan = run ["rishi/bin/rishi" "run" "tools/fixtures/markdown_structure_scan.rish"]
say scan.out
assert scan.ok else "markdown_structure RED — STOP the wave"
say "GREEN: markdown_structure — fixtures · tables · fences · links · headings held."
