# tools/m/mantra_glow_tend_limb1_witness.rish -- Mantra M1 in src/shape/ (e203).
#
#   rishi/bin/rishi run tools/m/mantra_glow_tend_limb1_witness.rish

say "mantra-tend-1: Language EN — first Mantra Glow Tend limb (sur museum)."
say "mantra-tend-1: Style Radiant — Line field count; Rye still weaves."
say "mantra-tend-1: Lens TAME — Equinox e203 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/shape/shape-mantra-line-field-count.glow"

say "mantra-tend-1: placard..."
let placard = run ["sh" "-c" "head -n 7 src/shape/shape-mantra-line-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "mantra-tend-1: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "mantra-tend-1: placard missing six lines"

say "mantra-tend-1: example locks to three fields..."
let ex = run ["sh" "-c" "grep -q 'example    3' src/shape/shape-mantra-line-field-count.glow"]
assert ex.ok else "mantra-tend-1: example 3 missing"
let names = run ["sh" "-c" "grep -q 'text' src/shape/shape-mantra-line-field-count.glow && grep -q 'gen' src/shape/shape-mantra-line-field-count.glow && grep -q 'pos' src/shape/shape-mantra-line-field-count.glow"]
assert names.ok else "mantra-tend-1: placard must name text · gen · pos"
let elder = run ["sh" "-c" "grep -q 'mantra/src/weave.rye' src/shape/shape-mantra-line-field-count.glow"]
assert elder.ok else "mantra-tend-1: weave.rye citation missing"

# The claim is the placard's, so the number is read from the placard rather than spelled a
# second time here -- a guard that carries its own copy of the number can only ever agree with
# itself. Until 20260906 this leg was N `grep -Fq` calls for N field lines, which is presence
# rather than a count: a fourth field passed it, a reorder passed it, and it refused in the
# words "missing or reordered" (REDS %500). The reader is proven in a pen by
# tools/r/rye_struct_fields_witness.rish, two of whose phases run the elder predicate verbatim
# and watch it wave both breaks through.
say "mantra-tend-1: the placard's own number, read against Line in the rye..."
let declared = run ["sh" "-c" "grep -E '^::  example' src/shape/shape-mantra-line-field-count.glow | sed -E 's/^.*example[[:space:]]+//'"]
assert declared.ok else "mantra-tend-1: the placard's example line is unreadable"
let want_count = trim declared.out
let counted = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--count" "mantra/src/weave.rye" "Line"]
assert counted.ok else "mantra-tend-1: the field reader refused on Line -- ${counted.out}"
let got_count = trim counted.out
assert got_count == want_count else "mantra-tend-1: Line declares ${got_count} fields where the placard says ${want_count}"
let named = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--fields" "mantra/src/weave.rye" "Line"]
assert named.ok else "mantra-tend-1: the field reader refused on Line -- ${named.out}"
let got_fields = trim named.out
assert got_fields == "text gen pos" else "mantra-tend-1: Line fields missing or reordered in the rye -- ${got_fields}"

say "mantra-tend-1: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "mantra-tend-1: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "mantra-tend-1: shape did not exit 0"

say "mantra-tend-1: Aurora A3 and Tally T6 still present..."
let prior = run ["sh" "-c" "test -f src/shape/shape-aurora-living-stages.glow -a -f src/shape/shape-tally-stack-laws.glow"]
assert prior.ok else "mantra-tend-1: A3 or T6 missing"

say "GREEN: mantra Glow Tend limb 1 — Line three fields in src/shape/; Tend ladder kept."
