# tools/m/mantra_glow_tend_limb1_witness.rish — Mantra M1 in src/sur/ (e203).
#
#   rishi/bin/rishi run tools/m/mantra_glow_tend_limb1_witness.rish

say "mantra-tend-1: Language EN — first Mantra Glow Tend limb (sur museum)."
say "mantra-tend-1: Style Radiant — Line field count; Rye still weaves."
say "mantra-tend-1: Lens TAME — Equinox e203 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-mantra-line-field-count.glow"

say "mantra-tend-1: placard..."
let placard = run ["sh" "-c" "head -n 7 src/sur/shape-mantra-line-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "mantra-tend-1: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "mantra-tend-1: placard missing six lines"

say "mantra-tend-1: example locks to three fields..."
let ex = run ["sh" "-c" "grep -q 'example    3' src/sur/shape-mantra-line-field-count.glow"]
assert ex.ok else "mantra-tend-1: example 3 missing"
let names = run ["sh" "-c" "grep -q 'text' src/sur/shape-mantra-line-field-count.glow && grep -q 'gen' src/sur/shape-mantra-line-field-count.glow && grep -q 'pos' src/sur/shape-mantra-line-field-count.glow"]
assert names.ok else "mantra-tend-1: placard must name text · gen · pos"
let elder = run ["sh" "-c" "grep -q 'mantra/src/weave.rye' src/sur/shape-mantra-line-field-count.glow"]
assert elder.ok else "mantra-tend-1: weave.rye citation missing"

say "mantra-tend-1: rye still seats Line with three fields..."
let rye = run ["sh" "-c" "grep -q 'pub const Line = struct' mantra/src/weave.rye && grep -Fq 'text: []const u8,' mantra/src/weave.rye && grep -Fq 'gen: u32,' mantra/src/weave.rye && grep -Fq 'pos: u32,' mantra/src/weave.rye"]
assert rye.ok else "mantra-tend-1: Line fields missing or reordered in weave.rye"

say "mantra-tend-1: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "mantra-tend-1: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "mantra-tend-1: shape did not exit 0"

say "mantra-tend-1: Aurora A3 and Tally T6 still present..."
let prior = run ["sh" "-c" "test -f src/sur/shape-aurora-living-stages.glow -a -f src/sur/shape-tally-stack-laws.glow"]
assert prior.ok else "mantra-tend-1: A3 or T6 missing"

say "GREEN: mantra Glow Tend limb 1 — Line three fields in src/sur/; Tend ladder kept."
