# mand_ring2_witness.rish — Mand ring-2: retention eligibility (decide, never erase).
#
#   rishi/bin/rishi run tools/m/mand_ring2_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "mand/bin/mand_ring2_witness"

let build = run ["sh" "-c" "mkdir -p mand/bin && env RYE_ZIG=${zig} rye/bin/rye build mand/mand_ring2_witness.rye -femit-bin=${bin}"]
assert build.ok else "Mand ring-2 witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "Mand ring-2 witness exited non-zero"
assert selftest.out contains "GREEN" else "Mand ring-2 witness not GREEN"
assert selftest.out contains "KEEP" else "Mand ring-2 missing KEEP claim"
assert selftest.out contains "ELIGIBLE" else "Mand ring-2 missing ELIGIBLE claim"
assert selftest.out contains "HELD" else "Mand ring-2 missing HELD claim"
assert selftest.out contains "exactly one audit line" else "Mand ring-2 missing one-audit claim"
assert selftest.out contains "MissingSchedule" else "Mand ring-2 missing MissingSchedule refuse"
assert selftest.out contains "MalformedSchedule" else "Mand ring-2 missing MalformedSchedule refuse"

say "GREEN: Mand ring-2 retention witness passed."
