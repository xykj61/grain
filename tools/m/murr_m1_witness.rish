# murr_m1_witness.rish -- MUR M1 one issuer, one holder witness (was MALA).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/murr_m1_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/murr"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/murr.rye -femit-bin=${bin}"]

assert build.ok else "MUR M1 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "MUR M1 selftest exited non-zero"
assert selftest.out contains "GREEN" else "MUR M1 selftest not GREEN"
assert selftest.out contains "forged mint signature refused" else "MUR M1 missing forged-sig unwelcome"
assert selftest.out contains "non-issuer mint refused" else "MUR M1 missing non-issuer unwelcome"
assert selftest.out contains "send exceeding balance refused" else "MUR M1 missing overspend unwelcome"
assert selftest.out contains "tampered log refused" else "MUR M1 missing tamper unwelcome"

say "GREEN: MUR M1 one-issuer one-holder witness passed."
