# tools/m/mycelium_choir.rish -- the Mycelium family's witnesses, sung as one roster row.
#
#   rishi/bin/rishi run tools/m/mycelium_choir.rish
#
# Eighty-one witnesses cover Mycelium, the tree's own `.myc` notation, and sixty-nine of them were
# reached by NO pass. `witness_reach_scan.sh` counted each of those `unheard`, the shape the row at
# `20260908.183635` books: a guard's reach is the roster rather than its own
# quality. Eighty-one roster rows would be one rule written eighty-one times.
#
# The discovery, the bound and the refusals live in `tools/fixtures/w/witness_family_scan.sh`. This
# is its THIRD caller and it cost a file of comments and one roster row, which is the whole return on
# generalizing the second one rather than copying the first.

# reach-list: sh tools/fixtures/w/witness_family_scan.sh --dir tools/m --prefix mycelium --list

say "mycelium-choir: Style Gauge, Meter -- the family is discovered, bounded, and sung."
say "mycelium-choir: Lens TAME -- a corpus of zero is a red rather than a reading."

say "mycelium-choir: the control -- eleven behaviors, every refusal planted and then lifted..."
let ctl = run ["sh" "tools/fixtures/w/witness_family_control.sh"]
assert ctl.ok else "mycelium-choir: the family control refused -- read its own pass/fail lines"
assert ctl.out contains "fail=0" else "mycelium-choir: a planted refusal behaved differently than stated"

let scan = run ["sh" "tools/fixtures/w/witness_family_scan.sh" "--dir" "tools/m" "--prefix" "mycelium"]
say scan.out
assert scan.ok else "mycelium-choir: the family refused -- read its own verdict line above"

# invariant: the family answered ok, which the scan prints only after every member has run.
assert scan.out contains "verdict=ok" else "mycelium-choir: the Mycelium family did not answer ok"

# invariant: members were found at all; an empty corpus reporting success is the one failure this
# choir exists to prevent, and the scan exits non-zero on it rather than printing ok.
assert (scan.out contains "members=0") == false else "mycelium-choir: a corpus of zero is a red, never a reading"

# invariant: every discovered member passed; one red fails the choir and names its path.
assert scan.out contains "reds=0" else "mycelium-choir: a Mycelium witness answered RED -- its path is printed above"

say "GREEN: mycelium-choir -- every Mycelium witness discovered, bounded, and sung under one row."
