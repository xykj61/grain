# tools/m/mycelium_tenure_witness.rish -- the Tenure: a contested name decided by the agreed order (r1).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - rung r1 -- the contested-name crux.
# The Cord derives one total order from a mesh of Kumara-signed blocks regardless of arrival; the Ledger
# Voice reads a lawful fold. Neither asked the question a namespace exists to answer: when two honest
# keepers reach for the same name at once, who holds it? The Tenure reads the Cord's agreed order as the
# namespace's verdict -- the first reservation of a name in that order holds it, every later one loses,
# and the same keeper wins on every honest node.
#
# The crux this witness proves: two distinct keepers reserve "bandun" at one round; the agreed order grants
# it to exactly one, the SAME one across three arrival permutations (deterministic verdict); the loser is a
# lawful no-op (the uncontested "vega" still holds, the supply still folds, the loss recorded) -- never a
# poison; and genuine corruption (a block carrying a broken-signature fact, and a free-name overdraw) each
# refuses the WHOLE resolution. Composes cord.rye + fold.rye public API only, editing no elder. Demo keeper
# seeds only -- no real key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-060935_mycelium-tenure-contested-name-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_tenure_witness.rish

say "mycelium-tenure: Language EN — a contested name is held by whichever reservation the agreed order places first."
say "mycelium-tenure: Style Radiant — a supply forgives every order; a name forgives only one; the Cord has already woven the order, and the Tenure reads it plainly."
say "mycelium-tenure: Lens TAME — the verdict composes cord + fold public API; every buffer bounded; a lost race is a lawful no-op, corruption refuses whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/tenure"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/tenure.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-tenure: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-tenure: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-tenure: selftest did not speak GREEN"
assert selftest.out contains "the agreed order grants it to one" else "mycelium-tenure: verdict claim missing"
assert selftest.out contains "across three arrival orders" else "mycelium-tenure: arrival-order-independence claim missing"
assert selftest.out contains "the loser is a lawful no-op" else "mycelium-tenure: lawful-no-op claim missing"
assert selftest.out contains "refuse the whole resolution" else "mycelium-tenure: corruption-poisons claim missing"

# The Cord whose agreed order the Tenure reads, and the Mycelium fold whose per-fact law it applies, both
# stand at the door -- their own selftests prove the machinery the verdict rests on.
let cord = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord.rye -femit-bin=mycelium/bin/cord && mycelium/bin/cord 2>&1"]
assert cord.ok else "mycelium-tenure: the Cord the Tenure reads is not GREEN"
assert cord.out contains "GREEN" else "mycelium-tenure: the Cord did not speak its GREEN"

let fold = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/fold.rye -femit-bin=mycelium/bin/fold && mycelium/bin/fold 2>&1"]
assert fold.ok else "mycelium-tenure: the Mycelium fold the Tenure applies is not GREEN"
assert fold.out contains "GREEN" else "mycelium-tenure: the Mycelium fold did not speak its GREEN"

say "mycelium-tenure: GREEN — two keepers reach for one name, the agreed order grants it to one, the same one every arrival; the loser loses nothing but the name, corruption refuses whole; the Cord and the fold stand at the door."
