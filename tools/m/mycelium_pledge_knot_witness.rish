# tools/m/mycelium_pledge_knot_witness.rish — the two-phase verdict reads across a Knot (r3).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the two-phase transfer · rung r3.
# r1 resolved a whole Cord Dag into a two-phase Ledger; r2 let the verdict travel. A ledger a family runs for
# years does not carry its whole past unbroken, so r3 makes the Pledge's corpus a KNOT plus its live suffix
# (mirroring purse_knot, carried from a single balance to balance + reserved and open pledges). A `PledgeKnot`
# pairs the integrity-sealed global supply (`cord_knot.seal_dag`, whose `issued` equals the prefix's
# `total_issued` — both count only genesis credits) with the prefix's accounts and OPEN pledges the FoldState
# omits; `continue_pledge` verifies the Knot, seeds a Ledger with the prefix map, and walks the live suffix
# through the shared `pledge.fold_pledge` step.
#
# The crux is what two-phase transfer exists FOR: a pledge and its resolution can stand far apart in time, even
# across a pruning checkpoint. Alice PLEDGES 100 to Bob inside the SEALED prefix (coins reserved, not moved),
# then POSTS it in the live suffix — a promise made before the cut, kept after it, the reserved hundred reaching
# Bob; a VOID in the suffix would instead return it to Alice. `pledges_match` proves the full Cord and the
# Knot-continued verdict never drift (pledges · settlements · balances · reserves). Conservation of balance +
# reserved holds past the cut. A corrupt Knot refuses `KnotCorrupt` before a fact is folded, a tampered suffix
# fact `IdentityRefused`, a resolution of a pledge the checkpoint never opened `UnknownPledge`. A pledge stays
# ONE kind_tax fact in the sealed prefix so fold's global taxed never double-counts a reserve-and-resolve pair.
# Composes pledge + cord_knot + cord + fold public API only; demo keeper seeds — no key, no funds, no network,
# no custody.
#
# Scope: active-designing/date/20260813/20260813-075049_mycelium-pledge-two-phase-transfer-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_pledge_knot_witness.rish

say "mycelium-pledge-knot: Language EN — a promise made before the ledger's past was tied off is kept after it, and every honest hand reads the same keeping."
say "mycelium-pledge-knot: Style Radiant — the Knot ties off a length of Cord and begins the next; a pledge opened in the sealed past is honored across the cut, the coin reaching the hand it was always meant for."
say "mycelium-pledge-knot: Lens TAME — the verdict never drifts across the cut; conservation of balance + reserved holds; a corrupt Knot, a tampered suffix fact, and a resolution of a pledge the checkpoint never opened each refuse whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/pledge_knot"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/pledge_knot.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-pledge-knot: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-pledge-knot: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-pledge-knot: selftest did not speak GREEN"
assert selftest.out contains "reads across a Knot" else "mycelium-pledge-knot: across-a-cut verdict claim missing"
assert selftest.out contains "honors it across the cut" else "mycelium-pledge-knot: pledge-honored-across-cut claim missing"
assert selftest.out contains "verdict never drifts" else "mycelium-pledge-knot: no-drift claim missing"
assert selftest.out contains "each refuse whole" else "mycelium-pledge-knot: refusal claim missing"

# The Pledge whose verdict this reads across a checkpoint, and the Knot whose seal it continues onto, both stand
# at the door — their own selftests prove the machinery the crossing rests on.
let pledge = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/pledge.rye -femit-bin=mycelium/bin/pledge && mycelium/bin/pledge 2>&1"]
assert pledge.ok else "mycelium-pledge-knot: the Pledge whose verdict reads across is not GREEN"
assert pledge.out contains "GREEN" else "mycelium-pledge-knot: the Pledge did not speak its GREEN"

let knot = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot.rye -femit-bin=mycelium/bin/cord_knot && mycelium/bin/cord_knot 2>&1"]
assert knot.ok else "mycelium-pledge-knot: the Knot the verdict continues onto is not GREEN"
assert knot.out contains "GREEN" else "mycelium-pledge-knot: the Knot did not speak its GREEN"

say "mycelium-pledge-knot: GREEN — the two-phase verdict reads across a sealed checkpoint, a pledge opened before the cut honored (or released) after it, the same whether in a full Cord or a Knot; conservation of balance + reserved whole; a corrupt Knot, a tampered suffix fact, and a resolution of a never-opened pledge each refuse whole; the Pledge and the Knot stand at the door."
