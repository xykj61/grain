# tools/m/mycelium_muster_witness.rish -- the Muster: a known validator set a Chorus must pass (r1).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - the Muster - rung r1 -- the crux.
# The Chorus made a position BELIEVABLE by a quorum of distinct independent Vouchers; yet it counts ANY
# distinct keys -- verify_chorus(3) passes the instant three fresh keypairs sign the claim, and nothing
# said WHOSE keys those must be. Distinctness proves the voices are different; it cannot prove they are
# entitled. The Muster fills that blind spot: a known, bounded, named set of validator public keys -- the
# roll a quorum must be drawn from.
#
# The crux this witness proves is A CHORUS PASSES MUSTER ONLY WHEN ENROLLED VALIDATORS REACH THE
# BYZANTINE THRESHOLD: pass_muster(muster, chorus) passes exactly when the Chorus is internally sound on
# its own terms (verify_chorus -- every voice verifies - all agree on one claim - signers distinct), every
# distinct voice is an enrolled Muster member (else NotMember), and the enrolled count meets the Muster's
# Byzantine threshold n−(n−1)/3 (else BelowQuorum). The crux demonstration: a Chorus of three fresh keys
# that PASSES verify_chorus(3) REFUSES pass_muster NotMember against a roll those keys were never enrolled
# in -- a fresh key never passes for a validator. The threshold is read from the roll's size, never stored,
# so a tampered roll cannot lower its own bar. Composes chorus + voucher + kumara public API only, editing
# none; the membership-and-quorum law is the Muster's own bounded fold; demo validator and keeper seeds --
# no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-110039_mycelium-muster-known-validator-set-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_muster_witness.rish

say "mycelium-muster: Language EN — a quorum is drawn not from any keys at all, but from a roll of validators named in the open: a Chorus is believed only when enrolled voices reach the Byzantine threshold the roll's own size sets."
say "mycelium-muster: Style Radiant — the Chorus made a position believable by a quorum of distinct voices; the Muster makes the quorum accountable to a named set, so a stranger who holds the roll trusts an enrolled quorum and refuses an outsider one."
say "mycelium-muster: Lens TAME — the membership-and-quorum law composes chorus + voucher + kumara public API; the roll is bounded at muster_max_members; the Byzantine threshold is derived from the count, never stored; every voice must be enrolled and the enrolled count must meet the threshold; refuses tamper; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/muster"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/muster.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-muster: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-muster: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-muster: selftest did not speak GREEN"
assert selftest.out contains "a Chorus is believed only when enrolled validators reach the Byzantine threshold" else "mycelium-muster: quorum-against-roll claim missing"
assert selftest.out contains "a fresh key never passes for a validator" else "mycelium-muster: crux (fresh key refused) claim missing"
assert selftest.out contains "Proof of quorum against a known set stands" else "mycelium-muster: closing claim missing"

# The refusal ledger a keeper reads -- the crux (fresh keys the Chorus alone believes, the Muster does not),
# the thin quorum, the padded quorum, and the enroll refusals.
assert selftest.out contains "verify_chorus(3) passes" else "mycelium-muster: the crux-forgery premise (Chorus alone believes fresh keys) missing"
assert selftest.out contains "refuse pass_muster NotMember" else "mycelium-muster: the crux refusal (NotMember) missing"
assert selftest.out contains "a thin quorum refuses BelowQuorum" else "mycelium-muster: thin-quorum refusal missing"
assert selftest.out contains "a padded quorum refuses whole" else "mycelium-muster: padded-quorum refusal missing"
assert selftest.out contains "enroll refuses Duplicate and MusterFull" else "mycelium-muster: enroll refusals missing"

# The rendered roll a keeper reads -- four enrolled validators set a Byzantine threshold of three.
assert selftest.out contains "muster validators=4 byzantine_threshold=3" else "mycelium-muster: rendered roll (n=4 t=3) missing"

# The Chorus each quorum is, and the Voucher each voice is, stand at the door -- their own selftests prove
# the quorum machinery the Muster rests on.
let chorus = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/chorus.rye -femit-bin=mycelium/bin/chorus && mycelium/bin/chorus 2>&1"]
assert chorus.ok else "mycelium-muster: the Chorus each quorum is is not GREEN"
assert chorus.out contains "GREEN" else "mycelium-muster: the Chorus did not speak its GREEN"

let voucher = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/voucher.rye -femit-bin=mycelium/bin/voucher && mycelium/bin/voucher 2>&1"]
assert voucher.ok else "mycelium-muster: the Voucher each voice is is not GREEN"
assert voucher.out contains "GREEN" else "mycelium-muster: the Voucher did not speak its GREEN"

say "mycelium-muster: GREEN — a known validator set binds a quorum to a named roll: a Chorus is believed only when enrolled validators reach the Byzantine threshold n−(n−1)/3, a fresh key never passes for a validator (NotMember), a thin quorum refuses BelowQuorum, a padded quorum refuses whole, and the roll refuses Duplicate and MusterFull; the Chorus and the Voucher stand at the door. Proof of quorum against a known set stands."
