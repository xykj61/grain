# mand_ring3_witness.rish — Mand ring-3: erasure (test-only reach).
#
#   rishi/bin/rishi run tools/m/mand_ring3_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "mand/bin/mand_ring3_witness"

let build = run ["sh" "-c" "mkdir -p mand/bin && env RYE_ZIG=${zig} rye/bin/rye build mand/mand_ring3_witness.rye -femit-bin=${bin}"]
assert build.ok else "Mand ring-3 witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "Mand ring-3 witness exited non-zero"
assert selftest.out contains "GREEN" else "Mand ring-3 witness not GREEN"
assert selftest.out contains "WitnessModeRequired" else "Mand ring-3 missing witness-mode refuse"
assert selftest.out contains "HeldRefused" else "Mand ring-3 missing HELD refuse"
assert selftest.out contains "removal fact written" else "Mand ring-3 missing removal fact claim"
assert selftest.out contains "digest unchanged" else "Mand ring-3 missing digest stance proof"

say "GREEN: Mand ring-3 erasure witness passed."
