# tools/m/mycelium_cord_batch_true_witness.rish -- the batched Cord reads true (fact batching r4, arc closes).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - fact batching - rung r4.
# r1 proved a batched history folds identical to single-fact, r2 let it travel, r3 measured the throughput
# win -- all over Dags seated in code. This closing rung carries the reader onto a real on-disk
# format cord-batch-v1 record a keeper can open and walk, and proves the order and supply the batched Cord
# reports are true to the bytes.
#
# tools/fixtures/cord_batch_truth.awk reads the same file independently; the witness asserts the app's
# triple (blocks-supply-stars) equals awk's -- two tools, one answer (2 700 1). The fixture is genuinely
# reproducible (the generator re-emits byte-identical bytes), and the record is a genuine committed batched
# Cord (the app rebuilds under add_batch, re-verifying every signature, and re-committing reproduces the
# file's agreed order). Demo keeper seeds only -- no key, funds, network, or custody.
#
# Additive: r1 (fold identical), r2 (travel), and r3 (throughput) re-run GREEN under this one.
#
# Scope: active-designing/date/20260813/20260813-043303_mycelium-fact-batching-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_cord_batch_true_witness.rish

say "mycelium-cord-batch-true: Language EN — the reading of a real batched Cord record is true to the bytes; app and awk give one answer."
say "mycelium-cord-batch-true: Style Radiant — the cord is drawn from the ground and walked bead by bead; what it says is what a keeper can count by hand."
say "mycelium-cord-batch-true: Lens TAME — blocks, supply, and stars cross-check against an independent awk; the Dag rebuilt under add_batch; a tampered record never read as true; demo seeds only."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_batch_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_batch_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-batch-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-cord-batch-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-batch-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent count of the same bytes" else "mycelium-cord-batch-true: read-true claim missing"
assert selftest.out contains "re-renders to the embedded bytes exactly, and its blocks stand in the agreed order" else "mycelium-cord-batch-true: genuine-cord claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-cord-batch-true: tamper refusal missing"
assert selftest.out contains "The fact-batching arc closes" else "mycelium-cord-batch-true: arc-close claim missing"

# The crux -- two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-cord-batch-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/cord_batch_truth.awk tools/fixtures/cord_batch_dag.bron"]
assert awk.ok else "mycelium-cord-batch-true: awk truth read failed"
assert awk.out contains "2 700 1" else "mycelium-cord-batch-true: awk triple not 2 700 1"
assert app.out == awk.out else "mycelium-cord-batch-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is genuinely reproducible -- the generator re-emits byte-identical bytes. Emit to a scratch
# path and diff (never overwrite the committed fixture in a read-only witness).
let gen = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_batch_fixture_gen.rye -femit-bin=mycelium/bin/cord_batch_fixture_gen"]
assert gen.ok else "mycelium-cord-batch-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/cord_batch_fixture_gen 2> /tmp/cord_batch_dag_regen.bron; diff tools/fixtures/cord_batch_dag.bron /tmp/cord_batch_dag_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-cord-batch-true: the fixture generator did not reproduce the committed bytes"
assert regen.out contains "REPRODUCIBLE" else "mycelium-cord-batch-true: the regenerated fixture drifted from the committed one"

# r1, r2, and r3 stay their own GREEN binaries -- this rung reads the record r2 renders, never replaces it.
let r2 = run ["sh" "-c" "rishi/bin/rishi run tools/m/mycelium_cord_batch_bron_witness.rish 2>&1"]
assert r2.ok else "mycelium-cord-batch-true: rung two (travel) is not GREEN"
assert r2.out contains "mycelium-cord-batch-bron: GREEN" else "mycelium-cord-batch-true: rung two did not speak its GREEN"

let r3 = run ["sh" "-c" "rishi/bin/rishi run tools/m/mycelium_cord_batch_bench_witness.rish 2>&1"]
assert r3.ok else "mycelium-cord-batch-true: rung three (throughput) is not GREEN"
assert r3.out contains "mycelium-cord-batch-bench: GREEN" else "mycelium-cord-batch-true: rung three did not speak its GREEN"

say "mycelium-cord-batch-true: GREEN — a real batched Cord record reads true (app==awk, 2 700 1), its supply rebuilt under add_batch and folded through the real Mycelium law, its blocks in the agreed order, its fixture reproducible; the travel and throughput rounds stand at r4's door. The Mycelium fact-batching arc closes."
