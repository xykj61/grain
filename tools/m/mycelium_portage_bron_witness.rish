# tools/m/mycelium_portage_bron_witness.rish — a crossing travels as a readable record, accepted by that alone
# (r3, travel).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · Portage · rung r3.
# r1 proved value crosses two worlds and the pair conserves; r2 made the crossing atomic — it lands on both
# ledgers or neither. Both read the two worlds' ledger blocks in hand. Yet the correspondent a portage means
# to replace is exactly the party a receiving world would otherwise trust for word of the far shore. r3 lets
# the crossing cross as a RECORD: a `format portage-v1` receipt carrying id · from · to-world · to-account ·
# amount · digest · out-head · in-head. Render writes it, parse reads it back byte-for-byte — a fixed point.
#
# The crux this witness proves is that the record is SELF-CERTIFYING and TIED TO BOTH LEDGERS: the carried
# digest is a pure function of the record's own bound fields, so a tampered field breaks self-certification;
# the out-head must be World A's real order-head with a matching burn, and the in-head must be World B's real
# order-head that credits the recipient under this digest — so a world accepts a cross-world transfer by
# reading its record alone, yet still catches a record whose fields or heads do not match the ledgers it
# names. Composes portage + cord + voucher + kumara public API only, editing none; demo world/keeper seeds —
# no key, no funds, no network, no value crossed.
#
# Scope: active-designing/date/20260813/20260813-124159_mycelium-portage-cross-world-transfer-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_portage_bron_witness.rish

say "mycelium-portage-bron: Language EN — the correspondent a portage replaces is the very party a receiving world would trust for word of the far shore, so the crossing must travel as a record a world can accept by itself."
say "mycelium-portage-bron: Style Radiant — render writes the crossing and parse reads it back byte-for-byte; the digest self-certifies its bound fields, the two heads tie the light record to the two real ledgers, and a tampered field or head refuses."
say "mycelium-portage-bron: Lens TAME — a purpose-built bounded reader composes portage + cord + voucher + kumara public API only, editing none; every field is fixed-width hex or a decimal amount; acceptance is a pure function of the two ledgers' bytes, never a correspondent's word; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/portage_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/portage_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-portage-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-portage-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-portage-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte" else "mycelium-portage-bron: the fixed-point claim missing"
assert selftest.out contains "accepts the crossing by its record alone" else "mycelium-portage-bron: the record-alone acceptance claim missing"
assert selftest.out contains "40 left A == 40 reached B" else "mycelium-portage-bron: the conservation-across-the-pair claim missing"
assert selftest.out contains "tampered out-head" else "mycelium-portage-bron: the tampered-head refusal claim missing"
assert selftest.out contains "missing field each refuse" else "mycelium-portage-bron: the reader-refusal claim missing"

# The Portage r1 crux this rung carries as a record stands at the door — the one-shot crossing and conservation.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/portage.rye -femit-bin=mycelium/bin/portage && mycelium/bin/portage 2>&1"]
assert r1.ok else "mycelium-portage-bron: the Portage r1 crux is not GREEN"
assert r1.out contains "GREEN" else "mycelium-portage-bron: the Portage r1 did not speak its GREEN"

# The Portage r2 atomic law this rung's record advertises stands too — a crossing lands on both or neither.
let r2 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/portage_atomic.rye -femit-bin=mycelium/bin/portage_atomic && mycelium/bin/portage_atomic 2>&1"]
assert r2.ok else "mycelium-portage-bron: the Portage r2 atomic law is not GREEN"
assert r2.out contains "GREEN" else "mycelium-portage-bron: the Portage r2 did not speak its GREEN"

say "mycelium-portage-bron: GREEN — a crossing renders to a format portage-v1 record and parses back byte-for-byte (a fixed point); a world accepts the crossing by its record alone — the digest self-certifies its bound fields, the out-head accepts World A's real ledger with a matching burn, the in-head accepts World B's real ledger crediting the recipient under this digest (40 left A == 40 reached B); a tampered field or head, and every malformed record, refuse; the Portage r1 crux and r2 atomic law both stand at the door. The record carries the crossing."
