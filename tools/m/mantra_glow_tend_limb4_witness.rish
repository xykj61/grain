# tools/m/mantra_glow_tend_limb4_witness.rish -- Mantra M4 in src/shape/.
#
#   rishi/bin/rishi run tools/m/mantra_glow_tend_limb4_witness.rish

say "mantra-tend-4: Language EN — Mantra Glow Tend limb 4 (sur museum)."
say "mantra-tend-4: Style Radiant — Store three dirs; Rye still owns the verbs."
say "mantra-tend-4: Lens TAME — Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/shape/shape-mantra-store-dir-count.glow"

let placard = run ["sh" "-c" "head -n 7 src/shape/shape-mantra-store-dir-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "mantra-tend-4: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "mantra-tend-4: placard missing six lines"

let ex = run ["sh" "-c" "grep -q 'example    3' src/shape/shape-mantra-store-dir-count.glow"]
assert ex.ok else "mantra-tend-4: example 3 missing"
let names = run ["sh" "-c" "grep -q 'root' src/shape/shape-mantra-store-dir-count.glow && grep -q 'blobs' src/shape/shape-mantra-store-dir-count.glow"]
assert names.ok else "mantra-tend-4: placard must name the members"
let elder = run ["sh" "-c" "grep -qE 'mantra/src/(weave|store).rye' src/shape/shape-mantra-store-dir-count.glow"]
assert elder.ok else "mantra-tend-4: elder citation missing"

# The claim is the placard's, so the number is read from the placard rather than spelled a
# second time here -- a guard that carries its own copy of the number can only ever agree with
# itself. Until 20260906 this leg was N `grep -Fq` calls for N field lines, which is presence
# rather than a count: a fourth field passed it, a reorder passed it, and it refused in the
# words "missing or reordered" (REDS %500). The reader is proven in a pen by
# tools/r/rye_struct_fields_witness.rish, two of whose phases run the elder predicate verbatim
# and watch it wave both breaks through.
say "mantra-tend-4: the placard's own number, read against Store in the rye..."
let declared = run ["sh" "-c" "grep -E '^::  example' src/shape/shape-mantra-store-dir-count.glow | sed -E 's/^.*example[[:space:]]+//'"]
assert declared.ok else "mantra-tend-4: the placard's example line is unreadable"
let want_count = trim declared.out
let counted = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--count" "mantra/src/store.rye" "Store"]
assert counted.ok else "mantra-tend-4: the field reader refused on Store -- ${counted.out}"
let got_count = trim counted.out
assert got_count == want_count else "mantra-tend-4: Store declares ${got_count} fields where the placard says ${want_count}"
let named = run ["sh" "tools/fixtures/r/rye_struct_fields_scan.sh" "--fields" "mantra/src/store.rye" "Store"]
assert named.ok else "mantra-tend-4: the field reader refused on Store -- ${named.out}"
let got_fields = trim named.out
assert got_fields == "root mantra_dir blobs_dir" else "mantra-tend-4: Store fields missing or reordered in the rye -- ${got_fields}"

let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "mantra-tend-4: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "mantra-tend-4: shape did not exit 0"

let prior = run ["sh" "-c" "test -f src/shape/shape-mantra-weave-field-count.glow -a -f src/shape/shape-mantra-line-field-count.glow"]
assert prior.ok else "mantra-tend-4: M1 or M2 missing"

say "GREEN: mantra Glow Tend limb 4 — Store three dirs in src/shape/; Tend ladder kept."
