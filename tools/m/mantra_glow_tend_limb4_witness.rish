# tools/m/mantra_glow_tend_limb4_witness.rish -- Mantra M4 in src/sur/.
#
#   rishi/bin/rishi run tools/m/mantra_glow_tend_limb4_witness.rish

say "mantra-tend-4: Language EN — Mantra Glow Tend limb 4 (sur museum)."
say "mantra-tend-4: Style Radiant — Store three dirs; Rye still owns the verbs."
say "mantra-tend-4: Lens TAME — Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-mantra-store-dir-count.glow"

let placard = run ["sh" "-c" "head -n 7 src/sur/shape-mantra-store-dir-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "mantra-tend-4: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "mantra-tend-4: placard missing six lines"

let ex = run ["sh" "-c" "grep -q 'example    3' src/sur/shape-mantra-store-dir-count.glow"]
assert ex.ok else "mantra-tend-4: example 3 missing"
let names = run ["sh" "-c" "grep -q 'root' src/sur/shape-mantra-store-dir-count.glow && grep -q 'blobs' src/sur/shape-mantra-store-dir-count.glow"]
assert names.ok else "mantra-tend-4: placard must name the members"
let elder = run ["sh" "-c" "grep -qE 'mantra/src/(weave|store).rye' src/sur/shape-mantra-store-dir-count.glow"]
assert elder.ok else "mantra-tend-4: elder citation missing"

let rye = run ["sh" "-c" "grep -q 'pub const Store = struct' mantra/src/store.rye && grep -Fq 'mantra_dir: Dir,' mantra/src/store.rye && grep -Fq 'blobs_dir:  Dir,' mantra/src/store.rye"]
assert rye.ok else "mantra-tend-4: fields missing or reordered in the rye elder"

let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "mantra-tend-4: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "mantra-tend-4: shape did not exit 0"

let prior = run ["sh" "-c" "test -f src/sur/shape-mantra-weave-field-count.glow -a -f src/sur/shape-mantra-line-field-count.glow"]
assert prior.ok else "mantra-tend-4: M1 or M2 missing"

say "GREEN: mantra Glow Tend limb 4 — Store three dirs in src/sur/; Tend ladder kept."
