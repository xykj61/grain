# mandate_serve_witness.rish -- Mandate's query serve protocol.
#
# Proves the wire shape of a query and its answer: a QueryRequest (k, optional tag
# filter, vector) and a QueryResponse (matches) serialize to bounded bytes; serve()
# decodes a request, answers it against the store, and encodes the response -- so a
# served query answers exactly as a direct in-process one. A bad magic, wrong version,
# over-range k, or too-small buffer is refused at the door.
#
# Build first:  rye build mandate/serve.rye -femit-bin=mandate/bin/serve
#   rishi/bin/rishi run tools/m/mandate_serve_witness.rish

# Build the binary this witness proves, rather than assuming a previous lap left one behind.
# mandate/bin/ is gitignored (.gitignore:191), so a clone carries none of these binaries: this
# witness named its build in the header comment above and then invoked the path, which died on a
# missing file rather than on a Mandate fact. The repair its Comlink sibling already carried.
let zig = "vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p mandate/bin && env RYE_ZIG=${zig} rye/bin/rye build mandate/serve.rye -femit-bin=mandate/bin/serve"]
assert build.ok else "mandate serve: build failed -- ${build.err}"

let st = run ["mandate/bin/serve" "selftest"]
assert st.ok else "mandate serve selftest must exit 0"
assert (st.err contains "GREEN") else "mandate serve must report GREEN"
assert (st.err contains "request/response protocol") else "serve is a query request/response protocol"
assert (st.err contains "messages a Comlink transport carries") else "the messages are what a Comlink transport carries"
assert (st.err contains "one-call server") else "serve is the one-call server"
assert (st.err contains "bytes in and bytes out") else "the same store answers in-process or across a wire"
assert (st.err contains "answers exactly as a direct in-process query") else "a served query equals a direct query"
assert (st.err contains "refused at the door") else "corrupt or out-of-range requests are refused"

say "GREEN: mandate serve — a bounded query request/response protocol over a Mandate store: encode/decode, answer, one-call serve, witnessed."
