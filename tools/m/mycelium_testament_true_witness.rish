# tools/m/mycelium_testament_true_witness.rish -- a real Testament certificate reads true, the receipt of the
# real verdict (r4, the Testament arc closes).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - Testament - rung r4 -- reads true.
# r1 sealed a named constellation's verdict and verified it offline, r2 carried its fault tolerance, r3 let
# it travel as a record -- all over certificates sealed in the same process. r4 carries the reader onto a REAL
# on-disk `format testament-v1` certificate a keeper can open and read -- tools/fixtures/testament_cert.bron,
# produced reproducibly by mycelium/testament_fixture_gen.rye, @embedFile-bound through the mycelium/corpora/
# symlink (no network).
#
# The crux this witness proves is TWO TOOLS, ONE ANSWER -- the app derives the certificate's shape
# (<ship_count> <head8>) INDEPENDENTLY of the record text: the ship count by booting the constellation from
# its names, the head by rebuilding the demo Dag and computing its true order-head; and that pair equals
# testament_cert_truth.awk's reading of the same bytes. The certificate is the receipt of the real verdict
# (it self-proves against its own named roster on parse, and the sealed head is a real order-head), its record
# a fixed point, its fixture reproducible, a tampered header refuses. Composes testament + testament_bron +
# testament_fixture_gen + constel + voucher public API only; siloed dev fixtures -- no key, funds, network,
# real value.
#
# Scope: active-designing/date/20260813/20260813-135126_mycelium-testament-named-quorum-certificate-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_testament_true_witness.rish

say "mycelium-testament-true: Language EN — a certificate a keeper can open and read is one the software cannot lie about: the reader's ship count and sealed head match an independent boot from the names and rebuild of the demo Dag, and the certificate is provably the receipt of the real verdict."
say "mycelium-testament-true: Style Radiant — r1 sealed the named verdict, r2 gave it fault tolerance, r3 let it travel; r4 reads a real on-disk certificate true, closing the Testament agent-doable arc."
say "mycelium-testament-true: Lens TAME — the reading is cross-checked against an independent awk of the same bytes (two tools, one answer); the app boots the roster from its names and the certificate self-proves on parse; the fixture is reproducible and the record a fixed point; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/testament_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/testament_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-testament-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-testament-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-testament-true: selftest did not speak GREEN"
assert selftest.out contains "matches an independent boot from the ship names" else "mycelium-testament-true: read-true claim missing"
assert selftest.out contains "the receipt of the real verdict" else "mycelium-testament-true: real-verdict claim missing"
assert selftest.out contains "never a hand-mock" else "mycelium-testament-true: fixed-point claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-testament-true: tamper refusal missing"
assert selftest.out contains "The Testament agent-doable arc closes" else "mycelium-testament-true: arc-close claim missing"

# The crux -- two tools, one answer. The app's measure pair must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-testament-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/testament_cert_truth.awk tools/fixtures/testament_cert.bron"]
assert awk.ok else "mycelium-testament-true: awk truth read failed"
assert awk.out contains "5 c2d99dd2" else "mycelium-testament-true: awk pair not 5 c2d99dd2"
assert app.out == awk.out else "mycelium-testament-true: app and awk disagree — the reading drifted from the bytes"

# The fixture is reproducible -- the generator re-emits byte-identical bytes, so the on-disk certificate is what
# the Testament seals, never a hand-mock. Emit to a scratch path and diff (never overwrite the committed one).
let genbuild = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/testament_fixture_gen.rye -femit-bin=mycelium/bin/testament_fixture_gen"]
assert genbuild.ok else "mycelium-testament-true: fixture generator build failed"
let regen = run ["sh" "-c" "mycelium/bin/testament_fixture_gen 2> /tmp/testament_cert_regen.bron; diff tools/fixtures/testament_cert.bron /tmp/testament_cert_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-testament-true: the regenerated fixture drifted from the committed one"
assert regen.out contains "REPRODUCIBLE" else "mycelium-testament-true: the regenerated fixture drifted from the committed one"

# The Testament r3 travel rung stands at the door -- a true reading of a real certificate means nothing unless
# the record round-trips and proves itself offline against its own roster.
let r3 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/testament_bron.rye -femit-bin=mycelium/bin/testament_bron && mycelium/bin/testament_bron 2>&1"]
assert r3.ok else "mycelium-testament-true: the Testament r3 travel rung is not GREEN"
assert r3.out contains "GREEN" else "mycelium-testament-true: the Testament r3 did not speak its GREEN"

say "mycelium-testament-true: GREEN — a real Testament certificate reads true (app==awk, 5 c2d99dd2), the certificate the receipt of the real verdict that self-proves against its own named roster and whose sealed head is a real order-head, its record a fixed point, its fixture reproducible; the travel round stands at r4's door. The Testament agent-doable arc closes — a named constellation's verdict is a portable, self-proving certificate a keeper reads by hand."
