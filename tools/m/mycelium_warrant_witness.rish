# tools/m/mycelium_warrant_witness.rish — the Warrant: a validator set rotates only when the current quorum
# certifies its successor (r1).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the Warrant · rung r1 — the crux.
# The Muster named WHICH nodes are the legitimate validators, yet the roll is FROZEN — nothing lets a
# validator set change. Real fault-tolerant systems must retire a compromised node, admit a new one, or
# rotate a whole committee between epochs (TigerBeetle changes its view, Mysticeti reconfigures its
# committee), and each faces the same trap: WHO authorizes the new roll? If a fresh set of keys could
# simply declare itself the validators, the Muster's guarantee evaporates. The Warrant fills that blind
# spot: a validator set rotates only when a QUORUM OF THE CURRENT ROLL certifies its successor — authority
# is handed forward under signature, never seized.
#
# The crux this witness proves is ONLY THE OUTGOING QUORUM CAN CROWN THE SUCCESSOR:
# verify_warrant(warrant, prev, next) passes exactly when the digests bind the two real rolls (else
# DigestMismatch), every endorser is an enrolled member of the PREVIOUS roll (else NotMember), the
# endorsers are distinct (else DuplicateSigner), every signature holds over the bound tuple (else
# BadSignature), and the count meets the previous roll's Byzantine threshold n−(n−1)/3 (else BelowQuorum).
# The crux demonstration: the successor's OWN fresh keys, signing their own coronation, REFUSE
# verify_warrant NotMember — a set cannot crown itself; only the roll it succeeds can hand authority
# forward. Composes muster + muster_bron + kumara public API only, editing none; demo validator and keeper
# seeds — no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-112420_mycelium-warrant-validator-set-rotation-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_warrant_witness.rish

say "mycelium-warrant: Language EN — a validator set does not seize authority; it receives it: a successor roll is believed only when a Byzantine quorum of the roll it replaces signed its content-address."
say "mycelium-warrant: Style Radiant — the Muster named which nodes are the validators; the Warrant lets that roll change hands without ever letting a set crown itself, so trust chains forward across epochs without a trusted third party."
say "mycelium-warrant: Lens TAME — the succession law composes muster + muster_bron + kumara public API; the certificate is bounded at warrant_max_sigs; each endorsement is domain-separated and digest-bound; every endorser must be enrolled in the previous roll and the count must meet its Byzantine threshold; refuses tamper; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/warrant"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/warrant.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-warrant: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-warrant: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-warrant: selftest did not speak GREEN"
assert selftest.out contains "a validator set rotates only when a Byzantine quorum of the current roll certifies its successor" else "mycelium-warrant: succession claim missing"
assert selftest.out contains "a set cannot crown itself" else "mycelium-warrant: crux (a set cannot crown itself) claim missing"
assert selftest.out contains "Safe validator-set rotation stands" else "mycelium-warrant: closing claim missing"

# The refusal ledger a keeper reads — the crux (the successor's own keys refuse NotMember), the thin
# handoff, the re-pointed certificate, the padded one, the forged endorsement, and the endorse refusals.
assert selftest.out contains "refuse verify_warrant NotMember" else "mycelium-warrant: the crux refusal (self-coronation NotMember) missing"
assert selftest.out contains "a thin handoff refuses BelowQuorum" else "mycelium-warrant: thin-handoff refusal missing"
assert selftest.out contains "a re-pointed certificate refuses DigestMismatch" else "mycelium-warrant: re-pointed refusal missing"
assert selftest.out contains "a padded one refuses whole" else "mycelium-warrant: padded refusal missing"
assert selftest.out contains "a forged endorsement refuses BadSignature" else "mycelium-warrant: forged-endorsement refusal missing"
assert selftest.out contains "endorse refuses DuplicateSigner and WarrantFull" else "mycelium-warrant: endorse refusals missing"

# The rendered warrant a keeper reads — epoch one, a freshly opened certificate with no endorsements yet.
assert selftest.out contains "warrant epoch=1 endorsements=0" else "mycelium-warrant: rendered warrant (epoch 1, empty) missing"

# The Muster the succession rests on stands at the door — its own selftest proves the roll and the
# Byzantine threshold the Warrant reads.
let muster = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/muster.rye -femit-bin=mycelium/bin/muster && mycelium/bin/muster 2>&1"]
assert muster.ok else "mycelium-warrant: the Muster the succession rests on is not GREEN"
assert muster.out contains "GREEN" else "mycelium-warrant: the Muster did not speak its GREEN"

say "mycelium-warrant: GREEN — authority is handed forward under signature, never seized: a successor roll is believed only when a Byzantine quorum of the previous roll signed its content-address (else DigestMismatch, NotMember, DuplicateSigner, BadSignature, BelowQuorum), and a set never crowns itself; the Muster stands at the door. Safe validator-set rotation stands."
