# tools/m/mycelium_tenure_bron_witness.rish -- the namespace verdict travels as a record (Tenure r2).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - Tenure rung r2 -- travel.
# r1 resolved a Cord's agreed order into a Tenure -- who holds each name, who lost a contest. A verdict a
# node cannot hand to another is only a local reading, so r2 lets a resolved Tenure cross as a
# `format tenure-v1` record and back, byte-for-byte, the recovered verdict answering the identical holder
# for every name and reporting the identical supply.
#
# The crux this witness proves: render the r1 contested verdict (two keepers reached for "bandun"; the
# agreed order granted it to one, supply folded to 800) to a record, parse it back, and the recovered
# Tenure gives the identical holder_of for every name and the identical supply; re-rendering is a fixed
# point. A purpose-built bounded reader refuses whole: a bad header (BadFormat), an unknown field
# (UnknownField), a bad hex key (BadHex), a missing supply line (BadFormat), an over-long verdict
# (TooManyHoldings). Composes tenure.rye + fold.rye public API only. Demo keeper seeds -- no key held.
#
# Scope: active-designing/date/20260813/20260813-060935_mycelium-tenure-contested-name-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_tenure_bron_witness.rish

say "mycelium-tenure-bron: Language EN — the namespace verdict crosses to a stranger as readable bytes, unchanged."
say "mycelium-tenure-bron: Style Radiant — the Cord wove one order through the dark; the Tenure read it; now the reading travels whole."
say "mycelium-tenure-bron: Lens TAME — a purpose-built bounded reader, never a general parser; every refusal whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/tenure_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/tenure_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-tenure-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-tenure-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-tenure-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte" else "mycelium-tenure-bron: round-trip claim missing"
assert selftest.out contains "answers the identical holder for every name" else "mycelium-tenure-bron: holder-unchanged claim missing"
assert selftest.out contains "each refuse" else "mycelium-tenure-bron: refusal claim missing"

# The Tenure whose verdict travels stands at the door -- its own selftest proves the verdict this record carries.
let tenure = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/tenure.rye -femit-bin=mycelium/bin/tenure && mycelium/bin/tenure 2>&1"]
assert tenure.ok else "mycelium-tenure-bron: the Tenure whose verdict travels is not GREEN"
assert tenure.out contains "GREEN" else "mycelium-tenure-bron: the Tenure did not speak its GREEN"

say "mycelium-tenure-bron: GREEN — the resolved verdict travels as a format tenure-v1 record and returns byte-for-byte, the recovered holder unchanged, every malformed record refused; the Tenure stands at the door."
