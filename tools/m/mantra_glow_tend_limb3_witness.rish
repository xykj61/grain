# tools/m/mantra_glow_tend_limb3_witness.rish — Mantra M3 in src/sur/.
#
#   rishi/bin/rishi run tools/m/mantra_glow_tend_limb3_witness.rish

say "mantra-tend-3: Language EN — Mantra Glow Tend limb 3 (sur museum)."
say "mantra-tend-3: Style Radiant — Diff two fields; Rye still owns the verbs."
say "mantra-tend-3: Lens TAME — Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-mantra-diff-field-count.glow"

let placard = run ["sh" "-c" "head -n 7 src/sur/shape-mantra-diff-field-count.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "mantra-tend-3: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "mantra-tend-3: placard missing six lines"

let ex = run ["sh" "-c" "grep -q 'example    2' src/sur/shape-mantra-diff-field-count.glow"]
assert ex.ok else "mantra-tend-3: example 2 missing"
let names = run ["sh" "-c" "grep -q 'inserts' src/sur/shape-mantra-diff-field-count.glow && grep -q 'deletes' src/sur/shape-mantra-diff-field-count.glow"]
assert names.ok else "mantra-tend-3: placard must name the members"
let elder = run ["sh" "-c" "grep -qE 'mantra/src/(weave|store).rye' src/sur/shape-mantra-diff-field-count.glow"]
assert elder.ok else "mantra-tend-3: elder citation missing"

let rye = run ["sh" "-c" "grep -q 'pub const Diff = struct' mantra/src/weave.rye && grep -Fq 'inserts: []const []const u8,' mantra/src/weave.rye && grep -Fq 'deletes: []const u32,' mantra/src/weave.rye"]
assert rye.ok else "mantra-tend-3: fields missing or reordered in the rye elder"

let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "mantra-tend-3: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "mantra-tend-3: shape did not exit 0"

let prior = run ["sh" "-c" "test -f src/sur/shape-mantra-weave-field-count.glow -a -f src/sur/shape-mantra-line-field-count.glow"]
assert prior.ok else "mantra-tend-3: M1 or M2 missing"

say "GREEN: mantra Glow Tend limb 3 — Diff two fields in src/sur/; Tend ladder kept."
