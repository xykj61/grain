# mandate_store_witness.rish — Mandate, Grain's turbopuffer.
#
# Proves the vector store: upsert normalizes a vector to a unit direction, so a query
# is a dot product; a query returns the k nearest by cosine similarity, most similar
# first, bounded and exact; the search is **zero-copy** (each record read in place);
# a **tag** filters the search; and an upsert on an existing id updates in place. The
# vectors are synthetic image embeddings — no key, no network — with Unsplash the
# first real data source on the horizon.
#
# Build first:  rye build mandate/store.rye -femit-bin=mandate/bin/store
#   rishi/bin/rishi run tools/m/mandate_store_witness.rish

let st = run ["mandate/bin/store" "selftest"]
assert st.ok else "mandate store selftest must exit 0"
assert (st.err contains "GREEN") else "mandate store must report GREEN"
assert (st.err contains "a query is a dot product") else "unit vectors make a query a dot product"
assert (st.err contains "cosine similarity") else "nearness is cosine similarity"
assert (st.err contains "most-similar-first") else "results return most similar first"
assert (st.err contains "bounded and exact") else "the store is bounded and search is exact"
assert (st.err contains "zero-copy") else "search reads each record in place, never copied"
assert (st.err contains "read in place at query time") else "the store owns the bytes; search borrows them"
assert (st.err contains "a tag filters the search") else "a metadata tag filters the search"
assert (st.err contains "updates in place, never growing the store") else "an upsert on an existing id updates in place"
assert (st.err contains "turbopuffer") else "Mandate is Grain's turbopuffer"
assert (st.err contains "object-storage backing") else "the whole store serializes to one portable object"
assert (st.err contains "hydrated back from it, identical") else "a fresh node round-trips the store from the blob (object-storage backing)"

say "GREEN: mandate store — Grain's turbopuffer: a bounded, zero-copy vector store; nearest-neighbour by cosine over unit vectors, a metadata filter, an approximate index, object-storage backing, exact and witnessed."
