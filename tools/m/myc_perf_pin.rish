# tools/m/myc_perf_pin.rish — door 11 · S0 performance pin (Voice J4 · h4).
#
# Wall-time baselines for the myc GREEN witness roster.
# Measure before movement · no tuning · no budget red on elapsed_ms.
# Bound myc_perf_baseline_min_rows 5 from tools/gen/season/recursion_block.brix.
#
#   rishi/bin/rishi run tools/m/myc_perf_pin.rish
#
# Report: work-in-progress/myc-s0-baselines.tsv
# Note: shell $vars cannot live in rish "sh -c" strings — rish expands $digits.
#       Row/exit checks therefore live in tools/m/myc_perf_pin.sh.

# cut -f2 — never put shell $N inside rish "sh -c" strings (rish expands them).
let bound_scan = run ["sh" "-c" "grep -E '^myc_perf_baseline_min_rows ' tools/gen/season/recursion_block.brix | cut -d' ' -f2"]
assert bound_scan.ok else "myc_perf_pin: bound scan failed"
let bound = trim bound_scan.out
assert bound == "5" else "myc_perf_pin: myc_perf_baseline_min_rows drift (want 5)"

let pin = run ["sh" "tools/m/myc_perf_pin.sh"]
if pin.out != "" then say pin.out
assert pin.ok else "myc_perf_pin: driver failed — correctness or thin rows"
assert pin.out contains "GREEN: myc_perf_pin" else "myc_perf_pin: missing GREEN line"

let report = run ["test" "-f" "construction/myc-s0-baselines.tsv"]
assert report.ok else "myc_perf_pin: missing construction/myc-s0-baselines.tsv"

let header = run ["sh" "-c" "head -1 construction/myc-s0-baselines.tsv"]
assert header.ok else "myc_perf_pin: header read failed"
assert header.out contains "name" else "myc_perf_pin: bad header"
assert header.out contains "elapsed_ms" else "myc_perf_pin: bad header"

say "GREEN: myc_perf_pin — S0 baselines pinned · bound=5 · report=construction/myc-s0-baselines.tsv · no tuning"
