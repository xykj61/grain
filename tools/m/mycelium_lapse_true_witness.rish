# tools/m/mycelium_lapse_true_witness.rish -- the Lapse reads a real deadline-clock fixture true (r4, closes).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - the Lapse - rung r4.
# r1 fixed the deadline verdict, r2 let it travel, r3 read it across a Knot -- all over Dags seated in code.
# This closing rung carries the reader onto a REAL on-disk Cord record carrying a genuine lapsed reservation
# a keeper can open and walk, and proves the property the whole Lapse rests on: the LAPSED recipient -- the
# one the coins never reached because the order's clock ran out -- is true to the bytes.
#
# The crux is TWO TOOLS, ONE ANSWER: mycelium/lapse_true parses tools/fixtures/lapse_dag.bron through
# cord_bron, rebuilds the Dag under cord.add (re-verifying every signature), resolves it through lapse, and
# reports the lapsed recipient, the lapsed count, and the open count; this witness cross-checks that triple
# against tools/fixtures/lapse_dag_truth.awk's independent reading of the same bytes. The awk ticks a clock
# in file order, lapsing an open pledge the moment the running position reaches its deadline (the same order
# the app's fold applies), so the app's full commit tie-break and the awk's file-order accounting name the
# same lapsed recipient -- a reservation the order let expire can never drift from an order a keeper walks by
# hand. The fixture is genuinely what the Cord emits (the generator re-emits byte-identical bytes), and a
# tampered record refuses. Composes cord_bron + cord + lapse public API only; demo keeper seeds -- no key,
# no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-085046_mycelium-lapse-pending-timeout-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_lapse_true_witness.rish

say "mycelium-lapse-true: Language EN — a reservation the clock let expire, read true from bytes a keeper can open and walk."
say "mycelium-lapse-true: Style Radiant — r1 fixed the deadline, r2 let it travel, r3 crossed a Knot; r4 reads a real record and the app and an awk name one lapsed recipient."
say "mycelium-lapse-true: Lens TAME — the reading composes cord_bron + cord + lapse public API; the Dag is rebuilt under the Cord's own add; the awk ticks the same clock in file order; conservation holds over the real bytes; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/lapse_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/lapse_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-lapse-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-lapse-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-lapse-true: selftest did not speak GREEN"
assert selftest.out contains "the lapsed pledge's coins never reached its recipient" else "mycelium-lapse-true: lapsed-came-home claim missing"
assert selftest.out contains "conservation holds over the real bytes" else "mycelium-lapse-true: conservation claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-lapse-true: tamper-refusal claim missing"

# The crux -- two tools, one answer. The app's measure triple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-lapse-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/lapse_dag_truth.awk tools/fixtures/lapse_dag.bron"]
assert awk.ok else "mycelium-lapse-true: awk truth read failed"
assert awk.out contains "55154f42065ea5a1bea05463826be2684eb92df92c100027aabaae57ca554207 1 1" else "mycelium-lapse-true: awk triple not Bob's lapsed pledge · lapsed 1 · open 1"
assert app.out == awk.out else "mycelium-lapse-true: app and awk disagree — the lapsed recipient drifted from the bytes"

# The fixture is genuinely what the Cord emits, not a hand-mock -- the generator re-emits byte-identical bytes.
let regen = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run mycelium/lapse_fixture_gen.rye 2>/tmp/lapse_regen.bron >/dev/null && diff -q tools/fixtures/lapse_dag.bron /tmp/lapse_regen.bron && echo REPRODUCIBLE"]
assert regen.ok else "mycelium-lapse-true: fixture is not reproducible — the generator drifted"
assert regen.out contains "REPRODUCIBLE" else "mycelium-lapse-true: fixture regeneration did not match"

# The Lapse whose verdict this rung reads from real bytes, and the cord_bron reader that rebuilds the real
# Dag, both stand at the door -- their own selftests prove the machinery r4 rests on.
let lapse = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/lapse.rye -femit-bin=mycelium/bin/lapse && mycelium/bin/lapse 2>&1"]
assert lapse.ok else "mycelium-lapse-true: the Lapse r1 the reading resolves is not GREEN"
assert lapse.out contains "GREEN" else "mycelium-lapse-true: the Lapse r1 did not speak its GREEN"

say "mycelium-lapse-true: GREEN — a real deadline-clock record reads true (app==awk, Bob's lapsed pledge · lapsed 1 · open 1); the lapsed recipient resolved under the Cord's own add and the agreed order, conservation of balance + reserved whole, the fixture reproducible, a tampered record refused; the Lapse stands at the door. The Mycelium Lapse's agent-doable arc closes."
