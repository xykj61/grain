# tools/m/mycelium_braid_kyri_witness.rish -- the linked-chain verdict travels as a record (r2).
#
# Chapter D (Kresfa & Mycelium) - Mycelium consensus - the Braid verdict travels - rung r2.
# r1 resolved a Cord's agreed order into a Ledger -- every account's balance and every braid's atom-verdict
# (committed, rejected, or pending). A verdict a node cannot hand to another is only a local reading, so r2
# lets a resolved Ledger cross as `format braid-v1` bytes: an `issued` line, one `holds <pk> <balance>` line
# per account, one `braid <id> <state>` line per linked chain, one `link <id> <seq> <from> <to> <amount>`
# line per link. Render writes it, parse reads it back byte-for-byte (a fixed point), and the recovered Ledger
# answers the identical balances, atom-verdicts, and links.
#
# The record carries conservation as its own law (as purse-v1 did): the balances a record claims must sum to
# exactly the `issued` total, or the reader refuses `BadInt` before trusting it -- no coin appears or vanishes,
# whether a committed braid moved coins or a rejected braid moved none. A purpose-built bounded reader refuses
# a bad header (`BadFormat`), an unknown field (`UnknownField`, never dropped), a bad hex key (`BadHex`), an
# unknown braid state or broken conservation (`BadInt`), a missing issued line (`BadFormat`), and an over-long
# verdict (`TooManyBraids` at render). Composes braid + cord + fold public API only; every buffer bounded;
# demo keeper seeds -- no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-081709_mycelium-braid-linked-atomic-chain-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_braid_kyri_witness.rish

say "mycelium-braid-kyri: Language EN — a linked chain's whole verdict written plainly enough that a stranger reads it back unchanged."
say "mycelium-braid-kyri: Style Radiant — r1 decided the atom locally; r2 lets it cross as readable bytes, carrying its own conservation law so no coin is made or lost in the crossing."
say "mycelium-braid-kyri: Lens TAME — render/parse compose braid + cord + fold public API; every buffer bounded; the balances must sum to the issued total or the record refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/braid_kyri"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh mycelium/braid_kyri.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-braid-kyri: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-braid-kyri: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-braid-kyri: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte" else "mycelium-braid-kyri: round-trip claim missing"
assert selftest.out contains "identical balances and atom-verdict" else "mycelium-braid-kyri: unchanged-verdict claim missing"
assert selftest.out contains "conservation to 150 unchanged" else "mycelium-braid-kyri: conservation-travels claim missing"
assert selftest.out contains "fixed point" else "mycelium-braid-kyri: fixed-point claim missing"
assert selftest.out contains "each refuse" else "mycelium-braid-kyri: refusal claim missing"

# The Braid whose verdict this record carries stands at the door -- its own selftest proves the
# linked-chain law the travelled bytes describe.
let braid = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh mycelium/braid.rye -femit-bin=mycelium/bin/braid && mycelium/bin/braid 2>&1"]
assert braid.ok else "mycelium-braid-kyri: the Braid whose verdict travels is not GREEN"
assert braid.out contains "GREEN" else "mycelium-braid-kyri: the Braid did not speak its GREEN"

say "mycelium-braid-kyri: GREEN — a resolved linked-chain verdict renders to a format braid-v1 record and parses back byte-for-byte, the recovered Ledger answering the identical balances and atom-verdict with conservation intact; a bad header · unknown field · bad hex · bad state · broken conservation · missing issued · over-long verdict each refuse; the Braid stands at the door."
