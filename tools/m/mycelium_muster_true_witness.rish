# tools/m/mycelium_muster_true_witness.rish -- a real quorum passes a real roll, true to the bytes (r4).
#
# Season D (Kresfa & Mycelium) - Mycelium consensus - the Muster - rung r4 -- the arc closes.
# r1 bound a Chorus to a known validator set (a Muster); r2 let the roll travel; r3 judged a quorum against
# a roll across a Knot -- all over Dags seated in code. This closing rung carries the roll onto a REAL
# on-disk Cord record a keeper can open and hash, and proves the roll's verdict on a real quorum is TRUE TO
# THE BYTES.
#
# The crux this witness proves is TWO TOOLS, ONE ANSWER: the app parses tools/fixtures/lapse_dag.bron
# through cord_bron, rebuilds the Dag under cord.add (re-verifying every signature), gathers a three-node
# quorum over the genesis-funded account, enrolls the roll of exactly that mesh, confirms the roll PASSES
# the real quorum, and emits the agreed position tuple; the independent statement_dag_truth.awk names the
# identical position (app.out == awk.out enforced). The roll's verdict is honest: three validators enrolled,
# three voices present, Byzantine threshold three (the enrolled count is exactly the members present), and a
# roll of three strangers refuses the same real quorum NotMember. A tampered header refuses BadFormat.
# Composes cord_bron + cord + lapse + statement + voucher + chorus + muster + kumara public API only; demo
# node and keeper seeds -- no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-110039_mycelium-muster-known-validator-set-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/m/mycelium_muster_true_witness.rish

say "mycelium-muster-true: Language EN — a real ledger record a keeper can open and hash is judged by a real validator set: the quorum that belongs to the roll passes, a roll of strangers does not, and the agreed position matches an independent reading byte for byte."
say "mycelium-muster-true: Style Radiant — the Muster's arc closes where it should, on the tree's own bytes: a real quorum passes the roll enrolling exactly its mesh, and the roll's verdict is true to a record two tools read the same way."
say "mycelium-muster-true: Lens TAME — the app rebuilds the real Dag under cord.add, gathers a quorum, enrolls the mesh roll, and confirms pass_muster; awk reads the same bytes; app.out == awk.out; three validators, three voices, threshold three; a stranger roll refuses NotMember; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/muster_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/muster_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-muster-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-muster-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-muster-true: selftest did not speak GREEN"
assert selftest.out contains "the real quorum passes the roll enrolling exactly its mesh" else "mycelium-muster-true: passes-its-roll claim missing"
assert selftest.out contains "the enrolled count is exactly the members present" else "mycelium-muster-true: enrolled-count claim missing"
assert selftest.out contains "a roll of three strangers refuses the same real quorum NotMember" else "mycelium-muster-true: stranger-roll refusal claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-muster-true: tamper-refusal claim missing"
assert selftest.out contains "The Mycelium Muster's agent-doable arc closes" else "mycelium-muster-true: arc-close claim missing"

# The crux -- two tools, one answer. The app's measure tuple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-muster-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/statement_dag_truth.awk tools/fixtures/lapse_dag.bron"]
assert awk.ok else "mycelium-muster-true: awk truth read failed"
assert awk.out contains "bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5 100 100 200" else "mycelium-muster-true: awk tuple not the funded account · balance 100 · reserved 100 · received 200"
assert app.out == awk.out else "mycelium-muster-true: app and awk disagree — the agreed position drifted from the bytes"

# The Muster r1 whose roll this rung applies to a real record stands at the door.
let muster = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/muster.rye -femit-bin=mycelium/bin/muster && mycelium/bin/muster 2>&1"]
assert muster.ok else "mycelium-muster-true: the Muster r1 this rung applies to a real record is not GREEN"
assert muster.out contains "GREEN" else "mycelium-muster-true: the Muster r1 did not speak its GREEN"

say "mycelium-muster-true: GREEN — a real ledger record is judged by a real validator set (app==awk, the funded account bc7cbcb5… · balance 100 · reserved 100 · received 200): the quorum enrolling exactly its mesh passes, three validators · three voices · threshold three, a roll of three strangers refuses NotMember, a tampered record refused; the Muster r1 stands at the door. The Mycelium Muster's agent-doable arc closes."
