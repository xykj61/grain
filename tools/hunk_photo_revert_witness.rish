# tools/hunk_photo_revert_witness.rish — the Photos app reverts on metal (HUNK14).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK14.
# Design read: active-designing/20260813-155719_hunk-photo-edits-non-destructive-exploration.md (HUNK14 horizon).
# Teacher, thanked clean-room: the "revert to original" of iCloud Photos / Google Photos (concept only, siloed).
#
# HUNK11 recorded the six Photos verbs as a bounded edit-list and replayed them over an untouched source. This rung
# banks that non-destructiveness: because the source is never mutated, a revert is only dropping edits off the end of
# the list. `image/photo_revert.rye` gives `drop_last` (forget the last k edits), `truncate` (keep the first keep), and
# `revert_one` — all pure over the count, returning a fresh shorter list and leaving the caller's list whole. The
# earlier image is one `apply` of the shorter list away; the original is one `apply` of the empty list away. The
# selftest proves a one-step revert equals the earlier verbs by hand byte-for-byte, that dropping zero is identity and
# dropping all recovers the original, that an over-count drop clamps to empty without underflow, that the source list
# survives a revert (so it can be redone), and that a revert is a byte-prefix of the full record and still round-trips
# as an open fixed-point record. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_photo_revert_witness.rish

say "hunk-photo-revert: Language EN — HUNK14 reverts by dropping edits off the end of the list; the earlier image is one apply away, the original one empty-list apply away."
say "hunk-photo-revert: Style Radiant — a revert forgets, it never reconstructs: no pixels stored, no history log replayed backward, only the recipe shortened on the open module the quest built."
say "hunk-photo-revert: Lens TAME — drop_last and truncate are pure over the count, bounded by the same ceiling, clamping without underflow; the source list is untouched; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/photo_revert"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/photo_revert.rye -femit-bin=${bin}"]
assert build.ok else "hunk-photo-revert: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-photo-revert: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-photo-revert: ${out}"

assert selftest.out contains "GREEN image-photo-revert" else "hunk-photo-revert: selftest did not print the GREEN revert line"

assert selftest.out contains "equals the first two verbs by hand" else "hunk-photo-revert: a one-step revert did not equal the earlier verbs by hand"

assert selftest.out contains "recovers the original one empty-list apply away" else "hunk-photo-revert: reverting all did not recover the original"

assert selftest.out contains "clamps to empty without" else "hunk-photo-revert: an over-count drop did not clamp without underflow"

assert selftest.out contains "source list is untouched so a revert" else "hunk-photo-revert: the source list was not proven untouched"

assert selftest.out contains "byte-prefix of the full record" else "hunk-photo-revert: a revert was not proven a byte-prefix that still round-trips"

say "hunk-photo-revert: GREEN — the Photos app reverts: edits dropped off the end of the list, earlier images and the original recovered by replay, clamping without underflow, the source list whole; no network, no key, no funds."
