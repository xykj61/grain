# width_check_th4.rish — TH-4 witness: .brix tracks living ROADMAP and TASKS.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/width_check_th4.rish

let roadmap = run ["sh" "-c" "grep -q '^file construction/ROADMAP.md$' .brix"]
assert roadmap.ok else ".brix must track construction/ROADMAP.md"

let tasks = run ["sh" "-c" "grep -q '^file construction/TASKS.md$' .brix"]
assert tasks.ok else ".brix must track construction/TASKS.md"

let stale = run ["sh" "-c" "grep -E '995_open_threads|996_roadmap' .brix || true"]
assert trim stale.out == "" else ".brix must not reference retired WIP paths"

# The descriptor molted 20260810.145743 from the elder "veganreyklah2" version
# 20260629.004912; the pin follows the living value so the guard reads the tree
# rather than the tree it once had.
let version = run ["sh" "-c" "grep -q '^version 20260810.145743$' .brix"]
assert version.ok else ".brix version must be 20260810.145743"

# Typo resolution — one canon hand (do not duplicate Prim→Prin greps here)
let alias = run ["rishi/bin/rishi" "run" "tools/brix_alias_resolve.rish"]
assert alias.ok else "brix_alias_resolve failed"
assert alias.out contains "GREEN" else "brix_alias_resolve not GREEN"

say "GREEN: TH-4 — .brix mended; ROADMAP and TASKS tracked; alias via brix_alias_resolve."
