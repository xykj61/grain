# tools/font5x7_box_witness.rish -- the open box-drawing corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - the first content BEYOND printable ASCII for the open glyph atlas
# image/glyph.rye (gfa1), set beside the five ASCII corpora (tools/font5x7_witness.rish the numerals,
# tools/font5x7_alpha_witness.rish the uppercase, tools/font5x7_lower_witness.rish the lowercase,
# tools/font5x7_punct_witness.rish the punctuation, tools/font5x7_symbol_witness.rish the symbols).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn box-drawing corpus: the eleven light single-line marks --
# horizontal, vertical, the four corners, the four tees, and the cross -- at their real Unicode codepoints
# U+2500..U+253C, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_box.rye, built into
# a gfa1 atlas and proven on metal. These are exactly the marks a terminal surface (the Dexter/Scooter family)
# reaches for to frame a panel, rule a line, or box a table. A full round-trip recovers every codepoint, advance, and
# coverage byte byte-for-byte; all eleven marks look up present and carry the shared advance while an ASCII letter
# misses; no two marks share coverage (a real box set's glyphs differ); and each mark reads within an honest
# legibility band (a plain rule is five cells, the cross eleven). Compression is reported as a fact, never asserted --
# the round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it wants to draw a
# frame, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_box_witness.rish

say "font5x7-box: Language EN -- Season G's first font content beyond ASCII; the eleven light box-drawing marks drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a terminal surface uses to frame and rule."
say "font5x7-box: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every mark byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-box: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - box_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_box"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_box.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-box: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-box: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-box: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-box' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-box: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-box: round-trip was not byte-identical"

say "font5x7-box: GREEN -- the open box-drawing corpus whole; eleven light marks round-trip byte-identical, all present, distinct, and legible; the font family reaches its first codepoints beyond ASCII."
