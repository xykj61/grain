# tools/mycelium_warrant_bron_witness.rish — a validator-set handoff travels as a readable record (r2).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the Warrant · rung r2 — travel.
# r1 bound a succession to a quorum of the outgoing roll. A certificate a holder cannot hand to another is
# only a local proof, so r2 lets the whole Warrant cross as `format warrant-v1` bytes: the epoch, the
# retiring and successor roll digests as hex, and one `endorse <pk-hex> <sig-hex>` line per outgoing
# validator. The crux this witness proves is THE HANDOFF'S VERDICT SURVIVES THE WIRE: a Warrant parsed from
# bytes, judged against the two rolls, reaches the identical verdict as the certificate in memory — a
# lawful handoff passes, the successor's own keys refuse NotMember, a re-pointed one refuses DigestMismatch.
# Render writes it, parse reads it back byte-for-byte (fixed point). A wrong header, a missing
# epoch/prev/next, an unknown field, a bad hex digest, a bad epoch, and a repeated endorser each refuse.
# Composes warrant + muster + kumara public API only; demo seeds — no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-112420_mycelium-warrant-validator-set-rotation-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_warrant_bron_witness.rish

say "mycelium-warrant-bron: Language EN — a validator-set handoff a holder cannot hand on is only a local proof; the Warrant crosses as readable text and a recipient re-judges the same succession offline."
say "mycelium-warrant-bron: Style Radiant — the epoch and both roll digests travel, one endorse line per outgoing validator, and the recovered certificate reaches the identical verdict the one in memory reached."
say "mycelium-warrant-bron: Lens TAME — a purpose-built bounded reader over warrant + muster public API; render/parse is a fixed point; the endorse laws (a validator signs once, the certificate honors its bound) travel with it; refuses tamper; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/warrant_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/warrant_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-warrant-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-warrant-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-warrant-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte (fixed point)" else "mycelium-warrant-bron: fixed-point claim missing"
assert selftest.out contains "reaches the identical verdict" else "mycelium-warrant-bron: identical-verdict claim missing"
assert selftest.out contains "judges a succession the same offline" else "mycelium-warrant-bron: closing claim missing"

# The verdict survives the wire — the lawful handoff and the two refusals that prove the roll still binds.
assert selftest.out contains "the successor's own keys refuse NotMember" else "mycelium-warrant-bron: self-coronation refusal (over the wire) missing"
assert selftest.out contains "a re-pointed one refuses DigestMismatch" else "mycelium-warrant-bron: re-pointed refusal (over the wire) missing"

# The reader's refusal ledger.
assert selftest.out contains "a bad header, a missing epoch/prev/next, an unknown field, a bad hex digest, a bad epoch, a repeated endorser each refuse" else "mycelium-warrant-bron: reader refusal ledger missing"

# The rendered warrant a keeper reads — epoch one, three endorsements recovered from the wire.
assert selftest.out contains "warrant epoch=1 endorsements=3" else "mycelium-warrant-bron: rendered recovered warrant (epoch 1, 3 endorsements) missing"

# The Warrant each certificate is stands at the door — its r1 selftest proves the succession law.
let warrant = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/warrant.rye -femit-bin=mycelium/bin/warrant && mycelium/bin/warrant 2>&1"]
assert warrant.ok else "mycelium-warrant-bron: the Warrant each certificate is is not GREEN"
assert warrant.out contains "GREEN" else "mycelium-warrant-bron: the Warrant did not speak its GREEN"

say "mycelium-warrant-bron: GREEN — a validator-set handoff travels as a format warrant-v1 record and parses back byte-for-byte (fixed point), judging a succession the same offline: a lawful handoff passes, the successor's own keys refuse NotMember, a re-pointed one refuses DigestMismatch; the reader refuses a bad header, a missing field, an unknown field, a bad hex digest, a bad epoch, and a repeated endorser; the Warrant stands at the door."
