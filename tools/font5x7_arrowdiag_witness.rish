# tools/font5x7_arrowdiag_witness.rish -- the open diagonal-arrow corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - more content BEYOND printable ASCII for the open glyph atlas image/glyph.rye
# (gfa1), completing the arrow family the six basic directions began (tools/font5x7_arrow_witness.rish, U+2190..U+2195).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn diagonal-arrow corpus: the four corner arrows -- north-west,
# north-east, south-east, south-west -- at their real Unicode codepoints U+2196..U+2199, each a 5x7 coverage grid drawn
# in the open as ASCII line art in image/font5x7_arrowdiag.rye (a diagonal shaft with a two-prong head at the pointed
# corner), built into a gfa1 atlas and proven on metal. These are the marks a terminal surface (the Dexter/Scooter
# family) reaches for to resize a corner, drag diagonally, or point off-axis. A full round-trip recovers every
# codepoint, advance, and coverage byte byte-for-byte; all four arrows look up present and carry the shared advance
# while an ASCII letter and a cardinal arrow miss; no two arrows share coverage (a real set points to four corners);
# the two upward arrows are left-right mirrors of each other and likewise the two downward arrows (a true reflected
# family); and each reads within an honest legibility band. Compression is reported as a fact, never asserted -- the
# round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it wants to point off-axis.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_arrowdiag_witness.rish

say "font5x7-arrowdiag: Language EN -- Season G font content beyond ASCII; the four diagonal corner arrows drawn in the open as ASCII line art, built into the gfa1 atlas, completing the eight-direction arrow set a terminal surface points with."
say "font5x7-arrowdiag: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every arrow byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-arrowdiag: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - arrowdiag_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; the mirror pairing proven both ways; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_arrowdiag"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_arrowdiag.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-arrowdiag: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-arrowdiag: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-arrowdiag: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-arrowdiag' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-arrowdiag: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-arrowdiag: round-trip was not byte-identical"

let mirror = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'mirror-paired' && echo yes"]
assert (trim mirror.out) == "yes" else "font5x7-arrowdiag: the mirror-pair property was not reported"

say "font5x7-arrowdiag: GREEN -- the open diagonal-arrow corpus whole; four corner arrows round-trip byte-identical, all present, distinct, mirror-paired, and legible; the eight-direction arrow set stands complete."
