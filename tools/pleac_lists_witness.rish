# pleac_lists_witness.rish — the PLEAC lists cookbook (chunk · window · flatten).
#
# SOON. Proves pleac/lists.rye: chunk cuts a list into consecutive groups of a size
# (last may be shorter); window yields every overlapping run of a size, in order; both
# are zero-copy slices into the source; flatten(chunk(xs, n)) == xs (grouping lossless);
# a window count is len - size + 1, a short list yields no window; a zero size and a
# too-small flatten output are refused.
#
# Build first:  rye build pleac/lists.rye -femit-bin=tools/.build/pleac_lists
#   rishi/bin/rishi run tools/pleac_lists_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} rye/bin/rye build pleac/lists.rye -femit-bin=tools/.build/pleac_lists"]
assert build.ok else "pleac lists build failed"

let st = run ["tools/.build/pleac_lists" "selftest"]
assert st.ok else "pleac lists selftest exited non-zero"
assert (st.err contains "GREEN") else "pleac lists selftest not GREEN"
assert (st.err contains "chunk cuts a list") else "pleac lists missing the chunk claim"
assert (st.err contains "window yields every overlapping run") else "pleac lists missing the window claim"
assert (st.err contains "flatten(chunk(xs, n)) == xs") else "pleac lists missing the lossless-grouping claim"
assert (st.err contains "zero size is refused") else "pleac lists missing the bounded refusal"

say "GREEN: pleac lists — chunk, window, flatten: grouping lossless and bounded, zero-copy on the cut, witnessed."
