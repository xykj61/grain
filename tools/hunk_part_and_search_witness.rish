# tools/hunk_part_and_search_witness.rish — the faceted search box on glass (HUNK79).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK79.
# Design read: active-designing/date/20260814/20260814-000723_hunk-part-and-search-faceted-shelf-on-glass-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's faceted search-then-see — several checks shrink the wall (concept only,
# siloed).
#
# HUNK78 gave the marketplace a faceted conjunction (parse_and -> filter_and), yet in the image layer, unseen. HUNK77
# drew the single-clause search on glass. This rung joins them: brushstroke/part_and_search.rye `and_search_shelf`
# reads a catalog, a multi-clause typed line, and a page offset, and draws exactly the narrowed page (parse_and ->
# filter_and -> part_window). The selftest proves what a keeper types is what a keeper sees: material:stainless-304
# max:100 draws the one stainless part under a dollar (equal to the hand-filtered window), the clauses commute on
# glass, an empty line is a match-all, a match-none compound draws a real empty page, a bad offset refuses BadOffset,
# and a malformed clause surfaces the parser's named refusal rather than a wrong shelf. A price is a fact compared,
# never moved.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_part_and_search_witness.rish

say "hunk-part-and-search: Language EN — HUNK79 joins HUNK78's conjunction to the shelf: a multi-clause key:value line draws exactly the narrowed, paged marketplace."
say "hunk-part-and-search: Style Radiant — what a keeper types is what a keeper sees; the faceted search view invents nothing, the clauses commute, and a line that reads as nonsense draws nothing rather than the wrong parts."
say "hunk-part-and-search: Lens TAME — pure composition over HUNK78 parse_and/filter_and and HUNK73/74 shelf; a price clause compares, never moves; positive invariants per fn; a malformed clause and a bad offset each refuse by name; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/part_and_search"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/part_and_search.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-and-search: build failed — ${build.err}"

# Read the GREEN line from a file — it carries an apostrophe ("parser's") that breaks a shell single-quote round-trip.
let outfile = "brushstroke/bin/part_and_search.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "hunk-part-and-search: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "hunk-part-and-search: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN part-and-search' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "hunk-part-and-search: selftest did not print the GREEN part-and-search line"

# HUNK78 stays GREEN — the conjunction the search view drives is the one part_and proved.
let a = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_and.rye -femit-bin=image/bin/part_and && image/bin/part_and selftest > image/bin/part_and.out 2>&1"]
assert a.ok else "hunk-part-and-search: HUNK78 part_and re-run failed — see image/bin/part_and.out"
let a_green = run ["sh" "-c" "grep -q 'GREEN part-and' image/bin/part_and.out && echo yes"]
assert (trim a_green.out) == "yes" else "hunk-part-and-search: HUNK78 part_and did not stay GREEN"

# HUNK77 stays GREEN — the single-clause search this rung generalizes.
let s = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/part_search.rye -femit-bin=brushstroke/bin/part_search && brushstroke/bin/part_search selftest > brushstroke/bin/part_search.out 2>&1"]
assert s.ok else "hunk-part-and-search: HUNK77 part_search re-run failed — see brushstroke/bin/part_search.out"
let s_green = run ["sh" "-c" "grep -q 'GREEN part-search' brushstroke/bin/part_search.out && echo yes"]
assert (trim s_green.out) == "yes" else "hunk-part-and-search: HUNK77 part_search did not stay GREEN"

say "hunk-part-and-search: GREEN — a keeper narrows on several facets and the marketplace draws the intersection on glass; HUNK78 conjunction and HUNK77 single-clause search underneath stay GREEN. HUNK79 lands."
