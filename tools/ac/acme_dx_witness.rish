# acme_dx_witness.rish — the whole Acme developer arc, proven in one command.
#
# The Acme DX design season produced four contracts; the development season made each
# a live gate. This suite runs all four conformance witnesses together, so a single
# GREEN means a newcomer's whole arc holds — cold clone through operating a module:
#
#   onboarding   — tools/o/onboarding_path_witness.rish        (cold start + first green line)
#   first hour   — tools/f/first_hour_witness.rish             (build your own module, witness it)
#   interfaces   — tools/i/interfaces_conformance_witness.rish (the reference keeps the shape)
#   operations   — tools/o/operations_conformance_witness.rish (run·serve·persist·recover·observe)
#
#   rishi/bin/rishi run tools/ac/acme_dx_witness.rish

let onboard = run ["rishi/bin/rishi" "run" "tools/o/onboarding_path_witness.rish"]
assert onboard.ok else "acme-dx: onboarding-path witness failed"
assert (onboard.out contains "GREEN") else "acme-dx: onboarding path not GREEN"

let firsthour = run ["rishi/bin/rishi" "run" "tools/f/first_hour_witness.rish"]
assert firsthour.ok else "acme-dx: first-hour witness failed"
assert (firsthour.out contains "GREEN") else "acme-dx: first hour not GREEN"

let interfaces = run ["rishi/bin/rishi" "run" "tools/i/interfaces_conformance_witness.rish"]
assert interfaces.ok else "acme-dx: interfaces conformance witness failed"
assert (interfaces.out contains "GREEN") else "acme-dx: interfaces conformance not GREEN"

let operations = run ["rishi/bin/rishi" "run" "tools/o/operations_conformance_witness.rish"]
assert operations.ok else "acme-dx: operations conformance witness failed"
assert (operations.out contains "GREEN") else "acme-dx: operations conformance not GREEN"

say "GREEN: acme-dx — the whole developer arc holds end to end: onboarding, first hour, interfaces, operations, all witnessed in one command."
