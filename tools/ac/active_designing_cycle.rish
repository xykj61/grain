# tools/ac/active_designing_cycle.rish — u64 designing-cycle picker (select only).
#
#   rishi/bin/rishi run tools/ac/active_designing_cycle.rish
#   rishi/bin/rishi run tools/ac/active_designing_cycle.rish 42
#
# Never shreds. Mitra / Class O stay gated.

say "ad-cycle: Language EN — active-designing u64 cycle (select only)."
say "ad-cycle: Style Radiant — honest pick; no shred; Mitra gated."
say "ad-cycle: Lens TAME — bounds · one clock · witness before narrative."

let seed_arg = ""
if length args != 0 then let seed_arg = args[0]

say "ad-cycle: listing active-designing (excludes quin-workshop)..."
let pick = run ["bash" "tools/ac/active_designing_cycle_pick.sh" "${seed_arg}"]
assert pick.ok else "ad-cycle: pick failed"
assert pick.out contains "ad-cycle: count " else "ad-cycle: missing count"
assert pick.out contains "ad-cycle: index " else "ad-cycle: missing index"
assert pick.out contains "ad-cycle: path active-designing/" else "ad-cycle: missing path"

say pick.out
say "ad-cycle: verbs — accept · update · queue-for-shred · (Mitra shred GATED)"
say "GREEN: active-designing cycle — one honest pick; no file moved."
