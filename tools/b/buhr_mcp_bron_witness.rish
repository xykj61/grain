# tools/b/buhr_mcp_bron_witness.rish — BUHR Journey 3, Rung 1.
#
# MCP-in-Bron, the descriptor shape, proven on metal: the Model Context Protocol
# spoken in Bron rather than JSON. A call envelope (format mcp-call-v1) parses into
# a bounded request, routes to a real tool (add over integers, join over strings),
# and answers with a paired result envelope (format mcp-result-v1) that parses back
# deterministically -- the owned shape round-trips. An unknown tool, an unknown
# field, a wrong header, a missing tool, and a missing argument are each refused or
# named as an error rather than fabricated.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mcp_bron_witness.rish

say "buhr-j3r1: Language EN — the Model Context Protocol spoken in Bron, round-tripped."
say "buhr-j3r1: Lens TAME — bounded envelopes, value-model-honest, unknown fields refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-bron"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_bron.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j3r1: mcp_bron build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j3r1: mcp_bron selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j3r1: selftest did not speak GREEN"
assert selftest.out contains "add round-trips — call -> result 5 -> parsed back" else "buhr-j3r1: integer round-trip missing"
assert selftest.out contains "join composes string args — 'hello world'" else "buhr-j3r1: string value-model missing"
assert selftest.out contains "manifest reads — tool 'add', 2 args declared" else "buhr-j3r1: mcp-tool-v1 manifest reader missing"
assert selftest.out contains "unknown tool answered with error" else "buhr-j3r1: unknown-tool refusal missing"
assert selftest.out contains "unknown field refused" else "buhr-j3r1: unknown-field refusal missing (would silently drop)"
assert selftest.out contains "wrong format header refused" else "buhr-j3r1: format-header gate missing"
assert selftest.out contains "a call missing its tool is refused" else "buhr-j3r1: missing-field gate missing"
assert selftest.out contains "add missing an argument answered bad_args" else "buhr-j3r1: missing-arg error missing"

say "GREEN: BUHR-J3r1 — MCP-in-Bron descriptor shape fixed; call/result envelopes round-trip on the owned notation."
