# tools/b/buhr_mantra_browser_witness.rish -- BUHR Journey 2, Rung 1.
#
# The first Realidream-branded Pond app, proven on metal: a Mantra browser reads a
# BoltCatalog and renders its append-only log as a readable revision graph. The
# reading is genuine -- real peer/bolt grouping, real per-path lanes, real revision
# chains carrying real content digests -- composed over Mantra's public catalog API
# only. Journey 1 (Quin's voices) is untouched.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mantra_browser_witness.rish

say "buhr-j2: Language EN — Mantra's append-only log rendered as a readable graph."
say "buhr-j2: Lens TAME — bounded render, deterministic reading, undersized buffer refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mantra-browser"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_browser.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j2: mantra_browser build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j2: mantra_browser selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j2: selftest did not speak GREEN"
assert selftest.out contains "2 bolts, 3 lanes, a.txt chains r1 -> r2" else "buhr-j2: real grouping + chain missing"
assert selftest.out contains "dense chain r1 -> r2 -> r3 rendered on one lane" else "buhr-j2: dense revision chain missing"
assert selftest.out contains "empty log renders '(empty log)'" else "buhr-j2: empty-log view missing"
assert selftest.out contains "render is deterministic" else "buhr-j2: determinism proof missing"
assert selftest.out contains "undersized buffer refused" else "buhr-j2: buffer-bound refusal missing (would risk overrun)"

let show = run ["sh" "-c" "${bin} show 2>&1"]
assert show.ok else "buhr-j2: mantra_browser show exited non-zero"
assert show.out contains "mantra log — append-only graph" else "buhr-j2: graph header missing in rendered view"
assert show.out contains "local/notes" else "buhr-j2: bolt header missing in rendered view"

say "GREEN: BUHR-J2 — Mantra's append-only log rendered as a readable graph; the first Realidream app on witnessed ground."
