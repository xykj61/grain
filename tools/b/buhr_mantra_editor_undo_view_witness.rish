# tools/b/buhr_mantra_editor_undo_view_witness.rish -- BUHR Journey 4, Rung 5.
#
# Undo advances the living edge, yet the newest node shows the restored content -- the
# visible signature of append-only undo. Rung two painted a commit's advance; rung four
# made undo itself an append (revert recalls an earlier revision's bytes and commits
# them as the next revision). This rung carries undo onto the styled Skate surface: on
# the edited lane's row, after reverting r2 back to r1, the head-token edge sits further
# right than before (the edge advanced to r3), the row carries r3[, and the digest
# between r3's brackets equals the digest between r1's -- because Mantra derives each
# node's digest from its content and undo brought the r1 content back -- while r2's
# digest differs. The lit head covers the restored r3 node; every other lane paints
# unchanged.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mantra_editor_undo_view_witness.rish

say "buhr-j4r5: Language EN — undo advances the living edge, yet the newest node wears the reverted-to node's content fingerprint."
say "buhr-j4r5: Lens TAME — proven at the cell level; the edge moves right to r3 while r3's rendered digest equals r1's, r2's differs."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mantra-editor-undo-view"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_editor_undo_view.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j4r5: mantra_editor_undo_view build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j4r5: mantra_editor_undo_view selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j4r5: selftest did not speak GREEN"
assert selftest.out contains "the r3 head wears r1's digest — history grew, the content returned" else "buhr-j4r5: the advance-and-restore proof is missing"
assert selftest.out contains "lit only its own lane" else "buhr-j4r5: the lights-only-its-lane proof is missing"
assert selftest.out contains "the lit head covers the restored r3 node" else "buhr-j4r5: the head-over-restored-node proof is missing"

# Rung four (undo) and rung two (view) stay their own green binaries -- this is additive.
let undo = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_mantra_editor_undo_witness.rish 2>&1"]
assert undo.ok else "buhr-j4r5: the undo (rung four) witness regressed"
assert undo.out contains "GREEN: BUHR-J4r4" else "buhr-j4r5: the undo rung lost its green"

let view = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_mantra_editor_view_witness.rish 2>&1"]
assert view.ok else "buhr-j4r5: the view (rung two) witness regressed"
assert view.out contains "GREEN: BUHR-J4r2" else "buhr-j4r5: the view rung lost its green"

say "GREEN: BUHR-J4r5 — undo advances the living edge while the head wears the restored content; append-only undo, made visible."
