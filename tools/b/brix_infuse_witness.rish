# brix_infuse_witness.rish — Brix-infuse, deep merge/override for descriptors.
#
# SOON j2. Proves brix/infuse.rye: a flat-Bron per-key override where the override's
# value(s) replace the base's for a key, base-only keys pass through in place, and
# override-only keys append in override order; zero-copy; bounded; a scalar overridden,
# a base-only key kept, a repeated list replaced, an empty override identity, and a
# too-small output refused.
#
# Build first:  rye build brix/infuse.rye -femit-bin=tools/.build/brix_infuse
#   rishi/bin/rishi run tools/b/brix_infuse_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} rye/bin/rye build brix/infuse.rye -femit-bin=tools/.build/brix_infuse"]
assert build.ok else "brix infuse build failed"

let st = run ["tools/.build/brix_infuse" "selftest"]
assert st.ok else "brix infuse selftest exited non-zero"
assert (st.err contains "GREEN") else "brix infuse selftest not GREEN"
assert (st.err contains "per-key override") else "brix infuse missing the per-key override claim"
assert (st.err contains "zero-copy") else "brix infuse missing the zero-copy claim"
assert (st.err contains "too-small output is refused") else "brix infuse missing the bounded-output refusal"

say "GREEN: brix infuse — deep merge/override for Brix descriptors: per-key override over flat Bron, zero-copy, bounded, witnessed."
