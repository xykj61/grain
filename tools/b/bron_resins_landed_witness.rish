# bron_resins_landed_witness.rish -- a resin's bytes are the bytes that landed.
#
# TWO CLAIMS, in the order that makes the second worth believing. First the control proves the scan
# can RED -- planted behaviors on REAL git repositories in a throwaway pen, every refusal shown
# from the failing side and then lifted, three mutations asserted to bite. Then the scan reads the
# real cellar. A guard that cannot red guards nothing, so the order is not decoration.
#
# WHY IT EXISTS (`20260916.234020`). `bron-resins/manifest.bron` states the room's law in its own
# prose: *every resin in this room has exactly one commit in the tree's whole history, and its blob
# at that commit is byte-identical to its blob at HEAD -- checked one file at a time, all seventeen
# equal.* That reading was taken by hand on `20260910` and held by nothing afterwards, which is
# Gauge's fifth question about a figure -- what holds it still -- answered `free`.
#
# WHAT THE SEAL CANNOT SEE. `bron_resins_catalog_witness.rish` recomputes each resin's SHA3-256 and
# compares it to the `seal` line beside it, so a resin edited in place reds. Both halves of that
# comparison live in the working tree, so an edit landing WITH an updated seal is self-consistent
# and every gate in this room stays green. Git's history is the copy an edit cannot reach, and this
# guard is the reading that asks it.
#
# The tally assert below is the wall that hears a leg nobody quotes (REDS `%794`): the control
# counts its own behaviors and this witness holds the failure count at zero, so a leg written
# tomorrow is heard on the lap it lands rather than waiting for somebody to name it here.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/bron_resins_landed_witness.rish

let control = "tools/fixtures/b/bron_resins_landed_control.sh"
let scan = "tools/fixtures/b/bron_resins_landed_scan.sh"

say "bron-resins landed: the control, so a green reading below can be believed..."
let c = run ["sh" control]
assert c.ok else "bron_resins_landed: control FAILED -- the scan cannot be trusted to red"
assert c.out contains "verdict=ok" else "bron_resins_landed: control did not answer ok"
assert c.out contains "behaviors=42" else "bron_resins_landed: control ran a different number of behaviors"
assert c.out contains "failed=0" else "bron_resins_landed: control reported a failed behavior"
assert c.out contains "mutation newest_add landed" else "bron_resins_landed: the earliest-add mutation planted nothing"
assert c.out contains "mutation keep_catalog landed" else "bron_resins_landed: the catalog-exclusion mutation planted nothing"
assert c.out contains "mutation no_gate landed" else "bron_resins_landed: the gate mutation planted nothing"

say "bron-resins landed: the real cellar against its own history..."
let s = run ["sh" scan]
assert s.ok else "bron_resins_landed: a resin's bytes have parted from the bytes that landed"
assert s.out contains "verdict=ok" else "bron_resins_landed: scan did not answer ok"
assert s.out contains "moved=0" else "bron_resins_landed: a resin differs from its adding commit's blob"
assert s.out contains "readded=0" else "bron_resins_landed: a resin was deleted and restored"
assert s.out contains "commits_multi=0" else "bron_resins_landed: more than one commit has touched a resin"
assert s.out contains "uncommitted=0" else "bron_resins_landed: a resin stands in the room and in no commit"

say "GREEN: bron-resins landed -- every resin stands at the bytes its own commit put there."
