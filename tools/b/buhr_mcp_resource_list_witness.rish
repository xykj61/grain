# tools/b/buhr_mcp_resource_list_witness.rish — BUHR Journey 10, Rung 2: the MCP resource list.
#
# Rung one served resources/read — a caller who knows a URI reads its bytes. This rung serves
# resources/list — a caller discovers every readable artifact by URI, the noun half's mirror of
# Journey 3's tools/list. A Tablecloth catalog renders to a bounded format mcp-resource-list-v1
# envelope (one `resource <uri> <len>` line per artifact) and round-trips. The list is proven an
# honest index: for every listed resource, rung one's read_resource returns exactly the published
# length of verified bytes — and a store tampered after the list is published breaks that honesty
# (NotHonest) rather than passing silently. Composed over public API only; rung one and Tablecloth
# stay their own green binaries. Reads no network — the Comlink-served transport stays the gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mcp_resource_list_witness.rish

say "buhr10r2: Language EN — the Tablecloth catalog advertised as an MCP resource list; a caller discovers artifacts by URI."
say "buhr10r2: Lens TAME — the list is an honest index; every advertised URI truly reads at its published length, or it refuses."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-resource-list"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_resource_list.rye -femit-bin=${bin}"]
assert build.ok else "buhr10r2: mcp_resource_list build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr10r2: mcp_resource_list selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr10r2: selftest did not speak GREEN"
assert selftest.out contains "resources/list round-trips" else "buhr10r2: the list round-trip is missing"
assert selftest.out contains "every listed URI reads through resources/read at its published length" else "buhr10r2: the honest-index proof is missing"
assert selftest.out contains "a tampered store breaks the list's honesty" else "buhr10r2: the tamper-breaks-honesty proof is missing"
assert selftest.out contains "an unknown list field refused" else "buhr10r2: the unknown-field refusal is missing"
assert selftest.out contains "a wrong list format header refused" else "buhr10r2: the bad-format refusal is missing"

# Rung one (resources/read) and Tablecloth (J7r1, grown one additive accessor artifact_name)
# stay their own green binaries; this rung calls only their public API.
let r1_bin = "pond/bin/mcp-resource"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_resource.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr10r2: mcp_resource (J10r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr10r2: mcp_resource (J10r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr10r2: mcp_resource (J10r1) did not speak GREEN"

let tcl_bin = "pond/bin/tablecloth"
let tcl_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth.rye -femit-bin=${tcl_bin}"]
assert tcl_build.ok else "buhr10r2: tablecloth (J7r1) re-build failed"
let tcl_selftest = run ["sh" "-c" "${tcl_bin} selftest 2>&1"]
assert tcl_selftest.ok else "buhr10r2: tablecloth (J7r1) selftest exited non-zero"
assert tcl_selftest.out contains "GREEN" else "buhr10r2: tablecloth (J7r1) did not speak GREEN"

say "buhr10r2: GREEN — the catalog advertises every artifact as a resource URI, and every advertised URI honestly reads."
