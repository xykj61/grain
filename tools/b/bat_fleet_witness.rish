# bat_fleet_witness.rish — the baton archetype fleet, read and validated by Scribe.
#
# Proves two things: the reader validates every archetype shape and refuses a short
# one (its own selftest), and each bat/<name>.kyri exemplar carries its format, its
# archetype, and the copyright-discipline note (an original coinage; no named ship or
# company). Every exemplar holds fake data only.
#
# Build first (the vendored toolchain):
#   RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build scribe/reader.rye -femit-bin=scribe/bin/reader
#   rishi/bin/rishi run tools/b/bat_fleet_witness.rish

# 1. The reader validates every shape and refuses a short Galleon (its selftest).
let st = run ["scribe/bin/reader" "selftest"]
assert st.ok else "scribe reader selftest must exit 0"
assert (st.err contains "GREEN") else "reader selftest must report GREEN"
assert (st.err contains "bat fleet") else "the selftest must exercise the bat fleet"

# 2. Each exemplar declares its archetype and carries the copyright-discipline note.
let g = run ["grep" "-q" "archetype galleon" "bat/galleon.kyri"]
assert g.ok else "galleon exemplar must declare archetype galleon"
let gn = run ["grep" "-q" "original coinage; no named ship or company" "bat/galleon.kyri"]
assert gn.ok else "galleon exemplar must carry the copyright-discipline note"

let c = run ["grep" "-q" "archetype cutter" "bat/cutter.kyri"]
assert c.ok else "cutter exemplar must declare archetype cutter"
let cn = run ["grep" "-q" "original coinage; no named ship or company" "bat/cutter.kyri"]
assert cn.ok else "cutter exemplar must carry the copyright-discipline note"

let b = run ["grep" "-q" "archetype barque" "bat/barque.kyri"]
assert b.ok else "barque exemplar must declare archetype barque"
let bn = run ["grep" "-q" "original coinage; no named ship or company" "bat/barque.kyri"]
assert bn.ok else "barque exemplar must carry the copyright-discipline note"

let h = run ["grep" "-q" "archetype holdfast" "bat/holdfast.kyri"]
assert h.ok else "holdfast exemplar must declare archetype holdfast"
let hn = run ["grep" "-q" "original coinage; no named ship or company" "bat/holdfast.kyri"]
assert hn.ok else "holdfast exemplar must carry the copyright-discipline note"

let cs = run ["grep" "-q" "archetype corsair" "bat/corsair.kyri"]
assert cs.ok else "corsair exemplar must declare archetype corsair"
let csn = run ["grep" "-q" "original coinage; no named ship or company" "bat/corsair.kyri"]
assert csn.ok else "corsair exemplar must carry the copyright-discipline note"

let l = run ["grep" "-q" "archetype ledgerworks" "bat/ledgerworks.kyri"]
assert l.ok else "ledgerworks exemplar must declare archetype ledgerworks"
let ln = run ["grep" "-q" "original coinage; no named ship or company" "bat/ledgerworks.kyri"]
assert ln.ok else "ledgerworks exemplar must carry the copyright-discipline note"

say "GREEN: bat fleet witness — six baton archetypes, validated by the reader, each an original coinage."
