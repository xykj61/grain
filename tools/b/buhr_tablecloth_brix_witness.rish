# tools/b/buhr_tablecloth_brix_witness.rish — BUHR Journey 7, Rung 3: a Brix descriptor declares artifacts.
#
# Rungs one and two built the artifact store and proved a manifest is an honest index of a
# live store. This rung makes the Brix-facing half literal: a `format tablecloth-decl-v1`
# descriptor (one `require <name>` line per artifact a system needs) is evaluated against a
# live store into a `format tablecloth-v1` manifest of exactly those declared artifacts, in
# declared order. A required name the store cannot satisfy refuses the whole evaluation
# (Unsatisfied) rather than emitting a manifest naming bytes the store does not hold; the
# evaluated manifest then verifies against the store by rung two, closing the chain — a
# system declares what it needs, the store proves it serves it, the manifest is the receipt.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_tablecloth_brix_witness.rish

say "buhr7: Language EN — a Brix descriptor declares artifacts; the store proves it satisfies them."
say "buhr7: Lens TAME — evaluation is the join of declaration and store; an unsatisfiable requirement refuses whole."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/tablecloth-brix"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth_brix.rye -femit-bin=${bin}"]
assert build.ok else "buhr7: tablecloth_brix build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr7: tablecloth_brix selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr7: selftest did not speak GREEN"
assert selftest.out contains "a declaration of 2 artifacts evaluated to a manifest of 2, in declared order" else "buhr7: evaluation/order missing"
assert selftest.out contains "the evaluated manifest verified against the live store (2 artifacts)" else "buhr7: chain-to-verify missing"
assert selftest.out contains "an unsatisfiable requirement, a bad header, an empty descriptor each refused GREEN" else "buhr7: brix refusals missing"

# Rungs one and two — the naming layer the declaration evaluates over and the reader that
# verifies its output — stay their own green binaries; rung three composes them additively.
let r1_bin = "pond/bin/tablecloth"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr7: tablecloth (r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr7: tablecloth (r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr7: tablecloth (r1) did not speak GREEN"

let r2_bin = "pond/bin/tablecloth-index"
let r2_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth_index.rye -femit-bin=${r2_bin}"]
assert r2_build.ok else "buhr7: tablecloth_index (r2) re-build failed"
let r2_selftest = run ["sh" "-c" "${r2_bin} selftest 2>&1"]
assert r2_selftest.ok else "buhr7: tablecloth_index (r2) selftest exited non-zero"
assert r2_selftest.out contains "GREEN" else "buhr7: tablecloth_index (r2) did not speak GREEN"

say "buhr7: GREEN — a Brix descriptor declares artifacts, the store satisfies them, the manifest verifies; an unsatisfiable requirement refuses."
