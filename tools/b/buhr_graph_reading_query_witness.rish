# tools/b/buhr_graph_reading_query_witness.rish -- BUHR Journey 6, Rung 4: the reading voice folds the graph.
#
# Rungs one through three let the graph voice count the surface and gathered it under
# the host; this rung brings the reading voice to the same surface. Scribble folds a
# markdown render of the living graph (mantra_browser.render_markdown) -- the very bytes
# the browser shows -- so `outline` names the title and every bolt, `bolts` folds to the
# depth-two bolt headings, and a fork adds a new bolt to the fold (the reading tracks
# the living surface). A length budget truncates with a length stop; a disallowed
# model, an unknown op (no fake answer), and a zero budget each refuse. The browser and
# the counting voice stay their own green binaries.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_graph_reading_query_witness.rish

say "buhr6: Language EN — the reading voice folds a markdown render of the living graph."
say "buhr6: Lens TAME — one source (render_markdown); Scribble parses those exact bytes; faults surface, unknown op refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/graph-reading-query"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/graph_reading_query.rye -femit-bin=${bin}"]
assert build.ok else "buhr6: graph_reading_query build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr6: graph_reading_query selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr6: selftest did not speak GREEN"
assert selftest.out contains "outline folded the graph markdown — text 'mantra log local/notes local/site'" else "buhr6: outline fold missing"
assert selftest.out contains "bolts folded to the bolt headings — text 'local/notes local/site'" else "buhr6: bolts fold missing"
assert selftest.out contains "a new bolt appears in the fold — text 'local/notes local/site local/wiki'" else "buhr6: fork not tracked by the reading"
assert selftest.out contains "length budget — tokens 2 length" else "buhr6: metering/length stop missing"
assert selftest.out contains "model not allowed refused" else "buhr6: model allow-list gate missing"
assert selftest.out contains "unknown op refused (no fake answer)" else "buhr6: no-fake-answer refusal missing"
assert selftest.out contains "zero budget refused by Lantern contract" else "buhr6: Lantern budget gate missing"

# The browser whose markdown render the fold reads stays its own green binary -- the
# render_markdown door was added additively beside render.
let browser_bin = "pond/bin/mantra-browser"
let browser_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_browser.rye -femit-bin=${browser_bin}"]
assert browser_build.ok else "buhr6: mantra_browser re-build failed"
let browser_selftest = run ["sh" "-c" "${browser_bin} selftest 2>&1"]
assert browser_selftest.ok else "buhr6: mantra_browser selftest regressed"
assert browser_selftest.out contains "GREEN" else "buhr6: mantra_browser did not speak GREEN"
assert browser_selftest.out contains "markdown outline rendered" else "buhr6: render_markdown selftest missing from the browser"

say "GREEN: BUHR6r4 — the reading voice folds the living graph's markdown; the fold reads the bytes the browser shows."
