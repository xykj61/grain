# tools/b/buhr_mantra_editor_view_witness.rish — BUHR Journey 4, Rung 2.
#
# An edit moves the living edge forward, visibly. Rung one proved an edit is an append
# the browser graph already knows how to show; this rung carries that growth onto the
# styled Skate surface. Rung three (Journey 2) lit each lane's head — the newest node —
# in the design system's head token; an edit adds a newer node, so the living edge on
# the edited lane advances to it. The proof is at the grid-cell level, deterministic:
# on the edited lane's row the head-token cells sit further to the right after the edit
# than before (r1 to the appended r2), the lit head covers the new node's span, and
# every other lane's row paints byte-for-byte unchanged.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mantra_editor_view_witness.rish

say "buhr-j4r2: Language EN — after a commit, the styled paint lights the appended revision as each lane's living edge."
say "buhr-j4r2: Lens TAME — proven at the grid-cell level; the head token advances from r1 to r2, other lanes unchanged, the paint tracks the append-only head."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mantra-editor-view"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mantra_editor_view.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j4r2: mantra_editor_view build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j4r2: mantra_editor_view selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j4r2: selftest did not speak GREEN"
assert selftest.out contains "the living edge moved from col" else "buhr-j4r2: the living-edge-advances proof is missing"
assert selftest.out contains "the new node is lit" else "buhr-j4r2: the new-node-is-the-head proof is missing"
assert selftest.out contains "the edit lit only its own lane" else "buhr-j4r2: the only-its-lane proof is missing"
assert selftest.out contains "the paint tracks the append-only head" else "buhr-j4r2: the second-edit-advances proof is missing"

# Rung one (editor) and rung three (heads) stay their own green binaries.
let editor = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_mantra_editor_witness.rish 2>&1"]
assert editor.ok else "buhr-j4r2: the editor (rung one) witness regressed"
assert editor.out contains "GREEN: BUHR-J4r1" else "buhr-j4r2: the editor lost its green"

let heads = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_mantra_browser_heads_witness.rish 2>&1"]
assert heads.ok else "buhr-j4r2: the heads (rung three) witness regressed"
assert heads.out contains "GREEN: BUHR-J2r3" else "buhr-j4r2: the heads paint lost its green"

say "GREEN: BUHR-J4r2 — an edit advances each lane's living edge on the styled surface; editor and view track one append-only head."
