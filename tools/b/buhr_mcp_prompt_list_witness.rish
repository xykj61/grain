# tools/b/buhr_mcp_prompt_list_witness.rish -- BUHR Journey 11, Rung 2: the MCP prompt list.
#
# Rung one served prompts/get -- a caller who knows a prompt names it and fills it. This rung
# serves prompts/list -- a caller discovers every prompt a server offers, and its arity, the
# template half's mirror of Journey 3's tools/list (J9) and Journey 10's resources/list. A
# bounded prompt book renders to a format mcp-prompt-list-v1 envelope (one `prompt <name> <argc>`
# line per template) and round-trips. The list is proven an honest index: every listed prompt
# names a descriptor the book truly holds, at exactly its advertised arity -- and a list whose
# arity disagrees, or names a prompt the book lacks, breaks that honesty (NotHonest) rather than
# passing silently. Composed over rung one's public API only; rung one stays its own green
# binary. Reads no network -- the Comlink-served transport stays the gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mcp_prompt_list_witness.rish

say "buhr11r2: Language EN — a server's prompt book advertised as an MCP prompt list; a caller discovers every template by name and arity."
say "buhr11r2: Lens TAME — the list is an honest index; every advertised prompt is truly held at its promised arity, or it refuses."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-prompt-list"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_prompt_list.rye -femit-bin=${bin}"]
assert build.ok else "buhr11r2: mcp_prompt_list build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr11r2: mcp_prompt_list selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr11r2: selftest did not speak GREEN"
assert selftest.out contains "prompts/list round-trips" else "buhr11r2: the list round-trip is missing"
assert selftest.out contains "every listed prompt is held, at exactly its advertised arity" else "buhr11r2: the honest-index proof is missing"
assert selftest.out contains "an arity that disagrees with the book breaks honesty" else "buhr11r2: the wrong-arity honesty check is missing"
assert selftest.out contains "a name the book does not hold breaks honesty" else "buhr11r2: the absent-prompt honesty check is missing"
assert selftest.out contains "an unknown list field refused" else "buhr11r2: the unknown-field refusal is missing"
assert selftest.out contains "a wrong list format header refused" else "buhr11r2: the bad-format refusal is missing"

# Rung one (prompts/get) stays its own green binary; this rung calls only its public API.
let r1_bin = "pond/bin/mcp-prompt"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_prompt.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr11r2: mcp_prompt (J11r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr11r2: mcp_prompt (J11r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr11r2: mcp_prompt (J11r1) did not speak GREEN"

say "buhr11r2: GREEN — the prompt book advertises every template by name and arity, and every advertised prompt is honestly held."
