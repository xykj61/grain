# brix_alias_resolve.rish — Brix typo resolution: alias from → to.
#
# First seat: Prim → Prin. Run from the repository root:
#   rishi/bin/rishi run tools/b/brix_alias_resolve.rish

let alias_line = run ["sh" "-c" "grep -E '^alias Prim Prin$' .brix"]
assert alias_line.ok else ".brix must carry alias Prim Prin"

let lexicon = run ["sh" "-c" "grep -F '| **Prim** | **Typo alias' context/LEXICON.md"]
assert lexicon.ok else "LEXICON Prim must be a typo alias redirect to Prin"

let prin = run ["sh" "-c" "grep -F '| **Prin** |' context/LEXICON.md"]
assert prin.ok else "LEXICON must seat Prin as the living word"

# Resolve: reading Prim through Brix alias yields Prin (shell fold of the table)
let resolved = run ["sh" "-c" "awk '/^alias Prim / { print $3; exit }' .brix"]
assert resolved.ok else "alias lookup failed"
assert trim resolved.out == "Prin" else "Prim must resolve to Prin"

say "GREEN: brix alias resolve — Prim → Prin."
