# tools/b/buhr_realidream_view_theme_witness.rish -- BUHR Journey 5, Rung 6.
#
# A .brush theme recolors the read origin. Rung five painted the read, program, and
# fused lanes together and marked each read origin in the design system's own read
# token (Madder), seated in tokens.base_sheet. This rung closes the authoring loop that
# token was named for: a real .brush file (pond/apps/read-source.brush) whose style:
# block overrides the read key is read through the actual authoring loop (parse_brush
# validates, collect_brush_style reassembles the flat Bron), infused over base_sheet by
# the WADE1 cascade (tokens.resolve), and painted by rung five's own paint_origins
# unchanged -- so every read origin burns the authored amber while the ink, edge rule,
# and living-edge head stand untouched. The recolor is proven two ways: the themed read
# reaches the canvas (391 amber pixels) and the default Madder leaves zero pixels (a
# recolor, never an addition); warm/low-blue holds through the theme; glyphs unchanged;
# a style-less .brush refuses ThemeMissingRead.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_realidream_view_theme_witness.rish

say "buhr-j5r6: Language EN — a .brush theme recolors the read origin on its own key; ground, ink, and living-edge head inherit unchanged."
say "buhr-j5r6: Lens TAME — proven on metal; the authored amber reaches the canvas, the default Madder leaves zero pixels (a recolor), the palette law holds through the theme. No network read."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/realidream-view-theme"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/realidream_view_theme.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j5r6: realidream_view_theme build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j5r6: realidream_view_theme selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j5r6: selftest did not speak GREEN"
assert selftest.out contains "themed-read pixels on the canvas" else "buhr-j5r6: the recolor proof is missing"
assert selftest.out contains "0 default-read pixels (recolored)" else "buhr-j5r6: the recolor-not-addition proof is missing"
assert selftest.out contains "the palette law holds through the theme" else "buhr-j5r6: the warm/low-blue proof is missing"
assert selftest.out contains "text unchanged by the theme" else "buhr-j5r6: the additive-glyphs proof is missing"
assert selftest.out contains "ThemeMissingRead" else "buhr-j5r6: the style-less refuse proof is missing"

# Rung 5 (the origins view) stays its own green binary -- additive.
let rung5 = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_realidream_view_witness.rish 2>&1"]
assert rung5.ok else "buhr-j5r6: the origins view (J5r5) witness regressed"
assert rung5.out contains "GREEN: BUHR-J5r5" else "buhr-j5r6: rung five lost its green"

say "GREEN: BUHR-J5r6 — a .brush theme recolors the read origin on its own key; the authored amber burns on every read lane, the default Madder gone, ground and head untouched."
