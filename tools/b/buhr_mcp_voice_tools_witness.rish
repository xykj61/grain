# tools/b/buhr_mcp_voice_tools_witness.rish -- BUHR Journey 9, Rung 2: the voices as distinct MCP tools.
#
# Rung one made the whole intelligence reachable as one MCP tool (ask). This rung gives
# each voice its own name at the protocol surface: a caller discovers five typed tools
# (lattice, scribble, ember, graph, artifact) through Journey 3's own tools/list envelope,
# and invokes one by name. The tool name is a typed assertion -- serve_voice dispatches the
# prompt through the gathered host and cross-checks that the voice which actually served
# equals the voice the tool named, refusing wrong_voice when a prompt routes elsewhere. So
# the protocol surface can never claim a voice answered that did not. Discovery reuses
# mcp_list (J3r4); invocation reuses mcp_voice (J9r1). Every module stays its own green
# binary; it reads no network (the real fetch and Comlink-served transport stay the gates).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_mcp_voice_tools_witness.rish

say "buhr9r2: Language EN — five voices, each a named MCP tool, discovered by tools/list and invoked by name."
say "buhr9r2: Lens TAME — the tool name is a typed assertion; a prompt off the named voice refuses wrong_voice."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/mcp-voice-tools"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_voice_tools.rye -femit-bin=${bin}"]
assert build.ok else "buhr9r2: mcp_voice_tools build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr9r2: mcp_voice_tools selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr9r2: selftest did not speak GREEN"
assert selftest.out contains "tools/list advertises 5 voice tools" else "buhr9r2: discovery envelope missing"
assert selftest.out contains "the lattice tool served the Lattice voice" else "buhr9r2: named-tool routing missing"
assert selftest.out contains "the artifact tool served the artifact voice" else "buhr9r2: artifact tool routing missing"
assert selftest.out contains "routing off the named tool -> named MCP error 'wrong_voice'" else "buhr9r2: the wrong_voice cross-check missing"
assert selftest.out contains "an unlisted tool -> named MCP error 'unknown_tool'" else "buhr9r2: unknown-tool refusal missing"
assert selftest.out contains "disallowed model on a voice tool -> named MCP error 'model_not_allowed'" else "buhr9r2: model refusal missing"

# Rung one (the single ask tool) and Journey 3's tools/list envelope -- the two halves this
# rung composes -- stay their own green binaries; this rung calls only their public API.
let r1_bin = "pond/bin/mcp-voice"
let r1_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_voice.rye -femit-bin=${r1_bin}"]
assert r1_build.ok else "buhr9r2: mcp_voice (J9r1) re-build failed"
let r1_selftest = run ["sh" "-c" "${r1_bin} selftest 2>&1"]
assert r1_selftest.ok else "buhr9r2: mcp_voice (J9r1) selftest exited non-zero"
assert r1_selftest.out contains "GREEN" else "buhr9r2: mcp_voice (J9r1) did not speak GREEN"

let list_bin = "pond/bin/mcp-list"
let list_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/mcp_list.rye -femit-bin=${list_bin}"]
assert list_build.ok else "buhr9r2: mcp_list (J3r4) re-build failed"
let list_selftest = run ["sh" "-c" "${list_bin} selftest 2>&1"]
assert list_selftest.ok else "buhr9r2: mcp_list (J3r4) selftest exited non-zero"
assert list_selftest.out contains "GREEN" else "buhr9r2: mcp_list (J3r4) did not speak GREEN"

say "buhr9r2: GREEN — five voices discoverable and addressable by name; the named tool must be the voice that answers, or it refuses."
