# tools/b/buhr_realidream_reread_witness.rish -- BUHR Journey 5, Rung 2.
#
# A re-read is an append, exactly as an edit is. Rung 1 fused a read lane and a program
# lane on one graph; this rung carries the graph's own law across the read/write seam:
# when the outside source is read again, the newer content is not an overwrite of the old
# -- it is one more revision appended to the read lane's chain, exactly as a program edit
# appends. refresh_read continues an existing read/ lane, so the read half inherits
# accrete-never-break by the same construction the editor did. The proof: pin a read lane
# at r1 and refresh it, and the read lane chains r1 -> r2 while every program lane stands
# byte-for-byte unchanged; the earlier read revision still recalls its original bytes
# after the refresh (the old read stands, never rewritten); a non-read path refuses
# NotAReadPath, an unpinned read lane refuses LaneUnknown. This rung reads no network --
# the refreshed content is supplied in-process; a real web fetch stays a named seam behind
# a bounded reader (its own later rung, surfacing for Keaton's word).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/b/buhr_realidream_reread_witness.rish

say "buhr-j5r2: Language EN — a re-read of an outside source is an append, exactly as a program edit is; the newer read chains after the old, never over it."
say "buhr-j5r2: Lens TAME — proven by the render and by recall; the read lane grows r1 -> r2 while every program lane stands unchanged, and r1 still recalls its bytes. No network read."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/realidream-reread"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/realidream_reread.rye -femit-bin=${bin}"]
assert build.ok else "buhr-j5r2: realidream_reread build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "buhr-j5r2: realidream_reread selftest exited non-zero"
assert selftest.out contains "GREEN" else "buhr-j5r2: selftest did not speak GREEN"
assert selftest.out contains "the read lane grew r1 -> r2, every program lane unchanged" else "buhr-j5r2: the re-read-grows-read-lane proof is missing"
assert selftest.out contains "the old read stands" else "buhr-j5r2: the earlier-read-still-stands proof is missing"
assert selftest.out contains "refuses NotAReadPath" else "buhr-j5r2: the non-read-path refuse proof is missing"

# Rung 1 (read fusion) and Journey 4 (editor) stay their own green binaries -- additive.
let rung1 = run ["sh" "-c" "rishi/bin/rishi run tools/b/buhr_realidream_reader_witness.rish 2>&1"]
assert rung1.ok else "buhr-j5r2: the read-fusion (J5r1) witness regressed"
assert rung1.out contains "GREEN: BUHR-J5r1" else "buhr-j5r2: rung one lost its green"

say "GREEN: BUHR-J5r2 — a re-read appends a new revision to the read lane; the newer read chains after the old, and every program lane stands unchanged."
