# tools/g/gism_j5_corpus_set_witness.rish -- GISM Journey 5 (Real corpora), Rung 3.
#
# Season 2, Yield: the reading voice stands on a real corpus SET, not one lucky file.
# Five real front-door / discipline documents (TAME_CORE, TWO_ROOMS, CODE_OF_CONDUCT,
# SECURITY, CHANGELOG) are embedded at compile time; each member's outline reads GREEN
# through the same Lantern-contracted Scribble path rung one ran over a single file,
# and every Scribble bound is proven against the largest real member of the set.
#
# The witness cross-checks the app's reported largest-by-bytes member against an
# independent `wc -c` over the same real files -- two tools, one answer -- so the crux
# is bound to the tree, not to a literal. The demo reading over pinned_doc
# (reading_query) is re-run untouched; the corpus_set reader stands beside it.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_j5_corpus_set_witness.rish

say "gism-j5r3: Language EN — the reading voice reads a real corpus set, the tree's own writing as a body."
say "gism-j5r3: Lens TAME — real bytes, every Scribble bound proven against the largest real member."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/corpus-set"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/corpus_set.rye -femit-bin=${bin}"]
assert build.ok else "gism-j5r3: corpus_set build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j5r3: corpus_set selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j5r3: selftest did not speak GREEN"
assert selftest.out contains "context/TAME_CORE.md — outline 'TAME Core" else "gism-j5r3: TAME_CORE member reading missing"
assert selftest.out contains "context/TWO_ROOMS.md — outline 'Two Rooms" else "gism-j5r3: TWO_ROOMS member reading missing"
assert selftest.out contains "CODE_OF_CONDUCT.md — outline 'Code of Conduct" else "gism-j5r3: CODE_OF_CONDUCT member reading missing"
assert selftest.out contains "SECURITY.md — outline 'Security" else "gism-j5r3: SECURITY member reading missing"
assert selftest.out contains "CHANGELOG.md — outline 'Changelog" else "gism-j5r3: CHANGELOG member reading missing"
assert selftest.out contains "bounds hold — largest by bytes" else "gism-j5r3: bounds-against-largest crux missing"
assert selftest.out contains "model not allowed refused" else "gism-j5r3: allow-list gate missing"
assert selftest.out contains "unknown op refused" else "gism-j5r3: unknown-op refusal missing (would be a fake answer)"

# Independent cross-check: the largest member by bytes, measured directly with `wc -c`
# over the same real files, must match the path and size the app reports. Two tools,
# one answer -- the crux bound to the tree, not to a literal. (sed backrefs, never awk
# positional vars, so Rishi's ${} interpolation is not tripped.)
# The app prints a machine line 'largest_wc <bytes> <path>' in wc -c's own native
# order; an independent wc -c over the same real files reduces to the identical
# '<bytes> <path>'. Two tools, one answer -- the crux bound to the tree, not a literal.
# (No sed backrefs and no shell vars -- Rishi keeps '\\' literal and interpolates $name.)
let wc_largest = run ["sh" "-c" "wc -c context/TAME_CORE.md context/TWO_ROOMS.md CODE_OF_CONDUCT.md SECURITY.md CHANGELOG.md | grep -vE ' total' | sort -n | tail -1 | sed -E 's/^ *//'"]
assert wc_largest.ok else "gism-j5r3: wc -c largest-member cross-check failed to run"
let app_largest = run ["sh" "-c" "${bin} selftest 2>&1 | grep -oE 'largest_wc [0-9]+ [^ ]+' | sed 's/largest_wc //'"]
assert app_largest.ok else "gism-j5r3: could not extract the app's largest bytes+path line"
assert app_largest.out == wc_largest.out else "gism-j5r3: app's largest-by-bytes member disagrees with wc -c over the real files"

# The demo reading over pinned_doc must still be GREEN -- corpus_set is additive.
let demo_bin = "pond/bin/reading-query"
let demo_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/reading_query.rye -femit-bin=${demo_bin}"]
assert demo_build.ok else "gism-j5r3: reading_query (demo) rebuild failed"
let demo_selftest = run ["sh" "-c" "${demo_bin} selftest 2>&1"]
assert demo_selftest.ok else "gism-j5r3: reading_query (demo) selftest regressed"
assert demo_selftest.out contains "GREEN" else "gism-j5r3: reading_query (demo) did not speak GREEN"

say "GREEN: GISM-J5r3 — the reading voice reads a real corpus set; bounds hold against the largest member; the demo reading stays GREEN."
