# tools/g/gism_j6_provenance_chain_witness.rish — GISM Journey 6 (Provenance), Rung 3.
#
# Season 2, Yield: custody is a verifiable chain, not a single stamp. This witness proves
# a real tree document (a compile-time embed of a living waymark green-claim, symlinked)
# is handed planet -> star -> galaxy, each transfer signed by the current holder, and the
# whole chain re-verifies from cold against the settled constellation — resolving the head
# holder. Every tamper refuses: a non-holder transfer (NotHolder, nothing appended), a
# forged link, a swapped artifact digest, and a wrong presented holder Deed (each
# BadTransfer). Demo keeper seeds only; no custody crosses.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_j6_provenance_chain_witness.rish

say "gism-j6r3: Language EN — custody is a verifiable line of signed handoffs over a real artifact."
say "gism-j6r3: Lens TAME — the chain is grounded in the settled ledger; every tamper refuses."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/provenance-chain"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/provenance_chain.rye -femit-bin=${bin}"]
assert build.ok else "gism-j6r3: provenance_chain build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j6r3: provenance_chain selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j6r3: selftest did not speak GREEN"
assert selftest.out contains "real artifact handed 267 -> 27 -> 3, chain verified, head 3" else "gism-j6r3: full chain / head resolution missing"
assert selftest.out contains "non-holder transfer refused (NotHolder), nothing appended" else "gism-j6r3: non-holder refusal missing"
assert selftest.out contains "forged link refused on re-verification (BadTransfer)" else "gism-j6r3: forged-link refusal missing"
assert selftest.out contains "swapped artifact digest refused (BadTransfer)" else "gism-j6r3: swapped-digest refusal missing"
assert selftest.out contains "wrong presented holder refused (BadTransfer)" else "gism-j6r3: wrong-holder refusal missing"

# The owner-signed catalog the chain composes over (BUHR-J7r4) must still be GREEN —
# provenance_chain reuses its digest/verify primitives, retiring nothing.
let keyed_bin = "pond/bin/tablecloth-keyed"
let keyed = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/tablecloth_keyed.rye -femit-bin=${keyed_bin} && ${keyed_bin} selftest 2>&1"]
assert keyed.ok else "gism-j6r3: tablecloth_keyed regressed"
assert keyed.out contains "GREEN" else "gism-j6r3: tablecloth_keyed did not speak GREEN"

say "GREEN: GISM-J6r3 — a real artifact's custody is a verifiable line of signed handoffs grounded in the settled ledger; every tamper refuses."
