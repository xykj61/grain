# glow_repl_witness.rish -- Rishi glow mode SLC stub GREEN.
#
# Drives stdin: one accept per seated single-line head family, one refusal, :quit.
# Builds a sibling binary so the running rishi witness is never FileBusy.
# Glow mode uses std.debug.print → stderr; claims read session.err.
#
#   rishi/bin/rishi run tools/g/glow_repl_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "rishi/bin/rishi-glow-wit"
let build = run ["env" "RYE_ZIG=${zig}" "rye/bin/rye" "build" "rishi/src/main.rye" "-femit-bin=${bin}"]
if build.ok == false then say "rishi-glow-wit rebuild stdout:"
if build.ok == false then say build.out
if build.ok == false then say "rishi-glow-wit rebuild stderr:"
if build.ok == false then say build.err
assert build.ok else "rishi-glow-wit rebuild failed"

let session = run ["sh" "-c" "env RYE_ZIG=${zig} ${bin} glow < tools/fixtures/glow_repl_stdin.txt"]
assert session.ok else "glow repl session exited non-zero"
let text = "${session.out}${session.err}"
assert text contains "glow -- sixteen single-line heads" else "missing warm greeting"
assert text contains "glow: refuse -- not a seated single-line head" else "missing named refusal"
assert text contains "glow: session closed." else "missing clean quit"
let refuse_lines = where (lines text) as ln: ln contains "glow: refuse -- not a seated single-line head"
assert (length refuse_lines) == 1 else "expected exactly one head-family refusal"
assert text contains "glow: ok" else "missing accept path (glow: ok)"

say "GREEN: Rishi glow mode SLC -- sixteen heads, one refusal, :quit."
