# tools/g/gism_spool_witness.rish -- GISM red %73: the spool (chunking storage).
#
# Season 2, Yield: every module stands on real bytes. GISM Journey 6 booked red %73 --
# a real front-door document (SECURITY.md 2689 B; context/TWO_ROOMS.md 6079 B) refuses
# ContentTooLarge because it does not fit one 512-byte resin, and the fix is not a
# bound-bump (max_resin_bytes is structurally capped) but a storage layer above beading.
# This witness proves the spool closes that red on metal: a real document winds across
# ordered resins and unwinds byte-for-byte, the honest 32 KB ceiling is reachable in
# full, and every tamper (a flipped bead, a corrupted resin index, a truncated spool)
# refuses the whole reassembly. It also re-runs beading untouched -- the store's bead
# capacity rose 64 -> 256 additively, so beading stays its own GREEN binary.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_spool_witness.rish

say "gism-red73: Language EN — a large real document winds across ordered resins and recalls whole."
say "gism-red73: Lens TAME — bounded resins, content-addressed, every tamper refused; beading stays GREEN."

let zig = "vendor/zig-toolchain/zig"
let bin = "mantra/bin/spool"

let build = run ["sh" "-c" "mkdir -p mantra/bin && env RYE_ZIG=${zig} rye/bin/rye build mantra/spool.rye -femit-bin=${bin}"]
assert build.ok else "gism-red73: spool build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-red73: spool selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-red73: selftest did not speak GREEN"
assert selftest.out contains "security.md — 2689 B across 6 resins" else "gism-red73: security.md spool missing"
assert selftest.out contains "two_rooms.md — 6079 B across 12 resins" else "gism-red73: two_rooms.md spool missing"
assert selftest.out contains "ceiling — 32768 B across 64 resins (128 beads) wound and unwound whole" else "gism-red73: honest ceiling not reached"
assert selftest.out contains "same bytes wound twice share one content address" else "gism-red73: stable name missing"
assert selftest.out contains "dedup dividend" else "gism-red73: dedup dividend missing"
assert selftest.out contains "tampered bead, tampered resin index, truncated spool refused whole GREEN" else "gism-red73: tamper refusals missing"
assert selftest.out contains "refused ContentTooLarge (the honest ceiling)" else "gism-red73: over-ceiling refusal missing"

# Cross-check the real document sizes the spool wound against the files on disk -- two
# tools, one answer (the honest-adversary discipline Yield lives by).
let sec_bytes = run ["sh" "-c" "wc -c < SECURITY.md | tr -d ' '"]
assert sec_bytes.ok else "gism-red73: could not measure SECURITY.md"
assert sec_bytes.out contains "2689" else "gism-red73: SECURITY.md is not 2689 B on disk"
let tr_bytes = run ["sh" "-c" "wc -c < context/TWO_ROOMS.md | tr -d ' '"]
assert tr_bytes.ok else "gism-red73: could not measure context/TWO_ROOMS.md"
assert tr_bytes.out contains "6079" else "gism-red73: context/TWO_ROOMS.md is not 6079 B on disk"

# Beading is re-run untouched -- the store capacity rose additively; the primitive the
# spool stands on stays its own GREEN binary.
let beading_bin = "mantra/bin/beading"
let beading_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build mantra/beading.rye -femit-bin=${beading_bin}"]
assert beading_build.ok else "gism-red73: beading rebuild failed"
let beading_selftest = run ["sh" "-c" "${beading_bin} selftest 2>&1"]
assert beading_selftest.ok else "gism-red73: beading selftest regressed"
assert beading_selftest.out contains "GREEN" else "gism-red73: beading did not speak GREEN"

say "GREEN: GISM red %73 — the spool winds large real documents across ordered resins and recalls the same bytes; beading stays GREEN."
