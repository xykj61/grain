# tools/g/gism_ayre_j8_entity_books_period_witness.rish -- Season 2 Journey 8 (Cash-first), Rung 3.
#
# Season 2, Yield -- the accounting spine, never braided. Rungs one and two booked a segregated
# inter-entity transfer and proved it one both stewards signed. pond/apps/entity_books_period.rye
# makes a closed period travel: an entity's period folds to a sealed statement (name, close stamp,
# trial-balance nets) that renders to a `format entity-period-v1` Bron record and parses back
# preserving every field, and the recovered period still conserves and still balances (its
# reconstructed trial balance sums to zero, its balance sheet balances). An unknown field
# (UnknownField, never dropped), a missing account net (MissingField), a wrong header (BadFormat),
# and unbalanced nets (Unbalanced) each refuse. Composes rung one's fold and dimeroll_core; reads
# no network (serve transport = Comlink-served gate). Facts only; demo entities only (gate %3
# untouched).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_ayre_j8_entity_books_period_witness.rish

say "gism-ayre-j8r3: Language EN — a closed period travels as Bron and returns still conserving and balancing, checkable offline."
say "gism-ayre-j8r3: Lens TAME — the round trip preserves every field; a missing net, an unknown field, a wrong header, and unbalanced nets refuse."

let zig = "vendor/zig-toolchain/zig"

# Rung one stays GREEN beneath the travel layer -- additive.
let bin1 = "pond/bin/entity-books"
let build1 = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/entity_books.rye -femit-bin=${bin1}"]
assert build1.ok else "gism-ayre-j8r3: rung-one entity_books build failed"
let self1 = run ["sh" "-c" "${bin1} selftest 2>&1"]
assert self1.ok else "gism-ayre-j8r3: rung-one selftest exited non-zero"
assert self1.out contains "GREEN" else "gism-ayre-j8r3: rung-one did not speak GREEN"

let bin = "pond/bin/entity-books-period"
let build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/entity_books_period.rye -femit-bin=${bin}"]
assert build.ok else "gism-ayre-j8r3: entity_books_period build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-ayre-j8r3: entity_books_period selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-ayre-j8r3: selftest did not speak GREEN"
assert selftest.out contains "preserving every field and still conserves and balances" else "gism-ayre-j8r3: round-trip preservation missing"
assert selftest.out contains "refused UnknownField (never dropped)" else "gism-ayre-j8r3: unknown-field refusal missing"
assert selftest.out contains "refused MissingField" else "gism-ayre-j8r3: missing-field refusal missing"
assert selftest.out contains "unbalanced nets refused Unbalanced" else "gism-ayre-j8r3: unbalanced refusal missing"

say "GREEN: GISM-AYRE-J8r3 entity_books_period — a closed period travels as Bron and returns still conserving and balancing; missing, unknown, malformed, and unbalanced records refuse."
