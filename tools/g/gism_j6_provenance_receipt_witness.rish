# tools/g/gism_j6_provenance_receipt_witness.rish -- GISM Journey 6 (Provenance), Rung 2.
#
# Chapter 2, Yield: provenance that outlives the store it was born in. Rung one bound a
# real tree document to a settled identity inside the owner-signed catalog; this witness
# proves the signed word travels *out of the store* as a portable receipt for the same
# real bytes, and returns whole. The receipt for the real document (a compile-time embed
# of a living waymark green-claim, symlinked) verifies offline, renders to Bron, parses
# back byte-for-byte, still verifies, and its held real content matches the bound digest.
#
# The crux cross-check: the length and SHA-256 the receipt signs equal an independent wc -c
# and sha256sum of the same real file -- two tools, one answer -- so the signed provenance can
# never drift from what a keeper computes by hand. Both readings are READ from disk and
# interpolated into the assertion, never spelled: a hand-typed fact is a copy the document is
# free to change without, and this family has paid for that twice (REDS %341, %357). Every
# tamper refuses (real byte flip, wrong keeper, unknown record field). The TACT-J2 demo receipt
# binaries are re-run untouched -- this app is additive, composed over their public API.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_j6_provenance_receipt_witness.rish

say "gism-j6r2: Language EN — a real publication's receipt travels offline and returns whole."
say "gism-j6r2: Lens TAME — the signed digest cross-checks against sha256sum; the demo receipts still GREEN."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/provenance-receipt"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/provenance_receipt.rye -femit-bin=${bin}"]
assert build.ok else "gism-j6r2: provenance_receipt build failed"

# The crux cross-check, measured before it is compared: the receipt's own signed length and
# digest must equal an independent reading of the real file.
let real = "waymarks/date/20260801/20260801-134653_e182-q46-errors-named-green.md"
let wc = run ["sh" "-c" "wc -c < ${real} | tr -d ' \n'"]
assert wc.ok else "gism-j6r2: wc -c over the real file failed"
let sha = run ["sh" "-c" "sha256sum ${real} | cut -d' ' -f1 | tr -d ' \n'"]
assert sha.ok else "gism-j6r2: sha256sum over the real file failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j6r2: provenance_receipt selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j6r2: selftest did not speak GREEN"
assert selftest.out contains "real receipt — ${wc.out} bytes, sha256 ${sha.out}, verified offline" else "gism-j6r2: real offline receipt disagrees with wc -c and sha256sum over the real file"
assert selftest.out contains "travelled through Bron (272 bytes) and returned whole, still verifying" else "gism-j6r2: Bron round-trip missing"
assert selftest.out contains "tampered real content refused" else "gism-j6r2: tampered-content refusal missing"
assert selftest.out contains "wrong keeper key refused" else "gism-j6r2: wrong-keeper refusal missing"
assert selftest.out contains "unknown record field refused (UnknownField)" else "gism-j6r2: unknown-field refusal missing"

# The TACT-J2 demo receipt binaries must still be GREEN -- provenance_receipt composes their
# public API only, retiring nothing.
let d1 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/publish_receipt.rye -femit-bin=pond/bin/publish-receipt && pond/bin/publish-receipt selftest 2>&1"]
assert d1.ok else "gism-j6r2: publish_receipt (demo) regressed"
assert d1.out contains "GREEN" else "gism-j6r2: publish_receipt (demo) did not speak GREEN"
let d2 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/publish_receipt_bron.rye -femit-bin=pond/bin/publish-receipt-bron && pond/bin/publish-receipt-bron selftest 2>&1"]
assert d2.ok else "gism-j6r2: publish_receipt_bron (demo) regressed"
assert d2.out contains "GREEN" else "gism-j6r2: publish_receipt_bron (demo) did not speak GREEN"

say "GREEN: GISM-J6r2 — a real publication's receipt verifies offline, travels as Bron, and cross-checks against wc -c and sha256sum; the demo receipts stay GREEN."
