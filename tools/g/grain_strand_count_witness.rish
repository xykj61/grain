# tools/g/grain_strand_count_witness.rish -- the grain's strand count is derived, never carried.
#
#   rishi/bin/rishi run tools/g/grain_strand_count_witness.rish
#
# `foundations/20260826-024942_the-grain-and-the-crossing.md` seated ten strands on `20260702` and
# three more on `20260802` under *Strands Seated at the Fusion*, "beside the elders" in its own
# words. The page has held THIRTEEN since that day, and on `20260907` ten living sentences across
# six documents still said ten -- the foundations front door, the day-one compass rose, the compass
# foundation in four places, the aether threshold page the rota reads first, the singularity
# history, and a manual tutorial.
#
# EVERY ONE OF THEM POINTS AT THE PAGE AND CARRIES A TOTAL RATHER THAN DERIVING ONE, which is what
# `.claude/rules/stamp-and-name.md` rule 3 forbids: count, never number. A total written into a
# sentence stays at whatever it was on the day somebody typed it, and this one had been wrong for
# thirty-six days with nothing reading it.
#
# So the count lives in one place and is derived everywhere else. Seat a fourteenth strand tomorrow
# and the reading moves with it; the control proves exactly that by growing the pen's page and
# watching a pointer that was right go stale.

say "grain-strand-count: Language EN -- one page holds the strands, and one reading counts them."
say "grain-strand-count: Style Gauge, Meter -- a derived total gated at disagreement."
say "grain-strand-count: Lens TAME -- bounded corpus, both refusals proven, the derivation shown live."

say "grain-strand-count: the control -- twenty behaviors on a planted page in a throwaway repository..."
let ctl = run ["sh" "tools/fixtures/g/grain_strand_count_control.sh"]
assert ctl.ok else "grain-strand-count: the control refused --\n${ctl.out}\n${ctl.err}"
assert ctl.out contains "pass=20 fail=0" else "grain-strand-count: the control did not prove twenty behaviors --\n${ctl.out}\n${ctl.err}"

say "grain-strand-count: the living tree's own count, derived from the canonical page..."
let scan = run ["sh" "tools/fixtures/g/grain_strand_count_scan.sh"]
# invariant: a refusal reports BOTH streams. The scan writes its reason to stderr, and a witness
# reporting `out` alone would write an empty reason into the run card a reader opens to learn why a
# guard stopped -- the half REDS %537's repair left behind one room over.
assert scan.ok else "grain-strand-count: the scan refused --\n${scan.out}\n${scan.err}"
# invariant: every reading is reported, empty or full. A census printing only its fault leaves a
# reader unable to tell a healthy tree from one the scan could not see.
assert scan.out contains "strands_elder=" else "grain-strand-count: the elder count went unreported"
assert scan.out contains "strands_fusion=" else "grain-strand-count: the fusion count went unreported"
assert scan.out contains "strands_total=" else "grain-strand-count: the total went unreported"
assert scan.out contains "docs_read=" else "grain-strand-count: the corpus size went unreported"
# invariant: the gate. A living document spelling a count the canonical page has moved past is a
# promise a reader checks and finds broken.
assert scan.out contains "stale_counts=0" else "grain-strand-count: a living document carries a strand count the page has moved past -- sh tools/fixtures/g/grain_strand_count_scan.sh list"

say "grain-strand-count: and the page that holds the strands states the count it holds..."
# invariant: the one place a count may stand is the page the strands live on. Without this the guard
# would pass a tree where nobody spells the number, and the next reader would tally bullets by hand.
assert scan.out contains "page_states=yes" else "grain-strand-count: the canonical page names no count of its own strands"

say "GREEN: grain-strand-count -- the strands counted where they live, and no living sentence carrying a total of its own."
