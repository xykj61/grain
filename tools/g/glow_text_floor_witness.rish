# glow_text_floor_witness.rish — Glow bounded string floor.
#
#   rishi/bin/rishi run tools/g/glow_text_floor_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "glow/bin/text_floor_witness"

let build = run ["sh" "-c" "mkdir -p glow/bin && env RYE_ZIG=${zig} rye/bin/rye build glow/text_floor_witness.rye -femit-bin=${bin}"]
assert build.ok else "Glow text floor witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "Glow text floor witness exited non-zero"
assert selftest.out contains "GREEN" else "Glow text floor witness not GREEN"
assert selftest.out contains "TextOverflow" else "Glow text floor missing overflow refuse"

say "GREEN: Glow text floor witness passed."
