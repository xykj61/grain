# tools/g/glow_tend_a2_suite.rish -- Ashvini a2 folding suite (e246).
#
#   rishi/bin/rishi run tools/g/glow_tend_a2_suite.rish

say "a2-suite: Language EN — gates that fold, one lap."
say "a2-suite: Lens TAME — range + list reducers; plants refuse."

say "a2-suite 1/6: sumto (STOA332)..."
let sumto = run ["rishi/bin/rishi" "run" "tools/t/tally_glow_tend_a2_gate_fold_witness.rish"]
assert sumto.ok else "a2-suite: sumto RED"
say "a2-suite 1/6 GREEN."

say "a2-suite 2/6: pair-sum (STOA333)..."
let pair = run ["rishi/bin/rishi" "run" "tools/t/tally_glow_tend_a2_gate_pair_sum_witness.rish"]
assert pair.ok else "a2-suite: pair-sum RED"
say "a2-suite 2/6 GREEN."

say "a2-suite 3/6: prodto (STOA334 — verb is a name)..."
let prodto = run ["rishi/bin/rishi" "run" "tools/t/tally_a2_fold_prodto_witness.rish"]
assert prodto.ok else "a2-suite: prodto RED"
say "a2-suite 3/6 GREEN."

say "a2-suite 4/6: N-sum widen (STOA335 — triple then n)..."
let nsum = run ["rishi/bin/rishi" "run" "tools/t/tally_a2_fold_n_sum_witness.rish"]
assert nsum.ok else "a2-suite: N-sum RED"
say "a2-suite 4/6 GREEN."

say "a2-suite 5/6: mantra list-fold (STOA335 — pair delegated)..."
let mantra = run ["rishi/bin/rishi" "run" "tools/m/mantra_a2_list_fold_witness.rish"]
assert mantra.ok else "a2-suite: mantra list-fold RED"
say "a2-suite 5/6 GREEN."

say "a2-suite 6/6: list reducer chosen (STOA336 — sum · prod)..."
let reducer = run ["rishi/bin/rishi" "run" "tools/t/tally_a2_list_reducer_witness.rish"]
assert reducer.ok else "a2-suite: list reducer RED"
say "a2-suite 6/6 GREEN."

say "GREEN: a2 suite — one rune, two domains, two reducers each."
