# glow_refusal_witness.rish -- the Glow refusal record, and its agreement with the receipt one.
#
# The product contract asks a refusal to name field, value, ceiling, unit and reason where a
# ceiling applies, and field and reason where none does. glow/rune_shape.rye answered its
# nine-face tuple ceiling and its three-face payload ceiling with the one error name
# TooManyFields, so a caller could not tell which of the two refused. glow/refusal.rye is the
# record that tells them apart, shaped after tally/receipt_refusal.rye, which landed this form
# first for the receipt side.
#
# THE LAST TWO LEGS ARE THE POINT. Two records rendering one line is one rule written twice, so
# the format strings are compared here rather than trusted. Change either spelling alone and this
# reds on the lap it lands.
#
# SIX LEGS JOINED ON `20260916.194500`, when the lexer every Glow parse passes through filled its
# own four. glow/tokens.rye answers a name past max_name_len, a cord literal interior past
# max_cord_lit_bytes, a hex literal past max_hex_lit_digits and a source past max_src_len with the
# one word error.BadToken; tokenize_reporting hands back the record that tells them apart, while
# tokenize keeps the signature and the bytes it always had. The fifth of the six is the one that
# keeps the slot honest: a BadToken no record names leaves the slot null, so a caller asks the slot
# rather than the error name. The sixth proves the published entry unmoved.
#
#   rishi/bin/rishi run tools/g/glow_refusal_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "glow/bin/refusal_witness"

let build = run ["sh" "-c" "mkdir -p glow/bin glow/.cache && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh glow/refusal_witness.rye -femit-bin=${bin}"]
assert build.ok else "refusal_witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "refusal_witness exited non-zero"
assert selftest.out contains "five-part rendering -- GREEN" else "refusal_witness missing five-part rendering"
assert selftest.out contains "two-part rendering -- GREEN" else "refusal_witness missing two-part rendering"
assert selftest.out contains "reason and unit words distinct and printable -- GREEN" else "refusal_witness missing word legs"
assert selftest.out contains "name ceiling admitted, one past refused -- GREEN" else "refusal_witness missing name ceiling both sides"
assert selftest.out contains "short buffer refused by name -- GREEN" else "refusal_witness missing short buffer refusal"
assert selftest.out contains "tuple ceiling names the face that would not fit -- GREEN" else "refusal_witness missing tuple ceiling record"
assert selftest.out contains "one error name, two ceilings, told apart -- GREEN" else "refusal_witness missing shared-error-name leg"
assert selftest.out contains "an unnamed refusal leaves the slot empty -- GREEN" else "refusal_witness missing empty-slot leg"
assert selftest.out contains "parse_source unchanged, nine admitted -- GREEN" else "refusal_witness missing published-entry leg"
assert selftest.out contains "the lexer name ceiling carries its own record -- GREEN" else "refusal_witness missing the lexer name ceiling"
assert selftest.out contains "one scanner, two kinds, each named -- GREEN" else "refusal_witness missing the tag-versus-ident leg"
assert selftest.out contains "the cord literal ceiling counts its interior -- GREEN" else "refusal_witness missing the cord literal ceiling"
assert selftest.out contains "the hex literal ceiling reports digits -- GREEN" else "refusal_witness missing the hex literal ceiling"
assert selftest.out contains "the source ceiling refuses ahead of the name ceiling -- GREEN" else "refusal_witness missing the source ceiling"
assert selftest.out contains "an unnamed BadToken leaves the slot empty -- GREEN" else "refusal_witness missing the empty-slot leg for the lexer"
assert selftest.out contains "tokenize unchanged, a name at the ceiling admitted -- GREEN" else "refusal_witness missing the published lexer leg"
# FIVE IDENT LEGS JOINED ON `20260917.004014`, when the Zig-identifier rule the lowering room
# lowers a face by moved out of 29 copies into glow/zig_ident.rye. Three faults arrive as the one
# word error.BadIdent -- an empty face, a face past its ceiling, a byte Zig will not take -- so each
# fills its own record; the dot policy keeps both honest readings, a face refusing it and a wing
# lowering it; and the caller's own field word and ceiling travel into the record, which is what
# lets one rule serve the room's five different budgets without the record going vague.
assert selftest.out contains "one ident rule lowers the hyphen and leaves the slot empty -- GREEN" else "refusal_witness missing the ident lowering leg"
assert selftest.out contains "three ident faults under one error name, three records -- GREEN" else "refusal_witness missing the three-ident-faults leg"
assert selftest.out contains "each ident refusal renders its own line -- GREEN" else "refusal_witness missing the ident rendering leg"
assert selftest.out contains "the dot refuses as a face and lowers as a wing -- GREEN" else "refusal_witness missing the dot-policy leg"
assert selftest.out contains "the caller's field and ceiling travel into the record -- GREEN" else "refusal_witness missing the caller-field leg"

# THE TALLY IS DERIVED, NEVER RECITED -- the discipline this guard's own sibling
# glow_ceiling_refusal_witness.rish already states, and which this line did not follow. It read
# "16 legs" and reddened on `20260917` the moment five legs were added, which is precisely the
# shape that teaches a lane to stop adding them. Every leg above is asserted by name, so a leg that
# BREAKS is still heard; what stops being gated is a leg that ARRIVES.
assert selftest.out contains "0 failures -- GREEN" else "refusal_witness reported a failing leg"

# THE REFUSAL THIS GUARD DEMONSTRATES, added `20260916.205141`. Every leg above proves the record
# is BUILT; none showed the witness refusing, so `standing_equipment_redleg` counted this guard
# among those rostered with no refusal of their own -- and it was right to, since a guard proven
# only in the passing direction cannot be told from a guard that has stopped reading. The pen and
# its plant live in tools/fixtures/g/glow_refusal_mutation_control.sh, which swaps the `%tag` path's
# kind word for "ident" and asks the rebuilt witness to refuse.
let mutation = run ["sh" "tools/fixtures/g/glow_refusal_mutation_control.sh"]
assert mutation.ok else "the mutation control refused to run -- read its own verdict line"
assert mutation.out contains "plant_found=1" else "the tag-kind call site has moved; the plant names a line that is no longer there"
assert mutation.out contains "mutant_refuses=yes" else "the kind word is not load-bearing: a lexer naming every long name 'ident' still passed every leg"

let five = run ["sh" "-c" "grep -c 'field={s} value={d} ceiling={d} unit={s} reason={s}' glow/refusal.rye tally/receipt_refusal.rye | tr '\n' ' '"]
assert five.ok else "the five-part format string is absent from one of the two records"
assert five.out contains "glow/refusal.rye:1" else "glow/refusal.rye does not spell the five-part line once"
assert five.out contains "tally/receipt_refusal.rye:1" else "tally/receipt_refusal.rye does not spell the five-part line once"

let two = run ["sh" "-c" "grep -c 'field={s} reason={s}' glow/refusal.rye tally/receipt_refusal.rye | tr '\n' ' '"]
assert two.ok else "the two-part format string is absent from one of the two records"
assert two.out contains "glow/refusal.rye:1" else "glow/refusal.rye does not spell the two-part line once"
assert two.out contains "tally/receipt_refusal.rye:1" else "tally/receipt_refusal.rye does not spell the two-part line once"

say "GREEN: Glow refusal record -- field, value, ceiling, unit, reason; one error name and six ceilings told apart across rune_shape and the lexer, the lexer's name ceiling reached through two scanners and naming each kind; a BadToken no record names leaving the slot empty; both format strings agreeing with tally/receipt_refusal.rye byte for byte; 21 legs plus 4 agreement asserts -- the five newest proving the one Zig-identifier rule the lowering room shares, and its own refusal shown by a planted mutation of the kind word."
