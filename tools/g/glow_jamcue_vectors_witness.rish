# glow_jamcue_vectors_witness.rish -- Glow cell-pack demo vectors GREEN.
#
# Asserts the seated demo arithmetic against tools/fixtures/glow_jamcue_vectors.txt
# and reuses glow_expr_witness for the parse/lower face.
#
#   rishi/bin/rishi run tools/g/glow_jamcue_vectors_witness.rish

let fixture = read-file "tools/fixtures/glow_jamcue_vectors.txt"
assert (fixture contains "flat|(jam from amount)|327683|3|") else "fixture missing flat vector"
assert (fixture contains "nest-left|(jam (mix from amount) amount)|393219|3|") else "fixture missing nest-left"
assert (fixture contains "nest-right|(jam cell (mix from amount))|327686|6|") else "fixture missing nest-right"
assert (fixture contains "nest-both|(jam (mix from amount) (mix cell gate))|393222|6|") else "fixture missing nest-both"

# Demo arithmetic -- same constants as glow/expr.rye (left=5 right=3 mix=6).
let flat_run = run ["sh" "-c" "echo $(( (5 << 16) | 3 ))"]
assert flat_run.ok else "flat jam arithmetic failed"
assert (trim flat_run.out) == "327683" else "flat jam expected 327683"

let nest_left_run = run ["sh" "-c" "echo $(( (6 << 16) | 3 ))"]
assert nest_left_run.ok else "nest-left jam arithmetic failed"
assert (trim nest_left_run.out) == "393219" else "nest-left jam expected 393219"

let nest_right_run = run ["sh" "-c" "echo $(( (5 << 16) | 6 ))"]
assert nest_right_run.ok else "nest-right jam arithmetic failed"
assert (trim nest_right_run.out) == "327686" else "nest-right jam expected 327686"

let nest_both_run = run ["sh" "-c" "echo $(( (6 << 16) | 6 ))"]
assert nest_both_run.ok else "nest-both jam arithmetic failed"
assert (trim nest_both_run.out) == "393222" else "nest-both jam expected 393222"

# Cue round-trip expects (low-16 / mix) already listed in the fixture rows.
assert (fixture contains "|327683|3|") else "cue flat expect missing"
assert (fixture contains "|393219|3|") else "cue nest-left expect missing"
assert (fixture contains "|327686|6|") else "cue nest-right expect missing"
assert (fixture contains "|393222|6|") else "cue nest-both expect missing"

let expr = run ["rishi/bin/rishi" "run" "tools/g/glow_expr_witness.rish"]
assert expr.ok else "glow_expr_witness failed under jamcue vectors"
assert expr.out contains "GREEN" else "glow_expr_witness not GREEN"
assert expr.out contains "jam" else "expr GREEN missing jam mention"
assert expr.out contains "cue" else "expr GREEN missing cue mention"

say "GREEN: Glow cell-pack demo vectors — four thin packs + cue round-trip + expr face."
