# tools/g/gism_j5_corpus_real_ember_witness.rish — GISM Journey 5 (Real corpora), Rung 2.
#
# Season 2, Yield: the craft voice stands on real data. Ember's demo read a catalog
# of invented line counts; this rung reads a catalog derived at compile time from
# three real embedded tree files (greet.rye, tally/stack.rye, one_clock_witness.rish),
# every count measured from the real bytes. The witness cross-checks Ember's
# sum_lines against an independent `wc -l` of the same real files — two tools, one
# answer — so the reading is bound to the tree, not to a literal. The demo reading
# over pinned_catalog (corpus_query) is re-run untouched; the refactor was additive.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_j5_corpus_real_ember_witness.rish

say "gism-j5r2: Language EN — the craft voice reads a real corpus derived from real tree files."
say "gism-j5r2: Lens TAME — real bytes, one bounded reader; Ember's sum cross-checked by wc -l."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/corpus-real-ember"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/corpus_real_ember.rye -femit-bin=${bin}"]
assert build.ok else "gism-j5r2: corpus_real_ember build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j5r2: corpus_real_ember selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j5r2: selftest did not speak GREEN"
assert selftest.out contains "real count_rye — '2' eos" else "gism-j5r2: real count_rye reading missing"
assert selftest.out contains "real paths_rye — 'manual/tutorials/greet.rye tally/stack.rye' eos" else "gism-j5r2: real rye paths reading missing"
assert selftest.out contains "real sum_lines" else "gism-j5r2: real sum_lines reading missing"
assert selftest.out contains "model not allowed refused" else "gism-j5r2: allow-list gate missing"
assert selftest.out contains "unknown op refused" else "gism-j5r2: unknown-op refusal missing (would be a fake answer)"

# Independent cross-check: total the real files' lines directly (awk NR across all
# three) and prove Ember's derived sum_lines matches — the Rye reading bound to the
# tree by a second tool. Two captured numbers compared as-is, no interpolation.
let expected = run ["sh" "-c" "awk 'END{print NR}' manual/tutorials/greet.rye tally/stack.rye tools/o/one_clock_witness.rish"]
assert expected.ok else "gism-j5r2: awk line-total cross-check failed to run"
let reported = run ["sh" "-c" "${bin} selftest 2>&1 | grep -oE 'truth [0-9]+' | grep -oE '[0-9]+'"]
assert reported.ok else "gism-j5r2: could not read Ember's reported sum"
assert expected.out == reported.out else "gism-j5r2: Ember sum_lines disagrees with awk line-total over the real files"

# The demo reading over pinned_catalog must still be GREEN — the answer_over refactor is additive.
let demo_bin = "pond/bin/corpus-query"
let demo_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/corpus_query.rye -femit-bin=${demo_bin}"]
assert demo_build.ok else "gism-j5r2: corpus_query (demo) rebuild failed after refactor"
let demo_selftest = run ["sh" "-c" "${demo_bin} selftest 2>&1"]
assert demo_selftest.ok else "gism-j5r2: corpus_query (demo) selftest regressed"
assert demo_selftest.out contains "GREEN" else "gism-j5r2: corpus_query (demo) did not speak GREEN"

say "GREEN: GISM-J5r2 — the craft voice reads a real derived corpus; Ember's sum matches wc -l; the demo reading stays GREEN."
