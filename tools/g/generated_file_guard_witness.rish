# tools/g/generated_file_guard_witness.rish — no generated binaries ride the index.
#
# Outside-eyes round (20260727.083402): an elder-network pilot's review found
# compiled outputs tracked under tools/bin/ while .gitignore already named the
# path — ignore rules never untrack. This witness keeps the promise from now on:
# the guarded output homes must be empty in the index.

let guarded = ["tools/bin"]

let hits = run ["git" "ls-files" "--" "tools/bin"]
assert hits.ok else "git ls-files failed"
let rows = where (lines hits.out) as ln: ln != ""
say "generated-file guard — tracked rows under tools/bin: ${length rows}"
assert (length rows) == 0 else "tracked generated files under tools/bin — untrack them (git rm -r --cached tools/bin)"
say "GREEN: generated-file guard — no compiled outputs ride the index."
