# tools/g/gen_bozo_fund_prep.rish -- accrete shim -> tools/gen/fund/gen_bozo_fund_prep.rish
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/fund/gen_bozo_fund_prep.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/fund/gen_bozo_fund_prep.rish" args[0]]
if r.out != "" then say r.out
exit r.code
