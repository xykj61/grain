# tools/g/glow_vane_pair_mirrors_witness.rish -- STOA346: the 2m mirrors, heard.
#
#   rishi/bin/rishi run tools/g/glow_vane_pair_mirrors_witness.rish
#
# Tally's relational wall, mirrored into Caravan and Mantra: two runtime faces at every door.
# REWRITTEN 20260828 (Sound's language custody, REDS %310): the elder form asserted only `.ok`
# on desks whose generated main compared the gate to a copy of itself -- exit 0 for every input,
# nothing spoken, so "every edge exact" was a sentence no run had ever checked. The lowering
# speaks now, and this witness asserts the SPOKEN DIGIT per side, read as the worker's first
# output line and compared exactly -- `contains` is a substring test and the worker's own
# EXIT:0 tail contains a 0, which is precisely how the elder blindness survived (%308's kin).
# Every accept side asserts 1, every refuse side asserts 0, per each gate's own placard.

fn side desk a b: trim (run ["sh" "-c" "sh tools/g/glow_run_worker.sh src/gate/${desk}.glow ${a} ${b} 2>/dev/null | head -1"]).out

say "346: caravan caps -- within, over, and at the cap..."
assert (side "gate-caravan-caps-pair-bound-u32" "3" "8") == "1" else "346: caravan within must speak 1"
assert (side "gate-caravan-caps-pair-bound-u32" "9" "8") == "0" else "346: caravan over must speak 0 -- the wall refuses"
assert (side "gate-caravan-caps-pair-bound-u32" "8" "8") == "1" else "346: caravan at-cap must speak 1 -- the bound is inclusive"

say "346: mantra gen-floor -- above, below, and at the floor..."
assert (side "gate-mantra-gen-floor-pair-u32" "3" "5") == "1" else "346: mantra above must speak 1"
assert (side "gate-mantra-gen-floor-pair-u32" "3" "2") == "0" else "346: mantra below must speak 0 -- the floor holds"
assert (side "gate-mantra-gen-floor-pair-u32" "3" "3") == "1" else "346: mantra at-floor must speak 1 -- at the floor stands"

say "346: the elder tally mirror -- at the bound, and past it..."
assert (side "gate-tally-garden-pair-bound-u32" "7" "7") == "1" else "346: tally at-bound must speak 1"
assert (side "gate-tally-garden-pair-bound-u32" "9" "8") == "0" else "346: tally past-bound must speak 0 -- the refusal the elder never asked for"

say "GREEN: the 2m mirrors -- Tally, Caravan, and Mantra ask with two runtime faces, and every edge is exact because every answer was HEARD: eight sides spoken, three refusals among them."
