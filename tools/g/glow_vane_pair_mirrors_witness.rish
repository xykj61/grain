# tools/g/glow_vane_pair_mirrors_witness.rish — STOA346: the 2m mirrors.
#
#   rishi/bin/rishi run tools/g/glow_vane_pair_mirrors_witness.rish
#
# Tally's relational wall, mirrored true into Caravan and Mantra: two runtime
# faces at every door, edges exact, the elder tally desk green beside them.

say "346: caravan — within, over, and at the cap..."
let c1 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-caravan-caps-pair-bound-u32.glow" "3" "8"]
assert c1.ok else "346: caravan within failed"
let c2 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-caravan-caps-pair-bound-u32.glow" "9" "8"]
assert c2.ok else "346: caravan over failed"
let c3 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-caravan-caps-pair-bound-u32.glow" "8" "8"]
assert c3.ok else "346: caravan at-cap failed"

say "346: mantra — above, below, and at the floor (floor stands first)..."
let m1 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-mantra-gen-floor-pair-u32.glow" "3" "5"]
assert m1.ok else "346: mantra above failed"
let m2 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-mantra-gen-floor-pair-u32.glow" "3" "2"]
assert m2.ok else "346: mantra below failed"
let m3 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-mantra-gen-floor-pair-u32.glow" "3" "3"]
assert m3.ok else "346: mantra at-floor failed"

say "346: the elder tally mirror stays green..."
let t1 = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "src/lib/gate-tally-garden-pair-bound-u32.glow" "7" "7"]
assert t1.ok else "346: tally regression failed"

say "GREEN: the 2m mirrors — Tally, Caravan, and Mantra all ask with two runtime faces; every edge exact; the pattern holds across the vanes."
