# tools/g/glow_gate_law_agree_witness.rish -- a Glow gate's wall still says what Rye says.
#
#   rishi/bin/rishi run tools/g/glow_gate_law_agree_witness.rish
#
# A Glow gate desk decides a module's law at the door by MEMORIZING its number, while the Rye
# module holds the declaration. Every other guard over these desks runs the gate twice and proves
# it DECIDES on both sides of the wall it carries -- which stays true after the Rye constant moves
# and the desk does not. This witness reads the two together.
#
# A law's middle field may name a plain-integer `const`, or a `<Type>.fields` struct field count,
# or a `<Type>.variants` enum variant count -- the dot selects which reader answers, and a Zig
# identifier can never carry one. The second and third homes landed `20260915.205116`, taking the
# ratchet's floor from fourteen to nine.
#
# THE SECOND POPULATION landed `20260915.222000`. A desk may DECIDE -- a `?:` wall comparing a face
# against a literal -- or DECLARE: no `?:` at all, a `+$` shape for a body, and its module's number
# stated once in the `example` head line. The declaring kind is the LARGER half, 45 desks against
# 25, and no reader opened it until this rung. Its own gate is `example_disagree` and its own
# ratchet is `pedestals_unlinked`, so neither word has to answer for both kinds.
#
# Scan: tools/fixtures/g/glow_gate_law_agree_scan.sh -- control: the sibling _control.sh, 79 legs
# on planted desk rooms in a throwaway pen, seven mutations proven to bite.

say "glow_gate_law_agree: Language EN -- each linked Glow gate wall against the Rye const it names."

let scan = run ["sh" "tools/fixtures/g/glow_gate_law_agree_scan.sh"]
assert scan.out contains "verdict=" else "glow_gate_law_agree: the scan printed no verdict -- an instrument that cannot answer refuses rather than passing"
assert scan.ok else "glow_gate_law_agree: a Glow gate wall disagrees with the Rye constant it names -- ${scan.out_brief}"
assert scan.out contains "verdict=ok" else "glow_gate_law_agree: scan did not read ok -- ${scan.out_brief}"

# The four gates, each named so a reader of this witness knows what is held at zero without
# opening the scan. Reading them back separately also catches a scan that prints ok while a
# counter it stopped incrementing reads blank.
assert scan.out contains "law_malformed=0" else "glow_gate_law_agree: a law line is not <file> <const> below|atmost|exact"
assert scan.out contains "law_unresolved=0" else "glow_gate_law_agree: a linked desk names a const no module declares as a plain integer"
assert scan.out contains "head_disagree=0" else "glow_gate_law_agree: a desk head restates its law at a number the Rye const no longer holds"
assert scan.out contains "body_disagree=0" else "glow_gate_law_agree: a desk wall literal disagrees with its declared relation to the Rye const"
assert scan.out contains "example_disagree=0" else "glow_gate_law_agree: a pedestal desk's example line states a number the Rye declaration it names no longer holds"

# The population must not read empty. A scan whose file list came back blank prints four honest
# zeros and verdict=ok, which is exactly what a healthy tree prints -- so the counts are read back
# and asserted positive, since a reader that stopped reading is invisible from its own output.
let walls = run ["sh" "-c" "sh tools/fixtures/g/glow_gate_law_agree_scan.sh | grep -q '^walls=0' && echo no || echo yes"]
assert (trim walls.out) == "yes" else "glow_gate_law_agree: the scan found no wall-memorizing desk at all, which reads like a broken reader rather than a clean tree"

let linked = run ["sh" "-c" "sh tools/fixtures/g/glow_gate_law_agree_scan.sh | grep -q '^linked=0' && echo no || echo yes"]
assert (trim linked.out) == "yes" else "glow_gate_law_agree: no desk is linked to a Rye const, so the four gates above hold nothing"

# The second population is read back the same way and for the same reason. A pedestal reading that
# silently stopped finding desks prints `pedestals=0` beside `verdict=ok`, which is what an empty
# room prints -- so both the population and its linked half are asserted non-empty.
let peds = run ["sh" "-c" "sh tools/fixtures/g/glow_gate_law_agree_scan.sh | grep -q '^pedestals=0' && echo no || echo yes"]
assert (trim peds.out) == "yes" else "glow_gate_law_agree: the scan found no declaring pedestal desk at all, which reads like a broken reader rather than a clean tree"

let peds_linked = run ["sh" "-c" "sh tools/fixtures/g/glow_gate_law_agree_scan.sh | grep -q '^pedestals_linked=0' && echo no || echo yes"]
assert (trim peds_linked.out) == "yes" else "glow_gate_law_agree: no pedestal is linked to a Rye declaration, so example_disagree holds nothing"

let control = run ["sh" "tools/fixtures/g/glow_gate_law_agree_control.sh"]
assert control.ok else "glow_gate_law_agree: the pen control failed -- ${control.out_brief}"
assert control.out contains "control_failed=0" else "glow_gate_law_agree: a control leg failed -- ${control.out_brief}"
assert control.out contains "control_verdict=ok" else "glow_gate_law_agree: the control reached no verdict -- ${control.out_brief}"

# The leg TALLY, asserted beside the verdict. `control_verdict=ok` says only that the control
# reached its last line, so a leg written tomorrow could read wrongly under a green witness --
# the `control_unheard` shape one room over. Raise this number in the same commit that adds a leg.
assert control.out contains "legs=79" else "glow_gate_law_agree: the control ran a different number of legs than this rung names -- a leg this witness cannot hear is a leg nobody is watching -- ${control.out}"

# The two homes beyond a plain const, named so a reader of this witness knows the dot suffix is
# held rather than merely written. Each is planted agreeing and then broken by growing the Rye
# declaration under a desk that does not move.
assert control.out contains "leg ok      struct fields linked" else "glow_gate_law_agree: a law naming <Type>.fields must resolve through the struct field reader"
assert control.out contains "leg ok      struct grew, body reds" else "glow_gate_law_agree: a struct growing a field under a still desk must red"
assert control.out contains "leg ok      enum variants linked" else "glow_gate_law_agree: a law naming <Type>.variants must resolve through the enum variant reader"
assert control.out contains "leg ok      enum grew, body reds" else "glow_gate_law_agree: an enum growing a variant under a still desk must red"
assert control.out contains "leg ok      wrong kind unresolved" else "glow_gate_law_agree: a kind suffix pointed at the wrong kind must refuse rather than reach for the other reader"

# The declaring population, named so a reader knows the larger half is held rather than merely
# counted. The first is the whole fault: a pedestal states 32, the Rye const moves to 48, and
# nothing but this reading says so. The last two are the disjointness -- a desk carrying a wall is
# a wall desk whatever its example line says, and a desk memorizing nothing is neither.
assert control.out contains "leg ok      const moved: example reds" else "glow_gate_law_agree: a Rye const moving under a still pedestal must red"
assert control.out contains "leg ok      pedestal field-count home" else "glow_gate_law_agree: the field-count reader must serve a pedestal law exactly as it serves a wall's"
assert control.out contains "leg ok      wall with example: not ped" else "glow_gate_law_agree: a wall desk carrying an example line must never be counted a second time as a pedestal"
assert control.out contains "leg ok      face-vs-face: no pedestal" else "glow_gate_law_agree: a desk memorizing nothing must be passed over rather than priced by an example it never decides on"

say "GREEN: glow_gate_law_agree -- every linked gate wall and every linked pedestal agrees with the Rye declaration it names."
