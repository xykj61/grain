# glow_digraph_twin_witness.rish -- STOA333 rung-1a digraph-table twin.
#
# Glow desk (sample-digraph-table.glow) - fixture - Rye match_rune2 extract
# agree byte-for-byte with each other; each fixture line tokenizes as Kind.rune2.
# Wrong-order fixture (glow_digraph_table_wrong_order.txt -- first two rows swapped)
# proves the cmp gate turns red. Standing-exempt intentional violation -- do not "fix".
#
#   rishi/bin/rishi run tools/g/glow_digraph_twin_witness.rish

let fixture = "tools/fixtures/glow_digraph_table.txt"
let wrong = "tools/fixtures/glow_digraph_table_wrong_order.txt"
let desk = "glow/gen/s/sample-digraph-table.glow"
let shape = "glow/gen/s/shape-digraph-table.glow"

assert ((read-file fixture) contains "+$") else "fixture missing +$"
assert ((read-file fixture) contains "|^") else "fixture missing |^ barket"
assert ((read-file wrong) contains "+$") else "wrong-order fixture missing +$"
assert ((read-file desk) contains "rows='") else "desk missing rows cord"
assert ((read-file shape) contains "digraph-table-shape") else "shape desk missing"

let rye = run ["sh" "tools/fixtures/glow_digraph_rye_extract.sh"]
assert rye.ok else "rye digraph extract failed"
let glow = run ["sh" "tools/fixtures/glow_digraph_desk_extract.sh"]
assert glow.ok else "glow desk digraph extract failed"

let rye_n = length (where (lines rye.out) as ln: ln != "")
let glow_n = length (where (lines glow.out) as ln: ln != "")
let fix_n = length (where (lines (read-file fixture)) as ln: ln != "")
let wrong_n = length (where (lines (read-file wrong)) as ln: ln != "")
assert rye_n == 28 else "rye extract count not 28"
assert glow_n == 28 else "glow extract count not 28"
assert fix_n == 28 else "fixture count not 28"
assert wrong_n == 28 else "wrong-order fixture count not 28"

# Byte-identical line streams -- order is law.
let cmp_rye = run ["sh" "-c" "tools/fixtures/glow_digraph_rye_extract.sh | cmp -s - ${fixture}"]
assert cmp_rye.ok else "rye extract != fixture (order or glyphs drifted)"
let cmp_glow = run ["sh" "-c" "tools/fixtures/glow_digraph_desk_extract.sh | cmp -s - ${fixture}"]
assert cmp_glow.ok else "glow desk extract != fixture"

# Rye extract and Glow desk extract are byte-identical to each other.
assert rye.out == glow.out else "rye extract != glow desk extract (twin drift)"

# Negative space: wrong-order fixture must fail cmp against the Rye extract.
let cmp_wrong = run ["sh" "-c" "tools/fixtures/glow_digraph_rye_extract.sh | cmp -s - ${wrong}"]
assert cmp_wrong.ok == false else "wrong-order fixture must fail cmp — gate inconclusive"

# Tokenizer face: each fixture digraph is Kind.rune2 length 2.
let zig = "vendor/zig-toolchain/zig"
let bin = "glow/bin/digraph_twin_check"
let build = run ["sh" "-c" "mkdir -p glow/bin && env RYE_ZIG=${zig} rye/bin/rye build glow/digraph_twin_check.rye -femit-bin=${bin}"]
assert build.ok else "digraph_twin_check build failed: ${build.err}${build.out}"
let check = run ["sh" "-c" "${bin} 2>&1"]
assert check.ok else "digraph_twin_check failed: ${check.err}${check.out}"
assert check.out contains "OK digraph_twin_check 28" else "digraph_twin_check missing OK 28"

# Alphabet gate still GREEN, at 28 now that barlus is named.
let alpha = run ["rishi/bin/rishi" "run" "tools/g/glow_rune_alphabet_witness.rish"]
assert alpha.ok else "glow_rune_alphabet_witness failed under digraph twin"
assert alpha.out contains "rune_heads=28" else "alphabet witness must publish rune_heads=28 (REDS %283)"

say "GREEN: STOA333 digraph-table twin rung 1a — desk ≡ fixture ≡ Rye · wrong-order fails · tokenize rune2"
