# tools/g/glyph_accent_witness.rish -- a whole accented corpus grown by composition proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - the overlay primitive's payoff. Where image/glyph_compose.rye composes ONE
# accented letter, image/glyph_accent.rye composes a WHOLE corpus: compose_accent_atlas(base atlas, one mark, a
# base->accented codepoint table) overlays the mark onto each named base glyph and returns a gfa1-encodable atlas of
# accented letters. The crux this witness proves: compose_accent_atlas(lowercase base, grave mark, the a/e/o/u grave
# map) reproduces the hand-drawn image/font5x7_grave.rye coverage BYTE-FOR-BYTE for those four vowels, and the
# composed atlas round-trips through the gfa1 encoder/decoder byte-for-byte -- so a corpus grown by composition is
# indistinguishable from one drawn by hand. A base the atlas lacks, a wrong-length mark, a non-ascending map, and an
# empty map each refuse by name. A five-vowel accent corpus is now a five-row table plus one mark, not five drawings.
# No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/glyph_accent_witness.rish

say "glyph-accent: Language EN -- Season G open-media primitive; compose_accent_atlas grows a whole accented corpus from one base atlas, one combining mark, and a base->accented codepoint table, the O(letters + accents) economy made literal."
say "glyph-accent: Style Radiant -- the hand-drawn corpus is the specification; the composed grave vowels equal font5x7_grave's own coverage byte-for-byte and round-trip through gfa1 byte-identical, so a corpus grown by composition is the corpus drawn by hand, our own open font, no external font to license."
say "glyph-accent: Lens TAME -- u32 in-memory counts; the table bounded by accent_max; accented codepoints required strictly ascending (the order the encoder trusts); invariants positive (one accented glyph per row, the base present, the mark one cell); refusals named (EmptyMap - TooManyAccents - MarkLenMismatch - MapNotAscending - BaseGlyphMissing); no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/glyph_accent"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/glyph_accent.rye -femit-bin=${bin}"]
assert build.ok else "glyph-accent: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "glyph-accent: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "glyph-accent: ${out}"

assert selftest.out contains "GREEN image-glyph-accent" else "glyph-accent: selftest did not print the GREEN primitive line"
