# tools/g/gism_j6_provenance_true_witness.rish — GISM Journey 6 (Provenance), Rung 4.
#
# Season 2, Yield: a signature is only as honest as its tie to the real bytes. This
# closing witness proves the facts a publication signs — the whole length and the content
# digest — are true to the real file a keeper can open and hash. The app signs the real
# embedded artifact (a living waymark green-claim, symlinked) and prints the signed length
# and SHA-256; this witness cross-checks both against an independent wc -c and sha256sum of
# the same file on disk — two tools, one answer — so a signature can never vouch for bytes
# the corpus does not contain. This closes GISM Journey 6.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/g/gism_j6_provenance_true_witness.rish

say "gism-j6r4: Language EN — the signed facts are true to the real file a keeper can open and hash."
say "gism-j6r4: Lens TAME — signed length and digest cross-check against wc -c and sha256sum; Journey 6 closes."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/provenance-true"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/provenance_true.rye -femit-bin=${bin}"]
assert build.ok else "gism-j6r4: provenance_true build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-j6r4: provenance_true selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-j6r4: selftest did not speak GREEN"
assert selftest.out contains "signed_len 213" else "gism-j6r4: signed length line missing"
assert selftest.out contains "signed_sha256 2010d1606c18cafac511b630be7e6bcaf1a9ec34cf9902ca7106deb4aaee0a6d" else "gism-j6r4: signed digest line missing"
assert selftest.out contains "true to the real bytes (a neighbor refuses)" else "gism-j6r4: tight-binding line missing"

# The crux cross-check: the signed facts equal an independent measurement of the real file.
let real = "waymarks/date/20260801/20260801-134653_e182-q46-errors-named-green.md"
let wc = run ["sh" "-c" "wc -c < ${real} | tr -d ' '"]
assert wc.ok else "gism-j6r4: wc -c over the real file failed"
assert wc.out contains "213" else "gism-j6r4: wc -c disagrees with the signed length"
let sha = run ["sh" "-c" "sha256sum ${real} | cut -d' ' -f1"]
assert sha.ok else "gism-j6r4: sha256sum over the real file failed"
assert sha.out contains "2010d1606c18cafac511b630be7e6bcaf1a9ec34cf9902ca7106deb4aaee0a6d" else "gism-j6r4: sha256sum disagrees with the signed digest"

say "GREEN: GISM-J6r4 — the signed length and digest are true to the real file (wc -c + sha256sum agree); GISM Journey 6 (Provenance) stands complete end to end."
