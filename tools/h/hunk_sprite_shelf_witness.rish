# tools/h/hunk_sprite_shelf_witness.rish — the marketplace catalog is browsed as a paged shelf (HUNK38, sprite quest).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · Open Image journey · rung HUNK38.
# Design read: active-designing/date/20260813/20260813-203000_hunk-sprite-catalog-shelf-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's fast one-sprite-sheet index page (concept only, siloed).
#
# HUNK4 made each product a bounded window into one decoded sheet; HUNK5 painted a single product page; HUNK2
# down-mapped a decoded image into Skate's palette-indexed cells; HUNK36/37 proved a paged shelf over a library.
# This rung is the marketplace's own front door: `brushstroke/sprite_shelf.rye` `catalog_shelf` renders a whole
# SpriteIndex onto one Skate grid, one row per product reading `<name>` and a color swatch wearing the product's
# own down-mapped slot; `catalog_window` pages a catalog larger than the screen. The selftest indexes four
# solid-color products (red/green/blue/yellow bands) into one 16x8 sheet and proves each row's swatch carries its
# product's color slot (3,4,5,6), each row names its product, paging covers every product once in held order, the
# shelf is pure and deterministic, and the five named refusals fire. Pure composition over public APIs — no new
# storage, codec, or palette. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_sprite_shelf_witness.rish

say "hunk-sprite-shelf: Language EN — HUNK38/39 paint a whole SpriteIndex as a paged catalog shelf: one row per product, its name beside a thumbnail swatch (a horizontal strip) drawn from its own window into the one shared sheet."
say "hunk-sprite-shelf: Style Radiant — a keeper reads the marketplace at a glance; every product reachable a page at a time, each swatch its product's own shape and color, none shown twice, none silently dropped."
say "hunk-sprite-shelf: Lens TAME — pure composition over public APIs; the swatch is a down-mapped strip that stretches to fill and is valid for any window; every dimension refuses by name; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/sprite_shelf"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/sprite_shelf.rye -femit-bin=${bin}"]
assert build.ok else "hunk-sprite-shelf: build failed — ${build.err}"

# Write the selftest output to a file and grep the file — the GREEN line carries apostrophes ("product's",
# "window's") that break a shell single-quoted round-trip, so read it from disk instead.
let outfile = "brushstroke/bin/sprite_shelf.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "hunk-sprite-shelf: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "hunk-sprite-shelf: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN sprite-shelf' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "hunk-sprite-shelf: selftest did not print the GREEN shelf line"

let nolose = run ["sh" "-c" "grep -q 'paging loses' ${outfile} && echo yes"]
assert (trim nolose.out) == "yes" else "hunk-sprite-shelf: the selftest did not prove paging loses nothing"

let swatch = run ["sh" "-c" "grep -q 'its own down-mapped slot' ${outfile} && echo yes"]
assert (trim swatch.out) == "yes" else "hunk-sprite-shelf: the selftest did not prove each swatch carries its product's color"

let shape = run ["sh" "-c" "grep -q 'carries the window' ${outfile} && echo yes"]
assert (trim shape.out) == "yes" else "hunk-sprite-shelf: the selftest did not prove the strip carries the window's shape"

# HUNK5 stays GREEN — the shelf reuses sprite.render and image_skate.down_map that the product page proved.
let page = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/sprite_page.rye -femit-bin=brushstroke/bin/sprite_page && brushstroke/bin/sprite_page selftest 2>&1"]
assert page.ok else "hunk-sprite-shelf: HUNK5 sprite_page re-run failed — ${page.out}"
assert page.out contains "GREEN sprite-page" else "hunk-sprite-shelf: HUNK5 sprite_page did not stay GREEN"

# HUNK2 stays GREEN — the down-map the swatch stands on, and the set_anchor_palette refactor beneath it, must hold.
let skate = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/image_skate.rye -femit-bin=brushstroke/bin/image_skate && brushstroke/bin/image_skate selftest 2>&1"]
assert skate.ok else "hunk-sprite-shelf: HUNK2 image_skate re-run failed — ${skate.out}"
assert skate.out contains "GREEN image-skate" else "hunk-sprite-shelf: HUNK2 image_skate did not stay GREEN after the set_anchor_palette refactor"

say "hunk-sprite-shelf: GREEN — the marketplace catalog is browsed as a paged shelf on metal; HUNK5 page and HUNK2 down-map underneath stay GREEN. HUNK38 lands."
