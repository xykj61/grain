# tools/h/hunk_part_catalog_witness.rish -- the parts marketplace carries honest facts (HUNK71).
#
# Season A (Hardware & Right-to-Repair) - waymark HUNK - parts-marketplace journey - rung HUNK71.
# Design read: active-designing/date/20260813/20260813-020035_double-seat-expansion-six-seasons.md (Season A -- parts marketplace).
# Teacher, thanked clean-room: McMaster-Carr's catalog (concept only, siloed -- a part is a picture PLUS its facts).
#
# HUNK4-HUNK7 built the visual half of the marketplace (one sheet, each product a window, the index travelling
# as text). image/part_catalog.rye carries the OTHER half: each product binds its sprite window to a part number,
# a material, and a price in cents (recorded as a FACT, a u64, never a balance the tree can move). A PartCatalog
# holds one SpriteIndex (the pictures) and one PartRecord per product (the facts) in the same held order; add_part
# grows both together so a part is never a window without facts. render_part_catalog / parse_part_catalog carry
# the whole thing as a flat-Bron format part-catalog-v1 record, so render(parse(render(x))) is a fixed point over
# BOTH the windows and the facts. No network, no key, no funds; disbursement stays a custody gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_part_catalog_witness.rish

say "hunk-part-catalog: Language EN — HUNK71 binds each marketplace product to its sprite window AND its honest facts: a part number, a material, and a price in cents."
say "hunk-part-catalog: Style Radiant — a part is a picture with its facts; render(parse(render)) is a fixed point over both halves, so a whole catalog crosses to text and home again losing neither a pixel nor a price."
say "hunk-part-catalog: Lens TAME — price is a u64 FACT, never a movable balance; fields are token-checked so a line always round-trips; named refusals; bounded buffers; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/part_catalog"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_catalog.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-catalog: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-part-catalog: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-part-catalog: ${out}"

assert selftest.out contains "GREEN part-catalog" else "hunk-part-catalog: selftest did not print the GREEN part-catalog line"

assert selftest.out contains "fixed point over" else "hunk-part-catalog: the selftest did not prove render(parse(render)) is a fixed point over both halves"

assert selftest.out contains "price in cents survive" else "hunk-part-catalog: the selftest did not prove the facts survive the round-trip"

assert selftest.out contains "no network, no key, no funds" else "hunk-part-catalog: the selftest did not affirm the custody floor (no funds)"

# HUNK4 stays GREEN -- the part catalog builds on the sprite index; the index underneath must still hold.
let sprite = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/sprite.rye -femit-bin=image/bin/sprite && image/bin/sprite selftest 2>&1"]
assert sprite.ok else "hunk-part-catalog: HUNK4 sprite re-run failed — ${sprite.out}"
assert sprite.out contains "GREEN image-sprite" else "hunk-part-catalog: HUNK4 sprite selftest did not stay GREEN"

say "hunk-part-catalog: GREEN — the parts marketplace carries a window AND its honest facts, travels as text, and rebuilds byte-for-byte on metal; HUNK4 index underneath stays GREEN. HUNK71 lands, the marketplace grows its facts."
