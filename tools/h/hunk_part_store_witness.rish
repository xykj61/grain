# tools/h/hunk_part_store_witness.rish -- the parts catalog is content-addressed (HUNK72).
#
# Season A (Hardware & Right-to-Repair) - waymark HUNK - parts-marketplace journey - rung HUNK72.
# Design read: active-designing/date/20260813/20260813-020035_double-seat-expansion-six-seasons.md (Season A -- parts marketplace).
# Teacher, thanked clean-room: McMaster-Carr's catalog (concept only, siloed -- a part is a picture PLUS its facts).
#
# HUNK71 made a parts catalog travel as a format part-catalog-v1 record (a window AND its facts per product);
# HUNK6 gave the sprite SHEET a content address. pond/apps/part_store.rye gives the CATALOG one: store_catalog
# renders the catalog to text and beads it content-addressed (HUNK1's Tablecloth store), and open_catalog fetches
# it back -- proving every bead against its digest and the whole against its recorded address BEFORE the text is
# parsed -- then parses it over a sheet into a fresh catalog. So a whole marketplace (pictures and prices) is
# reproducible from cold out of (sheet, catalog address): a tampered catalog refuses DigestMismatch and an unknown
# market refuses UnknownArtifact, each before a window or price is read. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_part_store_witness.rish

say "hunk-part-store: Language EN — HUNK72 gives the parts catalog a content address: store_catalog beads its text, open_catalog fetches it verified and parses it over a sheet into a fresh catalog."
say "hunk-part-store: Style Radiant — a whole marketplace, pictures and prices, reproduces from cold out of (sheet, name), losing neither a pixel nor a cent."
say "hunk-part-store: Lens TAME — the fetch proves every bead and the whole address BEFORE a window or price is read; a tampered catalog refuses DigestMismatch, an unknown market UnknownArtifact; bounded; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/part_store"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/part_store.rye -femit-bin=${bin}"]
assert build.ok else "hunk-part-store: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-part-store: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-part-store: ${out}"

assert selftest.out contains "GREEN part-store" else "hunk-part-store: selftest did not print the GREEN part-store line"

assert selftest.out contains "opens from cold" else "hunk-part-store: the selftest did not prove the marketplace opens from cold"

assert selftest.out contains "before a window or price is read" else "hunk-part-store: the selftest did not prove verify-before-read"

assert selftest.out contains "no network, no key, no funds" else "hunk-part-store: the selftest did not affirm the custody floor (no funds)"

# HUNK71 stays GREEN -- part_store banks the catalog HUNK71 renders; the catalog underneath must still hold.
let cat = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/part_catalog.rye -femit-bin=image/bin/part_catalog && image/bin/part_catalog selftest 2>&1"]
assert cat.ok else "hunk-part-store: HUNK71 part_catalog re-run failed — ${cat.out}"
assert cat.out contains "GREEN part-catalog" else "hunk-part-store: HUNK71 part_catalog selftest did not stay GREEN"

say "hunk-part-store: GREEN — the parts catalog is content-addressed; a whole marketplace opens from cold, verified before read, and rebuilds byte-for-byte on metal; HUNK71 catalog underneath stays GREEN. HUNK72 lands, the marketplace-facts arc closes."
