# tools/h/hunk_filter_strip_tap_witness.rish -- the tappable filter strip, on metal (HUNK65).
#
# Season A (Hardware & Right-to-Repair) - waymark HUNK - journey Photos app - rung HUNK65.
# Design read: active-designing/date/20260813/20260813-222956_hunk-filter-picker-exploration.md ("The road on from here").
# Teacher, thanked clean-room: the tappable filter row of a photo app (iCloud Photos / Instagram / VSCO) -- a keeper taps
# the thumbnail they want and the app selects that filter (concept only, siloed).
#
# HUNK64 painted the filter strip; this rung makes it tappable. FilterStripTap classifies a pixel tap into a filter band
# (x / band_px, the HUNK55 idiom) and selects that filter so paint's marker lands where the finger did, then commits the
# tapped filter into the history (HUNK16). No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_filter_strip_tap_witness.rish

say "hunk-filter-strip-tap: Language EN — HUNK65 turns the filter strip (HUNK64) into a tappable carousel; a pixel tap classifies into a filter band (the HUNK55 idiom), selects that filter, and commits it into the history (HUNK16)."
say "hunk-filter-strip-tap: Style Radiant — reading becomes choosing: a keeper taps the thumbnail they want, the marker lands under their finger, and the filter joins the picture — no discrete call, just a finger on the glass."
say "hunk-filter-strip-tap: Lens TAME — a pure composition over three proven seams; the band a keeper taps is the band the strip marks (no drift), a tap off the strip fires nothing, a bad thumbnail refuses BadThumb; the source is never mutated; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/filter_strip_tap"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/filter_strip_tap.rye -femit-bin=${bin}"]
assert build.ok else "hunk-filter-strip-tap: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-filter-strip-tap: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` -- the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe or brace in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-filter-strip-tap: ${out}"

assert out contains "GREEN filter-strip-tap" else "hunk-filter-strip-tap: selftest did not print the GREEN filter-strip-tap line"
assert out contains "a tap centered on band k selects filter k and the repainted marker sits on exactly band k for every filter (no drift)" else "hunk-filter-strip-tap: a tap drifted from the marked band"
assert out contains "a tap off the left edge and a tap past the last band each fire nothing (the selection unmoved)" else "hunk-filter-strip-tap: a tap off the strip moved the selection"
assert out contains "then committing pushes two edits and the view is the named filter byte-for-byte" else "hunk-filter-strip-tap: the tapped filter did not commit as the named recipe"
assert out contains "a zero-dimension thumbnail refuses BadThumb" else "hunk-filter-strip-tap: a zero-dimension thumbnail did not refuse BadThumb"

say "hunk-filter-strip-tap: GREEN — a tap centered on band k selects filter k with the marker landing on exactly band k (no drift), a tap off the strip fires nothing, a tapped filter commits into the history byte-for-byte, and a zero-dimension thumbnail refuses BadThumb; no network, no key, no funds."
