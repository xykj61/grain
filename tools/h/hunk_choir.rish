# tools/h/hunk_choir.rish -- the HUNK family's witnesses, sung as one roster row.
#
#   rishi/bin/rishi run tools/h/hunk_choir.rish
#
# Eighty-six witnesses cover the HUNK ladder -- Chapter A's open image module and the parts it grew
# -- and NOT ONE was reached by any pass. `witness_reach_scan.sh` counted every one `unheard`, the
# shape the row at `20260908.183635` books: a guard's reach is the roster rather than its own
# quality. Eighty-six roster rows would be one rule written eighty-six times.
#
# The discovery, the bound and the refusals live in `tools/fixtures/w/witness_family_scan.sh`, which
# is GENERIC: the first choir this tree wrote was bolted to one font, and the second family wanted
# the same thirty lines with one word changed. A family costs a roster row now rather than a file.

# reach-list: sh tools/fixtures/w/witness_family_scan.sh --dir tools/h --prefix hunk --list

say "hunk-choir: Style Gauge, Meter -- the family is discovered, bounded, and sung."
say "hunk-choir: Lens TAME -- a corpus of zero is a red rather than a reading."

say "hunk-choir: the control -- eleven behaviors, every refusal planted and then lifted..."
let ctl = run ["sh" "tools/fixtures/w/witness_family_control.sh"]
assert ctl.ok else "hunk-choir: the family control refused -- read its own pass/fail lines"
assert ctl.out contains "fail=0" else "hunk-choir: a planted refusal behaved differently than stated"

let scan = run ["sh" "tools/fixtures/w/witness_family_scan.sh" "--dir" "tools/h" "--prefix" "hunk"]
say scan.out
assert scan.ok else "hunk-choir: the family refused -- read its own verdict line above"

# invariant: the family answered ok, which the scan prints only after every member has run.
assert scan.out contains "verdict=ok" else "hunk-choir: the HUNK family did not answer ok"

# invariant: members were found at all; an empty corpus reporting success is the one failure this
# choir exists to prevent, and the scan exits non-zero on it rather than printing ok.
assert (scan.out contains "members=0") == false else "hunk-choir: a corpus of zero is a red, never a reading"

# invariant: every discovered member passed; one red fails the choir and names its path.
assert scan.out contains "reds=0" else "hunk-choir: a HUNK witness answered RED -- its path is printed above"

say "GREEN: hunk-choir -- every HUNK witness discovered, bounded, and sung under one row."
