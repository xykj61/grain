# tools/h/hunk_filter_preset_witness.rish -- the Photos app applies filters by name on metal (HUNK30).
#
# Season A (Hardware & Right-to-Repair) - waymark HUNK - journey Photos app - rung HUNK30.
# Design read: active-designing/date/20260813/20260813-181925_hunk-filter-preset-book-exploration.md
# Teacher, thanked clean-room: the named filter sets of Instagram / VSCO / iCloud Photos (concept only, siloed).
#
# HUNK29 closed the edit-list vocabulary -- every gesture the Photos app can do records, replays, and travels as
# data. This rung turns a recipe into a name. `image/filter_preset.rye` holds a `PresetBook` -- a bounded, named
# library of edit-list recipes -- and `apply_preset`, which looks a recipe up by name and replays it over ANY image
# (reusing HUNK11's pure `apply`, the source never touched). `stock_book` ships the well-known filters. The selftest
# proves a preset applied by name equals its recipe by hand byte-for-byte, that the SAME preset applies to a
# DIFFERENT image equalling that image's own recipe (the property a single content-addressed recipe cannot claim),
# that distinct presets differ, that a preset is deterministic and pure and re-encodes as an open image, and that an
# unknown name, a duplicate, a bad name, and a full book each refuse by name. No store, no beads, no network, no key.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_filter_preset_witness.rish

say "hunk-filter-preset: Language EN — HUNK30 turns a recipe into a name: a PresetBook of named edit-lists, applied by name over any image."
say "hunk-filter-preset: Style Radiant — filters by name are the real product: a keeper says `vivid` and the app knows the recipe, applied to any photo the source never touched."
say "hunk-filter-preset: Lens TAME — the book is bounded, names are bounded and copied into its own storage, apply is pure over a proven fold, every refusal named; no store, no beads, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/filter_preset"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/filter_preset.rye -femit-bin=${bin}"]
assert build.ok else "hunk-filter-preset: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-filter-preset: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-filter-preset: ${out}"

assert selftest.out contains "GREEN filter-preset" else "hunk-filter-preset: selftest did not print the GREEN preset line"

assert selftest.out contains "equals photos.saturate by hand byte-for-byte" else "hunk-filter-preset: a preset did not equal its recipe by hand"

assert selftest.out contains "applies to a DIFFERENT image equalling ITS own recipe" else "hunk-filter-preset: a preset was not proven to apply to any image"

assert selftest.out contains "distinct presets differ" else "hunk-filter-preset: distinct presets were not proven to differ"

assert selftest.out contains "deterministic and pure" else "hunk-filter-preset: a preset was not proven deterministic and pure"

assert selftest.out contains "re-encodes as an open image" else "hunk-filter-preset: a preset result did not re-encode as an open image"

assert selftest.out contains "refuses UnknownPreset before a verb runs" else "hunk-filter-preset: an unknown name did not refuse before a verb ran"

assert selftest.out contains "refuses PresetExists" else "hunk-filter-preset: the named define refusals did not all fire"
assert selftest.out contains "refuses BadPresetName" else "hunk-filter-preset: the named define refusals did not all fire"
assert selftest.out contains "refuses TooManyPresets" else "hunk-filter-preset: the named define refusals did not all fire"

# HUNK31 -- the whole book travels as a format filter-presets-v1 record, a fixed point.
assert selftest.out contains "format filter-presets-v1 record" else "hunk-filter-preset: the preset book did not travel as a filter-presets-v1 record"

assert selftest.out contains "render(parse(render)) is a fixed point and a rebuilt preset applies to the same bytes" else "hunk-filter-preset: the book round-trip fixed point was not proven"

assert selftest.out contains "each refuse BadBook" else "hunk-filter-preset: the malformed-book refusals did not fire"

say "hunk-filter-preset: GREEN — the Photos app applies filters by name and the book travels as text: a bounded book of named recipes replayed over any image, the source pure, distinct presets distinct, a curated book a fixed-point record, every refusal named."
