# tools/h/hunk_photos_editor_witness.rish — the unified Photos editor, on metal (HUNK66).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK66.
# Design read: active-designing/date/20260813/20260813-222956_hunk-filter-picker-exploration.md ("The road on from here").
# Teacher, thanked clean-room: the single editing surface of a photo app (iCloud Photos / Google Photos) — crop and
# filter are two tools over ONE undo stack (concept only, siloed).
#
# The crop sub-arc (HUNK60-62) and the filter sub-arc (HUNK63-65) each had their own history. This rung unifies them:
# PhotosEditor owns ONE EditCursor (HUNK16) both commit_crop and commit_filter push onto, so crop and filter edits
# interleave in one non-destructive history and undo/redo walk across both. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_photos_editor_witness.rish

say "hunk-photos-editor: Language EN — HUNK66 unifies the crop tool (HUNK62) and the filter tool (HUNK63) over ONE EditCursor (HUNK16); commit_crop and commit_filter push onto the same history, and undo/redo walk across both."
say "hunk-photos-editor: Style Radiant — the Photos app finally has one editing surface: a keeper crops, filters, and undoes across both tools without a seam — one stack, nothing ever lost."
say "hunk-photos-editor: Lens TAME — a pure composition over five proven seams; crop and filter interleave in one history, the crop frame re-syncs after every move, a bare crop refuses NoRect and a zero-dimension source EmptyImage; the source is never mutated; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/photos_editor"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/photos_editor.rye -femit-bin=${bin}"]
assert build.ok else "hunk-photos-editor: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-photos-editor: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe or brace in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-photos-editor: ${out}"

assert out contains "GREEN photos-editor" else "hunk-photos-editor: selftest did not print the GREEN photos-editor line"
assert out contains "a filter mono chain in ONE history (the view crop-then-filter byte-for-byte)" else "hunk-photos-editor: crop and filter did not chain in one history"
assert out contains "undo walks back the filter then the crop across both tools" else "hunk-photos-editor: undo did not walk across both tools"
assert out contains "recovers the source byte-for-byte" else "hunk-photos-editor: the history was not non-destructive"
assert out contains "the other order (filter mono then a crop) chains in one history too" else "hunk-photos-editor: the reverse order did not chain"
assert out contains "a bare crop refuses NoRect and a zero-dimension source refuses EmptyImage" else "hunk-photos-editor: the refusals did not fire"

say "hunk-photos-editor: GREEN — the Photos editor commits crop and filter into ONE non-destructive history that chains either order, walks across both tools with undo/redo (the crop frame following), recovers the source byte-for-byte, and refuses a bare crop NoRect and a zero-dimension source EmptyImage; no network, no key, no funds."
