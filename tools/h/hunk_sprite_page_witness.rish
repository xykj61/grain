# tools/h/hunk_sprite_page_witness.rish — a marketplace product page is seen on the canvas (HUNK5, sprite quest).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · Open Image journey · rung HUNK5.
# Design read: active-designing/date/20260813/20260813-201500_hunk-sprite-marketplace-index-exploration.md
# Teacher, thanked clean-room: McMaster-Carr's one-sprite-sheet render trick (concept only, siloed).
#
# HUNK4 made each product a bounded window into one decoded sheet; HUNK2 down-mapped a decoded image into
# Skate's palette-indexed cell grid. This rung joins them: `brushstroke/sprite_page.rye` `paint_product`
# renders a product's window (HUNK4's sprite.render, reusing HUNK3's crop) and down-maps that window to a Skate
# grid (HUNK2's image_skate.down_map), so a catalog entry is not only stored and windowed but SEEN. The
# selftest indexes two products into one two-tone sheet (red left, blue right) and proves each page carries its
# own window's color (red → slot 3, blue → slot 5), that the two pages differ (a page is seen as its own
# product, never a neighbor's), that the page equals a direct down-map of the window cell for cell (no drift
# between index and page), that lit pixels reach a real canvas, and that an unknown product refuses by name
# through the whole composition. Pure composition over public APIs — no new storage, codec, or palette. No
# network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_sprite_page_witness.rish

say "hunk-sprite-page: Language EN — HUNK5 joins HUNK4's window and HUNK2's down-map: a product page renders a product's window out of the one sheet and paints it to a Skate grid, so a catalog entry is seen."
say "hunk-sprite-page: Style Radiant — the page derives from exactly the window the index pins; it equals a direct down-map cell for cell, so the seen page can never drift from the product the catalog names."
say "hunk-sprite-page: Lens TAME — pure composition over public APIs; both grid axes fit the down-map ceilings; the unknown-product refusal travels before any paint; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/sprite_page"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/sprite_page.rye -femit-bin=${bin}"]
assert build.ok else "hunk-sprite-page: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-sprite-page: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-sprite-page: ${out}"

assert selftest.out contains "GREEN sprite-page" else "hunk-sprite-page: selftest did not print the GREEN page line"

assert selftest.out contains "pages differ" else "hunk-sprite-page: the selftest did not prove the two product pages differ"

assert selftest.out contains "equals a direct down-map cell for cell" else "hunk-sprite-page: the selftest did not prove the page equals a direct down-map"

# HUNK4 stays GREEN — the page reuses sprite.render; the index underneath must still hold.
let sprite = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/sprite.rye -femit-bin=image/bin/sprite && image/bin/sprite selftest 2>&1"]
assert sprite.ok else "hunk-sprite-page: HUNK4 sprite re-run failed — ${sprite.out}"
assert sprite.out contains "GREEN image-sprite" else "hunk-sprite-page: HUNK4 sprite selftest did not stay GREEN"

say "hunk-sprite-page: GREEN — a marketplace product page is rendered and seen on metal; HUNK4 index underneath stays GREEN. HUNK5 lands."
