# tools/h/hunk_photos_witness.rish — the first Photos verb crops the open grid on metal (HUNK3, quest close).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · opening journey Open Image · rung HUNK3.
# Design read: active-designing/date/20260813/20260813-144218_hunk-season-a-open-image-exploration.md
# Teacher, thanked clean-room: the common iCloud Photos / Google Photos crop gesture (concept only, siloed).
#
# HUNK0 decoded an image, HUNK1 gave it a content address, HUNK2 painted it; this rung closes the opening
# quest with the first thing a Photos app is for — a crop. `image/photos.rye` `crop` is a pure, bounded
# function over the decoded RGBA grid: it reads a rectangle and returns a fresh smaller image, the source
# untouched. The selftest crops a position-tagged image and proves every cropped pixel is exactly its source
# pixel, that the source is unmutated (pure), that the identity crop recovers the whole byte-for-byte, and
# that a cropped image is still an OPEN image — it re-encodes and round-trips through the codec byte-for-byte.
# An empty rectangle and rectangles past the right or bottom edge each refuse by name. No network, no key, no
# funds — the first user-facing verb, built on the open module rather than a proprietary one.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/h/hunk_photos_witness.rish

say "hunk-photos: Language EN — HUNK3 gives a keeper the first Photos verb: a crop, a pure bounded function over the decoded grid that reads a rectangle and returns a fresh open image, the source untouched."
say "hunk-photos: Style Radiant — a cropped image is still an open image: it re-encodes and round-trips byte-for-byte, so the first user-facing verb stands on the open module the whole quest built, never a proprietary one."
say "hunk-photos: Lens TAME — u32 coordinates checked in u64 so a rectangle can never wrap past the edge; the crop fits the codec's pixel ceiling; copy_disjoint per row; positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/photos"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/photos.rye -femit-bin=${bin}"]
assert build.ok else "hunk-photos: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-photos: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out

assert selftest.out contains "GREEN image-photos" else "hunk-photos: selftest did not print the GREEN crop line"

assert selftest.out contains "source untouched (pure)" else "hunk-photos: the crop did not leave the source untouched"

assert selftest.out contains "re-encodes and round-trips" else "hunk-photos: a cropped image did not round-trip as an open image"

say "hunk-photos: GREEN — the first Photos verb crops the open grid; pure, bounded, every pixel its source, refusals named."
