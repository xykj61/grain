# tools/font5x7_greek_witness.rish -- the open Greek-letters corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora and the wider-symbol corpora that opened next (tools/font5x7_box_witness.rish the light box marks,
# tools/font5x7_boxdouble_witness.rish the double, tools/font5x7_boxdiag_witness.rish the diagonal,
# tools/font5x7_boxarc_witness.rish the rounded corners, tools/font5x7_arrow_witness.rish the arrows,
# tools/font5x7_block_witness.rish the block elements, tools/font5x7_geometric_witness.rish the geometric marks,
# tools/font5x7_math_witness.rish the math/technical operators, tools/font5x7_currency_witness.rish the currency signs).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Greek-letters corpus: the twelve marks a science and
# engineering readout reaches for -- the three capitals a meter shows outright (Delta a change, Sigma a sum, Omega ohms)
# and the nine lowercase letters a formula names a quantity with (alpha, beta, gamma, theta, lambda, mu, pi, sigma,
# omega) -- at their real Unicode codepoints U+0394, U+03A3, U+03A9, U+03B1, U+03B2, U+03B3, U+03B8, U+03BB, U+03BC,
# U+03C0, U+03C3, U+03C9, each a 5x7 coverage grid drawn in the open as ASCII line art in image/font5x7_greek.rye,
# built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint, advance, and coverage byte
# byte-for-byte; all twelve letters look up present and carry the shared advance while an ASCII letter misses; no two
# letters share coverage (a real alphabet's glyphs differ); each letter reads within an honest legibility band; and the
# family orders hold -- the capital Omega out-inks the lowercase omega, and the capital Sigma out-inks the lowercase
# sigma. Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds
# -- the marks a surface reads the day it prints a quantity, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_greek_witness.rish

say "font5x7-greek: Language EN -- Season G font content; the twelve Greek letters (capital Delta, Sigma, Omega and lowercase alpha, beta, gamma, theta, lambda, mu, pi, sigma, omega) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a science readout prints when it names a quantity."
say "font5x7-greek: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-greek: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - greek_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_greek"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_greek.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-greek: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-greek: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-greek: ${out}"

assert selftest.out contains "GREEN image-font5x7-greek" else "font5x7-greek: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-greek: round-trip was not byte-identical"

say "font5x7-greek: GREEN -- the open Greek-letters corpus whole; twelve marks round-trip byte-identical, all present, distinct, and legible, the capital Omega out-inking the lowercase omega and the capital Sigma the lowercase sigma; the font gains the marks a science readout prints when it names a quantity."
