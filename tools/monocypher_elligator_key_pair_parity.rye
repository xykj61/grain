//! tools/monocypher_elligator_key_pair_parity.rye — our authored crypto/elligator_key_pair.rye asked for its OWN hidden keypairs over the same
//! sixteen seeds the Monocypher C harness (tools/fixtures/monocypher_elligator_key_pair_harness.c) prints, so
//! tools/crypto_monocypher_elligator_key_pair_parity_witness.rish can diff our bytes against the vendored Monocypher's C byte-for-byte — the
//! hidden keypair that closes the Elligator key-hiding arc, proven against the audit's parity target. Season G (Cryptography · Rye-native,
//! Monocypher-parity, audit-ready).
//!
//! Thirty-two lines print, identical in shape to the C harness: for each of sixteen deterministic seeds seed[j] = (i*7 + j*3 + 1) mod 256, the
//! 64-hex secret_key then the 64-hex hidden (representative). The witness diffs our thirty-two against Monocypher's thirty-two.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/elligator_key_pair.rye (reached through the
//! tools/elligator_key_pair.rye symlink, since Rye resolves imports beside the importing file, over the elligator/x25519_dirty/chacha20/fe25519
//! symlinks beneath it). Purely local — no key, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/monocypher_elligator_key_pair_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const ekp = @import("elligator_key_pair.rye");

/// print_hex — 32 bytes as 64 lowercase hex characters, one line, exactly the C harness's `ph`.
fn print_hex(b: [32]u8) void {
    var i: u32 = 0;
    while (i < 32) : (i += 1) print("{x:0>2}", .{b[i]});
    print("\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    // invariant (construction): the harness runs exactly sixteen deterministic seeds, the count the C harness prints.
    const cases: u32 = 16;
    assert(cases == 16);

    var i: u32 = 0;
    while (i < cases) : (i += 1) {
        var seed: [32]u8 = undefined;
        var j: u32 = 0;
        while (j < 32) : (j += 1) seed[j] = @as(u8, @truncate(i *% 7 +% j *% 3 +% 1));
        const kp = try ekp.key_pair(&seed);
        print_hex(kp.secret_key);
        print_hex(kp.hidden);
    }
    // invariant (postcondition): all sixteen cases printed exactly once, two lines each.
    assert(i == cases);
    return 0;
}
