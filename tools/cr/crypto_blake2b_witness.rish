# tools/cr/crypto_blake2b_witness.rish — BLAKE2b-512 authored in pure Rye: Season G's first crypto primitive, proven against the RFC 7693
# known-answer and byte-for-byte against an independent implementation (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-180728_open-season-g-crypto-blake2b.md
# Kin: the decision wave (active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md) seats Season G. Monocypher
# (vendor/monocypher, CC0/BSD-dual) is the parity TARGET, never a copied line — our own arithmetic, studied clean-room from the public
# RFC and Monocypher's public API (.claude/rules/gratitude-licenses.md).
#
# crypto/blake2b.rye authors BLAKE2b-512 from the algorithm — the IV, the SIGMA schedule, the G mixing function, twelve rounds of
# compression, the byte counter and final-block flag. The primitive calls no std.crypto. Parity is proven at selftest against two
# references runnable now: the RFC 7693 Appendix A known-answer for "abc" and the empty message (hex for hex), and Zig's own
# std.crypto BLAKE2b as an independent implementation (byte-for-byte over the empty message, "abc", an exact-128-byte boundary, and a
# 200-byte multi-block input). The vendored Monocypher source is a held network fetch, so Monocypher-source parity is an honest horizon
# rung; Monocypher passes the same RFC vectors and adds as a third target later. An over-long message refuses MessageTooLong before a
# byte is mixed. Purely local arithmetic — no key, no signature, no network, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cr/crypto_blake2b_witness.rish

say "crypto-blake2b: Language EN — Season G (Cryptography) opens with the crux-first, highest-Lindy primitive: BLAKE2b-512, the hash Monocypher itself signs with, so the whole Rye-native signing stack will stand on this one stone. Pure 64-bit integer arithmetic, no big-integer field math, so it is genuinely buildable in authored Rye this round, and it carries a published RFC 7693 known-answer that ties parity to a neutral public reference."
say "crypto-blake2b: Style Radiant — the law is stated positively: twelve rounds of the G mixing function under the SIGMA permutation fold 128-byte blocks into an eight-word chaining value, every add mod 2^64, every rotation a fixed constant (32, 24, 16, 63), a byte counter and a final-block flag binding the whole message to one 64-byte digest anyone can replay against the RFC."
say "crypto-blake2b: Lens TAME — the primitive calls no std.crypto; it is authored from the algorithm, bounded input (max_message_bytes), contract asserts on every function, wrapping +% where the math is mod 2^64, comptime index bounds proven in the G function. Parity holds against the RFC 7693 known-answer AND Zig's independent std.crypto BLAKE2b byte-for-byte over the empty message, \"abc\", an exact-128-byte boundary, and a multi-block input; an over-long message refuses MessageTooLong before a byte is mixed. Monocypher-source parity is now closed on metal — tools/cr/crypto_monocypher_parity_witness.rish compiles the vendored Monocypher and proves our Rye equals its C byte-for-byte over these same four messages. Purely local — no key, no signature, no network, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/blake2b"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/blake2b.rye -femit-bin=${bin}"]
assert build.ok else "crypto-blake2b: build failed — ${build.err}"

let outfile = "crypto/bin/blake2b.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-blake2b: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-blake2b: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-blake2b' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-blake2b: selftest did not print the GREEN crypto-blake2b line"
