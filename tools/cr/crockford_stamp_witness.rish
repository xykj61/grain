# crockford_stamp_witness.rish — Hands We Grow Decision 6 aura faces.
#
#   rishi/bin/rishi run tools/cr/crockford_stamp_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "linengrow/bin/crockford_stamp_witness"

let build = run ["sh" "-c" "mkdir -p linengrow/bin && env RYE_ZIG=${zig} rye/bin/rye build linengrow/crockford_stamp_witness.rye -femit-bin=${bin}"]
assert build.ok else "Crockford stamp witness build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "Crockford stamp witness exited non-zero"
assert selftest.out contains "GREEN" else "Crockford stamp witness not GREEN"
assert selftest.out contains "wire-le round-trip" else "Crockford missing wire LE round-trip"
assert selftest.out contains "rejected banned char" else "Crockford missing I/L/O/U reject"
assert selftest.out contains "rejected over-long" else "Crockford missing over-long reject"
assert selftest.out contains "case-insensitive decode" else "Crockford missing case-insensitive decode"

say "GREEN: Crockford stamp aura witness passed (bijection · thirteen · negatives)."
