# tools/cr/crypto_ed25519_to_x25519_witness.rish — the birational Edwards↔Montgomery key conversion authored in pure Rye: Season G's next rung,
# the identity-unification map that lets one Ed25519 key both sign and agree, proven against the RFC 7748 §4.1 base-point relationship
# (Edwards base ↔ u = 9) and byte-for-byte against Zig's independent std.crypto.ecc.Edwards25519 and std.crypto.dh.X25519 (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G names the crypto parity wave; this
# rung unifies the identity story so Kumara's one key serves both signing and key agreement).
# Kin: crypto/fe25519.rye (the GREEN base field beneath both maps) · crypto/x25519.rye (the key agreement the forward map feeds) ·
# crypto/ed25519_sign.rye (the signing the same key serves). Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity TARGET — its
# crypto_eddsa_to_x25519 / crypto_x25519_to_eddsa compute the same maps — never a copied line, studied clean-room from the public RFC and API
# (.claude/rules/gratitude-licenses.md).
#
# crypto/ed25519_to_x25519.rye authors the two maps of RFC 7748 §4.1: eddsa_to_x25519 lifts an Ed25519 public key's y-coordinate to the
# Montgomery u = (1 + y)/(1 − y) — the same X25519 public key that identity's secret scalar would produce — and x25519_to_eddsa inverts it,
# y = (u − 1)/(u + 1), returning the canonical sign-0 Edwards encoding. Each map is one add, one subtract, and one inverse-multiply over the
# GREEN base field, adds no new field mathematics, calls no std.crypto, and verifies its own inverse against the field as a postcondition.
# Parity is proven at selftest against two references runnable now: the published RFC 7748 §4.1 base-point relationship (the Edwards base's
# y = 4/5 maps to u = 9 exactly, and back), and our maps bridge Zig's independent Edwards25519 and X25519 public keys byte-for-byte across a
# deterministic spread of clamped scalars, with a reverse-then-forward round-trip recovering each u exactly. The vendored Monocypher source is a
# held network fetch, so Monocypher-source parity is an honest horizon rung. Purely local over TEST keys — no real identity key, no network, no
# funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cr/crypto_ed25519_to_x25519_witness.rish

say "crypto-ed25519-to-x25519: Language EN — Season G's identity-unification rung: the birational Edwards↔Montgomery key conversion authored in pure Rye. Curve25519 and edwards25519 are the same curve in two coordinate systems, so one Ed25519 identity key can both sign (on the Edwards curve) and agree a shared secret (as an X25519 key). This map is the bridge — eddsa_to_x25519 forward, x25519_to_eddsa back — so Kumara's one key need not carry a second, separate key for the sealed session."
say "crypto-ed25519-to-x25519: Style Radiant — the law is stated positively: RFC 7748 §4.1 fixes u = (1 + y)/(1 − y) and its inverse y = (u − 1)/(u + 1). The forward map drops the Ed25519 sign bit, lifts y to the Montgomery u, and packs the X25519 public key; the reverse map lifts u back to the canonical sign-0 Edwards y-encoding. Each is one add, one subtract, and one inverse-multiply over the GREEN base field — no new field mathematics — and the classic checkpoint holds: the Edwards base point's y = 4/5 maps to u = 9 exactly."
say "crypto-ed25519-to-x25519: Lens TAME — the maps call no std.crypto and each verifies its own inverse against the field (u·(1 − y) = 1 + y) as a postcondition, asserted wherever the inverse is defined. Parity holds against the published RFC 7748 §4.1 base-point relationship AND Zig's independent std.crypto.ecc.Edwards25519 and std.crypto.dh.X25519 public keys byte-for-byte across twenty-four deterministic clamped scalars, with a reverse-then-forward round-trip. Monocypher-source parity is a named horizon behind the held vendor fetch. Purely local over TEST keys — no real identity key, no network, no funds, no device; constant-time timing-safety stays a separate named horizon, and converting the maintainer's own identity key stays the custody gate."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/ed25519_to_x25519"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/ed25519_to_x25519.rye -femit-bin=${bin}"]
assert build.ok else "crypto-ed25519-to-x25519: build failed — ${build.err}"

let outfile = "crypto/bin/ed25519_to_x25519.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-ed25519-to-x25519: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-ed25519-to-x25519: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-ed25519-to-x25519' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-ed25519-to-x25519: selftest did not print the GREEN crypto-ed25519-to-x25519 line"
