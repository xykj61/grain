# tools/cr/crypto_slip10_ed25519_witness.rish — SLIP-0010 hierarchical-deterministic ed25519 keys authored in pure Rye, authoring NO new
# cryptography. The identity arc's HD rung: where crypto/bip32.rye grows a secp256k1 wallet tree by an additive child law, SLIP-0010 grows an
# ed25519 tree by taking the child key as I_L DIRECTLY and deriving hardened-only — the bridge from a BIP-39 wallet seed to a whole tree of
# Grain's OWN ed25519 identity keys (Kumara signs with ed25519). master_from_seed runs the fixed "ed25519 seed" HMAC; ckd_priv derives a hardened
# child; public_key emits the 33-byte 0x00-prefixed compressed key (crypto · Season G).
#
# Season: crypto — Season G (the Six-Season double-seat). This rung contributes only the tree grammar — the master and hardened-child HMAC data
# forms and the ser32 index encoding — over crypto/hmac_sha512.rye and crypto/ed25519_sign.rye, both already proven byte-for-byte on metal. Design
# read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G · the crypto parity wave).
# Clean-room: SLIP-0010 and its ed25519 test vectors are a public standard; the derivation is ours, standing on our own parity-GREEN HMAC-SHA-512
# and ed25519 public derivation, never a copied line (.claude/rules/gratitude-licenses.md).
#
# Parity is proven at selftest the replayable way the tree favours, against SLIP-0010's OWN published ed25519 test vectors (the spec's own
# known-answers, quoted character for character from the canonical satoshilabs/slips slip-0010.md, never fabricated): both Test Vector 1 (seed
# 000102…0f) and Test Vector 2 (the 64-byte seed) walk EVERY chain node hardened, and at each node the private key I_L, the chain code I_R, AND the
# 33-byte public key 0x00 ‖ ed25519_public(I_L) reproduce EXACTLY the spec's published bytes — proving the master HMAC, the hardened child HMAC,
# the ser32 index encoding, and the ed25519 public derivation together against a real standard answer. A non-hardened index raises NotHardened and
# an over-deep path raises DepthTooDeep. Purely local — every key is a TEST key from the spec's own seeds, no network, no funds; growing a real
# Kumara identity tree and signing with its key stays the custody gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cr/crypto_slip10_ed25519_witness.rish

say "crypto-slip10-ed25519: Language EN — SLIP-0010 hierarchical-deterministic ed25519 keys: the identity arc's HD rung, the bridge from a BIP-39 wallet seed to a whole tree of Grain's OWN ed25519 identity keys (Kumara signs with ed25519). Where crypto/bip32.rye grows secp256k1 keys by an additive child law, SLIP-0010 takes the child key as I_L directly and derives hardened-only: master I = HMAC-SHA-512(\"ed25519 seed\", seed), child I = HMAC-SHA-512(c_par, 0x00 ‖ ser256(k_par) ‖ ser32(i)), public 0x00 ‖ ed25519_public(I_L). Authors no new cryptography — every byte is the GREEN crypto/hmac_sha512.rye PRF and crypto/ed25519_sign.rye's public derivation. With this rung the identity arc stands: phrase → seed → ed25519 HD tree."
say "crypto-slip10-ed25519: Style Radiant — one backup phrase, and beneath it the whole tree of a keeper's ed25519 identity keys, each grown hardened from the last. The same seed a Bitcoin wallet reads, turned toward Grain's own signing identity, authored in the open and proven against the standard's own answers."
say "crypto-slip10-ed25519: Lens TAME — every width named (two 32-byte HMAC halves, a 33-byte public key, a 4-byte big-endian index, depth bounded at thirty-two), contract asserts on the master depth, the child depth, and each split; it calls no cryptography of its own, only the GREEN crypto/hmac_sha512.rye and crypto/ed25519_sign.rye beneath. Parity holds against SLIP-0010's OWN published ed25519 test vectors 1 and 2: every chain node's private key, chain code, and 0x00-prefixed public key reproduce EXACTLY the spec's bytes. The derive walker agrees with the step-by-step walk byte-for-byte; a non-hardened index raises NotHardened and an over-deep path raises DepthTooDeep. Purely local — TEST keys only, no real identity key, no network, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/slip10_ed25519"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/slip10_ed25519.rye -femit-bin=${bin}"]
assert build.ok else "crypto-slip10-ed25519: build failed — ${build.err}"

let outfile = "crypto/bin/slip10_ed25519.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-slip10-ed25519: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-slip10-ed25519: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-slip10-ed25519' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-slip10-ed25519: selftest did not print the GREEN crypto-slip10-ed25519 line"
