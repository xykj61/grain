# tools/cr/crypto_ed25519_sign_witness.rish — Ed25519 SIGNING authored in pure Rye: Season G's thirteenth rung, the near side of the Lotus signed
# carry and the mirror of the verifier. Given a 32-byte secret seed and a message, sign produces the 64-byte signature R ‖ S the verifier accepts,
# by the RFC 8032 §5.1.6 procedure, composing every GREEN arithmetic rung. Proven byte-for-byte against an independent implementation and round-
# tripped through our own GREEN verifier (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
# Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G: "once a Rye signing primitive is
# parity-GREEN, Lotus's signed carry becomes buildable — the library is engineering; signing with the maintainer's own identity key stays the gate").
# Kin: crypto/ed25519_muladd.rye · crypto/ed25519_scalar.rye · crypto/ed25519_scalarmul.rye · crypto/ed25519_group.rye · crypto/ed25519_decode.rye ·
# crypto/sha512.rye · crypto/ed25519_verify.rye (all GREEN). Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity TARGET, never a copied line
# — our own composition, studied clean-room from RFC 8032 (.claude/rules/gratitude-licenses.md).
#
# crypto/ed25519_sign.rye expands the seed through SHA-512 into the clamped secret scalar a and the prefix, publishes A = compress([a]B), derives
# the nonce r = SHA-512(prefix ‖ M) mod L, forms R = compress([r]B), derives the challenge k = SHA-512(R ‖ A ‖ M) mod L, and sets S = (r + k·a) mod L
# over the GREEN multiply-add — the signature is R ‖ S. The base point B is DERIVED (decode of y = 4/5), never a pasted literal. Signing is
# deterministic. The primitive calls no std.crypto. Parity is proven at selftest against Zig's own std.crypto.sign.Ed25519 as an independent RFC 8032
# implementation — across a spread of deterministic seeds and messages, our derived public key equals Zig's byte-for-byte and our signature equals
# Zig's byte-for-byte — and by round-tripping every signature through our own GREEN verifier (genuine accepts, a one-byte tamper refused), and by
# confirming determinism and the named message bound. The vendored Monocypher source is a held network fetch, so Monocypher-source parity is an
# honest horizon rung. This rung holds a secret scalar and signs, so a constant-time signing path is the Season's named timing HORIZON. Purely local
# — it signs only TEST seeds: no real key, no network, no funds, no real device; signing with the maintainer's own identity key stays its own gated
# round.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/cr/crypto_ed25519_sign_witness.rish

say "crypto-ed25519-sign: Language EN — Season G's thirteenth rung: Ed25519 signing authored in pure Rye, the near side of the Lotus signed carry and the mirror of the verifier. Given a 32-byte secret seed and a message, sign produces the 64-byte signature R ‖ S the verifier accepts. It signs only TEST seeds a selftest generates — a test seed is not the maintainer's identity key. Signing with the maintainer's own identity key stays its own separate, GATED round — no custody gate is crossed here."
say "crypto-ed25519-sign: Style Radiant — the law is stated positively as the RFC 8032 §5.1.6 procedure: expand the seed through SHA-512 into the clamped secret scalar a and the prefix, publish A = compress([a]B), derive r = SHA-512(prefix ‖ M) mod L, form R = compress([r]B), derive k = SHA-512(R ‖ A ‖ M) mod L, and set S = (r + k·a) mod L over the GREEN multiply-add. It writes no new mathematics — it composes the GREEN SHA-512, scalar reduction, scalar ladder, point compression, and multiply-add. The base point B is DERIVED (decode of y = 4/5), never a pasted literal. Signing is deterministic."
say "crypto-ed25519-sign: Lens TAME — the primitive calls no std.crypto; it asserts its contracts on every function (the clamp's cofactor and range, the pure-function derivation, the non-identity key, the canonical S, the named message bound), and bounds every hash buffer by a named maximum. Parity holds against Zig's independent std.crypto.sign.Ed25519 — derived public key and signature both byte-for-byte across a spread of deterministic seeds and messages — round-trips through our own GREEN verifier (genuine accepts, a one-byte tamper refused), confirms determinism, and refuses an oversize message. Monocypher-source parity is a named horizon behind the held vendor fetch. This rung holds a secret scalar; a constant-time signing path is the Season's named timing horizon, wanting measurement not a claim."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/ed25519_sign"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/ed25519_sign.rye -femit-bin=${bin}"]
assert build.ok else "crypto-ed25519-sign: build failed — ${build.err}"

let outfile = "crypto/bin/ed25519_sign.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-ed25519-sign: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-ed25519-sign: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-ed25519-sign' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-ed25519-sign: selftest did not print the GREEN crypto-ed25519-sign line"
