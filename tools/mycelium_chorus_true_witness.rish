# tools/mycelium_chorus_true_witness.rish — a quorum reads a real ledger record true (r4, the arc closes).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the Chorus · rung r4.
# r1 fixed the crux (a quorum of independent Vouchers is believed only when a threshold of distinct nodes
# agree), r2 let the whole quorum travel, r3 read it across a Knot — all over Dags seated in code. This
# closing rung (mycelium/chorus_true.rye, mirroring voucher_true) carries the quorum onto a REAL on-disk
# Cord record a keeper can open and hash, proving the property the whole Chorus rests on: the agreed
# position is TRUE TO THE BYTES, the distinct count the threshold reads is the count of members present,
# and every member's order-head is the order the fixture folds. The corpus reuses the Lapse's own fixture
# tools/fixtures/lapse_dag.bron (a funder credits Alice 200; a pledge to Bob lapses and comes home; a
# pledge to Carol stays open), @embedFile-bound through the mycelium/corpora/ symlink — no network.
#
# The crux this witness proves is TWO TOOLS, ONE ANSWER: the app parses the record through cord_bron,
# rebuilds the Dag under cord.add (re-verifying every signature), gathers a three-node quorum over the
# genesis-funded account, and emits the agreed triple; the independent statement_dag_truth.awk names the
# identical position (app.out == awk.out enforced). The quorum is honest: believed at threshold three yet
# refused at four (the distinct count the threshold reads is the members present), every member's
# recomputed order-head matching its signed one, and the quorum checks against the ledger it vouches; a
# tampered header refuses BadFormat. Composes cord_bron + cord + lapse + statement + voucher + chorus +
# kumara public API only; demo node/keeper seeds — no key, no funds, no network, no custody.
#
# Scope: active-designing/date/20260813/20260813-102533_mycelium-chorus-quorum-attestation-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_chorus_true_witness.rish

say "mycelium-chorus-true: Language EN — a mesh's quorum of a holder's standing, read off a real ledger record a keeper can open and hash, agrees field for field with an independent reading of the same bytes — the position no node invented and none double-counted."
say "mycelium-chorus-true: Style Radiant — the whole Chorus arc lands on the tree's own bytes: three distinct voices agree the funded account's position, the distinct count the threshold reads the members present, every voice bound to the fixture's own agreed order."
say "mycelium-chorus-true: Lens TAME — the app rebuilds the real Dag under cord.add, gathers a quorum, and emits the agreed triple; awk reads the same bytes; app.out == awk.out; believed at three, refused at four; a tampered header refuses; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/chorus_true"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/chorus_true.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-chorus-true: build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "mycelium-chorus-true: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-chorus-true: selftest did not speak GREEN"
assert selftest.out contains "the quorum's account key and its balance · reserved · received match an independent reading" else "mycelium-chorus-true: true-to-bytes claim missing"
assert selftest.out contains "the distinct count the threshold reads is exactly the three members present" else "mycelium-chorus-true: distinct-count claim missing"
assert selftest.out contains "the quorum checks against the real ledger it vouches" else "mycelium-chorus-true: check-against claim missing"
assert selftest.out contains "a tampered header refused BadFormat" else "mycelium-chorus-true: tamper-refusal claim missing"
assert selftest.out contains "The Mycelium Chorus's agent-doable arc closes" else "mycelium-chorus-true: arc-close claim missing"

# The crux — two tools, one answer. The app's measure tuple must equal awk's reading of the same bytes.
let app = run ["sh" "-c" "${bin} measure 2>&1"]
assert app.ok else "mycelium-chorus-true: app measure exited non-zero"
let awk = run ["sh" "-c" "awk -f tools/fixtures/statement_dag_truth.awk tools/fixtures/lapse_dag.bron"]
assert awk.ok else "mycelium-chorus-true: awk truth read failed"
assert awk.out contains "bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5 100 100 200" else "mycelium-chorus-true: awk tuple not the funded account · balance 100 · reserved 100 · received 200"
assert app.out == awk.out else "mycelium-chorus-true: app and awk disagree — the agreed position drifted from the bytes"

# The Chorus r1 whose quorum this rung reads over a real record stands at the door — its own selftest
# proves the machinery the reading rests on.
let chorus = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/chorus.rye -femit-bin=mycelium/bin/chorus && mycelium/bin/chorus 2>&1"]
assert chorus.ok else "mycelium-chorus-true: the Chorus r1 this rung reads over a real record is not GREEN"
assert chorus.out contains "GREEN" else "mycelium-chorus-true: the Chorus r1 did not speak its GREEN"

say "mycelium-chorus-true: GREEN — a real ledger record is vouched true by a three-node quorum (app==awk, the funded account bc7cbcb5… · balance 100 · reserved 100 · received 200), the distinct count the threshold reads the members present (believed at three, refused at four), every member's order-head the fixture's own agreed order, checking against the ledger it vouches, a tampered record refused; the Chorus r1 stands at the door. The Mycelium Chorus's agent-doable arc closes."
