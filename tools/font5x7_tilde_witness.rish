# tools/font5x7_tilde_witness.rish -- the open tilde-accent vowels corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, and the three accent corpora already drawn -- the acute/cedilla corpus
# (tools/font5x7_latin1_witness.rish), the grave vowels (tools/font5x7_grave_witness.rish), and the circumflex vowels
# (tools/font5x7_circumflex_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn tilde-accent vowels corpus: the two tilde lowercase vowels a
# Portuguese name reaches for -- a tilde, o tilde -- at their real Unicode codepoints U+00E3, U+00F5, each a 5x7 coverage
# grid drawn in the open as ASCII line art in image/font5x7_tilde.rye, built into a gfa1 atlas and proven on metal. A full
# round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; both letters look up present and carry
# the shared advance while an unaccented ASCII vowel misses; the two letters carry distinct coverage; each reads within an
# honest legibility band; and the tilde placement holds as the FOURTH lean beside acute/grave/circumflex -- every tilde
# mark is a wave spanning BOTH halves of the top two rows and cresting to the right of center, where an acute leans right
# only, a grave left only, and a circumflex peaks dead-center. Compression is reported as a fact, never asserted -- the
# round-trip is the proof. No network, no key, no funds -- the marks a surface reads the day it prints Sao Paulo or Joao.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_tilde_witness.rish

say "font5x7-tilde: Language EN -- Season G font content; the two tilde-accent lowercase vowels (a tilde, o tilde) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a civic surface prints when it spells a Portuguese keeper's own name -- Sao Paulo, Joao, coracao, irma."
say "font5x7-tilde: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; the tilde is the fourth lean, a wave that spans both halves where acute/grave/circumflex each lean one way, our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-tilde: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - tilde_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_tilde"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_tilde.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-tilde: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-tilde: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-tilde: ${out}"

assert selftest.out contains "GREEN image-font5x7-tilde" else "font5x7-tilde: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-tilde: round-trip was not byte-identical"

assert selftest.out contains "a wave spanning both halves" else "font5x7-tilde: tilde marks did not all span both halves"

say "font5x7-tilde: GREEN -- the open tilde-accent vowels corpus whole; two marks round-trip byte-identical, all present, distinct, and legible, every mark a wave spanning both halves as the fourth lean beside acute/grave/circumflex; the font gains the nasal vowels a civic surface needs to spell a Portuguese name that ASCII cannot."
