# settlement_constellation_witness.rish — the Sui settlement constellation.
#
# Proves JARL's settlement, shrunk to Sui's owned/shared split. A galaxy and its d60
# settle across five transitions — genesis, mint (spawn by capability), transfer,
# rotate (keys rotate while the keeper sits cold, a reset outranking a key bump), and
# escape (a child re-parents by its own word and the new sponsor's adoption). The
# shared surface is a small **commitment** — point, tier, sponsor, version, and a
# digest binding the owned **deed** — and it verifies a current deed while refusing a
# stale one, a tampered one, and a ghost. Every ledger refusal holds.
#
# Build first:  rye build settlement/constellation.rye -femit-bin=settlement/bin/constellation
#   rishi/bin/rishi run tools/settlement_constellation_witness.rish

let st = run ["settlement/bin/constellation" "selftest"]
assert st.ok else "settlement constellation selftest must exit 0"
assert (st.err contains "GREEN") else "settlement constellation must report GREEN"
assert (st.err contains "settle across five transitions") else "a galaxy and its d60 settle across five transitions"
assert (st.err contains "spawn by capability") else "children settle by a signed spawn capability"
assert (st.err contains "keeper that never moves") else "rotation heals the wire while the keeper sits cold"
assert (st.err contains "reset that outranks a key bump") else "a reset outranks a key rotation"
assert (st.err contains "sponsorship is a default, never a cage") else "a child may escape its default sponsor"
assert (st.err contains "escapes to a sibling star") else "escape re-parents to a settled sponsor one tier up"
assert (st.err contains "the shared surface is a small commitment") else "the surface is a small commitment, not the whole record"
assert (st.err contains "keys ride the fast path in the deed") else "the keys live in the owned deed, never on the shared surface"
assert (st.err contains "refuses a stale one, a tampered one, and a ghost") else "the surface refuses a stale, tampered, or ghost deed"
assert (st.err contains "every refusal holds") else "the ledger owes its refusals"
assert (st.err contains "a galaxy that cannot escape") else "a galaxy is root and cannot escape"
assert (st.err contains "a small shared commitment binds each owned deed") else "a small shared commitment binds each owned deed"
assert (st.err contains "settles once under its rightful sponsor") else "a number settles once, under its real place in the fractal"

say "GREEN: settlement constellation — the shared surface shrinks to a small commitment binding each owned deed; the five transitions hold, a current deed verifies while a stale, tampered, or ghost deed refuses, and every ledger refusal stands."
