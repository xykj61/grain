# mandate_named_serve_witness.rish — Mandate matches resolved to spoken names.
#
# Proves the resolution half of "served over Comlink, resolved to a spoken name": a
# query's matches resolve through the shared name registry to WHO — the spoken name a
# point wears — via names.rye's public sign_claim (the helper that unblocks claiming a
# name from outside that module). A point with no name resolves named=false, never a
# fabricated name.
#
# Build first:  rye build mandate/named_serve.rye -femit-bin=mandate/bin/named_serve
#   rishi/bin/rishi run tools/mandate_named_serve_witness.rish

let st = run ["mandate/bin/named_serve" "selftest"]
assert st.ok else "mandate named_serve selftest must exit 0"
assert (st.err contains "GREEN") else "mandate named_serve must report GREEN"
assert (st.err contains "resolves each match to WHO") else "a named query resolves matches to who"
assert (st.err contains "not merely a number") else "a search returns a name, not just a number"
assert (st.err contains "named=false, never a fabricated name") else "an unnamed point resolves honestly, never fabricated"
assert (st.err contains "public sign_claim") else "names are claimed via names.rye public sign_claim"
assert (st.err contains "both ways") else "the registry resolves name-to-point and point-to-name"

say "GREEN: mandate named_serve — a query's matches resolved to spoken names over the shared registry: who, not just which number, witnessed."
