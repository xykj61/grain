# tools/crypto_secp256k1_scalarmul_witness.rish — scalar multiplication on secp256k1 authored in pure Rye, composed entirely over the GREEN
# group law (crypto/secp256k1_group.rye): the last arithmetic rung before ECDSA verification and public-key recovery, the reach the
# Bitcoin/Ethereum address arc (Base58Check, Bech32, Keccak-256, RIPEMD-160, EIP-55) was climbing toward. Proven against algebraic
# known-answers and byte-for-byte against an independent implementation (Season G · Cryptography).
#
# Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, parity-checked, audit-ready).
# Design read: active-designing/20260816-022000_secp256k1-group-law-the-proven-curve.md (the group law this composes over) and
# active-designing/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (the priority spine: Rye first, Glow on green Rye).
# Kin: crypto/secp256k1_group.rye (the group this composes over, GREEN) · crypto/fe_secp256k1.rye (the base field beneath, GREEN) ·
# crypto/ed25519_scalarmul.rye (the sibling ladder). secp256k1 is not in Monocypher, so its source parity is not a rung here; the reference
# known-answers plus Zig's independent std.crypto are the two witnesses (.claude/rules/gratitude-licenses.md).
#
# crypto/secp256k1_scalarmul.rye computes k·P by the double-and-add ladder: walk the 32-byte little-endian scalar from its high bit down,
# double the accumulator at every bit and add P where the bit is set, starting from the group identity (the point at infinity, Z = 0). Because
# the complete formulas beneath are exception-free, the ladder needs no special case for the identity accumulator or for adding a point to
# itself; it composes only point doubling and point addition, no field inversion. Deliberately variable-time (it branches on scalar bits),
# correct but not yet timing-safe — a constant-time ladder for secret scalars stays a named horizon. The primitive calls no std.crypto. Parity
# is proven at selftest against two references runnable now: algebraic known-answers (0·G is the point at infinity, 1·G is G, 2·G is the
# doubling of G, (k+1)·G is k·G plus G), and Zig's own std.crypto.ecc.Secp256k1.mul byte-for-byte on the affine coordinates of k·P across a
# spread of scalars over both the base point and 3·G. Purely local — a scalar and a point are arithmetic, not a secret and not a signature:
# no real key, no signing (ECDSA signing stays its own gated round), no network, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/crypto_secp256k1_scalarmul_witness.rish

say "crypto-secp256k1_scalarmul: Language EN — scalar multiplication on secp256k1 authored in pure Rye, composed entirely over the GREEN group law (crypto/secp256k1_group.rye) and, beneath it, the GREEN base field. ECDSA over secp256k1 computes the public key Q = d·G and, on every verification, the two products u1·G and u2·Q; this rung authors exactly that operation, k·P, as a composition over the group's two primitives — the last arithmetic rung before ECDSA verification and public-key recovery, the reach the Bitcoin/Ethereum address arc was always climbing toward."
say "crypto-secp256k1_scalarmul: Style Radiant — the law is stated positively: k·P is P added to itself k times, computed by the double-and-add ladder in operations proportional to the bit length of k; walk the 32-byte little-endian scalar from its high bit down, double the accumulator at every bit and add P where the bit is set, starting from the group identity (the point at infinity, Z = 0). Because the complete addition and doubling formulas beneath are exception-free, the ladder needs no special case for the identity accumulator or for adding a point to itself — it composes only point doubling and point addition, no field inversion, no new curve math."
say "crypto-secp256k1_scalarmul: Lens TAME — the primitive calls no std.crypto; it walks a named 256-bit bound and asserts its contracts on every function; the ladder is deliberately variable-time (it branches on scalar bits), correct but not yet timing-safe, so a constant-time ladder for secret scalars stays a named horizon. Parity holds against algebraic known-answers AND Zig's independent std.crypto.ecc.Secp256k1.mul byte-for-byte on the affine coordinates of k·P across a spread of scalars over both the base point and 3·G. secp256k1 is not in Monocypher, so the two witnesses are the reference known-answers and Zig's std.crypto. Purely local — a scalar and a point are not a secret and not a signature, so no real key, no signing, no network, no funds, no device; ECDSA's signing with an identity key stays its own separate, gated round."

let zig = "vendor/zig-toolchain/zig"
let bin = "crypto/bin/secp256k1_scalarmul"

let build = run ["sh" "-c" "mkdir -p crypto/bin && env RYE_ZIG=${zig} rye/bin/rye build crypto/secp256k1_scalarmul.rye -femit-bin=${bin}"]
assert build.ok else "crypto-secp256k1_scalarmul: build failed — ${build.err}"

let outfile = "crypto/bin/secp256k1_scalarmul.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "crypto-secp256k1_scalarmul: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "crypto-secp256k1_scalarmul: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN crypto-secp256k1-scalarmul' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "crypto-secp256k1_scalarmul: selftest did not print the GREEN crypto-secp256k1-scalarmul line"
