# tools/s/skate_native_core_witness.rish -- the fixed Brushstroke Frame reaches native Surf and Skate.
#
# The Swift target owns a 40-by-8 cell grid, eight line seats, a 128-byte nib identity, eight
# palette seats, a 128-seat event ring, Image's 64-by-49-byte edit history, and a nine-node
# semantic snapshot in InlineArray storage. A frame carries Brushstroke's own one-through-eight
# declared line ceiling. Surf and Skate are compile-time aliases over the same frame, media receipt,
# event ring, edit history, and accessibility snapshot.
# The controls prove the living fold; media and history bounds; the
# refusing frame edges with all 459 Brushstroke values preserved; both event-ring refusals with all
# 130 stored ring values preserved; a full edit history with all 3,136 payload bytes preserved; a
# ten-node accessibility source with all nine prior physical seats preserved; FIFO order across
# physical wrap; and unsigned-counter refusal before arithmetic or ring mutation. AppKit and C stay
# outside this headless core. Image keeps the edit grammar and replay algorithms.

say "skate-native-core: Language EN -- Brushstroke lends one bounded Frame; Surf and Skate are peer names for its one native grid."
say "skate-native-core: Style Gauge Door -- the sizes, owner, refusal, and platform edge are named."
say "skate-native-core: Lens TAME -- fixed storage, bounded walks, and atomic refusal before mutation."

let shape = run ["sh" "-c" "grep -q 'InlineArray<128, UInt8>' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'InlineArray<8, BrushstrokeLine>' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'InlineArray<320, UInt8>' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'InlineArray<8, SkateColor>' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'InlineArray<128, Event?>' skate/Sources/SkateCore/EventRing.swift && grep -q 'func hasSameStoredState(as other: borrowing BrushstrokeFrame)' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'init(counterOrigin: UInt64)' skate/Sources/SkateCore/EventRing.swift && grep -q 'let nextTail = try Self.advanced(tail)' skate/Sources/SkateCore/EventRing.swift && grep -q 'throw EventRingError.full' skate/Sources/SkateCore/EventRing.swift && grep -q 'public let maxLines: Int' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'lineCount < maxLines' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'public typealias SurfFrameGrid = FrameGrid' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'public typealias SkateFrameGrid = FrameGrid' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'public typealias SurfEventRing' skate/Sources/SkateCore/EventRing.swift && grep -q 'public typealias SkateEventRing' skate/Sources/SkateCore/EventRing.swift && grep -q '@available(macOS 26.0, \*)' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'StrictMemorySafety' skate/Package.swift && grep -q '\-warnings-as-errors' skate/Package.swift && echo SHAPE_OK"]
assert shape.ok else "skate-native-core: fixed shape or strict build setting missing"
assert shape.out contains "SHAPE_OK" else "skate-native-core: fixed shape did not hold"

let history_shape = run ["/bin/bash" "-c" "grep -q 'InlineArray<49, UInt8>' skate/Sources/SkateCore/ImageEditHistory.swift && grep -q 'InlineArray<64, ImageEditRecordClaim?>' skate/Sources/SkateCore/ImageEditHistory.swift && grep -q 'public static let imageEditCapacity = 64' skate/Sources/SkateCore/ImageEditHistory.swift && grep -q 'public static let imageEditRecordBytes = 49' skate/Sources/SkateCore/ImageEditHistory.swift && grep -q 'pub const max_edits: u32 = 64;' image/photo_edits.rye && grep -q 'pub const per_line_bound: u32 = 49;' image/photo_edits.rye && grep -q 'public typealias SurfImageEditHistory = ImageEditHistory' skate/Sources/SkateCore/ImageEditHistory.swift && grep -q 'public typealias SkateImageEditHistory = ImageEditHistory' skate/Sources/SkateCore/ImageEditHistory.swift && echo HISTORY_SHAPE_OK"]
assert history_shape.ok else "skate-native-core: Image history shape drifted from its Rye contract"
assert history_shape.out contains "HISTORY_SHAPE_OK" else "skate-native-core: Image history shape did not hold"

let accessibility_shape = run ["/bin/bash" "-c" "grep -q 'public static let accessibilityNodeCapacity = 1 + rows' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'InlineArray<128, UInt8>' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'InlineArray<9, AccessibilityNode?>' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'case .frame: labelLimit = SkateCoreBounds.nibBytes' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'case .textLine: labelLimit = SkateCoreBounds.columns' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'case accessibilityTooLarge(limit: Int)' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'func hasSameStoredState(as other: borrowing AccessibilitySnapshot)' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'public typealias SurfAccessibilitySnapshot = AccessibilitySnapshot' skate/Sources/SkateCore/AccessibilitySnapshot.swift && grep -q 'public typealias SkateAccessibilitySnapshot = AccessibilitySnapshot' skate/Sources/SkateCore/AccessibilitySnapshot.swift && echo ACCESSIBILITY_SHAPE_OK"]
assert accessibility_shape.ok else "skate-native-core: nine-node accessibility shape or atomic refusal seam missing"
assert accessibility_shape.out contains "ACCESSIBILITY_SHAPE_OK" else "skate-native-core: accessibility shape did not hold"

let accessibility_parity = run ["/bin/bash" "-c" "grep -q 'pub const max_frame_lines: u32 = 8;' brushstroke/brush_parse.rye && grep -q 'pub const brush_skate_cols: u32 = 40;' brushstroke/brush_parse.rye && grep -q 'pub const brush_skate_rows: u32 = max_frame_lines;' brushstroke/brush_parse.rye && grep -q 'pub const max_pin_bytes: u32 = 128;' brushstroke/brush_parse.rye && grep -q 'public static let columns = 40' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'public static let rows = 8' skate/Sources/SkateCore/FrameGrid.swift && grep -q 'public static let nibBytes = 128' skate/Sources/SkateCore/FrameGrid.swift && echo ACCESSIBILITY_PARITY_OK"]
assert accessibility_parity.ok else "skate-native-core: Swift accessibility bounds drifted from Brushstroke's Rye constants"
assert accessibility_parity.out contains "ACCESSIBILITY_PARITY_OK" else "skate-native-core: accessibility parity did not hold"

let boundary = run ["sh" "-c" "if grep -Eq 'import (AppKit|Foundation)|Unsafe|(^|[^[:alnum:]_])Array<|(^|[^[:alnum:]_])Dictionary<|(^|[^[:alnum:]_])ContiguousArray<|(^|[^[:alnum:]_])Set<' skate/Sources/SkateCore/*.swift; then exit 1; else echo BOUNDARY_OK; fi"]
assert boundary.ok else "skate-native-core: platform import, unsafe seam, or dynamic owned collection entered the core"
assert boundary.out contains "BOUNDARY_OK" else "skate-native-core: core boundary did not hold"

let aliases = run ["sh" "tools/fixtures/a/alias_sameness_scan.sh"]
say aliases.out
assert aliases.ok else "skate-native-core: Surf and Skate must remain peer names over one identity"
assert aliases.out contains "alias_faults=0" else "skate-native-core: alias-sameness found a living asymmetry"
assert aliases.out contains "alias_verdict=ok" else "skate-native-core: alias-sameness must agree with itself"

let alias_control = run ["sh" "tools/fixtures/a/alias_sameness_control.sh"]
say alias_control.out
assert alias_control.ok else "skate-native-core: alias-sameness control must complete"
assert alias_control.out contains "control_cases=8" else "skate-native-core: eight alias-sameness behaviors must be exercised"
assert alias_control.out contains "control_fail=0" else "skate-native-core: every alias-sameness behavior must answer as planted"
assert alias_control.out contains "control_verdict=ok" else "skate-native-core: alias-sameness control must agree with itself"

let test = run ["/bin/bash" "-c" "mkdir -p tools/.build/skate-clang-cache tools/.build/skate-swift-cache && env DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer CLANG_MODULE_CACHE_PATH=$PWD/tools/.build/skate-clang-cache SWIFT_MODULE_CACHE_PATH=$PWD/tools/.build/skate-swift-cache /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/swift test --disable-sandbox --package-path skate --scratch-path $PWD/tools/.build/skate-core 2>&1"]
assert test.ok else "skate-native-core: Swift tests failed"
assert test.out contains "testBrushstrokeFrameLowersDeterministically" else "skate-native-core: living deterministic fold not exercised"
assert test.out contains "testMissingAtNibRefuses" else "skate-native-core: missing-nib control not exercised"
assert test.out contains "testHundredTwentyNinthNibByteRefuses" else "skate-native-core: nib-ceiling control not exercised"
assert test.out contains "testExactNibAndLineBoundsAreAccepted" else "skate-native-core: exact nib and line bounds not exercised"
assert test.out contains "testDeclaredOneLineCeilingRefusesSecondLineWithoutChangingFrame" else "skate-native-core: declared line ceiling control not exercised"
assert test.out contains "testDeclaredLineCeilingOutsideOneThroughEightRefuses" else "skate-native-core: line-ceiling range controls not exercised"
assert test.out contains "testSurfAndSkateAliasesShareOneFrameIdentityAndRefusalContract" else "skate-native-core: Surf and Skate alias-sameness control not exercised"
assert test.out contains "testNinthLineRefusesWithoutChangingFrame" else "skate-native-core: ninth-line control not exercised"
assert test.out contains "testFortyFirstByteRefusesWithoutChangingFrame" else "skate-native-core: forty-first-byte control not exercised"
assert test.out contains "testBrushstrokeFrameRefusalsPreserveAllStoredState" else "skate-native-core: Brushstroke append refusals did not prove all 459 stored values unchanged"
assert test.out contains "testInvalidPaletteRunsRefuseAtomically" else "skate-native-core: atomic paint controls not exercised"
assert test.out contains "testFrameGridRefusalsPreserveWholeState" else "skate-native-core: frame refusals did not prove all 648 owned values unchanged"
assert test.out contains "testImageLotusAndDigestValuesJoinOneBoundedMediaReceipt" else "skate-native-core: joined media receipt not exercised"
assert test.out contains "testImageSkatePlaneRefusesMalformedPlanesBeforeAdmission" else "skate-native-core: malformed media plane controls not exercised"
assert test.out contains "testLotusMeterAndDigestClaimsKeepTheirExactBounds" else "skate-native-core: meter and digest bounds not exercised"
assert test.out contains "testImageEditHistoryAdmitsExactBoundsAndKeepsOrder" else "skate-native-core: Image edit-history exact bounds and order not exercised"
assert test.out contains "testImageEditRecordRefusesEmptyAndFiftiethByte" else "skate-native-core: Image edit-record width controls not exercised"
assert test.out contains "testImageEditHistoryFullRefusalPreservesAllStoredBytes" else "skate-native-core: full Image history did not prove all stored bytes unchanged"
assert test.out contains "testSurfAndSkateImageEditHistoryAliasesShareOneIdentity" else "skate-native-core: Image history alias-sameness not exercised"
assert test.out contains "testEventRingFillsThenRefusesWithoutEviction" else "skate-native-core: full event-ring refusal not exercised"
assert test.out contains "testEventRingPhysicalWrapKeepsLinearFIFOOrder" else "skate-native-core: physical event-ring wrap not exercised"
assert test.out contains "testEventCounterRefusesBeforeUnsignedWrap" else "skate-native-core: event counter ceiling not exercised"
assert test.out contains "testEventRingCounterExhaustionRefusesWithoutMutation" else "skate-native-core: event counter refusal did not prove whole-state preservation"
assert test.out contains "testEventRingRefusalsPreserveEveryStoredSeat" else "skate-native-core: event refusals did not compare every stored seat"
assert test.out contains "testSurfAndSkateEventRingAliasesShareOneIdentity" else "skate-native-core: event alias-sameness not exercised"
assert test.out contains "testAccessibilitySnapshotRegeneratesRootAndEightLinesAtExactBounds" else "skate-native-core: exact nine-node accessibility snapshot not exercised"
assert test.out contains "testAccessibilityRegenerationIsDeterministic" else "skate-native-core: repeated accessibility regeneration did not prove one stable value"
assert test.out contains "testAccessibilityTooLargeRefusesWithLastWholeSnapshotUnchanged" else "skate-native-core: accessibility overflow did not preserve every prior physical seat"
assert test.out contains "testAccessibilityRegenerationClearsEveryRetiredPhysicalSeat" else "skate-native-core: accessibility regeneration did not clear retired scratch seats"
assert test.out contains "testAccessibilityNodeBoundsRefuseBeforeAValueExists" else "skate-native-core: accessibility label and rect bounds not exercised"
# The verdict reads ZERO FAILURES rather than an exact test count -- a pinned "21" made every
# honestly added test red this witness, which is the candidate-proof-boundary custody stop of
# 20260828. The named-test asserts above still hold the floor: each seated behavior must appear.
assert test.out contains ", with 0 failures" else "skate-native-core: zero-failure verdict missing"
assert test.out contains "Executed " else "skate-native-core: the suite must report how many tests it executed"

say "RED and GREEN paths proven -- one deterministic fold lives; the named identity, media, history, event, accessibility, exact-bound, refusal, and mutation claims hold."
say "GREEN: skate-native-core -- Surf and Skate share one Brushstroke Frame, event-ring, Image edit-history, and semantic-snapshot identity, storage shape, and refusal contract."
