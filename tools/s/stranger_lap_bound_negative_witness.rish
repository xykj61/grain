# stranger_lap_bound_negative_witness.rish -- proves the bound comparator is live.
#
# Deliberately sets STRANGER_LAP_WALL_SECONDS=0 so elapsed < bound can never
# hold for a non-negative wall-clock. Expects the worker to FAIL with
# STRANGER_BOUND_OK=0. If this witness greens while the worker exits 0, the
# comparison is dead and the seat is lying.
#
#   rishi/bin/rishi run tools/s/stranger_lap_bound_negative_witness.rish

let walk = run ["env" "STRANGER_LAP_MODE=warm" "STRANGER_LAP_WALL_SECONDS=0" "STRANGER_LAP_POSTURE=fixture-negative" "sh" "tools/s/stranger_lap_worker.sh"]
assert (walk.ok == false) else "bound-negative must FAIL the walk — comparator appears dead"
assert walk.out contains "STRANGER_MODE=warm" else "bound-negative missing mode=warm"
assert walk.out contains "STRANGER_BOUND_OK=0" else "bound-negative missing STRANGER_BOUND_OK=0"
assert walk.out contains "STRANGER_BOUND_SECONDS=0" else "bound-negative must have used tiny bound=0"
assert walk.out contains "FAIL: stranger lap exceeded wall-clock bound" else "bound-negative missing exceed FAIL line"

say "GREEN: stranger lap bound-negative — tiny bound FAILS; comparator is live."
