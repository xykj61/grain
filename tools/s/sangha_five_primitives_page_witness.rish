# tools/s/sangha_five_primitives_page_witness.rish -- door 12 page pin
#
# Asserts the five-primitives reference page exists, names five sections,
# and points at GREEN myc paths that resolve on disk. Zero new .rye.
#
#   rishi/bin/rishi run tools/s/sangha_five_primitives_page_witness.rish

let page = "docs-geode/sangha/03-five-primitives.md"
let have = run ["test" "-f" page]
assert have.ok else "sangha page missing: ${page}"

let h1 = run ["sh" "-c" "grep -c '### 1. Keypair' docs-geode/sangha/03-five-primitives.md"]
let h2 = run ["sh" "-c" "grep -c '### 2. Signed event' docs-geode/sangha/03-five-primitives.md"]
let h3 = run ["sh" "-c" "grep -c '### 3. Append-only log' docs-geode/sangha/03-five-primitives.md"]
let h4 = run ["sh" "-c" "grep -c '### 4. Pure fold' docs-geode/sangha/03-five-primitives.md"]
let h5 = run ["sh" "-c" "grep -c '### 5. Capability' docs-geode/sangha/03-five-primitives.md"]
assert trim h1.out == "1" else "missing Keypair section"
assert trim h2.out == "1" else "missing Signed event section"
assert trim h3.out == "1" else "missing Append-only log section"
assert trim h4.out == "1" else "missing Pure fold section"
assert trim h5.out == "1" else "missing Capability section"

let k = run ["test" "-f" "mycelium/kumara.rye"]
let f = run ["test" "-f" "mycelium/fold.rye"]
let p = run ["test" "-f" "mycelium/fold_persist.rye"]
let s = run ["test" "-f" "mycelium/ship_sol.rye"]
let r = run ["test" "-f" "mycelium/refusal_storm.rye"]
let b = run ["test" "-f" "mycelium/build_bounds.rye"]
assert k.ok else "missing mycelium/kumara.rye"
assert f.ok else "missing mycelium/fold.rye"
assert p.ok else "missing mycelium/fold_persist.rye"
assert s.ok else "missing mycelium/ship_sol.rye"
assert r.ok else "missing mycelium/refusal_storm.rye"
assert b.ok else "missing mycelium/build_bounds.rye"

let readme = run ["sh" "-c" "grep -c '03-five-primitives' docs-geode/sangha/README.md"]
assert readme.ok else "README grep failed"
assert trim readme.out != "0" else "README missing page-three index"

say "GREEN: sangha five-primitives page — five sections · six myc paths · README indexed"
