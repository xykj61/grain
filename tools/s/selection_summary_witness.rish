# tools/s/selection_summary_witness.rish -- read a SELECTION as a small table by joining scene-manifest facts over the subset, on metal (Season G).
#
# Season G (Open Media Primitives) -- the selection ladder (image/hit_test.rye a POINT, image/region_select.rye a RECTANGLE,
# image/lasso_select.rye a POLYGON) each returns an ASCENDING SET of dense labels. This rung is what a surface DOES with that set:
# image/selection_summary.rye joins image/scene_manifest.rye's per-object rows over just the selected labels and reads the selection
# as a whole -- how much is selected, which selected object is largest, which are holed, and the selection sorted by size. Exact
# integers, NO float, NO tolerance.
#
# The crux this witness proves on metal: a selection is a SUBSET, so a read over it is strictly sharper than the same read over the
# whole scene. Over a scene of a big solid block, a small ring, a large ring, and a small block, the selection {small ring, small
# block} excludes both the scene's largest object and its largest holed, so largest_in_selection and largest_holed_in_selection both
# name the small ring; the filter holds one holed object though the scene holds two; a non-empty unholed selection refuses
# NoHoledInSelection; and the sort of {small ring, large ring} reverses the label order to the large ring first. Refusals by name,
# determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/selection_summary_witness.rish

say "selection_summary: Language EN -- Season G selection read; join each selected object's scene-manifest facts (area, holes) over the SUBSET a selector named; largest, holed count, largest-holed, total area, and sort-by-area over the selection; NO float, NO tolerance."
say "selection_summary: Style Radiant -- compose not braid: this rung owns only the reads over a selection; scene_manifest owns the per-object rows (ObjectEntry, object_of, total_area), the selection ladder owns the label set. No plane of its own, no pixel written -- a reading over a reading."
say "selection_summary: Lens TAME -- a valid selection names at most one label per component under label_max_pixels; every read runs the selection length times, each a single manifest lookup; the sort is a bounded insertion sort; a malformed selection (background, past the count, out of ascending order, too long) refuses BadSelection at the edge having read nothing; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/selection_summary"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/selection_summary.rye -femit-bin=${bin}"]
assert build.ok else "selection_summary: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "selection_summary: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "selection_summary: ${out}"

assert selftest.out contains "GREEN image-selection-summary" else "selection_summary: selftest did not print the GREEN line"
assert selftest.out contains "JOIN each selected object's scene-manifest facts (area, holes) over the SUBSET" else "selection_summary: the join-over-subset rule did not print"
assert selftest.out contains "the DECISIVE subset crux, strictly sharper than the whole-scene reads" else "selection_summary: the decisive subset crux did not print"
assert selftest.out contains "EXCLUDES both the scene's largest object (the solid block) and the scene's largest holed (the large ring)" else "selection_summary: the exclusion did not print"
assert selftest.out contains "largest_in_selection names the SMALL RING (area 8) and largest_holed_in_selection names the SMALL RING too" else "selection_summary: the subset answer did not print"
assert selftest.out contains "that selection holds ONE holed object though the scene holds two" else "selection_summary: the sharper filter did not print"
assert selftest.out contains "refuses NoHoledInSelection (a fact about holes, not emptiness)" else "selection_summary: the unholed refusal did not print"
assert selftest.out contains "sorts by area descending to the LARGE RING first, labels 3 then 2" else "selection_summary: the sort reversal did not print"
assert selftest.out contains "the whole selection agrees with the scene" else "selection_summary: the whole-selection agreement did not print"
assert selftest.out contains "largest_in_selection refuses EmptySelection" else "selection_summary: the empty refusal did not print"
assert selftest.out contains "refuse BadSelection having read nothing" else "selection_summary: the malformed refusals did not print"
assert selftest.out contains "the same selection reads the same summary twice" else "selection_summary: determinism did not print"

say "selection_summary: GREEN on metal -- a selection read as a small table, the join over the subset landing where no whole-scene read does, the filter sharper than the scene's, the sort reversing the label order; refusals by name, determinism. Season G open-media."
