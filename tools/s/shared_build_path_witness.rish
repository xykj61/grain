# shared_build_path_witness.rish -- witnesses that emit to a literal path in the tree.
#
#   rishi/bin/rishi run tools/s/shared_build_path_witness.rish
#
# HOLDS THE RATCHET FROM REDS %700. A guard building its binary to a fixed path shares that name
# with every other run in the same checkout: one run EXECUTES the binary while another's linker
# opens the same path, and the linker refuses with ETXTBSY. The guard then answers differently on
# bytes nobody changed, which is FLAKY -- and a flaky guard is a defect in the EVIDENCE LAYER, since
# a green from it cannot be told from a green from a sound one.
#
# THE CEILING ONLY FALLS. The backlog was not made today, and a gate that reds on ordinary work is
# one somebody turns off. Migrate a site to a `mktemp -d` pen and lower the number here in the same
# commit. The refusals are proven in the control rather than asserted here.
let scan = run ["sh" "tools/fixtures/s/shared_build_path_scan.sh"]
assert scan.ok else "shared build path scan did not run: ${scan.err}"
assert scan.out contains "verdict=ok" else "shared build path over its ceiling: ${scan.out}"

# THE CONTROL IS ASSERTED BESIDE THE READING, because a scan that cannot refuse is a scan that
# always passes. Twelve behaviors on real git repositories in a throwaway pen, every refusal planted
# and then lifted, and one mutation that breaks the `let` resolution the whole reading rests on.
let control = run ["sh" "tools/fixtures/s/shared_build_path_control.sh"]
assert control.ok else "shared build path control did not reach verdict=ok: ${control.out}"
assert control.out contains "verdict=ok" else "shared build path control verdict missing: ${control.out}"
assert control.out contains "faults=0" else "a planted behavior went unread: ${control.out}"
assert control.out contains "leg resolution_required=ok" else "the let resolution is unproven: ${control.out}"
assert control.out contains "leg ceiling_over_refuses=ok" else "the ceiling never refused: ${control.out}"
assert control.out contains "leg empty_ok=ok" else "an empty tree did not read clean: ${control.out}"

say "GREEN: shared build path under its ceiling, and the reading proven able to refuse."
