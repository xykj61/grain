# seva_rename_witness.rish -- Seva rename complete - Mand seated - GREEN.
#
# Whole-surface rename: glow_seva_b0_* - seva-event desks - package ids -
# suite witnesses. HAWM1 memo bytes stay (STOP -- pinned root). Exclude is
# SEVA - MAND - MONA (SALA dropped). Lexicon: Seva confirmed - Mand confirmed -
# Sala historical - Mona prior-name.
#
#   rishi/bin/rishi run tools/s/seva_rename_witness.rish

let exclude_src = read-file "tools/w/waymark_derive.rish"
assert (exclude_src contains "SEVA") else "exclude missing SEVA"
assert (exclude_src contains "MAND") else "exclude missing MAND"
assert (exclude_src contains "MONA") else "exclude missing MONA (retired-name season)"
let sala_still = run ["sh" "-c" "grep qxE tools/w/waymark_derive.rish | grep -q SALA"]
assert (sala_still.ok == false) else "SALA must be off the exclude regex"

let lex = read-file "context/LEXICON.md"
assert (lex contains "**Seva**") else "LEXICON missing Seva"
assert (lex contains "**Mand**") else "LEXICON missing Mand"
assert (lex contains "**Historical**") else "LEXICON Sala row missing Historical"
assert (lex contains "Prior name") else "LEXICON Mona row missing Prior name"
assert (lex contains "digest-pinned HAWM1") else "LEXICON Sala row missing digest-pinned HAWM1 STOP"
assert (lex contains "99b3ae967c5a230acfc598a7e949b3c2c638ce996be47a51a7c9f8cb12e4c5fe") else "LEXICON Sala row missing HAWM1 root"
let tame = read-file "context/TAME_GUIDANCE.md"
assert (tame contains "digest-pinned HAWM1") else "TAME_GUIDANCE missing standing-exempt HAWM1 sala: memos"

# New paths present; old paths gone.
assert ((read-file "tools/s/seva_view_witness.rish") contains "seva_view") else "seva_view witness missing"
assert ((read-file "glow/gen/shape-seva-event.glow") contains "seva-event-shape") else "shape-seva-event missing"
assert ((read-file "glow/gen/cast-named-seva-event.glow") contains "seva-event-shape") else "cast-named-seva-event missing"
assert ((read-file "tools/g/glow_seva_b0_fold_witness.rish") contains "glow_seva_b0") else "glow_seva_b0_fold witness missing"
assert ((read-file "linengrow/glow_seva_b0_demo_fixture.rye") contains "sala:open rishi session") else "HAWM1 memo1 must remain (STOP)"
assert ((read-file "linengrow/glow_seva_b0_demo_fixture.rye") contains "99b3ae967c5a230acfc598a7e949b3c2c638ce996be47a51a7c9f8cb12e4c5fe") else "HAWM1 root pin must remain"

let old_view = run ["sh" "-c" "test ! -e tools/sala_view_witness.rish"]
assert old_view.ok else "tools/sala_view_witness.rish still present"
let old_glow = run ["sh" "-c" "test ! -e tools/glow_sala_b0_fold_witness.rish"]
assert old_glow.ok else "tools/glow_sala_b0_fold_witness.rish still present"
let old_shape = run ["sh" "-c" "test ! -e glow/gen/shape-sala-event.glow"]
assert old_shape.ok else "glow/gen/shape-sala-event.glow still present"
let old_pkg = run ["sh" "-c" "grep -q sala_broadcaster linengrow/tube_android_manifest_emit.rye tools/t/tube05_apk_pack_worker.sh"]
assert (old_pkg.ok == false) else "living package id still sala_broadcaster"

let way = run ["rishi/bin/rishi" "run" "tools/w/waymark_derive_witness.rish"]
assert way.ok else "waymark_derive_witness failed under Seva·Mand seat"
assert way.out contains "MAND" else "waymark GREEN missing MAND"

# Suite family
let w1 = run ["rishi/bin/rishi" "run" "tools/s/seva_view_witness.rish"]
assert w1.ok else "seva_view_witness failed"
let w2 = run ["rishi/bin/rishi" "run" "tools/s/seva_surface_witness.rish"]
assert w2.ok else "seva_surface_witness failed"
let w3 = run ["rishi/bin/rishi" "run" "tools/s/seva_session_core_witness.rish"]
assert w3.ok else "seva_session_core_witness failed"
let w4 = run ["rishi/bin/rishi" "run" "tools/s/seva_broadcast_delivery_witness.rish"]
assert w4.ok else "seva_broadcast_delivery_witness failed"
let w5 = run ["rishi/bin/rishi" "run" "tools/s/seva_backchannel_witness.rish"]
assert w5.ok else "seva_backchannel_witness failed"
let w6 = run ["rishi/bin/rishi" "run" "tools/s/seva_b1_glass_carriage_witness.rish"]
assert w6.ok else "seva_b1_glass_carriage_witness failed"
let w7 = run ["rishi/bin/rishi" "run" "tools/s/seva_jabs2_glass_audience_witness.rish"]
assert w7.ok else "seva_jabs2_glass_audience_witness failed"

# glow_seva_b0 fold + demo fixture (digest pin path)
let fold = run ["rishi/bin/rishi" "run" "tools/g/glow_seva_b0_fold_witness.rish"]
assert fold.ok else "glow_seva_b0_fold_witness failed"
let demo = run ["rishi/bin/rishi" "run" "tools/g/glow_seva_b0_demo_fixture_witness.rish"]
assert demo.ok else "glow_seva_b0_demo_fixture_witness failed"

# Shape desks via glow_run
let shape = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "glow/gen/shape-seva-event.glow"]
assert shape.ok else "shape-seva-event.glow failed"
assert shape.out contains "GREEN" else "shape-seva-event not GREEN"
let cast = run ["rishi/bin/rishi" "run" "tools/g/glow_run.rish" "glow/gen/cast-named-seva-event.glow"]
assert cast.ok else "cast-named-seva-event.glow failed"
assert cast.out contains "GREEN" else "cast-named-seva-event not GREEN"

say "GREEN: Seva rename complete · Mand seated · HAWM1 memos STOP · exclude SEVA·MAND·MONA · suite+b0+desks"
