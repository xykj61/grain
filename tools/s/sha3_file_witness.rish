# tools/s/sha3_file_witness.rish -- our own SHA3-256 digest, checked against the published standard.
#
# WHY THIS RUNG. The Amphora and Cellar fixtures pinned `openssl dgst -sha3-256`, and openssl is
# absent from this pier -- so Amphora lap 2 could not run, and the fascia meter stayed silent
# behind it (REDS %112). The fix asked for was `sha256sum`, and it would have been WRONG: sha256sum
# computes SHA-2 and SHA3-256 is Keccak. Different algorithms, not two spellings of one. Swapping
# them would have silently changed every content address in every manifest this tree has written,
# and every one would still have looked exactly like a digest.
#
# So the digest now comes from `crypto/sha3_file.rye` -- authored Rye over Keccak-f[1600], studied
# clean-room from FIPS 202. Same algorithm the hash-tier spec already names for the Working tier,
# same digests, no external dependency.
#
# WHICH RAISES THE REAL QUESTION THIS RUNG ANSWERS. The hash-tier spec called openssl the
# INDEPENDENT HOST ORACLE, and it was right to: a digest checked only against the code that
# produced it proves nothing about whether that code computes SHA3-256 at all. So the check here is
# against a PUBLIC STANDARD -- the FIPS 202 known-answer vectors, which anyone can look up and
# nobody in this tree can quietly change -- and additionally against openssl wherever it happens to
# be installed. The claim rests on the standard rather than on whichever tools a machine carries.
#
# WHAT IS PROVEN HERE, on metal.
#   The empty string and "abc" hash to their published FIPS 202 answers at BOTH widths -- 256
#   for the Amphora content addresses, 512 for the waymark draws and the registry seal.
#   Hashing a pipe gives the same answer as hashing the same bytes in a file, since the waymark
#   draws hash a ladder name through a pipe rather than from disk.
#   A one-byte change produces a different digest, so the tool is reading the file rather than
#   its name.
#   The digest goes to STDOUT and is capturable -- the first shape of this tool printed a perfect
#   answer through std.debug.print, which every `$(...)` around it read as the empty string, and
#   an empty digest is what wrote the short manifest line that started this whole failure.
#   openssl parity, when openssl is present. Reported honestly as skipped when it is not.
#
# WHAT IS NOT PROVEN. That SHA3-256 is the right algorithm for the Working tier -- the hash-tier
# spec decided that (`context/specs/20260703-191112_resins-and-hash-tiers.md`), and this rung only
# proves the tool computes what that decision names.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/sha3_file_witness.rish

say "sha3-file: Language EN -- a digest checked only against the code that made it proves nothing. This checks ours against FIPS 202, which anyone can look up and nobody here can quietly change."
say "sha3-file: Style Radiant -- published answers first, then a one-byte change, then that the answer is capturable, then openssl parity where openssl exists."
say "sha3-file: Lens TAME -- SHA3-256 is Keccak and sha256sum is SHA-2; the near-miss substitution that would have rewritten every content address is the reason this rung is written down."

let empty_expect = "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a"
let abc_expect = "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532"

let probe = run ["sh" "tools/fixtures/sha3_file_control.sh"]
assert probe.ok else "sha3-file: the control must complete -- see stderr"
say probe.out

assert probe.out contains "empty=${empty_expect}" else "sha3-file: the empty string must hash to its published FIPS 202 SHA3-256 answer"
assert probe.out contains "abc=${abc_expect}" else "sha3-file: the bytes abc must hash to their published FIPS 202 SHA3-256 answer"
assert probe.out contains "one_byte_changes_digest=yes" else "sha3-file: a one-byte change must change the digest -- otherwise the tool is reading a name rather than a file"
assert probe.out contains "capturable=yes" else "sha3-file: the digest must reach STDOUT, since a value only a terminal can see is a value no caller can use"
assert probe.out contains "length=64" else "sha3-file: a SHA3-256 digest renders as exactly sixty-four hex characters"
assert probe.out contains "empty512=a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26" else "sha3-file: the empty string must hash to its published FIPS 202 SHA3-512 answer -- this width carries the waymark seal"
assert probe.out contains "abc512=b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0" else "sha3-file: the bytes abc must hash to their published FIPS 202 SHA3-512 answer"
assert probe.out contains "length512=128" else "sha3-file: a SHA3-512 digest renders as exactly one hundred twenty-eight hex characters"
assert probe.out contains "stdin_matches_file=yes" else "sha3-file: hashing standard input must give the same answer as hashing the same bytes in a file -- the waymark draws hash a name through a pipe"
assert probe.out contains "control_verdict=ok" else "sha3-file: the control must agree with itself before it is believed"

# openssl is the spec's independent oracle. Absent here, so the parity leg reports honestly rather
# than claiming a check nobody ran.
assert probe.out contains "openssl_parity=" else "sha3-file: the openssl leg must report either agreement or its own absence"

say "GREEN: sha3-file -- FIPS 202 answers matched, a one-byte change moves the digest, the answer reaches stdout, and the openssl leg reports honestly."
