# tools/s/sow_allow_reach_witness.rish -- an allowed room that ships nothing is caught.
#
#   rishi/bin/rishi run tools/s/sow_allow_reach_witness.rish
#
# REDS %485. The seed is an allowlist, and on `20260906` a second filter inside
# tools/fixtures/s/sow_project.sh -- a hard exclusion by NAME, running after the allowlist --
# silently discarded an allowed room. The manifest read allow, the projection ran, and sow_witness
# answered GREEN, because a room that ships no bytes leaks no names. This asks the other direction:
# did the thing we allowed actually arrive.

say "sow-allow-reach: Language EN -- an allowlist proven from the shipped side."
say "sow-allow-reach: Style Gauge, Meter -- the gate, and the loud absence it must not count."
say "sow-allow-reach: Lens TAME -- the refusal planted on a real projection, then lifted."

say "sow-allow-reach: the projection must stand before anything is read..."
let absent = run ["sh" "-c" "SOW_SEED=/tmp/sow-allow-nowhere sh tools/fixtures/s/sow_allow_reach_scan.sh 2>&1 | head -1"]
# invariant: a scan that reads nothing refuses rather than reporting clean (REDS %170).
assert absent.out contains "refused: no projection" else "sow-allow-reach: an absent projection read as clean rather than refusing"

say "sow-allow-reach: every allowed, shippable room arrives..."
let scan = run ["sh" "tools/fixtures/s/sow_allow_reach_scan.sh"]
assert scan.ok else "sow-allow-reach: the scan refused --\n${scan.out}"
assert scan.out contains "empty=0" else "sow-allow-reach: a room is allowed and shippable and did not arrive --\n${scan.out}"

say "sow-allow-reach: and a LOUD absence is not counted as a silent one..."
# invariant: a file the projector withheld stands in .sow-withheld.log, which is the fail-safe
# working. Counting that as a fault would make the gate red on correct behaviour, and a gate that
# reds on correct behaviour is a gate somebody turns off.
assert scan.out contains "withheld_by_design=" else "sow-allow-reach: the loud absences went unreported"

say "sow-allow-reach: the gate reads from the manifest rather than a list of its own..."
let derived = run ["sh" "-c" "grep -c MANIFEST tools/fixtures/s/sow_allow_reach_scan.sh || true"]
assert derived.ok else "sow-allow-reach: the derivation could not be read"
assert (trim derived.out) != "0" else "sow-allow-reach: the scan spells its own room list rather than reading the manifest -- the second list this red is about"

say "GREEN: sow-allow-reach -- what the manifest allows and the field can ship, the seed carries; and an absence the projector announced is told apart from one nobody did."
