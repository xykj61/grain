# Prove that allowed rooms arrive in a current seed projection.
# The control runs in neutral repositories even when this checkout has no copy.
# A current copy is checked for missing rooms; absent or stale evidence is named.
# Malformed evidence refuses. The public publish remains a separate manual gate.

say "sow-allow-reach: prove the scan and projector in isolated repositories"
let control = run ["sh" "tools/fixtures/s/sow_allow_reach_control.sh"]
say control.out
say control.err
assert control.ok else "sow-allow-reach: the control must finish successfully"
assert control.out contains "control_fail=0" else "sow-allow-reach: all receipt and reach checks must agree"
assert control.out contains "control_verdict=ok" else "sow-allow-reach: the control must report its final verdict"

say "sow-allow-reach: read completion evidence before measuring the live copy"
let state = run ["sh" "tools/fixtures/s/sow_allow_reach_scan.sh" "--capability"]
say state.out
say state.err
assert state.ok else "sow-allow-reach: the receipt state must be readable"
if (trim state.out) == "absent" then say "SKIP: live reach -- seed projection absent or stale; isolated control passed"
if (trim state.out) == "absent" then exit 0
let scan = run ["sh" "tools/fixtures/s/sow_allow_reach_scan.sh"]
say scan.out
say scan.err
assert scan.ok else "sow-allow-reach: current projection scan must complete"
assert scan.out contains "empty=0" else "sow-allow-reach: an allowed room is silently missing"
assert scan.out contains "withheld_by_design=" else "sow-allow-reach: announced withholding must be reported"
say "GREEN: sow-allow-reach -- controls passed and the current copy accounts for its allowed rooms"
