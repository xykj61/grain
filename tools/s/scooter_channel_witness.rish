# tools/s/scooter_channel_witness.rish -- Scooter, Rung 1: the channel model on metal.
#
# pond/apps/scooter_channel.rye draws the heart of the Scooter CLI chat: a permissioned channel with an
# append-only journal and a per-member unread inbox, the pure rule every later rung (the drawn frame, the
# signed post, the Comlink transport between two Constel fake piers) stands on. This witness builds the
# module to a binary and asserts its selftest speaks GREEN over the four cruxes:
#   - Permissioned join -- a non-host admit refuses NotHost; a stranger's post refuses NotMember and leaves
#     the journal untouched.
#   - Append-only journal -- three posts carry seqs 0,1,2 ascending; each text reads back byte-for-byte.
#   - Derived-unread inbox -- a late joiner starts at 0 unread, each post adds one, catch_up clears, the
#     cursor never rewinds.
#   - Bounded -- ChannelFull, TextTooLong, JournalFull each refuse by name.
#
# Facts only, custody-first: no network, no key signs, no funds. Demo keeper points only.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/scooter_channel_witness.rish

say "scooter-r1: Language EN -- a permissioned channel with an append-only journal and a derived-unread inbox."
say "scooter-r1: Lens TAME -- only the host admits, a stranger is refused, and every bound refuses by name."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/scooter-channel"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/scooter_channel.rye -femit-bin=${bin}"]
assert build.ok else "scooter-r1: scooter_channel build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "scooter-r1: scooter_channel selftest exited non-zero"
assert selftest.out contains "GREEN" else "scooter-r1: selftest did not speak GREEN"
assert selftest.out contains "a stranger's post refused NotMember and left the journal untouched" else "scooter-r1: permissioned-join crux missing"
assert selftest.out contains "seqs 0,1,2 ascending" else "scooter-r1: append-only crux missing"
assert selftest.out contains "unread is derived post_count-cursor" else "scooter-r1: derived-unread crux missing"
assert selftest.out contains "a full roster refused ChannelFull" else "scooter-r1: bounds crux missing"

say "GREEN: scooter-r1 -- scooter_channel opens a permissioned channel, keeps an append-only journal, and derives every member's unread inbox."
