# tools/s/skate_styled_run_witness.rish -- WADE1: Skate per-cell styled runs.
#
# Proves brushstroke/skate_grid.rye's additive per-cell foreground layer
# (active-designing/date/20260812/20260812-000456_wade1-brush-surface-bridge-seam.md):
#   (a) two different cell ranges rasterize to two different colors;
#   (b) a grid with no color runs rasterizes byte-identically to a baseline --
#       the whole-buffer FNV signature of a no-runs grid equals a fresh grid's,
#       so the default display path carries no palette drift.
# Slot 0 of the run palette is the sentinel "wear the fg rasterize is given,"
# which is why the no-runs path is unchanged by construction.
#
#   rishi/bin/rishi run tools/s/skate_styled_run_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"

let run = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye run brushstroke/skate_styled_run_test.rye 2>&1"]
assert run.ok else "skate styled run: rye run failed"
assert (run.out contains "GREEN: brushstroke skate styled runs") else "skate styled run: not GREEN"
assert (run.out contains "byte-identical") else "skate styled run: missing byte-identical claim"
assert (run.out contains "two ranges two colors") else "skate styled run: missing two-color claim"
assert (run.out contains "differs from plain") else "skate styled run: painted grid did not differ from plain"

say "GREEN: WADE1 skate styled runs — two ranges two colors; the no-runs path stays byte-identical."
