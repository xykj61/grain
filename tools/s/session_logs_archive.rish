# session_logs_archive.rish -- fold prior days' session logs into date/YYYYMMDD/.
#
# Convention (ORGANIZING.md): the working day stays flat; earlier days live under
# session-logs/date/<YYYYMMDD>/. Folds Kyri (.kyri), the elder Bron (.bron), and historical
# Markdown (.md); README.md stays flat and has its links rewritten in place.
#
# The destination molted archive/ -> date/ on 20260821.161758 with the mark law
# (.claude/rules/stamp-and-name.md). The file keeps its elder name because 137 references
# across the tree already name it.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/session_logs_archive.rish
#
# Read-only count first:
#   rishi/bin/rishi run tools/s/session_logs_archive_preview.rish
#
# Core: tools/rye/session_logs_archive.rye - witness: session_logs_archive_witness.rish

let zig = "vendor/zig-toolchain/zig"
let rye = "rye/bin/rye"
let tool = "tools/rye/session_logs_archive.rye"
let bin = "tools/.build/session_logs_archive"

let build = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} ${rye} build ${tool} -femit-bin=${bin}"]
assert build.ok else "session_logs_archive build failed"

let today = run ["sh" "-c" "date +%Y%m%d"]
say "fold: keeping day ${today.out} flat; moving earlier days beneath date/."

let cmd = run ["sh" "-c" "${bin} fold 2>&1"]
assert cmd.ok else "session logs archive fold failed"
say cmd.out
assert cmd.out contains "GREEN"
