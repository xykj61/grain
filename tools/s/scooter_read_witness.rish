# tools/s/scooter_read_witness.rish -- Scooter, the held read view, on metal.
#
# pond/apps/scooter_read.rye holds one scroll position over a channel and offers the paging verbs a reader
# reaches for (home, oldest, page up/down, line up/down), each clamped against the live journal, and renders
# the frame at the held position. It composes the two proven halves -- scooter_scroll (the paging math) and
# scooter_view.render_window (the drawing) -- so scooter_scroll keeps the math, scooter_view keeps the drawing,
# and this keeps the position between keystrokes. Held PURE: a u32 position and a render, no TTY and no network.
# This witness builds the module and asserts its selftest speaks GREEN over the six cruxes:
#   - A fresh view opens at home, its render anchoring the newest post to the bottom.
#   - Paging up reveals older posts and clamps at the first, never underflowing.
#   - Paging down returns toward the newest and clamps at the home view, never past it.
#   - A line up and a line down move the held position by exactly one, clamped at each edge.
#   - A journal that fits the body stays home, every paging verb a harmless no-op.
#   - At every position the view's render equals render_window at its top -- the position and the drawn slice
#     are always one truth.
#
# Facts only, custody-first: it holds a scroll position and renders a public journal -- no network, no key, no
# funds. Binding a keeper's Up/Down/Page keys is a later rung; the Comlink wire reaches the serve gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/scooter_read_witness.rish

say "scooter-read: Language EN -- a held read view pages a keeper through journal history and draws each stop."
say "scooter-read: Lens TAME -- one bounded scroll position, every paging verb clamped, the render one truth with the drawn slice, no TTY, no key, no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/scooter-read"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/scooter_read.rye -femit-bin=${bin}"]
assert build.ok else "scooter-read: scooter_read build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "scooter-read: scooter_read selftest exited non-zero"
assert selftest.out contains "GREEN" else "scooter-read: selftest did not speak GREEN"
assert selftest.out contains "opens at home" else "scooter-read: fresh-view-home crux missing"
assert selftest.out contains "paging up reveals older posts and clamps at the first" else "scooter-read: page-up crux missing"
assert selftest.out contains "paging down returns toward the newest and clamps at the home view" else "scooter-read: page-down crux missing"
assert selftest.out contains "move the held position by exactly one" else "scooter-read: line-step crux missing"
assert selftest.out contains "stays home, every paging verb a harmless no-op" else "scooter-read: short-journal crux missing"
assert selftest.out contains "equals render_window at its top -- one truth" else "scooter-read: one-truth crux missing"

say "GREEN: scooter-read -- a held read view pages a keeper through journal history, the position bounded and always one truth with the drawn slice."
