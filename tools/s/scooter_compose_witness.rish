# tools/s/scooter_compose_witness.rish -- Scooter, Rung 4: the composed session on metal.
#
# pond/apps/scooter_compose.rye joins the terminal family into one act -- a keeper types a line
# (dexter_line.rye, rung the input half) and watches it land in the conversation (scooter_channel.rye's
# journal, drawn by scooter_view.rye's bounded 24x80 frame). This rung was designed for from both sides:
# scooter_view.render_within reserves its last row "for a prompt"; dexter_line holds the editable line the
# prompt draws. This witness builds the module and asserts its selftest speaks GREEN over the six cruxes:
#   - A typed line becomes a post -- type "hello", submit, and the journal holds it; the prompt clears.
#   - An empty submit is refused -- EmptyEntry, and the journal is left exactly as it was.
#   - The frame shows both -- journal in the body, prompt on the last row, byte-for-byte and deterministic.
#   - The prompt truncates -- an over-wide draft clips to the row width with a '~', never overflowing.
#   - The caret tracks the cursor -- the reported column is the prefix width plus the bytes before the cursor.
#   - The prompt row is reserved -- a journal past its budget draws its overflow in the body, never the prompt row.
#
# Facts only, custody-first: it edits a line and appends a post a member already holds -- no network, no key
# signs, no funds. The wire between two Constel piers reaches the serve gate -- the maintainer's hand, not here.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/s/scooter_compose_witness.rish

say "scooter-r4: Language EN -- a keeper's typed line becomes a post; the terminal family joins into one frame."
say "scooter-r4: Lens TAME -- a bounded editable line and a fixed 24x80 frame; empty submit refused, prompt truncation honest, no key and no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/scooter-compose"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/scooter_compose.rye -femit-bin=${bin}"]
assert build.ok else "scooter-r4: scooter_compose build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "scooter-r4: scooter_compose selftest exited non-zero"
assert selftest.out contains "GREEN" else "scooter-r4: selftest did not speak GREEN"
assert selftest.out contains "a typed line becomes a post" else "scooter-r4: typed-line-becomes-post crux missing"
assert selftest.out contains "an empty submit is refused" else "scooter-r4: empty-submit crux missing"
assert selftest.out contains "the prompt on the last row, deterministically" else "scooter-r4: frame-shows-both crux missing"
assert selftest.out contains "clips to the row width with a '~'" else "scooter-r4: prompt-truncation crux missing"
assert selftest.out contains "the caret column tracks the prompt cursor" else "scooter-r4: caret-tracking crux missing"
assert selftest.out contains "the prompt row stays reserved" else "scooter-r4: reserved-prompt-row crux missing"

say "GREEN: scooter-r4 -- scooter_compose joins the family: a typed line becomes a post, journal above and prompt below in one bounded frame, truncation and caret honest, empty submit refused."
