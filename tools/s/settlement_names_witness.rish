# settlement_names_witness.rish -- human-name custody, the SuiNS-analog.
#
# Proves the last JARL settlement door: a settled point number comes to wear a spoken
# name. A keeper who owns the point (its Deed verifies on the shared surface) claims a
# name it also signs; the name resolves both ways, name to point and point to name;
# and the same hand can release it. Names are the shared consensus surface -- globally
# unique, one name to one point, bounded and read together. Every refusal holds -- a
# taken name, an already-named point, a non-owner, a forged signature, a wrongful
# release -- and malformed names never parse.
#
# Build first:  rye build settlement/names.rye -femit-bin=settlement/bin/names
#   rishi/bin/rishi run tools/s/settlement_names_witness.rish

let st = run ["settlement/bin/names" "selftest"]
assert st.ok else "settlement names selftest must exit 0"
assert (st.err contains "GREEN") else "settlement names must report GREEN"
assert (st.err contains "wears a spoken name") else "a point number wears a spoken name"
assert (st.err contains "resolves both ways") else "a name resolves both ways, name to point and point to name"
assert (st.err contains "shared consensus surface") else "names are the shared consensus surface"
assert (st.err contains "one name to one point") else "a name is globally unique, one name to one point"
assert (st.err contains "custody means claim and release") else "custody is claim and release, the owner's own word"
assert (st.err contains "every refusal holds") else "name custody owes its refusals"
assert (st.err contains "a non-owner") else "a non-owner cannot claim a name"
assert (st.err contains "malformed names never parse") else "a malformed name never parses"

say "GREEN: settlement names — a settled number wears a name it can hold and let go, unique across a shared registry, resolvable both ways, and never claimable by a hand that does not own the point."
