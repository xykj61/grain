# tools/font5x7_grave_witness.rish -- the open grave-accent vowels corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box family, the arrows, the block elements, the geometric marks, the
# math/technical operators, the currency signs), the Greek letters (tools/font5x7_greek_witness.rish), the
# sub/superscript and fraction corpora, and the Latin-1 acute/cedilla corpus (tools/font5x7_latin1_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn grave-accent vowels corpus: the five grave lowercase vowels a
# French, Italian, or Portuguese name reaches for -- a grave, e grave, i grave, o grave, u grave -- at their real Unicode
# codepoints U+00E0, U+00E8, U+00EC, U+00F2, U+00F9, each a 5x7 coverage grid drawn in the open as ASCII line art in
# image/font5x7_grave.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint,
# advance, and coverage byte byte-for-byte; all five letters look up present and carry the shared advance while an
# unaccented ASCII vowel misses; no two letters share coverage (each accented name is spelled with its own glyph); each
# letter reads within an honest legibility band; and the grave placement holds as the deliberate MIRROR of the acute set
# -- every grave mark carries top-row ink in the left half and none in the right half, where the acute corpus leans the
# same mark right. Compression is reported as a fact, never asserted -- the round-trip is the proof. No network, no key,
# no funds -- the marks a surface reads the day it prints a name that ASCII cannot spell, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_grave_witness.rish

say "font5x7-grave: Language EN -- Season G font content; the five grave-accent lowercase vowels (a grave, e grave, i grave, o grave, u grave) drawn in the open as ASCII line art, built into the gfa1 atlas, the marks a civic surface prints when it spells a French, Italian, or Portuguese keeper's own name."
say "font5x7-grave: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; the corpus is the deliberate mirror of the acute set, our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-grave: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - grave_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_grave"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_grave.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-grave: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-grave: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-grave: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-grave' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-grave: selftest did not print the GREEN corpus line"

let round = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'round-trip byte-identical' && echo yes"]
assert (trim round.out) == "yes" else "font5x7-grave: round-trip was not byte-identical"

let leans = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'every mark leans left' && echo yes"]
assert (trim leans.out) == "yes" else "font5x7-grave: grave marks did not all lean left"

say "font5x7-grave: GREEN -- the open grave-accent vowels corpus whole; five marks round-trip byte-identical, all present, distinct, and legible, every mark leaning left as the mirror of the acute set; the font gains the grave vowels a civic surface needs to spell a name that ASCII cannot."
