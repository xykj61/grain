# tools/dahl_j11_council_sky_signed_witness.rish — Season 3 Journey 11 (Council skies), Rung 2.
#
# Rung one fixed the council rule as a pure state machine — a council loads a sky, seats a body at an odd
# fractal level, and decides by a majority that never ties. This rung binds each ballot to the voting
# seat's settled Kumara identity, so a vote a member never cast cannot be counted toward a quorum.
# pond/apps/council_sky_signed.rye — each ballot is signed by the very seat it speaks for over the exact
# facts (a tag, the council id, the council size, the seat, the proposal, the yes/no); a Keyring maps a
# seat to its keeper key; vote_signed verifies the seat's own signature before touching rung one's
# council, refusing UnknownKeeper (unenrolled) or BadConsent (unverifying). The honesty crux mirrors the
# group's relabel — flip a ballot's yes to no after signing and reuse the signature, it falls BadConsent.
# The odd-quorum guard carries through r1 (AlreadyVoted, tally unmoved), so signing still cannot fake a
# majority. A forged ballot (wrong keeper), a cross-council signature each refuse. Additive — composes
# council_sky (r1) and kumara over public API; r1 re-runs GREEN. Demo keeper seeds only; no real key, no
# network, no real identity (serve reaches the custody gate).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/dahl_j11_council_sky_signed_witness.rish

say "dahl-j11r2: Language EN — each council ballot carries its seat's signature; a vote cannot be fabricated or faked from one hand."
say "dahl-j11r2: Lens TAME — a flipped choice, a forged ballot, an unenrolled seat, and a cross-council signature each refuse; the odd-quorum guard carries through signing."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/council-sky-signed"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/council_sky_signed.rye -femit-bin=${bin}"]
assert build.ok else "dahl-j11r2: council_sky_signed build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "dahl-j11r2: council_sky_signed selftest exited non-zero"
assert selftest.out contains "GREEN" else "dahl-j11r2: selftest did not speak GREEN"
assert selftest.out contains "each ballot its seat's own word" else "dahl-j11r2: signed-majority crux missing"
assert selftest.out contains "signing cannot fake a majority from one hand" else "dahl-j11r2: lone-hand crux missing"
assert selftest.out contains "cannot swap a member's yes for a no" else "dahl-j11r2: flip-choice crux missing"
assert selftest.out contains "refused UnknownKeeper" else "dahl-j11r2: unknown-keeper refusal missing"

# r1 stays its own GREEN binary — additive.
let r1bin = "pond/bin/council-sky"
let r1build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/council_sky.rye -femit-bin=${r1bin}"]
assert r1build.ok else "dahl-j11r2: r1 rebuild failed"
let r1 = run ["sh" "-c" "${r1bin} selftest 2>&1"]
assert r1.ok else "dahl-j11r2: r1 selftest exited non-zero"
assert r1.out contains "GREEN" else "dahl-j11r2: r1 did not stay GREEN"

say "GREEN: dahl-j11r2 — council_sky_signed binds each ballot to its seat's Kumara identity; a vote cannot be fabricated or faked, and r1 stays GREEN."
