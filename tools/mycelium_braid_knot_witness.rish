# tools/mycelium_braid_knot_witness.rish — the linked-chain verdict reads across a Knot (r3).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · the Braid across a checkpoint · rung r3.
# r1 resolved a whole Cord Dag into a linked-chain Ledger. Yet a ledger a family runs for years does not carry
# its whole past unbroken: the Knot (cord_knot.rye) ties off a committed prefix into a sealed FoldState so a
# bounded Dag runs forever. This rung makes the Braid's corpus a Knot plus its live suffix — the checkpointed
# accounts and the braid opened before the cut read through the same verdict, settled by the links that arrived
# since.
#
# The crux this witness proves is a chain begun before the cut and finished after it: the braid's FIRST link
# (Alice->Bob) is sealed inside the prefix, the chain standing OPEN (no coin moved, since a braid settles only
# when its final link closes it); the routing tail (Bob->Carol->Dave) arrives in the live suffix, the final link
# closes the chain, and the whole atom commits at once. The honest seam this rung makes plain: fold's global
# supply law reads a kind_tax fact as a BURN (taxed <= issued), yet the Braid reuses kind_tax as a CONSERVING
# transfer, so a routing chain taxes far more than issued — a braid seals only its opening (one link within the
# issued bound) and the routing tail rides the suffix, where the Braid's own conserving law governs. A corrupt
# Knot, a tampered suffix link, and a link continuing a chain the checkpoint never opened each refuse whole;
# conservation holds past the cut. Composes braid + cord_knot + cord + fold public API only; demo keeper seeds —
# no key, no funds, no network, no custody.
#
# Scope: active-designing/20260813-081709_mycelium-braid-linked-atomic-chain-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_braid_knot_witness.rish

say "mycelium-braid-knot: Language EN — a chain begun in the sealed past and finished in the living present, and one verdict that cannot tell the difference."
say "mycelium-braid-knot: Style Radiant — the Knot ties off what is settled so the ledger runs forever; the Braid's opening waits in the seal, its routing tail closes in the live suffix, and the atom commits whole across the cut."
say "mycelium-braid-knot: Lens TAME — seal/continue compose braid + cord_knot + cord + fold public API; a corrupt Knot is a runtime gate not an assert; conservation holds past the cut; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/braid_knot"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/braid_knot.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-braid-knot: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-braid-knot: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-braid-knot: selftest did not speak GREEN"
assert selftest.out contains "reads across a Knot" else "mycelium-braid-knot: across-a-Knot claim missing"
assert selftest.out contains "committing at once" else "mycelium-braid-knot: chain-closed-across-cut claim missing"
assert selftest.out contains "conservation of balance whole" else "mycelium-braid-knot: conservation claim missing"
assert selftest.out contains "verdict never drifts" else "mycelium-braid-knot: no-drift claim missing"
assert selftest.out contains "each refuse whole" else "mycelium-braid-knot: refusal claim missing"

# The Braid whose verdict this continues, and the Knot it reads across, both stand at the door —
# their own selftests prove the linked-chain law and the checkpoint machinery the verdict rests on.
let braid = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/braid.rye -femit-bin=mycelium/bin/braid && mycelium/bin/braid 2>&1"]
assert braid.ok else "mycelium-braid-knot: the Braid whose verdict continues is not GREEN"
assert braid.out contains "GREEN" else "mycelium-braid-knot: the Braid did not speak its GREEN"

let knot = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot.rye -femit-bin=mycelium/bin/cord_knot && mycelium/bin/cord_knot 2>&1"]
assert knot.ok else "mycelium-braid-knot: the Knot the Braid reads across is not GREEN"
assert knot.out contains "GREEN" else "mycelium-braid-knot: the Knot did not speak its GREEN"

say "mycelium-braid-knot: GREEN — a linked chain opened inside a sealed prefix closes across the cut, the whole atom committing at once; the verdict reads identically whether a node walks the full Cord or a Knot plus a live suffix, conservation whole; a corrupt Knot · a tampered suffix link · a link continuing a chain the checkpoint never opened each refuse whole; the Braid and the Knot stand at the door."
