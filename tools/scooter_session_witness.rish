# tools/scooter_session_witness.rish -- Scooter, the whole loop, on metal.
#
# pond/apps/scooter_session.rye is the terminal family's capstone on the Pond floor: it joins the two proven
# halves that stood a step apart. The WRITE half (scooter_input over scooter_compose) commits a keeper's typed
# lines as posts; the READ half (scooter_nav over scooter_read) scrolls a held position over the same journal.
# A real terminal chat is BOTH at once, so this module holds one compose Session and one read View over one
# channel and routes each decoded keystroke to the half it belongs to -- editing keys edit the prompt,
# navigation keys scroll the view, Enter posts and snaps home. The drawn frame follows the read position.
# Held PURE, custody-first: it composes a channel, a prompt, and a scroll position -- no TTY, no network, no key.
# This witness builds the module and asserts its selftest speaks GREEN over the seven cruxes:
#   - A printable run edits the prompt and leaves the read view and journal untouched.
#   - A navigation run scrolls the read view and holds the draft prompt untouched.
#   - Enter commits the prompt as a post and snaps the view home to the newest line.
#   - A bare Enter posts nothing and the journal holds its count.
#   - Home and End move the prompt cursor and never scroll the read view.
#   - A full journal stops the feed by name, dropping no post.
#   - The drawn frame follows the read position -- the live prompt at home, the window scrolled back.
#
# Facts only, custody-first: the cbreak TTY read and the Comlink wire between two Constel piers reach the serve gate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/scooter_session_witness.rish

say "scooter-session: Language EN -- one keystroke stream drives the whole terminal chat, read and write at once."
say "scooter-session: Lens TAME -- editing and navigation a disjoint partition of the keys, every bound asserted, no TTY, no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"

let bin = "pond/bin/scooter-session"
let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/scooter_session.rye -femit-bin=${bin}"]
assert build.ok else "scooter-session: scooter_session build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "scooter-session: scooter_session selftest exited non-zero"
assert selftest.out contains "GREEN" else "scooter-session: selftest did not speak GREEN"
assert selftest.out contains "edits the prompt and leaves the read view and journal untouched" else "scooter-session: typing-isolation crux missing"
assert selftest.out contains "scrolls the read view and holds the draft prompt untouched" else "scooter-session: navigation-isolation crux missing"
assert selftest.out contains "commits the prompt as a post and snaps the view home" else "scooter-session: enter-snaps-home crux missing"
assert selftest.out contains "a bare Enter posts nothing" else "scooter-session: empty-enter crux missing"
assert selftest.out contains "Home and End move the prompt cursor and never scroll" else "scooter-session: home-end-line crux missing"
assert selftest.out contains "a full journal stops the feed by name" else "scooter-session: journal-full crux missing"
assert selftest.out contains "the drawn frame follows the read position" else "scooter-session: frame-follows crux missing"

say "GREEN: scooter-session -- one keystroke stream drives the whole terminal chat: editing keys edit the prompt, navigation keys scroll the read view, Enter posts and snaps home, the frame follows the position, the two halves never disturb each other."
