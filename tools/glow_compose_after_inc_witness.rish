# tools/glow_compose_after_inc_witness.rish — STOA339b: compose-after-inc desk.
#
#   rishi/bin/rishi run tools/glow_compose_after_inc_witness.rish
#
# The brief's full sentence: one Tend unary desk that vanes call after surface-inc.
# Chain: surface-inc 3 → GREEN; compose-sumto argv 4 → GREEN; welcome fixture GREEN;
# stranger still refuses; 339 unary witness stays warm.

say "339b: surface-inc 3 — the first half of the compose..."
let inc = run ["rishi/bin/rishi" "run" "tools/glow_run.rish" "src/lib/gate-surface-inc-u32.glow" "3"]
assert inc.ok else "339b: surface-inc 3 failed"
assert inc.out contains "GREEN" else "339b: surface-inc not GREEN"

say "339b: compose-sumto argv 4 — after that inc..."
let a4 = run ["rishi/bin/rishi" "run" "tools/glow_run.rish" "src/lib/gate-compose-sumto-u32.glow" "4"]
assert a4.ok else "339b: compose-sumto argv 4 failed"
assert a4.out contains "GREEN" else "339b: compose-sumto argv not GREEN"

say "339b: welcome fixture — both sides of the desk..."
let fx = run ["rishi/bin/rishi" "run" "tools/glow_run.rish" "glow/gen/gate-compose-sumto.glow"]
assert fx.ok else "339b: compose-sumto fixture failed"
assert fx.out contains "GREEN" else "339b: compose-sumto fixture not GREEN"

say "339b: stranger still refuses..."
let st = run ["rishi/bin/rishi" "run" "tools/glow_run.rish" "glow/gen/gate-stranger-refuse-339.glow"]
assert (st.ok == false) else "339b: stranger must refuse"

say "339b: STOA339 unary ground stays warm..."
let u = run ["rishi/bin/rishi" "run" "tools/glow_compose_tend_unary_witness.rish"]
assert u.ok else "339b: unary witness must stay GREEN"

say "GREEN: STOA339b — compose-after-inc desk; both sides; strangers still refuse; unary warm."
