# tools/font5x7_superscript_witness.rish -- the open superscript-digits corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box, arrow, block, geometric, math, and currency witnesses), the Greek
# letters (tools/font5x7_greek_witness.rish), and the subscript digits (tools/font5x7_subscript_witness.rish) -- this
# corpus is that subscript's twin from the other side of the line.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn superscript-digits corpus: the ten small digits a formula
# raises -- the numbers an exponent sets above the line (x(2), 10(6)), a footnote marks with, or an ordinal prints --
# at their real Unicode codepoints U+00B2, U+00B3, U+00B9 (one, two, three in the Latin-1 Supplement) and U+2070,
# U+2074..U+2079 (zero, four through nine in the superscripts block), each a 5x7 coverage grid drawn in the open as
# ASCII line art in image/font5x7_superscript.rye, built into a gfa1 atlas and proven on metal. A full round-trip
# recovers every codepoint, advance, and coverage byte byte-for-byte; all ten digits look up present and carry the
# shared advance while a full-height ASCII digit misses; no two digits share coverage; each reads within an honest
# legibility band; every digit sits high (the bottom two rows blank) so it reads as a superscript; the codepoint table
# is non-contiguous and digit-scrambled (it opens on the digit two at its lowest codepoint, unlike the tidy subscript
# run); and the family order holds -- the dense superscript eight out-inks the sparse superscript one. Compression is
# reported as a fact, never asserted -- the round-trip is the proof. No network, no key, no funds -- the small digits a
# surface sets high the day it prints an exponent, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_superscript_witness.rish

say "font5x7-superscript: Language EN -- Season G font content; the ten superscript digits (zero through nine) drawn in the open as small high ASCII line art, built into the gfa1 atlas, the numbers a formula sets above the line (x(2), 10(6)); the twin of the subscript corpus from the other side of the line."
say "font5x7-superscript: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every digit byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-superscript: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - superscript_count - the atlas ceilings it rests on); each function states its invariants positively; the codepoints are carried as an explicit ascending table (the run is genuinely non-contiguous) and proven strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_superscript"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_superscript.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-superscript: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-superscript: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-superscript: ${out}"

assert selftest.out contains "GREEN image-font5x7-superscript" else "font5x7-superscript: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-superscript: round-trip was not byte-identical"

assert selftest.out contains "raised to the top five rows" else "font5x7-superscript: digits were not proven raised"

say "font5x7-superscript: GREEN -- the open superscript-digits corpus whole; ten small high digits round-trip byte-identical, all present, distinct, legible, and raised, their codepoint table non-contiguous and digit-scrambled, the dense eight out-inking the sparse one; the font gains the numbers a surface sets above the line when it prints an exponent."
