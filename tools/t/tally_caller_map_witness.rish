# tally_caller_map_witness.rish — one seam caller map for Tally marks (Arc IV Unify).
#
# Canon prose: tally/README.md § Who calls Tally. This witness proves a closed
# set of consumer symlink homes still resolve — drift fails loud.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tally_caller_map_witness.rish

let scan = run ["sh" "tools/fixtures/tally_caller_map_scan.sh"]
if scan.ok == false then say "MISSING caller symlink or file:"
if scan.ok == false then say scan.out
assert scan.ok else "tally caller map has a broken consumer path"

let readme = run ["sh" "-c" "grep -F '## Who calls Tally' tally/README.md"]
assert readme.ok else "tally/README.md must carry the canon Who calls Tally section"

let saga = run ["sh" "-c" "grep -F 'Canon caller map' saga/README.md"]
assert saga.ok else "saga/README.md must point at the tally canon caller map"

say "GREEN: tally caller map — closed consumer paths resolve; canon prose seated."
