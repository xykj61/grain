# tensegral_arc_iv_witness.rish — Arc IV happy-zone fold (Tighten · Unify · Habitat).
#
# Witness habitat first: fast isolated Tally greens + caller map + gardens
# bounds. No metalsmoke suite claim. Stay tensegral.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tensegral_arc_iv_witness.rish

say "tensegral-arc-iv: foundation seeds..."
let seeds = run ["rishi/bin/rishi" "run" "tools/f/foundation_seeds.rish"]
assert seeds.ok else "foundation_seeds failed"
assert seeds.out contains "GREEN" else "foundation_seeds not GREEN"

say "tensegral-arc-iv: tally copy..."
let copy = run ["rishi/bin/rishi" "run" "tools/t/tally_copy.rish"]
assert copy.ok else "tally_copy failed"
assert copy.out contains "GREEN" else "tally_copy not GREEN"

say "tensegral-arc-iv: tally maybe..."
let maybe = run ["rishi/bin/rishi" "run" "tools/t/tally_maybe.rish"]
assert maybe.ok else "tally_maybe failed"
assert maybe.out contains "GREEN" else "tally_maybe not GREEN"

say "tensegral-arc-iv: tally no_padding..."
let pad = run ["rishi/bin/rishi" "run" "tools/t/tally_no_padding.rish"]
assert pad.ok else "tally_no_padding failed"
assert pad.out contains "GREEN" else "tally_no_padding not GREEN"

say "tensegral-arc-iv: tally parse_int..."
let pint = run ["rishi/bin/rishi" "run" "tools/t/tally_parse_int.rish"]
assert pint.ok else "tally_parse_int failed"
assert pint.out contains "GREEN" else "tally_parse_int not GREEN"

say "tensegral-arc-iv: tally gardens bounds..."
let gardens = run ["rishi/bin/rishi" "run" "tools/t/tally_gardens_witness.rish"]
assert gardens.ok else "tally_gardens_witness failed"
assert gardens.out contains "GREEN" else "tally_gardens_witness not GREEN"

say "tensegral-arc-iv: tally caller map..."
let callers = run ["rishi/bin/rishi" "run" "tools/t/tally_caller_map_witness.rish"]
assert callers.ok else "tally_caller_map_witness failed"
assert callers.out contains "GREEN" else "tally_caller_map_witness not GREEN"

say "GREEN: Tensegral Arc IV — habitat (seeds · marks · gardens · caller map)."
