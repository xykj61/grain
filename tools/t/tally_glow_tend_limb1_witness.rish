# tools/t/tally_glow_tend_limb1_witness.rish -- first Tally Glow Tend limb (e191).
#
# Proves the Glow pedestal names max_gardens in lockstep with tally/gardens.rye,
# lowers cleanly, and that Caravan/Aurora Glow Tend limbs are still absent
# (ladder honesty -- Tally first).
#
#   rishi/bin/rishi run tools/t/tally_glow_tend_limb1_witness.rish

say "tally-tend-1: Language EN — first Tally Glow Tend limb."
say "tally-tend-1: Style Radiant — pedestal beside Rye; no allocator rewrite."
say "tally-tend-1: Lens TAME — Equinox e191 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/gate/shape-tally-max-gardens.glow"

say "tally-tend-1: placard..."
let placard = run ["sh" "-c" "head -n 7 src/gate/shape-tally-max-gardens.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "tally-tend-1: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "tally-tend-1: placard missing six lines"

say "tally-tend-1: example locks to rye max_gardens..."
let g_example = run ["sh" "-c" "grep -q 'example    8' src/gate/shape-tally-max-gardens.glow"]
assert g_example.ok else "tally-tend-1: example 8 missing on pedestal"
let g_name = run ["sh" "-c" "grep -q 'max_gardens' src/gate/shape-tally-max-gardens.glow"]
assert g_name.ok else "tally-tend-1: max_gardens name missing on pedestal"
let g_elder = run ["sh" "-c" "grep -q 'tally/gardens.rye' src/gate/shape-tally-max-gardens.glow"]
assert g_elder.ok else "tally-tend-1: gardens.rye citation missing"
let g_rye = run ["sh" "-c" "grep -E '^pub const max_gardens: u32 = 8;$' tally/gardens.rye"]
assert g_rye.ok else "tally-tend-1: rye max_gardens must remain 8"

say "tally-tend-1: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "tally-tend-1: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "tally-tend-1: shape did not exit 0"

say "tend-ladder: Aurora A1 may be present..."
let aurora = run ["sh" "-c" "test -f src/shape/shape-aurora-wire-capacity.glow"]
assert aurora.ok else "tend-ladder: Aurora A1 pedestal missing after e197"

say "tally-tend-1: tally glow path present..."
# find plus grep rather than `rg --glob`: same question -- which .glow files under src name tally --
# in a spelling both piers carry. On a bench without ripgrep this line reported "tally glow limb
# missing" about a file that is present and matches (20260905.224445).
let has = run ["sh" "-c" "test -f src/gate/shape-tally-max-gardens.glow && find src -name '*.glow' -exec grep -l tally {} + | grep -q shape-tally-max-gardens && echo TALLY_OK"]
assert has.ok else "tally-tend-1: tally glow limb missing"
assert has.out contains "TALLY_OK" else "tally-tend-1: tally glow limb not indexed"

say "GREEN: tally Glow Tend limb 1 — max_gardens=8 pedestal; Tend ladder continues."
