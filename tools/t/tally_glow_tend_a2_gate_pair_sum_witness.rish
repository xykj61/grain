# tools/t/tally_glow_tend_a2_gate_pair_sum_witness.rish -- Ashvini a2: pair list fold (e244).
#
#   rishi/bin/rishi run tools/t/tally_glow_tend_a2_gate_pair_sum_witness.rish

say "a2-pair: Language EN — the first list fold (STOA333)."
say "a2-pair: Style Radiant — pair-shape fields folded into one @u32."
say "a2-pair: Lens TAME — empty · within · plant on wrong sample shape."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-tally-fold-pair-sum.glow"

say "a2-pair: empty pair (0 0) answers 0..."
let empty = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "0" "0"]
assert empty.ok else "a2-pair: empty failed to run"
assert empty.out contains "EXIT:0" else "a2-pair: empty did not exit 0"
assert empty.out contains "0" else "a2-pair: empty did not speak 0"

say "a2-pair: within (3 5) answers 8..."
let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk "3" "5"]
assert ok.ok else "a2-pair: accept failed to run"
assert ok.out contains "EXIT:0" else "a2-pair: accept did not exit 0"
assert ok.out contains "8" else "a2-pair: accept did not speak 8"

say "a2-pair: sum under @u32 must refuse (wrong nest)..."
let plant = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "tools/fixtures/gate-fold-sum-on-u32.glow" "3"]
assert plant.err contains "SampleDoesNotNest" else "a2-pair: wrong-nest plant was accepted"

say "a2-pair: sumto neighbor still green..."
let sumto = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" "src/lib/gate-tally-fold-sumto-u32.glow" "3"]
assert sumto.ok else "a2-pair: sumto regression failed"
assert sumto.out contains "6" else "a2-pair: sumto did not speak 6"

say "GREEN: a2 pair-sum fold — empty · within; wrong nest refuses; sumto stands."
