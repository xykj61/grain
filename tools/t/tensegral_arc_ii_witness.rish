# tensegral_arc_ii_witness.rish — Arc II public fold (Resin · Glow · Sameness).
#
# Sameness is the macro: one named fold, many callers. Refuse the private
# habit of pasting seven witness paths into every counsel page.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tensegral_arc_ii_witness.rish

say "tensegral-arc-ii: resin unit..."
let resin = run ["rishi/bin/rishi" "run" "tools/r/resin_unit_witness.rish"]
assert resin.ok else "resin_unit_witness failed"
assert resin.out contains "GREEN" else "resin_unit_witness not GREEN"

say "tensegral-arc-ii: glow text floor..."
let text = run ["rishi/bin/rishi" "run" "tools/g/glow_text_floor_witness.rish"]
assert text.ok else "glow_text_floor_witness failed"
assert text.out contains "GREEN" else "glow_text_floor_witness not GREEN"

say "tensegral-arc-ii: glow digraph twin..."
let digraph = run ["rishi/bin/rishi" "run" "tools/g/glow_digraph_twin_witness.rish"]
assert digraph.ok else "glow_digraph_twin_witness failed"
assert digraph.out contains "GREEN" else "glow_digraph_twin_witness not GREEN"

say "tensegral-arc-ii: glow truth..."
let truth = run ["rishi/bin/rishi" "run" "tools/g/glow_truth_semantics_witness.rish"]
assert truth.ok else "glow_truth_semantics_witness failed"
assert truth.out contains "GREEN" else "glow_truth_semantics_witness not GREEN"

say "GREEN: Tensegral Arc II — resin unit · text floor · digraph twin · truth (sameness fold)."
