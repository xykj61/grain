# tools/t/tend_reach_witness.rish -- Q52: the reach census answers, shape held.
#
# Runs the standing census and demands its answer shape: six-or-fewer room
# lines and one TOTAL line carrying rooms_files and orphans counts.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tend_reach_witness.rish

let census = run ["sh" "tools/t/tend_reach_census.sh"]
assert census.ok else "tend_reach: census must exit ok"
assert census.out contains "method v2-self-mention-excluded" else "tend_reach: method named"
assert census.out contains "session-logs tracked=" else "tend_reach: rooms speak"
assert census.out contains "TOTAL rooms_files=" else "tend_reach: total speaks"
assert census.out contains "orphans=" else "tend_reach: orphans named"

say "GREEN: tend_reach — the census stands as an instrument and answers in shape."
