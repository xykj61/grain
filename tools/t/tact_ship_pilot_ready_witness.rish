# tools/t/tact_ship_pilot_ready_witness.rish — TACT Journey 1, Rung 4: the ready-to-run report.
#
# Rungs one through three fixed the arc and wired its identity and customs steps to real modules.
# This rung closes Ship-Pilot's agent-doable crux — the whole first-run walked end to end, every
# step wired real. The place step decodes the settled point to a real topology galaxy; the app
# step names a runnable Pond app off an allow-list of what pond/bin truly builds. With every step
# proven the pilot reaches PILOT READY and the report names the concrete facts (point, place,
# mark, app); any unmet step holds the pilot there and the report says where — the first-run never
# claims ready on a step it did not prove.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/t/tact_ship_pilot_ready_witness.rish

say "tact1: Language EN — the first-run reaches READY only with every step proven."
say "tact1: Lens TAME — an invented app and a held mark each stop the arc; the report says where it held, never claiming ready."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/ship-pilot-ready"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/ship_pilot_ready.rye -femit-bin=${bin}"]
assert build.ok else "tact1: ship_pilot_ready build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "tact1: ship_pilot_ready selftest exited non-zero"
assert selftest.out contains "GREEN" else "tact1: selftest did not speak GREEN"
assert selftest.out contains "the whole arc walked real and reached PILOT READY; the report named the facts" else "tact1: full-arc-ready claim missing"
assert selftest.out contains "an app the tree does not build held the pilot at the app step" else "tact1: unknown-app hold missing"
assert selftest.out contains "a held customs mark stopped the arc at customs; the report never claimed ready" else "tact1: held-customs stop missing"
assert selftest.out contains "the first-run reaches READY only with every step proven, and reports where it holds" else "tact1: crux claim missing"

# The three rungs this report composes over stay their own green binaries.
let spine = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/ship_pilot.rye -femit-bin=pond/bin/ship-pilot && pond/bin/ship-pilot selftest 2>&1"]
assert spine.ok else "tact1: ship_pilot spine re-run failed"
assert spine.out contains "GREEN" else "tact1: spine selftest did not speak GREEN"

let ident = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/ship_pilot_identity.rye -femit-bin=pond/bin/ship-pilot-identity && pond/bin/ship-pilot-identity selftest 2>&1"]
assert ident.ok else "tact1: ship_pilot_identity re-run failed"
assert ident.out contains "GREEN" else "tact1: identity selftest did not speak GREEN"

let cust = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/ship_pilot_customs.rye -femit-bin=pond/bin/ship-pilot-customs && pond/bin/ship-pilot-customs selftest 2>&1"]
assert cust.ok else "tact1: ship_pilot_customs re-run failed"
assert cust.out contains "GREEN" else "tact1: customs selftest did not speak GREEN"

say "tact1: GREEN — the Ship-Pilot first-run walks end to end; READY only with every step proven, else it reports where it holds."
