# tools/t/tally_a2_list_reducer_witness.rish — Ashvini a2: the reducer is chosen (e248/e249).
#
#   rishi/bin/rishi run tools/t/tally_a2_list_reducer_witness.rish
#
# The list fold folds any closed tuple. STOA336 makes its REDUCER a choice at the
# call: `|+ sum <face>` and `|+ prod <face>` fold the same fields of the same shape
# and differ only in operator and identity — the sum of no fields is zero, the
# product of none is one. Both wrap on purpose, as the seated sum does.

say "a2-reducer: Language EN — sum and prod over one shape, chosen at the call."
say "a2-reducer: Lens TAME — same fields, same bound; only operator and identity differ."

let zig = "vendor/zig-toolchain/zig"
let prod = "src/lib/gate-tally-fold-triple-prod.glow"
let sum = "src/lib/gate-tally-fold-triple-sum.glow"
let mantra = "src/lib/gate-mantra-fold-triple-fields.glow"

say "a2-reducer: prod folds three fields by product..."
let p1 = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" prod "3" "5" "7"]
assert p1.ok else "a2-reducer: prod failed to run"
assert p1.out contains "EXIT:0" else "a2-reducer: prod did not exit 0"
assert p1.out contains "105" else "a2-reducer: 3 5 7 did not fold to 105"

say "a2-reducer: the product identity shows itself at all ones..."
let p2 = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" prod "1" "1" "1"]
assert p2.ok else "a2-reducer: identity case failed to run"
assert p2.out contains "1" else "a2-reducer: 1 1 1 did not fold to 1"

say "a2-reducer: one zero field carries the whole product to zero..."
let p3 = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" prod "0" "4" "9"]
assert p3.ok else "a2-reducer: zero-field case failed to run"
assert p3.out contains "0" else "a2-reducer: 0 4 9 did not fold to 0"

say "a2-reducer: the N-sum desk on the same shape still answers 15..."
let s1 = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" sum "3" "5" "7"]
assert s1.ok else "a2-reducer: sum neighbour failed to run"
assert s1.out contains "15" else "a2-reducer: 3 5 7 no longer sums to 15"

say "a2-reducer: the mantra sum desk on the same shape still answers 15..."
let s2 = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" mantra "3" "5" "7"]
assert s2.ok else "a2-reducer: mantra sum neighbour failed to run"
assert s2.out contains "15" else "a2-reducer: mantra 3 5 7 no longer sums to 15"

say "a2-reducer: each desk still names its own verb..."
let vp = run ["sh" "-c" "grep -qE '^[|][+]  prod  ' src/lib/gate-tally-fold-triple-prod.glow"]
assert vp.ok else "a2-reducer: the prod desk stopped naming its verb"
let vs = run ["sh" "-c" "grep -qE '^[|][+]  sum  ' src/lib/gate-tally-fold-triple-sum.glow"]
assert vs.ok else "a2-reducer: the sum desk stopped naming its verb"
let vm = run ["sh" "-c" "grep -qE '^[|][+]  sum  ' src/lib/gate-mantra-fold-triple-fields.glow"]
assert vm.ok else "a2-reducer: the mantra desk stopped naming its verb"

say "GREEN: a2 reducer chosen — sum and prod fold one shape; both sum desks stand; verbs named."
