# tools/t/tablecloth_glow_tend_witness.rish -- Tablecloth's first Glow desk, and the drift it
# cannot hide.
#
#   rishi/bin/rishi run tools/t/tablecloth_glow_tend_witness.rish
#
# WHY THIS RUNG. Every other infrastructure vane carrying a bound worth naming already stands in
# the shape museum -- Aurora four pedestals, Mantra four, Caravan three, Tally six, Comlink one.
# Tablecloth stood there not at all, with zero Glow desks of any kind, while `brushstroke/
# tablecloth.rye` publishes the catalog capacity that the Brix-facing manifest and the four
# `comlink/guest_tablecloth_query_*` wires both lean on. A bound nothing names outside its own
# source is a bound only its author can check. This seats the first pedestal and the guard that
# keeps it honest.
#
# WHAT IS PROVEN, on metal.
#   The placard reads in the order src/shape/PLACARD.md seats: name, shape, invariant, example,
#   readers, nib.
#   The pedestal names the Rye file its number comes from, so a reader can walk to the source.
#   The number the pedestal shows EQUALS the number brushstroke/tablecloth.rye publishes as
#   `max_artifacts`. The scan reads both and compares; it carries no value of its own, so raising
#   the bound honestly in both rooms leaves the guard quiet -- proven as a welcome, not assumed.
#   The desk lowers through Glow, builds through the Zig toolchain, and runs to EXIT:0.
#   Every reading refuses from the other side: eight plantings in a throwaway pen, each caught by
#   the reading it was planted against, and two honest trees walking free.
#
# WHAT IS NOT PROVEN. Whether thirty-two is the right capacity -- that is Tablecloth's own design
# question and a pedestal only displays what the source decided. Whether the catalog's other
# bounds agree with anything: `max_name`, `max_content_bytes`, and the eight ClothError paths wait
# for their own pedestals. And any behavior of the store itself, which
# tools/b/buhr_tablecloth_witness.rish already holds on real bytes.

say "tablecloth-tend: Language EN -- Tablecloth holds a thing by what it is, and until now it held nothing in the shape museum. This seats its first pedestal."
say "tablecloth-tend: Style Gauge -- the placard reads in the museum's seated order, and the number it shows is compared to the source rather than remembered."
say "tablecloth-tend: Lens TAME -- bound everything and say why: the catalog names a maximum, the pedestal names the maximum, and this proves the two are one number."

say "tablecloth-tend: the pedestal against its source..."
let scan = run ["sh" "tools/fixtures/t/tablecloth_glow_tend_scan.sh"]
assert scan.ok else "tablecloth-tend: the pedestal and brushstroke/tablecloth.rye disagree -- read the verdict line"
say scan.out
assert scan.out contains "verdict=agree" else "tablecloth-tend: the two rooms must name one number"
assert scan.out contains "citation=yes" else "tablecloth-tend: a pedestal names the source its number came from"
assert scan.out contains "placard_order=name shape invariant example readers nib" else "tablecloth-tend: the placard's six lines keep their seated order"
say "field GREEN -- the pedestal and the Rye source name one capacity"

say "tablecloth-tend: the control, both ways..."
let control = run ["sh" "tools/fixtures/t/tablecloth_glow_tend_control.sh"]
assert control.ok else "tablecloth-tend: the control must complete"
say control.out
assert control.out contains "welcomes=2" else "tablecloth-tend: an honest tree and an honest raise must both walk free"
assert control.out contains "refusals=8" else "tablecloth-tend: every reading must refuse from its own side"
assert control.out contains "wrong=0" else "tablecloth-tend: no case may land on the side it was not planted for"
assert control.out contains "control_verdict=ok" else "tablecloth-tend: the control must agree with itself"
say "RED and GREEN paths proven -- eight plantings refused, two honest trees welcomed"

let zig = "vendor/zig-toolchain/zig"
let desk = "src/shape/shape-tablecloth-catalog-capacity.glow"

say "tablecloth-tend: lower, build, run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/g/glow_run_worker.sh" desk]
assert gate.ok else "tablecloth-tend: the pedestal must lower, build, and run"
assert gate.out contains "EXIT:0" else "tablecloth-tend: the pedestal did not exit 0"
say "metal GREEN -- the desk lowers through Glow, builds through Zig, and runs"

say "GREEN: tablecloth Glow Tend -- max_artifacts stands on a pedestal, compared to its source rather than copied from it."
