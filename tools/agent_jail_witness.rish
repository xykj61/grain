# agent_jail_witness.rish — prove tools/agent-jail.sh on Linux (keeper pier).
#
#   rishi/bin/rishi run tools/agent_jail_witness.rish
#
# Or without Rishi built yet:
#   ./tools/agent_jail_witness.sh
#
# Run from an ordinary host shell at the repository root.

let result = run ["bash" "tools/agent_jail_witness.sh"]
say "agent_jail_witness: ok=${result.ok}"
assert result.ok else "agent-jail witness RED — see tools/agent_jail_witness.sh output"
say "GREEN: agent-jail witness"
