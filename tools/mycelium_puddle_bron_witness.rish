# tools/mycelium_puddle_bron_witness.rish — a fleet travels as a readable record, and berths the same
# offline (r3, travel).
#
# Season D (Kresfa & Mycelium) · Puddle fleet orchestration · rung r3 — travel.
# r1 derived the berth; r2 healed the fleet. A fleet a node cannot hand to another is only a local layout,
# so r3 lets the whole roster cross as `format puddle-fleet-v1` bytes — one `host <pk-hex> <capacity>` line
# per host, one `world <id>` line each. The reader rebuilds the fleet through r1's own add_host/add_world,
# so the fleet's laws travel with the bytes.
#
# The crux this witness proves is THE PLACEMENT SURVIVES THE WIRE, not merely the bytes: a fleet parsed from
# bytes berths to the byte-identical placement as the fleet in memory — two nodes agree on where every world
# runs by exchanging the roster alone. Render writes it, parse reads it back byte-for-byte (fixed point).
# Composes puddle.rye public API only; demo host and world seeds — no key, no funds, no network, no world
# provisioned.
#
# Scope: active-designing/20260813-114651_puddle-fleet-placement-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_puddle_bron_witness.rish

say "mycelium-puddle-bron: Language EN — a placement two nodes reach only by holding the same roster is a placement they can hand to each other: the fleet crosses as readable text, and the recovered roster berths every world exactly where the sender's did."
say "mycelium-puddle-bron: Style Radiant — r1 derived the berth, r2 healed it; r3 lets the whole fleet travel and proves the placement, not merely the bytes, survives the wire."
say "mycelium-puddle-bron: Lens TAME — the record is a purpose-built bounded reader, never a general parser; the reader rebuilds through r1's own add_host/add_world so the fleet's laws travel with the bytes; refuses a bad header, unknown field, malformed line, bad hex key, bad capacity, duplicate host; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/puddle_bron"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/puddle_bron.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-puddle-bron: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-puddle-bron: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-puddle-bron: selftest did not speak GREEN"
assert selftest.out contains "parses back byte-for-byte (fixed point)" else "mycelium-puddle-bron: fixed-point claim missing"
assert selftest.out contains "the recovered fleet berths to the byte-identical placement" else "mycelium-puddle-bron: placement-survives-wire crux claim missing"
assert selftest.out contains "The roster carries the placement" else "mycelium-puddle-bron: closing claim missing"

# The refusal ledger a keeper reads — the bounded reader's refusals and the fleet's own laws travelling.
assert selftest.out contains "a bad header, an unknown field, a malformed line, a bad hex key, a bad capacity, a duplicate host each refuse" else "mycelium-puddle-bron: refusal ledger missing"

# The rendered fleet a keeper reads — four hosts, six worlds.
assert selftest.out contains "hosts=4 worlds=6" else "mycelium-puddle-bron: rendered fleet (4 hosts, 6 worlds) missing"

# The r1 berth the travel rests on stands at the door.
let r1 = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/puddle.rye -femit-bin=mycelium/bin/puddle && mycelium/bin/puddle 2>&1"]
assert r1.ok else "mycelium-puddle-bron: the r1 berth the travel rests on is not GREEN"
assert r1.out contains "GREEN" else "mycelium-puddle-bron: the r1 berth did not speak its GREEN"

say "mycelium-puddle-bron: GREEN — a fleet travels as a format puddle-fleet-v1 record and berths the same offline: the recovered roster berths every world to the byte-identical placement, a round trip is a fixed point, and the fleet's own laws travel with the bytes; the r1 berth stands at the door. The roster carries the placement."
