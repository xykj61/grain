# one_clock_witness.rish -- one-clock naming law ratchet.
#
# Ceiling retired: the host-zone fix removes the UTC-drift cause, so a
# maintained human ceiling would add only upkeep and a back door.
#
# Duties:
#   1. shape -- every living dated filename matches ^\d{8}-\d{6}_
#   2. monotonicity -- living stamps stay <= true_head, with errata listed in
#      tools/fixtures/o/one_clock_drift_erratum.txt (the four UTC files)
#   3. zone -- host zone equals America/New_York by its name
#   4. provenance -- new stamps stay within ONE_CLOCK_PROVENANCE_TOLERANCE_SECONDS
#      ahead of the live host clock (duty 3 checks the host; duty 4 checks the stamp)
#   5. head -- the newest LIVING stamp is at or behind the live clock, within
#      ONE_CLOCK_HEAD_TOLERANCE_SECONDS. Duty 4 weighs only artifacts new
#      against xy/main, so a merged lap leaves that comparison; duty 5
#      weighs the head itself, every run, forever (REDS %96)
#   6. reach -- duty 5's POPULATION, proven by planting a fabricated stamp where
#      the law puts one: on its day shelf. Duties 1-5 read a flat glob that saw
#      247 of 7,344 dated artifacts, so a log born on its shelf from
#      20260827.171500 was invisible to the gate built for it
#      (tools/fixtures/o/one_clock_population_control.sh, 20260911.020039)
#
# Mode: tools/fixtures/o/one_clock_mode.txt -- blocking (seated 20260724.204741).
#
#   rishi/bin/rishi run tools/o/one_clock_witness.rish

let mode_line = run ["sh" "-c" "head -1 tools/fixtures/o/one_clock_mode.txt"]
let mode = trim mode_line.out
assert mode_line.ok else "one_clock_mode.txt unreadable"
assert (mode contains "block") else "one_clock_mode.txt must be blocking (or advisory during thaw)"

let shape = run ["sh" "tools/fixtures/o/one_clock_shape_scan.sh"]
assert shape.ok else "one_clock shape scan failed to run"
assert (shape.out contains "SHAPE_OK") else "dated filename shape failed (expected ^YYYYMMDD-HHMMSS_)"
assert ((shape.out contains "SHAPE_BAD") == false) else "dated filename shape violations present"

let mono = run ["sh" "tools/fixtures/o/one_clock_mono_scan.sh"]
say mono.out
assert mono.ok else "one_clock mono scan failed to run"
assert (mono.out contains "MONO_OK") else "one-clock monotonicity failed"
assert ((mono.out contains "MONO_BAD") == false) else "one-clock MONO_BAD present"

let zone = run ["sh" "tools/fixtures/o/one_clock_zone_scan.sh"]
say zone.out
assert zone.ok else "one_clock zone scan failed to run"
assert (zone.out contains "ZONE_OK") else "one-clock host zone is not America/New_York by name"
assert ((zone.out contains "ZONE_BAD") == false) else "one-clock ZONE_BAD present"

# Duty 4 -- provenance fixtures (PASS: live clock stamp; FAIL: four hours ahead)
let host_run = run ["sh" "-c" "TZ=America/New_York date +%Y%m%d.%H%M%S"]
let host_dot = trim host_run.out
assert host_run.ok else "host clock read failed"
assert (length host_dot) == 15 else "host clock stamp malformed"

let pass_prov = run ["sh" "-c" "ONE_CLOCK_PROVENANCE_STAMPS='${host_dot}' sh tools/fixtures/o/one_clock_provenance_scan.sh"]
say pass_prov.out
assert pass_prov.ok else "provenance PASS fixture failed — live clock stamp must pass"

# THE SHIFT NEEDS NO EXTENSION; THE FORMATTING DOES. `date -d '+4 hours'` is GNU-only and comes
# back empty under the BSD `date` macOS ships, so this fixture built an EMPTY stamp and the FAIL
# leg passed for the wrong reason -- the scan called an empty string unparsable rather than four
# hours ahead (REDS %250). Adding seconds to `date +%s` is arithmetic every host spells alike;
# only turning that epoch back into a stamp wanted a dialect answer, and stamp_ahead holds it.
let ahead = run ["sh" "-c" "export TZ=America/New_York; . tools/fixtures/s/shell_portable.sh; stamp_ahead 14400"]
assert ahead.ok else "could not compute four-hours-ahead stamp"
let ahead_dot = trim ahead.out
let fail_prov = run ["sh" "-c" "ONE_CLOCK_PROVENANCE_STAMPS='${ahead_dot}' sh tools/fixtures/o/one_clock_provenance_scan.sh"]
assert fail_prov.ok == false else "provenance FAIL fixture passed — four-hours-ahead stamp must fail"
assert fail_prov.out contains "PROV_BAD" else "provenance FAIL fixture must emit PROV_BAD"

let prov = run ["sh" "-c" "ONE_CLOCK_PROVENANCE_BASE=xy/main sh tools/fixtures/o/one_clock_provenance_scan.sh"]
say prov.out
assert prov.ok else "one_clock provenance scan failed on branch artifacts"


# Duty 5 -- the living head never stands ahead of the clock (REDS %96)
#
# Duty 4's base is `xy/main`, so it weighs a dated artifact for exactly as
# long as that artifact stays unmerged. Every lap that lands and merges retires
# its own stamps from that diff, which is why a head written 22 minutes into the
# future stood here through a GREEN run. This duty asks the one question that
# closes the gap, and it asks it of the head itself, on every run.
let head_pass_stamp = run ["sh" "-c" "TZ=America/New_York date +%Y%m%d.%H%M%S"]
assert head_pass_stamp.ok else "host clock read failed for the head PASS fixture"
let head_pass_dot = trim head_pass_stamp.out
let head_pass = run ["sh" "-c" "ONE_CLOCK_HEAD_STAMPS='${head_pass_dot}' sh tools/fixtures/o/one_clock_head_scan.sh"]
say head_pass.out
assert head_pass.ok else "head PASS fixture failed -- a stamp read from the live clock must pass"
assert head_pass.out contains "HEAD_OK" else "head PASS fixture must emit HEAD_OK"

let head_ahead = run ["sh" "-c" "export TZ=America/New_York; . tools/fixtures/s/shell_portable.sh; stamp_ahead 14400"]
assert head_ahead.ok else "could not compute a four-hours-ahead head stamp"
let head_ahead_dot = trim head_ahead.out
let head_fail = run ["sh" "-c" "ONE_CLOCK_HEAD_STAMPS='${head_ahead_dot}' sh tools/fixtures/o/one_clock_head_scan.sh"]
assert head_fail.ok == false else "head FAIL fixture passed -- a stamp ahead of the clock must fail"
assert head_fail.out contains "HEAD_BAD" else "head FAIL fixture must emit HEAD_BAD"

# Duty 5's REACH, not only its comparison (20260911.020039).
#
# The two fixtures above hand the stamp in through ONE_CLOCK_HEAD_STAMPS, which
# bypasses the population walk -- so both proved the predicate and neither proved
# that the walk can SEE a fabricated stamp where the law puts one. A log is born
# on its day shelf from 20260827.171500, and the flat glob that stood in the mono
# scan read 247 of 7,344 dated artifacts: a log stamped four hours ahead, on its
# shelf, passed both duties, and the same file moved flat reddened duty 5 at once.
# The control plants real files in real directories and runs the real scans, so
# the population is what is on trial. Its own legs are tallied and asserted,
# because a control that merely reaches its last line proves nothing about the
# legs written after the one that broke.
let population = run ["sh" "tools/fixtures/o/one_clock_population_control.sh"]
say population.out
assert population.ok else "one-clock population control failed -- duty 5 no longer reaches a folded shelf"
assert population.out contains "control_verdict=ok" else "population control named no ok verdict"
assert population.out contains "fails=0" else "population control reported a failing leg"
assert population.out contains "future_on_day_shelf_reds" else "population control skipped the day-shelf leg"
assert population.out contains "sprigless_future_on_shelf_reds" else "population control skipped the sprigless leg"

let head = run ["sh" "tools/fixtures/o/one_clock_head_scan.sh"]
say head.out
assert head.ok else "the living head stands ahead of the live clock -- a stamp was written rather than read"
assert head.out contains "HEAD_OK" else "one-clock head duty named no HEAD_OK"
assert ((head.out contains "HEAD_BAD") == false) else "one-clock HEAD_BAD present"
say "one-clock: mode ${mode} - shape - mono - zone - provenance - head"
say "GREEN: one_clock_witness -- shape - monotonicity - zone - provenance - head - mode ${mode}"
