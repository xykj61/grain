# tools/gen_alias_sameness_witness.rish — beta leg 2's proof: aliases proven.
#
# The Generator Season kept every elder path as an accrete shim relaying its
# gen/-homed twin. This witness proves the aliases two ways:
#   shape — every elder that shares a basename with a gen/ file must be a
#           lawful shim: it names its twin's path and stays small (roof 16
#           lines — shims run four to eight; the roof leaves accretion room)
#   sameness — one pure pair runs both ways and the outputs must match
#           byte-for-byte (sundial: read-only meter, safe to run twice)
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gen_alias_sameness_witness.rish

let shape = run ["sh" "-c" "bad=0; pairs=0; for f in $(git ls-files 'tools/gen/*/*.rish' 'tools/gen/*/*.sh'); do b=$(basename $f); if [ -e tools/$b ]; then pairs=$((pairs+1)); if ! grep -qF $f tools/$b; then bad=$((bad+1)); echo NOTWIN tools/$b; fi; n=$(wc -l < tools/$b); if [ $n -gt 16 ]; then bad=$((bad+1)); echo OVERROOF tools/$b lines=$n; fi; fi; done; echo pairs=$pairs bad=$bad; test $bad -eq 0"]
assert shape.ok else "gen_alias: every elder pair must be a lawful shim (twin named, under roof)"
assert shape.out contains "pairs=33" else "gen_alias: thirty-three pairs stand"
assert shape.out contains "bad=0" else "gen_alias: zero shim-shape faults"

# Measured finding (e205): the shim's `say r.out` relay appends exactly one
# trailing newline (39 lines vs 38 on sundial; the diff is one blank line).
# Sameness is therefore held modulo that one documented relay cost — the
# compare drops trailing blank lines on both sides and nothing else.
# Second owned red (e205): the first cut used backslash-escaped quotes —
# rishi treats backslash as no escape at all (the standing rishi law), so
# sh received garbage tokens; this cut carries no quotes and no braces.
let same = run ["sh" "-c" "rishi/bin/rishi run tools/sundial.rish 2>/dev/null | awk 'NF{p=NR} {l[NR]=$0} END{for(i=1;i<=p;i++) print l[i]}' > /tmp/gasw_e; rishi/bin/rishi run tools/gen/season/sundial.rish 2>/dev/null | awk 'NF{p=NR} {l[NR]=$0} END{for(i=1;i<=p;i++) print l[i]}' > /tmp/gasw_t; cmp -s /tmp/gasw_e /tmp/gasw_t"]
assert same.ok else "gen_alias: the pure pair must answer alike modulo the relay newline"

say "pairs=33 shape=lawful sameness=sundial-alike-modulo-relay-newline"
say "GREEN: gen_alias_sameness — the aliases are proven; beta leg two turns green."
