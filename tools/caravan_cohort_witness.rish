# caravan_cohort_witness.rish -- Caravan widest-cohort witness.
#
# `concurrent.rye` answered the pair question exactly: two domains may run
# together when they share no region and no channel. It closed on a ring's
# own arithmetic -- every domain adjacent to two others, so the non-adjacent
# pairs number n * (n - 3) / 2, zero at three and two at four -- and left
# the next question standing. A supervisor with three slots wants the widest
# SET it may run, and a pair is only the smallest such set.
#
# This rung answers it:
#
#   A set may run together exactly when every pair in it may, and the widest
#   such set is derived from the document rather than chosen by the
#   supervisor -- and it is not what you get by taking the first domain that
#   fits.
#
# Both hazards are relations between two domains, so a set carries no hazard
# its pairs do not already carry; the pair predicate is reused whole rather
# than restated one size up.
#
# A ring has no room for three. Its widest set is floor(n / 2) -- one at
# three, two at four -- so a non-adjacent triple wants a ring of six, past
# the four dependents one supervisor holds. The shape with room for three is
# not a ring at all: it is the most ordinary shape in this tree, one server
# and its clients. `serve.rye` proved two clients never hear each other's
# bell, and `serial_three_clients.bron` turns that isolation into room.
#
# The counterexample is what makes the derivation worth its cost. In that
# document the virtualiser is declared first and touches every client, so a
# first fit takes it and runs one dependent where the widest set runs three. The
# first fit is never unsafe -- it is simply narrow, threefold, on the
# plainest shape in the tree.
#
# The cost is named rather than hidden. Weighing every subset costs 2^n, and
# n is bounded at the roster bound, so the search is bounded at 256 subsets
# by the same constant. The room itself comes from privacy: each client
# keeps a tail region no other domain may reach, and a region only one
# domain can reach carries no direction, so the document answers `no
# directed flow to derive` rather than naming a ring. That price is stated,
# the way the mute document's was.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom. Every
# check is order-independent, since three dependents printing at the same
# moment genuinely interleave differently from run to run.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_cohort_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/cohort"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/cohort.rye -femit-bin=${bin}"]

assert build.ok else "caravan cohort build failed"

# The reader this witness runs is built here rather than borrowed (REDS #92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# Three documents: the two rings measured for the room they lack, and the
# server-and-clients shape that has room for three.
let narrow = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_cycle.bron 2>&1"]
assert narrow.ok else "the ring of three could not be read"
assert narrow.out contains "domains 3 -- channels 3 -- regions 4 -- grants 8" else "the ring of three changed shape"

let ring = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_cycle_wide.bron 2>&1"]
assert ring.ok else "the ring of four could not be read"
assert ring.out contains "domains 4 -- channels 4 -- regions 5 -- grants 10" else "the ring of four changed shape"

let clients = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients.bron 2>&1"]
assert clients.ok else "the three-client declaration could not be read"
assert clients.out contains "domains 4 -- channels 3 -- regions 9 -- grants 15" else "the three-client document changed shape"
assert clients.out contains "verdict: whole" else "the three-client declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan cohort selftest exited non-zero"
assert test.out contains "GREEN" else "caravan cohort selftest not GREEN"
assert test.out contains "the widest set a document may run is derived, never chosen" else "the cohort finding did not close"

# The wire: a set is judged by its pairs, and one bad pair refuses the set.
assert test.out contains "a set of 3 clears and the same set plus the virtualiser refuses on a pair" else "a set was not judged by its pairs"

# The room a ring has, derived from the grants and held to floor(n / 2).
assert test.out contains "a ring of 3 runs 1 at once; a ring of 4 runs 2, never three" else "the room a ring has was not derived"

# The widest set, the first fit that finds a third of it, and the cost of
# both the search and the privacy the room rests on.
assert test.out contains "weighing 16 subsets derives a widest set of 3 where the first fit takes 1" else "the widest set and the first fit did not separate"
assert test.out contains "the shape with room for three reads back as no directed flow to derive, never a ring" else "the shape cost of a private tail went unstated"

# The lap: the whole cohort spent twice, three unreaped at the peak, six home.
assert test.out contains "a cohort of 3 clears: no region and no channel in common" else "a cohort was not cleared before spawning"
assert test.out contains "9 dependents ran across 5 stages, 2 of them holding three at once" else "the lap did not spend the cohort twice"
assert test.out contains "3 dependents stood unreaped at the peak, 9 reaped, 0 reported behind" else "the peak in flight or the reaping did not hold"
assert test.out contains "6 asks come home over a shape that spent its whole cohort twice" else "the lap did not come home"

# The refusal: the one domain touching every other never joins a cohort.
assert test.out contains "serial_virt beside client_a: a region held by both" else "the virtualiser was not judged before spawning"
assert test.out contains "a cohort holding the virtualiser is refused SharedRegion with 0 dependents spawned" else "a touching domain ran beside the cohort"

# The reaping, with its unsafe reading carried as a named control. Three in
# flight makes the cost plain: one early report strands a pair, not one.
assert test.out contains "reporting on the first outcome leaves 2 dependents running behind the verdict" else "the loose reading did not strand the rest of the cohort"
assert test.out contains "reaping the whole cohort first reports the same refusal with 0 running" else "a refusal left dependents running behind its verdict"

say "GREEN: Caravan cohort witness passed."
