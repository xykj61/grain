# tools/hunk_edit_input_witness.rish — the Photos app edit input seam on metal (HUNK48).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK48.
# Design read: active-designing/20260813-202710_hunk-edit-input-seam-exploration.md.
# Teacher, thanked clean-room: the input layer of a photo editor (iCloud Photos / Google Photos) — a tap commits a
# gesture, a swipe walks the undo/redo history — reduced to one move over a recorded edit-list (concept only, siloed).
#
# HUNK16 gave a pure EditCursor whose undo and redo clamp at both ends and whose fresh push forgets the redo tail;
# HUNK43 gave the scroll arc its own input seam. This rung is the same boundary above the EditCursor: `apply(cursor,
# gesture)` maps one raw editing gesture — commit this verb, undo, redo — to exactly one history move, preserving every
# clamp the cursor holds. The selftest proves a committed verb advances the depth and the viewed image is exactly that
# verb byte-for-byte, undo/redo walk reversibly, both edges clamp as no-ops, a commit while rewound forgets the redo
# tail, and the list ceiling still refuses TooManyEdits through the seam — no new error invented. No network, no key,
# no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_edit_input_witness.rish

say "hunk-edit-input: Language EN — HUNK48 maps one raw editing gesture (commit a verb, undo, redo) to exactly one EditCursor move above HUNK16's history."
say "hunk-edit-input: Style Radiant — a device speaks gestures, not method calls; this seam translates one to one, and every clamp the cursor holds survives whatever the finger sends."
say "hunk-edit-input: Lens TAME — the gesture is one enum tag beside a HUNK11 Edit payload; commit routes to push, undo/redo to the clamped walk; no new storage, no new error beyond the list's own TooManyEdits ceiling; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/edit_input"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/edit_input.rye -femit-bin=${bin}"]
assert build.ok else "hunk-edit-input: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-edit-input: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe in the GREEN line can never break a check (the loom for REDS %75).
let out = trim selftest.out
say "hunk-edit-input: ${out}"

assert out contains "GREEN image-edit-input" else "hunk-edit-input: selftest did not print the GREEN edit-input line"
assert out contains "the viewed image is exactly that verb byte-for-byte" else "hunk-edit-input: a committed gesture did not apply exactly its verb"
assert out contains "undo walks the depth back to the original recovered byte-for-byte and redo rolls forward" else "hunk-edit-input: undo/redo gestures did not walk the history byte-for-byte"
assert out contains "clamp as no-ops" else "hunk-edit-input: a gesture at an edge did not clamp as a no-op"
assert out contains "forgets the redo tail" else "hunk-edit-input: a commit while rewound did not forget the redo tail"
assert out contains "still refuses TooManyEdits through the seam" else "hunk-edit-input: the list ceiling did not refuse through the seam"

say "hunk-edit-input: GREEN — the Photos app takes a gesture: a committed verb applies exactly, undo and redo walk byte-for-byte, both edges clamp as no-ops, a fresh commit forgets the road not taken, the ceiling still refuses; no network, no key, no funds."
