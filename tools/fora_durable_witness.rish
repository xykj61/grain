# tools/fora_durable_witness.rish — durable state: a pier survives a restart without ever forgetting its vote (FORA30).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark FORA · rung
# FORA30. Design read: active-designing/20260814-105746_fora30-constel-durable-state.md
#
# constel/durable.rye persists the exact triple Raft's Figure 2 requires on stable storage — (term, voted_for, TermedLog) — into a
# self-describing, Sha256-sealed byte image, read verify-before-trust on load (FORA3's discipline). `record_vote` is the vote-record
# decision whose durability is the point; `save`/`load` round-trip it through bytes. The selftest proves: round-trip identity; the
# crux — a pier that voted A in term 5, crashed, and restored refuses to vote B in term 5 (no second leader in one term); a new term
# clears the vote across the restart; the committed log survives whole; a corrupt image (flipped digest, wild log_len, short buffer,
# bad magic) fails closed; term never regresses; bounded to a full log. Purely local — no real fd, no socket, no network, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/fora_durable_witness.rish

say "fora-durable: Language EN — FORA30 closes the durability blind spot every earlier rung left open: Raft's Figure 2 requires currentTerm, votedFor, and log[] on STABLE STORAGE before a pier answers an RPC, because election safety rests on a pier never voting twice in one term."
say "fora-durable: Style Radiant — a pier remembers its one vote through the dark of a power cycle; a torn image restores no half-truth; the sky that slept wakes up exactly itself."
say "fora-durable: Lens TAME — record_vote refuses StaleTerm/AlreadyVoted over public APIs; save/load are bounded to max_image_bytes; load is verify-before-trust (magic, version, log_len<=max_entries, Sha256) refusing CorruptImage/ImageTooBig at the first fault; the store is a plain in-memory byte buffer, no real fd; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/durable"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/durable.rye -femit-bin=${bin}"]
assert build.ok else "fora-durable: build failed — ${build.err}"

let outfile = "constel/bin/durable.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "fora-durable: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "fora-durable: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN fora-durable' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "fora-durable: selftest did not print the GREEN fora-durable line"

say "fora-durable: GREEN — durable state is proven pure on the bench: the single vote survives a crash, no restart can raise a second leader in one term, and a torn or tampered image is refused rather than half-restored."
