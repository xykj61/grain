# tools/mycelium_cord_knot_witness.rish — the Knot: a bounded Cord ties off its committed past (r1).
#
# Season D (Kresfa & Mycelium) · Mycelium consensus · checkpointing · rung r1 — the crux.
# The Cord's Dag is statically allocated (cord_max_blocks = 256) — a feature, exactly TigerBeetle's
# discipline. Yet a bound reached is a mesh that stops. From TigerBeetle comes the checkpointing insight:
# fold the committed past into a summary, prune it, continue from the summary as if from genesis.
# Clean-room: studied, never copied. Grown BESIDE the elder — mycelium/cord.rye and mycelium/fold.rye
# stay green binaries; this composes their public API only.
#
# The crux this witness proves: folding new facts onto a sealed Knot yields the byte-identical supply
# (issued 1000 · taxed 300 · supply 700 · one star) as folding the whole history from empty — checkpointing
# is a storage transform, never a semantic one; the supply never notices where the past was tied off. Both
# boundaries hold (the Knot at genesis · the full-prefix Knot). Every invariant crosses the cut: a corrupted
# Knot refuses KnotCorrupt, a suffix tax past the checkpointed supply refuses Overdraw, a suffix star already
# sealed refuses StarTaken. Demo keeper seeds only — no real key, no funds, no network, no custody.
#
# Scope: active-designing/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
#
# Run from the repository root:
#   rishi/bin/rishi run tools/mycelium_cord_knot_witness.rish

say "mycelium-cord-knot: Language EN — a bounded Cord runs forever by tying off its committed past."
say "mycelium-cord-knot: Style Radiant — a knot lets a bounded strand carry an unbounded past, one sealed length at a time."
say "mycelium-cord-knot: Lens TAME — a Knot seals the folded supply under a digest; every buffer bounded; a corrupted or overdrawing continuation refuses whole; demo seeds only, no key held."

let zig = "vendor/zig-toolchain/zig"
let bin = "mycelium/bin/cord_knot"

let build = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord_knot.rye -femit-bin=${bin}"]
assert build.ok else "mycelium-cord-knot: build failed"

let selftest = run ["sh" "-c" "${bin} 2>&1"]
assert selftest.ok else "mycelium-cord-knot: selftest exited non-zero"
assert selftest.out contains "GREEN" else "mycelium-cord-knot: selftest did not speak GREEN"
assert selftest.out contains "a checkpointed prefix continued onto its Knot folds to the whole history's supply" else "mycelium-cord-knot: checkpoint-equivalence claim missing"
assert selftest.out contains "the Knot at genesis and the full-prefix Knot both reach supply 700, one star" else "mycelium-cord-knot: boundary claim missing"
assert selftest.out contains "a corrupted Knot, an overdraw past the cut, and a duplicate star each refuse whole" else "mycelium-cord-knot: refusal claim missing"

# The elder Cord the Knot checkpoints stays a green binary — accrete-never-break, proven by re-running its
# own selftest at this door.
let elder = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/cord.rye -femit-bin=mycelium/bin/cord && mycelium/bin/cord 2>&1"]
assert elder.ok else "mycelium-cord-knot: the elder single-fact Cord is not GREEN"
assert elder.out contains "GREEN" else "mycelium-cord-knot: the elder Cord did not speak its GREEN"

# The Mycelium supply fold the Knot seals stands at its door.
let myc = run ["sh" "-c" "mkdir -p mycelium/bin && env RYE_ZIG=${zig} rye/bin/rye build mycelium/fold.rye -femit-bin=mycelium/bin/fold && mycelium/bin/fold 2>&1"]
assert myc.ok else "mycelium-cord-knot: the Mycelium fold the Knot seals is not GREEN"
assert myc.out contains "GREEN" else "mycelium-cord-knot: the Mycelium fold did not speak its GREEN"

say "mycelium-cord-knot: GREEN — a checkpointed prefix continued onto its Knot folds to the whole history's identical supply, every invariant crosses the cut, and the elder Cord and the fold both stand green at their doors."
