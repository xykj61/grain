# tools/am/amphora_mark_wreck_witness.rish -- the wreck rule for marks, proven both ways.
#
# A vessel names its cargo in three fields: mark, digest, name. This witness holds the mark
# honest. The engine knows two marks by heart, `plain-bytes` and `manifest`. That pair is
# fixed in `foundations/20260703-202312_the-marked-value.md`, so the chain of who checks the
# checker ends somewhere a reader can point at. Any other mark is cargo of an unnamed kind.
# The vow for that case is one line: an unknown mark is refused whole.
#
# Four things stand proven, each on metal:
#
#   both roots parse, so ordinary cargo crosses freely
#   a stranger refuses, and names error.UnknownMark
#   an honest season pours and verifies end to end
#   a planted stranger refuses AT parse_manifest_line, read from the frame itself
#
# The fourth line does the real work here. Sealed things make this subtle. Editing a sealed
# vessel breaks its Kumara signature too, so a refusal alone says nothing about marks -- the
# stamp turns away any edit at all. The reason is what tells a type check from an integrity
# check. So this witness reads the frame. Restore the elder behavior and it says exactly
# that: `refused, yet NOT at the mark`.
#
# What stood before, and why eight sibling witnesses missed it, is written in the roster note
# beside this guard in `construction/standing-equipment.kyri` and in the ledger row stamped
# `20260907.015042`. Both are
# Meter, where a refusal is properly the subject.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/am/amphora_mark_wreck_witness.rish

let season = "tools/fixtures/cellar_ring1_tree"

# The pen is named by `mktemp -d`, so the kernel picks the suffix and no two runs can agree by
# accident. Eight ships share this pier's `/tmp`, so a constant pen path is a name every ship
# chose at write time -- and this witness WIPES its pen, which turns a collision into a peer's
# run deleted mid-flight. `shared_pen` counts both hazards and caught this one at its ceiling.
let pen_made = run ["sh" "-c" "mktemp -d /tmp/amphora_mark_wreck.XXXXXX"]
assert pen_made.ok else "mark_wreck: the pen must be made"
let pen = trim pen_made.out
let vessel = "${pen}/vessel.bron"
let planted = "${pen}/planted.bron"

# amphora/bin/ is gitignored, so a clone carries no binaries and this witness builds what
# it runs rather than trusting a previous lap (REDS %334); mkdir first, since rye build
# refuses an absent -femit-bin directory (REDS %337).
let zig = "vendor/zig-toolchain/zig"
let build_entry = run ["sh" "-c" "mkdir -p amphora/bin && env RYE_ZIG=${zig} rye/bin/rye build amphora/manifest_entry.rye -femit-bin=amphora/bin/manifest-entry"]
assert build_entry.ok else "mark_wreck: manifest_entry build failed -- ${build_entry.err}"
let build_core = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_core.rye -femit-bin=amphora/bin/vessel-core"]
assert build_core.ok else "mark_wreck: vessel-core build failed -- ${build_core.err}"
let build_seal = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_seal.rye -femit-bin=amphora/bin/vessel-seal"]
assert build_seal.ok else "mark_wreck: vessel-seal build failed -- ${build_seal.err}"
let build_amphora = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/src/main.rye -femit-bin=amphora/bin/amphora"]
assert build_amphora.ok else "mark_wreck: amphora build failed -- ${build_amphora.err}"

# The receipt seam reads the mark through the same parser rather than a second hand-rolled
# tokenizer, so it is built here too -- it needs libc for its sockets, as its own three
# rostered witnesses already spell.
let build_delivery = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_fetch_delivery.rye -lc -femit-bin=amphora/bin/vessel-fetch-delivery"]
assert build_delivery.ok else "mark_wreck: vessel_fetch_delivery no longer compiles -- ${build_delivery.err}"

# --- the module's own both-ways selftest, which carries the two roots and two strangers ---
# `std.debug.print` writes to stderr, so the claim is read through a merging shell -- the
# same spelling the three elder amphora witnesses already use.
let selftest = run ["sh" "-c" "amphora/bin/manifest-entry selftest 2>&1"]
assert selftest.ok else "mark_wreck: manifest_entry selftest exited non-zero -- ${selftest.out}"
assert selftest.out contains "GREEN" else "mark_wreck: manifest_entry not GREEN -- ${selftest.out}"

# --- welcome: an honest vessel pours and verifies ---
let pour = run ["amphora/bin/amphora" "pour" season vessel]
assert pour.ok else "mark_wreck: honest pour must pass -- ${pour.err}"
let verify = run ["amphora/bin/vessel-core" "verify" vessel]
assert verify.ok else "mark_wreck: honest vessel must verify -- ${verify.err}"

# The poured vessel must actually carry the root this witness plants over, or the plant
# below would be a no-op that passes for the wrong reason.
let carried = run ["sh" "-c" "grep -c '^manifest plain-bytes ' ${vessel}"]
assert carried.ok else "mark_wreck: poured vessel names no plain-bytes cargo"

# --- refusal: a kind the engine cannot name ---
let plant = run ["sh" "-c" "sed 's/^manifest plain-bytes /manifest zzz-unknown-stranger /' ${vessel} > ${planted}"]
assert plant.ok else "mark_wreck: plant must write"
let planted_ok = run ["sh" "-c" "grep -q 'zzz-unknown-stranger' ${planted}"]
assert planted_ok.ok else "mark_wreck: plant did not take -- the vessel shape moved"

let refused = run ["amphora/bin/vessel-core" "verify" planted]
assert refused.code != 0 else "mark_wreck: a vessel carrying an unnamed kind was ACCEPTED"

# The reason, not merely the refusal. A sealed vessel edited anywhere fails its Kumara
# signature, so this names the frame: parse_manifest_line must be what turned it away.
let reason = run ["sh" "-c" "amphora/bin/vessel-core verify ${planted} 2>&1 | head -3"]
assert reason.out contains "parse_manifest_line" else "mark_wreck: refused, yet NOT at the mark -- ${reason.out}"

# --- lifting the plant returns the reading to green, so the refusal is the mark's own ---
let lifted = run ["amphora/bin/vessel-core" "verify" vessel]
assert lifted.ok else "mark_wreck: the honest vessel must still verify after the plant"

say "amphora_mark_wreck: honest vessel verifies; an unnamed kind refuses at parse_manifest_line"

# --- the second spelling of the same rule, and the two ways it is now held ---
#
# `amphora/src/main.rye` reads cargo lines too, and it is the ONE reader that cannot route a
# whole line through `parse_manifest_line`: it walks decrypted seal plain rather than vessel
# text, and it fills a catalog slot the contract knows nothing about. So it kept its own
# tokenizer -- and, until `20260908`, its own mark rule, `eql(mark, "plain-bytes")`, which is
# NARROWER than the contract's two roots. A vessel carrying the `manifest` root would have been
# welcomed by every reader in the room and refused here as `CargoUnproven`.
#
# WHY NO LEG REACHES IT FROM OUTSIDE. This door writes what it reads: `pour` builds the cargo
# plain from the season with its own `mark_plain_bytes`, seals it, and `restore` opens that
# same plain back. No argument, file, or vessel edit puts a foreign mark into the plain without
# breaking the AEAD seal first -- so the divergence was unreachable, which is exactly why it
# stood. A leg that cannot be reached is proven where it lives: in the source, and in the
# compiler. Both are asserted below, and both are proven to BITE on a plant.

let pen_a = "${pen}/a"
let pen_b = "${pen}/b"
let make_pens = run ["sh" "-c" "mkdir -p ${pen_a} ${pen_b} && cp amphora/src/main.rye ${pen_a}/main.rye && cp amphora/src/main.rye ${pen_b}/main.rye && ln -s $(pwd)/amphora/manifest_entry.rye ${pen_a}/manifest_entry.rye && ln -s $(pwd)/amphora/manifest_entry.rye ${pen_b}/manifest_entry.rye"]
assert make_pens.ok else "mark_wreck: the source pens must be made -- ${make_pens.err}"

# The honest copy builds, so the plant below is read as the plant's own doing.
let pen_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${pen_a}/main.rye -femit-bin=${pen}/amphora-pen 2>&1"]
assert pen_build.ok else "mark_wreck: the unplanted source copy must build -- ${pen_build.out}"

# One: the mirrored root is compiler-held. Diverge the literal this door WRITES from the
# contract's own, and the comptime block must stop the build. A literal copied by hand that
# nothing checks is REDS %453's shape one field over.
let plant_root = run ["sh" "-c" "sed -i 's/^const mark_plain_bytes = \"plain-bytes\";/const mark_plain_bytes = \"plain-bytes-x\";/' ${pen_a}/main.rye && grep -q 'plain-bytes-x' ${pen_a}/main.rye"]
assert plant_root.ok else "mark_wreck: the divergent-root plant did not take -- the declaration moved"
let refused_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${pen_a}/main.rye -femit-bin=${pen}/amphora-pen-planted 2>&1"]
assert refused_build.code != 0 else "mark_wreck: a written root diverging from the contract STILL BUILT"
# The reason, not merely the refusal -- the same discipline the frame leg above keeps. A build
# can fail for a hundred reasons a sed introduces; only one of them is this guard's subject.
assert refused_build.out contains "mark_plain_bytes, me.mark_plain_bytes" else "mark_wreck: the pen build refused, yet NOT at the comptime tie -- ${refused_build.out}"

# Two: the reader names the contract's roster rather than a second one of its own.
let routes = run ["sh" "-c" "grep -q 'me.mark_verdict(mark) == .unknown' amphora/src/main.rye"]
assert routes.ok else "mark_wreck: main's cargo reader no longer routes its verdict through the contract"
let no_second = run ["sh" "-c" "! grep -q 'eql(u8, mark, mark_plain_bytes)' amphora/src/main.rye"]
assert no_second.ok else "mark_wreck: main's cargo reader spells a SECOND mark roster of its own"

# And that leg is proven to bite: restore the elder narrower rule in the second pen and the
# same reading must fail there. A leg proven only in the passing direction cannot be told
# from a bypass.
let elder = run ["sh" "-c" "sed -i 's/if (me.mark_verdict(mark) == .unknown)/if (!std.mem.eql(u8, mark, mark_plain_bytes))/' ${pen_b}/main.rye && ! grep -q 'eql(u8, mark, mark_plain_bytes)' ${pen_b}/main.rye"]
assert elder.code != 0 else "mark_wreck: the second-roster leg cannot bite -- it passes on the elder source"

# Three: the mark field is bounded before the contract is asked, so an over-long mark is
# REFUSED rather than tripping `mark_verdict`'s own precondition assert.
let bounded = run ["sh" "-c" "grep -q 'sp1 > me.max_mark_len' amphora/src/main.rye"]
assert bounded.ok else "mark_wreck: main hands an unbounded mark field to mark_verdict's assert"

say "amphora_mark_wreck: main's cargo reader borrows the roster; a divergent written root stops the build"
say "GREEN: Amphora keeps the wreck rule for marks -- two roots welcome, a stranger refuses whole."
