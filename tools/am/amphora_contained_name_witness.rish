# tools/am/amphora_contained_name_witness.rish -- keep every cargo name inside its out-home.
#
# A digest says what bytes arrived, while a cargo name says where they land. This witness checks
# both halves on the real Amphora programs. An honest relative name crosses all four doors and
# restores whole. An escaping name meets the shared rule in `amphora/manifest_entry.rye` before a
# write. Removing that rule in a pen makes the same escape happen, which proves the wall has teeth.
# Returning the rule restores the refusal and leaves the catalog absent. The module selftest also
# proves the rule welcomes ordinary nested names. The full value discipline begins at
# `foundations/20260703-202312_the-marked-value.md`. Run this witness from the repository root with
# `rishi/bin/rishi run tools/am/amphora_contained_name_witness.rish`.

let season = "tools/fixtures/cellar_ring1_tree"

# THE PEN CARRIES A UNIQUE NAME (REDS %512's class, held by tools/s/shared_pen_witness.rish).
# Eight ships run this roster from eight checkouts and share one /tmp, so a pen named by a
# constant is ONE directory on all eight.
let pen = run ["sh" "-c" "mktemp -d /tmp/amphora_contained.XXXXXX"]
assert pen.ok else "contained: pen must open"
let home = trim pen.out
let vessel = "${home}/v.bron"

# The witness builds the binaries it runs: amphora/bin/ is gitignored, so a clone carries none of
# them and this witness would die on a missing file rather than on an Amphora fact (REDS %334).
let zig = "vendor/zig-toolchain/zig"
let build_amphora = run ["sh" "-c" "mkdir -p ${home}/bin && env RYE_ZIG=${zig} rye/bin/rye build amphora/src/main.rye -femit-bin=${home}/bin/amphora"]
if build_amphora.ok == false then say build_amphora.err
assert build_amphora.ok else "contained: amphora build failed -- read the line above"
let build_core = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_core.rye -femit-bin=${home}/bin/vessel-core"]
if build_core.ok == false then say build_core.err
assert build_core.ok else "contained: vessel-core build failed -- read the line above"
let build_seal = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_seal.rye -femit-bin=${home}/bin/vessel-seal"]
if build_seal.ok == false then say build_seal.err
assert build_seal.ok else "contained: vessel-seal build failed -- read the line above"
let build_entry = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/manifest_entry.rye -femit-bin=${home}/bin/manifest-entry"]
if build_entry.ok == false then say build_entry.err
assert build_entry.ok else "contained: manifest-entry build failed -- read the line above"

# --- the rule itself, both directions, where it lives ---
# `sub/deeper/a.txt` walks free and six escaping shapes refuse by their own error name. A rule
# proven only on the refusing side cannot be told from one that refuses every name.
let selftest = run ["${home}/bin/manifest-entry" "selftest"]
if selftest.ok == false then say selftest.err
assert selftest.ok else "contained: the name rule must prove both directions -- read the line above"
assert selftest.err contains "hold the name inside" else "contained: selftest names the rule"

# --- the welcome, asserted as hard as every refusal below ---
let pour = run ["${home}/bin/amphora" "pour" season vessel]
assert pour.ok else "contained: seed pour must pass"
let honest_check = run ["${home}/bin/vessel-seal" "manifest-check" vessel]
assert honest_check.ok else "contained: an honest vessel must welcome at the listing door"
let ok_copy = run ["sh" "-c" "cp ${vessel} ${home}/ok.bron"]
assert ok_copy.ok else "contained: honest restore copy must land"
let honest_restore = run ["${home}/bin/amphora" "restore" "${home}/ok.bron"]
assert honest_restore.ok else "contained: an honest vessel must restore whole"
assert honest_restore.err contains "restore same-parent ok" else "contained: the honest restore re-pours to its own parent"

# The opened cargo block is the raw material for every plant below -- the names a restore reads.
let open_plain = run ["${home}/bin/vessel-seal" "open" vessel "${home}/plain.txt"]
assert open_plain.ok else "contained: the honest seal must open"

# --- plant 1: the seal writer. A forged unsealed vessel whose listing and cargo both name a path
# one directory up, handed to `seal`. The seal door reads every cargo line through the contract.
#
# The forgery recomputes the vessel's `parent` over the listing it just rewrote, and that step
# was added `20260911` when the pre-write parent proof landed one door over. Until then this
# plant left the elder `parent` line standing beside a listing that no longer hashed to it, so
# the forged vessel was internally INCONSISTENT and the elder pen's own leg had two possible
# refusals to choose from. `restore_open_catalog` now catches exactly that inconsistency before
# it writes anything, which would have retired this rule's elder leg by accident -- a wall that
# quietly absorbs a sibling's plant proves the sibling nothing. So the plant does the arithmetic
# a real forger would do, and the name rule is the only thing left for the elder to fail on.
let forged_cargo = run ["sh" "-c" "sed 's| hello.txt$| ../escaped.txt|' ${home}/plain.txt > ${home}/forged_cargo.txt"]
assert forged_cargo.ok else "contained: the forged listing must prepare -- ${forged_cargo.err}"
let forged_parent_read = run ["sh" "-c" "sh tools/fixtures/s/sha3_256.sh ${home}/forged_cargo.txt"]
assert forged_parent_read.ok else "contained: the forged parent must compute -- ${forged_parent_read.err}"
let forged_parent = trim forged_parent_read.out
let forge = run ["sh" "-c" "{ sed -n '1,5p' ${vessel} | sed 's|^parent .*|parent ${forged_parent}|'; grep '^manifest ' ${vessel} | sed 's| hello.txt$| ../escaped.txt|'; cat ${home}/forged_cargo.txt; } > ${home}/forged.bron"]
assert forge.ok else "contained: the forged vessel must prepare"
let forge_consistent = run ["sh" "-c" "grep -q '^parent ${forged_parent}$' ${home}/forged.bron"]
assert forge_consistent.ok else "contained: and the forgery must be INTERNALLY CONSISTENT -- it must carry parent ${forged_parent}, or the elder leg below could refuse for the parent rather than for the name -- ${forge_consistent.err}"
let seal_door = run ["${home}/bin/vessel-seal" "seal" "${home}/forged.bron"]
assert (seal_door.ok == false) else "contained: the seal writer must refuse an escaping name"

# --- plant 2 and 3: the stamp writer and the listing check, on a SEALED vessel whose listing
# alone was rewritten. Neither needs the seal re-made, so both doors speak for themselves.
let listing_plant = run ["sh" "-c" "cp ${vessel} ${home}/listed.bron && . tools/fixtures/s/shell_portable.sh && sed_inplace 's| hello.txt$| ../escaped.txt|' ${home}/listed.bron"]
assert listing_plant.ok else "contained: the listing plant must prepare"
let stamp_door = run ["${home}/bin/vessel-core" "sign" "${home}/listed.bron"]
assert (stamp_door.ok == false) else "contained: the stamp writer must refuse an escaping name"
let listing_door = run ["${home}/bin/vessel-seal" "manifest-check" "${home}/listed.bron"]
assert (listing_door.ok == false) else "contained: the listing check must refuse an escaping name"

# LIFT all three plants: the honest vessel is untouched, so the welcome returning is read off it.
let after_plants = run ["${home}/bin/vessel-seal" "manifest-check" vessel]
assert after_plants.ok else "contained: the welcome must stand once the plants are set aside"

# --- the wall removed, and returned. A pen copy of the room with the two containment refusals
# struck out is the ELDER Amphora: it seals an escaping name, stamps it, and restores it one
# directory above the out-home. This is the reading that was taken before the repair, reproduced
# here so a green witness cannot be told from a door that never had anything to refuse.
let elder_dir = "${home}/elder"
let elder_copy = run ["sh" "-c" "mkdir -p ${elder_dir}/src ${elder_dir}/bin && cp amphora/manifest_entry.rye ${elder_dir}/ && cp amphora/vessel_seal.rye amphora/vessel_core.rye ${elder_dir}/ && cp amphora/src/main.rye ${elder_dir}/src/ && cp amphora/kumara.rye amphora/tally_copy.rye ${elder_dir}/ && cp ${elder_dir}/manifest_entry.rye ${elder_dir}/src/manifest_entry.rye"]
assert elder_copy.ok else "contained: the elder pen must copy"
let strip = run ["sh" "-c" ". tools/fixtures/s/shell_portable.sh && sed_inplace '/switch (name_verdict(entry.name)) {/,/^    }$/d' ${elder_dir}/manifest_entry.rye && sed_inplace '/assert(name_verdict(entry.name) == .contained);/d' ${elder_dir}/manifest_entry.rye && sed_inplace '/if (me.name_verdict(name) != .contained) return error.CargoUnproven;/d' ${elder_dir}/src/main.rye && sed_inplace '/if (me.name_verdict(entry.path) != .contained) return error.SeasonNameUnframed;/d' ${elder_dir}/src/main.rye && cp ${elder_dir}/manifest_entry.rye ${elder_dir}/src/manifest_entry.rye"]
assert strip.ok else "contained: the wall must strip cleanly"
let gone = run ["sh" "-c" "cat ${elder_dir}/manifest_entry.rye ${elder_dir}/src/main.rye | grep -c 'name_verdict(entry.name)\|me.name_verdict(' || true"]
say gone.out
assert (trim gone.out) == "0" else "contained: the elder pen must lose every USE of the rule -- read the reading above"
let eb1 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${elder_dir}/src/main.rye -femit-bin=${elder_dir}/bin/amphora"]
if eb1.ok == false then say eb1.err
assert eb1.ok else "contained: elder amphora build failed -- read the line above"
let eb2 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${elder_dir}/vessel_seal.rye -femit-bin=${elder_dir}/bin/vessel-seal"]
if eb2.ok == false then say eb2.err
assert eb2.ok else "contained: elder vessel-seal build failed -- read the line above"
let eb3 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build ${elder_dir}/vessel_core.rye -femit-bin=${elder_dir}/bin/vessel-core"]
if eb3.ok == false then say eb3.err
assert eb3.ok else "contained: elder vessel-core build failed -- read the line above"

# The elder seals and stamps what every repaired door refused, then restores it -- and the file
# lands ABOVE the out-home while the command still prints its files-proven line.
let elder_forge = run ["sh" "-c" "cp ${home}/forged.bron ${home}/elder.bron && ${elder_dir}/bin/vessel-seal seal ${home}/elder.bron && ${elder_dir}/bin/vessel-core sign ${home}/elder.bron"]
if elder_forge.ok == false then say elder_forge.err
assert elder_forge.ok else "contained: the elder must seal and stamp the escaping vessel -- read the line above"
let elder_restore = run ["sh" "-c" "cp ${home}/elder.bron ${home}/eread.bron && cp -r ${home}/resins ${home}/resins.keep >/dev/null 2>&1; ${elder_dir}/bin/amphora restore ${home}/eread.bron; true"]
assert elder_restore.err contains "restore files proven" else "contained: the elder prints its files-proven line over an escaping name"
let escaped = run ["sh" "-c" "test -e ${home}/escaped.txt"]
assert escaped.ok else "contained: the wall removed, the file must land above the out-home -- otherwise this witness proves nothing"
let sweep_escape = run ["sh" "-c" "rm -f ${home}/escaped.txt && rm -rf ${home}/eread.bron.season"]
assert sweep_escape.ok else "contained: the escape must sweep"

# --- the wall returned: the repaired restore, over an ELDER seal tool, meets the escaping name at
# the cargo reader. This is the one door the repaired binaries cannot reach on their own, because
# every earlier door refuses first -- so it is reached the only honest way, by an elder vessel.
let mixed = run ["sh" "-c" "mkdir -p ${home}/mixed && cp ${home}/bin/amphora ${home}/mixed/ && cp ${elder_dir}/bin/vessel-seal ${elder_dir}/bin/vessel-core ${home}/mixed/"]
assert mixed.ok else "contained: the mixed pen must assemble"
let cargo_door = run ["sh" "-c" "cp ${home}/elder.bron ${home}/mread.bron && ${home}/mixed/amphora restore ${home}/mread.bron; true"]
assert cargo_door.err contains "cargo unproven" else "contained: the cargo reader must refuse an escaping name by its own door"
let no_write = run ["sh" "-c" "test ! -e ${home}/escaped.txt"]
assert no_write.ok else "contained: the refusal must arrive BEFORE the write"
let no_count = run ["sh" "-c" "printf '%s' \"${cargo_door.err}\" | grep -c 'files proven' || true"]
assert no_count.out contains "0" else "contained: no catalog forms, so restore_prove_write is never reached"

let sweep = run ["sh" "-c" "rm -rf ${home}"]
assert sweep.ok else "contained: pen must sweep"

say "rule=both-directions doors=seal+stamp+listing+cargo wall_removed=escaped wall_returned=refused_before_write"
say "GREEN: amphora_contained_name -- a cargo name lands inside its home, or it does not land."
