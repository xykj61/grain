# tools/am/amphora_carry_witness.rish -- Q26: the round trip, measured whole.
#
# pour -> carry -> far bytes equal near bytes -> far walls verify -> re-carry
# welcomes -> forked occupant at the dock refuses.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/am/amphora_carry_witness.rish

let season = "tools/fixtures/cellar_ring1_tree"
let vessel = "/tmp/amphora_carry_witness_vessel.bron"
let dock = "/tmp/amphora_carry_witness_dock"

let clean = run ["rm" "-rf" vessel dock]
assert clean.ok else "amphora_carry: clean must pass"

# The witness builds the binaries it runs, rather than assuming a previous lap left them
# behind. amphora/bin/ is gitignored (.gitignore:336), so a clone carries none of them and
# this witness died on a missing file rather than on an Amphora fact (REDS %334).
# All three, whatever this file names in run position: amphora/src/main.rye:138 and :176
# resolve vessel-seal and vessel-core as SIBLING SUBPROCESSES, so `pour` needs them present.
# The mkdir comes first because rye build refuses an absent -femit-bin directory (REDS %337).
let zig = "vendor/zig-toolchain/zig"
let build_amphora = run ["sh" "-c" "mkdir -p amphora/bin && env RYE_ZIG=${zig} rye/bin/rye build amphora/src/main.rye -femit-bin=amphora/bin/amphora"]
assert build_amphora.ok else "amphora_carry: amphora build failed -- ${build_amphora.err}"
let build_core = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_core.rye -femit-bin=amphora/bin/vessel-core"]
assert build_core.ok else "amphora_carry: vessel-core build failed -- ${build_core.err}"
let build_seal = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build amphora/vessel_seal.rye -femit-bin=amphora/bin/vessel-seal"]
assert build_seal.ok else "amphora_carry: vessel-seal build failed -- ${build_seal.err}"

let pour = run ["amphora/bin/amphora" "pour" season vessel]
assert pour.ok else "amphora_carry: pour must exit ok"

let carry = run ["amphora/bin/amphora" "carry" vessel dock]
assert carry.ok else "amphora_carry: carry must exit ok"
assert carry.err contains "carry complete" else "amphora_carry: completion spoken"

let equal = run ["cmp" "-s" vessel "${dock}/vessel.bron"]
assert equal.ok else "amphora_carry: far bytes must equal near bytes"

let far = run ["amphora/bin/vessel-core" "verify" "${dock}/vessel.bron"]
assert far.ok else "amphora_carry: far stamp must verify"
let faropen = run ["amphora/bin/vessel-seal" "open-check" "${dock}/vessel.bron"]
assert faropen.ok else "amphora_carry: far seal must open"

let again = run ["amphora/bin/amphora" "carry" vessel dock]
assert again.ok else "amphora_carry: re-carry must welcome"

let forkprep = run ["sh" "-c" "rm -rf /tmp/amphora_carry_fork; cp -r ${season} /tmp/amphora_carry_fork; printf x >> /tmp/amphora_carry_fork/$(ls /tmp/amphora_carry_fork | head -1)"]
assert forkprep.ok else "amphora_carry: fork plant must prepare"
let fv = run ["amphora/bin/amphora" "pour" "/tmp/amphora_carry_fork" "/tmp/amphora_carry_fork_vessel.bron"]
assert fv.ok else "amphora_carry: fork pour must pass"
let plant = run ["cp" "/tmp/amphora_carry_fork_vessel.bron" "${dock}/vessel.bron"]
assert plant.ok else "amphora_carry: fork plant at dock"
let refused = run ["amphora/bin/amphora" "carry" vessel dock]
assert (refused.ok == false) else "amphora_carry: forked dock must refuse"
assert refused.err contains "identity fork" else "amphora_carry: fork names its fault"

say "round=crossed equal=true farwalls=green repour=welcome fork=refused"
say "GREEN: amphora_carry — the round trip closes equal, and the far side keeps the law."
