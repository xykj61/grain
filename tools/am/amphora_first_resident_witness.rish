# tools/am/amphora_first_resident_witness.rish -- Q56: Amphora pours a real counsel season.
#
# Chapter source: tools/fixtures/amphora_first_resident_counsel (five J4 counsel seats).
# Proves: pour - stamp - seal - restore - byte-equal out-home.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/am/amphora_first_resident_witness.rish

let season = "tools/fixtures/amphora_first_resident_counsel"
let home = "/tmp/amphora_first_resident_witness"
let vessel = "/tmp/amphora_first_resident_witness/counsel.bron"
let out = "/tmp/amphora_first_resident_witness/counsel.bron.season"

let wipe = run ["rm" "-rf" home]
assert wipe.ok else "first_resident: home wipe"
let mk = run ["mkdir" "-p" home]
assert mk.ok else "first_resident: home mkdir"

# The witness builds the binary it runs (REDS %334: a build named in a comment builds nothing).
let build = run ["env" "RYE_ZIG=vendor/zig-toolchain/zig" "rye/bin/rye" "build" "amphora/src/main.rye" "-femit-bin=amphora/bin/amphora"]
assert build.ok else "first_resident: amphora build must succeed"

let pour = run ["amphora/bin/amphora" "pour" season vessel]
assert pour.ok else "first_resident: pour must exit ok"
assert pour.err contains "pour complete" else "first_resident: pour speaks complete"

let verify = run ["amphora/bin/vessel-core" "verify" vessel]
assert verify.ok else "first_resident: stamp must verify"

let seal = run ["amphora/bin/vessel-seal" "open-check" vessel]
assert seal.ok else "first_resident: seal must open"

let restore = run ["amphora/bin/amphora" "restore" vessel]
assert restore.ok else "first_resident: restore must exit ok"
assert restore.err contains "restore complete" else "first_resident: restore speaks complete"

let eq = run ["diff" "-qr" season out]
assert eq.ok else "first_resident: restored season must equal counsel source"

let count = run ["sh" "-c" "ls tools/fixtures/amphora_first_resident_counsel | wc -l | tr -d ' '"]
assert count.ok else "first_resident: fixture count measured"
say "first_resident=poured stamp=ok seal=ok restore=byte-equal files=${count.out}"
say "GREEN: amphora_first_resident -- a real counsel season crosses and returns whole."
