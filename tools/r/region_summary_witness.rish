# tools/r/region_summary_witness.rish -- read a query RECTANGLE as a small DIGEST TABLE, joining region_partition's three window-versus-
# crossing classes with scene_manifest's per-object area and holes, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/region_partition.rye splits a rectangle's crossing set into CONTAINED, CLIPPED, OUTSIDE and
# reads the three class SIZES. This rung reads the three class FACTS: region_summary folds each object's whole-scene area and hole count
# into its class, largest_contained names the biggest object a window select keeps. A reading over two readings -- no plane of its own.
#
# The crux this witness proves on metal, the box-is-a-prefilter lesson lifted from the OBJECT to its AREA: a per-class area sum reads
# each object's WHOLE foreground area, which for a CONTAINED object IS its in-rect foreground (every pixel inside) so contained_area is
# EXACT, yet for a CLIPPED object strictly EXCEEDS its in-rect foreground (some pixels outside by definition) so clipped_area OVER-COUNTS
# and touched_area is only an UPPER BOUND on the true in-rect foreground, tight only where nothing is clipped. Proven by a full pixel
# scan: contained_area equals the in-rect foreground exactly, while a clipped block's whole area (8) exceeds its in-rect pixels (4).
# The three counts partition the scene; largest_contained refuses NoContained when nothing is whole; a malformed rectangle refuses
# BadRect; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/region_summary_witness.rish

say "region_summary: Language EN -- Season G rectangle-to-digest; the whole-object area is EXACT for the contained class where it OVER-COUNTS for the clipped class; NO float, NO tolerance."
say "region_summary: Style Radiant -- compose not braid: this rung owns only the per-class fold of area and holes; region_partition owns the classification and exact box test, scene_manifest owns the per-object area and holes. No plane of its own, no pixel written -- a reading over two readings."
say "region_summary: Lens TAME -- the classification walk runs components times under label_max_pixels; each per-class accumulator sums at most components whole areas each under the pixel ceiling; a malformed rectangle refuses BadRect, an off-map marquee is an all-OUTSIDE digest, an empty contained class refuses NoContained; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/region_summary"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/region_summary.rye -femit-bin=${bin}"]
assert build.ok else "region_summary: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "region_summary: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "region_summary: ${out}"

assert selftest.out contains "GREEN image-region-summary" else "region_summary: selftest did not print the GREEN line"
assert selftest.out contains "read a query RECTANGLE as a small DIGEST TABLE" else "region_summary: the digest-table claim did not print"
assert selftest.out contains "lifts the box-is-a-prefilter lesson from the OBJECT to its AREA" else "region_summary: the decisive area crux did not print"
assert selftest.out contains "for a CONTAINED object IS its in-rect foreground (every pixel inside) so contained_area is EXACT" else "region_summary: the contained-exact claim did not print"
assert selftest.out contains "for a CLIPPED object STRICTLY EXCEEDS its in-rect foreground" else "region_summary: the clipped-over-count claim did not print"
assert selftest.out contains "touched_area is only an UPPER BOUND on the true in-rect foreground" else "region_summary: the upper-bound claim did not print"
assert selftest.out contains "a pixel scan finds only 4 of B's pixels inside (its right half cut off at x=6)" else "region_summary: the pixel-scan over-count did not print"
assert selftest.out contains "touched_area (34) equals the true in-rect foreground exactly, the bound tight at the no-clip fixed point" else "region_summary: the fixed-point tightness did not print"
assert selftest.out contains "largest_contained refuses NoContained" else "region_summary: the NoContained refusal did not print"
assert selftest.out contains "the three counts partition the scene" else "region_summary: the partition claim did not print"
assert selftest.out contains "largest_contained names A the biggest window keep" else "region_summary: the largest-contained keep did not print"
assert selftest.out contains "a malformed rectangle refuses BadRect having read nothing" else "region_summary: the BadRect refusal did not print"
assert selftest.out contains "the same rectangle reads the same digest twice" else "region_summary: determinism did not print"

say "region_summary: GREEN on metal -- a rectangle read as a small digest table, the whole-object area exact for the contained class and an over-count for the clipped class, so touched_area is an upper bound tight only where nothing is clipped; refusals by name, determinism. Season G open-media."
