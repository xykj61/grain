# tools/r/unshared_citation_witness.rish -- a lap cites its own row by stamp until the row is shared.
#
#   rishi/bin/rishi run tools/r/unshared_citation_witness.rish
#
# `.claude/rules/derived-spine.md` rule 4 has said this since `20260827`: the `%N` beside a row is a
# VIEW allocated by the anointed remote, so a lap names its own row by stamp until that number is
# bound upstream. The law is right; the practice was not. Measured `20260906` over that day's
# session logs: not one cited a new row by its stamp, and the bill stands in the ledger as **28
# recorded errata**, six rows renumbered more than once, and one row renumbered four times.
#
# The renumbering is lawful and costs nothing -- the stamp never moved in any of the 28. What costs
# is every OTHER file that spelled the number: a `%N` reaches 20 to 36 files within a day, and one
# such sweep "ran as a blind `sed` that rewrote a peer's row and two upstream passages". This guard
# holds the living surfaces a renumber would have to sweep at zero.

say "unshared-citation: Language EN -- a number is a view, and a view can change."
say "unshared-citation: Style Gauge, Meter -- one boundary, read from the anointed spine."
say "unshared-citation: Lens TAME -- every refusal planted in a pen and then lifted."

say "unshared-citation: the control -- ten behaviors against a stub spine in a throwaway repository..."
let ctl = run ["sh" "tools/fixtures/r/unshared_citation_control.sh"]
assert ctl.ok else "unshared-citation: the control refused --\n${ctl.out}\n${ctl.err}"
assert ctl.out contains "pass=10 fail=0" else "unshared-citation: the control did not prove ten behaviors --\n${ctl.out}\n${ctl.err}"

say "unshared-citation: no living surface cites a number the spine has not bound..."
let scan = run ["sh" "tools/fixtures/r/unshared_citation_scan.sh"]
assert scan.ok else "unshared-citation: the scan refused --\n${scan.out}"
# invariant: a citation of an unshared number is a sweep this lap has chosen and the stamp would
# have avoided -- the ledger assigns numbers, testimony records them, and living prose cites only
# what the anointed spine already bound.
assert scan.out contains "unshared_citations=0" else "unshared-citation: a living file cites a row number the anointed spine has not allocated -- cite the stamp until it is shared --\n${scan.out}"

say "unshared-citation: and the boundary is read rather than spelled..."
let derived = run ["sh" "-c" "grep -c 'reds_spine_derive_scan.sh' tools/fixtures/r/unshared_citation_scan.sh"]
assert derived.ok else "unshared-citation: the derivation could not be read"
# invariant: shared_max comes from the spine on every run. A number written into this file would be
# a second copy of the allocation, which is the fault the derived-spine law exists to end.
assert (trim derived.out) != "0" else "unshared-citation: the scan spells its own boundary rather than reading the spine"

say "GREEN: unshared-citation -- the ledger assigns a number, testimony keeps the one it wrote, and living prose cites only what the spine has bound."
