# realidream_forge_query_unified_view.rish -- Forge query unified: hosted + device -> Skate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/realidream_forge_query_unified_view.rish

let bin = "pond/bin/drawn-terminal"

# A Wayland application on a headless pier is a machine fact, never a tree red (REDS %173).
# One shared probe answers for every caller; it exits 3, and only 3, when a seam is absent.
let gate = run ["sh" "-c" "sh tools/fixtures/d/display_seam_probe.sh >/dev/null 2>&1; test $? -eq 3"]
if gate.ok then say "GATED: drawn-terminal wants a host with a display -- no graphical link seam here."
if gate.ok then say "GATED: run it on a Wayland host, or provision the seams -- a NixOS rebuild, a hand's gate."
if gate.ok then exit 0

say "build: Realidream forge query unified view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for forge query unified view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let forge = run ["sh" "-c" "${bin} forgequeryunifiedviewtest 2>&1"]
assert forge.ok else "drawn terminal forgequeryunifiedviewtest exited non-zero"
assert forge.out contains "forge query unified" else "forge query unified view missing expected output"
assert forge.out contains "GREEN" else "Realidream forge query unified view not GREEN"
assert forge.out contains "lines=8" else "forge query unified view missing eight-line frame"

say "GREEN: Realidream forge query unified view — hosted and device forge hits on one Skate frame."
