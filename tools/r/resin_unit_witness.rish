# resin_unit_witness.rish — Arc II Resin unit: one public fold over resin greens.
#
# Sameness as the macro: callers run this name; internals stay the named
# witnesses. Chunk cargo path here is the fixture; the Amphora hand
# tools/am/amphora_resin_chunk.rish owns rebuild+chunkdemo (tidied r8).
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/resin_unit_witness.rish

say "resin-unit: mantra resin-batch..."
let batch = run ["rishi/bin/rishi" "run" "tools/m/mantra_resin_batch.rish"]
assert batch.ok else "mantra_resin_batch failed"
assert batch.out contains "GREEN" else "mantra_resin_batch not GREEN"

say "resin-unit: granary resin wire..."
let granary = run ["rishi/bin/rishi" "run" "tools/g/granary_resin_wire.rish"]
assert granary.ok else "granary_resin_wire failed"
assert granary.out contains "GREEN" else "granary_resin_wire not GREEN"

say "resin-unit: amphora chunk fixture (cargo path)..."
let chunk = run ["sh" "tools/fixtures/amphora_chunk_witness.sh"]
assert chunk.ok else "amphora_chunk_witness failed"
assert chunk.out contains "GREEN" else "amphora_chunk_witness not GREEN"
assert chunk.out contains "SCRUB ok" else "amphora_chunk_witness missing SCRUB ok"

say "resin-unit: TUBE3 resin-fetch..."
let tube3 = run ["rishi/bin/rishi" "run" "tools/t/tube3_resin_fetch_witness.rish"]
assert tube3.ok else "tube3_resin_fetch_witness failed"
assert tube3.out contains "GREEN" else "tube3_resin_fetch_witness not GREEN"

say "GREEN: resin unit — batch · granary wire · amphora chunk · TUBE3 fetch."
