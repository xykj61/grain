# realidream_forge_view.rish -- Realidream forge view: live Amphora pour -> Skate.
#
# Pours amphora_lap3_tree into tools/fixtures/.forge_view_bundle, then folds
# cellar manifest + Amphora vessel through SLC-2a. Thin view -- no Dexter graduation.
# Run from the repository root:
#   rishi/bin/rishi run tools/r/realidream_forge_view.rish

let bin = "pond/bin/drawn-terminal"

# A Wayland application on a headless pier is a machine fact, never a tree red (REDS %173).
# One shared probe answers for every caller; it exits 3, and only 3, when a seam is absent.
let gate = run ["sh" "-c" "sh tools/fixtures/d/display_seam_probe.sh >/dev/null 2>&1; test $? -eq 3"]
if gate.ok then say "GATED: drawn-terminal wants a host with a display -- no graphical link seam here."
if gate.ok then say "GATED: run it on a Wayland host, or provision the seams -- a NixOS rebuild, a hand's gate."
if gate.ok then exit 0

say "pour: forge view bundle from Amphora pour..."
let pour = run ["sh" "tools/fixtures/f/forge_view_pour.sh"]
assert pour.ok else "forge view pour failed"
assert pour.out contains "FORGE_POUR ok" else "forge view pour missing ok line"

say "build: Realidream forge view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for forge view witness"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let forge = run ["sh" "-c" "${bin} forgeviewtest 2>&1"]
assert forge.ok else "drawn terminal forgeviewtest exited non-zero"
assert forge.out contains "forge view" else "forge view witness missing expected output"
assert forge.out contains "GREEN" else "Realidream forge view witness not GREEN"
assert forge.out contains "lines=8" else "forge view missing eight-line frame"

say "GREEN: Realidream forge view — live Amphora pour composes a Skate frame."
