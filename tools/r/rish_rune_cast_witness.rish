# rish_rune_cast_witness.rish — the ^- cast rune, the first Glow rune Rishi speaks.
#
# Proves Rishi now recognizes `^-` (kethep) as first-class syntax: it evaluates a body
# as a full expression, gates the value against the named **shape** (this tree's word,
# not Hoon's "mold"), enforces the shape's explicit width, nests, and refuses what
# cannot hold. A cast in Rishi is TAME's explicit width spoken as a rune.
#
#   rishi/bin/rishi run tools/r/rish_rune_cast_witness.rish

# A valid u32 passes through unchanged.
let a = ^- @u32 42
assert a == 42 else "^- @u32 42 should pass through as 42"

# The body is a full expression, evaluated before the cast — the rune nests.
let b = ^- @u32 (length "abc")
assert b == 3 else "^- @u32 (length ...) should evaluate the body, then cast to 3"

# The text shape gates on string.
let c = ^- @t "hello"
assert c == "hello" else "^- @t should pass a string through unchanged"

# @i64 accepts any signed integer, including negative.
let d = ^- @i64 -5
assert d == -5 else "^- @i64 should accept a negative int"

# @ud accepts a non-negative int.
let e = ^- @ud 7
assert e == 7 else "^- @ud should accept a non-negative int"

# A value that cannot hold refuses — a child whose cast fails exits non-zero.
let bad_type = run ["rishi/bin/rishi" "run" "tools/fixtures/rune_cast_bad_type.rish"]
assert bad_type.ok == false else "^- @u32 on a string must refuse (child should exit non-zero)"

let bad_range = run ["rishi/bin/rishi" "run" "tools/fixtures/rune_cast_out_of_range.rish"]
assert bad_range.ok == false else "^- @u32 -1 is below the u32 window and must refuse"

say "GREEN: Rishi rune-cast — ^- gates a value against its shape and explicit width, nests, and refuses what cannot hold."
