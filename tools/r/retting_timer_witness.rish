# tools/r/retting_timer_witness.rish -- the retting timer, ring one, proven whole.
#
# Simple Lovable Complete at witness grade: build - start - status - the
# READY fold on an aged plant - three refusals by name. Home is a /tmp
# fixture (witness law); the shipped default is durable linengrow/.retting.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/retting_timer_witness.rish

let build = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build linengrow/retting_timer.rye -femit-bin=linengrow/bin/retting"]
assert build.ok else "retting: build must pass"

# Ring-two build leg (e214): the Wasm target must keep compiling under a
# named size roof. Running it end-to-end waits on the WASI dir seam (the
# rye std carries no preopen walk today -- measured, zero prestat mentions).
let wasm = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build linengrow/retting_timer.rye -femit-bin=/tmp/retting_probe.wasm -target wasm32-wasi"]
assert wasm.ok else "retting: wasm target must build"
let wsize = run ["sh" "-c" "n=$(wc -c < /tmp/retting_probe.wasm); test $n -le 4194304 && echo wasm_bytes=$n"]
assert wsize.ok else "retting: wasm stays under the 4 MiB roof"

let fresh = run ["sh" "-c" "rm -rf /tmp/rtw; mkdir -p /tmp/rtw"]
assert fresh.ok else "retting: fixture home stands"

let start = run ["sh" "-c" "RETTING_HOME=/tmp/rtw linengrow/bin/retting start alpha 14 2>&1"]
assert start.ok else "retting: start must pass"
assert start.out contains "alpha started for 14 days" else "retting: start speaks"

let plant = run ["sh" "-c" "n=$(date +%s); a=$((n - 259200)); printf 'start %s 2 aged\n' $a >> /tmp/rtw/log.txt"]
assert plant.ok else "retting: aged plant lands"

let status = run ["sh" "-c" "RETTING_HOME=/tmp/rtw linengrow/bin/retting status 2>&1"]
assert status.ok else "retting: status must pass"
assert status.out contains "alpha day 1 of 14" else "retting: young batch counts day one"
assert status.out contains "aged READY" else "retting: aged batch folds to READY"

let days_red = run ["sh" "-c" "RETTING_HOME=/tmp/rtw linengrow/bin/retting start bad 999 2>&1"]
assert (days_red.ok == false) else "retting: day bound must refuse"
assert days_red.out contains "DaysOutOfBound" else "retting: refusal names the fault"

let name_red = run ["sh" "-c" "RETTING_HOME=/tmp/rtw linengrow/bin/retting start a-name-far-longer-than-a-jar-label-allows 3 2>&1"]
assert (name_red.ok == false) else "retting: name bound must refuse"

let home_red = run ["sh" "-c" "RETTING_HOME=/tmp/rtw_absent linengrow/bin/retting status 2>&1"]
assert (home_red.ok == false) else "retting: absent home must refuse"
assert home_red.out contains "HomeUnavailable" else "retting: home refusal names the fault"

say "build=green start=green status=fold ready=plant refusals=3-named"
say "GREEN: retting_timer ring one — simple, lovable, complete at its stated scope."
