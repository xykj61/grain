# tools/r/rye_compile_reach_witness.rish -- does anything in this tree ever compile that module?
#
# WHY THIS RUNG EXISTS. `mantra/src/weave.rye` had not compiled since the toolchain moved --
# `Weave.empty()` still returned the elder `.{}` ArrayList form where Zig 0.16 wants `.empty`, and
# building the HEAD blob in a pen answers *missing struct field: items*. Four guards stood at
# `tier lap` reading that module every lap and all four stayed green, because all four read it with
# `grep`. Its own test inlines a copy of it, and the copy reads `.empty` -- because the test is
# compiled and the module is not. A test that inlines its subject migrates with the toolchain while
# the subject rots, and every guard stays green (REDS %449, which booked this census).
#
# WHAT IT HOLDS. One reading is gated: a tracked Rye file that a runner makes a claim about while no
# build anywhere ever reaches it. That is %449's exact shape, and its ceiling only falls. The other
# readings -- files nothing compiles and nobody claims, planted specimens under `fixtures/`, imports
# naming a path that is not there -- are reported, because a test a hand runs and a probe kept for a
# day that has not come are honest, and a gate that reds on the honest is a gate someone turns off.
#
# WHY THE COUNTS ARE A FLOOR. A build root reaches the compiler three ways here -- a literal, a
# variable, and a function parameter -- so the census credits a runner generously: one that invokes
# the Rye compiler at all credits every Rye path it names. It over-credits on purpose, because a
# mis-tuned chase across 1,500 runners produces a confident false claim, which is the failure %460
# closed one lane over. Every count is a floor for the shapes the census can read, and the residue
# it cannot read rides beside them as `harness_unresolved` rather than as a reader's trust.
#
# AND THAT RESIDUE IS WEIGHED, because the raw count answers the resolver's question rather than
# this census's. The credit is conditional on the assembling script compiling anything; the residue
# was published unconditionally, so a reader weighing the floor met a doubt ten times the size of
# the one that could reach it. Nine of the field's ten unresolved sites sit in scripts that only
# read their directories, so the credit rule already answers them. `harness_unresolved_compiling`
# is the part that could, gated at 1 and falling only; the raw count rides beside it ungated, since
# a gate on the harmless is a gate someone turns off (the residue row `20260906.113130`).
#
# WHY IT ASKS ANOTHER SCAN. A runner can name its target without writing it down. One harness here
# compiles 116 Rye programs whose paths it joins from a directory in one variable and a bare stem in
# another, so none of the 116 is written anywhere in this tree -- and reading for filenames called
# every one of them unbuilt, 114 landing in a set labelled *a file no build reaches* (REDS %466).
# The census asks `rye_harness_roster_scan.sh --paths` for those, since that scan already resolves a
# harness's directory and stem list for its own gate. The credit is conditional on the harness
# actually invoking the compiler, so asking widens what is SEEN without widening what is BELIEVED,
# and a resolver that is missing or too old makes this census REFUSE rather than accuse 114 files.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/rye_compile_reach_witness.rish

say "rye-compile-reach: Language EN -- which authored Rye does anything ever compile?"
say "rye-compile-reach: Style Gauge, Meter -- one gated reading, three reported, every count a floor."
say "rye-compile-reach: Lens TAME -- three named bounds, and a refusal by name at each."

say "rye-compile-reach: reading the corpus, the runners, and the import graph..."
let census = run ["sh" "tools/fixtures/r/rye_compile_reach_scan.sh"]
assert census.ok else "rye-compile-reach: the census refused -- ${census.out}"
assert census.out contains "verdict=ok" else "rye-compile-reach: a tracked Rye file carries a claim no build ever checks -- ${census.out}"

assert census.out contains "corpus=" else "rye-compile-reach: the corpus count is missing"
assert census.out contains "distinct=" else "rye-compile-reach: the distinct-file count is missing"
assert census.out contains "roots=" else "rye-compile-reach: the build-root count is missing"
assert census.out contains "asserted=" else "rye-compile-reach: the gated reading is missing"
assert census.out contains "harness_paths=" else "rye-compile-reach: the assembled-path credit is missing -- without it 114 built files read as never-compiled"
assert census.out contains "harness_unresolved=" else "rye-compile-reach: the residue count is missing -- a floor that does not name what it cannot see is a claim"
assert census.out contains "harness_unresolved_compiling=" else "rye-compile-reach: the residue is unweighed -- a raw count answers the resolver's question, not this census's"

say "rye-compile-reach: proving the census on real repositories in a throwaway pen..."
let control = run ["sh" "tools/fixtures/r/rye_compile_reach_control.sh"]
assert control.ok else "rye-compile-reach: the control must complete -- a census nobody has watched fail is a census nobody has tested"
assert control.out contains "control_verdict=ok" else "rye-compile-reach: the control must reach its own verdict -- ${control.out}"
assert control.out contains "fail=0" else "rye-compile-reach: a planted case behaved wrongly -- ${control.out}"

# The two cases the whole census rests on, named here so a reader of this rung knows they ran.
assert control.out contains "a link to a built module is innocent" else "rye-compile-reach: the symlink-innocence case is missing -- sixteen false accusations rode on it"
assert control.out contains "the pen is innocent" else "rye-compile-reach: the innocence phase is missing -- every pass above would be a pass of the pen"
assert control.out contains "ceiling+1 asserted files exit 1" else "rye-compile-reach: the ceiling is not proven from its failing side"
assert control.out contains "exactly at the ceiling exits 0" else "rye-compile-reach: the ceiling is not proven from its passing side"

# The assembled-path credit, named from both sides. One word separates the two pens, so a credit
# that had quietly become unconditional would pass the first of these and fail the second.
assert control.out contains "a harness that compiles its assembled stems exits 0" else "rye-compile-reach: the assembled-path credit is not proven from its welcoming side"
assert control.out contains "a harness that only reads credits nothing" else "rye-compile-reach: the credit is not proven conditional -- an unconditional one passes the welcome and fails nothing"
assert control.out contains "the resolver missing refuses" else "rye-compile-reach: a missing resolver must refuse, never accuse every assembled path in silence"
assert control.out contains "a resolver with no marker refuses" else "rye-compile-reach: a resolver too old to know the flag reads exactly like an empty tree without the marker check"
assert control.out contains "a tree holding no harness exits 0" else "rye-compile-reach: an empty tree must stay lawful -- the refusals above must not swallow it"

# The residue weighed by the same condition the credit is. Two pens differing by one word, so a
# residue that had quietly gone unconditional again passes the first of these and fails the second.
# The condition moved UPSTREAM on `20260906`: the producing scan declines a non-building assembler
# itself, so the reading pen now leaves BOTH numbers at zero rather than only the weighed one. Both
# legs are still pinned, because the pens still differ by one word and the claim is unchanged --
# a site that could credit nothing must reach nothing.
assert control.out contains "and weighed, because this one compiles" else "rye-compile-reach: an unreadable site in a compiling script must be weighed"
assert control.out contains "a reading script's site leaves the harness residue" else "rye-compile-reach: a non-building assembler must leave the residue at its source"
assert control.out contains "and weighs zero, since it could credit nothing" else "rye-compile-reach: the residue is not proven conditional -- an unconditional one passes the welcome and fails nothing"
assert control.out contains "ceiling+1 unreadable sites in compiling scripts exit 1" else "rye-compile-reach: the residue ceiling is not proven from its failing side"
assert control.out contains "a resolver counting a residue it does not name refuses" else "rye-compile-reach: a counted residue nobody named must refuse, never read as harmless"

say "GREEN: every distinct Rye file is compiled by something, is a planted specimen, or carries no claim."
