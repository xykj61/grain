# realidream_forge_query_device_view.rish -- Forge query device: device-wire hits -> Skate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/realidream_forge_query_device_view.rish

let bin = "pond/bin/drawn-terminal"

# A Wayland application on a headless pier is a machine fact, never a tree red (REDS %173).
# One shared probe answers for every caller; it exits 3, and only 3, when a seam is absent.
let gate = run ["sh" "-c" "sh tools/fixtures/d/display_seam_probe.sh >/dev/null 2>&1; test $? -eq 3"]
if gate.ok then say "GATED: drawn-terminal wants a host with a display -- no graphical link seam here."
if gate.ok then say "GATED: run it on a Wayland host, or provision the seams -- a NixOS rebuild, a hand's gate."
if gate.ok then exit 0

say "build: Realidream forge query device view — drawn-terminal compile"
let build = run ["sh" "tools/fixtures/p/pond_build_drawn_terminal.sh"]
assert build.ok else "drawn_terminal build failed for forge query device view"
assert build.out contains "GREEN:" else "drawn_terminal build did not reach GREEN"

let forge = run ["sh" "-c" "${bin} forgequerydeviceviewtest 2>&1"]
assert forge.ok else "drawn terminal forgequerydeviceviewtest exited non-zero"
assert forge.out contains "forge query device" else "forge query device view missing expected output"
assert forge.out contains "GREEN" else "Realidream forge query device view not GREEN"
assert forge.out contains "lines=6" else "forge query device view missing six-line frame"

say "GREEN: Realidream forge query device view — device forge hits on one Skate frame."
