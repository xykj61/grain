# tools/r/region_cluster_witness.rish -- which connected clusters a query rectangle lands on, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/region_select.rye names every object a query rectangle covers (a geometric question);
# image/overlap_clusters.rye partitions the scene into connected clusters (a topological question). This rung joins the two: clusters_in_rect
# names the ascending set of clusters the rectangle's selected objects belong to, cluster_count_in_rect their count, selects_whole_cluster
# whether the rectangle catches a whole cluster or only part. Exact integers, NO float, NO tolerance.
#
# The crux this witness proves on metal, two shapes: A RECTANGLE SELECTS ONLY PART OF A CLUSTER -- a rectangle tight on one member of a
# connected cluster selects it alone, so selects_whole_cluster reads false, the connected group split by a box that knows nothing of
# connectivity; A RECTANGLE SPANS MULTIPLE CLUSTERS -- a strip crossing two clusters selects one object from each, so cluster_count_in_rect
# reads 2, a geometric box freely crossing topological boundaries. Refusals by name, determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/r/region_cluster_witness.rish

say "region_cluster: Language EN -- Season G region-to-cluster read; clusters_in_rect names the connected clusters a query rectangle lands on, cluster_count_in_rect their count, selects_whole_cluster whether a whole cluster is caught or only part; NO float, NO tolerance."
say "region_cluster: Style Radiant -- compose not braid: this rung owns only the object-set-to-cluster-set map and the whole-cluster test; region_select owns the rectangle-to-object decision and the label-map arbiter, overlap_clusters owns the connectivity and cluster labeling, scene_graph owns the per-object manifest. A reading over a reading."
say "region_cluster: Lens TAME -- the marquee scan is bounded by the pixel ceiling, the selected set holds at most the object count, the cluster-presence tally is sized to the cluster count plus one; a malformed rectangle refuses BadRect, a zero or past-the-count cluster id refuses BadClusterId; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/region_cluster"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/region_cluster.rye -femit-bin=${bin}"]
assert build.ok else "region_cluster: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "region_cluster: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "region_cluster: ${out}"

assert selftest.out contains "GREEN image-region-cluster" else "region_cluster: selftest did not print the GREEN line"
assert selftest.out contains "A RECTANGLE SELECTS ONLY PART OF A CLUSTER" else "region_cluster: the part-of-a-cluster case did not print"
assert selftest.out contains "the selected set a strict subset of the cluster" else "region_cluster: the strict-subset fact did not print"
assert selftest.out contains "A RECTANGLE SPANS MULTIPLE CLUSTERS" else "region_cluster: the spans-multiple-clusters case did not print"
assert selftest.out contains "a geometric box freely crossing topological boundaries" else "region_cluster: the crossing-boundaries fact did not print"
assert selftest.out contains "holds cluster 2 whole" else "region_cluster: the whole-cluster-2 fact did not print"
assert selftest.out contains "refuses BadClusterId" else "region_cluster: the bad-cluster-id refusal did not print"
assert selftest.out contains "refuses BadRect" else "region_cluster: the bad-rect refusal did not print"
assert selftest.out contains "the same rectangle lands on the same clusters twice" else "region_cluster: the determinism statement did not print"

say "region_cluster: GREEN on metal -- which connected clusters a query rectangle lands on; a rectangle selects only part of a cluster (a box splitting a connected group), a rectangle spans multiple clusters (a geometric box crossing topological boundaries), the whole-cluster test reads true only when every member is caught; refusals by name, determinism. Season G open-media."
