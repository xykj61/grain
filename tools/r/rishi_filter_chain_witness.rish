# rishi_filter_chain_witness.rish -- filter chained: where with numeric compare - 20260725.
#
#   rishi/bin/rishi run tools/r/rishi_filter_chain_witness.rish

let xs = [1 2 3 4 5]
let pass = where xs as x: x > 2
assert (length pass) == 3 else "where gt failed"

let pass2 = where pass as y: y < 5
assert (length pass2) == 2 else "chained where failed"

say "GREEN: Rishi filter chained — where with > and sequential chain."
