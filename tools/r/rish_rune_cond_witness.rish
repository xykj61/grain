# rish_rune_cond_witness.rish — the ?: conditional rune (wutcol).
#
# Proves Rishi has a conditional that returns a VALUE, not an effect — the piece a
# `fold` body needs, since `if/then/else` is a statement and a fold body is one
# expression. `?: <cond> <then> <else>` evaluates only the taken branch. Completes the
# boolean rune family (?! not · ?& and · ?| or · ?: if) and unlocks stateful folds —
# accumulators with per-line conditions, the shape every census seam wants.
#
#   rishi/bin/rishi run tools/r/rish_rune_cond_witness.rish

# The true and false branches.
assert (?: (1 == 1) ("yes") ("no")) == "yes" else "?: takes the then-branch when true"
assert (?: (2 == 3) ("yes") ("no")) == "no" else "?: takes the else-branch when false"

# A bare boolean condition, not only a comparison.
assert (?: (true) (1) (0)) == 1 else "?: reads a plain boolean"

# Laziness — the untaken branch never runs, so this never divides by zero.
assert (?: (true) (42) (10 / 0)) == 42 else "?: evaluates only the taken branch"

# It nests, and composes with the other runes.
assert (?: (?! false) ("a") ("b")) == "a" else "?: composes with ?!"

# The point: accumulation with a per-item condition. Count the evens in a list.
let evens = fold [1 2 3 4 5 6] from 0 as acc n: acc + (?: ((n / 2) * 2 == n) (1) (0))
assert evens == 3 else "fold + ?: counts a subset"

# A record accumulator carries state across the fold — sum and running max together.
let r = fold [3 1 4 1 5 9 2] from {sum: 0, hi: 0} as acc n: {sum: (acc.sum + n), hi: (?: (n > acc.hi) (n) (acc.hi))}
assert (r.sum) == 25 else "record fold accumulates a sum"
assert (r.hi) == 9 else "record fold carries a running maximum"

say "GREEN: Rishi ?: — a conditional that returns a value, lazy in its branches, so a fold body can carry state with per-item conditions."
