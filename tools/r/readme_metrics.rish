# tools/r/readme_metrics.rish -- render the front door numbers, and splice them in on request.
#
# WHY. A README is the most Lindy-exposed document a project owns: its promise is that a reader
# arriving three years on still finds it true. A number typed there by hand is stale the following
# morning and wrong within a month, and it will be wrong in the one document everybody trusts. So
# the front door carries GENERATED numbers or none: this renders the block, and `write` splices it
# between markers that say plainly it is not to be hand-edited.
#
# Four numbers only, chosen because they move when something REAL changes rather than every
# commit -- the reasoning is in tools/fixtures/readme_metrics_scan.sh, and the commit count and
# tracked-file count are deliberately absent.
#
# USAGE
#   rishi/bin/rishi run tools/r/readme_metrics.rish          # render to stdout, touch nothing
#   rishi/bin/rishi run tools/r/readme_metrics.rish write    # splice into README.md
#
# Proven by tools/r/readme_metrics_witness.rish. Run from the repository root.

let mode = "render"
if length args != 0 then let mode = args[0]

let scan = run ["sh" "tools/fixtures/readme_metrics_scan.sh"]
assert scan.ok else "readme-metrics: the scan must complete before anything is rendered -- see stderr"
assert scan.out contains "verdict=ok" else "readme-metrics: the scan must balance before its numbers are shown"

let rows = lines scan.out
let fascia_row = rows[0]
let witness_row = rows[1]
let module_row = rows[2]
let rooms_row = rows[3]

let fascia = slice fascia_row 7 (length fascia_row)
let witnesses = slice witness_row 10 (length witness_row)
let modules = slice module_row 8 (length module_row)
let rooms = slice rooms_row 11 (length rooms_row)

assert length fascia != 0 else "readme-metrics: the fascia grade must be read, not assumed"
assert length witnesses != 0 else "readme-metrics: the witness count must be read, not assumed"

# The block. Written between markers a human is told not to edit, because a generated number a
# human has touched is a hand-typed number wearing a generated number's clothes.
# Rishi holds no escape for a newline and no multi-line string, so one is fetched from printf --
# which is honest work rather than a trick: the shell owns character escapes, and asking it for
# the one character needed is smaller than teaching the language a syntax for it.
let nl = (run ["printf" "\n"]).out
assert (length nl) == 1 else "readme-metrics: the newline must be exactly one character"

let begin = "<!-- metrics:begin -- generated by tools/r/readme_metrics.rish; do not edit by hand -->"
let close = "<!-- metrics:end -->"
let r1 = "| Reading | Now |"
let r2 = "|---|---|"
let r3 = "| **Fascia** -- can a reader follow any thread home | **${fascia}** / 100 |"
let r4 = "| **Witnesses** running on metal | **${witnesses}** |"
let r5 = "| **Rye modules** they stand over | **${modules}** |"
let r6 = "| **Rooms grown past what a browser can list** | **${rooms}** |"
let body = "${r1}${nl}${r2}${nl}${r3}${nl}${r4}${nl}${r5}${nl}${r6}"
let block = "${begin}${nl}${nl}${body}${nl}${nl}${close}"

if mode == "render" then say block

if mode != "write" then exit exit-ok

# Rishi strings are bounded and an 18 KB README overruns that bound, so the claim stays here and
# the byte-shuffling goes to a fixture. That is the honest division rather than a workaround: the
# language that checks the fact owns the fact, and the tool that moves bytes moves bytes.
let block_path = "tools/.build/readme_metrics_block.md"
let mkdir = run ["mkdir" "-p" "tools/.build"]
assert mkdir.ok else "readme-metrics: the build directory must exist before the block is written"
write-file block_path block

let spliced = run ["sh" "tools/fixtures/readme_metrics_splice.sh" "README.md" block_path]
assert spliced.ok else "readme-metrics: the splice must succeed -- see stderr; the markers must already exist in README.md"
assert spliced.out contains "spliced=README.md" else "readme-metrics: the splice must name what it wrote"

say "readme-metrics: block written -- fascia ${fascia}, ${witnesses} witnesses over ${modules} modules, ${rooms} rooms over bound."
