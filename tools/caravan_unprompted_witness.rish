# caravan_unprompted_witness.rish -- Caravan unprompted witness.
#
# Proves who is allowed to start a conversation, and what a doorbell can
# and cannot say. Every ring before this one began at the server: the
# virtualiser asked, the client answered, and a dependent listening on a
# channel already knew what the next bell would mean because its own parent
# had scheduled the ask that caused it.
#
# Here `client_a` writes an ask into the memory it owns and rings a server
# that asked for nothing. A doorbell carries no payload -- it is a count
# that went up -- so the server cannot learn from the ring whether it is
# being asked or being answered. It reads the region its peer writes and
# lets the bytes decide.
#
# The claim is checkable from outside the program three ways. The walls say
# a client cannot plant an ask in memory it may only read. The two
# conversations say one verb carried both directions. And the count says
# how many of the attending steps answered an ask, told apart by bytes
# alone.
#
# Both RED paths were proven on metal before this witness was written.
# Making `attend` look only for an answer -- classifying by expectation
# rather than by what stands -- turned the unprompted ask into `bytes
# differed` and stopped the client-first conversation dead. Dropping the
# `heard == 0` check let the server attend a peer that had never rung,
# which is the `Unheard` wall stated in reverse.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_unprompted_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/unprompted"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/unprompted.rye -femit-bin=${bin}"]

assert build.ok else "caravan unprompted build failed"

# The reader this witness runs is built here rather than borrowed (REDS %92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# The declaration stands unchanged. A conversation starting at the client
# needs no new wiring, which is half of what this ring proves.
let decl = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_two_clients.bron 2>&1"]
assert decl.ok else "the two-client declaration could not be read"
assert decl.out contains "domains 3 -- channels 2 -- regions 4 -- grants 8" else "the two-client declaration changed shape"
assert decl.out contains "verdict: whole" else "the two-client declaration did not read whole"

# A fresh provisioning each run, so a bell found ringing was rung by this
# run rather than left standing by the last one.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan unprompted selftest exited non-zero"
assert test.out contains "GREEN" else "caravan unprompted selftest not GREEN"
assert test.out contains "who spoke first is a fact of the memory, never of the bell" else "the unprompted claim did not close"

# The plan wire is a closed shape before any process runs on it, and a verb
# this ring never named is refused rather than guessed at.
assert test.out contains "the plan wire reads back whole, and an unknown verb is refused" else "the plan wire did not read back"

# The wall that makes an unprompted ask trustworthy: a message can only be
# planted in memory its author holds for writing, so the region a message
# arrives on already names who wrote it.
assert test.out contains "client_a: announce on tx_a answering rx_a via serial_virt -- WriteDenied" else "a client forged an ask into the server's own memory"
assert test.out contains "a client announcing into the server's own memory is refused WriteDenied" else "the forgery wall did not close"

# An unwired announcement touches no bell, and a server attends nothing it
# was never rung for.
assert test.out contains "client_a: announce on rx_a answering tx_a via client_b -- NotWired" else "an undeclared channel carried an announcement"
assert test.out contains "serial_virt: attend on tx_a answering rx_a via client_a -- Unheard" else "a server attended a peer that never rang"

# A ring says only that something happened. Pointed at a region carrying no
# message, the same attending step refuses rather than inventing one.
assert test.out contains "serial_virt: attending rx_a found nothing it could read" else "the wrong region was read as a message"
assert test.out contains "serial_virt: attend on rx_a answering tx_a via client_a -- bytes differed" else "an empty region passed as a message"

# The client-first conversation: the client opens it, the server attends a
# bell it never invited, finds an ask, answers it, and the answer comes home
# with the original ask still standing beside it.
assert test.out contains "client_a: announce on rx_a answering tx_a via serial_virt -- carried" else "the client could not open a conversation"
assert test.out contains "serial_virt: attending tx_a found an ask" else "the server did not read an unprompted ask"
assert test.out contains "serial_virt: attend on tx_a answering rx_a via client_a -- carried" else "the server did not answer an ask it never made"
assert test.out contains "client_a: hear on rx_a answering tx_a via serial_virt -- carried" else "the answer did not come home"
assert test.out contains "a client opened a conversation the server never asked for, and the server answered it" else "the unprompted conversation did not close"

# The server-first conversation over the same wiring, through the same
# verb. This is the crux: identical bells, identical verb, and the two
# outcomes differ only because the bytes differed.
assert test.out contains "client_b: attending rx_b found an ask" else "the client did not read a server-first ask"
assert test.out contains "serial_virt: attending tx_b found an answer" else "the server did not read an answer as an answer"
assert test.out contains "serial_virt: attend on tx_b answering rx_b via client_b -- answer seen" else "an answer was not reported as an answer"

# And the count, measured across the whole run: three attending steps, two
# of them answering an ask. A server classifying by expectation rather than
# by bytes would read a different pair of numbers here.
assert test.out contains "3 attending steps, 2 of them answering an ask, told apart by bytes alone" else "the attending count did not measure the claim"
assert test.out contains "4 directed bells provisioned silent across 2 declared channels" else "the run did not start silent both ways"

say "GREEN: Caravan unprompted witness passed."
