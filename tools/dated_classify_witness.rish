# dated_classify_witness.rish — the Rishi dated/live classifier, living mutant of the
# elder tools/fixtures/dated_classify.py.
#
# Proves the mutant classifies the planted controls exactly as the canon defines and
# emits a self-consistent census with every definition line the roofs read. Self-
# contained — it does not shell out to python3 (absent from this pier's PATH), which is
# itself the reason the molt matters.
#
#   rishi/bin/rishi run tools/dated_classify_witness.rish

let bin = "tools/fixtures/dated_classify.rish"

# The live control declares a living-ledger header, so it is live surface though dated-named.
let live_ctl = trim (run ["rishi/bin/rishi" "run" bin "classify" "tools/fixtures/fascia_health_live_control.md"]).out
assert live_ctl == "live" else "the live control must classify as live"

# The dated control carries a stamp and no living header — dated testimony.
let dated_ctl = trim (run ["rishi/bin/rishi" "run" bin "classify" "tools/fixtures/20260731-150648_fascia_health_dated_control.md"]).out
assert dated_ctl == "dated" else "the dated control must classify as dated"

# A path with no dated stamp is always live surface.
let law = trim (run ["rishi/bin/rishi" "run" bin "classify" "context/specs/living-vs-dated.md"]).out
assert law == "live" else "a non-dated-named path must classify as live"

# The census carries the whole tally and the shared definition.
let cen = (run ["rishi/bin/rishi" "run" bin "census"]).out
assert cen contains "tracked_total=" else "census must report tracked_total"
assert cen contains "dated_testimony=" else "census must report dated_testimony"
assert cen contains "live_surface=" else "census must report live_surface"
assert cen contains "fascia_health=" else "census must report fascia_health"
assert cen contains "definition=living-vs-dated" else "census must name the shared definition"
assert cen contains "verdict=ok" else "census must close with verdict=ok"

say "GREEN: Rishi dated_classify — controls classify by the canon, census is whole and named, no python on the path."
