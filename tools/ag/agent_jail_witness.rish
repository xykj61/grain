# agent_jail_witness.rish -- prove tools/ag/agent-jail.sh on Linux (keeper pier).
#
#   rishi/bin/rishi run tools/ag/agent_jail_witness.rish
#
# Or without Rishi built yet:
#   ./tools/ag/agent_jail_witness.sh
#
# Run from an ordinary host shell at the repository root.

# BASE ONLY, since 20260906.010500 (REDS %455). The four legs that LAUNCH the jail live in
# tools/ag/agent_jail_enclosure_witness.rish, behind `capability jail_nesting`, because bwrap
# refuses to nest and a ship inside the enclosure could never run them -- which turned this whole
# guard red on eight of eight ships, withholding every roster receipt and costing each a full cold
# pass every lap. Everything here reads plans, paths and seeded files and runs anywhere.
let result = run ["sh" "-c" "AGENT_JAIL_PART=base bash tools/ag/agent_jail_witness.sh"]
say "agent_jail_witness: ok=${result.ok}"
assert result.ok else "agent-jail witness RED -- see tools/ag/agent_jail_witness.sh output"
say "GREEN: agent-jail witness -- the plans, paths and seeded files the launcher promises"

# REFUSAL LEG (REDS %827). The launcher refuses an unknown option while it parses its arguments,
# before any jail or bwrap starts, so a planted flag proves the refusal with no side effect. The
# exit code is the refusal: the plant is the flag, and code 2 is the launcher answering it.
let refused = run ["sh" "tools/ag/agent-jail.sh" "--no-such-arg-plant"]
assert refused.code == 2 else "agent-jail witness: an unknown launcher option was admitted instead of refused"
say "GREEN: agent-jail refusal -- an unknown option is refused with exit 2 before any jail starts"
