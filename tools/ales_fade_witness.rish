# tools/ales_fade_witness.rish — a fade envelope: gain that ramps across a span (ALES4).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES4.
# Design read: active-designing/20260814-fill-ales4-lotus-fade-envelope.md
# Stands on: lotus/timeline.rye (ALES2) — the Clip it fades and the saturation it reuses (timeline.saturate).
#
# lotus/fade.rye scales a span by a fraction that ramps linearly from a start level to an end level — the fade-in and
# fade-out every editor owes, so a clip opens from and closes to silence without a click. The selftest proves: a fade-in
# ramps 0 → full with exact endpoints and a linear middle; a fade-out mirrors it; a ramp past unity SATURATES rather than
# wraps; a sub-span fade leaves the rest untouched; a single-sample fade takes the end level; a zero denominator refuses
# BadGain; an out-of-range span refuses BadRange leaving the clip untouched. Purely local — no network, no keys, no funds,
# no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_fade_witness.rish

say "ales-fade: Language EN — ALES4 ramps a gain across a span: the fade-in and fade-out that open a clip from and close it to silence without a click."
say "ales-fade: Style Radiant — a gain whose fraction moves; endpoints land exactly on the start and end levels, and the ramp saturates rather than wraps, reused from ALES2."
say "ales-fade: Lens TAME — bounded Clip, u32 span, i16 samples, the linear step and the scale both in i64 before the clamp; the fade checks its range at the edge and refuses by name; siloed to lotus/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/fade"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/fade.rye -femit-bin=${bin}"]
assert build.ok else "ales-fade: build failed — ${build.err}"

let outfile = "lotus/bin/fade.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-fade: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-fade: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-fade' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-fade: selftest did not print the GREEN ales-fade line"

say "ales-fade: GREEN — a fade envelope ramps a gain across a span with exact endpoints, saturating past unity; ALES3's mix then sums faded tracks into a crossfade. The next Lotus rung can clock the timeline to a real sample rate or open a track table."
