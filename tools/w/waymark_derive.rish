# waymark_derive.rish -- derive a ladder's waymark: a four-letter word drawn
# deterministically from the naming-grade flw corpus fixture by hashing
# the ladder's own canonical name, so two ladders never have to coordinate
# to avoid picking the same short code. This is the exact failure that
# collided the Genode/seL4 proven-seat ladder's G0 with the GrapheneOS/
# Pixel ladder's G0 -- both independently reached for "G," the obvious
# first letter of each ladder's own teacher name (Genode, GrapheneOS).
#
#   rishi/bin/rishi run tools/w/waymark_derive.rish
#
# What3words-inspired in spirit only -- no what3words code, word list, or
# algorithm is copied; only the idea (a stable function from a name to a
# word, so no two independent namers ever have to coordinate to stay
# unique). Corpus pin: tools/fixtures/flw-four-letter.txt -- whole-file twin
# of elder old/doc/spec/flw.txt with an attribution header (Option C,
# counsel 20260724.150246 ruling). Header lines stay above
# "# body unmodified below"; extract skips them. Full design:
# context/specs/20260716-115927_waymark-ladder-naming-and-g0-collision-fix.md
#
# Naming-grade pins (fail loudly if the corpus drifts):
#   extracted sorted-unique count == 5526
#   SHA3-512(extracted corpus) == corpus_digest below
#
# Hashes with SHA3-512 (this tree's own Keccak via tools/fixtures/sha3.sh, ratified
# host oracle for the family -- context/specs/20260703-191112_resins-and-
# hash-tiers.md), never plain SHA-2/sha256sum: a waymark is a naming-grade,
# durable identity ("this name must mean one thing for as long as the work
# endures," the same promise that spec names for Aurora stage names), so it
# belongs at the Canonical tier (SHA3-512), not the Working tier (SHA3-256)
# reserved for high-volume store units like cellar resins.
#
# To derive a mark for a NEW ladder: change input_name below to that
# ladder's own canonical, stable, descriptive name (lowercase, hyphenated),
# rerun, and read the printed word. If the closing assert goes RED (the
# draw landed on an already-seated name), append "-2" to input_name and
# rerun -- a different hash, a different draw, same honest method.
#
# Agent rule: .cursor/rules/waymark-ladders.mdc - .claude/rules/waymark-ladders.md
# -- draw before numbering any new ladder.
# Sameness witness: tools/w/waymark_derive_witness.rish

let mk_cache = run ["mkdir" "-p" "tools/.cache/waymark"]
assert mk_cache.ok else "could not create tools/.cache/waymark/"

# Pinned extract digest -- Canonical tier SHA3-512 of sorted-unique [A-Z]{4} lines.
# Spec: context/specs/20260716-115927_waymark-ladder-naming-and-g0-collision-fix.md
let corpus_digest = "615dbeb79c631115505ba71713aabdae243dcf4c1ae77109f325583a2c0e282cf6fc009d54802a268f04e3c170f705f4bd7203e018f00f5c443ae5e79808d8cc"
let corpus_count_pin = "5526"
let fixture_path = "tools/fixtures/flw-four-letter.txt"
let corpus_path = "tools/.cache/waymark/corpus.txt"

let corpus_run = run ["sh" "tools/fixtures/waymark_corpus_extract.sh" "${fixture_path}" "${corpus_path}"]
assert corpus_run.ok else "could not read/derive the flw-four-letter fixture corpus"

let count_run = run ["sh" "-c" "wc -l < ${corpus_path}"]
assert count_run.ok else "could not count the corpus"
let corpus_size = trim count_run.out
assert corpus_size == corpus_count_pin else "corpus count drifted from naming-grade pin 5526"

# SHA3-512 from this tree's own Keccak (crypto/sha3_digest.rye over crypto/sha3.rye, clean-room
# from FIPS 202) rather than from an openssl the host may or may not carry. The elder shape hunted
# openssl across PATH, the system profile, and the nix store, which is not a dependency anyone
# chose -- it is one that happened. The ALGORITHM is unchanged, so every seated draw is unchanged,
# and tools/w/waymark_registry_witness.rish re-derives all thirty-one marks, so a drift of one digit
# reds on the lap it enters. An empty digest still must never masquerade as corpus drift; the shim
# refuses a short or non-hex answer rather than passing it along.
let sha3 = "tools/fixtures/sha3.sh"
say "sha3-512 oracle: ${sha3} (this tree's own Keccak)"

let digest_run = run ["sh" "-c" "sh ${sha3} 512 ${corpus_path}"]
assert digest_run.ok else "sha3-512 of the corpus failed"
let digest_val = trim digest_run.out
assert digest_val == corpus_digest else "corpus SHA3-512 drifted from naming-grade pin -- fixture body or extract changed"

say "corpus: ${corpus_size} four-letter words from ${fixture_path}"
say "corpus sha3-512: ${digest_val}"

# The ladder needing a mark today. Change this one line to derive the next.
# Seated draws (do not reuse input strings; do not redraw):
#   grapheneos-pixel-mobile-emulation -> HAWM
#   glow-application-framework-and-publishing -> TUBE
#   glow-english-qwerty-glass-keyboard-3 -> ZETA (20260717.180025)
#   sala-broadcast-live-session-fold -> JABS (20260717.191030)
#   glow-glass-hearth-display-and-wired-sync -> LULU (20260718.122145)
#   glow-language-rune-heads-nest-and-lowering -> MAIR (20260718.202414; superseded same day)
#   glow-language-rune-heads-nest-and-lowering-2 -> STOA (20260718.202730)
#   source-identity-breach-onboarding-refresh -> QUIZ (abandoned redraw - not seated)
#   slh-dsa-hash-based-signature-ladder -> DISC (seated 20260821 - Season G SLH-DSA ladder)
#   source-identity-breach-onboarding-refresh-2 -> COIF (abandoned - Keaton chose SUNN)
#   source-pier-papers-identity-refresh -> SUNN (20260730.143736 - Keaton's word)
#   (input debrided 20260825) -> POLE (20260730.150702 - exec hats; hand-seated)
#   glow-language-runes-stdlib-and-pipeline -> SOON (20260809.021829 - Compass Eq1 The Language)
#   kumara-identity-comlink-and-fractal-network -> JARL (20260809.021829 - Compass Eq2 Identity & Network)
#   realidream-surface-and-quin-inference-and-mcp-2 -> BUHR (20260809.021829 - Compass Eq3 Surface & Intelligence; -2 redraw, first was DOCS)
#   ship-pilot-publishing-grainphone-and-commerce -> TACT (20260809.021829 - Compass Eq4 The World)
#   harvest-season-equinox-1-yield -> GISM (20260810.222755 - Harvest Eq1 Yield)
#   harvest-season-equinox-2-trade -> AYRE (20260810.222755 - Harvest Eq2 Trade)
#   harvest-season-equinox-3-commons -> DAHL (20260810.222755 - Harvest Eq3 Commons)
#   harvest-season-equinox-4-rest -> KOFF (20260810.222755 - Harvest Eq4 Rest)
#   meta-season-chronological-labeling-molt -> CION (20260810.222755 - CION meta-season)
#   cion-meta-season-equinox-1-survey -> VOLS (20260810.225345 - CION Eq1 Survey)
#   cion-meta-season-equinox-3-debride -> OFFY (20260810.225345 - CION Eq3 Debride)
#   cion-meta-season-equinox-4-seal -> GRAD (20260810.225345 - CION Eq4 Seal)
#   season-a-open-image-decode-and-photos-surface -> HUNK (20260813 - Season A Hardware/Right-to-Repair, open image + Photos)
#   season-c-lotus-creative-suite-audio-wire-shape -> ALES (20260814 - Season C Lotus creative suite, the basic audio wire shape)
#   season-a-mikrophone-forgetful-capture -> DREY (20260817 - Season A, Mikrophone firmware, memory-that-forgets)
#   constel-local-test-constellations -> FORA (20260817 - Constel fake-pier test-network naming, siloed dev constellations)
#   dimeroll-hr-and-accounting-entities -> WADE (20260817 - Bit-Design surface + Dimeroll entities season, idx 5141)
#   cion-molt-living-mutants-and-fossils -> LOWE (20260817 - CION Eq2 Molt, idx 2813)
# SETU is hand-seated (not a corpus draw -- SETU is absent from flw); exclude only.
# SEVA is hand-seated (viewer; absent from flw).
# MAND is the seated M vane (in flw corpus; exclude so it never draws as a waymark).
# MONA is the same-day prior name of Mand -- exclude for one season.
# SALA dropped from exclude at alias retirement 20260724.202412 (Sala is historical).
# SURF is the seated social-network module name from 20260823.094410 (in flw corpus; exclude
# so it never draws as a waymark). It replaced Skate, which was never in the corpus.
# Placeholder below is the most recent seat; change it when drawing the next.
# Most recent seats (breach molt debride replacements 20260817):
#   input_name rests on WADE's below.
let input_name = "slh-dsa-hash-based-signature-ladder"

let hash_run = run ["sh" "-c" "printf '%s' '${input_name}' | sh ${sha3} 512 - | cut -c1-8"]
assert hash_run.ok else "sha3-512 of the ladder name failed"
let hash8 = trim hash_run.out

let dec_run = run ["sh" "-c" "printf '%d' 0x${hash8}"]
assert dec_run.ok else "hex-to-decimal conversion failed"
let dec_val = trim dec_run.out

let idx_run = run ["sh" "-c" "echo $((${dec_val} % ${corpus_size} + 1))"]
assert idx_run.ok else "index arithmetic failed"
let idx_val = trim idx_run.out

let word_run = run ["sh" "-c" "awk -v n='${idx_val}' 'NR==n' '${corpus_path}'"]
assert word_run.ok else "word lookup failed"
let word_val = trim word_run.out
assert (word_val != "") else "empty word at derived index -- corpus or index math is wrong"

# invariant: a waymark is exactly four uppercase letters. The corpus is [A-Z]{4}
# by extract, yet assert the shape at the draw so a drifted fixture or a stray
# non-four-letter exclude entry can never seat a mis-shaped mark (this caught a
# 3-letter MUR that had sat in the exclude below -- corrected to MURR).
let shape_check = run ["sh" "-c" "printf '%s' '${word_val}' | grep -qxE '[A-Z]{4}'"]
assert shape_check.ok else "derived waymark '${word_val}' is not exactly four uppercase letters -- corpus or extract drifted"

# Existing proper names this scheme must never echo (four-letter Lexicon
# identities + seated waymarks). Seated waymarks also live in
# .cursor/rules/waymark-ladders.mdc -- if the word matches, append -2 and redraw.
let exclude_check = run ["sh" "-c" "echo '${word_val}' | grep -qxE '(BRIX|BRON|POND|MURR|SURF|MALA|SEVA|MAND|MONA|POOL|QUIN|RIYO|REYA|TREY|TERA|TRIZ|OJJO|GLOW|RHYZ|PEAL|HAWM|TUBE|ZETA|JABS|LULU|SETU|MAIR|STOA|SUNN|POLE|SOON|JARL|BUHR|TACT|GISM|AYRE|DAHL|KOFF|CION|VOLS|OFFY|GRAD|BOZO|LINN|AHOY|HUNK|ALES|DREY|FORA|LOWE|WADE|DISC)'"]
assert (exclude_check.ok == false) else "derived waymark collides with an already-seated name -- append -2 to input_name above and rerun"

say ""
say "input:  ${input_name}"
say "sha3-512(8): ${hash8} -> decimal ${dec_val} -> index ${idx_val} of ${corpus_size}"
say "GREEN: waymark derived -- ${word_val}"
