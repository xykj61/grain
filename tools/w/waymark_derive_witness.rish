# waymark_derive_witness.rish -- naming-grade sameness across the flw fixture pin.
#
# Asserts corpus count + SHA3-512 pins, re-derives every corpus-drawn seated
# waymark (HAWM - TUBE - ZETA - JABS - LULU - STOA - SUNN), and confirms POLE - SETU - SEVA -
# MAND - MONA on the exclude list. SALA is historical (dropped from exclude).
#
#   rishi/bin/rishi run tools/w/waymark_derive_witness.rish

let corpus_digest = "615dbeb79c631115505ba71713aabdae243dcf4c1ae77109f325583a2c0e282cf6fc009d54802a268f04e3c170f705f4bd7203e018f00f5c443ae5e79808d8cc"
let corpus_count_pin = "5526"
let fixture_path = "tools/fixtures/flw-four-letter.txt"
let corpus_path = "tools/.cache/waymark/witness_corpus.txt"

let mk_cache = run ["mkdir" "-p" "tools/.cache/waymark"]
assert mk_cache.ok else "could not create tools/.cache/waymark/"

let marker = run ["sh" "-c" "grep -qx '# body unmodified below' ${fixture_path}"]
assert marker.ok else "fixture missing '# body unmodified below' marker"

let corpus_run = run ["sh" "tools/fixtures/waymark_corpus_extract.sh" "${fixture_path}" "${corpus_path}"]
assert corpus_run.ok else "fixture corpus extract failed"

let count_run = run ["sh" "-c" "wc -l < ${corpus_path}"]
assert count_run.ok else "corpus count failed"
let corpus_size = trim count_run.out
assert corpus_size == corpus_count_pin else "corpus count pin failed"

# SHA3-512 comes from this tree's own Keccak now (tools/fixtures/sha3.sh); no host oracle is
# hunted for. The seated-draws fixture below carries the same change, and the registry witness
# re-derives every mark, so the draws are proven rather than assumed unchanged.
let digest_run = run ["sh" "-c" "sh tools/fixtures/sha3.sh 512 ${corpus_path}"]
assert digest_run.ok else "corpus digest failed"
assert (trim digest_run.out) == corpus_digest else "corpus digest pin failed"

let twin_run = run ["sh" "tools/fixtures/waymark_fixture_twin.sh" "${fixture_path}"]
assert twin_run.ok else "fixture body does not match elder old/doc/spec/flw.txt byte-for-byte"

let setu_in_corpus = run ["sh" "-c" "grep -qx SETU ${corpus_path}"]
assert (setu_in_corpus.ok == false) else "SETU unexpectedly present in flw corpus"
let seva_in_corpus = run ["sh" "-c" "grep -qx SEVA ${corpus_path}"]
assert (seva_in_corpus.ok == false) else "SEVA unexpectedly present in flw corpus"
# MAND and MONA appear in the flw corpus -- exclude membership is the seat.
let mand_in_corpus = run ["sh" "-c" "grep -qx MAND ${corpus_path}"]
assert mand_in_corpus.ok else "MAND must be present in flw corpus"
let mona_in_corpus = run ["sh" "-c" "grep -qx MONA ${corpus_path}"]
assert mona_in_corpus.ok else "MONA must be present in flw corpus"

let exclude_src = read-file "tools/w/waymark_derive.rish"
assert (exclude_src contains "SETU") else "waymark_derive exclude list missing SETU"
assert (exclude_src contains "SEVA") else "waymark_derive exclude list missing SEVA"
assert (exclude_src contains "MAND") else "waymark_derive exclude list missing MAND"
assert (exclude_src contains "MONA") else "waymark_derive exclude list missing MONA (retired-name season)"
# SALA must not remain on the exclude regex after alias retirement.
let exclude_line = run ["sh" "-c" "grep qxE tools/w/waymark_derive.rish"]
assert exclude_line.ok else "exclude regex line missing"
assert (exclude_line.out contains "MAND") else "exclude regex missing MAND"
let sala_still = run ["sh" "-c" "grep qxE tools/w/waymark_derive.rish | grep -q SALA"]
assert (sala_still.ok == false) else "SALA must be dropped from exclude regex after alias retirement"
assert (exclude_src contains "tools/fixtures/flw-four-letter.txt") else "waymark_derive not pointed at fixture"
assert (exclude_src contains "${corpus_digest}") else "waymark_derive missing corpus digest pin"

let draw_run = run ["sh" "tools/fixtures/waymark_seated_draws.sh" "${corpus_path}"]
assert draw_run.ok else "seated waymark re-derive failed"
assert draw_run.out contains "HAWM" else "HAWM missing"
assert draw_run.out contains "TUBE" else "TUBE missing"
assert draw_run.out contains "ZETA" else "ZETA missing"
assert draw_run.out contains "JABS" else "JABS missing"
assert draw_run.out contains "LULU" else "LULU missing"
assert draw_run.out contains "STOA" else "STOA missing"
assert draw_run.out contains "SUNN" else "SUNN missing"
let pole_hand = run ["sh" "-c" "grep -c 'mark POLE .* status hand-seated' construction/waymark-registry.bron"]
assert pole_hand.ok else "POLE hand-seated row scan failed"
let pole_hand_n = trim pole_hand.out
assert pole_hand_n == "1" else "POLE must stand hand-seated in the registry (input debrided 20260825)"
assert (exclude_line.out contains "SUNN") else "exclude regex missing SUNN"
assert (exclude_line.out contains "POLE") else "exclude regex missing POLE"
assert (exclude_line.out contains "BOZO") else "exclude regex missing BOZO"

say "GREEN: waymark derive witness — corpus pins · body twin · seven seated draws - POLE hand-seated by debride · SETU·SEVA·MAND·MONA exclude · SALA retired"
