# tools/w/wayland_study_ledger_witness.rish — accrete shim → tools/gen/season/wayland_study_ledger_witness.rish (Surface p4)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/wayland_study_ledger_witness.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/season/wayland_study_ledger_witness.rish" args[0]]
if r.out != "" then say r.out
exit r.code
