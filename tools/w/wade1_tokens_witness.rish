# wade1_tokens_witness.rish -- WADE1 token sheet: cascade by infuse, lowered to Skate.
#
# Proves brushstroke/tokens.rye -- the `.brush` surface-bridge seam's durable core
# (active-designing/date/20260812/20260812-000456_wade1-brush-surface-bridge-seam.md):
#   (a) infuse resolves a child sheet whose tokens honor the six weave invariants
#       (warm hue, low blue, gentle lightness spread, paper hierarchy);
#   (b) base-only tokens are kept, override tokens win, new tokens append;
#   (c) a resolved sheet dresses/lowers into a renderable Skate grid.
# The cascade reuses brix/infuse.rye's proven per-key override -- no fresh engine.
#
# Build first:  rye build brushstroke/tokens.rye -femit-bin=tools/.build/brushstroke_tokens
#   rishi/bin/rishi run tools/w/wade1_tokens_witness.rish

let zig = "/home/keeper/grain/vendor/zig-toolchain/zig"
let build = run ["sh" "-c" "mkdir -p tools/.build && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/tokens.rye -femit-bin=tools/.build/brushstroke_tokens"]
assert build.ok else "brushstroke tokens build failed"

let st = run ["tools/.build/brushstroke_tokens" "selftest"]
assert st.ok else "brushstroke tokens selftest exited non-zero"
assert (st.err contains "GREEN") else "brushstroke tokens selftest not GREEN"
assert (st.err contains "warm-hue") else "brushstroke tokens missing the palette-invariant claim"
assert (st.err contains "per-key infuse") else "brushstroke tokens missing the cascade-by-infuse claim"
assert (st.err contains "dresses a Skate grid") else "brushstroke tokens missing the lowering claim"

say "GREEN: WADE1 tokens — a cascading token sheet by infuse, tokens honoring the six weave invariants, lowered into the Skate grid."
