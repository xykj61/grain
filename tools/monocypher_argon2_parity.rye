//! tools/monocypher_argon2_parity.rye — our authored crypto/argon2.rye asked for its OWN Argon2 derived key over RFC 9106's primary p=4
//! vector, printed one hex line per mode (Argon2d, Argon2i, Argon2id), so tools/crypto_monocypher_argon2_parity_witness.rish can diff our
//! bytes against the vendored Monocypher's C (tools/fixtures/monocypher_argon2_harness.c) byte-for-byte — the memory-hard password KDF Vault's
//! seal rests on, proven against the audit's parity target. Season G (Cryptography · Rye-native, Monocypher-parity, audit-ready) — the fifth
//! Monocypher-SOURCE parity rung, extending the four the decision wave named to Argon2, the primitive Monocypher itself implements.
//!
//! The three printed lines are, in order: the Argon2d, Argon2i, and Argon2id derived keys (32 bytes → 64 hex characters each) — the same three
//! lines the Monocypher C harness prints, over identical inputs, so the parity witness compares like against like. RFC 9106's primary vector:
//! password 0x01*32, salt 0x02*16, secret 0x03*8, ad 0x04*12, t=3 passes, m=32 blocks, p=4 lanes.
//!
//! This authors NO cryptography — it is a printing harness over the GREEN crypto/argon2.rye (reached through the tools/argon2.rye and
//! tools/blake2b.rye symlinks, since Rye resolves imports beside the importing file). Purely local — RFC 9106's public TEST inputs, no real
//! password, no identity key, no network, no funds, no device.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run tools/monocypher_argon2_parity.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const argon2 = @import("argon2.rye");

/// RFC 9106 primary vector inputs, shared by all three modes.
const rfc_password = [_]u8{0x01} ** 32;
const rfc_salt = [_]u8{0x02} ** 16;
const rfc_secret = [_]u8{0x03} ** 8;
const rfc_ad = [_]u8{0x04} ** 12;

const hex_alphabet = "0123456789abcdef";

/// print_hex — render a byte slice as a line of lowercase hex, two characters per byte. Bounded by a named ceiling on the slice length.
const max_hex_bytes: u32 = 64;
fn print_hex(bytes: []const u8) void {
    // invariant: the slice fits the hex ceiling, so each byte renders to exactly two characters within a bounded line.
    assert(bytes.len <= max_hex_bytes);
    var out: [max_hex_bytes * 2]u8 = undefined;
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_alphabet[bytes[i] >> 4];
        out[i * 2 + 1] = hex_alphabet[bytes[i] & 0x0f];
    }
    // invariant (postcondition): exactly two hex characters were written per byte — a full rendering, never a truncation.
    const n: u32 = @as(u32, @intCast(bytes.len)) * 2;
    print("{s}\n", .{out[0..n]});
}

/// derive_one — one Argon2 derived key over the RFC 9106 primary vector, for the given mode, printed as a hex line.
fn derive_one(garden: std.mem.Allocator, mode: argon2.Mode) !void {
    var dk: [32]u8 = undefined;
    // invariant (construction): the RFC's costs sit inside argon2's bounds — a real derivation, refused only if malformed.
    try argon2.kdf(garden, &dk, &rfc_password, &rfc_salt, .{ .t = 3, .m = 32, .p = 4, .secret = &rfc_secret, .ad = &rfc_ad }, mode);
    print_hex(&dk);
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();

    // invariant (construction): the inputs are the RFC's fixed widths, so both harnesses fold the identical pre-image.
    assert(rfc_password.len == 32 and rfc_salt.len == 16 and rfc_secret.len == 8 and rfc_ad.len == 12);

    // Three lines: Argon2d, Argon2i, Argon2id — the same three primary known-answers the Monocypher harness prints.
    try derive_one(garden, .argon2d);
    try derive_one(garden, .argon2i);
    try derive_one(garden, .argon2id);

    return 0;
}
