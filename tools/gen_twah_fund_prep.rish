# tools/gen_twah_fund_prep.rish — Constellation m5–m7+: Twah fund prep generator.
#
# Affirms Taurus earth seat, edu steps 1–5 witnessed (phone book · Comlink),
# refuses deploy / claim-domain / wallet verbs.
#   rishi/bin/rishi run tools/gen_twah_fund_prep.rish
#   rishi/bin/rishi run tools/gen_twah_fund_prep.rish deploy  # RED

say "gen-twah: Language EN — Twah fund prep (Taurus earth · edu gift · steps 1–5)."
say "gen-twah: Style Radiant — GREEN only after Comlink opens and steps 1–5 witness."
say "gen-twah: Lens TAME — prep only; no wallet, gas, domain claim, or live deploy."

let verb = ""
if length args != 0 then let verb = args[0]

let prep = run ["sh" "tools/fixtures/gen_twah_fund_prep.sh" verb]
assert prep.ok else "gen-twah REFUSE or stack door failed — see stderr for deploy/wallet/gas/claim-domain refusals"
assert prep.out contains "GREEN: gen-twah" else "gen-twah prep helper missing GREEN line"
assert prep.out contains "sign_index=1" else "gen-twah Taurus seat index unnamed"
assert prep.out contains "witness:step1 GREEN" else "gen-twah step1 witness missing"
assert prep.out contains "witness:step2 GREEN" else "gen-twah step2 witness missing"
assert prep.out contains "witness:step3 GREEN" else "gen-twah step3 witness missing"
assert prep.out contains "witness:step4 GREEN" else "gen-twah step4 witness missing"
assert prep.out contains "witness:step5 GREEN" else "gen-twah step5 witness missing"
say prep.out

say "GREEN: gen-twah m7 — steps 1–5 witnessed; phone book + Comlink knock GREEN; deploy RED by name."
