# tools/font5x7_fraction_witness.rish -- the open vulgar-fractions corpus proves itself on metal (Season G, font content).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora (the box, arrow, block, geometric, math, and currency witnesses), the Greek
# letters, and the two digit twins from either side of the line -- the subscript digits (small and low) and the
# superscript digits (small and high). This corpus is where those two twins meet in one body.
#
# The crux this witness proves is a REAL, OPEN, hand-drawn vulgar-fractions corpus: the nine common fractions a price
# tag and a recipe print -- one quarter, one half, three quarters, one third, two thirds, and the four eighths (one,
# three, five, seven) -- at their real Unicode codepoints U+00BC..U+00BE (the Latin-1 vulgar fractions) and U+2153,
# U+2154, U+215B..U+215E (the Number Forms), each a 5x7 coverage grid drawn in the open as ASCII line art in
# image/font5x7_fraction.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint,
# advance, and coverage byte byte-for-byte; all nine fractions look up present and carry the shared advance while a
# full-height ASCII digit misses; no two fractions share coverage; each reads within an honest legibility band; each
# carries its THREE PARTS (a numerator high on the left, a solidus down the middle, a denominator low on the right --
# the composition-in-one-cell that sets a fraction apart from a plain digit); the codepoint table is non-contiguous
# (the Latin-1 gap before the Number Forms); and the family order holds -- three quarters out-inks one quarter, seven
# eighths out-inks one eighth. Compression is reported as a fact, never asserted -- the round-trip is the proof. No
# network, no key, no funds -- the fractions a surface prints the day it names half a price, on our own open font.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_fraction_witness.rish

say "font5x7-fraction: Language EN -- Season G font content; the nine common vulgar fractions (quarters, halves, thirds, eighths) drawn in the open as 5x7 ASCII line art, built into the gfa1 atlas, the fractions a surface prints the day it shows a price (1/2 off) or a measure (3/4 lb); where the subscript twin sits low and the superscript twin high, a fraction carries both at once around a solidus."
say "font5x7-fraction: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every fraction byte for byte; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-fraction: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - fraction_count - the atlas ceilings it rests on); each function states its invariants positively; the codepoints are carried as an explicit ascending table (the run is genuinely non-contiguous) and proven strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_fraction"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_fraction.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-fraction: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-fraction: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-fraction: ${out}"

assert selftest.out contains "GREEN image-font5x7-fraction" else "font5x7-fraction: selftest did not print the GREEN corpus line"

assert selftest.out contains "round-trip byte-identical" else "font5x7-fraction: round-trip was not byte-identical"

assert selftest.out contains "three-part (numerator + solidus + denominator)" else "font5x7-fraction: fractions were not proven three-part"

say "font5x7-fraction: GREEN -- the open vulgar-fractions corpus whole; nine fractions round-trip byte-identical, all present, distinct, legible, and three-part (numerator, solidus, denominator), their codepoint table non-contiguous, three quarters out-inking one quarter and seven eighths one eighth; the font gains the fractions a surface prints the day it names half a price."
