# caravan_fence_witness.rish -- Caravan fence witness.
#
# `phases.rye` let an author cut a turn into phases and made the cut safe:
# each phase names its turn, and phases of one turn keep the order they were
# written in, absolutely. That order is TOTAL, which is stronger than most
# turns need -- a turn whose middle phases are genuinely independent pays
# for an order it never asked for.
#
#   A PHASE FOLLOWS A PREFIX OF ITS TURN, AND A PREFIX IS ONE NUMBER.
#
# The honest refinement looks like a graph, and a graph is what a queue may
# not grow: a supervisor that walks edges and closes them transitively to
# admit one dependent is a different machine from the one this arc built. A
# PREFIX is the shape that fits. A phase names one number -- how many
# leading phases of its own turn it follows. `after = step` is the link
# exactly, `after = 0` frees a phase of its siblings, and anything between
# is the author naming where the seam really is. The relation is
# transitively closed BY CONSTRUCTION, so nothing is walked: a prefix
# already holds every prefix inside it.
#
# THE FENCE STANDS BETWEEN THE TWO READINGS ALREADY MEASURED:
#
#   * Over the FENCED LAP, whose last turn peeks `menu` under a fence of
#     zero and `back_b` under a fence of two, the fence takes 1 pass where
#     the link takes 0 and reading acts alone takes 2. It runs 1 phase past
#     its turn where the link runs 0 -- lawfully, because the author wrote
#     that freedom down -- and breaks 0 fences where reading acts alone
#     breaks 1.
#   * Slots unspent read 7 by act, 8 fenced, 10 linked: the fence sits
#     exactly between, which is the whole claim in one number.
#   * The ISOLATION half needed nothing here either, for the reason
#     `phases.rye` gave: two phases of one turn share a domain, and
#     `commute.admissible` already refuses to stand a domain beside itself.
#
# A FENCE AT ITS OWN STEP IS THE LINK, EXACTLY -- proven pair by pair over
# the whole lap, so the elder reading is a fence rather than a rival to it.
#
# Both RED paths were proven on metal before this witness claimed GREEN.
# Drop the fence from `items_contend` and the fence read straight reds at a
# phase inside a named prefix being free to pass it. Keep the fence and hide
# it from the choosing alone, and the fenced run's own `fill_table`
# invariant fires on metal -- so the assert that says a fenced reading never
# runs a phase past the prefix it named is load-bearing rather than
# decorative.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_fence_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/fence"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/fence.rye -femit-bin=${bin}"]

assert build.ok else "caravan fence build failed"

# Nothing new is declared: the fence rides on the queue, where authorship
# belongs, rather than in the document, where a ceiling belongs.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan fence selftest exited non-zero"
assert test.out contains "GREEN" else "caravan fence selftest not GREEN"
assert test.out contains "a phase follows a prefix of its turn, and a prefix is one number" else "the fence finding did not close"

# The fence read straight, before any supervisor spends it.
assert test.out contains "a fence at its own step is the link exactly, and a fence of zero frees a phase" else "the fence did not answer the link it generalizes"

# The fenced lap: the fence stands between the two readings already measured.
assert test.out contains "the fenced lap runs 2 phases past their turn by act, 1 fenced, 0 linked" else "the fence did not buy back the phase the link was holding"
assert test.out contains "the fence is broken 1 times by act and 0 fenced" else "the fence did not keep the prefix its author wrote"
assert test.out contains "passes: 2 by act, 1 fenced, 0 linked" else "the fence did not stand between the two readings"
assert test.out contains "slots unspent: 7 by act, 8 fenced, 10 linked" else "the fence did not spend what it freed"
assert test.out contains "6 dependents run to the same end under all three" else "the three readings did not run the same lap to the same end"

say "GREEN: Caravan fence witness passed."
