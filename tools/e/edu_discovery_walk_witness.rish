# tools/e/edu_discovery_walk_witness.rish — door 13 edu discovery walk
#
# Re-runs the learner walk (discovery quartet + myc fold) and asserts
# each GREEN line. Invents no wire pier · no sixth primitive.
#
#   rishi/bin/rishi run tools/e/edu_discovery_walk_witness.rish

let zig = "vendor/zig-toolchain/zig"
let page = run ["test" "-f" "edu/discovery/round-trip-walk.md"]
assert page.ok else "edu walk page missing"

# Avoid $N inside sh -c (rish expands $digits). Use env + rye args as a list.
let d = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run comlink/discovery/descriptor_test.rye 2>&1"]
assert d.ok else "descriptor step failed"
assert d.out contains "GREEN: discovery descriptor" else "descriptor missing GREEN"

let t = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run comlink/discovery/table.rye 2>&1"]
assert t.ok else "table step failed"
assert t.out contains "GREEN: discovery table" else "table missing GREEN"

let g = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run comlink/discovery/gossip.rye 2>&1"]
assert g.ok else "gossip step failed"
assert g.out contains "GREEN: discovery gossip" else "gossip missing GREEN"

let i = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run comlink/discovery/introduce.rye 2>&1"]
assert i.ok else "introduce step failed"
assert i.out contains "GREEN: discovery introduce" else "introduce missing GREEN"
assert i.out contains "negative space" else "introduce missing negative-space signal"

let f = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/fold.rye 2>&1"]
assert f.ok else "fold step failed"
assert f.out contains "GREEN: myc fold" else "fold missing GREEN"

let honesty = run ["sh" "-c" "grep -c 'wire both-sides' edu/discovery/round-trip-walk.md"]
assert honesty.ok else "honesty grep failed"
assert trim honesty.out != "0" else "page must name that wire both-sides is not claimed"

say "GREEN: edu discovery walk — five steps · quartet + fold · no wire pier claimed"
