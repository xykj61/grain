# tools/e/edu_tower_frame_bite_witness.rish -- e15 tower frame-bound bite.
#
#   rishi/bin/rishi run tools/e/edu_tower_frame_bite_witness.rish

say "tower-frame-bite: Language EN — the bound bites where it must."
say "tower-frame-bite: Style Radiant — a fixture holds the violation."
say "tower-frame-bite: Lens TAME — e15 · negative space beside the welcome tower."

let fixture = run ["test" "-f" "edu/tower/frame_bound_overpush.rye"]
assert fixture.ok else "tower-frame-bite: overpush fixture missing"

let bite = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run edu/tower/frame_bound_overpush.rye 2>&1; echo EXIT=$?"]
say bite.out
assert bite.out contains "EXIT=1" else "tower-frame-bite: overpush must exit 1"
assert bite.out contains "assertion failure" else "tower-frame-bite: want assert panic text"

let welcome = run ["sh" "-c" "env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run edu/tower/bounded_tower.rye 2>&1"]
assert welcome.ok else "tower-frame-bite: welcome tower went RED"
assert welcome.out contains "GREEN: bounded tower" else "tower-frame-bite: welcome missing GREEN"

let pin = run ["sh" "-c" "grep -q 'frame_bound_overpush.rye' docs-geode/tutorials/recursion-in-glow.md && echo PIN_OK"]
assert pin.ok else "tower-frame-bite: tutorial pin scan failed"
assert pin.out contains "PIN_OK" else "tower-frame-bite: tutorial must name the overpush fixture"

let almanac = run ["sh" "tools/gen/season/equinox_tower_bite_almanac.sh"]
assert almanac.ok else "tower-frame-bite: almanac append failed"
say almanac.out

say "GREEN: tower-frame-bite — overpush exits 1 · welcome GREEN · tutorial pinned · almanac seat 21"
