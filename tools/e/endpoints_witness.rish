# tools/e/endpoints_witness.rish -- the skeleton endpoint detector proves itself on metal (Season G).
#
# Season G (Open Media Primitives) -- the endpoint detector the hit-or-miss floor opens, the crux-first sibling
# image/skeleton.rye named. A skeleton reads a shape down to a one-pixel medial figure; this rung answers the first
# topological question of that figure -- WHERE does it end. An ENDPOINT is a foreground pixel of degree one (exactly one
# foreground neighbor), and it is exactly a hit-or-miss with an eight-template pack: an edge base and a diagonal base, each in
# four rotations, covering the eight single-neighbor directions, unioned by a per-channel max.
#
# The crux this witness proves on metal: a one-pixel vertical segment lights exactly its two tips and not its degree-two
# middle; a diagonal segment lights its two tips through the diagonal templates; a lone dot of degree ZERO lights NOTHING (an
# endpoint is degree exactly one, never zero); a one-pixel plus lights its four arm tips while its degree-four center stays
# dark; the output is opaque white-on-black even from a translucent source; the endpoint map round-trips through the open QOI
# codec byte-for-byte; an empty source refuses by name; the same detection is deterministic. No network, no key, no funds --
# the tips a surface names the day it reads a skeleton's topology, on our own open geometry.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/e/endpoints_witness.rish

say "endpoints: Language EN -- Season G endpoint detector; mark every skeleton endpoint of a mask (a foreground pixel of degree one) by unioning an eight-template hit-or-miss pack."
say "endpoints: Style Radiant -- compose not braid: this rung owns only the endpoint template geometry and the union loop (a per-channel max over the pack's match planes); hitmiss owns each template match, structure the fit gather, qoi the buffers."
say "endpoints: Lens TAME -- the binary meaning of a pixel is read from hitmiss (one source of truth); the source is guarded and refused by name up front so a refusal allocates nothing; the union seeds opaque black and stays opaque; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/endpoints"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/endpoints.rye -femit-bin=${bin}"]
assert build.ok else "endpoints: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "endpoints: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "endpoints: ${out}"

assert selftest.out contains "GREEN image-endpoints" else "endpoints: selftest did not print the GREEN line"

say "endpoints: GREEN -- a line lights exactly its two tips, a plus its four arm tips, a lone dot nothing (degree zero is not an endpoint), the eight-template hit-or-miss pack unioned to a clean endpoint map, on metal."
