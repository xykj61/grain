# tools/ales_rack_sheet_witness.rish — the rack travels as text, a slot sheet (ALES33).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES33.
# Design read: active-designing/20260814-150213_fill-ales33-lotus-rack-sheet.md
# Stands on: lotus/rack.rye (ALES30) — copy_to / name_of / paste reused whole; lotus/selection.rye (ALES23) — make; lotus/timeline.rye
# (ALES2) — splice; lotus/pan.rye (ALES10) — the StereoClip; tally/parse_int.rye — strict decimal. Mirrors lotus/cue_sheet.rye (ALES22).
#
# lotus/rack_sheet.rye renders a whole rack of named held spans to a format lotus-rack-sheet-v1 record and parses it back, so a
# keeper's rack persists across a session close and ports as plain text — the first ALES travels-as-text rung to carry real PCM. The
# crux: parse_rack(render_rack(r)) recovers every slot's name and both channels' samples byte-for-byte and render(parse(render(r))) is
# a fixed point, the render walking the slots in stored order (canonical i16 decimal, no leading zero) and the parse rebuilding each
# slot through ALES30's own rack.copy_to over a temporary master so every rack bound is enforced at the one place. The selftest proves:
# a two-slot rack renders to the exact expected text and round-trips both names and both channels; a name with a space round-trips
# whole; and every corruption refuses by name (BadRecord for a bad header / mis-ordered line / wrong tag / L-R mismatch / bad sample /
# zero-length slot, Duplicate for a repeated name, RackFull past the ceiling, Overflow into a too-small buffer). Purely local — no
# network, no keys, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_rack_sheet_witness.rish

say "ales-rack-sheet: Language EN — ALES33 lets a keeper's whole rack of named held spans (the count-in, the verse, the chorus, the clean bridge take) persist across a session close and travel between benches as a plain-text slot sheet, the same travels-as-text law the ALES22 cue sheet already proved, now carrying real stereo PCM."
say "ales-rack-sheet: Style Radiant — the law is stated positively: parse_rack(render_rack(r)) recovers every slot's name and both channels byte-for-byte and render(parse(render(r))) is a fixed point, the render canonical (i16 decimal, no leading zero) and the parse rebuilding each slot through ALES30's own copy_to so every rack bound is enforced at the one place."
say "ales-rack-sheet: Lens TAME — rack.copy_to / name_of / paste and parse_int reused whole (no new rack bound beyond the text grammar); each channel bounded by max_clip and each name by max_name; a slot rebuilt over a temporary master so BadName / Duplicate / RackFull forward by name, and a bad header / mis-ordered line / L-R mismatch / bad sample refuses BadRecord before the rack is trusted; siloed to lotus/, no network, no keys, no funds, no device, no meter, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/rack_sheet"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/rack_sheet.rye -femit-bin=${bin}"]
assert build.ok else "ales-rack-sheet: build failed — ${build.err}"

let outfile = "lotus/bin/rack_sheet.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-rack-sheet: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-rack-sheet: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-rack-sheet' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-rack-sheet: selftest did not print the GREEN ales-rack-sheet line"

say "ales-rack-sheet: GREEN — a keeper's whole rack persists across a session close and ports as plain text: render_rack writes each slot's name and both channels canonically, parse_rack recovers them byte-for-byte through ALES30's own copy_to, render(parse(render(r))) is a fixed point, a name with a space survives, and every corruption refuses by name. The next Lotus rung can give the slot sheet a Sha256 content digest (verify-before-trust, mirroring the ALES0 wire deframe), or carry a slot across the ALES0 audio wire (a module seam, taken on Keaton's word)."
