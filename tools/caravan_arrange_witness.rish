# caravan_arrange_witness.rish -- Caravan arrange witness.
#
# `precede.rye` let a turn name the turns it follows and closed those names
# once at the door. Every reading in the arc up to there -- act, linked,
# fenced, masked, preceded -- takes the queue's WRITTEN SEQUENCE as given and
# only ever loosens or tightens which pairs of it may be swapped.
#
#   A PLAN MAY BE WRITTEN IN ANY ORDER, AND THE QUEUE SEATS IT.
#
# The sequence is a claim, and a claim may be checked. A plan is SEATED when
# no phase stands before a phase of a turn it names -- one bounded pass over
# pairs, read at the door. And a checkable claim is usually a derivable one:
# every fact the seating needs is already written down, so the queue derives
# a lawful order rather than trusting the one it was handed.
#
# WHAT THE SEATING BUYS, AND WHAT IT COSTS, MEASURED:
#
#   * A PANIC BECOMES A NAMED REFUSAL. Handed a plan its own names forbid,
#     the door answers `PlanUnseated` with 0 dependents started, where the
#     elder rung discovered it mid-flight through an invariant. Safety
#     first, in TAME order.
#   * THE DERIVED ORDER IS THE ORDER THE AUTHOR WOULD HAVE WRITTEN BY HAND
#     -- measure for measure over the same seven phases: 1 pass against 1,
#     6 slots unspent against 6, 7 dependents to the same end, 0 named turns
#     broken under both.
#   * DIRECTION IS WHY THE SEATING NEVER STALLS. A turn names only turns
#     below it, and a turn's steps keep the order they were written in, so
#     the phase with the smallest unseated turn number is always free -- no
#     visited set, no back-tracking.
#   * ARRANGING MOVES PHASES AND NEVER TOUCHES A NAME. The output is a
#     permutation of the plan exactly as its author wrote each phase.
#   * THE COST IS NAMED RATHER THAN HIDDEN: one bounded seating at the door,
#     at most `max_queue_len` squared pair tests over sixteen phases, paid
#     once before any dependent starts and never again during admission. It buys
#     back no slot and refuses no pass.
#   * The ISOLATION half needed nothing here either: which dependents may stand
#     at one instant is `commute.admissible`'s whole question.
#
# A SEATED PLAN ARRANGES TO ITSELF, EXACTLY -- phase for phase over the whole
# lap, so this rung generalizes `precede.rye` rather than rivalling it, the
# same way an empty turn mask was the sibling mask.
#
# Both RED paths were proven on metal before this witness claimed GREEN.
# Remove the seating check from the door and the elder invariant fires at
# `caravan/precede.rye:615` with dependents already in flight -- so the door is
# load-bearing rather than decorative. Hide the turn mask from the seating
# and the pure read reds at the derived order failing to recover the one the
# author wrote -- caught in the happy zone, before a single dependent starts.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_arrange_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/arrange"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/arrange.rye -femit-bin=${bin}"]

assert build.ok else "caravan arrange build failed"

# The reader this witness runs is built here rather than borrowed (REDS #92).
# Thirty-six rungs ran caravan/bin/read without building it, so the whole arc was
# green only on a tree some earlier run had left warm. A witness owns what it runs.
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"


# Nothing new is declared: a seating reads the plan the author wrote, and the
# document still speaks only in ceilings.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan arrange selftest exited non-zero"
assert test.out contains "GREEN" else "caravan arrange selftest not GREEN"
assert test.out contains "a plan may be written in any order, and the queue seats it" else "the arrange finding did not close"

# The seating read straight, before any supervisor spends it.
assert test.out contains "a plan written against its own names is refused rather than run" else "the door did not refuse an unseated sequence"
assert test.out contains "the derived order is the order the author would have written by hand" else "the seating did not recover the hand-written order"
assert test.out contains "a seated plan arranges to itself exactly, so the elder reading stands" else "the rung did not generalize the reading it extends"

# The arranged lap: one plan run twice, written two ways, ending the same.
assert test.out contains "a plan written against its own names is refused at the door, 0 dependents started" else "the refusal spent a dependent before answering"
assert test.out contains "breaks a named turn: 0 written by hand, 0 arranged" else "the arranged run did not keep the order its author named"
assert test.out contains "passes: 1 written by hand, 1 arranged" else "the derived order did not spend the passes the hand-written one spent"
assert test.out contains "slots unspent: 6 written by hand, 6 arranged" else "the cost of the seating was not reported honestly"
assert test.out contains "7 dependents run to the same end under both orders" else "the two orders did not run the same lap to the same end"

say "GREEN: Caravan arrange witness passed."
