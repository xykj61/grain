# tools/hunk_session_list_witness.rish — a keeper lists their saved editing sessions on metal (HUNK19).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK19.
# Design read: active-designing/20260813-175000_hunk-session-list-exploration.md (names HUNK19).
# Teacher, thanked clean-room: the "recent edits" surface of iCloud Photos / Google Photos (concept only, siloed).
#
# HUNK18 made an editing session a content-addressed artifact; this rung surfaces the list. `pond/apps/session_list.rye`
# `list_sessions` walks the catalog, selects every `.session` artifact, and open_session each (HUNK18, every bead
# proven against its digest before parse), recording a bounded summary — name, edit-count, live position. The honesty
# guarantee (borrowed from mcp_resource_list): a listing never names a session it cannot honestly reopen, so a tampered
# session refuses DigestMismatch through the open and the whole listing refuses with it. The selftest proves the
# listing names exactly the saved sessions in held order (a non-session skipped), true summaries (a rewound session
# reporting a redo depth), a bounded travelling record, and the whole listing refusing on a tampered session. No
# network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_session_list_witness.rish

say "hunk-session-list: Language EN — HUNK19 surfaces a keeper's saved editing sessions: an honest index over the catalog, every summary read from a verified reopen."
say "hunk-session-list: Style Radiant — a listing never names a session it cannot honestly reopen; a tampered session makes the whole index a named refusal, never a phantom."
say "hunk-session-list: Lens TAME — the listing is bounded to the catalog's own count, every open verifies each bead before parse, positive invariants per fn; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/apps/bin/session_list"

let build = run ["sh" "-c" "mkdir -p pond/apps/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/session_list.rye -femit-bin=${bin}"]
assert build.ok else "hunk-session-list: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-session-list: selftest exited non-zero — ${selftest.out}"

let out = trim selftest.out
say "hunk-session-list: ${out}"

let green = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'GREEN session-list' && echo yes"]
assert (trim green.out) == "yes" else "hunk-session-list: selftest did not print the GREEN session-list line"

let exact = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'lists exactly its 2 saved sessions in held order' && echo yes"]
assert (trim exact.out) == "yes" else "hunk-session-list: the listing did not name exactly the saved sessions"

let skipped = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'the non-session skipped, never opened' && echo yes"]
assert (trim skipped.out) == "yes" else "hunk-session-list: the non-session artifact was not proven skipped"

let verified = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'each summary read from a verified reopen' && echo yes"]
assert (trim verified.out) == "yes" else "hunk-session-list: the summaries were not proven read from a verified reopen"

let redo = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'portrait.session at 2/3 (redo depth 1)' && echo yes"]
assert (trim redo.out) == "yes" else "hunk-session-list: the rewound session's redo depth was not surfaced"

let phantom = run ["sh" "-c" "printf '%s' '${out}' | grep -q 'refuse DigestMismatch rather than advertise a phantom' && echo yes"]
assert (trim phantom.out) == "yes" else "hunk-session-list: a tampered session did not make the whole listing refuse"

say "hunk-session-list: GREEN — a keeper's saved sessions list honestly, each verified before it is named; a tampered session refuses the whole index rather than advertise a phantom."
