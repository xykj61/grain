# caravan_abide_witness.rish -- Caravan abide witness.
#
# `dispute.rye` taught a run to keep what its reader answered: the letter carried
# into the reader's own box, the reader's own hand read out of the box beside it,
# and the two readings written into the plan's record in both voices, resolved by
# neither. That record is exactly right, and it is kept where nobody reads it.
#
#   THE WORD AN OPERATOR READS STANDS BESIDE THE READING HELD AGAINST IT.
#
# WHAT THIS RUNG PROVES, MEASURED:
#
#   * THE NUMBER THE TWO ESCORTS DISAGREE ON IS WORDS AN OPERATOR READS AS
#     SETTLED WITH NO SIGN OF THE OBJECTION. The rung below weighs a record
#     against the answers it declined to keep. This weighs the record against the
#     place a person actually reads. It falls from 1 to 0.
#   * THE RECORD IS KEPT WHERE NOBODY READS IT, below this rung. The disagreement
#     lands in `caravan/.abidings/plan.dispute`, among the plan's own notes, and
#     an operator looking for the outcome opens `plan.settled` -- a different
#     file, one byte, reading exactly as it would have read had nobody objected.
#   * AN ESCORT QUOTES, AND NEVER ARGUES. The mark is one byte in
#     `caravan/.abidings/plan.beside`: `s` -- the reading this plan's reader
#     holds. The plan's own `plan.settled` still reads `c` afterward, since an
#     escort adds a voice beside a sentence rather than editing the sentence.
#   * A RUN QUOTES ITS READER'S HAND AND NEVER WRITES ONE. The reader's own
#     `caravan/.readers/desk.said` is seated by the selftest harness standing in
#     for the reader by name, and still reads `s` after both runs.
#   * THE PRICE IS ONE BYTE WRITTEN INTO A NOTE THE RUN ALREADY KNEW THE NAME OF.
#     Both runs take up 6 phases, absorb 3 into standing dependents, lose 3 arcs,
#     take the same judgment back, re-seat the same 3 phases, spend the same 6
#     dependents, post and carry the same correction, read the same answer,
#     record the same disagreement, and settle the plan `carried`.
#   * A PLAN PUBLISHES WHETHER ITS WORD TRAVELS ALONE. The escort is plan-level
#     beside the standing, since it instructs about how a record is read rather
#     than about one arc.
#   * A MARK IS BOUNDED BY THE RECORD THAT EARNED IT. Only a disagreement this
#     run actually read out of its own notes may be quoted, and only the reader's
#     own reading may be quoted from it.
#   * FOUR REFUSALS THIS RUNG EARNS, EACH ABOUT THE MARK RATHER THAN THE WORD IT
#     STANDS BESIDE. `AbideEarly` is the moment. `AbideUnrecorded` is the supply.
#     `AbideMiscounted` is the honesty of the count. `AbideMisquoted` is the
#     record -- an escort carries one person's word to whoever reads another, so
#     it must be that person's word.
#   * A PLAN THAT LOSES NOTHING READS AS THE RUNG BELOW, all 16 pairs -- this
#     arc's standing generalization test.
#
# Five RED paths were proven on metal before this witness claimed GREEN. Read no
# record and the run refuses `AbideEarly`. Mark a word with no disagreement
# standing, folds disarmed, and it refuses `AbideUnrecorded`. Let the count stop
# closing and it refuses `AbideMiscounted`. Plant a record naming one reading
# twice and it refuses `AbideMisquoted`. Disarm every guard at once and let the
# mark quote the plan's own reading, and the run writes `c` beside a word whose
# reader holds `s` -- the plan recorded as its own objector, and the selftest
# still calling itself GREEN. Seeing that once is what makes `quotes` a check
# rather than decoration.
#
# Checks read the selftest output natively (`contains`), never a shell grep over
# interpolated output -- REDS %76 / %85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_abide_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/abide"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/abide.rye -femit-bin=${bin}"]

assert build.ok else "caravan abide build failed -- ${build.err}"

# The reader this witness runs is built here rather than borrowed (REDS %92).
let read_bin_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build caravan/read.rye -femit-bin=caravan/bin/read"]
assert read_bin_build.ok else "caravan read build failed -- ${read_bin_build.err}"

# The board declaration the rungs below opened, unchanged.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_board.bron 2>&1"]
assert published.ok else "the board declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 11 -- grants 22" else "the board declaration changed shape"
assert published.out contains "verdict: whole" else "the board declaration did not read whole"

# A fresh start for the stores, the doorbells, this plan's notes, and the
# reader's own box. The box goes with them, so the lap begins with a reader who
# has neither been told anything nor said anything a run this witness never
# watched.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels caravan/.abidings caravan/.readers"]
assert clean.ok else "the region stores, doorbells, notes, and reader boxes could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan abide selftest exited non-zero"
assert test.out contains "GREEN" else "caravan abide selftest not GREEN"
assert test.out contains "a word an operator reads stands beside the reading against it" else "the abide finding did not close"

# The escort and its three standing refusals, read straight, before any dependent
# runs. The fourth, `AbideMisquoted`, is answered in the same fold, since whether
# a mark quotes its reader is a question two words can settle between themselves.
assert test.out contains "a plan publishes whether its word is read beside the reading against it" else "the escort fold was not weighed"
assert test.out contains "three refusals stand by name: early, unrecorded, miscounted" else "the three standing refusals did not stand"

# The record, the hearing, the delivery, the amendment, the recantation, the
# bearing, and the mend below, unchanged and still weighed.
assert test.out contains "a plan publishes whether its record may hold a disagreement" else "the record below stopped being weighed"
assert test.out contains "a plan publishes whether it hears what its reader answers" else "the hearing below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections travel" else "the delivery below stopped being weighed"
assert test.out contains "a plan publishes whether its own corrections are addressed" else "the amendment below stopped being weighed"
assert test.out contains "a plan publishes whether its own judgments answer to a later run" else "the recantation below stopped being weighed"
assert test.out contains "a plan names what it expects of a phase, and what it would accept of a loss" else "the bearing below stopped being weighed"
assert test.out contains "a repair still refuses by name: unread, whole, overreaching" else "the mend below stopped being weighed"

# The generalization test: a plan that loses nothing reads as the rung below.
assert test.out contains "a plan that loses nothing reads as the line handed, all 16 pairs" else "an unlost plan did not read as the line handed"

# The abide lap: one plan run twice over a reader's recorded disagreement, once
# leaving the published word to be read alone and once standing it beside the
# reading held against it. Every number stands still -- the work, the dependents,
# the correction, the journey, the record, the settlement -- and only the mark
# moves.
assert test.out contains "phases: 6 alone, 6 escorted" else "the two escorts ran different records"
assert test.out contains "dependents: 6 alone, 6 escorted" else "escorting a word cost work it should not have"
assert test.out contains "phases absorbed into a standing dependent: 3 alone, 3 escorted" else "the two escorts absorbed different phases"
assert test.out contains "abandoned reach, conferred and never served: 3 alone, 3 escorted" else "the two escorts lost different work"
assert test.out contains "phases re-seated to carry what was lost: 3 alone, 3 escorted" else "the two escorts repaired different work"
assert test.out contains "standing judgments taken back on this run's own evidence: 1 alone, 1 escorted" else "the recanting rung stopped moving under both escorts"
assert test.out contains "readings corrected where they were read: 1 alone, 1 escorted" else "the amending rung stopped moving under both escorts"
assert test.out contains "corrections carried to the place their reader was reached: 1 alone, 1 escorted" else "the couriering rung stopped moving under both escorts"
assert test.out contains "disagreements written into the record: 1 alone, 1 escorted" else "the disputing rung stopped moving under both escorts"
assert test.out contains "published words standing beside the reading against them: 0 alone, 1 escorted" else "the mark did not part the two escorts"
assert test.out contains "words an operator reads as settled with no sign of the objection: 1 against 0" else "the two escorts read the same way"
assert test.out contains "work still standing when the supervisor exits: 0 alone, 0 escorted" else "the two escorts left different work standing"
assert test.out contains "the plan, as an operator finally reads it: carried out whole alone, carried out whole escorted" else "the two escorts settled the plan differently"
assert test.out contains "breaks a named turn: 0 alone, 0 escorted" else "the escorting run broke an order its author named"

# What an operator reads is what the wire carries, and what a reader holds is
# what their own box carries. Every note is read here, outside the run that wrote
# it, exactly as each would be read by the person it was written for.
let settled = run ["sh" "-c" "cat caravan/.abidings/plan.settled"]
assert settled.ok else "the plan published no settlement an operator could read"
assert settled.out contains "c" else "the wire did not carry the carried settlement the repair earned"

# The mark this rung exists to write, standing where the settlement is read.
let beside = run ["sh" "-c" "cat caravan/.abidings/plan.beside"]
assert beside.ok else "an escorting run left its published word standing alone"
assert beside.out contains "s" else "the mark did not name the reading its reader holds"

# The record it quotes, kept exactly as the rung below writes it.
let quarrel = run ["sh" "-c" "cat caravan/.abidings/plan.dispute"]
assert quarrel.ok else "an open record kept no disagreement at all"
assert quarrel.out contains "cs" else "the record did not name the plan's reading and its reader's"

let correction = run ["sh" "-c" "cat caravan/.abidings/plan.amend"]
assert correction.ok else "the plan published no correction an operator could read"
assert correction.out contains "bc" else "the wire did not name the two readings the correction stands between"

let address = run ["sh" "-c" "cat caravan/.abidings/plan.at"]
assert address.ok else "the plan kept no address for the reader who took its word"
assert address.out contains "desk" else "the wire did not name the place its reader was reached"

# The two halves of the reader's own box, outside this plan's wire entirely --
# the letter the plan carried, and the hand the reader answered with.
let box = run ["sh" "-c" "cat caravan/.readers/desk.told"]
assert box.ok else "the reader's own box was never written to"
assert box.out contains "bc" else "the reader's box did not carry the correction in the words they read"

let hand = run ["sh" "-c" "cat caravan/.readers/desk.said"]
assert hand.ok else "the reader answered nothing at all"
assert hand.out contains "s" else "the reader's own hand did not name the reading they hold"

let recant_note = run ["sh" "-c" "cat caravan/.abidings/plan.recant"]
assert recant_note.ok else "the plan published no recantation an operator could read"
assert recant_note.out contains ".r...." else "the wire did not name the one judgment this run took back"

let lost_note = run ["sh" "-c" "cat caravan/.abidings/plan.lost"]
assert lost_note.ok else "the plan published no loss an operator could read"
assert lost_note.out contains ".x.x.x" else "the wire did not name the three phases the plan lost"

# The dependents measure the loss in their own hands, exactly as the rungs below
# left them, and the follower that once spoke for the judgment falls with it.
assert test.out contains "falls as its author declared, holding 1 conferred arcs it never served" else "a falling dependent did not fall holding its conferral"
assert test.out contains "client_b: read 3 arcs of its own, 0 inherited at its first breath, 1 conferred, 0 returned, 1 still reachable at home" else "the dependent a conferral was made to did not read it as its own"
assert test.out contains "client_c: bytes differed" else "the follower that once spoke for the judgment came home after all"

say "GREEN: Caravan abide witness passed."
