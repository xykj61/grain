# tools/ales_stereo_silence_span_witness.rish — stereo_silence_span: silencing a span carried into stereo, both channels in lockstep, validate-both-before-either (ALES122).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES122.
# Design read: active-designing/20260815-021904_fill-ales122-lotus-stereo-silence-span.md
# Stands on: lotus/silence_span.rye (ALES110 — the mono span-silence run once per channel), lotus/pan.rye (ALES10 — the StereoClip, two mono Clips left/right, and its balance invariant),
# lotus/stereo_paste_over.rye (ALES121 — the stereo overwrite this rung specializes with zero paint), lotus/timeline.rye (ALES2 — the Clip and the EditError reused whole), lotus/meter.rye
# (ALES13 — the peak/RMS meter). A Lotus master is a StereoClip whose defining invariant is that left and right hold the same length so the channels stay aligned in time; muting a bleed
# clears both speakers at once. This rung carries ALES110's silence_span into stereo the way ALES121 carried paste_over: run the proven mono silence_span on each channel over the same span.
# It is exactly the zero-paint case of stereo_paste_over — silence is the overwrite whose paint is zero — and the length-preserving third beside stereo_cut (which shrinks).
#
# lotus/stereo_silence_span.rye writes silence over [start, start+count) in both channels, validating BOTH channels before either is mutated (because mono silence_span can fault only with
# BadRange and the channels enter equal-length, the span is checked once against the shared length up front) so a refusal never desynchronises the channels. The crux is four laws. THE
# STEREO SILENCE LAW: each channel equals ALES110's mono silence_span on that channel byte for byte, the length held. THE BALANCE / LENGTH LAW: left.len == right.len after, both holding
# their starting length. THE SPECIALIZATION LAW: stereo_silence_span equals ALES121's stereo_paste_over with zero payloads. THE ATOMICITY / DEGENERATE LAW: a refusal leaves both channels
# untouched and balanced, count 0 the identity, silence_span(0, len) silencing both wholly, a span past the samples BadRange.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/ales_stereo_silence_span_witness.rish

say "ales-stereo-silence-span: Language EN — stereo_silence_span writes silence over the span [start, start+count) in both channels of a StereoClip, so the Silence Audio Selection gesture ALES110 named for a mono clip now lands on a real stereo master. A Lotus master is two Clips heard together, one per speaker, whose defining invariant is that left and right hold the same length so the two channels stay aligned in time; muting a bleed or dropping a cough clears both speakers at once. It is exactly the zero-paint case of ALES121's stereo_paste_over — silence is the overwrite whose paint is zero — and the length-preserving third beside stereo_cut, which shrinks the clip. It carries ALES110's proven mono silence_span into stereo — the same start and count on each channel — so the span clears identically in both and the stereo image stays balanced."
say "ales-stereo-silence-span: Style Radiant — the rule is stated positively: run the mono silence_span per channel over its public API, validating both channels before either is mutated (because mono silence_span can fault only with BadRange and the channels enter equal-length, the span is checked once against the shared length up front), so a refusal never leaves one channel silenced and the other not. The crux stands out as four laws: the stereo silence law (each channel equals ALES110's mono silence_span on that channel byte for byte, the span all zero and every sample outside it unchanged), the balance / length law (left.len == right.len after the edit and both hold their starting length, the stereo image staying aligned), the specialization law (stereo_silence_span equals ALES121's stereo_paste_over with zero payloads byte for byte on both channels), and the atomicity / degenerate law (any refusal leaves both channels byte for byte untouched and still balanced, count 0 the identity on both, silence_span(0, len) silencing both wholly, a span past the samples BadRange)."
say "ales-stereo-silence-span: Lens TAME — two bounded i16 Clips (left, right) whose named span is zeroed in lockstep; the span is checked without underflow against the common channel length once up front (start against len, count against the remainder), so every refusal comes by name before any write and the channels can never desynchronise; silence_span writes values only in one bounded in-place pass, no second buffer, so each channel holds its starting length and balance is preserved; it reuses ALES2's EditError whole and ALES110's silence_span per channel over its public API, inventing no new primitive; the stereo silence law is proven against ALES110's own silence_span run per channel, and the specialization law sets it beside ALES121's stereo_paste_over with zero paint; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_silence_span"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_silence_span.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-silence-span: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_silence_span.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-silence-span: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-silence-span: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-silence-span' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-silence-span: selftest did not print the GREEN ales-stereo-silence-span line"
