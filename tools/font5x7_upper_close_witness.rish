# tools/font5x7_upper_close_witness.rish -- the three capitals that CLOSE the uppercase Latin-1 letter set prove themselves on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1). Set beside the accented
# capital corpora (tools/font5x7_upper_accented_witness.rish, tools/font5x7_upper_latin1_witness.rish) and the
# Scandinavian/Icelandic capital corpora (tools/font5x7_upper_nordic_witness.rish, tools/font5x7_upper_icelandic_witness.rish).
#
# The crux this witness proves is the CLOSE of the uppercase Latin-1 letter set: the three uppercase letters still undrawn
# after every other capital corpus -- E diaeresis, I diaeresis, O tilde -- at their real Unicode codepoints U+00CB, U+00CF,
# U+00D5, the capital twins of lowercase letters the diaeresis and tilde corpora already carry. Each is a 5x7 coverage grid
# drawn in the open as ASCII line art in image/font5x7_upper_close.rye, built into a gfa1 atlas and proven on metal. A full
# round-trip recovers every codepoint, advance, and coverage byte byte-for-byte; all three look up present and carry the
# shared advance while a plain ASCII 'E' misses; the three carry distinct coverage; each reads within an honest legibility
# band; the two diaeresis marks are byte-identical (the mark stays one hand across E and I); and the O tilde is a two-row
# wave cresting right (not a one-row diaeresis). With these three, every alphabetic codepoint in the whole Latin-1
# Supplement block -- lowercase and uppercase alike -- now stands drawn in our own open hand. Compression is reported as a
# fact, never asserted -- the round-trip is the proof. No network, no key, no funds -- the capitals a surface reads the day
# it prints a full ALL-CAPS name whose last marks the block had left uppercase-blank.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_upper_close_witness.rish

say "font5x7-upper-close: Language EN -- Season G font content; the three capitals that close the uppercase Latin-1 letter set (E diaeresis, I diaeresis, O tilde) drawn in the open as ASCII line art, built into the gfa1 atlas -- the last uppercase letters the accented and Scandinavian/Icelandic capital corpora never reached."
say "font5x7-upper-close: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; two diaeresis marks proven byte-identical so the mark stays one hand, and the tilde a two-row wave cresting right; our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-upper-close: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - upper_close_count - the mark span - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_upper_close"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_upper_close.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-upper-close: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-upper-close: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-upper-close: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-upper-close' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-upper-close: selftest did not print the GREEN corpus line"

say "font5x7-upper-close: GREEN -- E diaeresis, I diaeresis, O tilde stand drawn in the open, closing the uppercase Latin-1 letter set, proven on metal."
