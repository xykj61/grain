# caravan_intent_witness.rish -- Caravan intent witness.
#
# `commute.rye` read the permission beside each region and separated two
# rooms with it: a shared region is a hazard only where one of the two sides
# may write it. That refinement reads the document and stops, and the
# document speaks in ceilings -- a domain granted `rw` holds the right to
# write for as long as it runs, so every reader behind it waits even on a
# turn where the writer only looks.
#
#   A GRANT IS A CEILING, AND A HOP IS AN ACT.
#
# Each queued item carries one letter per hop -- `r` for a hop it only
# reads, `w` for one it writes -- and the supervisor reads those letters
# TWICE, in two rooms. It schedules by them, so two items sharing a region
# neither writes this turn may be reordered. And it HANDS THEM OUT AS THE
# LINE: the dependent's capability words are narrowed to exactly what it
# declared, so an item that writes past its own word meets a refusal from
# the mechanism rather than a rebuke from the supervisor.
#
# THE WORD MAY NARROW A GRANT AND NEVER WIDEN ONE. The effective write is
# the grant AND the word, so an item declaring `w` on a region the document
# grants it read-only writes nothing and orders nobody. Trust flows one way.
#
# THE BOOT'S OWN CHECK WANTED EQUALITY, AND SAFETY ONLY EVER WANTED A
# CEILING. `boot.line_agrees` asks a handed line to EQUAL the declaration,
# which is right when the line is the derivation and refuses a narrowed line
# for being too careful. `boot.line_within` is the honest reading here:
# every right on the line is one the document grants, and none exceeds it.
# The virtualiser holds 7 capabilities and is handed 1, read alone.
#
# ONE ROOM CONVERTS, AND THE OTHER IS CLOSED FOR A NAMED REASON:
#
#   * Over the CEILING LAP, whose virtualiser holds `rw` on the published
#     region and only looks at it, reading the act converts the order half:
#     0 lawful passes by grant against 2 by act, reaching 3 items back, the
#     table filled to 3 where the grants held it at 2, and 6 slot-turns
#     unspent by grant against 3 by act. Five dependents run to the same end
#     under both.
#   * The ISOLATION half converts nothing, and the document says why: a
#     channel joins two domains at every instant they both run, and a bell
#     may ring at any moment of a hop. A per-hop word narrows what a dependent
#     touches and narrows no standing joint at all.
#
# THE CONTROL BELIEVES THE WORD WITHOUT HANDING IT OVER AND BREAKS ON METAL.
# `trusted` schedules by the same letters and hands the full derived line.
# Given an item that declares `r` on a region it then writes, the write
# lands, the dependent answers `carried` where its own declaration said
# `WriteDenied`, and the run refuses -- while the narrowed line refuses the
# write itself.
#
# Both RED paths were proven on metal before this witness claimed GREEN.
# Run the ceiling lap by grant under the act's own checks and it reds at no
# item passing an rw holder that only looks, so the conversion is real work.
# Remove the narrowing and hand the full line under the act's own reading,
# and the lie lap reds identically to the control -- which proves the
# narrowing is the whole of the safety rather than an ornament on it.
#
# Checks read the selftest output natively (`contains`), never a shell grep
# over interpolated output -- REDS #76 / #85, the apostrophe loom.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caravan_intent_witness.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "caravan/bin/intent"

let build = run ["sh" "-c" "mkdir -p caravan/bin && env RYE_ZIG=${zig} rye/bin/rye build caravan/intent.rye -femit-bin=${bin}"]

assert build.ok else "caravan intent build failed"

# Nothing new is declared: the letters ride on the queue, where an act
# belongs, rather than in the document, where a ceiling belongs.
let published = run ["sh" "-c" "caravan/bin/read caravan/systems/serial_three_clients_menu.bron 2>&1"]
assert published.ok else "the published declaration could not be read"
assert published.out contains "domains 4 -- channels 3 -- regions 10 -- grants 19" else "the published document changed shape"
assert published.out contains "verdict: whole" else "the published declaration did not read whole"

# A fresh provisioning each run, so every index starts at zero and a bell
# found ringing was rung by this run rather than left standing by the last.
let clean = run ["sh" "-c" "rm -rf caravan/.regions caravan/.channels"]
assert clean.ok else "the region stores and doorbells could not be cleared"

let test = run ["sh" "-c" "${bin} selftest 2>&1"]
assert test.ok else "caravan intent selftest exited non-zero"
assert test.out contains "GREEN" else "caravan intent selftest not GREEN"
assert test.out contains "a grant is a ceiling, a hop is an act, and a word is safe once you hand it over" else "the intent finding did not close"

# The word read straight, in both directions, before any supervisor spends it.
assert test.out contains "the write bit is the grant AND the word" else "the effective write stopped reading one of its two sources"
assert test.out contains "a word narrows a grant and never widens one" else "a declaration reached past the document"
assert test.out contains "the looker is handed 1 capability of the 7 it holds, and it cannot write it" else "the narrowed line did not narrow"

# The ceiling lap: reading the act converts the order the grants held.
assert test.out contains "the ceiling lap leaves 6 slot-turns unspent by grant and 3 by act" else "the act did not convert the slots a ceiling was holding"
assert test.out contains "a ceiling nobody stands on: 0 lawful passes by grant, 2 by act, reaching 3 items back" else "the ceiling lap did not reach past its head"
assert test.out contains "5 dependents run to the same end under both, at a peak of 2 against 3" else "the two readings did not run the same lap to the same end"

# The control: believing a word without handing it over is faster, and wrong.
assert test.out contains "the undeclared write meets WriteDenied from the dependent's own word" else "the narrowed line let an undeclared write land"
assert test.out contains "a declaration is safe when you hand it over" else "the control did not break where the document said it would"

say "GREEN: Caravan intent witness passed."
