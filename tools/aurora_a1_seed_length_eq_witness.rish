# tools/aurora_a1_seed_length_eq_witness.rish — Ashvini equality: exact 32 (STOA337).
#
#   rishi/bin/rishi run tools/aurora_a1_seed_length_eq_witness.rish
#
# gth speaks ceilings. eq speaks exactly. Aurora's seed_length=32 is the first
# pedestal that could not decide until this rune — 32→1, neighbors→0.

say "eq-seed: Language EN — the first exact deciding gate (STOA337)."
say "eq-seed: Lens TAME — exact match; both sides; gth neighbor still stands."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/lib/gate-aurora-seed-length-eq-u32.glow"

say "eq-seed: exact 32 answers 1..."
let ok = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "32"]
assert ok.ok else "eq-seed: exact case failed to run"
assert ok.out contains "EXIT:0" else "eq-seed: exact case did not exit 0"
assert ok.out contains "1" else "eq-seed: exact 32 did not speak 1"

say "eq-seed: just under (31) answers 0..."
let under = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "31"]
assert under.ok else "eq-seed: under case failed to run"
assert under.out contains "0" else "eq-seed: 31 did not speak 0"

say "eq-seed: just over (33) answers 0..."
let over = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk "33"]
assert over.ok else "eq-seed: over case failed to run"
assert over.out contains "0" else "eq-seed: 33 did not speak 0"

say "eq-seed: the desk names eq, not gth..."
let verb = run ["sh" "-c" "grep -qE '^[?][:]  [(]eq ' src/lib/gate-aurora-seed-length-eq-u32.glow"]
assert verb.ok else "eq-seed: the desk stopped naming eq"

say "eq-seed: gth neighbor (aurora wire bound) still green..."
let gth = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" "src/lib/gate-aurora-wire-bound-u32.glow" "128"]
assert gth.ok else "eq-seed: gth neighbor failed"
assert gth.out contains "1" else "eq-seed: gth neighbor did not speak 1"

say "GREEN: equality first — seed_length=32 decides exactly; gth still stands."
