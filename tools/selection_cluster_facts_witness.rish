# tools/selection_cluster_facts_witness.rish -- the whole-cluster facts a selection expands to, on metal (Season G).
#
# Season G (Open Media Primitives) -- image/selection_summary.rye reads a selection as a SUBSET (its area strictly sharper than the whole
# scene's); this rung reads the OTHER direction -- it EXPANDS a selection to the whole connected clusters its objects belong to
# (image/overlap_clusters.rye) and reads those clusters' facts (image/cluster_facts.rye): selection_cluster_ids the ascending clusters
# touched, selection_cluster_count their count, selection_cluster_frame the union group-handle, selection_cluster_area the whole-cluster
# substance, expands_beyond_selection whether snapping to groups adds anything. Composes over ANY selector's label set. NO float, NO tolerance.
#
# The crux this witness proves on metal, two shapes: A PARTIAL TOUCH EXPANDS -- selecting one member of a two-member cluster (own area 11)
# expands to the whole cluster (area 31, frame wider than the member's box), expands_beyond_selection true; A MULTI-CLUSTER SELECTION EXPANDS
# EACH WHOLE -- selecting one member of a cluster and a whole singleton expands to both (31 + 4, count 2); and the whole scene is the FIXED
# POINT, expands false. Refusals by name, determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/selection_cluster_facts_witness.rish

say "selection_cluster_facts: Language EN -- Season G selection-to-whole-cluster read; selection_cluster_ids the ascending clusters a selection lands on, selection_cluster_count their count, selection_cluster_frame the union group-handle, selection_cluster_area the whole-cluster substance, expands_beyond_selection whether snapping to whole groups adds anything; NO float, NO tolerance."
say "selection_cluster_facts: Style Radiant -- compose not braid: this rung owns only the selection-to-whole-cluster expansion; overlap_clusters owns the cluster_of map, cluster_facts owns each cluster's frame and area, selection_summary owns the selection's own subset area, scene_graph owns the per-object manifest. A reading over a reading over a reading."
say "selection_cluster_facts: Lens TAME -- the cluster-presence tally is sized to the cluster count plus one, the frame union and substance sum each run the cluster count times; a malformed label set refuses BadSelection, a selection landing on no cluster refuses NoClustersSelected for its frame; all-or-nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/selection_cluster_facts"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/selection_cluster_facts.rye -femit-bin=${bin}"]
assert build.ok else "selection_cluster_facts: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "selection_cluster_facts: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "selection_cluster_facts: ${out}"

assert selftest.out contains "GREEN image-selection-cluster-facts" else "selection_cluster_facts: selftest did not print the GREEN line"
assert selftest.out contains "A PARTIAL TOUCH EXPANDS" else "selection_cluster_facts: the partial-touch case did not print"
assert selftest.out contains "snapping to the group added B" else "selection_cluster_facts: the added-member fact did not print"
assert selftest.out contains "A MULTI-CLUSTER SELECTION EXPANDS EACH WHOLE" else "selection_cluster_facts: the multi-cluster case did not print"
assert selftest.out contains "THE FIXED POINT" else "selection_cluster_facts: the fixed-point case did not print"
assert selftest.out contains "snapping to groups adds nothing" else "selection_cluster_facts: the adds-nothing fact did not print"
assert selftest.out contains "refuses NoClustersSelected" else "selection_cluster_facts: the no-clusters refusal did not print"
assert selftest.out contains "refuse BadSelection" else "selection_cluster_facts: the bad-selection refusal did not print"
assert selftest.out contains "the same selection expands to the same substance twice" else "selection_cluster_facts: the determinism statement did not print"

say "selection_cluster_facts: GREEN on metal -- the whole-cluster facts a selection expands to; a partial touch expands to the whole cluster (adding the member the box never touched), a multi-cluster selection expands each whole, the whole scene is the fixed point where snapping adds nothing; refusals by name, determinism. Season G open-media."
