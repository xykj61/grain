# tools/fora_wire_witness.rish — the handshake's three values cross a self-describing local frame, verify-before-trust (FORA3).
#
# Season: the Six-Season double-seat, Season D/F thread · waymark FORA · Constel test-network naming · rung FORA3.
# Design read: active-designing/20260814-043551_fora3-constel-local-wire-frame.md
# Law kin: .claude/rules/placeholder-ship-names.md — the naming law reaches into the wire: a vowel-bearing (real-@p-shaped)
# name smuggled into a payload whose digest was fixed up STILL refuses VowelPresent at the border. Integrity and safety are
# two independent gates; a real address can never cross a Constel channel even inside a whole frame.
#
# constel/wire.rye frames each of FORA2's three proven values — Greeting · Ack · Session — into one self-describing layout
# (magic CNST · version · kind · payload_len · Sha256 digest · payload) and deframes verify-before-trust. The selftest proves:
# each value round-trips byte-for-byte; a short, bad-magic, bad-version, bad-kind, overlong, truncated, tampered, or
# wrong-kind frame each refuses by name before a value is formed; a smuggled vowel refuses at the naming-law border even with
# a fixed-up digest; and a field length past the payload refuses FieldOverrun. Purely local — no network, no keys, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/fora_wire_witness.rish

say "fora-wire: Language EN — FORA3 carries FORA2's three proven handshake values (Greeting · Ack · Session) across a self-describing local frame, deframed verify-before-trust, exactly as DREY1 proved the Mikrophone's committed payload before any real wire."
say "fora-wire: Style Radiant — one frame layout, a single source of truth (magic · version · kind · length · Sha256 · payload); every corruption refuses by name before a value is formed."
say "fora-wire: Lens TAME — deframing is two independent gates, the Sha256 proving the payload whole and the naming law proving it lawful; siloed to constel/, run from inside the jailed pier; no network, no transport, no keys, no funds, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/wire"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/wire.rye -femit-bin=${bin}"]
assert build.ok else "fora-wire: build failed — ${build.err}"

let outfile = "constel/bin/wire.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "fora-wire: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "fora-wire: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN fora-wire' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "fora-wire: selftest did not print the GREEN fora-wire line"

say "fora-wire: GREEN — the three handshake values cross a local frame proven whole and lawful; the FORA4 exchange loop need only pass these frames between two piers."
