# tools/tact_commerce_trade_bron_witness.rish — TACT Journey 4, Rung 3: the trade made portable.
#
# Rungs one and two booked a fair-value trade and proved it one both parties signed. A trade is only
# useful if both sides can carry the identical fact. This rung renders a signed trade to a
# `format trade-v1` Bron record and parses it back byte-for-byte: parse(render(signed)) recovers an
# equal signed trade (points, item, price, stamp, both signatures) that still passes both_agree, so
# the two-party agreement survived becoming text. The reader is purpose-built and bounded — an
# unknown field refuses UnknownField (never dropped), a missing field MissingField, a wrong header
# BadFormat, and malformed hex BadHex. Reads no network — the serve transport stays Keaton's hand.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/tact_commerce_trade_bron_witness.rish

say "tact4: Language EN — a signed trade travels as Bron and returns whole, so both keepers hold the identical fact."
say "tact4: Lens TAME — round-trip preserved, both_agree survives; unknown/missing field, bad header, bad hex each refuse."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/commerce-trade-bron"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/commerce_trade_bron.rye -femit-bin=${bin}"]
assert build.ok else "tact4: commerce_trade_bron build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "tact4: commerce_trade_bron selftest exited non-zero"
assert selftest.out contains "GREEN" else "tact4: selftest did not speak GREEN"
assert selftest.out contains "a signed trade round-tripped through Bron byte-for-byte and still passed both_agree" else "tact4: round-trip claim missing"
assert selftest.out contains "an unknown field refused UnknownField (never dropped)" else "tact4: unknown-field refusal missing"
assert selftest.out contains "a missing field refused MissingField" else "tact4: missing-field refusal missing"
assert selftest.out contains "a wrong header and short hex each refused" else "tact4: bad-header/hex refusal missing"
assert selftest.out contains "a signed trade travels as Bron and returns whole" else "tact4: crux claim missing"

# Rung two — the both-parties-signed agreement this record carries — stays its own green binary.
let r2 = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/commerce_trade_signed.rye -femit-bin=pond/bin/commerce-trade-signed && pond/bin/commerce-trade-signed selftest 2>&1"]
assert r2.ok else "tact4: rung-two commerce_trade_signed re-run failed"
assert r2.out contains "GREEN" else "tact4: rung-two selftest did not speak GREEN"

say "tact4: GREEN — a signed trade travels as Bron and returns whole, or names its refusal; both_agree survives the crossing."
