# tools/font5x7_icelandic_witness.rish -- the open Icelandic letters corpus proves itself on metal (Season G).
#
# Season G (Open Media Primitives) - font content for the open glyph atlas image/glyph.rye (gfa1), set beside the five
# ASCII corpora, the wider-symbol corpora, the Greek letters, the sub/superscript and fraction corpora, the five accent
# corpora (tools/font5x7_latin1_witness.rish and its grave/circumflex/tilde/diaeresis/german siblings), and the
# Danish-Norwegian letters (tools/font5x7_nordic_witness.rish).
#
# The crux this witness proves is a REAL, OPEN, hand-drawn Icelandic letters corpus: the three lowercase letters an
# Icelandic name reaches for that the accent and nordic corpora never drew -- eth, y acute, thorn -- at their real Unicode
# codepoints U+00F0, U+00FD, U+00FE, each a 5x7 coverage grid drawn in the open as ASCII line art in
# image/font5x7_icelandic.rye, built into a gfa1 atlas and proven on metal. A full round-trip recovers every codepoint,
# advance, and coverage byte byte-for-byte; all three letters look up present and carry the shared advance while a plain
# ASCII 'y' misses; the three carry distinct coverage; each reads within an honest legibility band; and the three
# CONSTRUCTIONS hold -- eth wears a crossed ascender (a crossbar spanning the upper cell with a short ascender above and a
# bowl below), thorn stands a full-height stem (ink in the left column from the ascender at top to the descender at
# bottom, a bowl on the right at its middle), and y acute leans its stroke right (top-row ink in the right half, none in
# the left). With these three the lowercase Latin-1 letter set stands whole in our own open hand -- every alphabetic
# codepoint in the block now drawn. Compression is reported as a fact, never asserted -- the round-trip is the proof. No
# network, no key, no funds -- the letters a surface reads when it prints an Icelandic keeper's own name.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/font5x7_icelandic_witness.rish

say "font5x7-icelandic: Language EN -- Season G font content; the three Icelandic letters (eth, y acute, thorn) drawn in the open as ASCII line art, built into the gfa1 atlas, the letters a civic surface prints when it spells an Icelandic keeper's own name -- the lowercase letters the accent and nordic corpora never reached, closing the Latin-1 letter set."
say "font5x7-icelandic: Style Radiant -- the drawings are the specification and the bytes are derived from them, so decode(encode(atlas)) recovers every letter byte for byte; three letters built three ways (eth's crossed ascender, thorn's full-height stem, y acute's right lean), our own hand, permissively ours, no external font to license and no web-search gate."
say "font5x7-icelandic: Lens TAME -- u32 in-memory counts, u8 coverage bytes; every buffer names a maximum (cell_area - icelandic_count - the atlas ceilings it rests on); each function states its invariants positively; codepoints explicit and strictly ascending; the source stays plain ASCII with numeric codepoints though the glyphs cover a non-ASCII range; compression a reported fact never a false invariant; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/font5x7_icelandic"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/font5x7_icelandic.rye -femit-bin=${bin}"]
assert build.ok else "font5x7-icelandic: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "font5x7-icelandic: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "font5x7-icelandic: ${out}"

let green = run ["sh" "-c" "${bin} selftest 2>&1 | grep -q 'GREEN image-font5x7-icelandic' && echo yes"]
assert (trim green.out) == "yes" else "font5x7-icelandic: selftest did not print the GREEN corpus line"

say "font5x7-icelandic: GREEN -- the letters eth, y acute, thorn stand drawn in the open, closing the lowercase Latin-1 letter set, proven on metal."
