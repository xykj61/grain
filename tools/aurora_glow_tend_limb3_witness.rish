# tools/aurora_glow_tend_limb3_witness.rish — Aurora A3 in src/sur/ (e202).
#
#   rishi/bin/rishi run tools/aurora_glow_tend_limb3_witness.rish

say "aurora-tend-3: Language EN — third Aurora Glow Tend limb (sur museum)."
say "aurora-tend-3: Style Radiant — six living stages named; boot stays in aurora/src."
say "aurora-tend-3: Lens TAME — Equinox e202 · Ashvini nest-only · Equinox B."

let zig = "vendor/zig-toolchain/zig"
let desk = "src/sur/shape-aurora-living-stages.glow"

say "aurora-tend-3: placard..."
let placard = run ["sh" "-c" "head -n 7 src/sur/shape-aurora-living-stages.glow | grep -E -c '^::  (name|shape|invariant|example|readers|nib)'"]
assert placard.ok else "aurora-tend-3: placard scan failed"
let pcount = trim placard.out
assert pcount == "6" else "aurora-tend-3: placard missing six lines"

say "aurora-tend-3: example locks to six stages..."
let ex = run ["sh" "-c" "grep -q 'example    6' src/sur/shape-aurora-living-stages.glow"]
assert ex.ok else "aurora-tend-3: example 6 missing"
let names = run ["sh" "-c" "grep -q 'seed' src/sur/shape-aurora-living-stages.glow && grep -q 'relay' src/sur/shape-aurora-living-stages.glow && grep -q 'named' src/sur/shape-aurora-living-stages.glow && grep -q 'sealed' src/sur/shape-aurora-living-stages.glow && grep -q 'wire' src/sur/shape-aurora-living-stages.glow && grep -q 'posted' src/sur/shape-aurora-living-stages.glow"]
assert names.ok else "aurora-tend-3: placard must name seed · relay · named · sealed · wire · posted"
let elder = run ["sh" "-c" "grep -q 'aurora/README.md' src/sur/shape-aurora-living-stages.glow"]
assert elder.ok else "aurora-tend-3: README citation missing"

say "aurora-tend-3: six stage sources still present..."
let stages = run ["sh" "-c" "test -f aurora/src/seed.rye -a -f aurora/src/relay.rye -a -f aurora/src/named.rye -a -f aurora/src/sealed.rye -a -f aurora/src/wire.rye -a -f aurora/src/posted.rye"]
assert stages.ok else "aurora-tend-3: one or more living stage .rye missing"
let run_doc = run ["sh" "-c" "grep -q 'aurora/run.sh relay' aurora/README.md && grep -q 'aurora/run.sh posted' aurora/README.md"]
assert run_doc.ok else "aurora-tend-3: README must still document relay and posted"

say "aurora-tend-3: lower and run..."
let gate = run ["env" "RYE_ZIG=${zig}" "sh" "tools/glow_run_worker.sh" desk]
assert gate.ok else "aurora-tend-3: shape lower/build/run failed"
assert gate.out contains "EXIT:0" else "aurora-tend-3: shape did not exit 0"

say "aurora-tend-3: A1–A2 and T6 still present..."
let prior = run ["sh" "-c" "test -f src/sur/shape-aurora-wire-capacity.glow -a -f src/sur/shape-aurora-seed-length.glow -a -f src/sur/shape-tally-stack-laws.glow"]
assert prior.ok else "aurora-tend-3: A1, A2, or T6 missing"

say "GREEN: aurora Glow Tend limb 3 — six living stages in src/sur/; Tend ladder kept."
