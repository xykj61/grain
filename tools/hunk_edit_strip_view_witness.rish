# tools/hunk_edit_strip_view_witness.rish — the strip painted beside the picture on metal (HUNK52).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK52.
# Design read: active-designing/20260813-205957_hunk-strip-chips-view-exploration.md.
# Teacher, thanked clean-room: the tool palette of a photo editor (iCloud Photos / Google Photos) — a row of tool chips
# a keeper reads and taps (concept only, siloed).
#
# HUNK51 gave the Photos editor a whole finger, yet the gesture strip stayed invisible — a keeper tapped pixel columns
# they could not see. This rung paints them: paint_strip renders a chips×1 Skate row where chip i wears the stable color
# of the verb bound at strip cell i (HUNK2's anchor palette), and chip i sits on exactly the pixel span finger_up reads
# as cell i. So the palette a keeper reads and the palette a keeper taps can never disagree — the exact parallel of
# HUNK51's no-drift, carried from the picture to the palette. The selftest proves each chip's color is its verb's color,
# a real tap centered on chip i commits exactly verb i, an unbound strip refuses EmptyStrip, and bad geometry refuses at
# open. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_edit_strip_view_witness.rish

say "hunk-edit-strip-view: Language EN — HUNK52 paints HUNK50's gesture strip as a Skate row of verb chips, over HUNK2's anchor palette: a keeper reads the palette they tap."
say "hunk-edit-strip-view: Style Radiant — chip i wears the stable color of the verb bound at cell i and sits on exactly the pixel span a tap reads as cell i, so the seen palette and the tapped palette can never disagree."
say "hunk-edit-strip-view: Lens TAME — a pure composition over HUNK51's finger view and HUNK2's down-map; no new render primitive, no new clamp; refusals only EmptyStrip and the sub-surfaces' own; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/edit_strip_view"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/edit_strip_view.rye -femit-bin=${bin}"]
assert build.ok else "hunk-edit-strip-view: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-edit-strip-view: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-edit-strip-view: ${out}"

assert out contains "GREEN edit-strip-view" else "hunk-edit-strip-view: selftest did not print the GREEN edit-strip-view line"
assert out contains "each chip wearing exactly chip_slot of its bound verb" else "hunk-edit-strip-view: a chip did not wear its verb's color"
assert out contains "the row rasterizes to a lit canvas" else "hunk-edit-strip-view: the chip row did not reach the glass"
assert out contains "commits exactly verb i (the seen palette equals the tapped palette, cell-for-cell)" else "hunk-edit-strip-view: a tap did not commit the chip it was centered on"
assert out contains "an unbound strip refuses EmptyStrip" else "hunk-edit-strip-view: an unbound strip did not refuse EmptyStrip"
assert out contains "each refuse at open by name" else "hunk-edit-strip-view: bad geometry did not refuse at open"

say "hunk-edit-strip-view: GREEN — the gesture strip is painted: each chip wears its verb's stable color, a finger tap centered on a chip commits exactly that verb, the seen palette equals the tapped palette, and an unbound strip or bad geometry refuses by name; no network, no key, no funds."
