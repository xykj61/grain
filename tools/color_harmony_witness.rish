# tools/color_harmony_witness.rish -- named colour-wheel schemes grown from one seed prove themselves on metal (Season G).
#
# Season G (Open Media Primitives) -- the design-system palette named, one rung above the palette toolkit
# (image/color_adjust.rye) and the open colour algebra (image/color.rye), a sibling of the tonal scale
# (image/color_scale.rye) and the on-colour swatch (image/color_swatch.rye).
# Design read: active-designing/date/20260816/20260816-210735_season-g-color-algebra-crux.md (the colour floor this stands on).
# Teacher, thanked clean-room: gratitude/w3c-css-color.md (the W3C CSS Color spec + sRGB -- public standards only).
#
# The crux this witness proves is the move a design system names rather than computes: from ONE seed colour, grow the
# classical colour-wheel schemes -- complementary, analogous, triadic, split-complementary, tetradic, square -- written as
# a single-stranded consumer of color_adjust.rotate_hue at the classical angles. Every scheme leads with the keeper's own
# seed byte-for-byte; the complementary partner is exactly the toolkit's complement (compose, not re-derive); triadic hues
# sit a third of the wheel apart and square hues an even quarter, both within a stated round-trip tolerance; alpha rides
# through every scheme; and a grey seed collapses every scheme back to the same grey. No new storage, codec, or maths --
# fixed small sets of hue turns over the existing verb, so color_adjust's own proofs carry through. No network, no key, no
# funds -- the named palette Brushstroke and Skate grow the day the design system lands.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/color_harmony_witness.rish

say "color-harmony: Language EN -- Season G's named palettes; a keeper names one brand seed and reads back a ready set of partner colours -- complementary, triadic, analogous, split-complementary, tetradic, square -- rather than computing an angle by hand."
say "color-harmony: Style Radiant -- compose not braid; color_adjust DECIDES the hue turn (rotate_hue steps the wheel and wraps a full circle) and this module only PICKS the classical angles for each named scheme, leading every one with the seed untouched."
say "color-harmony: Lens TAME -- u16 wheel degrees bounded to one circle; every scheme a fixed small array (two to four) bounded by construction; the seed led byte-for-byte; alpha carried; grey collapses; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/color_harmony"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/color_harmony.rye -femit-bin=${bin}"]
assert build.ok else "color-harmony: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "color-harmony: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "color-harmony: ${out}"

# Honour the loom REDS %76 named: check every claim with Rishi's native `contains`, never a shell grep over interpolated
# output, so an apostrophe in the selftest prose (here "keeper's own seed") can never break a check the way it broke the
# elder color_scale witness.
assert out contains "GREEN image-color-harmony" else "color-harmony: selftest did not print the GREEN colour-harmony line"
assert out contains "every scheme leads with the keeper's own seed byte-for-byte" else "color-harmony: a scheme did not lead with the seed byte-for-byte"
assert out contains "complement (compose, not re-derive)" else "color-harmony: the complementary partner was not the toolkit's own complement"
assert out contains "triadic hues sit a third of the wheel apart and square hues an even quarter" else "color-harmony: the triadic thirds or square quarters did not hold within tolerance"
assert out contains "a grey seed collapses every scheme back to the same grey" else "color-harmony: a grey seed did not collapse every scheme back to the same grey"

say "color-harmony: GREEN -- six named colour-wheel schemes from one seed whole; each leads with the seed, turns the classical angles, composes the toolkit's complement, holds even spacing within tolerance, carries alpha, and collapses a grey; determinism proven."
