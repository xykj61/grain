# tools/selection_neighbors_witness.rish -- the GROW-SELECTION gesture on metal: name a selection's one-ring neighborhood, grow the
# selection by that ring, and iterate the grow to a fixed point, over image/scene_graph.rye's precomputed box-overlap matrix (Season G).
#
# Season G (Open Media Primitives) -- image/overlap_clusters.rye reads the WHOLE transitive closure at once and image/selection_cluster_facts.rye
# expands a selection straight to whole clusters. This rung reads the SAME growth one STEP at a time: selection_neighbors names the immediate
# ring, grow_selection adds it once, grow_to_fixpoint repeats until nothing new arrives. A reading over the graph -- no plane of its own.
#
# The crux this witness proves on metal: box overlap is NOT transitive, so ONE ring is strictly weaker than the transitive closure, yet
# ITERATING the ring reaches it exactly. Over a 3-object chain (1's box overlaps 2, 2's overlaps 3, 1's never overlaps 3), growing {1} by one
# ring reaches only {1,2} while grow_to_fixpoint reaches {1,2,3} through 2 -- exactly the connected cluster, cross-checked against
# overlap_clusters. The grow depth depends on the start (the middle {2} reaches the whole cluster in one ring, an end {1} needs two) while the
# fixed point does not; a grow never leaks across a cluster boundary; refusals by name; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/selection_neighbors_witness.rish

say "selection_neighbors: Language EN -- Season G grow-selection; ONE ring is one step of the box-overlap graph, the fixed point its transitive closure; NO float, NO tolerance."
say "selection_neighbors: Style Radiant -- compose not braid: this rung owns only the one-ring neighbor read and the grow iteration; scene_graph owns the overlap matrix, overlap_clusters owns the whole-closure clustering the selftest cross-checks. No plane of its own, no pixel written -- a reading over a reading."
say "selection_neighbors: Lens TAME -- the neighbor scan runs the object count squared over the matrix under label_max_pixels; each grow adds at least one object or halts so the fixed-point loop runs at most the object count times; a malformed selection refuses BadSelection having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/selection_neighbors"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/selection_neighbors.rye -femit-bin=${bin}"]
assert build.ok else "selection_neighbors: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "selection_neighbors: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "selection_neighbors: ${out}"

assert selftest.out contains "GREEN image-selection-neighbors" else "selection_neighbors: selftest did not print the GREEN line"
assert selftest.out contains "the GROW-SELECTION gesture" else "selection_neighbors: the grow-selection claim did not print"
assert selftest.out contains "box overlap is NOT transitive so ONE ring is strictly weaker than the transitive closure yet ITERATING the ring reaches it exactly" else "selection_neighbors: the decisive crux did not print"
assert selftest.out contains "ONE STEP STOPS SHORT, THE CLOSURE REACHES THROUGH" else "selection_neighbors: the one-step claim did not print"
assert selftest.out contains "grow_to_fixpoint reaches {1,2,3} THROUGH 2, exactly overlap_clusters' connected cluster" else "selection_neighbors: the closure cross-check did not print"
assert selftest.out contains "THE DEPTH DEPENDS ON THE START, THE FIXED POINT DOES NOT" else "selection_neighbors: the depth claim did not print"
assert selftest.out contains "A grow never leaks across a cluster boundary" else "selection_neighbors: the no-leak claim did not print"
assert selftest.out contains "a stable selection (no neighbors) is exactly a union of WHOLE clusters" else "selection_neighbors: the stable-union claim did not print"
assert selftest.out contains "each refuse BadSelection having read nothing" else "selection_neighbors: the refusal claim did not print"
assert selftest.out contains "the same selection grows to the same ring twice" else "selection_neighbors: determinism did not print"

say "selection_neighbors: GREEN on metal -- the grow-selection gesture, one ring strictly weaker than the transitive closure yet iterating to the whole cluster, the grow depth a fact about the start and never about the fixed point, no leak across a cluster boundary, refusals by name, determinism. Season G open-media."
