# tools/gism_spool_receipt_witness.rish — GISM red %73 finish: large-artifact portable receipt.
#
# Season 2, Yield. The spool arc closed red %73 and stood on chunking (spool), naming
# (spool_cloth), and owner-signed (spool_keyed). This is the arc's finishing rung:
# pond/apps/spool_receipt.rye carries a large owner-signed document's signed word *out of
# the spool* as a portable receipt — the large-artifact sibling of TACT-J2's
# publish_receipt / publish_receipt_bron. A real front-door document (SECURITY.md, too
# large for one resin) winds across resins under an owner's signature, a detached receipt
# carries the identical signed word, travels as a `format publication-v1` Bron record and
# returns byte-for-byte, still verifies offline, and the bytes reassembled from the resins
# match the receipt's SHA-256 — cross-checked here against an independent sha256sum (two
# tools, one answer). Every tamper refuses. It re-runs spool_keyed, publish_receipt, and
# publish_receipt_bron untouched — spool_receipt composes their public API only.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gism_spool_receipt_witness.rish

say "gism-red73-receipt: Language EN — a large owner-signed document's receipt travels and returns whole."
say "gism-red73-receipt: Lens TAME — the receipt vouches for bytes reassembled from resins; every tamper refused."

let zig = "vendor/zig-toolchain/zig"
let bin = "pond/bin/spool-receipt"

let build = run ["sh" "-c" "mkdir -p pond/bin && env RYE_ZIG=${zig} rye/bin/rye build pond/apps/spool_receipt.rye -femit-bin=${bin}"]
assert build.ok else "gism-red73-receipt: spool_receipt build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "gism-red73-receipt: spool_receipt selftest exited non-zero"
assert selftest.out contains "GREEN" else "gism-red73-receipt: selftest did not speak GREEN"
assert selftest.out contains "wound across 6 resins under the owner's signature" else "gism-red73-receipt: winding-under-signature missing"
assert selftest.out contains "the detached receipt carries the identical signed word" else "gism-red73-receipt: detached-receipt equality missing"
assert selftest.out contains "reassembled 2689 B from the resins" else "gism-red73-receipt: reassembly missing"
assert selftest.out contains "travelled through Bron" else "gism-red73-receipt: Bron travel missing"
assert selftest.out contains "still matching the reassembled bytes" else "gism-red73-receipt: post-travel match missing"
assert selftest.out contains "tampered reassembled content refused" else "gism-red73-receipt: tamper refusal missing"
assert selftest.out contains "a wrong keeper key refused" else "gism-red73-receipt: wrong-keeper refusal missing"
assert selftest.out contains "unknown record field refused" else "gism-red73-receipt: unknown-field refusal missing"

# The digest the receipt bound is cross-checked against an independent sha256sum of the
# same real file — two tools, one answer, so the signed provenance can never drift from
# what a keeper computes by hand.
let sum = run ["sh" "-c" "sha256sum SECURITY.md | cut -d' ' -f1"]
assert sum.ok else "gism-red73-receipt: could not sha256sum SECURITY.md"
assert sum.out contains "5d34cc8b399262cfb12e593ab2ac509afce038ba661cdacab0904736defe571c" else "gism-red73-receipt: SECURITY.md sha256 drifted on disk"
assert selftest.out contains "5d34cc8b399262cfb12e593ab2ac509afce038ba661cdacab0904736defe571c" else "gism-red73-receipt: receipt digest does not match the file's sha256"

# The owner-signed store and the receipt machinery are re-run untouched — spool_receipt
# composes their public API only.
let keyed_bin = "pond/bin/spool-keyed"
let keyed_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/spool_keyed.rye -femit-bin=${keyed_bin}"]
assert keyed_build.ok else "gism-red73-receipt: spool_keyed rebuild failed"
let keyed_selftest = run ["sh" "-c" "${keyed_bin} selftest 2>&1"]
assert keyed_selftest.ok else "gism-red73-receipt: spool_keyed selftest regressed"
assert keyed_selftest.out contains "GREEN" else "gism-red73-receipt: spool_keyed did not speak GREEN"

let rcpt_bin = "pond/bin/publish-receipt"
let rcpt_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/publish_receipt.rye -femit-bin=${rcpt_bin}"]
assert rcpt_build.ok else "gism-red73-receipt: publish_receipt rebuild failed"
let rcpt_selftest = run ["sh" "-c" "${rcpt_bin} selftest 2>&1"]
assert rcpt_selftest.ok else "gism-red73-receipt: publish_receipt selftest regressed"
assert rcpt_selftest.out contains "GREEN" else "gism-red73-receipt: publish_receipt did not speak GREEN"

let bron_bin = "pond/bin/publish-receipt-bron"
let bron_build = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build pond/apps/publish_receipt_bron.rye -femit-bin=${bron_bin}"]
assert bron_build.ok else "gism-red73-receipt: publish_receipt_bron rebuild failed"
let bron_selftest = run ["sh" "-c" "${bron_bin} selftest 2>&1"]
assert bron_selftest.ok else "gism-red73-receipt: publish_receipt_bron selftest regressed"
assert bron_selftest.out contains "GREEN" else "gism-red73-receipt: publish_receipt_bron did not speak GREEN"

say "GREEN: GISM red %73 finish — a large owner-signed document's receipt travels as Bron and returns whole, matching bytes reassembled from the resins; spool_keyed, publish_receipt, publish_receipt_bron stay GREEN."
