# tools/al/ales_move_witness.rish — move: relocate a span in place, the length unchanged, the relocate-twin of ALES112's duplicate (ALES113).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES113.
# Design read: active-designing/date/20260815/20260815-012632_fill-ales113-lotus-move.md
# Stands on: lotus/timeline.rye (ALES2 — the Clip, its buf/len/samples, the EditError reused whole, and the cut + splice this rung composes), lotus/meter.rye (ALES13 — the
# peak/RMS meter, used only to prove that relocating existing samples never moves the peak). ALES112's duplicate COPIES a span (a second copy lands beside the first and the clip
# GROWS); move CARRIES one span somewhere new (the span leaves its old spot and the clip's length HOLDS) — the drag gesture every editor ships (circle a bar, drag it, and it lifts
# out of one place and lands at another: the verse pulled ahead of the chorus, the loop nudged whole to a new beat). Naming it beside duplicate completes the copy/relocate pair.
#
# lotus/move.rye copies the span into one bounded scratch buffer, then removes it in place through ALES2's cut and reinserts it at dest through ALES2's splice — the net length
# unchanged, no third primitive invented, refusing BadRange for a start past the samples, a count past the remainder, or a dest past len − count before any write. The crux is four
# laws. THE MOVE LAW: the clip is the removed timeline with the span reinserted at dest. THE INVERSE LAW: move then move(dest, count, start) returns the original byte for byte.
# THE PRESERVATION / PEAK LAW: move relocates existing samples and invents none, so the peak (re-measured through ALES13) is unchanged. THE DEGENERATE / REFUSAL LAW: count 0 the
# identity, dest = start the identity, a bad range BadRange.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_move_witness.rish

say "ales-move: Language EN — move lifts the count samples starting at start out of the timeline and reinserts them at dest, so the span is relocated and the clip's length holds. It is the relocate-twin of ALES112's duplicate: duplicate copies a span (a second copy lands beside the first and the clip grows), move carries one span somewhere new (the span leaves its old spot and the clip stays the same length). This is the drag gesture every editor ships — circle a bar, drag it, and it lifts out of one place and lands at another: the verse pulled ahead of the chorus, the stray breath slid to a rest, the loop nudged whole to a new beat. It relocates existing samples, inventing none."
say "ales-move: Style Radiant — the rule is stated positively: copy the span into one bounded scratch buffer, then remove it in place through ALES2's cut and reinsert it at dest through ALES2's splice, the net length unchanged and no third primitive invented. dest names a position in the removed timeline (0 ≤ dest ≤ len − count), so dest = start is the identity and the inverse is move(dest, count, start). It names the copy-vs-relocate pair beside duplicate. The crux stands out as four laws: the move law (the clip is the removed timeline with the span reinserted at dest), the inverse law (move then move(dest, count, start) returns the original byte for byte), the preservation / peak law (move relocates existing samples, so the peak is unchanged), and the degenerate / refusal law (count 0 the identity, dest = start the identity, a bad range BadRange)."
say "ales-move: Lens TAME — one mono clip of i16 PCM whose span is relocated in place, the length held; the span is copied into one bounded scratch buffer (its budget max_clip, the same bound the Clip's own buffer names), then removed through the proven cut and reinserted through the proven splice, so the net length is unchanged and splice can never refuse ClipFull; every range is refused by name before any write (BadRange for a start or count outside the samples or a dest past len − count, all checked without underflow), reusing ALES2's EditError whole and inventing none of its own; the inverse is proven against a second move and the unchanged peak against ALES13's read-only meter; it invents no sample, changes no value, and reads no byte past len; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/move"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/move.rye -femit-bin=${bin}"]
assert build.ok else "ales-move: build failed — ${build.err}"

let outfile = "lotus/bin/move.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-move: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-move: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-move' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-move: selftest did not print the GREEN ales-move line"
