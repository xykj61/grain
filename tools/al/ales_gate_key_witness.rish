# tools/al/ales_gate_key_witness.rish — the keyed gate: the door opened by another signal (ALES65).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES65.
# Design read: active-designing/date/20260814/20260814-190149_fill-ales65-lotus-keyed-gate.md
# Stands on: lotus/timeline.rye (ALES2 — the Clip, sample_min/sample_max, max_clip, the range law shape); lotus/gate.rye (ALES51 —
# the silenced floor this drives); lotus/hold_env.rye (ALES56 — the HELD time base); lotus/gate_env_hold.rye (ALES57 — the
# attack/hold/release gate this keys, re-proven below, and equalled byte-for-byte by a self-key).
#
# lotus/gate_key.rye drives ALES51's silenced floor from ALES56's HELD follower advanced on a KEY clip rather than on the target it
# processes: the door opens when the key is loud and closes when it falls quiet — the mirror of ALES63's ducking compressor. The
# selftest proves: silence stays silence; a self-key reduces to ALES57's attack/hold/release gate byte-for-byte (the grounding law,
# both tools run); a loud key opens the gate (a quiet target passes whole where the in-line gate would silence it); a silent key
# closes the gate (a loud target attenuated where the in-line gate would pass it — the e == 0 branch, the case the compressor never
# faced, the gate's gain den/num applied directly with no divide by zero); unit ratio is the identity everywhere; a gated target keeps
# its sign and never expands; the state carries so a span in two pieces equals the whole once; a bad threshold refuses BadThreshold, a
# sub-unity ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, a short key
# BadKey. Purely local — no lookahead, no network, no keys, no funds, no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_gate_key_witness.rish

say "ales-gate-key: Language EN — ALES65 completes the third tool ALES63 named: the keyed gate, the exact mirror of the sidechain compressor. Where the compressor ducks the target when the key gets loud (it acts above the threshold), the gate opens the target when the key is loud and closes it when the key falls quiet (it acts below). A gate triggered by a click track so a pad speaks only on the beat, a tom gated by its own close mic so the kit's bleed stays silent, a synth chopped by a drum loop — all one primitive, a detector that listens to a KEY while the gain lands on a TARGET."
say "ales-gate-key: Style Radiant — the law is stated positively: a self-key IS the ordinary ALES57 attack/hold/release gate byte-for-byte (the grounding law — the keyed gate generalizes the proven in-line gate, both tools run), a loud key opens the gate (a quiet target passes whole where the in-line gate would silence it), a silent key closes the gate (a loud target attenuated where the in-line gate would pass it), unit ratio is the identity everywhere, and the state carries — env and hold_left both — so a span in two pieces equals the whole once."
say "ales-gate-key: Lens TAME — a read-only key beside the mutable target, u32 span, i16 samples, i64 envelope, u32 hold counter; the one care the compressor did not need is the e == 0 case (a silent key over a loud target, the fully-closed gate): the gate's below-threshold gain gat/e is algebraically den/num (the envelope cancels), so the e == 0 branch applies den/num directly with no divide by zero, and for a self-key it writes zero over zero; threshold in [1, sample_max], ratio at least unity with a nonzero denominator, both coefficients in (0, 1], the hold bounded by max_clip, the span within the target, the key covering the span, all before any write; a bad threshold refuses BadThreshold, a sub-unity ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, a short key BadKey; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/gate_key"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/gate_key.rye -femit-bin=${bin}"]
assert build.ok else "ales-gate-key: build failed — ${build.err}"

let outfile = "lotus/bin/gate_key.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-gate-key: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-gate-key: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-gate-key' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-gate-key: selftest did not print the GREEN ales-gate-key line"

# This rung keys ALES57 with an ALES56-held detector over their public APIs — re-prove both still stand green under it.
let geh = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/gate_env_hold.rye -femit-bin=lotus/bin/gate_env_hold && lotus/bin/gate_env_hold selftest 2>&1 | grep -q 'GREEN ales-gate-env-hold' && echo yes"]
assert (trim geh.out) == "yes" else "ales-gate-key: the ALES57 attack/hold/release gate regressed under the keyed gate"

let h = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/hold_env.rye -femit-bin=lotus/bin/hold_env && lotus/bin/hold_env selftest 2>&1 | grep -q 'GREEN ales-hold-env' && echo yes"]
assert (trim h.out) == "yes" else "ales-gate-key: the ALES56 held follower regressed under the keyed gate"

say "ales-gate-key: GREEN — the keyed gate drives ALES51's silenced floor from ALES56's HELD follower advanced on a KEY clip rather than on the target, the door opening when the key is loud and closing when it falls quiet; a self-key is the ordinary ALES57 gate byte-for-byte, a loud key opens the gate, a silent key closes it (the e == 0 branch, den/num applied directly with no divide by zero), unit ratio is the identity everywhere, a gated target keeps its sign, the state carries so a span in two pieces equals the whole once; a bad threshold refuses BadThreshold, a sub-unity ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, a short key BadKey, each leaving the target untouched; the ALES57 gate and ALES56 held follower selftests stay GREEN. All three tools ALES63 named — de-esser, ducker, keyed gate — now stand as compositions of proven parts; a carried/spanning de-esser and external key routing stay taken only on Keaton's word."
