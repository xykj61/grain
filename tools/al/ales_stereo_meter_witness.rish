# tools/al/ales_stereo_meter_witness.rish -- the stereo meter during playback: two meters read both channels live (ALES17).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES17.
# Design read: active-designing/20260814-fill-ales17-lotus-stereo-meter.md
# Stands on: lotus/meter.rye (ALES13) -- the Meter, feed, peak, rms, and measure_stereo reused whole; lotus/stereo_transport.rye
# (ALES15) -- the stereo read blocks the two meters are fed, in lockstep off the one head; lotus/pan.rye (ALES10) -- the
# StereoClip whose two channels share one length.
#
# lotus/stereo_meter.rye meters a stereo master DURING playback -- a live stereo VU fed by the very blocks ALES15's stereo head
# plays. The crux: two meters read both channels in lockstep off the one head, so block-invariance holds PER CHANNEL over the
# stereo transport -- metering block by block gives the identical per-channel peak/RMS as ALES13's whole-master measure_stereo.
# The selftest proves: a fresh meter reads silence in both channels; block-invariance per channel at 1-, 2-, and 7-sample
# blocks; a loud left and quiet right report distinct levels; a rendered center pan meters 0.707 per side (700); metering
# mutates neither channel; feed refuses MeterFull. Purely local -- no network, no keys, no funds, no real device, no real meter.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_meter_witness.rish

say "ales-stereo-meter: Language EN — ALES17 meters a stereo master DURING playback: two meters read both channels live off the one stereo head, the pair a stereo VU shows."
say "ales-stereo-meter: Style Radiant — the law is stated positively: two meters read both channels in LOCKSTEP off the one head, so block-invariance holds per channel over the stereo transport — the live VU reads exactly what the stereo head plays."
say "ales-stereo-meter: Lens TAME — one ALES13 Meter per channel reused whole (no new arithmetic); the two blocks are one length from ALES15's read_block (asserted); feed forwards ALES13's MeterFull edge check; read-only, mutating neither channel; siloed to lotus/, no network, no keys, no funds, no device, no meter, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_meter"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_meter.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-meter: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_meter.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-meter: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-meter: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-meter' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-meter: selftest did not print the GREEN ales-stereo-meter line"

say "ales-stereo-meter: GREEN — two meters read both channels of a stereo master in lockstep off the one head, block-invariance holding per channel over the stereo transport. With play, loop, and meter all stereo, the read side is genuinely two-channel end to end. The next Lotus rung can name a scrub window, meter a looping stereo region, or (a module seam) a punch region tying playback back to capture."
