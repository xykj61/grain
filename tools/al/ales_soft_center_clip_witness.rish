# tools/al/ales_soft_center_clip_witness.rish -- the soft center clipper: silence the quiet middle and subtract the threshold, y = if |x| ≤ t then 0 else
# x − sign(x)-t (ALES88).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES88.
# Design read: active-designing/date/20260814/20260814-220520_fill-ales88-lotus-soft-center-clipper.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, sample_min/max) and lotus/center_clip.rye (ALES87 -- the hard center clip whose dead zone this rung
# shares and whose survivors this rung pulls toward zero by t). ALES87 silences the quiet middle and passes the loud UNCHANGED, a JUMP at the boundary;
# this rung shifts every survivor toward zero by the threshold so it rises CONTINUOUSLY from zero -- the floor-side twin of ALES79's soft clip on the ceiling.
#
# lotus/soft_center_clip.rye maps each sample to 0 when |x| ≤ thresh and to x − sign(x)-thresh otherwise. The crux is EXACT for every i16 with NO rail
# edge and NO saturate: a positive survivor lands in [1, sample_max], a negative in [sample_min, −1], the dead zone at 0; the magnitude is taken in i32 so
# |sample_min| = 32768 is representable. The map is MEMORYLESS, ODD (soft_center_clip(−x) = −soft_center_clip(x)), and NOT idempotent (each pass subtracts
# t again -- a shift, not a mask). The selftest proves it: a zero threshold is the identity; the quiet middle is silenced and the loud shifted inward by t;
# the boundary is continuous (|x| = t -> 0, |x| = t+1 -> ±1, no jump); the map is odd; soft and hard center clip silence the same dead zone and
# |soft| = |hard| − t on every survivor; a rail threshold silences all but the deepest sample (sample_min survives shifted to −1); the span discipline
# holds; a negative or over-rail threshold refuses BadThreshold and a span past the end refuses BadRange, the clip untouched. Purely local -- one magnitude,
# one compare, one signed subtract per sample; no gain, no ceiling, no saturate, no delay line, no envelope, no anti-aliasing, no network, no keys, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_soft_center_clip_witness.rish

say "ales-soft-center-clip: Language EN — the hard center clipper (ALES87) silences the quiet middle and passes the loud UNCHANGED, leaving a JUMP at the boundary (|x| = t+1 leaps to t+1). This rung rounds it: it silences the same quiet middle, then shifts every surviving sample TOWARD zero by exactly the threshold, so the survivor rises CONTINUOUSLY from zero — y = if |x| ≤ t then 0 else x − sign(x)·t. The floor-side twin of ALES79's soft clip on the ceiling; the classic hiss remover of noise reduction, the static curve of a downward expander."
say "ales-soft-center-clip: Style Radiant — the law is stated positively: the loud is kept WHOLE minus the threshold, the quiet middle SILENCED. The crux is EXACT for every i16 with NO rail edge and NO saturate — a positive survivor lands in [1, sample_max], a negative in [sample_min, −1], the dead zone at 0; the magnitude is taken in i32 so |sample_min| = 32768 is representable. The map is MEMORYLESS and ODD; it is NOT idempotent (each pass subtracts t again — a shift, not a mask, stated plainly). On every survivor |soft| = |hard| − t: the soft form is ALES87 pulled toward zero by exactly the threshold, silencing the same dead zone."
say "ales-soft-center-clip: Lens TAME — one mono clip of i16 PCM soft-center-clipped in place over a span; y = (if |x| ≤ thresh then 0 else x − sign(x)·thresh) fitting the rail by construction (no saturate); the map is memoryless (every output depends only on its own input); a threshold outside [0, sample_max] refuses BadThreshold and a span outside the samples refuses BadRange, each before any write, the clip untouched on refusal; siloed to lotus/, no gain, no ceiling, no saturate, no delay line, no envelope, no anti-aliasing, no snapshot, no network, no keys, no funds, no device, no speaker, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/soft_center_clip"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/soft_center_clip.rye -femit-bin=${bin}"]
assert build.ok else "ales-soft-center-clip: build failed — ${build.err}"

let outfile = "lotus/bin/soft_center_clip.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-soft-center-clip: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-soft-center-clip: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-soft-center-clip' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-soft-center-clip: selftest did not print the GREEN ales-soft-center-clip line"
