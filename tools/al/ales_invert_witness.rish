# tools/al/ales_invert_witness.rish — invert: flip every sample's sign, the exact VALUE-mirror of reverse (ALES105).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES105.
# Design read: active-designing/date/20260815/20260815-003415_fill-ales105-lotus-invert.md
# Stands on: lotus/timeline.rye (ALES2 — the Clip and its buf/len/samples, and `saturate`, reused so the rail lives in one place), lotus/meter.rye (ALES13 — the peak/RMS
# meter, used only to prove a sign flip off the rail moves no loudness). Invert is the "Invert" / "Invert Phase" menu item every editor and DAW ships, and it earns real
# reach — a phase flip brings two mics on one source into agreement, cancels a difference signal, folds a stereo side. Where ALES104's reverse changes every POSITION and
# no value, invert changes every VALUE and no position — its exact mirror on the other axis.
#
# lotus/invert.rye walks the clip once and replaces each sample with saturate(-x) — one in-place pass of len writes, no allocation. The crux is four laws. THE VALUE-MIRROR
# LAW: invert lands a hand-inverted vector exactly, every value flipped and no seat moved. THE INVOLUTION LAW, WITH AN HONEST RAIL: invert twice is the identity off the
# floor, yet sample_min (-32768) negates to +32768 which saturates to +32767 and round-trips to -32767 — the fixed two's-complement asymmetry, saturated by design not
# wrapped. THE MAGNITUDE LAW: off the rail the peak magnitude (re-measured through ALES13) is unchanged. THE FIXPOINT LAW: the all-zero and empty clips are each their own
# invert. The selftest proves all four.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_invert_witness.rish

say "ales-invert: Language EN — invert is the Invert (or Invert Phase) menu item every editor and DAW ships: flip every sample's sign, the whole clip mirrored about the zero line. It earns real reach — a phase flip brings two mics on one source into agreement, cancels a difference signal, folds a stereo side. Each sample x becomes saturate(-x); no seat moves."
say "ales-invert: Style Radiant — the rule is stated positively: replace each sample with saturate(-x), reusing ALES2's one true clamp so the signed rail lives in one place; the length is untouched. Where ALES104's reverse changes every position and no value, invert changes every value and no position — its exact mirror on the other axis. The crux stands out as four laws: the value-mirror law (invert lands the hand-inverted vector exactly), the involution law with an honest rail (invert twice is the identity off the floor; sample_min saturates and round-trips to -32767), the magnitude law (off the rail the peak is unchanged), and the fixpoint law (the all-zero and empty clips each their own invert)."
say "ales-invert: Lens TAME — one mono clip of i16 PCM flipped about zero in one in-place pass of len writes, no allocation and no second buffer; it flips existing samples and fabricates none, changes no length, and reads no byte past len; it names no span, so it forwards no EditError — total on any legal Clip; saturation is not re-derived — invert calls timeline.saturate, the same clamp gain uses, so +32768 (sample_min's true negation) pins to sample_max in exactly one place; the magnitude law is checked through ALES13's read-only meter; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/invert"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/invert.rye -femit-bin=${bin}"]
assert build.ok else "ales-invert: build failed — ${build.err}"

let outfile = "lotus/bin/invert.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-invert: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-invert: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-invert' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-invert: selftest did not print the GREEN ales-invert line"
