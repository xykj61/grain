# tools/al/ales_rotate_witness.rish — rotate: cyclic left-shift the whole clip by k samples, the third pure rearrangement beside reverse and invert (ALES106).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES106.
# Design read: active-designing/date/20260815/20260815-003935_fill-ales106-lotus-rotate.md
# Stands on: lotus/timeline.rye (ALES2 — the Clip and its buf/len/samples), lotus/meter.rye (ALES13 — the peak/RMS meter, used only to prove a permutation moves no
# loudness). A cyclic shift is the loop-aligning gesture behind every "rotate the loop to the downbeat", every phase-aligned wavetable, every circular buffer read at an
# offset. It completes the POSITION family beside ALES104's reverse (end-for-end) and ALES105's invert (the value-mirror); like reverse it invents no sample, drops none,
# and rounds nothing — a permutation, exact by construction.
#
# lotus/rotate.rye reduces the shift modulo the length, then rotates in place by the classic three-reversal identity — reverse [0, k), reverse [k, len), reverse [0, len) —
# standing on the same swap primitive reverse is built from, no second buffer. The crux is four laws. THE SHIFT LAW: rotate_left(k) lands a hand-rotated vector exactly,
# result[j] = original[(j+k) mod len]. THE MODULAR LAW: rotate by 0, len, or a full turn is the identity, and rotate(k) equals rotate(k mod len), so no over-long shift is
# out of range. THE COMPOSITION-AND-INVERSE LAW: rotate(k1) then rotate(k2) equals rotate(k1+k2), and rotate(k) then rotate(len-k) returns to the byte. THE PERMUTATION
# LAW: length and the peak magnitude (re-measured through ALES13) unchanged, no value moving only its seat. The selftest proves all four plus the degenerate fixpoints.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_rotate_witness.rish

say "ales-rotate: Language EN — rotate is a cyclic left-shift: slide the whole clip left by k samples and wrap the k that fall off the front back onto the tail. It is the loop-aligning gesture behind every rotate-the-loop-to-the-downbeat, every phase-aligned wavetable, every circular buffer read at an offset. It reseats samples and fabricates none."
say "ales-rotate: Style Radiant — the rule is stated positively: reduce the shift modulo the length (an over-long shift is the equivalent short one), then rotate in place by three range-reversals — reverse [0,k), reverse [k,len), reverse [0,len) — standing on the same swap primitive ALES104's reverse is built from, no second buffer. It completes the position family beside reverse (end-for-end) and invert (the value-mirror). The crux stands out as four laws: the shift law (rotate_left(k) lands the hand-rotated vector exactly), the modular law (rotate by 0, len, or a full turn is the identity, and rotate(k) equals rotate(k mod len)), the composition-and-inverse law (rotations add, and rotate(k) then rotate(len-k) returns to the byte), and the permutation law (length and peak unchanged)."
say "ales-rotate: Lens TAME — one mono clip of i16 PCM rotated cyclically in place through three range-reversals, no allocation and no second buffer; it reseats existing samples and fabricates none, changes no length, and reads no byte past len; the shift is reduced modulo the length before any work, so it names no out-of-range span and forwards no EditError — total on any legal Clip; the permutation law is checked through ALES13's read-only meter (peak before equals peak after); siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/rotate"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/rotate.rye -femit-bin=${bin}"]
assert build.ok else "ales-rotate: build failed — ${build.err}"

let outfile = "lotus/bin/rotate.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-rotate: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-rotate: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-rotate' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-rotate: selftest did not print the GREEN ales-rotate line"
