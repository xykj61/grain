# tools/al/ales_stereo_transport_witness.rish -- the stereo transport: one head reading two channels (ALES15).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES15.
# Design read: active-designing/20260814-fill-ales15-lotus-stereo-transport.md
# Stands on: lotus/transport.rye (ALES7) -- the single-position Transport head reused whole; lotus/pan.rye (ALES10) -- the
# StereoClip whose two channels share one length; lotus/clock.rye (ALES5) -- seek/elapsed in real time; lotus/timeline.rye
# (ALES2) -- the Clip each channel is. Plays back a master rendered by lotus/power.rye (ALES11).
#
# lotus/stereo_transport.rye makes the read side genuinely stereo: one head advances through both channels in LOCKSTEP,
# because a stereo master's two channels share one length (ALES10's StereoClip invariant). The selftest proves: reading fixed
# blocks concatenates back to EACH channel byte-for-byte, both channels aligned; the last block short and the read past the
# end empty; at_end exact; mismatched out buffers refuse BadBlock; seek_ms/elapsed_ms round-trip a real moment, a seek past
# the master refusing PastEnd; a StereoClip rendered by ALES11's power.render_stereo plays back exactly; the transport reads
# only, never mutating the master. Purely local -- no network, no keys, no funds, no real device, no real speaker.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_transport_witness.rish

say "ales-stereo-transport: Language EN — ALES15 plays a stereo master: one head reading both channels together, the read side finally as wide as the stereo side that built the second channel."
say "ales-stereo-transport: Style Radiant — the law is stated positively: one head reads both channels in LOCKSTEP because a stereo master's two channels share one length, so left and right never drift and each concatenates back byte-for-byte."
say "ales-stereo-transport: Lens TAME — reuses ALES7's single Transport head whole (no second cursor); refuses BadBlock / PastEnd by name; bounds proven within the shared length; read-only, never mutating the master; siloed to lotus/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_transport"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_transport.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-transport: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_transport.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-transport: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-transport: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-transport' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-transport: selftest did not print the GREEN ales-stereo-transport line"

say "ales-stereo-transport: GREEN — one head reads both channels in lockstep, each concatenating back byte-for-byte, and a power-rendered stereo master plays back exactly. The next Lotus rung can meter a stereo master during playback, loop a stereo region, or drive the paused two-channel sound-card write."
