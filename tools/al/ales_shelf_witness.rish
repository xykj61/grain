# tools/al/ales_shelf_witness.rish — a two-band tone shelf: bass and treble from the one-pole split (ALES41).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES41.
# Design read: active-designing/date/20260814/20260814-161231_fill-ales41-lotus-tone-shelf.md
# Stands on: lotus/tone.rye (ALES40 — the low-pass/high-pass split) and lotus/timeline.rye (ALES2 — the Clip and saturate).
#
# lotus/shelf.rye scales ALES40's low band and high band independently and sums them — the everyday bass/treble equalizer.
# The selftest proves: silence stays silence; unity on both bands is the identity (the bands reconstruct the input); bass
# scales direct current while treble leaves it untouched (the knobs are orthogonal at direct current); a boost SATURATES
# rather than wraps (scale in the wide domain, clamp once — ALES8's fader lesson); a zero/above-one coefficient refuses
# BadCoeff, a zero band denominator BadGain, an out-of-range span BadRange leaving the clip untouched. Purely local — no
# network, no keys, no funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_shelf_witness.rish

say "ales-shelf: Language EN — ALES41 turns ALES40's low/high split into two knobs: bass and treble, each boosting or cutting its band, the everyday equalizer."
say "ales-shelf: Style Radiant — the law is stated positively: unity on both bands reconstructs the input exactly, bass moves direct current and treble does not (orthogonal knobs), and a boost saturates rather than wraps."
say "ales-shelf: Lens TAME — bounded Clip, u32 span, i16 samples; the low band lives in a scratch copy so the high band's minuend stays intact; each band scaled in i64 and the sum clamped once (ALES8's fader lesson); an illegal coefficient refuses BadCoeff, a zero band denominator BadGain, an out-of-range span BadRange, each before a write; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/shelf"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/shelf.rye -femit-bin=${bin}"]
assert build.ok else "ales-shelf: build failed — ${build.err}"

let outfile = "lotus/bin/shelf.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-shelf: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-shelf: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-shelf' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-shelf: selftest did not print the GREEN ales-shelf line"

say "ales-shelf: GREEN — a two-band tone shelf gives a keeper bass and treble from ALES40's proven split, flat staying truly flat and a boost meeting the ceiling gracefully. The next Lotus rung can add a mid band, carry the filter state across a re-berthed span, or name the crossover in hertz through a real time base."
