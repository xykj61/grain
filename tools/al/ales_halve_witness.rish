# tools/al/ales_halve_witness.rish -- the half-wave rectifier: keep the positive half, zero the negative, y = max(x, 0) (ALES85).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES85.
# Design read: active-designing/date/20260814/20260814-214355_fill-ales85-lotus-half-wave-rectifier.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, sample_min/max). The full-wave rectifier (ALES84) folds the negative half UP onto the positive side
# (y = |x|, pure EVEN harmonics); the half-wave rectifier is its plain sibling -- it folds the negative half AWAY to silence. Where a diode BRIDGE makes
# full-wave rectification, a SINGLE diode makes half-wave. A keeper who wants a boosted or negatively-clamped half-wave composes this with ALES78's drive
# over the same span -- both in-place span maps that compose.
#
# lotus/halve.rye maps each sample to max(x, 0) -- the positive half kept whole, the negative half silenced. The crux is the complement of ALES84's:
# where |x| is exact for every i16 EXCEPT sample_min (which must saturate), max(x, 0) is EXACT for EVERY i16 with NO rail edge at all, so NO saturate is
# needed. Harmonically it is the even+odd mix: max(x, 0) = (x + |x|) / 2 carries the fundamental (odd) plus even harmonics plus a DC term, half the
# amplitude of the full-wave's pure-even doubling. The map is MEMORYLESS, IDEMPOTENT (a non-negative sample maps to itself), and always NON-NEGATIVE. The
# selftest proves it: non-negatives pass unchanged; negatives fold to silence (−1->0, −100->0, −12345->0, sample_min->0); there is no rail edge (sample_min
# maps to 0, not a saturate); every output is non-negative and the map is idempotent; the half-wave output is the full-wave output MASKED to the
# positive half (+a,−a -> a,0 where full-wave gave a,a); the span discipline holds; a span past the end refuses BadRange (the half-wave rectifier names no
# other fault -- max(x, 0) has no illegal parameter), the clip untouched. Purely local -- one compare-and-keep per sample; no gain, no ceiling, no
# threshold, no saturate, no delay line, no anti-aliasing, no network, no keys, no funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_halve_witness.rish

say "ales-halve: Language EN — the full-wave rectifier (ALES84) folds the whole negative half of the wave UP onto the positive side (y = |x|, pure EVEN harmonics). The half-wave rectifier is its plain sibling: it keeps the positive half and folds the negative half AWAY to silence — y = max(x, 0). Where a diode BRIDGE (four diodes) makes full-wave rectification, a SINGLE diode makes half-wave — it passes current one way and blocks it the other: the single-diode clipper of a crystal radio, the octave-up voice of a one-diode fuzz."
say "ales-halve: Style Radiant — the law is stated positively: the positive half of the wave is kept WHOLE, the negative half SILENCED. The crux is the complement of ALES84's — where |x| is exact for every i16 EXCEPT sample_min (whose magnitude 32768 overflows the rail and must saturate), max(x, 0) is EXACT for EVERY i16 with NO rail edge at all: a non-negative sample passes unchanged, a negative sample becomes 0, and NO saturate is needed. Harmonically the half-wave rectifier is the even+odd mix — max(x, 0) = (x + |x|) / 2 carries the fundamental (odd) plus the even harmonics plus a DC term, half the amplitude of the full-wave's pure-even doubling. The map is MEMORYLESS, IDEMPOTENT (a non-negative sample maps to itself), and always NON-NEGATIVE."
say "ales-halve: Lens TAME — one mono clip of i16 PCM half-wave-rectified in place over a span; y = (if x > 0 then x else 0) with no wide intermediate and no saturate (max(x, 0) never leaves [0, sample_max]); the map is memoryless (every output depends only on its own input); a span outside the samples refuses BadRange before any write, the clip untouched on refusal, and no other fault exists (max(x, 0) has no illegal parameter); siloed to lotus/, no gain, no ceiling, no threshold, no saturate, no delay line, no anti-aliasing, no snapshot, no network, no keys, no funds, no device, no speaker, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/halve"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/halve.rye -femit-bin=${bin}"]
assert build.ok else "ales-halve: build failed — ${build.err}"

let outfile = "lotus/bin/halve.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-halve: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-halve: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-halve' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-halve: selftest did not print the GREEN ales-halve line"
