# tools/al/ales_preset_witness.rish — a keeper loads a named effect chain from a small catalog, and receives a chain already legal
# for their clip, verify-before-trust (ALES219).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES219.
# Design read: active-designing/date/20260815/20260815-132711_fill-ales219-lotus-preset.md
# Idiom kin: lotus/render.rye (ALES217, the Step and the render this catalog feeds) · lotus/stereo_render.rye (ALES218). This
# rung seats the small catalog of named chains a keeper loads by name — the render family's other half, the keeper who does not
# want to hand-assemble a chain of Step records.
#
# lotus/preset.rye maps a plain name to a Preset (from_name) and builds a chain already clamped to the clip (build), so render
# never refuses a preset for BadRange whatever the length. The selftest proves: from_name round-trips every catalog name and
# refuses a stranger (the name law); every preset builds a chain render accepts at three clip lengths (the legal-chain law); a
# preset renders byte-for-byte to the same gestures by hand (the hand law); two presets render one clip to two files (the
# distinct law); no preset exceeds max_preset_steps (the bound law). Only gain · fade · invert composed — no new acoustic fact.
# A byte container only — no real file opened, no DAC, no network, no keys, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_preset_witness.rish

say "ales-preset: Language EN — ALES219 seats the render family's other half: a small catalog of named chains a keeper loads by name, receiving a chain already legal for their clip rather than hand-assembling Step records."
say "ales-preset: Style Radiant — the name law (from_name round-trips every catalog word), the legal-chain law (clamped spans render accepts at every length), and the hand law (byte-for-byte to the same gestures by hand) each named and proven."
say "ales-preset: Lens TAME — the preset owns the span arithmetic and clamps every span to the clip, so render never refuses a preset for BadRange; only gain, fade, and invert are composed, no new acoustic fact; siloed to lotus/, no real file, no DAC, no network, no keys, no funds, no real device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/preset"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/preset.rye -femit-bin=${bin}"]
assert build.ok else "ales-preset: build failed — ${build.err}"

let outfile = "lotus/bin/preset.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-preset: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-preset: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-preset' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-preset: selftest did not print the GREEN ales-preset line"

say "ales-preset: GREEN — a keeper loads a named chain from the catalog and renders it, legal for any clip length and byte-for-byte to the same gestures by hand; the next Lotus rung can grow the catalog, carry a preset over both channels of a StereoClip, or let a keeper save their own chain as a named preset."
