# tools/al/ales_expand_env_hold_witness.rish -- an attack/hold/release downward expander: the held quartet made whole (ALES62).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES62.
# Design read: active-designing/date/20260814/20260814-184011_fill-ales62-lotus-attack-hold-release-expander.md
# Stands on: lotus/timeline.rye (ALES2); lotus/expand.rye (ALES60 -- the deepened floor); lotus/hold_env.rye (ALES56 -- the HELD time
# base); lotus/expand_env.rye (ALES61 -- the un-held attack/release expander this reduces to at a hold of zero, re-proven below).
#
# lotus/expand_env_hold.rye advances the ALES56 HELD follower one step per sample and, when the held envelope falls below the
# threshold, widens its deficit by the ratio (ALES60's law) and applies that gain to the raw sample. The selftest proves: silence
# stays silence; a hold of zero reduces to the plain ALES61 expander byte-for-byte; unit ratio is the identity everywhere; a quiet
# signal's floor deepens with the sign held and the magnitude never expanding; a nonzero hold keeps the expander idle across a brief
# dip (it does not pump, the knob monotone); the state carries (env and hold_left both) so a span in two pieces equals the whole
# once; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, a
# hold past max_clip BadHold, an out-of-range span BadRange. Purely local -- no lookahead, no network, no keys, no funds, no device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_expand_env_hold_witness.rish

say "ales-expand-env-hold: Language EN — ALES62 gives the downward expander a hold knob by driving ALES60's deepened floor from ALES56's HELD envelope follower, the fourth and last member to earn it. On a fall away from a peak the hold pins the peak for a little while before the release begins, so the widening stays idle through a brief dip and the passage stays whole — the expander does not pump. With this rung the held dynamics quartet is complete: gate, compressor, limiter, expander all reading ALES56's one proven held follower, the exact mirror of the un-held quartet."
say "ales-expand-env-hold: Style Radiant — the law is stated positively: a hold of zero reduces to the plain ALES61 attack/release expander byte-for-byte (the zero-hold limit), unit ratio is the identity everywhere, a nonzero hold keeps the expander idle across a brief dip (the knob monotone, the dip strictly louder held), and the state carries — env and hold_left both — so a span split mid-hold equals the whole once, the seam invisible."
say "ales-expand-env-hold: Lens TAME — bounded Clip, u32 span, i16 samples, i64 carried envelope, u32 carried hold; the threshold checked in [1, sample_max], the ratio at least unity with a nonzero denominator, both coefficients in (0,1] by the follower's one rule, the hold bounded by max_clip, all before any write; the deficit widened in i64 and floored at zero so the expanded envelope is at most the envelope, the gain in [0,1] and every written magnitude at most the input's; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange; siloed to lotus/, no lookahead, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/expand_env_hold"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/expand_env_hold.rye -femit-bin=${bin}"]
assert build.ok else "ales-expand-env-hold: build failed — ${build.err}"

let outfile = "lotus/bin/expand_env_hold.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-expand-env-hold: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-expand-env-hold: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-expand-env-hold' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-expand-env-hold: selftest did not print the GREEN ales-expand-env-hold line"

# The held expander reduces to the un-held ALES61 expander at a hold of zero -- re-prove ALES61 still stands green beneath the new rung.
let unheld = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/expand_env.rye -femit-bin=lotus/bin/expand_env && lotus/bin/expand_env selftest 2>&1 | grep -q 'GREEN ales-expand-env' && echo yes"]
assert (trim unheld.out) == "yes" else "ales-expand-env-hold: the ALES61 attack/release expander witness regressed under the held expander"

# The held time base is ALES56's proven follower -- re-prove it too, so the rung rests on both parents.
let held = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/hold_env.rye -femit-bin=lotus/bin/hold_env && lotus/bin/hold_env selftest 2>&1 | grep -q 'GREEN ales-hold-env' && echo yes"]
assert (trim held.out) == "yes" else "ales-expand-env-hold: the ALES56 held follower witness regressed under the held expander"

say "ales-expand-env-hold: GREEN — an attack/hold/release downward expander drives ALES60's deepened floor from ALES56's HELD envelope; a hold of zero reduces to the plain ALES61 expander byte-for-byte, unit ratio is the identity everywhere, a quiet signal's floor deepens with the sign held and the magnitude never expanding, a nonzero hold keeps the expander idle across a brief dip (the knob monotone), and the state carries — env and hold_left both — so a span in two pieces equals the whole once; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an illegal coefficient BadCoeff, a hold past max_clip BadHold, an out-of-range span BadRange, each leaving the clip untouched; the ALES61 expander and ALES56 held follower stay GREEN beneath it. The HELD dynamics quartet is now whole — gate, compressor, limiter, expander all reading ALES56's one proven held follower, the exact mirror of the un-held quartet. The next Lindy-first crux is a new dynamics gesture (a de-esser over the band filter, a sidechain) or the lookahead delay for a true brickwall — a Keaton's-word horizon."
