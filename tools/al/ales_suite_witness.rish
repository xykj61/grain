tools/al/ales_reverb_mix_witness.rish" "tools/al/ales_reverb_pan_witness.rish" "tools/al/ales_reverb_place_witness.rish" "tools/al/ales_reverb_predelay_witness.rish" "tools/al/ales_reverb_preset_witness.rish" "tools/al/ales_reverb_shelf_witness.rish" "tools/al/ales_reverb_time_witness.rish" "tools/al/ales_reverb_tone_witness.rish" "tools/al/ales_reverb_width_witness.rish" "tools/al/ales_reverb_witness.rish" "tools/al/ales_reverse_witness.rish" "tools/al/ales_ring_mod_witness.rish" "tools/al/ales_roster_witness.rish" "tools/al/ales_rotate_witness.rish" "tools/al/ales_schmitt_witness.rish" "tools/al/ales_scrub_witness.rish" "tools/al/ales_seal_witness.rish" "tools/al/ales_segment_witness.rish" "tools/al/ales_selection_witness.rish" "tools/al/ales_session_witness.rish" "tools/al/ales_shelf_witness.rish" "tools/al/ales_shift_witness.rish" "tools/al/ales_sidechain_witness.rish" "tools/al/ales_silence_span_witness.rish" "tools/al/ales_smooth_runs_witness.rish" "tools/al/ales_smooth_trim_witness.rish" "tools/al/ales_soft_center_clip_witness.rish" "tools/al/ales_soft_drive_witness.rish" "tools/al/ales_split_silence_witness.rish" "tools/al/ales_stack_witness.rish" "tools/al/ales_stereo_allpass_witness.rish" "tools/al/ales_stereo_band_witness.rish" "tools/al/ales_stereo_bell_witness.rish" "tools/al/ales_stereo_center_clip_witness.rish" "tools/al/ales_stereo_chorus_witness.rish" "tools/al/ales_stereo_collapse_silence_witness.rish" "tools/al/ales_stereo_compress_env_hold_witness.rish" "tools/al/ales_stereo_compress_env_witness.rish" "tools/al/ales_stereo_compress_witness.rish" "tools/al/ales_stereo_crop_witness.rish" "tools/al/ales_stereo_crossfade_witness.rish" "tools/al/ales_stereo_crush_witness.rish" "tools/al/ales_stereo_cut_witness.rish" "tools/al/ales_stereo_dc_remove_witness.rish" "tools/al/ales_stereo_decimate_witness.rish" "tools/al/ales_stereo_drive_witness.rish" "tools/al/ales_stereo_duplicate_witness.rish" "tools/al/ales_stereo_echo_time_witness.rish" "tools/al/ales_stereo_echo_witness.rish" "tools/al/ales_stereo_envelope_witness.rish" "tools/al/ales_stereo_expand_env_hold_witness.rish" "tools/al/ales_stereo_expand_env_witness.rish" "tools/al/ales_stereo_expand_witness.rish" "tools/al/ales_stereo_fade_witness.rish" "tools/al/ales_stereo_flanger_witness.rish" "tools/al/ales_stereo_fold_witness.rish" "tools/al/ales_stereo_gate_env_hold_witness.rish" "tools/al/ales_stereo_gate_env_witness.rish" "tools/al/ales_stereo_gate_witness.rish" "tools/al/ales_stereo_halve_neg_witness.rish" "tools/al/ales_stereo_halve_witness.rish" "tools/al/ales_stereo_hold_env_witness.rish" "tools/al/ales_stereo_infinite_clip_witness.rish" "tools/al/ales_stereo_insert_join_witness.rish" "tools/al/ales_stereo_insert_silence_witness.rish" "tools/al/ales_stereo_invert_witness.rish" "tools/al/ales_stereo_join_witness.rish" "tools/al/ales_stereo_limit_env_hold_witness.rish" "tools/al/ales_stereo_limit_env_witness.rish" "tools/al/ales_stereo_limit_witness.rish" "tools/al/ales_stereo_loop_meter_witness.rish" "tools/al/ales_stereo_loop_witness.rish" "tools/al/ales_stereo_meter_witness.rish" "tools/al/ales_stereo_move_witness.rish" "tools/al/ales_stereo_normalize_witness.rish" "tools/al/ales_stereo_notch_witness.rish" "tools/al/ales_stereo_nyquist_witness.rish" "tools/al/ales_stereo_pad_tail_witness.rish" "tools/al/ales_stereo_paste_over_witness.rish" "tools/al/ales_stereo_preset_witness.rish" "tools/al/ales_stereo_rectify_witness.rish" "tools/al/ales_stereo_render_witness.rish" "tools/al/ales_stereo_replace_witness.rish" "tools/al/ales_stereo_reverb_console_predelay_witness.rish" "tools/al/ales_stereo_reverb_early_late_witness.rish" "tools/al/ales_stereo_reverb_freeze_witness.rish" "tools/al/ales_stereo_reverb_gate_env_witness.rish" "tools/al/ales_stereo_reverb_gate_witness.rish" "tools/al/ales_stereo_reverb_mix_witness.rish" "tools/al/ales_stereo_reverb_predelay_witness.rish" "tools/al/ales_stereo_reverb_preset_witness.rish" "tools/al/ales_stereo_reverb_shelf_witness.rish" "tools/al/ales_stereo_reverb_time_witness.rish" "tools/al/ales_stereo_reverb_tone_witness.rish" "tools/al/ales_stereo_reverb_witness.rish" "tools/al/ales_stereo_reverse_witness.rish" "tools/al/ales_stereo_ring_mod_witness.rish" "tools/al/ales_stereo_rotate_witness.rish" "tools/al/ales_stereo_schmitt_witness.rish" "tools/al/ales_stereo_segment_witness.rish" "tools/al/ales_stereo_shelf_witness.rish" "tools/al/ales_stereo_shift_witness.rish" "tools/al/ales_stereo_silence_span_witness.rish" "tools/al/ales_stereo_smooth_runs_witness.rish" "tools/al/ales_stereo_smooth_trim_witness.rish" "tools/al/ales_stereo_soft_center_clip_witness.rish" "tools/al/ales_stereo_soft_drive_witness.rish" "tools/al/ales_stereo_split_silence_witness.rish" "tools/al/ales_stereo_sweep_witness.rish" "tools/al/ales_stereo_taps_witness.rish" "tools/al/ales_stereo_tone_witness.rish" "tools/al/ales_stereo_top_tail_witness.rish" "tools/al/ales_stereo_transport_witness.rish" "tools/al/ales_stereo_tremolo_witness.rish" "tools/al/ales_stereo_trim_silence_witness.rish" "tools/al/ales_stereo_tube_witness.rish" "tools/al/ales_stereo_vibrato_witness.rish" "tools/al/ales_stereo_voiced_witness.rish" "tools/al/ales_stereo_wav_witness.rish" "tools/al/ales_stereo_width_witness.rish" "tools/al/ales_stereo_zero_cross_witness.rish" "tools/al/ales_stream_witness.rish" "tools/al/ales_strip_witness.rish" "tools/al/ales_sweep_witness.rish" "tools/al/ales_taps_witness.rish" "tools/al/ales_timeline_witness.rish" "tools/al/ales_tone_carry_witness.rish" "tools/al/ales_tone_witness.rish" "tools/al/ales_top_tail_witness.rish" "tools/al/ales_track_witness.rish" "tools/al/ales_transport_witness.rish" "tools/al/ales_tremolo_witness.rish" "tools/al/ales_trim_silence_witness.rish" "tools/al/ales_tube_witness.rish" "tools/al/ales_vibrato_witness.rish" "tools/al/ales_voiced_witness.rish" "tools/al/ales_wav_witness.rish" "tools/al/ales_wire_witness.rish" "tools/al/ales_zero_cross_witness.rish" ]

# The bijection, read by the scan this choir and the every-lap meter both pull, so the roster is one question
# answered in one place (REDS %101). Singing 240 witnesses costs four to five minutes; asking whether the
# roster is whole costs two greps -- and it is the asking that catches a witness born unheard.
let roster = run ["sh" "tools/fixtures/ales_roster_bijection_scan.sh"]
assert roster.ok else "ales-suite: the roster bijection must hold before the choir sings -- ${roster.out}"
assert roster.out contains "ROSTER_OK" else "ales-suite: want the roster whole in both directions -- ${roster.out}"

let disk_c = run ["sh" "-c" "find tools -maxdepth 2 -name 'ales_*_witness.rish' -type f | grep -v ales_suite_witness | wc -l | tr -d ' \n'"]
assert disk_c.ok else "ales-suite: could not count the witnesses on disk -- ${disk_c.err}"
let n_disk = trim disk_c.out

say "ales-suite: roster whole -- ${n_disk} per-rung witnesses on disk, each registered here and each registering a real file. Singing them now."

for-each witnesses as w do assert (run ["rishi/bin/rishi" "run" w]).ok else "ales-suite: a per-rung witness went RED -- ${w}"

let unlock = run ["sh" "tools/fixtures/ales_sing_lock.sh" "free"]
assert unlock.ok else "ales-suite: could not release the sing lock -- ${unlock.out}"

say "GREEN ales-suite -- ${n_disk} Lotus witnesses registered and run, every rung of Season C's creative suite heard in one voice"
