# tools/al/ales_flanger_witness.rish — the flanger: a short modulated delay with a feedback path (ALES73).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES73.
# Design read: active-designing/date/20260814/20260814-200314_fill-ales73-lotus-flanger-feedback-modulated-delay.md
# Stands on: lotus/chorus.rye (ALES71 — the triangle-LFO driver `triangle_delay_at`); lotus/echo.rye (ALES66 — the feedback delay whose
# in-place delay-line-is-the-buffer idiom this reuses, and which a zero-depth flanger equals byte-for-byte); lotus/glide.rye (ALES70 — the
# `glide_scale` fixed-point resolution and the interpolation read); lotus/timeline.rye (ALES2 — the Clip, sample_min/max, max_clip, saturate).
#
# lotus/flanger.rye is where the modulated-delay wing and the feedback wing meet — a short modulated delay whose delayed voice is FED BACK
# into itself. It is the family's first rung that adds a genuinely new element (feedback) rather than only changing the mix. It reuses ALES71's
# triangle_delay_at driver and ALES70's fractional interpolation, yet reads them OFF THE LIVE BUFFER (ALES66's feedback) rather than a frozen
# snapshot: because the delay is at least one whole sample both neighbours sit strictly before i, so the read hears prior OUTPUT safely in
# place. The selftest proves: fb = 0 is the dry identity; a ZERO-DEPTH flanger is exactly ALES66's echo at its centre byte-for-byte (the
# periodic driver reduces to the fixed one at rest); a hand-computed modulated-feedback read matches exactly (reading the outputs just
# written); a loud constructive sum saturates rather than wraps; a period not a positive multiple of four refuses BadPeriod, a swing below one
# whole sample BadDepth, a swing top past max_clip BadDelay, a feedback at unity or a zero denominator BadFeedback, an out-of-range span
# BadRange. Purely local — no lookahead beyond the in-place feedback read, no network, no keys, no funds, no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_flanger_witness.rish

say "ales-flanger: Language EN — the chorus (ALES71) and vibrato (ALES72) read a MODULATED delay off a FROZEN snapshot of the dry, so a moving read never reads a sample it just wrote; the echo (ALES66) does the opposite, reading the LIVE buffer so each output feeds the next and the train decays. The FLANGER is where the two meet — a short modulated delay whose delayed voice is FED BACK into itself, a moving comb whose notches slide up and down and deepen with the feedback, the jet-plane whoosh a keeper reaches for by name."
say "ales-flanger: Style Radiant — the law is stated positively: a modulated fractional delay is read OFF THE LIVE OUTPUT. It reuses ALES71's triangle_delay_at driver and ALES70's interpolation read, and reuses ALES66's discipline that the delay line is the clip buffer itself. Because the delay never dips below one whole sample, both interpolation neighbours sit strictly before i — a prior output (feedback), dry, or silence — so the flanger hears its own output safely in place, the exact inversion of the chorus/vibrato snapshot, and the reason it needs none. A zero-depth flanger is exactly the echo; fb = 0 is the dry identity."
say "ales-flanger: Lens TAME — one clip of i16 PCM, a u32 span, the scaled centre/depth, a u32 period, and a plain fb num/den; no snapshot and no separate delay buffer (the buffer IS the delay line); the triangle and interpolation run in i64 and the feedback sum saturates once; a period not a positive multiple of four (or past max_clip) refuses BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a feedback at or above unity or a zero denominator BadFeedback (a runaway can never begin), a span outside the samples BadRange, all before any write, the clip untouched on refusal; siloed to lotus/, the delay in scaled sample indices and the period in samples, no lookahead, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/flanger"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/flanger.rye -femit-bin=${bin}"]
assert build.ok else "ales-flanger: build failed — ${build.err}"

let outfile = "lotus/bin/flanger.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-flanger: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-flanger: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-flanger' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-flanger: selftest did not print the GREEN ales-flanger line"

# This rung's zero-depth case equals ALES66's echo at its centre delay byte-for-byte over its public API — re-prove the feedback delay still
# stands green beside it.
let echo = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/echo.rye -femit-bin=lotus/bin/echo && lotus/bin/echo selftest 2>&1 | grep -q 'GREEN ales-echo' && echo yes"]
assert (trim echo.out) == "yes" else "ales-flanger: the ALES66 feedback delay regressed under the flanger"

say "ales-flanger: GREEN — the flanger reads a short modulated delay with a feedback path: it reuses ALES71's triangle_delay_at driver and ALES70's fractional interpolation, read OFF THE LIVE BUFFER (ALES66's feedback), because the delay is at least one whole sample so both neighbours sit strictly before i and the read hears prior output safely in place. fb = 0 is the dry identity; a zero-depth flanger is EXACTLY ALES66's echo at its centre byte-for-byte (the periodic driver reduces to the fixed one at rest); a hand-computed modulated-feedback read matches exactly (reading the outputs just written); a loud constructive sum saturates rather than wraps; a period not a positive multiple of four refuses BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a feedback at unity or a zero denominator BadFeedback, an out-of-range span BadRange, each leaving the clip untouched; the ALES66 feedback delay stays GREEN beside it. The reverb (many delays and feedbacks composed into a dense tail) is the last and largest rung of the time-based wing."
