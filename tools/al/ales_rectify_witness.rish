# tools/al/ales_rectify_witness.rish -- the full-wave rectifier: fold the wave at zero, y = |x|, the plainest even-harmonic generator (ALES84).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES84.
# Design read: active-designing/date/20260814/20260814-213747_fill-ales84-lotus-full-wave-rectifier.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, sample_min/max, the one true saturate). Where the tube drive (ALES82) coaxes even harmonics from an
# UNEVEN clip, the rectifier makes them from the purest even map: |−x| = |x|. A keeper who wants a boosted or half-wave rectification composes this
# with ALES78's drive over the same span -- both in-place span maps that compose.
#
# lotus/rectify.rye takes each sample's ABSOLUTE VALUE, folding the negative half of the wave up onto the positive side -- a one-sided, DC-heavy signal
# at DOUBLE the frequency, the plainest even-harmonic generator. |x| is exact for every i16 EXCEPT sample_min = −32768, whose magnitude 32768 overflows
# the positive rail and SATURATES to sample_max. The map is MEMORYLESS, IDEMPOTENT (a non-negative sample rectifies to itself), and always
# NON-NEGATIVE. The selftest proves it: non-negatives pass unchanged; negatives fold by hand (−1->1, −100->100, −12345->12345, −32767->32767); the rail
# edge saturates sample_min to 32767; every output is non-negative and the map is idempotent; the even-harmonic signature folds +a and −a both onto a;
# the span discipline holds; a span past the end refuses BadRange (the rectifier names no other fault -- an absolute value has no illegal parameter),
# the clip untouched. Purely local -- one negate-and-pin per sample; no gain, no ceiling, no delay line, no anti-aliasing, no network, no keys, no
# funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_rectify_witness.rish

say "ales-rectify: Language EN — the DRIVE family (ALES78–ALES83) shapes a wave by clipping, quantizing, or holding it, and three of those are ODD maps that make only odd harmonics. The rectifier is the complement: it takes the ABSOLUTE VALUE, folding the whole negative half of the wave up onto the positive side. A full-wave rectifier turns a symmetric wave into a one-sided, DC-heavy signal at DOUBLE the frequency — the diode bridge of a power supply, the octave-up fuzz of a guitar pedal, a signal made entirely of EVEN harmonics and a DC term."
say "ales-rectify: Style Radiant — the law is stated positively: the rectifier is |x| PINNED TO THE RAIL, exact everywhere the rail can hold the magnitude and one unit shy at the single sample it cannot (sample_min = −32768, whose magnitude 32768 overflows the positive rail and saturates to sample_max). Where the tube drive coaxes even harmonics from an UNEVEN clip, the rectifier makes them from the purest even map: |−x| = |x|. The map is MEMORYLESS, IDEMPOTENT (a non-negative sample rectifies to itself), and always NON-NEGATIVE — the one-sided signal is its whole point."
say "ales-rectify: Lens TAME — one mono clip of i16 PCM rectified in place over a span; mag = (if x < 0 then −x else x) in i64 so negating sample_min never overflows before the pin, then y = saturate(mag) landing every output in [0, sample_max]; the map is memoryless (every output depends only on its own input); a span outside the samples refuses BadRange before any write, the clip untouched on refusal, and no other fault exists (an absolute value has no illegal parameter); siloed to lotus/, no gain, no ceiling, no delay line, no anti-aliasing, no snapshot, no network, no keys, no funds, no device, no speaker, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/rectify"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/rectify.rye -femit-bin=${bin}"]
assert build.ok else "ales-rectify: build failed — ${build.err}"

let outfile = "lotus/bin/rectify.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-rectify: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-rectify: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-rectify' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-rectify: selftest did not print the GREEN ales-rectify line"
