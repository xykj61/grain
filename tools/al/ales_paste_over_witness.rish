# tools/al/ales_paste_over_witness.rish -- paste_over: overwrite a span in place, the length unchanged, the overwrite-twin of ALES2's splice (ALES114).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES114.
# Design read: active-designing/date/20260815/20260815-013334_fill-ales114-lotus-paste-over.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, its buf/len/samples, the EditError reused whole, and the splice the length law contrasts against), lotus/silence_span.rye
# (ALES110 -- the zero-paint overwrite this rung generalizes, imported to prove the specialization law), lotus/meter.rye (ALES13 -- the peak/RMS meter). ALES2's splice INSERTS its
# payload and GROWS the clip; paste_over writes its payload ON TOP of what is there and keeps the length -- the two paste modes every editor ships. It is also the general case of
# silence_span, which overwrites a span with zeros: paste_over overwrites it with ANY samples, so silence is the overwrite whose paint is zero.
#
# lotus/paste_over.rye writes src over [at, at+src.len) in one bounded pass, refusing BadRange when the write would run past the samples (at > len or src.len > len − at) before any
# write. The crux is four laws. THE OVERWRITE LAW: the span becomes src exactly and every sample outside it is byte for byte unchanged, the length untouched. THE SPECIALIZATION
# LAW: paste_over of a zero src equals silence_span byte for byte. THE INSERT-CONTRAST / LENGTH LAW: the same src keeps the length here and grows it by src.len through splice. THE
# DEGENERATE / REFUSAL LAW: an empty src the identity, a paste past the samples BadRange.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_paste_over_witness.rish

say "ales-paste-over: Language EN — paste_over writes the src samples over the clip in place starting at at, so the span [at, at+src.len) becomes src and every sample outside it is left exactly as it was, the length holding. It is the overwrite-twin of ALES2's splice: splice inserts its payload and grows the clip, paste_over writes its payload on top of what is there and keeps the length — the two paste modes every editor ships. It is also the general case of ALES110's silence_span, which overwrites a span with zeros: paste_over overwrites it with any samples, so silence is the overwrite whose paint is zero. Drop a corrected word onto a muffled one, punch a clean take over a flubbed bar, and the new samples land on top of the old without moving anything after them."
say "ales-paste-over: Style Radiant — the rule is stated positively: write src over [at, at+src.len) in one bounded pass, refusing BadRange when the write would run past the samples (at > len or src.len > len − at) before any write, no allocation and no second buffer. It names the insert-vs-overwrite pair beside splice and the zero-paint specialization of silence_span. The crux stands out as four laws: the overwrite law (the span becomes src exactly and the rest is unchanged, the length untouched), the specialization law (paste_over of a zero src equals silence_span byte for byte), the insert-contrast / length law (the same src keeps the length here and grows it by src.len through splice), and the degenerate / refusal law (an empty src the identity, a paste past the samples BadRange)."
say "ales-paste-over: Lens TAME — one mono clip of i16 PCM whose named span is overwritten in place, the length held; the payload is a caller slice bounded once against max_clip before it is @intCast to u32 at the std seam (a bounded seam cast, correct Tiger code), then the write lies wholly within the current samples (BadRange when at or src.len falls outside, checked without underflow — count against the remainder), refused by name before any write, reusing ALES2's EditError whole and inventing none of its own; the specialization is proven against ALES110's own silence_span and the length contrast against ALES2's own splice; it changes no length and reads no byte past len; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/paste_over"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/paste_over.rye -femit-bin=${bin}"]
assert build.ok else "ales-paste-over: build failed — ${build.err}"

let outfile = "lotus/bin/paste_over.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-paste-over: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-paste-over: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-paste-over' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-paste-over: selftest did not print the GREEN ales-paste-over line"
