# tools/al/ales_transport_witness.rish — the transport play head: read a rendered master forward, stopping at the end (ALES7).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES7.
# Design read: active-designing/20260814-fill-ales7-lotus-transport.md
# Stands on: lotus/track.rye (ALES6) — the master a transport reads; lotus/clock.rye (ALES5) — seek and elapsed speak real
# time; lotus/timeline.rye (ALES2) — the Clip the master is.
#
# lotus/transport.rye is the read side of the suite — a play head that begins at a position, reads the master forward in
# bounded blocks, and stops exactly at the end. The selftest proves: reading fixed blocks from the start concatenates back
# to the exact master (no sample skipped or repeated); the last block is honestly short and the read past the end is empty;
# at_end is exact at pos == len; seek_ms places the head at a real moment and elapsed_ms reports it back; a seek past the
# master refuses PastEnd; the transport never mutates the master (a replay reads the same bytes). Purely local — no audio
# leaves the process, no network, no keys, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_transport_witness.rish

say "ales-transport: Language EN — ALES7 opens the play head: read a rendered master forward, block by block, and stop exactly at the end. Record, edit, and now PLAY."
say "ales-transport: Style Radiant — the read side of the whole suite; every block from the start concatenates back to the exact master, the end a hard wall, time spoken through the ALES5 clock."
say "ales-transport: Lens TAME — a bounded read cursor (pos ≤ master.len), read-only over the master, seek and elapsed through the clock; refuses PastEnd, DurationTooLong by name; siloed to lotus/, no audio out, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/transport"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/transport.rye -femit-bin=${bin}"]
assert build.ok else "ales-transport: build failed — ${build.err}"

let outfile = "lotus/bin/transport.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-transport: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-transport: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-transport' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-transport: selftest did not print the GREEN ales-transport line"

say "ales-transport: GREEN — a play head reads the master forward in bounded blocks and stops exactly at the end, reading only. The next Lotus rung can add a loop, a scrub, or an equal-power crossfade curve."
