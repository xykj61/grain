# tools/al/ales_chorus_witness.rish — the chorus: a triangle-LFO modulated delay round a centre (ALES71).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES71.
# Design read: active-designing/date/20260814/20260814-194730_fill-ales71-lotus-chorus-triangle-lfo-modulated-delay.md
# Stands on: lotus/glide.rye (ALES70 — the fractional interpolation this drives with a periodic LFO instead of a one-way ramp, whose
# zero-depth case this equals byte-for-byte); lotus/timeline.rye (ALES2 — the Clip, sample_max, max_clip, and the one true saturate).
#
# lotus/chorus.rye is the first PERIODIC modulated delay. The interpolation read is ALES70's, verbatim; the new thing is how the scaled
# delay moves — a symmetric triangle round centre_scaled with EXACT anchors at the quarter points (centre at k≡0 and k≡period/2, +depth at
# period/4, −depth at 3·period/4), honestly quantized between, off a frozen dry snapshot, mixed dry at num/den and saturated once. The
# selftest proves: level = 0 is the dry identity; a ZERO-DEPTH chorus is exactly ALES70's glide at its centre byte-for-byte (the periodic
# driver reduces to the one-way one at rest); the triangle honors its four quarter anchors and repeats one period later; a hand-computed
# modulated read matches exactly; a loud wet+dry sum saturates rather than wraps; a period not a positive multiple of four refuses
# BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a wet above unity or a zero denominator BadLevel,
# an out-of-range span BadRange. Purely local — no lookahead beyond the snapshot read, no network, no keys, no funds, no real device, no
# sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_chorus_witness.rish

say "ales-chorus: Language EN — ALES70 introduced the fractional read and drove it with the simplest honest motion, a one-way glide (the flanger's sweep). The effect a keeper actually reaches for is a PERIODIC one: the delay swings gently up and back down round a centre, over and over, and the dry mixed with that slowly-detuned copy of itself is the CHORUS — one voice made to sound like several. This rung adds only the driver — the periodic waveform that chooses the scaled delay at each sample — so it is a thin, durable rung the vibrato and the flanger reuse without change."
say "ales-chorus: Style Radiant — the law is stated positively: a triangle LFO DRIVES the scaled delay round a centre. Over one period P (a positive multiple of four, q = P/4) the scaled delay is centre + triangle(depth, P, k), a symmetric wave with EXACT anchors at the quarter points — centre at k≡0 and k≡2q, +depth at q, −depth at 3q — honestly quantized between; the interpolation read is ALES70's verbatim, off a FROZEN dry snapshot, so a moving read never reads a sample it just wrote."
say "ales-chorus: Lens TAME — one clip of i16 PCM, a u32 span, the scaled centre/depth, a u32 period and a plain u32/u32 wet level; the dry prefix is snapshotted into one bounded [max_clip]i16 scratch (glide's and taps' width), the triangle, interpolation, and wet mix all run in i64 and saturate once, so nothing on the path can overflow; a period not a positive multiple of four (or past max_clip) refuses BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a wet above unity or a zero denominator BadLevel, a span outside the samples BadRange, all before any write, the clip untouched on refusal; siloed to lotus/, the delay in scaled sample indices and the period in samples, no lookahead, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/chorus"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/chorus.rye -femit-bin=${bin}"]
assert build.ok else "ales-chorus: build failed — ${build.err}"

let outfile = "lotus/bin/chorus.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-chorus: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-chorus: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-chorus' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-chorus: selftest did not print the GREEN ales-chorus line"

# This rung's zero-depth case equals ALES70's glide at its centre byte-for-byte over its public API — re-prove the gliding delay still
# stands green beside it.
let glide = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/glide.rye -femit-bin=lotus/bin/glide && lotus/bin/glide selftest 2>&1 | grep -q 'GREEN ales-glide' && echo yes"]
assert (trim glide.out) == "yes" else "ales-chorus: the ALES70 gliding delay regressed under the chorus"

say "ales-chorus: GREEN — the chorus reads a triangle-LFO modulated delay round a centre, the first periodic modulated delay: the scaled delay is centre + triangle(depth, period, k), a symmetric wave with EXACT quarter anchors, read by ALES70's fractional interpolation off a frozen dry snapshot, mixed dry and saturated once. level = 0 is the dry identity; a zero-depth chorus is EXACTLY ALES70's glide at its centre byte-for-byte (the periodic driver reduces to the one-way one at rest); the triangle honors its four quarter anchors and repeats one period later; a hand-computed modulated read matches exactly; a loud wet+dry sum saturates rather than wraps; a period not a positive multiple of four refuses BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a wet above unity or a zero denominator BadLevel, an out-of-range span BadRange, each leaving the clip untouched; the ALES70 gliding delay stays GREEN beside it. The vibrato (this delay heard wet-only) and the flanger (a shorter modulated delay with feedback) are thin later rungs that only change the mix and add the feedback path."
