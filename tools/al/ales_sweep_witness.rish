# tools/al/ales_sweep_witness.rish -- a filter sweep: a low-pass whose cutoff moves across a span, seamless because state carries (ALES44).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES44.
# Design read: active-designing/date/20260814/20260814-163647_fill-ales44-lotus-filter-sweep.md
# Stands on: lotus/tone_carry.rye (ALES43) and lotus/tone.rye (ALES40 -- low_pass_carry) and lotus/timeline.rye (ALES2 -- the Clip).
#
# lotus/sweep.rye gives ALES40's one-pole low-pass a moving coefficient: it partitions a span into blocks, filters each with a
# coefficient interpolated from num_from to num_to, and carries ONE state across every block. The selftest proves: a degenerate
# sweep (num_from == num_to) equals ALES40's fixed low_pass over the whole span byte-for-byte (the crux); the schedule's
# endpoints are exact and its interior monotone and legal within [1, den]; a distinct-endpoint sweep is genuinely time-varying
# (equal to neither endpoint's fixed filter); a constant input swept settles exactly and never dips at a seam (no re-transient);
# an illegal endpoint refuses BadCoeff, an out-of-range span BadRange, an illegal block count BadBlocks. Purely local -- no
# network, no keys, no funds, no real device, no real sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_sweep_witness.rish

say "ales-sweep: Language EN — ALES44 gives ALES40's low-pass a moving coefficient, so the filter opens or closes across a span (the sweep a musician automates over a phrase) rather than holding one brightness."
say "ales-sweep: Style Radiant — the law is stated positively: a degenerate sweep from a coefficient to itself equals the fixed low_pass byte-for-byte, a distinct-endpoint sweep genuinely moves the brightness, and every block continues the last with no re-transient at a seam."
say "ales-sweep: Lens TAME — bounded Clip, u32 span, i16 samples, a named max_sweep_blocks partition, full-precision i64 state carried across every block through ALES43's low_pass_carry; the sweep adds only a coefficient schedule, no new arithmetic on the audio path; an illegal endpoint refuses BadCoeff, an out-of-range span BadRange, an illegal partition BadBlocks, each before a write; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/sweep"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/sweep.rye -femit-bin=${bin}"]
assert build.ok else "ales-sweep: build failed — ${build.err}"

let outfile = "lotus/bin/sweep.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-sweep: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-sweep: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-sweep' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-sweep: selftest did not print the GREEN ales-sweep line"

# The sweep reuses ALES43's carried low-pass and ALES40's stepping whole -- prove they still stand by their own green, not by claim.
let carry = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/tone_carry.rye -femit-bin=lotus/bin/tone_carry && lotus/bin/tone_carry selftest 2>&1 | grep -q 'GREEN ales-tone-carry' && echo yes"]
assert (trim carry.out) == "yes" else "ales-sweep: the ALES43 carried-filter witness regressed under the sweep"

say "ales-sweep: GREEN — a filter sweep moves a low-pass's cutoff across a span, the block boundaries seamless because ALES43's i64 state carries; a sweep from a coefficient to itself equals ALES40's fixed low_pass byte-for-byte, a distinct-endpoint sweep genuinely moves the brightness, and a constant input rises to it exactly with no re-transient at any seam; the ALES43 carried-filter selftest stays GREEN. The next Lotus rung can carry the high-pass and shelf/stack into a sweep, sweep under a keeper-drawn envelope, or name a crossover in hertz through a real time base."
