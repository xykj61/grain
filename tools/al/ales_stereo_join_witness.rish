# tools/al/ales_stereo_join_witness.rish — the crossfade join carried into stereo, both channels in lockstep (ALES27).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES27.
# Design read: active-designing/20260814-fill-ales27-lotus-stereo-crossfade-join.md
# Stands on: lotus/join.rye (ALES26) — the mono crossfade `join` run once per channel over its public API, so the stereo join
# inherits the proven seam law rather than re-deriving it; lotus/pan.rye (ALES10) — the StereoClip whose two channels share one
# length, the lockstep this rung keeps.
#
# lotus/stereo_join.rye runs ALES26's mono join on each channel with the SAME overlap, so a keeper joins a stereo span and the
# seam moves through ALES12's equal-power curve in both channels while the stereo image stays aligned. The crux is atomicity:
# because a StereoClip's channels are one length and a stereo span is one length, ALES26's guards read identically for left and
# right, so the join is validated once against the shared length BEFORE either channel is touched. The selftest proves: both
# channels grow by the shared-overlap count (5,5,2 → 8 each) and stay one length; each channel carries its own audio through
# its own equal-power seam (left 1000→200, right 4000→800); a full overlap is a pure crossfade with nothing appended in both;
# and an unequal span, a short overlap, a past-the-tail overlap, and an overflow each refuse by name leaving both channels
# untouched and aligned. Purely local — no network, no keys, no funds, no real device, no real speaker.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_join_witness.rish

say "ales-stereo-join: Language EN — ALES27 carries the crossfade join into stereo: ALES26's mono join run on each channel with the same overlap, so a keeper joins a stereo span and the seam flows through ALES12's equal-power curve in both channels."
say "ales-stereo-join: Style Radiant — the law is stated positively: both channels grow by the shared-overlap count and stay one length, each carrying its own audio through its own seam — the stereo image stays aligned."
say "ales-stereo-join: Lens TAME — the mono join is reused whole over its public API (the proven law, not re-derived); atomic across the two channels — because a StereoClip's channels are one length and a stereo span is one length, the guards are validated once before either channel is touched; refuses BadRange / ClipFull by name; siloed to lotus/, no network, no keys, no funds, no device."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_join"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_join.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-join: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_join.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-join: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-join: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-join' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-join: selftest did not print the GREEN ales-stereo-join line"

say "ales-stereo-join: GREEN — the join now lands in stereo the way a keeper works, both channels crossed in lockstep. The next Lotus rung can let the graft or paste join rather than butt by default, name a trailing-seam law where the audio after an insert rejoins the timeline, or carry a held span across the ALES0 audio wire (a module seam, Keaton's word)."
