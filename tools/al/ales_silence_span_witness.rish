# tools/al/ales_silence_span_witness.rish -- silence_span: write silence over a span in place, the length-preserving third of the trim/open/overwrite trio (ALES110).
#
# Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES110.
# Design read: active-designing/date/20260815/20260815-010618_fill-ales110-lotus-silence-span.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, its buf/len/samples, the EditError reused whole, and the cut imported by the selftest to prove the length trio),
# lotus/insert_silence.rye (ALES109 -- imported by the selftest so the same span is shown growing the clip beside cut shrinking it and silence_span keeping it), lotus/meter.rye
# (ALES13 -- the peak/RMS meter, used only to prove overwriting with silence never raises the peak). ALES2's cut removes a span and SHRINKS the clip; ALES109's insert_silence
# opens a gap and GROWS the clip; silence_span OVERWRITES a span and leaves the length exactly as it is -- the Silence Audio Selection button every editor ships (drop a cough,
# mute a bleed, clear a region to quiet without moving anything around it). Naming it beside cut and insert_silence completes the trio: remove, open, or overwrite.
#
# lotus/silence_span.rye writes zero into the count samples starting at start, refusing BadRange when the span falls outside the current samples before any write -- one
# bounded pass, no second buffer. The crux is four laws. THE SILENCE LAW: the span goes all zero and the rest stays byte for byte, the length untouched. THE TRIO / LENGTH
# LAW: the same span keeps the length here, shrinks it through cut, and grows it through insert_silence. THE IDEMPOTENCE / PEAK LAW: silencing twice equals once, and the peak
# (re-measured through ALES13) is non-increasing. THE DEGENERATE / REFUSAL LAW: count 0 the identity, silence_span(0, len) all silence, the empty clip its own silence, a span
# past the samples BadRange.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_silence_span_witness.rish

say "ales-silence-span: Language EN — silence_span writes silence over a span of samples in place, leaving the length and every sample outside the span exactly as they were. It is the third way a span meets silence: ALES2's cut removes a span and shrinks the clip, ALES109's insert_silence opens a gap and grows it, and silence_span overwrites a span and keeps the length. This is the Silence Audio Selection button every editor ships — drop a cough, mute a bleed, clear a region to quiet without moving anything around it. It writes silence over an existing span, inventing no non-zero sample and moving nothing."
say "ales-silence-span: Style Radiant — the rule is stated positively: zero the span [start, start+count) in one bounded pass, refusing BadRange when the span falls outside the samples before any write, no second buffer. It names the remove-vs-open-vs-overwrite distinction beside cut and insert_silence. The crux stands out as four laws: the silence law (the span goes all zero and the rest stays byte for byte, the length untouched), the trio / length law (the same span keeps the length here, shrinks it through cut, and grows it through insert_silence), the idempotence / peak law (silencing twice equals once, and the peak is non-increasing — the loudest span strictly lowers it, an already-silent span holds), and the degenerate / refusal law (count 0 the identity, silence_span(0, len) all silence, a span past the samples BadRange)."
say "ales-silence-span: Lens TAME — one mono clip of i16 PCM cleared in place over a bounded span, no allocation and no second buffer; the span is refused by name before any write (BadRange when start or count falls outside the samples, checked without underflow — count against the remainder), reusing ALES2's EditError whole and inventing none of its own; the length trio is proven against ALES2's own cut and ALES109's insert_silence, and the non-increasing peak against ALES13's read-only meter; it invents no non-zero sample, moves nothing, changes no length, and reads no byte past len; siloed to lotus/, no real sample rate, no network, no keys, no funds, no device, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/silence_span"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/silence_span.rye -femit-bin=${bin}"]
assert build.ok else "ales-silence-span: build failed — ${build.err}"

let outfile = "lotus/bin/silence_span.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-silence-span: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-silence-span: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-silence-span' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-silence-span: selftest did not print the GREEN ales-silence-span line"
