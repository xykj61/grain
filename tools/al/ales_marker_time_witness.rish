# tools/al/ales_marker_time_witness.rish — markers in real time, a named place set and read in seconds (ALES21).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES21.
# Design read: active-designing/20260814-fill-ales21-lotus-marker-time.md
# Stands on: lotus/markers.rye (ALES20) — the sorted, unique named track and its add reused whole; lotus/clock.rye (ALES5) —
# samples_for and ms_for, the one proven seconds ↔ samples conversion, exactly as loop.mark_ms uses it; lotus/pan.rye (ALES10).
#
# lotus/marker_time.rye is the twin of ALES14's loop.mark_ms for the markers track — a keeper drops a named place in seconds and
# reads it back in seconds. The crux: a place set in seconds lands at EXACTLY samples_for(ms) and reads back the honestly-lossy
# same time, the track staying sorted and unique by ALES20's own add invariant. The selftest proves: places set in seconds out of
# order land ascending and read their ms back (exact at 1 sample/ms); the edges refuse PastEnd / DurationTooLong / Duplicate by
# name; a marker set in seconds drives a real ALES20 region_between and scrub snap. Purely local — no network, no keys, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_marker_time_witness.rish

say "ales-marker-time: Language EN — ALES21 gives the ALES20 markers track a time face: a musician marks the downbeat by seconds, not by counting samples, the twin of ALES14's loop.mark_ms."
say "ales-marker-time: Style Radiant — the law is stated positively: a place set in seconds lands at exactly the clock's samples_for(ms) and reads back the same time, the track staying sorted and unique however out of order the times arrive."
say "ales-marker-time: Lens TAME — ALES5's samples_for/ms_for and ALES20's markers.add reused whole (no new conversion, no new bound); DurationTooLong forwarded from the clock, every ALES20 edge forwarded unchanged; read-only over the master; siloed to lotus/, no network, no keys, no funds, no device, no meter, no speaker."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/marker_time"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/marker_time.rye -femit-bin=${bin}"]
assert build.ok else "ales-marker-time: build failed — ${build.err}"

let outfile = "lotus/bin/marker_time.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-marker-time: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-marker-time: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-marker-time' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-marker-time: selftest did not print the GREEN ales-marker-time line"

say "ales-marker-time: GREEN — a keeper marks a session in time: a named place set in seconds lands at its exact sample and reads its time back, driving a real loop and snap. The next Lotus rung can offer the choice of law where a crossfade meets a marked edit, name a selection (a marked span cut or gained as one), or (a module seam) a punch region armed between two timed markers, tying playback back to the Mikrophone's capture."
