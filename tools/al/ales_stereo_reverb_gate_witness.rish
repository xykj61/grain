# tools/al/ales_stereo_reverb_gate_witness.rish — the stereo gate: the reverb's GATED TAIL carried across a stereo master (ALES201).
#
# Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES201.
# Design read: active-designing/date/20260815/20260815-110035_fill-ales201-lotus-stereo-reverb-gate.md
# Stands on: lotus/stereo_reverb_preset.rye (ALES191 — the named-room stereo wet, run over the master unchanged); lotus/gate.rye (ALES49 — the
# downward gate and its guards, run per channel); lotus/pan.rye (the StereoClip); lotus/clock.rye (ALES5 — the sample clock, converting the span);
# lotus/timeline.rye (ALES2 — the Clip each channel holds, its sample_max the gate's rail); lotus/reverb_gate.rye (ALES200 — the mono gate mirrored).
#
# lotus/stereo_reverb_gate.rye carries the mono gated reverb across a stereo master — the same downward gate over BOTH channels of a StereoClip, one
# shared threshold and ratio, the image held. It reverberates the master wet in place through ALES191's stereo_reverb_preset UNCHANGED, then gates
# each channel's wet with ALES49's proven downward gate at the same threshold and ratio, no cross-channel read: ratio_num == ratio_den is the identity
# (a unit-ratio gate), a larger ratio cuts the quiet tail harder. It invents no new audio arithmetic — every gated sample is written by a proven stage
# — and it prechecks the gate's threshold and ratio (the same guards ALES49 raises) BEFORE the wet is written, so a bad gate leaves both channels DRY
# and balanced (atomic). The selftest proves on both channels: at ratio_num == ratio_den the span equals stereo_reverb_preset byte for byte; for a
# firm ratio each channel equals stereo_reverb_preset then gate on that channel byte for byte and each gated channel differs from its wet; each gated
# channel's total energy is strictly less than its wet's; the image is held (a centred master identical channel-to-channel, a stereo master distinct);
# the channels leave balanced and silence stays silence; and the faults forward atomic (a bad threshold BadThreshold and a bad ratio BadRatio with
# both channels still dry, a span past the clip DurationTooLong, an out-of-range span BadRange). Purely local — one StereoClip, a validated clock; no
# network, no keys, no funds, no real device.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_stereo_reverb_gate_witness.rish

say "ales-stereo-reverb-gate: Language EN — ALES200 gave the MONO reverb its gate (the classic gated-reverb tail, only the loud early wash heard). A keeper mixing a STEREO master still had no such knob, exactly as the tone stopped at mono before ALES199 carried it across. This rung is the thin twin ALES200 named next: the SAME gate, over BOTH channels of a StereoClip, one shared threshold and ratio, the image held."
say "ales-stereo-reverb-gate: Style Radiant — the identity edge is stated positively and proven exact on both channels: at ratio_num == ratio_den the span equals stereo_reverb_preset byte for byte (a unit-ratio gate is exactly the un-gated stereo reverb); a larger ratio cuts the below-threshold tail harder on both ears, each gated channel's total energy strictly less than its wet's — the tail is cut the way a gated reverb cuts it, the image held. The threshold is a magnitude and the ratio a plain fraction, so the gate means the same at any sample rate."
say "ales-stereo-reverb-gate: Lens TAME — one StereoClip of i16 PCM, a validated clock, and ALES191's fixed banks; NO new audio arithmetic — the gate is ALES49's proven downward gate over the proven stereo wet, run per ear; StereoReverbGateError = stereo_reverb_preset.StereoReverbPresetError || BadThreshold || BadRatio, the gate's threshold and ratio PRECHECKED before the wet is written so a bad gate leaves both channels dry and balanced (atomic), DurationTooLong / BadRange / BadThreshold / BadRatio by name before any write; siloed to lotus/, no network, no keys, no funds, no device. A wet-tail gate; a true time-following envelope gate is named as a separate horizon, not claimed."

let zig = "vendor/zig-toolchain/zig"
let bin = "lotus/bin/stereo_reverb_gate"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_reverb_gate.rye -femit-bin=${bin}"]
assert build.ok else "ales-stereo-reverb-gate: build failed — ${build.err}"

let outfile = "lotus/bin/stereo_reverb_gate.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-stereo-reverb-gate: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-stereo-reverb-gate: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-stereo-reverb-gate' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-stereo-reverb-gate: selftest did not print the GREEN ales-stereo-reverb-gate line"

# This rung runs ALES191's stereo_reverb_preset over its public API for the wet — re-prove the stereo named-room preset still stands green beside it.
let preset = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/stereo_reverb_preset.rye -femit-bin=lotus/bin/stereo_reverb_preset && lotus/bin/stereo_reverb_preset selftest 2>&1 | grep -q 'GREEN ales-stereo-reverb-preset' && echo yes"]
assert (trim preset.out) == "yes" else "ales-stereo-reverb-gate: the ALES191 stereo named-room preset regressed under its gate"

# And re-prove ALES200's mono reverb gate still stands green — the mono gate this rung mirrors per ear.
let monog = run ["sh" "-c" "env RYE_ZIG=${zig} rye/bin/rye build lotus/reverb_gate.rye -femit-bin=lotus/bin/reverb_gate && lotus/bin/reverb_gate selftest 2>&1 | grep -q 'GREEN ales-reverb-gate' && echo yes"]
assert (trim monog.out) == "yes" else "ales-stereo-reverb-gate: the ALES200 mono reverb gate regressed under its stereo twin"

say "ales-stereo-reverb-gate: GREEN — the stereo gate: the reverb's GATED TAIL across a stereo master. Reverberate the master wet in place through ALES191's stereo_reverb_preset unchanged, then gate each channel's wet with ALES49's proven downward gate at the same threshold and ratio, no cross-channel read — ratio_num == ratio_den the identity, a larger ratio cutting the quiet tail harder — no new audio arithmetic, every gated sample written by a proven stage. Proven on both channels: at ratio_num == ratio_den exactly stereo_reverb_preset byte for byte; for a firm ratio each channel equals stereo_reverb_preset then gate on that channel byte for byte and each gated channel differs from its wet; each gated channel's total energy is strictly less than its wet's; the image is held (a centred master identical channel-to-channel, a stereo master distinct); the channels leave balanced and silence stays silence; a bad threshold refuses BadThreshold and a bad ratio BadRatio with both channels still dry, a span past the clip DurationTooLong, an out-of-range span BadRange, each leaving both channels untouched; the ALES191 stereo preset and the ALES200 mono gate stay GREEN beside it. The gate axis now stands whole for mono and stereo; a shaped envelope-gate (attack/hold/release over the tail) or a fresh reverb axis (width, freeze, early/late balance) is the richer horizon."
