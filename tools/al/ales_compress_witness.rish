# tools/al/ales_compress_witness.rish -- a compressor: the limiter's ceiling made gentle (ALES50).
#
# Chapter: the Six-Chapter double-seat, Chapter C thread (Lotus - the creative suite) - waymark ALES - rung ALES50.
# Design read: active-designing/date/20260814/20260814-171338_fill-ales50-lotus-compressor.md
# Stands on: lotus/timeline.rye (ALES2 -- the Clip, sample_min/sample_max, the range law shape); lotus/limit.rye (ALES49 -- the
# brickwall this softens, re-proven below).
#
# lotus/compress.rye passes a sample within the threshold byte-for-byte and divides an above-threshold sample's excess by the
# ratio. The selftest proves: silence stays silence; below the threshold is the identity; unit ratio is the identity everywhere;
# a loud signal has its peaks reduced with the sign held and the magnitude never expanding; a higher ratio compresses at least as
# hard and a ratio far past the excess seats a peak at the threshold (the limiter within); a zero threshold refuses BadThreshold,
# a sub-unity or zero-denominator ratio BadRatio, an out-of-range span BadRange. Purely local -- no network, no keys, no funds,
# no real device, no sample rate.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/al/ales_compress_witness.rish

say "ales-compress: Language EN — ALES50 softens the limiter's brickwall into a compressor: past the threshold a signal still rises, only by a fraction (the ratio) of what it would. The most-reached-for dynamics tool — it evens a vocal so every word sits, glues a drum bus, tames a bass that jumps; at an extreme ratio the compressor IS the limiter."
say "ales-compress: Style Radiant — the law is stated positively: below the threshold is the identity, unit ratio is the identity everywhere (a 1:1 compressor passes the whole signal by construction), and above the threshold the excess divides by the ratio so the magnitude only ever shrinks and the sign is always held — a higher ratio compresses at least as hard."
say "ales-compress: Lens TAME — bounded Clip, u32 span, i16 samples; the threshold checked in [1, sample_max] and the ratio checked at least unity with a nonzero denominator before any write; the excess divided in i64 with divTrunc, a compressed magnitude at most the input's so nothing on the audio path can overflow; a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an out-of-range span BadRange; siloed to lotus/, no network, no keys, no funds, no device, no sample rate."

let zig = "vendor/zig-toolchain/zig"
# THE BINARY LANDS IN A PEN, NEVER A SHARED PATH IN THE TREE (REDS %700). A fixed path is
# one name every run in this checkout writes: one run EXECUTES it while another's linker
# opens it, and the linker refuses with ETXTBSY -- so the guard answers differently on
# bytes nobody changed. `printf %s` trims the newline a bare capture would keep.
let pen = run ["sh" "-c" "printf %s $(mktemp -d)"]
assert pen.ok else "could not make a build pen: ${pen.err_brief}"
let bin = "${pen.out}/compress"

let build = run ["sh" "-c" "mkdir -p lotus/bin && env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/compress.rye -femit-bin=${bin}"]
assert build.ok else "ales-compress: build failed — ${build.err_brief}"

let outfile = "lotus/bin/compress.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "ales-compress: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "ales-compress: ${shown.out_brief}"

let green = run ["sh" "-c" "grep -q 'GREEN ales-compress' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "ales-compress: selftest did not print the GREEN ales-compress line"

# The compressor softens the ceiling the limiter proved -- re-prove ALES49's limiter still stands green, so the two rest together.
let limit = run ["sh" "-c" "env RYE_ZIG=${zig} sh tools/fixtures/r/rye_build.sh lotus/limit.rye -femit-bin=lotus/bin/limit && lotus/bin/limit selftest 2>&1 | grep -q 'GREEN ales-limit' && echo yes"]
assert (trim limit.out) == "yes" else "ales-compress: the ALES49 peak-limiter witness regressed under the compressor"

say "ales-compress: GREEN — a compressor softens the limiter's ceiling by dividing the above-threshold excess by the ratio; below the threshold is the identity, unit ratio is the identity everywhere, a loud signal's peaks reduce with the sign held and the magnitude never expanding, a higher ratio compresses at least as hard, and a ratio far past the excess seats a peak at the threshold (the limiter within); a zero threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an out-of-range span BadRange, each leaving the clip untouched; the ALES49 limiter selftest stays GREEN. The dynamics family now holds the brickwall and its softened ratio — the next rung can invert the threshold into a gate, or give the compressor an attack and release over a real time base."

# The pen is swept here rather than left for the next run to meet.
let pen_swept = run ["sh" "-c" "rm -rf ${pen.out}"]
assert pen_swept.ok else "the build pen outlived its witness: ${pen_swept.err_brief}"
