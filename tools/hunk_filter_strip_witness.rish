# tools/hunk_filter_strip_witness.rish — the filter strip, on metal (HUNK64).
#
# Season A (Hardware & Right-to-Repair) · waymark HUNK · journey Photos app · rung HUNK64.
# Design read: active-designing/20260813-222956_hunk-filter-picker-exploration.md ("The road on from here").
# Teacher, thanked clean-room: the filter strip of a photo app (iCloud Photos / Instagram / VSCO) — a row of the same
# photo under each named filter, the chosen one framed (concept only, siloed).
#
# HUNK63 gave a keeper the filter tool; this rung paints the whole carousel. paint_strip previews every filter in the
# picker's book over the current view (HUNK33/HUNK13) and tiles the thumbnails into one Skate grid (HUNK54 idiom), a
# marker row above over the selected band. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/hunk_filter_strip_witness.rish

say "hunk-filter-strip: Language EN — HUNK64 tiles every stock filter (HUNK30) previewed over the current view (HUNK33) into one Skate strip (HUNK54 idiom), a marker row over the selected band, so a keeper reads the whole filter book at a glance."
say "hunk-filter-strip: Style Radiant — the filter carousel is finally on glass: the same picture under each named filter, side by side, the chosen one marked — read the whole book, then keep one."
say "hunk-filter-strip: Lens TAME — a pure read over three proven seams; each band equals a direct preview cell-for-cell, the marker follows the selection, the strip previews over the edited view after a commit, and a too-wide strip refuses StripTooWide; the source is never mutated; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "brushstroke/bin/filter_strip"

let build = run ["sh" "-c" "mkdir -p brushstroke/bin && env RYE_ZIG=${zig} rye/bin/rye build brushstroke/filter_strip.rye -femit-bin=${bin}"]
assert build.ok else "hunk-filter-strip: build failed — ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "hunk-filter-strip: selftest exited non-zero — ${selftest.out}"

# The claim checks use Rishi's native `contains` — the output is a Rishi value, never interpolated into a shell
# single-quoted string, so an apostrophe or brace in the GREEN line can never break a check (the loom for REDS %76).
let out = trim selftest.out
say "hunk-filter-strip: ${out}"

assert out contains "GREEN filter-strip" else "hunk-filter-strip: selftest did not print the GREEN filter-strip line"
assert out contains "tiles all nine stock filters over the current view" else "hunk-filter-strip: the strip did not tile the whole book"
assert out contains "each band equal to a direct preview cell-for-cell, no drift" else "hunk-filter-strip: a band drifted from its recipe preview"
assert out contains "the marker sits over the selected band and follows the selection" else "hunk-filter-strip: the marker did not follow the selection"
assert out contains "the strip previews every candidate over the edited" else "hunk-filter-strip: the strip previewed over the stale source after a commit"
assert out contains "a too-wide strip refuses" else "hunk-filter-strip: a too-wide strip did not refuse StripTooWide"

say "hunk-filter-strip: GREEN — the filter strip tiles every stock filter over the current view (each band a direct preview cell-for-cell), marks the selected band and follows the selection, previews over the edited view after a commit, and refuses a too-wide strip StripTooWide; no network, no key, no funds."
