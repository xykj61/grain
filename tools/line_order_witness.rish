# tools/line_order_witness.rish -- read a DIRECTED line named by TWO anchor taps (from A toward B) as a READING ORDER ALONG the line, on
# metal (Season G).
#
# Season G (Open Media Primitives) -- image/line_partition.rye reads the SIGN of the cross product over the doubled group centers, splitting
# the plane PERPENDICULAR to A -> B into LEFT / ON / RIGHT. This rung reads the DOT product of the same two anchors -- the position PARALLEL
# to the line -- and ranks every object front-to-back along it. A reading over readings, no plane of its own.
#
# The crux this witness proves on metal: along-line ORDER and across-line SIDE are ORTHOGONAL, the dot and the cross of the same two
# anchors. Two objects can tie in projection (one along-line depth) yet split to opposite sides -- U and D share a column so along_tie is
# TRUE, yet line_partition places U LEFT and D RIGHT. The order reads the DRAWN direction and the tie moves with it: horizontal ties U and
# D (same column), vertical ties A and B (same row), the whole order reordering to the drawn axis. Reversing the anchors reverses the order;
# first_along and last_along name the ends; refusals by name; determinism. No network, no key, no funds.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/line_order_witness.rish

say "line_order: Language EN -- Season G line-to-order; the DOT product ranks objects ALONG the line where line_partition's CROSS product split them across it; NO float, NO tolerance."
say "line_order: Style Radiant -- compose not braid: this rung owns only the along-line projection and the sort it induces; line_partition owns the cross-product side arbiter the crux cross-checks, click_order owns click_group_id, click_collinear owns click_group_center_doubled, cluster_facts owns the group frame. No plane of its own, no pixel written -- a reading over readings."
say "line_order: Lens TAME -- the projection walk runs components times under label_max_pixels and the insertion sort over that same bounded count; the dot product runs in i64 so doubled-coordinate products never overflow; two anchors sharing a group refuse SameGroup, a background tap refuses EmptyClick, a point off the map refuses PointOutOfBounds, a label past the object count refuses BadTarget having read nothing; no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "image/bin/line_order"

let build = run ["sh" "-c" "mkdir -p image/bin && env RYE_ZIG=${zig} rye/bin/rye build image/line_order.rye -femit-bin=${bin}"]
assert build.ok else "line_order: build failed -- ${build.err}"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "line_order: selftest exited non-zero -- ${selftest.out}"

let out = trim selftest.out
say "line_order: ${out}"

assert selftest.out contains "GREEN image-line-order" else "line_order: selftest did not print the GREEN line"
assert selftest.out contains "read a DIRECTED line named by TWO anchor taps (from A toward B) as a READING ORDER ALONG the line" else "line_order: the reading-order-along claim did not print"
assert selftest.out contains "along-line ORDER and across-line SIDE are ORTHOGONAL, the DOT and the CROSS of the same two anchors" else "line_order: the decisive orthogonality crux did not print"
assert selftest.out contains "the horizontal line A -> B orders them A, P, U, D, Q, B by doubled column" else "line_order: the horizontal order did not print"
assert selftest.out contains "TWO OBJECTS TIE IN ORDER YET SPLIT TO OPPOSITE SIDES" else "line_order: the tie-yet-split crux did not print"
assert selftest.out contains "identical rank-key, opposite sides" else "line_order: the same-key-opposite-sides claim did not print"
assert selftest.out contains "THE ORDER READS THE DRAWN DIRECTION, AND THE TIE MOVES WITH IT" else "line_order: the direction-sensitivity crux did not print"
assert selftest.out contains "the former anchors A and B tie (same row) while U and D no longer do" else "line_order: the tie-moves claim did not print"
assert selftest.out contains "generalizes reading_order's fixed top-to-bottom sweep to ANY direction a keeper draws" else "line_order: the generalizes-reading_order claim did not print"
assert selftest.out contains "negates every projection so the whole order reverses" else "line_order: the antisymmetry claim did not print"
assert selftest.out contains "refuse SameGroup" else "line_order: the SameGroup refusal did not print"
assert selftest.out contains "refuses BadTarget having read nothing" else "line_order: the BadTarget refusal did not print"
assert selftest.out contains "the same line reads the same order twice" else "line_order: determinism did not print"

say "line_order: GREEN on metal -- a directed line read as a reading order along its own direction, the along-line order orthogonal to line_partition's across-line side; two objects tie in projection yet split to opposite sides, the tie moving with the drawn direction; antisymmetry reverses the order, refusals by name, determinism. Season G open-media."
