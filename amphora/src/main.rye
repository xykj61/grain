//! amphora/src/main.rye — Amphora: vessel software for a sealed crossing.
//!
//! Amphora is preservation in motion. It carries sealed resins across a
//! crossing — wire, dock, or pocket — under the same resins law and Kumara
//! stamp as Amber's cellar. Seal and stamp live inside pour; chunk lives
//! inside carry. The shoulder stays clear. Tamper must fail. Round-trip with
//! pour and carry must close equal.
//!
//! This is the seed: one file, three commands, one crossing.
//!
//! Commands:
//!   amphora pour <season> <vessel>   Fill, seal, then stamp a vessel.
//!   amphora carry <vessel> <dock>    Move sealed cargo; chunk inside carry.
//!   amphora restore <vessel>         Cold scrub, verify, restore faithful.
//!   amphora version                  Print the Amphora CLI version.
//!
//! Build:
//!   mkdir -p amphora/bin
//!   RYE_ZIG=$PWD/vendor/zig-toolchain/zig \
//!   rye/bin/rye build amphora/src/main.rye -femit-bin=amphora/bin/amphora
//!
//! Bounds (named constants — Q4; values align with vessel homes):
//!   max_words            — argv ceiling (program + command + two operands)
//!   max_vessel_path_len  — season / vessel / dock path text
//!   max_cargo_bytes      — sealed cargo / resin ceiling (vessel_fetch_wire)
//!   max_chunk_datagram   — one wire frame (kind 0x33 rides inside)
//!
//! Errors (named for the fault — Q5 will seat error set names):
//!   season missing · vessel forked · stamp fail · seal fail · dock refuse
//!   unknown command · too many words · quest waits
//!
//! Architecture (four sections, one file for the seed):
//!   § Pour    — fill from season; seal then Kumara-stamp; no second pour
//!   § Carry   — move sealed vessel; kind 0x33 chunks; far dock verifies
//!   § Restore — cold scrub; verify stamp+seal; restore byte-faithful
//!   § Main    — CLI: pour / carry / restore / version
//!
//! One loop · one crossing. Identity refuses a second pour that would fork.
//! Far side verifies stamp and seal before cargo is trusted again.
//! Result on stdout; diagnostics on stderr — a result no caller can read
//! is not a result (Amphora's half; family law awaits Keaton's word).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

/// Amphora CLI version — YYYYMMDD.HHMMSS, America/New_York, later is larger.
const amphora_version = "20260731.230237";

// -------------------------------------------------------------------------
// § Bounds — named with their why (Q4)
// -------------------------------------------------------------------------

/// At most four argv words: program · command · two operands (pour/carry).
const max_words: u8 = 4;

/// Path text ceiling for season · vessel · dock args (POSIX PATH_MAX lean).
/// Why: refuse absurd paths before open; pour metal will enforce on read.
const max_vessel_path_len: u16 = 4096;

/// Sealed cargo / assembled resin ceiling in bytes.
/// Why: matches vessel_fetch_wire.max_resin_bytes / vessel_seal.max_seal_plain.
const max_cargo_bytes: u32 = 1024;

/// One datagram payload ceiling on the crossing wire.
/// Why: matches vessel_fetch_wire.max_wire_payload; chunk (0x33) stays inside.
const max_chunk_datagram: u16 = 340;

// =========================================================================
// § Main — CLI (Q3: version; Q4: bounds named; pour/carry/restore wait)
// =========================================================================

pub fn main(init: std.process.Init) !u8 {
    const allocator = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(allocator);

    assert(args.len >= 1);
    assert(max_words == 4);
    assert(amphora_version.len == 15);
    assert(max_vessel_path_len == 4096);
    assert(max_cargo_bytes == 1024);
    assert(max_chunk_datagram == 340);

    if (args.len > max_words) {
        print("amphora: at most {d} words, {d} given\n", .{ max_words, args.len });
        return 2;
    }
    if (args.len < 2) {
        print_usage();
        return 2;
    }

    const cmd = args[1];
    if (std.mem.eql(u8, cmd, "version")) {
        return cmd_version(io);
    } else if (std.mem.eql(u8, cmd, "pour") or
        std.mem.eql(u8, cmd, "carry") or
        std.mem.eql(u8, cmd, "restore"))
    {
        print("amphora: '{s}' waits its quest\n", .{cmd});
        return 2;
    } else {
        print("amphora: unknown command '{s}'\n\n", .{cmd});
        print_usage();
        return 2;
    }
}

/// Print the free version string on stdout — the seam `say` already uses.
fn cmd_version(io: std.Io) u8 {
    assert(amphora_version.len == 15);
    assert(amphora_version[8] == '.');
    var buf: [48]u8 = undefined;
    const line = std.fmt.bufPrint(&buf, "amphora {s}\n", .{amphora_version}) catch {
        print("amphora: version format failed\n", .{});
        return 2;
    };
    const stdout = std.Io.File.stdout();
    stdout.writeStreamingAll(io, line) catch {
        print("amphora: stdout write failed\n", .{});
        return 2;
    };
    return 0;
}

fn print_usage() void {
    print(
        \\amphora — vessel software for a sealed crossing
        \\
        \\usage:
        \\  amphora pour <season> <vessel>   fill, seal, then stamp
        \\  amphora carry <vessel> <dock>    move sealed cargo
        \\  amphora restore <vessel>         cold scrub, verify, restore
        \\  amphora version                  print the Amphora version
        \\
    , .{});
}
