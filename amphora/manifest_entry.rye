//! amphora/manifest_entry.rye -- Amphora -- manifest entry: one cargo line, three fields, wreck rule - 20260713.
//!
//! Graduated from work-in-progress crossing manifest seed (parity 151).
//!
//!   rye build amphora/manifest_entry.rye -femit-bin=amphora/bin/manifest-entry
//!   amphora/bin/manifest-entry selftest
//!
//!     <mark> <sha3-256-hex> <name>

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const amphora_manifest_entry_version = "20260710.143500";

pub const digest_hex_len: u32 = 64;
pub const max_mark_len: u32 = 32;
pub const max_name_len: u32 = 200;
pub const max_line_len: u32 = max_mark_len + 1 + digest_hex_len + 1 + max_name_len;

/// The two roots the engine hardcodes, and the only marks it knows without asking.
/// `foundations/20260703-202312_the-marked-value.md` names exactly these two and says
/// why the circle of who-validates-the-validators has to break somewhere: the
/// plain-bytes mark, which every value trivially satisfies, and the manifest mark,
/// so a vessel can always be read. Everything above them is defined in the tree and
/// arrives through `mark_verdict`, never by widening this pair.
pub const mark_plain_bytes = "plain-bytes";
pub const mark_manifest = "manifest";

/// What the engine can say about a mark on sight. `known` is one of the two roots;
/// `unknown` is cargo whose kind cannot be named, which the wreck rule refuses whole.
pub const MarkVerdict = enum { known, unknown };

/// Read a mark's verdict off its face, the way a shoulder line is read before a seal breaks.
/// Postcondition: every mark receives exactly one verdict -- there is no third answer and
/// no partial trust, which is the wreck rule stated positively.
pub fn mark_verdict(mark: []const u8) MarkVerdict {
    // invariant: a mark reaching here has already passed the shape check above.
    assert(mark.len >= 1);
    // invariant: the roster is the two roots, so the walk is bounded by a named pair.
    assert(mark.len <= max_mark_len);
    if (std.mem.eql(u8, mark, mark_plain_bytes)) return .known;
    if (std.mem.eql(u8, mark, mark_manifest)) return .known;
    return .unknown;
}

/// What the engine can say about a NAME on sight. `contained` is a plain relative
/// path that can only ever land inside the home a restore was pointed at;
/// `escaping` is one that names a place outside it, or names no place at all.
///
/// The rule exists because a cargo line proves its bytes and never proved its
/// PLACE. Measured on metal `20260910`: a vessel whose cargo named
/// `../escaped.txt` passed the Kumara stamp, the AEAD seal, the listing-agrees
/// walk, and printed `restore files proven count=2` -- the digest matched,
/// because the content was honest and only the destination was not -- and
/// `restore` wrote the file one directory ABOVE its out-home before refusing on
/// the parent compare. A refusal that arrives after the write is not a wall.
pub const NameVerdict = enum { contained, escaping };

/// Read a name's verdict off its face. A contained name is a relative path whose
/// every segment carries content and is neither `.` nor `..`: no leading `/`, no
/// empty segment (which is what `//` and a trailing `/` are), and no segment that
/// walks upward. A season is read by a directory walk, so a pour can never MAKE an
/// escaping name -- this door exists for the names that arrive from outside, which
/// is every name a restore reads back out of a sealed vessel.
///
/// Postcondition: every name receives exactly one verdict, stated positively --
/// there is no partial containment.
pub fn name_verdict(name: []const u8) NameVerdict {
    // invariant: a name reaching here carries bytes -- the parser refuses an empty
    // field before asking where it points.
    if (name.len == 0) return .escaping;
    // invariant: and it fits the roster's own name roof, so the walk below is
    // bounded by a named constant rather than by whatever arrived.
    if (name.len > max_name_len) return .escaping;
    var start: u32 = 0;
    const len: u32 = @intCast(name.len);
    while (start <= len) {
        var end: u32 = start;
        while (end < len and name[@intCast(end)] != '/') : (end += 1) {}
        const seg = name[@intCast(start)..@intCast(end)];
        if (seg.len == 0) return .escaping;
        if (std.mem.eql(u8, seg, ".")) return .escaping;
        if (std.mem.eql(u8, seg, "..")) return .escaping;
        if (end >= len) break;
        start = end + 1;
    }
    return .contained;
}

pub const ManifestEntry = struct {
    mark: []const u8,
    digest_hex: []const u8,
    name: []const u8,
};

fn is_lower_hex(c: u8) bool {
    if (c >= '0' and c <= '9') return true;
    if (c >= 'a' and c <= 'f') return true;
    return false;
}

/// Precondition: line contains no newline and fits the named bound.
/// Postcondition: all three fields are nonempty, the digest is well-formed, and the
/// mark is one the engine can name. An unknown mark refuses whole rather than
/// riding through unread -- there is no partial trust of cargo whose kind has no name.
pub fn parse_manifest_line(line: []const u8) error{ InvalidFormat, UnknownMark, EscapingName }!ManifestEntry {
    // invariant: a line reaching the parser holds bytes and fits the named bound, so the u32
    // arithmetic below indexes real content and never walks past the slice it was handed.
    assert(line.len >= 1);
    assert(line.len <= max_line_len);

    const len: u32 = @intCast(line.len);

    var first_space: u32 = 0;
    while (first_space < len) : (first_space += 1) {
        if (line[@intCast(first_space)] == ' ') break;
    }
    if (first_space == 0) return error.InvalidFormat;
    if (first_space >= len) return error.InvalidFormat;
    if (first_space > max_mark_len) return error.InvalidFormat;

    const digest_start: u32 = first_space + 1;
    const digest_end: u32 = digest_start + digest_hex_len;
    if (digest_end >= len) return error.InvalidFormat;
    if (line[@intCast(digest_end)] != ' ') return error.InvalidFormat;

    var i: u32 = digest_start;
    while (i < digest_end) : (i += 1) {
        if (!is_lower_hex(line[@intCast(i)])) return error.InvalidFormat;
    }

    const name_start: u32 = digest_end + 1;
    if (len - name_start > max_name_len) return error.InvalidFormat;

    const entry = ManifestEntry{
        .mark = line[0..@intCast(first_space)],
        .digest_hex = line[@intCast(digest_start)..@intCast(digest_end)],
        .name = line[@intCast(name_start)..@intCast(len)],
    };
    // invariant: the three fields the entry publishes were each cut from the line above, so every
    // one carries content and the digest is exactly the width every later reader slices it at.
    assert(entry.mark.len >= 1);
    assert(entry.digest_hex.len == digest_hex_len);
    assert(entry.name.len >= 1);
    // The wreck rule, kept here so every reading site inherits it from one place. Counted
    // `20260908` rather than recalled: SIX callers route a whole line through here --
    // `vessel_core.rye:160` and `:167` (the parts reader) and `:234` (`take_listed_line`),
    // `vessel_seal.rye:115` and `:229`, and `vessel_fetch_delivery.rye:365` -- each
    // discarding the parsed entry with `_ =` and keeping only the refusal. This comment
    // read `five` and named `:234` nowhere. A SEVENTH reader cannot route the whole line:
    // `amphora/src/main.rye:append_cargo_line` walks decrypted seal plain into a catalog
    // slot, so it borrows `mark_verdict` alone and holds its written root against
    // `mark_plain_bytes` at comptime (REDS `20260908.004856`). A check written per caller
    // would be a rule written seven times to be forgotten once.
    if (mark_verdict(entry.mark) == .unknown) return error.UnknownMark;
    // invariant: past this line the mark is a root the engine names.
    assert(mark_verdict(entry.mark) == .known);
    // The containment rule, kept beside the wreck rule for the same reason: a name
    // that walks upward is refused once here rather than seven times at the readers.
    // A digest answers WHAT the bytes are; this answers WHERE they may land, and the
    // vessel carried the second claim unchecked until `20260910`.
    if (name_verdict(entry.name) == .escaping) return error.EscapingName;
    // invariant: past this line the name lands inside whatever home a restore names.
    assert(name_verdict(entry.name) == .contained);
    return entry;
}

fn run_selftest(_: std.Io) !u8 {
    const line = mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " session-logs/example.md";
    const entry = try parse_manifest_line(line);
    // invariant: a line built from the roster's own mark parses back into the same three fields, so
    // the welcome leg proves acceptance rather than proving only that no error was raised.
    assert(std.mem.eql(u8, entry.mark, mark_plain_bytes));
    assert(entry.digest_hex.len == digest_hex_len);
    assert(std.mem.eql(u8, entry.name, "session-logs/example.md"));

    if (parse_manifest_line(mark_plain_bytes ++ " short name")) |_| return error.UnwelcomePassed else |_| {}
    if (parse_manifest_line(" " ++ ("ab" ** 32) ++ " x")) |_| return error.UnwelcomePassed else |_| {}
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("AB" ** 32) ++ " x")) |_| return error.UnwelcomePassed else |_| {}

    // Both directions of the wreck rule, since a refusal proven only one way cannot be
    // told from a bypass. The manifest root walks free beside plain-bytes; a stranger
    // and an inviting-sounding kind the engine never named both refuse.
    const manifest_line = mark_manifest ++ " " ++ ("ab" ** 32) ++ " nested.bron";
    const nested = try parse_manifest_line(manifest_line);
    // invariant: the manifest root parses beside plain-bytes, so the roster admits both kinds; a
    // welcome proven for one mark alone would leave a narrowed roster reading green.
    assert(std.mem.eql(u8, nested.mark, mark_manifest));
    // invariant: each refusal names UnknownMark itself, so a refusal earned some other way -- a bad
    // length, a malformed digest -- cannot be read as the roster doing its work.
    if (parse_manifest_line("zzz-unknown-stranger " ++ ("ab" ** 32) ++ " x")) |_| return error.UnwelcomePassed else |err| assert(err == error.UnknownMark);
    if (parse_manifest_line("executable " ++ ("ab" ** 32) ++ " payload.so")) |_| return error.UnwelcomePassed else |err| assert(err == error.UnknownMark);

    // Both directions of the containment rule. A nested relative name walks free,
    // because a season is read by a directory walk and `sub/a.txt` is what that walk
    // hands back; every shape that could land outside the home refuses by its own name.
    const nested_ok = try parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " sub/deeper/a.txt");
    // invariant: the welcome is asserted as hard as the refusals, so a rule refusing
    // every name would be told apart from one refusing the escaping names alone.
    assert(std.mem.eql(u8, nested_ok.name, "sub/deeper/a.txt"));
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " ../escaped.txt")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " sub/../../escaped.txt")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " /etc/passwd")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " sub//a.txt")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " ./a.txt")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);
    if (parse_manifest_line(mark_plain_bytes ++ " " ++ ("ab" ** 32) ++ " sub/")) |_| return error.UnwelcomePassed else |err| assert(err == error.EscapingName);

    print("amphora: version {s}\n", .{amphora_manifest_entry_version});
    print("GREEN: Amphora manifest entry -- parse, name the mark, hold the name inside, and refuse whole.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init.arena.allocator();
    return run_selftest(init.io);
}
