//! pond/apps/council_sky.rye — Season 3 Journey 11 (Council skies), Rung 1: a community loads a sky, and the sky's odd fractal gives it a tie-free quorum and complete roles.
//!
//! Season 3, Commons — a community shapes its own deliberation. Journey 10 (Membership) drew quorum at a
//! threshold a caller chooses, over a flat roster. Journey 11 draws the load-bearing move the
//! loadable-topologies brief named: a council does not merely pick a threshold, it **loads a whole shape**
//! — a *sky* — the way a console loads a game, and the sky's own odd fractal *gives* the council its
//! tie-free quorum and its roles.
//!
//! The crux: **an odd sky gives a tie-free quorum and a complete triad.** A `Council` loads a `Sky`
//! (`comlink/topology.rye`) and seats a body at one of the sky's own fractal levels — its `galaxies`,
//! `stars`, `planets`, or `prosperity`. The council sky's four counts are 15 · 3 · 9 · 27, the odd-quorum
//! fractal **3 · 9 · 15 · 27**, every one odd. The council's quorum is the strict majority of that odd
//! body (`size / 2 + 1`); because the body is **odd**, yes-votes and no-votes can never both reach the
//! quorum, so once every seat has voted one side always holds the majority — a proposal is never left
//! forever undecided. The civic `compass_sky` is not a council sky: its `prosperity` is 60 — even — so
//! seating its d60 as a deliberating body would risk a tie, and the rule refuses it (`EvenCouncil`). Each
//! seat wears a **modality role** — one of `initiator · sustainer · adapter` — derived from its position
//! (`seat mod 3`), so any three consecutive seats hold one of each: odd *and* complete, one to open, one
//! to hold, one to bridge. The typing is a pure function of the seat, so it can never drift from the body
//! the sky seated.
//!
//! This is the pure rule as a bounded state machine — no signing yet (r2 signs each vote with the
//! member's settled Kumara identity, mirroring `skate_group_signed`). Facts only, custody-first: it
//! records the facts of a loaded shape and its votes and holds nothing, opens no network, and generates
//! no real identity (a council shared over the wire reaches the serve gate — Keaton's hand). Demo seats
//! (plain indices) only.
//!
//!   rye build pond/apps/council_sky.rye -femit-bin=pond/bin/council-sky
//!   pond/bin/council-sky selftest
//!
//! Scope: active-designing/20260812-210603_dahl-journey11-council-skies-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const topology = @import("topology.rye");
const Sky = topology.Sky;

pub const council_sky_app_version = "20260812.210603";

/// A council seats at most this many members — bounded so a loaded body never grows unbounded. Set above
/// the council sky's d27 (27) and the compass sky's d60 (60), so the even d60 refuses for being *even*,
/// never merely for being too large — the honest reason surfaces.
pub const max_seats: u32 = 64;

/// A council holds at most this many distinct ballots — bounded so consent never grows unbounded.
pub const max_votes: u32 = 512;

/// A member's worn role in the council — the brief's role tilak, drawn here as the seat's own mode. A
/// healthy triad holds one of each: one to open (initiator), one to hold (sustainer), one to bridge
/// (adapter). Odd and complete.
pub const Mode = enum {
    initiator, // opens — seat mod 3 == 0
    sustainer, // holds — seat mod 3 == 1
    adapter, // bridges — seat mod 3 == 2
};

/// The outcome of a proposal, folded from the odd-quorum tally.
pub const Outcome = enum {
    open, // fewer than a quorum on either side — still deciding
    passed, // a quorum of yes-votes — the proposal carries
    failed, // a quorum of no-votes — the proposal is rejected
};

pub const CouncilError = error{
    NotAFractalLevel, // the seated size is not one of the loaded sky's own tier counts
    EvenCouncil, // an even body could split its votes evenly with no forced answer — a council needs an odd body
    TooManySeats, // an odd fractal level larger than the bound — refuse rather than overflow
    NotSeated, // a seat index outside the council body tried to vote
    AlreadyVoted, // this seat already voted on this proposal — one seat, one vote per proposal
    VotesFull, // the vote book is at its bound — refuse rather than drop consent
};

/// One seat's ballot on one proposal — attributed to a distinct seat, so a quorum is the count of
/// distinct such ballots on one side, never one seat counted twice.
const Ballot = struct {
    seat: u32,
    proposal: u32,
    yea: bool,
};

/// The modality role a seat wears — a pure function of its position, so the role can never drift from the
/// body the sky seated. Seats cycle initiator · sustainer · adapter, so any consecutive triad is complete.
pub fn mode_of_seat(seat: u32) Mode {
    return switch (seat % 3) {
        0 => .initiator,
        1 => .sustainer,
        2 => .adapter,
        else => unreachable, // seat % 3 is always 0, 1, or 2
    };
}

/// Whether a size is one of a sky's own fractal levels — its galaxy, star, planet, or prosperity count.
/// A council may seat a body only at a level the loaded sky actually names.
fn is_fractal_level(sky: Sky, size: u32) bool {
    return size == sky.galaxies or size == sky.stars or size == sky.planets or size == sky.prosperity();
}

/// A deliberating body loaded over a sky: a fixed odd size, a majority quorum computed from it, the
/// modality role each seat wears (derived, not stored), and every distinct ballot cast. An outcome is
/// *derived* — a proposal passes only when the count of distinct yes-ballots reaches the quorum — so the
/// tie-free law cannot be bypassed by writing an outcome directly.
// Invariant: 3 <= size <= max_seats; size is odd; 2 * quorum > size (so both sides can never reach quorum).
pub const Council = struct {
    size: u32,
    quorum: u32,
    votes: [max_votes]Ballot,
    vote_count: u32,

    /// Load a sky and seat a council at one of the sky's own fractal levels. The level must be a level the
    /// sky names (`NotAFractalLevel`), must be odd so a majority can never tie (`EvenCouncil`), and must
    /// fit the seat bound (`TooManySeats`). The quorum is the strict majority of the odd body.
    pub fn load(sky: Sky, size: u32) CouncilError!Council {
        // invariant: a council seats only at a level the loaded sky actually names.
        if (!is_fractal_level(sky, size)) return error.NotAFractalLevel;
        // invariant: an odd body — so yes and no can never both reach a majority (no tie-breaker needed).
        if (size % 2 == 0) return error.EvenCouncil;
        // invariant: the body fits the bound.
        if (size > max_seats) return error.TooManySeats;

        const quorum = size / 2 + 1; // strict majority of an odd body: (size + 1) / 2

        // invariant: a council is at least a triad (the smallest odd deliberating body).
        assert(size >= 3);
        assert(size % 2 == 1);
        // invariant: both sides can never reach the quorum at once — 2*quorum > size — so no tie is possible.
        assert(2 * quorum > size);
        assert(quorum <= size);
        return Council{ .size = size, .quorum = quorum, .votes = undefined, .vote_count = 0 };
    }

    /// The modality role of a seat within this council.
    pub fn mode_at(self: *const Council, seat: u32) Mode {
        // invariant: only a seated index has a role.
        assert(seat < self.size);
        return mode_of_seat(seat);
    }

    /// Does this exact seat→proposal ballot already stand?
    fn has_ballot(self: *const Council, seat: u32, proposal: u32) bool {
        // invariant: the vote book never exceeds its bound.
        assert(self.vote_count <= max_votes);
        var i: u32 = 0;
        while (i < self.vote_count) : (i += 1) {
            if (self.votes[i].seat == seat and self.votes[i].proposal == proposal) return true;
        }
        return false;
    }

    /// How many distinct seats voted a given way on this proposal — a count of distinct hands on one side.
    pub fn tally(self: *const Council, proposal: u32, yea: bool) u32 {
        // invariant: the vote book never exceeds its bound.
        assert(self.vote_count <= max_votes);
        var count: u32 = 0;
        var i: u32 = 0;
        while (i < self.vote_count) : (i += 1) {
            if (self.votes[i].proposal == proposal and self.votes[i].yea == yea) count += 1;
        }
        // invariant: a one-sided tally can never exceed the whole seated body.
        assert(count <= self.size);
        return count;
    }

    /// The outcome of a proposal — the whole odd-quorum rule folded to one answer. Because the body is
    /// odd (`2 * quorum > size`), yes and no can never both reach the quorum, so at most one of passed /
    /// failed holds; `open` until one side does.
    pub fn outcome(self: *const Council, proposal: u32) Outcome {
        const yes = self.tally(proposal, true);
        const no = self.tally(proposal, false);
        const both_reach_quorum = yes >= self.quorum and no >= self.quorum;
        // invariant: the odd body forbids both sides reaching the quorum at once — never a tie.
        assert(!both_reach_quorum);
        if (yes >= self.quorum) return .passed;
        if (no >= self.quorum) return .failed;
        return .open;
    }

    /// Whether every seat has voted on a proposal — the state in which an odd body is *always* decided.
    pub fn fully_voted(self: *const Council, proposal: u32) bool {
        const cast = self.tally(proposal, true) + self.tally(proposal, false);
        // invariant: the ballots cast on one proposal never exceed the seated body.
        assert(cast <= self.size);
        return cast == self.size;
    }

    /// A seat votes yes or no on a proposal. Only a seated index votes (`NotSeated`); each seat votes on a
    /// given proposal once, so a lone hand can never fake a majority (`AlreadyVoted`). The outcome is
    /// derived from the tally, never written directly.
    pub fn vote(self: *Council, seat: u32, proposal: u32, yea: bool) CouncilError!void {
        if (seat >= self.size) return error.NotSeated;
        if (self.has_ballot(seat, proposal)) return error.AlreadyVoted;
        if (self.vote_count >= max_votes) return error.VotesFull;

        const i = self.vote_count;
        self.votes[i] = .{ .seat = seat, .proposal = proposal, .yea = yea };
        self.vote_count += 1;
        // invariant: the vote book grew by exactly one, within its bound.
        assert(self.vote_count == i + 1);
        assert(self.vote_count <= max_votes);
        // invariant: an odd body fully voted is always decided — never left open on a tie.
        assert(!self.fully_voted(proposal) or self.outcome(proposal) != .open);
    }
};

// --- selftest -----------------------------------------------------------

/// The council sky's four fractal levels — 3 · 9 · 15 · 27 — all seat a council, each with its own odd
/// majority quorum. The odd fractal is the whole point: a community loads it and every level decides.
fn welcome_odd_levels_all_seat() !void {
    const sky = topology.council_sky; // 15 galaxies · 3 stars · 9 planets → prosperity 27

    const triad = try Council.load(sky, 3);
    assert(triad.quorum == 2); // majority of three

    const bench = try Council.load(sky, 9);
    assert(bench.quorum == 5); // majority of nine

    const wheel = try Council.load(sky, 15);
    assert(wheel.quorum == 8); // majority of fifteen

    const d27 = try Council.load(sky, 27);
    assert(d27.quorum == 14); // majority of twenty-seven

    print("council_sky: the council sky's odd fractal 3-9-15-27 all seated, each with its own majority quorum (2, 5, 8, 14).\n", .{});
}

/// An odd body can never tie: on a triad, one yes and one no leave the outcome open, and the third vote
/// always decides — yes and no can never both reach the quorum of two.
fn welcome_odd_quorum_never_ties() !void {
    const sky = topology.council_sky;
    var c = try Council.load(sky, 3);
    const prop: u32 = 7;

    // Seat 0 votes yes, seat 1 votes no: one each, quorum two — the outcome holds open, no tie declared.
    try c.vote(0, prop, true);
    assert(c.outcome(prop) == .open);
    try c.vote(1, prop, false);
    assert(c.outcome(prop) == .open);
    assert(c.tally(prop, true) == 1);
    assert(c.tally(prop, false) == 1);
    assert(!c.fully_voted(prop));

    // Seat 2 casts the deciding vote. Every seat has now voted; an odd body is always decided — here, yes.
    try c.vote(2, prop, true);
    assert(c.fully_voted(prop));
    assert(c.outcome(prop) == .passed);
    assert(c.tally(prop, true) == 2);
    print("council_sky: a one-each split held open, and the odd third vote decided — a majority of an odd body never ties.\n", .{});
}

/// Every seat wears a modality role by position; any consecutive triad holds one of each — odd and
/// complete — and the cycle repeats, so a large body is a weave of complete triads.
fn welcome_modality_triad_complete() !void {
    const sky = topology.council_sky;
    var c = try Council.load(sky, 9);

    assert(c.mode_at(0) == .initiator);
    assert(c.mode_at(1) == .sustainer);
    assert(c.mode_at(2) == .adapter);
    // The three modes of a triad are distinct — one to open, one to hold, one to bridge.
    assert(c.mode_at(0) != c.mode_at(1));
    assert(c.mode_at(1) != c.mode_at(2));
    assert(c.mode_at(0) != c.mode_at(2));
    // The cycle repeats: seat 3 opens the next triad.
    assert(c.mode_at(3) == .initiator);
    assert(c.mode_at(8) == .adapter);
    print("council_sky: seats wore initiator-sustainer-adapter each once per triad, the cycle repeating — a body of complete triads.\n", .{});
}

/// The civic compass sky is not a council sky: its prosperity is 60 — even — so seating its d60 as a
/// deliberating body refuses EvenCouncil rather than risk a tie. Its odd star level (5) still seats.
fn unwelcome_even_level_refuses() !void {
    const compass = topology.compass_sky; // 12 galaxies · 5 stars · 12 planets → prosperity 60

    // The d60 is a real fractal level, yet even — a council of it could deadlock, so it refuses.
    const even = Council.load(compass, 60);
    assert(even == error.EvenCouncil);

    // The compass sky's star level (5) is odd — a valid council of five, quorum three.
    const five = try Council.load(compass, 5);
    assert(five.quorum == 3);
    print("council_sky: the compass sky's even d60 refused EvenCouncil, yet its odd star level (5) seated a council of quorum three.\n", .{});
}

/// A council seats only at a level the loaded sky names; an arbitrary size refuses.
fn unwelcome_not_a_level_refuses() !void {
    const sky = topology.council_sky;
    // 7 is odd, yet not one of the council sky's levels {3, 9, 15, 27}.
    const seven = Council.load(sky, 7);
    assert(seven == error.NotAFractalLevel);
    print("council_sky: a size the sky does not name refused NotAFractalLevel — a council seats only at a loaded level.\n", .{});
}

/// Only a seated index votes, and one seat votes on a proposal once — a lone hand can never fake a
/// majority.
fn unwelcome_nonseat_and_double_vote_refuse() !void {
    const sky = topology.council_sky;
    var c = try Council.load(sky, 3);
    const prop: u32 = 1;

    // Seat 9 is outside a body of three.
    const outside = c.vote(9, prop, true);
    assert(outside == error.NotSeated);

    // Seat 0 votes, then tries to vote again on the same proposal.
    try c.vote(0, prop, true);
    const doubled = c.vote(0, prop, true);
    assert(doubled == error.AlreadyVoted);
    // The tally did not budge — one hand cannot count for two.
    assert(c.tally(prop, true) == 1);
    assert(c.outcome(prop) == .open);
    print("council_sky: a non-seat vote refused NotSeated and a doubled ballot refused AlreadyVoted, the tally held at one — one hand can never fake a majority.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_odd_levels_all_seat();
    try welcome_odd_quorum_never_ties();
    try welcome_modality_triad_complete();
    try unwelcome_even_level_refuses();
    try unwelcome_not_a_level_refuses();
    try unwelcome_nonseat_and_double_vote_refuse();
    print("council_sky: version {s}\n", .{council_sky_app_version});
    print("GREEN: DAHL-J11r1 council_sky; a community loads a sky and the sky's odd fractal 3-9-15-27 gives a tie-free majority quorum and a complete triad of modality roles.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "council-sky"))) {
        return run_selftest();
    }
    return run_selftest();
}
