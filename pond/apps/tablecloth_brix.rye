//! pond/apps/tablecloth_brix.rye - BUHR Journey 7, Rung 3: a Brix descriptor declares artifacts.
//!
//! Rungs one and two built the artifact store and proved a manifest is an honest index of
//! a live store. This rung makes the "Brix-facing" half literal. Brix is the composition
//! language that declares a system and evaluates to Bron; here a small Brix-facing
//! descriptor - `format tablecloth-decl-v1`, one `require <name>` line per artifact a
//! system needs - is *evaluated against a live store* into a `format tablecloth-v1`
//! manifest of exactly those declared artifacts, in declared order.
//!
//! Evaluation is the join of declaration and store: a required name the catalog holds
//! contributes its true content address to the manifest; a required name the store cannot
//! satisfy refuses the whole evaluation (Unsatisfied) rather than emitting a manifest that
//! names bytes the store does not hold. The evaluated manifest then verifies against the
//! store by rung two, so the chain is whole: a system declares what it needs, the store
//! proves it can serve it, and the manifest is the audited receipt.
//!
//!   rye build pond/apps/tablecloth_brix.rye -femit-bin=pond/bin/tablecloth-brix
//!   pond/bin/tablecloth-brix selftest
//!
//! Scope: active-designing/date/20260812/20260812-142132_buhr-journey7-tablecloth-artifact-store-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const tc = @import("tablecloth.rye");
const beading = @import("mantra/beading.rye");
const tally_copy = @import("tally_copy.rye");
const index = @import("tablecloth_index.rye");

pub const tablecloth_brix_version = "20260812.143500";

pub const BrixError = error{
    BadDescriptor,
    Unsatisfied,
    Overflow,
};

/// Evaluate a `format tablecloth-decl-v1` descriptor against a live catalog into a
/// `format tablecloth-v1` manifest of exactly the declared artifacts, in declared order.
/// Returns the manifest length. A malformed descriptor refuses (BadDescriptor); a
/// required name the catalog cannot satisfy refuses the whole evaluation (Unsatisfied).
pub fn evaluate(decl_text: []const u8, cat: *const tc.Catalog, out: []u8) BrixError!u32 {
    const header = "format tablecloth-v1\n";
    if (header.len > out.len) return error.Overflow;
    tally_copy.copy_disjoint(u8, out[0..header.len], header);
    var off: u32 = @intCast(header.len);

    var lines = std.mem.splitScalar(u8, decl_text, '\n');
    const first = lines.next() orelse return error.BadDescriptor;
    if (!std.mem.eql(u8, first, "format tablecloth-decl-v1")) return error.BadDescriptor;

    var required: u32 = 0;
    while (lines.next()) |line| {
        if (line.len == 0) continue; // a trailing newline yields an empty final piece
        if (required >= tc.max_artifacts) return error.Overflow;

        var parts = std.mem.tokenizeScalar(u8, line, ' ');
        const tag = parts.next() orelse return error.BadDescriptor;
        if (!std.mem.eql(u8, tag, "require")) return error.BadDescriptor;
        const name = parts.next() orelse return error.BadDescriptor;
        if (parts.next() != null) return error.BadDescriptor; // one name per require line
        if (name.len == 0) return error.BadDescriptor;
        if (name.len > tc.max_name) return error.BadDescriptor;

        // The join: a declared name the store cannot satisfy refuses the whole evaluation.
        var hex: [tc.address_hex_width]u8 = undefined;
        tc.address_hex(cat, name, hex[0..]) catch return error.Unsatisfied;
        const whole_len = tc.artifact_len(cat, name) catch return error.Unsatisfied;

        const line_out = std.fmt.bufPrint(out[off..], "artifact {s} {s} {d}\n", .{
            name, hex[0..], whole_len,
        }) catch return error.Overflow;
        off += @intCast(line_out.len);
        required += 1;
    }

    if (required == 0) return error.BadDescriptor; // a descriptor declares at least one need
    // invariant: the evaluated manifest stays within the buffer
    assert(off <= out.len);
    return off;
}

const doc_a = "linen holds the warp, hemp the weft - a cloth over the table, plain and glad.";
const doc_b = "ramie brightens the border where the light lands, and the table keeps its word.";
const doc_c = "the fold in the cloth remembers every table it has covered, and covers this one too.";

fn run_brix_selftest() !u8 {
    // A live store of three artifacts.
    var store: beading.BeadStore = .empty();
    var cat: tc.Catalog = .empty();
    _ = try tc.store_artifact(&cat, &store, "notes.txt", doc_a);
    _ = try tc.store_artifact(&cat, &store, "site.md", doc_b);
    _ = try tc.store_artifact(&cat, &store, "fold.txt", doc_c);

    // A Brix descriptor declares two of the three, in an order of its own choosing.
    const decl = "format tablecloth-decl-v1\nrequire site.md\nrequire notes.txt\n";
    var man_bytes: [1024]u8 = undefined;
    const man_len = try evaluate(decl, &cat, man_bytes[0..]);

    // The evaluated manifest names exactly the two declared artifacts, in declared order.
    var man: tc.Manifest = undefined;
    try tc.parse_manifest(man_bytes[0..man_len], &man);
    assert(man.count == 2);
    assert(std.mem.eql(u8, man.entries[0].name[0..man.entries[0].name_len], "site.md"));
    assert(std.mem.eql(u8, man.entries[1].name[0..man.entries[1].name_len], "notes.txt"));

    // The chain is whole: the evaluated manifest verifies against the live store (rung two).
    var scratch: [tc.max_content_bytes]u8 = undefined;
    const verified = try index.verify_against_store(&man, &cat, &store, scratch[0..]);
    assert(verified == 2);

    // Unwelcome: a descriptor requiring an artifact the store lacks refuses the whole
    // evaluation - it never emits a manifest naming bytes the store cannot serve.
    {
        const decl_bad = "format tablecloth-decl-v1\nrequire notes.txt\nrequire absent.txt\n";
        var scratch2: [1024]u8 = undefined;
        if (evaluate(decl_bad, &cat, scratch2[0..])) |_| {
            return error.Unsatisfied;
        } else |err| {
            assert(err == error.Unsatisfied);
        }
    }

    // Unwelcome: a descriptor with the wrong header, and an empty descriptor, refuse.
    {
        var scratch2: [256]u8 = undefined;
        if (evaluate("format not-a-decl\nrequire notes.txt\n", &cat, scratch2[0..])) |_| {
            return error.BadDescriptor;
        } else |err| {
            assert(err == error.BadDescriptor);
        }
        if (evaluate("format tablecloth-decl-v1\n", &cat, scratch2[0..])) |_| {
            return error.BadDescriptor;
        } else |err| {
            assert(err == error.BadDescriptor);
        }
    }

    print("tablecloth-brix: a declaration of 2 artifacts evaluated to a manifest of {d}, in declared order\n", .{man.count});
    print("tablecloth-brix: the evaluated manifest verified against the live store ({d} artifacts)\n", .{verified});
    print("tablecloth-brix: an unsatisfiable requirement, a bad header, an empty descriptor each refused GREEN\n", .{});
    print("tablecloth-brix: version {s}\n", .{tablecloth_brix_version});
    print("GREEN: BUHR-J7r3 tablecloth-brix; a system declares what it needs and the store proves it serves it.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2) {
        if (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "tablecloth-brix")) {
            return run_brix_selftest();
        }
    }
    return run_brix_selftest();
}
