//! pond/apps/entity_books_period.rye — Season 2 Journey 8 (Cash-first), Rung 3: the closed period travels.
//!
//! Rungs one and two booked a segregated inter-entity transfer and proved it one both stewards
//! signed. An entity's books are only useful across time, though, if a closed period can be carried —
//! written to a file, pinned, or handed to an auditor — and checked **offline**, with no journal in
//! hand. This rung folds an entity's period to a sealed statement (its name, its close stamp, and its
//! trial-balance nets), renders it to a `format entity-period-v1` Bron record, and parses it back
//! byte-for-byte, so a closed period travels as testimony a recipient can verify.
//!
//! The crux is preservation with the accounting identity intact: `parse(render(period))` recovers an
//! equal statement whose reconstructed trial balance **still conserves and still balances** — the
//! period was not merely copied but stayed a true set of books across the crossing. The reader is a
//! purpose-built bounded Bron reader (the tree's flat `key value` idiom), never a general parser: an
//! unknown field refuses (never dropped), a missing field refuses, a wrong header refuses, and a bad
//! integer refuses rather than decode to garbage. A closed period is testimony, not a mutable draft —
//! it renders what the fold sealed at close, and a recipient re-derives the balance sheet from it.
//!
//! It composes rung one's `Entity` fold and `dimeroll_core`'s `fold_balance_sheet` over public API,
//! inventing no new value model. It reads no network — the serve transport is the Comlink-served gate
//! (Keaton's hand). Demo entities only; facts only (custody gate %3 untouched).
//!
//!   rye build pond/apps/entity_books_period.rye -femit-bin=pond/bin/entity-books-period
//!   pond/bin/entity-books-period selftest
//!
//! Scope: active-designing/date/20260812/20260812-195711_gism-ayre-journey8-cash-first-entity-books-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const entity = @import("entity_books.rye");
const gc = @import("dimeroll/dimeroll_core.rye");
const parse_int = @import("parse_int.rye");

pub const entity_books_period_version = "20260812.200558";

pub const max_period_stamp: u32 = 32;
/// The rendered record: a header plus a name, a stamp, and four account-net lines. Bounded over the
/// worst case (a 32-byte name, a 32-byte stamp, four 20-digit signed nets).
pub const max_record: u32 = 512;

pub const PeriodError = error{
    BadFormat, // the header line is not `format entity-period-v1`
    UnknownField, // a line names a field the record does not define
    MissingField, // a required field never appeared
    BadInt, // a numeric net did not parse
    NameTooLong, // the entity name exceeds max_entity_name
    StampTooLong, // the close stamp exceeds its budget
    RecordTooLong, // the render exceeded its bounded buffer
    Unbalanced, // the sealed statement's reconstructed trial balance does not conserve
};

/// A parsed closed period that owns its variable-length fields, so the reconstruction it hands out
/// points into its own buffers, never into freed text.
// Invariant: name_len <= max_entity_name and stamp_len <= max_period_stamp.
pub const PortablePeriod = struct {
    name_bytes: [entity.max_entity_name]u8,
    name_len: u32,
    stamp_bytes: [max_period_stamp]u8,
    stamp_len: u32,
    nets: [gc.account_count]i64,

    pub fn name(self: *const PortablePeriod) []const u8 {
        // invariant: the held name honors the entity-name budget.
        assert(self.name_len <= entity.max_entity_name);
        return self.name_bytes[0..self.name_len];
    }

    pub fn stamp(self: *const PortablePeriod) []const u8 {
        // invariant: the held stamp honors its budget.
        assert(self.stamp_len <= max_period_stamp);
        return self.stamp_bytes[0..self.stamp_len];
    }

    /// Reconstruct the trial balance the period sealed, from its own carried nets.
    pub fn trial_balance(self: *const PortablePeriod) gc.TrialBalance {
        var tb = gc.TrialBalance{};
        var i: u32 = 0;
        while (i < gc.account_count) : (i += 1) tb.nets[i] = self.nets[i];
        return tb;
    }

    /// The closed period is still true books: its reconstructed trial balance conserves, and its
    /// balance sheet balances. A statement whose nets do not conserve refuses Unbalanced rather than
    /// pretend to be books — a traveled period cannot claim to balance if it does not.
    pub fn balances(self: *const PortablePeriod) PeriodError!gc.BalanceSheet {
        const tb = self.trial_balance();
        if (tb.conservation() != 0) return error.Unbalanced;
        return gc.fold_balance_sheet(tb); // the core asserts the accounting identity holds
    }
};

/// Render an entity's closed period to a `format entity-period-v1` record: its name, a close stamp,
/// and its four trial-balance nets. Refuses an overlong stamp or an overflow.
pub fn render(ent: *const entity.Entity, close_stamp: []const u8, out: []u8) (PeriodError || entity.BookError)!u32 {
    // invariant: the render buffer honors its bound.
    assert(out.len >= max_record);
    if (close_stamp.len > max_period_stamp) return error.StampTooLong;
    const tb = try ent.trial_balance();
    const text = std.fmt.bufPrint(out, "format entity-period-v1\nentity {s}\nstamp {s}\ncash {d}\nrevenue {d}\nexpense {d}\nequity {d}\n", .{
        ent.name(),
        close_stamp,
        tb.nets[@intFromEnum(gc.Account.cash)],
        tb.nets[@intFromEnum(gc.Account.revenue)],
        tb.nets[@intFromEnum(gc.Account.expense)],
        tb.nets[@intFromEnum(gc.Account.equity)],
    }) catch return error.RecordTooLong;
    return @intCast(text.len);
}

/// Split a line into its first-token key and trimmed remainder value — the flat-Bron idiom.
fn key_val(line: []const u8) struct { key: []const u8, val: []const u8 } {
    var sp: u32 = 0;
    while (sp < line.len and line[sp] != ' ') : (sp += 1) {}
    const key = line[0..sp];
    const val = std.mem.trim(u8, line[sp..], " \t");
    return .{ .key = key, .val = val };
}

fn copy_field(dst: []u8, src: []const u8) void {
    var i: u32 = 0;
    while (i < src.len) : (i += 1) dst[i] = src[i];
}

/// Parse a `format entity-period-v1` record into a PortablePeriod, refusing an unknown or missing
/// field, a bad header, a bad integer, or an overlong name/stamp.
pub fn parse(text: []const u8) PeriodError!PortablePeriod {
    var lines = std.mem.splitScalar(u8, text, '\n');
    const header = lines.next() orelse return error.BadFormat;
    if (!std.mem.eql(u8, header, "format entity-period-v1")) return error.BadFormat;

    var have_entity = false;
    var have_stamp = false;
    var have = [_]bool{false} ** gc.account_count;
    var pp = PortablePeriod{ .name_bytes = undefined, .name_len = 0, .stamp_bytes = undefined, .stamp_len = 0, .nets = .{0} ** gc.account_count };

    while (lines.next()) |raw| {
        if (raw.len == 0) continue; // a trailing newline yields one empty line
        const kv = key_val(raw);
        if (std.mem.eql(u8, kv.key, "entity")) {
            if (kv.val.len > entity.max_entity_name) return error.NameTooLong;
            pp.name_len = @intCast(kv.val.len);
            copy_field(&pp.name_bytes, kv.val);
            have_entity = true;
        } else if (std.mem.eql(u8, kv.key, "stamp")) {
            if (kv.val.len > max_period_stamp) return error.StampTooLong;
            pp.stamp_len = @intCast(kv.val.len);
            copy_field(&pp.stamp_bytes, kv.val);
            have_stamp = true;
        } else if (gc.Account.parse(kv.key)) |acct| {
            const ix: u32 = @intFromEnum(acct);
            pp.nets[ix] = parse_int.parse_int(i64, kv.val, .{}) catch return error.BadInt;
            have[ix] = true;
        } else |_| {
            return error.UnknownField;
        }
    }
    if (!(have_entity and have_stamp)) return error.MissingField;
    var i: u32 = 0;
    while (i < gc.account_count) : (i += 1) {
        if (!have[i]) return error.MissingField;
    }
    // invariant: a fully parsed period honors its name and stamp budgets.
    assert(pp.name_len <= entity.max_entity_name);
    assert(pp.stamp_len <= max_period_stamp);
    return pp;
}

// --- selftest -----------------------------------------------------------

fn seat_linengrow() !entity.Entity {
    var e = try entity.Entity.open("Linengrow PBC");
    try e.post(.{ .debit = .cash, .credit = .equity, .amount = 2000, .memo = "opening contribution", .stamp = "20260812.200558" });
    try e.post(.{ .debit = .expense, .credit = .cash, .amount = 300, .memo = "hemp seed", .stamp = "20260812.200558" });
    try e.post(.{ .debit = .cash, .credit = .revenue, .amount = 900, .memo = "cloth sale", .stamp = "20260812.200558" });
    return e;
}

fn periods_equal(a: *const PortablePeriod, b: *const PortablePeriod) bool {
    if (!std.mem.eql(u8, a.name(), b.name())) return false;
    if (!std.mem.eql(u8, a.stamp(), b.stamp())) return false;
    var i: u32 = 0;
    while (i < gc.account_count) : (i += 1) {
        if (a.nets[i] != b.nets[i]) return false;
    }
    return true;
}

/// An entity's closed period renders to Bron and parses back preserving every field, and the
/// recovered period still conserves and still balances — the books survived the crossing whole.
fn welcome_round_trip_still_balances() !void {
    var linengrow = try seat_linengrow();
    const sealed_tb = try linengrow.trial_balance();
    const sealed_sheet = try linengrow.balance_sheet();

    var buf: [max_record]u8 = undefined;
    const n = try render(&linengrow, "20260812.period-close", &buf);
    const pp = try parse(buf[0..n]);

    // Every field survived: name, close stamp, and each account net.
    assert(std.mem.eql(u8, pp.name(), "Linengrow PBC"));
    assert(std.mem.eql(u8, pp.stamp(), "20260812.period-close"));
    var i: u32 = 0;
    while (i < gc.account_count) : (i += 1) assert(pp.nets[i] == sealed_tb.nets[i]);

    // Parsing the same record twice yields equal periods — the reader is deterministic.
    const pp2 = try parse(buf[0..n]);
    assert(periods_equal(&pp, &pp2));

    // The recovered period still balances, and its balance sheet matches the sealed one.
    const back_sheet = try pp.balances();
    assert(back_sheet.balances());
    assert(back_sheet.cash == sealed_sheet.cash);
    assert(back_sheet.equity_booked == sealed_sheet.equity_booked);
    assert(back_sheet.retained == sealed_sheet.retained);
    print("entity_books_period: a closed period round-tripped through Bron preserving every field and still conserves and balances.\n", .{});
}

/// An unknown field refuses — never silently dropped.
fn unwelcome_unknown_field_refuses() !void {
    const record = "format entity-period-v1\nentity X\nstamp s\ncash 100\nrevenue -50\nexpense 50\nequity -100\nsurprise yes\n";
    const parsed = parse(record);
    assert(parsed == error.UnknownField);
    print("entity_books_period: an unknown field refused UnknownField (never dropped).\n", .{});
}

/// A missing field refuses — a period statement names every account net and its two headers.
fn unwelcome_missing_field_refuses() !void {
    const record = "format entity-period-v1\nentity X\nstamp s\ncash 100\nrevenue -50\nexpense 50\n";
    const parsed = parse(record);
    assert(parsed == error.MissingField);
    print("entity_books_period: a missing account net refused MissingField.\n", .{});
}

/// A wrong header refuses, and an unbalanced set of nets refuses rather than travel as false books.
fn unwelcome_bad_header_and_unbalanced_refuse() !void {
    const bad_header = "format other-v1\nentity X\n";
    const header_result = parse(bad_header);
    assert(header_result == error.BadFormat);
    // Nets that do not sum to zero are not a true trial balance.
    const skewed = "format entity-period-v1\nentity X\nstamp s\ncash 100\nrevenue -50\nexpense 50\nequity -10\n";
    const pp = try parse(skewed);
    const balance_result = pp.balances();
    assert(balance_result == error.Unbalanced);
    print("entity_books_period: a wrong header refused BadFormat and unbalanced nets refused Unbalanced.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_round_trip_still_balances();
    try unwelcome_unknown_field_refuses();
    try unwelcome_missing_field_refuses();
    try unwelcome_bad_header_and_unbalanced_refuse();
    print("entity_books_period: version {s}\n", .{entity_books_period_version});
    print("GREEN: GISM-AYRE-J8r3 entity_books_period; a closed period travels as Bron and returns still balancing, or names its refusal.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "entity-books-period"))) {
        return run_selftest();
    }
    return run_selftest();
}
