//! pond/apps/realidream_view_theme.rye -- BUHR Journey 5, Rung 6: a .brush theme
//! recolors the read origin.
//!
//! Rung five painted the read, program, and fused lanes together on one styled
//! surface and marked each read origin in the design system's own `read` token,
//! seated in `tokens.base_sheet`. This rung closes the authoring loop that token was
//! named for: a `.brush` file's optional `style:` block overrides the `read` key, the
//! WADE1 cascade infuses that override over the base sheet, and rung five's own
//! `paint_origins` lowering paints every read origin in the *authored* color. The
//! proof this rung wants is that the read origin is genuinely themeable -- a person
//! editing a `.brush` file, never Skate or Rye, recolors every fetched source's mark
//! by writing one token line, while the ink, the edge rule, and the living-edge head
//! stand untouched.
//!
//! It stays on witnessed ground end to end. The theme is read by the real `.brush`
//! authoring loop (`brush_parse.parse_brush` validates the file, `collect_brush_style`
//! reassembles its style block into the flat Bron sheet `tokens.rye` consumes); the
//! cascade is `tokens.resolve` (per-key `brix/infuse`, already witnessed); the paint
//! is rung five's `paint_origins` unchanged. The recolor is proven two ways: the
//! themed read resolves to the authored amber, and the base sheet's default read color
//! (Madder) leaves *zero* pixels on the themed canvas -- a recolor, not an addition.
//!
//! Additive by construction: it imports realidream_view, mantra_browser,
//! brushstroke/tokens, brushstroke/skate_grid, and brushstroke/brush_parse, calling
//! only their public functions. No file beneath it changes; rungs one through five and
//! Journey 2 stay their own green binaries.
//!
//!   rye build pond/apps/realidream_view_theme.rye -femit-bin=pond/bin/realidream-view-theme
//!   pond/bin/realidream-view-theme selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const view = @import("realidream_view.rye");
const mb = @import("mantra_browser.rye");
const tokens = @import("brushstroke/tokens.rye");
const skate = @import("brushstroke/skate_grid.rye");
const bp = @import("brushstroke/brush_parse.rye");

const realidream_view_theme_version = "20260812.133056";

// The theme fixture the rung reads -- a real `.brush` authoring file whose style block
// recolors the `read` origin token only, leaving ground and head to inherit.
const theme_path = "pond/apps/read-source.brush";

// The read color the theme authors -- a warm amber, distinct from the base sheet's
// Madder. Warm and low-blue (R204 > G122 > B51), so it passes the design system's own
// palette law; distinctly brighter, so the recolor is unmistakable.
const themed_read_argb: u32 = 0xFF_CC_7A_33;

pub const ThemeError = error{
    ThemeMissingRead,
};

/// Resolve the theme fixture into a token sheet: read the `.brush` file, validate it
/// through the real authoring loop, collect its `style:` block into flat Bron, and
/// infuse that override over `tokens.base_sheet`. Returns the resolved sheet's byte
/// length in `out`. The `read` key the theme overrides now wins in the cascade.
pub fn resolve_theme(io: std.Io, path: []const u8, out: []u8) !u32 {
    // invariant: a real theme path names a file to read.
    assert(path.len > 0);
    // invariant: the resolved sheet fits the token-sheet bound.
    assert(out.len <= tokens.max_sheet_bytes);

    const garden = std.heap.page_allocator;
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, path, garden, .limited(bp.max_brush_bytes));
    // invariant: the source stays inside the brush read budget.
    assert(src.len <= bp.max_brush_bytes);
    defer garden.free(src);

    // Validate the file through the real authoring loop before trusting its style.
    const surface = try bp.parse_brush(src);
    // invariant: a theme fixture declares a non-empty style block to override with.
    if (surface.style_count == 0) return error.ThemeMissingRead;

    // Reassemble the style block into the flat Bron sheet tokens.rye's infuse reads.
    var override_buf: [bp.max_style_bytes]u8 = undefined;
    const over_len = try bp.collect_brush_style(src, &override_buf);
    // invariant: a declared style block collects at least one token line.
    assert(over_len > 0);
    // invariant: a read-source theme names the read token it means to recolor.
    if (std.mem.indexOf(u8, override_buf[0..over_len], "read ") == null) return error.ThemeMissingRead;

    const n = try tokens.resolve(tokens.base_sheet, override_buf[0..over_len], out);
    // invariant: the resolved sheet is non-empty and bounded.
    assert(n > 0);
    assert(n <= out.len);
    return n;
}

/// Count pixels whose visible color exactly matches `c` (ignoring alpha) in a
/// rasterized buffer -- a witness helper proving a specific token color reached (or
/// never reached) the canvas.
fn count_pixels_of_color(pixels: []const u8, stride: u32, width: u32, height: u32, c: skate.Color) u32 {
    // invariant: the stride holds a full row of ARGB8888 pixels.
    assert(stride >= width * 4);
    // invariant: a real canvas has width.
    assert(width > 0);
    // invariant: a real canvas has height.
    assert(height > 0);
    const stride_usize: usize = @intCast(stride);
    var count: u32 = 0;
    var y: u32 = 0;
    while (y < height) : (y += 1) {
        const y_usize: usize = @intCast(y);
        const rowbytes = pixels[y_usize * stride_usize ..][0 .. @as(usize, @intCast(width)) * 4];
        var x: u32 = 0;
        while (x < width) : (x += 1) {
            const px: usize = @intCast(x * 4);
            if (rowbytes[px + 0] == c.b and rowbytes[px + 1] == c.g and rowbytes[px + 2] == c.r) {
                count += 1;
            }
        }
    }
    return count;
}

fn welcome_theme_recolors_read(allocator: std.mem.Allocator, io: std.Io) !void {
    var themed_buf: [tokens.max_sheet_bytes]u8 = undefined;
    const n = try resolve_theme(io, theme_path, &themed_buf);
    const themed = themed_buf[0..n];

    // The themed sheet's read token now resolves to the authored amber, not the base
    // sheet's default Madder -- the override won the cascade on its own key.
    const themed_read = try tokens.token_color(themed, "read");
    const base_read = try tokens.token_color(tokens.base_sheet, "read");
    assert(themed_read.r == 0xCC);
    assert(themed_read.g == 0x7A);
    assert(themed_read.b == 0x33);
    assert(themed_read.r != base_read.r or themed_read.g != base_read.g or themed_read.b != base_read.b);

    // The ink, the edge rule, and the living-edge head all inherit unchanged -- the
    // theme touched only the read origin.
    const themed_head = try tokens.token_color(themed, "head");
    const base_head = try tokens.token_color(tokens.base_sheet, "head");
    // invariant: the living-edge head inherits unchanged -- the theme touched only read.
    assert(themed_head.r == base_head.r);
    assert(themed_head.g == base_head.g);
    assert(themed_head.b == base_head.b);

    // Paint the fused scene with the themed sheet -- every read origin wears the amber.
    var catalog = try view.fused_scene();
    var grid = try skate.Grid.init(allocator, view.view_cols, view.view_rows);
    const rows = try view.paint_origins(&catalog, &grid, themed);
    assert(rows == 10);

    // Rasterize the themed canvas and prove the recolor two ways.
    const paint = try tokens.dress(themed);
    const width: i32 = @intCast(view.view_cols * skate.cell_w);
    const height: i32 = @intCast(view.view_rows * skate.cell_h);
    const stride: u32 = view.view_cols * skate.cell_w * 4;
    const pixel_count: usize = @intCast(stride * @as(u32, @intCast(height)));
    const pixels = try allocator.alloc(u8, pixel_count);
    grid.rasterize(pixels, stride, width, height, paint.paper, paint.ink, 1);

    const w_u: u32 = @intCast(width);
    const h_u: u32 = @intCast(height);
    const themed_read_pixels = count_pixels_of_color(pixels, stride, w_u, h_u, themed_read);
    const base_read_pixels = count_pixels_of_color(pixels, stride, w_u, h_u, base_read);
    // The authored read color reached the canvas -- every read origin burns amber.
    assert(themed_read_pixels > 0);
    // The default Madder left zero pixels -- this is a recolor, never an addition.
    assert(base_read_pixels == 0);
    print("realidream_view_theme: {d} themed-read pixels on the canvas, {d} default-read pixels (recolored)\n", .{ themed_read_pixels, base_read_pixels });
}

fn welcome_theme_read_is_warm(io: std.Io) !void {
    var themed_buf: [tokens.max_sheet_bytes]u8 = undefined;
    const n = try resolve_theme(io, theme_path, &themed_buf);
    // token_color asserts warm/low-blue on the way -- a theme cannot smuggle a cold
    // read origin past the design system's own palette law. The authored value it
    // returns is exactly the amber the fixture declared.
    const themed_read = try tokens.token_color(themed_buf[0..n], "read");
    assert(themed_read.r > themed_read.g);
    assert(themed_read.g > themed_read.b);
    const want = skate.Color{
        .r = @intCast((themed_read_argb >> 16) & 0xFF),
        .g = @intCast((themed_read_argb >> 8) & 0xFF),
        .b = @intCast(themed_read_argb & 0xFF),
    };
    assert(themed_read.r == want.r);
    assert(themed_read.g == want.g);
    assert(themed_read.b == want.b);
    print("realidream_view_theme: the authored read origin is warm/low-blue — the palette law holds through the theme\n", .{});
}

fn welcome_theme_additive_glyphs(allocator: std.mem.Allocator, io: std.Io) !void {
    var themed_buf: [tokens.max_sheet_bytes]u8 = undefined;
    const n = try resolve_theme(io, theme_path, &themed_buf);

    var catalog = try view.fused_scene();
    var grid = try skate.Grid.init(allocator, view.view_cols, view.view_rows);
    _ = try view.paint_origins(&catalog, &grid, themed_buf[0..n]);

    // Theming touches only color -- the painted glyphs still carry the very bytes rung
    // one renders. Editor (render) and view (grid) stay one graph.
    var buf: [mb.max_render_bytes]u8 = undefined;
    const text = try mb.render(&catalog, &buf);
    const first_nl = std.mem.indexOfScalar(u8, text, '\n').?;
    const first_line = text[0..first_nl];
    const painted = grid.row_cells(0);
    // invariant: the grid row holds at least the rendered line's bytes.
    assert(painted.len >= first_line.len);
    assert(std.mem.startsWith(u8, painted, first_line));
    print("realidream_view_theme: theming recolors, never rewrites — text unchanged by the theme\n", .{});
}

fn welcome_no_style_keeps_default(allocator: std.mem.Allocator) !void {
    // A paint with the untouched base sheet keeps the default Madder read origin --
    // proving it is the theme's override, not the paint path, that recolors the mark.
    var catalog = try view.fused_scene();
    var grid = try skate.Grid.init(allocator, view.view_cols, view.view_rows);
    _ = try view.paint_origins(&catalog, &grid, tokens.base_sheet);

    const base_read = try tokens.token_color(tokens.base_sheet, "read");
    const paint = try tokens.dress(tokens.base_sheet);
    const width: i32 = @intCast(view.view_cols * skate.cell_w);
    const height: i32 = @intCast(view.view_rows * skate.cell_h);
    const stride: u32 = view.view_cols * skate.cell_w * 4;
    const pixel_count: usize = @intCast(stride * @as(u32, @intCast(height)));
    const pixels = try allocator.alloc(u8, pixel_count);
    grid.rasterize(pixels, stride, width, height, paint.paper, paint.ink, 1);

    const w_u: u32 = @intCast(width);
    const h_u: u32 = @intCast(height);
    const base_read_pixels = count_pixels_of_color(pixels, stride, w_u, h_u, base_read);
    // Untouched, the base sheet's Madder read origin still reaches the canvas.
    assert(base_read_pixels > 0);
    print("realidream_view_theme: without a theme, the base read origin stands — the override is what recolors\n", .{});
}

fn welcome_theme_refuses_styleless(io: std.Io) !void {
    // The seed fixture declares no style block; theming it names ThemeMissingRead
    // rather than silently painting the default -- a theme must carry a read to win.
    var out: [tokens.max_sheet_bytes]u8 = undefined;
    if (resolve_theme(io, "brushstroke/seed-frame.brush", &out)) |_| {
        unreachable;
    } else |err| {
        // invariant: a style-less fixture refuses by the named error.
        assert(err == error.ThemeMissingRead);
    }
    print("realidream_view_theme: a style-less .brush refuses to theme — ThemeMissingRead\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_theme_recolors_read(garden, io);
        try welcome_theme_read_is_warm(io);
        try welcome_theme_additive_glyphs(garden, io);
        try welcome_no_style_keeps_default(garden);
        try welcome_theme_refuses_styleless(io);
        print("realidream_view_theme {s} — GREEN\n", .{realidream_view_theme_version});
        return 0;
    }
    print("usage: realidream-view-theme selftest\n", .{});
    return 1;
}
