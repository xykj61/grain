//! pond/apps/mantra_browser_view.rye — BUHR Journey 2, Rung 2: the graph, painted.
//!
//! Rung one rendered Mantra's append-only log as a readable revision graph in plain
//! text. This rung carries that very same graph onto WADE1's styled Skate surface:
//! each rendered line lands on a grid row, dressed by a resolved token sheet — Flax
//! paper and Bark ink by default, or the dark cascade when the sheet flips. The
//! browser holds the graph; the sheet holds the colors; Skate paints the glyphs.
//!
//! This is the first proof that editor and view share one graph: `paint_graph`
//! calls `mantra_browser.render` for the exact bytes rung one witnesses, so the
//! painted surface can never drift from the readable text — they are one reading.
//!
//! Additive by construction: it imports mantra_browser, brushstroke/tokens, and
//! brushstroke/skate_grid, calling only their public functions. No file beneath it
//! changes; rung one stays its own green binary.
//!
//!   rye build pond/apps/mantra_browser_view.rye -femit-bin=pond/bin/mantra-browser-view
//!   pond/bin/mantra-browser-view selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const mb = @import("mantra_browser.rye");
const mn = @import("mantra/recall_lap1.rye");
const tokens = @import("brushstroke/tokens.rye");
const skate = @import("brushstroke/skate_grid.rye");

const mantra_browser_view_version = "20260812.151400";

// A bounded viewport: wide enough for a lane line, tall enough for the demo graph
// and any small catalog, both well inside Skate's own grid discipline.
pub const view_cols: u32 = 48;
pub const view_rows: u32 = 16;

pub const ViewError = error{
    ViewTooNarrow,
};

/// Paint the browser's append-only graph onto a styled Skate grid. Each rendered
/// line lands on the next grid row, dressed by `sheet` (paper/ink). Returns the
/// number of rows painted. The graph comes straight from `mantra_browser.render`,
/// so the painted view and the readable text are the same reading — never two.
pub fn paint_graph(catalog: *const mn.BoltCatalog, grid: *skate.Grid, sheet: []const u8) !u32 {
    // invariant: the grid is at least one row tall
    assert(grid.rows >= 1);
    // invariant: the sheet carries at least a paper token to lower from
    assert(sheet.len > 0);

    var buf: [mb.max_render_bytes]u8 = undefined;
    const text = try mb.render(catalog, &buf);
    // invariant: the render honors its own budget
    assert(text.len <= mb.max_render_bytes);

    var row: u32 = 0;
    var start: u32 = 0;
    var i: u32 = 0;
    // invariant: the scan walks the rendered text exactly once
    assert(text.len <= mb.max_render_bytes);
    while (i < text.len) : (i += 1) {
        if (text[i] != '\n') continue;
        const line = text[start..i];
        start = i + 1;
        if (line.len == 0) continue;
        if (row >= grid.rows) break; // bounded: never paint past the viewport
        if (line.len > grid.cols) return error.ViewTooNarrow;
        _ = try tokens.dress_grid(grid, row, line, sheet);
        row += 1;
    }
    // invariant: painted rows never exceed the grid's bounded height
    assert(row <= grid.rows);
    return row;
}

fn welcome_painted(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    const rows = try paint_graph(&catalog, &grid, tokens.base_sheet);
    // The demo graph is six lines: header, two bolt headers, three lanes.
    assert(rows == 6);
    // The first grid row carries the graph header, glyph for glyph.
    const head = grid.row_cells(0);
    assert(std.mem.startsWith(u8, head, "mantra log"));
    print("mantra_browser_view: graph painted onto {d} styled rows\n", .{rows});
}

fn welcome_shared_graph(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    _ = try paint_graph(&catalog, &grid, tokens.base_sheet);

    // Re-render the same catalog and confirm the painted grid carries the very same
    // first line — editor (render) and view (grid) are one graph, not two readings.
    var buf: [mb.max_render_bytes]u8 = undefined;
    const text = try mb.render(&catalog, &buf);
    const first_nl = std.mem.indexOfScalar(u8, text, '\n').?;
    const first_line = text[0..first_nl];
    const painted = grid.row_cells(0);
    // invariant: the grid row holds at least the rendered line's bytes
    assert(painted.len >= first_line.len);
    assert(std.mem.startsWith(u8, painted, first_line));
    print("mantra_browser_view: editor and view share one graph — line matches render\n", .{});
}

fn welcome_lit_pixels(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    _ = try paint_graph(&catalog, &grid, tokens.base_sheet);

    const paint = try tokens.dress(tokens.base_sheet);
    const width: i32 = @intCast(view_cols * skate.cell_w);
    const height: i32 = @intCast(view_rows * skate.cell_h);
    const stride: u32 = view_cols * skate.cell_w * 4;
    const pixel_count: usize = @intCast(stride * @as(u32, @intCast(height)));
    const pixels = try allocator.alloc(u8, pixel_count);
    grid.rasterize(pixels, stride, width, height, paint.paper, paint.ink, 1);
    // Glyphs actually reached the canvas — some pixels differ from the paper ground.
    const lit = grid.lit_pixel_count(pixels, stride, width, height, paint.paper);
    assert(lit > 0);
    print("mantra_browser_view: {d} ink pixels lit over Flax paper\n", .{lit});
}

fn welcome_styling_varies() !void {
    // The light sheet and the dark cascade lower to different papers — the styling
    // truly changes the view, it is not a decorative no-op.
    const light = try tokens.dress(tokens.base_sheet);
    var out: [tokens.max_sheet_bytes]u8 = undefined;
    const n = try tokens.resolve(tokens.base_sheet, tokens.dark_override, &out);
    const dark = try tokens.dress(out[0..n]);
    // invariant: dark paper is a distinct ground from light paper
    assert(light.paper.r != dark.paper.r or light.paper.g != dark.paper.g or light.paper.b != dark.paper.b);
    // Flax paper is far brighter than Bark paper — a wide, honest lightness spread.
    assert(light.paper.r > dark.paper.r);
    print("mantra_browser_view: light and dark sheets paint distinct grounds\n", .{});
}

fn welcome_bounded_viewport(allocator: std.mem.Allocator) !void {
    // A grid shorter than the graph paints only what fits — bounded, never an
    // overflow past the viewport's rows.
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, 3);
    const rows = try paint_graph(&catalog, &grid, tokens.base_sheet);
    assert(rows == 3);
    print("mantra_browser_view: short viewport bounded to {d} rows (no overflow)\n", .{rows});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_painted(garden);
        try welcome_shared_graph(garden);
        try welcome_lit_pixels(garden);
        try welcome_styling_varies();
        try welcome_bounded_viewport(garden);
        print("mantra_browser_view {s} — GREEN\n", .{mantra_browser_view_version});
        return 0;
    }
    print("usage: mantra-browser-view selftest\n", .{});
    return 1;
}
