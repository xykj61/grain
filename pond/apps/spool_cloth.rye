//! pond/apps/spool_cloth.rye -- GISM red %73 follow: the naming layer over the spool.
//!
//! Chapter 2, Yield. `mantra/spool.rye` closed red %73 by winding a large artifact
//! across ordered resins; yet a spool alone is a recipe, not a name. Tablecloth
//! (pond/apps/tablecloth.rye) is the naming layer over one-resin beading -- a human name
//! bound to a content address, fetch-by-name returning exactly the bytes whose digest
//! the name pins. This is Tablecloth's sibling for large artifacts: a human name bound
//! to a whole spool, so a real front-door document -- too large for one resin -- is
//! stored under a name and fetched back byte-for-byte. It is the layer provenance needs
//! to carry a *signed* real large document (a later rung), exactly as the small
//! owner-signed catalog needed Tablecloth beneath it.
//!
//! It invents no storage: the beads live in the shared BeadStore the spool wound them
//! into; the catalog holds each artifact's spool (its ordered resin recipe) and its
//! name. Asking by name unspools -- every bead proving itself by digest, every resin
//! against its recorded whole-digest, the whole against the spool's content address --
//! so a tampered byte anywhere refuses before a single byte is trusted. The Brix-facing
//! face is a `format spool-cloth-v1` manifest: one `large <name> <whole-hex> <len>
//! <resins>` line per artifact, render and parse round-tripping name, address, length,
//! and resin count. A name is one field of that line, so a space or a newline inside one
//! refuses at the store edge (NameHasSeparator) rather than rendering a manifest this
//! module's own parser rejects.
//!
//!   rye build pond/apps/spool_cloth.rye -femit-bin=pond/bin/spool-cloth
//!   pond/bin/spool-cloth selftest
//!
//! Scope: active-designing/date/20260812/20260812-191206_gism-red73-spool-chunking-storage-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const beading = @import("mantra/beading.rye");
const spool = @import("mantra/spool.rye");
const tally_copy = @import("tally_copy.rye");
const parse_int = @import("parse_int.rye");

pub const spool_cloth_version = "20260812.192400";

// A large artifact's human name. Short and plain, so a manifest line stays readable. A
// bound on LENGTH alone: the manifest's grammar is held by name_is_one_field below, rather
// than by this number staying too small for a forged line to fit inside a name.
pub const max_name: u32 = 48;
// How many large artifacts one cloth holds. Bounded small on purpose: each entry owns a
// whole spool (its ordered resin recipe, ~33 KB), so the catalog is heavy by design --
// four named large artifacts is ample for the naming crux and keeps the store legible.
// This bounds NAMES, and the shared store is a second wall that bounds BYTES; read
// guaranteed_full_artifacts below before trusting this number as a capacity.
pub const max_large_artifacts: u32 = 4;

// What one ceiling-sized artifact costs the shared store, derived rather than spelled: it
// fills every one of the spool's max_resins resins, and the spool beads each full resin at
// beading.max_bead_bytes, so a full max_resin_bytes resin becomes that many beads.
const full_artifact_beads: u32 = spool.max_resins * (beading.max_resin_bytes / beading.max_bead_bytes);

// How many CEILING artifacts a shared store holds from empty. max_large_artifacts counts
// names and this counts bytes, and today the two disagree -- so a caller storing real
// ceiling artifacts meets StoreFull while catalog seats still stand free, and the selftest
// prints both readings rather than a comment spelling numbers that drift. Published because
// an advertised bound a caller cannot reach is a promise nobody can check (REDS %341).
// Floor division on purpose: a guarantee rounds down.
pub const guaranteed_full_artifacts: u32 = beading.max_store_beads / full_artifact_beads;

const digest_raw_len: u32 = 32;
const digest_hex_len: u32 = digest_raw_len * 2;

pub const ClothError = error{
    NameEmpty,
    NameTooLong,
    NameHasSeparator,
    NameTaken,
    UnknownArtifact,
    CatalogFull,
    Overflow,
    BadManifest,
};

// One named large artifact: its name and the whole spool that reassembles it.
// Invariant: name_len <= max_name; the spool honors the Spool invariant.
const LargeEntry = struct {
    name: [max_name]u8,
    name_len: u32,
    spool: spool.Spool,
};

/// A bounded catalog binding names to spooled large artifacts over a shared BeadStore.
// Invariant: count <= max_large_artifacts; every live entry honors LargeEntry.
pub const LargeCatalog = struct {
    entries: [max_large_artifacts]LargeEntry,
    count: u32,

    pub fn empty() LargeCatalog {
        return .{ .entries = undefined, .count = 0 };
    }

    fn find(self: *const LargeCatalog, name: []const u8) ?u32 {
        // invariant: the search stays within the live count
        assert(self.count <= max_large_artifacts);
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            const e = &self.entries[i];
            if (std.mem.eql(u8, e.name[0..e.name_len], name)) return i;
        }
        // invariant: a miss scanned every live entry
        assert(i == self.count);
        return null;
    }
};

fn write_hex_lower(bytes: []const u8, out: []u8) void {
    // invariant: the output holds two hex chars per input byte
    assert(out.len >= bytes.len * 2);
    const digits = "0123456789abcdef";
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = digits[bytes[i] >> 4];
        out[i * 2 + 1] = digits[bytes[i] & 0x0F];
    }
    // invariant: every input byte produced its two hex chars
    assert(i == bytes.len);
}

// A name travels the manifest as one field on one line, so the two bytes that grammar
// reserves can never sit inside one: a space would split the name across two fields, and a
// newline would split its line in two. Read at the edge a name enters, so every name the
// catalog holds renders a line that parses back. One shape with tablecloth's own wall,
// because both modules flatten a name into a space-delimited line and read it back.
fn name_is_one_field(name: []const u8) bool {
    // invariant: the scan reads a name already inside its length bound
    assert(name.len <= max_name);
    var i: u32 = 0;
    while (i < name.len) : (i += 1) {
        if (name[i] == ' ' or name[i] == '\n') return false;
    }
    // invariant: a name that reaches here was read whole
    assert(i == name.len);
    return true;
}

/// Store a large artifact under a name. The content is wound across ordered resins into
/// the shared store (dedup earned across artifacts that share resins), and the catalog
/// records the name and the whole spool. Refuses an empty/overlong/taken name, a name
/// carrying a manifest separator (NameHasSeparator), a full catalog, and (through the
/// spool) content past the spool ceiling (ContentTooLarge) or a shared store with no room
/// left (StoreFull) -- the refusal a caller storing ceiling artifacts meets FIRST, since
/// the store pays for guaranteed_full_artifacts of them where the catalog advertises
/// max_large_artifacts names.
pub fn store_large(
    cat: *LargeCatalog,
    store: *beading.BeadStore,
    name: []const u8,
    content: []const u8,
) (beading.BeadError || spool.SpoolError || ClothError)!spool.SpoolReport {
    if (name.len == 0) return error.NameEmpty; // a name carries at least one byte
    if (name.len > max_name) return error.NameTooLong; // a name fits its budget
    if (!name_is_one_field(name)) return error.NameHasSeparator; // a name is one manifest field
    if (cat.find(name) != null) return error.NameTaken; // names are unique in a cloth
    if (cat.count >= max_large_artifacts) return error.CatalogFull; // the catalog is bounded
    // invariant: room remains for exactly this entry
    assert(cat.count < max_large_artifacts);

    var e = &cat.entries[cat.count];
    e.spool = spool.Spool.empty();
    const rep = try spool.spool_content(store, content, &e.spool);
    tally_copy.copy_disjoint(u8, e.name[0..name.len], name);
    e.name_len = @intCast(name.len);
    cat.count += 1;

    // invariant: the catalog grew and stays within its bound
    assert(cat.count <= max_large_artifacts);
    return rep;
}

/// Fetch a large artifact by name into out, returning its length. Reassembly proves
/// every bead against its digest, every resin against its whole-digest, and the whole
/// against the spool's content address, so a tampered bead or recipe refuses; an unknown
/// name refuses (UnknownArtifact).
pub fn fetch_large(
    cat: *const LargeCatalog,
    store: *const beading.BeadStore,
    name: []const u8,
    out: []u8,
) (beading.BeadError || spool.SpoolError || ClothError)!u32 {
    const i = cat.find(name) orelse return error.UnknownArtifact;
    // invariant: a found index is within the live catalog
    assert(i < cat.count);
    return spool.unspool(store, &cat.entries[i].spool, out);
}

/// The catalog index a name occupies, or null if unknown. The keyed layer
/// (spool_keyed.rye) reads the owning point recorded alongside this index, so an
/// owner-signed large artifact resolves not only to its bytes but to whose it is.
pub fn index_of(cat: *const LargeCatalog, name: []const u8) ?u32 {
    // invariant: the lookup stays within the catalog bound
    assert(cat.count <= max_large_artifacts);
    return cat.find(name);
}

/// The whole length of the artifact a name pins. Refuses an unknown name.
pub fn large_len(cat: *const LargeCatalog, name: []const u8) ClothError!u32 {
    // invariant: the search stays within the catalog bound
    assert(cat.count <= max_large_artifacts);
    const i = cat.find(name) orelse return error.UnknownArtifact;
    // invariant: a found index is within the live catalog
    assert(i < cat.count);
    return cat.entries[i].spool.whole_len;
}

/// Render the catalog as its `format spool-cloth-v1` manifest, returning its length. One
/// `large <name> <whole-hex> <len> <resins>` line per artifact, in held order.
pub fn render_manifest(cat: *const LargeCatalog, out: []u8) ClothError!u32 {
    // invariant: a manifest names at most the catalog bound
    assert(cat.count <= max_large_artifacts);
    const header = "format spool-cloth-v1\n";
    if (header.len > out.len) return error.Overflow;
    tally_copy.copy_disjoint(u8, out[0..header.len], header);
    var off: u32 = @intCast(header.len);

    var i: u32 = 0;
    while (i < cat.count) : (i += 1) {
        const e = &cat.entries[i];
        var hex: [digest_hex_len]u8 = undefined;
        write_hex_lower(e.spool.whole_digest[0..], hex[0..]);
        const line = std.fmt.bufPrint(out[off..], "large {s} {s} {d} {d}\n", .{
            e.name[0..e.name_len], hex[0..], e.spool.whole_len, e.spool.resin_count,
        }) catch return error.Overflow;
        off += @intCast(line.len);
    }
    // invariant: the rendered manifest stays within the buffer
    assert(off <= out.len);
    return off;
}

// A parsed manifest entry: the published name, address (hex), length, and resin count.
pub const ManifestEntry = struct {
    name: [max_name]u8,
    name_len: u32,
    digest_hex: [digest_hex_len]u8,
    whole_len: u32,
    resin_count: u32,
};

/// The Brix-facing manifest read back: names, addresses, lengths, resin counts.
// Invariant: count <= max_large_artifacts.
pub const Manifest = struct {
    entries: [max_large_artifacts]ManifestEntry,
    count: u32,
};

/// Parse a `format spool-cloth-v1` manifest. An unknown header, a malformed line, or an
/// out-of-range field refuses (BadManifest); more artifacts than the bound (CatalogFull).
pub fn parse_manifest(text: []const u8, man: *Manifest) ClothError!void {
    man.count = 0;
    // invariant: parsing starts from an empty manifest
    assert(man.count == 0);

    var lines = std.mem.splitScalar(u8, text, '\n');
    const first = lines.next() orelse return error.BadManifest;
    if (!std.mem.eql(u8, first, "format spool-cloth-v1")) return error.BadManifest;

    while (lines.next()) |line| {
        if (line.len == 0) continue; // a trailing newline yields an empty final piece
        if (man.count >= max_large_artifacts) return error.CatalogFull;

        var parts = std.mem.tokenizeScalar(u8, line, ' ');
        const tag = parts.next() orelse return error.BadManifest;
        if (!std.mem.eql(u8, tag, "large")) return error.BadManifest;
        const name = parts.next() orelse return error.BadManifest;
        const hex = parts.next() orelse return error.BadManifest;
        const len_tok = parts.next() orelse return error.BadManifest;
        const resins_tok = parts.next() orelse return error.BadManifest;
        if (parts.next() != null) return error.BadManifest; // no slack past the fields
        if (name.len == 0) return error.BadManifest;
        if (name.len > max_name) return error.BadManifest;
        if (hex.len != digest_hex_len) return error.BadManifest;
        const whole_len = parse_int.parse_int(u32, len_tok, .{}) catch return error.BadManifest;
        const resin_count = parse_int.parse_int(u32, resins_tok, .{}) catch return error.BadManifest;
        if (resin_count > spool.max_resins) return error.BadManifest;

        var e = &man.entries[man.count];
        tally_copy.copy_disjoint(u8, e.name[0..name.len], name);
        e.name_len = @intCast(name.len);
        tally_copy.copy_disjoint(u8, e.digest_hex[0..], hex);
        e.whole_len = whole_len;
        e.resin_count = resin_count;
        man.count += 1;
    }
    // invariant: a parsed manifest holds no more than the bound
    assert(man.count <= max_large_artifacts);
}

// Two real front-door documents, embedded at compile time through the corpora symlinks
// (the @embedFile idiom Yield lives with: real bytes a keeper reads, no network).
const doc_security = @embedFile("corpora/security.md");
const doc_two_rooms = @embedFile("corpora/two_rooms.md");

// Distinct bead content for the ceiling leg: each bead carries the artifact's tag in its
// first byte and its own index in the rest, so no two beads of one artifact agree and no
// bead of one artifact agrees with another's. Written here rather than reached for in the
// spool, because a naming layer composes the spool's published API alone; it reads the
// bead size through beading's own constant, which is what the spool beads each resin at.
fn fill_distinct(buf: []u8, tag: u8) void {
    // invariant: the fill covers at most one ceiling artifact
    assert(buf.len <= spool.max_content_bytes);
    const n: u32 = @intCast(buf.len); // seam cast: a slice length is usize, our counts are u32
    // invariant: a bead index fits one byte, so two beads of one artifact never agree
    assert(n / beading.max_bead_bytes <= 256);
    var k: u32 = 0;
    while (k < n) : (k += 1) {
        const j: u32 = k / beading.max_bead_bytes;
        buf[k] = if (k % beading.max_bead_bytes == 0) tag else @intCast(j & 0xFF);
    }
    // invariant: the fill reached the end of the buffer
    assert(k == n);
}

/// The catalog counts names and the shared store pays in beads, so a caller storing real
/// ceiling artifacts meets StoreFull with catalog seats still free. Fills the store from
/// empty with guaranteed_full_artifacts ceiling artifacts, proves the next one refuses, and
/// proves the refusal left the named artifacts whole. Returns the beads held across it,
/// which is the reading a report cannot fake (REDS %341).
fn store_refuses_on_beads_not_seats(out: []u8) !u32 {
    var store_f: beading.BeadStore = .empty();
    var cat_f: LargeCatalog = .empty();
    var wide: [spool.max_content_bytes]u8 = undefined;
    // invariant: the store holds at least one ceiling artifact, or this layer cannot serve
    // the artifacts it exists to name
    assert(guaranteed_full_artifacts >= 1);
    // invariant: the catalog advertises at least what the store guarantees
    assert(max_large_artifacts >= guaranteed_full_artifacts);

    var a: u32 = 0;
    while (a < guaranteed_full_artifacts) : (a += 1) {
        // invariant: an artifact tag fits one byte, so every artifact's beads stay distinct
        assert(a < 255);
        fill_distinct(wide[0..], @intCast(a + 1));
        var nm_buf: [16]u8 = undefined;
        const nm = std.fmt.bufPrint(nm_buf[0..], "full{d}.bin", .{a}) catch return error.Overflow;
        const rep = try store_large(&cat_f, &store_f, nm, wide[0..]);
        // invariant: a ceiling artifact dedups against nothing, so every bead is deposited
        assert(rep.beads_deduped == 0);
    }
    const held: u32 = store_f.count;
    // invariant: less room remains than one more ceiling artifact needs -- which is the
    // whole reason the next store refuses, stated rather than assumed from the numbers
    assert(beading.max_store_beads - held < full_artifact_beads);

    fill_distinct(wide[0..], @intCast(guaranteed_full_artifacts + 1));
    if (store_large(&cat_f, &store_f, "one-too-many.bin", wide[0..])) |_| {
        return error.StoreFull; // a name the store cannot pay for must never report success
    } else |err| {
        // invariant: the refusal is the store's own named error, reached through the spool
        assert(err == error.StoreFull);
    }
    // invariant: the catalog refused on BYTES with seats to spare -- the two bounds disagree
    assert(cat_f.count == guaranteed_full_artifacts);
    assert(cat_f.count < max_large_artifacts);
    // invariant: the refused store left no bead behind
    assert(store_f.count == held);

    // invariant: every name held before the refusal still fetches whole and byte-for-byte
    fill_distinct(wide[0..], 1);
    const nf = try fetch_large(&cat_f, &store_f, "full0.bin", out);
    assert(nf == wide.len);
    assert(std.mem.eql(u8, out[0..nf], wide[0..]));
    return held;
}

fn run_spool_cloth_selftest() !u8 {
    var store: beading.BeadStore = .empty();
    var cat: LargeCatalog = .empty();
    var out: [spool.max_content_bytes]u8 = undefined;

    // invariant: both real documents genuinely exceed one resin -- the naming layer earns
    // its keep only on artifacts the small Tablecloth could not hold
    assert(doc_security.len > beading.max_resin_bytes);
    assert(doc_two_rooms.len > beading.max_resin_bytes);

    // Store two real documents under names, and one of them under a second name.
    const rep_s = try store_large(&cat, &store, "security.md", doc_security);
    assert(rep_s.beads_deposited >= 1); // a fresh large artifact deposits its beads
    const rep_copy = try store_large(&cat, &store, "security-copy.md", doc_security);
    assert(rep_copy.beads_deposited == 0); // identical content: every resin already held
    assert(rep_copy.beads_deduped == rep_copy.bead_count); // full dedup across the name
    const rep_t = try store_large(&cat, &store, "two_rooms.md", doc_two_rooms);
    assert(rep_t.beads_deposited >= 1);
    assert(cat.count == 3);

    // Fetch each by name and prove the bytes returned are exactly the real document's.
    const n1 = try fetch_large(&cat, &store, "security.md", out[0..]);
    assert(n1 == doc_security.len);
    assert(std.mem.eql(u8, out[0..n1], doc_security));
    const n2 = try fetch_large(&cat, &store, "security-copy.md", out[0..]);
    assert(std.mem.eql(u8, out[0..n2], doc_security)); // one storage, two true names
    const n3 = try fetch_large(&cat, &store, "two_rooms.md", out[0..]);
    assert(std.mem.eql(u8, out[0..n3], doc_two_rooms));

    // The Brix-facing manifest round-trips: render then parse recovers name, address,
    // length, and resin count for every entry, field for field.
    var man_bytes: [1024]u8 = undefined;
    const man_len = try render_manifest(&cat, man_bytes[0..]);
    var man: Manifest = undefined;
    try parse_manifest(man_bytes[0..man_len], &man);
    assert(man.count == cat.count);
    {
        var i: u32 = 0;
        while (i < man.count) : (i += 1) {
            const ce = &cat.entries[i];
            const me = &man.entries[i];
            assert(std.mem.eql(u8, me.name[0..me.name_len], ce.name[0..ce.name_len]));
            assert(me.whole_len == ce.spool.whole_len);
            assert(me.resin_count == ce.spool.resin_count);
            var hex: [digest_hex_len]u8 = undefined;
            write_hex_lower(ce.spool.whole_digest[0..], hex[0..]);
            assert(std.mem.eql(u8, me.digest_hex[0..], hex[0..]));
        }
    }

    // Unwelcome: a tampered bead refuses the fetch by digest, in a fresh store so the
    // rest of the selftest is untouched.
    {
        var store_t: beading.BeadStore = .empty();
        var cat_t: LargeCatalog = .empty();
        _ = try store_large(&cat_t, &store_t, "brief.md", doc_two_rooms);
        store_t.beads[0].bytes[0] +%= 1; // flip one byte of a held bead
        if (fetch_large(&cat_t, &store_t, "brief.md", out[0..])) |_| {
            return error.DigestMismatch;
        } else |err| {
            assert(err == error.DigestMismatch);
        }
    }

    // Unwelcome: an unknown name refuses.
    if (fetch_large(&cat, &store, "absent.md", out[0..])) |_| {
        return error.UnknownArtifact;
    } else |err| {
        assert(err == error.UnknownArtifact);
    }

    // Unwelcome: a name already taken refuses.
    if (store_large(&cat, &store, "security.md", doc_two_rooms)) |_| {
        return error.NameTaken;
    } else |err| {
        assert(err == error.NameTaken);
    }

    // Unwelcome: an empty name refuses.
    if (store_large(&cat, &store, "", doc_security)) |_| {
        return error.NameEmpty;
    } else |err| {
        assert(err == error.NameEmpty);
    }

    // Unwelcome: a name carrying a manifest separator refuses at the edge. A space would
    // split the name across two fields; a newline would split its line in two.
    {
        if (store_large(&cat, &store, "my notes", doc_two_rooms)) |_| {
            return error.NameHasSeparator;
        } else |err| {
            assert(err == error.NameHasSeparator);
        }
        if (store_large(&cat, &store, "two\nlines", doc_two_rooms)) |_| {
            return error.NameHasSeparator;
        } else |err| {
            assert(err == error.NameHasSeparator);
        }
    }

    // And the reason that wall stands, proven from the parser's side rather than argued:
    // the line such a name WOULD have rendered reads as a different shape and refuses. So
    // without the wall a lawfully stored name could publish a manifest this module's own
    // parser rejects. 256 bytes holds the header, one line, a 64-char address, a length,
    // and a resin count.
    {
        var line_buf: [256]u8 = undefined;
        var hex: [digest_hex_len]u8 = undefined;
        write_hex_lower(cat.entries[0].spool.whole_digest[0..], hex[0..]);
        const split = std.fmt.bufPrint(line_buf[0..], "format spool-cloth-v1\nlarge my notes {s} {d} {d}\n", .{
            hex[0..], cat.entries[0].spool.whole_len, cat.entries[0].spool.resin_count,
        }) catch return error.Overflow;
        var bad_split: Manifest = undefined;
        if (parse_manifest(split, &bad_split)) |_| {
            return error.BadManifest;
        } else |err| {
            assert(err == error.BadManifest);
        }
    }

    // Unwelcome: the catalog counts names and the store pays in beads, so a ceiling artifact
    // past what the store holds refuses StoreFull with catalog seats still free.
    const held = try store_refuses_on_beads_not_seats(out[0..]);

    // Unwelcome: a manifest with the wrong header refuses.
    {
        var bad: Manifest = undefined;
        if (parse_manifest("format not-a-cloth\nlarge a ff 1 1\n", &bad)) |_| {
            return error.BadManifest;
        } else |err| {
            assert(err == error.BadManifest);
        }
    }

    print("spool_cloth: stored 3 names over 2 real documents; one document stored once, named twice\n", .{});
    print("spool_cloth: dedup dividend — security-copy deposited {d} beads, deduped {d}\n", .{
        rep_copy.beads_deposited, rep_copy.beads_deduped,
    });
    print("spool_cloth: fetch by name returned {d}/{d}/{d} real bytes, each byte-for-byte\n", .{
        n1, n2, n3,
    });
    print("spool_cloth: format spool-cloth-v1 manifest round-tripped {d} artifacts, len {d}\n", .{
        man.count, man_len,
    });
    print("spool_cloth: tampered bead, unknown name, taken name, empty name, bad manifest refused GREEN\n", .{});
    print("spool_cloth: a name carrying a manifest separator refused whole GREEN\n", .{});
    print("spool_cloth: the store pays in beads -- {d} ceiling artifacts held {d} of {d} beads, and the next refused StoreFull with {d} of {d} catalog seats free\n", .{
        guaranteed_full_artifacts, held,          beading.max_store_beads,
        max_large_artifacts - guaranteed_full_artifacts, max_large_artifacts,
    });
    print("spool_cloth: version {s}\n", .{spool_cloth_version});
    print("GREEN: a large real document gets a name; fetch returns the true bytes, whole.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2) {
        if (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "spool-cloth")) {
            return run_spool_cloth_selftest();
        }
    }
    return run_spool_cloth_selftest();
}
