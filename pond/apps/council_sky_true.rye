//! pond/apps/council_sky_true.rye — Season 3 Journey 11 (Council skies), Rung 4: the council reads true (Journey 11 closes).
//!
//! Rungs one through three fixed the council rule, signed each ballot, and let a signed council travel as
//! Bron — all over councils seated in code. This closing rung carries the reader onto a **real** council
//! record a keeper can open and count, and proves the property the whole council layer rests on: what the
//! reader *reports* about a council is true to the bytes.
//!
//! The corpus is `skate/fixtures/council.bron`, a genuine `format council-sky-v1` record with real
//! Ed25519 ballot signatures (the council sky's triad, size 3, quorum 2; two yes-ballots decide proposal
//! A, one yes-ballot holds proposal B open), `@embedFile`-bound at compile time through a symlink in
//! `pond/apps/corpora/` — no network, the bytes read are the tree's own. Two independent readings must
//! agree: the app parses the record through rung three and reports the **seated size**, the **ballot
//! count**, and the **decided-proposal count** (distinct proposals whose one-sided tally reaches the
//! quorum — a proposal short of quorum holds open and is not counted), and the witness cross-checks that
//! triple against `tools/fixtures/council_sky_truth.awk`'s reading of the same file — two tools, one
//! answer. And the record is genuinely tie-free and quorum-honest: `still_quorum_honest` re-verifies
//! every carried ballot signature against the demo keyring, and `rebuild` recovers proposal A's passage
//! and proposal B's open hold exactly, so the fixture is a real signed council, not a hollow shape.
//!
//! Additive — composes rungs one, two, and three over public API (all re-run GREEN). Demo keeper seeds
//! only, reads no network (a council served over the wire reaches the serve gate — Keaton's hand).
//!
//!   rye build pond/apps/council_sky_true.rye -femit-bin=pond/bin/council-sky-true
//!   pond/bin/council-sky-true selftest
//!
//! Scope: active-designing/20260812-210603_dahl-journey11-council-skies-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const council_mod = @import("council_sky.rye");
const signed = @import("council_sky_signed.rye");
const bron = @import("council_sky_bron.rye");
const kumara = @import("kumara.rye");

pub const council_sky_true_version = "20260812.210603";

/// The real council record, bound at compile time — the tree's own bytes, never a drifting copy.
const real_council = @embedFile("corpora/council.bron");

/// The three facts a keeper can count by hand: the seated size, the ballots cast, and proposals decided.
pub const Reading = struct {
    size: u32,
    ballots: u32,
    decided: u32,
};

/// The majority quorum of an odd body — the same rule rung one seats. A record's size is odd, so this is
/// its strict majority.
fn quorum_of(size: u32) u32 {
    return size / 2 + 1;
}

/// How many distinct ballots on this proposal took the given side (yes or no)? The record holds each
/// (seat, proposal) pair once (rung one refuses a doubled ballot before render), so this is a count of
/// distinct hands on one side.
fn side_tally(pc: *const bron.PortableCouncil, proposal: u32, yea: bool) u32 {
    // invariant: the scan stays within the parsed vote book.
    assert(pc.vote_count <= bron.max_votes);
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < pc.vote_count) : (i += 1) {
        if (pc.ballot_proposals[i] == proposal and pc.ballot_yeas[i] == yea) count += 1;
    }
    return count;
}

/// Count proposals decided by quorum — a distinct proposal whose yes-tally or no-tally reaches the
/// quorum. Each proposal is judged once (at its first ballot line), so a proposal voted on twice is not
/// double-counted, and one short of quorum on both sides is not counted at all.
fn decided_count(pc: *const bron.PortableCouncil) u32 {
    const quorum = quorum_of(pc.size);
    var decided: u32 = 0;
    var i: u32 = 0;
    while (i < pc.vote_count) : (i += 1) {
        const proposal = pc.ballot_proposals[i];
        // Only judge at the first appearance of this proposal, so each is counted once.
        var first = true;
        var j: u32 = 0;
        while (j < i) : (j += 1) {
            if (pc.ballot_proposals[j] == proposal) first = false;
        }
        const reached = side_tally(pc, proposal, true) >= quorum or side_tally(pc, proposal, false) >= quorum;
        if (first and reached) decided += 1;
    }
    // invariant: no more proposals are decided than there are ballots.
    assert(decided <= pc.vote_count);
    return decided;
}

/// Read the real council: parse it and count the three facts. The parse refuses a malformed record by
/// rung three's own reasons; here the bytes are the tree's own, so the reading is honest by construction.
pub fn read_council(text: []const u8) bron.BronError!Reading {
    const pc = try bron.parse(text);
    return .{ .size = pc.size, .ballots = pc.vote_count, .decided = decided_count(&pc) };
}

// --- selftest -----------------------------------------------------------

// Demo keeper seeds — the same seeds the fixture was signed with, so the record verifies as real.
const seat0_seed: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const seat1_seed: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const seat2_seed: [kumara.seed_length]u8 = .{0x33} ** kumara.seed_length;

const demo_council: u32 = 9;
const prop_a: u32 = 3;
const prop_b: u32 = 4;

fn pubkey_of(seed: *const [kumara.seed_length]u8) [signed.pubkey_len]u8 {
    return kumara.keypair_from_seed(seed).public_key.bytes;
}

fn demo_ring() error{KeyringFull}!signed.Keyring {
    var ring = signed.Keyring.open();
    try ring.enroll(0, pubkey_of(&seat0_seed));
    try ring.enroll(1, pubkey_of(&seat1_seed));
    try ring.enroll(2, pubkey_of(&seat2_seed));
    return ring;
}

/// The reading of the real record — the witness cross-checks this triple against awk's reading of the
/// same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_council(real_council);
    // The fixture holds a triad (size 3), three ballots, and exactly one decided proposal (A passed).
    assert(r.size == 3);
    assert(r.ballots == 3);
    assert(r.decided == 1);
    print("council_sky_true: truth-triple {d} {d} {d}\n", .{ r.size, r.ballots, r.decided });
    print("council_sky_true: the reading of the real record — size, ballots, decided — matches an independent count of the same bytes.\n", .{});
}

/// The record is genuinely tie-free and quorum-honest — every carried ballot signature verifies against
/// the demo keyring, and the rebuilt council carries proposal A's passage and proposal B's open hold
/// exactly, the odd-body tie-free invariant holding.
fn welcome_record_is_really_honest() !void {
    const ring = try demo_ring();
    const pc = try bron.parse(real_council);
    try pc.still_quorum_honest(&ring); // a hollow or tampered fixture would refuse here
    const council = try pc.rebuild(&ring);
    assert(council.outcome(prop_a) == .passed); // decided by a quorum of two — a real decision
    assert(council.outcome(prop_b) == .open); // one yes-ballot — held open, never decided
    assert(2 * council.quorum > council.size); // the odd-body tie-free invariant holds on the real record
    print("council_sky_true: the real record re-verified every ballot offline and rebuilt proposal A's passage and proposal B's open hold exactly.\n", .{});
}

/// A tampered copy of the real bytes refuses — the reader will not read a corrupted record as true.
fn unwelcome_tampered_record_refuses() !void {
    // Flip a byte inside the header so the record no longer names its format.
    var buf: [real_council.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_council.len) : (k += 1) buf[k] = real_council[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_council(buf[0..]);
    assert(bad == error.BadFormat);
    print("council_sky_true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_record_is_really_honest();
    try unwelcome_tampered_record_refuses();
    print("council_sky_true: version {s}\n", .{council_sky_true_version});
    print("GREEN: DAHL-J11r4 council_sky_true; the reading of a real council record is true to the bytes, and the record is genuinely tie-free and quorum-honest.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<size> <ballots> <decided>`), so the witness can compare the
/// app's reading against `council_sky_truth.awk` byte for byte — two tools, one answer.
fn run_measure() !u8 {
    const r = try read_council(real_council);
    print("{d} {d} {d}\n", .{ r.size, r.ballots, r.decided });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "council-sky-true"))) {
        return run_selftest();
    }
    return run_selftest();
}
