//! pond/apps/graph_query.rye -- BUHR Journey 6, Rung 1: the intelligence reads the surface.
//!
//! BUHR is Surface & Intelligence. Journey 1 raised the intelligence (the Q-vane
//! voices, each answering over a pinned corpus); Journeys 2-5 raised the surface
//! (the Realidream Mantra graph -- browsed, edited, themed). This rung fuses the two
//! halves the equinox is named for: a Lantern-shaped request whose *corpus is the
//! living Mantra graph itself* -- the very BoltCatalog the browser renders -- answered
//! and metered by the same contract that governs every other voice.
//!
//! No pinned answer: the number returned is a true reading of the actual catalog
//! (lanes, bolts, a lane's head revision), read through the Mantra browser's own
//! public readers. So the intelligence and the surface share one graph, exactly as
//! editor and view already do -- the count the voice reports is the count the painted
//! view shows.
//!
//! Additive by construction: it imports lantern_core and mantra_browser and calls
//! only their public functions. Neither contract changes; the reading journeys stay
//! their own green binaries.
//!
//!   rye build pond/apps/graph_query.rye -femit-bin=pond/bin/graph-query
//!   pond/bin/graph-query selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const lc = @import("lantern/lantern_core.rye");
const mb = @import("mantra_browser.rye");
const mn = @import("mantra/recall_lap1.rye");

const graph_query_version = "20260812.140058";

const max_result_text: u32 = lc.max_completion_len; // never exceed Lantern's completion bound

// The lane the `head` op reads -- the demo catalog's two-revision lane, so the head
// the voice reports (r2) is exactly the head the browser and editor journeys show.
const head_peer = "local";
const head_bolt = "notes";
const head_path = "a.txt";

/// The graph operations the router recognizes by name in the prompt. Each routes to
/// a real Mantra-browser reading of the live catalog; unknown prompts refuse.
pub const Op = enum(u8) {
    lane_count,
    bolt_count,
    head,
    summary,
};

pub const QueryError = error{
    UnknownOp,
    ResultTooLong,
    ModelNotAllowed,
    LaneUnknown,
};

/// Recognize the operation named at the head of the prompt. Returns UnknownOp rather
/// than guessing -- the host never invents an answer over a graph it cannot read.
pub fn route_op(prompt: []const u8) QueryError!Op {
    // invariant: the prompt fits Lantern's own bound before we read it
    assert(prompt.len <= lc.max_prompt_len);
    // invariant: a bound prompt names zero or more bytes, never a negative span
    assert(prompt.len >= 0);
    if (std.mem.startsWith(u8, prompt, "lane_count")) return .lane_count;
    if (std.mem.startsWith(u8, prompt, "bolt_count")) return .bolt_count;
    if (std.mem.startsWith(u8, prompt, "summary")) return .summary;
    if (std.mem.startsWith(u8, prompt, "head")) return .head;
    return error.UnknownOp;
}

/// Read the routed operation over the live catalog and format the true result into
/// `out_buf`. The graph is the corpus: every branch calls a public Mantra-browser
/// reader, never a pinned constant.
pub fn compute(op: Op, catalog: *const mn.BoltCatalog, out_buf: []u8) QueryError![]const u8 {
    // invariant: the caller's buffer respects Lantern's completion bound
    assert(out_buf.len <= max_result_text);
    // invariant: there is room for at least one byte
    assert(out_buf.len > 0);

    var written: u32 = 0;
    switch (op) {
        .lane_count => {
            const n = mb.lane_count(catalog);
            const piece = std.fmt.bufPrint(out_buf, "{d}", .{n}) catch return error.ResultTooLong;
            // seam: bufPrint returns usize; it never exceeds the slice it wrote into
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
        .bolt_count => {
            const n = mb.bolt_count(catalog);
            const piece = std.fmt.bufPrint(out_buf, "{d}", .{n}) catch return error.ResultTooLong;
            // seam: bufPrint returns usize; it never exceeds the slice it wrote into
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
        .head => {
            const h = mb.head_revision(catalog, head_peer, head_bolt, head_path) orelse return error.LaneUnknown;
            // invariant: a found head is a real revision, counting from one
            assert(h >= 1);
            const piece = std.fmt.bufPrint(out_buf, "{d}", .{h}) catch return error.ResultTooLong;
            // invariant: bufPrint returns a slice into the buffer it was given, so this states
            // the write stayed inside it rather than checking beforehand
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
        .summary => {
            const bolts = mb.bolt_count(catalog);
            const lanes = mb.lane_count(catalog);
            const piece = std.fmt.bufPrint(out_buf, "bolts={d} lanes={d}", .{ bolts, lanes }) catch return error.ResultTooLong;
            // invariant: bufPrint returns a slice into the buffer it was given, so this states
            // the write stayed inside it rather than checking beforehand
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
    }

    // invariant: we never wrote past the caller's buffer
    assert(written <= out_buf.len);
    return out_buf[0..written];
}

/// Count whitespace-separated words in `text` -- the same token sense Lantern's own
/// length budget uses when it truncates a completion.
pub fn count_words(text: []const u8) u32 {
    // invariant: the text respects Lantern's completion bound
    assert(text.len <= max_result_text);
    var words: u32 = 0;
    var in_word = false;
    var i: u32 = 0;
    // invariant: the loop is bounded by the text length
    assert(text.len <= max_result_text);
    while (i < text.len) : (i += 1) {
        const ch = text[i];
        const is_space = ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r';
        if (!is_space) {
            if (!in_word) {
                words += 1;
                in_word = true;
            }
        } else {
            in_word = false;
        }
    }
    return words;
}

/// The Q-vane query over the demo graph -- the catalog the reading journeys render.
/// A convenience over `answer_over`, so a caller with no catalog of its own still asks
/// against the same living graph the browser paints.
pub fn answer(req: lc.Request, allow_text: []const u8, out_buf: []u8) (lc.LanternError || QueryError)!lc.Response {
    // invariant: the caller's buffer honors Lantern's completion bound
    assert(out_buf.len <= max_result_text);
    // invariant: the buffer can hold at least one token
    assert(out_buf.len > 0);
    var catalog = mb.demo_catalog() catch return error.LaneUnknown;
    return answer_over(req, allow_text, &catalog, out_buf);
}

/// The Q-vane query over an explicit catalog: validate the request against Lantern's
/// contract, gate the model through the allow-list, read the *given* Mantra graph for
/// a true answer, and return a Lantern Response bounded by max_tokens (length stop
/// when the budget bites). The model is never trusted before the list clears; the
/// graph is never guessed at. Taking the catalog explicitly lets a caller ask over an
/// *edited* graph, so the answer tracks the living surface rather than a fixed demo.
pub fn answer_over(req: lc.Request, allow_text: []const u8, catalog: *const mn.BoltCatalog, out_buf: []u8) (lc.LanternError || QueryError)!lc.Response {
    // invariant: the caller's buffer honors Lantern's completion bound
    assert(out_buf.len <= max_result_text);
    // invariant: the buffer can hold at least one token
    assert(out_buf.len > 0);
    // invariant: the graph respects Mantra's binding budget before we read it
    assert(catalog.leaf_count <= mn.max_bindings);

    try lc.validate_request(req);
    if (!lc.model_allowed(req.model_hash, allow_text)) return error.ModelNotAllowed;

    const op = try route_op(req.prompt);
    const text = try compute(op, catalog, out_buf);

    const tokens_in = count_words(req.prompt);
    var tokens_out = count_words(text);
    var final_text = text;
    var reason: lc.StoppedReason = .eos;

    // Honor Lantern's metering: when the real reading outruns the budget, truncate to
    // max_tokens words and mark a length stop -- the same discipline every other voice
    // applies to a reading that outruns its budget.
    if (tokens_out > req.max_tokens) {
        var words: u32 = 0;
        var cut: u32 = 0;
        var i: u32 = 0;
        var in_word = false;
        // invariant: truncation walks no further than the produced text
        assert(text.len <= max_result_text);
        while (i < text.len) : (i += 1) {
            const ch = text[i];
            const is_space = ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r';
            if (!is_space) {
                if (!in_word) {
                    if (words == req.max_tokens) break;
                    words += 1;
                    in_word = true;
                }
                cut = i + 1;
            } else {
                in_word = false;
            }
        }
        final_text = text[0..cut];
        tokens_out = words;
        reason = .length;
    }

    // invariant: the returned text never exceeds Lantern's completion bound
    assert(final_text.len <= lc.max_completion_len);
    // invariant: metered output never exceeds the requested budget
    assert(tokens_out <= req.max_tokens);
    return .{
        .text = final_text,
        .tokens_in = tokens_in,
        .tokens_out = tokens_out,
        .stopped_reason = reason,
    };
}

fn welcome_lane_count_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "lane_count the graph",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // The demo catalog carries three lanes (a.txt, b.txt, index).
    assert(std.mem.eql(u8, resp.text, "3"));
    assert(resp.tokens_out == 1);
    assert(resp.stopped_reason == .eos);
    print("graph_query: lane_count read the live graph — text '{s}' eos\n", .{resp.text});
}

fn welcome_bolt_count_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "bolt_count the graph",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // Two bolts under one peer: local/notes and local/site.
    assert(std.mem.eql(u8, resp.text, "2"));
    assert(resp.stopped_reason == .eos);
    print("graph_query: bolt_count read the live graph — text '{s}' eos\n", .{resp.text});
}

fn welcome_head_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "head the a.txt lane",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // The a.txt lane chains r1 -> r2, so its head revision is 2 -- the same head the
    // browser paints and the editor continues.
    assert(std.mem.eql(u8, resp.text, "2"));
    assert(resp.stopped_reason == .eos);
    print("graph_query: head read the living edge — a.txt at r{s}\n", .{resp.text});
}

fn welcome_summary_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "summary the graph",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    assert(std.mem.eql(u8, resp.text, "bolts=2 lanes=3"));
    assert(resp.tokens_out == 2);
    assert(resp.stopped_reason == .eos);
    print("graph_query: summary read the live graph — text '{s}' eos\n", .{resp.text});
}

fn welcome_length_budget() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "summary the graph",
        .max_tokens = 1,
    };
    const resp = try answer(req, allow, &buf);
    // The real summary is two tokens; a budget of one truncates and marks length.
    assert(resp.tokens_out == 1);
    assert(std.mem.eql(u8, resp.text, "bolts=2"));
    assert(resp.stopped_reason == .length);
    print("graph_query: length budget — tokens {d} length\n", .{resp.tokens_out});
}

fn unwelcome_model_not_allowed() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-not-on-list",
        .prompt = "lane_count the graph",
        .max_tokens = 64,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.ModelNotAllowed);
    }
    print("graph_query: model not allowed refused\n", .{});
}

fn unwelcome_unknown_op() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "translate this poem",
        .max_tokens = 64,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.UnknownOp);
    }
    print("graph_query: unknown op refused (no fake answer)\n", .{});
}

fn unwelcome_zero_budget() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "lane_count the graph",
        .max_tokens = 0,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.BudgetExceeded);
    }
    print("graph_query: zero budget refused by Lantern contract\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_lane_count_query();
        try welcome_bolt_count_query();
        try welcome_head_query();
        try welcome_summary_query();
        try welcome_length_budget();
        try unwelcome_model_not_allowed();
        try unwelcome_unknown_op();
        try unwelcome_zero_budget();
        print("graph_query {s} — GREEN\n", .{graph_query_version});
        return 0;
    }
    print("usage: graph-query selftest\n", .{});
    return 1;
}
