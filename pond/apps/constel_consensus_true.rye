//! pond/apps/constel_consensus_true.rye — the converged mesh reads true (gossip-convergence r4, the arc closes).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · gossip-convergence r4.
//! Design read: active-designing/20260813-040613_constel-consensus-gossip-convergence-exploration.md
//!
//! r1 converged two nodes over gossip; r2 healed a partition; r3 carried the agreed
//! order out as a `format cord-dag-v1` record so a far node could rebuild from bytes
//! alone. This closing rung binds convergence to a **real on-disk record a keeper can
//! open and count**, and proves the property the whole consensus rests on: the order
//! two honest nodes converge to is true to the bytes.
//!
//! The corpus is `tools/fixtures/cord_dag.bron` — the canonical committed Cord record
//! produced reproducibly by `mycelium/cord_fixture_gen.rye` (the honest four-block
//! scene, supply 700 over one star) — `@embedFile`-bound through a symlink in
//! `pond/apps/corpora/`, no network, the tree's own bytes. Two readings must agree:
//! the app parses the record, rebuilds the Dag under r1's own `add` (re-verifying
//! every signature, requiring every parent already held), commits it, and reports the
//! **block count**, the **folded supply**, and the **star count**; the r4 witness
//! cross-checks that triple against `tools/fixtures/cord_dag_truth.awk`'s reading of
//! the same file — two tools, one answer.
//!
//! The crux distinct from the Cord's own r4 (which read a seated-in-code Dag): here
//! two nodes begun from their **own separate genesis** gossip to convergence over
//! r1's `gossip_merge`, and the converged Dag renders **byte-identically** to the
//! canonical on-disk record. So the record a keeper walks by hand is exactly the one
//! the network agrees on — convergence produces the true bytes, not a private draft.
//!
//! Additive — composes r3's `converge_two_nodes` and the Cord's cord-bron reader/writer
//! over public API; r1/r2/r3 re-run GREEN at this round's door. Siloed, dev-only, demo
//! seeds — no real key, no funds, no network, no custody; a Cord gossiped over Comlink
//! reaches the serve gate.
//!
//!   rye build pond/apps/constel_consensus_true.rye -femit-bin=pond/bin/constel-consensus-true
//!   pond/bin/constel-consensus-true selftest | measure

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_bron = @import("cord_bron.rye");
const fold = @import("fold.rye");
const travels = @import("constel_consensus_travels.rye");

pub const constel_consensus_true_version = "20260813.042829";

/// The canonical committed Cord record, bound at compile time — the tree's own bytes,
/// never a drifting copy.
const real_record = @embedFile("corpora/cord_dag.bron");

/// The three facts a keeper can count by hand: how many blocks the agreed order bundles,
/// its folded supply, and how many of those blocks reserve a star.
pub const Reading = struct {
    blocks: u32,
    supply: u64,
    stars: u32,
};

/// Read the real record: parse it, rebuild the Dag under r1's own `add` (verifying every
/// signature and requiring every parent already held), commit it, and fold the supply
/// through the real Mycelium law. The fixture's block lines stand in agreed order, so the
/// app's independent commit must be the identity permutation over them — else the record
/// is not a committed Cord and the reading refuses `OrderNotCanonical`.
pub fn read_record(text: []const u8) !Reading {
    const pl = try cord_bron.parse(text);
    // invariant: a real record carries at least one block — an empty Dag is no consensus.
    if (pl.len == 0) return error.BadFormat;
    var dag = try cord_bron.rebuild(&pl);
    var order: [cord.cord_max_blocks]u32 = undefined;
    const count = cord.commit(&dag, order[0..]);
    // invariant: the recorded block order is the true agreed order (identity permutation).
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        if (order[i] != i) return error.OrderNotCanonical;
    }
    var log = fold.Log.empty();
    cord.committed_log(&dag, order[0..], count, &log);
    const state = try fold.fold_log(&log);
    // invariant: supply is exactly issued minus taxed over the agreed order.
    assert(state.supply() == state.issued - state.taxed);
    return .{ .blocks = pl.len, .supply = state.supply(), .stars = state.star_count };
}

// --- selftest -----------------------------------------------------------

/// The reading of the real record — the witness cross-checks this triple against awk's
/// reading of the same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_record(real_record);
    // The record bundles four blocks, folds to supply 700, reserves one star.
    assert(r.blocks == 4);
    assert(r.supply == 700);
    assert(r.stars == 1);
    print("constel-true: truth-triple {d} {d} {d}\n", .{ r.blocks, r.supply, r.stars });
    print("constel-true: the reading of the real record — blocks, supply, stars — matches an independent count of the same bytes.\n", .{});
}

/// The r4 crux: two nodes begun from their own genesis gossip to convergence, and the
/// converged Dag renders byte-identically to the canonical on-disk record — so the bytes
/// a keeper walks by hand are exactly the order the network agrees on.
fn welcome_convergence_matches_the_record() !void {
    const converged = try travels.converge_two_nodes();
    // invariant: the converged mesh holds exactly the four-block scene.
    assert(converged.len == 4);
    const pl = try cord_bron.from_dag(&converged);
    var buf: [cord_bron.max_record]u8 = undefined;
    const n = try cord_bron.render(&pl, &buf);
    // invariant: two honest nodes converge to byte-identically the canonical record.
    assert(n == real_record.len);
    assert(std.mem.eql(u8, buf[0..n], real_record));
    print("constel-true: two nodes from their own genesis gossip to convergence and render byte-identically to the on-disk record — the network agrees on exactly the bytes a keeper can count.\n", .{});
}

/// A tampered copy of the real bytes refuses — the reader will not read a corrupted record
/// as true. A flipped header byte refuses `BadFormat`; a flipped signature byte would
/// refuse `BadSignature` at add on rebuild.
fn unwelcome_tampered_record_refuses() !void {
    var buf: [real_record.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_record.len) : (k += 1) buf[k] = real_record[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_record(buf[0..]);
    // invariant: a corrupted record is never read as a true agreed order.
    assert(bad == error.BadFormat);
    print("constel-true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_convergence_matches_the_record();
    try unwelcome_tampered_record_refuses();
    print("constel_consensus_true {s} — GREEN\n", .{constel_consensus_true_version});
    print("GREEN: constel consensus r4; the order two honest nodes converge to is true to a real on-disk record (blocks·supply·stars), the converged mesh rendering byte-identically to the bytes a keeper can count. The gossip-convergence arc closes.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<blocks> <supply> <stars>`), so the witness can
/// compare the app's reading against `cord_dag_truth.awk` byte for byte — two tools, one answer.
fn run_measure() !u8 {
    const r = try read_record(real_record);
    print("{d} {d} {d}\n", .{ r.blocks, r.supply, r.stars });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: constel-consensus-true selftest | measure\n", .{});
    return 1;
}
