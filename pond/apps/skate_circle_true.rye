//! pond/apps/skate_circle_true.rye — Season 3 Journey 9 (Skate), Rung 4: the circle reads true (Journey 9 closes).
//!
//! Rungs one through three fixed the consent rule, signed each act, and let a signed circle travel as
//! Bron — all over circles seated in code. This closing rung carries the reader onto a **real** Skate
//! circle record a keeper can open and count, and proves the property the whole social layer rests on:
//! what the reader *reports* about a circle is true to the bytes.
//!
//! The corpus is `skate/fixtures/circle.bron`, a genuine `format skate-circle-v1` record with real
//! Ed25519 signatures (three members; one mutual link and one one-sided hold), `@embedFile`-bound at
//! compile time through a symlink in `pond/apps/corpora/` — no network, the bytes read are the tree's
//! own. Two independent readings must agree: the app parses the record through rung three and reports
//! the member count, the link count, and the **mutual-link count** (an unordered pair both of whose
//! directed requests appear — a one-sided hold is not counted), and the witness cross-checks that
//! triple against `tools/fixtures/skate_circle_truth.awk`'s reading of the same file — two tools, one
//! answer. And the record is genuinely consent-honest: `still_consented` re-verifies every carried
//! signature against the demo keyring, so the fixture is a real signed circle, not a hollow shape.
//!
//! Additive — composes rungs one, two, and three over public API (all re-run GREEN). Demo keeper seeds
//! only, reads no network (a circle served over the wire reaches the serve gate — Keaton's hand).
//!
//!   rye build pond/apps/skate_circle_true.rye -femit-bin=pond/bin/skate-circle-true
//!   pond/bin/skate-circle-true selftest
//!
//! Scope: active-designing/date/20260812/20260812-201611_dahl-journey9-skate-consent-first-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const skate = @import("skate_circle.rye");
const signed = @import("skate_circle_signed.rye");
const bron = @import("skate_circle_bron.rye");
const kumara = @import("kumara.rye");

pub const skate_circle_true_version = "20260812.201611";

/// The real circle record, bound at compile time — the tree's own bytes, never a drifting copy.
const real_circle = @embedFile("corpora/skate_circle.bron");

/// The three facts a keeper can count by hand: members, link requests, and mutual links.
pub const Reading = struct {
    members: u32,
    links: u32,
    mutual: u32,
};

/// Count the mutual links in a parsed circle — an unordered pair {a,b} where both `a→b` and `b→a`
/// appear. Each mutual pair is counted once (when the reciprocal sits at a later index), so a
/// one-sided hold is never counted among them.
fn mutual_links(pc: *const bron.PortableCircle) u32 {
    // invariant: the scan stays within the parsed request book.
    assert(pc.link_count <= bron.max_links);
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < pc.link_count) : (i += 1) {
        var j: u32 = i + 1;
        while (j < pc.link_count) : (j += 1) {
            if (pc.link_from[i] == pc.link_to[j] and pc.link_to[i] == pc.link_from[j]) count += 1;
        }
    }
    // invariant: no pair is counted more than once — mutual links cannot exceed the request count.
    assert(count <= pc.link_count);
    return count;
}

/// Read the real circle: parse it and count the three facts. The parse refuses a malformed record by
/// rung three's own reasons; here the bytes are the tree's own, so the reading is honest by
/// construction.
pub fn read_circle(text: []const u8) bron.BronError!Reading {
    const pc = try bron.parse(text);
    return .{ .members = pc.member_count, .links = pc.link_count, .mutual = mutual_links(&pc) };
}

// --- selftest -----------------------------------------------------------

// Demo keeper seeds — the same seeds the fixture was signed with, so the record verifies as real.
const ivy_seed: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const wren_seed: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const flax_seed: [kumara.seed_length]u8 = .{0x33} ** kumara.seed_length;

const ivy: u32 = 101;
const wren: u32 = 202;
const flax: u32 = 303;
const demo_circle: u32 = 7;

fn pubkey_of(seed: *const [kumara.seed_length]u8) [signed.pubkey_len]u8 {
    return kumara.keypair_from_seed(seed).public_key.bytes;
}

fn demo_ring() error{KeyringFull}!signed.Keyring {
    var ring = signed.Keyring.open();
    try ring.enroll(ivy, pubkey_of(&ivy_seed));
    try ring.enroll(wren, pubkey_of(&wren_seed));
    try ring.enroll(flax, pubkey_of(&flax_seed));
    return ring;
}

/// The reading of the real record — the witness cross-checks this triple against awk's reading of the
/// same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_circle(real_circle);
    // The fixture holds three members, three requests, and exactly one mutual link (ivy↔wren).
    assert(r.members == 3);
    assert(r.links == 3);
    assert(r.mutual == 1);
    print("skate_circle_true: truth-triple {d} {d} {d}\n", .{ r.members, r.links, r.mutual });
    print("skate_circle_true: the reading of the real record — members, links, mutual — matches an independent count of the same bytes.\n", .{});
}

/// The record is genuinely consent-honest — every carried signature verifies against the demo keyring,
/// and the rebuilt circle carries the mutual link and the one-sided hold exactly.
fn welcome_record_is_really_consented() !void {
    const ring = try demo_ring();
    const pc = try bron.parse(real_circle);
    try pc.still_consented(&ring); // a hollow or tampered fixture would refuse here
    const circle = try pc.rebuild(&ring);
    assert(circle.linked(ivy, wren)); // the mutual link is real
    assert(circle.verdict(flax, ivy) == .hold); // flax's one-sided request holds, never links
    assert(!circle.visible(flax, ivy)); // a one-sided hold grants no visibility
    print("skate_circle_true: the real record re-verified every signature offline and rebuilt the mutual link and the one-sided hold exactly.\n", .{});
}

/// A tampered copy of the real bytes refuses — the reader will not read a corrupted record as true.
fn unwelcome_tampered_record_refuses() !void {
    // Flip a byte inside the header so the record no longer names its format.
    var buf: [real_circle.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_circle.len) : (k += 1) buf[k] = real_circle[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_circle(buf[0..]);
    assert(bad == error.BadFormat);
    print("skate_circle_true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_record_is_really_consented();
    try unwelcome_tampered_record_refuses();
    print("skate_circle_true: version {s}\n", .{skate_circle_true_version});
    print("GREEN: DAHL-J9r4 skate_circle_true; the reading of a real circle record is true to the bytes, and the record is genuinely consented.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<members> <links> <mutual>`), so the witness can compare the
/// app's reading against `skate_circle_truth.awk` byte for byte — two tools, one answer.
fn run_measure() !u8 {
    const r = try read_circle(real_circle);
    print("{d} {d} {d}\n", .{ r.members, r.links, r.mutual });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "skate-circle-true"))) {
        return run_selftest();
    }
    return run_selftest();
}
