//! pond/apps/mantra_browser_heads.rye — BUHR Journey 2, Rung 3: the living edge, lit.
//!
//! Rung two carried Mantra's append-only graph onto WADE1's styled Skate surface,
//! every line dressed in one paper and one ink. This rung takes the next crux: it
//! lights each lane's *head* revision — the newest node in a chain, the living edge
//! of that history — in a distinct token color, while the older nodes keep the
//! reading ink. The proof this rung wants is that the styled surface carries
//! *semantic* color per cell — a person reading the graph sees at a glance where
//! each lane's history currently stands — not merely one paper and one ink.
//!
//! It stays on witnessed ground. The head is found in the very bytes rung one
//! renders (the rightmost `r<n>[digest]` on a lane line), so the painted color can
//! never point at a node the readable text does not show. The color lands through
//! WADE1's own `dress_run`, wearing the sheet's warm `edge` token, seated in a
//! bounded palette slot; cells outside the head keep the default ink, so the paint
//! is strictly additive over rung two's single-color lowering — the glyphs, and the
//! text a reader sees, are byte-for-byte the same.
//!
//! Additive by construction: it imports mantra_browser, brushstroke/tokens, and
//! brushstroke/skate_grid, calling only their public functions. No file beneath it
//! changes; rungs one and two stay their own green binaries.
//!
//!   rye build pond/apps/mantra_browser_heads.rye -femit-bin=pond/bin/mantra-browser-heads
//!   pond/bin/mantra-browser-heads selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const mb = @import("mantra_browser.rye");
const mn = @import("mantra/recall_lap1.rye");
const tokens = @import("brushstroke/tokens.rye");
const skate = @import("brushstroke/skate_grid.rye");

const mantra_browser_heads_version = "20260812.161500";

// A bounded viewport, wide enough for a lane line and tall enough for the demo
// graph — the same discipline rung two keeps.
pub const view_cols: u32 = 48;
pub const view_rows: u32 = 16;

// The palette slot the head node wears. A real slot (never the fg sentinel),
// inside Skate's bounded run palette — one color for the living edge.
pub const head_slot: u8 = 3;

// The token a head node wears — the sheet's warm mid rule, distinct from the
// reading ink so the living edge stands out without leaving the warm family.
const head_token = "edge";

pub const HeadsError = error{
    ViewTooNarrow,
};

/// The column span of the head revision node on a rendered line, or null when the
/// line carries no node (the graph title, a bolt header, a blank line). The head is
/// the rightmost `r<digits>[<digest>]` — the newest revision in a dense chain, since
/// Mantra's append-only law renders revisions in ascending order. The span is a
/// half-open `[start, end)` of columns, read straight from the bytes rung one wrote.
pub fn head_span(line: []const u8) ?struct { start: u32, end: u32 } {
    // invariant: a rendered line stays within the render budget, so its length fits u32.
    assert(line.len <= mb.max_render_bytes);
    if (line.len == 0) return null;
    const n: u32 = @intCast(line.len);

    // Walk back to the rightmost ']' — the close of the head node.
    var close: u32 = n; // n means "no close found" (past the last index)
    var i: u32 = n;
    while (i > 0) : (i -= 1) {
        if (line[i - 1] == ']') {
            close = i - 1;
            break;
        }
    }
    if (close == n) return null; // no closing bracket — no node on this line

    // Walk back to the '[' that opens that node, left of the close.
    var open: u32 = 0;
    var found_open = false;
    var j: u32 = close;
    while (j > 0) : (j -= 1) {
        if (line[j - 1] == '[') {
            open = j - 1;
            found_open = true;
            break;
        }
    }
    if (!found_open) return null;

    // Walk left over the revision digits, then require the 'r' that names them.
    var k: u32 = open;
    while (k > 0 and is_digit(line[k - 1])) : (k -= 1) {}
    if (k == open) return null; // no digits before the bracket — not a node
    if (k == 0 or line[k - 1] != 'r') return null;
    const start = k - 1;

    // invariant: the span is a well-ordered, in-bounds half-open run.
    assert(start < close + 1);
    assert(close + 1 <= n);
    return .{ .start = start, .end = close + 1 };
}

/// True when a byte is an ASCII decimal digit — the revision number's alphabet.
fn is_digit(c: u8) bool {
    return c >= '0' and c <= '9';
}

/// Paint the browser's append-only graph onto a styled Skate grid, then light each
/// lane's head revision node in the sheet's head token. Each rendered line lands on
/// the next grid row dressed by `sheet` (paper/ink), exactly as rung two; where a
/// line carries a revision chain, its rightmost node is repainted in `head_slot`.
/// Returns the number of rows painted. The graph and the head both come straight
/// from `mantra_browser.render`, so the painted view and the readable text are one.
pub fn paint_heads(catalog: *const mn.BoltCatalog, grid: *skate.Grid, sheet: []const u8) !u32 {
    // invariant: the grid is at least one row tall.
    assert(grid.rows >= 1);
    // invariant: the sheet carries at least a paper token to lower from.
    assert(sheet.len > 0);

    var buf: [mb.max_render_bytes]u8 = undefined;
    const text = try mb.render(catalog, &buf);
    // invariant: the render honors its own budget.
    assert(text.len <= mb.max_render_bytes);

    var row: u32 = 0;
    var start: u32 = 0;
    var i: u32 = 0;
    while (i < text.len) : (i += 1) {
        if (text[i] != '\n') continue;
        const line = text[start..i];
        start = i + 1;
        if (line.len == 0) continue;
        if (row >= grid.rows) break; // bounded: never paint past the viewport
        if (line.len > grid.cols) return error.ViewTooNarrow;
        _ = try tokens.dress_grid(grid, row, line, sheet);
        if (head_span(line)) |span| {
            // The head — the living edge of this lane — wears the head token.
            _ = try tokens.dress_run(grid, row, span.start, span.end, sheet, head_token, head_slot);
        }
        row += 1;
    }
    // invariant: painted rows never exceed the grid's bounded height.
    assert(row <= grid.rows);
    return row;
}

/// Count pixels whose visible color exactly matches `c` (ignoring alpha) in a
/// rasterized buffer. A witness helper: it proves a specific token color reached
/// the canvas, which `lit_pixel_count` (any non-background pixel) cannot.
fn count_pixels_of_color(pixels: []const u8, stride: u32, width: u32, height: u32, c: skate.Color) u32 {
    // invariant: the stride holds a full row of ARGB8888 pixels.
    assert(stride >= width * 4);
    // invariant: a real canvas has width.
    assert(width > 0);
    // invariant: a real canvas has height.
    assert(height > 0);
    const stride_usize: usize = @intCast(stride);
    var count: u32 = 0;
    var y: u32 = 0;
    while (y < height) : (y += 1) {
        const y_usize: usize = @intCast(y);
        const rowbytes = pixels[y_usize * stride_usize ..][0 .. @as(usize, @intCast(width)) * 4];
        var x: u32 = 0;
        while (x < width) : (x += 1) {
            const px: usize = @intCast(x * 4);
            if (rowbytes[px + 0] == c.b and rowbytes[px + 1] == c.g and rowbytes[px + 2] == c.r) {
                count += 1;
            }
        }
    }
    return count;
}

fn welcome_heads_lit(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    const rows = try paint_heads(&catalog, &grid, tokens.base_sheet);
    // The demo graph is six lines: header, two bolt headers, three lanes.
    assert(rows == 6);

    // Every lane line lit exactly one head node; the title and bolt headers lit none.
    // Count grid cells wearing the head slot — one contiguous head run per lane.
    var head_cells: u32 = 0;
    var idx: u32 = 0;
    const total: u32 = grid.cols * grid.rows;
    // invariant: the fg-index buffer is exactly parallel to the cells.
    assert(grid.fg_index.len == grid.cells.len);
    while (idx < total) : (idx += 1) {
        if (grid.fg_index[idx] == head_slot) head_cells += 1;
    }
    // Three lanes each lit a head node of at least `r1[........]` = 11 cells.
    assert(head_cells >= 3 * 11);

    // The graph header row (row 0) carries no node, so it wears no head cell.
    var row0_head: u32 = 0;
    var c: u32 = 0;
    while (c < grid.cols) : (c += 1) {
        if (grid.fg_index[c] == head_slot) row0_head += 1;
    }
    assert(row0_head == 0);
    print("mantra_browser_heads: {d} head cells lit across the lanes, header row clean\n", .{head_cells});
}

fn welcome_head_span_reads_true() !void {
    // The a.txt lane chains two revisions; its head is the rightmost node, r2.
    const line = "  a.txt: r1[alpha123] -> r2[beta4567]";
    const span = head_span(line).?;
    // The head span opens at the last 'r' and closes past the last ']'.
    assert(line[span.start] == 'r');
    assert(line[span.start + 1] == '2');
    assert(line[span.end - 1] == ']');
    // A single-node lane lights its only node — that node is also its head.
    const solo = "  b.txt: r1[beta1234]";
    const solo_span = head_span(solo).?;
    assert(solo[solo_span.start] == 'r');
    assert(solo[solo_span.start + 1] == '1');
    // A bolt header and the title carry no node — nothing to light.
    assert(head_span("local/notes") == null);
    assert(head_span("mantra log — append-only graph") == null);
    print("mantra_browser_heads: head_span finds the rightmost node, refuses non-lanes\n", .{});
}

fn welcome_head_distinct_from_ink() !void {
    // The head token (edge) resolves to a color genuinely apart from the ink,
    // so the living edge reads as a different mark, not a decorative repaint.
    const head = try tokens.token_color(tokens.base_sheet, head_token);
    const paint = try tokens.dress(tokens.base_sheet);
    assert(head.r != paint.ink.r or head.g != paint.ink.g or head.b != paint.ink.b);
    print("mantra_browser_heads: head color stands apart from the reading ink\n", .{});
}

fn welcome_shared_graph(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    _ = try paint_heads(&catalog, &grid, tokens.base_sheet);

    // Coloring the head is additive over the glyphs: the painted row still carries
    // the very bytes rung one renders. Editor (render) and view (grid) are one graph.
    var buf: [mb.max_render_bytes]u8 = undefined;
    const text = try mb.render(&catalog, &buf);
    const first_nl = std.mem.indexOfScalar(u8, text, '\n').?;
    const first_line = text[0..first_nl];
    const painted = grid.row_cells(0);
    // invariant: the grid row holds at least the rendered line's bytes.
    assert(painted.len >= first_line.len);
    assert(std.mem.startsWith(u8, painted, first_line));
    print("mantra_browser_heads: editor and view share one graph — text unchanged by the paint\n", .{});
}

fn welcome_both_colors_reach_canvas(allocator: std.mem.Allocator) !void {
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, view_rows);
    _ = try paint_heads(&catalog, &grid, tokens.base_sheet);

    const paint = try tokens.dress(tokens.base_sheet);
    const head = try tokens.token_color(tokens.base_sheet, head_token);
    const width: i32 = @intCast(view_cols * skate.cell_w);
    const height: i32 = @intCast(view_rows * skate.cell_h);
    const stride: u32 = view_cols * skate.cell_w * 4;
    const pixel_count: usize = @intCast(stride * @as(u32, @intCast(height)));
    const pixels = try allocator.alloc(u8, pixel_count);
    grid.rasterize(pixels, stride, width, height, paint.paper, paint.ink, 1);

    // The crux, proven on metal: two token colors reached the canvas at once — the
    // reading ink for the body, the head color for each lane's living edge.
    const w_u: u32 = @intCast(width);
    const h_u: u32 = @intCast(height);
    const ink_pixels = count_pixels_of_color(pixels, stride, w_u, h_u, paint.ink);
    const head_pixels = count_pixels_of_color(pixels, stride, w_u, h_u, head);
    assert(ink_pixels > 0);
    assert(head_pixels > 0);
    print("mantra_browser_heads: {d} ink pixels and {d} head pixels share the canvas\n", .{ ink_pixels, head_pixels });
}

fn welcome_bounded_viewport(allocator: std.mem.Allocator) !void {
    // A grid shorter than the graph paints only what fits — bounded, never an
    // overflow, and the head paint respects the same viewport bound.
    var catalog = try mb.demo_catalog();
    var grid = try skate.Grid.init(allocator, view_cols, 3);
    const rows = try paint_heads(&catalog, &grid, tokens.base_sheet);
    assert(rows == 3);
    print("mantra_browser_heads: short viewport bounded to {d} rows (no overflow)\n", .{rows});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_heads_lit(garden);
        try welcome_head_span_reads_true();
        try welcome_head_distinct_from_ink();
        try welcome_shared_graph(garden);
        try welcome_both_colors_reach_canvas(garden);
        try welcome_bounded_viewport(garden);
        print("mantra_browser_heads {s} — GREEN\n", .{mantra_browser_heads_version});
        return 0;
    }
    print("usage: mantra-browser-heads selftest\n", .{});
    return 1;
}
