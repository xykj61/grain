//! pond/apps/fairtrade_cert.rye -- AYRE Journey 7 (Fair-trade), Rung 1: a certificate a record satisfies.
//!
//! Season 2, Yield -- the harvest's second promise beyond *stands on real data*: trades
//! fairly. A fair-trade certificate should mean exactly one honest thing -- a set of
//! criteria a cooperative record either satisfies in full or fails by name -- never a badge
//! a seller prints. This rung fixes that meaning as the join it is: a declaration of what
//! fair trade requires, evaluated against a record of what a cooperative actually holds, so
//! certification can never claim a criterion the record does not meet.
//!
//! It is BUHR-J7r3's Brix-declaration pattern carried from artifacts to fair-trade
//! criteria. Where `tablecloth_brix.evaluate` reads a `format tablecloth-decl-v1` descriptor
//! and refuses the whole evaluation when the store cannot serve a required artifact, this
//! reads a `format fairtrade-cert-v1` certificate (one `require <criterion>` line per
//! requirement) and refuses the whole certification (`Unsatisfied`) on the first criterion
//! the cooperative record lacks -- never certifying a gap. A malformed or empty certificate
//! refuses (`BadCertificate`).
//!
//! This rung is pure declaration-satisfaction: no signing, no books yet -- the spine the
//! later rungs wire real identity (r2, mirroring commerce_trade_signed) and a fair-value
//! trade (r4, mirroring commerce_trade) into, known correct first. Facts only; no funds
//! move, no key is held (custody gate %3 untouched). Demo attestations only.
//!
//!   rye build pond/apps/fairtrade_cert.rye -femit-bin=pond/bin/fairtrade-cert
//!   pond/bin/fairtrade-cert selftest
//!
//! Scope: active-designing/date/20260812/20260812-193727_ayre-journey7-fair-trade-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const fairtrade_cert_version = "20260812.193727";

/// A cooperative record holds at most this many named attestations -- the criteria it can
/// honestly claim. Bounded small: a record is a short roster of met criteria, not a corpus.
pub const max_attestations: u32 = 16;

/// A certificate declares at most this many required criteria -- likewise a short roster.
pub const max_criteria: u32 = 16;

/// A criterion or attestation name honors this width -- a short kebab token (`price-floor`,
/// `cooperative-member`), never a paragraph.
pub const max_criterion_len: u32 = 48;

pub const CertError = error{
    BadCertificate, // the header is wrong, a line is malformed, or no criterion is declared
    Unsatisfied, // a required criterion the record does not hold — the whole certification refuses
    TooManyCriteria, // the certificate declares past max_criteria
    NameTooLong, // a criterion name exceeds max_criterion_len
};

/// A cooperative record -- the bounded set of criteria the cooperative honestly holds. It is
/// the store side of the join, exactly as tablecloth_brix evaluates against a live catalog.
// Invariant: count <= max_attestations; every held name honors max_criterion_len.
pub const Record = struct {
    names: [max_attestations][max_criterion_len]u8,
    lens: [max_attestations]u32,
    count: u32,

    pub fn empty() Record {
        return .{ .names = undefined, .lens = undefined, .count = 0 };
    }

    /// Attest that the cooperative holds a named criterion. Refuses an overlong name rather
    /// than truncate a fact, and a full record rather than drop one silently.
    pub fn attest(self: *Record, name: []const u8) CertError!void {
        if (name.len > max_criterion_len) return error.NameTooLong;
        if (self.count >= max_attestations) return error.TooManyCriteria;
        const i = self.count;
        var k: u32 = 0;
        while (k < name.len) : (k += 1) self.names[i][k] = name[k];
        self.lens[i] = @intCast(name.len);
        self.count += 1;
        // invariant: attesting grew the record by exactly one held criterion
        assert(self.count == i + 1);
        // invariant: the record never holds past its bound
        assert(self.count <= max_attestations);
    }

    /// Whether the record holds a criterion of exactly this name.
    pub fn holds(self: *const Record, name: []const u8) bool {
        var i: u32 = 0;
        // invariant: the scan stays within the live record
        assert(self.count <= max_attestations);
        while (i < self.count) : (i += 1) {
            if (std.mem.eql(u8, self.names[i][0..self.lens[i]], name)) return true;
        }
        return false;
    }
};

/// A satisfied certificate -- the criteria a record met, in the order the certificate declared
/// them. It exists only when every required criterion was held, so its very existence is the
/// proof; it never names a criterion the record lacked.
// Invariant: count <= max_criteria; every named criterion honors max_criterion_len.
pub const Certified = struct {
    names: [max_criteria][max_criterion_len]u8,
    lens: [max_criteria]u32,
    count: u32,

    pub fn criterion(self: *const Certified, i: u32) []const u8 {
        // invariant: the index names a criterion inside the satisfied set
        assert(i < self.count);
        assert(self.count <= max_criteria);
        return self.names[i][0..self.lens[i]];
    }
};

/// Evaluate a `format fairtrade-cert-v1` certificate against a cooperative record. A record
/// holding every required criterion yields a Certified naming exactly those criteria in
/// declared order; a record missing any required criterion refuses the whole certification
/// (Unsatisfied) rather than certify a gap. A malformed or empty certificate refuses
/// (BadCertificate); a certificate declaring past the bound refuses (TooManyCriteria).
pub fn evaluate(cert_text: []const u8, record: *const Record) CertError!Certified {
    var lines = std.mem.splitScalar(u8, cert_text, '\n');
    const header = lines.next() orelse return error.BadCertificate;
    if (!std.mem.eql(u8, header, "format fairtrade-cert-v1")) return error.BadCertificate;

    var out = Certified{ .names = undefined, .lens = undefined, .count = 0 };
    while (lines.next()) |line| {
        if (line.len == 0) continue; // a trailing newline yields an empty final piece
        if (out.count >= max_criteria) return error.TooManyCriteria;

        var parts = std.mem.tokenizeScalar(u8, line, ' ');
        const tag = parts.next() orelse return error.BadCertificate;
        if (!std.mem.eql(u8, tag, "require")) return error.BadCertificate;
        const name = parts.next() orelse return error.BadCertificate;
        if (parts.next() != null) return error.BadCertificate; // one criterion per require line
        if (name.len == 0) return error.BadCertificate;
        if (name.len > max_criterion_len) return error.NameTooLong;

        // The join: a declared criterion the record does not hold refuses the whole
        // certification -- never a certificate naming a criterion the cooperative lacks.
        if (!record.holds(name)) return error.Unsatisfied;

        const i = out.count;
        var k: u32 = 0;
        while (k < name.len) : (k += 1) out.names[i][k] = name[k];
        out.lens[i] = @intCast(name.len);
        out.count += 1;
    }

    if (out.count == 0) return error.BadCertificate; // a certificate declares at least one criterion
    // invariant: a satisfied certificate names no more criteria than the bound
    assert(out.count <= max_criteria);
    return out;
}

// --- selftest -----------------------------------------------------------

fn seat_record() !Record {
    var r = Record.empty();
    // A demo cooperative's honestly-held criteria -- plainly demo tokens, no real cooperative.
    try r.attest("price-floor");
    try r.attest("cooperative-member");
    try r.attest("producer-signed");
    try r.attest("no-forced-labor");
    return r;
}

fn run_fairtrade_cert_selftest() !u8 {
    const record = try seat_record();

    // Welcome: a certificate whose every criterion the record holds is satisfied, and names
    // exactly those criteria in the order the certificate declared them.
    const cert = "format fairtrade-cert-v1\nrequire cooperative-member\nrequire price-floor\nrequire producer-signed\n";
    const certified = try evaluate(cert, &record);
    assert(certified.count == 3);
    assert(std.mem.eql(u8, certified.criterion(0), "cooperative-member"));
    assert(std.mem.eql(u8, certified.criterion(1), "price-floor"));
    assert(std.mem.eql(u8, certified.criterion(2), "producer-signed"));

    // Unwelcome: a certificate requiring a criterion the record does not hold refuses the
    // whole certification -- it never certifies a gap.
    {
        const cert_gap = "format fairtrade-cert-v1\nrequire price-floor\nrequire living-wage\n";
        if (evaluate(cert_gap, &record)) |_| {
            return error.CertifiedAGap;
        } else |err| {
            assert(err == error.Unsatisfied);
        }
    }

    // Unwelcome: a wrong header, a malformed line, and an empty certificate each refuse.
    {
        if (evaluate("format not-a-cert\nrequire price-floor\n", &record)) |_| {
            return error.BadHeaderPassed;
        } else |err| {
            assert(err == error.BadCertificate);
        }
        if (evaluate("format fairtrade-cert-v1\nallow price-floor\n", &record)) |_| {
            return error.BadTagPassed;
        } else |err| {
            assert(err == error.BadCertificate);
        }
        if (evaluate("format fairtrade-cert-v1\n", &record)) |_| {
            return error.EmptyPassed;
        } else |err| {
            assert(err == error.BadCertificate);
        }
    }

    // Unwelcome: a certificate declaring two names on one require line refuses -- one
    // criterion per line, so no line certifies more than it says.
    {
        if (evaluate("format fairtrade-cert-v1\nrequire price-floor cooperative-member\n", &record)) |_| {
            return error.TwoNamesPassed;
        } else |err| {
            assert(err == error.BadCertificate);
        }
    }

    print("fairtrade_cert: a certificate of 3 criteria the record holds is satisfied, naming exactly those criteria in declared order.\n", .{});
    print("fairtrade_cert: a required criterion the cooperative does not hold refuses the whole certification (Unsatisfied) — never a certified gap.\n", .{});
    print("fairtrade_cert: a wrong header, a bad tag, an empty certificate, and two names on one line each refuse (BadCertificate).\n", .{});
    print("fairtrade_cert: version {s}\n", .{fairtrade_cert_version});
    print("GREEN: AYRE-J7r1 fairtrade_cert; a fair-trade certificate means only what a cooperative record can honestly bear.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2) {
        if (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "fairtrade-cert")) {
            return run_fairtrade_cert_selftest();
        }
    }
    return run_fairtrade_cert_selftest();
}
