//! pond/apps/realidream_fuse.rye -- BUHR Journey 5, Rung 4: two read sources feed one
//! program node -- the fusion whole.
//!
//! Rung 3 drew the fused edge with a single upstream: one read node feeding one derived
//! program node. The Realidream foundation names the motion in the plural -- *two sources
//! can feed one node* (foundations/20260728-220203_realidream.md) -- and this rung draws
//! it whole. A program node is derived from *two* `read/` lanes at once, its content a
//! pure function of both current heads, so the node truly fuses two independent inputs
//! into one view.
//!
//! Because the fused node is a pure function of both reads it consumed, refreshing
//! *either* source flows downstream on the next derive, independently: re-read the first
//! and the fused node's first component moves; re-read the second and its second component
//! moves; each earlier fused node still recalls the pair it derived from. Two sources,
//! one node, every value an append the reader can trace to the exact upstream heads it
//! read -- referential transparency across a two-input edge.
//!
//! `derive_from_two_reads` reads the head content of two distinct `read/` lanes and
//! appends a fused summary (`a=<la> b=<lb>` -- the two read lengths, a small pure function
//! of both, standing in for any real two-input consumer) to a program lane, opening the
//! program lane on the first derive and continuing it on each later one. It refuses a
//! source path that does not name itself a read (`NotAReadPath`), a destination that is
//! itself a read path (`NotAProgramPath`), the same lane named as both sources
//! (`SameSource` -- a fusion wants two inputs, not one twice), and lets the recall refuse
//! a read lane that was never pinned (`LaneUnknown`).
//!
//! This rung reads no network: both reads' content is supplied in-process, exactly as
//! rungs one through three supply theirs. A real web fetch is a genuine outward act and
//! stays a named seam behind a bounded reader -- its own later rung, surfacing for
//! Keaton's word.
//!
//! Additive by construction: it imports realidream_reader, realidream_reread,
//! mantra_editor, mantra_browser and mantra/recall_lap1, calling only their public
//! functions. No file beneath it changes; rungs one through three and Journey 4 stay
//! green.
//!
//!   rye build pond/apps/realidream_fuse.rye -femit-bin=pond/bin/realidream-fuse
//!   pond/bin/realidream-fuse selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const mb = @import("mantra_browser.rye");
const reader = @import("realidream_reader.rye");
const reread = @import("realidream_reread.rye");
const editor = @import("mantra_editor.rye");
const mn = @import("mantra/recall_lap1.rye");

const realidream_fuse_version = "20260812.132000";

const read_prefix = "read/";

// The fused summary "a=<la> b=<lb>" is at most this many bytes: two labels, two u32
// widest decimals (ten digits each), and a separating space -- bounded, so the fuse
// never allocates or overruns.
const max_summary_bytes: u32 = 32;

pub const FuseError = error{
    NotAProgramPath,
    SameSource,
};

/// Read the head content length of a `read/` lane -- a small helper the fuse leans on
/// twice, once per source. Returns the head revision's byte length; refuses a lane that
/// was never pinned (`LaneUnknown`).
fn read_head_len(
    catalog: *mn.BoltCatalog,
    peer: []const u8,
    bolt: []const u8,
    read_path: []const u8,
) !u32 {
    // invariant: the source is a read lane -- the edge runs read -> program.
    if (!std.mem.startsWith(u8, read_path, read_prefix)) return error.NotAReadPath;
    const head = mb.head_revision(catalog, peer, bolt, read_path) orelse return error.LaneUnknown;
    // invariant: a pinned read lane has a real head counting from one.
    assert(head >= 1);

    var buf: [mn.max_resin_bytes]u8 = undefined;
    const res = try catalog.recall(.{ .peer = peer, .bolt = bolt, .revision = head, .path = read_path }, &buf);
    // invariant: the head of a real read lane resolves to real content.
    assert(res.outcome == .here);
    return res.len;
}

/// Derive a program node from two read nodes: read the head content of both `read/` lanes
/// and append a fused summary (`a=<la> b=<lb>`) as the program lane at `prog_path`. The
/// summary is a pure function of both current heads, so the node fuses two independent
/// inputs into one view. The first derive opens the program lane; each later derive
/// continues it, so re-deriving after a re-read of *either* source flows that source
/// downstream. Refuses a non-read source (`NotAReadPath`), a read destination
/// (`NotAProgramPath`), and the same lane named twice (`SameSource`); lets `recall`
/// refuse a read lane never pinned (`LaneUnknown`). Returns the program lane's new
/// revision number.
pub fn derive_from_two_reads(
    catalog: *mn.BoltCatalog,
    peer: []const u8,
    bolt: []const u8,
    read_path_a: []const u8,
    read_path_b: []const u8,
    prog_path: []const u8,
    tilak: []const u8,
) !u32 {
    // invariant: a real fuse names all five of its coordinates.
    assert(peer.len > 0);
    assert(bolt.len > 0);
    assert(read_path_a.len > 0);
    assert(read_path_b.len > 0);
    assert(prog_path.len > 0);
    // invariant: two sources means two distinct lanes, not one named twice.
    if (std.mem.eql(u8, read_path_a, read_path_b)) return error.SameSource;
    // invariant: the downstream is a program lane, never a read.
    if (std.mem.startsWith(u8, prog_path, read_prefix)) return error.NotAProgramPath;

    const len_a = try read_head_len(catalog, peer, bolt, read_path_a);
    const len_b = try read_head_len(catalog, peer, bolt, read_path_b);

    // Fuse both read lengths into one node's content -- a pure function of both heads.
    var summary_buf: [max_summary_bytes]u8 = undefined;
    const summary = try std.fmt.bufPrint(&summary_buf, "a={d} b={d}", .{ len_a, len_b });
    // invariant: the fused summary fits its named bound.
    assert(summary.len <= max_summary_bytes);

    // Append the fused node: open the program lane on the first derive, continue it on
    // every later one -- so re-deriving after a re-read appends the fresher fused node.
    if (mb.head_revision(catalog, peer, bolt, prog_path)) |_| {
        const rev = try editor.commit(catalog, peer, bolt, prog_path, summary, tilak);
        // invariant: a continued fuse advances the program lane by one revision.
        assert(rev >= 2);
        return rev;
    }
    const rev = try editor.open_lane(catalog, peer, bolt, prog_path, summary, tilak);
    // invariant: the first fuse opens the program lane at revision one.
    assert(rev == 1);
    return rev;
}

fn welcome_two_reads_feed_one() !void {
    // Two independent read lanes feed one program node -- its content a pure function of
    // both current heads.
    var catalog = try mb.demo_catalog();
    _ = try reader.pin_read(&catalog, "local", "web", "read/left", "abcd", "leaf");
    _ = try reader.pin_read(&catalog, "local", "web", "read/right", "xy", "leaf");

    const rev = try derive_from_two_reads(&catalog, "local", "web", "read/left", "read/right", "fused", "leaf");
    assert(rev == 1);

    var buf: [mn.max_resin_bytes]u8 = undefined;
    const got = try catalog.recall(.{ .peer = "local", .bolt = "web", .revision = 1, .path = "fused" }, &buf);
    assert(got.outcome == .here);
    // left is four bytes, right is two -- the fused node reflects both at once.
    assert(std.mem.eql(u8, buf[0..got.len], "a=4 b=2"));
    print("realidream_fuse: two read lanes fed one program node — a=4 b=2, both sources at once\n", .{});
}

fn welcome_either_reread_flows() !void {
    // Refreshing either source flows downstream independently on the next derive, while
    // every earlier fused node still recalls the pair it derived from.
    var catalog = try mb.demo_catalog();
    _ = try reader.pin_read(&catalog, "local", "web", "read/left", "abcd", "leaf");
    _ = try reader.pin_read(&catalog, "local", "web", "read/right", "xy", "leaf");
    _ = try derive_from_two_reads(&catalog, "local", "web", "read/left", "read/right", "fused", "leaf");

    // Re-read the first source (now eight bytes), fuse again -- only the first moves.
    _ = try reread.refresh_read(&catalog, "local", "web", "read/left", "abcdefgh", "leaf");
    const rev2 = try derive_from_two_reads(&catalog, "local", "web", "read/left", "read/right", "fused", "leaf");
    assert(rev2 == 2);
    var buf: [mn.max_resin_bytes]u8 = undefined;
    const p2 = try catalog.recall(.{ .peer = "local", .bolt = "web", .revision = 2, .path = "fused" }, &buf);
    assert(p2.outcome == .here);
    assert(std.mem.eql(u8, buf[0..p2.len], "a=8 b=2"));

    // Re-read the second source (now three bytes), fuse again -- only the second moves.
    _ = try reread.refresh_read(&catalog, "local", "web", "read/right", "xyz", "leaf");
    const rev3 = try derive_from_two_reads(&catalog, "local", "web", "read/left", "read/right", "fused", "leaf");
    assert(rev3 == 3);
    var buf3: [mn.max_resin_bytes]u8 = undefined;
    const p3 = try catalog.recall(.{ .peer = "local", .bolt = "web", .revision = 3, .path = "fused" }, &buf3);
    assert(p3.outcome == .here);
    assert(std.mem.eql(u8, buf3[0..p3.len], "a=8 b=3"));

    // The first fused node still recalls the original pair -- nothing mutated downstream.
    var buf1: [mn.max_resin_bytes]u8 = undefined;
    const p1 = try catalog.recall(.{ .peer = "local", .bolt = "web", .revision = 1, .path = "fused" }, &buf1);
    assert(p1.outcome == .here);
    assert(std.mem.eql(u8, buf1[0..p1.len], "a=4 b=2"));
    print("realidream_fuse: each re-read flowed independently — a=8 b=2 then a=8 b=3; the first fused node still reads a=4 b=2\n", .{});
}

fn welcome_refuses_wrong_edges() !void {
    // The two-input edge runs read + read -> program. A non-read source, a read
    // destination, the same lane twice, and an unpinned read all refuse by name.
    var catalog = try mb.demo_catalog();
    _ = try reader.pin_read(&catalog, "local", "web", "read/left", "abcd", "leaf");
    _ = try reader.pin_read(&catalog, "local", "web", "read/right", "xy", "leaf");

    // A source that does not name itself a read cannot be an upstream.
    if (derive_from_two_reads(&catalog, "local", "notes", "b.txt", "read/right", "fused", "leaf")) |_| {
        unreachable;
    } else |err| {
        // invariant: a non-read source refuses by the named error.
        assert(err == error.NotAReadPath);
    }
    // A destination that is itself a read path cannot be the downstream.
    if (derive_from_two_reads(&catalog, "local", "web", "read/left", "read/right", "read/mirror", "leaf")) |_| {
        unreachable;
    } else |err| {
        // invariant: a read destination refuses by the named error.
        assert(err == error.NotAProgramPath);
    }
    // The same lane named as both sources is one input, not two.
    if (derive_from_two_reads(&catalog, "local", "web", "read/left", "read/left", "fused", "leaf")) |_| {
        unreachable;
    } else |err| {
        // invariant: one lane named twice refuses by the named error.
        assert(err == error.SameSource);
    }
    // A read lane never pinned has no head to consume.
    if (derive_from_two_reads(&catalog, "local", "web", "read/left", "read/never", "fused", "leaf")) |_| {
        unreachable;
    } else |err| {
        // invariant: an unpinned read source refuses by the recall's named error.
        assert(err == error.LaneUnknown);
    }
    print("realidream_fuse: refuses NotAReadPath, NotAProgramPath, SameSource, and LaneUnknown — the two-input edge holds\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_two_reads_feed_one();
        try welcome_either_reread_flows();
        try welcome_refuses_wrong_edges();
        print("realidream_fuse {s} — GREEN\n", .{realidream_fuse_version});
        return 0;
    }
    print("usage: realidream-fuse selftest\n", .{});
    return 1;
}
