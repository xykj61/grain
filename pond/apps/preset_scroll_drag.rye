//! pond/apps/preset_scroll_drag.rye — HUNK44: the drag seam — a touch drag in pixels becomes line deltas.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · marketplace / Photos-app surface · rung HUNK44.
//! Design read: active-designing/date/20260813/20260813-195829_hunk-scroll-drag-exploration.md
//! Teacher, thanked clean-room: the pixel-quantizing layer of any touch scroll surface — a finger drag in pixels
//! becomes whole line moves over a row's pixel height, the sub-cell remainder carried between events (concept only,
//! siloed).
//!
//! HUNK43 turns a raw event into one cursor move, yet it assumes the delta already arrives counted in lines. A real
//! touch surface reports a drag in pixels, and a row of the library is some number of pixels tall. This rung is the
//! seam directly above HUNK43: `feed(pixels)` quantizes a pixel drag into a whole-line delta over the cell height,
//! carrying the sub-cell remainder so a slow drag accumulates instead of flooring to nothing every event; `drag`
//! composes that delta with HUNK43's `apply`, so a pixel drag drives the HUNK40 cursor with every clamp inherited. A
//! pure quantizer over a bounded carry — no storage, no render, and the one new refusal only `BadCellHeight`. No
//! network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run pond/apps/preset_scroll_drag.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const preset_scroll = @import("preset_scroll.rye");
const preset_scroll_input = @import("preset_scroll_input.rye");

pub const preset_scroll_drag_version = "20260813.195829";

pub const DragError = error{
    BadCellHeight,
};

/// A cell taller than any real display row is absurd — a row's pixel height is bounded so a divisor is always sane.
pub const max_cell_px: u32 = 4096;

/// The pixel-to-line quantizer for a touch drag. `cell_px` is the pixel height of one library row; `residual` is the
/// signed sub-cell carry — the pixels a drag has moved that do not yet make a whole line. The governing invariant,
/// preserved by every feed: `|residual| < cell_px`, so the carry is bounded and never grows. No cursor and no library
/// live here — a quantizer is two numbers: a row height and a leftover.
pub const DragScroll = struct {
    residual: i32 = 0,
    cell_px: u32 = 1,

    /// Open a quantizer over a row of `cell_px` pixels. A zero or over-ceiling height is not a real row.
    pub fn open(cell_px: u32) DragError!DragScroll {
        // invariant: a library row has a real, sane pixel height.
        if (cell_px == 0 or cell_px > max_cell_px) return error.BadCellHeight;
        return DragScroll{ .residual = 0, .cell_px = cell_px };
    }

    /// Add `pixels` of drag to the carry and return the whole-line delta it crosses (positive scrolls the content
    /// down, matching HUNK43's own sign). The running total is taken in `i64` so an `i32`-min delta added to a negative
    /// residual never wraps before the divide; the quotient (`@divTrunc`, toward zero) is the emitted line count and
    /// the remainder (`@rem`, magnitude strictly below `cell_px`) stays as the new carry — so a slow drag of sub-cell
    /// deltas accumulates instead of flooring to zero every event.
    pub fn feed(self: *DragScroll, pixels: i32) i32 {
        // invariant: the carry stands within one cell before the drag (a bounded, never-growing remainder).
        assert(self.cell_px >= 1);
        assert(self.cell_px <= max_cell_px);
        assert(carry_within(self.residual, self.cell_px));
        const cell: i64 = @as(i64, self.cell_px);
        const total: i64 = @as(i64, self.residual) + @as(i64, pixels);
        const lines: i64 = @divTrunc(total, cell);
        const rem: i64 = @rem(total, cell);
        // invariant: the division identity holds exactly — no pixel is lost or invented.
        assert(lines * cell + rem == total);
        // invariant: the new carry is strictly within one cell (the remainder of a divide by cell_px).
        assert(rem > -cell);
        assert(rem < cell);
        self.residual = @intCast(rem);
        // invariant: the emitted line delta fits an i32 (|total| < 2^31 + cell_px, divided by cell_px >= 1).
        assert(lines >= std.math.minInt(i32));
        assert(lines <= std.math.maxInt(i32));
        return @intCast(lines);
    }
};

/// True when a carry sits strictly within one cell — the bound every `feed` preserves. Taken in `i64` so an extreme
/// residual (never actually reached) could not wrap the check.
fn carry_within(residual: i32, cell_px: u32) bool {
    // invariant: the cell height is a real divisor.
    assert(cell_px >= 1);
    const cell: i64 = @as(i64, cell_px);
    return @as(i64, residual) > -cell and @as(i64, residual) < cell;
}

/// Drive a cursor by a touch drag of `pixels`: quantize the drag to a whole-line delta over the cell height (carrying
/// the remainder), then route that delta through HUNK43's `apply`, so the drag moves the HUNK40 cursor with every
/// clamp inherited. Returns the line delta it applied — zero when the drag has not yet crossed a whole cell. Pure over
/// the cursor beyond the offset move HUNK43 performs.
pub fn drag(cursor: *preset_scroll.ScrollCursor, quant: *DragScroll, pixels: i32) i32 {
    // invariant: the cursor stands on a real viewport before the drag.
    assert(cursor.offset <= cursor.max_offset());
    const lines = quant.feed(pixels);
    preset_scroll_input.apply(cursor, preset_scroll_input.Input.scroll_by(lines));
    // invariant: after the drag the cursor still stands on a real, bottom-pinned viewport (HUNK43's clamp inherited).
    assert(cursor.offset <= cursor.max_offset());
    return lines;
}

// --- selftest: build the same real five-book library, quantize touch drags over a ten-pixel cell, and prove a
//     full-cell drag scrolls a whole line reversibly, sub-cell drags accumulate their carry until one line crosses,
//     the carry stays bounded, an i32-min delta quantizes without wrap, and the composed drag inherits HUNK43's
//     clamps and the fitting-library no-op --------------------------------------------------------------------------

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const beading = @import("mantra/beading.rye");
    const tablecloth = @import("tablecloth.rye");
    const filter_preset = @import("filter_preset.rye");
    const preset_store = @import("preset_store.rye");
    const photo_edits = @import("photo_edits.rye");
    const preset_detail = @import("preset_detail.rye");

    // The same real five-book library the HUNK40/43 selftests build.
    var store: beading.BeadStore = .empty();
    var cat: tablecloth.Catalog = .empty();
    const stock = try filter_preset.stock_book();
    _ = try preset_store.store_book(&cat, &store, "stock.presets", &stock);
    var small = filter_preset.PresetBook.init();
    var flip = photo_edits.EditList.init();
    try flip.push(.flip_h);
    try small.define("mirror", &flip);
    _ = try preset_store.store_book(&cat, &store, "custom.presets", &small);
    {
        var one = photo_edits.EditList.init();
        try one.push(.flip_h);
        const names = [_][]const u8{ "a.presets", "b.presets", "c.presets" };
        var k: u32 = 0;
        while (k < names.len) : (k += 1) {
            var b = filter_preset.PresetBook.init();
            try b.define("edit", &one);
            _ = try preset_store.store_book(&cat, &store, names[k], &b);
        }
    }
    var lib: preset_detail.DetailListing = undefined;
    try preset_detail.detail_books(&cat, &store, &lib);
    assert(lib.len() == 5);

    const cell: u32 = 10; // a library row ten pixels tall
    const rows: u32 = 2; // a two-row viewport over five books; max_offset 3
    var cur = try preset_scroll.ScrollCursor.open(lib.count, rows);
    assert(cur.max_offset() == 3);

    // A full-cell drag scrolls exactly one line; two cells, two lines — the divide is exact when the drag is a whole
    // multiple of the cell height. Reversible: an upward drag of the same pixels walks straight back.
    {
        var q = try DragScroll.open(cell);
        assert(drag(&cur, &q, 20) == 2); // 20px over a 10px cell → two lines down
        assert(cur.offset == 2);
        assert(q.residual == 0); // an exact multiple leaves no carry
        assert(drag(&cur, &q, -20) == -2); // straight back up
        assert(cur.offset == 0);
        assert(q.residual == 0);
    }

    // The carry accumulates: four sub-cell drags of three pixels over a ten-pixel cell emit 0, 0, 0, then 1 — the
    // remainder was never floored away, and after the whole line crosses two pixels wait for the next drag.
    {
        var q = try DragScroll.open(cell);
        assert(q.feed(3) == 0);
        assert(q.residual == 3);
        assert(q.feed(3) == 0);
        assert(q.residual == 6);
        assert(q.feed(3) == 0);
        assert(q.residual == 9);
        assert(q.feed(3) == 1); // 12 total crosses one cell
        assert(q.residual == 2); // the leftover carries on
    }

    // The carry is symmetric downward: from a positive residual, small negative drags subtract and can cross a cell
    // boundary the other way, never underflowing.
    {
        var q = try DragScroll.open(cell);
        assert(q.feed(7) == 0);
        assert(q.residual == 7);
        assert(q.feed(-9) == 0); // total -2, no whole cell
        assert(q.residual == -2);
        assert(q.feed(-9) == -1); // total -11 crosses one cell down-to-up
        assert(q.residual == -1);
    }

    // The residual stays strictly within one cell after every feed in a long mixed stream — a bounded, never-growing
    // carry, whatever the drags arrive.
    {
        var q = try DragScroll.open(cell);
        const stream = [_]i32{ 3, -7, 25, 4, -30, 1, 100, -6, 0, -99 };
        var s: u32 = 0;
        while (s < stream.len) : (s += 1) {
            _ = q.feed(stream[s]);
            assert(q.residual > -10); // |residual| < cell_px (10), always
            assert(q.residual < 10);
        }
    }

    // An i32-min pixel delta added onto a negative residual quantizes cleanly — the total is taken in i64, so the
    // divide never wraps, and the carry lands back inside one cell.
    {
        var q = try DragScroll.open(cell);
        assert(q.feed(-5) == 0);
        assert(q.residual == -5);
        const big = q.feed(std.math.minInt(i32)); // -2147483648 + (-5) in i64, divided cleanly
        assert(big < 0); // a large downward line delta
        assert(q.residual > -10); // still bounded within one cell
        assert(q.residual < 10);
    }

    // The composed drag inherits HUNK43's clamps: a huge downward fling lands on the bottom-pinned offset (never past
    // it, no wrap), a huge upward one on the top.
    {
        var q = try DragScroll.open(cell);
        cur.to_top();
        _ = drag(&cur, &q, 1000000); // a hundred thousand cells of fling
        assert(cur.offset == 3); // clamped at max_offset
        _ = drag(&cur, &q, -1000000);
        assert(cur.offset == 0); // clamped at the top
    }

    // A library that fits the screen never moves whatever the drag — max_offset 0, so the cursor stays put even as the
    // quantizer emits real line deltas.
    {
        var fit = try preset_scroll.ScrollCursor.open(lib.count, 8); // eight rows over five books
        var q = try DragScroll.open(cell);
        assert(fit.max_offset() == 0);
        const emitted = drag(&fit, &q, 50); // five cells of drag → five lines, all clamped away
        assert(emitted == 5); // the quantizer still counted the lines honestly
        assert(fit.offset == 0); // the cursor never moved
    }

    // A zero or over-ceiling cell height refuses BadCellHeight — a row must have a real pixel height to quantize over.
    if (DragScroll.open(0)) |_| return error.CellSlipped else |e| {
        if (e != error.BadCellHeight) return error.WrongCell;
    }
    if (DragScroll.open(max_cell_px + 1)) |_| return error.CellSlipped else |e| {
        if (e != error.BadCellHeight) return error.WrongCell;
    }

    _ = garden;
    print("GREEN preset-scroll-drag: a five-book library driven through a two-row viewport by touch drags over a " ++
        "ten-pixel cell — a full-cell drag scrolls exactly one line reversibly (20px down two, back up two, no " ++
        "carry left); four sub-cell drags of three pixels accumulate the carry and emit 0,0,0,1 (the remainder never " ++
        "floored away, two pixels waiting after); the carry subtracts symmetrically downward without underflow; the " ++
        "residual stays strictly within one cell after every feed in a long mixed stream; an i32-min delta onto a " ++
        "negative carry quantizes without wrap (total taken in i64); the composed drag inherits HUNK43 clamps (a " ++
        "huge fling lands bottom-pinned, never past); a fitting library counts the lines yet never moves; a zero or " ++
        "over-ceiling cell refuses BadCellHeight. HUNK43 input and HUNK40 cursor GREEN beneath\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: preset_scroll_drag selftest\n", .{});
    return 1;
}
