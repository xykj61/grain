//! pond/apps/skate_group.rye — Season 3 Journey 10 (Membership), Rung 1: admission is by quorum, never one hand.
//!
//! Season 3, Commons — a community shapes its own membership by consent. Journey 9 (Skate) drew consent
//! at its smallest size: two keepers linked only by mutual request. Journey 10 draws the next size up,
//! the load-bearing one — a **group**, the one surface `settlement/names.rye` names in its own header as
//! *the surface that genuinely needs consensus*, proven now at **more than two keepers**.
//!
//! The crux: **a candidate is seated only when a quorum of distinct members consent.** A `Group` opens
//! with a founder roster and a fixed quorum `t` (`2 <= t <= roster` — genuine consensus, more than one
//! hand, yet never full unanimity a lone hold-out could veto). A member votes for a candidate; the
//! candidate is admitted only when `t` **distinct** members have voted. The honesty is the distinctness
//! with the threshold: one keeper voting twice is counted once (`AlreadyVoted`), so a lone steward can
//! never manufacture a quorum. Admission is *derived* from the count of distinct member votes reaching
//! `t`, never written directly — exactly as Journey 9 derived a link from two opposing requests rather
//! than storing it. A seat exists only when the named number of true hands agreed.
//!
//! This is the pure rule as a bounded state machine — quorum modeled as distinct explicit votes, no
//! signing yet (r2 signs each vote with the member's settled Kumara identity, mirroring
//! `skate_circle_signed`). Facts only, custody-first: it records the facts of quorum and holds nothing,
//! opens no network, and generates no real identity (a group shared over the wire reaches the serve gate
//! — Keaton's hand). Demo keeper points only.
//!
//!   rye build pond/apps/skate_group.rye -femit-bin=pond/bin/skate-group
//!   pond/bin/skate-group selftest
//!
//! Scope: active-designing/date/20260812/20260812-204233_dahl-journey10-membership-quorum-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const skate_group_version = "20260812.204233";

/// A group seats at most this many keepers — a bounded shared surface, not a whole network.
pub const max_members: u32 = 32;

/// A group holds at most this many distinct votes — bounded so consent never grows unbounded.
pub const max_votes: u32 = 256;

/// The membership verdict for a candidate, carried from the customs/Skate trichotomy to the group border.
pub const Verdict = enum {
    refuse, // no member has voted for the candidate — the resting state; admitted by nobody's default
    hold, // some members voted, yet fewer than the quorum — a standing intention, never an admission
    place, // a quorum of distinct members voted — mutual consent at the named threshold; the candidate is seated
};

pub const GroupError = error{
    BadThreshold, // a quorum below two — a genuine consensus needs more than one hand
    TooFewFounders, // fewer founders than the quorum — a group that could never admit anyone
    DuplicateFounder, // a founder point named twice — a seat is held once
    AlreadyMember, // the candidate (or a re-added keeper) already holds a seat
    NotMember, // a non-member tried to vote — only members decide who joins
    AlreadyVoted, // this member already voted for this candidate — one member, one vote; no faking a quorum
    GroupFull, // the roster is at its bound — refuse rather than drop a keeper
    VotesFull, // the vote book is at its bound — refuse rather than drop consent
};

/// One member's vote to admit a candidate — attributed to a distinct voter, so a quorum is the count of
/// distinct such votes, never one keeper's vote counted twice.
const Vote = struct {
    voter: u32,
    candidate: u32,
};

/// A shared surface: the keepers who hold a seat, a fixed quorum threshold, and every distinct vote cast
/// to admit a candidate. Membership is stored (a seated keeper is a member); admission is *derived* — a
/// candidate is seated only when the count of distinct member votes for them reaches the quorum, so the
/// quorum law cannot be bypassed by seating a keeper directly.
// Invariant: member_count <= max_members; vote_count <= max_votes; 2 <= quorum <= member_count at open.
pub const Group = struct {
    members: [max_members]u32,
    member_count: u32,
    quorum: u32,
    votes: [max_votes]Vote,
    vote_count: u32,

    /// Open a group with its founder roster and a fixed quorum. The quorum must be at least two (genuine
    /// consensus) and no larger than the founders (else the group could never admit anyone); founders
    /// must be distinct (a seat is held once) and within the roster bound.
    pub fn open(founders: []const u32, quorum: u32) GroupError!Group {
        // invariant: a quorum is genuine consensus — more than one hand.
        if (quorum < 2) return error.BadThreshold;
        // invariant: the founder roster fits the bound.
        if (founders.len > max_members) return error.GroupFull;
        // invariant: a reachable quorum — at least as many founders as the threshold.
        if (founders.len < quorum) return error.TooFewFounders;

        var g = Group{ .members = undefined, .member_count = 0, .quorum = quorum, .votes = undefined, .vote_count = 0 };
        for (founders) |point| {
            // invariant: a founder seat is held once — no point seated twice.
            if (g.is_member(point)) return error.DuplicateFounder;
            g.members[g.member_count] = point;
            g.member_count += 1;
        }
        // invariant: the roster seated exactly the founders, the quorum sits within it, both bounded.
        assert(g.member_count == @as(u32, @intCast(founders.len)));
        assert(g.quorum >= 2);
        assert(g.quorum <= g.member_count);
        assert(g.member_count <= max_members);
        return g;
    }

    /// Does this keeper hold a seat — were they a founder or admitted by quorum?
    pub fn is_member(self: *const Group, point: u32) bool {
        // invariant: the roster never exceeds its bound.
        assert(self.member_count <= max_members);
        var i: u32 = 0;
        while (i < self.member_count) : (i += 1) {
            if (self.members[i] == point) return true;
        }
        return false;
    }

    /// Does this exact member→candidate vote already stand?
    fn has_vote(self: *const Group, voter: u32, candidate: u32) bool {
        // invariant: the vote book never exceeds its bound.
        assert(self.vote_count <= max_votes);
        var i: u32 = 0;
        while (i < self.vote_count) : (i += 1) {
            if (self.votes[i].voter == voter and self.votes[i].candidate == candidate) return true;
        }
        return false;
    }

    /// How many distinct members have voted to admit this candidate? The vote book holds each
    /// (voter, candidate) pair once (see `vote`), so this count is a count of distinct hands.
    pub fn tally(self: *const Group, candidate: u32) u32 {
        // invariant: the vote book never exceeds its bound.
        assert(self.vote_count <= max_votes);
        var count: u32 = 0;
        var i: u32 = 0;
        while (i < self.vote_count) : (i += 1) {
            if (self.votes[i].candidate == candidate) count += 1;
        }
        // invariant: a tally can never exceed the number of members who could have voted.
        assert(count <= self.member_count);
        return count;
    }

    /// The verdict for a candidate — the whole quorum rule, folded to one answer:
    ///   refuse — no member has voted
    ///   hold   — some members voted, fewer than the quorum
    ///   place  — a quorum of distinct members voted (the candidate is, or has just been, seated)
    pub fn verdict(self: *const Group, candidate: u32) Verdict {
        const t = self.tally(candidate);
        if (t == 0) return .refuse;
        if (t < self.quorum) return .hold;
        return .place;
    }

    /// A member votes to admit a candidate. Only a member decides (`NotMember`); a candidate already
    /// seated cannot be re-admitted (`AlreadyMember`); the same member votes for one candidate once, so a
    /// lone hand can never fake a quorum (`AlreadyVoted`). When this vote makes the count of distinct
    /// member votes reach the quorum, the candidate is seated in the same act — admission is derived from
    /// the tally, never written directly.
    pub fn vote(self: *Group, voter: u32, candidate: u32) GroupError!void {
        if (!self.is_member(voter)) return error.NotMember;
        if (self.is_member(candidate)) return error.AlreadyMember;
        if (self.has_vote(voter, candidate)) return error.AlreadyVoted;
        if (self.vote_count >= max_votes) return error.VotesFull;

        // Would this vote carry the candidate to quorum? If so, the seat must be available first, so a
        // full roster refuses before the vote is recorded rather than counting consent it cannot honor.
        const reaches_quorum = (self.tally(candidate) + 1 >= self.quorum);
        if (reaches_quorum and self.member_count >= max_members) return error.GroupFull;

        const i = self.vote_count;
        self.votes[i] = .{ .voter = voter, .candidate = candidate };
        self.vote_count += 1;
        // invariant: the vote book grew by exactly one, within its bound.
        assert(self.vote_count == i + 1);
        assert(self.vote_count <= max_votes);

        if (reaches_quorum) {
            self.members[self.member_count] = candidate;
            self.member_count += 1;
            // invariant: a candidate is seated only with a quorum of distinct votes behind them.
            assert(self.tally(candidate) >= self.quorum);
            assert(self.is_member(candidate));
            assert(self.member_count <= max_members);
        }
        // invariant: membership follows the quorum exactly — seated iff the verdict placed.
        assert(self.is_member(candidate) == (self.verdict(candidate) == .place));
    }
};

// --- selftest -----------------------------------------------------------

// Demo keeper points — plain identifiers for the pure rule; r2 binds each to a settled Kumara identity.
const ivy: u32 = 101;
const wren: u32 = 202;
const flax: u32 = 303;
const bram: u32 = 404;
const cate: u32 = 505;

/// A quorum of two admits: one vote holds, the second distinct vote seats the candidate; the verdict
/// tracks the tally exactly — the crux, made checkable.
fn welcome_quorum_of_two_admits() !void {
    var g = try Group.open(&.{ ivy, wren, flax }, 2);

    // Before anyone votes: refuse. The candidate is admitted by nobody's default.
    assert(g.verdict(bram) == .refuse);
    assert(!g.is_member(bram));

    // Ivy votes for Bram. One distinct vote, quorum two: it holds, Bram is not yet seated.
    try g.vote(ivy, bram);
    assert(g.verdict(bram) == .hold);
    assert(g.tally(bram) == 1);
    assert(!g.is_member(bram));

    // Wren votes for Bram. Now two distinct members have voted: the quorum is met, Bram is seated.
    try g.vote(wren, bram);
    assert(g.verdict(bram) == .place);
    assert(g.tally(bram) == 2);
    assert(g.is_member(bram));
    assert(g.member_count == 4);
    print("skate_group: one vote held; only when a quorum of two distinct members voted did the candidate take a seat.\n", .{});
}

/// A quorum of three needs three distinct hands — the honest heart of "more than two keepers." Two
/// distinct votes hold; the third admits.
fn welcome_quorum_of_three_needs_three() !void {
    var g = try Group.open(&.{ ivy, wren, flax, bram }, 3);

    try g.vote(ivy, cate);
    assert(g.verdict(cate) == .hold); // one of three
    try g.vote(wren, cate);
    assert(g.verdict(cate) == .hold); // two of three — still short
    assert(!g.is_member(cate));
    try g.vote(flax, cate);
    assert(g.verdict(cate) == .place); // three distinct members — quorum met
    assert(g.is_member(cate));
    assert(g.tally(cate) == 3);
    print("skate_group: a quorum of three admitted only when three distinct members voted — consent proven past two keepers.\n", .{});
}

/// One member voting twice can never reach a quorum of two — the crux against a lone steward faking
/// consent. The double vote refuses, and the tally stays at one.
fn unwelcome_double_vote_cannot_fake_quorum() !void {
    var g = try Group.open(&.{ ivy, wren }, 2);
    try g.vote(ivy, flax);
    const doubled = g.vote(ivy, flax);
    assert(doubled == error.AlreadyVoted);
    // The tally did not budge — one hand cannot count for two.
    assert(g.tally(flax) == 1);
    assert(g.verdict(flax) == .hold);
    assert(!g.is_member(flax));
    print("skate_group: a member voting twice refused AlreadyVoted and the tally held at one — one hand can never fake a quorum.\n", .{});
}

/// Only members decide, and a seated keeper cannot be re-admitted.
fn unwelcome_nonmember_and_remember_refuse() !void {
    var g = try Group.open(&.{ ivy, wren }, 2);

    // Flax never joined; Flax cannot vote.
    const outsider = g.vote(flax, bram);
    assert(outsider == error.NotMember);

    // Ivy is a founder; a vote to admit a seated member refuses.
    const readmit = g.vote(wren, ivy);
    assert(readmit == error.AlreadyMember);
    print("skate_group: a non-member voting refused NotMember and re-admitting a seated keeper refused AlreadyMember — only members decide, once.\n", .{});
}

/// A group opens only with an honest quorum: at least two, no larger than its founders, founders distinct.
fn unwelcome_bad_openings_refuse() !void {
    // A quorum of one is not consensus.
    const lone = Group.open(&.{ ivy, wren }, 1);
    assert(lone == error.BadThreshold);
    // A quorum larger than the founders could never be met.
    const unreachable_quorum = Group.open(&.{ ivy, wren }, 3);
    assert(unreachable_quorum == error.TooFewFounders);
    // A founder seated twice.
    const dup = Group.open(&.{ ivy, ivy, wren }, 2);
    assert(dup == error.DuplicateFounder);
    print("skate_group: a lone quorum refused BadThreshold, an unreachable quorum TooFewFounders, a doubled founder DuplicateFounder — a group opens honest.\n", .{});
}

/// The group is bounded — a full roster refuses the vote that would seat one more, rather than overflow.
fn unwelcome_full_group_refuses() !void {
    // Open at the roster bound with a quorum of two.
    var founders: [max_members]u32 = undefined;
    var n: u32 = 0;
    while (n < max_members) : (n += 1) founders[n] = 1000 + n;
    var g = try Group.open(founders[0..max_members], 2);
    assert(g.member_count == max_members);

    // Two members vote to admit one more — but there is no seat; the second (quorum-reaching) vote refuses.
    try g.vote(1000, 9999);
    const seat_it = g.vote(1001, 9999);
    assert(seat_it == error.GroupFull);
    // The refusal held the roster and did not seat the candidate.
    assert(g.member_count == max_members);
    assert(!g.is_member(9999));
    print("skate_group: a full roster refused the quorum-reaching vote GroupFull rather than overflow — the bound holds before consent is counted.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_quorum_of_two_admits();
    try welcome_quorum_of_three_needs_three();
    try unwelcome_double_vote_cannot_fake_quorum();
    try unwelcome_nonmember_and_remember_refuse();
    try unwelcome_bad_openings_refuse();
    try unwelcome_full_group_refuses();
    print("skate_group: version {s}\n", .{skate_group_version});
    print("GREEN: DAHL-J10r1 skate_group; a candidate is seated only when a quorum of distinct members votes — one hand can never fake a quorum, and consent is proven past two keepers.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "skate-group"))) {
        return run_selftest();
    }
    return run_selftest();
}
