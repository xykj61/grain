//! pond/apps/skate_group_true.rye -- Season 3 Journey 10 (Membership), Rung 4: the group reads true (Journey 10 closes).
//!
//! Rungs one through three fixed the quorum rule, signed each vote, and let a signed group travel as
//! Bron -- all over groups seated in code. This closing rung carries the reader onto a **real** Skate
//! group record a keeper can open and count, and proves the property the whole membership layer rests
//! on: what the reader *reports* about a group is true to the bytes.
//!
//! The corpus is `surf/fixtures/group.bron`, a genuine `format skate-group-v1` record with real Ed25519
//! vote signatures (three founders at quorum 2; two votes admit Bram, one one-sided vote for Cate holds),
//! `@embedFile`-bound at compile time through a symlink in `pond/apps/corpora/` -- no network, the bytes
//! read are the tree's own. Two independent readings must agree: the app parses the record through rung
//! three and reports the founder count, the vote count, and the **admitted-by-quorum count** (distinct
//! candidates whose distinct-vote tally reaches the quorum -- a candidate short of quorum holds and is not
//! counted), and the witness cross-checks that triple against `tools/fixtures/skate_group_truth.awk`'s
//! reading of the same file -- two tools, one answer. And the record is genuinely quorum-honest:
//! `still_quorum_honest` re-verifies every carried vote signature against the demo keyring, and `rebuild`
//! recovers Bram's admission and Cate's hold exactly, so the fixture is a real signed group, not a hollow
//! shape.
//!
//! Additive -- composes rungs one, two, and three over public API (all re-run GREEN). Demo keeper seeds
//! only, reads no network (a group served over the wire reaches the serve gate -- Keaton's hand).
//!
//!   rye build pond/apps/skate_group_true.rye -femit-bin=pond/bin/skate-group-true
//!   pond/bin/skate-group-true selftest
//!
//! Scope: active-designing/date/20260812/20260812-204233_dahl-journey10-membership-quorum-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const group_mod = @import("skate_group.rye");
const signed = @import("skate_group_signed.rye");
const bron = @import("skate_group_bron.rye");
const kumara = @import("kumara.rye");

pub const skate_group_true_version = "20260812.204233";

/// The real group record, bound at compile time -- the tree's own bytes, never a drifting copy.
const real_group = @embedFile("corpora/skate_group.bron");

/// The three facts a keeper can count by hand: founders, votes, and candidates admitted by quorum.
pub const Reading = struct {
    founders: u32,
    votes: u32,
    admitted: u32,
};

/// How many distinct votes name this candidate in the parsed record? The record holds each
/// (voter, candidate) pair once (rung three's reader carries rung two's dedup), so this is a count of
/// distinct hands.
fn tally_of(pg: *const bron.PortableGroup, candidate: u32) u32 {
    // invariant: the scan stays within the parsed vote book.
    assert(pg.vote_count <= bron.max_votes);
    var count: u32 = 0;
    var i: u32 = 0;
    while (i < pg.vote_count) : (i += 1) {
        if (pg.vote_candidates[i] == candidate) count += 1;
    }
    return count;
}

/// Count candidates admitted by quorum -- a distinct candidate whose tally reaches the record's quorum.
/// A candidate is counted once (at the first vote line that names them), so a candidate voted for twice
/// is not double-counted, and one short of quorum is not counted at all.
fn admitted_count(pg: *const bron.PortableGroup) u32 {
    var admitted: u32 = 0;
    var i: u32 = 0;
    while (i < pg.vote_count) : (i += 1) {
        const candidate = pg.vote_candidates[i];
        // Only tally at the first appearance of this candidate, so each is judged once.
        var first = true;
        var j: u32 = 0;
        while (j < i) : (j += 1) {
            if (pg.vote_candidates[j] == candidate) first = false;
        }
        if (first and tally_of(pg, candidate) >= pg.quorum) admitted += 1;
    }
    // invariant: no more candidates are admitted than there are votes.
    assert(admitted <= pg.vote_count);
    return admitted;
}

/// Read the real group: parse it and count the three facts. The parse refuses a malformed record by
/// rung three's own reasons; here the bytes are the tree's own, so the reading is honest by construction.
pub fn read_group(text: []const u8) bron.BronError!Reading {
    const pg = try bron.parse(text);
    return .{ .founders = pg.founder_count, .votes = pg.vote_count, .admitted = admitted_count(&pg) };
}

// --- selftest -----------------------------------------------------------

// Demo keeper seeds -- the same seeds the fixture was signed with, so the record verifies as real.
const ivy_seed: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const wren_seed: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const flax_seed: [kumara.seed_length]u8 = .{0x33} ** kumara.seed_length;

const ivy: u32 = 101;
const wren: u32 = 202;
const flax: u32 = 303;
const bram: u32 = 404;
const cate: u32 = 505;
const demo_group: u32 = 7;

fn pubkey_of(seed: *const [kumara.seed_length]u8) [signed.pubkey_len]u8 {
    return kumara.keypair_from_seed(seed).public_key.bytes;
}

fn demo_ring() error{KeyringFull}!signed.Keyring {
    var ring = signed.Keyring.open();
    try ring.enroll(ivy, pubkey_of(&ivy_seed));
    try ring.enroll(wren, pubkey_of(&wren_seed));
    try ring.enroll(flax, pubkey_of(&flax_seed));
    return ring;
}

/// The reading of the real record -- the witness cross-checks this triple against awk's reading of the
/// same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_group(real_group);
    // The fixture holds three founders, three votes, and exactly one candidate admitted by quorum (Bram).
    assert(r.founders == 3);
    assert(r.votes == 3);
    assert(r.admitted == 1);
    print("skate_group_true: truth-triple {d} {d} {d}\n", .{ r.founders, r.votes, r.admitted });
    print("skate_group_true: the reading of the real record — founders, votes, admitted — matches an independent count of the same bytes.\n", .{});
}

/// The record is genuinely quorum-honest -- every carried vote signature verifies against the demo
/// keyring, and the rebuilt group carries Bram's admission and Cate's hold exactly.
fn welcome_record_is_really_honest() !void {
    const ring = try demo_ring();
    const pg = try bron.parse(real_group);
    try pg.still_quorum_honest(&ring); // a hollow or tampered fixture would refuse here
    const group = try pg.rebuild(&ring);
    assert(group.is_member(bram)); // admitted by quorum — a real seat
    assert(group.verdict(bram) == .place);
    assert(!group.is_member(cate)); // one one-sided vote — held, never seated
    assert(group.verdict(cate) == .hold);
    print("skate_group_true: the real record re-verified every vote offline and rebuilt Bram's admission and Cate's hold exactly.\n", .{});
}

/// A tampered copy of the real bytes refuses -- the reader will not read a corrupted record as true.
fn unwelcome_tampered_record_refuses() !void {
    // Flip a byte inside the header so the record no longer names its format.
    var buf: [real_group.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_group.len) : (k += 1) buf[k] = real_group[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_group(buf[0..]);
    assert(bad == error.BadFormat);
    print("skate_group_true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_record_is_really_honest();
    try unwelcome_tampered_record_refuses();
    print("skate_group_true: version {s}\n", .{skate_group_true_version});
    print("GREEN: DAHL-J10r4 skate_group_true; the reading of a real group record is true to the bytes, and the record is genuinely quorum-honest.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<founders> <votes> <admitted>`), so the witness can compare the
/// app's reading against `skate_group_truth.awk` byte for byte -- two tools, one answer.
fn run_measure() !u8 {
    const r = try read_group(real_group);
    print("{d} {d} {d}\n", .{ r.founders, r.votes, r.admitted });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "skate-group-true"))) {
        return run_selftest();
    }
    return run_selftest();
}
