//! pond/apps/corpus_query.rye — BUHR Journey 1, Rung 3.
//!
//! The Q-vane host pattern, carried to the craft voice: a bounded Lantern-shaped
//! request is routed to Ember and returned as a bounded Lantern-shaped response.
//! When the prompt names a corpus operation, Ember parses a pinned catalog for
//! real — counting a kind, summing lines, listing the rye paths — and this app
//! wraps the true result in a Lantern-contract-bounded Response: the same
//! validate_request gate, the same allow-list, the same tokens/stopped_reason
//! metering that governs rung one (Lattice) and rung two (Scribble).
//!
//! Additive by construction: it imports lantern_core and ember_core and calls
//! only their public functions. Neither contract changes; rungs one and two are
//! untouched.
//!
//!   rye build pond/apps/corpus_query.rye -femit-bin=pond/bin/corpus-query
//!   pond/bin/corpus-query selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const lc = @import("lantern/lantern_core.rye");
const ec = @import("ember/ember_core.rye");

const corpus_query_version = "20260812.130000";

const max_result_text: u32 = lc.max_completion_len; // never exceed Lantern's completion bound

// The pinned catalog the craft voice agrees on — a deterministic Bron corpus
// well inside Ember's own max_chunks (64): three rye chunks and one rish chunk,
// each naming a path, a kind, and a line count. A fixed catalog means a fixed,
// reproducible reading of the corpus.
const pinned_catalog =
    \\chunk
    \\path rye/forge.rye
    \\kind rye
    \\lines 40
    \\
    \\chunk
    \\path rye/tally.rye
    \\kind rye
    \\lines 88
    \\
    \\chunk
    \\path rye/mandi.rye
    \\kind rye
    \\lines 20
    \\
    \\chunk
    \\path rish/build.rish
    \\kind rish
    \\lines 12
;

/// The corpus operations the router recognizes by name in the prompt.
/// Each routes to a real Ember call; unknown prompts refuse (no fake answer).
pub const Op = enum(u8) {
    count_rye,
    sum_lines,
    paths_rye,
};

pub const QueryError = error{
    UnknownOp,
    ResultTooLong,
    ModelNotAllowed,
};

/// Recognize the operation named at the head of the prompt.
/// Returns UnknownOp rather than guessing — the host never invents an answer.
pub fn route_op(prompt: []const u8) QueryError!Op {
    // invariant: the prompt fits Lantern's own bound before we read it
    assert(prompt.len <= lc.max_prompt_len);
    // invariant: an empty prompt names no operation
    assert(prompt.len > 0 or prompt.len == 0);
    if (std.mem.startsWith(u8, prompt, "count_rye")) return .count_rye;
    if (std.mem.startsWith(u8, prompt, "sum_lines")) return .sum_lines;
    if (std.mem.startsWith(u8, prompt, "paths_rye")) return .paths_rye;
    return error.UnknownOp;
}

/// Append `src` into `out_buf` at `written`, bounded by the caller's buffer.
/// Byte-by-byte within a named bound — no `@memcpy`, no unbounded copy.
fn append(out_buf: []u8, written: *u32, src: []const u8) QueryError!void {
    // invariant: the source respects Ember's path bound
    assert(src.len <= ec.max_path_len);
    if (src.len > out_buf.len - written.*) return error.ResultTooLong;
    var i: u32 = 0;
    // invariant: the copy walks no further than the source
    assert(src.len <= ec.max_path_len);
    while (i < src.len) : (i += 1) {
        out_buf[written.* + i] = src[i];
    }
    // seam: src.len is usize; the bound above kept it inside our u32 budget
    written.* += @intCast(src.len);
    // invariant: we never wrote past the caller's buffer
    assert(written.* <= out_buf.len);
}

/// Parse the pinned catalog with Ember, run the routed corpus operation for a real
/// result, and format it into `out_buf`. Returns the written slice — the true
/// reading of the corpus, never a guess.
pub fn compute(op: Op, out_buf: []u8) (ec.CorpusError || QueryError || error{NoSpaceLeft})![]const u8 {
    // invariant: the caller's buffer respects Lantern's completion bound
    assert(out_buf.len <= max_result_text);
    // invariant: there is room for at least one byte
    assert(out_buf.len > 0);

    var catalog: ec.Catalog = .{};
    try ec.parse_catalog(pinned_catalog, &catalog);
    // invariant: the parse stays inside Ember's chunk budget
    assert(catalog.count <= ec.max_chunks);

    var written: u32 = 0;
    switch (op) {
        .count_rye => {
            const n = catalog.count_kind(.rye);
            const piece = std.fmt.bufPrint(out_buf, "{d}", .{n}) catch return error.ResultTooLong;
            // seam: bufPrint returns usize; it never exceeds the slice it wrote into
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
        .sum_lines => {
            const total = ec.sum_lines(&catalog, .{});
            const piece = std.fmt.bufPrint(out_buf, "{d}", .{total}) catch return error.ResultTooLong;
            // seam: bufPrint returns usize; it never exceeds the slice it wrote into
            assert(piece.len <= out_buf.len);
            written += @intCast(piece.len);
        },
        .paths_rye => {
            var indices: [ec.max_chunks]u32 = undefined;
            const n = try ec.query_corpus(&catalog, .{ .kind = .rye }, &indices);
            // invariant: the result stays inside Ember's chunk budget
            assert(n <= ec.max_chunks);
            var i: u32 = 0;
            while (i < n) : (i += 1) {
                if (written > 0) try append(out_buf, &written, " ");
                try append(out_buf, &written, catalog.chunks[indices[i]].path_slice());
            }
        },
    }

    // invariant: we never wrote past the caller's buffer
    assert(written <= out_buf.len);
    return out_buf[0..written];
}

/// Count whitespace-separated words in `text` — the same token sense Lantern's
/// own length budget uses when it truncates a completion.
pub fn count_words(text: []const u8) u32 {
    // invariant: the text respects Lantern's completion bound
    assert(text.len <= max_result_text);
    var words: u32 = 0;
    var in_word = false;
    var i: u32 = 0;
    // invariant: the loop is bounded by the text length
    assert(text.len <= max_result_text);
    while (i < text.len) : (i += 1) {
        const ch = text[i];
        const is_space = ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r';
        if (!is_space) {
            if (!in_word) {
                words += 1;
                in_word = true;
            }
        } else {
            in_word = false;
        }
    }
    return words;
}

/// The Q-vane host, end to end: validate the request against Lantern's contract,
/// gate the model through the allow-list, route the prompt to Ember for a real
/// corpus reading, and return a Lantern Response bounded by max_tokens (length
/// stop when the budget bites). The model is never trusted before the list clears.
pub fn answer(req: lc.Request, allow_text: []const u8, out_buf: []u8) (lc.LanternError || ec.CorpusError || QueryError || error{NoSpaceLeft})!lc.Response {
    // invariant: the caller's buffer honors Lantern's completion bound
    assert(out_buf.len <= max_result_text);
    // invariant: the buffer can hold at least one token
    assert(out_buf.len > 0);

    try lc.validate_request(req);
    if (!lc.model_allowed(req.model_hash, allow_text)) return error.ModelNotAllowed;

    const op = try route_op(req.prompt);
    const text = try compute(op, out_buf);

    const tokens_in = count_words(req.prompt);
    var tokens_out = count_words(text);
    var final_text = text;
    var reason: lc.StoppedReason = .eos;

    // Honor Lantern's metering: when the real reading outruns the budget, truncate
    // to max_tokens words and mark a length stop — the same discipline Lantern's
    // own complete_fixture applies to a fixture that outruns its budget.
    if (tokens_out > req.max_tokens) {
        var words: u32 = 0;
        var cut: u32 = 0;
        var i: u32 = 0;
        var in_word = false;
        // invariant: truncation walks no further than the produced text
        assert(text.len <= max_result_text);
        while (i < text.len) : (i += 1) {
            const ch = text[i];
            const is_space = ch == ' ' or ch == '\t' or ch == '\n' or ch == '\r';
            if (!is_space) {
                if (!in_word) {
                    if (words == req.max_tokens) break;
                    words += 1;
                    in_word = true;
                }
                cut = i + 1;
            } else {
                in_word = false;
            }
        }
        final_text = text[0..cut];
        tokens_out = words;
        reason = .length;
    }

    // invariant: the returned text never exceeds Lantern's completion bound
    assert(final_text.len <= lc.max_completion_len);
    // invariant: metered output never exceeds the requested budget
    assert(tokens_out <= req.max_tokens);
    return .{
        .text = final_text,
        .tokens_in = tokens_in,
        .tokens_out = tokens_out,
        .stopped_reason = reason,
    };
}

fn welcome_count_rye_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "count_rye the corpus",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // The pinned catalog holds three rye chunks.
    assert(std.mem.eql(u8, resp.text, "3"));
    assert(resp.tokens_out == 1);
    assert(resp.tokens_in == 3);
    assert(resp.stopped_reason == .eos);
    print("corpus_query: count_rye routed to Ember — text '{s}' eos\n", .{resp.text});
}

fn welcome_sum_lines_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "sum_lines the corpus",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // 40 + 88 + 20 + 12 = 160 lines across the whole catalog.
    assert(std.mem.eql(u8, resp.text, "160"));
    assert(resp.tokens_out == 1);
    assert(resp.stopped_reason == .eos);
    print("corpus_query: sum_lines routed to Ember — text '{s}' eos\n", .{resp.text});
}

fn welcome_paths_rye_query() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "paths_rye the corpus",
        .max_tokens = 64,
    };
    const resp = try answer(req, allow, &buf);
    // The three rye paths in held order.
    assert(std.mem.eql(u8, resp.text, "rye/forge.rye rye/tally.rye rye/mandi.rye"));
    assert(resp.tokens_out == 3);
    assert(resp.stopped_reason == .eos);
    print("corpus_query: paths_rye routed to Ember — text '{s}' eos\n", .{resp.text});
}

fn welcome_length_budget() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "paths_rye the corpus",
        .max_tokens = 2,
    };
    const resp = try answer(req, allow, &buf);
    // The real result is three paths; a budget of two truncates and marks length.
    assert(resp.tokens_out == 2);
    assert(std.mem.eql(u8, resp.text, "rye/forge.rye rye/tally.rye"));
    assert(resp.stopped_reason == .length);
    print("corpus_query: length budget — tokens {d} length\n", .{resp.tokens_out});
}

fn unwelcome_model_not_allowed() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-not-on-list",
        .prompt = "count_rye the corpus",
        .max_tokens = 64,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.ModelNotAllowed);
    }
    print("corpus_query: model not allowed refused\n", .{});
}

fn unwelcome_unknown_op() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "translate this poem",
        .max_tokens = 64,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.UnknownOp);
    }
    print("corpus_query: unknown op refused (no fake answer)\n", .{});
}

fn unwelcome_zero_budget() !void {
    const allow =
        \\model_hash sha3-256-rye-forge-lap0
    ;
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "count_rye the corpus",
        .max_tokens = 0,
    };
    if (answer(req, allow, &buf)) |_| {
        return error.UnwelcomePassed;
    } else |err| {
        assert(err == error.BudgetExceeded);
    }
    print("corpus_query: zero budget refused by Lantern contract\n", .{});
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_count_rye_query();
        try welcome_sum_lines_query();
        try welcome_paths_rye_query();
        try welcome_length_budget();
        try unwelcome_model_not_allowed();
        try unwelcome_unknown_op();
        try unwelcome_zero_budget();
        print("corpus_query {s} — GREEN\n", .{corpus_query_version});
        return 0;
    }
    print("usage: corpus-query selftest\n", .{});
    return 1;
}
