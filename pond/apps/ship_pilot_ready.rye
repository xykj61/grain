//! pond/apps/ship_pilot_ready.rye -- TACT Journey 1, Rung 4: the ready-to-run report.
//!
//! Rungs one through three fixed the arc and wired its identity and customs steps to real
//! modules. This rung closes Ship-Pilot's agent-doable crux -- the whole first-run walked end to
//! end, every step wired real, and a readiness report a keeper reads at the finish.
//!
//! The place step now decodes the settled identity's point to a real topology place (a galaxy
//! under the compass sky); the app step names a runnable Pond app off a small allow-list of what
//! `pond/bin` truly builds. With identity settled, place assigned, customs placing, and a real
//! app named, the pilot reaches PILOT READY and the report names the concrete facts -- the settled
//! point, its place, the placed mark, the runnable app. Any step still unmet holds the pilot
//! exactly there, and the report says where -- the first-run never claims ready on a step it did
//! not prove.
//!
//! Composed over the spine (r1), the real identity (r2), and the real customs (r3). Demo keeper
//! seeds only; the maintainer's own Kumara instance stays custody gate %4. It reads no network --
//! provisioning a real Pond host stays custody gate %2; this rung proves the arc, not the host.
//!
//!   rye build pond/apps/ship_pilot_ready.rye -femit-bin=pond/bin/ship-pilot-ready
//!   pond/bin/ship-pilot-ready selftest
//!
//! Scope: active-designing/date/20260812/20260812-172129_tact-journey1-ship-pilot-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const pilot = @import("ship_pilot.rye");
const identity = @import("ship_pilot_identity.rye");
const customs_step = @import("ship_pilot_customs.rye");
const topology = @import("topology.rye");

pub const ship_pilot_ready_version = "20260812.172129";

pub const max_ready: u32 = pilot.max_report + 128; // the pilot arc plus the named facts

// The runnable Pond apps a first-run may name -- a small allow-list of what pond/bin truly
// builds, so the app step names something real, never an invented binary.
const runnable_apps = [_][]const u8{ "drawn-terminal", "mantra-browser", "quin-host" };

/// A named app is runnable only when it is one Pond truly builds.
pub fn app_runnable(name: []const u8) bool {
    for (runnable_apps) |app| {
        if (std.mem.eql(u8, name, app)) return true;
    }
    return false;
}

/// Assign the settled point its place in the topology -- a genesis point decodes to a galaxy.
/// Returns the galaxy index, or null when the point names no galaxy place.
pub fn assign_place(point: u32) ?u8 {
    const addr = topology.decode(point) orelse return null;
    if (addr.tier != .galaxy) return null;
    // invariant: a galaxy place carries a galaxy index inside the universe
    assert(addr.galaxy < topology.galaxies_per_universe);
    return addr.galaxy;
}

/// Walk the whole first-run arc with every step wired to its real signal: identity settled,
/// place assigned, customs placing, a runnable app named. Each unmet step holds the pilot
/// exactly there.
pub fn pilot_ready(id: *const identity.Identity, mark: []const u8, app_name: []const u8) pilot.PilotError!pilot.Pilot {
    var p = pilot.Pilot.begin();
    if (!id.settled) {
        _ = p.attempt(.identity, false) catch {};
        return p;
    }
    try p.attempt(.identity, true);
    const place = assign_place(id.point);
    if (place == null) {
        _ = p.attempt(.place, false) catch {};
        return p;
    }
    try p.attempt(.place, true);
    if (!customs_step.customs_admits(mark)) {
        _ = p.attempt(.customs, false) catch {};
        return p;
    }
    try p.attempt(.customs, true);
    if (!app_runnable(app_name)) {
        _ = p.attempt(.app, false) catch {};
        return p;
    }
    try p.attempt(.app, true);
    // invariant: every step met carries the arc to the end
    assert(p.is_ready());
    return p;
}

/// Render the readiness report a keeper reads at the finish -- the named facts, then the pilot's
/// own arc verdict. Refuses when the rendering exceeds its bounded buffer.
pub fn ready_report(
    id: *const identity.Identity,
    mark: []const u8,
    app_name: []const u8,
    out: []u8,
) pilot.PilotError!u32 {
    // invariant: the report buffer honors its bound
    assert(out.len >= max_ready);
    var p = try pilot_ready(id, mark, app_name);
    const place = assign_place(id.point);
    const galaxy: u32 = if (place) |g| g else 0;
    const verdict = customs_step.customs_verdict(mark);
    const verdict_word: []const u8 = switch (verdict) {
        .place => "place",
        .hold => "hold",
        .refuse => "refuse",
    };
    // The named facts, then a blank line, then the pilot's own arc report.
    const head = std.fmt.bufPrint(out, "identity {d}\nplace galaxy {d}\ncustoms {s}\napp {s}\n", .{
        id.point, galaxy, verdict_word, app_name,
    }) catch return error.ReportTooLong;
    var n: u32 = @intCast(head.len);
    const arc = try p.report(out[n..]);
    n += arc;
    // invariant: the whole report honors its bound
    assert(n <= max_ready);
    return n;
}

// ---- witnesses ----

const demo_key: [32]u8 = .{0x11} ** 32;
const demo_keeper: [32]u8 = .{0x22} ** 32;
const demo_galaxy: u32 = 3;

fn settled_demo() identity.Identity {
    return identity.settle_identity(&demo_key, &demo_keeper, demo_galaxy);
}

/// The whole arc walked with every real signal reaches PILOT READY, and the report names the
/// concrete facts.
fn welcome_full_arc_ready() !void {
    var buf: [max_ready]u8 = undefined;
    const id = settled_demo();
    assert(id.settled);
    var p = try pilot_ready(&id, "plain-bytes", "drawn-terminal");
    assert(p.is_ready());
    const n = try ready_report(&id, "plain-bytes", "drawn-terminal", &buf);
    const text = buf[0..n];
    assert(std.mem.indexOf(u8, text, "identity 3") != null);
    assert(std.mem.indexOf(u8, text, "place galaxy ") != null);
    assert(std.mem.indexOf(u8, text, "customs place") != null);
    assert(std.mem.indexOf(u8, text, "app drawn-terminal") != null);
    assert(std.mem.indexOf(u8, text, "PILOT READY") != null);
    print("ship_pilot_ready: the whole arc walked real and reached PILOT READY; the report named the facts.\n", .{});
}

/// An app the tree does not build holds the pilot at the app step -- the first-run never claims
/// ready on an invented binary.
fn unwelcome_unknown_app_holds() !void {
    var buf: [max_ready]u8 = undefined;
    const id = settled_demo();
    var p = try pilot_ready(&id, "plain-bytes", "not-a-real-app");
    assert(!p.is_ready());
    assert(p.current().? == .app);
    const n = try ready_report(&id, "plain-bytes", "not-a-real-app", &buf);
    assert(std.mem.indexOf(u8, buf[0..n], "PILOT INCOMPLETE at app") != null);
    print("ship_pilot_ready: an app the tree does not build held the pilot at the app step.\n", .{});
}

/// A held customs mark stops the arc before the app step -- the report says where it held, and
/// never names PILOT READY.
fn unwelcome_held_customs_stops_before_app() !void {
    var buf: [max_ready]u8 = undefined;
    const id = settled_demo();
    var p = try pilot_ready(&id, "await-word", "drawn-terminal");
    assert(!p.is_ready());
    assert(p.current().? == .customs);
    const n = try ready_report(&id, "await-word", "drawn-terminal", &buf);
    const text = buf[0..n];
    assert(std.mem.indexOf(u8, text, "customs hold") != null);
    assert(std.mem.indexOf(u8, text, "PILOT INCOMPLETE at customs") != null);
    assert(std.mem.indexOf(u8, text, "PILOT READY") == null);
    print("ship_pilot_ready: a held customs mark stopped the arc at customs; the report never claimed ready.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_full_arc_ready();
    try unwelcome_unknown_app_holds();
    try unwelcome_held_customs_stops_before_app();
    print("ship_pilot_ready {s} — GREEN\n", .{ship_pilot_ready_version});
    print("GREEN: TACT-J1r4 ship_pilot_ready; the first-run reaches READY only with every step proven, and reports where it holds.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: ship-pilot-ready selftest\n", .{});
    return 1;
}
