//! pond/apps/skate_group_signed.rye -- Season 3 Journey 10 (Membership), Rung 2: a vote that cannot be fabricated.
//!
//! Rung one fixed the quorum rule as a pure state machine -- a candidate is seated only when a quorum of
//! distinct members votes. Yet a bare state machine trusts whoever calls it: a steward could cast a vote
//! in a member's name, and the books would read as that member's consent to admit. This rung binds each
//! vote to the voting member's **settled Kumara identity**, so a vote a member never cast cannot be
//! counted toward a quorum.
//!
//! Each vote is signed by the very member it speaks for, over the exact facts: a tag (so a vote can
//! never be replayed as another act), the group id (so a vote cannot cross groups), the voter, and the
//! candidate. A `Keyring` maps a point to its keeper public key -- the caller's statement of whose word
//! to trust (as `skate_circle_signed` and `commerce_trade_signed` pass their keys). `vote_signed`
//! verifies the voting member's own signature against the keyring **before** touching rung one's group,
//! refusing `UnknownKeeper` (the voter is not enrolled) or `BadConsent` (the signature does not verify).
//! The honesty crux mirrors the circle's relabel: change the candidate after signing and reuse the
//! signature, and it falls -- the signature was over the candidate the member actually named. And the
//! lone-steward guard carries through r1 unchanged: a member's signature lets them vote once, never
//! twice, so a signed act still cannot fake a quorum from one hand.
//!
//! The founders are the group's given bootstrap roster (its genesis, seeded at open); every *admission*
//! after that takes signed, distinct votes. Additive -- composes rung one (`skate_group`) and `kumara`
//! over public API; rung one stays its own GREEN binary. Demo keeper seeds only -- no real key, no
//! network, no real identity (a group served over the wire reaches the serve gate -- Keaton's hand).
//!
//!   rye build pond/apps/skate_group_signed.rye -femit-bin=pond/bin/skate-group-signed
//!   pond/bin/skate-group-signed selftest
//!
//! Scope: active-designing/date/20260812/20260812-204233_dahl-journey10-membership-quorum-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const group_mod = @import("skate_group.rye");
const kumara = @import("kumara.rye");

pub const skate_group_signed_version = "20260812.204233";

pub const pubkey_len: u32 = 32;
pub const sig_len: u32 = 64;

/// A keyring maps a point to its keeper public key -- a caller's statement of whose vote to trust.
pub const max_keyring: u32 = group_mod.max_members;

/// The act a signature speaks for -- a tag so a vote can never be replayed as another act.
const tag_vote: u8 = 1;

/// The exact bytes a vote signs: the tag, the group id (so a vote cannot cross groups), the voter, and
/// the candidate.
pub const max_msg_len: u32 = 1 + 4 + 4 + 4; // tag, group_id, voter, candidate

pub const SignedError = error{
    UnknownKeeper, // the voting point is not enrolled in the keyring — no key to check its word against
    BadConsent, // the signature does not verify over these exact facts — the member did not cast this vote
};

pub const GroupActError = SignedError || group_mod.GroupError;

fn vote_message(out: *[max_msg_len]u8, group_id: u32, voter: u32, candidate: u32) u32 {
    out[0] = tag_vote;
    std.mem.writeInt(u32, out[1..5], group_id, .little);
    std.mem.writeInt(u32, out[5..9], voter, .little);
    std.mem.writeInt(u32, out[9..13], candidate, .little);
    // invariant: the vote message is exactly its fixed length, within the buffer bound.
    assert(13 <= max_msg_len);
    return 13;
}

/// The voting member's signature over their own vote -- proof this point voted to admit this candidate.
pub fn sign_vote(keeper_seed: *const [kumara.seed_length]u8, group_id: u32, voter: u32, candidate: u32) [sig_len]u8 {
    const kp = kumara.keypair_from_seed(keeper_seed);
    var msg: [max_msg_len]u8 = undefined;
    const len = vote_message(&msg, group_id, voter, candidate);
    return kumara.sign(msg[0..len], kp, null).toBytes();
}

fn verify_over(keeper: [pubkey_len]u8, msg: []const u8, sig: *const [sig_len]u8) bool {
    // invariant: an Ed25519 public key is 32 bytes and a signature 64.
    assert(pubkey_len == 32);
    assert(sig_len == 64);
    const pub_key = kumara.PublicKey.fromBytes(keeper) catch return false;
    kumara.verify_bytes(msg, sig, pub_key) catch return false;
    return true;
}

/// A bounded map from a point to its keeper public key -- whose vote the caller trusts.
// Invariant: count <= max_keyring.
pub const Keyring = struct {
    points: [max_keyring]u32,
    keys: [max_keyring][pubkey_len]u8,
    count: u32,

    pub fn open() Keyring {
        const k = Keyring{ .points = undefined, .keys = undefined, .count = 0 };
        // invariant: an opened keyring enrolls no one.
        assert(k.count == 0);
        return k;
    }

    pub fn enroll(self: *Keyring, point: u32, key: [pubkey_len]u8) error{KeyringFull}!void {
        if (self.count >= max_keyring) return error.KeyringFull;
        const i = self.count;
        self.points[i] = point;
        self.keys[i] = key;
        self.count += 1;
        // invariant: enrolling grew the ring by exactly one, within its bound.
        assert(self.count == i + 1);
        assert(self.count <= max_keyring);
    }

    pub fn key_of(self: *const Keyring, point: u32) ?[pubkey_len]u8 {
        // invariant: the ring never exceeds its bound.
        assert(self.count <= max_keyring);
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (self.points[i] == point) return self.keys[i];
        }
        return null;
    }
};

/// Verify a member's own vote signature against the keyring, refusing an unenrolled voter
/// (`UnknownKeeper`) or an unverifying signature (`BadConsent`). Touches no group -- the verification
/// half alone, so a traveled record (r3) can re-check a vote offline with no state to mutate.
pub fn verify_vote(ring: *const Keyring, group_id: u32, voter: u32, candidate: u32, sig: *const [sig_len]u8) SignedError!void {
    const key = ring.key_of(voter) orelse return error.UnknownKeeper;
    var msg: [max_msg_len]u8 = undefined;
    const len = vote_message(&msg, group_id, voter, candidate);
    if (!verify_over(key, msg[0..len], sig)) return error.BadConsent;
}

/// A member votes to admit a candidate only when their own signature over this exact vote verifies.
/// Refuses an unenrolled voter (`UnknownKeeper`) or an unverifying signature (`BadConsent`) before
/// touching the group, then votes through rung one (which refuses a non-member / re-admit / double vote
/// / full roster by its own laws, so a signed vote still cannot fake a quorum from one hand).
pub fn vote_signed(
    group: *group_mod.Group,
    ring: *const Keyring,
    group_id: u32,
    voter: u32,
    candidate: u32,
    sig: *const [sig_len]u8,
) GroupActError!void {
    try verify_vote(ring, group_id, voter, candidate, sig);
    try group.vote(voter, candidate);
}

// --- selftest -----------------------------------------------------------

// Demo keeper seeds -- plainly not real keys, so no identity is invented.
const ivy_seed: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const wren_seed: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const flax_seed: [kumara.seed_length]u8 = .{0x33} ** kumara.seed_length;

const ivy: u32 = 101;
const wren: u32 = 202;
const flax: u32 = 303;
const bram: u32 = 404;
const cate: u32 = 505;
const demo_group: u32 = 7;

fn pubkey_of(seed: *const [kumara.seed_length]u8) [pubkey_len]u8 {
    return kumara.keypair_from_seed(seed).public_key.bytes;
}

fn demo_ring() error{KeyringFull}!Keyring {
    var ring = Keyring.open();
    try ring.enroll(ivy, pubkey_of(&ivy_seed));
    try ring.enroll(wren, pubkey_of(&wren_seed));
    try ring.enroll(flax, pubkey_of(&flax_seed));
    return ring;
}

fn demo_group_of_three() group_mod.GroupError!group_mod.Group {
    return group_mod.Group.open(&.{ ivy, wren, flax }, 2);
}

/// Two signed votes from distinct members seat a candidate -- each vote carrying its member's own word.
fn welcome_signed_quorum_admits() !void {
    var g = try demo_group_of_three();
    const ring = try demo_ring();

    const ivy_votes = sign_vote(&ivy_seed, demo_group, ivy, bram);
    try vote_signed(&g, &ring, demo_group, ivy, bram, &ivy_votes);
    assert(g.verdict(bram) == .hold); // one signed vote holds

    const wren_votes = sign_vote(&wren_seed, demo_group, wren, bram);
    try vote_signed(&g, &ring, demo_group, wren, bram, &wren_votes);
    assert(g.verdict(bram) == .place); // two distinct signed votes — the quorum is met
    assert(g.is_member(bram));
    print("skate_group_signed: two signed votes from distinct members seated a candidate — each vote its member's own word.\n", .{});
}

/// The lone-steward guard carries through signing -- a member's valid signature lets them vote once, not
/// twice, so a signed act still cannot fake a quorum from one hand.
fn unwelcome_signed_double_cannot_fake() !void {
    var g = try demo_group_of_three();
    const ring = try demo_ring();

    const ivy_votes = sign_vote(&ivy_seed, demo_group, ivy, bram);
    try vote_signed(&g, &ring, demo_group, ivy, bram, &ivy_votes);
    // The same signed vote presented again -- one member, one vote.
    const doubled = vote_signed(&g, &ring, demo_group, ivy, bram, &ivy_votes);
    assert(doubled == error.AlreadyVoted);
    assert(g.tally(bram) == 1);
    assert(!g.is_member(bram));
    print("skate_group_signed: a member's signed vote counted once, the repeat refused AlreadyVoted — signing cannot fake a quorum from one hand.\n", .{});
}

/// The honesty crux -- a steward relabels a vote's candidate after signing and reuses the signature; it
/// falls, because the signature was over the candidate the member actually named.
fn unwelcome_relabel_candidate_refuses() !void {
    var g = try demo_group_of_three();
    const ring = try demo_ring();
    // Ivy signed a vote to admit Bram; a steward reuses it claiming Ivy voted for Cate.
    const ivy_votes_bram = sign_vote(&ivy_seed, demo_group, ivy, bram);
    const swapped = vote_signed(&g, &ring, demo_group, ivy, cate, &ivy_votes_bram);
    assert(swapped == error.BadConsent);
    assert(g.tally(cate) == 0); // no vote for Cate was recorded
    print("skate_group_signed: a vote's candidate relabelled after signing refused BadConsent — a steward cannot swap whom a member voted for.\n", .{});
}

/// One member cannot sign another's vote -- the voting point must sign its own vote.
fn unwelcome_forged_vote_refuses() !void {
    var g = try demo_group_of_three();
    const ring = try demo_ring();
    // Wren signs a vote naming Ivy as the voter -- the wrong keeper's word for Ivy's vote.
    const forged = sign_vote(&wren_seed, demo_group, ivy, bram);
    const bad = vote_signed(&g, &ring, demo_group, ivy, bram, &forged);
    assert(bad == error.BadConsent);
    assert(g.tally(bram) == 0); // no vote was counted on a forged word
    print("skate_group_signed: a vote signed by the wrong keeper refused BadConsent — a member signs their own vote.\n", .{});
}

/// A member the ring does not enroll has no key to check -- their word cannot be trusted, so the vote
/// refuses UnknownKeeper before the group is touched, even though the voter is a real member.
fn unwelcome_unknown_keeper_refuses() !void {
    var g = try demo_group_of_three();
    // A ring that enrolls only ivy and wren -- flax is a member but unenrolled.
    var ring = Keyring.open();
    try ring.enroll(ivy, pubkey_of(&ivy_seed));
    try ring.enroll(wren, pubkey_of(&wren_seed));
    const flax_votes = sign_vote(&flax_seed, demo_group, flax, bram);
    const bad = vote_signed(&g, &ring, demo_group, flax, bram, &flax_votes);
    assert(bad == error.UnknownKeeper);
    print("skate_group_signed: a vote by a member the ring does not enroll refused UnknownKeeper — whose word is unknown is not counted.\n", .{});
}

/// A signature bound to one group does not cross into another -- a vote names its group.
fn unwelcome_cross_group_refuses() !void {
    var g = try demo_group_of_three();
    const ring = try demo_ring();
    // Ivy signs a vote for group 7; the same signature is presented to group 8.
    const ivy_votes_7 = sign_vote(&ivy_seed, demo_group, ivy, bram);
    const other_group: u32 = 8;
    const bad = vote_signed(&g, &ring, other_group, ivy, bram, &ivy_votes_7);
    assert(bad == error.BadConsent);
    print("skate_group_signed: a vote signed for one group refused BadConsent in another — a vote names its group.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_signed_quorum_admits();
    try unwelcome_signed_double_cannot_fake();
    try unwelcome_relabel_candidate_refuses();
    try unwelcome_forged_vote_refuses();
    try unwelcome_unknown_keeper_refuses();
    try unwelcome_cross_group_refuses();
    print("skate_group_signed: version {s}\n", .{skate_group_signed_version});
    print("GREEN: DAHL-J10r2 skate_group_signed; each vote carries its member's signature, and a vote cannot be fabricated or faked from one hand.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "skate-group-signed"))) {
        return run_selftest();
    }
    return run_selftest();
}
