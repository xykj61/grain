//! pond/apps/constel_net_true.rye -- Constel dev-net harness, Rung 4: the net reads true (the arc closes).
//!
//! Rungs one through three named a fake dev-net from a law-safe name, settled a whole d12-d60 branch
//! beneath it, and let a constel travel as a `format constel-net-v1` Bron record -- all over nets seated
//! in code. This closing rung carries the reader onto a **real** on-disk constel record a keeper can open
//! and count, and proves the property the whole harness rests on: what the reader *reports* about a net
//! is true to the bytes.
//!
//! The corpus is `tools/fixtures/constel_net.bron`, a genuine `format constel-net-v1` record produced
//! reproducibly by `pond/apps/constel_net_fixture_gen.rye` (the branch galaxy 3 - star 27 - planet 267
//! under the law-safe name `xnqvel34`), `@embedFile`-bound at compile time through a symlink in
//! `pond/apps/corpora/` -- no network, the bytes read are the tree's own. Two independent readings must
//! agree: the app parses the record through rung three and reports the **roster size**, the **galaxy**
//! (first point), and the **planet** (deepest point), and the witness cross-checks that triple against
//! `tools/fixtures/constel_net_truth.awk`'s reading of the same file -- two tools, one answer. And the
//! record is genuinely a harness record and genuinely quarantined: re-rendering the parsed roster
//! reproduces the embedded bytes exactly (the fixture is what the harness emits, not a hand-mock), and
//! the recovered name is still law-safe (the quarantine holds on the real bytes).
//!
//! Additive -- composes rung three over public API (it re-runs GREEN). Demo seeds only, reads no network
//! (a constel served over the wire reaches the serve gate -- Keaton's hand).
//!
//!   rye build pond/apps/constel_net_true.rye -femit-bin=pond/bin/constel-net-true
//!   pond/bin/constel-net-true selftest
//!
//! Law:   active-designing/date/20260813/20260813-022222_constel-test-network-naming-law.md
//! Scope: active-designing/date/20260813/20260813-022908_constel-devnet-harness-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const constel_net = @import("constel_net.rye");
const bron = @import("constel_net_bron.rye");

pub const constel_net_true_version = "20260813.024836";

/// The real constel record, bound at compile time -- the tree's own bytes, never a drifting copy.
const real_net = @embedFile("corpora/constel_net.bron");

/// The three facts a keeper can count by hand: the roster size, the galaxy it is crowned by, and the
/// deepest member (the planet).
pub const Reading = struct {
    points: u32,
    galaxy: u32,
    planet: u32,
};

/// Read the real net: parse it and count the three facts. The parse refuses a malformed record by rung
/// three's own reasons (including an unsafe name); here the bytes are the tree's own, so the reading is
/// honest by construction.
pub fn read_net(text: []const u8) bron.BronError!Reading {
    const pc = try bron.parse(text);
    // invariant: a real net record carries at least its crowning galaxy -- an empty roster is no net.
    if (pc.point_count == 0) return error.MissingNet;
    return .{
        .points = pc.point_count,
        .galaxy = pc.point_at(0),
        .planet = pc.point_at(pc.point_count - 1),
    };
}

// --- selftest -----------------------------------------------------------

const galaxy_num: u32 = 3;
const planet_num: u32 = 267;
const demo_name = "xnqvel34";

/// The reading of the real record -- the witness cross-checks this triple against awk's reading of the
/// same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_net(real_net);
    // The fixture holds a three-point branch crowned by galaxy 3, deepest at planet 267.
    assert(r.points == 3);
    assert(r.galaxy == galaxy_num);
    assert(r.planet == planet_num);
    print("constel-net-true: truth-triple {d} {d} {d}\n", .{ r.points, r.galaxy, r.planet });
    print("constel-net-true: the reading of the real record — points, galaxy, planet — matches an independent count of the same bytes.\n", .{});
}

/// The record is genuinely a harness record and genuinely quarantined: re-rendering the parsed roster
/// reproduces the embedded bytes exactly, and the recovered name is still law-safe.
fn welcome_record_is_really_a_harness_net() !void {
    const pc = try bron.parse(real_net);
    // the quarantine holds on the real bytes -- the recovered name carries a digit
    assert(constel_net.name_safe(pc.name()));
    assert(std.mem.eql(u8, pc.name(), demo_name));
    // re-rendering the parsed roster reproduces the embedded bytes exactly -- a real harness record
    var buf: [bron.max_record]u8 = undefined;
    const n = try bron.render(&pc, &buf);
    assert(n == real_net.len);
    assert(std.mem.eql(u8, buf[0..n], real_net));
    print("constel-net-true: the real record re-renders to the embedded bytes exactly, and its recovered name is still law-safe.\n", .{});
}

/// A tampered copy of the real bytes refuses -- the reader will not read a corrupted record as true.
fn unwelcome_tampered_record_refuses() !void {
    // Flip a byte inside the header so the record no longer names its format.
    var buf: [real_net.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_net.len) : (k += 1) buf[k] = real_net[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_net(buf[0..]);
    assert(bad == error.BadFormat);
    print("constel-net-true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_record_is_really_a_harness_net();
    try unwelcome_tampered_record_refuses();
    print("constel-net-true {s} — GREEN\n", .{constel_net_true_version});
    print("GREEN: constel-net r4; the reading of a real constel record is true to the bytes (points·galaxy·planet), and the record is a genuine, law-safe harness net. The harness's agent-doable arc closes.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<points> <galaxy> <planet>`), so the witness can compare the
/// app's reading against `constel_net_truth.awk` byte for byte -- two tools, one answer.
fn run_measure() !u8 {
    const r = try read_net(real_net);
    print("{d} {d} {d}\n", .{ r.points, r.galaxy, r.planet });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: constel-net-true selftest | measure\n", .{});
    return 1;
}
