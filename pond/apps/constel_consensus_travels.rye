//! pond/apps/constel_consensus_travels.rye -- the network travels (gossip-convergence r3).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - gossip-convergence r3.
//! Design read: active-designing/date/20260813/20260813-040613_constel-consensus-gossip-convergence-exploration.md
//!
//! r1 proved two nodes begun from their own genesis converge once they gossip;
//! r2 proved a healed partition catches up because convergence is content-dependent,
//! not timing-dependent. Both exchanged blocks in shared process memory. A mesh
//! becomes a network only when a node's agreed order crosses to a stranger as
//! readable bytes -- with no shared memory, no gossip channel, no ordering message.
//!
//! This round carries the gossip-converged Dag out as text: node A and node B
//! converge over `gossip_merge` (r1's crux), then A renders its converged Dag to a
//! `format cord-dag-v1` record and a **far node** -- one that never gossiped, holds
//! no channel to the mesh, and begins empty -- reconstructs the whole history from
//! those bytes alone and commits to the byte-identical order, folding the real
//! Mycelium law to the identical supply. So the bytes *are* the network: the record
//! replaces the gossip protocol entirely, and every signature rides in it and is
//! re-verified on rebuild -- a tampered record refuses `BadSignature` and can never
//! cross as consensus.
//!
//! Composes r1's public gossip fixpoint and commit helpers (`seeded`, `gossip_merge`,
//! `commits_equal`, `committed_supply`) with the Cord's own `format cord-dag-v1`
//! reader/writer (`from_dag`, `render`, `parse`, `rebuild`); r1 and cord-bron re-run
//! GREEN at this round's door. Siloed, dev-only, demo seeds -- no real key, no funds,
//! no network, no custody; a Cord gossiped over Comlink reaches the serve gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run pond/apps/constel_consensus_travels.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const cc = @import("constel_consensus.rye");
const cord_bron = @import("cord_bron.rye");

/// Seat two nodes, each begun from its own genesis, and gossip them to convergence
/// exactly as r1 does -- then return node A's converged Dag for the network to carry.
/// The two nodes are asserted converged before the order is handed off, so what
/// travels is a genuine agreed history, not one node's private draft.
pub fn converge_two_nodes() !cord.Dag {
    const ka = cc.seeded(0xA1);
    const kb = cc.seeded(0xB2);
    const kc = cc.seeded(0xC3);
    const kd = cc.seeded(0xD4);

    // Two local views, each holding only its own genesis issue at first.
    var dag_a = cord.Dag.empty();
    var dag_b = cord.Dag.empty();

    const fa = fold.mint_fact(ka, fold.kind_issue, 500, "", "genesis-a") orelse return error.MintA;
    const fb = fold.mint_fact(kb, fold.kind_issue, 500, "", "genesis-b") orelse return error.MintB;
    const ba = cord.mint_block(ka, 0, &[_][cord.hash_len]u8{}, fa) orelse return error.BlockA;
    const bb = cord.mint_block(kb, 0, &[_][cord.hash_len]u8{}, fb) orelse return error.BlockB;
    try cord.add(&dag_a, ba);
    try cord.add(&dag_b, bb);
    // invariant: each node begins holding exactly its own single genesis block.
    assert(dag_a.len == 1);
    assert(dag_b.len == 1);

    // Gossip the genesis blocks both ways -- each node now holds both roots.
    _ = try cc.gossip_merge(&dag_a, &dag_b);
    _ = try cc.gossip_merge(&dag_b, &dag_a);

    // Each mints a round-1 fact referencing both genesis blocks -- real cross-node
    // fan-in, mintable only after gossip taught each node the other's root.
    var ha: [cord.hash_len]u8 = undefined;
    var hb: [cord.hash_len]u8 = undefined;
    cord.address(&ba, &ha);
    cord.address(&bb, &hb);
    const roots = [_][cord.hash_len]u8{ ha, hb };

    const fc = fold.mint_fact(kc, fold.kind_tax, 200, "", "tax-c") orelse return error.MintC;
    const fd = fold.mint_fact(kd, fold.kind_star_reserve, 100, "vega", "reserve") orelse return error.MintD;
    const bc = cord.mint_block(kc, 1, roots[0..], fc) orelse return error.BlockC;
    const bd = cord.mint_block(kd, 1, roots[0..], fd) orelse return error.BlockD;
    try cord.add(&dag_a, bc);
    try cord.add(&dag_b, bd);
    _ = try cc.gossip_merge(&dag_a, &dag_b);
    _ = try cc.gossip_merge(&dag_b, &dag_a);

    // invariant: both nodes drained to the full four-block mesh.
    assert(dag_a.len == 4);
    assert(dag_b.len == 4);
    // invariant: the two nodes converged before the order is carried out as text.
    assert(cc.commits_equal(&dag_a, &dag_b));
    return dag_a;
}

pub fn main() !void {
    // r1's crux, re-seated: two nodes from their own genesis converge over gossip.
    const converged = try converge_two_nodes();
    if (converged.len != 4) return error.NotConverged;
    const state = try cc.committed_supply(&converged);
    if (state.supply() != 700) return error.SupplyNet;
    if (state.star_count != 1) return error.StarCount;

    // The network travels: the converged Dag renders to a format cord-dag-v1 record.
    const pl = try cord_bron.from_dag(&converged);
    var buf: [cord_bron.max_record]u8 = undefined;
    const n = try cord_bron.render(&pl, &buf);
    // invariant: the record carries every block of the converged mesh.
    assert(pl.len == converged.len);

    // A far node -- never gossiped, holds no channel, begins empty -- reconstructs the
    // whole history from the bytes alone and re-admits each block under r1's own add,
    // re-verifying every signature.
    const heard = try cord_bron.parse(buf[0..n]);
    if (heard.len != 4) return error.RosterLostOverWire;
    var far_dag = try cord_bron.rebuild(&heard);
    if (far_dag.len != 4) return error.FarRebuildPartial;

    // The crux: the far node commits to the byte-identical agreed order and folds the
    // real Mycelium law to the identical supply -- no gossip, no ordering message, the
    // record alone carried the network.
    if (!cc.commits_equal(&far_dag, &converged)) return error.FarNodeDiverged;
    const far_state = try cc.committed_supply(&far_dag);
    if (far_state.supply() != state.supply()) return error.SupplyDivergedOverWire;
    if (far_state.star_count != state.star_count) return error.StarsDivergedOverWire;

    // A tampered record cannot cross as consensus: flip one byte of a block signature
    // in the recovered roster and the rebuild refuses BadSignature at add, before the
    // far node ever holds the forgery.
    var tampered = heard;
    tampered.blocks[0].sig[0] ^= 0xff;
    if (cord_bron.rebuild(&tampered)) |_| {
        return error.TamperCrossed;
    } else |err| {
        if (err != error.BadSignature) return error.WrongTamper;
    }

    print("constel-travels: two nodes from their own genesis converge over gossip on one agreed order (supply {d}, one star)\n", .{state.supply()});
    print("constel-travels: the converged Dag renders to a format cord-dag-v1 record — the agreed history as readable bytes\n", .{});
    print("constel-travels: a far node that never gossiped reconstructs from the bytes alone and commits to the byte-identical order, folding supply {d} over one star\n", .{far_state.supply()});
    print("constel-travels: a tampered record refuses BadSignature on rebuild — corruption can never cross as consensus\n", .{});
    print("GREEN: constel travels — the converged mesh crosses to a far node as text · order identical · supply={d} · stars={d} · tamper refused whole\n", .{
        far_state.supply(),
        far_state.star_count,
    });
}
