//! pond/apps/graph_query_edit.rye -- BUHR Journey 6, Rung 2: the query tracks a live edit.
//!
//! Rung one proved a voice can read the living graph -- the head it reports (r2 on
//! a.txt) is the head the browser paints. This rung proves the *living* in living
//! graph: when the surface is edited, the voice's answer moves with it. It composes
//! Journey 6's `graph_query.answer_over` with Journey 4's `mantra_editor.commit` over
//! one catalog -- ask the head, commit a new revision, ask again, and watch the
//! reported head advance from r2 to r3. Nothing is mutated behind the reader: an edit
//! is an append, so the earlier answer was true when it was given and the new answer
//! is true now.
//!
//! Additive by construction: it imports graph_query and mantra_editor and calls only
//! their public functions. Neither contract changes; rung one and the editor stay
//! their own green binaries.
//!
//!   rye build pond/apps/graph_query_edit.rye -femit-bin=pond/bin/graph-query-edit
//!   pond/bin/graph-query-edit selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const lc = @import("lantern/lantern_core.rye");
const mb = @import("mantra_browser.rye");
const gq = @import("graph_query.rye");
const ed = @import("mantra_editor.rye");

const graph_query_edit_version = "20260812.140400";

const max_result_text: u32 = lc.max_completion_len;

// The lane the query and the edit both name -- the demo graph's two-revision lane.
const q_peer = "local";
const q_bolt = "notes";
const q_path = "a.txt";
const editor_tilak = "leaf";

const head_allow =
    \\model_hash sha3-256-rye-forge-lap0
;

fn head_request() lc.Request {
    return .{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "head the a.txt lane",
        .max_tokens = 64,
    };
}

fn welcome_head_advances_on_edit() !void {
    var catalog = try mb.demo_catalog();
    var buf: [max_result_text]u8 = undefined;

    // Ask the head before the edit -- the a.txt lane stands at r2.
    const before = try gq.answer_over(head_request(), head_allow, &catalog, &buf);
    // invariant: the voice reads the living edge, r2.
    assert(std.mem.eql(u8, before.text, "2"));
    assert(before.stopped_reason == .eos);
    print("graph_query_edit: head before edit — a.txt at r{s}\n", .{before.text});

    // Commit a new revision through the editor -- an append, never a rewrite.
    const new_head = try ed.commit(&catalog, q_peer, q_bolt, q_path, "alpha-three", editor_tilak);
    // invariant: the commit advanced the lane's head by exactly one.
    assert(new_head == 3);

    // Ask again over the same catalog -- the voice's answer moved with the surface.
    var buf2: [max_result_text]u8 = undefined;
    const after = try gq.answer_over(head_request(), head_allow, &catalog, &buf2);
    // invariant: the reported head advanced to r3.
    assert(std.mem.eql(u8, after.text, "3"));
    assert(after.stopped_reason == .eos);
    print("graph_query_edit: head after edit — a.txt at r{s} (advanced by the commit)\n", .{after.text});
}

fn welcome_lane_count_grows_on_fork() !void {
    var catalog = try mb.demo_catalog();
    var buf: [max_result_text]u8 = undefined;
    const req = lc.Request{
        .model_hash = "sha3-256-rye-forge-lap0",
        .prompt = "lane_count the graph",
        .max_tokens = 64,
    };

    // Three lanes before the fork.
    const before = try gq.answer_over(req, head_allow, &catalog, &buf);
    assert(std.mem.eql(u8, before.text, "3"));

    // Open a new lane through the editor -- the graph grows by one lane.
    _ = try ed.open_lane(&catalog, q_peer, q_bolt, "c.txt", "gamma", editor_tilak);

    var buf2: [max_result_text]u8 = undefined;
    const after = try gq.answer_over(req, head_allow, &catalog, &buf2);
    // invariant: the voice now counts four lanes -- the fork is visible to the query.
    assert(std.mem.eql(u8, after.text, "4"));
    print("graph_query_edit: lane_count grew 3 -> {s} on a new lane\n", .{after.text});
}

fn welcome_earlier_answer_still_true() !void {
    // An edit is an append: the earlier revision still stands, so a head query over a
    // catalog restored to its earlier shape still reads the earlier head. Proven by
    // asking two independent catalogs -- one edited, one not -- and seeing each answer
    // its own true head.
    var edited = try mb.demo_catalog();
    var pristine = try mb.demo_catalog();
    _ = try ed.commit(&edited, q_peer, q_bolt, q_path, "alpha-three", editor_tilak);

    var buf_a: [max_result_text]u8 = undefined;
    var buf_b: [max_result_text]u8 = undefined;
    const edited_head = try gq.answer_over(head_request(), head_allow, &edited, &buf_a);
    const pristine_head = try gq.answer_over(head_request(), head_allow, &pristine, &buf_b);
    // invariant: each catalog answers its own true head -- the query never mutates it.
    assert(std.mem.eql(u8, edited_head.text, "3"));
    assert(std.mem.eql(u8, pristine_head.text, "2"));
    print("graph_query_edit: edited graph reads r{s}, pristine reads r{s} — the query is read-only\n", .{ edited_head.text, pristine_head.text });
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        try welcome_head_advances_on_edit();
        try welcome_lane_count_grows_on_fork();
        try welcome_earlier_answer_still_true();
        print("graph_query_edit {s} — GREEN\n", .{graph_query_edit_version});
        return 0;
    }
    print("usage: graph-query-edit selftest\n", .{});
    return 1;
}
