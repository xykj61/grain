//! pond/apps/skate_circle.rye -- Season 3 Journey 9 (Skate), Rung 1: consent is mutual, presence is never default.
//!
//! Season 3, Commons -- keepers meet each other with consent. Skate is the social layer over Pond
//! identities, and Journey 9 draws its first, load-bearing half: how two keepers come to *see* each
//! other at all. Pond's own first policy already names the shape at the artifact border -- place -
//! hold - refuse (`pond/customs.rye`); Skate carries that same trichotomy to the social border, where
//! the resting verdict is the strictest one.
//!
//! The crux: **a link between two members exists only when both have requested it.** A `Circle` is a
//! shared surface a keeper joins only by their own explicit act -- no keeper is a member by default. A
//! `link` between two members is mutual-only: one keeper's request is a standing offer that **holds**;
//! the connection **places** (links) only when the other keeper has also asked. A one-sided request
//! holds forever without ever becoming a link, so a steward cannot manufacture a connection from one
//! side. Visibility follows the link exactly -- a member sees another only when they are linked, so
//! presence is never default. This is the honest meaning of consent-first: not "opt out is available,"
//! but "nothing exists until both opted in."
//!
//! This is the pure rule as a bounded state machine -- consent modeled as explicit acts, no signing yet
//! (r2 signs each act with the keeper's settled Kumara identity, mirroring `commerce_trade_signed`).
//! Facts only, custody-first: it records the facts of consent and holds nothing, opens no network, and
//! generates no real identity (a circle shared over the wire reaches the serve gate -- Keaton's hand).
//! Demo keeper points only.
//!
//!   rye build pond/apps/skate_circle.rye -femit-bin=pond/bin/skate-circle
//!   pond/bin/skate-circle selftest
//!
//! Scope: active-designing/date/20260812/20260812-201611_dahl-journey9-skate-consent-first-exploration.md

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const skate_circle_version = "20260812.201611";

/// A circle seats at most this many keepers -- a bounded shared surface, not a whole network.
pub const max_members: u32 = 32;

/// A circle holds at most this many one-sided link requests -- bounded so consent never grows unbounded.
pub const max_requests: u32 = 128;

/// The social verdict, carried from Pond's own customs trichotomy to the keeper border.
pub const Verdict = enum {
    refuse, // not both members, or neither has asked — the resting state; nobody is visible by default
    hold, // exactly one keeper has asked to link; a standing offer, never yet a connection
    place, // both keepers have asked — mutual consent; only this makes a link, and a link makes visible
};

pub const CircleError = error{
    AlreadyMember, // a keeper already holds a seat — a seat is claimed once
    NotMember, // a link touches a keeper who has not joined — only members consent
    SelfLink, // a keeper cannot link with themselves — a bond crosses between two keepers
    AlreadyRequested, // this keeper already made this exact request — an offer is recorded once
    CircleFull, // the circle is at its seat bound — refuse rather than drop a keeper
    RequestsFull, // the request book is at its bound — refuse rather than drop consent
};

/// One keeper's standing offer to link with another -- directional by construction, so mutuality is a
/// property of two of these existing, never of one.
const Request = struct {
    from: u32,
    to: u32,
};

/// A shared surface: the keepers who have joined by their own act, and every one-sided link request
/// they have made. A link is not stored -- it is *derived* as the presence of two opposing requests, so
/// the mutual-only law cannot be bypassed by writing a link directly.
// Invariant: member_count <= max_members; request_count <= max_requests.
pub const Circle = struct {
    members: [max_members]u32,
    member_count: u32,
    requests: [max_requests]Request,
    request_count: u32,

    pub fn open() Circle {
        const c = Circle{ .members = undefined, .member_count = 0, .requests = undefined, .request_count = 0 };
        // invariant: an opened circle seats no one and holds no request -- presence is never default.
        assert(c.member_count == 0);
        assert(c.request_count == 0);
        return c;
    }

    /// Is this keeper a member -- did they join by their own act?
    pub fn is_member(self: *const Circle, point: u32) bool {
        // invariant: the member roll never exceeds its bound.
        assert(self.member_count <= max_members);
        var i: u32 = 0;
        while (i < self.member_count) : (i += 1) {
            if (self.members[i] == point) return true;
        }
        return false;
    }

    /// A keeper joins the circle by their own explicit act. Refuses a taken seat (a seat is claimed
    /// once) and a full circle (bounded rather than dropping a keeper).
    pub fn join(self: *Circle, point: u32) CircleError!void {
        if (self.is_member(point)) return error.AlreadyMember;
        if (self.member_count >= max_members) return error.CircleFull;
        const i = self.member_count;
        self.members[i] = point;
        self.member_count += 1;
        // invariant: joining seated exactly one keeper, within the bound.
        assert(self.member_count == i + 1);
        assert(self.member_count <= max_members);
    }

    /// Does this exact directional request already stand?
    fn has_request(self: *const Circle, from: u32, to: u32) bool {
        // invariant: the request book never exceeds its bound.
        assert(self.request_count <= max_requests);
        var i: u32 = 0;
        while (i < self.request_count) : (i += 1) {
            if (self.requests[i].from == from and self.requests[i].to == to) return true;
        }
        return false;
    }

    /// One keeper asks to link with another -- a standing offer. Both must be members (only members
    /// consent); a keeper cannot ask themselves; the same offer is recorded once; the book is bounded.
    /// A request alone never makes a link -- it takes the opposite request too (see `verdict`).
    pub fn request_link(self: *Circle, from: u32, to: u32) CircleError!void {
        if (from == to) return error.SelfLink;
        if (!self.is_member(from)) return error.NotMember;
        if (!self.is_member(to)) return error.NotMember;
        if (self.has_request(from, to)) return error.AlreadyRequested;
        if (self.request_count >= max_requests) return error.RequestsFull;
        const i = self.request_count;
        self.requests[i] = .{ .from = from, .to = to };
        self.request_count += 1;
        // invariant: the offer grew the book by exactly one, within its bound.
        assert(self.request_count == i + 1);
        assert(self.request_count <= max_requests);
    }

    /// The verdict for a pair of keepers -- the whole consent rule, folded to one answer:
    ///   refuse -- either is not a member, or neither has asked
    ///   hold   -- exactly one has asked (a standing offer, not yet a connection)
    ///   place  -- both have asked (mutual consent -- a link)
    pub fn verdict(self: *const Circle, a: u32, b: u32) Verdict {
        if (a == b) return .refuse; // a keeper is not linked with themselves
        if (!self.is_member(a) or !self.is_member(b)) return .refuse;
        const a_asked = self.has_request(a, b);
        const b_asked = self.has_request(b, a);
        if (a_asked and b_asked) return .place;
        if (a_asked or b_asked) return .hold;
        return .refuse;
    }

    /// Are these two keepers linked -- did *both* consent? A link is mutual-only; this is the crux.
    pub fn linked(self: *const Circle, a: u32, b: u32) bool {
        return self.verdict(a, b) == .place;
    }

    /// Does `viewer` see `other`? A member sees another only when linked -- presence is never default.
    /// Visibility follows the link exactly, so the rule has one source of truth.
    pub fn visible(self: *const Circle, viewer: u32, other: u32) bool {
        // invariant: visibility is nothing more, and nothing less, than a mutual link.
        assert((self.verdict(viewer, other) == .place) == self.linked(viewer, other));
        return self.linked(viewer, other);
    }
};

// --- selftest -----------------------------------------------------------

// Demo keeper points -- plain identifiers for the pure rule; r2 binds each to a settled Kumara identity.
const ivy: u32 = 101;
const wren: u32 = 202;
const flax: u32 = 303;

/// A one-sided request holds and never reads as linked; the mutual pair links; visibility follows the
/// link exactly -- the crux, made checkable.
fn welcome_mutual_only_links() !void {
    var c = Circle.open();
    try c.join(ivy);
    try c.join(wren);

    // Before anyone asks: refuse. Nobody is visible by default.
    assert(c.verdict(ivy, wren) == .refuse);
    assert(!c.visible(ivy, wren));

    // Ivy asks Wren. One-sided: it holds, and it is not a link -- no visibility yet, either way.
    try c.request_link(ivy, wren);
    assert(c.verdict(ivy, wren) == .hold);
    assert(!c.linked(ivy, wren));
    assert(!c.visible(ivy, wren));
    assert(!c.visible(wren, ivy)); // the offer is one-sided; Wren has not consented

    // Wren asks Ivy back. Now both have asked: the link places, and each sees the other.
    try c.request_link(wren, ivy);
    assert(c.verdict(ivy, wren) == .place);
    assert(c.linked(ivy, wren));
    assert(c.linked(wren, ivy)); // the link is symmetric — mutual consent has no direction
    assert(c.visible(ivy, wren));
    assert(c.visible(wren, ivy));
    print("skate_circle: a one-sided request held; only when both asked did the link place and each see the other.\n", .{});
}

/// A member is invisible to everyone they have not mutually linked -- presence is never default, even
/// among members of the same circle.
fn welcome_presence_never_default() !void {
    var c = Circle.open();
    try c.join(ivy);
    try c.join(wren);
    try c.join(flax);

    // Ivy and Wren link; Flax has joined but linked no one.
    try c.request_link(ivy, wren);
    try c.request_link(wren, ivy);

    // Flax sees no one and is seen by no one, though a full member of the circle.
    assert(!c.visible(flax, ivy));
    assert(!c.visible(ivy, flax));
    assert(!c.visible(flax, wren));
    assert(c.verdict(ivy, flax) == .refuse); // neither asked — the resting state holds
    print("skate_circle: a joined keeper who linked no one sees no one and is seen by no one — presence is never default.\n", .{});
}

/// A link touching a keeper who never joined refuses -- only members consent.
fn unwelcome_nonmember_refuses() !void {
    var c = Circle.open();
    try c.join(ivy);
    // Wren never joined.
    const from_member = c.request_link(ivy, wren);
    const to_member = c.request_link(wren, ivy);
    assert(from_member == error.NotMember);
    assert(to_member == error.NotMember);
    print("skate_circle: a link touching a keeper who never joined refused NotMember — only members consent.\n", .{});
}

/// A keeper cannot link with themselves, and cannot be linked with themselves by the verdict either.
fn unwelcome_self_link_refuses() !void {
    var c = Circle.open();
    try c.join(ivy);
    const self_req = c.request_link(ivy, ivy);
    assert(self_req == error.SelfLink);
    assert(c.verdict(ivy, ivy) == .refuse);
    print("skate_circle: a self-link refused SelfLink — a bond crosses between two keepers.\n", .{});
}

/// A seat is claimed once, and the same offer is recorded once -- consent is not doubled.
fn unwelcome_double_refuses() !void {
    var c = Circle.open();
    try c.join(ivy);
    try c.join(wren);
    const rejoin = c.join(ivy);
    assert(rejoin == error.AlreadyMember);
    try c.request_link(ivy, wren);
    const reoffer = c.request_link(ivy, wren);
    assert(reoffer == error.AlreadyRequested);
    print("skate_circle: a taken seat refused AlreadyMember and a repeated offer AlreadyRequested — consent is recorded once.\n", .{});
}

/// The circle is bounded -- a full seat roll refuses rather than drop a keeper.
fn unwelcome_full_circle_refuses() !void {
    var c = Circle.open();
    var n: u32 = 0;
    while (n < max_members) : (n += 1) {
        try c.join(1000 + n);
    }
    const overflow = c.join(9999);
    assert(overflow == error.CircleFull);
    print("skate_circle: a circle at its seat bound refused CircleFull rather than drop a keeper.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_mutual_only_links();
    try welcome_presence_never_default();
    try unwelcome_nonmember_refuses();
    try unwelcome_self_link_refuses();
    try unwelcome_double_refuses();
    try unwelcome_full_circle_refuses();
    print("skate_circle: version {s}\n", .{skate_circle_version});
    print("GREEN: DAHL-J9r1 skate_circle; a link exists only when both keepers ask, and a member is visible only when linked — presence is never default.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "skate-circle"))) {
        return run_selftest();
    }
    return run_selftest();
}
