//! pond/apps/constel_net_ledger_fixture_gen.rye — reproducibly emit the real constel-ledger fixture record.
//!
//! Rung four reads a genuine on-disk ledger record and cross-checks the harness's fold against an
//! independent measure. This generator produces that fixture reproducibly, so the on-disk bytes are
//! exactly what the ledger renders — a keeper can regenerate `tools/fixtures/constel_net_ledger.bron`
//! and get the identical record, never a hand-mocked shape. It opens a demo sovereign ledger (rung
//! one), issues 100, taxes 30, and reserves the star `vega` for 20 (rung two — supply folds to 50),
//! builds a portable ledger (rung three), and prints the `format constel-ledger-v1` record.
//!
//! Demo keeper seeds only — no real key, no funds, no network, no custody. The record names a fake
//! dev-net under a law-safe name; nothing it holds can reach the live network or move a dollar.
//!
//! The record prints on stderr (the tree's `std.debug.print` convention), so capture stderr:
//!
//!   rye build pond/apps/constel_net_ledger_fixture_gen.rye -femit-bin=pond/bin/constel-net-ledger-fixture-gen
//!   pond/bin/constel-net-ledger-fixture-gen 2> tools/fixtures/constel_net_ledger.bron

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const ledger = @import("constel_net_ledger.rye");
const stars = @import("constel_net_ledger_stars.rye");
const bron = @import("constel_net_ledger_bron.rye");
const kumara = @import("kumara.rye");

pub const constel_net_ledger_fixture_gen_version = "20260813.032037";

// The same demo ledger the rungs seat: one law-safe name, one genesis keeper seed.
const demo_key: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const demo_keeper: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const demo_galaxy: u32 = 3;
const demo_name = "xnqvel34";

fn emit_record() !u8 {
    var net_ledger = try ledger.open_ledger(demo_name, &demo_key, &demo_keeper, demo_galaxy);
    _ = try ledger.issue(&net_ledger, 100);
    _ = try ledger.tax(&net_ledger, 30);
    _ = try stars.reserve_star(&net_ledger, "vega", 20);
    const pl = try bron.from_ledger(&net_ledger);
    var buf: [bron.max_record]u8 = undefined;
    const n = try bron.render(&pl, &buf);
    // invariant: the render is bounded and non-empty — a real record always carries its header.
    assert(n > 0);
    assert(n <= bron.max_record);
    print("{s}", .{buf[0..n]});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return emit_record();
}
