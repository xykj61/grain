//! pond/apps/dexter_line.rye -- Dexter, the bounded line editor: the input half of the terminal.
//!
//! Season G (Open Media Primitives) -- the terminal family. scooter_view.rye draws a channel's journal
//! into a bounded 24x80 frame (the OUTPUT half a keeper reads); this module gives Dexter its INPUT half:
//! one editable line with a cursor, the primitive every prompt stands on. It is Dexter's own module, the
//! live-TTY rung the drawn frame named "later" -- yet held pure, so no escape codes, no raw terminal, and
//! no network enter here. A caller feeds it keystrokes; it holds a bounded, edited line and hands the text
//! back. The wire and the raw TTY are later rungs; the editable line is the floor beneath them.
//! Design kin: active-designing/20260817-041429_scooter-drawn-frame-crux.md (the output half).
//! Pattern elder: pond/apps/scooter_channel.rye -- the same bounded state machine, named errors, >=2 asserts.
//!
//! The crux is one edited line held strictly bounded:
//!   - Insert at the cursor. A printable ASCII byte enters at the cursor, shifting the tail right by one.
//!     A control byte is refused (NonPrintable), a full line is refused (LineFull) -- never a dropped byte.
//!   - Delete around the cursor. backspace removes the byte left of the cursor; delete_forward removes the
//!     byte under it; each shifts the tail left. Nothing to remove is refused by name, never a silent no-op.
//!   - Move within bounds. left/right/home/end walk the cursor over 0..len; a step past either edge is
//!     refused (CursorAtStart / CursorAtEnd). The cursor is always within the held line, by construction.
//!   - The line is referentially transparent -- the same keystrokes yield the same bytes every time.
//!
//! Facts only, custody-first: it edits a line of text and holds nothing else -- no network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build pond/apps/dexter_line.rye -femit-bin=pond/bin/dexter-line
//!   pond/bin/dexter-line selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const dexter_line_version = "20260817.042243";

/// A line holds at most this many bytes -- power of two, bounded so an input line never grows unbounded.
pub const max_line: u32 = 256;

/// The lowest and highest printable ASCII bytes -- a space through a tilde. Only these enter the line;
/// a control byte (tab, newline, escape, delete) never does, so a drawn line is always displayable.
pub const printable_low: u8 = 0x20; // ' '
pub const printable_high: u8 = 0x7e; // '~'

pub const LineError = error{
    LineFull, // the line is at its capacity -- refuse rather than drop a byte
    NonPrintable, // only printable ASCII enters the line -- a control byte is refused
    CursorAtStart, // nothing to the left to delete or move past -- refused by name, never a silent no-op
    CursorAtEnd, // nothing to the right to delete or move past -- refused by name, never a silent no-op
};

/// Is this byte a printable ASCII character -- a space through a tilde, the only bytes a line accepts?
pub fn is_printable(ch: u8) bool {
    // invariant: the printable band is a real ascending range within a byte.
    assert(printable_low <= printable_high);
    assert(printable_high <= 0x7f);
    return ch >= printable_low and ch <= printable_high;
}

/// A bounded editable line: the held bytes, how many are held, and where the cursor sits between them.
/// The cursor is an insertion point in 0..len (len is "past the last byte"); every operation keeps
/// cursor <= len <= max_line by construction, so the cursor can never point outside the held line.
pub const Line = struct {
    cells: [max_line]u8 = [_]u8{0} ** max_line,
    len: u32 = 0,
    cursor: u32 = 0,

    /// A fresh empty line: no bytes held, the cursor at the start.
    pub fn empty() Line {
        const l = Line{};
        // invariant: an empty line holds nothing and sits at the start.
        assert(l.len == 0);
        assert(l.cursor == 0);
        return l;
    }

    /// The held text -- exactly the bytes entered, never more than the buffer holds.
    pub fn text(self: *const Line) []const u8 {
        // invariant: the held length never claims more than the buffer holds.
        assert(self.len <= max_line);
        // invariant: the cursor is always within the held line.
        assert(self.cursor <= self.len);
        return self.cells[0..self.len];
    }

    /// The bytes left of the cursor -- what a prompt draws before the caret.
    pub fn before(self: *const Line) []const u8 {
        // invariant: the cursor is a real split point within the held line.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        return self.cells[0..self.cursor];
    }

    /// The bytes at and right of the cursor -- what a prompt draws after the caret.
    pub fn after(self: *const Line) []const u8 {
        // invariant: the cursor is a real split point within the held line.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        return self.cells[self.cursor..self.len];
    }

    /// Insert one printable byte at the cursor, shifting the tail right by one. A control byte is refused
    /// (NonPrintable); a full line is refused (LineFull) rather than dropping a byte.
    pub fn insert(self: *Line, ch: u8) LineError!void {
        // invariant: the cursor and length are within bounds before the edit.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        if (!is_printable(ch)) return error.NonPrintable;
        if (self.len >= max_line) return error.LineFull;
        // Shift the tail one cell right, from the last held byte down to the cursor, opening a gap.
        var i: u32 = self.len;
        while (i > self.cursor) : (i -= 1) {
            self.cells[i] = self.cells[i - 1];
        }
        self.cells[self.cursor] = ch;
        self.len += 1;
        self.cursor += 1;
        // invariant: the edit grew the line by exactly one and kept the cursor within it.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
    }

    /// Type a whole string, byte by byte, at the cursor. Refuses the first non-printable byte or overflow
    /// by name, leaving the bytes already inserted in place (a bounded, honest partial).
    pub fn type_str(self: *Line, s: []const u8) LineError!void {
        // invariant: a typed string never exceeds the line bound.
        assert(s.len <= max_line);
        assert(self.len <= max_line);
        var i: u32 = 0;
        while (i < s.len) : (i += 1) {
            try self.insert(s[i]);
        }
    }

    /// Delete the byte left of the cursor, shifting the tail left. Nothing to the left is refused
    /// (CursorAtStart) rather than a silent no-op.
    pub fn backspace(self: *Line) LineError!void {
        // invariant: the cursor and length are within bounds before the edit.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        if (self.cursor == 0) return error.CursorAtStart;
        // Shift the tail one cell left, closing the gap the removed byte leaves.
        var i: u32 = self.cursor - 1;
        while (i + 1 < self.len) : (i += 1) {
            self.cells[i] = self.cells[i + 1];
        }
        self.len -= 1;
        self.cursor -= 1;
        // invariant: the edit shrank the line by exactly one and kept the cursor within it.
        assert(self.cursor <= self.len);
        assert(self.len < max_line);
    }

    /// Delete the byte at the cursor, shifting the tail left. Nothing under the cursor is refused
    /// (CursorAtEnd) rather than a silent no-op.
    pub fn delete_forward(self: *Line) LineError!void {
        // invariant: the cursor and length are within bounds before the edit.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        if (self.cursor >= self.len) return error.CursorAtEnd;
        var i: u32 = self.cursor;
        while (i + 1 < self.len) : (i += 1) {
            self.cells[i] = self.cells[i + 1];
        }
        self.len -= 1;
        // invariant: the edit shrank the line by exactly one; the cursor still lies within it.
        assert(self.cursor <= self.len);
        assert(self.len < max_line);
    }

    /// Step the cursor one byte left. A step past the start is refused (CursorAtStart).
    pub fn move_left(self: *Line) LineError!void {
        // invariant: the cursor is within the held line before the move.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        if (self.cursor == 0) return error.CursorAtStart;
        self.cursor -= 1;
        // invariant: the cursor stayed within the held line.
        assert(self.cursor < self.len or self.len == 0);
        return;
    }

    /// Step the cursor one byte right. A step past the end is refused (CursorAtEnd).
    pub fn move_right(self: *Line) LineError!void {
        // invariant: the cursor is within the held line before the move.
        assert(self.cursor <= self.len);
        assert(self.len <= max_line);
        if (self.cursor >= self.len) return error.CursorAtEnd;
        self.cursor += 1;
        // invariant: the cursor stayed within the held line.
        assert(self.cursor <= self.len);
        return;
    }

    /// Jump the cursor to the start of the line.
    pub fn move_home(self: *Line) void {
        // invariant: the line is within bounds before the jump.
        assert(self.len <= max_line);
        assert(self.cursor <= self.len);
        self.cursor = 0;
        // invariant: the cursor sits at the start.
        assert(self.cursor == 0);
    }

    /// Jump the cursor to the end of the line, just past the last held byte.
    pub fn move_end(self: *Line) void {
        // invariant: the line is within bounds before the jump.
        assert(self.len <= max_line);
        assert(self.cursor <= self.len);
        self.cursor = self.len;
        // invariant: the cursor sits at the end.
        assert(self.cursor == self.len);
    }

    /// Empty the line and return the cursor to the start -- what a prompt does after a committed entry.
    pub fn clear(self: *Line) void {
        // invariant: the line is within bounds before the reset.
        assert(self.len <= max_line);
        assert(self.cursor <= self.len);
        self.len = 0;
        self.cursor = 0;
        // invariant: the line is empty and at the start.
        assert(self.len == 0);
        assert(self.cursor == 0);
    }
};

fn insert_builds_at_cursor() !void {
    var l = Line.empty();
    try l.type_str("hello");
    // The typed bytes read back in order, the cursor resting past the last.
    assert(std.mem.eql(u8, l.text(), "hello"));
    assert(l.cursor == 5);
    // Insert at the start: home, then a byte, shifts the tail right.
    l.move_home();
    try l.insert('X');
    assert(std.mem.eql(u8, l.text(), "Xhello"));
    assert(l.cursor == 1);
    // before/after split the line at the cursor.
    assert(std.mem.eql(u8, l.before(), "X"));
    assert(std.mem.eql(u8, l.after(), "hello"));
    print("dexter_line: a printable byte enters at the cursor, shifting the tail right.\n", .{});
}

fn delete_around_the_cursor() !void {
    var l = Line.empty();
    try l.type_str("hello");
    // Backspace removes the byte left of the cursor (at the end, the last byte).
    try l.backspace();
    assert(std.mem.eql(u8, l.text(), "hell"));
    assert(l.cursor == 4);
    // Home, then delete_forward removes the byte under the cursor.
    l.move_home();
    try l.delete_forward();
    assert(std.mem.eql(u8, l.text(), "ell"));
    assert(l.cursor == 0);
    print("dexter_line: backspace and delete each remove one byte around the cursor, shifting the tail left.\n", .{});
}

fn cursor_motion_is_bounded() !void {
    var l = Line.empty();
    try l.type_str("hi");
    // At the end, a right step is refused by name; home then a left step is refused by name.
    assert(l.cursor == 2);
    const past_end = l.move_right();
    assert(past_end == error.CursorAtEnd);
    l.move_home();
    assert(l.cursor == 0);
    const past_start = l.move_left();
    assert(past_start == error.CursorAtStart);
    // Interior motion walks the cursor without touching the bytes.
    try l.move_right();
    assert(l.cursor == 1);
    assert(std.mem.eql(u8, l.text(), "hi"));
    l.move_end();
    assert(l.cursor == 2);
    print("dexter_line: the cursor walks over 0..len; a step past either edge is refused by name.\n", .{});
}

fn capacity_is_bounded() !void {
    var l = Line.empty();
    // Fill the line to its bound, then a further insert is refused rather than dropping a byte.
    var i: u32 = 0;
    while (i < max_line) : (i += 1) try l.insert('a');
    assert(l.len == max_line);
    const overflow = l.insert('a');
    assert(overflow == error.LineFull);
    // The held line is unchanged by the refused insert.
    assert(l.len == max_line);
    print("dexter_line: a full line refuses a further byte (LineFull) rather than dropping one.\n", .{});
}

fn only_printable_enters() !void {
    var l = Line.empty();
    // A tab, a newline, and a delete are all control bytes -- each refused, no byte landing.
    const tab = l.insert(0x09);
    assert(tab == error.NonPrintable);
    const newline = l.insert(0x0a);
    assert(newline == error.NonPrintable);
    const del = l.insert(0x7f);
    assert(del == error.NonPrintable);
    assert(l.len == 0);
    // A space and a tilde are the band edges -- both accepted.
    try l.insert(0x20);
    try l.insert(0x7e);
    assert(std.mem.eql(u8, l.text(), " ~"));
    print("dexter_line: only printable ASCII enters; a control byte is refused, no byte landing.\n", .{});
}

fn clear_empties_the_line() !void {
    var l = Line.empty();
    try l.type_str("draft");
    l.move_home();
    // Clear empties the line and returns the cursor to the start -- a committed entry, wiped for the next.
    l.clear();
    assert(l.len == 0);
    assert(l.cursor == 0);
    assert(std.mem.eql(u8, l.text(), ""));
    // The same keystrokes rebuild the same bytes -- referential transparency.
    try l.type_str("draft");
    assert(std.mem.eql(u8, l.text(), "draft"));
    print("dexter_line: clear empties the line to the start, and the same keystrokes rebuild the same bytes.\n", .{});
}

fn run_selftest() !u8 {
    try insert_builds_at_cursor();
    try delete_around_the_cursor();
    try cursor_motion_is_bounded();
    try capacity_is_bounded();
    try only_printable_enters();
    try clear_empties_the_line();
    print("dexter_line: version {s}\n", .{dexter_line_version});
    print("GREEN: dexter_line; a bounded editable line of at most {d} bytes -- insert, delete, and cursor motion all held within 0..len, only printable ASCII, deterministic every time.\n", .{max_line});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and (std.mem.eql(u8, args[1], "selftest") or std.mem.eql(u8, args[1], "dexter-line"))) {
        return run_selftest();
    }
    return run_selftest();
}
