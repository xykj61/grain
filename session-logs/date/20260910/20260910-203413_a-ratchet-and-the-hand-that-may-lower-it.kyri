loom roster=standing_equipment_cold guards=247 green=242 red=2 gated=3 seconds=3709
loom roster=standing_equipment_hot guards=248 green=243 red=1 gated=3 tree_moved=no
loom roster=standing_equipment_hot_rerun guards=248 green=244 red=1 gated=3 tree_moved=no
loom scan=instrument_refusal scans_read=971 swallowed_before=1 swallowed_after=0
