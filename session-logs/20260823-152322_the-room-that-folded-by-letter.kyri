loom sweep=random_witness_draw rooms=29 sampled=86 red=12 genuine=2 device_gated=5 unbuilt=3 not_reds=2
file tools/fixtures/tool_path_repoint_scan.sh the repointer -- tracked files only, one instrument name, one living dated room, one cut behind a dollar sign
