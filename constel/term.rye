//! constel/term.rye -- FORA16: leadership made safe across re-election. Every rung from FORA10 on assumes ONE STABLE LEADER --
//! FORA10 elects a leader once, FORA11 lets that leader commit values, FORA12 orders them into a log. Yet a real network
//! re-elects: a leader crashes, a partition heals, a new leader rises. The single hardest safety question a consensus protocol
//! answers is what happens to the OLD leader -- the one elected, then superseded, yet still believing it leads and trying to
//! commit. Without a defense it could commit a value the sky has already moved past, forking the ledger in TIME. This rung takes
//! that one concern: a TERM -- a monotonic logical clock on leadership -- so that AN OLD LEADER CAN NEVER COMMIT.
//!
//! A term is a u32 that only ever climbs. Every pier tracks the highest term it has seen (ground term 0 before any leader). A
//! leader is elected FOR a term, and a decree carries ITS term. The rule is one line, and it is the whole safety:
//!   * a voter whose current term is GREATER than a decree's term refuses StaleTerm -- it moved to a newer leader, so it will not
//!     lend its vote to an older one;
//!   * a voter whose current term is at or below the decree's term adopts that term (monotonically) and accepts as in FORA11.
//! The safety follows from FORA9's intersection lemma: once a STRICT MAJORITY has advanced to term T (exactly what electing a
//! leader in T does), any decree in a term < T gathers accepts from at most the minority that has not advanced -- below the
//! threshold -- so it can never commit. The old leader is not forbidden by fiat; it is OUT-VOTED by construction.
//!
//! Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium -- the tree's own consensus) - waymark FORA - rung
//! FORA16. Design read: active-designing/date/20260814/20260814-083300_fora16-constel-terms-stale-leader.md
//! Stands on: constel/decree.rye (FORA11) -- the Decree a term guards; constel/quorum.rye (FORA9) -- majority_of, the intersection
//! lemma the safety spends; constel/census.rye (FORA8) -- announce/respond/hear collect accepts at the border; constel/
//! switchboard.rye (FORA6) -- the medium; constel/roster.rye (FORA1) -- the bound.
//!
//! Purely LOCAL -- a bounded term table and a decree guarded by it, over the switchboard on one bench, siloed to constel/, run
//! from inside the jailed pier. No socket, no network, no keys, no funds, no real address ever formed (custody gate %2 -- real
//! hardware / any real wire -- and gate %4 -- real Kumara -- both untouched).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run constel/term.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const name = @import("name.rye");
const wire = @import("wire.rye");
const roster = @import("roster.rye");
const switchboard = @import("switchboard.rye");
const census = @import("census.rye");
const quorum = @import("quorum.rye");
const decree = @import("decree.rye");

pub const term_version = "20260814.083300";

/// The term before any leader has been elected -- the ground state every pier starts in. A term only ever climbs from here.
pub const ground_term: u32 = 0;

pub const TermError = error{
    /// A voter whose current term is already greater than a decree's term refuses to lend its vote -- it has moved to a newer
    /// leader. This one refusal is the whole safety of the rung: it starves a stale leader of the majority it would need.
    StaleTerm,
} || decree.DecreeError;

/// Each roster slot's highest-seen term -- a bounded [max_piers]u32, exactly like the roster it indexes. A term is monotonic per
/// slot: observe advances it, and nothing ever lowers it.
pub const TermTable = struct {
    term: [roster.max_piers]u32 = [_]u32{ground_term} ** roster.max_piers,
    size: u32 = 0,

    /// The term a slot currently holds. A fresh table reads ground_term everywhere.
    pub fn current(self: *const TermTable, slot: u32) u32 {
        // invariant: only a real slot of a bounded constellation is ever read.
        assert(slot < self.size);
        assert(self.size <= roster.max_piers);
        return self.term[slot];
    }

    /// Advance a slot's term to max(current, t) and report whether it moved. Monotonic by construction -- a term never travels
    /// backward, which is exactly why a pier that has seen a newer leader can never be talked back into an older one.
    pub fn observe(self: *TermTable, slot: u32, t: u32) bool {
        // invariant: only a real slot is ever advanced.
        assert(slot < self.size);
        const before = self.term[slot];
        if (t > before) self.term[slot] = t;
        // invariant: the term never decreased -- the post-state is at least the pre-state.
        assert(self.term[slot] >= before);
        return self.term[slot] > before;
    }

    /// How many slots stand at term t or higher -- the countable form of the majority argument. Once this reaches a strict
    /// majority for term T, no decree below T can ever commit.
    pub fn at_least(self: *const TermTable, t: u32) u32 {
        var n: u32 = 0;
        var i: u32 = 0;
        while (i < self.size) : (i += 1) {
            if (self.term[i] >= t) n += 1;
        }
        // invariant: the count never exceeds the constellation it is drawn from.
        assert(n <= self.size);
        return n;
    }
};

/// An FORA11 decree plus the term it belongs to. Accepting consults the voter's term: a voter that has moved on refuses
/// StaleTerm; a voter at or below adopts the term (monotonically) and accepts. Commit is FORA11's, over the up-to-date accepts.
pub const TermedDecree = struct {
    inner: decree.Decree = .{},
    term: u32 = ground_term,

    /// A fresh termed decree over a proposed value in a given term, for a bounded constellation.
    pub fn init(term: u32, value: u32, size: u32) TermedDecree {
        // invariant: a decree runs over a real, bounded constellation.
        assert(size >= 1 and size <= roster.max_piers);
        return .{ .inner = decree.Decree{ .value = value, .size = size }, .term = term };
    }

    /// Record one termed accept. A voter whose current term is greater than this decree's term refuses StaleTerm -- its vote is
    /// not lent to an older leader. Otherwise the voter adopts this term (monotonic) and the accept records through the inner
    /// decree, inheriting DoubleAccept (a second cast) and WrongValue (an off-value accept) unchanged.
    pub fn accept(self: *TermedDecree, terms: *TermTable, voter: u32, value: u32) TermError!void {
        // invariant: only a real member of the constellation ever accepts.
        assert(voter < self.inner.size);
        if (terms.current(voter) > self.term) return error.StaleTerm; // the voter has moved to a newer leader
        _ = terms.observe(voter, self.term); // the voter adopts this decree's term — never backward
        try self.inner.accept(voter, value);
        // invariant: an accepted voter now stands at least at this decree's term.
        assert(terms.current(voter) >= self.term);
    }

    /// How many up-to-date piers accepted the proposed value.
    pub fn support(self: *const TermedDecree) u32 {
        return self.inner.support();
    }

    /// Commit the proposed value when a strict majority of up-to-date piers accepted it, else refuse NoDecree. This is FORA11's
    /// seal unchanged -- the term guard has already filtered stale voters out of the count, so a majority here is a majority of
    /// piers that agree this decree's term is current.
    pub fn commit(self: *const TermedDecree) TermError!u32 {
        return self.inner.commit();
    }
};

/// The whole round over the switchboard, term-guarded: announce, then every other member responds+hears at the naming-law
/// border and attempts a termed accept -- a member that has moved on refuses StaleTerm and is simply NOT gathered (the round
/// continues, it does not fault), while a real fault (NoSuchPier, VowelPresent at the border) still surfaces. Commit reflects
/// only the up-to-date majority, so a stale leader whose sky has advanced can never reach the threshold.
pub fn run_termed_decree(sb: *switchboard.Switchboard, terms: *TermTable, leader: []const u8, term: u32, value: u32) TermError!u32 {
    const leader_slot = try sb.member(leader); // a stranger cannot open a decree
    const n = sb.size();
    // invariant: the leader is a real member of a bounded constellation the term table also indexes.
    assert(leader_slot < n and n <= roster.max_piers);
    assert(terms.size == n);

    var ping = wire.Frame{};
    const reached = try census.announce(sb, leader, &ping);
    // invariant: the announce reached exactly every other member.
    assert(reached == n - 1);

    var d = TermedDecree.init(term, value, n);
    _ = terms.observe(leader_slot, term); // the leader stands at its own term
    try d.accept(terms, leader_slot, value); // present by definition, and at its own term so never stale

    var i: u32 = 0;
    while (i < n) : (i += 1) {
        if (i == leader_slot) continue;
        const who = try sb.roster.member(i);
        var wb: [name.max_ship_len]u8 = undefined;
        const wn = copy_name(&wb, who);
        try census.respond(sb, wn, leader); // the member replies its present token
        const slot = try census.hear(sb, leader); // the leader reads exactly that reply at the border
        // invariant: a heard accept comes from a member whose reachability the medium just proved.
        assert(slot < n);
        d.accept(terms, slot, value) catch |e| switch (e) {
            error.StaleTerm => continue, // the member has moved on — its vote is not gathered, the round carries on
            else => return e, // a real fault still surfaces
        };
    }
    return d.commit();
}

// --- selftest: the term table is monotonic; a ground decree commits; a moved-on voter refuses StaleTerm; AN OLD LEADER CAN'T
//     COMMIT proven at the value level and again over a real sky; a full constellation of eight runs bounded. -----------------

fn run_selftest() !u8 {
    // 1. The term table is MONOTONIC -- observe advances up and never down; a lower observe is a no-op; current reads back.
    {
        var t = TermTable{ .size = 4 };
        assert(t.current(0) == ground_term);
        assert(t.observe(0, 3)); // moved 0 -> 3
        assert(t.current(0) == 3);
        assert(!t.observe(0, 2)); // a lower observe never lowers the term
        assert(t.current(0) == 3);
        assert(!t.observe(0, 3)); // equal is a no-op
        assert(t.at_least(3) == 1 and t.at_least(1) == 1 and t.at_least(4) == 0);
    }

    // 2. A GROUND COMMIT -- a fresh termed decree in term 1 with every pier at ground commits, and every accepting pier adopts
    //    term 1.
    {
        var terms = TermTable{ .size = 4 };
        var d = TermedDecree.init(1, 7, 4);
        try d.accept(&terms, 0, 7);
        try d.accept(&terms, 1, 7);
        try d.accept(&terms, 2, 7);
        assert(d.support() == 3);
        assert((try d.commit()) == 7);
        assert(terms.at_least(1) == 3); // the three that accepted adopted term 1
    }

    // 3. STALE TERM -- a voter already at a higher term refuses a lower-term accept, and its vote is not recorded.
    {
        var terms = TermTable{ .size = 4 };
        _ = terms.observe(1, 5); // slot 1 has seen term 5
        var d = TermedDecree.init(2, 7, 4); // a decree in the older term 2
        try d.accept(&terms, 0, 7);
        if (d.accept(&terms, 1, 7)) |_| return error.StaleAccepted else |e| if (e != error.StaleTerm) return error.WrongStale;
        assert(d.support() == 1); // slot 1's vote never counted
        assert(terms.current(1) == 5); // and its term was not lowered
    }

    // 4. AN OLD LEADER CAN'T COMMIT -- the crux, at the value level. A term-1 decree commits over a sky of four; a majority then
    //    advances to term 2 (a new election); the old term-1 leader now gathers only its own vote (the others refuse StaleTerm)
    //    and refuses NoDecree, while the new term-2 leader commits.
    {
        var terms = TermTable{ .size = 4 };
        var first = TermedDecree.init(1, 100, 4);
        try first.accept(&terms, 0, 100);
        try first.accept(&terms, 1, 100);
        try first.accept(&terms, 2, 100);
        try first.accept(&terms, 3, 100);
        assert((try first.commit()) == 100); // term 1 commits, whole sky now at term 1

        // A new election: a strict majority advances to term 2. (Slots 1, 2, 3 have seen the new leader.)
        _ = terms.observe(1, 2);
        _ = terms.observe(2, 2);
        _ = terms.observe(3, 2);
        assert(terms.at_least(2) == 3); // a majority has moved on

        // The OLD leader (slot 0, still at term 1) tries to commit in term 1. The advanced majority refuses; it is out-voted.
        var stale = TermedDecree.init(1, 200, 4);
        try stale.accept(&terms, 0, 200); // the old leader's own vote
        var s: u32 = 1;
        while (s < 4) : (s += 1) {
            if (stale.accept(&terms, s, 200)) |_| return error.StaleMajorityVoted else |e| if (e != error.StaleTerm) return error.WrongStaleMajority;
        }
        assert(stale.support() == 1); // only the old leader itself
        if (stale.commit()) |_| return error.OldLeaderCommitted else |e| if (e != error.NoDecree) return error.WrongOldLeader;

        // The NEW leader (slot 1, at term 2) commits in term 2 -- the advanced majority accepts.
        var fresh = TermedDecree.init(2, 300, 4);
        try fresh.accept(&terms, 1, 300);
        try fresh.accept(&terms, 2, 300);
        try fresh.accept(&terms, 3, 300);
        assert((try fresh.commit()) == 300);
    }

    // 5. AN OLD LEADER CAN'T COMMIT -- the same story over a REAL sky, driven through announce, respond, and hear (each accept
    //    proven present at the border). A term-1 round commits; a majority advances to term 2; the old term-1 run refuses
    //    NoDecree while a term-2 run commits.
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(4);
        var terms = TermTable{ .size = 4 };
        const l0 = try name_of(&sb, 0);
        var l0b: [name.max_ship_len]u8 = undefined;
        const l0n = copy_name(&l0b, l0);

        assert((try run_termed_decree(&sb, &terms, l0n, 1, 11)) == 11); // term 1 commits over the wire
        assert(terms.at_least(1) == 4); // every member adopted term 1

        // A new election moves a strict majority to term 2 (slots 1..3 saw the new leader).
        _ = terms.observe(1, 2);
        _ = terms.observe(2, 2);
        _ = terms.observe(3, 2);

        // The old leader (slot 0, term 1) runs a term-1 decree -- the advanced majority refuses StaleTerm, so it cannot commit.
        if (run_termed_decree(&sb, &terms, l0n, 1, 22)) |_| return error.OldWireLeaderCommitted else |e| if (e != error.NoDecree) return error.WrongOldWire;

        // The new leader (slot 1, term 2) runs a term-2 decree -- the advanced majority accepts, so it commits.
        const l1 = try name_of(&sb, 1);
        var l1b: [name.max_ship_len]u8 = undefined;
        const l1n = copy_name(&l1b, l1);
        assert((try run_termed_decree(&sb, &terms, l1n, 2, 33)) == 33);
    }

    // 6. A full constellation of eight runs a termed decree bounded -- the round interleaves respond and hear, so no ChannelFull.
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(roster.max_piers);
        var terms = TermTable{ .size = roster.max_piers };
        const leader = try name_of(&sb, 0);
        var lb: [name.max_ship_len]u8 = undefined;
        const ln = copy_name(&lb, leader);
        assert((try run_termed_decree(&sb, &terms, ln, 1, 5)) == 5);
        assert(terms.at_least(1) == roster.max_piers);
    }

    print("GREEN fora-term: leadership made safe across re-election — the term table is monotonic (observe advances a term and " ++
        "never lowers it, so a pier that saw a newer leader can never be talked back); a ground decree in term 1 commits and " ++
        "every accepting pier adopts the term; a voter already at a higher term refuses StaleTerm and its vote is not counted; " ++
        "AN OLD LEADER CAN'T COMMIT — proven at the value level and again over a real sky: a term-1 decree commits, a strict " ++
        "majority then advances to term 2, and the old term-1 leader gathers only its own vote (the others refuse StaleTerm) " ++
        "and refuses NoDecree while the new term-2 leader commits — the old leader out-voted by construction, not forbidden by " ++
        "fiat, the same intersection lemma that made the leader unique now making leadership safe across time; and a full " ++
        "constellation of eight runs bounded — no socket, no network, no keys, no funds, no real address ever formed\n", .{});
    return 0;
}

/// The name at a roster slot -- a thin selftest helper so a scenario names its piers off the roster rather than the alphabet.
fn name_of(sb: *switchboard.Switchboard, slot: u32) switchboard.SwitchboardError![]const u8 {
    // invariant: only a slot within the current constellation is ever named.
    assert(slot < sb.size());
    return sb.roster.member(slot);
}

/// Copy a pier name out of the roster's buffer into a caller-owned buffer, returning the plain slice -- respond/hear mutate
/// mailboxes but never the roster, so this is belt-and-braces clarity rather than a correctness need.
fn copy_name(dst: []u8, src: []const u8) []const u8 {
    // invariant: a pier name always fits the ship bound, so the copy never overruns.
    assert(src.len <= name.max_ship_len);
    assert(dst.len >= src.len);
    var i: u32 = 0;
    while (i < src.len) : (i += 1) dst[i] = src[i];
    return dst[0..src.len];
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
