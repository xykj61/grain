//! constel/admit.rye — FORA26: the whole add-a-member lifecycle, closed. A non-voting learner (FORA25) is promoted into the voting
//! set only once it is caught up, and the promotion is carried by reconfig's joint consensus (FORA13) — so the "safe way to add a
//! member" is proven end to end: catch up out of the critical path, then switch the membership without a fork.
//!
//! The gap it closes:
//!   FORA25 gave a learner and a `may_promote` predicate, yet nothing consumed it — the learner could catch up, but no rung actually
//!   admitted it to the vote. FORA13 gave a joint-consensus membership switch, yet it would admit ANY new slot, empty log and all —
//!   the very stall FORA25 warned against. This rung joins the two: `admit` refuses to even PROPOSE a promotion until the learner is
//!   caught up (learner.require_caught_up), and only then builds the joint config old → old∪{learner} that reconfig's ballot commits
//!   with a strict majority in BOTH configs. So a member is added exactly the safe way: never as an empty voter, never without the
//!   no-fork joint switch.
//!
//! This composes FORA25 (learner — the catch-up gate) with FORA13 (reconfig — the no-fork joint switch), over their public APIs
//! only. No new transport, no new quorum math: the promotion is a reconfig transition whose new config is the old plus one caught-up
//! learner, and the joint ballot's own two-majority rule carries the FORA9 intersection lemma across the switch unchanged.
//!
//! Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark FORA · rung
//! FORA26. Design read: active-designing/20260814-074656_fora26-constel-admit-learner-promotion.md
//! Stands on: constel/learner.rye (FORA25) — require_caught_up, the bounded-lag gate; constel/reconfig.rye (FORA13) — config_of,
//! JointConfig, JointBallot, require_joint, the no-fork joint switch; constel/roster.rye (FORA1) — max_piers, the membership bound.
//!
//! Purely LOCAL — bounded membership masks and index scalars on one bench, siloed to constel/, run from inside the jailed pier. No
//! socket, no network, no keys, no funds, no real address ever formed (custody gate #2 — real hardware / any real wire — and gate
//! #4 — real Kumara — both untouched).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run constel/admit.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const roster = @import("roster.rye");
const learner = @import("learner.rye");
const reconfig = @import("reconfig.rye");

pub const admit_version = "20260814.074656";

pub const AdmitError = error{
    /// The slot proposed for promotion is already a voter in the old config — a learner, not a voter, is what gets admitted.
    AlreadyVoter,
};

/// The whole set of ways a promotion can be refused: the learner may already vote (AlreadyVoter), may not yet be caught up
/// (learner.NotCaughtUp), or the resulting configs may be malformed (reconfig.EmptyConfig, etc.).
pub const PromoteError = AdmitError || learner.LearnerError || reconfig.ReconfigError;

/// ADMIT A CAUGHT-UP LEARNER TO THE VOTE. Given the old voting mask and a learner's slot + catch-up state, refuse unless the learner
/// is genuinely a non-voter (AlreadyVoter) AND caught up (NotCaughtUp), then build the joint config old → old∪{learner} that a
/// reconfig ballot commits. Nothing is proposed until both gates pass — an empty replica can never begin a promotion it would stall.
pub fn admit(
    old_mask: [roster.max_piers]bool,
    learner_slot: u32,
    learner_match: u32,
    leader_commit: u32,
    lag_bound: u32,
) PromoteError!reconfig.JointConfig {
    // invariant: the promoted slot is a real roster slot.
    assert(learner_slot < roster.max_piers);
    // invariant: a learner never runs ahead of the commit it trails.
    assert(learner_match <= leader_commit);
    if (old_mask[learner_slot]) return error.AlreadyVoter; // a voter is not a learner — nothing to admit
    try learner.require_caught_up(learner_match, leader_commit, lag_bound); // NotCaughtUp until within the bounded lag
    var new_mask = old_mask;
    new_mask[learner_slot] = true; // the new config is the old plus this one caught-up learner
    const old = try reconfig.config_of(old_mask);
    const new = try reconfig.config_of(new_mask);
    // invariant: promotion grows the voting set by exactly one — the caught-up learner, no other change.
    assert(new.size == old.size + 1);
    return reconfig.JointConfig{ .old = old, .new = new };
}

/// Build a membership mask from a list of voter slots — a small pure helper for callers and the selftest.
pub fn mask_of(slots: []const u32) [roster.max_piers]bool {
    // invariant: the slot list is bounded by the roster it indexes.
    assert(slots.len <= roster.max_piers);
    var mask = [_]bool{false} ** roster.max_piers;
    var i: u32 = 0;
    while (i < slots.len) : (i += 1) {
        assert(slots[i] < roster.max_piers); // invariant: every listed slot is a real roster slot
        mask[slots[i]] = true;
    }
    return mask;
}

// --- selftest: a learner not caught up is refused promotion; an already-voter is refused; a CAUGHT-UP learner is admitted into a
//     joint config old → old∪{learner} that commits only with a strict majority in BOTH configs; the promoted member then counts
//     toward the new majority; an old-only or new-only quorum cannot smuggle the switch; bounded. -----------------------------------

fn run_selftest() !u8 {
    // 1. A LEARNER NOT CAUGHT UP IS REFUSED PROMOTION — no joint config is ever built, so the voter set cannot change. Three voters
    //    {0,1,2}, a learner at slot 3 with an empty log while the leader has committed to 12, lag bound 3.
    {
        const old = mask_of(&[_]u32{ 0, 1, 2 });
        const r = admit(old, 3, 0, 12, 3);
        if (r) |_| unreachable else |e| assert(e == error.NotCaughtUp); // an empty replica may not be promoted
    }

    // 2. AN ALREADY-VOTER IS REFUSED — slot 1 is already in the old config, so there is no learner there to admit.
    {
        const old = mask_of(&[_]u32{ 0, 1, 2 });
        const r = admit(old, 1, 12, 12, 3);
        if (r) |_| unreachable else |e| assert(e == error.AlreadyVoter);
    }

    // 3. THE CRUX — A CAUGHT-UP LEARNER IS ADMITTED, AND THE SWITCH COMMITS ONLY WITH A STRICT MAJORITY IN BOTH CONFIGS. The learner
    //    at slot 3 reaches match 10 (lag 2 ≤ 3): caught up. `admit` yields the joint config old {0,1,2} → new {0,1,2,3}. A joint
    //    ballot where the whole union votes yes carries a strict majority in both (3 of 3 old, 4 of 4 new) — the promotion commits.
    {
        const old = mask_of(&[_]u32{ 0, 1, 2 });
        const joint = try admit(old, 3, 10, 12, 3);
        assert(joint.old.size == 3 and joint.new.size == 4);
        assert(joint.new.contains(3) and !joint.old.contains(3)); // slot 3 joins the NEW config only
        var b = reconfig.JointBallot{ .joint = joint };
        try b.cast(0);
        try b.cast(1);
        try b.cast(2);
        try b.cast(3); // the freshly-promoted member votes too — it is a participant in the union
        b.seal();
        try reconfig.require_joint(&b); // committed — a strict majority in both old and new
        assert(b.yes_old == 3 and b.yes_new == 4);
    }

    // 4. THE PROMOTED MEMBER NOW COUNTS TOWARD THE NEW MAJORITY. After the switch the voting set is four; its majority is three, and
    //    a commit backed by any three of the four voters (the new member among them) reaches it — the member's voice now weighs.
    {
        const new_roles = [_]bool{ true, true, true, true }; // four voters after promotion
        assert(learner.voter_majority(&new_roles) == 3);
        const with_promoted = [_]bool{ true, false, true, true }; // leader + slot 2 + the promoted slot 3 ack
        assert(learner.commit_backing(&new_roles, &with_promoted) == 3);
        assert(learner.committed(&new_roles, &with_promoted)); // the promoted member's ack helped commit
    }

    // 5. THE OLD CONFIG'S MAJORITY ALONE CANNOT SMUGGLE THE SWITCH — the joint rule needs a strict majority in BOTH configs, so the
    //    promoted member's own config must also agree. A ballot of just the two old voters {0,1} carries an old majority (2 of 3) yet
    //    only 2 of the 4 new members — NOT a new majority (which needs 3) — so require_joint refuses NoJointMajority: the pre-promotion
    //    set cannot force a new member in over the new config's own head.
    {
        const old = mask_of(&[_]u32{ 0, 1, 2 });
        const joint = try admit(old, 3, 12, 12, 3); // exactly caught up
        var b = reconfig.JointBallot{ .joint = joint };
        try b.cast(0);
        try b.cast(1); // 2 of 3 old (a majority), 2 of 4 new (NOT a majority)
        b.seal();
        const guard = reconfig.require_joint(&b);
        if (guard) |_| unreachable else |e| assert(e == error.NoJointMajority);
        assert(b.yes_old == 2 and b.yes_new == 2 and !b.reached);
    }

    // 6. BOUNDED — a full roster: seven voters {0..6} and a caught-up learner at the last slot promoted to an eighth voter, the joint
    //    config sizing exactly seven → eight within the pier cap.
    {
        const seven = mask_of(&[_]u32{ 0, 1, 2, 3, 4, 5, 6 });
        const joint = try admit(seven, roster.max_piers - 1, 20, 20, 0); // exactly current, zero slack
        assert(joint.old.size == roster.max_piers - 1 and joint.new.size == roster.max_piers);
        assert(joint.new.contains(roster.max_piers - 1));
    }

    print("GREEN fora-admit: the whole add-a-member lifecycle, closed (FORA25 learner + FORA13 reconfig) — `admit` refuses to " ++
        "propose a promotion until the learner is CAUGHT UP (NotCaughtUp) and is genuinely a non-voter (AlreadyVoter), then builds " ++
        "the joint config old → old∪{{learner}} that reconfig's ballot commits only with a strict majority in BOTH configs; THE " ++
        "CRUX: a caught-up learner is admitted (old size 3 → new size 4) and the switch commits when the whole union votes, while " ++
        "an old-only quorum is refused NoJointMajority so no stale set can smuggle the promotion; the promoted member then counts " ++
        "toward the new majority; bounded over a full roster seven → eight — a member added exactly the safe way, never an empty " ++
        "voter and never without the no-fork joint switch, no socket, no network, no keys, no funds, no real address ever formed\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
