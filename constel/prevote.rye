//! constel/prevote.rye — FORA22: a partitioned pier cannot disrupt a stable sky (Raft §9.6, pre-vote). FORA16 made a monotonic
//! term the guard against a stale leader — a leader whose term the sky has passed can never commit. That guard has a liveness
//! cost:
//!
//!   A pier partitioned away keeps hitting its election timeout, and each timeout INCREMENTS its term — so its term balloons in
//!   isolation. When the partition heals and it rejoins, its very high term forces the CURRENT, HEALTHY leader to step down (a
//!   higher term always wins), triggering a needless election. The sky was stable; one disconnected node disrupts it, and it can
//!   repeat every time that node's term climbs again.
//!
//! Pre-vote is Raft's answer: a candidate must win a PRACTICE election before it is allowed to bump its real term. In a pre-vote
//! round NO node changes its term; each peer answers "would I vote for you next term?" and pre-grants only when BOTH hold — it has
//! NOT heard from a current leader recently (its own timeout elapsed), AND the candidate's log is at least as up-to-date (FORA21's
//! at_least_as_current, reused). Only if a MAJORITY pre-grant does the candidate increment its real term. So a partitioned node,
//! however high its private term, can never force the sky to move until a majority already agree the leader is gone.
//!
//! Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark FORA · rung
//! FORA22. Design read: active-designing/date/20260814/20260814-084500_fora22-constel-prevote-no-disruption.md
//! Stands on: constel/vote.rye (FORA21) — at_least_as_current, the up-to-date check a pre-vote reuses unchanged; constel/quorum.rye
//! (FORA9) — the majority threshold; constel/roster.rye (FORA1) — the bound.
//!
//! Purely LOCAL — a bounded pre-vote count and per-peer leader-contact flags on one bench, siloed to constel/, run from inside the
//! jailed pier. No socket, no network, no keys, no funds, no real address ever formed (custody gate %2 — real hardware / any real
//! wire — and gate %4 — real Kumara — both untouched). A served pre-vote reaches the Comlink-served gate; the socket rung stays
//! the maintainer's hand.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run constel/prevote.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const roster = @import("roster.rye");
const vote = @import("vote.rye");
const quorum = @import("quorum.rye");

pub const prevote_version = "20260814.084500";

/// One peer's standing as a pre-vote is asked: whether it has HEARD from a current leader recently (its election timeout has NOT
/// elapsed). A peer still hearing a healthy leader answers no to any pre-vote, because from where it stands the sky is fine.
pub const Peer = struct {
    heard_leader_recently: bool = true,
    last_term: u32 = 0, // the peer's own last log term
    len: u32 = 0, // the peer's own log length
};

/// A PEER PRE-GRANTS iff BOTH conditions hold: it has NOT heard from a current leader recently (its timeout elapsed), AND the
/// candidate's log is at least as up-to-date as the peer's own (FORA21's rule, reused unchanged). Either condition alone is a no —
/// a peer that still hears a leader never pre-grants, and a behind candidate is refused here exactly as in a real vote.
pub fn pre_grants(peer: *const Peer, cand_last_term: u32, cand_len: u32) bool {
    // invariant: a pre-grant never fires while the peer still hears a healthy leader.
    if (peer.heard_leader_recently) return false;
    return vote.at_least_as_current(cand_last_term, cand_len, peer.last_term, peer.len);
}

/// HOW MANY PEERS WOULD PRE-GRANT, over a bounded roster. The pre-vote PASSES iff this reaches the majority threshold.
pub fn pre_vote_tally(peers: []const Peer, cand_last_term: u32, cand_len: u32) u32 {
    // invariant: the roster polled is bounded to the constellation.
    assert(peers.len <= roster.max_piers);
    var grants: u32 = 0;
    var i: u32 = 0;
    while (i < peers.len) : (i += 1) {
        if (pre_grants(&peers[i], cand_last_term, cand_len)) grants += 1;
    }
    // invariant: the count never exceeds the roster it was drawn from.
    assert(grants <= peers.len);
    return grants;
}

/// Whether the pre-vote PASSES — a strict majority would pre-grant.
pub fn pre_vote_passes(peers: []const Peer, cand_last_term: u32, cand_len: u32, threshold: u32) bool {
    // invariant: the threshold is a real strict majority within the roster.
    assert(threshold >= 1 and threshold <= peers.len);
    return pre_vote_tally(peers, cand_last_term, cand_len) >= threshold;
}

/// BUMP THE REAL TERM ONLY AFTER A PRE-VOTE PASSES. Returns the term the candidate should carry into a real election: the SAME
/// current_term (no disruption) when the pre-vote fails, or current_term + 1 when it passes. This is the whole anti-disruption
/// guarantee — the real term never advances on a partitioned node's say-so alone.
pub fn maybe_start_election(peers: []const Peer, cand_last_term: u32, cand_len: u32, current_term: u32, threshold: u32) u32 {
    // invariant: the current term leaves room to advance without overflow.
    assert(current_term < std.math.maxInt(u32));
    if (pre_vote_passes(peers, cand_last_term, cand_len, threshold)) return current_term + 1;
    return current_term; // pre-vote failed — the term is NOT bumped, the sky undisturbed
}

// --- selftest: a peer pre-grants only when both conditions hold; A STABLE SKY IS NOT DISRUPTED (a majority still hear a leader,
//     so a rejoining high-term candidate fails the pre-vote and its real term is not bumped); a genuinely leaderless sky DOES
//     elect; a behind candidate fails the pre-vote even leaderless; the term is bumped exactly once and only on success; bounded.

fn run_selftest() !u8 {
    const five: u32 = 5;
    const th = quorum.majority_of(five); // 3

    // 1. A PEER PRE-GRANTS ONLY WHEN BOTH CONDITIONS HOLD — leader-silence AND an up-to-date candidate.
    {
        // A peer that has lost the leader and whose log the candidate matches — pre-grants.
        const silent_current = Peer{ .heard_leader_recently = false, .last_term = 2, .len = 3 };
        assert(pre_grants(&silent_current, 2, 3)); // both hold
        // The SAME peer while it still hears the leader — never pre-grants, however current the candidate.
        const hearing = Peer{ .heard_leader_recently = true, .last_term = 2, .len = 3 };
        assert(!pre_grants(&hearing, 2, 3)); // still hears a leader — no
        // A silent peer, but the candidate is BEHIND (shorter at the same term) — refused by the up-to-date rule.
        const silent_ahead = Peer{ .heard_leader_recently = false, .last_term = 2, .len = 5 };
        assert(!pre_grants(&silent_ahead, 2, 3)); // candidate one short — no
    }

    // 2. A STABLE SKY IS NOT DISRUPTED — the crux. A majority of five still HEAR a healthy leader; a rejoining candidate whose
    //    PRIVATE term ballooned to 99 and whose log is fully current still fails the pre-vote, and its real term is NOT bumped.
    {
        const peers = [_]Peer{
            .{ .heard_leader_recently = true, .last_term = 2, .len = 3 }, // three of five still hear the leader
            .{ .heard_leader_recently = true, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = true, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 }, // only two have lost contact
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
        };
        // The candidate is up-to-date (term 2, len 3) and its private term is enormous — yet it may not bump a real term.
        assert(pre_vote_tally(&peers, 2, 3) == 2); // only the two silent peers pre-grant
        assert(!pre_vote_passes(&peers, 2, 3, th)); // below the majority — the pre-vote FAILS
        const real_term = maybe_start_election(&peers, 2, 3, 5, th); // the leader's real term is 5; candidate's private term 99
        assert(real_term == 5); // UNCHANGED — the healthy leader is not forced to step down
    }

    // 3. A GENUINELY LEADERLESS SKY DOES ELECT — when a majority HAVE lost the leader (real failure) and the candidate is current,
    //    the pre-vote passes and only then is the term bumped. Pre-vote blocks disruption, never a true election.
    {
        const peers = [_]Peer{
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 }, // a majority have lost contact
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = true, .last_term = 2, .len = 3 }, // two stragglers still think a leader lives
            .{ .heard_leader_recently = true, .last_term = 2, .len = 3 },
        };
        assert(pre_vote_tally(&peers, 2, 3) == 3); // the three silent, current peers pre-grant
        assert(pre_vote_passes(&peers, 2, 3, th)); // a majority — the pre-vote PASSES
        const real_term = maybe_start_election(&peers, 2, 3, 5, th);
        assert(real_term == 6); // NOW the term advances by exactly one — a legitimate election begins
    }

    // 4. A BEHIND CANDIDATE FAILS THE PRE-VOTE EVEN LEADERLESS — the up-to-date check (FORA21) still binds, so pre-vote never
    //    elects an incomplete leader either.
    {
        const peers = [_]Peer{
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 }, // all five have lost the leader...
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
            .{ .heard_leader_recently = false, .last_term = 2, .len = 3 },
        };
        // ...but the candidate is BEHIND (term 2, len 2 — one entry short). No peer pre-grants.
        assert(pre_vote_tally(&peers, 2, 2) == 0);
        assert(!pre_vote_passes(&peers, 2, 2, th)); // incomplete candidate — pre-vote fails
        assert(maybe_start_election(&peers, 2, 2, 5, th) == 5); // term unchanged
    }

    // 5. THE TERM IS BUMPED EXACTLY ONCE AND ONLY ON SUCCESS — a failed pre-vote leaves the term; a passed one advances it by one.
    {
        const all_hearing = [_]Peer{
            .{ .heard_leader_recently = true, .last_term = 1, .len = 1 },
            .{ .heard_leader_recently = true, .last_term = 1, .len = 1 },
            .{ .heard_leader_recently = true, .last_term = 1, .len = 1 },
        };
        assert(maybe_start_election(&all_hearing, 1, 1, 7, quorum.majority_of(3)) == 7); // fail → unchanged
        const all_silent = [_]Peer{
            .{ .heard_leader_recently = false, .last_term = 1, .len = 1 },
            .{ .heard_leader_recently = false, .last_term = 1, .len = 1 },
            .{ .heard_leader_recently = false, .last_term = 1, .len = 1 },
        };
        assert(maybe_start_election(&all_silent, 1, 1, 7, quorum.majority_of(3)) == 8); // pass → +1 exactly
    }

    // 6. BOUNDED — the pre-vote poll runs over a full roster of eight within the pier cap.
    {
        var peers: [roster.max_piers]Peer = [_]Peer{.{ .heard_leader_recently = false, .last_term = 1, .len = 1 }} ** roster.max_piers;
        const grants = pre_vote_tally(&peers, 1, 1); // every peer is silent and matched — all pre-grant
        assert(grants == roster.max_piers);
    }

    print("GREEN fora-prevote: a partitioned pier cannot disrupt a stable sky (Raft §9.6, pre-vote) — a peer pre-grants only when " ++
        "BOTH hold, it has lost the leader AND the candidate is up-to-date (FORA21); A STABLE SKY IS NOT DISRUPTED — a majority " ++
        "still hearing a healthy leader make a rejoining candidate's pre-vote FAIL however high its private term, so its real " ++
        "term is NOT bumped and the leader is not forced to step down; a GENUINELY LEADERLESS sky (a majority lost contact) DOES " ++
        "pass the pre-vote and only then bumps the term by exactly one; a BEHIND candidate fails the pre-vote even leaderless, " ++
        "the up-to-date rule still binding; the term advances exactly once and only on success; and the poll runs bounded over a " ++
        "full roster — no socket, no network, no keys, no funds, no real address ever formed\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
