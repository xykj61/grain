//! constel/log.rye — FORA12: a sequence of decrees the whole sky agrees on, in order. FORA11 committed one value, once,
//! guarded so two piers can never hold a different value for one decision. A ledger is not one decision, though — it is a
//! SEQUENCE of them, in order. The output every consensus protocol exists to produce is a replicated, append-only log: entry
//! 0, then entry 1, then entry 2, each committed by quorum and — the whole point — the same at every pier. This rung takes
//! that one new concern: order the decrees into a log that cannot fork.
//!
//! The safety carries up from FORA11 by construction: because each index commits AT MOST ONE value, two logs that replicate
//! the same committed decrees are identical entry for entry — no fork is possible. Append is ordered (index n fills before
//! n+1), append-only (a committed entry is never rewritten, exactly Mantra's own discipline), and bounded (LogFull at the
//! cap). A decree that fails to commit does NOT grow the log — the index stays open for a later round — so a log never carries
//! a gap or an uncommitted value.
//!
//! Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark FORA · rung
//! FORA12. Design read: active-designing/20260814-054414_fora12-constel-replicated-log.md
//! Stands on: constel/decree.rye (FORA11) — each entry is one committed decree; constel/switchboard.rye (FORA6) — the medium;
//! constel/roster.rye (FORA1) — the bound.
//!
//! Purely LOCAL — a bounded in-memory log over the switchboard on one bench, siloed to constel/, run from inside the jailed
//! pier. No socket, no network, no keys, no funds, no real address ever formed (custody gate %2 — real hardware / any real
//! wire — and gate %4 — real Kumara — both untouched).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run constel/log.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const name = @import("name.rye");
const roster = @import("roster.rye");
const switchboard = @import("switchboard.rye");
const decree = @import("decree.rye");

pub const log_version = "20260814.054414";

/// The most entries a Constel log holds on the bench. A bounded ledger, named at construction like every collection in the
/// tree; a real deployment would page beyond this, yet the fake-pier bench proves the ordering law within one bound.
pub const max_entries: u32 = 64;

pub const LogError = error{
    /// The log is at its entry cap — a bounded ledger refuses to grow past max_entries rather than overrun.
    LogFull,
    /// A read named an index the log has not yet committed.
    NoEntry,
} || decree.DecreeError;

/// An append-only sequence of committed values. `len` entries are filled, in order, index 0 first. A committed entry is never
/// rewritten — the only mutation is a new value at index `len`, exactly Mantra's append-only order.
pub const Log = struct {
    entry: [max_entries]u32 = [_]u32{0} ** max_entries,
    len: u32 = 0,

    /// Append an already-committed value at the next index, refusing LogFull at the cap. The value joins at index `len`, and
    /// no prior entry moves — append-only by construction.
    pub fn append(self: *Log, value: u32) LogError!u32 {
        // invariant: the log never grows past its named bound.
        assert(self.len <= max_entries);
        if (self.len >= max_entries) return error.LogFull;
        const idx = self.len;
        self.entry[idx] = value;
        self.len += 1;
        // invariant: exactly one entry was added, and it sits at the index just filled.
        assert(self.len == idx + 1);
        assert(self.entry[idx] == value);
        return idx;
    }

    /// Read a committed entry, refusing NoEntry for an index the log has not filled.
    pub fn get(self: *const Log, index: u32) LogError!u32 {
        if (index >= self.len) return error.NoEntry;
        // invariant: a read stays within the committed prefix.
        assert(index < self.len);
        return self.entry[index];
    }

    /// Whether two logs are identical entry for entry — the replication / no-fork check. Two piers that replicated the same
    /// committed decrees must match, because each index committed at most one value (FORA11).
    pub fn matches(self: *const Log, other: *const Log) bool {
        if (self.len != other.len) return false;
        var i: u32 = 0;
        while (i < self.len) : (i += 1) {
            if (self.entry[i] != other.entry[i]) return false;
        }
        return true;
    }
};

/// Run one FORA11 decree and, only on a clean commit, append the committed value — the whole "propose, agree, record" cycle
/// of a replicated log. Any error (NoDecree below a majority, NoSuchPier for a stranger leader, VowelPresent at the border)
/// propagates and leaves the log UNCHANGED, so the log never carries a gap or an uncommitted value.
pub fn run_and_append(log: *Log, sb: *switchboard.Switchboard, leader: []const u8, value: u32) LogError!u32 {
    const before = log.len;
    const committed = try decree.run_decree(sb, leader, value); // any failure returns here, before the append
    // invariant: a decree commits exactly the value it proposed, which is what the log records.
    assert(committed == value);
    const idx = try log.append(committed);
    // invariant: a clean round grows the log by exactly one entry.
    assert(log.len == before + 1);
    assert(idx == before);
    return idx;
}

// --- selftest: append grows in order and reads back, bounded by LogFull; a real sky commits a sequence in order; two logs
//     replicating the same sequence are identical (no fork); a failed decree does not grow the log; eight append bounded ----

fn run_selftest() !u8 {
    // 1. append grows the log in order, get reads each entry back, and LogFull refuses past the cap.
    {
        var log = Log{};
        assert((try log.append(10)) == 0);
        assert((try log.append(20)) == 1);
        assert((try log.append(30)) == 2);
        assert(log.len == 3);
        assert((try log.get(0)) == 10 and (try log.get(1)) == 20 and (try log.get(2)) == 30);
        if (log.get(3)) |_| return error.ReadPastEnd else |e| if (e != error.NoEntry) return error.WrongNoEntry;

        // Fill to the cap, then refuse LogFull.
        var full = Log{};
        var i: u32 = 0;
        while (i < max_entries) : (i += 1) _ = try full.append(i);
        assert(full.len == max_entries);
        if (full.append(999)) |_| return error.GrewPastCap else |e| if (e != error.LogFull) return error.WrongLogFull;
    }

    // 2. run_and_append over a real sky commits and appends a sequence in exact order.
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(4);
        const leader = try name_of(&sb, 0);
        var lb: [name.max_ship_len]u8 = undefined;
        const ln = copy_name(&lb, leader);

        var log = Log{};
        assert((try run_and_append(&log, &sb, ln, 11)) == 0);
        assert((try run_and_append(&log, &sb, ln, 22)) == 1);
        assert((try run_and_append(&log, &sb, ln, 33)) == 2);
        assert(log.len == 3);
        assert((try log.get(0)) == 11 and (try log.get(1)) == 22 and (try log.get(2)) == 33);
    }

    // 3. No fork — two logs driven through the same committed sequence are identical entry for entry. Each index committed one
    //    value (FORA11), so replication cannot diverge.
    {
        var sba = switchboard.Switchboard{};
        try sba.stand_up(3);
        var sbb = switchboard.Switchboard{};
        try sbb.stand_up(3);
        const la = try name_of(&sba, 0);
        const lb2 = try name_of(&sbb, 0);
        var ab: [name.max_ship_len]u8 = undefined;
        var bb: [name.max_ship_len]u8 = undefined;
        const lan = copy_name(&ab, la);
        const lbn = copy_name(&bb, lb2);

        var log_a = Log{};
        var log_b = Log{};
        const seq = [_]u32{ 7, 8, 9, 100 };
        var i: u32 = 0;
        while (i < seq.len) : (i += 1) {
            _ = try run_and_append(&log_a, &sba, lan, seq[i]);
            _ = try run_and_append(&log_b, &sbb, lbn, seq[i]);
        }
        assert(log_a.matches(&log_b)); // the two replicas agree — no fork
        assert(log_a.len == 4);

        // A log that stopped one entry short does NOT match — the check is honest, not a constant true.
        var log_short = Log{};
        _ = try run_and_append(&log_short, &sba, lan, 7); // sba's mailboxes are empty after the round above
        assert(!log_a.matches(&log_short));
    }

    // 4. A failed decree does not grow the log — a stranger leader refuses NoSuchPier and len is unchanged (the same
    //    early-return-before-append that NoDecree takes).
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(3);
        var log = Log{};
        _ = try run_and_append(&log, &sb, try name_of(&sb, 0), 1);
        assert(log.len == 1);
        if (run_and_append(&log, &sb, "zzzz9", 2)) |_| return error.StrangerAppended else |e| if (e != error.NoSuchPier) return error.WrongStranger;
        assert(log.len == 1); // the failed round left the log untouched
    }

    // 5. A full constellation of eight appends bounded — run_decree interleaves respond and hear so no ChannelFull, and the
    //    sky commits and records two entries in order.
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(roster.max_piers);
        const leader = try name_of(&sb, 0);
        var lb: [name.max_ship_len]u8 = undefined;
        const ln = copy_name(&lb, leader);
        var log = Log{};
        assert((try run_and_append(&log, &sb, ln, 5)) == 0);
        assert((try run_and_append(&log, &sb, ln, 6)) == 1);
        assert(log.len == 2 and (try log.get(1)) == 6);
    }

    print("GREEN fora-log: a sequence of decrees the whole sky agrees on, in order — append grows the log in order and reads " ++
        "back, refusing LogFull past the cap and NoEntry past the committed prefix; run_and_append over a real sky commits " ++
        "and appends a sequence (11, 22, 33) in exact order; NO FORK — two logs driven through the same committed sequence " ++
        "are identical entry for entry (each index committed one value, so replication cannot diverge), and a log one entry " ++
        "short honestly does not match; a failed decree does not grow the log (a stranger leader refuses NoSuchPier, len " ++
        "unchanged); and a full constellation of eight appends bounded (no ChannelFull, interleaved) — the append-only " ++
        "ledger every consensus exists to produce, no fork possible; no socket, no network, no keys, no funds, no real " ++
        "address ever formed\n", .{});
    return 0;
}

/// The name at a roster slot — a thin selftest helper so a scenario names its piers off the roster rather than the alphabet.
fn name_of(sb: *switchboard.Switchboard, slot: u32) switchboard.SwitchboardError![]const u8 {
    // invariant: only a slot within the current constellation is ever named.
    assert(slot < sb.size());
    return sb.roster.member(slot);
}

/// Copy a pier name out of the roster's buffer into a caller-owned buffer, returning the plain slice — the decree round
/// mutates mailboxes but never the roster, so this is belt-and-braces clarity rather than a correctness need.
fn copy_name(dst: []u8, src: []const u8) []const u8 {
    // invariant: a pier name always fits the ship bound, so the copy never overruns.
    assert(src.len <= name.max_ship_len);
    assert(dst.len >= src.len);
    var i: u32 = 0;
    while (i < src.len) : (i += 1) dst[i] = src[i];
    return dst[0..src.len];
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
