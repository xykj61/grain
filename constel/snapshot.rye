//! constel/snapshot.rye — FORA14: compact the log so it can serve forever. FORA12 built the append-only replicated log every
//! consensus exists to produce; FORA13 let the sky change its own membership without a fork. Both leave one honest bound: the
//! log is a fixed [max_entries]u32 and append refuses LogFull at the cap. A ledger that can only ever hold sixty-four decisions
//! is a demonstration, not a ledger. A real replicated log runs for years and must COMPACT — fold its settled history into a
//! small summary and reclaim the room — or it stops. This rung takes that one new concern: snapshot / log compaction.
//!
//! The state a log accumulates is a DETERMINISTIC, ORDER-SENSITIVE fold over its committed values, applied in order:
//!   state_0 = fold_seed;  state_n = state_{n-1} *% fold_mul +% value_n  (wrapping u32).
//! A Snapshot is (count, state) — how many committed entries it absorbed, and their fold. Because two piers that committed the
//! same prefix apply the same values in the same order (FORA12: each index commits AT MOST ONE value), their snapshots are
//! IDENTICAL — the no-fork guarantee carries straight into compaction rather than being re-argued. A CompactLog keeps a
//! snapshot plus a live tail of entries committed after it; compact folds the tail into the snapshot and empties it, so the
//! effective log grows past the tail bound in bounded memory, and can never fork.
//!
//! Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark FORA · rung
//! FORA14. Design read: active-designing/date/20260814/20260814-060326_fora14-constel-snapshot-log-compaction.md
//! Stands on: constel/log.rye (FORA12) — the append-only order the snapshot preserves; constel/decree.rye (FORA11) — each entry
//! is one committed decree; constel/switchboard.rye (FORA6) — the medium; constel/roster.rye (FORA1) — the bound.
//!
//! Purely LOCAL — a bounded in-memory compact log over the switchboard on one bench, siloed to constel/, run from inside the
//! jailed pier. No socket, no network, no keys, no funds, no real address ever formed (custody gate %2 — real hardware / any
//! real wire — and gate %4 — real Kumara — both untouched).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run constel/snapshot.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const name = @import("name.rye");
const roster = @import("roster.rye");
const switchboard = @import("switchboard.rye");
const decree = @import("decree.rye");

pub const snapshot_version = "20260814.060326";

/// The most live entries a Constel compact log holds in its tail before a compaction is wanted. A bounded tail, named at
/// construction like every collection in the tree; compaction folds it into the snapshot, so the EFFECTIVE log runs far past
/// this bound in bounded memory — the whole point of the rung.
pub const max_tail: u32 = 64;

/// The seed and multiplier of the deterministic fold. The fold is order-sensitive on purpose (a rolling combine, not a sum),
/// so a snapshot preserves the log's ORDERING, not merely its multiset of values. The multiplier is the FNV-1a prime — an
/// arbitrary odd constant that mixes well; any fixed odd constant would keep the determinism this rung actually depends on.
pub const fold_seed: u32 = 2166136261; // FNV offset basis, used as a plain deterministic seed
pub const fold_mul: u32 = 16777619; // FNV prime — an arbitrary odd multiplier; determinism is what matters, not cryptography

pub const SnapshotError = error{
    /// The live tail is at its cap — compact() before appending more, or run_and_append auto-compacts.
    TailFull,
    /// A read named an effective index already folded into the snapshot and discarded — the compaction reclaimed it.
    Compacted,
    /// A read named an effective index the log has not committed.
    NoEntry,
} || decree.DecreeError;

/// One deterministic fold step: advance a running state by one committed value. Wrapping arithmetic keeps it total over all
/// u32 — a fold never traps, it only mixes.
pub fn fold_step(state: u32, value: u32) u32 {
    // invariant: the step is pure in its inputs — same (state, value) always yields the same next state, which is exactly why
    // two piers folding the same committed prefix reach the same snapshot.
    return (state *% fold_mul) +% value;
}

/// The compacted summary of a committed prefix: how many entries it absorbed, and their order-sensitive fold. Two snapshots
/// that absorbed the same committed prefix are identical in both fields — the no-fork guarantee, carried into compaction.
pub const Snapshot = struct {
    count: u32 = 0,
    state: u32 = fold_seed,

    /// Fold one more committed value into this snapshot, advancing both the count and the running state. The one mutation a
    /// snapshot ever takes — it only ever absorbs the next committed value, never rewrites a past one.
    pub fn fold(self: *Snapshot, value: u32) void {
        // invariant: a snapshot never absorbs more than a full compacted log could hold; the caller (compact) bounds this by
        // max_tail per call, and total across the log is what climbs — the snapshot count itself is monotone.
        const before = self.count;
        self.state = fold_step(self.state, value);
        self.count = before + 1;
        // invariant: exactly one value was absorbed, and the count advanced by exactly one.
        assert(self.count == before + 1);
    }

    /// Whether two snapshots absorbed the same committed prefix — identical count AND identical fold. The replication check at
    /// the snapshot level: same committed prefix, same summary.
    pub fn matches(self: *const Snapshot, other: *const Snapshot) bool {
        return self.count == other.count and self.state == other.state;
    }
};

/// A replicated log that compacts: a snapshot of the committed prefix plus a bounded live tail of entries committed after it.
/// The effective committed length is snap.count + tail_len, which climbs past max_tail as compaction reclaims the tail.
pub const CompactLog = struct {
    snap: Snapshot = .{},
    tail: [max_tail]u32 = [_]u32{0} ** max_tail,
    tail_len: u32 = 0,

    /// The effective committed length — the snapshot's absorbed count plus the live tail. This is the number a client sees;
    /// it grows without bound (in bounded memory) as compaction folds the tail away.
    pub fn total(self: *const CompactLog) u32 {
        // invariant: the tail never exceeds its bound, so the sum is well defined.
        assert(self.tail_len <= max_tail);
        return self.snap.count + self.tail_len;
    }

    /// Append an already-committed value to the live tail, refusing TailFull at the cap. No prior entry moves — append-only,
    /// exactly as FORA12's log; the only difference is that the tail can be reclaimed by compaction.
    pub fn append(self: *CompactLog, value: u32) SnapshotError!u32 {
        // invariant: the tail never grows past its named bound.
        assert(self.tail_len <= max_tail);
        if (self.tail_len >= max_tail) return error.TailFull;
        const total_before = self.total();
        const idx = self.snap.count + self.tail_len; // the effective index this value takes
        self.tail[self.tail_len] = value;
        self.tail_len += 1;
        // invariant: exactly one entry was added and the effective length grew by exactly one.
        assert(self.total() == total_before + 1);
        assert(idx == self.total() - 1);
        return idx;
    }

    /// Fold the entire live tail into the snapshot, in order, then empty the tail — the reclaim. The effective length is
    /// preserved (the entries move from tail into the snapshot's count), and effective_state is unchanged (folding then
    /// continuing equals folding all at once).
    pub fn compact(self: *CompactLog) void {
        // invariant: the tail is within bound before the fold — bounded work per compaction.
        assert(self.tail_len <= max_tail);
        const total_before = self.total();
        const state_before = self.effective_state();
        var i: u32 = 0;
        while (i < self.tail_len) : (i += 1) self.snap.fold(self.tail[i]);
        self.tail_len = 0;
        // invariant: compaction preserves the effective length and the effective state — it reclaims room, it changes nothing
        // a client can observe. This is why two piers may compact on different schedules and never fork.
        assert(self.total() == total_before);
        assert(self.effective_state() == state_before);
    }

    /// The full fold over every committed value — the snapshot's state advanced by the live tail. Whether or not a compaction
    /// has happened, two logs that committed the same prefix report the same effective_state.
    pub fn effective_state(self: *const CompactLog) u32 {
        var s = self.snap.state;
        var i: u32 = 0;
        while (i < self.tail_len) : (i += 1) s = fold_step(s, self.tail[i]);
        // invariant: the fold walked exactly the live tail; the snapshot already holds the rest.
        assert(i == self.tail_len);
        return s;
    }

    /// Read a committed entry by effective index. An index already folded into the snapshot refuses Compacted (the compaction
    /// reclaimed it — a real client would read the snapshot instead); an index past the end refuses NoEntry.
    pub fn get(self: *const CompactLog, index: u32) SnapshotError!u32 {
        if (index < self.snap.count) return error.Compacted;
        if (index >= self.total()) return error.NoEntry;
        const tail_idx = index - self.snap.count;
        // invariant: a live read lands inside the tail, never past it.
        assert(tail_idx < self.tail_len);
        return self.tail[tail_idx];
    }

    /// Whether two compact logs are equivalent as ledgers — same effective length AND same effective state — regardless of how
    /// each has compacted. This is the no-fork check for compaction: replication is judged by the committed history, not by the
    /// bookkeeping of when each pier reclaimed its tail.
    pub fn equivalent(self: *const CompactLog, other: *const CompactLog) bool {
        return self.total() == other.total() and self.effective_state() == other.effective_state();
    }
};

/// Run one FORA11 decree and, only on a clean commit, append the committed value to the compact log — auto-compacting when the
/// tail is full so the round never fails for room. Any decree error (NoDecree below a majority, NoSuchPier for a stranger
/// leader, VowelPresent at the border) propagates and leaves the log UNCHANGED, so the log never carries a gap or an
/// uncommitted value.
pub fn run_and_append(clog: *CompactLog, sb: *switchboard.Switchboard, leader: []const u8, value: u32) SnapshotError!u32 {
    const total_before = clog.total();
    const committed = try decree.run_decree(sb, leader, value); // any failure returns here, before any log mutation
    // invariant: a decree commits exactly the value it proposed, which is what the log records.
    assert(committed == value);
    if (clog.tail_len >= max_tail) clog.compact(); // reclaim before the append so a full tail never blocks a committed value
    const idx = try clog.append(committed);
    // invariant: a clean round grows the effective log by exactly one entry.
    assert(clog.total() == total_before + 1);
    assert(idx == total_before);
    return idx;
}

// --- selftest: the fold is deterministic and order-sensitive; append/get/TailFull on the tail; compact preserves total and
//     effective_state and reclaims the tail (Compacted on a folded index); no fork across differing compaction schedules;
//     compaction carries the effective log past max_tail; a real sky commits a sequence past the tail cap, a failure untouched -

fn run_selftest() !u8 {
    // 1. The fold is deterministic and ORDER-SENSITIVE — the same values in a different order fold to a different state, so a
    //    snapshot preserves ordering, not merely contents.
    {
        var a = Snapshot{};
        var b = Snapshot{};
        a.fold(10);
        a.fold(20);
        a.fold(30);
        b.fold(10);
        b.fold(20);
        b.fold(30);
        assert(a.matches(&b)); // same values, same order — identical
        assert(a.count == 3);

        var c = Snapshot{};
        c.fold(10);
        c.fold(30);
        c.fold(20); // same multiset, swapped order
        assert(c.count == a.count); // same number absorbed
        assert(!c.matches(&a)); // yet a DIFFERENT fold — ordering is preserved
    }

    // 2. append grows the tail, get reads back at effective indices, TailFull refuses past the tail cap.
    {
        var clog = CompactLog{};
        assert((try clog.append(5)) == 0);
        assert((try clog.append(6)) == 1);
        assert((try clog.append(7)) == 2);
        assert(clog.total() == 3);
        assert((try clog.get(0)) == 5 and (try clog.get(1)) == 6 and (try clog.get(2)) == 7);
        if (clog.get(3)) |_| return error.ReadPastEnd else |e| if (e != error.NoEntry) return error.WrongNoEntry;

        var full = CompactLog{};
        var i: u32 = 0;
        while (i < max_tail) : (i += 1) _ = try full.append(i);
        assert(full.tail_len == max_tail and full.total() == max_tail);
        if (full.append(999)) |_| return error.GrewPastCap else |e| if (e != error.TailFull) return error.WrongTailFull;
    }

    // 3. compact folds the tail into the snapshot, empties the tail, preserves total() and effective_state(), and turns a
    //    folded-away index into Compacted.
    {
        var clog = CompactLog{};
        _ = try clog.append(11);
        _ = try clog.append(22);
        _ = try clog.append(33);
        const total_before = clog.total();
        const state_before = clog.effective_state();
        clog.compact();
        assert(clog.tail_len == 0); // the tail was reclaimed
        assert(clog.snap.count == 3); // the snapshot absorbed all three
        assert(clog.total() == total_before); // effective length preserved
        assert(clog.effective_state() == state_before); // effective state unchanged
        if (clog.get(0)) |_| return error.ReadCompacted else |e| if (e != error.Compacted) return error.WrongCompacted;
        // A new append lands at the effective index just past the snapshot, and reads back live.
        assert((try clog.append(44)) == 3);
        assert((try clog.get(3)) == 44);
        assert(clog.total() == 4);
    }

    // 4. NO FORK across compaction — two logs fed the same committed sequence, one compacting midway and one never compacting,
    //    hold the same total() and the same effective_state(). Compaction introduces no divergence.
    {
        var eager = CompactLog{}; // compacts after every few appends
        var lazy = CompactLog{}; // never compacts (fits the tail)
        const seq = [_]u32{ 3, 1, 4, 1, 5, 9, 2, 6 };
        var i: u32 = 0;
        while (i < seq.len) : (i += 1) {
            _ = try eager.append(seq[i]);
            _ = try lazy.append(seq[i]);
            if (i % 3 == 0) eager.compact(); // a different compaction schedule
        }
        eager.compact();
        assert(eager.snap.count == seq.len and eager.tail_len == 0); // eager folded everything
        assert(lazy.snap.count == 0 and lazy.tail_len == seq.len); // lazy folded nothing
        assert(eager.equivalent(&lazy)); // yet equivalent as ledgers — no fork
        assert(eager.total() == lazy.total() and eager.total() == seq.len);

        // A log fed a DIFFERENT sequence is honestly NOT equivalent — the check is real, not a constant true.
        var other = CompactLog{};
        _ = try other.append(3);
        _ = try other.append(1);
        _ = try other.append(4);
        _ = try other.append(1);
        _ = try other.append(5);
        _ = try other.append(9);
        _ = try other.append(2);
        _ = try other.append(7); // last value differs
        assert(!eager.equivalent(&other));
    }

    // 5. Compaction carries the effective log PAST the original bound — append the tail to full, compact, append more, so
    //    total() climbs past max_tail in bounded memory.
    {
        var clog = CompactLog{};
        var i: u32 = 0;
        while (i < max_tail) : (i += 1) _ = try clog.append(i);
        clog.compact(); // reclaim the full tail
        assert(clog.tail_len == 0 and clog.snap.count == max_tail);
        var j: u32 = 0;
        while (j < max_tail) : (j += 1) _ = try clog.append(1000 + j);
        assert(clog.total() == max_tail * 2); // twice the original cap, tail still bounded
        assert(clog.tail_len == max_tail);
        assert((try clog.get(max_tail)) == 1000); // the first post-snapshot entry reads back
    }

    // 6. Over a REAL sky — run_and_append drives decrees into a compact log, auto-compacting when the tail fills, committing a
    //    sequence in order past the tail cap; a stranger leader refuses NoSuchPier and leaves the log untouched.
    {
        var sb = switchboard.Switchboard{};
        try sb.stand_up(4);
        const leader = try name_of(&sb, 0);
        var lb: [name.max_ship_len]u8 = undefined;
        const ln = copy_name(&lb, leader);

        var clog = CompactLog{};
        assert((try run_and_append(&clog, &sb, ln, 11)) == 0);
        assert((try run_and_append(&clog, &sb, ln, 22)) == 1);
        assert((try run_and_append(&clog, &sb, ln, 33)) == 2);
        assert(clog.total() == 3);
        // A live read still reaches the tail entries the round just committed.
        assert((try clog.get(2)) == 33);

        // A failed decree leaves the compact log untouched.
        if (run_and_append(&clog, &sb, "zzzz9", 44)) |_| return error.StrangerAppended else |e| if (e != error.NoSuchPier) return error.WrongStranger;
        assert(clog.total() == 3); // the failed round grew nothing
    }

    print("GREEN fora-snapshot: compact the log so it can serve forever — the fold is deterministic and order-sensitive (the " ++
        "same values in a different order fold to a different state, so a snapshot preserves ordering not just contents); " ++
        "append grows the tail and reads back, refusing TailFull past the cap and NoEntry past the end; compact folds the " ++
        "tail into the snapshot, empties it, preserves the effective length and the effective state, and turns a folded-away " ++
        "index into Compacted; NO FORK across compaction — an eager log and a lazy log fed the same committed sequence are " ++
        "equivalent as ledgers regardless of when each reclaimed its tail, and a different sequence honestly is not; " ++
        "compaction carries the effective log past its original bound (twice max_tail, tail still bounded); and over a real " ++
        "sky run_and_append commits a sequence in order, a stranger leader refusing NoSuchPier and leaving the log untouched " ++
        "— the ledger that serves forever, no fork possible; no socket, no network, no keys, no funds, no real address ever " ++
        "formed\n", .{});
    return 0;
}

/// The name at a roster slot — a thin selftest helper so a scenario names its piers off the roster rather than the alphabet.
fn name_of(sb: *switchboard.Switchboard, slot: u32) switchboard.SwitchboardError![]const u8 {
    // invariant: only a slot within the current constellation is ever named.
    assert(slot < sb.size());
    return sb.roster.member(slot);
}

/// Copy a pier name out of the roster's buffer into a caller-owned buffer, returning the plain slice — the decree round mutates
/// mailboxes but never the roster, so this is belt-and-braces clarity rather than a correctness need.
fn copy_name(dst: []u8, src: []const u8) []const u8 {
    // invariant: a pier name always fits the ship bound, so the copy never overruns.
    assert(src.len <= name.max_ship_len);
    assert(dst.len >= src.len);
    var i: u32 = 0;
    while (i < src.len) : (i += 1) dst[i] = src[i];
    return dst[0..src.len];
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
