//! linengrow/glow_seva_b0_replay.rye — Glow product replay surface for Seva B0.
//!
//! STOA196: owns demo-log replay while calling elder `seva.replay`.
//! STOA203: append path carries sign+line errors into ReplayError.
//! STOA204: claim path also digests via glow_seva_b0_digest (honesty).
//! STOA211 (C1): `replay` composes product line · sign · digest — no
//! `seva.replay`.
//! STOA212 (C2): FactFields / amount parse through glow_seva_b0_fields.
//! STOA235: `claim_replay_demo_root_from_desk` builds via desk append.
//!
//!   rye build linengrow/glow_seva_b0_replay_witness.rye \
//!     -femit-bin=linengrow/bin/glow_seva_b0_replay_witness

const std = @import("std");
const assert = std.debug.assert;
const kumara = @import("kumara.rye");
const mc = @import("murr_core.rye");
const rc = @import("receipt_core.rye");
const seva = @import("seva_session_core.rye");
const fixture = @import("glow_seva_b0_demo_fixture.rye");
const append = @import("glow_seva_b0_append.rye");
const digest = @import("glow_seva_b0_digest.rye");
const line = @import("glow_seva_b0_line.rye");
const sign = @import("glow_seva_b0_sign.rye");
const fields = @import("glow_seva_b0_fields.rye");

pub const replay_version = "20260722.134552";

pub const ReplayError = append.AppendError || digest.DigestError || fields.FieldsError || seva.SessionError || error{RootMismatch};

pub const ReplayResult = seva.ReplayResult;

/// Replay a bounded log via product line · fields · sign · digest (not seva.replay).
pub fn replay(
    log: []const u8,
    actor_hex: *const [mc.pubkey_hex_len]u8,
    actor_pk: kumara.PublicKey,
) ReplayError!ReplayResult {
    // invariant: the log is replayed whole and the elder format fixes the ceiling, so a longer
    // one would be replayed truncated and reach a root it does not have
    assert(log.len <= rc.max_log_len);
    // invariant: the pubkey is what every event in the log is checked against, so an empty one
    // would replay a log signed by nobody as though it verified
    assert(mc.pubkey_hex_len > 0);

    var count: u32 = 0;
    var last_seq: i64 = 0;
    var pos: u32 = 0;
    const log_u32: u32 = @intCast(log.len);
    while (pos < log_u32) {
        if (count >= seva.max_events) return error.ReplayFailed;
        const line_end_usz = std.mem.indexOfScalarPos(u8, log, pos, '\n') orelse log.len;
        const line_end: u32 = @intCast(line_end_usz);
        const raw_line = log[pos..line_end];
        pos = if (line_end < log_u32) line_end + 1 else line_end;
        if (std.mem.trim(u8, raw_line, " \t\r\n").len == 0) continue;

        var sig_buf: [kumara.signature_length]u8 = undefined;
        var fact_out: [rc.max_fact_len]u8 = undefined;
        const parsed = line.parse_log_line(raw_line, &sig_buf, &fact_out) catch return error.ReplayFailed;
        const fact = fact_out[0..parsed.fact_len];

        var fact_fields: rc.FactFields = undefined;
        fields.parse_fact_fields(fact, &fact_fields) catch return error.ReplayFailed;

        if (!std.mem.eql(u8, fact_fields.from, actor_hex[0..])) return error.ReplayFailed;
        sign.verify_record(sig_buf[0..parsed.sig_len], fact, actor_pk) catch return error.ReplayFailed;

        const seq = fields.parse_amount_signed(fact_fields.amount) catch return error.ReplayFailed;
        if (seq != last_seq + 1) return error.OutOfOrder;
        last_seq = seq;
        count += 1;
    }

    const root = digest.digest_log_bytes(log);
    return .{ .events = count, .root = root, .last_seq = last_seq };
}

fn claim_replay_built_log(
    log_buf: *[rc.max_log_len]u8,
    len: u32,
    actor_hex: *const [mc.pubkey_hex_len]u8,
    actor_pk: kumara.PublicKey,
) ReplayError![32]u8 {
    const r1 = try replay(log_buf[0..len], actor_hex, actor_pk);
    const r2 = try replay(log_buf[0..len], actor_hex, actor_pk);
    // invariant: the two replays are compared to each other and to the fixture's own counts, so
    // a divergence names itself here rather than downstream
    assert(r1.events == fixture.event_count);
    assert(r2.events == fixture.event_count);
    assert(r1.last_seq == 3);
    assert(r2.last_seq == 3);
    // invariant: two replays of one log reach the same root, which is the whole promise a
    // replay makes -- a differing root means the fold is not deterministic
    assert(std.mem.eql(u8, &r1.root, &r2.root));
    if (!digest.root_matches_fixture(&r1.root)) return error.RootMismatch;

    // STOA204: product digest surface owns the claim assert.
    const product_root = try digest.claim_digest_log(log_buf[0..len]);
    if (!std.mem.eql(u8, &product_root, &r1.root)) return error.RootMismatch;
    return product_root;
}

/// Build the three-event demo log from pins, replay twice, assert roots agree.
pub fn claim_replay_demo_root(log_buf: *[rc.max_log_len]u8) ReplayError![32]u8 {
    const actor_kp = kumara.keypair_from_seed(&mc.issuer_seed);
    var actor_hex: [mc.pubkey_hex_len]u8 = undefined;
    mc.hex_of_key(actor_kp.public_key, &actor_hex);

    const len = try append.append_demo_log(log_buf);
    return claim_replay_built_log(log_buf, len, &actor_hex, actor_kp.public_key);
}

/// Build from runtime desk text, replay twice, assert HAWM1 (STOA235).
pub fn claim_replay_demo_root_from_desk(
    desk_src: []const u8,
    log_buf: *[rc.max_log_len]u8,
) ReplayError![32]u8 {
    const actor_kp = kumara.keypair_from_seed(&mc.issuer_seed);
    var actor_hex: [mc.pubkey_hex_len]u8 = undefined;
    mc.hex_of_key(actor_kp.public_key, &actor_hex);

    const len = try append.append_demo_log_from_desk(desk_src, log_buf);
    return claim_replay_built_log(log_buf, len, &actor_hex, actor_kp.public_key);
}
