//! linengrow/crockford_stamp.rye — Hands We Grow Decision 6: stamp aura faces.
//!
//! Two canonical faces of one chronological stamp, bijection both ways:
//!   · inward  — u64, fixed eight bytes, little-endian (zero-copy wire)
//!   · outward — Crockford base32, exactly thirteen characters
//!
//! Alphabet excludes I, L, O, U (case-insensitive decode). Width law: u64 for
//! the wire-persistent value; u32 for bounded counts; no authored usize.
//!
//!   rye build linengrow/crockford_stamp_witness.rye \
//!     -femit-bin=linengrow/bin/crockford_stamp_witness

const std = @import("std");
const assert = std.debug.assert;
const tally_copy = @import("tally_copy.rye");

pub const crockford_stamp_version = "20260724.205009";

/// Crockford base32 — digits then letters, skipping I L O U.
pub const alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";

pub const encoded_len: u32 = 13;
pub const wire_bytes: u32 = 8;

pub const EncodeError = error{ BufferTooSmall };
pub const DecodeError = error{ BadLength, BadChar, Overflow };

fn alphabet_index(c: u8) ?u8 {
    var i: u32 = 0;
    while (i < 32) : (i += 1) {
        if (alphabet[i] == c) return @intCast(i);
    }
    return null;
}

fn normalize_char(c: u8) DecodeError!u8 {
    // Case-insensitive; map i/l → 1, o → 0 is NOT Crockford's optional
    // mistype fold here — we reject I/L/O/U outright per Decision 6.
    const up: u8 = if (c >= 'a' and c <= 'z') c - ('a' - 'A') else c;
    if (up == 'I' or up == 'L' or up == 'O' or up == 'U') return error.BadChar;
    return up;
}

/// Pack u64 to eight little-endian wire bytes.
pub fn to_wire_le(value: u64, out: *[wire_bytes]u8) void {
    var i: u32 = 0;
    var v = value;
    while (i < wire_bytes) : (i += 1) {
        out[i] = @truncate(v & 0xff);
        v >>= 8;
    }
}

/// Unpack eight little-endian wire bytes to u64.
pub fn from_wire_le(bytes: *const [wire_bytes]u8) u64 {
    var v: u64 = 0;
    var i: u32 = 0;
    while (i < wire_bytes) : (i += 1) {
        const b: u64 = bytes[i];
        v |= b << @intCast(8 * i);
    }
    return v;
}

/// Encode u64 → 13 Crockford chars (most-significant symbol first).
pub fn encode(value: u64, out: *[encoded_len]u8) void {
    var v = value;
    var i: u32 = encoded_len;
    while (i > 0) {
        i -= 1;
        const idx: u32 = @intCast(v & 31);
        out[i] = alphabet[idx];
        v >>= 5;
    }
    // invariant: the loop divides the value down to nothing, so a remainder here would mean
    // digits were dropped off the front of the stamp
    assert(v == 0);
}

/// Decode 13 Crockford chars → u64. Rejects wrong length, I/L/O/U, and
/// symbols outside the alphabet. Case-insensitive for A–Z.
pub fn decode(text: []const u8) DecodeError!u64 {
    const n: u32 = @intCast(text.len);
    if (n != encoded_len) return error.BadLength;
    var v: u64 = 0;
    var i: u32 = 0;
    while (i < encoded_len) : (i += 1) {
        const up = try normalize_char(text[i]);
        const idx = alphabet_index(up) orelse return error.BadChar;
        // 13×5 = 65 bits of symbol space; values that would shift past u64
        // are impossible for a well-formed 13-char Crockford of a u64 encode
        // path — still guard the high bits on the first symbol.
        if (i == 0 and idx > 15) return error.Overflow; // top symbol only 4 bits of u64
        const shifted = @as(u64, idx);
        v = (v << 5) | shifted;
    }
    return v;
}

/// Round-trip: encode then decode must recover the value.
pub fn round_trip(value: u64) bool {
    var buf: [encoded_len]u8 = undefined;
    encode(value, &buf);
    const back = decode(buf[0..]) catch return false;
    return back == value;
}

/// Copy encode into a caller buffer; requires out.len >= encoded_len.
pub fn encode_to_slice(value: u64, out: []u8) EncodeError!u32 {
    if (out.len < encoded_len) return error.BufferTooSmall;
    var tmp: [encoded_len]u8 = undefined;
    encode(value, &tmp);
    tally_copy.copy_disjoint(u8, out[0..encoded_len], tmp[0..]);
    return encoded_len;
}
