//! scribe/reader.rye -- Scribe, the Kyri voice's home: a zero-copy Kyri reader.
//!
//! Scribe is where the flagship voice keeps its records -- session logs, batons, and
//! inventory -- and every one of them is a **Kyri** document: `format <name>` on the
//! first line, then `key value` fields, one per line, `#` comments and blank lines
//! ignored, no quotes and no braces. This file is the foundation the rest of Scribe
//! stands on: it **parses** a Kyri document into its fields and **dispatches by
//! format**, so the settings dashboard, the baton renderer, and the log index all read
//! from one honest reader.
//!
//! **Zero-copy.** A field is a pair of slices *into the source text* -- the reader never
//! copies a key or a value. The document borrows the bytes; the caller keeps them.
//! **Bounded.** The source length, the field count, all name a maximum, asserted at the
//! edge. A key may repeat (`think`, `file`), and the reader keeps every occurrence.
//!
//! The dashboard, the tilak-typing of fields (Q2's shared type-marks), and rendering on
//! Skate are horizons above this; here Scribe simply reads.
//!
//!   rye build scribe/reader.rye -femit-bin=scribe/bin/reader
//!   scribe/bin/reader selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const reader_version = "20260810.041230";

// A Kyri document's bounds: the longest source the reader accepts, and the most fields
// it holds. A voice's records are short; these are generous and named once.
pub const max_source_len: u32 = 65536;
pub const max_fields: u32 = 512;

/// One field -- a key and its value, each a slice *into the source text*. Zero-copy:
/// the reader points at the bytes, it does not own them.
pub const Field = struct {
    key: []const u8,
    val: []const u8,
};

/// A parsed Kyri document: its fields, how many, and the source they borrow from.
pub const Document = struct {
    fields: [max_fields]Field,
    count: u32,
    source: []const u8,

    /// The value of the first field with this key, or null. The forward read.
    pub fn get(self: *const Document, key: []const u8) ?[]const u8 {
        // invariant: the field count never runs past the bounded fields.
        assert(self.count <= max_fields);
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (std.mem.eql(u8, self.fields[i].key, key)) return self.fields[i].val;
        }
        return null;
    }

    /// How many fields carry this key -- a repeatable key like `think` keeps every one.
    pub fn count_key(self: *const Document, key: []const u8) u32 {
        var found: u32 = 0;
        var i: u32 = 0;
        while (i < self.count) : (i += 1) {
            if (std.mem.eql(u8, self.fields[i].key, key)) found += 1;
        }
        return found;
    }

    /// The document's format -- the value of its `format` field -- or null if it has none.
    pub fn format(self: *const Document) ?[]const u8 {
        return self.get("format");
    }
};

/// Parse Kyri text into a document, zero-copy. Each non-blank, non-comment line becomes
/// a field whose key is the text up to the first space and whose value is the rest;
/// both slice into `text`, which the caller must keep alive.
pub fn parse(text: []const u8) Document {
    // invariant: the source fits the bounded reader.
    assert(text.len <= max_source_len);
    const len: u32 = @intCast(text.len);
    var doc = Document{ .fields = undefined, .count = 0, .source = text };
    var i: u32 = 0;
    while (i < len) {
        if (doc.count >= max_fields) break;
        const start = i;
        while (i < len and text[i] != '\n') : (i += 1) {}
        const line = text[start..i];
        if (i < len) i += 1; // step over the newline
        // Blank lines and comments carry no field.
        if (line.len == 0 or line[0] == '#') continue;
        // The key runs to the first space; the value is the remainder (empty if none).
        var sp: u32 = 0;
        const line_len: u32 = @intCast(line.len);
        while (sp < line_len and line[sp] != ' ') : (sp += 1) {}
        const key = line[0..sp];
        const val = if (sp < line_len) line[sp + 1 ..] else line[line_len..line_len];
        doc.fields[doc.count] = .{ .key = key, .val = val };
        doc.count += 1;
    }
    // invariant: every field's key and value slice into the source we were given.
    assert(doc.count <= max_fields);
    return doc;
}

// --- format dispatch: Scribe reads a document by what it says it is ------

/// Whether a document is a well-formed **session log** -- its format says so and the
/// load-bearing fields are present.
pub fn is_session_log(doc: *const Document) bool {
    const fmt = doc.format() orelse return false;
    if (!std.mem.eql(u8, fmt, "session-log-v1")) return false;
    return doc.get("stamp") != null and doc.get("title") != null;
}

/// Whether a document is a **baton** -- a `.kyri` document with `format baton-v1`, the
/// form the counsel seated (no new extension; one notation, many formats).
pub fn is_baton(doc: *const Document) bool {
    const fmt = doc.format() orelse return false;
    return std.mem.eql(u8, fmt, "baton-v1");
}

/// Whether a document is an **inventory** -- `format inventory-v1` with its load-bearing
/// `stamp` present. The dashboard's third shelf, in the exact shape of the two above:
/// one honest reader, one more format, no sprawl.
pub fn is_inventory(doc: *const Document) bool {
    const fmt = doc.format() orelse return false;
    if (!std.mem.eql(u8, fmt, "inventory-v1")) return false;
    return doc.get("stamp") != null;
}

// --- the bat fleet: baton archetypes -----------------------------------
// A baton (`format baton-v1`) may declare an `archetype` -- a named shape, one of
// the fleet, telling a reader which fields to expect. Every name is a plain common
// noun (a galleon, a cutter) no one owns -- original coinages, never a named ship or
// company. One predicate per shape, in the pattern of `is_session_log`: it IS a
// baton, its archetype names the shape, and the shape's required fields are present.

/// The archetype a baton declares -- the value of its `archetype` field, or null.
pub fn archetype_of(doc: *const Document) ?[]const u8 {
    return doc.get("archetype");
}

fn is_archetype(doc: *const Document, name: []const u8) bool {
    if (!is_baton(doc)) return false;
    const a = archetype_of(doc) orelse return false;
    return std.mem.eql(u8, a, name);
}

/// A **Galleon** -- the full vision handoff: everything to disk so history may clear.
pub fn validates_galleon(doc: *const Document) bool {
    if (!is_archetype(doc, "galleon")) return false;
    return doc.get("manifest") != null and doc.get("seated") != null and
        doc.get("aspiration") != null and doc.get("next") != null and doc.count_key("gap") >= 1;
}

/// A **Cutter** -- the one-keystone lap: a single mechanical step, small on purpose.
pub fn validates_cutter(doc: *const Document) bool {
    if (!is_archetype(doc, "cutter")) return false;
    return doc.get("state") != null and doc.get("next") != null;
}

/// A **Barque** -- the round in progress: several doors open, none yet closed.
pub fn validates_barque(doc: *const Document) bool {
    if (!is_archetype(doc, "barque")) return false;
    return doc.get("state") != null and doc.get("next") != null and
        doc.get("witness") != null and doc.count_key("gap") >= 1;
}

/// A **Holdfast** -- the checkpoint: a named stop-before-cross gate and the hand to confirm it.
pub fn validates_holdfast(doc: *const Document) bool {
    if (!is_archetype(doc, "holdfast")) return false;
    return doc.get("state") != null and doc.get("gate") != null and
        doc.get("hand") != null and doc.get("next") != null;
}

/// A **Corsair** -- the audit sweep: each edge probed, each that held, each that fell.
pub fn validates_corsair(doc: *const Document) bool {
    if (!is_archetype(doc, "corsair")) return false;
    return doc.get("state") != null and doc.get("next") != null and
        doc.count_key("probe") >= 1 and doc.count_key("held") >= 1;
}

/// A **Ledgerworks** -- the portfolio roll-up: many modules gathered under one head.
pub fn validates_ledgerworks(doc: *const Document) bool {
    if (!is_archetype(doc, "ledgerworks")) return false;
    return doc.get("roll") != null and doc.get("stamp") != null and
        doc.get("next") != null and doc.count_key("member") >= 1;
}

// --- sibling extensions: .kyri and .bron -------------------------------
// The notation molted from **Bron** to **Kyri** on the maintainer's word, yet the two
// extensions are **siblings, not a succession**: Scribe reads and records both as one
// notation, one format family. A `.bron` session log and a `.kyri` session log are the
// same shape by different names; neither is a fossil the reader turns away.

/// Whether a filename carries a Scribe-recorded extension -- `.kyri` or its sibling `.bron`.
pub fn is_scribe_extension(name: []const u8) bool {
    return std.mem.endsWith(u8, name, ".kyri") or std.mem.endsWith(u8, name, ".bron");
}

// --- selftest -----------------------------------------------------------

const sample_log =
    \\format session-log-v1
    \\# a comment line, and a blank line follow
    \\
    \\stamp 20260810.041230
    \\title a scribe reader test
    \\think first step of reasoning
    \\think second step of reasoning
    \\file scribe/reader.rye the reader itself
    \\recommend keep-going build the dashboard next
;

const sample_baton =
    \\format baton-v1
    \\stamp 20260810.041230
    \\state six witnesses green
    \\next build scribe
;

fn prove_parse() !void {
    const doc = parse(sample_log);
    // Six fields survive: format, stamp, title, two thinks, one file, one recommend.
    if (doc.count != 7) return error.FieldCountWrong;
    // The format dispatches, and the load-bearing fields read back.
    const fmt = doc.format() orelse return error.NoFormat;
    if (!std.mem.eql(u8, fmt, "session-log-v1")) return error.FormatWrong;
    const stamp = doc.get("stamp") orelse return error.NoStamp;
    if (!std.mem.eql(u8, stamp, "20260810.041230")) return error.StampWrong;
    const title = doc.get("title") orelse return error.NoTitle;
    if (!std.mem.eql(u8, title, "a scribe reader test")) return error.TitleWrong;
    // A repeatable key keeps every occurrence; get returns the first.
    if (doc.count_key("think") != 2) return error.ThinkCountWrong;
    const first_think = doc.get("think") orelse return error.NoThink;
    if (!std.mem.eql(u8, first_think, "first step of reasoning")) return error.ThinkWrong;
    // A missing key reads null; comments and blanks became no fields.
    if (doc.get("absent") != null) return error.PhantomField;
}

fn prove_zero_copy() !void {
    const doc = parse(sample_log);
    // A field's value is a slice *into the source* -- same bytes, not a copy.
    const title = doc.get("title").?;
    // The slice lies within the source text's own memory.
    const src = doc.source;
    const within = @intFromPtr(title.ptr) >= @intFromPtr(src.ptr) and
        @intFromPtr(title.ptr) + title.len <= @intFromPtr(src.ptr) + src.len;
    if (!within) return error.NotZeroCopy;
}

fn prove_dispatch() !void {
    const log = parse(sample_log);
    if (!is_session_log(&log)) return error.LogNotRecognized;
    if (is_baton(&log)) return error.LogSeenAsBaton;

    const baton = parse(sample_baton);
    if (!is_baton(&baton)) return error.BatonNotRecognized;
    if (is_session_log(&baton)) return error.BatonSeenAsLog;
    // A baton reads its own fields by the same reader.
    if (!std.mem.eql(u8, baton.get("next").?, "build scribe")) return error.BatonFieldWrong;
}

fn prove_fleet() !void {
    // A Galleon carries the full handoff; the reader reads its archetype and shape.
    const galleon =
        \\format baton-v1
        \\archetype galleon
        \\stamp 20260810.094500
        \\manifest the whole cargo in one line
        \\seated three modules landed green
        \\aspiration the north star, consent-gated
        \\gap the first open door
        \\gap the second open door
        \\gap the third open door
        \\next open the first door
    ;
    const g = parse(galleon);
    if (!is_baton(&g)) return error.GalleonNotBaton;
    if (is_session_log(&g)) return error.GalleonSeenAsLog;
    const arch = archetype_of(&g) orelse return error.NoArchetype;
    if (!std.mem.eql(u8, arch, "galleon")) return error.ArchetypeWrong;
    if (!validates_galleon(&g)) return error.GalleonInvalid;
    if (g.count_key("gap") != 3) return error.GapCountWrong;

    // A short Galleon -- manifest removed -- fails, exactly as a log missing stamp fails.
    const short_galleon =
        \\format baton-v1
        \\archetype galleon
        \\stamp 20260810.094500
        \\seated one module
        \\aspiration a star
        \\gap one door
        \\next go
    ;
    const sg = parse(short_galleon);
    if (validates_galleon(&sg)) return error.ShortGalleonAccepted;

    // The other five shapes each validate their own required fields.
    const cutter = "format baton-v1\narchetype cutter\nstamp 20260810.094500\nstate one lap open\nnext do the lap\n";
    if (!validates_cutter(&parse(cutter))) return error.CutterInvalid;

    const barque = "format baton-v1\narchetype barque\nstamp 20260810.094500\nstate mid-round\ngap a door\nwitness GREEN\nnext close the door\n";
    if (!validates_barque(&parse(barque))) return error.BarqueInvalid;

    const holdfast = "format baton-v1\narchetype holdfast\nstamp 20260810.094500\nstate at a gate\ngate confirm the seam\nhand Claude\nnext wait for the ruling\n";
    if (!validates_holdfast(&parse(holdfast))) return error.HoldfastInvalid;

    const corsair = "format baton-v1\narchetype corsair\nstamp 20260810.094500\nstate audit done\nprobe the width seam\nprobe the name net\nheld the width seam\nheld the name net\nred none\nnext ship the fixes\n";
    if (!validates_corsair(&parse(corsair))) return error.CorsairInvalid;

    const ledgerworks = "format baton-v1\narchetype ledgerworks\nstamp 20260810.094500\nmember vault green\nmember basin green\nroll all green\nnext keep watch\n";
    if (!validates_ledgerworks(&parse(ledgerworks))) return error.LedgerworksInvalid;

    // A baton with a nonsense archetype validates as none of the six.
    const stray = "format baton-v1\narchetype schooner\nstamp 20260810.094500\nstate adrift\nnext name it or drop it\n";
    const st = parse(stray);
    if (validates_galleon(&st) or validates_cutter(&st)) return error.StrayValidated;
}

fn prove_siblings() !void {
    // .kyri and .bron are sibling extensions -- Scribe records both as one notation.
    if (!is_scribe_extension("session-logs/20260810-113354_a-log.kyri")) return error.KyriNotRecognized;
    if (!is_scribe_extension("session-logs/archive/20260713-201910_old.bron")) return error.BronNotRecognized;
    // A different extension is not Scribe's to record.
    if (is_scribe_extension("README.md")) return error.MdWronglyRecognized;
    if (is_scribe_extension("bron")) return error.BareWordWronglyRecognized;
}

fn run_selftest() !u8 {
    try prove_parse();
    try prove_zero_copy();
    try prove_dispatch();
    try prove_fleet();
    try prove_siblings();

    print("scribe reader: a Kyri document parses into key-value fields, zero-copy — each field slices into the source, never copied; a repeatable key keeps every occurrence.\n", .{});
    print("scribe reader: Scribe reads by format — a session-log-v1 and a baton-v1 are told apart and read by one honest reader, the counsel's one-notation-many-formats made real.\n", .{});
    print("scribe reader: the bat fleet — a baton may declare an archetype (galleon·cutter·barque·holdfast·corsair·ledgerworks), and the reader validates each shape's required fields, refusing a short one.\n", .{});
    print("scribe reader: .kyri and .bron are sibling extensions — the notation molted from Bron to Kyri, yet Scribe records both as one format family, neither a fossil.\n", .{});
    print("scribe reader: version {s}\n", .{reader_version});
    print("GREEN: scribe reader — the Kyri voice's home reads its own records: parse a document, dispatch by its format, get a field, count a repeated key — bounded and zero-copy.\n", .{});
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
