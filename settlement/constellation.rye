//! settlement/constellation.rye — the Sui settlement constellation.
//!
//! A galaxy and its d60 — five stars, sixty planets — settle as a constellation.
//! Where `../comlink/topology.rye` is the geometry (which number sits where) and
//! `../kumara/tilak.rye` is the deed (who holds a number, and how it moves), this
//! file is the **ledger**: who has settled, in what order, under whose authority.
//!
//! It models Sui's own split between owned and shared, faithfully:
//!
//!   * A **Deed** is the owned object — a point's identity, keeper, networking key,
//!     and counters. It rides the fast path in the owner's own hand; the network
//!     never needs it to agree, so it is never held on the shared surface.
//!   * A **Commitment** is the shared surface — the *only* thing the whole network
//!     reads together: a member's point, tier, sponsor, version, and a **digest**
//!     that binds its owned Deed. Small by design; no key ever sits here.
//!
//! The Constellation holds Commitments alone. Any transition that needs a member's
//! private facts (a parent's keeper to authorize a spawn, a sponsor's keeper to
//! adopt) requires that member's **Deed** to be presented and verified against its
//! commitment by digest — so the shared surface stays minimal, and private facts
//! are proven on demand rather than stored for all to read.
//!
//! It keeps the five commitments of the ledger shape, in our own words:
//!
//!   * A point is a single-keeper record — the fast path, no global ordering spent
//!     on one owner's affairs.
//!   * Powers are capability records — a `sow` cap spawns, a `hand` cap transfers, a
//!     `tend` cap rotates keys; the elder's proxies, our own tilaks.
//!   * Networking keys rotate on their own counters — a reset outranks a key bump,
//!     and the keeper's key never moves while the wire heals.
//!   * Sponsorship is a default, never a cage — a child settles under its real place
//!     in the fractal, yet may escape one tier up, by its word and the sponsor's.
//!   * The ledger accretes — a point settles once, and its version only climbs.
//!
//! This is the Rye-side model of what a Sui contract would enforce; no Move, no
//! wallet, no key, no chain touched. The example seeds are plainly not a real
//! pilot's — no identity is invented here.
//!
//!   rye build settlement/constellation.rye -femit-bin=settlement/bin/constellation
//!   settlement/bin/constellation selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const kumara = @import("kumara.rye");
const tilak = @import("kumara_tilak.rye");
const topology = @import("topology.rye");

const Sha256 = std.crypto.hash.sha2.Sha256;

pub const constellation_version = "20260810.004547";

const pubkey_len: u32 = 32;
const sig_len: u32 = 64;
const digest_len: u32 = 32;

// A galaxy crowns its own circle: itself, its five stars, and their sixty planets.
// Sixty-six commitments at most — the d60 of prosperity plus the six that lead it.
// The shared surface a constellation ever holds is bounded here, once, by name.
pub const constellation_max: u32 = 1 + topology.stars_per_galaxy + topology.d60; // 66

// The unconfigured networking key: all zeros is not a valid Ed25519 point, so it
// can never collide with a real key, and it marks a point that has never rotated.
const no_net_key: [pubkey_len]u8 = .{0} ** pubkey_len;

pub const SettleError = error{
    Full,
    AlreadySettled,
    ParentNotSettled,
    NotSettled,
    StaleDeed,
    WrongSponsor,
    BadBind,
    BadAuthority,
    WrongPower,
    BadTurn,
    StaleTurn,
    NumberOutOfUniverse,
    NotGenesis,
    CannotEscape,
    NotAnEscape,
    BadSponsor,
};

/// The owned object — the fast path. A point's identity signs its turns; the keeper
/// owns it and grants its powers; the networking key and counters heal the wire. All
/// of this is the owner's own business; the network never needs it to agree, so it
/// lives in the owner's hand, never on the shared surface. The version climbs by
/// exactly one on every change, like a Sui object's version.
pub const Deed = struct {
    point: u32,
    tier: topology.Tier,
    identity_key: [pubkey_len]u8, // signs turns — the bind's key side
    keeper: [pubkey_len]u8, // owns the point, grants caps — the bind's keeper side
    sponsor: u32, // the parent point in the fractal
    net_key: [pubkey_len]u8, // current networking key; `no_net_key` until first rotation
    key_counter: u64, // climbs on an ordinary rotation
    reset_counter: u64, // climbs when continuity starts over
    version: u64, // climbs by exactly one per change
};

// The Deed on the wire, a fixed 129 bytes, so its digest is the same on every
// target. Point, tier, both keys, sponsor, networking key, both counters, version —
// the whole owned state, canonically ordered.
const deed_wire_len: u32 = 4 + 1 + pubkey_len + pubkey_len + 4 + pubkey_len + 8 + 8 + 8; // 129

fn deed_to_bytes(deed: *const Deed) [deed_wire_len]u8 {
    var out: [deed_wire_len]u8 = undefined;
    std.mem.writeInt(u32, out[0..4], deed.point, .little);
    out[4] = @intFromEnum(deed.tier);
    for (deed.identity_key, 0..) |b, i| out[5 + i] = b;
    for (deed.keeper, 0..) |b, i| out[37 + i] = b;
    std.mem.writeInt(u32, out[69..73], deed.sponsor, .little);
    for (deed.net_key, 0..) |b, i| out[73 + i] = b;
    std.mem.writeInt(u64, out[105..113], deed.key_counter, .little);
    std.mem.writeInt(u64, out[113..121], deed.reset_counter, .little);
    std.mem.writeInt(u64, out[121..129], deed.version, .little);
    return out;
}

/// The digest that the shared surface commits to — a hash of the whole owned Deed,
/// so a presented Deed can be proven to be the committed one without the surface
/// ever holding a key.
fn deed_digest(deed: *const Deed) [digest_len]u8 {
    const bytes = deed_to_bytes(deed);
    var out: [digest_len]u8 = undefined;
    Sha256.hash(&bytes, &out, .{});
    return out;
}

/// The shared surface — the only record the whole network reads together. A member's
/// place and freshness, and a digest binding its owned Deed. It carries no key, no
/// counter; those ride the fast path in the Deed.
pub const Commitment = struct {
    point: u32,
    tier: topology.Tier,
    sponsor: u32,
    version: u64,
    digest: [digest_len]u8, // binds the full owned Deed at this version
};

comptime {
    // invariant: the shared surface is strictly smaller than the owned deed — the
    // whole point of the shrink, proven at compile time.
    assert(@sizeOf(Commitment) < @sizeOf(Deed));
}

/// Commit a Deed to its shared record. The structural facts are copied for reading;
/// the digest binds every field, including the keys the Commitment does not hold.
fn commit(deed: *const Deed) Commitment {
    return .{
        .point = deed.point,
        .tier = deed.tier,
        .sponsor = deed.sponsor,
        .version = deed.version,
        .digest = deed_digest(deed),
    };
}

/// Whether a Deed is the one a Commitment binds — same point, same version, same
/// digest. The digest covers the whole owned state, so a tampered key fails here.
fn commitment_matches(c: *const Commitment, deed: *const Deed) bool {
    if (c.point != deed.point) return false;
    if (c.version != deed.version) return false;
    return std.mem.eql(u8, &c.digest, &deed_digest(deed));
}

/// The whole settled circle of one galaxy — a bounded array of commitments and how
/// many are filled. The array never reallocates, so a pointer into it stays valid
/// across a later settlement; the bound is `constellation_max`, enforced at mint.
pub const Constellation = struct {
    galaxy: u8,
    slots: [constellation_max]Commitment,
    filled: u32,

    /// Find a member's commitment by point number, or null — the shared-surface read.
    pub fn member(self: *const Constellation, point: u32) ?*const Commitment {
        // invariant: the fill count never runs past the bounded slots.
        assert(self.filled <= constellation_max);
        var i: u32 = 0;
        while (i < self.filled) : (i += 1) {
            if (self.slots[i].point == point) return &self.slots[i];
        }
        return null;
    }

    /// Whether a point has settled into this constellation.
    pub fn is_settled(self: *const Constellation, point: u32) bool {
        return self.member(point) != null;
    }

    // A mutable commitment, for the transitions that climb a member's version.
    fn slot_of(self: *Constellation, point: u32) ?*Commitment {
        // invariant: the fill count never runs past the bounded slots.
        assert(self.filled <= constellation_max);
        var i: u32 = 0;
        while (i < self.filled) : (i += 1) {
            if (self.slots[i].point == point) return &self.slots[i];
        }
        return null;
    }
};

/// The shared surface proves a presented Deed is the current member it claims to be:
/// the point is a member, and its Deed matches the commitment by version and digest.
/// This is the whole value of the split — anyone can verify an owned Deed against the
/// small shared record, with no key ever leaving the owner's hand.
pub fn verify(con: *const Constellation, deed: *const Deed) bool {
    const c = con.member(deed.point) orelse return false;
    return commitment_matches(c, deed);
}

// The authority message a power-holder signs to exercise a capability over a point:
// the point number, little-endian, then the 32-byte subject the act concerns (a
// spawned child's identity, or a transfer's new keeper). 36 bytes, same on every
// target, so possessing the cap record is never enough — the holder's key must sign.
const authority_msg_len: u32 = 4 + pubkey_len; // 36

fn authority_message(out: *[authority_msg_len]u8, number: u32, subject: *const [pubkey_len]u8) void {
    std.mem.writeInt(u32, out[0..4], number, .little);
    for (subject, 0..) |b, i| out[4 + i] = b;
}

/// Verify that `holder` signed this exact authority message. A valid capability
/// record names its holder; this proves the holder actually authorized *this* act,
/// closing the gap a replayed public cap record would otherwise open.
fn verify_authority(holder: [pubkey_len]u8, number: u32, subject: *const [pubkey_len]u8, sig: *const [sig_len]u8) bool {
    const pub_key = kumara.PublicKey.fromBytes(holder) catch return false;
    var msg: [authority_msg_len]u8 = undefined;
    authority_message(&msg, number, subject);
    kumara.verify_bytes(&msg, sig, pub_key) catch return false;
    return true;
}

/// A turn is fresher than a deed's current state when its reset counter climbs, or —
/// resets equal — its key counter climbs. The very first key (from `no_net_key`) is
/// fresher than nothing. This is the wire's own `turn_route` rule, so the ledger and
/// the network agree on which rotation supersedes.
fn turn_is_fresher(t: *const tilak.Turn, deed: *const Deed) bool {
    // invariant: an unconfigured point admits its first verified turn as baseline.
    if (std.mem.eql(u8, &deed.net_key, &no_net_key)) return true;
    if (t.reset_counter != deed.reset_counter) return t.reset_counter > deed.reset_counter;
    return t.key_counter > deed.key_counter;
}

/// Open a constellation on a galaxy — the genesis settlement. A galaxy is the root of
/// its own tree, so no spawn capability authorizes it; its own bind is the whole
/// warrant. Returns the constellation with the galaxy's commitment, and the galaxy's
/// own Deed for the owner to keep. Every later member chains here.
pub const Opened = struct { con: Constellation, deed: Deed };

pub fn open(galaxy_number: u32, galaxy_bind: *const tilak.Bind) SettleError!Opened {
    const addr = topology.decode(galaxy_number) orelse return error.NumberOutOfUniverse;
    // invariant: a constellation is crowned by a galaxy, never a star or a planet.
    if (addr.tier != .galaxy) return error.NotGenesis;
    // invariant: the genesis bind must truly marry its keys, or the root is a forgery.
    if (!tilak.verify_bind(galaxy_bind)) return error.BadBind;
    const deed = Deed{
        .point = galaxy_number,
        .tier = .galaxy,
        .identity_key = galaxy_bind.kumara_pubkey,
        .keeper = galaxy_bind.keeper_pubkey,
        .sponsor = galaxy_number, // a galaxy sponsors itself — the root of its tree
        .net_key = no_net_key,
        .key_counter = 0,
        .reset_counter = 0,
        .version = 1,
    };
    var con = Constellation{ .galaxy = addr.galaxy, .slots = undefined, .filled = 0 };
    con.slots[0] = commit(&deed);
    con.filled = 1;
    // invariant: genesis seats exactly the galaxy, at version one, and its deed
    // verifies against the fresh commitment.
    assert(con.filled == 1);
    assert(con.slots[0].version == 1);
    assert(verify(&con, &deed));
    return .{ .con = con, .deed = deed };
}

/// Settle a child under a parent already in the constellation. The parent's own Deed
/// is presented — verified against its commitment, so a forged parent cannot spawn —
/// and its keeper's spawn (`sow`) capability, signed for this exact child, authorizes
/// the birth. The child's own bind proves its keys; topology fixes its sponsor.
/// Returns the child's Deed for the new owner to keep.
pub fn mint(
    con: *Constellation,
    parent_deed: *const Deed,
    child_number: u32,
    child_bind: *const tilak.Bind,
    sow_cap: *const tilak.Cap,
    spawn_sig: *const [sig_len]u8,
) SettleError!Deed {
    // invariant: the bounded circle never overflows its slots.
    if (con.filled >= constellation_max) return error.Full;
    // invariant: the presented parent must be the real current parent — its deed
    // matches its commitment on the shared surface.
    if (!verify(con, parent_deed)) return error.ParentNotSettled;
    // invariant: a point settles once — the ledger accretes, never re-mints.
    if (con.is_settled(child_number)) return error.AlreadySettled;
    const child_addr = topology.decode(child_number) orelse return error.NumberOutOfUniverse;
    // invariant: the child's topology sponsor is exactly the parent presented — a
    // point settles under its real place in the fractal, never a claimed one.
    if (topology.encode(child_addr.parent()) != parent_deed.point) return error.WrongSponsor;
    // invariant: the child's bind must verify, or its identity and keeper are unproven.
    if (!tilak.verify_bind(child_bind)) return error.BadBind;
    // invariant: the cap must be a real `sow` grant over the parent, signed by the
    // parent's own keeper — the only hand that may spawn beneath it.
    if (sow_cap.power != .sow) return error.WrongPower;
    if (sow_cap.point_number != parent_deed.point) return error.BadAuthority;
    if (!tilak.verify_cap(sow_cap, parent_deed.keeper)) return error.BadAuthority;
    // invariant: the cap's holder must sign this specific child, so a public cap
    // record alone can never spawn — the holder's key is the true authority.
    if (!verify_authority(sow_cap.holder, child_number, &child_bind.kumara_pubkey, spawn_sig)) return error.BadAuthority;

    const deed = Deed{
        .point = child_number,
        .tier = child_addr.tier,
        .identity_key = child_bind.kumara_pubkey,
        .keeper = child_bind.keeper_pubkey,
        .sponsor = parent_deed.point,
        .net_key = no_net_key,
        .key_counter = 0,
        .reset_counter = 0,
        .version = 1,
    };
    con.slots[con.filled] = commit(&deed);
    con.filled += 1;
    // invariant: a fresh settlement seats at version one, reads back as a member, and
    // its returned deed verifies against the shared surface.
    assert(con.slots[con.filled - 1].version == 1);
    assert(con.is_settled(child_number));
    assert(verify(con, &deed));
    return deed;
}

/// Hand a settled point to a new keeper. The point's current Deed is presented and
/// checked against the shared surface; its keeper's transfer (`hand`) capability,
/// signed for this exact new keeper, authorizes the move. Returns the new Deed; the
/// shared surface climbs to its digest.
pub fn transfer(
    con: *Constellation,
    deed: *const Deed,
    new_keeper: [pubkey_len]u8,
    hand_cap: *const tilak.Cap,
    transfer_sig: *const [sig_len]u8,
) SettleError!Deed {
    const c = con.member(deed.point) orelse return error.NotSettled;
    // invariant: the presented deed must be the current one — no stale deed transfers.
    if (!commitment_matches(c, deed)) return error.StaleDeed;
    // invariant: only a real `hand` grant over this point, signed by its current
    // keeper, moves it — the elder's transfer proxy, our own record.
    if (hand_cap.power != .hand) return error.WrongPower;
    if (hand_cap.point_number != deed.point) return error.BadAuthority;
    if (!tilak.verify_cap(hand_cap, deed.keeper)) return error.BadAuthority;
    // invariant: the holder must sign this exact new keeper, so the handoff is
    // deliberate — never a replay of an old grant.
    if (!verify_authority(hand_cap.holder, deed.point, &new_keeper, transfer_sig)) return error.BadAuthority;
    var next = deed.*;
    next.keeper = new_keeper;
    next.version = deed.version + 1;
    con.slot_of(deed.point).?.* = commit(&next);
    // invariant: a transfer climbs the version by one, and the new deed verifies.
    assert(next.version == deed.version + 1);
    assert(verify(con, &next));
    return next;
}

/// Rotate a settled point's networking key. The point's current Deed is presented and
/// checked; its keeper's management (`tend`) capability authorizes, and the new key
/// arrives as a signed turn the point's identity key vouches for. The keeper never
/// moves — a compromised ship heals its wire while its deed sits cold. Returns the new
/// Deed; the shared surface climbs.
pub fn rotate(
    con: *Constellation,
    deed: *const Deed,
    new_turn: *const tilak.Turn,
    tend_cap: *const tilak.Cap,
) SettleError!Deed {
    const c = con.member(deed.point) orelse return error.NotSettled;
    // invariant: the presented deed must be the current one — no stale deed rotates.
    if (!commitment_matches(c, deed)) return error.StaleDeed;
    // invariant: only a real `tend` grant over this point, signed by its keeper, rotates.
    if (tend_cap.power != .tend) return error.WrongPower;
    if (tend_cap.point_number != deed.point) return error.BadAuthority;
    if (!tilak.verify_cap(tend_cap, deed.keeper)) return error.BadAuthority;
    // invariant: the turn must verify under the point's own identity key — a rotation
    // is authentic, never a key someone else pushed.
    if (!tilak.verify_turn(new_turn, deed.identity_key)) return error.BadTurn;
    // invariant: the turn must be strictly fresher, so a replay can never re-key.
    if (!turn_is_fresher(new_turn, deed)) return error.StaleTurn;
    var next = deed.*;
    next.net_key = new_turn.net_pubkey;
    next.key_counter = new_turn.key_counter;
    next.reset_counter = new_turn.reset_counter;
    next.version = deed.version + 1;
    con.slot_of(deed.point).?.* = commit(&next);
    // invariant: rotation never moves the keeper, and climbs the version by one.
    assert(std.mem.eql(u8, &next.keeper, &deed.keeper));
    assert(next.version == deed.version + 1);
    return next;
}

// The tier a child's sponsor must hold — one step up the fractal. A galaxy is the
// root of its own tree and has no sponsor, so it can never escape.
fn sponsor_tier(child: topology.Tier) ?topology.Tier {
    return switch (child) {
        .galaxy => null,
        .star => .galaxy,
        .planet => .star,
    };
}

/// Escape — a child re-parents to a chosen sponsor. Sponsorship is a default, never a
/// cage. The move takes two words: the child's own identity signs the request (the
/// `sponsor` tilak), and the new sponsor's keeper signs its adoption — and because the
/// keeper lives only in the sponsor's Deed, the sponsor presents that Deed, verified
/// against its commitment. The old sponsor keeps no veto; the child's number never
/// moves, only whom it answers to. Returns the new Deed.
pub fn escape(
    con: *Constellation,
    deed: *const Deed,
    new_sponsor_deed: *const Deed,
    request: *const tilak.Sponsor,
    adopt_sig: *const [sig_len]u8,
) SettleError!Deed {
    const c = con.member(deed.point) orelse return error.NotSettled;
    // invariant: the presented child deed must be the current one.
    if (!commitment_matches(c, deed)) return error.StaleDeed;
    const child_addr = topology.decode(deed.point) orelse return error.NumberOutOfUniverse;
    // invariant: a galaxy is a root — it has no sponsor to escape to.
    const want_tier = sponsor_tier(child_addr.tier) orelse return error.CannotEscape;
    // invariant: an escape actually moves — re-parenting to the current sponsor is none.
    if (new_sponsor_deed.point == deed.sponsor) return error.NotAnEscape;
    // invariant: the new sponsor must be a real current member — its deed matches its
    // commitment, which is also how we come to hold its keeper honestly.
    if (!verify(con, new_sponsor_deed)) return error.NotSettled;
    // invariant: a child escapes to a sponsor exactly one tier up.
    if (new_sponsor_deed.tier != want_tier) return error.WrongSponsor;
    // invariant: the request is the child's own word — its identity signs the chosen
    // parent over this very point.
    if (!tilak.verify_sponsor(request, deed.identity_key)) return error.BadSponsor;
    if (request.point_number != deed.point or request.chosen_parent != new_sponsor_deed.point) return error.BadSponsor;
    // invariant: the new sponsor consents — its keeper signs the adoption of this
    // child, so no point can hang itself off an unwilling sponsor.
    if (!verify_authority(new_sponsor_deed.keeper, deed.point, &deed.identity_key, adopt_sig)) return error.BadAuthority;
    var next = deed.*;
    next.sponsor = new_sponsor_deed.point;
    next.version = deed.version + 1;
    con.slot_of(deed.point).?.* = commit(&next);
    // invariant: an escape climbs the version by one, and the sponsor really moved.
    assert(next.version == deed.version + 1);
    assert(next.sponsor == new_sponsor_deed.point);
    return next;
}

// --- selftest -----------------------------------------------------------

// Example seeds — plainly not a real pilot's key, so no identity is invented.
const g_key: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const g_keeper: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const s_key: [kumara.seed_length]u8 = .{0x44} ** kumara.seed_length;
const s_keeper: [kumara.seed_length]u8 = .{0x55} ** kumara.seed_length;
const p_key: [kumara.seed_length]u8 = .{0x77} ** kumara.seed_length;
const p_keeper: [kumara.seed_length]u8 = .{0x88} ** kumara.seed_length;
const p_net: [kumara.seed_length]u8 = .{0x99} ** kumara.seed_length;
const p_net_reset: [kumara.seed_length]u8 = .{0xbb} ** kumara.seed_length;
const new_owner: [kumara.seed_length]u8 = .{0xaa} ** kumara.seed_length;
const s2_key: [kumara.seed_length]u8 = .{0xcc} ** kumara.seed_length;
const s2_keeper: [kumara.seed_length]u8 = .{0xdd} ** kumara.seed_length;

// A sibling star under galaxy 3, for the planet to escape to: of_star(3,1) = 15.
const star2_num: u32 = 15;

// Topology numbers in the inclusive fractal: galaxy 3, its star (3,2) = 3 + 2·12 = 27,
// its planet (3,2,4) = 27 + 4·60 = 267. Sponsorship is by modulus: 267 mod 60 = 27,
// 27 mod 12 = 3.
const galaxy_num: u32 = 3;
const star_num: u32 = 27;
const planet_num: u32 = 267;

// The binds and caps the selftest settles from, seated once.
const Fixture = struct {
    g_bind: tilak.Bind,
    s_bind: tilak.Bind,
    p_bind: tilak.Bind,
    g_sow: tilak.Cap,
    s_sow: tilak.Cap,
    p_hand: tilak.Cap,
    p_tend: tilak.Cap,
};

fn seat_fixture() Fixture {
    const g_bind = tilak.make_bind(&g_key, &g_keeper);
    const s_bind = tilak.make_bind(&s_key, &s_keeper);
    const p_bind = tilak.make_bind(&p_key, &p_keeper);
    return .{
        .g_bind = g_bind,
        .s_bind = s_bind,
        .p_bind = p_bind,
        // Each parent keeper grants a spawn cap over its own point to its own key.
        .g_sow = tilak.make_cap(&g_keeper, galaxy_num, .sow, g_bind.kumara_pubkey),
        .s_sow = tilak.make_cap(&s_keeper, star_num, .sow, s_bind.kumara_pubkey),
        // The planet's keeper grants transfer and management over the planet.
        .p_hand = tilak.make_cap(&p_keeper, planet_num, .hand, p_bind.kumara_pubkey),
        .p_tend = tilak.make_cap(&p_keeper, planet_num, .tend, p_bind.kumara_pubkey),
    };
}

// The owner-held Deeds the selftest threads — each transition returns the next one.
const Deeds = struct {
    galaxy: Deed,
    star: Deed,
    star2: Deed,
    planet: Deed,
};

// A holder's authority signature over (number, subject), signed by `signer_seed`.
fn make_authority(signer_seed: *const [kumara.seed_length]u8, number: u32, subject: *const [pubkey_len]u8) [sig_len]u8 {
    const kp = kumara.keypair_from_seed(signer_seed);
    var msg: [authority_msg_len]u8 = undefined;
    authority_message(&msg, number, subject);
    return kumara.sign(&msg, kp, null).toBytes();
}

// A plausible but unsettled deed for a non-member point — used to prove refusals.
fn unsettled_deed(point: u32) Deed {
    const addr = topology.decode(point).?;
    return .{
        .point = point,
        .tier = addr.tier,
        .identity_key = no_net_key,
        .keeper = no_net_key,
        .sponsor = topology.encode(addr.parent()),
        .net_key = no_net_key,
        .key_counter = 0,
        .reset_counter = 0,
        .version = 1,
    };
}

// Grow the constellation: the genesis galaxy is already open in d.galaxy; spawn a
// star beneath it, then a planet beneath that.
fn prove_grow(con: *Constellation, fx: *const Fixture, d: *Deeds) !void {
    // invariant: the galaxy is settled, at version one, sponsoring itself.
    if (!con.is_settled(galaxy_num)) return error.GalaxyNotSettled;
    const g = con.member(galaxy_num).?;
    if (g.version != 1 or g.sponsor != galaxy_num or g.tier != .galaxy) return error.GenesisWrong;

    // The galaxy's own deed, holding its sow cap, spawns the star.
    const spawn_star = make_authority(&g_key, star_num, &fx.s_bind.kumara_pubkey);
    d.star = try mint(con, &d.galaxy, star_num, &fx.s_bind, &fx.g_sow, &spawn_star);
    const st = con.member(star_num).?;
    if (st.sponsor != galaxy_num or st.tier != .star or st.version != 1) return error.StarSettleWrong;

    // The star's own deed, holding its sow cap, spawns the planet.
    const spawn_planet = make_authority(&s_key, planet_num, &fx.p_bind.kumara_pubkey);
    d.planet = try mint(con, &d.star, planet_num, &fx.p_bind, &fx.s_sow, &spawn_planet);
    const pl = con.member(planet_num).?;
    if (pl.sponsor != star_num or pl.tier != .planet) return error.PlanetSettleWrong;
    // invariant: three members now — every one chains back to the galaxy.
    if (con.filled != 3) return error.FillWrong;
    var i: u32 = 0;
    while (i < con.filled) : (i += 1) {
        if (!con.is_settled(con.slots[i].sponsor)) return error.SponsorNotSettled;
    }
}

// Rotate the planet's key while its keeper still holds it — the keeper stays cold,
// the version climbs on both the deed and the shared surface, and a reset outranks.
fn prove_rotate(con: *Constellation, fx: *const Fixture, d: *Deeds) !void {
    const keeper_before = d.planet.keeper;
    const turn1 = tilak.make_turn(&p_key, &p_net, 1, 0);
    d.planet = try rotate(con, &d.planet, &turn1, &fx.p_tend);
    if (!std.mem.eql(u8, &d.planet.net_key, &turn1.net_pubkey)) return error.RotateDidNotSetKey;
    if (!std.mem.eql(u8, &d.planet.keeper, &keeper_before)) return error.RotateMovedKeeper;
    if (d.planet.version != 2 or d.planet.key_counter != 1) return error.RotateVersionWrong;
    if (con.member(planet_num).?.version != 2) return error.SurfaceVersionWrong;

    // A reset outranks a key bump — reset_counter 1 supersedes key_counter 1.
    const turn_reset = tilak.make_turn(&p_key, &p_net_reset, 0, 1);
    d.planet = try rotate(con, &d.planet, &turn_reset, &fx.p_tend);
    if (d.planet.reset_counter != 1 or d.planet.version != 3) return error.ResetWrong;
}

// Escape — settle a sibling star, then let the planet re-parent to it. Both the
// child's word and the new sponsor's Deed-and-adoption sign; the number never moves.
fn prove_escape(con: *Constellation, fx: *const Fixture, d: *Deeds) !void {
    const s2_bind = tilak.make_bind(&s2_key, &s2_keeper);
    const spawn_s2 = make_authority(&g_key, star2_num, &s2_bind.kumara_pubkey);
    d.star2 = try mint(con, &d.galaxy, star2_num, &s2_bind, &fx.g_sow, &spawn_s2);

    if (d.planet.sponsor != star_num) return error.EscapeStartWrong;
    const request = tilak.make_sponsor(&p_key, planet_num, star_num, star2_num);
    const adopt = make_authority(&s2_keeper, planet_num, &fx.p_bind.kumara_pubkey);
    d.planet = try escape(con, &d.planet, &d.star2, &request, &adopt);
    if (d.planet.sponsor != star2_num or d.planet.version != 4) return error.EscapeWrong;
    // invariant: the arithmetic default is unmoved — the planet still sits under star
    // 29 in the fractal, yet answers to star 27; the default is a cage no longer.
    const default_parent = topology.encode(topology.decode(planet_num).?.parent());
    if (default_parent != star_num) return error.DefaultMoved;
    if (d.planet.sponsor == default_parent) return error.EscapeNotRecorded;
}

// Every refusal escape owes: a galaxy has no sponsor to leave; the target must be
// settled, one tier up, and different; the request and the adoption must both be real.
fn prove_escape_refusals(con: *Constellation, d: *Deeds) !void {
    const zero_sig: [sig_len]u8 = .{0} ** sig_len;

    // A galaxy is the root of its own tree — it cannot escape.
    const g_req = tilak.make_sponsor(&g_key, galaxy_num, galaxy_num, star_num);
    if (escape(con, &d.galaxy, &d.star, &g_req, &zero_sig)) |_| return error.GalaxyEscaped else |e| {
        if (e != error.CannotEscape) return error.GalaxyEscapeWrongError;
    }
    // The planet already answers to its escaped sponsor, star 15; re-parenting there is none.
    const same = tilak.make_sponsor(&p_key, planet_num, star_num, star2_num);
    if (escape(con, &d.planet, &d.star2, &same, &zero_sig)) |_| return error.NoOpEscaped else |e| {
        if (e != error.NotAnEscape) return error.NoOpWrongError;
    }
    // A sponsor that never settled cannot adopt — an unsettled star-39 deed (of_star(3,3)).
    const absent_deed = unsettled_deed(39);
    const absent = tilak.make_sponsor(&p_key, planet_num, star2_num, 39);
    if (escape(con, &d.planet, &absent_deed, &absent, &zero_sig)) |_| return error.AbsentAdopted else |e| {
        if (e != error.NotSettled) return error.AbsentWrongError;
    }
    // The galaxy is settled, yet a planet's sponsor must be a star, never a galaxy.
    const wrong_tier = tilak.make_sponsor(&p_key, planet_num, star2_num, galaxy_num);
    if (escape(con, &d.planet, &d.galaxy, &wrong_tier, &zero_sig)) |_| return error.WrongTierAdopted else |e| {
        if (e != error.WrongSponsor) return error.WrongTierWrongError;
    }
    // A forged request — the identity never signed it — refuses before any adoption.
    var forged = tilak.make_sponsor(&p_key, planet_num, star2_num, star_num);
    forged.sig[0] ^= 0x01;
    if (escape(con, &d.planet, &d.star, &forged, &zero_sig)) |_| return error.ForgedRequestAdopted else |e| {
        if (e != error.BadSponsor) return error.ForgedRequestWrongError;
    }
    // A genuine request with a forged adoption refuses — the sponsor never consented.
    const genuine = tilak.make_sponsor(&p_key, planet_num, star2_num, star_num);
    if (escape(con, &d.planet, &d.star, &genuine, &zero_sig)) |_| return error.ForgedAdoptAccepted else |e| {
        if (e != error.BadAuthority) return error.ForgedAdoptWrongError;
    }
}

// Every refusal the ledger owes: orphan parent, wrong sponsor, forged cap, forged
// spawn signature, a re-mint, a stale rotation, and a turn signed by the wrong key.
fn prove_refusals(con: *Constellation, fx: *const Fixture, d: *Deeds) !void {
    const other_bind = tilak.make_bind(&new_owner, &new_owner);
    const zero_sig: [sig_len]u8 = .{0} ** sig_len;

    // A planet whose star (39) was never settled cannot mint — present an unsettled
    // parent deed; the shared surface has no commitment for it. Planet 99 = of_planet(3,3,1).
    const orphan_parent = unsettled_deed(39);
    if (mint(con, &orphan_parent, 99, &other_bind, &fx.s_sow, &zero_sig)) |_| return error.OrphanAccepted else |e| {
        if (e != error.ParentNotSettled) return error.OrphanWrongError;
    }
    // Claiming the wrong sponsor: planet 327 = of_planet(3,2,5) belongs under star 27,
    // not the galaxy — presenting the galaxy's deed as its parent refuses (327 mod 60 = 27).
    if (mint(con, &d.galaxy, 327, &other_bind, &fx.g_sow, &zero_sig)) |_| return error.WrongSponsorAccepted else |e| {
        if (e != error.WrongSponsor) return error.WrongSponsorWrongError;
    }
    // A forged spawn cap (flipped signature) refuses — the keeper never signed it.
    // Planet 387 = of_planet(3,2,6), a genuine child of star 27.
    var bad_sow = fx.s_sow;
    bad_sow.sig[0] ^= 0x01;
    const spawn387 = make_authority(&s_key, 387, &other_bind.kumara_pubkey);
    if (mint(con, &d.star, 387, &other_bind, &bad_sow, &spawn387)) |_| return error.ForgedCapAccepted else |e| {
        if (e != error.BadAuthority) return error.ForgedCapWrongError;
    }
    // A valid cap with a forged holder signature refuses — the public cap record is
    // never enough; the holder's key must sign this child.
    if (mint(con, &d.star, 387, &other_bind, &fx.s_sow, &zero_sig)) |_| return error.ForgedSpawnAccepted else |e| {
        if (e != error.BadAuthority) return error.ForgedSpawnWrongError;
    }
    // A point settles once — re-minting the planet refuses.
    const respawn = make_authority(&s_key, planet_num, &fx.p_bind.kumara_pubkey);
    if (mint(con, &d.star, planet_num, &fx.p_bind, &fx.s_sow, &respawn)) |_| return error.RemintAccepted else |e| {
        if (e != error.AlreadySettled) return error.RemintWrongError;
    }
    // A stale rotation refuses — replaying the first turn cannot re-key.
    const stale = tilak.make_turn(&p_key, &p_net, 1, 0);
    if (rotate(con, &d.planet, &stale, &fx.p_tend)) |_| return error.StaleAccepted else |e| {
        if (e != error.StaleTurn) return error.StaleWrongError;
    }
    // A turn signed by the wrong identity refuses — only the point's own key rotates it.
    const forged_turn = tilak.make_turn(&g_key, &p_net, 9, 9);
    if (rotate(con, &d.planet, &forged_turn, &fx.p_tend)) |_| return error.ForgedTurnAccepted else |e| {
        if (e != error.BadTurn) return error.ForgedTurnWrongError;
    }
    // Membership reads true for the settled, false for the absent.
    if (!con.is_settled(galaxy_num) or !con.is_settled(star_num) or !con.is_settled(planet_num)) return error.MembershipWrong;
    if (con.is_settled(500)) return error.PhantomMember;
}

// Hand the planet to a new keeper — the last act the old keeper's cap authorizes.
fn prove_transfer(con: *Constellation, fx: *const Fixture, d: *Deeds) !void {
    const new_keeper = tilak.pubkey_of(&new_owner);
    const xfer = make_authority(&p_key, planet_num, &new_keeper);
    d.planet = try transfer(con, &d.planet, new_keeper, &fx.p_hand, &xfer);
    if (!std.mem.eql(u8, &d.planet.keeper, &new_keeper)) return error.TransferKeptOldKeeper;
    // invariant: rotate, reset, and escape each climbed the version once, then transfer.
    if (d.planet.version != 5) return error.TransferVersionWrong;
}

// The shared surface itself: it verifies the current owned deed and refuses a stale
// one, a tampered one, and a ghost — the digest binds the whole owned state, and the
// keys never sit on the surface.
fn prove_shared_surface(con: *Constellation, d: *Deeds) !void {
    // The current deed verifies against its commitment.
    if (!verify(con, &d.planet)) return error.CurrentDeedRejected;

    // A stale deed — an older version the owner has rotated past — is refused.
    var stale = d.planet;
    stale.version = d.planet.version - 1;
    if (verify(con, &stale)) return error.StaleDeedAccepted;

    // A tampered deed — same version, a changed keeper — is refused; the digest binds
    // the whole owned state, not merely its version.
    var tampered = d.planet;
    tampered.keeper[0] ^= 0x01;
    if (verify(con, &tampered)) return error.TamperedDeedAccepted;

    // A deed for a point that never settled is refused.
    const ghost = unsettled_deed(500);
    if (verify(con, &ghost)) return error.GhostDeedAccepted;
}

fn run_selftest() !u8 {
    const fx = seat_fixture();
    const opened = try open(galaxy_num, &fx.g_bind);
    var con = opened.con;
    var d: Deeds = undefined;
    d.galaxy = opened.deed;

    try prove_grow(&con, &fx, &d);
    try prove_rotate(&con, &fx, &d);
    try prove_escape(&con, &fx, &d);
    try prove_escape_refusals(&con, &d);
    try prove_refusals(&con, &fx, &d);
    try prove_transfer(&con, &fx, &d);
    try prove_shared_surface(&con, &d);

    print("settlement constellation: a galaxy and its d60 settle across five transitions — genesis, spawn by capability, transfer, rotation with a keeper that never moves, and a reset that outranks a key bump.\n", .{});
    print("settlement constellation: sponsorship is a default, never a cage — a planet escapes to a sibling star by its own word and the new sponsor's adoption, its number unmoved.\n", .{});
    print("settlement constellation: the shared surface is a small commitment — point, tier, sponsor, version, and a digest binding the owned deed; the keys ride the fast path in the deed, never on the surface.\n", .{});
    print("settlement constellation: the surface verifies a current deed and refuses a stale one, a tampered one, and a ghost — the digest binds the whole owned state.\n", .{});
    print("settlement constellation: every refusal holds — orphan parent, wrong sponsor, forged cap, forged spawn signature, a re-mint, a stale rotation, a turn signed by the wrong key, a galaxy that cannot escape, a forged request, a forged adoption.\n", .{});
    print("settlement constellation: version {s}\n", .{constellation_version});
    print("GREEN: settlement constellation — a small shared commitment binds each owned deed; a number settles once under its rightful sponsor, powers move by signed capability, keys rotate while the deed sits cold, and a child escapes without ever leaving its place.\n", .{});
    return 0;
}

pub fn main() !u8 {
    return run_selftest();
}
