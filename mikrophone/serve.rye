//! mikrophone/serve.rye — DREY9: the desk serves a wanted recording. The want-response to DREY8's have-advertisement:
//! given a content address a far hand asked for, the desk re-frames the held recording into exactly the wire frame that
//! carries it — or refuses `NotHeld` if it does not hold that address. Together with DREY7's catalog and DREY8's
//! manifest, this closes a complete, purely local content-addressed sync: advertise holdings → compute wanted → serve
//! each wanted → deposit verify-before-keep.
//!
//! Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY9.
//! Design read: active-designing/20260814-065650_drey9-desk-serves-a-wanted-recording-exploration.md
//! Stands on: mikrophone/catalog.rye (DREY7) — fetch a held payload by address; mikrophone/wire.rye (DREY1) — the one
//! proven framing path; mikrophone/session.rye (DREY0) — a committed session the frame reads.
//!
//! This rung stays purely LOCAL — `serve` yields the frame bytes; it moves them over no transport. Producing a frame
//! from a held recording crosses no gate; serving those bytes over a real network to a real far hand reaches the
//! Comlink-served custody gate (Season 1, Journey 2) and waits for the maintainer's word. No disk, no network, no key
//! signs, no funds (custody gate %2 untouched); the content address stays an integrity identity, not a signature.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mikrophone/serve.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const session = @import("session.rye");
const wire = @import("wire.rye");
const catalog = @import("catalog.rye");
const manifest = @import("manifest.rye");

pub const serve_version = "20260814.065650";

pub const ServeError = error{
    /// A serve was asked for an address the catalog does not hold — refused before a frame is built.
    NotHeld,
};

/// Serve a wanted recording — re-frame the payload the catalog holds under `address` into `out`, or refuse `NotHeld` if
/// the catalog does not hold it. Re-framing rebuilds a committed session from the held payload and calls `wire.frame`,
/// reusing the one proven framing path rather than inventing a second. Because the frame's Sha256 is computed over the
/// identical payload bytes, the served frame's content address equals the address asked for.
pub fn serve(cat: *const catalog.Catalog, address: catalog.Address, out: *wire.Frame) !void {
    const payload = catalog.fetch(cat, address) orelse return error.NotHeld;
    // invariant: a held payload is always bounded by the session ceiling, so a session can carry it whole.
    assert(payload.len <= session.max_samples);

    // Rebuild a committed session holding exactly the payload, then frame it through the one proven path.
    var s = session.Session.init();
    var i: u32 = 0;
    while (i < payload.len) : (i += 1) try session.capture(&s, payload[i]);
    try session.commit(&s);
    try wire.frame(&s, out);

    // invariant: the served frame carries exactly the held payload — content-preserving, verifiable by the far hand.
    const carried = try wire.deframe(out.bytes());
    assert(std.mem.eql(u8, carried, payload));
    // invariant: the served frame's content address equals the address asked for — the sync converges.
    assert(std.mem.eql(u8, &catalog.address_of(carried), &address));
}

// --- selftest: serve answers only what is held, the answer is content-preserving, the whole local loop converges, and
//     a tampered served frame still refuses ------------------------------------------------------------------------------

/// Frame the text as a committed session would carry it — so each block deposits from a real wire frame.
fn framed(text: []const u8) !wire.Frame {
    var s = session.Session.init();
    var i: u32 = 0;
    while (i < text.len) : (i += 1) try session.capture(&s, text[i]);
    try session.commit(&s);
    var f = wire.Frame{};
    try wire.frame(&s, &f);
    return f;
}

fn run_selftest() !u8 {
    // 1. Serve answers only what is held — a held address yields a frame; an absent address refuses NotHeld.
    {
        var cat = catalog.Catalog.init();
        var a = try framed("held recording");
        const addr = try catalog.deposit(&cat, a.bytes());
        var out = wire.Frame{};
        try serve(&cat, addr, &out);
        const carried = try wire.deframe(out.bytes());
        assert(std.mem.eql(u8, carried, "held recording"));

        const absent = catalog.address_of("never deposited");
        if (serve(&cat, absent, &out)) |_| {
            return error.ServedTheAbsent;
        } else |e| {
            if (e != error.NotHeld) return error.WrongNotHeld;
        }
    }

    // 2. The answer is content-preserving — the served frame's content address equals the address served, and a far
    //    hand deposits it under that same address.
    {
        var desk = catalog.Catalog.init();
        var a = try framed("prove the address");
        const addr = try catalog.deposit(&desk, a.bytes());
        var out = wire.Frame{};
        try serve(&desk, addr, &out);

        var far = catalog.Catalog.init();
        const landed = try catalog.deposit(&far, out.bytes());
        assert(std.mem.eql(u8, &landed, &addr));
        assert(std.mem.eql(u8, catalog.fetch(&far, addr).?, "prove the address"));
    }

    // 3. The whole local loop converges — a far hand holding a subset, given the desk's manifest, serves each wanted
    //    address and ends holding exactly what the desk holds.
    {
        var desk = catalog.Catalog.init();
        var a = try framed("alpha");
        var b = try framed("bravo");
        var c = try framed("charlie");
        _ = try catalog.deposit(&desk, a.bytes());
        _ = try catalog.deposit(&desk, b.bytes());
        _ = try catalog.deposit(&desk, c.bytes());

        // The desk advertises its holdings.
        var man = manifest.Manifest{};
        manifest.write_manifest(&desk, &man);
        const records = try manifest.verify(man.bytes());

        // The far hand already holds "bravo".
        var far = catalog.Catalog.init();
        var b2 = try framed("bravo");
        _ = try catalog.deposit(&far, b2.bytes());

        // For each advertised address the far hand wants, the desk serves it and the far hand deposits it.
        var served: u32 = 0;
        var i: u32 = 0;
        while (i < manifest.count_in(records)) : (i += 1) {
            if (!manifest.wanted(&far, records, i)) continue;
            const want_addr = manifest.address_in(records, i);
            var out = wire.Frame{};
            try serve(&desk, want_addr, &out);
            _ = try catalog.deposit(&far, out.bytes());
            served += 1;
        }
        // Two were wanted and served; the far hand now holds all three the desk holds.
        assert(served == 2);
        assert(catalog.count_of(&far) == 3);
        var j: u32 = 0;
        while (j < catalog.count_of(&desk)) : (j += 1) {
            const desk_addr = catalog.address_at(&desk, j);
            assert(catalog.holds(&far, desk_addr));
        }
    }

    // 4. A tampered served frame still refuses — the far hand's deposit is verify-before-trust, so a frame corrupted in
    //    the answer refuses DigestMismatch and lands nothing.
    {
        var desk = catalog.Catalog.init();
        var a = try framed("serve me whole");
        const addr = try catalog.deposit(&desk, a.bytes());
        var out = wire.Frame{};
        try serve(&desk, addr, &out);
        // Corrupt the served frame in transit.
        out.buf[wire.header_len] = out.buf[wire.header_len] ^ 0x01;

        var far = catalog.Catalog.init();
        if (catalog.deposit(&far, out.bytes())) |_| {
            return error.TamperLanded;
        } else |e| {
            if (e != error.DigestMismatch) return error.WrongTamper;
        }
        assert(catalog.count_of(&far) == 0);
    }

    print("GREEN drey-serve: the Mikrophone desk answers a want by re-framing the recording it holds — serve yields a " ++
        "frame for a held address and refuses NotHeld for an absent one, the answer is content-preserving (the served " ++
        "frame's content address equals the address asked for, and a far hand deposits it under that same address), the " ++
        "whole local loop converges (a far hand holding a subset, given the desk's manifest, serves each wanted address " ++
        "and ends holding exactly what the desk holds), and a tampered served frame refuses DigestMismatch and lands " ++
        "nothing. Catalog, manifest, serve — a complete local content-addressed sync, proven pure before metal; serving " ++
        "over a real transport stays the Comlink gate; no disk, no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
