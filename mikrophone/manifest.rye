//! mikrophone/manifest.rye — DREY8: the desk manifest of holdings. A bounded, self-describing, verify-before-trust
//! record of WHAT a content-addressed catalog holds — one entry per recording carrying its content address and payload
//! length, and no payload bytes at all. A far hand reads the manifest to learn the desk's holdings by address, then
//! computes exactly which recordings it still lacks (the have/want primitive), before a single payload byte crosses.
//!
//! Season A (Hardware & Right-to-Repair) · waymark DREY · Mikrophone firmware journey · rung DREY8.
//! Design read: active-designing/date/20260814/20260814-065231_drey8-desk-manifest-of-holdings-exploration.md
//! Stands on: mikrophone/catalog.rye (DREY7) — the content-addressed desk; and mikrophone/wire.rye (DREY1) — the same
//! verify-before-trust framing discipline, here over metadata rather than payload.
//!
//! This rung stays the HAVE side only — purely descriptive, purely local, read-only. Describing holdings crosses no
//! gate; SERVING the payloads a far hand wants reaches the Comlink-served custody gate (Season 1, Journey 2) and waits
//! for the maintainer's word. No disk, no network, no key signs, no funds (custody gate %2 untouched); the Sha256 over
//! the record region is an integrity check the reader recomputes, not a signature.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mikrophone/manifest.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const wire = @import("wire.rye");
const catalog = @import("catalog.rye");

const Sha256 = std.crypto.hash.sha2.Sha256;

pub const manifest_version = "20260814.065231";

/// The one version byte this manifest speaks. A manifest carrying a different version refuses `BadVersion` rather than
/// guessing at a layout it does not know.
pub const man_version: u8 = 1;

/// The four magic bytes that open every manifest — "MMAN" (Mikrophone MANifest). A blob that does not open with these
/// refuses `BadMagic` before any field is read.
pub const magic: [4]u8 = [4]u8{ 'M', 'M', 'A', 'N' };

/// One manifest record's width on the wire: a content address (a full Sha256) followed by the payload length as a u32.
/// No payload bytes — a record advertises identity and size, never content.
pub const record_len: u32 = wire.digest_len + 4;

/// The fixed header before the records: magic(4) · version(1) · count(u32, 4) · digest(32). Named once so the layout is
/// a single source of truth and `verify` can never read a field at the wrong offset.
pub const header_len: u32 = 4 + 1 + 4 + wire.digest_len;

/// The widest a whole manifest runs — the header plus a full catalog's worth of records. Bounded once by the catalog's
/// own entry ceiling, so a manifest can never outgrow the catalog it describes. No heap outlives this fixed buffer.
pub const max_manifest: u32 = header_len + catalog.max_entries * record_len;

pub const ManifestError = error{
    ManifestTooShort,
    BadMagic,
    BadVersion,
    CountOverflow,
    ManifestTruncated,
    DigestMismatch,
};

/// A bounded manifest blob: a fixed buffer sized for the widest possible manifest, and the length actually written.
/// `bytes()` reads back exactly the written region — never a byte past what `write_manifest` wrote.
pub const Manifest = struct {
    buf: [max_manifest]u8 = [_]u8{0} ** max_manifest,
    len: u32 = 0,

    /// The written manifest bytes as they stand — exactly the header plus records written by `write_manifest`.
    pub fn bytes(self: *const Manifest) []const u8 {
        // invariant: the manifest length never claims more than the buffer holds.
        assert(self.len <= self.buf.len);
        // invariant: a written manifest is at least a whole header — a manifest can advertise zero holdings, never less.
        assert(self.len == 0 or self.len >= header_len);
        return self.buf[0..self.len];
    }
};

/// Emit the manifest for a catalog — one record per kept recording, in first-deposit order, carrying its content
/// address and its payload length, and no payload bytes at all. Writes the record region first, digests it, then writes
/// the header. Every write is a plain bounded loop, never a bare memcpy.
pub fn write_manifest(cat: *const catalog.Catalog, out: *Manifest) void {
    const count = catalog.count_of(cat);
    // invariant: a catalog never holds more than its entry ceiling, so the manifest fits its fixed buffer.
    assert(count <= catalog.max_entries);

    // Records first, at the region just past the header.
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const base = header_len + i * record_len;
        const address = catalog.address_at(cat, i);
        var d: u32 = 0;
        while (d < wire.digest_len) : (d += 1) out.buf[base + d] = address[d];
        // The payload length — read back from the catalog's own fetch, so the advertised size is exactly what is held.
        const held = catalog.fetch(cat, address).?;
        const plen: u32 = @intCast(held.len);
        std.mem.writeInt(u32, out.buf[base + wire.digest_len ..][0..4], plen, .little);
    }
    const records_end = header_len + count * record_len;

    // magic (4)
    var m: u32 = 0;
    while (m < magic.len) : (m += 1) out.buf[m] = magic[m];
    // version (1)
    out.buf[4] = man_version;
    // count (u32, little-endian)
    std.mem.writeInt(u32, out.buf[5..9], count, .little);
    // digest (32) — Sha256 over the record region only, so a flipped address or length fails the check
    var dg: [wire.digest_len]u8 = undefined;
    Sha256.hash(out.buf[header_len..records_end], &dg, .{});
    var g: u32 = 0;
    while (g < wire.digest_len) : (g += 1) out.buf[9 + g] = dg[g];

    out.len = records_end;
    // invariant: the whole manifest is header plus count records, within the fixed buffer.
    assert(out.len == header_len + count * record_len);
    assert(out.len <= out.buf.len);
}

/// Verify a manifest whole and return its record region — proving every field BEFORE a record is read. Each check runs
/// in order and returns on failure: too short for a header, wrong magic, wrong version, a count past the entry bound, a
/// truncated tail, and finally a Sha256 over the records that must match. Only when all pass is the record slice
/// returned.
pub fn verify(bytes: []const u8) ![]const u8 {
    // invariant: a manifest is at least a whole header — anything shorter cannot be read as one.
    if (bytes.len < header_len) return error.ManifestTooShort;
    // magic
    var i: u32 = 0;
    while (i < magic.len) : (i += 1) {
        if (bytes[i] != magic[i]) return error.BadMagic;
    }
    // version
    if (bytes[4] != man_version) return error.BadVersion;
    // declared count — never trusted past the entry ceiling, before any record read
    const count = std.mem.readInt(u32, bytes[5..9], .little);
    if (count > catalog.max_entries) return error.CountOverflow;
    // truncation — the bytes must actually hold the whole declared record region
    const whole = header_len + count * record_len;
    if (bytes.len < whole) return error.ManifestTruncated;
    // digest — recompute over the record region and match BEFORE yielding the slice
    const records = bytes[header_len..whole];
    var dg: [wire.digest_len]u8 = undefined;
    Sha256.hash(records, &dg, .{});
    var d: u32 = 0;
    while (d < wire.digest_len) : (d += 1) {
        if (bytes[9 + d] != dg[d]) return error.DigestMismatch;
    }
    // invariant: every check passed — the record region is proven whole and within the bound before it is returned.
    assert(count <= catalog.max_entries);
    assert(records.len == count * record_len);
    return records;
}

/// How many recordings a verified record region advertises.
pub fn count_in(records: []const u8) u32 {
    // invariant: a verified region is a whole number of records within the entry bound.
    assert(records.len % record_len == 0);
    const count: u32 = @intCast(records.len / record_len);
    assert(count <= catalog.max_entries);
    return count;
}

/// The content address advertised by the i-th record of a verified region. `i` must be within the count.
pub fn address_in(records: []const u8, i: u32) catalog.Address {
    // invariant: only an advertised record can be read — never past the count.
    assert(i < count_in(records));
    const base = i * record_len;
    var address: catalog.Address = undefined;
    var d: u32 = 0;
    while (d < wire.digest_len) : (d += 1) address[d] = records[base + d];
    return address;
}

/// The payload length advertised by the i-th record of a verified region. `i` must be within the count.
pub fn len_in(records: []const u8, i: u32) u32 {
    // invariant: only an advertised record can be read — never past the count.
    assert(i < count_in(records));
    const base = i * record_len + wire.digest_len;
    return std.mem.readInt(u32, records[base..][0..4], .little);
}

/// The have/want primitive: whether the i-th advertised address is one the local catalog does NOT already hold — the
/// recordings a far hand would need to ask for. A local catalog already holding an address wants nothing for it.
pub fn wanted(local: *const catalog.Catalog, records: []const u8, i: u32) bool {
    const address = address_in(records, i);
    const want = !catalog.holds(local, address);
    // invariant: wanting an address is exactly not holding it — one source of truth.
    assert(want == !catalog.holds(local, address));
    return want;
}

// --- selftest: a catalog's manifest round-trips exactly, carries no payload, refuses every corruption by name, and
//     answers have/want honestly ---------------------------------------------------------------------------------------

/// Frame the text as a committed session would carry it — capture, commit, frame — so each block deposits from a real
/// wire frame. Returns the frame; the caller reads `bytes()`.
fn framed(text: []const u8) !wire.Frame {
    const session = @import("session.rye");
    var s = session.Session.init();
    var i: u32 = 0;
    while (i < text.len) : (i += 1) try session.capture(&s, text[i]);
    try session.commit(&s);
    var f = wire.Frame{};
    try wire.frame(&s, &f);
    return f;
}

fn run_selftest() !u8 {
    // 1. Round-trip is exact — a catalog's manifest verifies and reads back the same count, and each advertised address
    //    and length equals the catalog's own.
    {
        var cat = catalog.Catalog.init();
        var a = try framed("first take");
        var b = try framed("second take longer");
        var c = try framed("third");
        const addr_a = try catalog.deposit(&cat, a.bytes());
        const addr_b = try catalog.deposit(&cat, b.bytes());
        const addr_c = try catalog.deposit(&cat, c.bytes());

        var man = Manifest{};
        write_manifest(&cat, &man);
        const records = try verify(man.bytes());
        assert(count_in(records) == 3);
        assert(std.mem.eql(u8, &address_in(records, 0), &addr_a));
        assert(std.mem.eql(u8, &address_in(records, 1), &addr_b));
        assert(std.mem.eql(u8, &address_in(records, 2), &addr_c));
        assert(len_in(records, 0) == "first take".len);
        assert(len_in(records, 1) == "second take longer".len);
        assert(len_in(records, 2) == "third".len);
    }

    // 2. No payload travels — the manifest's whole size is header + count*record_len, independent of payload size.
    {
        var cat = catalog.Catalog.init();
        // A large recording and a tiny one — the manifest is the same size per entry regardless.
        var big: [1000]u8 = undefined;
        var k: u32 = 0;
        while (k < big.len) : (k += 1) big[k] = 0xAB;
        var fbig = try framed(&big);
        var fsmall = try framed("x");
        _ = try catalog.deposit(&cat, fbig.bytes());
        _ = try catalog.deposit(&cat, fsmall.bytes());
        var man = Manifest{};
        write_manifest(&cat, &man);
        assert(man.bytes().len == header_len + 2 * record_len);
    }

    // 3. Every corruption refuses by name, before a record is yielded.
    {
        var cat = catalog.Catalog.init();
        var a = try framed("prove me whole");
        _ = try catalog.deposit(&cat, a.bytes());
        var man = Manifest{};
        write_manifest(&cat, &man);

        // Shorter than a whole header.
        if (verify(man.buf[0 .. header_len - 1])) |_| {
            return error.ShortSlipped;
        } else |e| {
            if (e != error.ManifestTooShort) return error.WrongShort;
        }
        // Flipped magic.
        {
            var m = man;
            m.buf[0] = 'X';
            if (verify(m.bytes())) |_| return error.MagicSlipped else |e| {
                if (e != error.BadMagic) return error.WrongMagic;
            }
        }
        // Wrong version.
        {
            var m = man;
            m.buf[4] = 2;
            if (verify(m.bytes())) |_| return error.VersionSlipped else |e| {
                if (e != error.BadVersion) return error.WrongVersion;
            }
        }
        // Count past the entry ceiling.
        {
            var m = man;
            std.mem.writeInt(u32, m.buf[5..9], catalog.max_entries + 1, .little);
            if (verify(m.bytes())) |_| return error.CountSlipped else |e| {
                if (e != error.CountOverflow) return error.WrongCount;
            }
        }
        // Truncated tail.
        if (verify(man.buf[0 .. man.len - 1])) |_| {
            return error.TruncatedSlipped;
        } else |e| {
            if (e != error.ManifestTruncated) return error.WrongTruncated;
        }
        // A flipped record byte refuses DigestMismatch.
        {
            var m = man;
            m.buf[header_len] = m.buf[header_len] ^ 0x01;
            if (verify(m.bytes())) |_| return error.TamperSlipped else |e| {
                if (e != error.DigestMismatch) return error.WrongTamper;
            }
        }
    }

    // 4. have/want is honest — a far hand holding a subset wants exactly the addresses it lacks, and none it holds.
    {
        // The desk holds three recordings; advertise them.
        var desk = catalog.Catalog.init();
        var a = try framed("alpha");
        var b = try framed("bravo");
        var c = try framed("charlie");
        _ = try catalog.deposit(&desk, a.bytes());
        _ = try catalog.deposit(&desk, b.bytes());
        _ = try catalog.deposit(&desk, c.bytes());
        var man = Manifest{};
        write_manifest(&desk, &man);
        const records = try verify(man.bytes());

        // A far hand already holds "bravo" — it wants alpha and charlie, not bravo.
        var far = catalog.Catalog.init();
        var b2 = try framed("bravo");
        _ = try catalog.deposit(&far, b2.bytes());

        var wanted_count: u32 = 0;
        var i: u32 = 0;
        while (i < count_in(records)) : (i += 1) {
            if (wanted(&far, records, i)) wanted_count += 1;
        }
        assert(wanted_count == 2);
        // The address the far hand already holds is not wanted.
        assert(!wanted(&far, records, 1)); // record 1 is "bravo", in first-deposit order
        // Both others are wanted.
        assert(wanted(&far, records, 0));
        assert(wanted(&far, records, 2));
    }

    // 5. An empty catalog advertises a valid, whole manifest of zero holdings.
    {
        var cat = catalog.Catalog.init();
        var man = Manifest{};
        write_manifest(&cat, &man);
        const records = try verify(man.bytes());
        assert(count_in(records) == 0);
        assert(man.bytes().len == header_len);
    }

    print("GREEN drey-manifest: the Mikrophone desk describes its holdings without shipping a payload — a catalog's " ++
        "manifest round-trips exactly (same count, each advertised address and length equal to the catalog's own), its " ++
        "size is header + count records regardless of how large the recordings are, every corruption refuses by name " ++
        "before a record is yielded (ManifestTooShort, BadMagic, BadVersion, CountOverflow, ManifestTruncated, " ++
        "DigestMismatch), and have/want is honest (a far hand wants exactly the addresses it lacks). The HAVE side of " ++
        "content-addressed sync, proven pure before metal; serving the wanted payloads stays the Comlink gate; no disk, " ++
        "no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
