//! mantra/src/diff_witness.rye -- proves the diff, and proves it by compiling it.
//!
//!   rye build mantra/src/diff_witness.rye -femit-bin=mantra/bin/diff-witness
//!   mantra/bin/diff-witness
//!
//! The module under test is `mantra/src/diff.rye`: a pure LCS over line text
//! equality, turning a weave's current view plus a new text into a Diff. Until
//! this file was written, five guards read that module and every one read it
//! with `grep` -- so it had stopped compiling under the Zig 0.16 toolchain move
//! and all five stayed green. A guard that cannot red guards nothing.
//!
//! Two instruments here, and they answer different questions.
//!
//! The COMPTIME WALKER below reaches every declaration of the module, which is
//! what makes this a compile proof rather than an import. Zig analyses lazily:
//! a file that merely says `@import("diff.rye")` and reads a signature passes
//! straight over a type error in a function body -- measured `20260906` by
//! planting one and watching the build exit 0. Referencing each declaration
//! forces its body through semantic analysis, so a planted error reds.
//!
//! The CLAIMS below prove behavior by doing, on inputs small enough to read:
//!   1. Identical documents yield an empty diff -- no inserts, no deletes.
//!   2. An append yields inserts only; a tail delete yields deletes only.
//!   3. The diff is pure -- the same inputs give the same answer twice.
//!   4. The LCS keeps what is common: a one-line edit inside a document moves
//!      one line rather than replacing the document.
//!   5. The round trip is exact for an append-shaped edit -- diff then apply
//!      reads back the new text, line for line.
//!   6. The round trip REORDERS for a middle insert, and this witness asserts
//!      that by name rather than wishing otherwise. `Diff.inserts` carries text
//!      and no anchor, so `Weave.apply` appends; old `a c` against new `a b c`
//!      reads back `a c b`. The module's own head said the opposite until this
//!      witness measured it. Pinning the true behavior is what makes a later
//!      widening of `Diff` a visible change rather than a silent one.
//!   7. split_lines drops the empty token a trailing newline leaves, keeps an
//!      interior blank line, and answers zero lines for empty text.
//!   8. The ceilings refuse by name one cell past themselves and admit the
//!      cell at them -- both readings, both directions. The module allocated a
//!      quadratic LCS table with no named max, no named error, and no edge
//!      check until `20260907`; `check_bounds` allocates nothing, so the
//!      boundary is pressed directly rather than by building a million-line
//!      document to learn one boolean.
//!   9. The ceilings are derived rather than restated: the per-side bound IS
//!      `weave.max_weave_lines`, and the cell bound is the byte bound divided
//!      by a cell. A quantity spelled twice is a quantity that drifts.
//!  10. `diff` reads that edge check itself, proven by handing it a side one
//!      line past the ceiling and watching it refuse before it allocates. A
//!      bound nobody calls is a bound.
//!
//! Part of Mantra -- TAME-first from line one.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const weave = @import("weave.rye");

/// The site this witness edits from. A site names the hand making an edit, and
/// no two hands share a counter, so a line's identity is its position and this
/// number together. One hand is enough here: every claim below is about the
/// diff of one document against itself, rather than about two branches.
const site_here: u32 = 1;
const diff_mod = @import("diff.rye");

const witness_version = "20260907.110117";

// Every declaration of the module under test, forced through semantic analysis
// at comptime. This is the leg that makes the witness a compile proof: without
// it, a planted type error in a function this witness never calls would ride
// through the build untouched, because Zig analyses only what is reached.
comptime {
    for (@typeInfo(diff_mod).@"struct".decls) |decl| {
        _ = &@field(diff_mod, decl.name);
    }
}

/// The largest number of lines any plant below holds. Named because every plant
/// here is meant to be read by a person checking the claim: a proof whose input
/// outgrows its reader has stopped proving anything that reader can check.
const max_planted_lines: u32 = 8;

/// A fresh weave holding exactly these lines, at positions 0..texts.len.
fn planted(garden: std.mem.Allocator, texts: []const []const u8) !weave.Weave {
    // invariant: a plant stays small enough to read, since this witness argues
    // its claims by showing every line it moves
    assert(texts.len <= max_planted_lines);
    var w = weave.Weave.empty();
    try w.apply(garden, .{ .site = site_here, .inserts = texts, .deletes = &[_]weave.LineId{} });
    // invariant: the plant holds exactly the lines it was handed, so every later
    // claim about a diff is a claim about known input
    assert(w.lines.items.len == texts.len);
    return w;
}

/// The texts a weave presently shows, in weave order -- what a reader would see.
fn view(garden: std.mem.Allocator, w: *const weave.Weave) ![]const []const u8 {
    const present = try w.current(garden);
    // invariant: the view stands inside the module's own ceiling, so a caller
    // comparing against it is comparing against a bounded document
    assert(present.len <= weave.max_weave_lines);
    const out = try garden.alloc([]const u8, present.len);
    for (present, 0..) |line, idx| out[idx] = line.text;
    return out;
}

/// True when two documents read the same, line for line and in order.
fn same_document(left: []const []const u8, right: []const []const u8) bool {
    if (left.len != right.len) return false;
    for (left, right) |a, b| {
        if (!std.mem.eql(u8, a, b)) return false;
    }
    return true;
}

/// Diff `old` against `new` through a real weave, returning both the diff and
/// the document the weave reads back after applying it.
const Trip = struct {
    inserts: u32,
    deletes: u32,
    after: []const []const u8,
};

fn round_trip(
    garden: std.mem.Allocator,
    old: []const []const u8,
    new: []const []const u8,
) !Trip {
    // invariant: both documents are readable plants, so a surprise in the result
    // belongs to the diff rather than to an input nobody checked
    assert(old.len <= max_planted_lines);
    assert(new.len <= max_planted_lines);
    var w = try planted(garden, old);
    const before = try w.current(garden);
    const d = try diff_mod.diff(garden, site_here, before, new);
    try w.apply(garden, d);
    return .{
        .inserts = @intCast(d.inserts.len),
        .deletes = @intCast(d.deletes.len),
        .after = try view(garden, &w),
    };
}

/// Claim 1 and 2: an unchanged document moves nothing; an append inserts only;
/// a tail delete deletes only.
fn prove_shapes(garden: std.mem.Allocator) !void {
    const same = try round_trip(garden, &[_][]const u8{ "a", "b", "c" }, &[_][]const u8{ "a", "b", "c" });
    // invariant: a document that did not change produces no work, which is what
    // makes a diff cheap to apply on an idle file
    assert(same.inserts == 0);
    assert(same.deletes == 0);
    print("diff: identical documents give an empty diff\n", .{});

    const grew = try round_trip(garden, &[_][]const u8{ "a", "b" }, &[_][]const u8{ "a", "b", "c" });
    // invariant: appending one line inserts exactly that line and deletes none
    assert(grew.inserts == 1);
    assert(grew.deletes == 0);
    print("diff: an append inserts one line and deletes none\n", .{});

    const shrank = try round_trip(garden, &[_][]const u8{ "a", "b", "c" }, &[_][]const u8{ "a", "b" });
    // invariant: removing the last line deletes exactly it and inserts nothing
    assert(shrank.deletes == 1);
    assert(shrank.inserts == 0);
    print("diff: a tail delete deletes one line and inserts none\n", .{});
}

/// Claim 3: the diff is pure -- the module's head says so, and a claim in a
/// head is worth exactly what a run says it is.
fn prove_pure(garden: std.mem.Allocator) !void {
    const old = [_][]const u8{ "alpha", "beta", "gamma" };
    const new = [_][]const u8{ "alpha", "delta", "gamma" };
    var w = try planted(garden, &old);
    const before = try w.current(garden);

    const first = try diff_mod.diff(garden, site_here, before, &new);
    const second = try diff_mod.diff(garden, site_here, before, &new);
    // invariant: same inputs, same answer -- a pure function's whole promise,
    // and the one a weave leans on when two hands diff the same file
    assert(first.inserts.len == second.inserts.len);
    assert(first.deletes.len == second.deletes.len);
    assert(same_document(first.inserts, second.inserts));
    for (first.deletes, second.deletes) |a, b| assert(a.eq(b));
    print("diff: the same inputs give the same diff twice\n", .{});
}

/// Claim 4: the LCS earns its name. A one-line change inside a document moves
/// exactly one line, rather than replacing every line that follows it.
fn prove_lcs_keeps_the_common(garden: std.mem.Allocator) !void {
    const old = [_][]const u8{ "one", "two", "three", "four", "five" };
    const new = [_][]const u8{ "one", "two", "CHANGED", "four", "five" };
    const trip = try round_trip(garden, &old, &new);
    // invariant: four of five lines are common, so an LCS moves one line each
    // way -- a naive replace would move five, and this is the whole difference
    assert(trip.inserts == 1);
    assert(trip.deletes == 1);
    print("diff: a one-line edit inside five lines moves one line, not five\n", .{});
}

/// Claim 5: the round trip is exact when every insert belongs at the end.
fn prove_append_round_trip(garden: std.mem.Allocator) !void {
    const new = [_][]const u8{ "a", "b", "c", "d" };
    const trip = try round_trip(garden, &[_][]const u8{ "a", "b" }, &new);
    // invariant: for an append-shaped edit the weave reads back the new text
    // exactly, which is the case the module was written for
    assert(same_document(trip.after, &new));
    print("diff: an append round-trips exactly -- the weave reads back the new text\n", .{});
}

/// Claim 6: the round trip REORDERS for a middle insert, and the reorder is
/// asserted by name. `Diff.inserts` is text without an anchor, so `Weave.apply`
/// appends; the module's own head promised otherwise until this measured it.
fn prove_middle_insert_lands_at_the_end(garden: std.mem.Allocator) !void {
    const old = [_][]const u8{ "a", "c" };
    const new = [_][]const u8{ "a", "b", "c" };
    const trip = try round_trip(garden, &old, &new);
    // invariant: the diff itself is right -- one line was genuinely added
    assert(trip.inserts == 1);
    assert(trip.deletes == 0);
    // invariant: and the weave reads back a c b rather than a b c, because an
    // insert carries what was added and never where. Asserting the true shape
    // is what turns a later widening of Diff into a visible change.
    const expected = [_][]const u8{ "a", "c", "b" };
    assert(same_document(trip.after, &expected));
    assert(!same_document(trip.after, &new));
    print("diff: a middle insert lands at the end -- a c + b reads back a c b\n", .{});
}

/// Claim 7: split_lines drops the token a trailing newline leaves, keeps an
/// interior blank line, and answers nothing for empty text.
fn prove_split_lines(garden: std.mem.Allocator) !void {
    const trailing = try diff_mod.split_lines(garden, "one\ntwo\n");
    // invariant: a file ending in a newline holds two lines rather than three,
    // since the empty token after the last newline is not a line anyone wrote
    assert(trailing.len == 2);
    assert(std.mem.eql(u8, trailing[1], "two"));

    const unterminated = try diff_mod.split_lines(garden, "one\ntwo");
    // invariant: a file with no final newline holds the same two lines, so the
    // trailing newline changes the bytes and never the document
    assert(unterminated.len == 2);

    const interior = try diff_mod.split_lines(garden, "one\n\nthree\n");
    // invariant: a blank line between two lines is a line -- only the trailing
    // token is dropped, and dropping interior blanks would lose real content
    assert(interior.len == 3);
    assert(interior[1].len == 0);

    const empty = try diff_mod.split_lines(garden, "");
    // invariant: empty text holds no lines, so a new file diffs as pure insert
    assert(empty.len == 0);
    print("diff: split_lines drops the trailing token, keeps interior blanks, answers zero for empty\n", .{});
}

/// Claim 8: the ceiling is pressed by hand, at it and one past it, in both of
/// its refusals.
///
/// `check_bounds` allocates nothing, which is the whole reason it exists as a
/// function: proving the per-side ceiling by BUILDING a document of
/// `max_diff_lines` lines would cost a million slice headers to learn one
/// boolean, and proving the table ceiling that way would cost a gibibyte. So
/// the boundary is pressed directly -- exactly at the ceiling it must admit,
/// and one line or one cell past it, where it must refuse by name.
///
/// A refusal proven only in the failing direction cannot be told from a wall
/// that refuses everything, so every plant below is shown from both sides.
fn prove_the_bounds_refuse(_: std.mem.Allocator) !void {
    const max_lines: u64 = diff_mod.max_diff_lines;

    // invariant: a small pair is admitted, which is what every other claim in
    // this witness has been relying on without saying so
    try diff_mod.check_bounds(2, 3);

    // The per-side ceiling, from both sides. A single line against the full
    // ceiling keeps the table small, so this plant isolates the per-side
    // reading from the table reading rather than tripping both at once.
    try diff_mod.check_bounds(max_lines, 1);
    try diff_mod.check_bounds(1, max_lines);
    // invariant: one line past the per-side ceiling refuses by NAME, so a
    // caller can tell an oversized side from an oversized table
    try std.testing.expectError(diff_mod.DiffError.TooManyLines, diff_mod.check_bounds(max_lines + 1, 1));
    try std.testing.expectError(diff_mod.DiffError.TooManyLines, diff_mod.check_bounds(1, max_lines + 1));

    // The table ceiling, from both sides. The square root of the cell ceiling
    // is the largest side that may meet itself: at `side` the table is exactly
    // `max_diff_table_cells`, and one line more passes it.
    const side: u64 = std.math.sqrt(diff_mod.max_diff_table_cells) - 1;
    // invariant: the plant is a real boundary rather than a number that merely
    // looks like one -- the table at `side` against `side` IS the ceiling
    assert((side + 1) * (side + 1) == diff_mod.max_diff_table_cells);
    try diff_mod.check_bounds(side, side);
    // invariant: one line past it refuses by the OTHER name, because two sides
    // that are each ordinary can still ask for a table that is not
    try std.testing.expectError(diff_mod.DiffError.TableTooLarge, diff_mod.check_bounds(side + 1, side));
    try std.testing.expectError(diff_mod.DiffError.TableTooLarge, diff_mod.check_bounds(side, side + 1));

    // invariant: both sides inside the per-side ceiling and the product past
    // the table ceiling is the case that has no other name -- it is why the
    // module carries two refusals rather than one
    assert(max_lines <= diff_mod.max_diff_lines);
    try std.testing.expectError(diff_mod.DiffError.TableTooLarge, diff_mod.check_bounds(max_lines, max_lines));

    print("diff: the bounds refuse by name at one cell past the ceiling, and admit it at the ceiling\n", .{});
}

/// Claim 9: the ceilings are derived rather than restated, so nothing in this
/// module family can spell one of them a second time and drift.
fn prove_the_ceilings_are_derived(_: std.mem.Allocator) !void {
    // invariant: the per-side ceiling IS the weave's own, rather than a number
    // that happens to match it today
    assert(diff_mod.max_diff_lines == weave.max_weave_lines);
    // invariant: the cell ceiling is the byte ceiling divided by a cell, so
    // moving the byte ceiling moves both and neither can be edited alone
    assert(diff_mod.max_diff_table_cells == diff_mod.max_diff_table_bytes / @sizeOf(u32));
    print("diff: the per-side ceiling is the weave's own and the cell ceiling is derived from bytes\n", .{});
}

/// Claim 10: `diff` itself reads the edge check, rather than merely living in
/// a module that owns one.
///
/// Claim 8 presses `check_bounds` directly, which proves the decision and says
/// nothing about the call site -- and a bound nobody calls is a bound. So this
/// plants an oversized NEW side and watches `diff` refuse by name before it
/// allocates anything. The new side is chosen over the old on cost: one slice
/// header per line at `max_diff_lines + 1` is about 16 MiB of pointers all
/// aimed at one literal, where the same plant on the old side would cost a
/// `Line` apiece. The refusal arrives before the table, which is the whole
/// point: had it arrived after, this claim would need a gibibyte to make.
fn prove_diff_reads_the_edge(garden: std.mem.Allocator) !void {
    const oversized = try garden.alloc([]const u8, diff_mod.max_diff_lines + 1);
    for (oversized) |*slot| slot.* = "one line, repeated";
    // invariant: the plant is one line past the ceiling rather than merely
    // large, so a refusal here names the boundary and not a machine limit
    assert(oversized.len == @as(usize, diff_mod.max_diff_lines) + 1);

    const empty_old = [_]weave.Line{};
    try std.testing.expectError(
        diff_mod.DiffError.TooManyLines,
        diff_mod.diff(garden, site_here, &empty_old, oversized),
    );

    // invariant: and the ceiling itself is admitted through `diff`'s own edge,
    // so the refusal above is a boundary rather than a wall -- proven on the
    // pair that costs nothing, since claim 8 already pressed the ceiling
    const small = [_][]const u8{"a"};
    const accepted = try diff_mod.diff(garden, site_here, &empty_old, &small);
    assert(accepted.inserts.len == 1);

    print("diff: diff refuses an oversized side at its own edge, before the table is allocated\n", .{});
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    try prove_shapes(garden);
    try prove_pure(garden);
    try prove_lcs_keeps_the_common(garden);
    try prove_append_round_trip(garden);
    try prove_middle_insert_lands_at_the_end(garden);
    try prove_split_lines(garden);
    try prove_the_bounds_refuse(garden);
    try prove_the_ceilings_are_derived(garden);
    try prove_diff_reads_the_edge(garden);

    print("diff: version {s}\n", .{witness_version});
    print("GREEN: the diff compiles, keeps the common subsequence, round-trips an append, and appends a middle insert.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    return run_selftest(garden);
}
