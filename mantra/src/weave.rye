//! mantra/src/weave.rye -- the weave: a living history of a text stream.
//!
//! A Weave is a list of Lines. Each Line carries its text, a generation count,
//! and a stable identity that never changes once assigned. Generation parity
//! names presence: odd = present, even = gone. Generations never decrease.
//! These two facts together mean the weave remembers every line ever seen --
//! its full history -- while current() surfaces only what is present now.
//!
//! IDENTITY IS A PAIR, which is what lets two branches merge at all. A position
//! counter runs inside one weave, so two weaves that parted hand the same small
//! integer to different lines; a join reading that integer alone saw one line
//! where there were two and refused the ordinary case of branching. A line is
//! named by a LineId instead -- the position, AND the site whose counter
//! assigned it -- and that pair is unique by construction, since no two sites
//! share a counter. The site rides on Diff rather than on Weave, because an
//! edit is authored by one hand while the history it lands in is shared by
//! every hand.
//!
//! ORDER IS ITS OWN QUESTION, asked and answered apart from identity. Where a
//! line sits is a Place -- run, then site, then position -- and Place.less_than
//! is that order written once, which every sort and every ordering assert in
//! this file reads. A run names one apply: every line of one edit carries one
//! run number, read before the loop that stamps them. So the site tie between
//! two concurrent edits is settled ONCE, for the whole run, and each hand's
//! block arrives whole. Reading the identity pair as the order settled that tie
//! at every line instead, so two sides that each appended three lines came back
//! alternating left, right, left, right, their positions coinciding one for
//! one.
//!
//! The identity keeps its two fields, since a position counter runs fresh
//! inside one weave and the pair is therefore already unique. Identity is what
//! a merge joins on; place is what it sorts by; and holding them apart is what
//! let the order be repaired with every line's name left exactly as it was.
//!
//! WHAT THIS LEAVES FOR THE NEXT LAP, so the head promises exactly what the
//! code does. Every insert lands at the END of the document, since apply reads
//! its positions off a counter that only rises -- so a paragraph edited in the
//! middle of a file arrives as a deletion and an append. Placing a line between
//! two others wants an anchor per insert, a line naming the line it follows,
//! which widens Diff and is a seam rather than a lap. One further shape is
//! worth expecting, and it is the honest answer rather than a fault: where one
//! side made TWO edits and the other made one, the other's block lands between
//! them, because run numbers order edits and both sides' first edits share one.
//! Each side's own sequence survives exactly; an anchor is what would let a
//! merge know which of two concurrent paragraphs its author meant to come
//! first.
//!
//! The operations, listed rather than counted. This list is read against the
//! module's own `pub fn` declarations by
//! tools/fixtures/m/mantra_weave_head_scan.sh, in both directions, so an
//! operation that lands without a line here reds on the lap it arrives --
//! which is what `merge` did for half a day (REDS %506):
//!   Weave.empty()            -- an empty weave, no lines yet
//!   weave.apply(alloc, d)    -- advance the weave by one Diff
//!   weave.current(alloc)     -- the lines present now, in document order
//!   weave.merge(alloc, w)    -- one weave from two, by union and max
//!   weave.annotate(alloc, w) -- what each side did, one Note per position
//!
//! Part of Mantra -- TAME-first from line one.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

/// The largest number of lines one weave holds, and the ceiling both `apply`
/// and `merge` read before they allocate anything. A weave keeps every line a
/// file has ever held, so its natural size is the whole history rather than the
/// current length; a million lines stands far above any history this tree has
/// written, and is small enough that the refusal arrives long before the
/// machine is in trouble.
pub const max_weave_lines: u32 = 1 << 20;

/// What a weave refuses, by name. Each refusal is read at the edge -- before an
/// allocation is made, rather than after one has grown.
pub const WeaveError = error{
    /// Two weaves hold one LineId with different text. An identity names a
    /// line for all time, and it carries the site that issued it, so this now
    /// says one site handed one identity to two different lines -- a replayed
    /// counter or a forged weave, rather than the ordinary parting of two
    /// branches, which the site distinguishes. Merging them would keep one
    /// line while silently dropping the other, the single outcome a weave
    /// exists to prevent. Refusing here is what keeps the history whole.
    PositionTextDisagrees,
    /// The weave would pass max_weave_lines -- by a diff's inserts in `apply`,
    /// or by the union of two weaves in `merge`.
    TooManyLines,
};

/// What names a line for all time: the position one counter handed it, and the
/// site of the hand that was counting.
///
/// Either half alone is ambiguous across two weaves. A position counter runs
/// inside one weave, so two weaves that parted hand the same small integer to
/// different lines; a site names a hand and says nothing about where in the
/// document its line sits. Together they are unique by construction rather
/// than by coordination, because no two sites share a counter.
pub const LineId = struct {
    pos: u32,
    site: u32,

    /// Whether two identities name one line -- the equality reading of the
    /// single order below.
    pub fn eq(self: LineId, other: LineId) bool {
        return self.order(other) == .eq;
    }

    /// Where one identity falls against another, by its own two fields.
    ///
    /// This is an order over NAMES rather than the document order -- it exists
    /// so a caller holding identities alone can put them in a stable sequence.
    /// Where a line sits in the document is `Place.less_than`, which reads the
    /// run as well; the two were one function until `20260907`, and the seam
    /// between them is what the interleave cost.
    ///
    /// It answers a three-way `Order` rather than a bool because a binary
    /// search needs to know which side it landed on, and a sort needs only
    /// less-than. Writing the comparison once and deriving the second reading
    /// from it is what keeps a sorted list and a search over that list from
    /// ever disagreeing about where a name sits.
    pub fn order(self: LineId, other: LineId) std.math.Order {
        if (self.pos != other.pos) return std.math.order(self.pos, other.pos);
        return std.math.order(self.site, other.site);
    }

    /// Whether one identity sorts before another -- the sort's reading of the
    /// single order above.
    pub fn less_than(self: LineId, other: LineId) bool {
        return self.order(other) == .lt;
    }
};

/// Where a line sits in the document: which edit placed it, whose edit that
/// was, and where inside that edit it fell.
///
/// IDENTITY AND ORDER ARE TWO QUESTIONS, and one type answering both is what
/// let two branches' inserts interleave. `LineId` answers *which line is this*;
/// `Place` answers *where does it go*. Reading the pair as an order sorted by
/// position first, so two sides that each appended THREE lines from a shared
/// counter alternated line for line -- left, right, left, right -- because
/// their positions coincided one for one and the site broke each tie
/// separately. The run is what holds a hand's own paragraph together: every
/// line of one `apply` carries one run number, so the whole block sorts as a
/// block and the site tie is broken ONCE, for the run, rather than at each
/// line inside it.
///
/// The three fields are read in the order that makes each of those promises:
///
///   run  -- which edit. Runs are handed out by a monotone counter, so an
///           edit made before another sorts before it, and every line the two
///           sides inherited from a common ancestor keeps its exact place.
///   site -- whose edit. Two runs that share a number are concurrent by
///           construction, since a counter advances for each edit it sees; the
///           site orders them the same way on both sides.
///   pos  -- where inside the edit. Positions rise within one `apply`, so a
///           hand's lines keep the order that hand wrote them in.
pub const Place = struct {
    run: u32,
    site: u32,
    pos: u32,

    /// Document order, written once, because every sort and every ordering
    /// assert in this module reads it -- and an order spelled at each call site
    /// is an order those call sites may come to disagree about, which for a
    /// merge would mean two sides computing two documents from one history.
    pub fn less_than(self: Place, other: Place) bool {
        if (self.run != other.run) return self.run < other.run;
        if (self.site != other.site) return self.site < other.site;
        return self.pos < other.pos;
    }
};

/// A single line in the weave. Once added, its identity is permanent.
///
/// Invariants:
///   gen >= 1         -- zero is reserved; every line starts at generation 1
///   gen is odd       <->  line is currently present
pub const Line = struct {
    text: []const u8,
    gen: u32,
    pos: u32,
    site: u32,
    run: u32,

    /// What names this line in every weave that will ever hold it.
    ///
    /// The run stays OUT of the identity on purpose. A position comes from a
    /// counter that never repeats inside one weave, so `(pos, site)` is already
    /// unique by construction, and a third field would name the same line twice
    /// over -- which is exactly the kind of redundancy a merge can find itself
    /// disagreeing with.
    pub fn id(self: Line) LineId {
        return .{ .pos = self.pos, .site = self.site };
    }

    /// Where this line sits in the document.
    pub fn place(self: Line) Place {
        return .{ .run = self.run, .site = self.site, .pos = self.pos };
    }
};

/// An edit to a weave: who is making it, a set of lines to insert (with their
/// text), and a set of lines to delete (by identity). Inserts arrive in the
/// order they should appear; deletes name currently-present lines.
///
/// The site sits here rather than on Weave on purpose. A weave is a shared
/// history that several hands merge into one; an edit is the act of one hand.
/// Holding the site on the weave would make it a field a merge has to
/// reconcile, and there is no honest answer to whose history a merged history
/// is -- so the question is never asked.
pub const Diff = struct {
    site: u32,                   // whose edit this is; stamped on every insert
    inserts: []const []const u8, // text of new lines, in order
    deletes: []const LineId,     // identities of lines to remove
};

/// What the two sides did at one position, in a single word.
///
/// The five readings are exhaustive over two generation counts, which is why
/// `Note.reading` needs no default arm: either exactly one side has seen the
/// position, or both have and their counts are equal, or both have and one
/// stands higher.
pub const Reading = enum {
    /// Only the left weave has ever seen this line, so the left is the side
    /// that added it and the right has not met it yet. Two branches that each
    /// inserted read as one left_only and one right_only, rather than as a
    /// collision, because the two lines carry different sites.
    left_only,
    /// The mirror: only the right weave has seen it.
    right_only,
    /// Both hold the position at the same count, so neither side has touched
    /// it since they parted. Parity says whether that shared state is present
    /// or gone.
    agreed,
    /// Both have seen it and the left's count stands higher, so the left is
    /// the side that acted last. `present_left` says whether the act left the
    /// line present or gone.
    left_moved,
    /// The mirror: the right acted last.
    right_moved,
};

/// One line, read from both sides: what each weave holds at that identity, and
/// what a merge of the two lands on.
///
/// A generation of **zero** means that side has never seen this position. Zero
/// is already reserved by the module -- every line starts at generation 1 --
/// and zero is also even, so an unseen position reads as not-present through
/// the same parity test every other reading uses, with no special case
/// anywhere.
///
/// The merged generation is derived rather than stored. Holding a third count
/// beside the two it comes from would let the story and the merge drift into
/// two answers, and a story that can disagree with the thing it describes is
/// worse than no story.
pub const Note = struct {
    pos: u32,
    site: u32,
    run: u32,
    left_gen: u32,
    right_gen: u32,

    /// The line this note is about, named the way merge names it.
    pub fn id(self: Note) LineId {
        return .{ .pos = self.pos, .site = self.site };
    }

    /// Where the line this note is about sits, ordered the way merge orders it.
    /// A reading that sorted differently from the merge it describes would be a
    /// story about a different document.
    pub fn place(self: Note) Place {
        return .{ .run = self.run, .site = self.site, .pos = self.pos };
    }

    /// The generation a merge of the two sides lands on at this position --
    /// the same `@max` the merge itself takes, read from the same two counts.
    pub fn gen(self: Note) u32 {
        return @max(self.left_gen, self.right_gen);
    }

    /// Whether the left side holds this line present. Parity is the tombstone,
    /// and zero is even, so a side that never saw the position answers false.
    pub fn present_left(self: Note) bool {
        return self.left_gen % 2 == 1;
    }

    /// The mirror, for the right side.
    pub fn present_right(self: Note) bool {
        return self.right_gen % 2 == 1;
    }

    /// The story at this position in one word.
    pub fn reading(self: Note) Reading {
        // invariant: a note names a position at least one side has seen, since
        // a position neither weave holds never enters the union at all
        assert(self.left_gen != 0 or self.right_gen != 0);
        if (self.right_gen == 0) return .left_only;
        if (self.left_gen == 0) return .right_only;
        if (self.left_gen == self.right_gen) return .agreed;
        // invariant: both counts are real and they differ, so exactly one side
        // stands higher and the two arms below name it rather than falling
        // through to a default that would hide a fourth case
        assert(self.left_gen != self.right_gen);
        if (self.left_gen > self.right_gen) return .left_moved;
        return .right_moved;
    }
};

/// Where a search key falls against a line, read through the identity's own
/// single order. Named at file scope because both folds -- the merge's and the
/// reading's -- search the same way, and one comparison spelled twice is
/// exactly the drift a shared function cannot have.
fn search_by_id(key: LineId, item: Line) std.math.Order {
    return key.order(item.id());
}

/// Where an identity falls against an identity -- the same order, read over a
/// slice of NAMES rather than of lines.
///
/// `apply` searches its own delete targets rather than the weave, because a
/// merged weave comes back in place order and place order is not identity
/// order. The small side is the one that can be sorted, so the search reads a
/// slice of LineId and this is its comparison.
fn search_by_name(key: LineId, item: LineId) std.math.Order {
    return key.order(item);
}

/// Copy lines into a caller-owned slice of exactly their count.
///
/// Named rather than reached for through `@memcpy`, per the module family's
/// own rule, and asserted on both sides so a scratch slice sized from one
/// count can never be filled from another.
fn copy_lines(into: []Line, from: []const Line) void {
    // invariant: the destination holds exactly the source's count, since a
    // shorter one would drop lines a later search would then never find
    assert(into.len == from.len);
    for (from, 0..) |line, i| into[i] = line;
}

/// Put a slice of lines in identity order -- the order both folds search in.
///
/// Strictness is asserted rather than assumed. A weave holds each identity
/// once, so a sorted slice of one weave's lines rises strictly; a slice that
/// merely did not fall would mean two lines answering to one name, and a
/// binary search over it could return either.
fn sort_by_id(lines: []Line) void {
    std.mem.sort(Line, lines, {}, struct {
        fn less_than(_: void, a: Line, b: Line) bool {
            return a.id().less_than(b.id());
        }
    }.less_than);
    for (lines, 0..) |line, i| {
        // invariant: identities strictly increase, which is what makes the
        // search below return the one line that carries the name it was given
        if (i + 1 < lines.len) assert(lines[i].id().less_than(lines[i + 1].id()));
        _ = line;
    }
}

/// A Weave: the living history of a text stream.
///
/// Invariant: for all i < lines.items.len:
///   lines.items[i].gen >= 1
///   lines.items[i].pos < next_pos
///   lines.items[i].run < next_run
///   gen counts are non-decreasing across successive apply calls
pub const Weave = struct {
    lines: std.ArrayListUnmanaged(Line),
    next_pos: u32,
    /// The number the next edit's run will be stamped with. It counts EDITS
    /// where `next_pos` counts LINES, and the two advance at different rates on
    /// purpose: one `apply` inserting three lines takes one run and three
    /// positions, which is what makes the three sort as one block.
    next_run: u32,

    /// An empty weave -- no history yet.
    pub fn empty() Weave {
        return .{ .lines = .empty, .next_pos = 0, .next_run = 0 };
    }

    /// Advance the weave by one diff. Deletes remove lines by toggling their
    /// generation to even (gone); inserts append new lines at the current
    /// generation (1 = first time seen). Position counters are assigned
    /// monotonically and never reused, and each insert is stamped with the
    /// diff's site, so the pair the line is named by is unique across every
    /// weave that will ever hold it.
    ///
    /// COST IS LINEAR IN THE WEAVE, which it was not until `20260907`. Both
    /// halves of this function walked the whole weave once per item the diff
    /// carried -- each delete searching for its target, each insert asking
    /// every held line whether it already answered to the new name -- so one
    /// apply cost |lines| x |diff|. `merge` carried the same shape one function
    /// over and was repaired the same day; this is its other half.
    ///
    /// Measured on this pier, ReleaseSafe -- the checked build a witness
    /// actually runs -- as three applies in sequence: insert n lines into an
    /// empty weave, delete half of them by identity, then insert n more.
    /// Wall time for each apply, walking then reading:
    ///
    ///   n = 16,384    insert    83ms -> 10ms
    ///                 delete    59ms -> under the timer's floor
    ///                 insert   262ms -> under the timer's floor
    ///   n = 131,072   insert 5,764ms -> 29ms
    ///                 delete 2,957ms -> 5ms
    ///                 insert 16,693ms -> 28ms
    ///
    /// The walk rose about 3.9x per doubling, which is the quadratic the shape
    /// predicts. At **524,288** lines -- half the ceiling -- the first apply
    /// alone took **109,506ms** walking and takes **97ms** reading, so the
    /// declared ceiling was again one the operation could not serve. The bound
    /// did not move; the two loops did.
    ///
    /// Two different repairs, because the two halves fail for two reasons.
    /// The delete pass sorts its own TARGETS and walks the weave once, since a
    /// merged weave comes back in place order and cannot itself be searched by
    /// identity; that costs |lines| x log |deletes|. The insert check needed no
    /// search at all: positions come off a counter that only rises, and the
    /// weave's own invariant already holds every line below it, so a new
    /// identity is fresh by construction and one floor read replaces the walk.
    ///
    /// Precondition:  every delete names a line the weave holds and that is
    ///   present (odd gen), and no two deletes name one line -- both asserted.
    /// Postcondition: all inserted lines carry gen == 1 and odd (present);
    ///   all deleted lines carry gen % 2 == 0 (gone).
    pub fn apply(self: *Weave, allocator: std.mem.Allocator, diff: Diff) !void {
        // invariant: the weave already stands inside its own ceiling, so the
        // refusal just below names the diff rather than covering for a weave
        // that was over the ceiling before this call arrived
        assert(self.lines.items.len <= max_weave_lines);

        // The weave grows by exactly the diff's inserts, so the sum is what the
        // ceiling reads -- at the edge, before a single line is appended.
        if (self.lines.items.len + diff.inserts.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // Process deletes first: bump each named line's gen to even. Identity
        // rather than position, since a position alone names a line in one
        // weave and a merged weave holds lines from several.
        //
        // THE TARGETS ARE SORTED AND THE WEAVE IS WALKED ONCE, rather than the
        // weave being walked once per target. The pass costs |lines| x
        // log |deletes| where the walk cost |lines| x |deletes|. The weave is
        // the side that cannot be searched: `merge` returns its lines in PLACE
        // order, and place order is not identity order, so the side put in
        // identity order is the small one the caller handed in.
        if (diff.deletes.len > 0) {
            // invariant: a diff names no more lines than the weave can hold, since
            // every target must name a line this weave already carries -- and this is
            // the bound the scratch slice just below is sized by
            assert(diff.deletes.len <= max_weave_lines);

            const targets = try allocator.alloc(LineId, diff.deletes.len);
            defer allocator.free(targets);
            for (targets, diff.deletes) |*into, from| into.* = from;
            std.mem.sort(LineId, targets, {}, struct {
                fn less_than(_: void, a: LineId, b: LineId) bool {
                    return a.less_than(b);
                }
            }.less_than);
            for (targets, 0..) |_, i| {
                // invariant: the targets are distinct and strictly increasing, which is
                // what lets the hit count below prove every one of them was found. Two
                // deletes naming one line would otherwise bump one generation twice and
                // report two changes where the weave saw one.
                if (i + 1 < targets.len) assert(targets[i].less_than(targets[i + 1]));
            }

            var hits: u32 = 0;
            for (self.lines.items) |*line| {
                if (std.sort.binarySearch(LineId, targets, line.id(), search_by_name) == null) continue;
                // invariant: an odd generation means present -- the parity IS the
                // tombstone, so an even one reaching here would be a deleted line treated
                // as live
                assert(line.gen % 2 == 1);
                line.gen += 1;                       // odd -> even: mark gone
                hits += 1;
            }
            // usize lives at the inherited-std seam alone: a slice counts in usize, and
            // the bound asserted above is what makes the cast safe.
            // invariant: every delete named a line the weave holds, since deleting one
            // that is not there would report success for a change that never happened.
            // The targets are distinct, so one hit apiece is exactly this count.
            assert(hits == @as(u32, @intCast(diff.deletes.len)));
        }

        // Process inserts: each new line enters at generation 1 (first appearance,
        // present). Position is assigned from the monotone counter, and the whole
        // run of them carries ONE run number -- read before the loop, so every
        // line this edit adds sorts as one block rather than each line taking its
        // chances against the other side's lines separately.
        const run = self.next_run;
        // The floor every identity this edit hands out stands above, read once
        // before a line is added. Positions come off a counter that only rises,
        // and the weave's own invariant holds every line it already carries
        // BELOW that counter -- so a new line's position is above every held
        // position, and the identity is therefore fresh whatever its site.
        const floor = self.next_pos;
        // invariant: every line the weave already holds sits below the counter the
        // inserts are about to draw from. This is the weave's declared invariant,
        // checked here at the edge because the uniqueness asserted inside the loop
        // rests on it -- one pass, where asking each new line against every held
        // line cost |inserts| x |lines| and was the second quadratic this function
        // carried.
        for (self.lines.items) |held| assert(held.pos < floor);
        for (diff.inserts) |text| {
            const line = Line{
                .text = text,
                .gen   = 1,
                .pos   = self.next_pos,
                .site  = diff.site,
                .run   = run,
            };
            // invariant: an odd generation means present -- the parity IS the tombstone, so an
            // even one reaching here would be a deleted line treated as live
            assert(line.gen % 2 == 1);
            // invariant: the identity being handed out is one this weave does not already
            // hold. This is what the pair buys, asserted where it is created rather than
            // trusted: its position stands at or above the floor every held line sits
            // below, so no held line can answer to this name whatever its site, and a
            // counter that repeated itself is caught right here.
            assert(line.pos >= floor);
            try self.lines.append(allocator, line);
            self.next_pos += 1;
        }

        // The run counter advances once for the whole edit, and only when the
        // edit actually placed a line. A delete-only diff leaves it alone: it
        // stamped nothing, so burning a number would open a gap that a
        // concurrent edit on the other side could never be compared against.
        if (diff.inserts.len > 0) self.next_run += 1;

        // Postcondition: every line in the weave has a valid, assigned position.
        for (self.lines.items) |line| {
            // invariant: a line carries a real generation and a position inside the weave's own
            // counter, so neither ordering nor identity is left to the caller
            assert(line.gen >= 1);
            assert(line.pos < self.next_pos);
            // invariant: a line's run stands under the weave's own run counter, so the next
            // edit is handed a number no line already carries -- which is what makes two
            // sides' concurrent runs comparable rather than merely different
            assert(line.run < self.next_run);
        }
    }

    /// Return the lines currently present (odd generation), in document order.
    /// The caller owns the returned slice; it is allocated from `allocator`.
    ///
    /// THE BACKING LIST IS ALREADY IN PLACE ORDER, so this reads it once and
    /// sorts nothing. It sorted every call until `20260908`, which was the
    /// third and last of the three quadratic-or-worse shapes this module
    /// carried -- `merge` was repaired on `20260907`, `apply` the same night,
    /// and this one is the read the other two are measured through.
    ///
    /// The order is held by all three of the ways a weave can come to exist,
    /// which is why it is an invariant rather than a hope:
    ///
    ///   `empty`  starts with no lines, so it is ordered trivially.
    ///   `apply`  appends its inserts carrying `next_run`, and every line the
    ///            weave already holds carries a run BELOW that -- asserted in
    ///            that function's own postcondition -- so an appended line
    ///            sorts after every held line whatever its site, and the run
    ///            of them sorts among itself by a position counter that only
    ///            rises. Deletes change a generation and move nothing.
    ///   `merge`  sorts its result by place and asserts places strictly
    ///            increase before it returns.
    ///
    /// So the order is established where a line is placed rather than
    /// re-established where a line is read, and the walk below asserts it
    /// rather than trusting it: a caller reaching past the module's own API to
    /// push a line onto `lines` is caught at the next read.
    ///
    /// NAME WHAT THAT ASSERT IS NOT: it is a restatement, and no control phase
    /// isolates it. Planting a disorder means removing `merge`'s place sort,
    /// and `merge`'s own postcondition then fires first; removing that assert
    /// too still reds the pen through the field-for-field equality claim, which
    /// two differently-ordered merges fail whatever the read does. Both plants
    /// were built and run on `20260908` and both exited 134 with the sort here
    /// and without it, so the isolating phase was declined rather than written
    /// -- a plant that reds for a reason the phase did not name proves the same
    /// nothing as a plant that matched no line, which is the fault the merge
    /// control already warns about in its own comments. The honest claim is the
    /// narrow one: this read no longer TIDIES a disorder it did not create.
    ///
    /// Measured on this pier, ReleaseSafe -- the checked build a witness
    /// actually runs -- as twenty reads of a weave holding n present lines,
    /// best of three runs, sorting then reading:
    ///
    ///   n =  16,384    0.4ms ->  0.4ms
    ///   n = 131,072    3.3ms ->  2.7ms
    ///   n = 524,288   25.3ms -> 13.3ms
    ///
    /// SAY THE SHAPE HONESTLY: this is a factor of two at half the ceiling and
    /// nothing at all at sixteen thousand, where the sort sat inside the
    /// timing noise. What remains dominates -- the read copies every present
    /// line into a slice the caller owns, which at 524,288 lines is about
    /// sixteen megabytes of Line, and no ordering change touches that. The
    /// win worth naming is the one that is not a number: document order is now
    /// something the module HOLDS rather than something each read rebuilds, so
    /// a caller that corrupts it is caught here instead of being tidied over.
    ///
    /// Precondition:  the backing list is in strictly increasing place order --
    ///   asserted below, over the whole list.
    /// Postcondition: every returned line is present, and places strictly
    ///   increase.
    pub fn current(self: *const Weave, allocator: std.mem.Allocator) ![]const Line {
        // invariant: the weave stands inside its own ceiling, so the slice this
        // returns is bounded by max_weave_lines rather than by whoever calls it
        assert(self.lines.items.len <= max_weave_lines);
        var out: std.ArrayListUnmanaged(Line) = .empty;
        for (self.lines.items, 0..) |line, i| {
            // invariant: the backing list is in place order already, which is what
            // lets this read return document order without sorting. Held over the
            // whole list rather than over the filtered result, because a filter can
            // hide a disorder that a later delete would then reveal.
            if (i + 1 < self.lines.items.len) {
                assert(line.place().less_than(self.lines.items[i + 1].place()));
            }
            if (line.gen % 2 == 1) { // odd = present
                try out.append(allocator, line);
            }
        }
        // A subsequence of an ordered list is ordered, so the filter above
        // carries document order out with it and nothing is sorted here.
        const result = try out.toOwnedSlice(allocator);

        // Postcondition: result is sorted and all entries are present.
        for (result) |line| {
            // invariant: an odd generation means present -- the parity IS the tombstone, so an
            // even one reaching here would be a deleted line treated as live
            assert(line.gen % 2 == 1);
        }
        for (result, 0..) |line, i| {
            if (i + 1 < result.len) {
                // invariant: the result comes out ordered by identity, which is what makes a
                // weave readable as a document rather than a bag of lines
                assert(result[i].place().less_than(result[i + 1].place()));
            }
            _ = line;
        }

        return result;
    }

    /// Fold one weave's lines into a list already holding the other's: a line
    /// whose identity is already held joins by the higher generation, and one
    /// whose identity is new is appended.
    ///
    /// Two branches that each inserted therefore keep BOTH lines, since their
    /// sites differ even where their positions agree. That is the whole reason
    /// identity is a pair.
    ///
    /// The caller has already ensured capacity for the whole union, so nothing
    /// here allocates and the only way out is the refusal.
    ///
    /// THE HELD SIDE ARRIVES SORTED BY IDENTITY, so a lookup is a
    /// binary search rather than a walk. That is the whole difference between
    /// a merge that serves the module's declared ceiling and one that does
    /// not. Walking cost |self| x |other| identity comparisons; searching
    /// costs |other| x log |self|.
    ///
    /// A line this fold APPENDS can never be a later lookup's answer, so the
    /// sorted prefix stays the whole search space for the whole fold. That
    /// holds because `apply` hands out each identity once per weave and
    /// asserts it at the point of creation: `incoming` therefore carries no
    /// two lines of one name, and a miss is a miss for every line after it.
    ///
    /// Precondition:  `out` has room for every line of `incoming`, and its
    ///   first `sorted_len` entries are sorted by identity.
    /// Postcondition: every identity of `incoming` is held by `out` exactly once.
    fn union_into(out: *std.ArrayListUnmanaged(Line), sorted_len: u32, incoming: []const Line) WeaveError!void {
        // invariant: the list can take the whole union without growing, which is
        // what lets this fold run with no allocator and no error but the refusal
        assert(out.capacity >= out.items.len + incoming.len);
        // invariant: the union stays inside the weave's own ceiling, so the
        // append below can never carry the list past what merge already checked
        assert(out.items.len + incoming.len <= max_weave_lines);
        // invariant: the searched prefix is one the list actually holds, since
        // a search past the end would read whatever the capacity left behind
        assert(sorted_len <= out.items.len);

        const sorted = out.items[0..sorted_len];
        for (incoming) |line| {
            const found = std.sort.binarySearch(Line, sorted, line.id(), search_by_id);
            if (found) |at| {
                const held = &sorted[at];
                if (!std.mem.eql(u8, held.text, line.text)) {
                    return WeaveError.PositionTextDisagrees;
                }
                // The join itself. Max carries parity with it, so a delete on
                // either side survives a merge with a side still holding the
                // line -- gone is a larger count than present, and larger wins.
                held.gen = @max(held.gen, line.gen);
            } else {
                out.appendAssumeCapacity(line);
            }
        }
    }

    /// Merge another weave into this one, returning a new weave and leaving
    /// both arguments exactly as they were.
    ///
    /// An identity names a line for all time. So an identity both weaves hold
    /// is one line seen twice, and an identity only one of them holds is a line
    /// the other has not seen yet. The rule is therefore a union over
    /// identities where the HIGHER GENERATION wins -- no commit identifier is
    /// consulted, only the counts in front of it, which keeps the merge
    /// structural.
    ///
    /// Two branches that each inserted are exactly the second case, twice over:
    /// their sites differ, so their identities differ, so the union keeps both
    /// lines and the merge succeeds. That is the ordinary case of parting and
    /// coming back, and it is the case this merge was named for.
    ///
    /// Three operations sit underneath: union of the identities, max on the
    /// generation, max on next_pos, max on next_run. Each of the four is
    /// commutative, associative, and idempotent, so the merge is all three as
    /// well -- by construction rather than by care. Sorting the result by place
    /// makes that structural rather than merely visible: `a.merge(alloc, b)`
    /// and `b.merge(alloc, a)` come out equal field for field, rather than only
    /// equal once they are read as a document. The site earns its keep twice
    /// here: it separates two branches' lines through the identity, AND it
    /// orders their runs through the place, so a total order leaves nothing for
    /// a tiebreak to invent.
    ///
    /// Cost is one sort of this side plus |other| x log |self| searches. It
    /// was |self| x |other| walks until `20260907`, on the reasoning that an
    /// index earns its place when a measurement asks for one rather than
    /// before -- and then the measurement asked, in these numbers.
    ///
    /// Measured on this pier, ReleaseFast, two disjoint sides of equal size so
    /// no identity joins and the fold does its whole work. Wall time for one
    /// merge, walking then searching: 16,384 lines a side **387ms -> 7ms**;
    /// 32,768 **1,522ms -> 10ms**; 65,536 **6,004ms -> 17ms**; 131,072
    /// **24,310ms -> 28ms**. The walk rose 3.95x then 4.05x across those
    /// doublings, which is the quadratic the shape predicts.
    ///
    /// At the LARGEST MERGE THE BOUND PERMITS -- 524,288 a side, a union of
    /// exactly `max_weave_lines` -- the walk **did not finish inside ten
    /// minutes** and was stopped there; the search takes **162ms**, and
    /// **1,376ms** in the checked build a witness runs. So the declared
    /// ceiling was one the operation could not serve, which makes it a ceiling
    /// named for the allocator alone. The fold changed rather than the bound.
    ///
    /// The order is a sort this merge already had to take, so no index is
    /// stored and no structure outlives the call.
    ///
    /// Refusal keeps that order-independence. Weaves that pairwise agree on
    /// their shared positions are closed under merge -- the merged text at a
    /// position comes from one of the two sides, and both already agreed with
    /// the third -- so no grouping can hide a disagreement from a later one.
    ///
    /// Precondition:  an identity held by both weaves carries the same text --
    ///   refused by name. With the site in the identity this is corruption
    ///   rather than ordinary branching: one site issued one name twice.
    /// Postcondition: places strictly increase, every line keeps a real
    ///   generation, and next_pos and next_run stand above every position and
    ///   run in the result.
    pub fn merge(self: *const Weave, allocator: std.mem.Allocator, other: *const Weave) !Weave {
        // invariant: each weave already stands inside the named bound, so a
        // refusal below names the union rather than covering for an input that
        // was over the ceiling before a merge was ever asked for
        assert(self.lines.items.len <= max_weave_lines);
        assert(other.lines.items.len <= max_weave_lines);

        // The union holds at most the sum, so checking the sum checks the union
        // -- at the edge, before a single line is copied.
        if (self.lines.items.len + other.lines.items.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // usize lives at the inherited-std seam alone: ArrayListUnmanaged counts
        // in usize, and the bound just checked is what makes the cast safe.
        const self_len: u32 = @intCast(self.lines.items.len);
        const other_len: u32 = @intCast(other.lines.items.len);

        var out: std.ArrayListUnmanaged(Line) = .empty;
        errdefer out.deinit(allocator);
        try out.ensureTotalCapacity(allocator, self_len + other_len);
        for (self.lines.items) |line| {
            out.appendAssumeCapacity(line);
        }

        // The fold below searches this side rather than walking it, so the side
        // arrives in identity order. Sorting here rather than inside the fold
        // keeps the fold allocation-free and states the precondition where a
        // reader can see it being met.
        sort_by_id(out.items);
        try union_into(&out, self_len, other.lines.items);

        std.mem.sort(Line, out.items, {}, struct {
            fn less_than(_: void, a: Line, b: Line) bool {
                return a.place().less_than(b.place());
            }
        }.less_than);

        const merged = Weave{
            .lines = out,
            .next_pos = @max(self.next_pos, other.next_pos),
            // Max on the run counter for the same reason as max on the position
            // counter: the next edit made on the merged weave must take a number
            // NEITHER side has spent, or it would read as concurrent with a run
            // that has already happened.
            .next_run = @max(self.next_run, other.next_run),
        };

        for (merged.lines.items, 0..) |line, i| {
            // invariant: a line carries a real generation, since zero is
            // reserved and a merge must never invent one
            assert(line.gen >= 1);
            // invariant: every position stays under the merged counter, so the
            // next insert is handed one neither side has ever used
            assert(line.pos < merged.next_pos);
            if (i + 1 < merged.lines.items.len) {
                // invariant: identities strictly increase, which both orders the
                // document and proves the union kept exactly one line per
                // identity -- two branches' concurrent inserts share a position
                // and are separated here by their sites
                assert(merged.lines.items[i].place().less_than(merged.lines.items[i + 1].place()));
            }
        }

        return merged;
    }

    /// Append one note per position the LEFT holds, carrying the right's count
    /// beside it -- zero when the right has never seen it. The text comparison
    /// lives here, so the fold below reads positions alone.
    ///
    /// The caller has already ensured capacity for the whole union, so nothing
    /// here allocates and the only way out is the refusal. This is the same
    /// shape `union_into` takes for `merge`, on purpose: two folds over one
    /// union, and the reading differs only in what it writes down.
    ///
    /// `right_sorted` arrives in identity order for the same reason the merge's
    /// held side does: the lookup is a binary search rather than a walk, so the
    /// reading costs what the merge costs and the two stay comparable at every
    /// size rather than only at small ones.
    ///
    /// Precondition:  `out` has room for every line of `left`, and
    ///   `right_sorted` is in identity order.
    /// Postcondition: `out` holds one note per identity of `left`.
    fn notes_from_left(
        out: *std.ArrayListUnmanaged(Note),
        left: []const Line,
        right_sorted: []const Line,
    ) WeaveError!void {
        // invariant: the list can take the whole fold without growing, which is
        // what lets this run with no allocator and no error but the refusal
        assert(out.capacity >= out.items.len + left.len);
        // invariant: the fold stays inside the weave's own ceiling, so the
        // append below can never carry the list past what annotate checked
        assert(out.items.len + left.len <= max_weave_lines);

        for (left) |line| {
            var right_gen: u32 = 0;
            if (std.sort.binarySearch(Line, right_sorted, line.id(), search_by_id)) |at| {
                const held = right_sorted[at];
                if (!std.mem.eql(u8, held.text, line.text)) {
                    return WeaveError.PositionTextDisagrees;
                }
                right_gen = held.gen;
            }
            out.appendAssumeCapacity(.{
                .pos = line.pos,
                .site = line.site,
                .run = line.run,
                .left_gen = line.gen,
                .right_gen = right_gen,
            });
        }
    }

    /// Append a note for each line only the RIGHT has seen. Every shared
    /// identity already had its text compared by the fold above, so this one
    /// reads identities alone and cannot refuse.
    ///
    /// Precondition:  `out` has room for every line of `right`, and
    ///   `left_sorted` is in identity order.
    /// Postcondition: every identity of `right` is held by `out` exactly once.
    fn notes_from_right(
        out: *std.ArrayListUnmanaged(Note),
        left_sorted: []const Line,
        right: []const Line,
    ) void {
        // invariant: the list can take the whole fold without growing, which is
        // what lets this run with no allocator at all
        assert(out.capacity >= out.items.len + right.len);
        // invariant: the fold stays inside the weave's own ceiling, so the
        // append below can never carry the list past what annotate checked
        assert(out.items.len + right.len <= max_weave_lines);

        for (right) |line| {
            const shared = std.sort.binarySearch(Line, left_sorted, line.id(), search_by_id) != null;
            if (!shared) {
                out.appendAssumeCapacity(.{
                    .pos = line.pos,
                    .site = line.site,
                    .run = line.run,
                    .left_gen = 0,
                    .right_gen = line.gen,
                });
            }
        }
    }

    /// Read two weaves side by side: for every line either one holds, what each
    /// side did there, in document order.
    ///
    /// `merge` answers *what is the one state*. This answers *what did each
    /// side do to reach it* -- the story the weave was named to be able to
    /// tell, where two branches that touched one line are SHOWN doing so
    /// rather than handed back as two opaque blobs.
    ///
    /// It reads exactly the inputs `merge` accepts and refuses exactly what
    /// `merge` refuses, by the same names and at the same edge, because a
    /// story about a merge that cannot happen is a story about nothing. That
    /// shared precondition is the whole seam between the two: the reading is
    /// the merge's own arithmetic printed instead of applied, so
    /// `note.gen()` is the generation `merge` lands on at that position and a
    /// witness holds the two to each other line for line.
    ///
    /// What this cannot yet tell, said here so the head promises no more than
    /// the code does: `apply` hands every insert a position from the end of
    /// the counter, so a line cannot land *between* two existing ones. The
    /// reading therefore names what each side did to each line, and not yet
    /// where a new line sits relative to the other side's delete. That second
    /// story wants an anchor per insert, which widens `Diff` -- a seam rather
    /// than a lap, and the same seam the module head names.
    ///
    /// Cost is |self| x |other| text comparisons, the same as `merge` and for
    /// the same reason: a weave carries no index from position to line, and a
    /// map earns its place when a measurement asks for one.
    ///
    /// The caller owns the returned slice; it is allocated from `allocator`.
    ///
    /// Precondition:  an identity held by both weaves carries the same text --
    ///   refused by name, and by the same reading `merge` takes: with the site
    ///   in the identity, one name on two lines is corruption rather than the
    ///   ordinary parting of two branches.
    /// Postcondition: identities strictly increase, and every note names a line
    ///   at least one side has seen.
    pub fn annotate(self: *const Weave, allocator: std.mem.Allocator, other: *const Weave) ![]const Note {
        // invariant: each weave already stands inside the named bound, so the
        // refusal below names the union rather than covering for an input that
        // was over the ceiling before a reading was ever asked for
        assert(self.lines.items.len <= max_weave_lines);
        assert(other.lines.items.len <= max_weave_lines);

        // One note per position in the union, and the union holds at most the
        // sum -- so checking the sum checks the notes, at the edge, before a
        // single one is written.
        if (self.lines.items.len + other.lines.items.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // usize lives at the inherited-std seam alone: ArrayListUnmanaged counts
        // in usize, and the bound just checked is what makes the cast safe.
        const self_len: u32 = @intCast(self.lines.items.len);
        const other_len: u32 = @intCast(other.lines.items.len);

        var out: std.ArrayListUnmanaged(Note) = .empty;
        errdefer out.deinit(allocator);
        try out.ensureTotalCapacity(allocator, self_len + other_len);

        // Each fold searches the side it does not iterate, so each side is put
        // in identity order once. The copies are scratch for this call and are
        // freed with it -- neither weave is touched, which is the promise the
        // head above makes, and a sorted copy is how it is kept while the
        // lookup still costs a search rather than a walk.
        const left_sorted = try allocator.alloc(Line, self_len);
        defer allocator.free(left_sorted);
        copy_lines(left_sorted, self.lines.items);
        sort_by_id(left_sorted);

        const right_sorted = try allocator.alloc(Line, other_len);
        defer allocator.free(right_sorted);
        copy_lines(right_sorted, other.lines.items);
        sort_by_id(right_sorted);

        try notes_from_left(&out, self.lines.items, right_sorted);
        notes_from_right(&out, left_sorted, other.lines.items);

        const result = try out.toOwnedSlice(allocator);
        std.mem.sort(Note, result, {}, struct {
            fn less_than(_: void, a: Note, b: Note) bool {
                return a.place().less_than(b.place());
            }
        }.less_than);

        for (result, 0..) |note, i| {
            // invariant: a note names a line at least one side has seen,
            // since an identity neither weave holds never enters the union
            assert(note.left_gen != 0 or note.right_gen != 0);
            if (i + 1 < result.len) {
                // invariant: identities strictly increase, which orders the
                // reading as a document and proves the union kept exactly one
                // note per identity -- the reading stays line for line with the
                // merge it describes, which is the seam between the two
                assert(result[i].place().less_than(result[i + 1].place()));
            }
        }

        return result;
    }
};
