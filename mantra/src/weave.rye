//! mantra/src/weave.rye -- the weave: a living history of a text stream.
//!
//! A Weave is a list of Lines. Each Line carries its text, a generation count,
//! and a stable position that never changes once assigned. Generation parity
//! names presence: odd = present, even = gone. Generations never decrease.
//! These two facts together mean the weave remembers every line ever seen --
//! its full history -- while current() surfaces only what is present now.
//!
//! The operations, listed rather than counted. This list is read against the
//! module's own `pub fn` declarations by
//! tools/fixtures/m/mantra_weave_head_scan.sh, in both directions, so an
//! operation that lands without a line here reds on the lap it arrives --
//! which is what `merge` did for half a day (REDS %506):
//!   Weave.empty()            -- an empty weave, no lines yet
//!   weave.apply(alloc, d)    -- advance the weave by one Diff
//!   weave.current(alloc)     -- the lines present now, in position order
//!   weave.merge(alloc, w)    -- one weave from two, by union and max
//!   weave.annotate(alloc, w) -- what each side did, one Note per position
//!
//! Part of Mantra -- TAME-first from line one.

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

/// The largest number of lines one weave holds, and the ceiling both `apply`
/// and `merge` read before they allocate anything. A weave keeps every line a
/// file has ever held, so its natural size is the whole history rather than the
/// current length; a million lines stands far above any history this tree has
/// written, and is small enough that the refusal arrives long before the
/// machine is in trouble.
pub const max_weave_lines: u32 = 1 << 20;

/// What a weave refuses, by name. Each refusal is read at the edge -- before an
/// allocation is made, rather than after one has grown.
pub const WeaveError = error{
    /// Two weaves hold one position with different text. A position names a
    /// line for all time, so this says the two positions came from counters
    /// that never met -- and merging them would keep one line while silently
    /// dropping the other, which is the single outcome a weave exists to
    /// prevent. Refusing here is what keeps the history whole.
    PositionTextDisagrees,
    /// The weave would pass max_weave_lines -- by a diff's inserts in `apply`,
    /// or by the union of two weaves in `merge`.
    TooManyLines,
};

/// A single line in the weave. Once added, its position is permanent.
///
/// Invariants:
///   gen >= 1         -- zero is reserved; every line starts at generation 1
///   gen is odd       <->  line is currently present
pub const Line = struct {
    text: []const u8,
    gen: u32,
    pos: u32,
};

/// An edit to a weave: a set of lines to insert (with their text) and a set
/// of positions to delete (by stable position). Inserts arrive in the order
/// they should appear; deletes are positions of currently-present lines.
pub const Diff = struct {
    inserts: []const []const u8, // text of new lines, in order
    deletes: []const u32,        // positions of lines to remove
};

/// What the two sides did at one position, in a single word.
///
/// The five readings are exhaustive over two generation counts, which is why
/// `Note.reading` needs no default arm: either exactly one side has seen the
/// position, or both have and their counts are equal, or both have and one
/// stands higher.
pub const Reading = enum {
    /// Only the left weave has ever seen this position, so the left is the
    /// side that added the line and the right has not met it yet.
    left_only,
    /// The mirror: only the right weave has seen it.
    right_only,
    /// Both hold the position at the same count, so neither side has touched
    /// it since they parted. Parity says whether that shared state is present
    /// or gone.
    agreed,
    /// Both have seen it and the left's count stands higher, so the left is
    /// the side that acted last. `present_left` says whether the act left the
    /// line present or gone.
    left_moved,
    /// The mirror: the right acted last.
    right_moved,
};

/// One position, read from both sides: what each weave holds there, and what a
/// merge of the two lands on.
///
/// A generation of **zero** means that side has never seen this position. Zero
/// is already reserved by the module -- every line starts at generation 1 --
/// and zero is also even, so an unseen position reads as not-present through
/// the same parity test every other reading uses, with no special case
/// anywhere.
///
/// The merged generation is derived rather than stored. Holding a third count
/// beside the two it comes from would let the story and the merge drift into
/// two answers, and a story that can disagree with the thing it describes is
/// worse than no story.
pub const Note = struct {
    pos: u32,
    left_gen: u32,
    right_gen: u32,

    /// The generation a merge of the two sides lands on at this position --
    /// the same `@max` the merge itself takes, read from the same two counts.
    pub fn gen(self: Note) u32 {
        return @max(self.left_gen, self.right_gen);
    }

    /// Whether the left side holds this line present. Parity is the tombstone,
    /// and zero is even, so a side that never saw the position answers false.
    pub fn present_left(self: Note) bool {
        return self.left_gen % 2 == 1;
    }

    /// The mirror, for the right side.
    pub fn present_right(self: Note) bool {
        return self.right_gen % 2 == 1;
    }

    /// The story at this position in one word.
    pub fn reading(self: Note) Reading {
        // invariant: a note names a position at least one side has seen, since
        // a position neither weave holds never enters the union at all
        assert(self.left_gen != 0 or self.right_gen != 0);
        if (self.right_gen == 0) return .left_only;
        if (self.left_gen == 0) return .right_only;
        if (self.left_gen == self.right_gen) return .agreed;
        // invariant: both counts are real and they differ, so exactly one side
        // stands higher and the two arms below name it rather than falling
        // through to a default that would hide a fourth case
        assert(self.left_gen != self.right_gen);
        if (self.left_gen > self.right_gen) return .left_moved;
        return .right_moved;
    }
};

/// A Weave: the living history of a text stream.
///
/// Invariant: for all i < lines.items.len:
///   lines.items[i].gen >= 1
///   lines.items[i].pos < next_pos
///   gen counts are non-decreasing across successive apply calls
pub const Weave = struct {
    lines: std.ArrayListUnmanaged(Line),
    next_pos: u32,

    /// An empty weave -- no history yet.
    pub fn empty() Weave {
        return .{ .lines = .empty, .next_pos = 0 };
    }

    /// Advance the weave by one diff. Deletes remove lines by toggling their
    /// generation to even (gone); inserts append new lines at the current
    /// generation (1 = first time seen). Position counters are assigned
    /// monotonically and never reused.
    ///
    /// Precondition:  every delete position exists in the weave and is present
    ///   (odd gen) -- asserted individually.
    /// Postcondition: all inserted lines carry gen == 1 and odd (present);
    ///   all deleted lines carry gen % 2 == 0 (gone).
    pub fn apply(self: *Weave, allocator: std.mem.Allocator, diff: Diff) !void {
        // invariant: the weave already stands inside its own ceiling, so the
        // refusal just below names the diff rather than covering for a weave
        // that was over the ceiling before this call arrived
        assert(self.lines.items.len <= max_weave_lines);

        // The weave grows by exactly the diff's inserts, so the sum is what the
        // ceiling reads -- at the edge, before a single line is appended.
        if (self.lines.items.len + diff.inserts.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // Process deletes first: find each position and bump its gen to even.
        for (diff.deletes) |target_pos| {
            var found = false;
            for (self.lines.items) |*line| {
                if (line.pos == target_pos) {
                    // invariant: an odd generation means present -- the parity IS the
                    // tombstone, so an even one reaching here would be a deleted line treated
                    // as live
                    assert(line.gen % 2 == 1);
                    line.gen += 1;                       // odd -> even: mark gone
                    found = true;
                    break;
                }
            }
            // invariant: a delete names a position the weave holds, since deleting one that is
            // not there would report success for a change that never happened
            assert(found);
        }

        // Process inserts: each new line enters at generation 1 (first appearance,
        // present). Position is assigned from the monotone counter.
        for (diff.inserts) |text| {
            const line = Line{
                .text = text,
                .gen   = 1,
                .pos   = self.next_pos,
            };
            // invariant: an odd generation means present -- the parity IS the tombstone, so an
            // even one reaching here would be a deleted line treated as live
            assert(line.gen % 2 == 1);
            try self.lines.append(allocator, line);
            self.next_pos += 1;
        }

        // Postcondition: every line in the weave has a valid, assigned position.
        for (self.lines.items) |line| {
            // invariant: a line carries a real generation and a position inside the weave's own
            // counter, so neither ordering nor identity is left to the caller
            assert(line.gen >= 1);
            assert(line.pos < self.next_pos);
        }
    }

    /// Return the lines currently present (odd generation), in position order.
    /// The caller owns the returned slice; it is allocated from `allocator`.
    pub fn current(self: *const Weave, allocator: std.mem.Allocator) ![]const Line {
        // invariant: the weave stands inside its own ceiling, so the slice this
        // returns is bounded by max_weave_lines rather than by whoever calls it
        assert(self.lines.items.len <= max_weave_lines);
        var out: std.ArrayListUnmanaged(Line) = .empty;
        for (self.lines.items) |line| {
            if (line.gen % 2 == 1) { // odd = present
                try out.append(allocator, line);
            }
        }
        // Sort by position -- inserts append to the backing list in order of
        // arrival; a merge may interleave positions from two weave branches.
        const result = try out.toOwnedSlice(allocator);
        std.mem.sort(Line, result, {}, struct {
            fn less_than(_: void, a: Line, b: Line) bool {
                return a.pos < b.pos;
            }
        }.less_than);

        // Postcondition: result is sorted and all entries are present.
        for (result) |line| {
            // invariant: an odd generation means present -- the parity IS the tombstone, so an
            // even one reaching here would be a deleted line treated as live
            assert(line.gen % 2 == 1);
        }
        for (result, 0..) |line, i| {
            if (i + 1 < result.len) {
                // invariant: the result comes out ordered by position, which is what makes a
                // weave readable as a document rather than a bag of lines
                assert(result[i].pos < result[i + 1].pos);
            }
            _ = line;
        }

        return result;
    }

    /// Fold one weave's lines into a list already holding the other's: a line
    /// whose position is already held joins by the higher generation, and one
    /// whose position is new is appended.
    ///
    /// The caller has already ensured capacity for the whole union, so nothing
    /// here allocates and the only way out is the refusal.
    ///
    /// Precondition:  `out` has room for every line of `incoming`.
    /// Postcondition: every position of `incoming` is held by `out` exactly once.
    fn union_into(out: *std.ArrayListUnmanaged(Line), incoming: []const Line) WeaveError!void {
        // invariant: the list can take the whole union without growing, which is
        // what lets this fold run with no allocator and no error but the refusal
        assert(out.capacity >= out.items.len + incoming.len);
        // invariant: the union stays inside the weave's own ceiling, so the
        // append below can never carry the list past what merge already checked
        assert(out.items.len + incoming.len <= max_weave_lines);

        for (incoming) |line| {
            var joined = false;
            for (out.items) |*held| {
                if (held.pos != line.pos) continue;
                if (!std.mem.eql(u8, held.text, line.text)) {
                    return WeaveError.PositionTextDisagrees;
                }
                // The join itself. Max carries parity with it, so a delete on
                // either side survives a merge with a side still holding the
                // line -- gone is a larger count than present, and larger wins.
                held.gen = @max(held.gen, line.gen);
                joined = true;
                break;
            }
            if (!joined) {
                out.appendAssumeCapacity(line);
            }
        }
    }

    /// Merge another weave into this one, returning a new weave and leaving
    /// both arguments exactly as they were.
    ///
    /// A position names a line for all time. So a position both weaves hold is
    /// one line seen twice, and a position only one of them holds is a line the
    /// other has not seen yet. The rule is therefore a union over positions
    /// where the HIGHER GENERATION wins -- no commit identifier is consulted,
    /// only the counts in front of it, which is what keeps the merge structural.
    ///
    /// Three operations sit underneath: union of the positions, max on the
    /// generation, max on next_pos. Each of the three is commutative,
    /// associative, and idempotent, so the merge is all three as well -- by
    /// construction rather than by care. Sorting the result by position makes
    /// that structural rather than merely visible: `a.merge(alloc, b)` and
    /// `b.merge(alloc, a)` come out equal field for field, rather than only
    /// equal once they are read as a document.
    ///
    /// Cost is |self| x |other| text comparisons, since a weave carries no index
    /// from position to line. That is deliberate at this size: the bound above
    /// names the ceiling, and a map earns its place when a measurement asks for
    /// one rather than before.
    ///
    /// Refusal keeps that order-independence. Weaves that pairwise agree on
    /// their shared positions are closed under merge -- the merged text at a
    /// position comes from one of the two sides, and both already agreed with
    /// the third -- so no grouping can hide a disagreement from a later one.
    ///
    /// Precondition:  a position held by both weaves carries the same text --
    ///   refused by name, because two counters that never met hand the same
    ///   small integers to different lines.
    /// Postcondition: positions strictly increase, every line keeps a real
    ///   generation, and next_pos stands above every position in the result.
    pub fn merge(self: *const Weave, allocator: std.mem.Allocator, other: *const Weave) !Weave {
        // invariant: each weave already stands inside the named bound, so a
        // refusal below names the union rather than covering for an input that
        // was over the ceiling before a merge was ever asked for
        assert(self.lines.items.len <= max_weave_lines);
        assert(other.lines.items.len <= max_weave_lines);

        // The union holds at most the sum, so checking the sum checks the union
        // -- at the edge, before a single line is copied.
        if (self.lines.items.len + other.lines.items.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // usize lives at the inherited-std seam alone: ArrayListUnmanaged counts
        // in usize, and the bound just checked is what makes the cast safe.
        const self_len: u32 = @intCast(self.lines.items.len);
        const other_len: u32 = @intCast(other.lines.items.len);

        var out: std.ArrayListUnmanaged(Line) = .empty;
        errdefer out.deinit(allocator);
        try out.ensureTotalCapacity(allocator, self_len + other_len);
        for (self.lines.items) |line| {
            out.appendAssumeCapacity(line);
        }

        try union_into(&out, other.lines.items);

        std.mem.sort(Line, out.items, {}, struct {
            fn less_than(_: void, a: Line, b: Line) bool {
                return a.pos < b.pos;
            }
        }.less_than);

        const merged = Weave{
            .lines = out,
            .next_pos = @max(self.next_pos, other.next_pos),
        };

        for (merged.lines.items, 0..) |line, i| {
            // invariant: a line carries a real generation, since zero is
            // reserved and a merge must never invent one
            assert(line.gen >= 1);
            // invariant: every position stays under the merged counter, so the
            // next insert is handed one neither side has ever used
            assert(line.pos < merged.next_pos);
            if (i + 1 < merged.lines.items.len) {
                // invariant: positions strictly increase, which both orders the
                // document and proves the union kept exactly one line per
                // position
                assert(merged.lines.items[i].pos < merged.lines.items[i + 1].pos);
            }
        }

        return merged;
    }

    /// Append one note per position the LEFT holds, carrying the right's count
    /// beside it -- zero when the right has never seen it. The text comparison
    /// lives here, so the fold below reads positions alone.
    ///
    /// The caller has already ensured capacity for the whole union, so nothing
    /// here allocates and the only way out is the refusal. This is the same
    /// shape `union_into` takes for `merge`, on purpose: two folds over one
    /// union, and the reading differs only in what it writes down.
    ///
    /// Precondition:  `out` has room for every line of `left`.
    /// Postcondition: `out` holds one note per position of `left`.
    fn notes_from_left(
        out: *std.ArrayListUnmanaged(Note),
        left: []const Line,
        right: []const Line,
    ) WeaveError!void {
        // invariant: the list can take the whole fold without growing, which is
        // what lets this run with no allocator and no error but the refusal
        assert(out.capacity >= out.items.len + left.len);
        // invariant: the fold stays inside the weave's own ceiling, so the
        // append below can never carry the list past what annotate checked
        assert(out.items.len + left.len <= max_weave_lines);

        for (left) |line| {
            var right_gen: u32 = 0;
            for (right) |held| {
                if (held.pos != line.pos) continue;
                if (!std.mem.eql(u8, held.text, line.text)) {
                    return WeaveError.PositionTextDisagrees;
                }
                right_gen = held.gen;
                break;
            }
            out.appendAssumeCapacity(.{
                .pos = line.pos,
                .left_gen = line.gen,
                .right_gen = right_gen,
            });
        }
    }

    /// Append a note for each position only the RIGHT has seen. Every shared
    /// position already had its text compared by the fold above, so this one
    /// reads positions alone and cannot refuse.
    ///
    /// Precondition:  `out` has room for every line of `right`.
    /// Postcondition: every position of `right` is held by `out` exactly once.
    fn notes_from_right(
        out: *std.ArrayListUnmanaged(Note),
        left: []const Line,
        right: []const Line,
    ) void {
        // invariant: the list can take the whole fold without growing, which is
        // what lets this run with no allocator at all
        assert(out.capacity >= out.items.len + right.len);
        // invariant: the fold stays inside the weave's own ceiling, so the
        // append below can never carry the list past what annotate checked
        assert(out.items.len + right.len <= max_weave_lines);

        for (right) |line| {
            var shared = false;
            for (left) |held| {
                if (held.pos == line.pos) {
                    shared = true;
                    break;
                }
            }
            if (!shared) {
                out.appendAssumeCapacity(.{
                    .pos = line.pos,
                    .left_gen = 0,
                    .right_gen = line.gen,
                });
            }
        }
    }

    /// Read two weaves side by side: for every position either one holds, what
    /// each side did there, in position order.
    ///
    /// `merge` answers *what is the one state*. This answers *what did each
    /// side do to reach it* -- the story the weave was named to be able to
    /// tell, where two branches that touched one line are SHOWN doing so
    /// rather than handed back as two opaque blobs.
    ///
    /// It reads exactly the inputs `merge` accepts and refuses exactly what
    /// `merge` refuses, by the same names and at the same edge, because a
    /// story about a merge that cannot happen is a story about nothing. That
    /// shared precondition is the whole seam between the two: the reading is
    /// the merge's own arithmetic printed instead of applied, so
    /// `note.gen()` is the generation `merge` lands on at that position and a
    /// witness holds the two to each other line for line.
    ///
    /// What this cannot yet tell, said here so the head promises no more than
    /// the code does: `apply` hands every insert a position from the end of
    /// the counter, so document order is arrival order and a line cannot land
    /// *between* two existing ones. The reading therefore names what each side
    /// did to each line, and not yet where a new line sits relative to the
    /// other side's delete. That second story wants an anchor per insert,
    /// which widens `Diff` -- a seam rather than a lap.
    ///
    /// Cost is |self| x |other| text comparisons, the same as `merge` and for
    /// the same reason: a weave carries no index from position to line, and a
    /// map earns its place when a measurement asks for one.
    ///
    /// The caller owns the returned slice; it is allocated from `allocator`.
    ///
    /// Precondition:  a position held by both weaves carries the same text --
    ///   refused by name, since two counters that never met hand the same
    ///   small integers to different lines.
    /// Postcondition: positions strictly increase, and every note names a
    ///   position at least one side has seen.
    pub fn annotate(self: *const Weave, allocator: std.mem.Allocator, other: *const Weave) ![]const Note {
        // invariant: each weave already stands inside the named bound, so the
        // refusal below names the union rather than covering for an input that
        // was over the ceiling before a reading was ever asked for
        assert(self.lines.items.len <= max_weave_lines);
        assert(other.lines.items.len <= max_weave_lines);

        // One note per position in the union, and the union holds at most the
        // sum -- so checking the sum checks the notes, at the edge, before a
        // single one is written.
        if (self.lines.items.len + other.lines.items.len > max_weave_lines) {
            return WeaveError.TooManyLines;
        }

        // usize lives at the inherited-std seam alone: ArrayListUnmanaged counts
        // in usize, and the bound just checked is what makes the cast safe.
        const self_len: u32 = @intCast(self.lines.items.len);
        const other_len: u32 = @intCast(other.lines.items.len);

        var out: std.ArrayListUnmanaged(Note) = .empty;
        errdefer out.deinit(allocator);
        try out.ensureTotalCapacity(allocator, self_len + other_len);

        try notes_from_left(&out, self.lines.items, other.lines.items);
        notes_from_right(&out, self.lines.items, other.lines.items);

        const result = try out.toOwnedSlice(allocator);
        std.mem.sort(Note, result, {}, struct {
            fn less_than(_: void, a: Note, b: Note) bool {
                return a.pos < b.pos;
            }
        }.less_than);

        for (result, 0..) |note, i| {
            // invariant: a note names a position at least one side has seen,
            // since a position neither weave holds never enters the union
            assert(note.left_gen != 0 or note.right_gen != 0);
            if (i + 1 < result.len) {
                // invariant: positions strictly increase, which orders the
                // reading as a document and proves the union kept exactly one
                // note per position
                assert(result[i].pos < result[i + 1].pos);
            }
        }

        return result;
    }
};
