//! comlink/guest_roster_tx.rye -- send the sealed roster pairs across virtio-net.
//!
//! Same card and same seal as guest_sealed_tx.rye. The payload is the four
//! canonical pairs. expected_message stays the sentence the sealed guests open.

const vn = @import("virtio_net.rye");
const tally_copy = @import("tally_copy.rye");
const wf = @import("wire_format.rye");

const pairs =
    "serial_driver serial_virt\n" ++
    "serial_virt client_a\n" ++
    "serial_virt client_b\n" ++
    "client_a timer_driver";

var tx: vn.TxQueue = undefined;

export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ li sp, 0x80100000
        \\ j kmain
    );
}

export fn kmain() callconv(.c) noreturn {
    vn.init_device();
    tx.init();
    vn.driver_ok();

    var scratch: [@intCast(wf.wire_capacity)]u8 = undefined;
    const dg_len: u32 = @intCast(wf.seal_message(pairs, &scratch) catch {
        vn.write_str("comlink device wire: roster pairs FAIL — seal refused\n");
        vn.finish_fail();
    });

    const buf = tx.frame();
    @memset(buf[0..vn.virtio_net_hdr_len], 0);
    const eoff = vn.virtio_net_hdr_len;
    var i: u32 = 0;
    while (i < 6) : (i += 1) buf[eoff + i] = 0xff;
    while (i < 12) : (i += 1) buf[eoff + i] = 0x00;
    buf[eoff + 12] = @truncate(vn.lab_ethertype >> 8);
    buf[eoff + 13] = @truncate(vn.lab_ethertype);
    const poff = eoff + vn.eth_header_len;
    tally_copy.copy_disjoint(u8, buf[poff..][0..dg_len], scratch[0..dg_len]);
    tx.send(poff + dg_len);
    vn.write_str("comlink device wire: roster pairs TX sent\n");
    vn.finish_pass();
}
