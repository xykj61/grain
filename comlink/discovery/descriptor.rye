//! comlink/discovery/descriptor.rye — a peer's signed self-description, bounded.
//!
//! Build Journey v32 · slot 0 · five_primitives · equinox A · journey 1.
//! Bounds inherited from tools/gen/season/recursion_block.brix (v27 seat):
//!   discovery_descriptor_max_bytes 512
//! A descriptor is key · transport hints · freshness · lineage — nothing more.
//! Mycelium is untouched; discovery finds peers and never orders them.
//!
//!   rye run comlink/discovery/descriptor_test.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const tally_copy = @import("tally_copy.rye");

/// Hard ceiling — seated before this file existed (v27 · explicit_bounds).
pub const descriptor_max_bytes: u32 = 512;

/// One peer descriptor: length-prefixed bytes inside the seated bound.
pub const Descriptor = struct {
    bytes: [descriptor_max_bytes]u8 = undefined,
    len: u32 = 0,

    pub fn init_empty() Descriptor {
        return .{};
    }

    /// Welcome: a payload that fits. Refuse: one that does not.
    pub fn from_slice(src: []const u8) ?Descriptor {
        if (src.len > descriptor_max_bytes) return null;
        var d = Descriptor{};
        tally_copy.copy_disjoint(u8, d.bytes[0..src.len], src);
        d.len = @intCast(src.len);
        // invariant: the descriptor is held in a fixed buffer of descriptor_max_bytes, so a
        // longer one would be stored truncated and read back as a different descriptor
        assert(d.len <= descriptor_max_bytes);
        return d;
    }

    pub fn as_slice(d: *const Descriptor) []const u8 {
        // invariant: the descriptor is held in a fixed buffer of descriptor_max_bytes, so a
        // longer one would be stored truncated and read back as a different descriptor
        assert(d.len <= descriptor_max_bytes);
        return d.bytes[0..d.len];
    }

    pub fn remaining(d: *const Descriptor) u32 {
        // invariant: the descriptor is held in a fixed buffer of descriptor_max_bytes, so a
        // longer one would be stored truncated and read back as a different descriptor
        assert(d.len <= descriptor_max_bytes);
        return descriptor_max_bytes - d.len;
    }
};
