//! comlink/guest_roster_rx.rye -- open the sealed roster pairs from virtio-net.
//!
//! Same card and same open as guest_sealed_rx.rye. The opened bytes are the
//! four canonical pairs. The sealed guests still open their own sentence.

const vn = @import("virtio_net.rye");
const wf = @import("wire_format.rye");

const pairs =
    "serial_driver serial_virt\n" ++
    "serial_virt client_a\n" ++
    "serial_virt client_b\n" ++
    "client_a timer_driver";

var rx: vn.RxQueue = undefined;

export fn _start() linksection(".text.init") callconv(.naked) noreturn {
    asm volatile (
        \\ li sp, 0x80100000
        \\ j kmain
    );
}

fn same_pairs(a: []const u8) bool {
    if (a.len != pairs.len) return false;
    var i: usize = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != pairs[i]) return false;
    }
    return true;
}

export fn kmain() callconv(.c) noreturn {
    vn.init_device();
    rx.init();
    vn.driver_ok();
    rx.kick();

    const n = rx.wait_frame();
    if (n == 0) {
        vn.write_str("comlink device wire: roster pairs FAIL — RX timeout\n");
        vn.finish_fail();
    }
    const poff = vn.virtio_net_hdr_len + vn.eth_header_len;
    if (n <= poff) {
        vn.write_str("comlink device wire: roster pairs FAIL — frame too short\n");
        vn.finish_fail();
    }
    const buf = rx.frame();
    var opened: [@intCast(wf.max_message)]u8 = undefined;
    const msg_len = wf.open_datagram(buf[poff..n], &opened) catch {
        vn.write_str("comlink device wire: roster pairs FAIL — open refused\n");
        vn.finish_fail();
    };
    if (!same_pairs(opened[0..@intCast(msg_len)])) {
        vn.write_str("comlink device wire: roster pairs FAIL — pair mismatch\n");
        vn.finish_fail();
    }
    vn.write_str("comlink device wire: roster pairs GREEN — four pairs opened\n");
    vn.finish_pass();
}
