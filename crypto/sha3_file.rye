//! crypto/sha3_file.rye -- the SHA3-256 of a file, over this tree's own authored Keccak.
//!
//! WHY THIS EXISTS. The Amphora and Cellar fixtures pinned `openssl dgst -sha3-256` as their
//! digest, and `openssl` is absent from this pier -- so Amphora lap 2 could not run, which in turn
//! kept the fascia meter silent for an unknown span (REDS %112). The obvious substitution is the
//! wrong one: `sha256sum` computes SHA-2, and SHA3-256 is Keccak. They are different algorithms,
//! not two spellings of one, and swapping them would silently change every content address in
//! every manifest this tree has written.
//!
//! So the digest comes from OUR OWN code instead. `crypto/sha3.rye` is authored Rye over
//! Keccak-f[1600], studied clean-room from FIPS 202 and parity-checked, and it computes exactly
//! the algorithm the hash-tier spec already names for the Working tier
//! (`context/specs/20260703-191112_resins-and-hash-tiers.md`). Same algorithm, same digests, no
//! external dependency, and one more place the tree stands on what it built.
//!
//! WHAT THIS DOES NOT REPLACE. That spec calls openssl the *independent host oracle*, and it was
//! right to: a digest checked only against the code that produced it proves less than one checked
//! against a stranger. This tool is the IMPLEMENTATION, so the lap runs anywhere; openssl stays
//! the ORACLE wherever it is installed, and `tools/sha3_file_witness.rish` checks our digests
//! against published FIPS 202 answers so the parity claim rests on a public standard rather than
//! on whichever tools a given machine happens to carry.
//!
//! Season: the Standfast restrategizing of `20260821` -- closing the last known red on this pier.
//!
//!   rye/bin/rye build crypto/sha3_file.rye -femit-bin=crypto/bin/sha3-256
//!   crypto/bin/sha3-256 <path>          # prints 64 lowercase hex characters and a newline

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const sha3 = @import("sha3.rye");

/// Every file this digests is a manifest, a resin, or a test fixture -- none of them large. The
/// bound is named rather than unlimited because `hash256` takes the whole message in memory, so
/// an unbounded read is an unbounded allocation wearing a convenience API.
const max_file_bytes: u32 = 64 * 1024 * 1024;

/// A SHA3-256 digest is 32 bytes, so its hex rendering is exactly 64 characters.
const hex_len: u32 = 64;

pub fn main(init: std.process.Init) !u8 {
    const a = init.arena.allocator();
    const io = init.io;

    const args = init.minimal.args.toSlice(a) catch return error.OutOfMemory;
    if (args.len < 2) {
        print("usage: sha3-256 <path>\n", .{});
        return 2;
    }
    const path = args[1];

    // invariant: a path is named before anything is opened, since a digest of nothing is a lie
    // that looks exactly like a digest.
    assert(path.len != 0);

    const cwd = std.Io.Dir.cwd();
    const data = cwd.readFileAlloc(io, path, a, std.Io.Limit.limited(max_file_bytes)) catch |err| {
        print("sha3-256: cannot read {s}: {s}\n", .{ path, @errorName(err) });
        return 1;
    };

    // invariant: the read stayed inside the bound this file names, so the digest below covers the
    // whole file rather than a silently truncated prefix.
    assert(data.len <= max_file_bytes);

    const digest = try sha3.hash256(data);

    // invariant: the digest is the width SHA3-256 promises, so the hex buffer below is exact.
    assert(digest.len == sha3.digest_256);

    var hex: [hex_len + 1]u8 = undefined;
    sha3.to_hex(digest[0..], hex[0..hex_len]);
    hex[hex_len] = '\n';

    // The digest goes to STDOUT, not through `print`, which is std.debug.print and writes to
    // stderr. A tool whose whole output is one value must put that value where a caller captures
    // it -- the first shape of this file printed a perfect digest that every `$(...)` around it
    // read as the empty string.
    var out = std.Io.File.stdout();
    try out.writeStreamingAll(io, hex[0..]);
    return 0;
}
