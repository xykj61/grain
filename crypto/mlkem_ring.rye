//! crypto/mlkem_ring.rye — Season G (Cryptography): the ML-KEM base ring, the first rung of the post-quantum arc. Every lattice operation in
//! ML-KEM (NIST FIPS 203, CRYSTALS-Kyber) lives in one polynomial ring — R_q = Z_q[X]/(X²⁵⁶ + 1) with the prime modulus q = 3329 — and the
//! whole scheme's speed rests on multiplying in that ring through the Number Theoretic Transform (NTT), the finite-field cousin of the FFT that
//! turns a 256-by-256 schoolbook convolution into 128 tiny degree-1 products. This module authors that ring in pure Rye: modular add/sub/mul
//! mod 3329, the forward NTT, the inverse NTT, and the pointwise multiply in the NTT domain — the arithmetic every later ML-KEM rung (encode,
//! sample, keygen, encaps/decaps) stands on. It is the post-quantum counterpart to crypto/fe25519.rye: a field/ring stone that authors no
//! protocol, only the mathematics the protocol composes.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, parity-checked, audit-ready).
//! Design read: active-designing/date/20260816/20260816-161537_post-quantum-mlkem-mldsa-pivot.md — the pivot that seats ML-KEM/ML-DSA on the doubled oracle
//! (a FIPS known-answer AND an independent second implementation agreeing byte-for-byte), because the vendored Zig std.crypto ships ml_kem.zig
//! and ml_dsa.zig but no SLH-DSA. Rye-first spine: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md.
//! Kin: crypto/shake.rye (the XOF that will seed ML-KEM's matrix and noise, GREEN) · crypto/fe25519.rye (the classical field sibling) ·
//! crypto/sha3.rye. The parity TARGET is Zig's std.crypto ml_kem and the FIPS 203 known-answers, studied clean-room — never a copied line
//! (.claude/rules/gratitude-licenses.md).
//!
//! THE HONEST PARITY BOUNDARY — FIPS 203 specifies STANDARD-domain arithmetic (the primitive 256th root ζ = 17, plain reduction mod q); Zig's
//! std.crypto computes internally in MONTGOMERY domain for speed. The two disagree on the representation of an intermediate NTT coefficient, yet
//! agree byte-for-byte at every published boundary (encoded keys, ciphertexts) because both normalize to the canonical residue before encoding.
//! So this module authors the SPEC's standard domain — clean, auditable, FIPS-faithful — and its correctness is proven here by SELF-CONSISTENCY,
//! exactly where crypto/elligator.rye's round-trip identity stood when Zig shipped no Elligator to diff: the NTT round-trip inv_ntt(ntt(f)) = f,
//! and the decisive one, that multiply-in-the-NTT-domain equals schoolbook negacyclic convolution — inv_ntt(ntt(f) ∘ ntt(g)) = f ⊛ g in
//! R_q — over a deterministic spread of pseudo-random polynomials. The byte-boundary parity against Zig std.crypto arrives at the keygen rung.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device. This module holds no key and signs nothing; it computes in
//! a ring. It calls no std.crypto. Constant-time timing-safety stays the Season's named horizon — the arithmetic here is data-independent by
//! construction (no branch depends on a coefficient's value), yet a timing CLAIM wants measurement on metal, so this rung proves CORRECTNESS.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/mlkem_ring.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const mlkem_ring_version = "20260816.161537";

/// ML-KEM's prime modulus, q = 3329 = 13·256 + 1 — chosen so that 256 divides q − 1, which is exactly what lets a primitive 256th root of unity
/// exist mod q and the NTT split the ring all the way down to degree-1 factors (FIPS 203 §2.4). Every coefficient this module handles lives in
/// the reduced range [0, q).
pub const q: u32 = 3329;

/// The ring degree: R_q = Z_q[X]/(X²⁵⁶ + 1), so every polynomial carries exactly 256 coefficients. Named so every loop and the Poly array both
/// cite one ceiling rather than a bare literal.
pub const n: u32 = 256;

/// The primitive 256th root of unity mod q that FIPS 203 fixes for the transform (ζ = 17): 17²⁵⁶ ≡ 1 and 17¹²⁸ ≡ −1 (mod 3329), the property
/// the selftest anchors on. Every zeta the NTT twiddles by is a power of this root.
pub const zeta_root: u32 = 17;

/// 128⁻¹ mod q = 3303 — the scale the inverse NTT applies to every coefficient at the end, undoing the factor of 128 the seven butterfly layers
/// accumulate (FIPS 203 Algorithm 10). Derived from the field (128·3303 = 422784 = 127·3329 + 1), asserted in the selftest, never a lone limb.
pub const inv128: u32 = 3303;

/// The faults this ring's selftest can raise — every one a proof that failed, never a runtime path (the arithmetic below cannot fail; it reduces).
pub const MlkemRingError = error{
    /// The primitive-root anchors (ζ²⁵⁶ = 1, ζ¹²⁸ = −1, or 128·inv128 = 1) did not hold — a wrong constant, caught before any transform.
    RootAnchorMismatch,
    /// The bit-reversal of a 7-bit index did not match its known value — the index permutation the zetas table rests on is wrong.
    BitRevMismatch,
    /// inv_ntt(ntt(f)) did not return f — the forward and inverse transforms disagree.
    RoundTripMismatch,
    /// inv_ntt(ntt(f) ∘ ntt(g)) did not equal the schoolbook negacyclic convolution f ⊛ g — the NTT multiply is wrong.
    ConvolutionMismatch,
    /// A test polynomial came out identically zero, so a passing check would prove nothing — the selftest refuses a trivial witness.
    TrivialWitness,
};

/// A ring element: 256 coefficients over Z_q, each kept in the reduced range [0, q). The same layout in the standard domain and the NTT domain —
/// what changes between them is which basis the coefficients speak in, not their storage.
pub const Poly = struct {
    cs: [n]u32,
};

/// add_mod — (a + b) mod q for a, b already in [0, q). One add stays below 2q < 2³², so a single reduction lands the result back in range.
fn add_mod(a: u32, b: u32) u32 {
    // invariant (precondition): both inputs are already reduced, so their sum cannot overflow u32.
    assert(a < q and b < q);
    const r = (a + b) % q;
    // invariant (postcondition): the result is a canonical residue.
    assert(r < q);
    return r;
}

/// sub_mod — (a − b) mod q for a, b in [0, q). Add q before subtracting so the intermediate never underflows in unsigned arithmetic.
fn sub_mod(a: u32, b: u32) u32 {
    // invariant (precondition): both inputs are reduced, so a + q − b stays below 2q.
    assert(a < q and b < q);
    const r = (a + q - b) % q;
    // invariant (postcondition): the difference is a canonical residue.
    assert(r < q);
    return r;
}

/// mul_mod — (a · b) mod q for a, b in [0, q). The product is below q·q ≈ 1.1·10⁷, well inside u32, so one multiply-then-reduce is exact.
fn mul_mod(a: u32, b: u32) u32 {
    // invariant (precondition): both inputs are reduced, so the product fits u32 with room to spare (q·q < 2²⁴).
    assert(a < q and b < q);
    const r = (a * b) % q;
    // invariant (postcondition): the product reduces to a canonical residue.
    assert(r < q);
    return r;
}

/// pow_mod — base^exp mod q by square-and-multiply, the helper the zeta tables are computed with. Comptime-callable, so the tables below are
/// built at compile time exactly as Zig's own std.crypto ml_kem builds its zetas.
fn pow_mod(base: u32, exp: u32) u32 {
    // invariant (precondition): the base is reduced so every squaring stays a valid mul_mod input.
    assert(base < q);
    var result: u32 = 1;
    var b: u32 = base % q;
    var e: u32 = exp;
    // invariant (bound): the exponent halves each turn, so the loop runs at most 32 times (u32 has 32 bits) — never unbounded.
    var guard: u32 = 0;
    while (e > 0) : (guard += 1) {
        // invariant: the exponent is at most 32 bits, so a square-and-multiply walking its bits
        // ends inside this count rather than looping on a value it cannot reach
        assert(guard < 32);
        if ((e & 1) == 1) result = mul_mod(result, b);
        b = mul_mod(b, b);
        e >>= 1;
    }
    // invariant (postcondition): the result is a canonical residue.
    assert(result < q);
    return result;
}

/// bitrev7 — reverse the low 7 bits of x, the index permutation FIPS 203's zetas table is laid out under (zetas[k] = ζ^BitRev7(k)). The seven
/// bits are exactly enough to index the 128 twiddle factors.
fn bitrev7(x: u32) u32 {
    // invariant (precondition): the index addresses one of the 128 twiddles, so it fits in 7 bits.
    assert(x < 128);
    var r: u32 = 0;
    var i: u32 = 0;
    // invariant (bound): exactly seven bit moves, the width of a 128-entry index.
    while (i < 7) : (i += 1) {
        r = (r << 1) | ((x >> @as(u5, @intCast(i))) & 1);
    }
    // invariant (postcondition): a reversed 7-bit value still fits 7 bits.
    assert(r < 128);
    return r;
}

/// compute_zetas — the forward-NTT twiddle table, zetas[k] = ζ^BitRev7(k) mod q for k in 0..128 (FIPS 203 §4.3, ζ = 17). Built at comptime from
/// the field, never a pasted table, so a wrong root cannot slip in unproven.
fn compute_zetas() [128]u32 {
    // Building 128 twiddles by square-and-multiply at comptime crosses Zig's default 1000-branch budget; raise it for this pure computation.
    @setEvalBranchQuota(100000);
    var table: [128]u32 = undefined;
    var k: u32 = 0;
    // invariant (bound): exactly 128 twiddles, one per NTT butterfly index.
    while (k < 128) : (k += 1) {
        table[k] = pow_mod(zeta_root, bitrev7(k));
    }
    return table;
}

/// compute_gammas — the base-case-multiply twiddles, gammas[i] = ζ^(2·BitRev7(i)+1) mod q for i in 0..128 (FIPS 203 Algorithm 12). The NTT
/// leaves each ring element as 128 degree-1 polynomials modulo (X² − γᵢ); these are those γᵢ. Built at comptime from the field.
fn compute_gammas() [128]u32 {
    // Same comptime budget as compute_zetas — 128 exponentiations by square-and-multiply.
    @setEvalBranchQuota(100000);
    var table: [128]u32 = undefined;
    var i: u32 = 0;
    // invariant (bound): one gamma per degree-1 factor, 128 of them.
    while (i < 128) : (i += 1) {
        table[i] = pow_mod(zeta_root, 2 * bitrev7(i) + 1);
    }
    return table;
}

/// The two twiddle tables, computed once at compile time.
const zetas: [128]u32 = compute_zetas();
const gammas: [128]u32 = compute_gammas();

/// ntt — the forward Number Theoretic Transform (FIPS 203 Algorithm 9). Seven layers of Cooley–Tukey butterflies (len = 128, 64, …, 2) carry a
/// standard-domain polynomial into the NTT domain, where ring multiplication becomes 128 independent degree-1 products. Pure, data-independent
/// control flow: the butterfly schedule depends only on the public degree, never on a coefficient's value.
pub fn ntt(f: *const Poly) Poly {
    var a = f.*;
    // invariant (precondition): every input coefficient is already a canonical residue.
    assert(a.cs[0] < q and a.cs[n - 1] < q);
    var i: u32 = 1;
    var len: u32 = 128;
    // invariant (bound): the transform runs exactly seven layers (len halves from 128 down to 2), i walking the 127 twiddles once each.
    while (len >= 2) : (len >>= 1) {
        var start: u32 = 0;
        while (start < n) : (start += 2 * len) {
            const z = zetas[i];
            i += 1;
            var j: u32 = start;
            while (j < start + len) : (j += 1) {
                const t = mul_mod(z, a.cs[j + len]);
                a.cs[j + len] = sub_mod(a.cs[j], t);
                a.cs[j] = add_mod(a.cs[j], t);
            }
        }
    }
    // invariant (postcondition): every twiddle was consumed exactly once (indices 1..127, then i rests at 128).
    assert(i == 128);
    return a;
}

/// inv_ntt — the inverse NTT (FIPS 203 Algorithm 10). The same seven layers run outward (len = 2, 4, …, 128) with the twiddles walked in
/// reverse, then every coefficient is scaled by 128⁻¹ = 3303 to undo the factor the butterflies accumulate. inv_ntt(ntt(f)) = f.
pub fn inv_ntt(f: *const Poly) Poly {
    var a = f.*;
    // invariant (precondition): every input coefficient is a canonical residue.
    assert(a.cs[0] < q and a.cs[n - 1] < q);
    var i: u32 = 127;
    var len: u32 = 2;
    // invariant (bound): exactly seven layers outward (len doubles from 2 to 128), i walking the twiddles back down from 127.
    while (len <= 128) : (len <<= 1) {
        var start: u32 = 0;
        while (start < n) : (start += 2 * len) {
            const z = zetas[i];
            // i counts down; on the final (len = 128) layer its last decrement reaches 0, so guard the subtraction against underflow at the end.
            if (i > 0) i -= 1;
            var j: u32 = start;
            while (j < start + len) : (j += 1) {
                const t = a.cs[j];
                a.cs[j] = add_mod(t, a.cs[j + len]);
                a.cs[j + len] = mul_mod(z, sub_mod(a.cs[j + len], t));
            }
        }
    }
    var k: u32 = 0;
    // invariant (bound): one final scaling per coefficient, exactly n of them.
    while (k < n) : (k += 1) {
        a.cs[k] = mul_mod(a.cs[k], inv128);
    }
    return a;
}

/// multiply_ntts — multiply two ring elements already in the NTT domain (FIPS 203 Algorithm 11 over Algorithm 12's base case). The NTT domain
/// splits R_q into 128 quotients Z_q[X]/(X² − γᵢ), so the product is 128 independent degree-1 multiplies: for the pair at index i,
/// c0 = a0·b0 + a1·b1·γᵢ and c1 = a0·b1 + a1·b0. This is the whole reason the NTT exists — the ring multiply is now linear-time.
pub fn multiply_ntts(f: *const Poly, g: *const Poly) Poly {
    var h: Poly = .{ .cs = [_]u32{0} ** n };
    // invariant (precondition): both operands carry canonical residues.
    assert(f.cs[0] < q and g.cs[0] < q);
    var i: u32 = 0;
    // invariant (bound): exactly 128 degree-1 products, one per NTT-domain factor.
    while (i < 128) : (i += 1) {
        const a0 = f.cs[2 * i];
        const a1 = f.cs[2 * i + 1];
        const b0 = g.cs[2 * i];
        const b1 = g.cs[2 * i + 1];
        const gamma = gammas[i];
        h.cs[2 * i] = add_mod(mul_mod(a0, b0), mul_mod(mul_mod(a1, b1), gamma));
        h.cs[2 * i + 1] = add_mod(mul_mod(a0, b1), mul_mod(a1, b0));
    }
    // invariant (postcondition): the result is a full ring element back in the NTT domain.
    assert(h.cs[n - 1] < q);
    return h;
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

/// A deterministic pseudo-random ring element from a seed — the selftest's non-trivial inputs, each coefficient reduced into [0, q). A tiny LCG
/// keeps it reproducible without any std.crypto, so a failing run always reruns identically.
fn poly_from_seed(seed: u32) Poly {
    var p: Poly = .{ .cs = [_]u32{0} ** n };
    var state: u32 = seed *% 2654435761 +% 1013904223;
    var j: u32 = 0;
    while (j < n) : (j += 1) {
        state = state *% 1664525 +% 1013904223;
        p.cs[j] = (state >> 8) % q;
    }
    return p;
}

/// poly_eq — do two ring elements match coefficient for coefficient?
fn poly_eq(a: *const Poly, b: *const Poly) bool {
    var j: u32 = 0;
    while (j < n) : (j += 1) {
        if (a.cs[j] != b.cs[j]) return false;
    }
    return true;
}

/// poly_is_zero — is every coefficient zero? Used to refuse a trivial witness (a passing check on the zero polynomial proves nothing).
fn poly_is_zero(a: *const Poly) bool {
    var j: u32 = 0;
    while (j < n) : (j += 1) {
        if (a.cs[j] != 0) return false;
    }
    return true;
}

/// negacyclic_schoolbook — the reference ring multiply, straight from the definition of R_q = Z_q[X]/(X²⁵⁶ + 1): the O(n²) convolution where a
/// term whose degree reaches 256 or beyond wraps with a MINUS sign (X²⁵⁶ ≡ −1). This is the ground truth the NTT multiply must reproduce; it is
/// slow and obviously correct, which is exactly what a self-consistency oracle wants.
fn negacyclic_schoolbook(f: *const Poly, g: *const Poly) Poly {
    var h: Poly = .{ .cs = [_]u32{0} ** n };
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        var j: u32 = 0;
        while (j < n) : (j += 1) {
            const p = mul_mod(f.cs[i], g.cs[j]);
            const k = i + j;
            if (k < n) {
                h.cs[k] = add_mod(h.cs[k], p);
            } else {
                h.cs[k - n] = sub_mod(h.cs[k - n], p);
            }
        }
    }
    return h;
}

fn run_selftest() !u8 {
    // 1. The primitive-root anchors FIPS 203 fixes: ζ = 17 has order 256 mod q (ζ²⁵⁶ = 1 and ζ¹²⁸ = −1), and 128·inv128 = 1. These are the
    //    field facts the entire transform rests on; a wrong q or ζ fails here before any butterfly runs.
    if (pow_mod(zeta_root, 256) != 1) return error.RootAnchorMismatch;
    if (pow_mod(zeta_root, 128) != q - 1) return error.RootAnchorMismatch;
    if ((inv128 * 128) % q != 1) return error.RootAnchorMismatch;

    // 2. The bit-reversal the zetas table is laid out under, on its named fixed points.
    if (bitrev7(0) != 0) return error.BitRevMismatch;
    if (bitrev7(1) != 64) return error.BitRevMismatch;
    if (bitrev7(64) != 1) return error.BitRevMismatch;
    if (bitrev7(127) != 127) return error.BitRevMismatch;

    // 3. The NTT round-trip: inv_ntt(ntt(f)) = f across a deterministic spread of non-trivial polynomials. A round-trip that held only on the
    //    zero polynomial would prove nothing, so each input is asserted non-zero.
    {
        var seed: u32 = 1;
        while (seed <= 64) : (seed += 1) {
            const f = poly_from_seed(seed);
            if (poly_is_zero(&f)) return error.TrivialWitness;
            const back = inv_ntt(&ntt(&f));
            if (!poly_eq(&back, &f)) return error.RoundTripMismatch;
        }
    }

    // 4. THE decisive oracle: multiply-in-the-NTT-domain equals schoolbook negacyclic convolution. inv_ntt(ntt(f) ∘ ntt(g)) = f ⊛ g in R_q,
    //    across a deterministic spread. The schoolbook is the definition of the ring; the NTT path is the fast route. Their agreement proves the
    //    forward transform, the pointwise multiply (and its gammas), and the inverse transform all together, with no external dependency.
    {
        var seed: u32 = 1;
        while (seed <= 64) : (seed += 1) {
            const f = poly_from_seed(seed);
            const g = poly_from_seed(seed +% 1000);
            const school = negacyclic_schoolbook(&f, &g);
            if (poly_is_zero(&school)) return error.TrivialWitness;
            const fast = inv_ntt(&multiply_ntts(&ntt(&f), &ntt(&g)));
            if (!poly_eq(&fast, &school)) return error.ConvolutionMismatch;
        }
    }

    print("GREEN crypto-mlkem-ring: the ML-KEM base ring R_q = Z_q[X]/(X^256 + 1), q = 3329, authored in pure Rye as Season G's first " ++
        "post-quantum rung. Modular add/sub/mul mod 3329, the forward NTT and inverse NTT (FIPS 203 Algorithms 9 and 10, seven Cooley-Tukey " ++
        "butterfly layers under the primitive 256th root zeta = 17), and the pointwise multiply in the NTT domain (Algorithm 11 over the " ++
        "Algorithm 12 base case, 128 degree-1 products under the gamma twiddles). The twiddle tables zetas[k] = zeta^BitRev7(k) and " ++
        "gammas[i] = zeta^(2*BitRev7(i)+1) are computed at compile time from the field, never a pasted limb. FIPS specifies standard-domain " ++
        "arithmetic while Zig's std.crypto computes in Montgomery domain, so parity against Zig is taken at the encoded byte boundary at the " ++
        "keygen rung; here correctness is proven by SELF-CONSISTENCY with no external dependency — the primitive-root anchors (zeta^256 = 1, " ++
        "zeta^128 = -1, 128*3303 = 1 mod q), the NTT round-trip inv_ntt(ntt(f)) = f over 64 non-trivial polynomials, and the decisive one, " ++
        "that inv_ntt(ntt(f) o ntt(g)) equals schoolbook negacyclic convolution f (*) g in R_q over 64 pairs. This ring is the arithmetic the " ++
        "ML-KEM encode, sample, keygen, and encaps/decaps rungs compose next. Purely local — no key, no network, no funds, no real device; " ++
        "the arithmetic is data-independent by construction, constant-time timing-safety the Season's named horizon.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
