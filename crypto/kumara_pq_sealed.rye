//! crypto/kumara_pq_sealed.rye — Season G (Cryptography), the POST-QUANTUM sealed-to-identity door: a message sealed TO a named post-quantum identity
//! AND signed BY a named post-quantum identity, so one frame carries both confidentiality and provenance, hardened against the quantum day. It is the
//! post-quantum sibling of crypto/kumara_sealed.rye — where that seals to a Kumara identity's Ed25519 key by converting it to X25519 (one key doing
//! two jobs through the birational map), this seals to the identity's ML-KEM half and signs with the sender's ML-DSA half, the two lattice keys a
//! post-quantum identity carries (crypto/kumara_pq_identity.rye). Where the classical sealed box is anonymous by construction, this door adds what the
//! dual-key shape makes reachable and one lattice key cannot: a message only the named recipient can read, provably from the named sender.
//!
//! It authors NO new cryptography. The confidentiality is crypto/mlkem_sealed.rye's own seal/open (ML-KEM · SHA3-256 · BLAKE2b · ChaCha20-Poly1305);
//! the provenance is crypto/kumara_pq_identity.rye's own sign/verify (ML-DSA); this module contributes only the framing that binds them — a signed
//! envelope around a sealed frame, opened verify-before-trust: the sender's signature is checked, and refused unless it is the sender the reader named,
//! BEFORE the ciphertext is ever decapsulated. A valid signature from the wrong keeper is caught, never mistaken for the right one, exactly as
//! crypto/kumara_carry.rye's binding catches it in the classical world.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, audit-ready). Double-seats BESIDE crypto/kumara_sealed.rye, which
//! stays the correct CLASSICAL sealed-to-identity door; nothing already GREEN moves.
//! Design read: active-designing/20260816-192400_post-quantum-identity-is-dual-key.md — "the coming kumara_pq_sealed seals to the identity's ML-KEM
//! half, and — where provenance is also wanted — signs the frame with the identity's ML-DSA key. Confidentiality and provenance come from the two
//! halves, composed." This rung is that door.
//! Kin: crypto/kumara_pq_identity.rye (the dual-key identity this seals to and signs with, GREEN) · crypto/mlkem_sealed.rye (the confidentiality,
//! GREEN) · crypto/kumara_sealed.rye (the classical sibling) · crypto/kumara_carry.rye (the classical provenance-binding this mirrors). Clean-room:
//! FIPS 203/204 are public NIST standards studied through their specs; the framing is our own Rye wiring over our own GREEN rungs (.claude/rules/gratitude-licenses.md).
//!
//! THE ENVELOPE — magic "GQS1" ‖ sender-ML-DSA-public(pk_len) ‖ sender-ML-DSA-signature(sig_len) ‖ inner mlkem_sealed frame(variable, to the end).
//!   The fixed-width header (magic, sender public key, signature) sits FIRST, so open locates the trailing inner frame without parsing a nested length;
//!   the inner frame runs to the end and crypto/mlkem_sealed.rye validates it whole. The signature covers a BLAKE2b-512 digest of the inner sealed
//!   frame — a fixed 64 bytes, well within ML-DSA's message bound at every plaintext length, bound to the exact ciphertext by the hash's collision
//!   resistance — so a tampered ciphertext breaks the signature (caught at verify) or the AEAD tag (caught at open), and never opens.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device. Every identity in the selftest is a TEST identity from a
//! published-vector mnemonic; the module's own functions call no std.crypto (the halves beneath are each doubly-oracle-proven one rung down). The KEM
//! message m must be fresh randomness in real use — the selftest supplies a deterministic TEST value and names the duty plainly. Constant-time
//! timing-safety stays crypto/CONSTANT_TIME.md's named horizon; sealing to or signing as the maintainer's OWN post-quantum identity stays the custody gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/kumara_pq_sealed.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const pq = @import("kumara_pq_identity.rye");
const mlkem = @import("mlkem_sealed.rye");
const blake2b = @import("blake2b.rye");

pub const kumara_pq_sealed_version = "20260816.193000";

/// The four magic bytes opening every Grain post-quantum sealed-and-signed envelope (v1).
pub const magic: [4]u8 = .{ 'G', 'Q', 'S', '1' };
pub const magic_len: u32 = 4;

/// The 32-byte KEM message width, borrowed from the identity so a caller sizes one value.
pub const seed_bytes: u32 = pq.seed_bytes;

/// header_len — the fixed-width envelope prefix for a parameter set: magic ‖ sender ML-DSA public key ‖ sender ML-DSA signature. Everything after it is
/// the inner sealed frame.
pub fn header_len(comptime p: pq.PqParams) u32 {
    return magic_len + pq.sign_public_len(p) + pq.sig_len(p);
}

/// max_frame_bytes — the whole envelope at the largest plaintext, per set: the fixed header plus the inner frame's own maximum. Named so a caller's
/// scratch cites one ceiling.
pub fn max_frame_bytes(comptime p: pq.PqParams) u32 {
    return header_len(p) + mlkem.max_frame_bytes(p.kem);
}

/// The largest plaintext one sealed carry holds — inherited from the inner sealed frame, so this door adds no looser limit.
pub const max_plain_bytes: u32 = mlkem.max_plain_bytes;

pub const KumaraPqSealedError = error{
    /// seal's output buffer is too small to hold the whole envelope — refused before any byte is written.
    OutTooSmall,
    /// A plaintext longer than max_plain_bytes — refused before any key agreement or signing.
    PayloadTooLong,
    /// open was handed a buffer shorter than the fixed header, so it cannot hold even an empty inner frame.
    FrameTooShort,
    /// The first four bytes are not the GQS1 magic — this is not a post-quantum sealed-and-signed envelope.
    BadMagic,
    /// The envelope names a sender that is not the one the reader expected — a valid signature from the wrong keeper, refused before any decapsulation.
    UnexpectedSigner,
    /// The sender's ML-DSA signature did not verify over the inner sealed frame — the provenance is not genuine. No plaintext is revealed.
    BadSignature,
    /// The inner sealed frame did not open (a wrong recipient, or a tampered ciphertext/tag). No plaintext is revealed.
    OpenFailed,
    /// A composed seal, sign, or verify rung surfaced its own error — honored honestly.
    ComposedFailed,
};

/// What open() returns once provenance and confidentiality both hold: the recovered plaintext (a zero-copy slice into the caller's out buffer) and the
/// verified sender's ML-DSA public key, so a caller reads who sent it beside what they sent.
pub fn OpenedType(comptime p: pq.PqParams) type {
    return struct {
        plain: []const u8,
        sender_public: [pq.sign_public_len(p)]u8,
    };
}

/// seal_signed — seal `plain` TO the recipient's ML-KEM agreement half and SIGN the sealed frame with the sender's ML-DSA half, writing a whole
/// post-quantum sealed-and-signed envelope into `out` and returning its length. Confidentiality from the recipient's half, provenance from the sender's
/// — the two halves the dual-key identity carries, composed in one frame. The KEM message m must be fresh randomness in real use (the caller's duty).
pub fn seal_signed(
    comptime p: pq.PqParams,
    sender: *const pq.IdentityType(p),
    recipient_agree_public: *const [pq.agree_public_len(p)]u8,
    m: *const [seed_bytes]u8,
    plain: []const u8,
    out: []u8,
) KumaraPqSealedError!u32 {
    // invariant (precondition): the plaintext fits the inner frame's bound, so the whole envelope fits and every length below stays a bounded u32.
    if (plain.len > max_plain_bytes) return error.PayloadTooLong;
    const hlen = header_len(p);
    // invariant (precondition): the caller's buffer holds at least the fixed header plus an empty inner frame — the full check follows once the inner
    // length is known.
    if (out.len < hlen + mlkem.frame_overhead(p.kem)) return error.OutTooSmall;

    // Write the inner sealed frame at out[hlen..], leaving room for the fixed header ahead of it.
    const inner_len = mlkem.seal(p.kem, recipient_agree_public, m, plain, out[hlen..]) catch return error.ComposedFailed;
    const inner = out[hlen .. hlen + inner_len];

    // Sign a BLAKE2b-512 digest of the inner ciphertext frame with the sender's ML-DSA half — the provenance binding. Signing the digest (a fixed 64
    // bytes) rather than the frame itself keeps the signed message within ML-DSA's bound at every plaintext length, and binds the signature to the
    // exact ciphertext by the hash's collision resistance.
    const digest = blake2b.hash512(inner) catch return error.ComposedFailed;
    const sig = pq.sign(p, sender, digest[0..]) catch return error.ComposedFailed;

    // --- fixed header: magic ‖ sender public key ‖ signature ------------------------------------------------------------------------------------
    var i: u32 = 0;
    while (i < magic_len) : (i += 1) out[i] = magic[i];
    const pk_len = pq.sign_public_len(p);
    var k: u32 = 0;
    // invariant (bound): copy exactly pk_len sender-public-key bytes.
    while (k < pk_len) : (k += 1) out[magic_len + k] = sender.sign.public_key[k];
    const sig_len = pq.sig_len(p);
    var s: u32 = 0;
    // invariant (bound): copy exactly sig_len signature bytes.
    while (s < sig_len) : (s += 1) out[magic_len + pk_len + s] = sig[s];

    // invariant (postcondition): the whole envelope was written — the fixed header plus the inner frame — and nothing past it was touched.
    assert(hlen + inner_len <= out.len);
    return hlen + inner_len;
}

/// open_signed — recover the plaintext of a post-quantum sealed-and-signed envelope, verify-before-trust: refuse unless the named sender matches the
/// reader's expectation and its ML-DSA signature over the inner frame verifies, THEN decapsulate the inner frame with the recipient's ML-KEM half. A
/// wrong expected sender (UnexpectedSigner), a forged signature (BadSignature), a wrong recipient or tampered ciphertext (OpenFailed) each refuse with
/// no plaintext revealed. Returns the plaintext and the verified sender public key.
pub fn open_signed(
    comptime p: pq.PqParams,
    recipient: *const pq.IdentityType(p),
    expected_sender_public: *const [pq.sign_public_len(p)]u8,
    frame: []const u8,
    out: []u8,
) KumaraPqSealedError!OpenedType(p) {
    const hlen = header_len(p);
    // invariant (precondition): the envelope is at least the fixed header plus an empty inner frame, so every fixed field below has bytes to read.
    if (frame.len < hlen + mlkem.frame_overhead(p.kem)) return error.FrameTooShort;
    if (!bytes_eq(frame[0..magic_len], magic[0..])) return error.BadMagic;

    const pk_len = pq.sign_public_len(p);
    const sig_len = pq.sig_len(p);

    // Read the named sender's public key and refuse a sender the reader did not expect — before any signature check or decapsulation.
    var sender_public: [pq.sign_public_len(p)]u8 = undefined;
    var k: u32 = 0;
    // invariant (bound): read exactly pk_len sender-public-key bytes.
    while (k < pk_len) : (k += 1) sender_public[k] = frame[magic_len + k];
    if (!bytes_eq(sender_public[0..], expected_sender_public[0..])) return error.UnexpectedSigner;

    // Read the signature and the inner sealed frame (which runs to the end).
    var sig: [pq.sig_len(p)]u8 = undefined;
    var s: u32 = 0;
    // invariant (bound): read exactly sig_len signature bytes.
    while (s < sig_len) : (s += 1) sig[s] = frame[magic_len + pk_len + s];
    const inner = frame[hlen..];

    // PROVENANCE FIRST — verify the sender's signature over the BLAKE2b-512 digest of the inner frame; refuse a forgery before touching the
    // recipient's secret key. The digest is recomputed here, so a tampered ciphertext yields a different digest and the signature no longer verifies.
    const digest = blake2b.hash512(inner) catch return error.ComposedFailed;
    const genuine = pq.verify(p, &sender_public, digest[0..], &sig) catch return error.ComposedFailed;
    if (!genuine) return error.BadSignature;

    // CONFIDENTIALITY — decapsulate the inner frame with the recipient's ML-KEM half; a wrong recipient or tampered ciphertext fails OpenFailed.
    const opened = mlkem.open(p.kem, &recipient.agree.dk, &recipient.agree.ek, inner, out) catch return error.OpenFailed;

    // invariant (postcondition): both provenance and confidentiality held — the plaintext is authentic, from the expected sender, and sealed to this
    // recipient.
    assert(genuine);
    return OpenedType(p){ .plain = opened.plain, .sender_public = sender_public };
}

// ---- shared helpers -----------------------------------------------------------------------------------------------------------------

fn bytes_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    // invariant (bound): read exactly a.len bytes, one per turn.
    while (i < a.len) : (i += 1) if (a[i] != b[i]) return false;
    return true;
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

/// Fill a buffer with a deterministic spread of test bytes — TEST plaintexts and TEST KEM messages only, never real randomness.
fn fill_test(buf: []u8, seed: u8) void {
    var i: u32 = 0;
    while (i < buf.len) : (i += 1) buf[i] = @as(u8, @truncate(@as(u32, i) *% (@as(u32, seed) | 1) +% @as(u32, seed) +% 7));
    if (buf.len > 0) buf[0] |= 1;
}

// Two TEST identities from BIP-39's published Trezor vector, separated by passphrase — the sender and the recipient. NOT real identities.
const trezor_mnemonic = "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about";

/// check_param — prove the sealed-and-signed door for one parameter set: a confidential-and-authenticated round-trip across plaintext lengths, the
/// message not the plaintext, and four refusals — a wrong recipient, a wrong expected sender, a tampered inner frame, and a tampered signature.
fn check_param(comptime p: pq.PqParams) !void {
    const sender = try pq.from_mnemonic(p, trezor_mnemonic, "SENDER");
    const recipient = try pq.from_mnemonic(p, trezor_mnemonic, "RECIPIENT");
    const stranger = try pq.from_mnemonic(p, trezor_mnemonic, "STRANGER");

    var m: [seed_bytes]u8 = undefined; // TEST KEM message — fresh randomness in real use
    fill_test(m[0..], 19);

    var frame_buf: [max_frame_bytes(p)]u8 = undefined;
    var out_buf: [max_plain_bytes]u8 = undefined;

    // 1. Round-trip across a spread of plaintext lengths: sealed to the recipient, signed by the sender, opened with both provenance and
    //    confidentiality, the recovered sender public key equal to the sender's own.
    const lengths = [_]u32{ 0, 1, 16, 64, 500 };
    for (lengths) |plen| {
        var plain_buf: [500]u8 = undefined;
        const plain = plain_buf[0..plen];
        fill_test(plain, @truncate(plen +% 5));
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain, frame_buf[0..]);
        const opened = try open_signed(p, &recipient, &sender.sign.public_key, frame_buf[0..flen], out_buf[0..]);
        if (!bytes_eq(opened.plain, plain)) return error.PlainWrong;
        if (!bytes_eq(opened.sender_public[0..], sender.sign.public_key[0..])) return error.SenderWrong;
    }

    // 2. Confidentiality: the sealed message body is NOT the plaintext.
    {
        var plain_buf: [64]u8 = undefined;
        fill_test(plain_buf[0..], 9);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        // The inner frame's ciphertext body sits past the fixed header and the inner header.
        const body_start = header_len(p) + mlkem.header_len(p.kem);
        if (flen < body_start + 64) return error.FrameTooShortForBody;
        if (bytes_eq(frame_buf[body_start .. body_start + 64], plain_buf[0..])) return error.CiphertextIsPlaintext;
    }

    // 3. Wrong recipient — the stranger cannot open a frame sealed to the recipient, even though the provenance is genuine: OpenFailed.
    {
        var plain_buf: [48]u8 = undefined;
        fill_test(plain_buf[0..], 31);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        if (open_signed(p, &stranger, &sender.sign.public_key, frame_buf[0..flen], out_buf[0..])) |_| {
            return error.WrongRecipientOpened;
        } else |e| if (e != error.OpenFailed) return error.WrongRecipientWrongError;
    }

    // 4. Wrong expected sender — a reader expecting the stranger refuses a frame the sender signed, before any decapsulation: UnexpectedSigner.
    {
        var plain_buf: [48]u8 = undefined;
        fill_test(plain_buf[0..], 37);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        if (open_signed(p, &recipient, &stranger.sign.public_key, frame_buf[0..flen], out_buf[0..])) |_| {
            return error.WrongSenderOpened;
        } else |e| if (e != error.UnexpectedSigner) return error.WrongSenderWrongError;
    }

    // 5. Tampered inner ciphertext — the sender's signature no longer covers it: BadSignature, refused before decapsulation.
    {
        var plain_buf: [48]u8 = undefined;
        fill_test(plain_buf[0..], 41);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        // Flip a byte inside the inner frame's ciphertext body.
        const body_start = header_len(p) + mlkem.header_len(p.kem);
        frame_buf[body_start] ^= 0x01;
        if (open_signed(p, &recipient, &sender.sign.public_key, frame_buf[0..flen], out_buf[0..])) |_| {
            return error.TamperInnerOpened;
        } else |e| if (e != error.BadSignature) return error.TamperInnerWrongError;
    }

    // 6. Tampered signature — the provenance is broken: BadSignature.
    {
        var plain_buf: [48]u8 = undefined;
        fill_test(plain_buf[0..], 43);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        frame_buf[magic_len + pq.sign_public_len(p)] ^= 0x01; // the first signature byte (the commitment)
        if (open_signed(p, &recipient, &sender.sign.public_key, frame_buf[0..flen], out_buf[0..])) |_| {
            return error.TamperSigOpened;
        } else |e| if (e != error.BadSignature) return error.TamperSigWrongError;
    }

    // 7. Bad magic and a too-short frame.
    {
        var plain_buf: [32]u8 = undefined;
        fill_test(plain_buf[0..], 51);
        const flen = try seal_signed(p, &sender, &recipient.agree.ek, &m, plain_buf[0..], frame_buf[0..]);
        frame_buf[0] = 'X';
        if (open_signed(p, &recipient, &sender.sign.public_key, frame_buf[0..flen], out_buf[0..])) |_| {
            return error.BadMagicOpened;
        } else |e| if (e != error.BadMagic) return error.BadMagicWrongError;
        frame_buf[0] = 'G'; // restore
        if (open_signed(p, &recipient, &sender.sign.public_key, frame_buf[0 .. header_len(p) + mlkem.frame_overhead(p.kem) - 1], out_buf[0..])) |_| {
            return error.ShortOpened;
        } else |e| if (e != error.FrameTooShort) return error.ShortWrongError;
    }
}

fn run_selftest() !u8 {
    try check_param(pq.pq_small);
    try check_param(pq.pq_default);
    try check_param(pq.pq_large);

    print("GREEN crypto-kumara-pq-sealed: the POST-QUANTUM sealed-to-identity door authored in pure Rye — a message sealed TO a named post-quantum " ++
        "identity AND signed BY a named post-quantum identity, so one frame carries both confidentiality and provenance, hardened against the quantum " ++
        "day. The post-quantum sibling of crypto/kumara_sealed.rye, double-seated beside it: where the classical door seals to an Ed25519 identity " ++
        "through the Ed25519→X25519 map (one key doing two jobs), this seals to the identity's ML-KEM half and signs with the sender's ML-DSA half — " ++
        "the two lattice keys crypto/kumara_pq_identity.rye carries. Where the classical sealed box is anonymous, this door adds what the dual-key " ++
        "shape makes reachable and one lattice key cannot: a message only the named recipient can read, provably from the named sender. Authors NO new " ++
        "cryptography — the confidentiality is crypto/mlkem_sealed.rye's own seal/open, the provenance crypto/kumara_pq_identity.rye's own sign/verify; " ++
        "this module contributes only the signed envelope (magic GQS1 ‖ sender ML-DSA public key ‖ sender ML-DSA signature ‖ inner mlkem_sealed frame) " ++
        "opened verify-before-trust: the sender's signature is checked, and refused unless it is the sender the reader named, BEFORE the ciphertext is " ++
        "ever decapsulated. Proven GREEN on metal at every tier (small ML-DSA-44/ML-KEM-512, default ML-DSA-65/ML-KEM-768, large ML-DSA-87/ML-KEM-1024): " ++
        "a confidential-and-authenticated round-trip across five plaintext lengths (empty → 500 bytes) recovering both the plaintext and the verified " ++
        "sender, the message provably not the plaintext, and four refusals — a wrong recipient fails OpenFailed, a wrong expected sender fails " ++
        "UnexpectedSigner before any decapsulation, a tampered inner ciphertext fails BadSignature, and a tampered signature fails BadSignature — plus " ++
        "bad magic and truncation. The module's own functions call no std.crypto; each composed half is doubly-oracle-proven one rung down. Purely " ++
        "local over TEST identities from published vectors — no real key held, no network, no funds, no real device; the KEM message must be fresh " ++
        "randomness in real use, constant-time timing-safety the named horizon, and sealing to or signing as the maintainer's own post-quantum " ++
        "identity the custody gate. The post-quantum identity now both signs and seals, end to end, through one dual-key name.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
