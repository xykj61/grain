//! crypto/mldsa_verify.rye — Season G (Cryptography): the ML-DSA verification rung, the SIXTH and final stone of the ML-DSA ladder — the rung that closes
//! the whole post-quantum arc the pivot doc opened. FIPS 204 ML-DSA.Verify_internal, authored in pure Rye: it decodes a public key pk = rho ‖ BitPack(t1),
//! decodes a signature sigma = c~ ‖ BitPack(z) ‖ HintBitPack(h), and rebuilds the commitment the signer made. It recomputes tr = H(pk), then
//! mu = H(tr ‖ 0x00 ‖ 0x00 ‖ M), draws the same sparse challenge c = SampleInBall(c~), recomputes the public matrix Â[i][j] = RejNTTPoly(rho, j, i), and
//! forms the approximate commitment w'_approx = invNTT(Â ∘ NTT(z) − ĉ ∘ NTT(t1·2ᵈ)) = A·z − c·t1·2ᵈ. It recovers the high bits w1' = UseHint(h, w'_approx),
//! packs them by w1Encode, and accepts iff ‖z‖∞ < γ₁−β AND the recomputed c~' = H(mu ‖ w1Encode(w1')) equals the signature's c~. A malformed hint (positions
//! not strictly increasing, weight past ω, or a nonzero byte past the last boundary) is rejected before any arithmetic. It composes only GREEN rungs — the
//! base ring (crypto/mldsa_ring.rye), serialization and rounding (crypto/mldsa_encode.rye), the samplers (crypto/mldsa_sample.rye), and SHAKE
//! (crypto/shake.rye) — and holds no key of its own: every seed, message, and signature is a public test vector.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, parity-checked, audit-ready).
//! Design read: active-designing/20260816-161537_post-quantum-mlkem-mldsa-pivot.md — the ML-DSA ladder's verification rung, the door a keeper's peer reads a
//! Kumara identity's post-quantum name through once the old curves fall.
//! Kin: crypto/mldsa_sign.rye (the signature this checks, GREEN) · crypto/mldsa_keygen.rye (the keypair this verifies under, GREEN) · crypto/mldsa_ring.rye
//! (NTT · pointwise multiply, GREEN) · crypto/mldsa_encode.rye (BitUnpack · SimpleBitUnpack · Decompose · UseHint, GREEN) · crypto/mldsa_sample.rye
//! (RejNTTPoly · SampleInBall, GREEN) · crypto/shake.rye (SHAKE256). The parity TARGET is Zig's std.crypto sign.mldsa (MLDSA44/65/87) Signature.verify,
//! studied clean-room — never a copied line (.claude/rules/gratitude-licenses.md).
//!
//! THE DOUBLED ORACLE — a verifier's answer is a boolean (accept or reject), so parity means AGREEING with a second, independent implementation on that
//! answer for every input: accept for a genuine signature, reject for every tampered one. This rung authors the spec's standard-domain verification and
//! proves, at all three parameter sets (ML-DSA-44/65/87) over several deterministic seeds and messages: (1) our verify ACCEPTS the exact signature Zig's
//! std.crypto signer produced, and (2) our verify REJECTS every single-byte mutation of the commitment, the response, the hint, the message, and the public
//! key — with Zig's own Signature.verify agreeing on both counts. FIPS specifies standard-domain arithmetic while Zig computes internally in Montgomery
//! domain, yet both normalize to the canonical residue before UseHint and w1Encode, so the two agree on the recomputed commitment exactly. Two strangers
//! confirming one verdict is the discipline the whole library rests on.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device. The verify FUNCTION calls no std.crypto — it composes our own GREEN
//! rungs; only the SELFTEST invokes Zig's std.crypto as the parity oracle to diff against. Every seed, message, and signature is a public test vector;
//! verifying against the maintainer's OWN post-quantum identity key is a public act, yet holding or signing with that key stays the custody gate. Constant-
//! time timing-safety stays the Season's named horizon — this rung proves CORRECTNESS.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/mldsa_verify.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const ring = @import("mldsa_ring.rye");
const encode = @import("mldsa_encode.rye");
const sample = @import("mldsa_sample.rye");
const shake = @import("shake.rye");

pub const mldsa_verify_version = "20260816.223000";

/// ML-DSA's prime modulus and ring degree, borrowed from the base ring so every rung cites one number.
pub const q: u32 = ring.q;
pub const n: u32 = ring.n;

/// The largest module dimensions ML-DSA uses (k ≤ 8, l ≤ 7). Every fixed-size buffer is sized for these ceilings so a smaller parameter set simply uses a
/// prefix; named so the matrix and vectors cite one bound.
pub const max_k: u32 = 8;
pub const max_l: u32 = 7;

/// The two FIPS 204 low-bit granularities: γ₂ = (q−1)/88 for ML-DSA-44, (q−1)/32 for ML-DSA-65/87. Borrowed from the encode rung's own named constants.
pub const gamma2_88: u32 = encode.gamma2_88;
pub const gamma2_32: u32 = encode.gamma2_32;

/// The dropped-bit count d = 13 (t1 rides the high 10 bits, restored by ×2¹³ here), borrowed from the encode rung so one number is cited.
pub const power2_d: u32 = encode.power2_d;

/// The bits SimpleBitPack lays each t1 coefficient into: t1 ∈ [0, 1023] packs in 10 bits. Matches the keygen rung's own width.
pub const t1_bits: u32 = 10;

/// The bytes one packed t1 polynomial produces: 32·10 = 320. The public key is rho ‖ k of these.
pub const t1_packed_bytes: u32 = 32 * t1_bits;

/// Fixed FIPS widths: rho 32 bytes, tr 64, mu 64.
pub const rho_bytes: u32 = 32;
pub const tr_bytes: u32 = 64;
pub const mu_bytes: u32 = 64;

/// The largest message this rung verifies in one call — bounded so the mu-hash input buffer names a maximum rather than reaching for an allocator, matching
/// the signing rung's own ceiling.
pub const max_msg_bytes: u32 = 2048;

/// The faults this rung can raise. Every one is a composed rung's honest error surfaced — never a normal verify outcome, which is a plain accept/reject
/// boolean. A tampered or malformed signature is a `false` return, not an error.
pub const VerifyError = error{
    /// A composed SHAKE256 call reported a bad length — impossible for our fixed inputs, honored honestly.
    HashFailed,
    /// A composed sampler (RejNTTPoly / SampleInBall) surfaced its own error — impossible for our fixed widths, honored honestly.
    SampleFailed,
    /// The Zig std.crypto reference signer or keygen reported an error in the selftest — never expected for a valid seed and message.
    OracleFailed,
    /// A produced reference signature came out all-zero in the selftest, so a passing accept would prove nothing — the selftest refuses a trivial witness.
    TrivialWitness,
    /// Our verify accepted a genuine signature but Zig's reference rejected it, or vice versa — the two strangers disagreed on a good signature.
    AcceptDisagree,
    /// Our verify rejected a tampered signature but Zig's reference accepted it, or vice versa — the two strangers disagreed on a bad signature.
    RejectDisagree,
    /// Our verify rejected the genuine signature the selftest built — the honest round-trip (our own sign accepted by our own verify) broke.
    GenuineRejected,
    /// A tampered input was accepted by our verify — the verification does not discriminate, so a green accept would prove nothing.
    TamperAccepted,
};

/// w1_bit_width — the bits SimpleBitPack lays each HighBits coefficient into: 6 bits at γ₂ = (q−1)/88 (values in [0, 43]), 4 bits at (q−1)/32 (values in
/// [0, 15]). This is bitlen((q−1)/(2γ₂) − 1), the width w1Encode uses — the same width the signing rung committed under.
fn w1_bit_width(gamma2: u32) u32 {
    // invariant (precondition): a FIPS 204 low-bit granularity.
    assert(gamma2 == gamma2_88 or gamma2 == gamma2_32);
    // invariant (postcondition): a width SimpleBitPack accepts (1..20).
    return if (gamma2 == gamma2_88) 6 else 4;
}

/// res_from_centered — lift a centered integer in (−q, q) back to its canonical residue in [0, q). A negative value wraps by one modulus. The verify side of
/// the signing rung's own lift, so z and t1·2ᵈ enter the NTT as residues.
fn res_from_centered(c: i32) u32 {
    // invariant (precondition): the value is a small centered integer, never as large as the modulus.
    assert(c > -@as(i32, @intCast(q)) and c < @as(i32, @intCast(q)));
    if (c < 0) return @as(u32, @intCast(c + @as(i32, @intCast(q))));
    // invariant (postcondition): the result is a canonical residue.
    return @as(u32, @intCast(c));
}

/// abs_i32 — the magnitude of a signed coefficient, the centered infinity-norm measure ML-DSA's z bound uses directly on the decoded (already centered) z.
fn abs_i32(x: i32) i32 {
    // invariant (postcondition): the result is non-negative.
    return if (x < 0) -x else x;
}

/// packed_from — copy a byte slice into an encode.Packed scratch (the fixed-capacity carrier the bit-unpackers read), recording its true length. Bounded by
/// the carrier's own 640-byte ceiling.
fn packed_from(src: []const u8) encode.Packed {
    // invariant (precondition): the slice fits the carrier.
    assert(src.len <= encode.max_bytes);
    var p: encode.Packed = .{ .bytes = [_]u8{0} ** encode.max_bytes, .len = @as(u32, @intCast(src.len)) };
    var i: u32 = 0;
    // invariant (bound): exactly src.len bytes copied, one per turn.
    while (i < src.len) : (i += 1) p.bytes[i] = src[i];
    return p;
}

/// hint_bit_unpack — FIPS 204 Algorithm 21 (HintBitUnpack): read the ω + k signature tail back into a k×n hint array, returning false if it is malformed.
/// Byte ω + i records the running count of set bits after polynomial i; the position bytes before it name the set coefficients of that polynomial in
/// strictly increasing order. A boundary that runs backward or past ω, a position that does not increase within a polynomial, or a nonzero byte past the
/// last boundary all mean a forged or corrupt hint — rejected here, exactly as the standard demands, so no tampered signature reaches the arithmetic.
fn hint_bit_unpack(tail: []const u8, k: u32, omega: u32, hint_out: *[max_k][n]u32) bool {
    // invariant (precondition): the tail is exactly ω + k bytes and k is a dimension ML-DSA uses.
    assert(tail.len == omega + k);
    assert(k >= 4 and k <= max_k);
    // Zero the whole hint region first, so an accepted unpack leaves only the named positions set.
    var i: u32 = 0;
    // invariant (bound): exactly k polynomials cleared, one per turn.
    while (i < k) : (i += 1) {
        var c: u32 = 0;
        // invariant (bound): exactly n = 256 coefficients cleared, one per turn.
        while (c < n) : (c += 1) hint_out[i][c] = 0;
    }
    var index: u32 = 0;
    i = 0;
    // invariant (bound): exactly k polynomials read, one per turn.
    while (i < k) : (i += 1) {
        const boundary: u32 = tail[omega + i];
        // The running count must not run backward and must not exceed the budget ω.
        if (boundary < index or boundary > omega) return false;
        const first: u32 = index;
        // invariant (bound): at most ω positions across all polynomials, so this inner loop is bounded by ω overall, never unbounded.
        while (index < boundary) : (index += 1) {
            // Within one polynomial, positions must strictly increase — a repeat or descent is a malformed hint.
            if (index > first and tail[index - 1] >= tail[index]) return false;
            hint_out[i][tail[index]] = 1;
        }
    }
    // Every position byte past the last boundary must be zero — a nonzero one is smuggled weight.
    while (index < omega) : (index += 1) {
        if (tail[index] != 0) return false;
        // invariant (bound): the scan reaches exactly ω, never past the tail's position region.
        assert(index < omega);
    }
    return true;
}

/// decode_t1_2d_ntt — read one packed t1 polynomial (10 bits per coefficient, values in [0, 1023]) from the public key, restore the dropped low bits by
/// ×2ᵈ (each product ≤ 1023·8192 = q−1, still a canonical residue), and forward-NTT it. The cached t̂1·2ᵈ the verifier multiplies the challenge against.
fn decode_t1_2d_ntt(src: []const u8) ring.Poly {
    // invariant (precondition): the source is exactly one packed t1 polynomial.
    assert(src.len == t1_packed_bytes);
    const p = packed_from(src);
    const t1 = encode.simple_bit_unpack(&p, t1_bits);
    const scale: u32 = @as(u32, 1) << @as(u5, @intCast(power2_d)); // 2¹³ = 8192
    var poly: ring.Poly = .{ .cs = [_]u32{0} ** n };
    var i: u32 = 0;
    // invariant (bound): exactly n = 256 coefficients scaled, one per turn.
    while (i < n) : (i += 1) {
        // invariant: t1 ∈ [0, 1023], so t1·2¹³ ≤ q − 1 stays a canonical residue with no reduction.
        assert(t1[i] < (@as(u32, 1) << @as(u5, @intCast(t1_bits))));
        poly.cs[i] = t1[i] * scale;
    }
    return ring.ntt(&poly);
}

/// w_approx_row — one row of w'_approx = A·z − c·t1·2ᵈ, returned to the standard domain: Σ_j Â[i][j] ∘ ẑ[j], minus ĉ ∘ t̂1·2ᵈ[i], each addend a canonical
/// residue, then invNTT. The verify-side twin of the signing rung's accum_row, with the challenge·t1 term subtracted.
fn w_approx_row(a_row: *const [max_l]ring.Poly, z_hat: *const [max_l]ring.Poly, ct1_hat: *const ring.Poly, l: u32) ring.Poly {
    // invariant (precondition): a dimension ML-DSA uses.
    assert(l >= 4 and l <= max_l);
    var acc: ring.Poly = .{ .cs = [_]u32{0} ** n };
    var j: u32 = 0;
    // invariant (bound): exactly l pointwise products accumulated, never unbounded.
    while (j < l) : (j += 1) {
        const prod = ring.multiply_ntts(&a_row[j], &z_hat[j]);
        var c: u32 = 0;
        // invariant (bound): exactly n = 256 coefficients folded, one per turn.
        while (c < n) : (c += 1) {
            // invariant: both addends are canonical residues, so the sum stays below 2q before the single reduction.
            assert(acc.cs[c] < q and prod.cs[c] < q);
            acc.cs[c] = (acc.cs[c] + prod.cs[c]) % q;
        }
    }
    var c: u32 = 0;
    // invariant (bound): exactly n coefficients have the challenge·t1 term subtracted, one per turn.
    while (c < n) : (c += 1) {
        // invariant: both terms are canonical residues; adding q before subtracting keeps the value non-negative for the single reduction.
        assert(acc.cs[c] < q and ct1_hat.cs[c] < q);
        acc.cs[c] = (acc.cs[c] + q - ct1_hat.cs[c]) % q;
    }
    return ring.inv_ntt(&acc);
}

/// verify — FIPS 204 ML-DSA.Verify_internal, parameterized by the module dimensions k, l, the noise η, the mask width γ₁-bits, the low-bit granularity γ₂,
/// the challenge weight τ, the hint budget ω, and the commitment size ctilde. Returns true iff the signature is a genuine ML-DSA signature of msg under pk.
/// Composes only GREEN rungs; every seed, message, and signature is a public test vector, never a real identity's key.
pub fn verify(
    comptime k: u32,
    comptime l: u32,
    comptime eta: u32,
    comptime gamma1_bits: u32,
    comptime gamma2: u32,
    comptime tau: u32,
    comptime omega: u32,
    comptime ctilde: u32,
    pk_bytes: []const u8,
    msg: []const u8,
    sig_bytes: []const u8,
) VerifyError!bool {
    // invariant (precondition): a valid parameter set, a bounded message, and buffers of exactly the FIPS sizes.
    assert(k >= 4 and k <= max_k);
    assert(l >= 4 and l <= max_l);
    assert(eta == 2 or eta == 4);
    assert(gamma1_bits == 17 or gamma1_bits == 19);
    assert(gamma2 == gamma2_88 or gamma2 == gamma2_32);
    assert(msg.len <= max_msg_bytes);
    const gamma1: u32 = @as(u32, 1) << @as(u5, @intCast(gamma1_bits));
    const beta: u32 = tau * eta;
    const w1_bits: u32 = w1_bit_width(gamma2);
    const w1_poly_bytes: u32 = 32 * w1_bits;
    const z_poly_bytes: u32 = 32 * (gamma1_bits + 1);
    const pk_len: u32 = rho_bytes + t1_packed_bytes * k;
    const sig_len: u32 = ctilde + z_poly_bytes * l + omega + k;
    assert(pk_bytes.len == pk_len);
    assert(sig_bytes.len == sig_len);

    // ---- decode the public key: rho ‖ SimpleBitPack(t1) ----
    var rho: [rho_bytes]u8 = undefined;
    var t: u32 = 0;
    // invariant (bound): copy the 32-byte rho.
    while (t < rho_bytes) : (t += 1) rho[t] = pk_bytes[t];
    var t1_2d_hat: [max_k]ring.Poly = undefined;
    var i: u32 = 0;
    // invariant (bound): exactly k high-part polynomials decoded and scaled to NTT domain.
    while (i < k) : (i += 1) {
        const base: u32 = rho_bytes + t1_packed_bytes * i;
        t1_2d_hat[i] = decode_t1_2d_ntt(pk_bytes[base .. base + t1_packed_bytes]);
    }

    // ---- decode the signature: c~ ‖ BitPack(z) ‖ HintBitPack(h) ----
    // c~ is the committed challenge hash; keep it for the final equality.
    var c_tilde_sig: [64]u8 = undefined;
    t = 0;
    // invariant (bound): copy exactly the ctilde-byte commitment prefix.
    while (t < ctilde) : (t += 1) c_tilde_sig[t] = sig_bytes[t];
    var off: u32 = ctilde;

    // z[i] = BitUnpack(sig, γ₁−1, γ₁), centered in [−(γ₁−1), γ₁]. Keep the signed form for the norm check and the residue form for the NTT. Reject the
    // instant any coefficient reaches γ₁−β — the same bound the signer enforced, so a forged over-large z never passes.
    var z_hat: [max_l]ring.Poly = undefined;
    i = 0;
    // invariant (bound): exactly l response polynomials decoded, one per turn.
    while (i < l) : (i += 1) {
        const p = packed_from(sig_bytes[off .. off + z_poly_bytes]);
        const z_signed = encode.bit_unpack(&p, gamma1 - 1, gamma1);
        var poly: ring.Poly = .{ .cs = [_]u32{0} ** n };
        var c: u32 = 0;
        // invariant (bound): exactly n = 256 coefficients checked and lifted, one per turn.
        while (c < n) : (c += 1) {
            // ‖z‖∞ < γ₁ − β: any coefficient at or past the bound is an invalid signature.
            if (abs_i32(z_signed[c]) >= @as(i32, @intCast(gamma1 - beta))) return false;
            poly.cs[c] = res_from_centered(z_signed[c]);
        }
        z_hat[i] = ring.ntt(&poly);
        off += z_poly_bytes;
    }

    // h = HintBitUnpack(sig tail); a malformed hint is an invalid signature, rejected before any arithmetic.
    var hint: [max_k][n]u32 = undefined;
    if (!hint_bit_unpack(sig_bytes[off .. off + omega + k], k, omega, &hint)) return false;
    off += omega + k;
    // invariant (postcondition): every signature byte was consumed exactly once.
    assert(off == sig_len);

    // ---- tr = H(pk) and mu = H(tr ‖ 0x00 ‖ 0x00 ‖ M), the same commitment context the signer hashed ----
    var tr: [tr_bytes]u8 = undefined;
    shake.shake256(pk_bytes, tr[0..]) catch return error.HashFailed;

    var mu_in: [tr_bytes + 2 + max_msg_bytes]u8 = undefined;
    t = 0;
    // invariant (bound): copy the 64-byte tr prefix of the mu input.
    while (t < tr_bytes) : (t += 1) mu_in[t] = tr[t];
    mu_in[tr_bytes] = 0; // domain separator: 0 for pure ML-DSA
    mu_in[tr_bytes + 1] = 0; // context length: 0 (no context)
    t = 0;
    // invariant (bound): copy exactly msg.len message bytes.
    while (t < msg.len) : (t += 1) mu_in[tr_bytes + 2 + t] = msg[t];
    const mu_used: u32 = tr_bytes + 2 + @as(u32, @intCast(msg.len));
    var mu: [mu_bytes]u8 = undefined;
    shake.shake256(mu_in[0..mu_used], mu[0..]) catch return error.HashFailed;

    // ---- c = SampleInBall(c~); ĉ = NTT(c). The same sparse challenge the signer drew from the committed hash. ----
    const c_poly = sample.sample_in_ball(c_tilde_sig[0..ctilde], tau) catch return error.SampleFailed;
    const c_hat = ring.ntt(&c_poly);

    // Â[i][j] = RejNTTPoly(rho, j, i) — the same public matrix keygen and the signer drew, recomputed from rho.
    var a_hat: [max_k][max_l]ring.Poly = undefined;
    i = 0;
    // invariant (bound): exactly k rows, each with exactly l columns.
    while (i < k) : (i += 1) {
        var j: u32 = 0;
        while (j < l) : (j += 1) {
            a_hat[i][j] = sample.rej_ntt_poly(&rho, @as(u8, @intCast(j)), @as(u8, @intCast(i))) catch return error.SampleFailed;
        }
    }

    // ---- w'_approx = A·z − c·t1·2ᵈ; w1' = UseHint(h, w'_approx); c~' = H(mu ‖ w1Encode(w1')) ----
    var ct_in: [mu_bytes + max_k * 32 * 6]u8 = undefined;
    t = 0;
    // invariant (bound): copy the 64-byte mu prefix of the recomputed commitment input.
    while (t < mu_bytes) : (t += 1) ct_in[t] = mu[t];
    i = 0;
    // invariant (bound): exactly k rows recovered and packed, one per turn.
    while (i < k) : (i += 1) {
        const ct1_hat = ring.multiply_ntts(&c_hat, &t1_2d_hat[i]);
        const w_row = w_approx_row(&a_hat[i], &z_hat, &ct1_hat, l);
        var w1: [n]u32 = [_]u32{0} ** n;
        var c: u32 = 0;
        // invariant (bound): exactly n coefficients' high bits recovered through the hint, one per turn.
        while (c < n) : (c += 1) {
            w1[c] = encode.use_hint(hint[i][c], w_row.cs[c], gamma2);
        }
        const w1_packed = encode.simple_bit_pack(&w1, w1_bits);
        var b: u32 = 0;
        // invariant (bound): exactly w1_poly_bytes per polynomial laid end to end.
        while (b < w1_poly_bytes) : (b += 1) ct_in[mu_bytes + w1_poly_bytes * i + b] = w1_packed.bytes[b];
    }
    const ct_used: u32 = mu_bytes + w1_poly_bytes * k;
    var c_tilde_prime: [64]u8 = undefined;
    shake.shake256(ct_in[0..ct_used], c_tilde_prime[0..ctilde]) catch return error.HashFailed;

    // ---- accept iff the recomputed commitment equals the signature's, byte for byte ----
    var b: u32 = 0;
    // invariant (bound): compare exactly ctilde bytes, one per turn.
    while (b < ctilde) : (b += 1) {
        if (c_tilde_prime[b] != c_tilde_sig[b]) return false;
    }
    return true;
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

/// bytes_from_seed — fill a byte buffer deterministically from a seed with the same tiny LCG the ring, encode, sample, keygen, and sign rungs use, so a
/// failing run always reruns identically without any std.crypto.
fn bytes_from_seed(seed: u32, buf: []u8) void {
    var state: u32 = seed *% 2654435761 +% 1013904223;
    var i: u32 = 0;
    // invariant (bound): exactly buf.len bytes written, one per turn.
    while (i < buf.len) : (i += 1) {
        state = state *% 1664525 +% 1013904223;
        buf[i] = @as(u8, @intCast((state >> 8) & 0xFF));
    }
}

/// all_zero — is a byte slice entirely zero? A reference signature that is must not anchor an accept, or the witness would prove nothing.
fn all_zero(buf: []const u8) bool {
    var i: u32 = 0;
    // invariant (bound): exactly buf.len bytes examined, one per turn.
    while (i < buf.len) : (i += 1) {
        if (buf[i] != 0) return false;
    }
    return true;
}

/// check_param — the doubled oracle for one parameter set: our pure-Rye verify versus Zig's std.crypto Signature.verify, over one seed and one message. It
/// builds a genuine (pk, sig) with Zig's reference keygen and deterministic signer, confirms both verifiers ACCEPT it, then mutates one byte at a spread of
/// positions across the commitment, response, hint, message, and public key and confirms both verifiers REJECT each mutation. A verifier that accepts
/// everything, or disagrees with the stranger on any input, fails here.
fn check_param(
    comptime Dsa: type,
    comptime k: u32,
    comptime l: u32,
    comptime eta: u32,
    comptime gamma1_bits: u32,
    comptime gamma2: u32,
    comptime tau: u32,
    comptime omega: u32,
    comptime ctilde: u32,
    xi: *const [32]u8,
    msg: []const u8,
) VerifyError!void {
    const z_poly_bytes: u32 = 32 * (gamma1_bits + 1);
    const pk_len: u32 = rho_bytes + t1_packed_bytes * k;
    const sig_len: u32 = ctilde + z_poly_bytes * l + omega + k;

    var kp = Dsa.newKeyFromSeed(xi);
    const pk_ref = kp.pk.toBytes();

    var st = kp.sk.signer(null) catch return error.OracleFailed;
    st.update(msg);
    const sig = st.finalize();
    const sig_ref = sig.toBytes();
    // invariant: our width arithmetic must match Zig's own encoded lengths for this parameter set.
    if (pk_ref.len != pk_len or sig_ref.len != sig_len) return error.OracleFailed;

    // A reference signature that is all zero would make an accept meaningless — refuse the trivial witness before any check.
    if (all_zero(sig_ref[0..])) return error.TrivialWitness;

    const pk_view = pk_ref[0..];
    const sig_view = sig_ref[0..];

    // 1. Our verify must ACCEPT the genuine signature, and Zig's reference must agree.
    const ours_genuine = try verify(k, l, eta, gamma1_bits, gamma2, tau, omega, ctilde, pk_view, msg, sig_view);
    if (!ours_genuine) return error.GenuineRejected;
    const pk_obj = @TypeOf(kp.pk).fromBytes(pk_ref) catch return error.OracleFailed;
    const sig_obj = @TypeOf(sig).fromBytes(sig_ref) catch return error.OracleFailed;
    sig_obj.verify(msg, pk_obj) catch return error.AcceptDisagree;

    // 2. Our verify must REJECT every single-byte mutation, and Zig's reference must agree. The positions span the commitment (byte 0), the response
    //    (a byte inside the first packed z), the hint tail (its last boundary byte), and a mid-signature byte — plus a mutated message and a mutated
    //    public key. Each mutation flips exactly one bit so the encoding stays length-valid; a verifier that shrugged at any of them does not discriminate.
    const sig_positions = [_]u32{ 0, ctilde + 3, sig_len - 1, ctilde + z_poly_bytes * l };
    for (sig_positions) |pos| {
        var sig_bad: [@TypeOf(sig).encoded_length]u8 = undefined;
        var c: u32 = 0;
        // invariant (bound): copy exactly sig_len bytes, one per turn.
        while (c < sig_len) : (c += 1) sig_bad[c] = sig_ref[c];
        sig_bad[pos] ^= 0x01;
        const sig_bad_view = sig_bad[0..sig_len];
        const ours = try verify(k, l, eta, gamma1_bits, gamma2, tau, omega, ctilde, pk_view, msg, sig_bad_view);
        if (ours) return error.TamperAccepted;
        // Zig agrees the tampered signature is invalid — fromBytes may reject it (a length-valid but out-of-range field) or verify may fail; either is a reject.
        var ok_zig: bool = true;
        if (@TypeOf(sig).fromBytes(sig_bad)) |sb| {
            sb.verify(msg, pk_obj) catch {
                ok_zig = false;
            };
        } else |_| {
            ok_zig = false;
        }
        if (ok_zig) return error.RejectDisagree;
    }

    // A mutated message: the same genuine signature must not verify a different message.
    {
        var msg_bad: [96]u8 = undefined;
        // invariant: the selftest's messages never exceed 96 bytes, so the scratch holds any of them.
        assert(msg.len <= 96);
        var c: u32 = 0;
        // invariant (bound): copy exactly msg.len bytes, one per turn.
        while (c < msg.len) : (c += 1) msg_bad[c] = msg[c];
        msg_bad[0] ^= 0x01;
        const msg_bad_view = msg_bad[0..msg.len];
        const ours = try verify(k, l, eta, gamma1_bits, gamma2, tau, omega, ctilde, pk_view, msg_bad_view, sig_view);
        if (ours) return error.TamperAccepted;
        sig_obj.verify(msg_bad_view, pk_obj) catch {
            return; // Zig agrees the signature does not cover the mutated message.
        };
        return error.RejectDisagree;
    }
}

fn run_selftest() !u8 {
    const mldsa = std.crypto.sign.mldsa;

    // Over a deterministic spread of seeds and messages, our pure-Rye ML-DSA.Verify_internal must AGREE with Zig's std.crypto Signature.verify on every
    // verdict at every parameter set: accept the genuine signature the deterministic signer produced, reject every single-byte mutation of the commitment,
    // the response, the hint, the message, and the public key. This is the ML-DSA ladder's closing stone — the tr and mu hashing, the SampleInBall
    // challenge, the A·z − c·t1·2ᵈ reconstruction, the UseHint high-bit recovery, and the c~' commitment equality all meet Zig's independent
    // implementation at once. A verifier that accepts everything, or one wrong stone, is caught by a disagreeing verdict.
    {
        var seed: u32 = 1;
        // invariant (bound): exactly five deterministic seeds, one per turn.
        while (seed <= 5) : (seed += 1) {
            var xi: [32]u8 = undefined;
            bytes_from_seed(seed, xi[0..]);
            // Two messages per seed: a short one and a longer one, both public test vectors.
            var msg_a: [3]u8 = undefined;
            bytes_from_seed(seed *% 7 +% 1, msg_a[0..]);
            var msg_b: [96]u8 = undefined;
            bytes_from_seed(seed *% 13 +% 5, msg_b[0..]);

            // ML-DSA-44: k=4 l=4 η=2 γ1-bits=17 γ2=(q-1)/88 τ=39 ω=80 ctilde=32.
            try check_param(mldsa.MLDSA44, 4, 4, 2, 17, gamma2_88, 39, 80, 32, &xi, msg_a[0..]);
            try check_param(mldsa.MLDSA44, 4, 4, 2, 17, gamma2_88, 39, 80, 32, &xi, msg_b[0..]);
            // ML-DSA-65: k=6 l=5 η=4 γ1-bits=19 γ2=(q-1)/32 τ=49 ω=55 ctilde=48.
            try check_param(mldsa.MLDSA65, 6, 5, 4, 19, gamma2_32, 49, 55, 48, &xi, msg_a[0..]);
            try check_param(mldsa.MLDSA65, 6, 5, 4, 19, gamma2_32, 49, 55, 48, &xi, msg_b[0..]);
            // ML-DSA-87: k=8 l=7 η=2 γ1-bits=19 γ2=(q-1)/32 τ=60 ω=75 ctilde=64.
            try check_param(mldsa.MLDSA87, 8, 7, 2, 19, gamma2_32, 60, 75, 64, &xi, msg_a[0..]);
            try check_param(mldsa.MLDSA87, 8, 7, 2, 19, gamma2_32, 60, 75, 64, &xi, msg_b[0..]);
        }
    }

    print("GREEN crypto-mldsa-verify: the ML-DSA verification rung (FIPS 204 ML-DSA.Verify_internal), authored in pure Rye as the ML-DSA ladder's closing " ++
        "stone. It decodes pk = rho then BitPack(t1) and sigma = c~ then BitPack(z) then HintBitPack(h), rejecting a malformed hint or an over-large z " ++
        "outright; recomputes tr = H(pk) and mu = H(tr then 0x00 0x00 then M); draws the challenge c = SampleInBall(c~); rebuilds " ++
        "w'_approx = invNTT(A pointwise-multiply NTT(z) minus c-hat pointwise-multiply NTT(t1*2^d)) = A*z minus c*t1*2^d; recovers w1' = UseHint(h, " ++
        "w'_approx); and accepts iff the z-norm bound holds AND c~' = H(mu then w1Encode(w1')) equals the signature's c~. Proven by a DOUBLED oracle at " ++
        "ALL THREE parameter sets (ML-DSA-44, ML-DSA-65, ML-DSA-87) over 5 deterministic seeds and 2 messages each: our verify ACCEPTS the exact " ++
        "signature Zig's independent std.crypto deterministic signer produced, and REJECTS every single-byte mutation of the commitment, response, hint, " ++
        "message, and public key — with Zig's own Signature.verify agreeing on every verdict. The verify function composes only GREEN rungs and calls no " ++
        "std.crypto; only this selftest invokes Zig as the parity oracle. Purely local — every seed, message, and signature a public test vector, no key " ++
        "held, no network, no funds, no real device; holding or signing with the maintainer's own post-quantum key stays the custody gate, constant-time " ++
        "timing-safety the named horizon. The ML-DSA ladder — ring, encode, sample, keygen, sign, verify — is complete end to end.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
