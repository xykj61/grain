//! crypto/signed_carry.rye — Season G (Cryptography), the fifteenth rung: the FIRST composition over the GREEN Monocypher-parity primitives.
//! Where the fourteen rungs before this authored the primitives (BLAKE2b, SHA-512, ChaCha/Poly, the whole Ed25519 family, X25519, the base
//! field), this rung composes two of them — BLAKE2b-512 and Ed25519 sign/verify — into the one shape every module that records provenance
//! reaches for: a self-describing, content-addressed, signed frame that answers "who made this record, and has a byte moved since." It is the
//! decision wave's named Lotus unblock and Season 2's content-addressed chain of custody, built as a library: the agent authors and verifies
//! it over a TEST keypair, and signing a real record with the maintainer's own identity key stays the custody gate.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md — "once a Rye signing primitive is
//! parity-GREEN, Lotus's 'who made this record' signed carry becomes buildable — the library is engineering." The 1,024-round itinerary,
//! Season 2 Journey 6 (Provenance): "a real document carries a Kumara-signed, content-addressed chain of custody end to end."
//! Kin: crypto/ed25519_sign.rye · crypto/ed25519_verify.rye (the signature, GREEN) · crypto/blake2b.rye (the content-address digest, GREEN).
//! This file authors NO cryptography of its own — it is pure composition over primitives already proven byte-for-byte parity-GREEN.
//!
//! THE FRAME — a signed carry is a flat, self-describing byte string laid out so a reader deframes it with no ambiguity and no allocation:
//!
//!   magic    4 bytes   "GSC1"  (Grain Signed Carry, version 1) — refuses a buffer that is not one of ours before any parse
//!   signer   32 bytes  the Ed25519 public key of whoever sealed this carry
//!   paylen   8 bytes   u64 big-endian — the opaque payload's length (u64 because a length is a wire-persistent quantity, TAME width law)
//!   payload  paylen    the opaque record — this library never reads its meaning, only carries and seals it
//!   digest   64 bytes  BLAKE2b-512 of (magic ‖ signer ‖ paylen ‖ payload) — the CONTENT ADDRESS: a byte moved anywhere upstream moves this
//!   sig      64 bytes  Ed25519 signature over the 64-byte digest — binds the signer's key to that exact content address
//!
//! Signing the digest rather than the raw payload makes the digest do double duty: it is both the content address a keeper cites a record by
//! AND the thing the signature commits to, so "this key vouches for this content address" is one verification, not two.
//!
//! VERIFY BEFORE TRUST — open() recomputes the digest from the frame's own bytes and refuses on any mismatch BEFORE it checks the signature,
//! and refuses on a bad signature BEFORE it returns one payload byte. A caller never sees an unverified byte. The returned payload is a slice
//! INTO the caller's frame buffer (zero-copy, bounded), and the verified signer key rides alongside it.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device, no identity. Every seal in the selftest uses a TEST seed,
//! never a real key; the frames are held in memory, sent nowhere. Constant-time timing-safety stays the Season's named horizon (it lives in the
//! signing primitive this composes, unchanged here), and sealing a record with the maintainer's own identity key stays the custody gate.
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/signed_carry.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const signer_lib = @import("ed25519_sign.rye");
const verify_lib = @import("ed25519_verify.rye");
const blake2b = @import("blake2b.rye");

pub const signed_carry_version = "20260816.010000";

/// The four magic bytes that open every Grain Signed Carry v1 frame. A buffer that does not start with these is refused before any field is
/// read — a cheap, unambiguous "this is not one of ours" gate.
pub const magic: [4]u8 = .{ 'G', 'S', 'C', '1' };

/// Field widths, named once so seal and open agree on the layout by construction rather than by matching two hand-counted offsets.
pub const magic_len: u32 = 4;
pub const signer_len: u32 = 32; // Ed25519 public key
pub const paylen_field_len: u32 = 8; // u64 big-endian
pub const digest_len: u32 = blake2b.digest_len; // 64 — BLAKE2b-512
pub const sig_len: u32 = 64; // Ed25519 R ‖ S

/// Bytes before the payload (magic ‖ signer ‖ paylen) and after it (digest ‖ sig). A frame is header ‖ payload ‖ trailer.
pub const header_len: u32 = magic_len + signer_len + paylen_field_len; // 44
pub const trailer_len: u32 = digest_len + sig_len; // 128
pub const frame_overhead: u32 = header_len + trailer_len; // 172

/// The largest payload a single carry holds. 64 KiB matches the signing family's own message bound and covers every provenance record this
/// stack seals near-term; a streaming carry for larger blobs is a separate, later rung. The preimage (header + payload) stays far inside
/// BLAKE2b's own 1 MiB bound, so the digest step can never refuse.
pub const max_payload_bytes: u32 = 1 << 16;

/// The largest whole frame — overhead plus the largest payload. Every seal buffer a caller provides is checked against this at the edge.
pub const max_frame_bytes: u32 = frame_overhead + max_payload_bytes;

pub const SignedCarryError = error{
    /// seal's output buffer is too small to hold the whole frame — refused before any byte is written.
    OutTooSmall,
    /// A payload longer than max_payload_bytes — refused before hashing or signing.
    PayloadTooLong,
    /// open was handed a buffer shorter than the fixed overhead, so it cannot even hold an empty-payload frame.
    FrameTooShort,
    /// The first four bytes are not the GSC1 magic — this is not a signed carry.
    BadMagic,
    /// The frame's declared paylen does not match its actual length, or paylen exceeds the bound — a malformed or truncated frame.
    LengthMismatch,
    /// The recomputed BLAKE2b digest does not match the embedded one — a payload, signer, or length byte moved since sealing.
    DigestMismatch,
    /// The Ed25519 signature does not verify against the embedded signer over the digest — the seal is forged or the key is wrong.
    BadSignature,
};

/// What open() hands back once every check has passed: the verified signer's public key and a zero-copy slice of the verified payload, which
/// points into the caller's own frame buffer.
pub const Opened = struct {
    signer: [32]u8,
    payload: []const u8,
};

/// Write a u64 as 8 big-endian bytes into `dst`. Big-endian keeps the wire form byte-order-stable across targets.
fn write_u64_be(dst: *[8]u8, v: u64) void {
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        // Most-significant byte first: byte i holds bits [56-8i .. 63-8i].
        dst[i] = @intCast((v >> @intCast(56 - 8 * i)) & 0xff);
    }
    // invariant: the round-trip through read_u64_be recovers the value exactly — the encoding is total and reversible.
    assert(read_u64_be(dst) == v);
}

/// Read 8 big-endian bytes as a u64. The inverse of write_u64_be.
fn read_u64_be(src: *const [8]u8) u64 {
    var v: u64 = 0;
    var i: u32 = 0;
    while (i < 8) : (i += 1) v = (v << 8) | @as(u64, src[i]);
    // invariant: exactly eight bytes were folded in, so every bit of the u64 came from the buffer.
    assert(i == 8);
    return v;
}

/// Constant-time-independent byte compare for the selftest and the digest check. Returns false on any length or byte difference. (The digest
/// and signature checks below guard public frames, so a data-independent compare is not required here — the signature is the secret-bearing
/// gate, and it lives in the verify primitive.)
fn bytes_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// Seal an opaque payload under a 32-byte secret seed, writing a whole signed carry frame into `out` and returning its length in bytes. The
/// frame is built in place: header and payload first, then the BLAKE2b digest over exactly those bytes, then the Ed25519 signature over the
/// digest. Reads a secret seed (through the signing primitive); the frame it produces is entirely public.
pub fn seal(seed: *const [32]u8, payload: []const u8, out: []u8) SignedCarryError!u32 {
    // invariant: the payload fits the named bound, so the whole frame fits max_frame_bytes and every length below stays a bounded u32.
    if (payload.len > max_payload_bytes) return error.PayloadTooLong;
    const paylen: u32 = @intCast(payload.len);
    const frame_len: u32 = frame_overhead + paylen;
    // invariant: the caller's buffer holds the whole frame — checked at the edge before a single byte is written.
    if (out.len < frame_len) return error.OutTooSmall;

    // --- header: magic ‖ signer ‖ paylen -------------------------------------------------------------------------------------------------
    var i: u32 = 0;
    while (i < magic_len) : (i += 1) out[i] = magic[i];

    const signer = signer_lib.derive_public(seed);
    var j: u32 = 0;
    while (j < signer_len) : (j += 1) out[magic_len + j] = signer[j];

    var lenbuf: [8]u8 = undefined;
    write_u64_be(&lenbuf, payload.len);
    var k: u32 = 0;
    while (k < paylen_field_len) : (k += 1) out[magic_len + signer_len + k] = lenbuf[k];

    // --- payload -------------------------------------------------------------------------------------------------------------------------
    var p: u32 = 0;
    while (p < paylen) : (p += 1) out[header_len + p] = payload[p];

    // --- digest: BLAKE2b-512 over (magic ‖ signer ‖ paylen ‖ payload) ---------------------------------------------------------------------
    const preimage = out[0 .. header_len + paylen];
    // invariant: the preimage is header + payload, far inside BLAKE2b's 1 MiB bound, so the digest step cannot refuse — catch unreachable is honest.
    assert(preimage.len <= header_len + max_payload_bytes);
    const digest = blake2b.hash512(preimage) catch unreachable;
    var d: u32 = 0;
    while (d < digest_len) : (d += 1) out[header_len + paylen + d] = digest[d];

    // --- signature: Ed25519 over the 64-byte digest --------------------------------------------------------------------------------------
    // The digest is 64 bytes, far inside the signing bound, so signing cannot refuse here either.
    const sig = signer_lib.sign(seed, digest[0..]) catch unreachable;
    var s: u32 = 0;
    while (s < sig_len) : (s += 1) out[header_len + paylen + digest_len + s] = sig[s];

    // invariant: the whole frame was written — overhead plus payload — and nothing past it was touched.
    assert(header_len + paylen + trailer_len == frame_len);
    return frame_len;
}

/// Open a signed carry frame: verify BEFORE returning any payload byte. Checks, in order, magic → declared length → recomputed digest →
/// signature; only when all four pass does it return the verified signer and a zero-copy payload slice into `frame`. Reads only public bytes;
/// holds no key.
pub fn open(frame: []const u8) SignedCarryError!Opened {
    // invariant: the frame is at least the fixed overhead, so every fixed field below has bytes to read.
    if (frame.len < frame_overhead) return error.FrameTooShort;

    // 1. Magic — refuse anything that is not one of ours before touching another field.
    if (!bytes_eq(frame[0..magic_len], magic[0..])) return error.BadMagic;

    // 2. Declared length must match the actual frame, and stay within bounds.
    const paylen_u64 = read_u64_be(frame[magic_len + signer_len ..][0..8]);
    if (paylen_u64 > max_payload_bytes) return error.LengthMismatch;
    const paylen: u32 = @intCast(paylen_u64);
    if (frame.len != frame_overhead + paylen) return error.LengthMismatch;

    // 3. Content address: recompute the digest over the frame's own header+payload and compare to the embedded one. A byte moved anywhere
    //    upstream — payload, signer, or length — changes this and is refused here, before the signature is even consulted.
    const preimage = frame[0 .. header_len + paylen];
    const recomputed = blake2b.hash512(preimage) catch unreachable;
    const embedded_digest = frame[header_len + paylen ..][0..digest_len];
    if (!bytes_eq(recomputed[0..], embedded_digest)) return error.DigestMismatch;

    // 4. Signature: the embedded key must have signed this exact digest. Only after this passes does a payload byte leave the door.
    var sig: [64]u8 = undefined;
    var s: u32 = 0;
    const sig_off = header_len + paylen + digest_len;
    while (s < sig_len) : (s += 1) sig[s] = frame[sig_off + s];
    var signer: [32]u8 = undefined;
    var j: u32 = 0;
    while (j < signer_len) : (j += 1) signer[j] = frame[magic_len + j];
    verify_lib.verify(&sig, recomputed[0..], &signer) catch return error.BadSignature;

    // invariant: every gate passed — magic, length, digest, signature — so the payload slice below is trustworthy.
    assert(frame.len == frame_overhead + paylen);
    return Opened{ .signer = signer, .payload = frame[header_len .. header_len + paylen] };
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

/// Fill a buffer with a deterministic spread of test bytes — the same generator shape the sibling primitives use, seeded so each value differs
/// and the first byte is nonzero. Used for TEST seeds and TEST payloads only; never a real key.
fn fill_test(buf: []u8, seed: u8) void {
    var i: u32 = 0;
    while (i < buf.len) : (i += 1) buf[i] = @as(u8, @truncate(@as(u32, i) *% (@as(u32, seed) | 1) +% @as(u32, seed) +% 7));
    if (buf.len > 0) buf[0] |= 1;
}

fn run_selftest() !u8 {
    var frame_buf: [max_frame_bytes]u8 = undefined;
    var frame_buf2: [max_frame_bytes]u8 = undefined;

    // A TEST seed — 32 bytes of deterministic material. NOT a real identity key.
    var seed: [32]u8 = undefined;
    fill_test(seed[0..], 42);
    const signer = signer_lib.derive_public(&seed);

    // 1. Round-trip across a spread of payload lengths, including the empty payload and the maximum.
    const lengths = [_]u32{ 0, 1, 32, 44, 127, 1000, 4096, max_payload_bytes };
    for (lengths) |plen| {
        var payload_buf: [max_payload_bytes]u8 = undefined;
        const payload = payload_buf[0..plen];
        fill_test(payload, @truncate(plen +% 3));

        const flen = try seal(&seed, payload, frame_buf[0..]);
        if (flen != frame_overhead + plen) return error.FrameLenWrong;

        const opened = try open(frame_buf[0..flen]);
        if (!bytes_eq(&opened.signer, &signer)) return error.SignerWrong;
        if (!bytes_eq(opened.payload, payload)) return error.PayloadWrong;
    }

    // 2. Determinism: Ed25519 is deterministic, so sealing the same (seed, payload) twice yields byte-identical frames.
    {
        var payload_buf: [64]u8 = undefined;
        fill_test(payload_buf[0..], 9);
        const f1 = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        const f2 = try seal(&seed, payload_buf[0..], frame_buf2[0..]);
        if (f1 != f2) return error.DeterminismLenWrong;
        if (!bytes_eq(frame_buf[0..f1], frame_buf2[0..f2])) return error.DeterminismBytesWrong;
    }

    // 3. Independent cross-check: the embedded digest equals an independent BLAKE2b of the preimage, and the primitive verifier accepts the
    //    embedded signature over that digest — parity with the primitives this library composes, checked from outside seal/open.
    {
        var payload_buf: [200]u8 = undefined;
        fill_test(payload_buf[0..], 5);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        const plen: u32 = 200;
        const preimage = frame_buf[0 .. header_len + plen];
        const indep_digest = try blake2b.hash512(preimage);
        const embedded = frame_buf[header_len + plen ..][0..digest_len];
        if (!bytes_eq(indep_digest[0..], embedded)) return error.IndependentDigestMismatch;
        var sig: [64]u8 = undefined;
        var s: u32 = 0;
        while (s < 64) : (s += 1) sig[s] = frame_buf[header_len + plen + digest_len + s];
        verify_lib.verify(&sig, indep_digest[0..], &signer) catch return error.IndependentVerifyFailed;
        _ = flen;
    }

    // 4. Tamper the payload — the recomputed digest changes, so open refuses with DigestMismatch before ever reaching the signature.
    {
        var payload_buf: [128]u8 = undefined;
        fill_test(payload_buf[0..], 11);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        frame_buf[header_len + 3] ^= 0x01; // flip one payload byte
        if (open(frame_buf[0..flen])) |_| return error.TamperPayloadAccepted else |e| {
            if (e != error.DigestMismatch) return error.TamperPayloadWrongError;
        }
    }

    // 5. Tamper the signature only — the digest still recomputes correctly (it is over the preimage, not the signature), so open reaches the
    //    signature check and refuses with BadSignature. This proves the two failure paths are distinct.
    {
        var payload_buf: [128]u8 = undefined;
        fill_test(payload_buf[0..], 13);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        const sig_off = header_len + 128 + digest_len;
        frame_buf[sig_off + 10] ^= 0x80; // flip one signature byte
        if (open(frame_buf[0..flen])) |_| return error.TamperSigAccepted else |e| {
            if (e != error.BadSignature) return error.TamperSigWrongError;
        }
    }

    // 6. Tamper the embedded digest — the recomputed digest no longer matches the embedded field, so DigestMismatch fires first.
    {
        var payload_buf: [64]u8 = undefined;
        fill_test(payload_buf[0..], 17);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        frame_buf[header_len + 64] ^= 0x01; // flip one digest byte
        if (open(frame_buf[0..flen])) |_| return error.TamperDigestAccepted else |e| {
            if (e != error.DigestMismatch) return error.TamperDigestWrongError;
        }
    }

    // 7. Wrong signer swapped in — the signer key is part of the preimage, so the recomputed digest changes and DigestMismatch fires. (A
    //    forger cannot substitute a key without also breaking the content address that the real signature commits to.)
    {
        var seed_b: [32]u8 = undefined;
        fill_test(seed_b[0..], 99);
        const signer_b = signer_lib.derive_public(&seed_b);
        var payload_buf: [64]u8 = undefined;
        fill_test(payload_buf[0..], 19);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        var j: u32 = 0;
        while (j < signer_len) : (j += 1) frame_buf[magic_len + j] = signer_b[j]; // splice in a different key
        if (open(frame_buf[0..flen])) |_| return error.WrongSignerAccepted else |e| {
            if (e != error.DigestMismatch) return error.WrongSignerWrongError;
        }
    }

    // 8. Bad magic — a buffer that is not one of ours is refused before any field parse.
    {
        var payload_buf: [32]u8 = undefined;
        fill_test(payload_buf[0..], 23);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        frame_buf[0] = 'X';
        if (open(frame_buf[0..flen])) |_| return error.BadMagicAccepted else |e| {
            if (e != error.BadMagic) return error.BadMagicWrongError;
        }
    }

    // 9. Truncation — a frame shorter than the fixed overhead, and one whose declared length disagrees with its actual bytes.
    {
        var payload_buf: [32]u8 = undefined;
        fill_test(payload_buf[0..], 29);
        const flen = try seal(&seed, payload_buf[0..], frame_buf[0..]);
        if (open(frame_buf[0 .. frame_overhead - 1])) |_| return error.ShortAccepted else |e| {
            if (e != error.FrameTooShort) return error.ShortWrongError;
        }
        // Hand open one byte too few of a valid-magic frame: overhead is met but declared paylen no longer matches the actual length.
        if (open(frame_buf[0 .. flen - 1])) |_| return error.LengthAccepted else |e| {
            if (e != error.LengthMismatch) return error.LengthWrongError;
        }
    }

    // 10. seal refuses an out buffer that is too small, and a payload past the bound.
    {
        var small: [frame_overhead + 10]u8 = undefined;
        var payload_buf: [64]u8 = undefined;
        fill_test(payload_buf[0..], 31);
        if (seal(&seed, payload_buf[0..], small[0..])) |_| return error.SmallOutAccepted else |e| {
            if (e != error.OutTooSmall) return error.SmallOutWrongError;
        }
    }

    print("GREEN crypto-signed-carry: the FIRST composition over Season G's GREEN primitives — a self-describing, content-addressed, " ++
        "Ed25519-signed carry frame built purely from BLAKE2b-512 (the content address) and Ed25519 sign/verify (the seal), authoring no new " ++
        "cryptography of its own. A frame is magic ‖ signer ‖ paylen(u64 BE) ‖ payload ‖ BLAKE2b-512 digest ‖ Ed25519 signature-over-digest; " ++
        "signing the digest makes it do double duty as both the content address a keeper cites and the value the signature commits to. open() " ++
        "verifies BEFORE trust: magic, then declared length, then a recomputed digest (a byte moved anywhere upstream is refused here), then " ++
        "the signature — only then does one zero-copy payload byte leave the door, alongside the verified signer key. Proven GREEN on metal: " ++
        "round-trip across eight payload lengths (empty through 64 KiB), byte-identical determinism, an independent BLAKE2b + primitive-verify " ++
        "cross-check, and seven refusals each caught by its OWN named error — tampered payload and tampered/spliced digest and swapped signer " ++
        "all fail DigestMismatch, a flipped signature byte fails BadSignature (proving the two paths are distinct), plus bad magic, two " ++
        "truncations, and an undersized output buffer. Purely local over a TEST seed — no real identity key, no network, no funds, no real " ++
        "device; sealing a record with the maintainer's own identity key stays the custody gate, and constant-time timing-safety stays the " ++
        "Season's named horizon. This is the Lotus 'who made this record' unblock and Season 2's content-addressed chain of custody, standing " ++
        "as a library on primitives already parity-GREEN.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
