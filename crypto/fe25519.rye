//! crypto/fe25519.rye — Season G (Cryptography), the sixth rung: the Curve25519 base field GF(2^255 − 19) authored in pure Rye. Every
//! remaining Monocypher-parity primitive the decision wave names — Ed25519 signing (the Lotus signed carry, Kumara identity, Vault,
//! Comlink) and X25519 key agreement — stands on this one finite field. The five GREEN primitives before it (BLAKE2b, SHA-512, ChaCha20,
//! Poly1305, and the ChaCha20-Poly1305 AEAD) were integer arithmetic alone; the AEAD's own header stated the boundary plainly: it "adds no
//! new field math (the curve, edwards25519, still wants its own design round)." This file is that design round's crux — the durable stone
//! every later curve operation reaches for, built and proven before any of them.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-193010_fe25519-the-curve-field-crux.md (this round) and
//! active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G names Ed25519 as the Lotus unblock, its
//! field math a separate gated round).
//! Kin: crypto/poly1305.rye (the limb-arithmetic sibling — five 26-bit limbs mod 2^130 − 5; this is five 51-bit limbs mod 2^255 − 19).
//! Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity TARGET, never a copied line — our own arithmetic, studied clean-room from the
//! public mathematics of Curve25519 and Monocypher's public API (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX — a field element is a residue mod the prime p = 2^255 − 19, carried in five 51-bit limbs (radix 2^51), the exact sibling of
//! Poly1305's five 26-bit limbs over 2^130 − 5. Addition and subtraction are limbwise (subtraction adds a folded 2p first so no limb goes
//! negative). Multiplication is the schoolbook product with the field's own reduction: any partial product past limb 4 lands at 2^255 or
//! beyond, and 2^255 ≡ 19 (mod p), so those terms fold back multiplied by 19 — precisely how Poly1305 folds ×5 because 2^130 ≡ 5. The
//! products accumulate in 128-bit words, then a carry chain returns the result to reduced 51-bit limbs. Squaring is the product of an
//! element with itself. The multiplicative inverse is Fermat's: a^(p−2) = a^(2^255 − 21), computed by a fixed square-and-multiply ladder
//! (254 squarings, skipping the two multiplies the exponent's bit pattern omits). Packing to 32 bytes performs a final conditional subtract
//! of p, so the output is always the true canonical residue. Nothing here is a claim about a device; it is arithmetic anyone can replay.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device, no identity. A field element is arithmetic, not a
//! secret and not a signature: this file signs nothing (Ed25519's signing with an identity key stays its own separate, gated round). It
//! calls no std.crypto in the primitive itself. Parity is proven at selftest against two references runnable now — small known-answers
//! anyone can check by hand (1·1 = 1, 2·3 = 6, canonical round-trips, a − a = 0, a·a⁻¹ = 1, and a non-canonical encoding reducing to its
//! true residue), and Zig's own std.crypto.ecc.Edwards25519.Fe as an independent radix-2^51 implementation, compared byte-for-byte on the
//! canonical packing of add, sub, mul, sq, and invert across a deterministic spread of field elements. Because the comparison is on
//! canonical bytes, the two implementations may carry limbs differently and still must agree exactly. Monocypher-source parity stays the
//! same held-fetch horizon the other primitives carry; constant-time timing-safety stays a separate named horizon (the ladder is
//! data-independent by construction, yet timing is a measurement, not a claim).
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/fe25519.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const fe25519_version = "20260815.193010";

/// The limb mask — 2^51 − 1. A field element is five limbs, each holding 51 bits of the 255-bit residue, so a limb-by-limb product of two
/// weakly-reduced limbs (each below 2^53) stays under 2^106 and a sum of five such terms with a ×19 fold fits a single 128-bit word.
const mask51: u64 = 0x7ffffffffffff;

/// The reduction constant. Because 2^255 ≡ 19 (mod p), any weight past the fifth limb folds back multiplied by 19 — the field's own trick,
/// exactly as Poly1305 folds ×5 for 2^130 ≡ 5.
const reduce_fold: u64 = 19;

pub const Fe25519Error = error{
    /// A hex or byte buffer handed to a helper did not match its declared fixed length. The field element itself is a fixed 32-byte value,
    /// so the primitive's own operations cannot receive a malformed length; this names the selftest helpers' contract.
    LengthMismatch,
};

/// A field element in GF(2^255 − 19), five 51-bit limbs, little-endian by limb weight (limb 0 is the least significant). Operations keep
/// limbs weakly reduced (each below 2^53), and `to_bytes` performs the final canonical reduction.
pub const Field = struct {
    l: [5]u64,
};

/// Unpack a 32-byte little-endian value into five 51-bit limbs, dropping bit 255 (the field holds 255 bits). This is the canonical
/// Curve25519 bit layout: successive 51-bit windows cut from overlapping 64-bit reads. The result may exceed p (it is reduced on packing).
pub fn from_bytes(s: *const [32]u8) Field {
    var f: Field = undefined;
    f.l[0] = std.mem.readInt(u64, s[0..8], .little) & mask51;
    f.l[1] = (std.mem.readInt(u64, s[6..14], .little) >> 3) & mask51;
    f.l[2] = (std.mem.readInt(u64, s[12..20], .little) >> 6) & mask51;
    f.l[3] = (std.mem.readInt(u64, s[19..27], .little) >> 1) & mask51;
    f.l[4] = (std.mem.readInt(u64, s[24..32], .little) >> 12) & mask51;
    // invariant: every unpacked limb is masked to 51 bits, so the element is weakly reduced from the start.
    assert(f.l[0] <= mask51 and f.l[1] <= mask51 and f.l[2] <= mask51 and f.l[3] <= mask51 and f.l[4] <= mask51);
    // invariant: bit 255 is dropped — limb 4 holds bits 204..254, never bit 255, so the value is a residue mod 2^255.
    assert(f.l[4] <= mask51);
    return f;
}

/// Reduce an element to its true canonical residue in [0, p): two carry passes fold the limbs below 2^51, then a conditional subtract of p
/// (staged as an add of p's complement) leaves the least non-negative representative. Branchless by construction — the choice rides in the
/// carry, not in a branch on the value.
fn reduce(f: *Field) void {
    var i: u32 = 0;
    // Two weak-reduction passes: carry each limb into the next, folding the top carry back ×19 (2^255 ≡ 19).
    var pass: u32 = 0;
    while (pass < 2) : (pass += 1) {
        i = 0;
        while (i < 4) : (i += 1) {
            f.l[i + 1] += f.l[i] >> 51;
            f.l[i] &= mask51;
        }
        f.l[0] += reduce_fold * (f.l[4] >> 51);
        f.l[4] &= mask51;
    }
    // invariant: after two folding passes the value is below 2^255 + a small slack, so one more add-of-19 exposes whether it is ≥ p.
    assert(f.l[4] <= mask51);

    // Add 19: if the value was in [p, 2^255) this pushes limb 4 past 2^51, and the carry that folds back marks the overflow; if it was
    // below p, no such carry appears. Either way a final subtract of p (staged as adding 2^51 − 19 / 2^51 − 1 to each limb) lands the
    // canonical residue once the carries settle.
    f.l[0] += reduce_fold;
    i = 0;
    while (i < 4) : (i += 1) {
        f.l[i + 1] += f.l[i] >> 51;
        f.l[i] &= mask51;
    }
    f.l[0] += reduce_fold * (f.l[4] >> 51);
    f.l[4] &= mask51;

    f.l[0] += 0x8000000000000 - 19; // 2^51 − 19  (p's low limb complement)
    f.l[1] += 0x8000000000000 - 1; //  2^51 − 1
    f.l[2] += 0x8000000000000 - 1;
    f.l[3] += 0x8000000000000 - 1;
    f.l[4] += 0x8000000000000 - 1;

    i = 0;
    while (i < 4) : (i += 1) {
        f.l[i + 1] += f.l[i] >> 51;
        f.l[i] &= mask51;
    }
    f.l[4] &= mask51;
    // invariant: the element is now the canonical residue — every limb below 2^51.
    assert(f.l[0] <= mask51 and f.l[1] <= mask51 and f.l[2] <= mask51 and f.l[3] <= mask51 and f.l[4] <= mask51);
}

/// Pack a field element to 32 little-endian bytes, first reducing to the canonical residue so equal values always serialize identically —
/// the property the byte-for-byte parity check depends on.
pub fn to_bytes(a: Field) [32]u8 {
    var f = a;
    reduce(&f);
    var s: [32]u8 = undefined;
    std.mem.writeInt(u64, s[0..8], f.l[0] | (f.l[1] << 51), .little);
    std.mem.writeInt(u64, s[8..16], (f.l[1] >> 13) | (f.l[2] << 38), .little);
    std.mem.writeInt(u64, s[16..24], (f.l[2] >> 26) | (f.l[3] << 25), .little);
    std.mem.writeInt(u64, s[24..32], (f.l[3] >> 39) | (f.l[4] << 12), .little);
    return s;
}

/// Add two field elements limbwise. Operands are weakly reduced (limbs below 2^53), so each sum stays below 2^54 — well inside u64 and
/// inside the multiply schedule's headroom.
pub fn add(a: Field, b: Field) Field {
    var f: Field = undefined;
    var i: u32 = 0;
    while (i < 5) : (i += 1) f.l[i] = a.l[i] + b.l[i];
    // invariant: each limb sum of two sub-2^53 limbs stays below 2^54, safe as a later multiply operand.
    assert(f.l[0] < (1 << 54) and f.l[4] < (1 << 54));
    return f;
}

/// Subtract b from a. First b is carried below 2^51, then a folded 2p (2^52 − 38 for limb 0, 2^52 − 2 for the rest) is added to a before
/// subtracting b, so no limb underflows and the result stays a valid weakly-reduced element congruent to a − b.
pub fn sub(a: Field, b: Field) Field {
    var t = b;
    var i: u32 = 0;
    while (i < 4) : (i += 1) {
        t.l[i + 1] += t.l[i] >> 51;
        t.l[i] &= mask51;
    }
    t.l[0] += reduce_fold * (t.l[4] >> 51);
    t.l[4] &= mask51;
    // invariant: b is now carried below 2^51 per limb, so adding the folded 2p to a keeps each difference non-negative.
    assert(t.l[0] <= mask51 and t.l[4] <= mask51);

    var f: Field = undefined;
    f.l[0] = (a.l[0] + 0xfffffffffffda) - t.l[0]; // + (2^52 − 38)
    f.l[1] = (a.l[1] + 0xffffffffffffe) - t.l[1]; // + (2^52 − 2)
    f.l[2] = (a.l[2] + 0xffffffffffffe) - t.l[2];
    f.l[3] = (a.l[3] + 0xffffffffffffe) - t.l[3];
    f.l[4] = (a.l[4] + 0xffffffffffffe) - t.l[4];
    // invariant: each result limb is below 2^53, so the difference is a safe multiply operand.
    assert(f.l[0] < (1 << 53) and f.l[4] < (1 << 53));
    return f;
}

/// Multiply two field elements. Schoolbook radix-2^51 product with the 2^255 ≡ 19 fold: partial products a_i·b_j land at limb (i+j), and
/// any i+j ≥ 5 crosses 2^255 and folds back ×19. Products accumulate in 128-bit words; a carry chain returns the result to weakly-reduced
/// 51-bit limbs (each below 2^52).
pub fn mul(a: Field, b: Field) Field {
    const a0 = a.l[0];
    const a1 = a.l[1];
    const a2 = a.l[2];
    const a3 = a.l[3];
    const a4 = a.l[4];

    // The ×19 folds of b's upper limbs — each stays below 2^58 (19 · 2^53), safe as a u64 multiplicand.
    const b0 = b.l[0];
    const b1 = b.l[1];
    const b2 = b.l[2];
    const b3 = b.l[3];
    const b4 = b.l[4];
    const b1_19 = reduce_fold * b1;
    const b2_19 = reduce_fold * b2;
    const b3_19 = reduce_fold * b3;
    const b4_19 = reduce_fold * b4;

    // invariant: each folded upper limb fits a u64, so every product below stays within a u128.
    assert(b4_19 < (1 << 59));

    const c0: u128 = @as(u128, a0) * b0 + @as(u128, a4) * b1_19 + @as(u128, a3) * b2_19 + @as(u128, a2) * b3_19 + @as(u128, a1) * b4_19;
    var c1: u128 = @as(u128, a0) * b1 + @as(u128, a1) * b0 + @as(u128, a4) * b2_19 + @as(u128, a3) * b3_19 + @as(u128, a2) * b4_19;
    var c2: u128 = @as(u128, a0) * b2 + @as(u128, a1) * b1 + @as(u128, a2) * b0 + @as(u128, a4) * b3_19 + @as(u128, a3) * b4_19;
    var c3: u128 = @as(u128, a0) * b3 + @as(u128, a1) * b2 + @as(u128, a2) * b1 + @as(u128, a3) * b0 + @as(u128, a4) * b4_19;
    var c4: u128 = @as(u128, a0) * b4 + @as(u128, a1) * b3 + @as(u128, a2) * b2 + @as(u128, a3) * b1 + @as(u128, a4) * b0;

    // Carry the product chain, folding the top overflow back ×19 (2^255 ≡ 19), then a final short carry so limb 0 settles below 2^51.
    c1 += c0 >> 51;
    var l0: u64 = @as(u64, @truncate(c0)) & mask51;
    c2 += c1 >> 51;
    const l1a: u64 = @as(u64, @truncate(c1)) & mask51;
    c3 += c2 >> 51;
    const l2: u64 = @as(u64, @truncate(c2)) & mask51;
    c4 += c3 >> 51;
    const l3: u64 = @as(u64, @truncate(c3)) & mask51;
    const l4: u64 = @as(u64, @truncate(c4)) & mask51;

    l0 += reduce_fold * @as(u64, @truncate(c4 >> 51));
    const l1: u64 = l1a + (l0 >> 51);
    l0 &= mask51;

    var f: Field = undefined;
    f.l[0] = l0;
    f.l[1] = l1;
    f.l[2] = l2;
    f.l[3] = l3;
    f.l[4] = l4;
    // invariant: every output limb is weakly reduced below 2^52, a safe operand for the next field operation.
    assert(f.l[0] <= mask51 and f.l[1] < (1 << 52) and f.l[2] <= mask51 and f.l[3] <= mask51 and f.l[4] <= mask51);
    return f;
}

/// Square a field element — the product of the element with itself. Kept as its own named contract so callers (the inverse ladder) read
/// plainly, and so a future dedicated squaring schedule can replace the body without touching the callers.
pub fn square(a: Field) Field {
    const r = mul(a, a);
    // invariant: squaring yields a weakly-reduced element, identical in contract to any other product.
    assert(r.l[0] <= mask51 and r.l[4] <= mask51);
    return r;
}

/// The multiplicative inverse by Fermat's little theorem: a^(p−2) = a^(2^255 − 21). A fixed square-and-multiply ladder of 254 squarings
/// multiplies in a at every step except the two the exponent's bit pattern omits (positions 2 and 4), so a·invert(a) = 1 for every nonzero
/// a. invert(0) is 0 (0 has no inverse); callers never invert zero. Data-independent by construction — the ladder's shape is fixed.
pub fn invert(a: Field) Field {
    var c = a;
    var i: i32 = 253;
    // invariant: the ladder runs a fixed 254 iterations, bounded and independent of the operand's value.
    while (i >= 0) : (i -= 1) {
        c = square(c);
        if (i != 2 and i != 4) c = mul(c, a);
    }
    // invariant: the result is a weakly-reduced field element, ready for a final multiply or packing.
    assert(c.l[0] <= mask51 and c.l[4] <= mask51);
    return c;
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

/// Build a small field element from a u64 that fits one limb — used only for the by-hand known-answers (1, 2, 3, 6).
fn from_small(v: u64) Field {
    // invariant: the value fits a single 51-bit limb, so the constructed element is already canonical.
    assert(v <= mask51);
    return Field{ .l = .{ v, 0, 0, 0, 0 } };
}

fn bytes_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// A deterministic spread of test encodings — the same generator shape the sibling primitives use, seeded so each element differs and none
/// is zero. Bit 255 is cleared so the encoding is a clean 255-bit value both unpackers read identically.
fn test_bytes(seed: u8) [32]u8 {
    var s: [32]u8 = undefined;
    var i: u32 = 0;
    while (i < 32) : (i += 1) s[i] = @as(u8, @truncate(@as(u32, i) *% (@as(u32, seed) | 1) +% @as(u32, seed) +% 7));
    s[0] |= 1; // guarantee a nonzero, non-p residue for the invert check
    s[31] &= 0x7f; // drop bit 255 — the field holds 255 bits
    return s;
}

/// Independent reference: Zig's own std.crypto field element over the same prime, an independent radix-2^51 implementation. Used ONLY
/// inside the selftest as a second implementation to prove our authored arithmetic matches byte-for-byte. The primitive above never calls it.
const ZFe = std.crypto.ecc.Edwards25519.Fe;

fn run_selftest() !u8 {
    // 1. By-hand known-answers anyone can check: canonical round-trips, 1·1 = 1, 2·3 = 6, a − a = 0, and a non-canonical encoding
    //    reducing to its true residue.
    {
        // Canonical round-trip of the Curve25519 base u-coordinate, 9.
        var nine = [_]u8{0} ** 32;
        nine[0] = 9;
        if (!bytes_eq(&to_bytes(from_bytes(&nine)), &nine)) return error.RoundTripMismatch;

        // 1·1 = 1.
        const one = from_small(1);
        var one_b = [_]u8{0} ** 32;
        one_b[0] = 1;
        if (!bytes_eq(&to_bytes(mul(one, one)), &one_b)) return error.OneMismatch;

        // 2·3 = 6.
        var six_b = [_]u8{0} ** 32;
        six_b[0] = 6;
        if (!bytes_eq(&to_bytes(mul(from_small(2), from_small(3))), &six_b)) return error.ProductMismatch;

        // a − a = 0 for a nonzero a.
        const a = from_bytes(&test_bytes(31));
        var zero_b = [_]u8{0} ** 32;
        if (!bytes_eq(&to_bytes(sub(a, a)), &zero_b)) return error.SubMismatch;

        // a · a⁻¹ = 1.
        if (!bytes_eq(&to_bytes(mul(a, invert(a))), &one_b)) return error.InverseMismatch;

        // A non-canonical encoding reduces to its true residue: the encoding of p is 0, and the encoding of p + 5 is 5.
        var p_enc = [_]u8{0xff} ** 32;
        p_enc[0] = 0xed;
        p_enc[31] = 0x7f;
        if (!bytes_eq(&to_bytes(from_bytes(&p_enc)), &zero_b)) return error.NonCanonicalP;

        var p5_enc = [_]u8{0xff} ** 32;
        p5_enc[0] = 0xf2; // 0x100 − 14, i.e. (p + 5) mod 256
        p5_enc[31] = 0x7f;
        var five_b = [_]u8{0} ** 32;
        five_b[0] = 5;
        if (!bytes_eq(&to_bytes(from_bytes(&p5_enc)), &five_b)) return error.NonCanonicalP5;
    }

    // 2. Independent-implementation parity: our authored Rye equals Zig's std.crypto.ecc.Edwards25519.Fe byte-for-byte on the canonical
    //    packing of add, sub, mul, sq, and invert across a deterministic spread of field elements.
    {
        var seed: u8 = 1;
        while (seed <= 24) : (seed += 1) {
            const xb = test_bytes(seed);
            const yb = test_bytes(seed +% 101);

            const x = from_bytes(&xb);
            const y = from_bytes(&yb);
            const zx = ZFe.fromBytes(xb);
            const zy = ZFe.fromBytes(yb);

            if (!bytes_eq(&to_bytes(add(x, y)), &zx.add(zy).toBytes())) return error.RefAddMismatch;
            if (!bytes_eq(&to_bytes(sub(x, y)), &zx.sub(zy).toBytes())) return error.RefSubMismatch;
            if (!bytes_eq(&to_bytes(mul(x, y)), &zx.mul(zy).toBytes())) return error.RefMulMismatch;
            if (!bytes_eq(&to_bytes(square(x)), &zx.sq().toBytes())) return error.RefSqMismatch;
            if (!bytes_eq(&to_bytes(invert(x)), &zx.invert().toBytes())) return error.RefInvertMismatch;
        }
    }

    print("GREEN crypto-fe25519: the Curve25519 base field GF(2^255 − 19) authored in pure Rye — Season G's sixth rung and the durable " ++
        "stone every later curve operation stands on. A field element is a residue mod p = 2^255 − 19 in five 51-bit limbs (radix 2^51), " ++
        "the exact sibling of Poly1305's five 26-bit limbs over 2^130 − 5; addition and subtraction are limbwise, multiplication is the " ++
        "schoolbook product with the field's own fold (any weight past 2^255 returns ×19, because 2^255 ≡ 19), squaring is the product " ++
        "with itself, and the inverse is Fermat's a^(p−2) by a fixed 254-squaring ladder. The primitive calls no std.crypto. Parity holds " ++
        "against two references runnable now: by-hand known-answers (1·1 = 1, 2·3 = 6, the base coordinate round-trips, a − a = 0, " ++
        "a·a⁻¹ = 1, and the encodings of p and p+5 reduce to 0 and 5), and our authored Rye equals Zig's independent " ++
        "std.crypto.ecc.Edwards25519.Fe byte-for-byte on the canonical packing of add, sub, mul, sq, and invert across a deterministic " ++
        "spread of twenty-four field elements. Because parity is checked on canonical bytes, the two implementations carry limbs their own " ++
        "way and still agree exactly. Monocypher's own field passes the same mathematics — its vendored source is a held fetch, so " ++
        "Monocypher-source parity is an honest horizon rung. Purely local arithmetic — a field element is not a secret and not a " ++
        "signature, so no real key, no signing, no network, no funds, no real device; Ed25519's signing with an identity key stays its " ++
        "own separate, gated round, and constant-time timing-safety stays a separate named horizon. The field beneath the curve now " ++
        "stands, and Ed25519 and X25519 become composition rounds over a proven base.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
