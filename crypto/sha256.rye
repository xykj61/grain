//! crypto/sha256.rye -- Season G (Cryptography): SHA-256 authored in pure Rye. SHA-256 (FIPS 180-4) is the 256-bit hash the tree
//! already leans on through std.crypto -- Tablecloth's content-addressed keying (pond/apps/tablecloth_keyed.rye), the Mycelium
//! consensus spine's rendezvous placement (SHA-256(domain - world-id - host-pk) in puddle.rye), and the constel test network's
//! name-to-seed derivation (seed = SHA-256(name)) all name content or identity with it. Season G's thesis is to author our own,
//! parity-checked, calling no std.crypto -- so this rung lifts SHA-256 off the standard library the same way SHA-512, BLAKE2b, and the
//! SHA3 pair already stand. It is the 32-bit sibling of SHA-512: the same Merkle-Damgård shape over 32-bit words instead of 64.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography - Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (the wave that seats Season G).
//! Kin: crypto/sha512.rye (the 64-bit sibling, GREEN on metal), crypto/sha3.rye (the Keccak hash). Monocypher (vendor/monocypher,
//! CC0/BSD-dual) does not itself ship SHA-256; this hash is authored from FIPS 180-4 directly and proven against Zig's independent
//! std.crypto, exactly as SHA3 was added for Aurora's need (.claude/rules/gratitude-licenses.md -- our own arithmetic, clean-room).
//!
//! THE CRUX -- SHA-256 is a bounded loop over 32-bit words, mod 2^32. The message is padded to a whole number of 64-byte blocks (a
//! 0x80 byte, zeros, then the 64-bit big-endian bit length), each block expanded to sixty-four message-schedule words and folded
//! through sixty-four rounds of the Ch/Maj/Sigma functions into an eight-word hash state. Every add is mod 2^32 (Zig's wrapping +%);
//! every rotation and shift is a fixed constant from the standard. Nothing here is a claim about a device -- it is arithmetic anyone
//! can replay against FIPS 180-4.
//!
//! HONEST SCOPE -- software only, purely LOCAL, no key, no network, no funds, no real device. The primitive calls no std.crypto; it is
//! authored from the standard. Parity is proven at selftest against two references runnable now -- the FIPS 180-4 known-answers for
//! "abc" and the empty message, and Zig's own std.crypto SHA-256 as an independent implementation, byte-for-byte over the empty
//! message, "abc", a 55-byte input (the padding edge where the length still fits the block), a 56-byte input (the edge that forces a
//! second all-padding block), and a multi-block input. Constant-time timing-safety is a separate named horizon.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/sha256.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const sha256_version = "20260815.232724";

/// SHA-256's fixed shapes. digest_len is the 32-byte (256-bit) output; block_bytes is the 64-byte compression block; the message
/// schedule runs sixty-four rounds. Named so every bound cites one rather than a bare number.
pub const digest_len: u32 = 32;
pub const block_bytes: u32 = 64;
pub const hex_len: u32 = digest_len * 2;
const rounds: u32 = 64;

/// The largest message this primitive hashes in one call. Generous for the test vectors and any in-process artifact, yet named so the
/// bit-length field and the block loop both cite a maximum -- the TAME reflex that every loop and every count declares its ceiling.
pub const max_message_bytes: u32 = 1 << 20;

/// The one fault this primitive can raise: a message longer than max_message_bytes, refused before a single byte is mixed.
pub const Sha256Error = error{
    /// A message whose length exceeds max_message_bytes -- refused at the edge, before padding or the block loop begins.
    MessageTooLong,
};

/// The SHA-256 initial hash value -- the eight 32-bit words (FIPS 180-4 §5.3.3), the fractional parts of the square roots of the first
/// eight primes. Named as a constant so init reads from one source of truth.
const h_init = [8]u32{
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
};

/// The sixty-four SHA-256 round constants (FIPS 180-4 §4.2.2) -- the fractional parts of the cube roots of the first sixty-four primes.
/// A single wrong entry breaks parity against the standard at once, which the selftest proves it does not.
const k = [64]u32{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
};

fn ch(x: u32, y: u32, z: u32) u32 {
    return (x & y) ^ (~x & z);
}

fn maj(x: u32, y: u32, z: u32) u32 {
    return (x & y) ^ (x & z) ^ (y & z);
}

fn big_sigma0(x: u32) u32 {
    return std.math.rotr(u32, x, 2) ^ std.math.rotr(u32, x, 13) ^ std.math.rotr(u32, x, 22);
}

fn big_sigma1(x: u32) u32 {
    return std.math.rotr(u32, x, 6) ^ std.math.rotr(u32, x, 11) ^ std.math.rotr(u32, x, 25);
}

fn small_sigma0(x: u32) u32 {
    return std.math.rotr(u32, x, 7) ^ std.math.rotr(u32, x, 18) ^ (x >> 3);
}

fn small_sigma1(x: u32) u32 {
    return std.math.rotr(u32, x, 17) ^ std.math.rotr(u32, x, 19) ^ (x >> 10);
}

/// Compress one 64-byte block into the eight-word hash state h. The block's sixteen big-endian 32-bit words seed a sixty-four-word
/// message schedule, which drives sixty-four rounds of the Ch/Maj/Sigma round function over eight working words, then the working
/// words fold back into h.
fn compress(h: *[8]u32, block: *const [block_bytes]u8) void {
    // invariant: the block carries exactly sixteen 32-bit words -- the first sixteen entries of the message schedule.
    comptime assert(block_bytes == 16 * 4);
    // invariant: the schedule runs the sixty-four rounds the standard defines.
    comptime assert(rounds == 64);

    var w: [64]u32 = undefined;
    var t: u32 = 0;
    while (t < 16) : (t += 1) {
        w[t] = std.mem.readInt(u32, block[t * 4 ..][0..4], .big);
    }
    while (t < rounds) : (t += 1) {
        w[t] = small_sigma1(w[t - 2]) +% w[t - 7] +% small_sigma0(w[t - 15]) +% w[t - 16];
    }

    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];

    t = 0;
    while (t < rounds) : (t += 1) {
        const t1 = hh +% big_sigma1(e) +% ch(e, f, g) +% k[t] +% w[t];
        const t2 = big_sigma0(a) +% maj(a, b, c);
        hh = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
    }

    h[0] +%= a;
    h[1] +%= b;
    h[2] +%= c;
    h[3] +%= d;
    h[4] +%= e;
    h[5] +%= f;
    h[6] +%= g;
    h[7] +%= hh;
}

/// Hash a message to its 32-byte SHA-256 digest. The message is padded per FIPS 180-4 §5.1.1 -- a 0x80 byte, then zeros, then the
/// message length in bits as a 64-bit big-endian integer -- filling a whole number of 64-byte blocks, then every block is compressed
/// in order.
pub fn hash(msg: []const u8) Sha256Error![digest_len]u8 {
    // invariant: SHA-256's shapes are the standard's own -- 32-byte digest, 64-byte block. Proven at compile time.
    comptime assert(digest_len == 32 and block_bytes == 64);
    // invariant: the message fits the named bound, so its length casts to u32 losslessly and the bit length never overflows u64.
    if (msg.len > max_message_bytes) return error.MessageTooLong;

    const total: u32 = @intCast(msg.len);
    // invariant: the u32 count names exactly the message bytes -- the bounded cast lost nothing.
    assert(total == msg.len);

    var h: [8]u32 = h_init;

    // Compress every FULL 64-byte block of the message proper.
    var offset: u32 = 0;
    while (total - offset >= block_bytes) : (offset += block_bytes) {
        compress(&h, msg[offset..][0..block_bytes]);
    }

    // The tail is 0..63 leftover bytes. Build the padded final block(s): the tail, a 0x80 marker, zeros, then the 64-bit big-endian
    // bit length. When the tail plus marker plus length would exceed one block, two padded blocks are emitted -- the 56-byte edge.
    const rem = total - offset;
    // invariant: the leftover is strictly less than a whole block -- every full block was consumed above.
    assert(rem < block_bytes);

    var tail = [_]u8{0} ** (block_bytes * 2);
    var j: u32 = 0;
    while (j < rem) : (j += 1) tail[j] = msg[offset + j];
    tail[rem] = 0x80;

    // Two padded blocks are needed when the tail leaves no room for the 8-byte length (rem >= 56); otherwise one.
    const padded_len: u32 = if (rem >= block_bytes - 8) block_bytes * 2 else block_bytes;
    // The bit length occupies the last 8 bytes of the padded region; the message is bounded well within u64, so the field carries
    // total * 8 bits exactly.
    const bit_len: u64 = @as(u64, total) * 8;
    std.mem.writeInt(u64, tail[padded_len - 8 ..][0..8], bit_len, .big);

    compress(&h, tail[0..block_bytes]);
    if (padded_len == block_bytes * 2) {
        compress(&h, tail[block_bytes .. block_bytes * 2][0..block_bytes]);
    }

    var out: [digest_len]u8 = undefined;
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        std.mem.writeInt(u32, out[i * 4 ..][0..4], h[i], .big);
    }
    return out;
}

/// Render a 32-byte digest as 64 lowercase hex characters, for comparison against the standard's own hex form.
pub fn to_hex(digest: [digest_len]u8) [hex_len]u8 {
    const alphabet = "0123456789abcdef";
    var out: [hex_len]u8 = undefined;
    var i: u32 = 0;
    // invariant: each input byte renders to exactly two hex characters, so the output fills hex_len exactly.
    comptime assert(hex_len == digest_len * 2);
    while (i < digest_len) : (i += 1) {
        out[i * 2] = alphabet[digest[i] >> 4];
        out[i * 2 + 1] = alphabet[digest[i] & 0x0f];
    }
    return out;
}

// The FIPS 180-4 known-answer for SHA-256 of the ASCII string "abc" -- the neutral public reference our Rye and any auditor's
// reference must both reproduce.
const fips_abc_hex = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
// The published SHA-256 of the empty message.
const fips_empty_hex = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";

/// Independent reference: Zig's own std.crypto SHA-256, used ONLY inside the selftest as a second implementation to prove our authored
/// primitive matches byte-for-byte. The primitive above never calls this.
fn ref_hash(msg: []const u8) [digest_len]u8 {
    var out: [digest_len]u8 = undefined;
    std.crypto.hash.sha2.Sha256.hash(msg, &out, .{});
    return out;
}

fn hex_eq(got: [hex_len]u8, want: []const u8) bool {
    if (want.len != hex_len) return false;
    var i: u32 = 0;
    while (i < hex_len) : (i += 1) {
        if (got[i] != want[i]) return false;
    }
    return true;
}

fn bytes_eq(a: [digest_len]u8, b: [digest_len]u8) bool {
    var i: u32 = 0;
    while (i < digest_len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn ref_parity(msg: []const u8) !void {
    const ours = try hash(msg);
    if (!bytes_eq(ours, ref_hash(msg))) return error.RefMismatch;
}

fn run_selftest() !u8 {
    // 1. The FIPS 180-4 known-answers: SHA-256 of "abc" and the empty message equal the published digests, hex for hex.
    {
        const d = try hash("abc");
        if (!hex_eq(to_hex(d), fips_abc_hex)) return error.AbcVectorMismatch;
        const e = try hash("");
        if (!hex_eq(to_hex(e), fips_empty_hex)) return error.EmptyVectorMismatch;
    }

    // 2. Independent-implementation parity across the padding edges: empty, "abc", 55 bytes (length still fits the block), 56 bytes
    //    (forces a second all-padding block), and a multi-block input. Our authored Rye equals Zig's std.crypto SHA-256 byte-for-byte.
    {
        try ref_parity("");
        try ref_parity("abc");

        var buf55: [55]u8 = undefined;
        var i: u32 = 0;
        while (i < 55) : (i += 1) buf55[i] = @as(u8, @truncate(i));
        try ref_parity(&buf55);

        var buf56: [56]u8 = undefined;
        i = 0;
        while (i < 56) : (i += 1) buf56[i] = @as(u8, @truncate(i));
        try ref_parity(&buf56);

        var multi: [300]u8 = undefined;
        i = 0;
        while (i < 300) : (i += 1) multi[i] = @as(u8, @truncate(i *% 7 +% 1));
        try ref_parity(&multi);
    }

    // 3. The bound refuses an over-long message before any byte is mixed.
    {
        const oversize: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_message_bytes + 1];
        if (hash(oversize)) |_| return error.OversizeSlipped else |err| if (err != error.MessageTooLong) return error.WrongOversize;
    }

    print("GREEN crypto-sha256: SHA-256 authored in pure Rye — Season G's 256-bit hash, the one Tablecloth keys content with, the " ++
        "Mycelium consensus spine places worlds by (SHA-256(domain · world-id · host-pk)), and the constel test network seeds ship " ++
        "identities from (seed = SHA-256(name)). Sixteen big-endian words per 64-byte block expand to a sixty-four-word message " ++
        "schedule and fold through sixty-four rounds of the Ch/Maj/Sigma round function, every add mod 2^32, every rotation and shift " ++
        "a fixed constant, the message padded with a 0x80 marker and a 64-bit big-endian bit length. Parity holds against two " ++
        "references runnable now: the FIPS 180-4 known-answer for \"abc\" AND the empty message match hex for hex, and our authored " ++
        "Rye equals Zig's independent std.crypto SHA-256 byte-for-byte over the empty message, \"abc\", a 55-byte input, a 56-byte " ++
        "input (the edge that forces a second all-padding block), and a 300-byte multi-block input. Monocypher does not ship SHA-256, " ++
        "so this hash is authored from FIPS 180-4 directly, the same way SHA3 was added for Aurora's need. An over-long message " ++
        "refuses MessageTooLong before a byte is mixed. Purely local arithmetic — the primitive calls no std.crypto, no key, no " ++
        "signature, no network, no funds, no real device; constant-time timing-safety stays a separate named horizon. The tree's " ++
        "content-addressing hash now stands in our own Rye, off the standard library.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
