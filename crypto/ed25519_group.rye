//! crypto/ed25519_group.rye — Season G (Cryptography), the seventh rung: the edwards25519 group law authored in pure Rye, composed
//! entirely over the GREEN base field (crypto/fe25519.rye). Ed25519 signing — the Lotus signed carry, Kumara identity, Vault, Comlink —
//! adds a point to itself many times (scalar multiplication) over this curve; that ladder is a composition over exactly two operations,
//! point addition and point doubling, and this file authors both. It adds no new field math (fe25519 proved that) and no scalar ladder yet
//! (that is its own next round); it is the tractable, highest-Lindy move that turns a proven field into a proven group.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-193010_fe25519-the-curve-field-crux.md (the field this stands on) and
//! active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G names Ed25519 as the Lotus unblock, its
//! group arithmetic a composition over the field).
//! Kin: crypto/fe25519.rye (the base field this composes over, GREEN) · crypto/poly1305.rye (the limb-arithmetic sibling). Monocypher
//! (vendor/monocypher, CC0/BSD-dual) is the parity TARGET, never a copied line — our own composition, studied clean-room from the public
//! mathematics of twisted Edwards curves and Monocypher's public API (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX — a point on edwards25519 is carried in extended twisted-Edwards coordinates (X, Y, Z, T) with x = X/Z, y = Y/Z, and
//! T = XY/Z, the representation that makes the group law complete and division-free (Hisil–Wong–Carter–Dawson, 2008; RFC 8032 §5.1). The
//! curve constant is d = −121665/121666 (mod p), derived here in our own field arithmetic rather than copied as a literal, and 2d is the
//! constant the unified addition needs. Point doubling and point addition are each a fixed sequence of field squarings, multiplies, adds,
//! and subtracts — no field element is ever inverted inside the group law; a single inversion appears only when a point is finally
//! compressed to 32 bytes (Y/Z, with the low bit of X/Z carried in the top bit). Negation flips the sign of X and T; subtraction is
//! addition of the negation. Nothing here is a claim about a device; it is arithmetic anyone can replay against RFC 8032.
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device, no identity. A curve point is arithmetic, not a
//! secret and not a signature: this file signs nothing and holds no key (Ed25519's signing with an identity key stays its own separate,
//! gated round; even the scalar-multiplication ladder is a later non-gated round). The primitive calls no std.crypto. Parity is proven at
//! selftest against two references runnable now — algebraic identities anyone can check (the base point compresses to its published
//! encoding, the identity compresses to Y = 1, B + B = 2B, and B + (−B) = the identity), and Zig's own
//! std.crypto.ecc.Edwards25519 as an independent implementation, compared byte-for-byte on the compression of dbl, add, sub, and neg
//! across the base point and several of its multiples. Monocypher-source parity stays the same held-fetch horizon the other primitives
//! carry; constant-time timing-safety stays a separate named horizon (the group law is data-independent by construction).
//!
//! Run from the repository root:
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/ed25519_group.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const fe = @import("fe25519.rye");

pub const ed25519_group_version = "20260815.194500";

/// A point on edwards25519 in extended twisted-Edwards coordinates: x = X/Z, y = Y/Z, and the redundant T = XY/Z that keeps the addition
/// formula complete and inversion-free. Every coordinate is a field element from the proven base field.
pub const Point = struct {
    x: fe.Field,
    y: fe.Field,
    z: fe.Field,
    t: fe.Field,
};

/// The field element 0, as a fresh constant (fe25519 keeps small constructors private, so the group builds its own).
fn fe_zero() fe.Field {
    return fe.Field{ .l = .{ 0, 0, 0, 0, 0 } };
}

/// The field element 1.
fn fe_one() fe.Field {
    return fe.Field{ .l = .{ 1, 0, 0, 0, 0 } };
}

/// Negate a field element — 0 − a. Used for the curve constant and for point negation.
fn fe_neg(a: fe.Field) fe.Field {
    return fe.sub(fe_zero(), a);
}

/// Twice the square of a field element, 2·a² — the one doubled term the point-doubling formula needs.
fn fe_sq2(a: fe.Field) fe.Field {
    const s = fe.square(a);
    return fe.add(s, s);
}

/// The curve constant 2d, where d = −121665/121666 (mod p), computed in our own field arithmetic so no borrowed literal enters the tree.
/// invariant on the callers: both small numerators fit one limb, so the constructed elements are canonical before the inverse.
fn edwards_d2() fe.Field {
    const num = fe.Field{ .l = .{ 121665, 0, 0, 0, 0 } };
    const den = fe.Field{ .l = .{ 121666, 0, 0, 0, 0 } };
    const d = fe.mul(fe_neg(num), fe.invert(den));
    return fe.add(d, d);
}

/// Double a point (RFC 8032 §5.1.4, extended coordinates). A fixed sequence of squarings, adds, and subtracts — no inversion — so the
/// result is another extended-coordinate point on the curve.
pub fn dbl(p: Point) Point {
    const t0 = fe.square(fe.add(p.x, p.y));
    const xx = fe.square(p.x);
    const yy = fe.square(p.y);
    const y = fe.add(yy, xx);
    const z = fe.sub(yy, xx);
    const x = fe.sub(t0, y);
    const t = fe.sub(fe_sq2(p.z), z);
    // invariant: the doubled point keeps the extended-coordinate relation T·Z = X·Y by construction of the four products below.
    const r = Point{ .x = fe.mul(x, t), .y = fe.mul(y, z), .z = fe.mul(z, t), .t = fe.mul(x, y) };
    // invariant: the limbs stay inside the 51-bit radix, so a doubling that left one wide would
    // carry into the next on the following add rather than reduce
    assert(r.x.l[0] <= 0x7ffffffffffff and r.z.l[0] <= 0x7ffffffffffff);
    return r;
}

/// Add two points (RFC 8032 §5.1.4, unified extended-coordinate addition with the 2d constant). Complete for all inputs on the prime-order
/// subgroup — no exceptional case, no inversion — so doubling and addition compose into the scalar ladder its own later round will build.
pub fn add(p: Point, q: Point) Point {
    const a = fe.mul(fe.sub(p.y, p.x), fe.sub(q.y, q.x));
    const b = fe.mul(fe.add(p.x, p.y), fe.add(q.x, q.y));
    const c = fe.mul(fe.mul(p.t, q.t), edwards_d2());
    var d = fe.mul(p.z, q.z);
    d = fe.add(d, d);
    const x = fe.sub(b, a);
    const y = fe.add(b, a);
    const z = fe.add(d, c);
    const t = fe.sub(d, c);
    // invariant: the sum keeps the extended-coordinate relation by construction of the four products below.
    const r = Point{ .x = fe.mul(x, t), .y = fe.mul(y, z), .z = fe.mul(z, t), .t = fe.mul(x, y) };
    // invariant: the limbs stay inside the 51-bit radix, so an addition that left one wide
    // would carry into the next on the following operation rather than reduce
    assert(r.y.l[0] <= 0x7ffffffffffff and r.z.l[0] <= 0x7ffffffffffff);
    return r;
}

/// Negate a point — flip the sign of X and T, keeping Y and Z. The additive inverse: p + neg(p) is the identity.
pub fn neg(p: Point) Point {
    return Point{ .x = fe_neg(p.x), .y = p.y, .z = p.z, .t = fe_neg(p.t) };
}

/// Subtract a point — addition of the negation.
pub fn sub(p: Point, q: Point) Point {
    return add(p, neg(q));
}

/// Compress a point to its 32-byte encoding (RFC 8032 §5.1.2): the little-endian Y/Z with the low bit of X/Z folded into the top bit. The
/// one inversion in the whole group law lives here, at the boundary, exactly as the standard intends.
pub fn to_bytes(p: Point) [32]u8 {
    const zi = fe.invert(p.z);
    var s = fe.to_bytes(fe.mul(p.y, zi));
    const xs = fe.to_bytes(fe.mul(p.x, zi));
    // invariant: the sign bit is a single bit — the parity of X/Z — placed in the top bit of the last byte.
    assert((s[31] & 0x80) == 0);
    s[31] ^= (xs[0] & 1) << 7;
    return s;
}

// ---- selftest ----------------------------------------------------------------------------------------------------------------------

fn bytes_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// Independent reference: Zig's own std.crypto edwards25519, used ONLY inside the selftest as a second implementation to prove our group
/// law matches byte-for-byte. The primitive above never calls it.
const ZEd = std.crypto.ecc.Edwards25519;

/// Copy a Zig point into our representation through the canonical byte form of each coordinate, so parity compares two genuinely
/// independent group laws on the same projective representative.
fn from_zig(zp: ZEd) Point {
    const xb = zp.x.toBytes();
    const yb = zp.y.toBytes();
    const zb = zp.z.toBytes();
    const tb = zp.t.toBytes();
    return Point{ .x = fe.from_bytes(&xb), .y = fe.from_bytes(&yb), .z = fe.from_bytes(&zb), .t = fe.from_bytes(&tb) };
}

fn run_selftest() !u8 {
    const b = ZEd.basePoint;
    const b2 = b.dbl();
    const b3 = b.add(b2);
    const b4 = b2.dbl();
    const b5 = b.add(b4);

    // 1. Algebraic known-answers anyone can check.
    {
        // The base point compresses to its published encoding.
        if (!bytes_eq(&to_bytes(from_zig(b)), &b.toBytes())) return error.BasePointMismatch;

        // The identity compresses to Y = 1 (all-zero bytes but the first).
        var id_b = [_]u8{0} ** 32;
        id_b[0] = 1;
        if (!bytes_eq(&to_bytes(from_zig(ZEd.identityElement)), &id_b)) return error.IdentityMismatch;

        // B + B equals 2B.
        const pb = from_zig(b);
        if (!bytes_eq(&to_bytes(add(pb, pb)), &to_bytes(dbl(pb)))) return error.AddEqualsDoubleMismatch;

        // B + (−B) is the identity.
        if (!bytes_eq(&to_bytes(add(pb, neg(pb))), &id_b)) return error.InverseSumMismatch;
    }

    // 2. Independent-implementation parity: our group law equals Zig's std.crypto.ecc.Edwards25519 byte-for-byte on the compression of
    //    dbl, add, sub, and neg across the base point and several of its multiples.
    {
        const zs = [_]ZEd{ b, b2, b3, b4, b5 };
        const pairs = [_][2]u32{ .{ 0, 1 }, .{ 1, 2 }, .{ 2, 3 }, .{ 3, 0 }, .{ 4, 1 }, .{ 0, 4 } };

        for (zs) |zp| {
            if (!bytes_eq(&to_bytes(dbl(from_zig(zp))), &zp.dbl().toBytes())) return error.RefDblMismatch;
            if (!bytes_eq(&to_bytes(neg(from_zig(zp))), &zp.neg().toBytes())) return error.RefNegMismatch;
        }

        for (pairs) |pr| {
            const za = zs[pr[0]];
            const zb = zs[pr[1]];
            const pa = from_zig(za);
            const pbb = from_zig(zb);
            if (!bytes_eq(&to_bytes(add(pa, pbb)), &za.add(zb).toBytes())) return error.RefAddMismatch;
            if (!bytes_eq(&to_bytes(sub(pa, pbb)), &za.sub(zb).toBytes())) return error.RefSubMismatch;
        }
    }

    print("GREEN crypto-ed25519-group: the edwards25519 group law authored in pure Rye — Season G's seventh rung, composed entirely over " ++
        "the GREEN base field (crypto/fe25519.rye). A point rides in extended twisted-Edwards coordinates (X, Y, Z, T) so addition and " ++
        "doubling are complete and inversion-free; the one inversion lives at compression, where a point becomes the 32-byte Y/Z with the " ++
        "sign of X/Z in the top bit (RFC 8032 §5.1). The curve constant 2d is derived in our own field arithmetic (d = −121665/121666), " ++
        "never a copied literal. The primitive calls no std.crypto. Parity holds against two references runnable now: algebraic " ++
        "known-answers (the base point compresses to its published encoding, the identity to Y = 1, B + B = 2B, and B + (−B) = the " ++
        "identity), and our authored Rye equals Zig's independent std.crypto.ecc.Edwards25519 byte-for-byte on the compression of dbl, " ++
        "add, sub, and neg across the base point and several of its multiples. Monocypher's own group law passes the same mathematics — " ++
        "its vendored source is a held fetch, so Monocypher-source parity is an honest horizon rung. Purely local arithmetic — a curve " ++
        "point is not a secret and not a signature, so no real key, no signing, no network, no funds, no real device; Ed25519's signing " ++
        "with an identity key stays its own separate, gated round, and even the scalar-multiplication ladder is a later non-gated round. " ++
        "The group now stands over the field, and scalar multiplication becomes a composition over dbl and add.\n", .{});
    return 0;
}

pub fn main(init_args: std.process.Init) !u8 {
    _ = init_args;
    return run_selftest();
}
