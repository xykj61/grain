//! crypto/keccak256.rye -- Season G (Cryptography): Keccak-256 authored in pure Rye as a composition over the GREEN Keccak-f[1600] sponge
//! in crypto/sha3.rye. Keccak-256 is the hash the Ethereum world runs on -- an account address is the low twenty bytes of the Keccak-256
//! of an uncompressed secp256k1 public key, an EVM function is dispatched by the first four bytes of the Keccak-256 of its signature, and
//! every EIP-191 / EIP-712 message digest and Merkle-Patricia node name is a Keccak-256. It is NOT SHA3-256: the two share the exact same
//! permutation and pad10*1 rule and differ in one byte -- the domain-separation delimiter is the original Keccak submission's 0x01 rather
//! than FIPS 202's 0x06. Ethereum standardized before FIPS 202 changed that byte, so the whole EVM world kept 0x01.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography - Rye-native, parity-checked, audit-ready). This rung authors NO new
//! cryptography: it composes one already-GREEN stone -- the Keccak-f[1600] permutation and sponge proven in crypto/sha3.rye against FIPS
//! 202 and std.crypto -- and passes it the 0x01 delimiter, so the Ethereum-family hash stands on the same arithmetic the rest of Season G
//! does. This is the sibling that unblocks Ethereum-family address derivation once a secp256k1 rung lands, and it ties straight into the
//! encoding suite (hex today; EIP-55 mixed-case checksum a natural next rung).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G - the crypto parity wave).
//! Kin: crypto/sha3.rye (the SHA3 sibling and the sponge this composes). Clean-room: the 0x01 delimiter and the sponge law are the public
//! Keccak/FIPS 202 standard's own; the arithmetic is our GREEN sha3.rye, never a copied line (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX -- call the proven sponge with rate 136 (the SHA3-256 rate -- Keccak-256 shares it, since rate is set by the 256-bit capacity,
//! not the delimiter) and the 0x01 delimiter instead of 0x06. Every theta-rho-pi-chi-iota round, every absorb, every squeeze is the
//! permutation crypto/sha3.rye already proved on metal; the only difference from SHA3-256 is the single marker byte in the final block.
//!
//! HONEST SCOPE -- software only, purely LOCAL, no key, no network, no funds, no real device. The primitive calls no std.crypto; it stands
//! on our own GREEN sha3.rye. Parity is proven at selftest against two references runnable now -- the canonical Keccak-256 known-answers
//! for the empty message and "abc", and Zig's own std.crypto Keccak256 as an independent implementation, byte-for-byte across the padding
//! edges (the rate-1 length where the 0x01 marker and the 0x80 pad collide into one 0x81 byte, the exact-rate length that forces a whole
//! extra padding block, and multi-block inputs) -- plus the real-world ERC-20 selector Keccak-256("transfer(address,uint256)")[0..4] =
//! 0xa9059cbb, the exact four bytes an Ethereum node dispatches a token transfer on. Constant-time timing-safety stays a separate named
//! horizon (a hash of public data is data-independent by construction; the note lives in crypto/CONSTANT_TIME.md).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/keccak256.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const sha3 = @import("sha3.rye");

pub const keccak256_version = "20260816.000000";

/// Keccak-256's fixed shapes, read from the sibling so there is one source of truth. The digest is 32 bytes; the sponge rate is 136 --
/// the same rate SHA3-256 absorbs at, since the rate is fixed by the 256-bit capacity (rate + capacity = 200 bytes), not by the
/// delimiter that distinguishes Keccak from SHA3.
pub const digest_256: u32 = sha3.digest_256;
pub const rate_256: u32 = sha3.rate_256;

/// The largest message this primitive hashes in one call -- the same generous in-process bound the sibling names, so the two hashes agree
/// on their ceiling.
pub const max_message_bytes: u32 = 1 << 20;

/// The one fault this primitive can raise: a message longer than max_message_bytes, refused before a single byte is absorbed.
pub const Keccak256Error = error{
    /// A message whose length exceeds max_message_bytes -- refused at the edge, before absorption begins.
    MessageTooLong,
};

/// Hash a message to its 32-byte Keccak-256 digest -- the Ethereum-family hash. Composes crypto/sha3.rye's GREEN sponge with the original
/// Keccak 0x01 delimiter; authors no permutation of its own.
pub fn hash256(msg: []const u8) Keccak256Error![digest_256]u8 {
    // invariant: Keccak-256 shares SHA3-256's shapes -- 32-byte digest, 136-byte rate -- and differs only in the sponge delimiter.
    comptime assert(digest_256 == 32 and rate_256 == 136);
    if (msg.len > max_message_bytes) return error.MessageTooLong;
    var out: [digest_256]u8 = undefined;
    sha3.keccak_sponge(rate_256, sha3.keccak_delim, msg, &out);
    return out;
}

/// Render a digest as lowercase hex, for comparison against the standard's own hex form. Bounded to the digest length through a slice.
pub fn to_hex(digest: []const u8, out: []u8) void {
    const alphabet = "0123456789abcdef";
    // invariant: each input byte renders to exactly two hex characters.
    assert(out.len == digest.len * 2);
    var i: u32 = 0;
    const n: u32 = @intCast(digest.len);
    while (i < n) : (i += 1) {
        out[i * 2] = alphabet[digest[i] >> 4];
        out[i * 2 + 1] = alphabet[digest[i] & 0x0f];
    }
}

// The canonical Keccak-256 known-answers -- the neutral public references our composition must reproduce, hex for hex. These are the
// original Keccak vectors (0x01 delimiter), distinct from the FIPS 202 SHA3-256 digests of the same inputs.
const kat_empty = "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470";
const kat_abc = "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45";

// The real-world ERC-20 selector: the first four bytes of Keccak-256("transfer(address,uint256)") are the exact bytes an Ethereum node
// dispatches a token transfer on. A published, load-bearing value anyone with an EVM can replay.
const erc20_transfer_sig = "transfer(address,uint256)";
const erc20_transfer_selector = "a9059cbb";

/// Independent reference: Zig's own std.crypto Keccak256, used ONLY inside the selftest as a second implementation to prove our
/// composition matches byte-for-byte. The primitives above never call this.
fn ref_keccak256(msg: []const u8) [digest_256]u8 {
    var out: [digest_256]u8 = undefined;
    std.crypto.hash.sha3.Keccak256.hash(msg, &out, .{});
    return out;
}

fn hex_eq(got: []const u8, want: []const u8) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    const n: u32 = @intCast(got.len);
    while (i < n) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn bytes_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    const n: u32 = @intCast(a.len);
    while (i < n) : (i += 1) if (a[i] != b[i]) return false;
    return true;
}

fn parity(msg: []const u8) !void {
    const ours = try hash256(msg);
    if (!bytes_eq(&ours, &ref_keccak256(msg))) return error.RefMismatch;
}

fn run_selftest() !u8 {
    // 1. The canonical Keccak-256 known-answers: the empty message and "abc" equal the published digests, hex for hex. These differ from
    //    SHA3-256 of the same inputs -- proof the 0x01 delimiter is carried, not 0x06.
    {
        const a = try hash256("");
        var ah: [digest_256 * 2]u8 = undefined;
        to_hex(&a, &ah);
        if (!hex_eq(&ah, kat_empty)) return error.KatEmptyMismatch;

        const b = try hash256("abc");
        to_hex(&b, &ah);
        if (!hex_eq(&ah, kat_abc)) return error.KatAbcMismatch;
    }

    // 2. Independent-implementation parity across the padding edges (rate 136): the empty message, "abc", 135 bytes (the rate-1 edge where
    //    the 0x01 marker and the 0x80 pad collide into one 0x81 byte), 136 bytes (a full block forcing a whole extra padding block), 137
    //    bytes, and a 400-byte multi-block input -- our authored composition equals Zig's std.crypto Keccak256 byte-for-byte at each.
    {
        try parity("");
        try parity("abc");

        const lengths = [_]u32{ 135, 136, 137, 400 };
        for (lengths) |len| {
            var buf: [400]u8 = undefined;
            var i: u32 = 0;
            while (i < len) : (i += 1) buf[i] = @truncate(i *% 7 +% 1);
            try parity(buf[0..len]);
        }
    }

    // 3. The real-world ERC-20 selector: Keccak-256("transfer(address,uint256)")[0..4] == 0xa9059cbb, the exact four bytes an Ethereum
    //    node dispatches a token transfer on -- a published, load-bearing value that proves this hash is fit for EVM use.
    {
        const d = try hash256(erc20_transfer_sig);
        var sel: [8]u8 = undefined;
        to_hex(d[0..4], &sel);
        if (!hex_eq(&sel, erc20_transfer_selector)) return error.SelectorMismatch;
    }

    // 4. The bound refuses an over-long message before any byte is absorbed.
    {
        const oversize: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_message_bytes + 1];
        if (hash256(oversize)) |_| return error.OversizeSlipped else |err| if (err != error.MessageTooLong) return error.WrongOversize;
    }

    print("GREEN crypto-keccak256: Keccak-256 authored in pure Rye as a composition over the GREEN Keccak-f[1600] sponge in crypto/sha3.rye " ++
        "— the Ethereum-family hash. An account address is the low twenty bytes of the Keccak-256 of a public key, an EVM function is " ++
        "dispatched by the first four bytes of the Keccak-256 of its signature, and every EIP-191/712 digest is a Keccak-256. It is NOT " ++
        "SHA3-256: the two share the exact permutation and pad10*1 rule and differ in one byte — the original Keccak 0x01 delimiter rather " ++
        "than FIPS 202's 0x06, since Ethereum standardized before that byte changed. This rung authors no new cryptography: it passes the " ++
        "0x01 delimiter to the sponge crypto/sha3.rye already proved on metal. Parity holds against two references runnable now: the " ++
        "canonical Keccak-256 known-answers for the empty message AND \"abc\" match hex for hex (distinct from SHA3-256 of the same inputs, " ++
        "proof the 0x01 marker is carried), and our composition equals Zig's independent std.crypto Keccak256 byte-for-byte across the " ++
        "padding edges — the rate-1 length where the marker and the pad collide into one 0x81 byte, the exact-rate extra-block edge, and " ++
        "multi-block inputs. The real-world ERC-20 selector Keccak-256(\"transfer(address,uint256)\")[0..4] resolves to 0xa9059cbb, the " ++
        "exact four bytes an Ethereum node dispatches a token transfer on. An over-long message refuses MessageTooLong before a byte is " ++
        "absorbed. Purely local arithmetic — no std.crypto in the primitive, no key, no network, no funds, no real device; constant-time " ++
        "timing-safety stays a separate named horizon. Season G's Ethereum-family hash now stands beside its SHA3 sibling.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
