//! crypto/hkdf_sha512.rye — Season G (Cryptography), a key-derivation rung: HKDF-SHA-512 (RFC 5869) authored in pure Rye. HKDF is the
//! standard "turn one shared secret into as many independent keys as a protocol needs" primitive — the extract-then-expand key
//! derivation function every modern handshake, sealed box, and vault key schedule stands on. It authors no new cryptography: it composes
//! the GREEN crypto/hmac_sha512.rye through RFC 5869's own two steps, so it is buildable this round and provable against an independent
//! reference and against the RFC-4231-anchored HMAC beneath it.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G · the crypto parity wave).
//! Kin: crypto/hmac_sha512.rye (the keyed hash beneath it, GREEN on metal) · crypto/sha512.rye (the hash beneath that). Monocypher
//! (vendor/monocypher, CC0/BSD-dual) is the parity DISCIPLINE target — our own Rye, studied clean-room from the public standards
//! (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX — RFC 5869's two steps, both HMAC and nothing more:
//!   extract(salt, ikm) = HMAC(salt, ikm) → PRK, a 64-byte pseudorandom key (an absent salt is HashLen zero bytes).
//!   expand(PRK, info, L) = the first L bytes of T(1) ‖ T(2) ‖ … where T(0) is empty and
//!                          T(i) = HMAC(PRK, T(i-1) ‖ info ‖ byte(i)), i counting up from 1, at most 255 blocks.
//! No new mathematics — only the RFC's composition over a MAC a lower rung already proved. The same salt, ikm, info, and length always
//! fold to the same key material anyone can replay against an independent HKDF.
//!
//! HONEST SCOPE — software only, purely LOCAL, TEST inputs, no real identity key, no network, no funds, no real device. The module calls
//! no std.crypto in the primitive. RFC 5869 publishes its known-answer vectors over SHA-256 and SHA-1 rather than SHA-512, so this
//! SHA-512 instantiation is proven at selftest against two references runnable now: Zig's own std.crypto HKDF-SHA-512 as an independent
//! implementation, byte-for-byte across the RFC's three input shapes (salt + info, longer inputs, and zero-length salt + info); AND the
//! RFC-4231-anchored HMAC beneath it — extract(salt, ikm) reproduces crypto/hmac_sha512.rye's mac(ikm, salt) exactly, and the first
//! expand block reproduces mac(info ‖ 0x01, prk), so both HKDF steps tie transitively back to the published HMAC known-answer. Constant
//! -time discipline is the HMAC layer's named horizon; HKDF derives keys and returns them.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/hkdf_sha512.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const sha512 = @import("sha512.rye");
const hmac = @import("hmac_sha512.rye");

pub const hkdf_sha512_version = "20260816.000000";

/// HKDF-SHA-512's fixed shapes, inherited from the HMAC beneath so a single source of truth names them. prk_len is the 64-byte
/// pseudorandom key extract produces and expand keys on; block_len is the same 64-byte HMAC-SHA-512 output width each T(i) block carries.
pub const prk_len: u32 = hmac.tag_len;
pub const block_len: u32 = hmac.tag_len;

/// The largest inputs this primitive accepts, each refused at the edge before a byte is mixed. HKDF's real uses — a handshake secret, a
/// salt, a short context label — sit far below these; the bounds are named so every buffer beneath cites a ceiling, and so each HMAC
/// call the composition makes stays provably within crypto/hmac_sha512.rye's own message and key bounds.
pub const max_ikm_bytes: u32 = 1 << 12;
pub const max_salt_bytes: u32 = 1 << 12;
pub const max_info_bytes: u32 = 1 << 12;

/// The largest key material one expand call yields: RFC 5869 caps expansion at 255 blocks of HashLen, so 255 · 64 = 16320 bytes is the
/// standard's own ceiling, named here so the counter can never overflow a single byte and the output buffer cites a bound.
pub const max_okm_bytes: u32 = 255 * block_len;

/// The three faults this primitive can raise, each refused at the edge before a byte is mixed.
pub const HkdfError = error{
    /// An ikm longer than max_ikm_bytes — refused before extract mixes it.
    IkmTooLong,
    /// A salt longer than max_salt_bytes — refused before extract keys on it.
    SaltTooLong,
    /// An info longer than max_info_bytes — refused before expand mixes it.
    InfoTooLong,
    /// A requested output longer than max_okm_bytes (RFC 5869's 255-block cap) — refused before expand fills a byte.
    OutputTooLong,
};

/// RFC 5869 step 1 — extract(salt, ikm) = HMAC-SHA-512(salt, ikm), producing the 64-byte pseudorandom key PRK. An empty salt becomes
/// HashLen zero bytes, exactly as the standard directs, so a caller with no salt still keys the HMAC on a defined block.
pub fn extract(salt: []const u8, ikm: []const u8) HkdfError![prk_len]u8 {
    // invariant: PRK is exactly the HMAC output width, proven at compile time — HKDF keys expand on this whole block.
    comptime assert(prk_len == 64 and block_len == 64);
    // invariant: the salt fits the named bound, so it stays within HMAC's own key bound and its mac call cannot fault below.
    if (salt.len > max_salt_bytes) return error.SaltTooLong;
    // invariant: the ikm fits the named bound, so it stays within HMAC's own message bound and its mac call cannot fault below.
    if (ikm.len > max_ikm_bytes) return error.IkmTooLong;

    if (salt.len == 0) {
        // No salt: RFC 5869 keys the extract HMAC on HashLen zero bytes. This buffer is that defined salt.
        const zero_salt = [_]u8{0} ** prk_len;
        // The bounds above put both inputs within HMAC's message and key bounds, so this mac cannot fault — asserted, not swallowed.
        return hmac.mac(ikm, &zero_salt) catch unreachable;
    }
    // The salt keys the HMAC, the ikm is its message — extract is exactly one HMAC, provably within bounds, so it cannot fault.
    return hmac.mac(ikm, salt) catch unreachable;
}

/// RFC 5869 step 2 — expand(PRK, info, L) fills out with the first out.len bytes of T(1) ‖ T(2) ‖ …, where T(0) is empty and
/// T(i) = HMAC(PRK, T(i-1) ‖ info ‖ byte(i)). The counter runs from 1, at most 255 blocks, so the byte(i) tag never overflows.
pub fn expand(out: []u8, prk: [prk_len]u8, info: []const u8) HkdfError!void {
    // invariant: the info fits the named bound, so each T(i) HMAC message (block + info + 1) stays within HMAC's own message bound.
    if (info.len > max_info_bytes) return error.InfoTooLong;
    // invariant: the request fits RFC 5869's 255-block cap, so the block counter stays a single byte and never overflows.
    if (out.len > max_okm_bytes) return error.OutputTooLong;

    const ilen: u32 = @intCast(info.len);
    // invariant: the info-length cast lost nothing — it is bounded by max_info_bytes above.
    assert(ilen <= max_info_bytes);

    // The HMAC message for each block: the previous block (0 bytes on the first, 64 after), then info, then the one counter byte.
    var msg: [block_len + max_info_bytes + 1]u8 = undefined;
    var t_prev: [block_len]u8 = undefined;
    var t_prev_len: u32 = 0;

    var done: u32 = 0;
    var i: u32 = 1;
    const total: u32 = @intCast(out.len);
    // invariant: the output-length cast lost nothing — it is bounded by max_okm_bytes above.
    assert(total == out.len);

    while (done < total) : (i += 1) {
        // invariant: RFC 5869 forbids more than 255 blocks; the output bound above guarantees it, and this asserts it before the cast.
        assert(i >= 1 and i <= 255);

        var p: u32 = 0;
        var k: u32 = 0;
        while (k < t_prev_len) : (k += 1) {
            msg[p] = t_prev[k];
            p += 1;
        }
        k = 0;
        while (k < ilen) : (k += 1) {
            msg[p] = info[k];
            p += 1;
        }
        msg[p] = @as(u8, @intCast(i));
        p += 1;

        // invariant: the block message is (T-prev ‖ info ‖ counter), at most block + info + 1 bytes, within HMAC's message bound; its
        // mac cannot fault, so the error is unreachable and asserted rather than swallowed.
        const t = hmac.mac(msg[0..p], &prk) catch unreachable;

        // Copy this block into the output: a whole 64-byte block, or the final partial tail that finishes the request.
        const remain: u32 = total - done;
        const take: u32 = if (remain < block_len) remain else block_len;
        var c: u32 = 0;
        while (c < take) : (c += 1) out[done + c] = t[c];
        done += take;

        // This block becomes the previous block for the next round; after the first block t_prev_len is a whole 64-byte block.
        t_prev = t;
        t_prev_len = block_len;
    }
    // invariant: the loop fills exactly the requested length, no more and no less.
    assert(done == total);
}

/// One-shot HKDF: extract then expand, RFC 5869's whole "one secret in, keyed material out" arc in a single call.
pub fn hkdf(out: []u8, salt: []const u8, ikm: []const u8, info: []const u8) HkdfError!void {
    const prk = try extract(salt, ikm);
    try expand(out, prk, info);
}

/// Independent reference: Zig's own std.crypto HKDF-SHA-512, used ONLY inside the selftest as a second implementation to prove our
/// authored composition matches byte-for-byte. The primitive above never calls this.
fn ref_extract(salt: []const u8, ikm: []const u8) [prk_len]u8 {
    return std.crypto.kdf.hkdf.HkdfSha512.extract(salt, ikm);
}

fn ref_expand(out: []u8, info: []const u8, prk: [prk_len]u8) void {
    std.crypto.kdf.hkdf.HkdfSha512.expand(out, info, prk);
}

fn block_eq(a: [prk_len]u8, b: [prk_len]u8) bool {
    var i: u32 = 0;
    while (i < prk_len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn slice_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// Prove our authored HKDF equals Zig's independent std.crypto HKDF-SHA-512 for one (salt, ikm, info, length) shape, byte-for-byte,
/// across both steps and the one-shot arc.
fn ref_parity(salt: []const u8, ikm: []const u8, info: []const u8, out: []u8, ref_out: []u8) !void {
    // invariant: the two output buffers are the same length, so a byte-for-byte compare is meaningful.
    assert(out.len == ref_out.len);

    const prk = try extract(salt, ikm);
    if (!block_eq(prk, ref_extract(salt, ikm))) return error.ExtractMismatch;

    try expand(out, prk, info);
    ref_expand(ref_out, info, ref_extract(salt, ikm));
    if (!slice_eq(out, ref_out)) return error.ExpandMismatch;
}

fn run_selftest() !u8 {
    // 1. HKDF-extract ties transitively back to the RFC 4231-anchored HMAC: extract(salt, ikm) is exactly HMAC(salt, ikm), and an empty
    //    salt keys the HMAC on HashLen zeros — both reproduced against the already-GREEN crypto/hmac_sha512.rye.
    {
        const salt = "hkdf salt bytes";
        const ikm = "input keying material";
        const prk = try extract(salt, ikm);
        const via_hmac = try hmac.mac(ikm, salt);
        if (!block_eq(prk, via_hmac)) return error.ExtractNotHmac;

        const zero_salt = [_]u8{0} ** prk_len;
        const prk0 = try extract("", ikm);
        const via_hmac0 = try hmac.mac(ikm, &zero_salt);
        if (!block_eq(prk0, via_hmac0)) return error.EmptySaltNotHmac;
    }

    // 2. The first expand block ties back to the same HMAC: T(1) = HMAC(PRK, info ‖ 0x01), so a request shorter than one block is a
    //    prefix of that HMAC tag under the RFC-4231-anchored primitive.
    {
        const prk = try extract("s", "k");
        const info = "context label";
        var first: [40]u8 = undefined;
        try expand(&first, prk, info);

        var t1_msg: [max_info_bytes + 1]u8 = undefined;
        var i: u32 = 0;
        while (i < info.len) : (i += 1) t1_msg[i] = info[i];
        t1_msg[info.len] = 0x01;
        const t1 = try hmac.mac(t1_msg[0 .. info.len + 1], &prk);
        if (!slice_eq(first[0..], t1[0..40])) return error.FirstBlockNotHmac;
    }

    // 3. Independent-implementation parity across RFC 5869's three input shapes, byte-for-byte against Zig's std.crypto HKDF-SHA-512:
    //    a with-salt-and-info case, a longer-inputs case spanning several blocks, and a zero-length-salt-and-info case.
    {
        // Shape A — RFC 5869 Test Case 1 structure (short salt, short info), 42 output bytes.
        {
            var out: [42]u8 = undefined;
            var ref: [42]u8 = undefined;
            try ref_parity("\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c", "\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", "\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9", &out, &ref);
        }
        // Shape B — RFC 5869 Test Case 2 structure (longer salt, info, and ikm), 82 output bytes spanning several blocks.
        {
            var ikm: [80]u8 = undefined;
            var salt: [80]u8 = undefined;
            var info: [80]u8 = undefined;
            var j: u32 = 0;
            while (j < 80) : (j += 1) {
                ikm[j] = @as(u8, @truncate(j));
                salt[j] = @as(u8, @truncate(0x60 + j));
                info[j] = @as(u8, @truncate(0xb0 + j));
            }
            var out: [82]u8 = undefined;
            var ref: [82]u8 = undefined;
            try ref_parity(&salt, &ikm, &info, &out, &ref);
        }
        // Shape C — RFC 5869 Test Case 3 structure (zero-length salt and info), 42 output bytes.
        {
            var out: [42]u8 = undefined;
            var ref: [42]u8 = undefined;
            try ref_parity("", "\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b", "", &out, &ref);
        }
        // Shape D — a full-length request at RFC 5869's 255-block ceiling, to prove the counter walks every block and the tail lands.
        {
            var out: [max_okm_bytes]u8 = undefined;
            var ref: [max_okm_bytes]u8 = undefined;
            try ref_parity("ceiling salt", "ceiling ikm", "ceiling info", &out, &ref);
        }
    }

    // 4. The bounds refuse over-long inputs and an over-long request before a byte is mixed.
    {
        const prk = try extract("s", "k");
        var small: [8]u8 = undefined;

        const oversize_info: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_info_bytes + 1];
        if (expand(&small, prk, oversize_info)) |_| return error.OversizeInfoSlipped else |err| if (err != error.InfoTooLong) return error.WrongOversizeInfo;

        const oversize_salt: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_salt_bytes + 1];
        if (extract(oversize_salt, "k")) |_| return error.OversizeSaltSlipped else |err| if (err != error.SaltTooLong) return error.WrongOversizeSalt;

        const oversize_ikm: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_ikm_bytes + 1];
        if (extract("s", oversize_ikm)) |_| return error.OversizeIkmSlipped else |err| if (err != error.IkmTooLong) return error.WrongOversizeIkm;

        const oversize_out: []u8 = @as([*]u8, @ptrFromInt(0x1000))[0 .. max_okm_bytes + 1];
        if (expand(oversize_out, prk, "i")) |_| return error.OversizeOutSlipped else |err| if (err != error.OutputTooLong) return error.WrongOversizeOut;
    }

    print("GREEN crypto-hkdf-sha512: HKDF-SHA-512 authored in pure Rye — Season G's key-derivation rung (RFC 5869), the extract-then" ++
        "-expand key schedule every handshake, sealed box, and vault key ladder stands on. It composes the GREEN crypto/hmac_sha512.rye " ++
        "through the RFC's own two steps: extract(salt, ikm) = HMAC(salt, ikm) yields the 64-byte PRK (an empty salt keyed on HashLen " ++
        "zeros), and expand(PRK, info, L) walks T(i) = HMAC(PRK, T(i-1) ‖ info ‖ byte(i)) up to 255 blocks and returns the first L bytes " ++
        "— no new cryptography, only the RFC's composition over a MAC a lower rung already proved. RFC 5869 publishes its known-answers " ++
        "over SHA-256 and SHA-1, so this SHA-512 instantiation is proven against two references runnable now: Zig's independent std." ++
        "crypto HKDF-SHA-512 byte-for-byte across the RFC's salt-and-info, longer-inputs, and zero-salt-and-info shapes plus a full " ++
        "255-block request, AND the RFC-4231-anchored HMAC beneath — extract reproduces mac(ikm, salt) exactly and the first expand " ++
        "block reproduces mac(info ‖ 0x01, prk), tying both steps transitively back to the published HMAC known-answer. An over-long " ++
        "info, salt, ikm, or request refuses its named error before a byte is mixed. Purely local — TEST inputs, no real identity key, " ++
        "no network, no funds, no real device; constant-time discipline stays the HMAC layer's named horizon. Every module that will " ++
        "ever derive a key now has its RFC 5869 stone.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
