//! crypto/eip155_tx.rye — the EIP-155 legacy Ethereum transaction digest, authored in pure Rye as a COMPOSITION over stones already GREEN in
//! this tree: the Recursive Length Prefix serialization (encoding/rlp.rye), the Keccak-256 hash (crypto/keccak256.rye), the secp256k1 public-key
//! recovery (crypto/secp256k1_ecrecover.rye), and the Ethereum address derivation (crypto/eth_address.rye). It authors NO new cryptography and
//! no new serialization — only the one small assembly the Ethereum world performs before every send: lay the transaction's fields out as an RLP
//! list, hash that list with Keccak-256, and you hold the exact 32 bytes a wallet signs. Recover the signature back through ecrecover and you
//! hold the sender. This is the rung the RLP module named next — "a signed transaction is the keccak256 of the RLP of its fields, recovered back
//! to its sender's address" — made concrete against Ethereum's own published example.
//!
//! Season: crypto (Season G · Cryptography), the seventh composition on the shelf, beside eth_address, eth_personal_sign, and eip712. Where
//! eip712 hashes a TREE of typed fields for an off-chain "sign this typed data," eip155_tx hashes the FLAT nine-field list of an on-chain
//! transaction — the two shapes a key is ever asked to sign. Both stand entirely on the same GREEN Keccak-256, ecrecover, and eth_address.
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (the Rye-first spine that seats Season G).
//! Clean-room: the rules are EIP-155 and the Ethereum Yellow Paper; the arithmetic is ours (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX — EIP-155 replay protection, stated positively. A pre-155 legacy transaction signs the RLP of six fields
//! [nonce, gasPrice, gas, to, value, data] and carries v = 27 or 28. EIP-155 folds the chain id into the signed preimage: the SIGNING list is
//! nine fields [nonce, gasPrice, gas, to, value, data, chainId, 0, 0], its Keccak-256 is the sighash, and the final v = recovery_id + 2*chainId
//! + 35 — so a signature valid on one chain can never replay on another, because the chain id is inside the very bytes that were hashed. The
//! SIGNED transaction that goes on the wire replaces the last three fields with the real [v, r, s]. This module builds the signing sighash from
//! the fields, and recovers the sender from (sighash, r, s, v) — the two halves of "who signed this transaction, and for which chain."
//!
//! HONEST SCOPE — software only, purely LOCAL, no key, no network, no funds, no real device. This module NEVER signs: signing needs a secret
//! scalar, and signing with the maintainer's own identity key is the custody gate that stays the maintainer's hand. It builds the public preimage
//! and recovers from a published signature, both of which touch no secret. Parity is proven three ways anyone can replay: (1) a PUBLISHED
//! known-answer bound to the world — the EIP-155 specification's own canonical example transaction (nonce 9, 20 gwei, 21000 gas, to 0x3535…35,
//! 1 ETH, chain id 1) hashes byte-for-byte to the spec's stated sighash 0xdaf5a779…4c8e53; (2) a RECOVERY against that same example — the spec's
//! published (v=37, r, s) recovers through our GREEN ecrecover to exactly the example's published sender 0x9d8a62f6…855a4f, the address of the
//! spec's test key 0x4646…46, so a one-bit encoding error anywhere would break the recovery; and (3) an INDEPENDENT construction — the same
//! sighash built a second time with Zig's own std.crypto Keccak-256 over the identical RLP bytes, byte-for-byte equal to our GREEN path.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/eip155_tx.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const rlp = @import("encoding_rlp.rye");
const keccak = @import("keccak256.rye");
const ecr = @import("secp256k1_ecrecover.rye");
const eth = @import("eth_address.rye");

pub const eip155_tx_version = "20260816.100000";

/// The Keccak-256 digest width and the Ethereum address width, re-exported from the stones this file composes so a caller names one door.
pub const digest_bytes: u32 = keccak.digest_256; // 32
pub const address_bytes: u32 = eth.address_bytes; // 20

/// The number of fields in a legacy transaction's signing and signed lists. EIP-155 fixes both at nine: the signing list ends in
/// [chainId, 0, 0], the signed list ends in [v, r, s]. Named so every field walk cites its bound.
pub const tx_fields: u32 = 9;

/// The largest RLP-encoded transaction preimage this module hashes. A legacy transaction is small — nine fields, a twenty-byte address, two
/// thirty-two-byte scalars, and a data payload — yet the ceiling is stated generously and explicitly, the TAME reflex that a buffer names its
/// maximum before it is filled. Well inside Keccak-256's own million-byte message bound.
pub const max_tx_bytes: u32 = 1 << 16;

/// The faults this module can raise, each refused at the edge before a partial or dishonest result escapes. Composed with the errors of the
/// stones underneath so a caller handles one set.
pub const Eip155Error = error{
    /// A signing or signed field list that is not exactly tx_fields items.
    BadFieldCount,
    /// A v value below 27 — not a legacy recovery id (27/28) nor an EIP-155 v (>= 35).
    BadV,
    /// An r or s that is not exactly thirty-two bytes.
    BadScalarLength,
} || rlp.RlpError || keccak.Keccak256Error || ecr.RecoverError || eth.EthAddressError;

/// The Keccak-256 sighash of a legacy transaction's SIGNING list — the exact thirty-two bytes a wallet signs. The caller hands the nine signing
/// fields as RLP items ([nonce, gasPrice, gas, to, value, data, chainId, empty, empty] for EIP-155, or the six-field pre-155 form padded by the
/// caller); this lays them out as one RLP list and hashes it. Composes encoding/rlp.rye and crypto/keccak256.rye, authoring neither.
pub fn signing_sighash(signing_fields: []const rlp.Item) Eip155Error![digest_bytes]u8 {
    // invariant: an EIP-155 signing list is exactly nine fields; a malformed list is refused before a byte is hashed.
    if (signing_fields.len != tx_fields) return error.BadFieldCount;

    var buf: [max_tx_bytes]u8 = undefined;
    const encoded = try rlp.encode_item(&buf, rlp.Item{ .list = signing_fields }, 0);
    // invariant: the RLP frame fit the named ceiling and Keccak-256's own message bound, so the hash below cannot overflow either.
    assert(encoded.len <= max_tx_bytes);
    return try keccak.hash256(encoded);
}

/// What a v byte reveals: the recovery id (0 or 1) the signature carries, and the chain id it was bound to (0 for a pre-155 signature). EIP-155
/// packs both into v = recovery_id + 2*chainId + 35; the pre-155 forms 27 and 28 carry recovery id v-27 and chain id 0.
pub const VParts = struct {
    recovery_id: u8,
    chain_id: u64,
};

/// Split a transaction's v into its recovery id and chain id. v = 27 or 28 is the pre-155 form (chain id 0); v >= 35 is EIP-155
/// (chainId = (v - 35) / 2, recovery_id = (v - 35) & 1). A v below 27 is not a legacy signature and is refused.
pub fn v_parts(v: u64) Eip155Error!VParts {
    // invariant: a legacy v is 27, 28, or an EIP-155 value at least 35 — nothing below 27 is a valid recovery byte.
    if (v < 27) return error.BadV;
    if (v == 27 or v == 28) {
        const rid: u8 = @intCast(v - 27);
        // invariant: the pre-155 recovery id is exactly 0 or 1.
        assert(rid <= 1);
        return VParts{ .recovery_id = rid, .chain_id = 0 };
    }
    // invariant: an EIP-155 v is at least 35, so v - 35 does not underflow.
    if (v < 35) return error.BadV;
    const base = v - 35;
    const rid: u8 = @intCast(base & 1);
    // invariant: the recovery id extracted from v is exactly 0 or 1.
    assert(rid <= 1);
    return VParts{ .recovery_id = rid, .chain_id = base >> 1 };
}

/// Recover the twenty-byte sender address from a legacy transaction's sighash and its signature scalars. recovery_id is v_parts(v).recovery_id.
/// Composes crypto/secp256k1_ecrecover.rye (public-key recovery from public data) and crypto/eth_address.rye (Keccak-256 of the key, low twenty
/// bytes) — touching no secret scalar, exactly as an Ethereum node does when it credits a transaction's gas to its sender.
pub fn recover_sender(
    sighash: []const u8,
    r_be: []const u8,
    s_be: []const u8,
    recovery_id: u8,
) Eip155Error![address_bytes]u8 {
    // invariant: the sighash is exactly thirty-two bytes and each scalar exactly thirty-two — refused otherwise before recovery.
    if (sighash.len != digest_bytes) return error.BadScalarLength;
    if (r_be.len != 32 or s_be.len != 32) return error.BadScalarLength;

    var z: [32]u8 = undefined;
    var r_fixed: [32]u8 = undefined;
    var s_fixed: [32]u8 = undefined;
    var i: u32 = 0;
    while (i < 32) : (i += 1) {
        // invariant: each of the three thirty-two-byte inputs fills its fixed array whole.
        assert(i < digest_bytes);
        z[i] = sighash[i];
        r_fixed[i] = r_be[i];
        s_fixed[i] = s_be[i];
    }

    const q = try ecr.recover(&z, &r_fixed, &s_fixed, recovery_id);

    // Pack the recovered key as the sixty-four-byte uncompressed body (x ‖ y) the address derivation expects.
    var pub64: [eth.pubkey_bytes]u8 = undefined;
    // invariant: the packed body is exactly the two thirty-two-byte coordinates, filling the sixty-four-byte public-key width.
    comptime assert(eth.pubkey_bytes == 64);
    i = 0;
    while (i < 32) : (i += 1) {
        pub64[i] = q.qx[i];
        pub64[32 + i] = q.qy[i];
    }
    return eth.address_from_pubkey(&pub64);
}

/// Zig's own Keccak-256, used ONLY inside the selftest as a second, independent construction of the sighash; the primitive above never calls
/// it. A different implementation hashing the identical RLP bytes cross-checks this file's composition over crypto/keccak256.rye.
const ZKeccak = std.crypto.hash.sha3.Keccak256;

fn slice_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn run_selftest() !u8 {
    // The EIP-155 specification's own canonical example transaction, field for field. Test key 0x4646…46, chain id 1.
    const to = [_]u8{0x35} ** 20; // to = 0x3535353535353535353535353535353535353535
    const gas_price = [_]u8{ 0x04, 0xa8, 0x17, 0xc8, 0x00 }; // 20 gwei = 20e9
    const gas = [_]u8{ 0x52, 0x08 }; // 21000
    const value = [_]u8{ 0x0d, 0xe0, 0xb6, 0xb3, 0xa7, 0x64, 0x00, 0x00 }; // 1 ETH = 1e18 wei

    // The nine SIGNING fields: [nonce, gasPrice, gas, to, value, data, chainId, 0, 0]. The two trailing empties are RLP empty strings, exactly
    // as EIP-155 specifies — the chain id folded into the preimage, then two zero placeholders where r and s will later go.
    const signing_fields = [_]rlp.Item{
        rlp.Item{ .str = &[_]u8{0x09} }, // nonce 9
        rlp.Item{ .str = &gas_price }, // gasPrice 20e9
        rlp.Item{ .str = &gas }, // gas 21000
        rlp.Item{ .str = &to }, // to (20-byte address)
        rlp.Item{ .str = &value }, // value 1e18 wei
        rlp.Item{ .str = "" }, // data (empty)
        rlp.Item{ .str = &[_]u8{0x01} }, // chainId 1
        rlp.Item{ .str = "" }, // 0 placeholder
        rlp.Item{ .str = "" }, // 0 placeholder
    };

    // 1. Published known-answer: the sighash of the signing list equals EIP-155's own stated value, byte-for-byte.
    const sighash = try signing_sighash(&signing_fields);
    const sighash_want = [_]u8{
        0xda, 0xf5, 0xa7, 0x79, 0xae, 0x97, 0x2f, 0x97, 0x21, 0x97, 0x30, 0x3d, 0x7b, 0x57, 0x47, 0x46,
        0xc7, 0xef, 0x83, 0xea, 0xda, 0xc0, 0xf2, 0x79, 0x1a, 0xd2, 0x3d, 0xb9, 0x2e, 0x4c, 0x8e, 0x53,
    };
    if (!slice_eq(&sighash, &sighash_want)) return error.SighashMismatch;

    // 2. Independent construction: the identical RLP preimage hashed by Zig's own Keccak-256 gives the same sighash. A different implementation,
    //    the same bytes, the same digest — so the parity rests on two independent Keccak paths, not one.
    {
        var buf: [max_tx_bytes]u8 = undefined;
        const encoded = try rlp.encode_item(&buf, rlp.Item{ .list = &signing_fields }, 0);
        var zsig: [32]u8 = undefined;
        var zh = ZKeccak.init(.{});
        zh.update(encoded);
        zh.final(&zsig);
        if (!slice_eq(&zsig, &sighash_want)) return error.IndependentKeccakMismatch;
    }

    // 3. Recovery against the published signature: EIP-155's own (v=37, r, s) recovers to the example's published sender. v = 37 splits to
    //    recovery id 0 and chain id 1 — the same chain id folded into the signed preimage above, a cross-check the two halves agree.
    const v: u64 = 37;
    const parts = try v_parts(v);
    if (parts.recovery_id != 0) return error.RecoveryIdMismatch;
    if (parts.chain_id != 1) return error.ChainIdMismatch;

    const r = [_]u8{
        0x28, 0xef, 0x61, 0x34, 0x0b, 0xd9, 0x39, 0xbc, 0x21, 0x95, 0xfe, 0x53, 0x75, 0x67, 0x86, 0x60,
        0x03, 0xe1, 0xa1, 0x5d, 0x3c, 0x71, 0xff, 0x63, 0xe1, 0x59, 0x06, 0x20, 0xaa, 0x63, 0x62, 0x76,
    };
    const s = [_]u8{
        0x67, 0xcb, 0xe9, 0xd8, 0x99, 0x7f, 0x76, 0x1a, 0xec, 0xb7, 0x03, 0x30, 0x4b, 0x38, 0x00, 0xcc,
        0xf5, 0x55, 0xc9, 0xf3, 0xdc, 0x64, 0x21, 0x4b, 0x29, 0x7f, 0xb1, 0x96, 0x6a, 0x3b, 0x6d, 0x83,
    };
    const sender = try recover_sender(&sighash, &r, &s, parts.recovery_id);
    // The address of the EIP-155 example's test key 0x4646…46.
    const sender_want = [_]u8{
        0x9d, 0x8a, 0x62, 0xf6, 0x56, 0xa8, 0xd1, 0x61, 0x5c, 0x12,
        0x94, 0xfd, 0x71, 0xe9, 0xcf, 0xb3, 0xe4, 0x85, 0x5a, 0x4f,
    };
    if (!slice_eq(&sender, &sender_want)) return error.SenderMismatch;

    // 4. The SIGNED transaction on the wire — the same nine fields with [v, r, s] in the trailing three slots — assembles, and its list header
    //    reads back through the RLP decoder to exactly its own bytes. The frame a node receives, proven to round-trip.
    {
        const signed_fields = [_]rlp.Item{
            rlp.Item{ .str = &[_]u8{0x09} },
            rlp.Item{ .str = &gas_price },
            rlp.Item{ .str = &gas },
            rlp.Item{ .str = &to },
            rlp.Item{ .str = &value },
            rlp.Item{ .str = "" },
            rlp.Item{ .str = &[_]u8{0x25} }, // v = 37 = 0x25
            rlp.Item{ .str = &r },
            rlp.Item{ .str = &s },
        };
        var buf: [max_tx_bytes]u8 = undefined;
        const encoded = try rlp.encode_item(&buf, rlp.Item{ .list = &signed_fields }, 0);
        // Two 32-byte scalars and a 20-byte address push the payload well past 55 bytes: the long-form list header.
        if (encoded[0] < 0xf8) return error.SignedNotLongForm;
        const h = try rlp.decode_list_header(encoded);
        if (h.consumed != encoded.len) return error.SignedHeaderMismatch;
        // Walking the payload yields exactly nine fields, each recovering its own bytes through the independent decoder.
        var off: u32 = 0;
        var count: u32 = 0;
        while (off < h.value.len) : (count += 1) {
            const d = try rlp.decode_bytes(h.value[off..]);
            off += d.consumed;
        }
        if (count != tx_fields) return error.SignedFieldCountMismatch;
    }

    // 5. The edges refuse: a short field list, a v below 27, and a mis-sized scalar each raise their named error before a dishonest result
    //    escapes.
    {
        const short_list = [_]rlp.Item{ rlp.Item{ .str = "" }, rlp.Item{ .str = "" } };
        if (signing_sighash(&short_list)) |_| return error.CountSlipped else |err| if (err != error.BadFieldCount) return error.WrongCountErr;
        if (v_parts(26)) |_| return error.BadVSlipped else |err| if (err != error.BadV) return error.WrongBadVErr;
        const tiny = [_]u8{0x00};
        if (recover_sender(&sighash, &tiny, &s, 0)) |_| return error.ScalarSlipped else |err| if (err != error.BadScalarLength) return error.WrongScalarErr;
    }

    print("GREEN crypto-eip155-tx: the EIP-155 legacy Ethereum transaction digest authored in pure Rye as a composition over the GREEN RLP " ++
        "(encoding/rlp.rye), Keccak-256 (crypto/keccak256.rye), ecrecover (crypto/secp256k1_ecrecover.rye), and eth_address " ++
        "(crypto/eth_address.rye) — authoring no new cryptography and no new serialization. The signing sighash is keccak256(rlp([nonce, " ++
        "gasPrice, gas, to, value, data, chainId, 0, 0])); the chain id folded into the preimage is EIP-155 replay protection, and v = " ++
        "recovery_id + 2*chainId + 35 carries it back out. Parity holds three ways anyone can replay: the EIP-155 spec's own canonical example " ++
        "(nonce 9, 20 gwei, 21000 gas, to 0x3535…35, 1 ETH, chain id 1) hashes byte-for-byte to the spec's stated sighash 0xdaf5a779…4c8e53; " ++
        "the same preimage hashed by Zig's own std.crypto Keccak-256 gives the identical digest, a second independent path; and the spec's " ++
        "published (v=37, r, s) recovers through our ecrecover to exactly the example's published sender 0x9d8a62f6…855a4f, the address of the " ++
        "spec's test key 0x4646…46 — a one-bit encoding error anywhere would break the recovery. The signed nine-field transaction assembles " ++
        "and round-trips through the RLP decoder to its own bytes; a short field list, a v below 27, and a mis-sized scalar each refuse their " ++
        "named error. Purely local — no key, no network, no funds, no device: this module builds the public preimage and recovers from a " ++
        "published signature, never signing. Signing with a real identity key stays the custody gate.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
