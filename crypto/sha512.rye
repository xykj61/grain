//! crypto/sha512.rye -- Season G (Cryptography), the second primitive: SHA-512 authored in pure Rye. SHA-512 is the hash standard
//! Ed25519 signs with (RFC 8032 / FIPS 180-4) -- Monocypher's EdDSA hashes the nonce, the public key, and the message through it -- so
//! this primitive is the direct next stone toward the Rye-native signing that unblocks the Lotus signed carry. Like BLAKE2b it is
//! pure 64-bit integer arithmetic and carries a published FIPS 180-4 known-answer (SHA-512("abc")), so it is buildable in authored
//! Rye this round and provable against a neutral public reference.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography - Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-180728_open-season-g-crypto-blake2b.md (the season's opening read -- SHA-512 is the second
//! primitive named there as following the hash foundation).
//! Kin: crypto/blake2b.rye (the first primitive, GREEN on metal). Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity TARGET,
//! never a copied line -- our own arithmetic, studied clean-room from the public standard and Monocypher's public API
//! (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX -- SHA-512 is a bounded loop over 64-bit words, mod 2^64. The message is padded to a whole number of 128-byte blocks (a
//! 0x80 byte, zeros, then the 128-bit big-endian bit length), each block expanded to eighty message-schedule words and folded through
//! eighty rounds of the Ch/Maj/Sigma functions into an eight-word hash state. Every add is mod 2^64 (Zig's wrapping +%); every
//! rotation and shift is a fixed constant from the standard. Nothing here is a claim about a device -- it is arithmetic anyone can
//! replay against FIPS 180-4.
//!
//! HONEST SCOPE -- software only, purely LOCAL, no key, no network, no funds, no real device. The primitive calls no std.crypto; it is
//! authored from the standard. Parity is proven at selftest against two references runnable now -- the FIPS 180-4 known-answer for
//! "abc" and the empty message, and Zig's own std.crypto SHA-512 as an independent implementation, byte-for-byte over the empty
//! message, "abc", a 111-byte input (the padding edge where the length still fits the block), a 112-byte input (the edge that forces a
//! second all-padding block), and a multi-block input. Monocypher-source parity is now LANDED: tools/cr/crypto_monocypher_sha512_parity_witness.rish
//! compiles the vendored Monocypher's optional crypto_sha512 fresh and diffs it byte-for-byte against this module over the empty message,
//! "abc", and the {111, 112, 300}-byte edges (the tenth real Monocypher-source parity rung). Constant-time timing-safety is a separate
//! named horizon.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/sha512.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const sha512_version = "20260815.181439";

/// SHA-512's fixed shapes. digest_len is the 64-byte (512-bit) output; block_bytes is the 128-byte compression block; the message
/// schedule runs eighty rounds. Named so every bound cites one rather than a bare number.
pub const digest_len: u32 = 64;
pub const block_bytes: u32 = 128;
pub const hex_len: u32 = digest_len * 2;
const rounds: u32 = 80;

/// The largest message this primitive hashes in one call. Generous for the test vectors and any in-process artifact, yet named so the
/// bit-length field and the block loop both cite a maximum -- the TAME reflex that every loop and every count declares its ceiling.
pub const max_message_bytes: u32 = 1 << 20;

/// The one fault this primitive can raise: a message longer than max_message_bytes, refused before a single byte is mixed.
pub const Sha512Error = error{
    /// A message whose length exceeds max_message_bytes -- refused at the edge, before padding or the block loop begins.
    MessageTooLong,
};

/// The SHA-512 initial hash value -- the eight 64-bit words (FIPS 180-4 §5.3.5), the fractional parts of the square roots of the first
/// eight primes. Named as a constant so init reads from one source of truth.
const h_init = [8]u64{
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
};

/// The eighty SHA-512 round constants (FIPS 180-4 §4.2.3) -- the fractional parts of the cube roots of the first eighty primes. A
/// single wrong entry breaks parity against the standard at once, which the selftest proves it does not.
const k = [80]u64{
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
};

fn ch(x: u64, y: u64, z: u64) u64 {
    return (x & y) ^ (~x & z);
}

fn maj(x: u64, y: u64, z: u64) u64 {
    return (x & y) ^ (x & z) ^ (y & z);
}

fn big_sigma0(x: u64) u64 {
    return std.math.rotr(u64, x, 28) ^ std.math.rotr(u64, x, 34) ^ std.math.rotr(u64, x, 39);
}

fn big_sigma1(x: u64) u64 {
    return std.math.rotr(u64, x, 14) ^ std.math.rotr(u64, x, 18) ^ std.math.rotr(u64, x, 41);
}

fn small_sigma0(x: u64) u64 {
    return std.math.rotr(u64, x, 1) ^ std.math.rotr(u64, x, 8) ^ (x >> 7);
}

fn small_sigma1(x: u64) u64 {
    return std.math.rotr(u64, x, 19) ^ std.math.rotr(u64, x, 61) ^ (x >> 6);
}

/// Compress one 128-byte block into the eight-word hash state h. The block's sixteen big-endian 64-bit words seed an eighty-word
/// message schedule, which drives eighty rounds of the Ch/Maj/Sigma round function over eight working words, then the working words
/// fold back into h.
fn compress(h: *[8]u64, block: *const [block_bytes]u8) void {
    // invariant: the block carries exactly sixteen 64-bit words -- the first sixteen entries of the message schedule.
    comptime assert(block_bytes == 16 * 8);
    // invariant: the schedule runs the eighty rounds the standard defines.
    comptime assert(rounds == 80);

    var w: [80]u64 = undefined;
    var t: u32 = 0;
    while (t < 16) : (t += 1) {
        w[t] = std.mem.readInt(u64, block[t * 8 ..][0..8], .big);
    }
    while (t < rounds) : (t += 1) {
        w[t] = small_sigma1(w[t - 2]) +% w[t - 7] +% small_sigma0(w[t - 15]) +% w[t - 16];
    }

    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];

    t = 0;
    while (t < rounds) : (t += 1) {
        const t1 = hh +% big_sigma1(e) +% ch(e, f, g) +% k[t] +% w[t];
        const t2 = big_sigma0(a) +% maj(a, b, c);
        hh = g;
        g = f;
        f = e;
        e = d +% t1;
        d = c;
        c = b;
        b = a;
        a = t1 +% t2;
    }

    h[0] +%= a;
    h[1] +%= b;
    h[2] +%= c;
    h[3] +%= d;
    h[4] +%= e;
    h[5] +%= f;
    h[6] +%= g;
    h[7] +%= hh;
}

/// Hash a message to its 64-byte SHA-512 digest. The message is padded per FIPS 180-4 §5.1.2 -- a 0x80 byte, then zeros, then the
/// message length in bits as a 128-bit big-endian integer -- filling a whole number of 128-byte blocks, then every block is compressed
/// in order.
pub fn hash(msg: []const u8) Sha512Error![digest_len]u8 {
    // invariant: SHA-512's shapes are the standard's own -- 64-byte digest, 128-byte block. Proven at compile time.
    comptime assert(digest_len == 64 and block_bytes == 128);
    // invariant: the message fits the named bound, so its length casts to u32 losslessly and the bit length never overflows u64.
    if (msg.len > max_message_bytes) return error.MessageTooLong;

    const total: u32 = @intCast(msg.len);
    // invariant: the u32 count names exactly the message bytes -- the bounded cast lost nothing.
    assert(total == msg.len);

    var h: [8]u64 = h_init;

    // Compress every FULL 128-byte block of the message proper.
    var offset: u32 = 0;
    while (total - offset >= block_bytes) : (offset += block_bytes) {
        compress(&h, msg[offset..][0..block_bytes]);
    }

    // The tail is 0..127 leftover bytes. Build the padded final block(s): the tail, a 0x80 marker, zeros, then the 128-bit big-endian
    // bit length. When the tail plus marker plus length would exceed one block, two padded blocks are emitted -- the 112-byte edge.
    const rem = total - offset;
    // invariant: the leftover is strictly less than a whole block -- every full block was consumed above.
    assert(rem < block_bytes);

    var tail = [_]u8{0} ** (block_bytes * 2);
    var j: u32 = 0;
    while (j < rem) : (j += 1) tail[j] = msg[offset + j];
    tail[rem] = 0x80;

    // Two padded blocks are needed when the tail leaves no room for the 16-byte length (rem >= 112); otherwise one.
    const padded_len: u32 = if (rem >= block_bytes - 16) block_bytes * 2 else block_bytes;
    // The bit length occupies the last 16 bytes of the padded region; the message is bounded well within u64, so the high 8 bytes
    // stay zero and the low 8 carry total * 8 bits.
    const bit_len: u64 = @as(u64, total) * 8;
    std.mem.writeInt(u64, tail[padded_len - 8 ..][0..8], bit_len, .big);

    compress(&h, tail[0..block_bytes]);
    if (padded_len == block_bytes * 2) {
        compress(&h, tail[block_bytes .. block_bytes * 2][0..block_bytes]);
    }

    var out: [digest_len]u8 = undefined;
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        std.mem.writeInt(u64, out[i * 8 ..][0..8], h[i], .big);
    }
    return out;
}

/// Render a 64-byte digest as 128 lowercase hex characters, for comparison against the standard's own hex form.
pub fn to_hex(digest: [digest_len]u8) [hex_len]u8 {
    const alphabet = "0123456789abcdef";
    var out: [hex_len]u8 = undefined;
    var i: u32 = 0;
    // invariant: each input byte renders to exactly two hex characters, so the output fills hex_len exactly.
    comptime assert(hex_len == digest_len * 2);
    while (i < digest_len) : (i += 1) {
        out[i * 2] = alphabet[digest[i] >> 4];
        out[i * 2 + 1] = alphabet[digest[i] & 0x0f];
    }
    return out;
}

// The FIPS 180-4 known-answer for SHA-512 of the ASCII string "abc" -- the neutral public reference our Rye and Monocypher must both
// reproduce.
const fips_abc_hex = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f";
// The published SHA-512 of the empty message.
const fips_empty_hex = "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e";

/// Independent reference: Zig's own std.crypto SHA-512, used ONLY inside the selftest as a second implementation to prove our authored
/// primitive matches byte-for-byte. The primitive above never calls this.
fn ref_hash(msg: []const u8) [digest_len]u8 {
    var out: [digest_len]u8 = undefined;
    std.crypto.hash.sha2.Sha512.hash(msg, &out, .{});
    return out;
}

fn hex_eq(got: [hex_len]u8, want: []const u8) bool {
    if (want.len != hex_len) return false;
    var i: u32 = 0;
    while (i < hex_len) : (i += 1) {
        if (got[i] != want[i]) return false;
    }
    return true;
}

fn bytes_eq(a: [digest_len]u8, b: [digest_len]u8) bool {
    var i: u32 = 0;
    while (i < digest_len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

fn ref_parity(msg: []const u8) !void {
    const ours = try hash(msg);
    if (!bytes_eq(ours, ref_hash(msg))) return error.RefMismatch;
}

fn run_selftest() !u8 {
    // 1. The FIPS 180-4 known-answers: SHA-512 of "abc" and the empty message equal the published digests, hex for hex.
    {
        const d = try hash("abc");
        if (!hex_eq(to_hex(d), fips_abc_hex)) return error.AbcVectorMismatch;
        const e = try hash("");
        if (!hex_eq(to_hex(e), fips_empty_hex)) return error.EmptyVectorMismatch;
    }

    // 2. Independent-implementation parity across the padding edges: empty, "abc", 111 bytes (length still fits the block), 112 bytes
    //    (forces a second all-padding block), and a multi-block input. Our authored Rye equals Zig's std.crypto SHA-512 byte-for-byte.
    {
        try ref_parity("");
        try ref_parity("abc");

        var buf111: [111]u8 = undefined;
        var i: u32 = 0;
        while (i < 111) : (i += 1) buf111[i] = @as(u8, @truncate(i));
        try ref_parity(&buf111);

        var buf112: [112]u8 = undefined;
        i = 0;
        while (i < 112) : (i += 1) buf112[i] = @as(u8, @truncate(i));
        try ref_parity(&buf112);

        var multi: [300]u8 = undefined;
        i = 0;
        while (i < 300) : (i += 1) multi[i] = @as(u8, @truncate(i *% 7 +% 1));
        try ref_parity(&multi);
    }

    // 3. The bound refuses an over-long message before any byte is mixed.
    {
        const oversize: []const u8 = @as([*]const u8, @ptrFromInt(0x1000))[0 .. max_message_bytes + 1];
        if (hash(oversize)) |_| return error.OversizeSlipped else |err| if (err != error.MessageTooLong) return error.WrongOversize;
    }

    print("GREEN crypto-sha512: SHA-512 authored in pure Rye — Season G's second primitive, the hash Ed25519 signs with (RFC 8032 / " ++
        "FIPS 180-4). Sixteen big-endian words per 128-byte block expand to an eighty-word message schedule and fold through eighty " ++
        "rounds of the Ch/Maj/Sigma round function, every add mod 2^64, every rotation and shift a fixed constant, the message padded " ++
        "with a 0x80 marker and a 128-bit big-endian bit length. Parity holds against two references runnable now: the FIPS 180-4 " ++
        "known-answer for \"abc\" AND the empty message match hex for hex, and our authored Rye equals Zig's independent std.crypto " ++
        "SHA-512 byte-for-byte over the empty message, \"abc\", a 111-byte input, a 112-byte input (the edge that forces a second " ++
        "all-padding block), and a 300-byte multi-block input. Monocypher-source parity is landed too — the vendored Monocypher's " ++
        "optional crypto_sha512 agrees byte-for-byte (tools/cr/crypto_monocypher_sha512_parity_witness.rish, the tenth parity rung). An over-long message refuses MessageTooLong before a byte " ++
        "is mixed. Purely local arithmetic — the primitive calls no std.crypto, no key, no signature, no network, no funds, no real " ++
        "device; constant-time timing-safety stays a separate named horizon. The hash foundation for Ed25519 now stands beside " ++
        "BLAKE2b.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
