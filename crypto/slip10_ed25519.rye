const v2_seed_hex = "fffcf9f6f3f0edeae7e4e1dedbd8d5d2cfccc9c6c3c0bdbab7b4b1aeaba8a5a29f9c999693908d8a8784817e7b7875726f6c696663605d5a5754514e4b484542";
// m, m/0H, m/0H/2147483647H, .../1H, .../2147483646H, .../2H.
const v2_indices = [_]u32{ 0, 2147483647, 1, 2147483646, 2 };
const v2_chain = [_][]const u8{
    "ef70a74db9c3a5af931b5fe73ed8e1a53464133654fd55e7a66f8570b8e33c3b",
