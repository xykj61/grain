//! crypto/slip10_ed25519.rye -- Season G (Cryptography), the identity arc's HD rung: SLIP-0010 hierarchical-deterministic keys over the ed25519
//! curve. Where crypto/bip32.rye grows a TREE of secp256k1 keys for a Bitcoin/Ethereum wallet, BIP-32's additive child-key law does NOT work for
//! ed25519 -- an ed25519 private key is a 32-byte seed hashed and clamped into a scalar, not a scalar you can add an offset to. SLIP-0010 is the
//! standard that answers exactly this: from one BIP-39 seed, a whole tree of ed25519 identity keys, each child derived hardened-only through the
//! same HMAC-SHA-512 PRF, the private key taken as I_L DIRECTLY (no modular add, no canonicality retry). This is the bridge from the already-GREEN
//! wallet seed (crypto/bip39_seed.rye) to Grain's OWN identity keys -- Kumara signs with ed25519, and this rung grows a Kumara key tree from a
//! single backup phrase the same way BIP-44 grows a Bitcoin one.
//!
//! It authors NO new cryptography. Every byte is HMAC-SHA-512 (crypto/hmac_sha512.rye, the same derivation PRF BIP-32 uses) and the ed25519
//! public-key derivation already proven in crypto/ed25519_sign.rye (derive_public: SHA-512 the seed, clamp, scalar-multiply the base point,
//! compress). SLIP-0010 for ed25519 contributes only the tree grammar (SLIP-0010 §"Master key generation" and §"Child key derivation"):
//!   master:  I = HMAC-SHA-512(Key = "ed25519 seed", Data = seed);  I_L = key,  I_R = chain code
//!   child:   I = HMAC-SHA-512(Key = c_par, Data = 0x00 ‖ ser256(k_par) ‖ ser32(i));  I_L = child key,  I_R = child chain code   (hardened i only)
//!   public:  0x00 ‖ ed25519_public(I_L)                                              (the 33-byte SLIP-0010 public form, the 0x00 a domain tag)
//! ed25519 admits ONLY hardened derivation -- a normal (non-hardened) index has no defined public-parent child and is refused NotHardened.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography - Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G - the crypto parity wave -- the library
//! that serves Kumara identity, Vault, Comlink, and the Lotus signed carry; this rung is the wallet arc turned toward Grain's OWN ed25519 identity).
//! Kin: crypto/bip32.rye (the secp256k1 HD sibling) - crypto/bip39_seed.rye (the seed this grows a master from) - crypto/ed25519_sign.rye (the
//! public-key derivation this composes) - crypto/hmac_sha512.rye (the PRF). Monocypher (vendor/monocypher, CC0/BSD-dual) is the parity DISCIPLINE
//! target for the primitives beneath; SLIP-0010 and its test vectors are public standards, studied clean-room (.claude/rules/gratitude-licenses.md).
//!
//! HONEST SCOPE -- software only, purely LOCAL, no network, no funds, no real device. Every key derived here is a TEST key from SLIP-0010's OWN
//! published seeds; this module calls no std.crypto. Constant-time discipline: the derivation touches secret key material (I_L and the HMAC over
//! it), so its timing-safety inherits crypto/hmac_sha512.rye's and crypto/ed25519_sign.rye's horizon -- a named horizon wanting measurement, not a
//! claim (crypto/CONSTANT_TIME.md). Growing a REAL Kumara identity tree and signing with its key stays the custody gate (#3/#4): the agent builds
//! and verifies the derivation, never holds the maintainer's key.
//!
//! Parity is proven at selftest the replayable way the tree favours, against SLIP-0010's OWN published ed25519 test vectors (the spec's own
//! known-answers, quoted character for character, fetched byte-exact from the canonical satoshilabs/slips slip-0010.md, never fabricated): both
//! Test Vector 1 (seed 000102...0f) and Test Vector 2 (the 64-byte seed) walk EVERY chain node hardened, and at each node the private key I_L, the
//! chain code I_R, AND the 33-byte public key 0x00‖ed25519_public(I_L) reproduce EXACTLY the spec's published bytes -- proving the master HMAC, the
//! hardened child HMAC, the ser32 index encoding, and the ed25519 public derivation together against a real standard answer. The edges refuse: a
//! non-hardened index raises NotHardened, a walk past the depth ceiling raises DepthTooDeep.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/slip10_ed25519.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const hmac = @import("hmac_sha512.rye");
const ed25519 = @import("ed25519_sign.rye");
const bip32 = @import("bip32.rye");

pub const slip10_ed25519_version = "20260816.084930";

/// The two 32-byte halves of every HMAC-SHA-512 output: I_L (the private key seed) and I_R (the chain code).
pub const key_len: u32 = 32;
pub const chain_code_len: u32 = 32;

/// The SLIP-0010 public key is 33 bytes: a 0x00 domain tag ahead of the 32-byte compressed ed25519 public key, so it never collides with a
/// secp256k1 SEC1 compressed point (which begins 0x02/0x03) at a shared boundary.
pub const public_len: u32 = 33;

/// The HMAC-SHA-512 key that seeds the ed25519 master, fixed by SLIP-0010 §"Master key generation" -- the curve name, not a secret.
const ed25519_seed_key = "ed25519 seed";

/// The width of the child HMAC data, 0x00 ‖ ser256(k_par) ‖ ser32(i): one tag byte, the 32-byte parent key, and the 4-byte big-endian index.
const ckd_data_len: u32 = 1 + key_len + 4;

/// A generous ceiling on tree depth. SLIP-0010's own vectors reach depth five; thirty-two bounds any real identity path well above it while
/// staying far under any width concern.
pub const max_depth: u32 = 32;

/// The faults this rung raises, each refused at the edge before a wrong index or an overrun walk derives a key.
pub const Slip10Error = error{
    /// A non-hardened index -- ed25519 admits only hardened derivation (SLIP-0010 §"Child key derivation": the public-parent path is undefined).
    NotHardened,
    /// A walk deeper than max_depth levels -- refused before the depth counter passes its named ceiling.
    DepthTooDeep,
};

/// One node of the ed25519 HD tree: the private key seed I_L, the chain code I_R, and the depth below the master. The public key is derived on
/// demand (public_key) rather than stored, since it is a pure function of the key.
pub const Node = struct {
    key: [key_len]u8,
    chain_code: [chain_code_len]u8,
    depth: u32,
};

/// Split a 64-byte HMAC-SHA-512 output into a node at `depth`: the low 32 bytes are I_L (the key), the high 32 bytes are I_R (the chain code).
/// ed25519 takes I_L DIRECTLY -- unlike secp256k1 there is no "< n" canonicality check and no retry, because an ed25519 key is any 32 bytes,
/// hashed and clamped into a scalar downstream (SLIP-0010 §"Master key generation" note).
fn node_from_i(i: *const [hmac.tag_len]u8, depth: u32) Node {
    // invariant: HMAC-SHA-512 gives exactly the two 32-byte halves this split needs.
    comptime assert(hmac.tag_len == key_len + chain_code_len);
    var node = Node{ .key = undefined, .chain_code = undefined, .depth = depth };
    var k: u32 = 0;
    while (k < key_len) : (k += 1) {
        // invariant: each half stays within the 64-byte output -- the key from the low 32, the chain code from the high 32.
        assert(k < key_len and (key_len + k) < hmac.tag_len);
        node.key[k] = i[k];
        node.chain_code[k] = i[key_len + k];
    }
    return node;
}

/// Grow the master node from `seed`: I = HMAC-SHA-512(Key = "ed25519 seed", Data = seed), then split. The seed is a BIP-39 seed (or any byte
/// string SLIP-0010 admits); no length check beyond the HMAC's own message bound, since SLIP-0010 places none on the ed25519 master seed.
pub fn master_from_seed(seed: []const u8) hmac.HmacError!Node {
    const i = try hmac.mac(seed, ed25519_seed_key);
    // invariant: the master sits at depth zero -- the root every child counts down from.
    const node = node_from_i(&i, 0);
    // invariant: a master node is the root of the tree, so a depth of anything else would
    // serialize a child as if it had no parent
    assert(node.depth == 0);
    return node;
}

/// Serialize a 32-bit index big-endian (ser32) into `out` -- the wire form SLIP-0010 folds into the child HMAC data.
fn ser32(out: *[4]u8, index: u32) void {
    out[0] = @intCast((index >> 24) & 0xff);
    out[1] = @intCast((index >> 16) & 0xff);
    out[2] = @intCast((index >> 8) & 0xff);
    out[3] = @intCast(index & 0xff);
}

/// Derive a hardened child (CKDpriv for ed25519). The HMAC data is 0x00 ‖ ser256(k_par) ‖ ser32(i); the child key is I_L directly and the child
/// chain code is I_R. A non-hardened index is refused -- ed25519 has no public-parent normal child. Composes crypto/hmac_sha512.rye entirely.
pub fn ckd_priv(parent: *const Node, index: u32) Slip10Error!Node {
    // invariant: ed25519 admits only hardened derivation -- an index below the hardened offset names a normal child that does not exist here.
    if (index < bip32.hardened_offset) return error.NotHardened;
    // invariant: the child depth stays within the named ceiling before the walk records it.
    if (parent.depth >= max_depth) return error.DepthTooDeep;

    var data: [ckd_data_len]u8 = undefined;
    // 0x00 tag, then the 32-byte parent key, then the 4-byte big-endian index.
    data[0] = 0x00;
    var k: u32 = 0;
    while (k < key_len) : (k += 1) {
        // invariant: both writes below index fixed arrays, so each bound and the array it
        // addresses are the same number
        assert(k < key_len and (1 + k) < ckd_data_len);
        data[1 + k] = parent.key[k];
    }
    var idx_be: [4]u8 = undefined;
    ser32(&idx_be, index);
    k = 0;
    while (k < 4) : (k += 1) {
        // invariant: the write below indexes a fixed array of that length, so the loop's bound
        // and the array's own size are the same number
        assert((1 + key_len + k) < ckd_data_len);
        data[1 + key_len + k] = idx_be[k];
    }

    // HMAC over the parent chain code cannot fail on our bounded 37-byte data / 32-byte key, yet the error is carried honestly through.
    const i = hmac.mac(data[0..], parent.chain_code[0..]) catch unreachable;
    // invariant: the child sits exactly one level below its parent.
    const child = node_from_i(&i, parent.depth + 1);
    // invariant: a derived child sits exactly one level below its parent, and the depth is what
    // a serialized key publishes -- a wrong one names a different position in the tree
    assert(child.depth == parent.depth + 1);
    return child;
}

/// The 33-byte SLIP-0010 public key of a node: 0x00 ‖ ed25519_public(I_L). The private key seed is run through the ed25519 public derivation
/// already proven in crypto/ed25519_sign.rye -- this rung adds only the 0x00 domain tag.
pub fn public_key(node: *const Node) [public_len]u8 {
    var out: [public_len]u8 = undefined;
    out[0] = 0x00;
    const pk = ed25519.derive_public(&node.key);
    var k: u32 = 0;
    while (k < key_len) : (k += 1) {
        // invariant: the 32-byte compressed public key sits after the single 0x00 tag byte.
        assert((1 + k) < public_len);
        out[1 + k] = pk[k];
    }
    return out;
}

/// Walk a list of hardened indices from `seed` to a leaf node -- the ergonomic derive, the ed25519 sibling of crypto/bip44.rye's derive_path.
pub fn derive(seed: []const u8, indices: []const u32) (Slip10Error || hmac.HmacError)!Node {
    // invariant: a path never exceeds the depth ceiling before the walk begins.
    if (indices.len > max_depth) return error.DepthTooDeep;
    var node = try master_from_seed(seed);
    var k: u32 = 0;
    while (k < indices.len) : (k += 1) {
        // invariant: the walk never steps past the supplied depth.
        assert(k < max_depth);
        node = try ckd_priv(&node, indices[k]);
    }
    return node;
}

fn nibble(c: u8) u8 {
    if (c >= '0' and c <= '9') return c - '0';
    // invariant: the vector hex uses only lowercase a-f beyond the digits.
    assert(c >= 'a' and c <= 'f');
    return c - 'a' + 10;
}

/// Compare a raw byte buffer against its lowercase-hex spelling -- the replayable check every node's I_L, I_R, and public key face.
fn eq_hex(raw: []const u8, hex: []const u8) bool {
    if (raw.len * 2 != hex.len) return false;
    var i: u32 = 0;
    while (i < raw.len) : (i += 1) {
        if (raw[i] != nibble(hex[i * 2]) * 16 + nibble(hex[i * 2 + 1])) return false;
    }
    return true;
}

fn from_hex(out: []u8, hex: []const u8) u32 {
    // invariant: two hex chars name one byte, so the buffer must hold half the hex length.
    assert(hex.len % 2 == 0 and out.len * 2 >= hex.len);
    var i: u32 = 0;
    while (i < hex.len / 2) : (i += 1) out[i] = nibble(hex[i * 2]) * 16 + nibble(hex[i * 2 + 1]);
    return @intCast(hex.len / 2);
}

// SLIP-0010's OWN published ed25519 test vectors -- the spec's own known-answers, quoted character for character from the canonical
// satoshilabs/slips slip-0010.md; nothing here is fabricated. Each row is a chain node reached by walking from the seed through the hardened
// indices, and its expected chain code, private key, and public key (0x00-prefixed) are the spec's.

const v1_seed_hex = "000102030405060708090a0b0c0d0e0f";
// The hardened indices walked in turn: m, m/0H, m/0H/1H, m/0H/1H/2H, m/0H/1H/2H/2H, m/0H/1H/2H/2H/1000000000H.
const v1_indices = [_]u32{ 0, 1, 2, 2, 1000000000 };
const v1_chain = [_][]const u8{
    "90046a93de5380a72b5e45010748567d5ea02bbf6522f979e05c0d8d8ca9fffb",
