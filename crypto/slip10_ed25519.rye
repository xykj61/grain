    "002e66aa57069c86cc18249aecf5cb5a9cebbfd6fadeab056254763874a9352b45",
    "00e33c0f7d81d843c572275f287498e8d408654fdf0d1e065b84e2e6f157aab09b",
    "0047150c75db263559a70d5778bf36abbab30fb061ad69f69ece61a72b0cfa4fc0",
};

/// Walk one published vector: the master, then each hardened child, checking I_L, I_R, and the 33-byte public key at EVERY node against the
/// spec's bytes. `indices` are the bare (non-hardened) values; the hardened offset is added here so the vector table reads as the spec writes it.
fn check_vector(
    seed_hex: []const u8,
    indices: []const u32,
    chain: []const []const u8,
    priv: []const []const u8,
    pub_hex: []const []const u8,
) !void {
    // invariant: a vector names one node for the master and one per child index -- the four arrays move in lockstep.
    assert(chain.len == indices.len + 1 and priv.len == chain.len and pub_hex.len == chain.len);

    var seed: [64]u8 = undefined;
    const seed_len = from_hex(seed[0..], seed_hex);

    var node = try master_from_seed(seed[0..seed_len]);
    var level: u32 = 0;
    while (true) {
        const pk = public_key(&node);
        if (!eq_hex(node.chain_code[0..], chain[level])) return error.ChainCodeMismatch;
        if (!eq_hex(node.key[0..], priv[level])) return error.PrivMismatch;
        if (!eq_hex(pk[0..], pub_hex[level])) return error.PubMismatch;
        if (level >= indices.len) break;
        node = try ckd_priv(&node, indices[level] + bip32.hardened_offset);
        level += 1;
    }
}

fn run_selftest() !u8 {
    // 1. SLIP-0010 Test Vector 1 (seed 000102...0f): every node's private key, chain code, and 0x00-prefixed public key reproduces EXACTLY the
    //    spec's published bytes, master through the 1000000000-hardened leaf -- proving the master HMAC, the hardened child HMAC with its ser32
    //    index, and the ed25519 public derivation together against a real standard answer.
    try check_vector(v1_seed_hex, v1_indices[0..], v1_chain[0..], v1_priv[0..], v1_pub[0..]);

    // 2. SLIP-0010 Test Vector 2 (the 64-byte seed): the same three-way check across its five hardened children, including the 2147483647- and
    //    2147483646-hardened indices whose ser32 exercises the high bits of the index encoding.
    try check_vector(v2_seed_hex, v2_indices[0..], v2_chain[0..], v2_priv[0..], v2_pub[0..]);

    // 3. The `derive` walker reaches the SAME leaf as the step-by-step walk, byte-for-byte -- the ergonomic helper does not drift from ckd_priv.
    {
        var seed: [32]u8 = undefined;
        const seed_len = from_hex(seed[0..], v1_seed_hex);
        const h = bip32.hardened_offset;
        const path = [_]u32{ 0 + h, 1 + h, 2 + h, 2 + h, 1000000000 + h };
        const leaf = try derive(seed[0..seed_len], path[0..]);
        if (!eq_hex(leaf.key[0..], v1_priv[5])) return error.DeriveLeafMismatch;
        const pk = public_key(&leaf);
        if (!eq_hex(pk[0..], v1_pub[5])) return error.DeriveLeafPubMismatch;
    }

    // 4. The edges refuse, each with its named error: a non-hardened index (ed25519 has no normal child), and a path past the depth ceiling.
    {
        var seed: [32]u8 = undefined;
        const seed_len = from_hex(seed[0..], v1_seed_hex);
        const master = try master_from_seed(seed[0..seed_len]);
        // A bare index 0 is below the hardened offset -- refused NotHardened, unlike secp256k1 which would derive a normal child.
        if (ckd_priv(&master, 0)) |_| return error.NotHardenedSlipped else |err| if (err != error.NotHardened) return error.WrongNotHardened;
        // A path of max_depth + 1 hardened indices overruns the ceiling before it walks.
        var deep: [max_depth + 1]u32 = undefined;
        var k: u32 = 0;
        while (k < deep.len) : (k += 1) deep[k] = bip32.hardened_offset;
        if (derive(seed[0..seed_len], deep[0..])) |_| return error.TooDeepSlipped else |err| if (err != error.DepthTooDeep) return error.WrongTooDeep;
    }

    print("GREEN crypto-slip10-ed25519: SLIP-0010 hierarchical-deterministic ed25519 keys authored in pure Rye — the identity arc's HD rung, the " ++
        "bridge from a BIP-39 wallet seed to a whole tree of Grain's OWN ed25519 identity keys (Kumara signs with ed25519). Where crypto/bip32's " ++
        "additive child law fits secp256k1, SLIP-0010 takes the child key as I_L DIRECTLY and derives hardened-only: master I = HMAC-SHA-512(\"" ++
        "ed25519 seed\", seed), child I = HMAC-SHA-512(c_par, 0x00 ‖ ser256(k_par) ‖ ser32(i)), public 0x00 ‖ ed25519_public(I_L). Authors NO new " ++
        "cryptography — every byte is the GREEN crypto/hmac_sha512 PRF and crypto/ed25519_sign's public derivation; this rung adds only the tree " ++
        "grammar. Parity holds the replayable way, against SLIP-0010's OWN published ed25519 test vectors (quoted character for character from " ++
        "satoshilabs/slips, never fabricated): both Test Vector 1 (seed 000102…0f) and Test Vector 2 (the 64-byte seed) walk EVERY chain node " ++
        "hardened, and at each node the private key I_L, the chain code I_R, AND the 33-byte public key reproduce EXACTLY the spec's bytes — the " ++
        "master HMAC, the hardened child HMAC, the ser32 index, and the ed25519 public derivation all proven against a real answer. The `derive` " ++
        "walker agrees with the step-by-step walk byte-for-byte; a non-hardened index refuses NotHardened and an over-deep path refuses " ++
        "DepthTooDeep. Purely local — TEST keys from the spec's own seeds, no real identity key, no network, no funds, no real device; growing a " ++
        "REAL Kumara tree and signing with its key stays the custody gate. With this rung the identity arc stands: phrase → seed → ed25519 HD tree.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
