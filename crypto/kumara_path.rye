//! crypto/kumara_path.rye — Season G (Cryptography), the identity arc's account-path rung: the ed25519 sibling of crypto/bip44.rye. Where
//! crypto/slip10_ed25519.rye grows one BIP-39 seed into a whole TREE of ed25519 identity keys and derives a child by a bare hardened index,
//! this rung is the CONVENTION that gives that tree a named, copyable shape — m / purpose' / coin_type' / account' / index', every level hardened
//! — so a keeper's Kumara identity is reached the same way from the same phrase on any device. It is the parser and the walker of that path:
//! parse_path reads the human "m/44'/0'/0'/0'" text into the exact 32-bit hardened index list; derive_path and derive_identity walk
//! crypto/slip10_ed25519.rye's ckd_priv down that list from the master to the identity key a Kumara signature is made with.
//!
//! It authors NO new cryptography. Every HMAC, every clamp, every scalar lives one rung down in the already-GREEN crypto/slip10_ed25519.rye
//! (itself only HMAC-SHA-512 and the ed25519 public derivation); this module contributes only the path grammar. The one difference from its
//! secp256k1 sibling crypto/bip44.rye is the law ed25519 imposes: SLIP-0010 admits ONLY hardened derivation over ed25519 (a normal child has no
//! defined public-parent form), so this parser REQUIRES a hardening marker on every level and refuses a bare index NotHardened — where bip44's
//! parser accepts both. The recipe (BIP-44 §"Path levels", turned toward identity over SLIP-0010's ed25519 curve):
//!   m / 44' / coin_type' / account' / index'
//! with 44' the purpose fixed by BIP-43, coin_type' the SLIP-44-style coin slot (a registered Grain identity coin type is a named horizon, so it
//! stays a caller-supplied value rather than a fabricated constant), account' a hardened account number, and index' the hardened leaf. All four
//! levels are hardened because ed25519 has no watch-only public-parent path — the whole tree is reached only from the seed.
//!
//! Season: the Six-Season double-seat, Season G thread (Cryptography · Rye-native, Monocypher-parity, audit-ready).
//! Design read: active-designing/date/20260815/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (Season G · the crypto parity wave — the library
//! that serves Kumara identity, Vault, Comlink, and the Lotus signed carry; this rung is the identity arc's account path, the ed25519 answer to the
//! wallet arc's crypto/bip44.rye).
//! Kin: crypto/slip10_ed25519.rye (the ed25519 HD tree this walks, GREEN on metal) · crypto/bip44.rye (the secp256k1 account-path sibling) ·
//! crypto/bip39_seed.rye (the seed that grows the master) · crypto/ed25519_sign.rye (the public derivation two rungs down). Monocypher
//! (vendor/monocypher, CC0/BSD-dual) is the parity DISCIPLINE target for the primitives beneath; the path convention and SLIP-0010's test vectors
//! are public standards, studied clean-room (.claude/rules/gratitude-licenses.md).
//!
//! HONEST SCOPE — software only, purely LOCAL, no network, no funds, no real device. Every key walked here is a TEST key derived from SLIP-0010's
//! own published test-vector seeds; this module calls no std.crypto. Constant-time discipline does not arise in the parser: a derivation path is
//! public structure (a device shows it), not a secret; only the keys it reaches are secret, and their timing-safety is crypto/slip10_ed25519.rye's
//! and crypto/ed25519_sign.rye's named horizon, not this parser's (crypto/CONSTANT_TIME.md). Growing a REAL Kumara identity and signing with its
//! key stays the custody gate (#3/#4) — the agent builds and verifies the derivation, never holds the maintainer's key.
//!
//! Parity is proven at selftest the replayable way the tree favours, against SLIP-0010's OWN published ed25519 test vectors (the spec's own
//! known-answers, quoted character for character from the canonical satoshilabs/slips slip-0010.md, never fabricated): walking each of the six
//! nodes of Test Vector 1 and Test Vector 2 BY ITS HUMAN PATH STRING ("m", "m/0'", … "m/0'/1'/2'/2'/1000000000'") reproduces EXACTLY the spec's
//! published private key, chain code, AND 0x00-prefixed public key at every node — so the path parser, the hardening requirement, and the walk are
//! all proven against a real standard answer without a single external fetch. The Kumara convention itself is proven: "m/44'/0'/0'/0'" parses to
//! the exact all-hardened index list, derive_identity and derive_path agree byte-for-byte, and a malformed path (a bare non-hardened index, no
//! master, a non-digit index, an index at 2³¹, a too-deep path, a trailing slash) each raises its named error.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run crypto/kumara_path.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const slip10 = @import("slip10_ed25519.rye");
const bip32 = @import("bip32.rye");
const hmac = @import("hmac_sha512.rye");

pub const kumara_path_version = "20260816.160000";

/// The fixed Kumara identity-path levels, named rather than scattered as magic numbers. The purpose is fixed by BIP-43 (44), reused by the ed25519
/// identity convention. A registered Grain SLIP-44 coin type is a named HORIZON — until then the coin slot is a caller-supplied value, so this
/// module fabricates no registry number it has not earned.
pub const purpose: u32 = 44;

/// A generous ceiling on a parsed path's depth. The Kumara convention is exactly four levels below the master; sixteen bounds the parser well
/// above any real identity path while staying under crypto/slip10_ed25519.rye's own thirty-two-level derivation ceiling.
pub const max_path_depth: u32 = 16;

/// The largest decimal an index string may carry (ten digits), so the parse loop is bounded and a wildly long token is refused early.
const max_index_digits: u32 = 10;

/// The faults this rung can raise, each refused at the edge before a wrong index or a malformed path walks the tree.
pub const KumaraPathError = error{
    /// A path that is empty, does not begin with the master 'm', has a missing or misplaced separator, an empty index token, or a trailing slash.
    BadPath,
    /// A bare index at or above 2³¹ (the hardened offset) — a level's value must stay below it, the hardening bit is added by the parser itself.
    IndexTooLarge,
    /// A level with no hardening marker — ed25519/SLIP-0010 admits only hardened derivation, so every Kumara-path level must carry a ' / h / H.
    NotHardened,
    /// A path deeper than max_path_depth levels — refused before the walk overruns its bound.
    PathTooDeep,
};

/// Parse a hardened-only ed25519 derivation path ("m", "m/44'/0'/0'/0'", "m/0'/1'") into `out` as the exact 32-bit index list, returning the
/// depth. EVERY level must carry a hardening marker (' or h or H) — the hardened offset (2³¹) is added to its value — because ed25519 has no
/// normal (public-parent) child; a bare level raises NotHardened. "m" alone yields zero indices (the master itself). No cryptography here: pure
/// text over a bounded decimal.
pub fn parse_path(out: *[max_path_depth]u32, path: []const u8) KumaraPathError!u32 {
    // invariant: a path names the master first — an empty path or one not rooted at 'm' cannot describe a node.
    if (path.len == 0) return error.BadPath;
    if (path[0] != 'm') return error.BadPath;

    var i: u32 = 1;
    var count: u32 = 0;
    while (i < path.len) {
        // Each level after the master opens with a single '/' separator.
        if (path[i] != '/') return error.BadPath;
        i += 1;

        // At least one decimal digit must follow the separator — no empty token, no trailing slash.
        if (i >= path.len or path[i] < '0' or path[i] > '9') return error.BadPath;

        var value: u32 = 0;
        var digits: u32 = 0;
        while (i < path.len and path[i] >= '0' and path[i] <= '9') : (i += 1) {
            // invariant: an index token never runs past ten digits — a u32 index needs at most ten, and this bounds the loop.
            if (digits >= max_index_digits) return error.IndexTooLarge;
            digits += 1;
            const d: u32 = path[i] - '0';
            // Overflow-safe accumulation kept entirely in u32: guard before the multiply and before the add so the bare value can never wrap or
            // reach the hardened offset. A valid bare value is 0..2³¹-1; the parser adds the hardened offset itself once the marker is seen.
            if (value > (bip32.hardened_offset - 1) / 10) return error.IndexTooLarge;
            value = value * 10;
            if (value > bip32.hardened_offset - 1 - d) return error.IndexTooLarge;
            value += d;
        }

        // invariant: ed25519 admits ONLY hardened derivation — every level must carry a ' / h / H marker; a bare index has no ed25519 child.
        if (i >= path.len or (path[i] != '\'' and path[i] != 'h' and path[i] != 'H')) return error.NotHardened;
        i += 1;

        // invariant: the parsed depth stays within its named ceiling before another level is recorded.
        if (count >= max_path_depth) return error.PathTooDeep;
        out[count] = value + bip32.hardened_offset;
        count += 1;
    }
    // invariant: a "m"-only path yields zero levels; every other path yields at least one and never more than the ceiling.
    assert(count <= max_path_depth);
    return count;
}

/// Derive the ed25519 node at `path` from `seed`: parse the human path, grow the master from the seed, then walk slip10's ckd_priv down each
/// parsed hardened index. Composes crypto/slip10_ed25519.rye entirely — the mathematics is proven there; here is only the walk.
pub fn derive_path(seed: []const u8, path: []const u8) (KumaraPathError || slip10.Slip10Error || hmac.HmacError)!slip10.Node {
    var indices: [max_path_depth]u32 = undefined;
    const count = try parse_path(&indices, path);
    var node = try slip10.master_from_seed(seed);
    var k: u32 = 0;
    while (k < count) : (k += 1) {
        // invariant: the walk never steps past the parsed depth.
        assert(k < max_path_depth);
        node = try slip10.ckd_priv(&node, indices[k]);
    }
    return node;
}

/// Derive a Kumara identity leaf m/44'/coin_type'/account'/index' directly from the three chosen level values, without a path string. All four
/// levels are hardened here by adding the hardened offset; there is no watch-only public path over ed25519, so every level must be hardened. This
/// is the ergonomic heart of "the Kumara identity path".
pub fn derive_identity(
    seed: []const u8,
    coin_type: u32,
    account: u32,
    index: u32,
) (KumaraPathError || slip10.Slip10Error || hmac.HmacError)!slip10.Node {
    // invariant: every level stays below 2³¹ before the hardening bit is added — a value at or above it would collide with the offset.
    if (coin_type >= bip32.hardened_offset or account >= bip32.hardened_offset or index >= bip32.hardened_offset) return error.IndexTooLarge;

    var node = try slip10.master_from_seed(seed);
    node = try slip10.ckd_priv(&node, purpose + bip32.hardened_offset);
    node = try slip10.ckd_priv(&node, coin_type + bip32.hardened_offset);
    node = try slip10.ckd_priv(&node, account + bip32.hardened_offset);
    node = try slip10.ckd_priv(&node, index + bip32.hardened_offset);
    return node;
}

fn nibble(c: u8) u8 {
    if (c >= '0' and c <= '9') return c - '0';
    // invariant: the vector hex uses only lowercase a–f beyond the digits.
    assert(c >= 'a' and c <= 'f');
    return c - 'a' + 10;
}

/// Compare two raw byte buffers — the check the direct helper and the path walk face, both raw (not hex).
fn slices_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) if (a[i] != b[i]) return false;
    return true;
}

/// Compare a raw byte buffer against its lowercase-hex spelling — the replayable check every node's private key, chain code, and public key face.
fn eq_hex(raw: []const u8, hex: []const u8) bool {
    if (raw.len * 2 != hex.len) return false;
    var i: u32 = 0;
    while (i < raw.len) : (i += 1) {
        if (raw[i] != nibble(hex[i * 2]) * 16 + nibble(hex[i * 2 + 1])) return false;
    }
    return true;
}

fn from_hex(out: []u8, hex: []const u8) u32 {
    // invariant: two hex chars name one byte, so the buffer must hold half the hex length.
    assert(hex.len % 2 == 0 and out.len * 2 >= hex.len);
    var i: u32 = 0;
    while (i < hex.len / 2) : (i += 1) out[i] = nibble(hex[i * 2]) * 16 + nibble(hex[i * 2 + 1]);
    return @intCast(hex.len / 2);
}

