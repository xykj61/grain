//! lotus/chorus.rye — ALES71: the chorus — a triangle-LFO modulated delay round a centre. ALES70 introduced the one genuinely new
//! arithmetic the modulated-delay family needs — a delay read at a FRACTIONAL position by linear interpolation of its two neighbours — and
//! drove it with the simplest honest motion, a one-way linear glide from a start to an end position (the flanger's sweep). The effect a
//! keeper actually reaches for is not a one-way sweep but a PERIODIC one: the delay swings gently up and back down round a centre, over and
//! over, and the dry mixed with that slowly-detuned copy of itself is the CHORUS — one voice made to sound like several.
//!
//! The crux is that A TRIANGLE LFO DRIVES THE SCALED DELAY ROUND A CENTRE. The interpolation read is ALES70's, verbatim; the only new thing
//! is how the scaled delay moves. Over one period P (a positive multiple of four, q = P/4) with phase p = k % P, the scaled delay is
//! d_s(k) = centre_scaled + triangle(depth_scaled, P, k), a symmetric wave with EXACT ANCHORS at the quarter points: 0 at p = 0 and p = 2q
//! (the centre), +depth at p = q (the top), −depth at p = 3q (the bottom), and honestly `@divTrunc`-quantized between (a scaled delay rarely
//! lands on a whole triangle step, exactly as the ALES70 ramp is between its endpoints). Then near = dry[i − d_whole], far = dry[i − d_whole
//! − 1], delayed = (near·(glide_scale − frac) + far·frac)/glide_scale, and y[i] = saturate(x[i] + level·delayed). Every read is off a FROZEN
//! snapshot of the dry prefix (the ALES68/ALES70 idiom, reused), so a moving read never reads a sample it just wrote. The delay never dips
//! below one whole sample (centre − depth ≥ glide_scale) and never reaches past the widest clip ((centre + depth)/glide_scale ≤ max_clip),
//! both checked before any write. A zero-depth chorus is exactly ALES70's glide at its centre, byte-for-byte (the periodic driver reduces to
//! the one-way one when it does not move). The wet is mixed at level = num/den (num ≤ den) and the sum saturates once (ALES3's saturation).
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES71.
//! Design read: active-designing/20260814-194730_fill-ales71-lotus-chorus-triangle-lfo-modulated-delay.md
//! Stands on: lotus/glide.rye (ALES70) — the fractional interpolation this drives with a periodic LFO instead of a one-way ramp, whose
//! zero-depth case this equals byte-for-byte; lotus/timeline.rye (ALES2) — the Clip, sample_max, max_clip, and the one true saturate.
//!
//! HONEST SCOPE — software only, purely LOCAL. Bounded in-process i16 PCM in one clip, siloed to lotus/. No socket, no network, no keys, no
//! funds, no real device, no real sample rate — the delay is counted in scaled sample indices and the period in samples, not milliseconds or
//! hertz (the real-time twin follows as echo_ms and multitap_ms did). No lookahead beyond the snapshot read. The dry prefix is snapshotted
//! into one bounded [max_clip]i16 scratch (glide/taps' width); the triangle, the interpolation, and the wet mix all run in i64 and saturate
//! once, so nothing on the path can overflow.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/chorus.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");
const glide = @import("glide.rye");

pub const chorus_version = "20260814.194730";

/// The chorus's faults, one consistent name each: a period that is not a positive multiple of four (the triangle's quarter anchors need
/// P/4 whole), a swing that would dip below one whole sample (centre − depth < glide_scale) or reach past the widest clip
/// (centre + depth whole > max_clip), a wet level above unity or with a zero denominator, and a span outside the samples. Each refused
/// before any write.
pub const ChorusError = error{
    /// A period that is not a positive multiple of four, or wider than max_clip — refused, no write.
    BadPeriod,
    /// A negative depth, or a swing whose bottom (centre − depth) falls under one whole sample — refused, no write.
    BadDepth,
    /// A swing whose top (centre + depth) whole delay is longer than max_clip samples — refused, no write.
    BadDelay,
    /// A wet numerator above the denominator (a voice louder than the dry) or a zero denominator — refused, no write.
    BadLevel,
    /// A span outside the current samples — refused, no write.
    BadRange,
};

/// The scaled delay at span offset `k`, driven by a symmetric triangle LFO of `depth_scaled` round `centre_scaled` over `period` samples.
/// Exact at the quarter anchors — `centre` at k ≡ 0 and k ≡ period/2, `centre + depth` at k ≡ period/4, `centre − depth` at k ≡ 3·period/4 —
/// and honestly `@divTrunc`-quantized between. Periodic: offset `period` returns the same value. Pure and public, so the modulation is
/// testable directly. The caller validates `period` (a positive multiple of four) before calling; the helper asserts it.
pub fn triangle_delay_at(centre_scaled: i64, depth_scaled: i64, period: u32, k: u32) i64 {
    // invariant: the period is a positive multiple of four, so its quarter q = period/4 is whole and the four anchors land exactly.
    assert(period > 0 and period % 4 == 0);
    // invariant: the depth is non-negative — a swing has a magnitude, never a sign.
    assert(depth_scaled >= 0);
    const q: i64 = @divTrunc(@as(i64, period), 4);
    const p: i64 = @as(i64, k % period); // phase within one period, in [0, period)
    // Piecewise linear triangle over the four quarters, exact at each anchor: centre → top → centre → bottom → centre.
    const off: i64 = if (p < q)
        @divTrunc(depth_scaled * p, q) // centre → top
    else if (p < 2 * q)
        @divTrunc(depth_scaled * (2 * q - p), q) // top → centre
    else if (p < 3 * q)
        -@divTrunc(depth_scaled * (p - 2 * q), q) // centre → bottom
    else
        -@divTrunc(depth_scaled * (4 * q - p), q); // bottom → centre
    // invariant: the LFO never swings past its depth in either direction, so the delay stays within [centre − depth, centre + depth].
    assert(off >= -depth_scaled and off <= depth_scaled);
    return centre_scaled + off;
}

/// Apply a chorus over `count` samples starting at `start` in place in `clip`: a triangle LFO of `depth_scaled` round `centre_scaled` over
/// `period` samples drives the scaled delay, each sample read by LINEAR INTERPOLATION of the two dry neighbours straddling its fractional
/// delay (ALES70's read, verbatim), then mixed with the dry at `num/den` — y[i] = saturate(x[i] + level·interp(dry, i, d_s(i))). Every read
/// is off a FROZEN snapshot of the dry prefix, so a moving read never reads a sample it just wrote. A zero depth is a fixed whole delay at
/// the centre, equal to ALES70's glide at that centre byte-for-byte. The wet plus dry saturates once. Refuses BadPeriod, BadDepth, BadDelay,
/// BadLevel, and BadRange before any write; on refusal the clip is untouched. Values only — never a length.
/// Validate a chorus's LFO, mix level, and span against a clip length ONCE, before any write — factored out of `chorus` so the stereo lift
/// (`stereo_chorus`, ALES179) can refuse against the shared length before either channel is snapshotted, mirroring ALES75's `ring_mod.precheck`
/// and ALES72's `vibrato.precheck`. Refuses a period not a positive multiple of four (or wider than max_clip) BadPeriod, a negative depth or a
/// swing dipping below one whole sample BadDepth, a swing top past the widest clip BadDelay, a zero denominator or a wet above unity BadLevel,
/// and a span outside `clip_len` BadRange.
pub fn precheck(clip_len: u32, start: u32, count: u32, centre_scaled: i64, depth_scaled: i64, period: u32, num: u32, den: u32) ChorusError!void {
    // invariant: the period is a positive multiple of four (the triangle's quarter anchors need P/4 whole) and no wider than the widest
    // clip, so the LFO is bounded. Checked at the edge before any read.
    if (period == 0 or period % 4 != 0) return error.BadPeriod;
    if (period > timeline.max_clip) return error.BadPeriod;
    // invariant: the depth is non-negative and the swing's bottom stays at or above one whole sample — below that there is no `far`
    // neighbour to interpolate toward before the clip, and the delay is meaningless.
    if (depth_scaled < 0) return error.BadDepth;
    if (centre_scaled - depth_scaled < glide.glide_scale) return error.BadDepth;
    // invariant: the swing's top whole delay fits the widest clip, so the reach is bounded.
    if (@divTrunc(centre_scaled + depth_scaled, glide.glide_scale) > @as(i64, timeline.max_clip)) return error.BadDelay;
    // invariant: the wet is a legal fraction at or below unity — a nonzero denominator, a numerator no larger. num == 0 (dry only) is legal.
    if (den == 0) return error.BadLevel;
    if (num > den) return error.BadLevel;
    // invariant: the span lies wholly within the current samples — checked without underflow (count vs the remainder).
    if (start > clip_len) return error.BadRange;
    if (count > clip_len - start) return error.BadRange;
}

pub fn chorus(
    clip: *timeline.Clip,
    start: u32,
    count: u32,
    centre_scaled: i64,
    depth_scaled: i64,
    period: u32,
    num: u32,
    den: u32,
) ChorusError!void {
    // invariant: the LFO, mix level, and span are all legal — the five faults refused before any read, so a refusal never half-writes.
    // ALES179's stereo lift reuses this same `precheck` against the shared length.
    try precheck(clip.len, start, count, centre_scaled, depth_scaled, period, num, den);

    const end: u32 = start + count;
    // Snapshot the dry prefix [0, end) BEFORE any write, so every interpolated read is of the ORIGINAL audio — the ALES68/ALES70/graft
    // snapshot-before-write idiom, reused. One bounded scratch, the width glide and taps already carry.
    var dry: [timeline.max_clip]i16 = [_]i16{0} ** timeline.max_clip;
    {
        var j: u32 = 0;
        // invariant: end never exceeds the clip's length, so the snapshot stays within the bounded scratch.
        assert(end <= clip.len and end <= dry.len);
        while (j < end) : (j += 1) dry[j] = clip.buf[j];
    }

    const scale: i64 = glide.glide_scale;
    const wet_num: i64 = @as(i64, num);
    const wet_den: i64 = @as(i64, den);
    var k: u32 = 0;
    while (k < count) : (k += 1) {
        const i: u32 = start + k;
        const x: i64 = @as(i64, dry[i]); // the dry input (from the frozen snapshot — identical to clip.buf[i], not yet written)
        const d_s: i64 = triangle_delay_at(centre_scaled, depth_scaled, period, k);
        // invariant: the LFO never leaves the validated delay window, so the whole delay stays at least one sample and within the clip.
        assert(d_s >= scale and @divTrunc(d_s, scale) <= @as(i64, timeline.max_clip));
        const d_whole: i64 = @divTrunc(d_s, scale);
        const frac: i64 = d_s - d_whole * scale; // in [0, glide_scale)
        // invariant: the fractional part is a legal weight strictly under the scale.
        assert(frac >= 0 and frac < scale);
        // The two dry neighbours straddling the fractional delay: `near` at the smaller delay, `far` one sample further back. Each is
        // silence before the clip (index < 0). Read from the frozen snapshot.
        const near_ix: i64 = @as(i64, i) - d_whole;
        const far_ix: i64 = near_ix - 1;
        const near_val: i64 = if (near_ix >= 0) @as(i64, dry[@intCast(near_ix)]) else 0;
        const far_val: i64 = if (far_ix >= 0) @as(i64, dry[@intCast(far_ix)]) else 0;
        // invariant: both neighbours already fit the i16 rail — they are dry audio, never a wide intermediate.
        assert(near_val >= @as(i64, timeline.sample_min) and near_val <= @as(i64, timeline.sample_max));
        assert(far_val >= @as(i64, timeline.sample_min) and far_val <= @as(i64, timeline.sample_max));
        // Linear interpolation (ALES70's read): near weighted by (scale − frac), far by frac, divided once. frac = 0 returns near exactly;
        // frac = scale/2 returns the exact average. |near|,|far| <= 32768 and the weights sum to glide_scale, so the product fits i64.
        const delayed: i64 = @divTrunc(near_val * (scale - frac) + far_val * frac, scale);
        // The wet voice at level num/den (num <= den, so |wet| <= |delayed|), then the dry plus wet saturates ONCE over the true sum.
        const wet: i64 = @divTrunc(wet_num * delayed, wet_den);
        // invariant: the wet voice is no louder in magnitude than the interpolated read — a level at or below unity only attenuates it.
        assert((if (wet < 0) -wet else wet) <= (if (delayed < 0) -delayed else delayed));
        clip.buf[i] = timeline.saturate(x + wet);
    }
    // invariant: a chorus changes sample values only, never the clip's length or bound.
    assert(start + count <= clip.len);
    assert(clip.len <= clip.buf.len);
}

// --- selftest: level = 0 is the dry identity; a zero-depth chorus is EXACTLY ALES70's glide at its centre (byte-for-byte — the periodic
//     driver reduces to the one-way one at rest); the triangle honors its four quarter anchors and repeats one period later; a hand-computed
//     modulated read matches exactly; a loud wet+dry sum SATURATES rather than wraps; and each fault refuses by name, the clip untouched ---

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn load_clip(clip: *timeline.Clip, src: []const i16) !void {
    try timeline.splice(clip, 0, src);
}

fn run_selftest() !u8 {
    const scale = glide.glide_scale;

    // 1. level = 0 IS THE DRY IDENTITY — a zero wet numerator adds nothing, the dry signal passes byte-for-byte under any modulation.
    {
        const sig = [_]i16{ 1000, -2000, 3000, -4000, 5000, -6000, 7000, -8000 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &sig);
        try chorus(&clip, 0, clip.len, 3 * scale, 1 * scale, 8, 0, 4); // wet 0/4, the voice turned fully off
        if (!eq(clip.samples(), &sig)) return error.ZeroLevelNotIdentity;
    }

    // 2. A ZERO-DEPTH CHORUS IS EXACTLY ALES70's GLIDE AT ITS CENTRE — depth == 0, so the LFO sits at rest and the delay is a fixed whole
    //    `centre`: the chorus equals glide(centre, centre) byte-for-byte (the periodic driver reduces to the one-way one when it does not
    //    move). Both tools run.
    {
        const sig = [_]i16{ 100, 200, 300, 400, 500, 600, 700, 800 };
        var chorused = timeline.Clip{};
        try load_clip(&chorused, &sig);
        try chorus(&chorused, 0, chorused.len, 3 * scale, 0, 8, 1, 1);
        var glided = timeline.Clip{};
        try load_clip(&glided, &sig);
        try glide.glide(&glided, 0, glided.len, 3 * scale, 3 * scale, 1, 1);
        if (!eq(chorused.samples(), glided.samples())) return error.ZeroDepthNotGlide;
    }

    // 3. THE TRIANGLE HONORS ITS FOUR QUARTER ANCHORS AND REPEATS — centre at k=0 and k=period/2, +depth at k=period/4, −depth at
    //    k=3·period/4, and the same value one full period later. Proven directly on the pure helper.
    {
        const centre: i64 = 4 * scale;
        const depth: i64 = 2 * scale;
        const period: u32 = 8; // q = 2
        if (triangle_delay_at(centre, depth, period, 0) != centre) return error.AnchorZeroWrong;
        if (triangle_delay_at(centre, depth, period, 2) != centre + depth) return error.AnchorTopWrong; // k = q
        if (triangle_delay_at(centre, depth, period, 4) != centre) return error.AnchorHalfWrong; // k = 2q
        if (triangle_delay_at(centre, depth, period, 6) != centre - depth) return error.AnchorBottomWrong; // k = 3q
        if (triangle_delay_at(centre, depth, period, 8) != centre) return error.PeriodNotRepeating; // k = period
        if (triangle_delay_at(centre, depth, period, 10) != centre + depth) return error.PeriodTopNotRepeating; // k = period + q
        // a zero depth is flat at the centre everywhere
        var k: u32 = 0;
        while (k < 12) : (k += 1) if (triangle_delay_at(centre, 0, period, k) != centre) return error.ZeroDepthNotFlat;
    }

    // 4. A HAND-COMPUTED MODULATED READ — centre = 2·scale, depth = 1·scale, period = 4 (q = 1), wet 1/1. The triangle lands the delay on
    //    WHOLE samples at every offset, so each read is an exact integer tap and computable by hand:
    //      k: 0  1  2  3  4  5      d_whole via triangle_delay_at(2·s, 1·s, 4, k)/s:
    //      p: 0  1  2  3  0  1
    //      delay(k): centre(2), top(3), centre(2), bottom(1), centre(2), top(3)
    //    On sig[i] = i·1000 (dry[j]=0 for j<0), y[i] = dry[i] + dry[i − delay(i)]:
    //      i0 d2: 0    + dry[-2]=0        = 0
    //      i1 d3: 1000 + dry[-2]=0        = 1000
    //      i2 d2: 2000 + dry[0]=0         = 2000
    //      i3 d1: 3000 + dry[2]=2000      = 5000
    //      i4 d2: 4000 + dry[2]=2000      = 6000
    //      i5 d3: 5000 + dry[2]=2000      = 7000
    {
        const sig = [_]i16{ 0, 1000, 2000, 3000, 4000, 5000 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &sig);
        try chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, 4, 1, 1);
        const want = [_]i16{ 0, 1000, 2000, 5000, 6000, 7000 };
        if (!eq(clip.samples(), &want)) return error.ModulatedReadWrong;
    }

    // 5. A LOUD WET+DRY SUM SATURATES RATHER THAN WRAPS — a loud dry sample under a loud in-phase read exceeds the i16 rail; the sum pins to
    //    sample_max (ALES3's ceiling) instead of wrapping negative. A steady 30000, centre 1·scale depth 0 (a fixed whole delay of 1), wet
    //    1/1 sums 30000 + 30000 = 60000 from index 1 on, saturated to 32767.
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &[_]i16{ 30000, 30000, 30000, 30000 });
        try chorus(&clip, 0, clip.len, 1 * scale, 0, 4, 1, 1);
        const want = [_]i16{ 30000, 32767, 32767, 32767 };
        if (!eq(clip.samples(), &want)) return error.SaturateWrong;
    }

    // 6a. A PERIOD not a positive multiple of four refuses BadPeriod; a period wider than max_clip refuses BadPeriod — before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, 6, 1, 2)) |_| return error.OddPeriodSlipped else |e| if (e != error.BadPeriod) return error.WrongOddPeriod;
        if (!eq(clip.samples(), &three)) return error.RefusedOddPeriodMutated;
        if (chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, 0, 1, 2)) |_| return error.ZeroPeriodSlipped else |e| if (e != error.BadPeriod) return error.WrongZeroPeriod;
        if (!eq(clip.samples(), &three)) return error.RefusedZeroPeriodMutated;
        const wide: u32 = timeline.max_clip + 4;
        if (chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, wide, 1, 2)) |_| return error.WidePeriodSlipped else |e| if (e != error.BadPeriod) return error.WrongWidePeriod;
        if (!eq(clip.samples(), &three)) return error.RefusedWidePeriodMutated;
    }

    // 6b. A DEPTH that swings below one whole sample refuses BadDepth; a swing top past max_clip refuses BadDelay — each before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        // centre 1·scale, depth 1·scale → bottom = 0 < glide_scale
        if (chorus(&clip, 0, clip.len, 1 * scale, 1 * scale, 4, 1, 2)) |_| return error.LowSwingSlipped else |e| if (e != error.BadDepth) return error.WrongLowSwing;
        if (!eq(clip.samples(), &three)) return error.RefusedLowSwingMutated;
        // top = centre + depth whole past max_clip
        const wide_top: i64 = (@as(i64, timeline.max_clip) + 1) * scale;
        if (chorus(&clip, 0, clip.len, wide_top, 2 * scale, 4, 1, 2)) |_| return error.WideTopSlipped else |e| if (e != error.BadDelay) return error.WrongWideTop;
        if (!eq(clip.samples(), &three)) return error.RefusedWideTopMutated;
    }

    // 6c. A WET ABOVE UNITY refuses BadLevel; a zero denominator refuses BadLevel — each before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, 4, 5, 4)) |_| return error.LoudWetSlipped else |e| if (e != error.BadLevel) return error.WrongLoudWet;
        if (!eq(clip.samples(), &three)) return error.RefusedLoudWetMutated;
        if (chorus(&clip, 0, clip.len, 2 * scale, 1 * scale, 4, 1, 0)) |_| return error.ZeroDenSlipped else |e| if (e != error.BadLevel) return error.WrongZeroDen;
        if (!eq(clip.samples(), &three)) return error.RefusedZeroDenMutated;
    }

    // 6d. AN OUT-OF-RANGE SPAN refuses BadRange before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (chorus(&clip, 2, 5, 2 * scale, 1 * scale, 4, 1, 2)) |_| return error.BadRangeSlipped else |e| if (e != error.BadRange) return error.WrongBadRange;
        if (!eq(clip.samples(), &three)) return error.RefusedRangeMutated;
    }

    print("GREEN ales-chorus: the CHORUS — a triangle-LFO modulated delay round a centre, the first PERIODIC modulated delay. The " ++
        "interpolation read is ALES70's, verbatim; the new thing is how the scaled delay moves — a symmetric triangle round centre_scaled " ++
        "with EXACT anchors at the quarter points (centre at k≡0 and k≡period/2, +depth at period/4, −depth at 3·period/4), honestly " ++
        "quantized between, off a FROZEN dry snapshot (the ALES68/ALES70 idiom, reused), mixed dry at num/den and saturated once. level = 0 " ++
        "is the dry identity; a ZERO-DEPTH chorus is EXACTLY ALES70's glide at its centre byte-for-byte (the periodic driver reduces to the " ++
        "one-way one at rest); the triangle honors its four quarter anchors and repeats one period later; a hand-computed modulated read " ++
        "matches exactly; a loud wet+dry sum SATURATES to the i16 rail rather than wrapping; and a period not a positive multiple of four " ++
        "refuses BadPeriod, a swing below one whole sample BadDepth, a swing top past max_clip BadDelay, a wet above unity or a zero " ++
        "denominator BadLevel, an out-of-range span BadRange, each leaving the clip untouched; no socket, no network, no keys, no funds, no " ++
        "real device, no real sample rate. The vibrato (this delay heard wet-only) and the flanger (a shorter one with feedback) follow\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
