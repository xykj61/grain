//! lotus/album_merge.rye — ALES235: two independent sets of record changes, reconciled. ALES232 answered what changed between two
//! versions of a record; yet a diff only ever compares two. The moment more than one hand touches a record the honest question
//! changes — one engineer remasters the verse while another drops a rough take and adds a bridge, both from the same master, and the
//! next morning the two edits must become one record. A diff cannot answer that; a MERGE can, and a merge is the whole reason a diff
//! exists. This rung mirrors library_merge (ALES234) one level down: a common ancestor `base` and two descendants `ours` and
//! `theirs`, every track reconciled into one verdict — resolved, dropped, or a named conflict.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES235.
//! Design read: active-designing/20260815-150324_fill-ales235-lotus-album-merge.md
//! Stands on: lotus/album_find.rye (ALES231) — the find / digest_of resolve this composes on, the same resolve album_diff uses;
//! lotus/album_manifest.rye (ALES224) — the three opened AlbumManifest values this reconciles. It mirrors library_merge (ALES234) one
//! level down (album→track, catalog→record), unchanged in shape, and stands BESIDE album_diff (ALES232): both are second-order
//! primitives over one find, and a merge is two diffs reconciled against one base. No new hash, no new frame.
//!
//! THE CRUX — a merge is a decision procedure, not a guess. Per track name, where only one side changed it the merge takes that
//! change; where both sides made the SAME change (same new digest, or both removed it) the merge takes it and marks it agreed; where
//! both sides changed it to DIFFERENT content (or one changed while the other removed) the merge names a conflict carrying all three
//! digests — never silently resolved. The content-address digest is the whole comparison — two matching digests mean identical
//! bundle bytes, two differing digests mean the track moved — so the merge needs no byte compare and no new hash, only the handles
//! the three manifests already carry.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded classification over in-process fields already proven whole by
//! open_album_manifest, siloed to lotus/. Content-addressing on every handle it reports, never a signature: it reconciles what two
//! hands changed, not who made a change — the signed carry remains a later crypto seam on Keaton's word. No real file, no DAC, no
//! acoustic or electrical fact, no network, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/album_merge.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const album_manifest = @import("album_manifest.rye");
const album_find = @import("album_find.rye");
const render_album = @import("render_album.rye");

pub const album_merge_version = "20260815.150324";

/// Which hand a clean verdict came from. `unchanged` — neither side touched the track (it equals base). `ours` / `theirs` — one
/// side's change was taken because the other left the track at base. `agreed` — both sides made the same change.
pub const Source = enum { unchanged, ours, theirs, agreed };

/// One track the merged record holds: its name, the content-address digest chosen for the merge, and the source of that choice. Both
/// slices point into the opened manifests the merge read.
pub const Resolution = struct {
    name: []const u8,
    digest: []const u8,
    source: Source,
};

/// One track the merge removes from the record: its name and the source that removed it — `ours` or `theirs` for a one-sided
/// removal, `agreed` when both sides removed it. `unchanged` never drops a track.
pub const Drop = struct {
    name: []const u8,
    source: Source,
};

/// One track the two sides disagree on: both changed it from base, to different content, or one changed it while the other removed
/// it. Every digest is a slice into an opened manifest, or `""` where that side does not hold the track at all. A conflict is named,
/// never resolved — a keeper's ear decides it.
pub const Conflict = struct {
    name: []const u8,
    base_digest: []const u8,
    our_digest: []const u8,
    their_digest: []const u8,
};

/// The most tracks a merged verdict can hold in its present-bearing lists. A track is `resolved` or in `conflicts` only if it is
/// present in `ours` or `theirs`, so two records' worth is the true ceiling; sized from max_tracks so the fixed arrays cannot
/// overflow and every walk terminates.
pub const max_present: u32 = 2 * album_manifest.max_tracks;

/// The whole verdict of reconciling `base`, `ours`, and `theirs`. `dropped` is bounded by one record's tracks — only a base track
/// can be removed. Every track across the three records lands in exactly one of resolved / dropped / conflicts.
pub const Merge = struct {
    resolved: [max_present]Resolution = undefined,
    resolved_count: u32 = 0,
    dropped: [album_manifest.max_tracks]Drop = undefined,
    dropped_count: u32 = 0,
    conflicts: [max_present]Conflict = undefined,
    conflict_count: u32 = 0,
};

/// True when no track conflicts — the merge stands on its own, no keeper's ear needed. A caller reads one bool rather than walking
/// the conflict list.
pub fn is_clean(m: *const Merge) bool {
    return m.conflict_count == 0;
}

/// The content-address digest of `name` in `am`, or null when the record does not hold it — the optional the three-way rule reads.
/// Composes on the ALES231 resolve: a find to the index, then digest_of at that index.
fn digest_in(am: *const album_manifest.AlbumManifest, name: []const u8) ?[]const u8 {
    if (album_find.find(am, name)) |i| return album_find.digest_of(am, i);
    return null;
}

/// True when two optional digests are equal — both absent is equal, one absent is not, both present compares bytes. Absence is a
/// value here, so "removed on both sides" reads as agreement and "present only in base" reads as a change from base.
fn eq_opt(a: ?[]const u8, b: ?[]const u8) bool {
    if (a == null and b == null) return true;
    if (a == null or b == null) return false;
    return std.mem.eql(u8, a.?, b.?);
}

/// Classify one track `name` present in at least one record into `m`, by the three-way rule. Reads each side's digest as an optional
/// and appends exactly one verdict — a resolution, a drop, or a conflict.
fn classify_name(
    m: *Merge,
    base: *const album_manifest.AlbumManifest,
    ours: *const album_manifest.AlbumManifest,
    theirs: *const album_manifest.AlbumManifest,
    name: []const u8,
) void {
    const b = digest_in(base, name);
    const o = digest_in(ours, name);
    const t = digest_in(theirs, name);
    // invariant: the name came from one of the three records, so at least one side holds it.
    assert(b != null or o != null or t != null);

    if (eq_opt(o, t)) {
        // both sides agree — take what they agree on, or drop it if they agree it is gone.
        if (o) |od| {
            const src: Source = if (eq_opt(o, b)) .unchanged else .agreed;
            m.resolved[m.resolved_count] = .{ .name = name, .digest = od, .source = src };
            m.resolved_count += 1;
        } else {
            // both absent, so base must hold it (the name came from somewhere) — both removed it.
            m.dropped[m.dropped_count] = .{ .name = name, .source = .agreed };
            m.dropped_count += 1;
        }
    } else if (eq_opt(o, b)) {
        // ours left the track at base; only theirs changed it — take theirs (present) or honor its removal (absent).
        if (t) |td| {
            m.resolved[m.resolved_count] = .{ .name = name, .digest = td, .source = .theirs };
            m.resolved_count += 1;
        } else {
            m.dropped[m.dropped_count] = .{ .name = name, .source = .theirs };
            m.dropped_count += 1;
        }
    } else if (eq_opt(t, b)) {
        // theirs left the track at base; only ours changed it — take ours (present) or honor its removal (absent).
        if (o) |od| {
            m.resolved[m.resolved_count] = .{ .name = name, .digest = od, .source = .ours };
            m.resolved_count += 1;
        } else {
            m.dropped[m.dropped_count] = .{ .name = name, .source = .ours };
            m.dropped_count += 1;
        }
    } else {
        // both sides changed the track, to different content or one to a removal — a conflict, named not guessed.
        m.conflicts[m.conflict_count] = .{
            .name = name,
            .base_digest = b orelse "",
            .our_digest = o orelse "",
            .their_digest = t orelse "",
        };
        m.conflict_count += 1;
    }
}

/// Reconcile `base`, `ours`, and `theirs` into one Merge. Visit every distinct track name exactly once — base in order, then names
/// only ours holds, then names only theirs holds — and classify each by the three-way rule. Bounded on open, so the walk is total
/// and the verdict infallible.
pub fn merge(
    base: *const album_manifest.AlbumManifest,
    ours: *const album_manifest.AlbumManifest,
    theirs: *const album_manifest.AlbumManifest,
) Merge {
    // invariant: no record names more tracks than the shared bound — open_album_manifest already proved it, re-asserted here.
    assert(base.count <= album_manifest.max_tracks and ours.count <= album_manifest.max_tracks and theirs.count <= album_manifest.max_tracks);
    var m: Merge = .{};
    var visited: u32 = 0;

    // Every base name — each is classified once regardless of what the descendants did with it.
    var i: u32 = 0;
    while (i < base.count) : (i += 1) {
        classify_name(&m, base, ours, theirs, album_find.name_of(base, i));
        visited += 1;
    }

    // Names ours holds that base did not — a fresh track on our side.
    var j: u32 = 0;
    while (j < ours.count) : (j += 1) {
        const name = album_find.name_of(ours, j);
        if (album_find.find(base, name) == null) {
            classify_name(&m, base, ours, theirs, name);
            visited += 1;
        }
    }

    // Names theirs holds that neither base nor ours did — a fresh track on their side alone.
    var k: u32 = 0;
    while (k < theirs.count) : (k += 1) {
        const name = album_find.name_of(theirs, k);
        if (album_find.find(base, name) == null and album_find.find(ours, name) == null) {
            classify_name(&m, base, ours, theirs, name);
            visited += 1;
        }
    }

    // invariant: every distinct name landed in exactly one list — the three tallies account for the whole union.
    assert(m.resolved_count + m.dropped_count + m.conflict_count == visited);
    // invariant: no list overflowed its bound — present-bearing lists by two records, drops by one.
    assert(m.resolved_count <= max_present and m.conflict_count <= max_present and m.dropped_count <= album_manifest.max_tracks);
    return m;
}

// --- selftest: THE CLEAN LAW — one-sided changes are taken with zero conflicts, each naming its hand, a one-sided removal drops
//     cleanly; THE AGREEMENT LAW — both sides making the same change is clean and marked agreed; THE CONFLICT LAW — both sides
//     changing a track differently (or change-vs-remove) is named a conflict carrying base/our/their digests; THE UNTOUCHED LAW —
//     a track neither side changed resolves unchanged with its base digest; THE IDENTITY LAW — merge(base, base, base) resolves
//     every track unchanged, zero drops, zero conflicts -----------------------------------------------------------------------------

/// Seal a small album manifest over stand-in bundles into `out`, returning its length — the content address a keeper holds for a
/// whole record. Any bytes serve as a bundle here; the manifest addresses their bytes, so equal bytes mean an equal digest (an
/// unchanged track) and different bytes mean a moved digest (a changed track).
fn make_album(out: []u8, names: []const []const u8, bundles: []const []const u8) !u32 {
    // invariant: a witness helper builds a small, well-formed record — the two arrays run in lockstep.
    assert(names.len == bundles.len);
    var tracks: [8]render_album.TrackIn = undefined;
    var i: u32 = 0;
    while (i < names.len) : (i += 1) tracks[i] = .{ .name = names[i], .bundle = bundles[i] };
    return album_manifest.seal_album_manifest(out, tracks[0..names.len]);
}

/// Find a resolution by name in a merge, or null — a witness reader so a law can assert on one track without a fixed index.
fn resolution_of(m: *const Merge, name: []const u8) ?Resolution {
    var i: u32 = 0;
    while (i < m.resolved_count) : (i += 1) {
        if (std.mem.eql(u8, m.resolved[i].name, name)) return m.resolved[i];
    }
    return null;
}

fn run_selftest() !u8 {
    // Stand-in bundle bytes. A `*b` variant shares a name's slot but carries different bytes — a remaster, so a moved digest.
    const b0 = "LOTUSBND....first bundle bytes....\x01\x02\x03";
    const b0b = "LOTUSBND....first bundle REMASTER\x01\x02\x04";
    const b0c = "LOTUSBND....first bundle OTHER....\x01\x02\x05";
    const b1 = "LOTUSBND....second bundle bytes...\x04\x05\x06";
    const b1b = "LOTUSBND....second bundle REMASTER\x04\x05\x07";
    const b2 = "LOTUSBND....third bundle bytes....\x07\x08\x09";
    const b4 = "LOTUSBND....fourth bundle bytes...\x0a\x0b\x0c";
    const b5 = "LOTUSBND....fifth bundle bytes....\x0d\x0e\x0f";

    // 1. THE CLEAN LAW + THE UNTOUCHED LAW — every track changed by at most one side; the merge takes each change, names its hand,
    //    and drops a one-sided removal, all with zero conflicts.
    //    base:  {intro b0, verse b1, hook b2, jam b4}
    //    ours:  {intro b0 (unchanged), verse b1b (ours changed), hook b2 (unchanged), bridge b5 (ours added)}  [ours removed jam]
    //    theirs:{intro b0b (theirs changed), verse b1 (unchanged), hook b2 (unchanged), jam b4 (unchanged)}    [theirs kept jam]
    {
        var base_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var ours_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var theirs_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const bn = try make_album(base_rec[0..], &.{ "intro", "verse", "hook", "jam" }, &.{ b0, b1, b2, b4 });
        const on = try make_album(ours_rec[0..], &.{ "intro", "verse", "hook", "bridge" }, &.{ b0, b1b, b2, b5 });
        const tn = try make_album(theirs_rec[0..], &.{ "intro", "verse", "hook", "jam" }, &.{ b0b, b1, b2, b4 });
        const base = try album_manifest.open_album_manifest(base_rec[0..bn]);
        const ours = try album_manifest.open_album_manifest(ours_rec[0..on]);
        const theirs = try album_manifest.open_album_manifest(theirs_rec[0..tn]);

        const g = merge(&base, &ours, &theirs);
        if (!is_clean(&g)) return error.CleanNotClean;
        if (g.conflict_count != 0) return error.CleanConflictLeaked;

        // intro: ours unchanged, theirs changed → take theirs.
        const intro = resolution_of(&g, "intro") orelse return error.IntroMissing;
        if (intro.source != .theirs) return error.IntroSourceWrong;
        if (!std.mem.eql(u8, intro.digest, digest_in(&theirs, "intro").?)) return error.IntroDigestWrong;
        // verse: theirs unchanged, ours changed → take ours.
        const verse = resolution_of(&g, "verse") orelse return error.VerseMissing;
        if (verse.source != .ours) return error.VerseSourceWrong;
        if (!std.mem.eql(u8, verse.digest, digest_in(&ours, "verse").?)) return error.VerseDigestWrong;
        // hook: neither side changed → unchanged, base digest.
        const hook = resolution_of(&g, "hook") orelse return error.HookMissing;
        if (hook.source != .unchanged) return error.HookSourceWrong; // THE UNTOUCHED LAW
        if (!std.mem.eql(u8, hook.digest, digest_in(&base, "hook").?)) return error.HookDigestWrong;
        // bridge: ours added, theirs never had it → take ours (clean add).
        const bridge = resolution_of(&g, "bridge") orelse return error.BridgeMissing;
        if (bridge.source != .ours) return error.BridgeSourceWrong;
        // jam: ours removed, theirs left at base → clean removal by ours.
        if (resolution_of(&g, "jam") != null) return error.JamStillPresent;
        if (g.dropped_count != 1) return error.DropCountWrong;
        if (!std.mem.eql(u8, g.dropped[0].name, "jam")) return error.DropNameWrong;
        if (g.dropped[0].source != .ours) return error.DropSourceWrong;
        // four tracks remain in the merged record: intro, verse, hook, bridge.
        if (g.resolved_count != 4) return error.ResolvedCountWrong;
    }

    // 2. THE AGREEMENT LAW — both sides make the SAME change: an identical remaster reads agreed; both removing a track drops it agreed.
    //    base:  {intro b0, verse b1}
    //    ours:  {intro b0b}            [ours remastered intro, ours removed verse]
    //    theirs:{intro b0b}            [theirs remastered intro identically, theirs removed verse]
    {
        var base_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var ours_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var theirs_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const bn = try make_album(base_rec[0..], &.{ "intro", "verse" }, &.{ b0, b1 });
        const on = try make_album(ours_rec[0..], &.{"intro"}, &.{b0b});
        const tn = try make_album(theirs_rec[0..], &.{"intro"}, &.{b0b});
        const base = try album_manifest.open_album_manifest(base_rec[0..bn]);
        const ours = try album_manifest.open_album_manifest(ours_rec[0..on]);
        const theirs = try album_manifest.open_album_manifest(theirs_rec[0..tn]);

        const g = merge(&base, &ours, &theirs);
        if (!is_clean(&g)) return error.AgreeNotClean;
        const intro = resolution_of(&g, "intro") orelse return error.AgreeIntroMissing;
        if (intro.source != .agreed) return error.AgreeSourceWrong; // both made the same change
        if (!std.mem.eql(u8, intro.digest, digest_in(&ours, "intro").?)) return error.AgreeDigestWrong;
        // both removed verse → dropped agreed.
        if (g.dropped_count != 1) return error.AgreeDropCountWrong;
        if (!std.mem.eql(u8, g.dropped[0].name, "verse")) return error.AgreeDropNameWrong;
        if (g.dropped[0].source != .agreed) return error.AgreeDropSourceWrong;
        if (g.resolved_count != 1) return error.AgreeResolvedCountWrong;
    }

    // 3. THE CONFLICT LAW — both sides change the same track to different content is a conflict carrying all three digests; one side
    //    changing while the other removes is also a conflict, with the removing side's digest empty.
    {
        // change vs change: base intro b0, ours b0b, theirs b0c — different remasters.
        var base_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var ours_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        var theirs_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const bn = try make_album(base_rec[0..], &.{"intro"}, &.{b0});
        const on = try make_album(ours_rec[0..], &.{"intro"}, &.{b0b});
        const tn = try make_album(theirs_rec[0..], &.{"intro"}, &.{b0c});
        const base = try album_manifest.open_album_manifest(base_rec[0..bn]);
        const ours = try album_manifest.open_album_manifest(ours_rec[0..on]);
        const theirs = try album_manifest.open_album_manifest(theirs_rec[0..tn]);

        const g = merge(&base, &ours, &theirs);
        if (is_clean(&g)) return error.ConflictReadClean;
        if (g.conflict_count != 1) return error.ConflictCountWrong;
        if (g.resolved_count != 0 or g.dropped_count != 0) return error.ConflictLeaked;
        const c = g.conflicts[0];
        if (!std.mem.eql(u8, c.name, "intro")) return error.ConflictNameWrong;
        if (!std.mem.eql(u8, c.base_digest, digest_in(&base, "intro").?)) return error.ConflictBaseWrong;
        if (!std.mem.eql(u8, c.our_digest, digest_in(&ours, "intro").?)) return error.ConflictOurWrong;
        if (!std.mem.eql(u8, c.their_digest, digest_in(&theirs, "intro").?)) return error.ConflictTheirWrong;

        // change vs remove: ours changes intro, theirs removes it → conflict, their digest empty.
        var trec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const empty = [_]render_album.TrackIn{};
        const en = try album_manifest.seal_album_manifest(trec[0..], empty[0..]);
        const gone = try album_manifest.open_album_manifest(trec[0..en]);
        const g2 = merge(&base, &ours, &gone);
        if (g2.conflict_count != 1) return error.ModDelCountWrong;
        if (g2.conflicts[0].their_digest.len != 0) return error.ModDelTheirNotEmpty;
        if (!std.mem.eql(u8, g2.conflicts[0].our_digest, digest_in(&ours, "intro").?)) return error.ModDelOurWrong;
    }

    // 4. THE IDENTITY LAW — a record merged with itself on both sides resolves every track unchanged, zero drops, zero conflicts.
    {
        var base_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const bn = try make_album(base_rec[0..], &.{ "intro", "verse", "hook" }, &.{ b0, b1, b2 });
        const base = try album_manifest.open_album_manifest(base_rec[0..bn]);
        const g = merge(&base, &base, &base);
        if (!is_clean(&g)) return error.IdentityNotClean;
        if (g.resolved_count != base.count) return error.IdentityResolvedWrong;
        if (g.dropped_count != 0 or g.conflict_count != 0) return error.IdentityMoved;
        var i: u32 = 0;
        while (i < g.resolved_count) : (i += 1) {
            if (g.resolved[i].source != .unchanged) return error.IdentitySourceWrong;
        }
    }

    print("GREEN ales-album-merge: two independent sets of record changes reconciled — merge(base, ours, theirs) sorts every track " ++
        "into resolved (with its chosen digest and source), dropped, or a named conflict. THE CRUX: a merge is a decision " ++
        "procedure, not a guess — it composes on the ALES231 resolve the diff uses, and the content-address digest is the whole " ++
        "comparison (no byte compare, no new hash). THE CLEAN LAW: a one-sided change is taken and names its hand (ours/theirs), a " ++
        "one-sided removal drops cleanly, zero conflicts. THE AGREEMENT LAW: both sides making the same change reads agreed. THE " ++
        "CONFLICT LAW: both sides changing a track differently — or change-vs-remove — is named a conflict carrying base, our, and " ++
        "their digests, never silently resolved. THE UNTOUCHED LAW: a track neither side touched resolves unchanged with its base " ++
        "digest. THE IDENTITY LAW: merge(base, base, base) resolves every track unchanged, zero drops, zero conflicts. The mirror " ++
        "of library_merge (ALES234) one level down, standing beside album_diff; content-addressing on every handle, not a " ++
        "signature — no real file, no DAC, no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
