//! lotus/loop.rye — ALES14: the transport loop — a marked region read round and round, the first read that does not end.
//! ALES7 opened the read side with a play head that reads a master forward and stops EXACTLY at the end, the end a hard wall.
//! That is ordinary playback. The read a musician reaches for second is LOOP — mark a region and hear it round and round: the
//! practice loop over a hard bar, the comping cycle a take is punched into. This rung extends the ALES7 head with a region it
//! wraps at instead of stopping.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES14.
//! Design read: active-designing/20260814-fill-ales14-lotus-transport-loop.md
//! Stands on: lotus/transport.rye (ALES7) — the play head this rung extends (a loop OFF delegates to it whole); lotus/clock.rye
//! (ALES5) — mark_ms sets the region in real time; lotus/timeline.rye (ALES2) — the Clip the master is.
//!
//! THE CRUX: a loop is a play head that WRAPS at a marked end instead of stopping. ALES7's head only moved forward and halted
//! at master.len; a loop keeps a region [start, end) and, whenever the head reaches end, wraps it back to start — so a
//! continuous read cycles the region forever and the pulled block is always full (a non-empty region never runs dry). The head
//! stays WITHIN the region after every read (start ≤ pos < end, asserted), so the cycle is exact: reading K cycles concatenates
//! to the region repeated K times, no sample skipped at the seam and none doubled. A loop OFF is ALES7's forward read exactly.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded read cursor over an in-process i16 PCM master, siloed to lotus/. No
//! audio leaves the process — a block is COPIED samples, not a sound-card write (that real write is the paused hardware round).
//! No socket, no network, no keys, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/loop.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");
const clock = @import("clock.rye");
const transport = @import("transport.rye");

pub const loop_version = "20260814.130000";

pub const LoopError = error{
    /// A region that is empty or inverted (start ≥ end) or runs past the master (end > master.len) — refused at the edge, so
    /// every armed loop below rests on a non-empty region wholly within the master.
    BadLoop,
};

/// A marked loop region [start, end) over a master, and whether the loop is armed. Default OFF and empty, so a fresh loop is
/// plain ALES7 forward playback until a keeper marks and arms a region.
pub const Loop = struct {
    start: u32 = 0,
    end: u32 = 0,
    on: bool = false,

    /// The region's length in samples — always ≥ 1 for an armed loop (make refuses an empty region).
    pub fn span(self: *const Loop) u32 {
        // invariant: an armed loop is a non-empty region; a disarmed default reports zero.
        assert(self.end >= self.start);
        return self.end - self.start;
    }
};

/// Build a validated, armed loop over [start, end), refusing BadLoop at the edge: an empty or inverted region (start ≥ end) or
/// one past the master (end > master_len). The one place a region's legality is proven, so the looping read rests on a bounded,
/// in-range region.
pub fn make(start: u32, end: u32, master_len: u32) LoopError!Loop {
    // invariant: the region is non-empty and wholly within the master.
    if (start >= end) return error.BadLoop;
    if (end > master_len) return error.BadLoop;
    const lp = Loop{ .start = start, .end = end, .on = true };
    // invariant: the built loop carries exactly the requested, validated, non-empty region within the master.
    assert(lp.start < lp.end and lp.end <= master_len and lp.on);
    return lp;
}

/// Mark the loop region in REAL TIME through the ALES5 clock — start_ms and end_ms convert to sample offsets, then `make`
/// validates them. Forwards the clock's DurationTooLong past the master bound. So a keeper sets loop points in seconds, not
/// sample indices.
pub fn mark_ms(clk: clock.Clock, start_ms: u32, end_ms: u32, master: *const timeline.Clip) (LoopError || clock.ClockError)!Loop {
    // invariant: the clock is valid, so the conversions are bounded and safe.
    assert(clk.rate >= 1 and clk.rate <= clock.max_rate);
    const s = try clock.samples_for(clk, start_ms);
    const e = try clock.samples_for(clk, end_ms);
    return make(s, e, master.len);
}

/// Place the head at the region start, arming the cycle — a keeper hits loop and the transport jumps to the top of the region.
/// A no-op region check is left to `make`; here the loop is assumed already validated.
pub fn enter(t: *transport.Transport, lp: *const Loop) void {
    // invariant: an entered loop is a legal, armed, non-empty region.
    assert(lp.on and lp.start < lp.end);
    t.pos = lp.start;
    // invariant: the head now sits at the top of the region.
    assert(t.pos == lp.start);
}

/// The looping read: copy the next up-to-out.len samples into out, advancing the head and WRAPPING at the region end. When the
/// loop is OFF this is ALES7's forward read exactly (delegated whole — a short block at the end, zero past it). When ON, the
/// head that reaches `end` wraps to `start`, so the block is always filled (a non-empty region never runs dry) and the head is
/// left within [start, end). Returns the count copied.
pub fn read_block(t: *transport.Transport, master: *const timeline.Clip, lp: *const Loop, out: []i16) u32 {
    // invariant: the head is within the master before the read.
    assert(t.pos <= master.len);
    if (!lp.on) return transport.read_block(t, master, out);

    // invariant: an armed loop is a non-empty region wholly within the master.
    assert(lp.start < lp.end and lp.end <= master.len);
    // a head outside the region (a fresh seek, or a just-armed loop) enters at the region start.
    if (t.pos < lp.start or t.pos >= lp.end) t.pos = lp.start;

    const want: u32 = @intCast(out.len);
    var i: u32 = 0;
    while (i < want) : (i += 1) {
        // invariant: the head is within the region at the top of each copy — wrap the instant it reaches the end.
        if (t.pos >= lp.end) t.pos = lp.start;
        // invariant: the playhead stays inside the loop it is looping, so a position outside
        // would read samples from beyond the region and call them the loop
        assert(t.pos >= lp.start and t.pos < lp.end);
        out[i] = master.buf[t.pos];
        t.pos += 1;
    }
    // leave the head within the region even when the last copy landed exactly on the end, so the next read continues the cycle.
    if (t.pos >= lp.end) t.pos = lp.start;
    // invariant: after a looping read the head is always within the region, and the whole block was filled.
    assert(t.pos >= lp.start and t.pos < lp.end);
    assert(i == want);
    return want;
}

// --- selftest: a loop OFF reads identically to ALES7's forward read (short last block, empty past the end); a region [1,4) of
//     a five-sample master cycles 20,30,40,20,30,40,… exactly, K cycles concatenating to the region repeated K times; the head
//     stays within [start,end) after every read; a loop over the whole master cycles the full master; a single-sample region
//     repeats that one sample; make refuses BadLoop (empty, inverted, past the master); mark_ms places the region at real
//     times; the loop reads only — the master is never mutated ------------------------------------------------------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn run_selftest() !u8 {
    const c = try clock.make(1000); // 1 sample per ms — a millisecond equals a sample index, legible on a bench

    // 1. a loop OFF reads identically to ALES7's forward read — the last block honestly short (5 samples in 2s → 2,2,1) and the
    //    read past the end empty. The loop generalizes the transport: disarmed, it IS the transport.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 10, 20, 30, 40, 50 });
        var t = transport.Transport{};
        const off = Loop{}; // default: off
        var gathered: [5]i16 = [_]i16{0} ** 5;
        var got: u32 = 0;
        while (!transport.at_end(&t, &master)) {
            var block: [2]i16 = [_]i16{0} ** 2;
            const n = read_block(&t, &master, &off, &block);
            var k: u32 = 0;
            while (k < n) : (k += 1) {
                gathered[got] = block[k];
                got += 1;
            }
        }
        if (got != 5) return error.OffCountWrong;
        if (!eq(gathered[0..got], master.samples())) return error.OffConcatWrong;
    }

    // 2. THE CRUX — a region [1,4) of [10,20,30,40,50] cycles 20,30,40,20,30,40,… exactly. Reading nine samples (three cycles of
    //    the three-sample region) concatenates to the region repeated three times, no seam sample skipped or doubled.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 10, 20, 30, 40, 50 });
        const lp = try make(1, 4, master.len); // region [1,4) = 20,30,40
        var t = transport.Transport{};
        enter(&t, &lp);
        var nine: [9]i16 = [_]i16{0} ** 9;
        const n = read_block(&t, &master, &lp, &nine);
        const three_cycles = [_]i16{ 20, 30, 40, 20, 30, 40, 20, 30, 40 };
        if (n != 9 or !eq(nine[0..n], &three_cycles)) return error.CycleWrong;
        // the head is left within the region for the next read.
        if (!(t.position() >= 1 and t.position() < 4)) return error.HeadOutsideRegion;
    }

    // 3. the head stays within [start,end) after every read, whatever the block size — read one sample at a time across a full
    //    cycle-and-a-bit and confirm the head never leaves the region.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 1, 2, 3, 4, 5, 6 });
        const lp = try make(2, 5, master.len); // region [2,5) = 3,4,5
        var t = transport.Transport{};
        enter(&t, &lp);
        var step: u32 = 0;
        while (step < 10) : (step += 1) {
            var one: [1]i16 = [_]i16{0};
            _ = read_block(&t, &master, &lp, &one);
            if (!(t.position() >= 2 and t.position() < 5)) return error.HeadDriftedOut;
        }
    }

    // 4. a loop over the WHOLE master [0,len) cycles the full master — continuous replay, the master heard end to end and again.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 7, 8, 9 });
        const lp = try make(0, master.len, master.len);
        var t = transport.Transport{};
        enter(&t, &lp);
        var seven: [7]i16 = [_]i16{0} ** 7;
        const n = read_block(&t, &master, &lp, &seven);
        const two_and_a_bit = [_]i16{ 7, 8, 9, 7, 8, 9, 7 };
        if (n != 7 or !eq(seven[0..n], &two_and_a_bit)) return error.WholeLoopWrong;
    }

    // 5. a single-sample region [2,3) repeats that one sample forever — the tightest cycle, proving the wrap never skips.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 11, 22, 33, 44 });
        const lp = try make(2, 3, master.len); // region [2,3) = 33
        var t = transport.Transport{};
        enter(&t, &lp);
        var four: [4]i16 = [_]i16{0} ** 4;
        _ = read_block(&t, &master, &lp, &four);
        const all_thirty_three = [_]i16{ 33, 33, 33, 33 };
        if (!eq(&four, &all_thirty_three)) return error.SingleSampleWrong;
    }

    // 6. make refuses BadLoop at the edge — an empty region (start == end), an inverted one (start > end), and one past the
    //    master (end > len) each refuse by name, leaving no half-built loop.
    {
        if (make(3, 3, 5)) |_| return error.EmptySlipped else |e| if (e != error.BadLoop) return error.WrongEmpty;
        if (make(4, 2, 5)) |_| return error.InvertedSlipped else |e| if (e != error.BadLoop) return error.WrongInverted;
        if (make(2, 6, 5)) |_| return error.PastSlipped else |e| if (e != error.BadLoop) return error.WrongPast;
    }

    // 7. mark_ms places the region at real times through the clock — at 1000 Hz, [200ms, 400ms) is samples [200,400). The clock
    //    converts the units; the region is the same one `make` would build from indices.
    {
        var master = timeline.Clip{};
        var i: u32 = 0;
        var samples: [500]i16 = [_]i16{0} ** 500;
        while (i < 500) : (i += 1) samples[i] = @intCast(@as(i32, @intCast(i)) - 250); // a legible ramp
        try timeline.splice(&master, 0, &samples);
        const lp = try mark_ms(c, 200, 400, &master);
        if (!(lp.start == 200 and lp.end == 400 and lp.on)) return error.MarkMsWrong;
        if (lp.span() != 200) return error.MarkMsSpanWrong;
    }

    // 8. the loop reads ONLY — cycling a master many times over, then checking the master is byte-for-byte unchanged. Read-only
    //    playback, exactly as ALES7.
    {
        var master = timeline.Clip{};
        try timeline.splice(&master, 0, &[_]i16{ 5, 6, 7, 8 });
        const original = [_]i16{ 5, 6, 7, 8 };
        const lp = try make(1, 3, master.len);
        var t = transport.Transport{};
        enter(&t, &lp);
        var big: [16]i16 = [_]i16{0} ** 16;
        _ = read_block(&t, &master, &lp, &big); // eight cycles of a two-sample region
        if (!eq(master.samples(), &original)) return error.LoopMutatedMaster;
    }

    print("GREEN ales-loop: the transport loop reads a marked region round and round — the first read that does not end. A loop " ++
        "OFF reads identically to ALES7's forward play head (short last block, empty past the end); a region [1,4) cycles " ++
        "20,30,40,20,30,40,… EXACTLY, K cycles concatenating to the region repeated K times with no seam sample skipped or " ++
        "doubled; the head stays within [start,end) after every read, at any block size; a loop over the whole master cycles " ++
        "the full master (continuous replay); a single-sample region repeats that one sample; make refuses BadLoop on an empty, " ++
        "inverted, or past-the-master region; mark_ms places the region at real times through the ALES5 clock; and the loop " ++
        "reads only — a master cycled many times over is never mutated; no audio leaves the process, no socket, no network, no " ++
        "keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
