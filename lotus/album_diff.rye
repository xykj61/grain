//! lotus/album_diff.rye — ALES232: what changed between two record versions. ALES231 let a keeper reach into one record by track name;
//! yet a record grows and changes — a keeper remasters a track, drops a rough take, adds a bonus cut, and reseals the album the same
//! evening, and the honest question the next morning is what changed in this record since the last master. ALES229 answered exactly
//! that one level up, for a catalog of records; this rung answers it one level down, for a record of tracks: a bounded classification
//! of two opened album manifests, a BEFORE and an AFTER, into three verdicts — added, removed, changed — every other track unchanged.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES232.
//! Design read: active-designing/20260815-144541_fill-ales232-lotus-album-diff.md
//! Stands on: lotus/album_find.rye (ALES231) — the find / digest_of resolve this composes on; lotus/album_manifest.rye (ALES224) — the
//! two opened AlbumManifest values this compares. The album level's own second-order primitive, standing ON album_find rather than
//! beside it — the shape the level grows in, mirroring library_diff (ALES229). No new hash, no new frame.
//!
//! THE CRUX — a diff composes on the resolve, it does not re-walk from scratch. Each classification is a find into the other record:
//! name present or absent, digest same or different. The digest IS the whole comparison — content-addressing already proved two
//! matching digests mean identical bundle bytes and two differing digests mean the track moved, so a diff needs no byte compare and no
//! new hash, only the handles the manifests already carry.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded classification over in-process fields already proven whole by
//! open_album_manifest, siloed to lotus/. Content-addressing on every handle it reports, never a signature: it names what moved, not
//! who made it — the signed carry remains a later crypto seam on Keaton's word. No real file, no DAC, no acoustic or electrical fact,
//! no network, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/album_diff.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const album_manifest = @import("album_manifest.rye");
const album_find = @import("album_find.rye");
const render_album = @import("render_album.rye");

pub const album_diff_version = "20260815.144541";

/// One track present in BOTH records whose content-address digest moved — the same track slot, remastered. Both digests are slices
/// into their respective opened manifest bodies.
pub const Change = struct {
    name: []const u8,
    old_digest: []const u8,
    new_digest: []const u8,
};

/// The whole verdict of comparing a before-record to an after-record. Every list is bounded by the manifest's own track ceiling, so
/// the classification can never overflow and always terminates. `same_count` counts tracks present in both with an identical digest —
/// they need no line, only a tally.
pub const Diff = struct {
    added: [album_manifest.max_tracks]album_manifest.Entry = undefined,
    added_count: u32 = 0,
    removed: [album_manifest.max_tracks]album_manifest.Entry = undefined,
    removed_count: u32 = 0,
    changed: [album_manifest.max_tracks]Change = undefined,
    changed_count: u32 = 0,
    same_count: u32 = 0,
};

/// Classify every track of `before` and `after` into added / removed / changed / same. For each track in `after`, find it in
/// `before`: absent means added, present-with-a-different-digest means changed, present-and-equal means counted same. For each track
/// in `before`, absent from `after` means removed. One ordered pass over each record — both bounded on open, so the walk is total and
/// the verdict infallible.
pub fn classify(before: *const album_manifest.AlbumManifest, after: *const album_manifest.AlbumManifest) Diff {
    // invariant: neither record names more tracks than the shared bound — open_album_manifest already proved it, re-asserted here.
    assert(before.count <= album_manifest.max_tracks and after.count <= album_manifest.max_tracks);
    var d: Diff = .{};

    // Added and changed: walk the after against the before.
    var i: u32 = 0;
    while (i < after.count) : (i += 1) {
        const a = after.entries[i];
        if (album_find.find(before, a.name)) |bi| {
            // present in both — same digest is unchanged, a different digest is a remaster.
            if (std.mem.eql(u8, album_find.digest_of(before, bi), a.digest)) {
                d.same_count += 1;
            } else {
                d.changed[d.changed_count] = .{ .name = a.name, .old_digest = album_find.digest_of(before, bi), .new_digest = a.digest };
                d.changed_count += 1;
            }
        } else {
            d.added[d.added_count] = a;
            d.added_count += 1;
        }
    }

    // Removed: walk the before against the after — a track the after no longer holds.
    var j: u32 = 0;
    while (j < before.count) : (j += 1) {
        const b = before.entries[j];
        if (album_find.find(after, b.name) == null) {
            d.removed[d.removed_count] = b;
            d.removed_count += 1;
        }
    }

    // invariant: every after-track landed in exactly one of added / changed / same — the three tallies account for the whole after.
    assert(d.added_count + d.changed_count + d.same_count == after.count);
    // invariant: no list overflowed its bound — each is at most one record's worth of tracks.
    assert(d.added_count <= after.count and d.removed_count <= before.count and d.changed_count <= after.count);
    return d;
}

// --- selftest: THE ADDED LAW — an after-only track appears once as added with its digest; THE REMOVED LAW — a before-only track
//     appears once as removed with its digest; THE CHANGED LAW — a name in both with a moved digest appears once as changed carrying
//     both digests, an unchanged name appears in no list and is counted same; THE IDENTITY LAW — a record against itself yields all
//     zeros and same_count equal to the track count ---------------------------------------------------------------------------------

/// Seal a small album manifest over stand-in bundles into `out`, returning its length — the content address a keeper holds for a
/// whole record. Any bytes serve as a bundle here; the manifest addresses their OUTPUT bytes.
fn make_album(out: []u8, names: []const []const u8, bundles: []const []const u8) !u32 {
    // invariant: a witness helper builds a small, well-formed record — the two arrays run in lockstep.
    assert(names.len == bundles.len);
    var tracks: [8]render_album.TrackIn = undefined;
    var i: u32 = 0;
    while (i < names.len) : (i += 1) tracks[i] = .{ .name = names[i], .bundle = bundles[i] };
    return album_manifest.seal_album_manifest(out, tracks[0..names.len]);
}

fn run_selftest() !u8 {
    // Stand-in bundle bytes. b1b shares b1's track NAME ("verse") but different bytes — a remaster, so a changed verdict.
    const b0 = "LOTUSBND....first bundle bytes....\x01\x02\x03";
    const b1 = "LOTUSBND....second bundle bytes...\x04\x05\x06";
    const b1b = "LOTUSBND....second bundle REMASTER\x04\x05\x07";
    const b2 = "LOTUSBND....third bundle bytes....\x07\x08\x09";

    // before: {intro, verse}. after: {intro (same), verse (remastered → changed), bridge (new → added)}. intro same; verse changed;
    // bridge added; nothing removed here — a removal is proven in its own block below.
    var before_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    var after_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    const bn = try make_album(before_rec[0..], &.{ "intro", "verse" }, &.{ b0, b1 });
    const an = try make_album(after_rec[0..], &.{ "intro", "verse", "bridge" }, &.{ b0, b1b, b2 });
    const before = try album_manifest.open_album_manifest(before_rec[0..bn]);
    const after = try album_manifest.open_album_manifest(after_rec[0..an]);

    // 1. THE ADDED & CHANGED LAWS — bridge added once with its digest; verse changed once carrying old and new; intro unchanged,
    //    counted same and in no list.
    {
        const d = classify(&before, &after);
        if (d.added_count != 1) return error.AddedCountWrong;
        if (!std.mem.eql(u8, d.added[0].name, "bridge")) return error.AddedNameWrong;
        if (!std.mem.eql(u8, d.added[0].digest, album_find.digest_of(&after, album_find.find(&after, "bridge").?))) return error.AddedDigestWrong;

        if (d.changed_count != 1) return error.ChangedCountWrong;
        if (!std.mem.eql(u8, d.changed[0].name, "verse")) return error.ChangedNameWrong;
        if (!std.mem.eql(u8, d.changed[0].old_digest, album_find.digest_of(&before, album_find.find(&before, "verse").?))) return error.OldDigestWrong;
        if (!std.mem.eql(u8, d.changed[0].new_digest, album_find.digest_of(&after, album_find.find(&after, "verse").?))) return error.NewDigestWrong;
        if (std.mem.eql(u8, d.changed[0].old_digest, d.changed[0].new_digest)) return error.ChangeNotMoved;

        if (d.same_count != 1) return error.SameCountWrong; // intro
        if (d.removed_count != 0) return error.RemovedLeaked;
    }

    // 2. THE REMOVED LAW — retire verse: after holds only {intro}. verse appears once as removed, with its before-digest.
    {
        var small_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const sn = try make_album(small_rec[0..], &.{"intro"}, &.{b0});
        const smaller = try album_manifest.open_album_manifest(small_rec[0..sn]);
        const d = classify(&before, &smaller);
        if (d.removed_count != 1) return error.RemovedCountWrong;
        if (!std.mem.eql(u8, d.removed[0].name, "verse")) return error.RemovedNameWrong;
        if (!std.mem.eql(u8, d.removed[0].digest, album_find.digest_of(&before, album_find.find(&before, "verse").?))) return error.RemovedDigestWrong;
        if (d.added_count != 0 or d.changed_count != 0) return error.RemovedLeakedOther;
        if (d.same_count != 1) return error.RemovedSameWrong; // intro still same
    }

    // 3. THE IDENTITY LAW — a record diffed against itself: nothing added, removed, or changed; same_count is the track count.
    {
        const d = classify(&before, &before);
        if (d.added_count != 0 or d.removed_count != 0 or d.changed_count != 0) return error.IdentityMoved;
        if (d.same_count != before.count) return error.IdentitySameWrong;
    }

    print("GREEN ales-album-diff: what changed between two record versions — classify(before, after) sorts every track into " ++
        "added, removed, changed, or same. THE CRUX: a diff composes on the ALES231 resolve, it does not re-walk from scratch — each " ++
        "verdict is a find into the other record, and the content-address digest IS the whole comparison (no byte compare, no new " ++
        "hash). THE ADDED LAW: an after-only track appears once as added with its digest. THE REMOVED LAW: a before-only track " ++
        "appears once as removed with its digest. THE CHANGED LAW: a name in both with a moved digest appears once carrying old and " ++
        "new, an unchanged name appears in no list and is counted same. THE IDENTITY LAW: a record against itself yields all zeros " ++
        "and same_count equal to the track count. The album level's second-order primitive, mirroring library_diff (ALES229) one " ++
        "level down; content-addressing on every handle, not a signature — no real file, no DAC, no network, no keys, no funds, no " ++
        "real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
