//! lotus/compress.rye — ALES50: a compressor — the limiter's ceiling made gentle. The limiter (ALES49) is a brickwall: past the
//! ceiling nothing gets through. The compressor is the same ceiling softened — past the threshold a signal still rises, only by a
//! fraction (the ratio) of what it would. Where the limiter says "no louder than this," the compressor says "louder still, but
//! softer the louder you get." It is the most-reached-for dynamics tool: it evens a vocal so every word sits, glues a drum bus,
//! tames a bass that jumps. The ratio is the one knob that names how hard it leans, and at its extreme the compressor IS the
//! limiter — a very high ratio divides the excess to nothing, seating an above-threshold sample at the threshold.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES50.
//! Design read: active-designing/date/20260814/20260814-171338_fill-ales50-lotus-compressor.md
//! Stands on: lotus/timeline.rye (ALES2) — the Clip, sample_min/sample_max, the range law shape; lotus/limit.rye (ALES49) — the
//! brickwall this softens, re-proven beside it.
//!
//! HONEST SCOPE — software only, purely LOCAL. Bounded in-process i16 PCM buffers on one bench, siloed to lotus/. No socket,
//! no network, no keys, no funds, no real device, no real sample rate — the threshold is a magnitude in sample units, not
//! decibels, the ratio a plain fraction, and the compression is instantaneous (no attack, release, or knee — those are later
//! rungs). One comparison and at most one divide per sample; nothing on the audio path can overflow, since the ratio is at least
//! one so a compressed magnitude is at most the input magnitude, which already fits i16.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/compress.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");

pub const compress_version = "20260814.171338";

/// The compressor's faults: a threshold outside the legal range (a magnitude in [1, sample_max]), a ratio below unity or with a
/// zero denominator (a ratio below one would EXPAND — a different tool), and a span outside the samples. BadRange coincides by
/// name with timeline's, the EQ family's, and the limiter's, so a composer sees one consistent fault.
pub const CompressError = error{
    /// A threshold of zero (there is no band left to compress below it) or above sample_max (nothing could ever cross it).
    BadThreshold,
    /// A ratio below unity (would expand, not compress) or with a zero denominator — refused, no write.
    BadRatio,
    /// A span outside the current samples — refused, no write.
    BadRange,
};

/// Compress `count` samples starting at `start` in place above the magnitude `threshold` by the ratio `ratio_num/ratio_den`
/// (at least one). A sample within the threshold passes byte-for-byte; above it, the excess m − threshold is divided by the
/// ratio and the sample rewritten sign(x)·(threshold + excess·ratio_den/ratio_num). After the call every written magnitude is at
/// most the input's (the compressor reduces, never boosts) and no sign is changed. Unit ratio is the identity everywhere.
/// Refuses BadThreshold on a threshold outside [1, sample_max], BadRatio on a ratio below unity or a zero denominator, and
/// BadRange on a span outside the samples — each before any write. Values only — never the length.
pub fn compress(
    clip: *timeline.Clip,
    start: u32,
    count: u32,
    threshold: i32,
    ratio_num: u32,
    ratio_den: u32,
) CompressError!void {
    // invariant: the threshold is a legal magnitude — at least one sample unit and no greater than the i16 rail. Before any write.
    if (threshold < 1) return error.BadThreshold;
    if (threshold > @as(i32, timeline.sample_max)) return error.BadThreshold;
    // invariant: the ratio is at least one (num >= den) and its denominator is nonzero — a ratio below one would expand, a zero
    // denominator would divide by zero. A downward compressor only ever reduces the excess.
    if (ratio_den == 0) return error.BadRatio;
    if (ratio_num < ratio_den) return error.BadRatio;
    // invariant: the span lies wholly within the current samples — checked without underflow (count vs the remainder).
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;

    const thr: i64 = @as(i64, threshold);
    const num: i64 = @as(i64, ratio_num);
    const den: i64 = @as(i64, ratio_den);
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const x: i16 = clip.buf[start + i];
        const m: i64 = if (x < 0) -@as(i64, x) else @as(i64, x); // |x| — safe in i64 (|sample_min| = 32768 fits)
        if (m > thr) {
            const excess: i64 = m - thr; // strictly positive above the threshold
            // Divide the excess by the ratio (num/den), keeping the threshold whole: the band below threshold is untouched, only
            // the part above is leaned on. divTrunc of positives is floor; the ratio being >= 1 makes the quotient <= excess.
            const new_m: i64 = thr + @divTrunc(excess * den, num);
            // invariant: compression reduces, never boosts, and never drops below the threshold it leans from.
            assert(new_m <= m and new_m >= thr);
            const y: i16 = @intCast(if (x < 0) -new_m else new_m); // safe: 1 <= thr <= new_m <= m <= sample_max
            clip.buf[start + i] = y;
            // invariant: the written sample holds the input's sign (magnitude only shrank).
            assert((x >= 0 and y >= 0) or (x <= 0 and y <= 0));
        }
        // a sample within the threshold is left exactly as it was — the compressor touches only what rises above.
    }
    // invariant: a compressor changes sample values only, never the clip's length or bound.
    assert(start + count <= clip.len);
    assert(clip.len <= clip.buf.len);
}

// --- selftest: silence stays silence; a signal within the threshold passes byte-for-byte (below the threshold is the identity);
//     UNIT RATIO is the identity everywhere (even above threshold); a loud signal has its peaks reduced with the sign held and
//     the magnitude never expanding; a HIGHER RATIO compresses at least as hard (monotone), an infinite-enough ratio seats a peak
//     at the threshold (the limiter within); and a bad threshold, a sub-unity ratio, a zero ratio denominator, and an
//     out-of-range span each refuse by name ------------------------------------------------------------------------------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn load_clip(clip: *timeline.Clip, src: []const i16) !void {
    try timeline.splice(clip, 0, src);
}

fn abs16(v: i16) i32 {
    return if (v < 0) -@as(i32, v) else @as(i32, v);
}

fn run_selftest() !u8 {
    // 1. silence stays silence — an all-zero clip compresses to all zeros at any legal threshold and ratio.
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &[_]i16{ 0, 0, 0, 0, 0, 0 });
        try compress(&clip, 0, clip.len, 1000, 4, 1);
        const zeros = [_]i16{ 0, 0, 0, 0, 0, 0 };
        if (!eq(clip.samples(), &zeros)) return error.SilenceWrong;
    }

    // 2. BELOW THE THRESHOLD IS THE IDENTITY — a signal whose every peak sits within the threshold passes byte-for-byte.
    {
        const quiet = [_]i16{ 500, -900, 1000, -1000, 250, -500 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &quiet);
        try compress(&clip, 0, clip.len, 1000, 8, 1); // threshold equals the loudest peak — inclusive, so it still passes
        if (!eq(clip.samples(), &quiet)) return error.QuietNotIdentity;
    }

    // 3. UNIT RATIO IS THE IDENTITY EVERYWHERE — ratio_num == ratio_den writes threshold + excess·1 = |x| byte-for-byte even for
    //    samples above the threshold. A 1:1 compressor passes the whole signal through, guaranteed by construction.
    {
        const loud = [_]i16{ 3000, -3000, 500, -20000, 20000, -400 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &loud);
        try compress(&clip, 0, clip.len, 1000, 3, 3); // unit ratio 3:3
        if (!eq(clip.samples(), &loud)) return error.UnitRatioNotIdentity;
    }

    // 4. THE SIGN IS HELD AND THE MAGNITUDE NEVER EXPANDS — a signal above the threshold compresses so every output magnitude is
    //    at most the input's, every sign matches, and each above-threshold peak lands exactly at threshold + excess/ratio.
    {
        const loud = [_]i16{ 5000, -5000, 800, -9000, 9000, -200 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &loud);
        const thr: i32 = 1000;
        try compress(&clip, 0, clip.len, thr, 4, 1); // 4:1
        const out = clip.samples();
        var i: u32 = 0;
        while (i < out.len) : (i += 1) {
            const src = loud[i];
            if (abs16(out[i]) > abs16(src)) return error.MagnitudeExpanded; // compression only reduces
            if ((src > 0 and out[i] < 0) or (src < 0 and out[i] > 0)) return error.SignFlipped;
            const m = abs16(src);
            const want_mag: i32 = if (m > thr) thr + @divTrunc((m - thr), 4) else m;
            const want: i16 = @intCast(if (src < 0) -want_mag else want_mag);
            if (out[i] != want) return error.WrongCompression;
        }
    }

    // 5. A HIGHER RATIO COMPRESSES AT LEAST AS HARD — for the same above-threshold sample, 8:1 yields a magnitude no greater than
    //    2:1 (the ratio knob is monotone), and a ratio high enough seats the peak exactly at the threshold — the limiter within.
    {
        const one = [_]i16{9000};
        const thr: i32 = 1000;
        var soft = timeline.Clip{};
        try load_clip(&soft, &one);
        try compress(&soft, 0, soft.len, thr, 2, 1); // 2:1
        var hard = timeline.Clip{};
        try load_clip(&hard, &one);
        try compress(&hard, 0, hard.len, thr, 8, 1); // 8:1
        if (abs16(hard.samples()[0]) > abs16(soft.samples()[0])) return error.RatioNotMonotone;
        // a ratio far larger than the excess drives the excess to zero: the peak sits exactly at the threshold (the brickwall).
        var wall = timeline.Clip{};
        try load_clip(&wall, &one);
        try compress(&wall, 0, wall.len, thr, 100000, 1); // ratio >> excess (8000) — excess/ratio truncates to 0
        if (wall.samples()[0] != @as(i16, @intCast(thr))) return error.HighRatioNotLimiter;
    }

    // 6a. a zero threshold refuses BadThreshold before any write, the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (compress(&clip, 0, clip.len, 0, 4, 1)) |_| return error.ZeroThresholdSlipped else |e| if (e != error.BadThreshold) return error.WrongZeroThreshold;
        if (!eq(clip.samples(), &three)) return error.RefusedThresholdMutated;
    }

    // 6b. a sub-unity ratio (would expand) refuses BadRatio before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (compress(&clip, 0, clip.len, 1000, 1, 2)) |_| return error.SubUnitySlipped else |e| if (e != error.BadRatio) return error.WrongSubUnity;
        if (!eq(clip.samples(), &three)) return error.RefusedRatioMutated;
    }

    // 6c. a zero ratio denominator refuses BadRatio before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (compress(&clip, 0, clip.len, 1000, 4, 0)) |_| return error.ZeroDenSlipped else |e| if (e != error.BadRatio) return error.WrongZeroDen;
        if (!eq(clip.samples(), &three)) return error.RefusedDenMutated;
    }

    // 6d. an out-of-range span refuses BadRange before any write, leaving the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (compress(&clip, 2, 5, 1000, 4, 1)) |_| return error.BadRangeSlipped else |e| if (e != error.BadRange) return error.WrongBadRange;
        if (!eq(clip.samples(), &three)) return error.RefusedRangeMutated;
    }

    print("GREEN ales-compress: a compressor softens the limiter's ceiling — a sample within the threshold passes byte-for-byte, " ++
        "a sample above it has its excess divided by the ratio and is rewritten sign(x)·(threshold + excess/ratio). Silence " ++
        "stays silence; below the threshold is the IDENTITY; UNIT RATIO is the identity everywhere (even above threshold — a 1:1 " ++
        "compressor passes the whole signal by construction); a loud signal has its peaks reduced with the sign held and the " ++
        "magnitude never expanding; a HIGHER RATIO compresses at least as hard (the ratio knob is monotone) and a ratio far " ++
        "past the excess seats a peak exactly at the threshold — the limiter reached from within the compressor; and a zero " ++
        "threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an out-of-range span BadRange, each " ++
        "leaving the clip untouched; no socket, no network, no keys, no funds, no real device, no real sample rate\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
