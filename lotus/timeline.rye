//! lotus/timeline.rye -- ALES2: the edit gestures over a reassembled sample timeline -- cut, gain, splice. ALES0 framed one
//! buffer of samples verify-before-trust; ALES1 reassembled many frames off a byte stream into one gapless Timeline. Neither
//! CHANGES a sample -- they only carry and order the audio. This rung opens the first real DAW gesture: an editable Clip of
//! samples and the three edits every timeline owes -- remove a span (cut), scale a span's loudness (gain), insert a span
//! (splice) -- each transforming the samples exactly and in order.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES2.
//! Design read: active-designing/20260814-fill-ales2-lotus-timeline-edits.md
//! Stands on: lotus/stream.rye (ALES1) -- the reassembled Timeline this rung loads and edits; lotus/wire.rye (ALES0) for the
//! sample width and bound. `load` copies a drained Timeline into a Clip, so the full road reads: bytes -> frames -> gapless
//! timeline -> edited clip.
//!
//! HONEST SCOPE -- software only, purely LOCAL. A bounded in-process buffer of i16 PCM samples on one bench, siloed to lotus/.
//! No socket, no network, no keys, no funds, no real device, no real sample rate (the samples carry no clock yet -- that is a
//! later rung). The one correctness this rung owes beyond a generic integer buffer is SATURATION: gain clamps to i16 min/max
//! rather than wrapping, so a scaled-loud sample can never wrap to the opposite sign -- the audio-editor analog of ALES0's
//! audio border.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/timeline.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const wire = @import("wire.rye");
const stream = @import("stream.rye");

pub const timeline_version = "20260814.112555";

/// The widest editable clip this rung proves -- the same bound ALES1's reassembly holds, so a drained Timeline always loads.
/// Bounded so no edit can grow an unbounded buffer; a real session is many such bounded windows.
pub const max_clip: u32 = stream.max_timeline;

/// The lowest and highest values an i16 sample can hold. Named so saturation reads plainly and no magic number hides the
/// audio-editor's one owed correctness.
pub const sample_min: i16 = -32768;
pub const sample_max: i16 = 32767;

pub const EditError = error{
    /// An edit would grow the clip past its fixed bound -- refused, never a silent overwrite past the buffer.
    ClipFull,
    /// A start offset or count names samples outside the clip's current length -- refused before any read or shift.
    BadRange,
    /// A gain with a zero denominator -- refused, no divide by zero.
    BadGain,
};

/// Clamp a wide intermediate to the i16 sample range. A scaled or summed sample is computed in i64 so the arithmetic never
/// overflows, then pinned to [sample_min, sample_max] -- the saturation an audio edit owes so loud never wraps to the opposite
/// sign. Public so the mixer (ALES3) reuses the one true saturation rather than re-deriving it.
pub fn saturate(v: i64) i16 {
    // invariant: the clamp bounds are the true i16 extremes, so the result is always a legal sample.
    assert(sample_min == -32768 and sample_max == 32767);
    if (v < @as(i64, sample_min)) return sample_min;
    if (v > @as(i64, sample_max)) return sample_max;
    // invariant: within [sample_min, sample_max] the cast is exact and lossless.
    assert(v >= @as(i64, sample_min) and v <= @as(i64, sample_max));
    return @intCast(v);
}

/// A bounded, editable buffer of i16 PCM samples: the audio a keeper actually works on. A Clip is loaded from a reassembled
/// Timeline (ALES1) and then cut, gained, and spliced in place. No heap outlives it.
pub const Clip = struct {
    buf: [max_clip]i16 = [_]i16{0} ** max_clip,
    len: u32 = 0,

    /// The clip's samples in order -- exactly the audio under edit.
    pub fn samples(self: *const Clip) []const i16 {
        // invariant: the length never claims more samples than the buffer holds.
        assert(self.len <= self.buf.len);
        return self.buf[0..self.len];
    }
};

/// Copy a reassembled Timeline (ALES1) into an editable Clip -- the seam that ties this rung to the road: bytes -> frames ->
/// gapless timeline -> editable clip. Refuses ClipFull rather than overrun, so a timeline wider than the clip never truncates
/// silently.
pub fn load(tl: *const stream.Timeline, out: *Clip) EditError!void {
    // invariant: the timeline must fit the clip whole -- no partial load.
    if (tl.len > out.buf.len) return error.ClipFull;
    var i: u32 = 0;
    while (i < tl.len) : (i += 1) out.buf[i] = tl.samples()[i];
    out.len = tl.len;
    // invariant: the clip now holds exactly the timeline's samples, within its bound.
    assert(out.len == tl.len);
    assert(out.len <= out.buf.len);
}

/// Remove `count` samples starting at `start`, shifting the tail left to close the gap -- the audio stays gapless and in
/// order, with everything after the cut preserved exactly. Refuses BadRange when the span falls outside the current samples,
/// before any shift.
pub fn cut(clip: *Clip, start: u32, count: u32) EditError!void {
    // invariant: the removed span lies wholly within the current samples (checked without underflow -- count vs the remainder).
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;
    const tail_start = start + count;
    var i: u32 = tail_start;
    while (i < clip.len) : (i += 1) clip.buf[i - count] = clip.buf[i];
    clip.len -= count;
    // invariant: the clip shrank by exactly the removed span and never below zero.
    assert(clip.len <= clip.buf.len);
}

/// Scale the loudness of `count` samples starting at `start` by the fraction num/den, saturating to the i16 range so a loud
/// sample never wraps to the opposite sign. A negative num inverts phase. Refuses BadGain on a zero denominator and BadRange
/// on a span outside the samples, before any write. This is the one correctness beyond a generic integer buffer.
pub fn gain(clip: *Clip, start: u32, count: u32, num: i32, den: u32) EditError!void {
    // invariant: no divide by zero, and the span lies wholly within the current samples.
    if (den == 0) return error.BadGain;
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;
    const end = start + count;
    var i: u32 = start;
    while (i < end) : (i += 1) {
        // The multiply runs in i64 so it never overflows before the clamp; @divTrunc rounds toward zero, the plain gain rule.
        const scaled: i64 = @as(i64, clip.buf[i]) * @as(i64, num);
        const divided: i64 = @divTrunc(scaled, @as(i64, den));
        clip.buf[i] = saturate(divided);
    }
    // invariant: gain changes sample values only, never the clip's length or bound.
    assert(end <= clip.len);
    assert(clip.len <= clip.buf.len);
}

/// Insert the samples `ins` at position `at`, shifting the tail right to open the gap -- the inserted audio lands in order and
/// everything after `at` follows it, unchanged. Refuses ClipFull when the insert would overflow the fixed buffer and BadRange
/// when `at` falls past the current samples, before any shift.
pub fn splice(clip: *Clip, at: u32, ins: []const i16) EditError!void {
    // invariant: the insertion point lies within the current samples, and the result fits the fixed buffer.
    if (at > clip.len) return error.BadRange;
    if (ins.len > clip.buf.len - clip.len) return error.ClipFull;
    const n: u32 = @intCast(ins.len);
    // Shift the tail right by n, high index first, so no sample overwrites one still to move.
    var i: u32 = clip.len;
    while (i > at) : (i -= 1) clip.buf[i - 1 + n] = clip.buf[i - 1];
    var j: u32 = 0;
    while (j < n) : (j += 1) clip.buf[at + j] = ins[j];
    clip.len += n;
    // invariant: the clip grew by exactly the inserted span and never past its bound.
    assert(clip.len <= clip.buf.len);
}

// --- selftest: cut removes a span exactly and keeps the rest in order; gain scales and SATURATES rather than wraps (the one
//     owed correctness), a negative num inverts phase and clamps i16-min's negation; splice inserts in order; splice then cut
//     the same span round-trips to the original; out-of-range and zero-denominator and overflow each refuse by name; and the
//     whole rung composes on ALES1 -- a stream reassembles, a clip loads and edits the reassembled audio -------------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn run_selftest() !u8 {
    // 1. cut removes exactly the named span; the tail shifts left, gapless and in order.
    {
        var clip = Clip{};
        const src = [_]i16{ 0, 1, 2, 3, 4, 5, 6, 7 };
        try splice(&clip, 0, &src);
        try cut(&clip, 2, 3); // remove samples 2,3,4
        const want = [_]i16{ 0, 1, 5, 6, 7 };
        if (!eq(clip.samples(), &want)) return error.CutWrong;
    }

    // 2. gain SATURATES rather than wraps -- a sample whose doubled value exceeds the i16 range clamps to the extreme, it
    //    never wraps to the opposite sign. 20000 * 2 = 40000 would wrap negative in i16 arithmetic; saturation keeps +32767.
    {
        var clip = Clip{};
        const src = [_]i16{ 100, 20000, -20000, sample_min, sample_max };
        try splice(&clip, 0, &src);
        try gain(&clip, 0, clip.len, 2, 1); // ×2
        const want = [_]i16{ 200, sample_max, sample_min, sample_min, sample_max };
        if (!eq(clip.samples(), &want)) return error.GainSaturateWrong;
    }

    // 3. a negative num inverts phase, and negating sample_min saturates to sample_max (its true negation, +32768, is out of
    //    range) -- the clamp holds on the signed edge too.
    {
        var clip = Clip{};
        const src = [_]i16{ 1, -1, 32767, sample_min };
        try splice(&clip, 0, &src);
        try gain(&clip, 0, clip.len, -1, 1); // ×-1 (phase invert)
        const want = [_]i16{ -1, 1, -32767, sample_max };
        if (!eq(clip.samples(), &want)) return error.GainInvertWrong;
    }

    // 4. gain scales only a sub-span, leaving the rest untouched -- a fractional cut (half loudness) on the middle.
    {
        var clip = Clip{};
        const src = [_]i16{ 400, 400, 400, 400 };
        try splice(&clip, 0, &src);
        try gain(&clip, 1, 2, 1, 2); // halve samples 1 and 2
        const want = [_]i16{ 400, 200, 200, 400 };
        if (!eq(clip.samples(), &want)) return error.GainSpanWrong;
    }

    // 5. splice inserts in order at a mid position; the tail shifts right, everything after preserved.
    {
        var clip = Clip{};
        const src = [_]i16{ 0, 1, 2 };
        try splice(&clip, 0, &src);
        const ins = [_]i16{ 9, 8 };
        try splice(&clip, 1, &ins);
        const want = [_]i16{ 0, 9, 8, 1, 2 };
        if (!eq(clip.samples(), &want)) return error.SpliceWrong;
    }

    // 6. splice then cut the SAME span round-trips to the original -- the two gestures are exact inverses over one span.
    {
        var clip = Clip{};
        const src = [_]i16{ 5, 6, 7, 8 };
        try splice(&clip, 0, &src);
        const ins = [_]i16{ 100, 101, 102 };
        try splice(&clip, 2, &ins); // insert 3 samples at 2
        try cut(&clip, 2, 3); // remove the same 3 samples
        if (!eq(clip.samples(), &src)) return error.RoundTripWrong;
    }

    // 7. an out-of-range cut refuses BadRange before any shift (count runs past the samples).
    {
        var clip = Clip{};
        const src = [_]i16{ 1, 2, 3 };
        try splice(&clip, 0, &src);
        if (cut(&clip, 2, 5)) |_| return error.BadCutSlipped else |e| if (e != error.BadRange) return error.WrongBadCut;
        // the clip is untouched by the refused cut
        if (!eq(clip.samples(), &src)) return error.RefusedCutMutated;
    }

    // 8. a zero-denominator gain refuses BadGain -- no divide by zero.
    {
        var clip = Clip{};
        const src = [_]i16{ 1, 2, 3 };
        try splice(&clip, 0, &src);
        if (gain(&clip, 0, clip.len, 1, 0)) |_| return error.BadGainSlipped else |e| if (e != error.BadGain) return error.WrongBadGain;
    }

    // 9. a splice that would overflow the fixed buffer refuses ClipFull -- never a silent overwrite past the bound.
    {
        var clip = Clip{};
        clip.len = max_clip - 1; // one sample of room
        const ins = [_]i16{ 0, 0, 0 };
        if (splice(&clip, 0, &ins)) |_| return error.OverflowSlipped else |e| if (e != error.ClipFull) return error.WrongOverflow;
    }

    // 10. the whole rung composes on ALES1 -- a byte stream reassembles two frames into a gapless Timeline, a Clip loads it,
    //     and an edit lands on the reassembled audio, proving ALES2 stands on ALES1's output end to end.
    {
        const a = [_]i16{ 10, 11, 12 };
        const b = [_]i16{ 20, 21 };
        var fa = wire.Frame{};
        var fb = wire.Frame{};
        try wire.frame(.xlr, &a, &fa);
        try wire.frame(.usb_c, &b, &fb);

        var st = stream.AudioStream{};
        try stream.feed(&st, &fa);
        try stream.feed(&st, &fb);
        var tl = stream.Timeline{};
        try stream.drain(&st, &tl);
        // The reassembled timeline is a ++ b, gapless.
        const reassembled = [_]i16{ 10, 11, 12, 20, 21 };
        if (!eq(tl.samples(), &reassembled)) return error.ReassembleWrong;

        var clip = Clip{};
        try load(&tl, &clip);
        try cut(&clip, 0, 3); // drop frame a's samples off the front of the reassembled audio
        const want = [_]i16{ 20, 21 };
        if (!eq(clip.samples(), &want)) return error.ComposeWrong;
    }

    print("GREEN ales-timeline: the three edit gestures transform a sample timeline exactly and in order — cut removes a span " ++
        "and closes the gap gapless; gain scales a span and SATURATES to the i16 range rather than wrapping (20000×2 pins to " ++
        "+32767, not a wrapped negative), a negative num inverts phase and negating i16-min clamps to +32767; splice inserts " ++
        "in order and shifts the tail right; splice then cut the same span round-trips to the original (exact inverses); an " ++
        "out-of-range cut refuses BadRange leaving the clip untouched, a zero-denominator gain refuses BadGain, an overflowing " ++
        "splice refuses ClipFull; and the rung composes on ALES1 — a byte stream reassembles into a gapless Timeline, a Clip " ++
        "loads it, and an edit lands on the reassembled audio; no socket, no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
