//! lotus/stereo_wav.rye — ALES216: the canonical RIFF/WAVE container widened to two channels, interleaved. The mono twin
//! ALES215 opened the container family; this rung closes the mono→stereo pair the whole suite keeps, so a keeper who
//! reverberated and placed a wet image in the field (ALES214) can export that STEREO result rather than folding it to mono.
//! Software only — a byte container, no real file, no DAC, no acoustic or electrical fact asserted.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES216.
//! Design read: active-designing/20260815-130649_fill-ales216-lotus-stereo-wav.md
//! Stands on: lotus/wav.rye (ALES215) — the same canonical header and two-gate verify-before-trust decode, differing only
//! where stereo differs (channels 2, block align 4, byte rate rate*4) and adding one widened border: the data chunk must be a
//! whole number of two-sample FRAMES, so neither channel ever receives a lone unpaired sample.
//!
//! HONEST SCOPE — software only. `encode`/`decode` convert between two bounded i16 channel buffers and the interleaved
//! RIFF/WAVE byte layout; the stored sample rate is a carried FIELD, not a real clock. No file opened, no device driven, no
//! network, no keys, no funds. RIFF/WAVE (public, unencumbered) studied clean-room; our own bounded, asserted Rye
//! implementation, siloed to lotus/.
//!
//! The canonical stereo/16-bit header, 44 bytes, samples stored interleaved L R L R:
//!   "RIFF"(4) · riff_size(u32 LE) · "WAVE"(4) · "fmt "(4) · fmt_size(u32=16) · format(u16=1 PCM) · channels(u16=2) ·
//!   sample_rate(u32) · byte_rate(u32=rate*4) · block_align(u16=4) · bits(u16=16) · "data"(4) · data_size(u32) · payload.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/stereo_wav.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const stereo_wav_version = "20260815.130649";

/// One PCM sample is a little-endian signed 16-bit integer — two bytes.
pub const sample_bytes: u32 = 2;

/// Two channels — left and right.
pub const channels_stereo: u16 = 2;

/// One stereo FRAME is one left plus one right sample — four bytes. The block align, and the alignment border's unit.
pub const frame_bytes: u32 = channels_stereo * sample_bytes;

/// The canonical mono/16-bit RIFF/WAVE header length — the stereo container shares the same 44-byte header shape, differing
/// only in the channels, block-align, and byte-rate field VALUES.
pub const header_len: u32 = 44;

/// The one PCM format code this container speaks — 1, uncompressed integer PCM.
pub const pcm_format: u16 = 1;

/// Sixteen bits per sample.
pub const bits_per_sample: u16 = 16;

/// The fmt chunk body is always 16 bytes for canonical PCM.
pub const fmt_chunk_size: u32 = 16;

/// The widest per-channel buffer one container carries in this rung — a bounded ceiling so no size arithmetic overflows.
pub const max_frames: u32 = 1 << 20;

/// The widest data chunk — `max_frames` four-byte frames.
pub const max_data: u32 = max_frames * frame_bytes;

/// The widest whole container — header plus the widest data chunk.
pub const max_file: u32 = header_len + max_data;

/// A sane upper bound on the sample-rate FIELD, so `sample_rate * frame_bytes` (the byte rate) can never overflow u32.
pub const max_sample_rate: u32 = 768_000;

pub const StereoWavError = error{
    /// Fewer bytes than a whole canonical header cannot be read as a container.
    FileTooShort,
    /// The opening four bytes are not "RIFF".
    BadRiff,
    /// The declared RIFF chunk size does not equal the file length minus the 8-byte RIFF prefix.
    RiffSizeMismatch,
    /// The form type after the RIFF size is not "WAVE".
    BadWave,
    /// The first sub-chunk is not "fmt ".
    BadFmt,
    /// The fmt chunk body is not the canonical 16 bytes.
    BadFmtSize,
    /// The audio format code is not 1 (uncompressed integer PCM).
    NotPcm,
    /// The channel count is not 2 — this rung carries stereo only, and refuses a mono container.
    NotStereo,
    /// The declared byte rate does not equal sample_rate * 4.
    ByteRateMismatch,
    /// The block align is not 4 (one stereo frame).
    BlockAlignMismatch,
    /// The bit depth is not 16.
    NotSixteenBit,
    /// The chunk after fmt is not "data".
    BadData,
    /// The declared data size is not a whole number of stereo frames — neither channel may receive a lone unpaired sample.
    PartialFrame,
    /// The declared data size is past this rung's ceiling — refused before any sample is read.
    DataOverflow,
    /// The header plus declared data size does not equal the buffer length.
    DataSizeMismatch,
    /// The sample-rate field is zero or past the sane ceiling.
    BadSampleRate,
    /// The two channel buffers offered to encode are not the same length.
    ChannelLengthMismatch,
    /// More frames offered to the encoder than one container carries.
    TooManyFrames,
    /// A caller buffer cannot hold the whole encoded container, or the whole decoded per-channel frame count.
    OutputTooSmall,
};

/// What a decoded stereo container yields: the sample-rate field it carried and how many frames were read into each channel.
pub const StereoPcm = struct {
    sample_rate: u32 = 0,
    frames: u32 = 0,
};

/// Write the four ASCII bytes of a chunk tag at `off`. A plain bounded loop, never a bare memcpy.
fn put_tag(out: []u8, off: u32, tag: *const [4]u8) void {
    // invariant: the four tag bytes land wholly within the buffer.
    assert(off + 4 <= out.len);
    // invariant: a tag is exactly four bytes — the RIFF chunk-id width.
    assert(tag.len == 4);
    var i: u32 = 0;
    while (i < 4) : (i += 1) out[off + i] = tag[i];
}

/// True when the four bytes at `off` equal `tag`. The single place a chunk tag is compared.
fn tag_is(bytes: []const u8, off: u32, tag: *const [4]u8) bool {
    // invariant: the compare window sits wholly within the bytes.
    assert(off + 4 <= bytes.len);
    var i: u32 = 0;
    while (i < 4) : (i += 1) {
        if (bytes[off + i] != tag[i]) return false;
    }
    return true;
}

/// Encode two equal-length mono i16 buffers into a canonical interleaved stereo RIFF/WAVE container, returning the byte
/// length. Every fault refuses BEFORE a single byte is written, so a failed encode never leaves a half-written container.
pub fn encode(sample_rate: u32, left: []const i16, right: []const i16, out: []u8) StereoWavError!u32 {
    if (left.len != right.len) return error.ChannelLengthMismatch;
    if (left.len > max_frames) return error.TooManyFrames;
    if (sample_rate == 0 or sample_rate > max_sample_rate) return error.BadSampleRate;
    const frames: u32 = @intCast(left.len);
    const data_size = frames * frame_bytes;
    const file_len = header_len + data_size;
    if (out.len < file_len) return error.OutputTooSmall;
    // invariant: the two channels are the same length, so every frame has both a left and a right sample.
    assert(left.len == right.len);
    // invariant: the whole container fits the caller's buffer, proven before any write.
    assert(file_len <= out.len);
    // invariant: the data chunk is a whole number of frames by construction.
    assert(data_size % frame_bytes == 0);

    put_tag(out, 0, "RIFF");
    std.mem.writeInt(u32, out[4..8], file_len - 8, .little);
    put_tag(out, 8, "WAVE");
    put_tag(out, 12, "fmt ");
    std.mem.writeInt(u32, out[16..20], fmt_chunk_size, .little);
    std.mem.writeInt(u16, out[20..22], pcm_format, .little);
    std.mem.writeInt(u16, out[22..24], channels_stereo, .little);
    std.mem.writeInt(u32, out[24..28], sample_rate, .little);
    std.mem.writeInt(u32, out[28..32], sample_rate * frame_bytes, .little);
    std.mem.writeInt(u16, out[32..34], @intCast(frame_bytes), .little);
    std.mem.writeInt(u16, out[34..36], bits_per_sample, .little);
    put_tag(out, 36, "data");
    std.mem.writeInt(u32, out[40..44], data_size, .little);

    var i: u32 = 0;
    while (i < frames) : (i += 1) {
        const at = header_len + i * frame_bytes;
        std.mem.writeInt(i16, out[at..][0..2], left[i], .little);
        std.mem.writeInt(i16, out[at + sample_bytes ..][0..2], right[i], .little);
    }
    // invariant: the returned length is exactly header plus the whole interleaved data chunk written.
    assert(file_len == header_len + frames * frame_bytes);
    return file_len;
}

/// Prove a container whole and canonical stereo, running every check in order BEFORE any sample is read, then de-interleave
/// its frames into the two channel buffers. The size chain proves the file self-consistent and the frame border proves it
/// frame-aligned — two independent gates, so neither channel ever receives a lone unpaired sample.
pub fn decode(bytes: []const u8, left: []i16, right: []i16) StereoWavError!StereoPcm {
    if (bytes.len < header_len) return error.FileTooShort;
    if (!tag_is(bytes, 0, "RIFF")) return error.BadRiff;
    const riff_size = std.mem.readInt(u32, bytes[4..8], .little);
    if (riff_size != @as(u32, @intCast(bytes.len)) - 8) return error.RiffSizeMismatch;
    if (!tag_is(bytes, 8, "WAVE")) return error.BadWave;
    if (!tag_is(bytes, 12, "fmt ")) return error.BadFmt;
    if (std.mem.readInt(u32, bytes[16..20], .little) != fmt_chunk_size) return error.BadFmtSize;
    if (std.mem.readInt(u16, bytes[20..22], .little) != pcm_format) return error.NotPcm;
    if (std.mem.readInt(u16, bytes[22..24], .little) != channels_stereo) return error.NotStereo;
    const sample_rate = std.mem.readInt(u32, bytes[24..28], .little);
    if (sample_rate == 0 or sample_rate > max_sample_rate) return error.BadSampleRate;
    if (std.mem.readInt(u32, bytes[28..32], .little) != sample_rate * frame_bytes) return error.ByteRateMismatch;
    if (std.mem.readInt(u16, bytes[32..34], .little) != @as(u16, @intCast(frame_bytes))) return error.BlockAlignMismatch;
    if (std.mem.readInt(u16, bytes[34..36], .little) != bits_per_sample) return error.NotSixteenBit;
    if (!tag_is(bytes, 36, "data")) return error.BadData;
    const data_size = std.mem.readInt(u32, bytes[40..44], .little);
    // THE FRAME BORDER — a data chunk that is not a whole number of stereo frames would leave one channel a lone sample.
    // Refuse it before a single sample is read.
    if (data_size % frame_bytes != 0) return error.PartialFrame;
    if (data_size > max_data) return error.DataOverflow;
    if (header_len + data_size != bytes.len) return error.DataSizeMismatch;
    const frames: u32 = data_size / frame_bytes;
    if (frames > left.len or frames > right.len) return error.OutputTooSmall;
    // invariant: the data chunk is proven whole, frame-aligned, and within bound before any sample is read.
    assert(frames * frame_bytes == data_size);
    assert(frames <= left.len and frames <= right.len);

    var i: u32 = 0;
    while (i < frames) : (i += 1) {
        const at = header_len + i * frame_bytes;
        left[i] = std.mem.readInt(i16, bytes[at..][0..2], .little);
        right[i] = std.mem.readInt(i16, bytes[at + sample_bytes ..][0..2], .little);
    }
    // invariant: exactly the container's declared frame count was de-interleaved into each channel.
    assert(i == frames);
    return .{ .sample_rate = sample_rate, .frames = frames };
}

// --- selftest: two channel buffers round-trip byte-for-byte through the canonical interleaved container; the payload is
//     exactly L R L R; an empty pair yields a valid 44-byte header; a torn frame refuses PartialFrame; and every header
//     corruption — including a mono container offered to a stereo decoder — refuses by name before a sample crosses ---------

fn run_selftest() !u8 {
    const rate: u32 = 48_000;
    // Distinct left and right buffers so a byte-for-byte de-interleave is a real check; boundary-touching i16 values.
    const left = [_]i16{ 0, 100, -100, 32767, -32768, 7, -7, 4242 };
    const right = [_]i16{ 1, -1, 200, -32768, 32767, -8, 8, -4242 };

    var file: [header_len + 64 * frame_bytes]u8 = undefined;
    var lb: [64]i16 = undefined;
    var rb: [64]i16 = undefined;

    // 1. THE ROUND-TRIP LAW — both channels encode and decode back byte-for-byte, the rate preserved.
    const wrote = try encode(rate, &left, &right, &file);
    assert(wrote == header_len + left.len * frame_bytes);
    {
        const got = try decode(file[0..wrote], &lb, &rb);
        assert(got.sample_rate == rate);
        assert(got.frames == left.len);
        var s: u32 = 0;
        while (s < left.len) : (s += 1) {
            assert(lb[s] == left[s]);
            assert(rb[s] == right[s]);
        }
    }

    // 2. THE INTERLEAVE LAW — the payload is exactly L0 R0 L1 R1 …; left at even frame slots, right at odd.
    {
        var s: u32 = 0;
        while (s < left.len) : (s += 1) {
            const at = header_len + s * frame_bytes;
            assert(std.mem.readInt(i16, file[at..][0..2], .little) == left[s]);
            assert(std.mem.readInt(i16, file[at + sample_bytes ..][0..2], .little) == right[s]);
        }
    }

    // 3. THE CANONICAL-STEREO-HEADER LAW — exactly the canonical stereo/16-bit fields.
    {
        assert(tag_is(file[0..wrote], 0, "RIFF"));
        assert(std.mem.readInt(u32, file[4..8], .little) == wrote - 8);
        assert(tag_is(file[0..wrote], 8, "WAVE"));
        assert(tag_is(file[0..wrote], 12, "fmt "));
        assert(std.mem.readInt(u16, file[22..24], .little) == channels_stereo);
        assert(std.mem.readInt(u32, file[28..32], .little) == rate * frame_bytes);
        assert(std.mem.readInt(u16, file[32..34], .little) == frame_bytes);
        assert(std.mem.readInt(u16, file[34..36], .little) == bits_per_sample);
        assert(tag_is(file[0..wrote], 36, "data"));
        assert(std.mem.readInt(u32, file[40..44], .little) == left.len * frame_bytes);
    }

    // 4. THE EMPTY LAW — zero frames encode to a valid 44-byte header and decode back to zero frames.
    {
        const el = [_]i16{};
        const er = [_]i16{};
        var ef: [header_len]u8 = undefined;
        const ew = try encode(rate, &el, &er, &ef);
        assert(ew == header_len);
        var elb: [1]i16 = undefined;
        var erb: [1]i16 = undefined;
        const eg = try decode(ef[0..ew], &elb, &erb);
        assert(eg.frames == 0);
        assert(eg.sample_rate == rate);
    }

    // 5. THE FRAME-BORDER LAW — a data chunk one byte short of a whole frame refuses PartialFrame. Shorten and fix both size
    //    fields so only the border can catch it.
    {
        var f = file;
        const short_data = (left.len * frame_bytes) - 1; // one byte short of a whole frame
        const short_len = header_len + short_data;
        std.mem.writeInt(u32, f[4..8], short_len - 8, .little);
        std.mem.writeInt(u32, f[40..44], short_data, .little);
        if (decode(f[0..short_len], &lb, &rb)) |_| return error.PartialSlipped else |e| if (e != error.PartialFrame) return error.WrongPartial;
    }

    // 6. THE FAULT LAW — every structural corruption refuses by name.
    {
        if (decode(file[0 .. header_len - 1], &lb, &rb)) |_| return error.ShortSlipped else |e| if (e != error.FileTooShort) return error.WrongShort;

        // A flipped RIFF tag.
        {
            var c = file;
            c[0] = 'X';
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.RiffSlipped else |e| if (e != error.BadRiff) return error.WrongRiff;
        }
        // A non-WAVE form.
        {
            var c = file;
            c[8] = 'X';
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.WaveSlipped else |e| if (e != error.BadWave) return error.WrongWave;
        }
        // A non-"fmt " chunk.
        {
            var c = file;
            c[12] = 'X';
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.FmtSlipped else |e| if (e != error.BadFmt) return error.WrongFmt;
        }
        // A non-PCM format.
        {
            var c = file;
            std.mem.writeInt(u16, c[20..22], 3, .little);
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.PcmSlipped else |e| if (e != error.NotPcm) return error.WrongPcm;
        }
        // A MONO container refused by the stereo decoder.
        {
            var c = file;
            std.mem.writeInt(u16, c[22..24], 1, .little);
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.StereoSlipped else |e| if (e != error.NotStereo) return error.WrongStereo;
        }
        // A mismatched byte rate.
        {
            var c = file;
            std.mem.writeInt(u32, c[28..32], rate * sample_bytes, .little); // mono byte rate, not stereo
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.ByteRateSlipped else |e| if (e != error.ByteRateMismatch) return error.WrongByteRate;
        }
        // A wrong block align.
        {
            var c = file;
            std.mem.writeInt(u16, c[32..34], 2, .little);
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.BlockAlignSlipped else |e| if (e != error.BlockAlignMismatch) return error.WrongBlockAlign;
        }
        // A non-16-bit depth.
        {
            var c = file;
            std.mem.writeInt(u16, c[34..36], 24, .little);
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.BitsSlipped else |e| if (e != error.NotSixteenBit) return error.WrongBits;
        }
        // A non-"data" chunk.
        {
            var c = file;
            c[36] = 'X';
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.DataSlipped else |e| if (e != error.BadData) return error.WrongData;
        }
        // A mismatched data size.
        {
            var c = file;
            std.mem.writeInt(u32, c[40..44], (left.len * frame_bytes) - frame_bytes, .little);
            if (decode(c[0..wrote], &lb, &rb)) |_| return error.DataSizeSlipped else |e| if (e != error.DataSizeMismatch) return error.WrongDataSize;
        }
    }

    // 7. Encode faults refuse before any write.
    {
        const shortr = [_]i16{ 1, 2 };
        var small: [header_len + frame_bytes]u8 = undefined;
        // Unequal channel lengths.
        if (encode(rate, &left, &shortr, &small)) |_| return error.MismatchSlipped else |e| if (e != error.ChannelLengthMismatch) return error.WrongMismatch;
        // An output buffer too small.
        if (encode(rate, &left, &right, &small)) |_| return error.SmallSlipped else |e| if (e != error.OutputTooSmall) return error.WrongSmall;
        // A zero sample rate.
        var ok: [header_len + 8 * frame_bytes]u8 = undefined;
        if (encode(0, &left, &right, &ok)) |_| return error.RateSlipped else |e| if (e != error.BadSampleRate) return error.WrongRate;
    }

    print("GREEN ales-stereo-wav: two bounded i16 channel buffers round-trip byte-for-byte through the canonical interleaved " ++
        "RIFF/WAVE stereo container (channels 2 · block_align 4 · byte_rate rate*4 · data), the payload exactly L R L R and " ++
        "the sample-rate field preserved; an empty pair yields a valid 44-byte header; a data chunk one byte short of a whole " ++
        "frame refuses PartialFrame at the frame border; and a bad RIFF/WAVE/fmt tag, non-PCM format, a MONO container, " ++
        "mismatched byte rate or block align, non-16-bit depth, absent data chunk, mismatched size, unequal channel lengths, " ++
        "or a too-small output each refuses by name before a sample crosses — structure and frame-alignment are two gates, so " ++
        "neither channel ever receives a lone unpaired sample; a byte container only, no real file, no DAC, no acoustic fact, " ++
        "no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
