//! lotus/rack_sheet.rye — ALES33: the rack travels as text — a SLOT SHEET. ALES30's rack lets a keeper hold a handful of named
//! spans (the count-in, the verse, the chorus, the clean bridge take) and reach for each by name, yet every slot lives only in
//! process memory — close the session and the whole rack is gone. ALES22 already proved the one primitive that outlives a session:
//! render a structure to canonical text, parse it back to exactly the same structure. This rung hands that law to the rack. The
//! difference is honest and load-bearing: a markers track carries only positions and names — small integers — while a rack carries
//! ACTUAL STEREO AUDIO in each slot, so a slot sheet renders each slot's held sample buffers, the first ALES "travels as text" rung
//! to persist real PCM.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES33.
//! Design read: active-designing/20260814-150213_fill-ales33-lotus-rack-sheet.md
//! Stands on: lotus/rack.rye (ALES30) — copy_to reused WHOLE so every rack bound (BadName / Duplicate / RackFull) is enforced at the
//! one place, and name_of / the slot boards read for render; lotus/selection.rye (ALES23) — make grabs the whole rebuilt span, its
//! empty-span refusal the reason a rack slot always holds >=1 sample; lotus/timeline.rye (ALES2) — splice builds the temp master a
//! slot is rebuilt from; lotus/pan.rye (ALES10) — the StereoClip; tally/parse_int.rye — strict decimal at the text edge (a leading
//! zero refuses, so `007` never masquerades as `7`). Mirrors the proven "travels as text" idiom of lotus/cue_sheet.rye (ALES22).
//!
//! THE CRUX: a rack rendered to a slot sheet parses back to EXACTLY the same rack — parse_rack(render_rack(r)) recovers every slot's
//! name and both channels' samples byte-for-byte, and render_rack(parse_rack(render_rack(r))) is a fixed point. Two facts make this
//! exact. Render walks the slots in stored (fill) order, each name and each channel's samples printed canonically (i16 decimal, no
//! leading zero, a sign only where negative), so the text has no per-render choice to drift. And parse rebuilds each slot through
//! ALES30's own rack.copy_to — building a tiny temporary master holding exactly the parsed samples, grabbing the whole span with
//! selection.make, and handing it to copy_to — so the parsed rack is name-bounded, duplicate-free, and within the slot ceiling by
//! ALES30's own invariant; a corrupt record refuses BadRecord, or forwards BadName / Duplicate / RackFull by the rack's own name,
//! before a byte is trusted.
//!
//! HONEST SCOPE — software only, purely LOCAL. Text in, text out, over in-process two-channel i16 PCM slot buffers, siloed to lotus/.
//! A slot sheet is a rack's held audio as words, not a signal on a wire. No socket, no network, no keys, no funds, no real device, no
//! real meter, no real speaker.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/rack_sheet.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");
const pan = @import("pan.rye");
const selection = @import("selection.rye");
const rack = @import("rack.rye");
const parse_int = @import("parse_int.rye");

pub const rack_sheet_version = "20260814.150213";

/// The record header, its own line. A parsed record must open with exactly this, so a foreign or corrupt text refuses at the first
/// line before any slot is trusted.
const sheet_header = "format lotus-rack-sheet-v1";

/// The widest decimal an i16 sample can render — "-32768", six bytes. Named so the render bound below is proven, never guessed.
const max_sample_digits: u32 = 6;

/// The most bytes a rendered slot sheet can need: the header line, then per slot a `slot <name>` line and two channel lines, each
/// channel at most `max_clip` samples wide. Every line is bounded — a name ≤ max_name, a channel ≤ max_clip samples each a space
/// plus at most six digits — so the whole record is proven to fit a fixed bound, never an unbounded string. A documented ceiling;
/// render bounds by the caller's own buffer, so no caller ever allocates the full worst case.
pub const max_rack_sheet_bytes: u32 = @intCast(sheet_header.len + 1 +
    rack.max_slots * ((5 + rack.max_name + 1) + 2 * (1 + timeline.max_clip * (1 + max_sample_digits) + 1)));

/// The combined error set of the slot sheet: two honest edges for the text grammar, every rack bound forwarded unchanged from
/// ALES30's rack.copy_to (which already carries ALES25's clipboard, ALES23's selection, and ALES2's edit faults). Each fault refuses
/// by name before a slot is trusted or a byte written past the buffer.
pub const RackSheetError = error{
    /// A render whose text would exceed the caller's buffer — refused rather than writing past its end.
    Overflow,
    /// A slot sheet whose header, line order, channel tag, channel-length agreement, or a sample field is malformed — the one honest
    /// error at the text grammar edge.
    BadRecord,
} || rack.RackError;

/// Append `fmt`/`args` to `out` at `off`, returning the new offset. Refuses Overflow rather than writing past the buffer's end. The
/// offset only advances on a write that fit, so `off` never exceeds `out.len` and the next slice is always in bounds.
fn append(out: []u8, off: u32, comptime fmt: []const u8, args: anytype) RackSheetError!u32 {
    // invariant: the offset never runs past the buffer before a write is attempted.
    assert(off <= out.len);
    const w = std.fmt.bufPrint(out[off..], fmt, args) catch return error.Overflow;
    // usize seam: bufPrint returns a slice whose length is a byte count bounded by the buffer; keep the running offset in u32.
    return off + @as(u32, @intCast(w.len));
}

/// Render one channel as `<tag> <s0> <s1> …` into `out` at `off`, returning the new offset. Each sample is canonical i16 decimal, one
/// space before each, then a newline. Refuses Overflow rather than overrun.
fn render_channel(out: []u8, off_in: u32, tag: []const u8, samples: []const i16) RackSheetError!u32 {
    // invariant: a channel never renders more samples than a clip can hold.
    assert(samples.len <= timeline.max_clip);
    var off = try append(out, off_in, "{s}", .{tag});
    var k: u32 = 0;
    while (k < samples.len) : (k += 1) off = try append(out, off, " {d}", .{samples[k]});
    return try append(out, off, "\n", .{});
}

/// Render a whole rack as its `format lotus-rack-sheet-v1` record into `out`, returning the length written. A header line, then per
/// slot in stored (fill) order a `slot <name>` line and the two channel lines `L …` / `R …`. Refuses Overflow rather than writing
/// past the buffer a caller supplied. So a keeper's whole rack travels as shareable text, and — with parse_rack —
/// render(parse(render(r))) is a fixed point.
pub fn render_rack(r: *const rack.Rack, out: []u8) RackSheetError!u32 {
    // invariant: the rack stays within its named ceiling before it is ever rendered.
    assert(r.count <= rack.max_slots);
    var off = try append(out, 0, "{s}\n", .{sheet_header});

    var i: u32 = 0;
    while (i < r.count) : (i += 1) {
        // The name is bounded by max_name; the two channels each by max_clip — so a slot's three lines can never overrun a well-sized
        // buffer, and a slot's two held channels always share one length (a rack slot is filled from a non-empty selection).
        const board = &r.slots[i].board;
        // invariant: the slot's two held channels share one length — the lockstep every rack slot keeps.
        assert(board.left.len == board.right.len and board.len <= board.left.len);
        off = try append(out, off, "slot {s}\n", .{rack.name_of(r, i)});
        off = try render_channel(out, off, "L", board.left[0..board.len]);
        off = try render_channel(out, off, "R", board.right[0..board.len]);
    }
    // invariant: the rendered record stays within the buffer.
    assert(off <= out.len);
    return off;
}

/// Parse one channel line `<tag> <s0> <s1> …` into `buf`, returning the sample count. The line must open with `tag`; samples follow,
/// each after a single space, strict decimal (a leading zero refuses). A wrong tag, a double or trailing space, a non-numeric or
/// leading-zero sample, or more samples than a clip holds refuses BadRecord. So a corrupt channel refuses before a sample is trusted.
fn parse_channel(tag: u8, line: []const u8, buf: []i16) RackSheetError!u32 {
    if (line.len == 0 or line[0] != tag) return error.BadRecord;
    const rest = line[1..];
    if (rest.len == 0) return 0; // a bare tag line holds no samples
    if (rest[0] != ' ') return error.BadRecord; // samples always follow a single delimiting space
    var n: u32 = 0;
    var toks = std.mem.splitScalar(u8, rest[1..], ' ');
    while (toks.next()) |t| {
        if (t.len == 0) return error.BadRecord; // a double or trailing space is not canonical
        if (n >= buf.len) return error.BadRecord; // a channel wider than a clip refuses rather than overrun
        buf[n] = parse_int.parse_int(i16, t, .{}) catch return error.BadRecord;
        n += 1;
    }
    // invariant: the parsed count never claims more samples than the scratch buffer holds.
    assert(n <= buf.len);
    return n;
}

/// Parse a `format lotus-rack-sheet-v1` record into a fresh rack. Past the header, each slot is three lines: `slot <name>` (the name
/// is the remainder of the line, so a name may carry spaces), then `L …` and `R …`. Each slot is rebuilt through ALES30's rack.copy_to
/// — a tiny temporary master holds exactly the parsed samples and the whole span is grabbed with selection.make — so the parsed rack
/// is name-bounded, duplicate-free, and within the slot ceiling by ALES30's own invariant, enforced at the text edge rather than
/// re-spelled here. A bad header, a mis-ordered line, a channel-length mismatch, or a malformed sample refuses BadRecord; every rack
/// bound forwards by its own name (BadName, Duplicate, RackFull).
pub fn parse_rack(text: []const u8, out: *rack.Rack) RackSheetError!void {
    // invariant: parsing starts from an empty rack.
    out.* = rack.Rack{};
    assert(out.count == 0);

    var lines = std.mem.splitScalar(u8, text, '\n');
    const first = lines.next() orelse return error.BadRecord;
    if (!std.mem.eql(u8, first, sheet_header)) return error.BadRecord;

    // Each iteration reads exactly one slot record — a `slot` line and its two channel lines. Bounded: copy_to refuses RackFull past
    // the ceiling, so the rack can never accept more than max_slots records however long the text.
    while (lines.next()) |slot_line| {
        if (slot_line.len == 0) {
            // a trailing newline yields an empty final piece; it must be the last thing in the text.
            if (lines.next() != null) return error.BadRecord;
            break;
        }
        const prefix = "slot ";
        if (slot_line.len <= prefix.len or !std.mem.eql(u8, slot_line[0..prefix.len], prefix)) return error.BadRecord;
        const name = slot_line[prefix.len..];

        const l_line = lines.next() orelse return error.BadRecord;
        const r_line = lines.next() orelse return error.BadRecord;

        var lbuf: [timeline.max_clip]i16 = undefined;
        var rbuf: [timeline.max_clip]i16 = undefined;
        const ln = try parse_channel('L', l_line, lbuf[0..]);
        const rn = try parse_channel('R', r_line, rbuf[0..]);
        // A slot's two channels always share one length; a mismatch is corrupt. A slot always holds at least one sample (it was
        // filled from a non-empty selection), so a zero-length record is corrupt too.
        if (ln != rn) return error.BadRecord;
        if (ln == 0) return error.BadRecord;

        // Rebuild the slot through ALES30's own copy_to over a temporary master — every rack bound enforced at the one place.
        var master = pan.StereoClip{};
        try timeline.splice(&master.left, 0, lbuf[0..ln]);
        try timeline.splice(&master.right, 0, rbuf[0..rn]);
        const sel = selection.make(&master, 0, ln) catch return error.BadRecord;
        try rack.copy_to(out, name, &master, sel);
    }
    // invariant: a parsed rack holds no more than the slot ceiling.
    assert(out.count <= rack.max_slots);
}

// --- selftest: THE CRUX — a rack renders to the exact expected format lotus-rack-sheet-v1 text; parse recovers every slot's name and
//     both channels byte-for-byte; render(parse(render(r))) is a fixed point; a name with a space round-trips; and every corruption
//     refuses by name ------------------------------------------------------------------------------------------------------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

// Paste a recovered slot into a fresh master and compare both channels to what was filed — proof the slot's audio round-tripped.
fn slot_is(r: *const rack.Rack, name: []const u8, want_l: []const i16, want_r: []const i16) !void {
    var m = pan.StereoClip{};
    try rack.paste(r, name, &m, 0);
    if (!eq(m.left.samples(), want_l)) return error.SlotLeftWrong;
    if (!eq(m.right.samples(), want_r)) return error.SlotRightWrong;
}

fn run_selftest() !u8 {
    // 1. THE CRUX — a two-slot rack renders to the exact expected text, and parse recovers both names and both channels byte-for-byte.
    //    Source left {0,1,2,3,4,5}, right {0,-1,-2,-3,-4,-5}; file [1,3)="head"={1,2}/{-1,-2}, [4,6)="tail"={4,5}/{-4,-5}.
    {
        var src = pan.StereoClip{};
        try timeline.splice(&src.left, 0, &[_]i16{ 0, 1, 2, 3, 4, 5 });
        try timeline.splice(&src.right, 0, &[_]i16{ 0, -1, -2, -3, -4, -5 });
        var r = rack.Rack{};
        try rack.copy_to(&r, "head", &src, try selection.make(&src, 1, 3));
        try rack.copy_to(&r, "tail", &src, try selection.make(&src, 4, 6));

        var text: [512]u8 = undefined;
        const n = try render_rack(&r, text[0..]);
        const want = "format lotus-rack-sheet-v1\n" ++
            "slot head\nL 1 2\nR -1 -2\n" ++
            "slot tail\nL 4 5\nR -4 -5\n";
        if (!std.mem.eql(u8, text[0..n], want)) return error.RenderWrong;

        var back = rack.Rack{};
        try parse_rack(text[0..n], &back);
        if (back.size() != 2) return error.ParseCountWrong;
        if (!std.mem.eql(u8, rack.name_of(&back, 0), "head")) return error.ParseName0Wrong;
        if (!std.mem.eql(u8, rack.name_of(&back, 1), "tail")) return error.ParseName1Wrong;
        try slot_is(&back, "head", &[_]i16{ 1, 2 }, &[_]i16{ -1, -2 });
        try slot_is(&back, "tail", &[_]i16{ 4, 5 }, &[_]i16{ -4, -5 });

        // render(parse(render(r))) is a fixed point — the parsed rack renders to the identical bytes.
        var text2: [512]u8 = undefined;
        const n2 = try render_rack(&back, text2[0..]);
        if (!std.mem.eql(u8, text[0..n], text2[0..n2])) return error.NotFixedPoint;
    }

    // 2. a name carrying a SPACE round-trips whole — the name is the remainder of the slot line, so a space survives.
    {
        var src = pan.StereoClip{};
        try timeline.splice(&src.left, 0, &[_]i16{ 7, 8, 9 });
        try timeline.splice(&src.right, 0, &[_]i16{ 70, 80, 90 });
        var r = rack.Rack{};
        try rack.copy_to(&r, "clean bridge take", &src, try selection.make(&src, 0, 3));

        var text: [256]u8 = undefined;
        const n = try render_rack(&r, text[0..]);
        var back = rack.Rack{};
        try parse_rack(text[0..n], &back);
        if (!std.mem.eql(u8, rack.name_of(&back, 0), "clean bridge take")) return error.SpaceNameWrong;
        try slot_is(&back, "clean bridge take", &[_]i16{ 7, 8, 9 }, &[_]i16{ 70, 80, 90 });
    }

    // 3. every corruption at the text grammar refuses BadRecord — a bad header, a mis-ordered line (L before slot), a wrong channel
    //    tag, an L/R length mismatch, a leading-zero sample (the parse_int footgun refused), and a non-numeric sample.
    {
        var back = rack.Rack{};
        if (parse_rack("format wrong-header\nslot a\nL 1\nR 1\n", &back)) |_| return error.BadHeaderSlipped else |e| if (e != error.BadRecord) return error.WrongBadHeader;
        if (parse_rack("format lotus-rack-sheet-v1\nL 1\nR 1\n", &back)) |_| return error.MisorderSlipped else |e| if (e != error.BadRecord) return error.WrongMisorder;
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nX 1\nR 1\n", &back)) |_| return error.BadTagSlipped else |e| if (e != error.BadRecord) return error.WrongBadTag;
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nL 1 2\nR 1\n", &back)) |_| return error.LenMismatchSlipped else |e| if (e != error.BadRecord) return error.WrongLenMismatch;
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nL 007\nR 1\n", &back)) |_| return error.LeadingZeroSlipped else |e| if (e != error.BadRecord) return error.WrongLeadingZero;
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nL 1x\nR 1\n", &back)) |_| return error.BadNumSlipped else |e| if (e != error.BadRecord) return error.WrongBadNum;
        // a zero-length slot record refuses — a rack slot always holds at least one sample.
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nL\nR\n", &back)) |_| return error.EmptySlotSlipped else |e| if (e != error.BadRecord) return error.WrongEmptySlot;
    }

    // 4. a rack bound forwards by its own name — a duplicate slot name (Duplicate), and a record past the slot ceiling (RackFull).
    {
        var back = rack.Rack{};
        if (parse_rack("format lotus-rack-sheet-v1\nslot a\nL 1\nR 1\nslot a\nL 2\nR 2\n", &back)) |_| return error.DupSlipped else |e| if (e != error.Duplicate) return error.WrongDup;

        // build a record of max_slots+1 slots — each a distinct one-letter name — and parse it.
        var over: [1024]u8 = undefined;
        var off = try append(over[0..], 0, "{s}\n", .{sheet_header});
        var s: u32 = 0;
        while (s < rack.max_slots + 1) : (s += 1) {
            const nm = [_]u8{@intCast('a' + s)};
            off = try append(over[0..], off, "slot {s}\nL {d}\nR {d}\n", .{ nm[0..], s, s });
        }
        if (parse_rack(over[0..off], &back)) |_| return error.FullSlipped else |e| if (e != error.RackFull) return error.WrongFull;
    }

    // 5. a render into a too-small buffer refuses Overflow rather than writing past its end.
    {
        var src = pan.StereoClip{};
        try timeline.splice(&src.left, 0, &[_]i16{ 1, 2, 3 });
        try timeline.splice(&src.right, 0, &[_]i16{ 1, 2, 3 });
        var r = rack.Rack{};
        try rack.copy_to(&r, "x", &src, try selection.make(&src, 0, 3));
        var tiny: [8]u8 = undefined; // smaller than even the header line
        if (render_rack(&r, tiny[0..])) |_| return error.OverflowSlipped else |e| if (e != error.Overflow) return error.WrongOverflow;
    }

    print("GREEN ales-rack-sheet: a rack travels as a format lotus-rack-sheet-v1 record — a keeper's whole set of named held spans " ++
        "persists across a session close and ports as plain text, the first ALES travels-as-text rung to carry real PCM. THE CRUX: " ++
        "parse_rack(render_rack(r)) recovers every slot's name and both channels' samples byte-for-byte and render(parse(render(r))) " ++
        "is a fixed point, the render walking the slots in stored order so the text is canonical (i16 decimal, no leading zero) and " ++
        "the parse rebuilding each slot through ALES30's own rack.copy_to over a temporary master so every rack bound is enforced at " ++
        "the one place; a name with a space round-trips whole; and every corruption refuses by name — a bad header, a mis-ordered " ++
        "line, a wrong channel tag, an L/R length mismatch, a leading-zero or non-numeric sample, a zero-length slot BadRecord, a " ++
        "duplicate slot name Duplicate, a record past the ceiling RackFull, a render into a too-small buffer Overflow; rack.copy_to / " ++
        "name_of / paste and parse_int reused whole; no socket, no network, no keys, no funds, no real device, no real meter, no real " ++
        "speaker\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
