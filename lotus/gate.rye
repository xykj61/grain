//! lotus/gate.rye — ALES51: a noise gate — the compressor's threshold turned upside down. The compressor (ALES50) leans on what
//! rises ABOVE the threshold; the gate leans on what falls BELOW it. Where the compressor softens the loud, the gate quiets the
//! quiet — the hiss between words, the amp hum under a held chord, the room tone in a podcast pause. It is the third member of the
//! dynamics family: the limiter (ALES49) caps the peaks, the compressor softens them, and the gate silences the floor. Its knob is
//! the same ratio the compressor speaks, only now it names how hard the quiet is pushed down, and at its extreme the gate closes
//! to silence — the below-threshold magnitude divided to nothing.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES51.
//! Design read: active-designing/20260814-171918_fill-ales51-lotus-noise-gate.md
//! Stands on: lotus/timeline.rye (ALES2) — the Clip, sample_min/sample_max, the range law shape; lotus/compress.rye (ALES50) — the
//! threshold this inverts, re-proven beside it.
//!
//! HONEST SCOPE — software only, purely LOCAL. Bounded in-process i16 PCM buffers on one bench, siloed to lotus/. No socket,
//! no network, no keys, no funds, no real device, no real sample rate — the threshold is a magnitude in sample units, not
//! decibels, the ratio a plain fraction, and the gating is instantaneous (no attack, hold, or release — those are later rungs).
//! One comparison and at most one divide per sample; nothing on the audio path can overflow, since the ratio is at least one so a
//! gated magnitude is at most the input magnitude, which already fits i16.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/gate.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");

pub const gate_version = "20260814.171918";

/// The gate's faults: a threshold outside the legal range (a magnitude in [1, sample_max]), a ratio below unity or with a zero
/// denominator (a ratio below one would BOOST the quiet — a different tool), and a span outside the samples. BadRange coincides by
/// name with timeline's, the EQ family's, the limiter's, and the compressor's, so a composer sees one consistent fault.
pub const GateError = error{
    /// A threshold of zero (there is no band left to gate below it) or above sample_max (everything would fall below it) — refused.
    BadThreshold,
    /// A ratio below unity (would boost the quiet, not attenuate it) or with a zero denominator — refused, no write.
    BadRatio,
    /// A span outside the current samples — refused, no write.
    BadRange,
};

/// Gate `count` samples starting at `start` in place below the magnitude `threshold` by the ratio `ratio_num/ratio_den` (at least
/// one). A sample at or above the threshold passes byte-for-byte (the gate is open); below it, the magnitude m is divided by the
/// ratio and the sample rewritten sign(x)·(m·ratio_den/ratio_num). After the call every written magnitude is at most the input's
/// (the gate attenuates, never boosts) and no sign is changed. Unit ratio is the identity everywhere. Refuses BadThreshold on a
/// threshold outside [1, sample_max], BadRatio on a ratio below unity or a zero denominator, and BadRange on a span outside the
/// samples — each before any write. Values only — never the length.
pub fn gate(
    clip: *timeline.Clip,
    start: u32,
    count: u32,
    threshold: i32,
    ratio_num: u32,
    ratio_den: u32,
) GateError!void {
    // invariant: the threshold is a legal magnitude — at least one sample unit and no greater than the i16 rail. Before any write.
    if (threshold < 1) return error.BadThreshold;
    if (threshold > @as(i32, timeline.sample_max)) return error.BadThreshold;
    // invariant: the ratio is at least one (num >= den) and its denominator is nonzero — a ratio below one would boost the quiet, a
    // zero denominator would divide by zero. A downward gate only ever reduces a below-threshold magnitude.
    if (ratio_den == 0) return error.BadRatio;
    if (ratio_num < ratio_den) return error.BadRatio;
    // invariant: the span lies wholly within the current samples — checked without underflow (count vs the remainder).
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;

    const thr: i64 = @as(i64, threshold);
    const num: i64 = @as(i64, ratio_num);
    const den: i64 = @as(i64, ratio_den);
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const x: i16 = clip.buf[start + i];
        const m: i64 = if (x < 0) -@as(i64, x) else @as(i64, x); // |x| — safe in i64 (|sample_min| = 32768 fits)
        if (m < thr) {
            // Divide the whole below-threshold magnitude by the ratio (num/den): the quiet is pushed toward zero. divTrunc of
            // positives is floor; the ratio being >= 1 makes the quotient <= m, and a large enough ratio drives it to 0 (silence).
            const new_m: i64 = @divTrunc(m * den, num);
            // invariant: gating reduces, never boosts, and never falls below zero.
            assert(new_m <= m and new_m >= 0);
            const y: i16 = @intCast(if (x < 0) -new_m else new_m); // safe: 0 <= new_m <= m <= sample_max
            clip.buf[start + i] = y;
            // invariant: the written sample holds the input's sign (magnitude only shrank), zero being sign-neutral.
            assert((x >= 0 and y >= 0) or (x <= 0 and y <= 0));
        }
        // a sample at or above the threshold is left exactly as it was — the gate touches only what falls below.
    }
    // invariant: a gate changes sample values only, never the clip's length or bound.
    assert(start + count <= clip.len);
    assert(clip.len <= clip.buf.len);
}

// --- selftest: silence stays silence; a signal at or above the threshold passes byte-for-byte (above the threshold is the
//     identity); UNIT RATIO is the identity everywhere (even below threshold); a quiet signal has its floor pushed down with the
//     sign held and the magnitude never expanding; a HIGHER RATIO gates at least as hard (monotone), an infinite-enough ratio
//     drives the quiet to silence (the hard gate); and a bad threshold, a sub-unity ratio, a zero ratio denominator, and an
//     out-of-range span each refuse by name ------------------------------------------------------------------------------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn load_clip(clip: *timeline.Clip, src: []const i16) !void {
    try timeline.splice(clip, 0, src);
}

fn abs16(v: i16) i32 {
    return if (v < 0) -@as(i32, v) else @as(i32, v);
}

fn run_selftest() !u8 {
    // 1. silence stays silence — an all-zero clip gates to all zeros at any legal threshold and ratio.
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &[_]i16{ 0, 0, 0, 0, 0, 0 });
        try gate(&clip, 0, clip.len, 1000, 4, 1);
        const zeros = [_]i16{ 0, 0, 0, 0, 0, 0 };
        if (!eq(clip.samples(), &zeros)) return error.SilenceWrong;
    }

    // 2. ABOVE THE THRESHOLD IS THE IDENTITY — a signal whose every peak reaches the threshold passes byte-for-byte.
    {
        const loud = [_]i16{ 5000, -9000, 1000, -1000, 32000, -3000 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &loud);
        try gate(&clip, 0, clip.len, 1000, 8, 1); // threshold equals the quietest peak — inclusive, so it still passes
        if (!eq(clip.samples(), &loud)) return error.LoudNotIdentity;
    }

    // 3. UNIT RATIO IS THE IDENTITY EVERYWHERE — ratio_num == ratio_den writes m·1 = |x| byte-for-byte even for samples below the
    //    threshold. A 1:1 gate passes the whole signal through, guaranteed by construction.
    {
        const quiet = [_]i16{ 300, -300, 5000, -20, 20, -400 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &quiet);
        try gate(&clip, 0, clip.len, 1000, 3, 3); // unit ratio 3:3
        if (!eq(clip.samples(), &quiet)) return error.UnitRatioNotIdentity;
    }

    // 4. THE SIGN IS HELD AND THE MAGNITUDE NEVER EXPANDS — a signal below the threshold gates so every output magnitude is at most
    //    the input's, every sign matches, and each below-threshold sample lands exactly at m·ratio_den/ratio_num.
    {
        const mixed = [_]i16{ 800, -800, 5000, -600, 200, -9000 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &mixed);
        const thr: i32 = 1000;
        try gate(&clip, 0, clip.len, thr, 4, 1); // 4:1
        const out = clip.samples();
        var i: u32 = 0;
        while (i < out.len) : (i += 1) {
            const src = mixed[i];
            if (abs16(out[i]) > abs16(src)) return error.MagnitudeExpanded; // gating only reduces
            if ((src > 0 and out[i] < 0) or (src < 0 and out[i] > 0)) return error.SignFlipped;
            const m = abs16(src);
            const want_mag: i32 = if (m < thr) @divTrunc(m, 4) else m;
            const want: i16 = @intCast(if (src < 0) -want_mag else want_mag);
            if (out[i] != want) return error.WrongGating;
        }
    }

    // 5. A HIGHER RATIO GATES AT LEAST AS HARD — for the same below-threshold sample, 8:1 yields a magnitude no greater than 2:1
    //    (the ratio knob is monotone), and a ratio high enough drives the quiet exactly to silence — the hard gate.
    {
        const one = [_]i16{600};
        const thr: i32 = 1000;
        var soft = timeline.Clip{};
        try load_clip(&soft, &one);
        try gate(&soft, 0, soft.len, thr, 2, 1); // 2:1
        var hard = timeline.Clip{};
        try load_clip(&hard, &one);
        try gate(&hard, 0, hard.len, thr, 8, 1); // 8:1
        if (abs16(hard.samples()[0]) > abs16(soft.samples()[0])) return error.RatioNotMonotone;
        // a ratio far larger than the magnitude drives the quiet to zero: the sample falls to silence (the hard gate).
        var shut = timeline.Clip{};
        try load_clip(&shut, &one);
        try gate(&shut, 0, shut.len, thr, 100000, 1); // ratio >> magnitude (600) — m/ratio truncates to 0
        if (shut.samples()[0] != 0) return error.HighRatioNotSilent;
    }

    // 6a. a zero threshold refuses BadThreshold before any write, the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (gate(&clip, 0, clip.len, 0, 4, 1)) |_| return error.ZeroThresholdSlipped else |e| if (e != error.BadThreshold) return error.WrongZeroThreshold;
        if (!eq(clip.samples(), &three)) return error.RefusedThresholdMutated;
    }

    // 6b. a sub-unity ratio (would boost the quiet) refuses BadRatio before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (gate(&clip, 0, clip.len, 1000, 1, 2)) |_| return error.SubUnitySlipped else |e| if (e != error.BadRatio) return error.WrongSubUnity;
        if (!eq(clip.samples(), &three)) return error.RefusedRatioMutated;
    }

    // 6c. a zero ratio denominator refuses BadRatio before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (gate(&clip, 0, clip.len, 1000, 4, 0)) |_| return error.ZeroDenSlipped else |e| if (e != error.BadRatio) return error.WrongZeroDen;
        if (!eq(clip.samples(), &three)) return error.RefusedDenMutated;
    }

    // 6d. an out-of-range span refuses BadRange before any write, leaving the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (gate(&clip, 2, 5, 1000, 4, 1)) |_| return error.BadRangeSlipped else |e| if (e != error.BadRange) return error.WrongBadRange;
        if (!eq(clip.samples(), &three)) return error.RefusedRangeMutated;
    }

    print("GREEN ales-gate: a noise gate inverts the compressor's threshold — a sample at or above the threshold passes " ++
        "byte-for-byte, a sample below it has its magnitude divided by the ratio and is rewritten sign(x)·(m·ratio_den/ratio_num). " ++
        "Silence stays silence; above the threshold is the IDENTITY; UNIT RATIO is the identity everywhere (even below threshold — " ++
        "a 1:1 gate passes the whole signal by construction); a quiet signal has its floor pushed down with the sign held and the " ++
        "magnitude never expanding; a HIGHER RATIO gates at least as hard (the ratio knob is monotone) and a ratio far past the " ++
        "magnitude drives the quiet exactly to silence — the hard gate reached from within the downward expander; and a zero " ++
        "threshold refuses BadThreshold, a sub-unity or zero-denominator ratio BadRatio, an out-of-range span BadRange, each " ++
        "leaving the clip untouched; no socket, no network, no keys, no funds, no real device, no real sample rate\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
