//! lotus/library_find.rye -- ALES228: resolve an album by name in a catalog. ALES226 sealed a keeper's whole catalog by content
//! address; ALES227 drew it as a readable page. Both walk the catalog in order -- a keeper reads it top to bottom. Yet a working
//! creator does not scroll a discography to cite one record; they name it. Every later Lotus workflow -- open THIS album, compare
//! THIS album's digest, publish THIS one -- begins by resolving a name to the record it points at. This rung seats that resolve, so a
//! large catalog is an index a keeper reaches into, not only a scroll they read down.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES228.
//! Design read: active-designing/date/20260815/20260815-142750_fill-ales228-lotus-library-find.md
//! Stands on: lotus/library_manifest.rye (ALES226) -- the opened LibraryManifest (its ordered (name, digest) entries) this reads. The
//! find / name_of lookup idiom is already proven one level down in lotus/rack.rye (ALES30); this lifts it from a rack of clips to a
//! catalog of records, unchanged in shape. No new frame, no new hash -- a read over fields the seal already proved whole.
//!
//! THE CRUX -- a resolve turns a listing into an index. The manifest and the sheet walk the catalog in order; find reaches straight to
//! the record a keeper names, and digest_of hands back the citable content address that record points at. A miss is an ANSWER, not a
//! fault: a catalog that does not hold a name returns null (the honest optional rack.find returns), so a caller tells ABSENT from
//! MALFORMED without an error path.
//!
//! HONEST SCOPE -- software only, purely LOCAL. A bounded lookup over in-process fields already proven whole by open_library_manifest,
//! siloed to lotus/. Content-addressing on the handle it returns, never a signature: it points to a record, it does not prove who
//! made one -- the signed carry remains a later crypto seam on Keaton's word. No real file, no DAC, no acoustic or electrical fact, no
//! network, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/library_find.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const library_manifest = @import("library_manifest.rye");

pub const library_find_version = "20260815.142750";

/// The album name at index `i` -- a slice into the opened manifest body. Mirrors rack.name_of one level up: an album is a record, a
/// slot is a clip, the accessor is the same.
pub fn name_of(lm: *const library_manifest.LibraryManifest, i: u32) []const u8 {
    // invariant: the index names a live album whose name fits the manifest's own bound.
    assert(i < lm.count and lm.entries[i].name.len <= library_manifest.max_album_name);
    return lm.entries[i].name;
}

/// The 64-hex content-address digest of the album at index `i` -- the citable handle a resolve exists to hand back. A slice into the
/// opened manifest body.
pub fn digest_of(lm: *const library_manifest.LibraryManifest, i: u32) []const u8 {
    // invariant: the index names a live album whose digest is exactly the full hex width -- open_library_manifest already proved it.
    assert(i < lm.count and lm.entries[i].digest.len == library_manifest.digest_hex_len);
    return lm.entries[i].digest;
}

/// The index of the album named `name`, or null when the catalog holds no such name. One ordered pass; an album name is unique within
/// a manifest, so the first match is the only match. A miss is a clean null, never a fault -- absence and malformation are different
/// answers, and the manifest was already proven whole.
pub fn find(lm: *const library_manifest.LibraryManifest, name: []const u8) ?u32 {
    // invariant: the search never reads past the live albums -- the manifest's own bound holds.
    assert(lm.count <= library_manifest.max_albums);
    var i: u32 = 0;
    while (i < lm.count) : (i += 1) {
        if (std.mem.eql(u8, name_of(lm, i), name)) return i;
    }
    // invariant: a null answer means every live album was compared -- an ordered, total pass, not an early stop.
    assert(i == lm.count);
    return null;
}

// --- selftest: THE RESOLVE LAW -- a present name resolves to its index in order, and digest_of returns the exact digest the manifest
//     holds; THE ABSENCE LAW -- a name the catalog lacks returns null, never a wrong index; THE FIRST-MATCH LAW -- the null answer means
//     every album was compared; THE EMPTY LAW -- a search over a zero-album catalog returns null for any name ----------------------

fn run_selftest() !u8 {
    // Three stand-in album manifests -- any bytes serve; the library addresses their OUTPUT bytes, and find reads the opened catalog.
    // Small hand-built manifests keep the witness self-contained.
    const m0 = "first album manifest bytes.....\x01\x02\x03";
    const m1 = "second album manifest bytes....\x04\x05\x06";
    const m2 = "third album manifest bytes.....\x07\x08\x09";
    const albums = [_]library_manifest.AlbumIn{
        .{ .name = "debut", .album_manifest = m0 },
        .{ .name = "sequel", .album_manifest = m1 },
        .{ .name = "finale", .album_manifest = m2 },
    };

    var rec: [library_manifest.max_library_manifest_bytes]u8 = undefined;
    const rn = try library_manifest.seal_library_manifest(rec[0..], albums[0..]);
    const lm = try library_manifest.open_library_manifest(rec[0..rn]);

    // 1. THE RESOLVE LAW -- each present name resolves to its own index in order, and digest_of at that index returns the exact digest
    //    the manifest holds for it (the citable handle the resolve exists to hand back).
    {
        const idx0 = find(&lm, "debut") orelse return error.DebutMissing;
        const idx1 = find(&lm, "sequel") orelse return error.SequelMissing;
        const idx2 = find(&lm, "finale") orelse return error.FinaleMissing;
        if (!(idx0 == 0 and idx1 == 1 and idx2 == 2)) return error.IndexWrong;
        if (!std.mem.eql(u8, name_of(&lm, idx1), "sequel")) return error.NameWrong;
        if (!std.mem.eql(u8, digest_of(&lm, idx1), lm.entries[1].digest)) return error.DigestWrong;
        // the handle a keeper would cite is exactly the full hex width the manifest carries.
        if (digest_of(&lm, idx2).len != library_manifest.digest_hex_len) return error.DigestWidthWrong;
    }

    // 2. THE ABSENCE LAW -- a name the catalog does not hold returns null, never a wrong index and never a fault.
    {
        if (find(&lm, "encore") != null) return error.AbsentSlipped;
        if (find(&lm, "") != null) return error.EmptyNameSlipped;
        // a name that is a prefix of a present one still misses -- the match is whole, not partial.
        if (find(&lm, "deb") != null) return error.PrefixSlipped;
    }

    // 3. THE EMPTY LAW -- a search over a zero-album catalog returns null for any name.
    {
        var erec: [library_manifest.max_library_manifest_bytes]u8 = undefined;
        const empty = [_]library_manifest.AlbumIn{};
        const ern = try library_manifest.seal_library_manifest(erec[0..], empty[0..]);
        const elm = try library_manifest.open_library_manifest(erec[0..ern]);
        if (find(&elm, "debut") != null) return error.EmptyFound;
    }

    print("GREEN ales-library-find: resolve an album by name in a catalog — find(lm, name) returns the album's index or null, " ++
        "name_of / digest_of read its name and its 64-hex content-address handle by index. THE CRUX: a resolve turns a listing " ++
        "into an index — every later workflow (open · compare · publish THIS album) begins by naming it. THE RESOLVE LAW: a present " ++
        "name resolves to its index in order, and digest_of hands back the exact digest the manifest holds. THE ABSENCE LAW: a name " ++
        "the catalog lacks returns null — absence is an answer, not a fault, and a prefix of a name still misses. THE FIRST-MATCH " ++
        "LAW: a null answer means every album was compared, an ordered total pass. THE EMPTY LAW: a search over a zero-album " ++
        "catalog returns null. The find / name_of idiom lifted whole from rack.rye (ALES30); content-addressing on the handle, not " ++
        "a signature — no real file, no DAC, no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
