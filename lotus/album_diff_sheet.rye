//! lotus/album_diff_sheet.rye — ALES233: what changed in a record, as a readable page. ALES232 classified two record versions into
//! added, removed, and changed — the honest answer to what changed in this record since the last master — yet that answer lives in a
//! Diff struct a program reads, not a page a keeper reads. A keeper wants to SEE the change at a glance: which tracks arrived, which
//! were cut, which were remastered, and how many stood still. This rung draws that page.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES233.
//! Design read: active-designing/date/20260815/20260815-144829_fill-ales233-lotus-album-diff-sheet.md
//! Stands on: lotus/album_diff.rye (ALES232) — the classified Diff this reads. The readable-projection idiom is the same one
//! library_diff_sheet (ALES230) took over a catalog diff one level up: no new frame, no new hash — a projection, not a round-trip.
//!
//! A PROJECTION, NOT A ROUND-TRIP. The Diff is the computed verdict; this sheet is the eye's version of it. It parses back to nothing
//! — it completes the diff's usefulness the way library_diff_sheet completed the catalog diff: every catalog primitive earns its
//! readable page, and with this rung the album and library levels stand at full parity.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded text render over in-process fields already proven whole by classify, siloed
//! to lotus/. Content-addressing on the page, never a signature. No real file, no DAC, no acoustic or electrical fact, no network, no
//! keys, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/album_diff_sheet.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const album_manifest = @import("album_manifest.rye");
const album_diff = @import("album_diff.rye");
const render_album = @import("render_album.rye");

pub const album_diff_sheet_version = "20260815.144829";

/// The page's first line, its own line — names the shape so a reader (or a grep) can tell it from an album sheet or a manifest.
pub const sheet_header = "format lotus-album-diff-sheet-v1";

/// The widest single moved-track line is a changed line: `changed ` (8), the name bound, a space, two 64-hex digests with a space
/// between, then a newline. A named ceiling so the whole page is proven to fit a fixed buffer.
pub const moved_line_max: u32 = 8 + album_manifest.max_track_name + 1 + album_manifest.digest_hex_len + 1 + album_manifest.digest_hex_len + 1;

/// The widest summary line: `summary ` (8) plus four u32 decimals (10 each) with single spaces, then a newline.
pub const summary_line_max: u32 = 8 + 4 * 10 + 3 + 1;

/// The most bytes a rendered diff sheet can need: the header line, the summary line, then one moved line for every track across all
/// three lists — each list bounded by the manifest's track ceiling, so at most three records' worth of lines.
pub const max_sheet_bytes: u32 =
    @intCast(sheet_header.len + 1 + summary_line_max + 3 * album_manifest.max_tracks * moved_line_max);

/// The sheet's only fault: a render whose text would exceed the caller's buffer, refused rather than truncated. A projection is
/// otherwise infallible — every field it reads was already proven by classify.
pub const SheetError = error{
    /// The rendered page would exceed the caller's buffer — refused, never truncated.
    Overflow,
};

/// Render a classified Diff as its readable change page into `out`, returning the length written. The header line, a
/// `summary <added> <removed> <changed> <same>` line, then one line per moved track in order: `added <name> <digest>`,
/// `removed <name> <digest>`, `changed <name> <old_digest> <new_digest>`. Refuses Overflow rather than writing past the buffer.
pub fn render_sheet(diff: *const album_diff.Diff, out: []u8) SheetError!u32 {
    // invariant: every list stays within the manifest's track ceiling — classify already proved it, re-asserted before a byte renders.
    assert(diff.added_count <= album_manifest.max_tracks and diff.removed_count <= album_manifest.max_tracks and diff.changed_count <= album_manifest.max_tracks);
    const head = std.fmt.bufPrint(out, "{s}\nsummary {d} {d} {d} {d}\n", .{ sheet_header, diff.added_count, diff.removed_count, diff.changed_count, diff.same_count }) catch return error.Overflow;
    var off: u32 = @intCast(head.len);

    var a: u32 = 0;
    while (a < diff.added_count) : (a += 1) {
        const e = diff.added[a];
        // invariant: the digest is exactly the full hex width — classify carried it straight from a proven manifest entry.
        assert(e.digest.len == album_manifest.digest_hex_len);
        const line = std.fmt.bufPrint(out[off..], "added {s} {s}\n", .{ e.name, e.digest }) catch return error.Overflow;
        off += @intCast(line.len);
    }

    var r: u32 = 0;
    while (r < diff.removed_count) : (r += 1) {
        const e = diff.removed[r];
        // invariant: a digest is the hex of a fixed-width hash, so any other length names an
        // entry the manifest never wrote
        assert(e.digest.len == album_manifest.digest_hex_len);
        const line = std.fmt.bufPrint(out[off..], "removed {s} {s}\n", .{ e.name, e.digest }) catch return error.Overflow;
        off += @intCast(line.len);
    }

    var c: u32 = 0;
    while (c < diff.changed_count) : (c += 1) {
        const ch = diff.changed[c];
        // invariant: both digests are the full hex width — a changed line carries the track's before and after handles.
        assert(ch.old_digest.len == album_manifest.digest_hex_len and ch.new_digest.len == album_manifest.digest_hex_len);
        const line = std.fmt.bufPrint(out[off..], "changed {s} {s} {s}\n", .{ ch.name, ch.old_digest, ch.new_digest }) catch return error.Overflow;
        off += @intCast(line.len);
    }

    // invariant: the rendered page stays within the buffer.
    assert(off <= out.len);
    return off;
}

// --- selftest: THE SUMMARY LAW — the page opens with the format line and a summary line carrying the four tallies; THE MOVED LAW —
//     every added / removed / changed track appears in order with its name and full digest(s), a changed line carrying both; THE QUIET
//     LAW — an unchanged track appears in no track line; THE ATOMIC LAW — a too-small buffer refuses Overflow -----------------------

fn make_album(out: []u8, names: []const []const u8, bundles: []const []const u8) !u32 {
    // invariant: a witness helper builds a small, well-formed record — the two arrays run in lockstep.
    assert(names.len == bundles.len);
    var tracks: [8]render_album.TrackIn = undefined;
    var i: u32 = 0;
    while (i < names.len) : (i += 1) tracks[i] = .{ .name = names[i], .bundle = bundles[i] };
    return album_manifest.seal_album_manifest(out, tracks[0..names.len]);
}

fn run_selftest() !u8 {
    const b0 = "LOTUSBND....first bundle bytes....\x01\x02\x03";
    const b1 = "LOTUSBND....second bundle bytes...\x04\x05\x06";
    const b1b = "LOTUSBND....second bundle REMASTER\x04\x05\x07";
    const b2 = "LOTUSBND....third bundle bytes....\x07\x08\x09";

    // before {intro, verse, outro}; after {intro same, verse remastered → changed, coda new → added}; outro dropped → removed.
    var before_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    var after_rec: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    const bn = try make_album(before_rec[0..], &.{ "intro", "verse", "outro" }, &.{ b0, b1, b2 });
    const an = try make_album(after_rec[0..], &.{ "intro", "verse", "coda" }, &.{ b0, b1b, b2 });
    const before = try album_manifest.open_album_manifest(before_rec[0..bn]);
    const after = try album_manifest.open_album_manifest(after_rec[0..an]);
    const diff = album_diff.classify(&before, &after);

    var sheet: [max_sheet_bytes]u8 = undefined;
    const sn = try render_sheet(&diff, sheet[0..]);
    const text = sheet[0..sn];

    // 1. THE SUMMARY LAW — the page opens with the format line and the four-tally summary (1 added · 1 removed · 1 changed · 1 same).
    if (std.mem.indexOf(u8, text, "format lotus-album-diff-sheet-v1\n") != 0) return error.HeaderWrong;
    if (std.mem.indexOf(u8, text, "summary 1 1 1 1\n") == null) return error.SummaryWrong;

    // 2. THE MOVED LAW — each moved track appears with its name; a changed line carries BOTH the old and the new digest.
    if (std.mem.indexOf(u8, text, "added coda ") == null) return error.AddedMissing;
    if (std.mem.indexOf(u8, text, "removed outro ") == null) return error.RemovedMissing;
    if (std.mem.indexOf(u8, text, "changed verse ") == null) return error.ChangedMissing;
    if (std.mem.indexOf(u8, text, diff.changed[0].old_digest) == null) return error.OldDigestMissing;
    if (std.mem.indexOf(u8, text, diff.changed[0].new_digest) == null) return error.NewDigestMissing;

    // 3. THE QUIET LAW — the unchanged track (intro) never appears in a track line; only the summary counts it.
    if (std.mem.indexOf(u8, text, "intro") != null) return error.QuietBroken;

    // 4. THE ATOMIC LAW — a buffer too small for the whole page refuses Overflow rather than truncating it.
    {
        var tiny: [40]u8 = undefined; // room for the header at most, not the summary and moved lines
        if (render_sheet(&diff, tiny[0..])) |_| return error.OverflowSlipped else |e| if (e != error.Overflow) return error.WrongOverflow;
    }

    print("GREEN ales-album-diff-sheet: what changed in a record, as a readable page — a `format lotus-album-diff-sheet-v1` page (a " ++
        "`summary <added> <removed> <changed> <same>` line then one `added` / `removed` / `changed` line per moved track) rendered " ++
        "from an ALES232 Diff. THE SUMMARY LAW: the page opens with the format and four-tally summary lines. THE MOVED LAW: every " ++
        "added, removed, and changed track appears in order with its name and full digest(s), a changed line carrying both old and " ++
        "new. THE QUIET LAW: an unchanged track appears in no track line, only the summary counts it. THE ATOMIC LAW: a small buffer " ++
        "refuses Overflow. A projection, not a round-trip — the eye's version of the diff, completing album parity so the album and " ++
        "library levels each carry content address · readable page · resolve · diff · diff page; no real file, no DAC, no network, " ++
        "no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
