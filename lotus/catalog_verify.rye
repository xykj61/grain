//! lotus/catalog_verify.rye — ALES238: a whole catalog proven whole, end to end. The catalog family now stands whole (manifest ·
//! sheet · find · diff · diff_sheet · merge · merge_sheet at both levels), yet each verify to date proved ONE level: verify_library
//! (ALES226) confirms each album's manifest digest matches the catalog, verify_album (ALES224) confirms each track's bundle digest
//! matches a record. A keeper who holds a whole body of work — the library manifest, every album manifest, every bundle — wants ONE
//! answer: is all of it whole, top to bottom? This rung composes the two levels into that one deep check.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES238.
//! Design read: active-designing/date/20260815/20260815-151716_fill-ales238-lotus-catalog-verify.md
//! Stands on: lotus/library_manifest.rye (ALES226) — verify_library, the catalog level; lotus/album_manifest.rye (ALES224) —
//! open_album_manifest + verify_album, the record level. Pure composition over their public APIs — no new hash, no new frame.
//!
//! THE CRUX — content-addressing composes into a proof of the WHOLE TREE. The library digest binds each album manifest, each album
//! manifest binds each bundle, so verifying a catalog end to end is walking two levels of digests, never re-hashing a mountain of
//! audio into one number. A flipped byte anywhere — a swapped album manifest, a single edited bundle two levels down — surfaces by
//! name at the level it broke. A Merkle check the shape of the catalog itself.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded walk over in-process bytes, siloed to lotus/. Content-addressing, never a
//! signature: it proves a catalog arrived whole, NOT who made it — the signed carry remains a later crypto seam on Keaton's word. No
//! real file, no DAC, no acoustic or electrical fact, no network, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/catalog_verify.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const library_manifest = @import("library_manifest.rye");
const album_manifest = @import("album_manifest.rye");
const render_album = @import("render_album.rye");

pub const catalog_verify_version = "20260815.151716";

/// One album's whole tree in hand: its display name, the sealed ALES224 `album_manifest` bytes the catalog names, and the tracks
/// (bundles) that album manifest in turn names. verify_deep proves all three levels agree.
pub const AlbumTree = struct {
    name: []const u8,
    album_manifest: []const u8,
    tracks: []const render_album.TrackIn,
};

/// The deep verify's faults — the honest union of both levels it walks, so a break surfaces by the same name the single-level verify
/// already uses (AlbumDigestMismatch / AlbumNameMismatch / CountMismatch from the catalog level, TrackDigestMismatch /
/// TrackNameMismatch / CountMismatch from the record level, plus the seal and grammar faults of either).
pub const DeepError = library_manifest.LibraryManifestError || album_manifest.AlbumManifestError;

/// Confirm a whole catalog in hand IS the body of work its library manifest names, top to bottom. First the catalog level:
/// verify_library checks the count, each album name, and each album manifest's recomputed Sha256 against `lm`. Then the record level:
/// each album manifest is opened (verify-before-trust) and verify_album checks its count, each track name, and each bundle's
/// recomputed Sha256. A match returns cleanly; any break refuses by name at the level it broke.
pub fn verify_deep(lm: *const library_manifest.LibraryManifest, tree: []const AlbumTree) DeepError!void {
    // invariant: the catalog stays within its bound, so the fixed AlbumIn array cannot overflow and the walk terminates.
    if (tree.len > library_manifest.max_albums) return error.TooManyAlbums;
    // invariant: the manifest names no more than its bound — open_library_manifest already proved it, re-asserted here.
    assert(lm.count <= library_manifest.max_albums);

    // Catalog level: prove each album manifest is the one the library names, in order.
    var albums: [library_manifest.max_albums]library_manifest.AlbumIn = undefined;
    var i: u32 = 0;
    while (i < tree.len) : (i += 1) albums[i] = .{ .name = tree[i].name, .album_manifest = tree[i].album_manifest };
    try library_manifest.verify_library(lm, albums[0..tree.len]);

    // Record level: open each proven album manifest and prove its bundles, two levels down.
    var j: u32 = 0;
    while (j < tree.len) : (j += 1) {
        const am = try album_manifest.open_album_manifest(tree[j].album_manifest);
        try album_manifest.verify_album(&am, tree[j].tracks);
    }

    // invariant: reaching here means both levels agreed for every album — the whole tree is whole.
}

// --- selftest: THE WHOLE-TREE LAW — a catalog whose library manifest, album manifests, and bundles all match verifies cleanly; THE
//     CATALOG-TAMPER LAW — an edited album manifest refuses AlbumDigestMismatch at the catalog level; THE RECORD-TAMPER LAW — a
//     single flipped bundle byte two levels down refuses TrackDigestMismatch; THE NAME LAW — a renamed track refuses
//     TrackNameMismatch; THE COUNT LAW — a dropped album refuses CountMismatch --------------------------------------------------

fn make_album_manifest(out: []u8, names: []const []const u8, bundles: []const []const u8) !u32 {
    // invariant: a witness helper builds a small, well-formed record — the two arrays run in lockstep.
    assert(names.len == bundles.len);
    var tracks: [8]render_album.TrackIn = undefined;
    var i: u32 = 0;
    while (i < names.len) : (i += 1) tracks[i] = .{ .name = names[i], .bundle = bundles[i] };
    return album_manifest.seal_album_manifest(out, tracks[0..names.len]);
}

fn run_selftest() !u8 {
    // Two records, each a real ALES224 album manifest over stand-in bundles, gathered into one catalog.
    const b0 = "LOTUSBND....opener bundle bytes...\x01\x02\x03";
    const b1 = "LOTUSBND....closer bundle bytes...\x04\x05\x06";
    const b2 = "LOTUSBND....single bundle bytes...\x07\x08\x09";

    var m_first: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    var m_second: [album_manifest.max_album_manifest_bytes]u8 = undefined;
    const nf = try make_album_manifest(m_first[0..], &.{ "opener", "closer" }, &.{ b0, b1 });
    const ns = try make_album_manifest(m_second[0..], &.{"single"}, &.{b2});

    // The catalog names both records by their album-manifest digests.
    const albums = [_]library_manifest.AlbumIn{
        .{ .name = "debut", .album_manifest = m_first[0..nf] },
        .{ .name = "sequel", .album_manifest = m_second[0..ns] },
    };
    var lib: [library_manifest.max_library_manifest_bytes]u8 = undefined;
    const ln = try library_manifest.seal_library_manifest(lib[0..], albums[0..]);
    const lm = try library_manifest.open_library_manifest(lib[0..ln]);

    // The whole tree in hand — each album manifest paired with the bundles it names.
    const first_tracks = [_]render_album.TrackIn{ .{ .name = "opener", .bundle = b0 }, .{ .name = "closer", .bundle = b1 } };
    const second_tracks = [_]render_album.TrackIn{.{ .name = "single", .bundle = b2 }};

    // 1. THE WHOLE-TREE LAW — every level agrees, so the deep verify returns cleanly.
    {
        const tree = [_]AlbumTree{
            .{ .name = "debut", .album_manifest = m_first[0..nf], .tracks = first_tracks[0..] },
            .{ .name = "sequel", .album_manifest = m_second[0..ns], .tracks = second_tracks[0..] },
        };
        try verify_deep(&lm, tree[0..]);
    }

    // 2. THE CATALOG-TAMPER LAW — a whole album manifest swapped for a different (well-formed) one refuses AlbumDigestMismatch: the
    //    library digest no longer names it, caught at the catalog level before the record level is even walked.
    {
        var m_other: [album_manifest.max_album_manifest_bytes]u8 = undefined;
        const no = try make_album_manifest(m_other[0..], &.{"single"}, &.{"LOTUSBND....a DIFFERENT single...\x0a\x0b\x0c"});
        const other_tracks = [_]render_album.TrackIn{.{ .name = "single", .bundle = "LOTUSBND....a DIFFERENT single...\x0a\x0b\x0c" }};
        const tree = [_]AlbumTree{
            .{ .name = "debut", .album_manifest = m_first[0..nf], .tracks = first_tracks[0..] },
            .{ .name = "sequel", .album_manifest = m_other[0..no], .tracks = other_tracks[0..] }, // internally consistent, wrong for the catalog
        };
        if (verify_deep(&lm, tree[0..])) |_| return error.CatalogTamperSlipped else |e| if (e != error.AlbumDigestMismatch) return error.WrongCatalogTamper;
    }

    // 3. THE RECORD-TAMPER LAW — a single flipped byte in one bundle, two levels down, refuses TrackDigestMismatch. The album
    //    manifest still matches the catalog (its bytes are untouched), so the fault can only surface at the record level.
    {
        var b1_flipped: [b1.len]u8 = undefined;
        var k: u32 = 0;
        while (k < b1.len) : (k += 1) b1_flipped[k] = b1[k];
        b1_flipped[0] ^= 0x01;
        const flipped_tracks = [_]render_album.TrackIn{ .{ .name = "opener", .bundle = b0 }, .{ .name = "closer", .bundle = b1_flipped[0..] } };
        const tree = [_]AlbumTree{
            .{ .name = "debut", .album_manifest = m_first[0..nf], .tracks = flipped_tracks[0..] },
            .{ .name = "sequel", .album_manifest = m_second[0..ns], .tracks = second_tracks[0..] },
        };
        if (verify_deep(&lm, tree[0..])) |_| return error.RecordTamperSlipped else |e| if (e != error.TrackDigestMismatch) return error.WrongRecordTamper;
    }

    // 4. THE NAME LAW — a track renamed in hand (its bytes and thus digest unchanged) refuses TrackNameMismatch at the record level.
    {
        const renamed_tracks = [_]render_album.TrackIn{ .{ .name = "opener", .bundle = b0 }, .{ .name = "outro", .bundle = b1 } };
        const tree = [_]AlbumTree{
            .{ .name = "debut", .album_manifest = m_first[0..nf], .tracks = renamed_tracks[0..] },
            .{ .name = "sequel", .album_manifest = m_second[0..ns], .tracks = second_tracks[0..] },
        };
        if (verify_deep(&lm, tree[0..])) |_| return error.NameSlipped else |e| if (e != error.TrackNameMismatch) return error.WrongName;
    }

    // 5. THE COUNT LAW — a catalog missing an album (the tree names fewer than the library) refuses CountMismatch at the catalog level.
    {
        const tree = [_]AlbumTree{
            .{ .name = "debut", .album_manifest = m_first[0..nf], .tracks = first_tracks[0..] },
        };
        if (verify_deep(&lm, tree[0..])) |_| return error.CountSlipped else |e| if (e != error.CountMismatch) return error.WrongCount;
    }

    print("GREEN ales-catalog-verify: a whole catalog proven whole, end to end — verify_deep(lm, tree) walks two levels of content " ++
        "addresses (verify_library at the catalog level, then open_album_manifest + verify_album at the record level) so a keeper " ++
        "gets ONE answer for a whole body of work. THE CRUX: content-addressing composes into a proof of the whole tree — the " ++
        "library digest binds each album manifest, each album manifest binds each bundle, a Merkle check the shape of the catalog, " ++
        "never re-hashing a mountain of audio into one number. THE WHOLE-TREE LAW: every level agreeing returns cleanly. THE " ++
        "CATALOG-TAMPER LAW: a swapped album manifest refuses AlbumDigestMismatch at the catalog level. THE RECORD-TAMPER LAW: a " ++
        "single flipped bundle byte two levels down refuses TrackDigestMismatch. THE NAME LAW: a renamed track refuses " ++
        "TrackNameMismatch. THE COUNT LAW: a dropped album refuses CountMismatch. Pure composition over both levels' public verify " ++
        "APIs; content-addressing, not a signature — no real file, no DAC, no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
