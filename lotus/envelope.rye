//! lotus/envelope.rye — ALES52: an envelope follower — the time base the whole dynamics family waits for. The limiter (ALES49),
//! compressor (ALES50), and gate (ALES51) each act on a sample the instant they see it, with no memory of the sound a moment ago.
//! A real dynamics processor hears a peak ARRIVE and leans in over a few samples (the attack), then eases off as the sound falls
//! away (the release). That shape is exactly one thing — a running estimate of how loud the signal is right now, rising quickly
//! toward a new peak and falling slowly after it. Build it once, prove it, and the attack/release versions of the limiter,
//! compressor, and gate all read the same proven time base. It is the crux that opens the rest of dynamics.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES52.
//! Design read: active-designing/20260814-172539_fill-ales52-lotus-envelope-follower.md
//! Stands on: lotus/timeline.rye (ALES2) — the Clip, sample_min/sample_max, the range law shape; lotus/tone.rye (ALES40/43) — the
//! forced-unit-step exact-reach guarantee and the carried-state lesson, re-used here for the envelope; lotus/gate.rye (ALES51) —
//! the dynamics rung this time base will later drive, re-proven beside it.
//!
//! HONEST SCOPE — software only, purely LOCAL. Bounded in-process i16 PCM buffers on one bench, siloed to lotus/. No socket,
//! no network, no keys, no funds, no real device, no real sample rate — the attack and release are fractions per sample index,
//! not milliseconds against a clock, and the follower renders a magnitude curve rather than routing it into a gain yet (wiring the
//! envelope into the limiter, compressor, and gate is the next rung). One comparison and at most one multiply-divide per sample;
//! nothing on the path can overflow, since the envelope is bounded in [0, sample_max], which fits i16.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/envelope.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");

pub const envelope_version = "20260814.172539";

/// The follower's faults: a coefficient outside (0, 1] on either the attack or the release, and a span outside the samples.
/// BadRange coincides by name with timeline's, the EQ family's, and the whole dynamics family's, so a composer sees one
/// consistent fault.
pub const EnvelopeError = error{
    /// An attack or release coefficient outside (0, 1] — a zero numerator (the envelope would freeze), a numerator past the
    /// denominator (a step overshooting the gap), or a zero denominator (a divide by zero). Refused, no write.
    BadCoeff,
    /// A span outside the current samples — refused, no write.
    BadRange,
};

/// A legal envelope coefficient is a fraction in (0, 1]: a nonzero numerator no greater than a nonzero denominator. A zero
/// numerator freezes the envelope; a numerator past the denominator would overshoot; a zero denominator would divide by zero.
fn coeff_ok(num: u32, den: u32) bool {
    // invariant: legality is exactly 1 <= num <= den — the fraction lies in (0, 1].
    return den != 0 and num != 0 and num <= den;
}

/// Advance the envelope by one sample toward the magnitude of `x` and return the new envelope value. `env` holds the running
/// magnitude at full i64 precision in sample units. The target is min(|x|, sample_max) — a full-scale negative peak reads at the
/// positive rail. The envelope steps a fraction num/den of the way toward the target, choosing the attack fraction when rising and
/// the release fraction when falling; when that fractional step truncates to zero yet the gap remains, it advances by one, so a
/// held level is reached EXACTLY in finite steps (ALES40's guarantee). The step never overshoots, so convergence is monotone.
fn env_step(
    env: *i64,
    x: i16,
    attack_num: u32,
    attack_den: u32,
    release_num: u32,
    release_den: u32,
) i16 {
    // invariant: both coefficients reaching this step are already legal fractions in (0, 1] — coeff_ok ran at the edge.
    assert(coeff_ok(attack_num, attack_den) and coeff_ok(release_num, release_den));
    const mag: i64 = if (x < 0) -@as(i64, x) else @as(i64, x); // |x| — safe in i64 (|sample_min| = 32768 fits)
    const rail: i64 = @as(i64, timeline.sample_max);
    const target: i64 = if (mag > rail) rail else mag; // clamp the full-scale negative peak to the positive rail
    const gap: i64 = target - env.*;
    // Rising uses the attack fraction, falling (or level) the release fraction — the asymmetry that makes attack and release two
    // separate knobs. gap == 0 takes the release branch and steps nothing.
    const num: i64 = if (gap > 0) @as(i64, attack_num) else @as(i64, release_num);
    const den: i64 = if (gap > 0) @as(i64, attack_den) else @as(i64, release_den);
    var step: i64 = @divTrunc(gap * num, den);
    // The forced unit step fires only when the fractional step rounds to nothing yet the gap remains — so a held level is reached
    // exactly rather than left with a residual offset.
    if (step == 0 and gap != 0) step = if (gap > 0) 1 else -1;
    // invariant: the step only ever shrinks the gap — it never overshoots the target, so convergence is monotone.
    assert((step >= 0 and step <= gap) or (step <= 0 and step >= gap));
    env.* += step;
    // invariant: the envelope stays a legal i16 magnitude — never negative, never past the rail — so it fits i16 unsigned by sign.
    assert(env.* >= 0 and env.* <= rail);
    return @intCast(env.*);
}

/// Follow `count` samples starting at `start` in place, CONTINUING from the caller's `env` rather than from silence — the
/// carried-state form (ALES43's lesson). The caller owns the i64 envelope across calls, so following a span in two pieces (the
/// second carrying the first's ending envelope) equals following the whole span once: no fresh transient at the seam. A fresh
/// `env` of 0 follows from silence. Refuses BadCoeff on an illegal attack or release coefficient and BadRange on a span outside
/// the samples, before any write; on refusal `env` is left untouched. Values only — never the length.
pub fn follow_carry(
    clip: *timeline.Clip,
    start: u32,
    count: u32,
    env: *i64,
    attack_num: u32,
    attack_den: u32,
    release_num: u32,
    release_den: u32,
) EnvelopeError!void {
    // invariant: both coefficients are legal fractions in (0, 1] — checked before any write.
    if (!coeff_ok(attack_num, attack_den)) return error.BadCoeff;
    if (!coeff_ok(release_num, release_den)) return error.BadCoeff;
    // invariant: the span lies wholly within the current samples — checked without underflow (count vs the remainder).
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;

    var i: u32 = 0;
    while (i < count) : (i += 1) {
        clip.buf[start + i] = env_step(env, clip.buf[start + i], attack_num, attack_den, release_num, release_den);
    }
    // invariant: a follower changes sample values only, never the clip's length or bound.
    assert(start + count <= clip.len);
    assert(clip.len <= clip.buf.len);
}

/// Follow `count` samples starting at `start` in place, from a zero initial envelope (from silence), by the attack and release
/// coefficients. A fresh `env` of 0 is exactly this from-silence form — one implementation, so the two forms cannot drift.
/// Refuses BadCoeff on an illegal coefficient and BadRange on a span outside the samples, before any write.
pub fn follow(
    clip: *timeline.Clip,
    start: u32,
    count: u32,
    attack_num: u32,
    attack_den: u32,
    release_num: u32,
    release_den: u32,
) EnvelopeError!void {
    var env: i64 = 0;
    return follow_carry(clip, start, count, &env, attack_num, attack_den, release_num, release_den);
}

// --- selftest: silence stays silence; UNIT attack and release make the envelope the instantaneous magnitude (the peak follower);
//     a constant input is reached EXACTLY from below (attack) and from above (release), monotonically and without overshoot; the
//     envelope stays in [0, sample_max]; a faster attack rises at least as fast (monotone); the state CARRIES so a span followed
//     in two pieces equals the whole once; and an illegal coefficient and an out-of-range span each refuse by name -------------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn load_clip(clip: *timeline.Clip, src: []const i16) !void {
    try timeline.splice(clip, 0, src);
}

fn abs16(v: i16) i32 {
    return if (v < 0) -@as(i32, v) else @as(i32, v);
}

fn run_selftest() !u8 {
    // 1. silence stays silence — an all-zero clip follows to all zeros at any legal coefficients.
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &[_]i16{ 0, 0, 0, 0, 0, 0 });
        try follow(&clip, 0, clip.len, 1, 4, 1, 8);
        const zeros = [_]i16{ 0, 0, 0, 0, 0, 0 };
        if (!eq(clip.samples(), &zeros)) return error.SilenceWrong;
    }

    // 2. UNIT ATTACK AND RELEASE ARE THE INSTANTANEOUS MAGNITUDE — num == den on both makes step = gap, so the envelope becomes
    //    min(|x|, sample_max) every sample: a follower with no smoothing IS the rectified signal, byte-for-byte by construction.
    {
        const sig = [_]i16{ 5000, -9000, 0, -32768, 32767, -400 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &sig);
        try follow(&clip, 0, clip.len, 1, 1, 1, 1); // unit attack, unit release
        const want = [_]i16{ 5000, 9000, 0, 32767, 32767, 400 }; // |x| clamped to the rail (|-32768| -> 32767)
        if (!eq(clip.samples(), &want)) return error.UnitNotInstantaneous;
    }

    // 3. A CONSTANT INPUT IS REACHED EXACTLY, monotonically, from below via the attack — no drifting steady-state offset. The
    //    geometric step decays until the fractional step truncates to zero, then the forced unit step finishes it: exact in finite
    //    steps, given enough samples (a 1:4 attack over 64 samples converges well before the tail).
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &([_]i16{8000} ** 64));
        try follow(&clip, 0, clip.len, 1, 4, 1, 8); // slow-ish attack 1:4
        const out = clip.samples();
        var i: u32 = 1;
        while (i < out.len) : (i += 1) {
            if (out[i] < out[i - 1]) return error.AttackNotMonotone; // never falls while chasing a higher target
            if (out[i] > 8000) return error.AttackOvershot; // never overshoots
        }
        if (out[0] <= 0) return error.AttackDidNotRise; // it moved off silence on the first sample
        if (out[out.len - 1] != 8000) return error.AttackNotExact; // reached the held level exactly by the end
    }

    // 4. A CONSTANT-THEN-QUIETER INPUT falls to the new level EXACTLY via the release, monotonically, from above.
    {
        // rise to 10000 with an instantaneous attack, then hold 2000 — the release must ease DOWN to exactly 2000 in finite steps.
        var clip = timeline.Clip{};
        try load_clip(&clip, &([_]i16{10000} ++ ([_]i16{2000} ** 63)));
        try follow(&clip, 0, clip.len, 1, 1, 1, 3); // instant attack, slow release 1:3
        const out = clip.samples();
        if (out[0] != 10000) return error.ReleaseAttackWrong; // instant attack seats the peak at once
        var i: u32 = 2;
        while (i < out.len) : (i += 1) {
            if (out[i] > out[i - 1]) return error.ReleaseNotMonotone; // never rises while falling toward a lower target
            if (out[i] < 2000) return error.ReleaseUndershot; // never falls past the target
        }
        if (out[out.len - 1] != 2000) return error.ReleaseNotExact; // reached the lower level exactly
    }

    // 5. A FASTER ATTACK RISES AT LEAST AS FAST — for the same rising target, 1:2 reaches a magnitude no less than 1:8 at every
    //    sample (the attack knob is monotone).
    {
        const ramp = [_]i16{ 12000, 12000, 12000, 12000, 12000, 12000 };
        var slow = timeline.Clip{};
        try load_clip(&slow, &ramp);
        try follow(&slow, 0, slow.len, 1, 8, 1, 8); // slow attack 1:8
        var fast = timeline.Clip{};
        try load_clip(&fast, &ramp);
        try follow(&fast, 0, fast.len, 1, 2, 1, 8); // fast attack 1:2
        var i: u32 = 0;
        while (i < ramp.len) : (i += 1) {
            if (fast.samples()[i] < slow.samples()[i]) return error.AttackNotFaster;
        }
    }

    // 6. THE STATE CARRIES — following a span in two pieces (the second continuing the first's ending envelope) equals following
    //    the whole span once, byte-for-byte: the seam invisible, so the coming attack/release dynamics can span and automate.
    {
        const sig = [_]i16{ 3000, -14000, 14000, -2000, 9000, -9000, 500, -500 };
        var whole = timeline.Clip{};
        try load_clip(&whole, &sig);
        try follow(&whole, 0, whole.len, 1, 3, 1, 5);

        var split = timeline.Clip{};
        try load_clip(&split, &sig);
        var env: i64 = 0;
        try follow_carry(&split, 0, 3, &env, 1, 3, 1, 5); // first piece
        try follow_carry(&split, 3, split.len - 3, &env, 1, 3, 1, 5); // second continues the state
        if (!eq(split.samples(), whole.samples())) return error.CarryNotEqual;
    }

    // 7a. an illegal attack coefficient (numerator past the denominator) refuses BadCoeff before any write, the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (follow(&clip, 0, clip.len, 3, 2, 1, 4)) |_| return error.BadAttackSlipped else |e| if (e != error.BadCoeff) return error.WrongBadAttack;
        if (!eq(clip.samples(), &three)) return error.RefusedAttackMutated;
    }

    // 7b. a zero release numerator (the envelope would freeze) refuses BadCoeff before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (follow(&clip, 0, clip.len, 1, 4, 0, 4)) |_| return error.ZeroReleaseSlipped else |e| if (e != error.BadCoeff) return error.WrongZeroRelease;
        if (!eq(clip.samples(), &three)) return error.RefusedReleaseMutated;
    }

    // 7c. a zero denominator refuses BadCoeff before any write.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (follow(&clip, 0, clip.len, 1, 0, 1, 4)) |_| return error.ZeroDenSlipped else |e| if (e != error.BadCoeff) return error.WrongZeroDen;
        if (!eq(clip.samples(), &three)) return error.RefusedDenMutated;
    }

    // 7d. an out-of-range span refuses BadRange before any write, leaving the clip untouched.
    {
        var clip = timeline.Clip{};
        const three = [_]i16{ 1, 2, 3 };
        try load_clip(&clip, &three);
        if (follow(&clip, 2, 5, 1, 4, 1, 8)) |_| return error.BadRangeSlipped else |e| if (e != error.BadRange) return error.WrongBadRange;
        if (!eq(clip.samples(), &three)) return error.RefusedRangeMutated;
    }

    print("GREEN ales-envelope: an envelope follower renders a running magnitude estimate — the target min(|x|, sample_max), the " ++
        "envelope stepping a fraction of the way toward it, the attack fraction while rising and the release while falling, a " ++
        "forced unit step making a held level reachable EXACTLY. Silence stays silence; UNIT attack and release are the " ++
        "instantaneous magnitude (the peak follower, byte-for-byte by construction); a constant input is reached exactly from " ++
        "below (attack) and from above (release), monotonically and without overshoot; the envelope stays in [0, sample_max]; a " ++
        "faster attack rises at least as fast (the knob is monotone); the state CARRIES so a span followed in two pieces equals " ++
        "the whole once (the seam invisible); and an illegal attack or release coefficient refuses BadCoeff, an out-of-range span " ++
        "BadRange, each leaving the clip untouched; no socket, no network, no keys, no funds, no real device, no real sample " ++
        "rate\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
