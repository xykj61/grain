//! lotus/duplicate.rye — ALES112: duplicate — insert a second copy of the `count` samples starting at `start` immediately after the span, IN PLACE, so [start, start+count)
//! becomes [start, start+2*count) holding the span twice back to back and the clip GROWS by exactly count. This is the growth-twin of ALES111's crop: where crop KEEPS a span
//! and drops the rest (the clip SHRINKS to the selection), duplicate REPEATS one span in place (the clip grows by the span). Circle a bar, press Duplicate, and a second copy
//! lands immediately after the first — the doubled drum loop, the repeated chorus, the stutter edit. Naming it beside crop completes the shrink/grow pair on a selection: keep
//! only it, or repeat it.
//!
//! The rule, stated once: duplicate(clip, start, count) opens count silent seats at the span's end through ALES109's insert_silence (a bounded grow, refusing ClipFull past the
//! fixed buffer), then copies the original span forward into that gap — source [start, end) and destination [end, end+count) are adjacent and DISJOINT, so the forward copy is
//! exact with no temporary buffer. It refuses BadRange when the span falls outside the current samples before any write, reusing ALES2's EditError whole. No allocation, no
//! second buffer.
//!
//! The crux — four laws. THE DUPLICATE LAW: after duplicate(clip, start, count) the clip is original[0..end] ++ original[start..end] ++ original[end..len), end = start+count,
//! the span twice back to back and the length grown by count. THE INVERSE LAW: duplicate(start, count) then ALES2's cut(end, count) returns the original byte for byte — the
//! inserted copy removed exactly, duplicate the honest inverse of cut on the copied span. THE COPY / PEAK LAW: duplicate copies existing samples and invents none, so the peak
//! re-measured through ALES13 is unchanged (the loudest sample inside the span simply appears twice at the same magnitude, outside it untouched). THE DEGENERATE / REFUSAL LAW:
//! count = 0 the identity, a start past the samples or a count past the remainder BadRange, a duplicate past the fixed buffer ClipFull, each before any write.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES112.
//! Design read: active-designing/20260815-011901_fill-ales112-lotus-duplicate.md
//! Stands on: lotus/timeline.rye (ALES2) — the Clip, its buf/len/samples, the EditError reused whole, and the cut imported by the selftest to prove the inverse law;
//! lotus/insert_silence.rye (ALES109) — opens the count-sample gap at the span's end without a caller slice; lotus/meter.rye (ALES13) — the peak/RMS meter, used only by the
//! witness to prove that copying existing samples never moves the peak.
//!
//! HONEST SCOPE — software only, purely LOCAL. A bounded in-process buffer of i16 PCM on one bench, siloed to lotus/. It opens a gap through the proven insert_silence and fills
//! it with a copy of an existing span — it invents no sample, changes no value, and reads no byte past len. No real sample rate, no network, no keys, no funds, no real device,
//! no real speaker.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/duplicate.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const timeline = @import("timeline.rye");
const meter = @import("meter.rye");
const insert_silence = @import("insert_silence.rye");

pub const duplicate_version = "20260815.011901";

/// duplicate forwards ALES2's OWN faults reused by name — BadRange when the span falls outside the current samples, ClipFull when the grow would overrun the fixed buffer — and
/// invents none of its own; `start` and `count` are plain span bounds with no illegal value save the range the samples already name.
pub const DuplicateError = timeline.EditError;

/// Insert a second copy of the `count` samples starting at `start` immediately after the span, in place — the clip grows by exactly `count`, the span appearing twice back to
/// back. Refuses BadRange when the span falls outside the current samples and ClipFull when the grow would overrun the buffer, before any write. This is ALES111's crop read as
/// a growth rather than a reduction — the shrink/grow twin on a selection.
pub fn duplicate(clip: *timeline.Clip, start: u32, count: u32) DuplicateError!void {
    // invariant: the length never claims more samples than the buffer holds — every seat we read is inside the buffer.
    assert(clip.len <= clip.buf.len);

    // invariant: the span lies wholly within the current samples (checked without underflow — count against the remainder), refused by name before any write.
    if (start > clip.len) return error.BadRange;
    if (count > clip.len - start) return error.BadRange;

    const end: u32 = start + count;

    // Open `count` silent seats at the span's end through ALES109 — a bounded grow that refuses ClipFull past the fixed buffer before any write. The span [start, end) stays put
    // (it lies before the insertion point), the tail shifts right, and [end, end+count) becomes zero.
    try insert_silence.insert_silence(clip, end, count);

    // invariant: the clip grew by exactly the span, so the copy destination [end, end+count) is legal and disjoint from the source [start, end).
    assert(end + count <= clip.len);

    // Fill the opened gap with a forward copy of the original span — destination end + i is always ahead of source start + i, so no live sample is overwritten before it is read.
    var i: u32 = 0;
    while (i < count) : (i += 1) clip.buf[end + i] = clip.buf[start + i];

    // invariant: duplicate only grew the clip and copied existing samples — the length stays within its bound.
    assert(clip.len <= clip.buf.len);
}

// --- selftest: THE DUPLICATE LAW — the span appears twice back to back and the length grows by count; THE INVERSE LAW — duplicate then ALES2's cut(end, count) returns the
//     original byte for byte; THE COPY / PEAK LAW — duplicate copies existing samples, so the peak re-measured through ALES13 is unchanged; THE DEGENERATE / REFUSAL LAW —
//     count 0 the identity, a span past the samples BadRange, a grow past the buffer ClipFull ----------

fn eq(got: []const i16, want: []const i16) bool {
    if (got.len != want.len) return false;
    var i: u32 = 0;
    while (i < want.len) : (i += 1) if (got[i] != want[i]) return false;
    return true;
}

fn load_clip(clip: *timeline.Clip, src: []const i16) !void {
    try timeline.splice(clip, 0, src);
}

/// The clip's current peak magnitude, re-measured through ALES13 — the reader the peak law checks the result against.
fn clip_peak(clip: *const timeline.Clip) !u32 {
    const m = try meter.measure(clip);
    return meter.peak(&m);
}

fn run_selftest() !u8 {
    // 1. THE DUPLICATE LAW — the span appears twice back to back and the length grows by count. Proven at a mid span, the head, and the tail.
    {
        var mid = timeline.Clip{};
        try load_clip(&mid, &[_]i16{ 10, 20, 30, 40, 50 });
        try duplicate(&mid, 1, 2); // duplicate {20, 30}
        if (mid.len != 7) return error.DupMidLength;
        if (!eq(mid.samples(), &[_]i16{ 10, 20, 30, 20, 30, 40, 50 })) return error.DupMidWrong;

        var head = timeline.Clip{};
        try load_clip(&head, &[_]i16{ 10, 20, 30 });
        try duplicate(&head, 0, 2); // duplicate the head {10, 20}
        if (!eq(head.samples(), &[_]i16{ 10, 20, 10, 20, 30 })) return error.DupHeadWrong;

        var tail = timeline.Clip{};
        try load_clip(&tail, &[_]i16{ 10, 20, 30 });
        try duplicate(&tail, 1, 2); // duplicate through the tail {20, 30}
        if (!eq(tail.samples(), &[_]i16{ 10, 20, 30, 20, 30 })) return error.DupTailWrong;
    }

    // 2. THE INVERSE LAW — duplicate(start, count) then ALES2's cut(end, count) returns the original byte for byte, the inserted copy removed exactly.
    {
        const src = [_]i16{ 10, 20, 30, 40 };
        var clip = timeline.Clip{};
        try load_clip(&clip, &src);
        try duplicate(&clip, 1, 2); // {10, 20, 30, 20, 30, 40}
        if (!eq(clip.samples(), &[_]i16{ 10, 20, 30, 20, 30, 40 })) return error.DupInverseSetup;
        try timeline.cut(&clip, 3, 2); // remove the inserted copy at end = 1+2 = 3
        if (!eq(clip.samples(), &src)) return error.InverseBroken;
    }

    // 3. THE COPY / PEAK LAW — duplicate copies existing samples and invents none, so the peak re-measured through ALES13 is unchanged: the loudest sample inside the span
    //    appears twice at the same magnitude, and a loudest sample outside the span is untouched.
    {
        var inside = timeline.Clip{};
        try load_clip(&inside, &[_]i16{ 100, -30000, 200, -50 });
        const before_in = try clip_peak(&inside);
        try duplicate(&inside, 1, 1); // duplicate the loud -30000
        if (try clip_peak(&inside) != before_in) return error.PeakMovedInside;

        var outside = timeline.Clip{};
        try load_clip(&outside, &[_]i16{ 100, -30000, 200, -50 });
        const before_out = try clip_peak(&outside);
        try duplicate(&outside, 2, 2); // duplicate {200, -50} — the loud sample untouched
        if (try clip_peak(&outside) != before_out) return error.PeakMovedOutside;
    }

    // 4a. THE DEGENERATE LAW — count 0 is the identity (nothing inserted, the length unchanged).
    {
        var idc = timeline.Clip{};
        try load_clip(&idc, &[_]i16{ 7, 8, 9 });
        try duplicate(&idc, 1, 0); // zero count — the identity
        if (!eq(idc.samples(), &[_]i16{ 7, 8, 9 })) return error.ZeroCountMoved;
    }

    // 4b. THE REFUSAL LAW — a `start` past the current samples and a `count` past the remainder each refuse BadRange, and a grow past the fixed buffer refuses ClipFull, each
    //     before any write, the clip untouched.
    {
        var clip = timeline.Clip{};
        try load_clip(&clip, &[_]i16{ 1, 2, 3 });
        if (duplicate(&clip, 4, 1)) |_| return error.StartNotRefused else |e| {
            if (e != error.BadRange) return error.WrongError;
        }
        if (duplicate(&clip, 2, 5)) |_| return error.CountNotRefused else |e| {
            if (e != error.BadRange) return error.WrongError;
        }
        // The clip is untouched by the refused range calls — each refusal came before any write.
        if (!eq(clip.samples(), &[_]i16{ 1, 2, 3 })) return error.RefusedCallWrote;

        // A grow past the fixed buffer refuses ClipFull. Fill the clip to its bound, then a duplicate that would grow past it must refuse before any write.
        var full = timeline.Clip{};
        var i: u32 = 0;
        while (i < timeline.max_clip) : (i += 1) try timeline.splice(&full, i, &[_]i16{1});
        const full_len = full.len;
        if (duplicate(&full, 0, 1)) |_| return error.FullNotRefused else |e| {
            if (e != error.ClipFull) return error.WrongFullError;
        }
        if (full.len != full_len) return error.RefusedGrowChangedLength;
    }

    print("GREEN ales-duplicate: DUPLICATE — insert a second copy of the `count` samples starting at `start` immediately after the span, IN PLACE, so the span appears twice " ++
        "back to back and the clip GROWS by count; the growth-twin of ALES111's crop (which KEEPS a span and drops the rest, SHRINKING the clip): duplicate REPEATS one span " ++
        "in place. This is the Duplicate button every editor ships — circle a bar and a second copy lands immediately after the first (the doubled loop, the repeated chorus). " ++
        "The rule: open count silent seats at the span's end through ALES109's insert_silence, then copy the original span forward into the disjoint gap; no temporary buffer, " ++
        "refusing BadRange when the span falls outside the samples and ClipFull past the fixed buffer before any write. The crux is four laws. THE DUPLICATE LAW: the clip " ++
        "becomes original[0..end] ++ original[start..end] ++ original[end..len), the length grown by count. THE INVERSE LAW: duplicate then ALES2's cut(end, count) returns the " ++
        "original byte for byte. THE COPY / PEAK LAW: duplicate copies existing samples and invents none, so the peak re-measured through ALES13 is unchanged. THE DEGENERATE " ++
        "/ REFUSAL LAW: count 0 the identity, a span past the samples BadRange, a grow past the buffer ClipFull. Purely local — it opens a gap through insert_silence and " ++
        "fills it with a copy of an existing span, inventing no sample, changing no value, reading no byte past len; no real sample rate, no network, no keys, no funds, no " ++
        "real speaker\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
