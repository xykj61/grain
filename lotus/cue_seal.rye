//! lotus/cue_seal.rye — ALES37: the cue sheet, SEALED — the arrangement map that verifies before it is trusted. ALES34 gave the rack
//! sheet an integrity gate; a keeper saves TWO kinds of thing, though — the rack (the held audio) and the cue sheet (the arrangement
//! map: where the intro, verse, chorus, outro fall). ALES22 lets that map travel as a `format lotus-cue-sheet-v1` record, yet plain
//! text carries no proof it arrived whole — a hand-edited marker position or a truncated map parses as SOME OTHER arrangement without a
//! word, the same gap ALES34 closed for the rack. This rung hands the ALES0 wire's verify-before-trust to the saveable cue sheet, and
//! reveals that the seal is not specific to a rack: it is a law for any travels-as-text record.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES37.
//! Design read: active-designing/date/20260814/20260814-153033_fill-ales37-lotus-cue-seal.md
//! Stands on: lotus/cue_sheet.rye (ALES22) — render_sheet / parse_sheet reused WHOLE as the sealed body, so the seal adds only the
//! digest layer and no new grammar; lotus/markers.rye (ALES20) — the Markers track sealed and rebuilt. Mirrors lotus/rack_seal.rye
//! (ALES34) and the Sha256 verify-before-trust of lotus/wire.rye (ALES0) — an integrity check the reader recomputes itself, not a
//! signature.
//!
//! THE CRUX: a sealed cue sheet parses back to EXACTLY the same markers track ONLY when its digest matches its body — verify_and_parse
//! recomputes the Sha256 over the embedded ALES22 record and refuses DigestMismatch before a single marker is trusted, so a hand-edited
//! position or a truncated tail is caught at the gate rather than parsed as some other arrangement. Two facts make this exact. The seal
//! wraps ALES22 whole: seal_sheet renders the plain record with cue_sheet.render_sheet and writes a Sha256 over exactly those body
//! bytes, so the digest covers the canonical text with nothing added or omitted. And verify runs BEFORE trust: verify_and_parse checks
//! the digest first and hands the body to cue_sheet.parse_sheet only on a match, so no corrupt record ever reaches the parser — the
//! integrity gate is independent of and prior to every ALES22 grammar and position-bound check. The one honest difference from the rack
//! seal: parse_sheet validates positions against a master clip, so verify_and_parse takes that master and passes it through.
//!
//! HONEST SCOPE — software only, purely LOCAL. A Sha256 integrity check over an in-process text record, siloed to lotus/. It proves a
//! sheet arrived whole, NOT who wrote it — no signature, no key. No socket, no network, no keys, no funds, no real device, no real
//! meter, no real speaker.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/cue_seal.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const pan = @import("pan.rye");
const markers = @import("markers.rye");
const cue_sheet = @import("cue_sheet.rye");
const seal = @import("seal.rye");

pub const cue_seal_version = "20260814.153033";

/// The sealed record header, its own line — distinct from the plain ALES22 header AND from the rack's sealed header, so no record is
/// ever mistaken for another kind. `seal.open` requires a parsed record to open with exactly this before its digest is read. The digest
/// framing itself (the `digest ` prefix, the 64-hex width, the Sha256 verify-before-trust) is ALES38's shared law in lotus/seal.rye.
const sealed_header = "format lotus-cue-sheet-sealed-v1";

/// The combined error set of the cue seal: the shared seal's faults (DigestMismatch / BadRecord / Overflow) unioned with every
/// markers-track fault forwarded unchanged from ALES22. DigestMismatch and a malformed seal are caught before any marker is parsed. Zig
/// merges error sets by name, so the seal's BadRecord / Overflow coincide with ALES22's own rather than doubling.
pub const CueSealError = seal.SealError || cue_sheet.MarkerTextError;

/// Seal a markers track as a `format lotus-cue-sheet-sealed-v1` record into `out`, returning the length written. The record is the
/// sealed header line, a `digest <64 hex>` line over the body, then the whole plain ALES22 record as the body — the frame owned by
/// ALES38's seal.begin / seal.finish, the body rendered directly into `out` between them so the digest covers the canonical text with
/// nothing added or omitted and no scratch buffer is used. Refuses Overflow rather than writing past the caller's buffer. So a keeper's
/// arrangement map travels as text that verifies before it is trusted.
pub fn seal_sheet(m: *const markers.Markers, out: []u8) CueSealError!u32 {
    // invariant: the track stays within its named ceiling before it is ever sealed.
    assert(m.count <= markers.max_markers);
    const frame = try seal.begin(out, sealed_header);
    // Render the plain ALES22 record directly as the body between begin and finish, then let finish hash exactly those bytes.
    const body_len = try cue_sheet.render_sheet(m, out[frame.body_at..]);
    return seal.finish(out, frame, body_len);
}

/// Verify a sealed record and parse it into a fresh markers track over `master` — the integrity gate BEFORE trust. seal.open recomputes
/// the Sha256 over the body and returns the body slice only when the sealed header and `digest <64 hex>` line are well-formed and the
/// digest matches; only then is that body handed to ALES22's cue_sheet.parse_sheet (which validates each marker's position against
/// `master` — the one honest per-format difference, living here in the caller after the gate). A missing or malformed header or digest
/// line refuses BadRecord; a body that no longer matches its digest refuses DigestMismatch — in every refusal `out` is left an empty
/// track and no marker is trusted.
pub fn verify_and_parse(text: []const u8, master: *const pan.StereoClip, out: *markers.Markers) CueSealError!void {
    // invariant: verification starts from an empty track — a refused record leaves nothing half-parsed.
    out.* = markers.Markers{};
    // invariant: the sink is empty when this runs, so a leftover count means a prior render was
    // never drained and its samples would be mixed into this one
    assert(out.count == 0);

    // The integrity gate: seal.open returns the verified body BYTES, or refuses before any marker is trusted.
    const body = try seal.open(text, sealed_header);

    // Verified whole — only now is the body trusted to the ALES22 parser (which bounds each position against master).
    try cue_sheet.parse_sheet(body, master, out);
    // invariant: a verified track holds no more than the marker ceiling.
    assert(out.count <= markers.max_markers);
}

// --- selftest: THE CRUX — a sealed markers track round-trips through verify_and_parse; a flipped body byte and a truncated tail refuse
//     DigestMismatch; a malformed header or digest line refuses BadRecord; the body verified is the exact ALES22 record ------------

fn run_selftest() !u8 {
    // A master long enough to hold every marker position, and a four-marker track to seal in every case below.
    var master = pan.StereoClip{};
    master.left.len = 500;
    master.right.len = 500;
    var track = markers.Markers{};
    try markers.add(&track, &master, 0, "intro");
    try markers.add(&track, &master, 100, "verse");
    try markers.add(&track, &master, 250, "chorus");
    try markers.add(&track, &master, 400, "outro");

    // 1. THE CRUX — a sealed record opens with the sealed header and a digest line, and verify_and_parse recovers the exact track.
    {
        var text: [600]u8 = undefined;
        const n = try seal_sheet(&track, text[0..]);
        const want_head = "format lotus-cue-sheet-sealed-v1\ndigest ";
        if (!std.mem.eql(u8, text[0..want_head.len], want_head)) return error.SealHeadWrong;
        // the body (after the sealed header and 64-hex digest line) is exactly the plain ALES22 record.
        const body_at = want_head.len + seal.digest_hex_len + 1;
        if (!std.mem.eql(u8, text[body_at .. body_at + "format lotus-cue-sheet-v1\n".len], "format lotus-cue-sheet-v1\n")) return error.SealBodyWrong;

        var back = markers.Markers{};
        try verify_and_parse(text[0..n], &master, &back);
        if (back.count != 4) return error.VerifyCountWrong;
        // every position and name recovered, in order.
        if (markers.pos_of(&back, 0) != 0 or !std.mem.eql(u8, markers.name_of(&back, 0), "intro")) return error.Verify0Wrong;
        if (markers.pos_of(&back, 2) != 250 or !std.mem.eql(u8, markers.name_of(&back, 2), "chorus")) return error.Verify2Wrong;
        if (markers.pos_of(&back, 3) != 400 or !std.mem.eql(u8, markers.name_of(&back, 3), "outro")) return error.Verify3Wrong;
    }

    // 2. a single flipped BODY byte refuses DigestMismatch — the integrity gate, before any marker is parsed. The final byte is the
    //    body's trailing newline; step back to a name character and change it.
    {
        var text: [600]u8 = undefined;
        const n = try seal_sheet(&track, text[0..]);
        text[n - 2] = if (text[n - 2] == 'o') 'p' else 'o';
        var back = markers.Markers{};
        if (verify_and_parse(text[0..n], &master, &back)) |_| return error.TamperSlipped else |e| if (e != error.DigestMismatch) return error.WrongTamper;
        if (back.count != 0) return error.TamperMutated;
    }

    // 3. a TRUNCATED tail refuses — the shortened body hashes differently. Drop the last byte of a good record.
    {
        var text: [600]u8 = undefined;
        const n = try seal_sheet(&track, text[0..]);
        var back = markers.Markers{};
        if (verify_and_parse(text[0 .. n - 1], &master, &back)) |_| return error.TruncSlipped else |e| if (e != error.DigestMismatch) return error.WrongTrunc;
    }

    // 4. a malformed header or digest line refuses BadRecord — a plain (unsealed) record, a missing digest line, a short digest, and a
    //    non-hex digit in the digest — each caught before the body is hashed or parsed.
    {
        var back = markers.Markers{};
        if (verify_and_parse("format lotus-cue-sheet-v1\nmark 0 intro\n", &master, &back)) |_| return error.PlainSlipped else |e| if (e != error.BadRecord) return error.WrongPlain;
        if (verify_and_parse("format lotus-cue-sheet-sealed-v1\n", &master, &back)) |_| return error.NoDigestSlipped else |e| if (e != error.BadRecord) return error.WrongNoDigest;
        if (verify_and_parse("format lotus-cue-sheet-sealed-v1\ndigest abc\nformat lotus-cue-sheet-v1\n", &master, &back)) |_| return error.ShortDigestSlipped else |e| if (e != error.BadRecord) return error.WrongShortDigest;
        const bad_hex = "format lotus-cue-sheet-sealed-v1\ndigest " ++ ("z" ** 64) ++ "\nformat lotus-cue-sheet-v1\n";
        if (verify_and_parse(bad_hex, &master, &back)) |_| return error.BadHexSlipped else |e| if (e != error.BadRecord) return error.WrongBadHex;
    }

    // 5. a seal into a too-small buffer refuses Overflow rather than writing past its end.
    {
        var tiny: [40]u8 = undefined; // room for the header but not the digest line
        if (seal_sheet(&track, tiny[0..])) |_| return error.OverflowSlipped else |e| if (e != error.Overflow) return error.WrongOverflow;
    }

    print("GREEN ales-cue-seal: the cue sheet, SEALED — the arrangement map that verifies before it is trusted, the ALES0 wire's " ++
        "Sha256 verify-before-trust (and the ALES34 rack seal) handed to the saveable ALES22 cue sheet. THE CRUX: a sealed cue sheet " ++
        "parses back to exactly the same markers track ONLY when its digest matches its body — seal_sheet wraps ALES22 whole " ++
        "(rendering the plain record as the body and a Sha256 over exactly those bytes), and verify_and_parse recomputes the digest " ++
        "and hands the body to cue_sheet.parse_sheet only on a match, so a hand-edited position, a truncated tail, or a changed name " ++
        "is caught at the gate before a single marker is trusted; a sealed four-marker track round-trips whole, a flipped body byte " ++
        "and a truncated tail refuse DigestMismatch, a plain record / a missing / short / non-hex digest line refuses BadRecord, and a " ++
        "seal into a too-small buffer refuses Overflow; cue_sheet.render_sheet / parse_sheet reused whole; the seal proves a sheet " ++
        "arrived whole, not who wrote it — no signature, no socket, no network, no keys, no funds, no real device, no real meter, no " ++
        "real speaker\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
