//! lotus/wav.rye — ALES215: the canonical RIFF/WAVE container for mono 16-bit PCM. Two hundred and fifteen Lotus rungs edit an
//! in-memory i16 buffer; this rung is the door every one of them leaves through — a way to turn a bounded buffer of samples
//! into the open, decades-old .wav byte layout another program will open, and to read such a container back verify-before-trust
//! so a torn or malformed file never yields a half-sample onto a timeline. Software only — a byte container, no real file
//! handle, no DAC, no acoustic or electrical fact asserted.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus · the creative suite) · waymark ALES · rung ALES215.
//! Design read: active-designing/20260815-130110_fill-ales215-lotus-wav-container.md
//! Stands on: the verify-before-trust frame idiom proven at lotus/wire.rye (ALES0) — the same two-gate discipline (structure
//! whole AND sample-aligned), now speaking the RIFF/WAVE format the outside world already reads.
//!
//! HONEST SCOPE — software only. `encode`/`decode` convert between a bounded i16 buffer and the RIFF/WAVE byte layout; the
//! stored sample rate is an integer FIELD the container carries, not a real clock. No file is opened, no device driven, no
//! network, no keys, no funds. The format (RIFF/WAVE, IBM/Microsoft 1991) is public and unencumbered, studied clean-room; this
//! is our own bounded, asserted Rye implementation, siloed to lotus/.
//!
//! The canonical mono/16-bit header, 44 bytes, a single source of truth:
//!   "RIFF"(4) · riff_size(u32 LE) · "WAVE"(4) · "fmt "(4) · fmt_size(u32=16) · format(u16=1 PCM) · channels(u16=1) ·
//!   sample_rate(u32) · byte_rate(u32=rate*2) · block_align(u16=2) · bits(u16=16) · "data"(4) · data_size(u32) · payload(i16 LE).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/wav.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const wav_version = "20260815.130110";

/// One PCM sample is a little-endian signed 16-bit integer — two bytes. Named once so the sample-alignment border, the data
/// size, and the block align all read from a single source of truth.
pub const sample_bytes: u32 = 2;

/// The canonical mono/16-bit RIFF/WAVE header length: RIFF(4)+size(4)+WAVE(4)+"fmt "(4)+16+16+"data"(4)+size(4) = 44 bytes.
/// Named once so encode and decode can never read a field at the wrong offset.
pub const header_len: u32 = 44;

/// The one PCM format code this container speaks — 1, uncompressed integer PCM. A container declaring anything else refuses
/// `NotPcm` rather than guessing at a codec it does not know.
pub const pcm_format: u16 = 1;

/// This rung carries one channel — mono. The stereo twin (channels == 2, interleaved) is its own later rung.
pub const channels_mono: u16 = 1;

/// Sixteen bits per sample — the common CD-audio depth the whole Lotus suite already edits as i16.
pub const bits_per_sample: u16 = 16;

/// The fmt chunk body is always 16 bytes for canonical PCM. A container declaring another size refuses `BadFmtSize`.
pub const fmt_chunk_size: u32 = 16;

/// The widest sample buffer one container carries in this rung — a bounded ceiling so no size arithmetic overflows and no
/// unbounded read is ever attempted. A real long recording is a larger container; this rung proves the bounded case.
pub const max_samples: u32 = 1 << 20;

/// The widest data chunk — `max_samples` two-byte samples. Named so the whole-file bound reads from one source.
pub const max_data: u32 = max_samples * sample_bytes;

/// The widest whole container — header plus the widest data chunk.
pub const max_file: u32 = header_len + max_data;

/// A sane upper bound on the sample-rate FIELD, so `sample_rate * sample_bytes` (the byte rate) can never overflow u32 and a
/// wild rate is refused at the edge. 768 kHz is above every real professional rate; this asserts no real clock.
pub const max_sample_rate: u32 = 768_000;

pub const WavError = error{
    /// Fewer bytes than a whole canonical header cannot be read as a container.
    FileTooShort,
    /// The opening four bytes are not "RIFF".
    BadRiff,
    /// The declared RIFF chunk size does not equal the file length minus the 8-byte RIFF prefix.
    RiffSizeMismatch,
    /// The form type after the RIFF size is not "WAVE".
    BadWave,
    /// The first sub-chunk is not "fmt ".
    BadFmt,
    /// The fmt chunk body is not the canonical 16 bytes.
    BadFmtSize,
    /// The audio format code is not 1 (uncompressed integer PCM).
    NotPcm,
    /// The channel count is not 1 — this rung carries mono only.
    NotMono,
    /// The declared byte rate does not equal sample_rate * 2.
    ByteRateMismatch,
    /// The block align is not 2 (one 16-bit mono sample).
    BlockAlignMismatch,
    /// The bit depth is not 16.
    NotSixteenBit,
    /// The chunk after fmt is not "data".
    BadData,
    /// The declared data size is not a whole number of i16 samples — a container must never yield a torn half-sample.
    PartialSample,
    /// The declared data size is past this rung's ceiling — refused before any sample is read.
    DataOverflow,
    /// The header plus declared data size does not equal the buffer length — a truncated or padded container.
    DataSizeMismatch,
    /// The sample-rate field is zero or past the sane ceiling.
    BadSampleRate,
    /// More samples offered to the encoder than one container carries.
    TooManySamples,
    /// The caller's buffer cannot hold the whole encoded container, or the whole decoded sample count.
    OutputTooSmall,
};

/// What a decoded container yields: the sample-rate field it carried and how many samples were read into the caller's buffer.
pub const Pcm = struct {
    sample_rate: u32 = 0,
    count: u32 = 0,
};

/// Write the four ASCII bytes of a chunk tag at `off` in `out`. A plain bounded loop, never a bare memcpy.
fn put_tag(out: []u8, off: u32, tag: *const [4]u8) void {
    // invariant: the four tag bytes land wholly within the buffer.
    assert(off + 4 <= out.len);
    // invariant: a tag is exactly four bytes — the RIFF chunk-id width.
    assert(tag.len == 4);
    var i: u32 = 0;
    while (i < 4) : (i += 1) out[off + i] = tag[i];
}

/// True when the four bytes at `off` equal `tag`. Read-only; the single place a chunk tag is compared.
fn tag_is(bytes: []const u8, off: u32, tag: *const [4]u8) bool {
    // invariant: the compare window sits wholly within the bytes.
    assert(off + 4 <= bytes.len);
    var i: u32 = 0;
    while (i < 4) : (i += 1) {
        if (bytes[off + i] != tag[i]) return false;
    }
    return true;
}

/// Encode a buffer of mono i16 samples into a canonical RIFF/WAVE container written into `out`, returning the byte length.
/// Every fault — too many samples, a wild rate, a buffer too small — refuses BEFORE a single byte is written, so a failed
/// encode never leaves a half-written container.
pub fn encode(sample_rate: u32, samples: []const i16, out: []u8) WavError!u32 {
    if (samples.len > max_samples) return error.TooManySamples;
    if (sample_rate == 0 or sample_rate > max_sample_rate) return error.BadSampleRate;
    const count: u32 = @intCast(samples.len);
    const data_size = count * sample_bytes;
    const file_len = header_len + data_size;
    if (out.len < file_len) return error.OutputTooSmall;
    // invariant: the whole container fits the caller's buffer, proven before any write.
    assert(file_len <= out.len);
    // invariant: the data chunk is a whole number of samples by construction.
    assert(data_size % sample_bytes == 0);

    put_tag(out, 0, "RIFF");
    std.mem.writeInt(u32, out[4..8], file_len - 8, .little);
    put_tag(out, 8, "WAVE");
    put_tag(out, 12, "fmt ");
    std.mem.writeInt(u32, out[16..20], fmt_chunk_size, .little);
    std.mem.writeInt(u16, out[20..22], pcm_format, .little);
    std.mem.writeInt(u16, out[22..24], channels_mono, .little);
    std.mem.writeInt(u32, out[24..28], sample_rate, .little);
    std.mem.writeInt(u32, out[28..32], sample_rate * sample_bytes, .little);
    std.mem.writeInt(u16, out[32..34], @intCast(sample_bytes), .little);
    std.mem.writeInt(u16, out[34..36], bits_per_sample, .little);
    put_tag(out, 36, "data");
    std.mem.writeInt(u32, out[40..44], data_size, .little);

    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const at = header_len + i * sample_bytes;
        std.mem.writeInt(i16, out[at..][0..2], samples[i], .little);
    }
    // invariant: the returned length is exactly header plus the whole data chunk written.
    assert(file_len == header_len + count * sample_bytes);
    return file_len;
}

/// Prove a container whole and canonical, running every check in order BEFORE any sample is read, then read its samples into
/// `out`. The size chain proves the file self-consistent and the audio border proves it sample-aligned — two independent
/// gates, so a container can never yield a torn half-sample.
pub fn decode(bytes: []const u8, out: []i16) WavError!Pcm {
    if (bytes.len < header_len) return error.FileTooShort;
    if (!tag_is(bytes, 0, "RIFF")) return error.BadRiff;
    const riff_size = std.mem.readInt(u32, bytes[4..8], .little);
    // The RIFF size counts every byte after its own 8-byte prefix.
    if (riff_size != @as(u32, @intCast(bytes.len)) - 8) return error.RiffSizeMismatch;
    if (!tag_is(bytes, 8, "WAVE")) return error.BadWave;
    if (!tag_is(bytes, 12, "fmt ")) return error.BadFmt;
    if (std.mem.readInt(u32, bytes[16..20], .little) != fmt_chunk_size) return error.BadFmtSize;
    if (std.mem.readInt(u16, bytes[20..22], .little) != pcm_format) return error.NotPcm;
    if (std.mem.readInt(u16, bytes[22..24], .little) != channels_mono) return error.NotMono;
    const sample_rate = std.mem.readInt(u32, bytes[24..28], .little);
    if (sample_rate == 0 or sample_rate > max_sample_rate) return error.BadSampleRate;
    if (std.mem.readInt(u32, bytes[28..32], .little) != sample_rate * sample_bytes) return error.ByteRateMismatch;
    if (std.mem.readInt(u16, bytes[32..34], .little) != @as(u16, @intCast(sample_bytes))) return error.BlockAlignMismatch;
    if (std.mem.readInt(u16, bytes[34..36], .little) != bits_per_sample) return error.NotSixteenBit;
    if (!tag_is(bytes, 36, "data")) return error.BadData;
    const data_size = std.mem.readInt(u32, bytes[40..44], .little);
    // THE AUDIO BORDER — a data chunk that is not a whole number of i16 samples would yield a torn half-sample. Refuse it
    // before a single sample is read.
    if (data_size % sample_bytes != 0) return error.PartialSample;
    if (data_size > max_data) return error.DataOverflow;
    if (header_len + data_size != bytes.len) return error.DataSizeMismatch;
    const count: u32 = data_size / sample_bytes;
    if (count > out.len) return error.OutputTooSmall;
    // invariant: the data chunk is proven whole, sample-aligned, and within bound before any sample is read.
    assert(count * sample_bytes == data_size);
    assert(count <= out.len);

    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const at = header_len + i * sample_bytes;
        out[i] = std.mem.readInt(i16, bytes[at..][0..2], .little);
    }
    // invariant: exactly the container's declared sample count was read back.
    assert(i == count);
    return .{ .sample_rate = sample_rate, .count = count };
}

// --- selftest: a buffer round-trips byte-for-byte through the canonical container; the header is exactly canonical; an empty
//     buffer yields a valid 44-byte header; a torn data chunk refuses PartialSample; and every header corruption refuses by
//     name before a sample crosses ------------------------------------------------------------------------------------------

fn run_selftest() !u8 {
    const rate: u32 = 44_100;
    // A small buffer with distinct, signed, boundary-touching values so a byte-for-byte round-trip is a real check.
    const tone = [_]i16{ 0, 1, -1, 32767, -32768, 100, -100, 4242 };

    var file: [header_len + 64 * sample_bytes]u8 = undefined;
    var back: [64]i16 = undefined;

    // 1. THE ROUND-TRIP LAW — the buffer encodes and decodes back byte-for-byte, the rate preserved.
    const wrote = try encode(rate, &tone, &file);
    assert(wrote == header_len + tone.len * sample_bytes);
    {
        const got = try decode(file[0..wrote], &back);
        assert(got.sample_rate == rate);
        assert(got.count == tone.len);
        var s: u32 = 0;
        while (s < tone.len) : (s += 1) assert(back[s] == tone[s]);
    }

    // 2. THE CANONICAL-HEADER LAW — the encoded bytes carry exactly the canonical mono/16-bit fields.
    {
        assert(tag_is(file[0..wrote], 0, "RIFF"));
        assert(std.mem.readInt(u32, file[4..8], .little) == wrote - 8);
        assert(tag_is(file[0..wrote], 8, "WAVE"));
        assert(tag_is(file[0..wrote], 12, "fmt "));
        assert(std.mem.readInt(u32, file[16..20], .little) == fmt_chunk_size);
        assert(std.mem.readInt(u16, file[20..22], .little) == pcm_format);
        assert(std.mem.readInt(u16, file[22..24], .little) == channels_mono);
        assert(std.mem.readInt(u32, file[28..32], .little) == rate * sample_bytes);
        assert(std.mem.readInt(u16, file[32..34], .little) == sample_bytes);
        assert(std.mem.readInt(u16, file[34..36], .little) == bits_per_sample);
        assert(tag_is(file[0..wrote], 36, "data"));
        assert(std.mem.readInt(u32, file[40..44], .little) == tone.len * sample_bytes);
    }

    // 3. THE EMPTY LAW — zero samples encode to a valid 44-byte header and decode back to a count of zero.
    {
        const empty = [_]i16{};
        var ef: [header_len]u8 = undefined;
        const ew = try encode(rate, &empty, &ef);
        assert(ew == header_len);
        var eb: [1]i16 = undefined;
        const eg = try decode(ef[0..ew], &eb);
        assert(eg.count == 0);
        assert(eg.sample_rate == rate);
    }

    // 4. THE AUDIO-BORDER LAW — a data chunk one byte short of whole samples refuses PartialSample. Shorten the file and fix
    //    both size fields so only the border can catch it.
    {
        var f = file;
        const short_data = (tone.len * sample_bytes) - 1; // one byte short of whole samples
        const short_len = header_len + short_data;
        std.mem.writeInt(u32, f[4..8], short_len - 8, .little);
        std.mem.writeInt(u32, f[40..44], short_data, .little);
        if (decode(f[0..short_len], &back)) |_| return error.PartialSlipped else |e| if (e != error.PartialSample) return error.WrongPartial;
    }

    // 5. THE FAULT LAW — every structural corruption refuses by name before a sample crosses.
    {
        // Shorter than a whole header.
        if (decode(file[0 .. header_len - 1], &back)) |_| return error.ShortSlipped else |e| if (e != error.FileTooShort) return error.WrongShort;

        // A flipped RIFF tag.
        {
            var c = file;
            c[0] = 'X';
            if (decode(c[0..wrote], &back)) |_| return error.RiffSlipped else |e| if (e != error.BadRiff) return error.WrongRiff;
        }
        // A mismatched RIFF size.
        {
            var c = file;
            std.mem.writeInt(u32, c[4..8], wrote, .little);
            if (decode(c[0..wrote], &back)) |_| return error.RiffSizeSlipped else |e| if (e != error.RiffSizeMismatch) return error.WrongRiffSize;
        }
        // A non-WAVE form.
        {
            var c = file;
            c[8] = 'X';
            if (decode(c[0..wrote], &back)) |_| return error.WaveSlipped else |e| if (e != error.BadWave) return error.WrongWave;
        }
        // A non-"fmt " chunk.
        {
            var c = file;
            c[12] = 'X';
            if (decode(c[0..wrote], &back)) |_| return error.FmtSlipped else |e| if (e != error.BadFmt) return error.WrongFmt;
        }
        // A wrong fmt size.
        {
            var c = file;
            std.mem.writeInt(u32, c[16..20], 18, .little);
            if (decode(c[0..wrote], &back)) |_| return error.FmtSizeSlipped else |e| if (e != error.BadFmtSize) return error.WrongFmtSize;
        }
        // A non-PCM format.
        {
            var c = file;
            std.mem.writeInt(u16, c[20..22], 3, .little); // 3 = IEEE float
            if (decode(c[0..wrote], &back)) |_| return error.PcmSlipped else |e| if (e != error.NotPcm) return error.WrongPcm;
        }
        // A non-mono channel count.
        {
            var c = file;
            std.mem.writeInt(u16, c[22..24], 2, .little);
            if (decode(c[0..wrote], &back)) |_| return error.MonoSlipped else |e| if (e != error.NotMono) return error.WrongMono;
        }
        // A mismatched byte rate.
        {
            var c = file;
            std.mem.writeInt(u32, c[28..32], rate, .little); // should be rate*2
            if (decode(c[0..wrote], &back)) |_| return error.ByteRateSlipped else |e| if (e != error.ByteRateMismatch) return error.WrongByteRate;
        }
        // A wrong block align.
        {
            var c = file;
            std.mem.writeInt(u16, c[32..34], 4, .little);
            if (decode(c[0..wrote], &back)) |_| return error.BlockAlignSlipped else |e| if (e != error.BlockAlignMismatch) return error.WrongBlockAlign;
        }
        // A non-16-bit depth.
        {
            var c = file;
            std.mem.writeInt(u16, c[34..36], 24, .little);
            if (decode(c[0..wrote], &back)) |_| return error.BitsSlipped else |e| if (e != error.NotSixteenBit) return error.WrongBits;
        }
        // A non-"data" chunk.
        {
            var c = file;
            c[36] = 'X';
            if (decode(c[0..wrote], &back)) |_| return error.DataSlipped else |e| if (e != error.BadData) return error.WrongData;
        }
        // A mismatched data size (declares less than the buffer holds).
        {
            var c = file;
            std.mem.writeInt(u32, c[40..44], (tone.len * sample_bytes) - sample_bytes, .little);
            if (decode(c[0..wrote], &back)) |_| return error.DataSizeSlipped else |e| if (e != error.DataSizeMismatch) return error.WrongDataSize;
        }
        // A zero sample rate.
        {
            var c = file;
            std.mem.writeInt(u32, c[24..28], 0, .little);
            std.mem.writeInt(u32, c[28..32], 0, .little); // keep byte rate consistent so only the rate gate can catch it
            if (decode(c[0..wrote], &back)) |_| return error.RateSlipped else |e| if (e != error.BadSampleRate) return error.WrongRate;
        }
    }

    // 6. Encode faults refuse before any write.
    {
        var tiny: [header_len - 1]u8 = undefined;
        if (encode(rate, &tone, &tiny)) |_| return error.SmallSlipped else |e| if (e != error.OutputTooSmall) return error.WrongSmall;

        var one: [header_len + sample_bytes]u8 = undefined;
        if (encode(0, &tone, &one)) |_| return error.RateEncSlipped else |e| if (e != error.BadSampleRate) return error.WrongRateEnc;
    }

    print("GREEN ales-wav: a bounded buffer of i16 PCM samples round-trips byte-for-byte through the canonical RIFF/WAVE " ++
        "container (RIFF · WAVE · fmt  · format 1 · 1 channel · 16 bit · byte_rate rate*2 · block_align 2 · data), the " ++
        "sample-rate field preserved; an empty buffer yields a valid 44-byte header; a data chunk one byte short of whole " ++
        "samples refuses PartialSample at the audio border; and a bad RIFF/WAVE/fmt tag, wrong fmt size, non-PCM format, " ++
        "non-mono channels, mismatched byte rate or block align, non-16-bit depth, absent data chunk, mismatched riff/data " ++
        "size, or a zero/over-bound rate each refuses by name before a sample crosses — structure and sample-alignment are " ++
        "two gates, so no timeline ever receives a half-sample; a byte container only, no real file, no DAC, no acoustic " ++
        "fact, no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
