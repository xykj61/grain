//! lotus/album_manifest.rye -- ALES224: a whole record's own content address, sealed. ALES221 gave a single render a sealed,
//! content-addressed manifest; ALES223 gathered many renders into an album -- yet the album as a whole has no small, citable name.
//! A keeper who wants to publish a record, cite it in a chain of custody, or prove two copies are the same record needs ONE short
//! sealed record that fixes the whole collection's identity, without shipping the audio to do it. This rung seats it: a sealed
//! `format lotus-album-v1` body listing the track count and, per track, its name and the Sha256 of its whole bundle bytes.
//!
//! Season: the Six-Season double-seat, Season C thread (Lotus - the creative suite) - waymark ALES - rung ALES224.
//! Design read: active-designing/date/20260815/20260815-140211_fill-ales224-lotus-album-manifest.md
//! Stands on: lotus/seal.rye (ALES38) -- begin/finish/open, the verify-before-trust frame reused WHOLE; lotus/render_album.rye
//! (ALES223) -- the TrackIn (name - bundle bytes) this manifest names, and its max_tracks / max_track_name bounds; std.crypto Sha256
//! for each track's bundle digest, the same hash the seal and the render manifest already carry. No new hash, no new frame.
//!
//! album_manifest is to the album exactly what render_manifest is to a single render, one level up. Each track's bundle Sha256
//! already binds that track's manifest AND its audio (a bundle self-binds, ALES222), so listing those digests fixes the whole
//! collection; the seal's own digest binds this listing's text. Content-addressing, never a signature: it proves a collection's
//! identity is whole, NOT who made it. No key, no custody.
//!
//! HONEST SCOPE -- software only, purely LOCAL. A Sha256 record over in-process bytes, siloed to lotus/. No real file, no DAC, no
//! acoustic or electrical fact, no network, no keys, no funds, no real device.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run lotus/album_manifest.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const seal = @import("seal.rye");
const render_album = @import("render_album.rye");
const parse_int = @import("parse_int.rye");
const tally_copy = @import("tally_copy.rye");

const Sha256 = std.crypto.hash.sha2.Sha256;

pub const album_manifest_version = "20260815.140211";

/// The sealed record's kind line -- the header seal.begin writes and seal.open matches. An album manifest sealed under this kind
/// can never be opened as a render manifest or any other format.
pub const header = "format lotus-album-v1";

/// The most tracks one album manifest lists -- harmonized with the album's own bound, so a manifest names exactly the catalog a
/// LOTUSALB frame can carry.
pub const max_tracks: u32 = render_album.max_tracks;

/// The longest track name the manifest carries -- harmonized with the album's bound. In this readable body a name is a single
/// token (the line grammar reserves the space and the newline), so a name with a space refuses NameTooLong rather than breaking a
/// line the reader trusts.
pub const max_track_name: u32 = render_album.max_track_name;

/// The 64 lowercase hex characters of a full Sha256 -- the same width the seal and the render manifest carry.
pub const digest_hex_len: u32 = seal.digest_hex_len;

/// The widest count line -- `count ` (6) plus a u32's widest decimal (10) plus a newline. Named so the body ceiling reads from one
/// source.
pub const count_line_max: u32 = 6 + 10 + 1;

/// The widest single track line -- `track ` (6) plus the name bound, a space, the 64-hex digest, and a newline.
pub const track_line_max: u32 = 6 + max_track_name + 1 + digest_hex_len + 1;

/// The widest sealed album manifest: the seal frame overhead (the header line, the `digest <64 hex>` line) plus the body (the
/// count line and up to max_tracks track lines). A named ceiling so seal_album_manifest's output buffer is bounded and every
/// offset stays inside u32.
pub const max_album_manifest_bytes: u32 =
    @intCast(header.len + 1 + seal.digest_prefix.len + digest_hex_len + 1 + count_line_max + max_tracks * track_line_max);

/// The album manifest's own faults, unioned with the seal's (DigestMismatch - BadRecord - Overflow). BadAlbumManifest is a
/// malformed body field; NameTooLong a name that is not a single token; TooManyTracks a count past the bound; the three Mismatch
/// faults are what verify_album refuses when a collection in hand is not the record the manifest names.
pub const AlbumManifestError = seal.SealError || error{
    /// A body field is missing, out of order, or malformed (a bad count, a track line without its prefix, name, digest, or newline).
    BadAlbumManifest,
    /// A track name is empty, longer than max_track_name, or carries a space or newline the readable line grammar reserves.
    NameTooLong,
    /// The track count is past max_tracks -- refused before the fixed entry array could overflow.
    TooManyTracks,
    /// verify_album was handed a collection with a different number of tracks than the manifest names.
    CountMismatch,
    /// verify_album found a track whose name does not match the manifest's, in order.
    TrackNameMismatch,
    /// verify_album recomputed a track's bundle Sha256 and it does not match the manifest's digest -- a swapped or edited track.
    TrackDigestMismatch,
};

/// One entry in an opened album manifest: a track's name and the 64-hex Sha256 of its bundle, both slices INTO the opened body.
pub const Entry = struct {
    name: []const u8,
    digest: []const u8,
};

/// A parsed, sealed album manifest -- the ordered catalog of `(name, digest)` entries the seal already proved whole, and how many
/// are live. Lives only as long as the text it was opened from.
pub const AlbumManifest = struct {
    entries: [max_tracks]Entry = undefined,
    count: u32 = 0,
};

/// Write `bytes` as lowercase hex into `out`, two characters per byte -- the `{x:0>2}` idiom, so a zero byte renders `00`. `out`
/// must hold exactly `bytes.len * 2` characters.
fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex characters per byte.
    assert(out.len == bytes.len * 2);
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        _ = std.fmt.bufPrint(out[i * 2 ..][0..2], "{x:0>2}", .{bytes[i]}) catch unreachable; // two chars always fit the reserved pair
    }
}

/// True when `name` is a single legal token: non-empty, within the bound, and free of the space and newline the line grammar
/// reserves. A name that fails this can never be written, so seal_album_manifest refuses before it touches the buffer.
fn name_ok(name: []const u8) bool {
    if (name.len == 0 or name.len > max_track_name) return false;
    var i: u32 = 0;
    while (i < name.len) : (i += 1) {
        if (name[i] == ' ' or name[i] == '\n') return false;
    }
    return true;
}

/// Seal an album's content address into `out`: hash each track's whole bundle bytes, then render a `count <n>` line and one
/// `track <name> <digest>` line per track inside a seal.begin/finish frame. Returns the total sealed length. Refuses
/// TooManyTracks past the bound, NameTooLong for a name that is not a single token, and Overflow rather than writing past the
/// buffer.
pub fn seal_album_manifest(out: []u8, tracks: []const render_album.TrackIn) AlbumManifestError!u32 {
    // invariant: the catalog stays within its bound, so the count fits u32 and the loop terminates.
    if (tracks.len > max_tracks) return error.TooManyTracks;
    const count: u32 = @intCast(tracks.len);

    const fr = try seal.begin(out, header);
    const cnt = std.fmt.bufPrint(out[fr.body_at..], "count {d}\n", .{count}) catch return error.Overflow;
    var body_len: u32 = @intCast(cnt.len);

    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const t = tracks[i];
        // invariant: each track name is a single legal token -- checked before it is written, so a bad name never half-fills the body.
        if (!name_ok(t.name)) return error.NameTooLong;
        var dg: [Sha256.digest_length]u8 = undefined;
        Sha256.hash(t.bundle, &dg, .{});
        var hex: [digest_hex_len]u8 = undefined;
        to_hex(&dg, hex[0..]);

        const line = std.fmt.bufPrint(out[fr.body_at + body_len ..], "track {s} {s}\n", .{ t.name, hex[0..] }) catch return error.Overflow;
        body_len += @intCast(line.len);
    }

    const total = seal.finish(out, fr, body_len);
    // invariant: the sealed record fits the buffer the caller gave.
    assert(total <= out.len);
    return total;
}

/// Read the `count <n>` line at `body[0..]`, returning the value and the cursor just past its newline. A missing prefix or newline
/// refuses BadAlbumManifest.
fn count_field(body: []const u8) AlbumManifestError!struct { value: []const u8, next: u32 } {
    const prefix = "count ";
    if (body.len < prefix.len) return error.BadAlbumManifest;
    if (!std.mem.eql(u8, body[0..prefix.len], prefix)) return error.BadAlbumManifest;
    const after = body[prefix.len..];
    const nl = std.mem.indexOfScalar(u8, after, '\n') orelse return error.BadAlbumManifest;
    // seam: prefix.len and nl are std usize; the body is bounded well under u32, so both narrow safely at this edge.
    const prefix_len: u32 = @intCast(prefix.len);
    const nl_u32: u32 = @intCast(nl);
    return .{ .value = after[0..nl], .next = prefix_len + nl_u32 + 1 };
}

/// Read one `track <name> <digest>` line at `body[cursor..]`: the prefix, a single-token name up to a space, then exactly
/// digest_hex_len hex to a newline. Returns the name and digest slices and the cursor just past the newline. Any malformation
/// refuses BadAlbumManifest -- the reader never guesses a field.
fn track_line(body: []const u8, cursor: u32) AlbumManifestError!struct { name: []const u8, digest: []const u8, next: u32 } {
    // invariant: the cursor stays within the body -- an exhausted body is a malformed record, not a silent stop.
    if (cursor > body.len) return error.BadAlbumManifest;
    const rest = body[cursor..];
    const prefix = "track ";
    if (rest.len < prefix.len) return error.BadAlbumManifest;
    if (!std.mem.eql(u8, rest[0..prefix.len], prefix)) return error.BadAlbumManifest;

    const after = rest[prefix.len..];
    const sp = std.mem.indexOfScalar(u8, after, ' ') orelse return error.BadAlbumManifest;
    const name = after[0..sp];
    if (!name_ok(name)) return error.BadAlbumManifest;

    const after_name = after[sp + 1 ..];
    const nl = std.mem.indexOfScalar(u8, after_name, '\n') orelse return error.BadAlbumManifest;
    const digest = after_name[0..nl];
    // invariant: the digest is exactly the full hex width -- a short or long field is a malformed line.
    if (digest.len != digest_hex_len) return error.BadAlbumManifest;

    // seam: every offset is a std usize into a body bounded well under u32; they narrow safely at this edge.
    const prefix_len: u32 = @intCast(prefix.len);
    const sp_u32: u32 = @intCast(sp);
    const nl_u32: u32 = @intCast(nl);
    return .{ .name = name, .digest = digest, .next = cursor + prefix_len + sp_u32 + 1 + nl_u32 + 1 };
}

/// Open a sealed album manifest -- the integrity gate BEFORE trust. seal.open recomputes the record's digest and refuses
/// DigestMismatch / BadRecord before a field is read; only a whole record's body is parsed into an AlbumManifest.
pub fn open_album_manifest(text: []const u8) AlbumManifestError!AlbumManifest {
    // invariant: the body is verified whole before any field is trusted -- no partial parse of a corrupt record.
    const body = try seal.open(text, header);

    const f_count = try count_field(body);
    const count = parse_int.parse_int(u32, f_count.value, .{}) catch return error.BadAlbumManifest;
    if (count > max_tracks) return error.TooManyTracks;

    var am: AlbumManifest = .{ .count = count };
    var cursor: u32 = f_count.next;
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        const tl = try track_line(body, cursor);
        am.entries[i] = .{ .name = tl.name, .digest = tl.digest };
        cursor = tl.next;
    }

    // invariant: the whole body was consumed -- a trailing line is a record this grammar does not know, refused not ignored.
    if (cursor != body.len) return error.BadAlbumManifest;
    return am;
}

/// Confirm a collection in hand IS the record its manifest names: the count must match, then each track's name and recomputed
/// bundle Sha256 must match the manifest, in order. A swapped, edited, missing, or added track refuses by name before the
/// collection is trusted. Infallible otherwise -- a match returns cleanly.
pub fn verify_album(am: *const AlbumManifest, tracks: []const render_album.TrackIn) AlbumManifestError!void {
    // invariant: the manifest names no more than its bound -- open_album_manifest already proved it, re-asserted at the use site.
    assert(am.count <= max_tracks);
    if (tracks.len != am.count) return error.CountMismatch;

    var i: u32 = 0;
    while (i < am.count) : (i += 1) {
        const t = tracks[i];
        if (!std.mem.eql(u8, t.name, am.entries[i].name)) return error.TrackNameMismatch;
        var dg: [Sha256.digest_length]u8 = undefined;
        Sha256.hash(t.bundle, &dg, .{});
        var hex: [digest_hex_len]u8 = undefined;
        to_hex(&dg, hex[0..]);
        if (!std.mem.eql(u8, hex[0..], am.entries[i].digest)) return error.TrackDigestMismatch;
    }
}

// --- selftest: THE CONTENT-ADDRESS LAW -- seal then open recovers the count and every (name, digest) in order, verify_album accepts
//     the exact tracks; THE TAMPER LAW -- a flipped bundle byte refuses TrackDigestMismatch, a swapped name TrackNameMismatch, a
//     dropped track CountMismatch; THE SEAL LAW -- a tampered body refuses DigestMismatch, a wrong header BadRecord; THE GRAMMAR LAW
//     -- a spaced name refuses NameTooLong, a malformed body BadAlbumManifest; THE ATOMIC LAW -- a small buffer refuses Overflow ----

fn run_selftest() !u8 {
    // Three stand-in bundles -- any bytes serve, since the manifest addresses bundle OUTPUT bytes, it does not build one.
    const b0 = "LOTUSBND....first bundle bytes....\x01\x02\x03";
    const b1 = "LOTUSBND....second bundle bytes...\x04\x05\x06";
    const b2 = "LOTUSBND....third bundle bytes....\x07\x08\x09";
    const tracks = [_]render_album.TrackIn{
        .{ .name = "opener", .bundle = b0 },
        .{ .name = "middle", .bundle = b1 },
        .{ .name = "closer", .bundle = b2 },
    };

    // 1. THE CONTENT-ADDRESS LAW -- seal, open, recover the count and every entry in order; verify_album accepts the exact tracks.
    {
        var out: [max_album_manifest_bytes]u8 = undefined;
        const n = try seal_album_manifest(out[0..], tracks[0..]);
        const am = try open_album_manifest(out[0..n]);
        if (am.count != 3) return error.CountWrong;
        if (!std.mem.eql(u8, am.entries[0].name, "opener")) return error.Name0Wrong;
        if (!std.mem.eql(u8, am.entries[2].name, "closer")) return error.Name2Wrong;
        if (am.entries[1].digest.len != digest_hex_len) return error.DigestWidthWrong;
        try verify_album(&am, tracks[0..]); // the record names exactly these tracks
    }

    // 2. THE TAMPER LAW -- a flipped byte in a bundle refuses TrackDigestMismatch; a swapped name TrackNameMismatch; a dropped track
    //    CountMismatch.
    {
        var out: [max_album_manifest_bytes]u8 = undefined;
        const n = try seal_album_manifest(out[0..], tracks[0..]);
        const am = try open_album_manifest(out[0..n]);

        var b1_flipped: [b1.len]u8 = undefined;
        tally_copy.copy_disjoint(u8, b1_flipped[0..], b1); // a test scratch copy, not a suite data path
        b1_flipped[0] ^= 0x01;
        const tampered = [_]render_album.TrackIn{
            .{ .name = "opener", .bundle = b0 },
            .{ .name = "middle", .bundle = b1_flipped[0..] },
            .{ .name = "closer", .bundle = b2 },
        };
        if (verify_album(&am, tampered[0..])) |_| return error.FlipSlipped else |e| if (e != error.TrackDigestMismatch) return error.WrongFlip;

        const renamed = [_]render_album.TrackIn{
            .{ .name = "opener", .bundle = b0 },
            .{ .name = "bridge", .bundle = b1 }, // a different name for the same bytes
            .{ .name = "closer", .bundle = b2 },
        };
        if (verify_album(&am, renamed[0..])) |_| return error.NameSlipped else |e| if (e != error.TrackNameMismatch) return error.WrongName;

        if (verify_album(&am, tracks[0..2])) |_| return error.CountSlipped else |e| if (e != error.CountMismatch) return error.WrongCount;
    }

    // 3. THE SEAL LAW -- a flipped body byte refuses DigestMismatch; a wrong header refuses BadRecord (inherited from ALES38).
    {
        var out: [max_album_manifest_bytes]u8 = undefined;
        const n = try seal_album_manifest(out[0..], tracks[0..]);
        out[n - 2] ^= 0x01; // a byte inside the body, never the digest line
        if (open_album_manifest(out[0..n])) |_| return error.TamperSlipped else |e| if (e != error.DigestMismatch) return error.WrongTamper;

        var again: [max_album_manifest_bytes]u8 = undefined;
        const n2 = try seal_album_manifest(again[0..], tracks[0..]);
        if (seal.open(again[0..n2], "format lotus-other-v1")) |_| return error.HeaderSlipped else |e| if (e != error.BadRecord) return error.WrongHeader;
    }

    // 4. THE GRAMMAR LAW -- a name with a space refuses NameTooLong at seal; a count past the bound refuses TooManyTracks; a
    //    hand-built body with a malformed track line refuses BadAlbumManifest at open.
    {
        var out: [max_album_manifest_bytes]u8 = undefined;
        const spaced = [_]render_album.TrackIn{.{ .name = "two words", .bundle = b0 }};
        if (seal_album_manifest(out[0..], spaced[0..])) |_| return error.SpaceSlipped else |e| if (e != error.NameTooLong) return error.WrongSpace;

        // A hand-built body whose single track line is missing its digest -- open must refuse BadAlbumManifest, not guess.
        const bad_body = "count 1\ntrack opener \n";
        var hand: [max_album_manifest_bytes]u8 = undefined;
        const fr = try seal.begin(hand[0..], header);
        tally_copy.copy_disjoint(u8, hand[fr.body_at .. fr.body_at + bad_body.len], bad_body);
        const hn = seal.finish(hand[0..], fr, @intCast(bad_body.len));
        if (open_album_manifest(hand[0..hn])) |_| return error.BadBodySlipped else |e| if (e != error.BadAlbumManifest) return error.WrongBadBody;
    }

    // 5. THE ATOMIC LAW -- a buffer too small for the sealed record refuses Overflow rather than truncating it.
    {
        var tiny: [96]u8 = undefined; // room for the header and digest line, not the body's three track lines
        if (seal_album_manifest(tiny[0..], tracks[0..])) |_| return error.OverflowSlipped else |e| if (e != error.Overflow) return error.WrongOverflow;
    }

    print("GREEN ales-album-manifest: a whole record's own content address, sealed — a `format lotus-album-v1` record (count · per " ++
        "track: name · bundle Sha256) sealed through the ALES38 verify-before-trust frame, one level up from the render manifest. " ++
        "THE CONTENT-ADDRESS LAW: seal then open recovers the count and every entry in order, verify_album accepts the exact " ++
        "tracks. THE TAMPER LAW: a flipped bundle byte refuses TrackDigestMismatch, a swapped name TrackNameMismatch, a dropped " ++
        "track CountMismatch. THE SEAL LAW: a tampered body refuses DigestMismatch, a wrong header BadRecord. THE GRAMMAR LAW: a " ++
        "spaced name refuses NameTooLong, a malformed body BadAlbumManifest. THE ATOMIC LAW: a small buffer refuses Overflow. " ++
        "Content-addressing, not a signature — it proves a collection's identity is whole, not who made it; no real file, no DAC, " ++
        "no network, no keys, no funds, no real device\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
