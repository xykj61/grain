//! encoding/pem.rye — PEM (RFC 7468) textual encoding authored in pure Rye as a composition, no new base conversion. PEM is the armor a
//! key, a certificate, or a signature wears when it travels as text: a `-----BEGIN LABEL-----` line, the payload rendered in standard Base64
//! and wrapped at 64 characters a line, and a `-----END LABEL-----` line to close it. It is the exact form an Ed25519 key or a signed carry
//! is pasted into a config file, mailed between two hands, or committed beside its code — the shape `openssl` prints and every TLS stack reads.
//! This module composes one already-GREEN rung — the standard-alphabet Base64 rendering from encoding/base64.rye — and authors none of its
//! own base arithmetic; it adds only the label framing and the line wrapping RFC 7468 lays down.
//!
//! Season: encoding — the serialization sibling of Season G (Cryptography), beside base64.rye and base58check.rye. Where base64.rye renders
//! raw bytes to symbols, this rung wraps those symbols in the labelled envelope a real key or certificate carries, so a keeper can read what
//! a block holds at a glance and a parser can find exactly the bytes between the markers. base64.rye's own front door already names PEM as
//! its purpose; this rung seats that armor in our own Rye.
//! Design read: active-designing/20260815-175524_rye-first-crypto-parity-and-the-decision-wave.md (the wave that seats the Rye-first spine).
//! Clean-room: the `-----BEGIN/END LABEL-----` framing and the 64-character wrap are RFC 7468's own public convention; the composition is
//! ours, standing on our own parity-GREEN Base64 primitive (.claude/rules/gratitude-licenses.md).
//!
//! THE CRUX — encode writes `-----BEGIN <label>-----`, then the Base64 of the payload broken into lines of at most 64 characters each ended
//! by a newline, then `-----END <label>-----`. decode inverts it: locate the BEGIN and END markers for the requested label, gather every
//! Base64 character between them (skipping the line-wrap whitespace), and Base64-decode the gathered body — refusing BadLabel when a marker
//! is absent or names a different label, so a block is never decoded as something it does not claim to be. No new base conversion: the Base64
//! beneath is already proven on metal.
//!
//! HONEST SCOPE — software only, purely LOCAL, no key, no network, no funds, no real device. The primitive calls no std codec: the rendering
//! is encoding/base64.rye (RFC 4648, parity-GREEN against std.base64). Parity is proven at selftest against a reproducible RFC-4648-anchored
//! known-answer (the block wrapping "foobar" is exactly `-----BEGIN GRAIN TEST-----` ‖ `Zm9vYmFy` ‖ `-----END GRAIN TEST-----`, since
//! "Zm9vYmFy" is RFC 4648 §10's published Base64 of "foobar"), a round-trip across payload lengths that exercises the 64-character wrap, a
//! second independent deframer, and the label and buffer guards.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run encoding/pem.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const base64 = @import("base64.rye");

pub const pem_version = "20260816.010000";

/// RFC 7468 wraps the Base64 body so each line carries at most 64 characters. Named so every line-copy loop cites the ceiling it fills to.
pub const line_width: u32 = 64;

/// The largest binary payload this module frames, and the largest a decode produces — inherited from the Base64 primitive beneath so the
/// rendering always fits. Generous for a key, a certificate, or a signed carry.
pub const max_der_bytes: u32 = base64.max_decoded_bytes;

/// The longest label this module frames — "CERTIFICATE", "PUBLIC KEY", "ED25519 PRIVATE KEY" and their kin all fit well within this.
pub const max_label_len: u32 = 64;

const begin_prefix = "-----BEGIN ";
const end_prefix = "-----END ";
const marker_suffix = "-----";
const eol: u8 = '\n';

/// The faults this module can raise, each refused at the edge before a partial result escapes.
pub const PemError = error{
    /// A payload larger than max_der_bytes, or a label longer than max_label_len — refused before a byte is written.
    BadLength,
    /// The caller's destination buffer is smaller than the exact output length — refused before the first write.
    DestTooSmall,
    /// A decode input carrying a Base64 character outside the alphabet, or a malformed Base64 body — surfaced from the primitive beneath.
    BadChar,
    /// A decode input missing the `-----BEGIN <label>-----` or `-----END <label>-----` marker for the requested label — a block that does
    /// not claim to hold what the caller asked for is refused rather than decoded as something else.
    BadLabel,
};

/// The exact number of newline-ended wrap lines the Base64 body of b64_len symbols occupies: one line per 64 symbols, the last line holding
/// the remainder. A zero-length body still emits no body lines. Named so encode can size its output before the first write.
fn wrap_lines(b64_len: u32) u32 {
    // invariant: the wrap width is the RFC 7468 ceiling, never zero, so the division is well-formed.
    assert(line_width > 0);
    return (b64_len + line_width - 1) / line_width;
}

fn slice_eq(a: []const u8, b: []const u8) bool {
    if (a.len != b.len) return false;
    var i: u32 = 0;
    while (i < a.len) : (i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

/// Copy src into dest starting at off, returning the new offset. A tiny bounded helper so encode reads as a sequence of appends; every
/// caller has already checked dest is large enough for the whole block.
fn append(dest: []u8, off: u32, src: []const u8) u32 {
    // invariant: the append stays within the destination the caller sized.
    assert(off + src.len <= dest.len);
    var i: u32 = 0;
    while (i < src.len) : (i += 1) dest[off + i] = src[i];
    // invariant: exactly src.len bytes advanced the offset.
    assert(i == src.len);
    return off + @as(u32, @intCast(src.len));
}

/// Write the marker line `prefix ‖ label ‖ "-----" ‖ eol` into a small caller buffer, returning the written slice. Used for both the BEGIN
/// and END lines on encode, and to build the tokens decode searches for.
fn marker_line(buf: []u8, prefix: []const u8, label: []const u8, with_eol: bool) []const u8 {
    // invariant: the label fits the named bound, so the marker fits any buffer sized for prefix + max label + suffix + eol.
    assert(label.len <= max_label_len);
    var off: u32 = 0;
    off = append(buf, off, prefix);
    off = append(buf, off, label);
    off = append(buf, off, marker_suffix);
    if (with_eol) {
        buf[off] = eol;
        off += 1;
    }
    return buf[0..off];
}

/// Encode payload as a PEM block with the given label into dest, returning the exact written slice. Composes the standard-Base64 rendering,
/// wrapping the body at 64 characters a line and framing it with the RFC 7468 BEGIN/END markers — no new base arithmetic.
pub fn encode(dest: []u8, label: []const u8, payload: []const u8) PemError![]const u8 {
    if (payload.len > max_der_bytes) return error.BadLength;
    if (label.len > max_label_len) return error.BadLength;
    const plen: u32 = @intCast(payload.len);
    // invariant: the bounded cast named exactly the payload bytes.
    assert(plen == payload.len);

    // Render the whole payload to standard Base64 once, into a bounded scratch, then wrap it line by line into dest.
    var body: [base64.max_encoded_bytes]u8 = undefined;
    const b64 = base64.encode(&body, payload) catch |err| switch (err) {
        error.TooLong => return error.BadLength,
        error.DestTooSmall => return error.BadLength,
        error.BadChar => return error.BadChar,
        error.BadLength => return error.BadLength,
    };
    const b64_len: u32 = @intCast(b64.len);
    // invariant: the bounded cast named exactly the Base64 length.
    assert(b64_len == b64.len);

    // Size the exact output: BEGIN line, one newline per wrap line plus the body symbols, END line. Each marker line is prefix ‖ label ‖
    // "-----" ‖ eol.
    const label_len: u32 = @intCast(label.len);
    const begin_line: u32 = @as(u32, begin_prefix.len) + label_len + @as(u32, marker_suffix.len) + 1;
    const end_line: u32 = @as(u32, end_prefix.len) + label_len + @as(u32, marker_suffix.len) + 1;
    const want: u32 = begin_line + b64_len + wrap_lines(b64_len) + end_line;
    if (dest.len < want) return error.DestTooSmall;

    var off: u32 = 0;
    var line: [begin_prefix.len + max_label_len + marker_suffix.len + 1]u8 = undefined;
    off = append(dest, off, marker_line(&line, begin_prefix, label, true));

    // Wrap: copy at most line_width Base64 symbols, end each line with a newline.
    var si: u32 = 0;
    while (si < b64_len) {
        const remaining = b64_len - si;
        const take = if (remaining < line_width) remaining else line_width;
        off = append(dest, off, b64[si .. si + take]);
        dest[off] = eol;
        off += 1;
        si += take;
    }
    // invariant: every Base64 symbol was placed on some wrap line.
    assert(si == b64_len);

    off = append(dest, off, marker_line(&line, end_prefix, label, true));
    // invariant: exactly the predicted block length was written.
    assert(off == want);
    return dest[0..off];
}

/// Find the first index at which needle occurs in haystack, or null. A small bounded substring scan so decode can locate its markers.
fn index_of(haystack: []const u8, needle: []const u8) ?u32 {
    if (needle.len == 0 or needle.len > haystack.len) return null;
    const last = haystack.len - needle.len;
    var i: u32 = 0;
    // invariant: the search never reads past the last position a full needle can start at.
    assert(last < haystack.len or haystack.len == needle.len);
    while (i <= last) : (i += 1) {
        if (slice_eq(haystack[i .. i + needle.len], needle)) return i;
    }
    return null;
}

/// True when c is one of the line-wrap whitespace bytes RFC 7468 allows between Base64 symbols — space, tab, carriage return, or newline.
fn is_wrap_space(c: u8) bool {
    return c == ' ' or c == '\t' or c == '\r' or c == eol;
}

/// Decode a PEM block bearing the requested label from source into dest, returning the exact payload bytes. Locates the BEGIN and END
/// markers, gathers the Base64 body between them (skipping the wrap whitespace), and Base64-decodes it — refusing BadLabel when the block
/// does not claim the requested label, so bytes are never returned from a block of the wrong kind.
pub fn decode(dest: []u8, source: []const u8, label: []const u8) PemError![]const u8 {
    if (label.len > max_label_len) return error.BadLength;

    // Build the exact marker tokens (no trailing eol — the markers may be followed by CRLF or LF) and locate them in source.
    var begin_tok: [begin_prefix.len + max_label_len + marker_suffix.len]u8 = undefined;
    var end_tok: [end_prefix.len + max_label_len + marker_suffix.len]u8 = undefined;
    const begin = marker_line(&begin_tok, begin_prefix, label, false);
    const end = marker_line(&end_tok, end_prefix, label, false);

    const begin_at = index_of(source, begin) orelse return error.BadLabel;
    const body_start = begin_at + @as(u32, @intCast(begin.len));
    // invariant: the body begins after the whole BEGIN marker.
    assert(body_start <= source.len);
    if (body_start > source.len) return error.BadLabel;

    const rest = source[body_start..];
    const end_rel = index_of(rest, end) orelse return error.BadLabel;

    // Gather the Base64 body, skipping every wrap-whitespace byte, into a bounded scratch.
    var gathered: [base64.max_encoded_bytes]u8 = undefined;
    var gi: u32 = 0;
    var i: u32 = 0;
    // invariant: gathering stops at the END marker and never overruns the Base64 scratch.
    assert(end_rel <= rest.len);
    while (i < end_rel) : (i += 1) {
        const c = rest[i];
        if (is_wrap_space(c)) continue;
        if (gi >= gathered.len) return error.BadLength;
        gathered[gi] = c;
        gi += 1;
    }

    return base64.decode(dest, gathered[0..gi]) catch |err| switch (err) {
        error.TooLong => error.BadLength,
        error.DestTooSmall => error.DestTooSmall,
        error.BadChar => error.BadChar,
        error.BadLength => error.BadChar,
    };
}

// The reproducible RFC-4648-anchored known-answer: the Base64 of "foobar" is "Zm9vYmFy" (RFC 4648 §10), so the PEM block wrapping "foobar"
// under the label "GRAIN TEST" is exactly the three lines below — a neutral reference any reader reproduces from the published Base64 vector
// and RFC 7468's literal markers.
const kat_label = "GRAIN TEST";
const kat_payload = "foobar";
const kat_block = "-----BEGIN GRAIN TEST-----\nZm9vYmFy\n-----END GRAIN TEST-----\n";

/// Independent deframer used ONLY inside the selftest: split the block on newlines, drop the first line (BEGIN) and every line that opens the
/// END marker, and concatenate the interior lines into out — so the block's framing is checked by a second, separate reader rather than by
/// the same code that wrote it. Returns the recovered Base64 body.
fn ref_body(block: []const u8, out: []u8) []const u8 {
    // invariant: the scratch is large enough to hold the whole block, which bounds the body it recovers.
    assert(out.len >= block.len);
    var oi: u32 = 0;
    var line_start: u32 = 0;
    var idx: u32 = 0;
    var i: u32 = 0;
    while (i <= block.len) : (i += 1) {
        if (i == block.len or block[i] == eol) {
            const line = block[line_start..i];
            // Keep only interior lines: not the first (idx 0, the BEGIN marker) and not any line starting the END marker.
            const is_end = line.len >= end_prefix.len and slice_eq(line[0..end_prefix.len], end_prefix);
            if (idx >= 1 and !is_end) {
                var j: u32 = 0;
                while (j < line.len) : (j += 1) {
                    out[oi] = line[j];
                    oi += 1;
                }
            }
            idx += 1;
            line_start = i + 1;
        }
    }
    return out[0..oi];
}

fn run_selftest() !u8 {
    var ebuf: [512]u8 = undefined;
    var dbuf: [512]u8 = undefined;

    // 1. The reproducible known-answer: "foobar" under label "GRAIN TEST" encodes to the exact three-line block, and that block decodes
    //    back to "foobar".
    {
        const got = try encode(&ebuf, kat_label, kat_payload);
        if (!slice_eq(got, kat_block)) return error.KatBlockMismatch;

        const back = try decode(&dbuf, kat_block, kat_label);
        if (!slice_eq(back, kat_payload)) return error.KatRoundtripMismatch;
    }

    // 2. Round-trip across payload lengths, exercising the 64-character wrap: every payload 0..96 bytes encodes to a block whose body lines
    //    are each at most 64 characters, and decodes back exactly. A second independent deframer recovers the same Base64 body.
    {
        var payload: [96]u8 = undefined;
        var n: u32 = 0;
        while (n <= 96) : (n += 1) {
            var j: u32 = 0;
            while (j < n) : (j += 1) payload[j] = @as(u8, @truncate(j *% 37 +% 11));

            var enc: [512]u8 = undefined;
            const block = try encode(&enc, "GRAIN DATA", payload[0..n]);

            // Every body line (between the two markers) is at most line_width characters.
            var li: u32 = 0;
            var col: u32 = 0;
            var line_idx: u32 = 0;
            while (li < block.len) : (li += 1) {
                if (block[li] == eol) {
                    line_idx += 1;
                    col = 0;
                } else {
                    col += 1;
                    // line_idx 0 is BEGIN, the last is END; interior lines carry the body and must not exceed the wrap width.
                    if (line_idx >= 1 and col > line_width) return error.WrapTooWide;
                }
            }

            var dec: [128]u8 = undefined;
            const body = try decode(&dec, block, "GRAIN DATA");
            if (!slice_eq(body, payload[0..n])) return error.RoundtripMismatch;

            // A second, independent deframer recovers the same Base64 body, and Base64-decoding it returns the same payload — the framing
            // is checked by a reader that never shares code with encode.
            var refbuf: [512]u8 = undefined;
            const rb = ref_body(block, &refbuf);
            var refdec: [128]u8 = undefined;
            const ref_payload = base64.decode(&refdec, rb) catch return error.RefDeframeMismatch;
            if (!slice_eq(ref_payload, payload[0..n])) return error.RefDeframeMismatch;
        }
    }

    // 3. The label and buffer guards: decoding with the wrong label refuses BadLabel; a body carrying a non-Base64 character refuses
    //    BadChar; a too-small destination refuses DestTooSmall — each before a partial result escapes.
    {
        var junk: [64]u8 = undefined;
        if (decode(&junk, kat_block, "OTHER LABEL")) |_| return error.LabelSlipped else |err| if (err != error.BadLabel) return error.WrongBadLabel;

        const bad_block = "-----BEGIN GRAIN TEST-----\nZm9v*mFy\n-----END GRAIN TEST-----\n";
        if (decode(&junk, bad_block, kat_label)) |_| return error.BadCharSlipped else |err| if (err != error.BadChar) return error.WrongBadChar;

        var tiny: [2]u8 = undefined;
        if (decode(&tiny, kat_block, kat_label)) |_| return error.DestSlipped else |err| if (err != error.DestTooSmall) return error.WrongDest;
    }

    print("GREEN encoding-pem: PEM (RFC 7468) authored in pure Rye as a composition — the labelled armor a key, certificate, or signed carry " ++
        "wears as text: a -----BEGIN LABEL----- line, the payload in standard Base64 wrapped at 64 characters a line, and a -----END LABEL----- " ++
        "line to close it. encode composes the GREEN encoding/base64.rye and adds only the framing and the wrap; decode locates the markers for " ++
        "the requested label, gathers the Base64 between them (skipping the wrap whitespace), and decodes it — refusing BadLabel when the block " ++
        "does not claim the requested label, so bytes are never returned from a block of the wrong kind. No new base arithmetic: the Base64 " ++
        "beneath is parity-GREEN against std.base64. Parity holds against the reproducible RFC-4648-anchored known-answer (\"foobar\" under " ++
        "\"GRAIN TEST\" → the exact three-line block, its body the published Zm9vYmFy) matching character for character and round-tripping back, " ++
        "a round-trip across payloads 0..96 bytes whose body lines never exceed 64 characters, recovered by a second independent deframer; a " ++
        "wrong label refuses BadLabel, a bad character BadChar, a too-small destination DestTooSmall — each before a partial result escapes. " ++
        "Purely local — no key, no network, no funds, no real device. The armor a key wears now stands in our own Rye, composing the Season G " ++
        "encoding stack.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    _ = init;
    return run_selftest();
}
