# seat_nakshatra_witness.rish -- the private seat -> nakshatra tool.
#
# Lives in the silo (classical-vedic-astrology/, withheld from the public seed), beside
# the tool it proves, so no broken witness ever ships in the OS template. Proves a
# point's public d27 seat names its nakshatra outfit from the roster.
#
# Build first (the vendored toolchain):
#   ln -sf ../comlink/topology.rye classical-vedic-astrology/topology.rye
#   mkdir -p classical-vedic-astrology/bin
#   RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye build classical-vedic-astrology/seat_nakshatra.rye -femit-bin=classical-vedic-astrology/bin/seat_nakshatra
#   rishi/bin/rishi run classical-vedic-astrology/seat_nakshatra_witness.rish

# The tool's own selftest -- first/last mansions, past-universe none, the example seat.
let st = run ["classical-vedic-astrology/bin/seat_nakshatra" "selftest"]
assert st.ok else "seat_nakshatra selftest must exit 0"
assert (st.err contains "GREEN") else "selftest must report GREEN"
assert (st.err contains "point 0 wears Ashvini") else "the first point must wear the first mansion"

# A named point resolves to its seat and nakshatra.
let p = run ["classical-vedic-astrology/bin/seat_nakshatra" "267"]
assert p.ok else "seat_nakshatra must resolve a point"
assert (p.out contains "seat 23") else "point 267 sits in seat 23"
assert (p.out contains "nakshatra Shatabhishak") else "point 267 wears Shatabhishak"

say "GREEN: seat nakshatra witness -- a point's public d27 seat named as its nakshatra outfit."
