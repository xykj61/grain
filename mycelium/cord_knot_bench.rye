//! mycelium/cord_knot_bench.rye -- checkpointing is a genuine bound win, measured honestly.
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - checkpointing - rung r3 -- the measured bound win.
//! Design read: active-designing/date/20260813/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
//!
//! r1 proved a checkpoint folds identical to the whole history; r2 let it travel.
//! r3 measures what the Knot buys: the Cord's Dag is statically allocated
//! (cord.cord_max_blocks = 256), so a history longer than that ceiling cannot live
//! in one Dag at all -- and this rung proves it (a fresh Dag filled to the ceiling
//! refuses the next block DagFull). Yet checkpoint-and-prune folds a history past
//! the ceiling while the LIVE Dag never exceeds one bounded window, reaching the
//! byte-identical supply as folding the whole history from empty.
//!
//! Two Rooms honesty: the module ASSERTS only what it proves exactly -- the ceiling
//! refuses, the final supply equals the whole-history fold, the live Dag stays at
//! the window -- and REPORTS the amortization as a measured `loom` observation
//! (blocks a un-checkpointed run would need vs blocks the live Dag ever holds),
//! never an asserted invariant. A wall-time benchmark stays a named later round.
//!
//! Composes cord.rye + fold.rye + cord_knot.rye public API only. Siloed, dev-only,
//! demo seeds -- no key, funds, network, or custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/cord_knot_bench.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");
const cord = @import("cord.rye");
const cord_knot = @import("cord_knot.rye");

/// The static Dag ceiling the Knot lifts -- a history past it cannot live in one Dag.
const dag_ceiling: u32 = cord.cord_max_blocks;

/// Blocks per epoch before a Knot ties the epoch off and the Dag is pruned -- the
/// live-Dag window, chosen well under the ceiling so the win is visible.
const window: u32 = 64;

/// Epochs in the measured run -- five windows of 64 carry 320 facts, past the 256
/// ceiling, so an un-checkpointed run provably could not represent this history.
const windows: u32 = 5;

/// The whole history's fact count -- window * windows.
const total_facts: u32 = window * windows;

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// A distinct issue fact for index `i` -- amount 1, a unique body so every fact
/// (and thus every single-fact block over it) is distinct.
fn issue_i(k: kumara.KeyPair, i: u32) !fold.Fact {
    var body: [16]u8 = undefined;
    const b = std.fmt.bufPrint(&body, "f{d}", .{i}) catch return error.BodyTooLong;
    return fold.mint_fact(k, fold.kind_issue, 1, "", b) orelse error.MintFact;
}

/// Commit a Dag and flatten its committed facts into a log ready to continue.
fn dag_log(dag: *const cord.Dag) fold.Log {
    var order: [cord.cord_max_blocks]u32 = undefined;
    const count = cord.commit(dag, order[0..]);
    var log = fold.Log.empty();
    cord.committed_log(dag, order[0..], count, &log);
    return log;
}

pub fn main() !void {
    const k = seeded(0x5A);

    // invariant: the run genuinely exceeds the static ceiling -- else it proves
    // nothing about a history a single Dag cannot hold.
    assert(total_facts > dag_ceiling);

    // Ground truth: the whole history folded from empty (no Dag), for the exact
    // supply the checkpoint chain must match.
    var ground = fold.FoldState{};
    var g: u32 = 0;
    while (g < total_facts) : (g += 1) {
        const f = try issue_i(k, g);
        try fold.fold_fact(&ground, &f);
    }
    if (ground.issued != total_facts) return error.GroundSupply;

    // The ceiling is real: fill a fresh Dag to cord_max_blocks (distinct rounds
    // over one fact), and the next block refuses DagFull -- a history past the
    // ceiling cannot live in one Dag.
    const f0 = try issue_i(k, 0);
    var one = cord.Dag.empty();
    var r: u32 = 0;
    while (r < dag_ceiling) : (r += 1) {
        const blk = cord.mint_block(k, r, &[_][cord.hash_len]u8{}, f0) orelse return error.MintCeiling;
        try cord.add(&one, blk);
    }
    if (one.len != dag_ceiling) return error.CeilingCount;
    const extra = cord.mint_block(k, 0, &[_][cord.hash_len]u8{}, f0) orelse return error.MintExtra;
    if (cord.add(&one, extra)) |_| {
        return error.CeilingNotEnforced;
    } else |err| {
        if (err != error.DagFull) return error.WrongCeiling;
    }

    // The checkpoint chain: each epoch is a bounded Cord Dag of `window` blocks,
    // sealed to a Knot and pruned; the next epoch continues onto the Knot. The
    // live Dag never exceeds the window, yet the chain folds the whole history.
    var knot = cord_knot.seal(fold.FoldState{});
    var max_live: u32 = 0;
    var w: u32 = 0;
    while (w < windows) : (w += 1) {
        var dag = cord.Dag.empty();
        var j: u32 = 0;
        while (j < window) : (j += 1) {
            const idx = w * window + j;
            const f = try issue_i(k, idx);
            const blk = cord.mint_block(k, j, &[_][cord.hash_len]u8{}, f) orelse return error.MintWindow;
            try cord.add(&dag, blk);
        }
        if (dag.len > max_live) max_live = dag.len;
        const wlog = dag_log(&dag);
        const state = try cord_knot.continue_verified(&knot, &wlog);
        knot = cord_knot.seal(state);
        // the epoch Dag falls out of scope here -- pruned; only the Knot carries on.
    }

    // invariant: the checkpoint chain reaches the exact whole-history supply.
    if (!cord_knot.states_match(&ground, &knot.state)) return error.ChainMismatch;
    // invariant: the live Dag stayed within one window, never near the ceiling.
    if (max_live != window) return error.LiveWindow;
    if (max_live >= dag_ceiling) return error.LiveOverflow;

    // Two Rooms: the win is structural. An un-checkpointed run would need one live
    // block per fact (total_facts, past the ceiling); the checkpoint chain holds at
    // most `window`. Reported as a measured observation, asserted nowhere.
    const live_ratio_x10 = total_facts * 10 / max_live;
    print("cord-knot-bench: a fresh Dag filled to the ceiling ({d}) refuses the next block DagFull\n", .{dag_ceiling});
    print("cord-knot-bench: the checkpoint chain folds {d} facts to the whole-history supply while the live Dag holds at most {d}\n", .{ total_facts, max_live });
    print("loom bench=cord_knot total_facts={d} dag_ceiling={d} max_live_blocks={d} windows={d} live_ratio_x10={d} would_overflow=yes\n", .{
        total_facts, dag_ceiling, max_live, windows, live_ratio_x10,
    });
    print("GREEN: myc cord-knot-bench — a bounded Dag runs past its {d}-block ceiling by checkpointing · supply={d} · live<= {d}\n", .{
        dag_ceiling,
        knot.state.supply(),
        max_live,
    });
}
