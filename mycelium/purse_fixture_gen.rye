//! mycelium/purse_fixture_gen.rye — reproducibly emit a per-account double-spend Cord dev-net fixture (r4 support).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · the per-account double-spend · rung r4 support.
//! Design read: active-designing/date/20260813/20260813-073500_mycelium-purse-true-real-fixture-exploration.md
//!
//! Seats a real four-block scene carrying a genuine per-account double-spend — one holder
//! spending the same coins twice. A demo funder issues a genesis credit of 100 to Alice;
//! Alice transfers that 100 to Bob at round 1 (the winning move); Bob transfers 40 onward
//! to Dan at round 2 (an uncontested move, so two transfers move coins, not one); and Alice
//! signs a second transfer of 100 to Carol at round 2, referencing the winner. Alice's purse
//! emptied at round 1, so her second transfer comes up short — a lawful no-op (she once held
//! the hundred). The losing transfer is unambiguously the round-2 one, and the two moves that
//! pay touch disjoint accounts, so a keeper (or an awk) can name the spent-out signer by
//! walking the block lines in file order — the same holder the Purse's full commit tie-break
//! names. Committing and rendering to a `format cord-dag-v1` record gives the exact bytes
//! `mycelium/purse_true.rye` reads back and the r4 witness cross-checks against an independent
//! awk reading.
//!
//! Deterministic: seeded demo keys and a pure commit mean the same bytes every run, so the
//! on-disk fixture is what the Cord emits, never a hand-mock. Emitted on stderr (hosted
//! `print` is `std.debug.print`), so capture with `2>`.
//!
//! Siloed, dev-only, demo seeds — no real key, no funds, no network, no custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/purse_fixture_gen.rye \
//!     2> tools/fixtures/purse_dag.bron
//!
//! Kin: mycelium/till_fixture_gen.rye (the treasury sibling), mycelium/tenure_fixture_gen.rye (the name-contest sibling).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_bron = @import("cord_bron.rye");
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// Seat the per-account double-spend four-block Dag — genesis credits Alice 100; Alice → Bob 100
/// wins at round 1; Bob → Dan 40 moves uncontested at round 2; Alice → Carol 100 comes up short at
/// round 2, her purse already emptied by the winning transfer.
fn seat_dag() !cord.Dag {
    const kf = seeded(0xF0); // demo funder / genesis credit authority
    const ka = seeded(0xA1); // Alice — the double-spender
    const kb = seeded(0xB2); // Bob — the winning recipient, then an onward sender
    const kc = seeded(0xC3); // Carol — the losing recipient (paid nothing)
    const kd = seeded(0xD4); // Dan — Bob's onward recipient

    const alice_pk = ka.public_key.toBytes();
    const bob_pk = kb.public_key.toBytes();
    const carol_pk = kc.public_key.toBytes();
    const dan_pk = kd.public_key.toBytes();

    // A genesis credit's body names the account to fund; a transfer's body names the recipient.
    const f_gen = fold.mint_fact(kf, fold.kind_issue, 100, "", alice_pk[0..]) orelse return error.MintGen;
    const f_bob = fold.mint_fact(ka, fold.kind_tax, 100, "", bob_pk[0..]) orelse return error.MintBob;
    const f_dan = fold.mint_fact(kb, fold.kind_tax, 40, "", dan_pk[0..]) orelse return error.MintDan;
    const f_carol = fold.mint_fact(ka, fold.kind_tax, 100, "", carol_pk[0..]) orelse return error.MintCarol;

    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const roots = [_][cord.hash_len]u8{hg};

    // Alice's winning transfer at round 1 references the genesis.
    const wb = cord.mint_block(ka, 1, roots[0..], f_bob) orelse return error.BlockWb;
    var hwb: [cord.hash_len]u8 = undefined;
    cord.address(&wb, &hwb);
    const roots2 = [_][cord.hash_len]u8{hwb};

    // Both round-2 transfers reference the winner, so the loss is unambiguously the later round.
    const wd = cord.mint_block(kb, 2, roots2[0..], f_dan) orelse return error.BlockWd;
    const wc = cord.mint_block(ka, 2, roots2[0..], f_carol) orelse return error.BlockWc;

    var dag = cord.Dag.empty();
    try cord.add(&dag, g);
    try cord.add(&dag, wb);
    try cord.add(&dag, wd);
    try cord.add(&dag, wc);
    return dag;
}

pub fn main() !void {
    var dag = try seat_dag();
    const pl = try cord_bron.from_dag(&dag);
    var buf: [cord_bron.max_record]u8 = undefined;
    const n = try cord_bron.render(&pl, &buf);
    // invariant: the render is bounded and non-empty — a real record carries its header.
    assert(n > 0);
    assert(n <= cord_bron.max_record);
    print("{s}", .{buf[0..n]});
}
