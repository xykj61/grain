//! mycelium/cord_knot.rye — the Knot: a bounded Cord ties off its committed past.
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · checkpointing · rung r1 — the crux.
//! Design read: active-designing/date/20260813/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
//!
//! The Cord's Dag is statically allocated (cord.cord_max_blocks = 256) — a
//! feature, exactly TigerBeetle's discipline: a consensus that cannot fail by
//! running out of memory under load. Yet a bound reached is a mesh that stops. A
//! ledger meant to run for years cannot hold every block it ever saw in one fixed
//! array. From TigerBeetle comes the checkpointing insight: fold the committed
//! past into a summary, prune it, continue from the summary as if from genesis.
//! Clean-room — TigerBeetle is studied, never copied.
//!
//! Grown BESIDE the elder, never over it: cord.rye and fold.rye stay green
//! binaries; this composes their public API only. A `Knot` seals a committed
//! Cord's `fold.FoldState` (issued · taxed · every reserved star) under a SHA-256
//! digest. It carries no signature — a Knot is a deterministic function of the
//! committed Dag, so any node folds the identical Knot; its digest is
//! integrity-in-travel, never authority. Kumara still signs each fact, the Cord
//! still orders the blocks, the fold still decides the supply — the Knot only lets
//! the first two be pruned once the third has summed them.
//!
//! The crux: folding new facts onto a sealed Knot yields the byte-identical supply
//! as folding the whole history from empty, and every fold invariant
//! (non-negative supply · star-uniqueness · each fact's own signature) holds
//! across the cut — so a node may discard every block before the Knot and keep
//! only the Knot plus its live Dag, bounded forever.
//!
//! Siloed, dev-only, demo seeds — no real key, no funds, no network, no custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/cord_knot.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");
const cord = @import("cord.rye");

const Sha256 = std.crypto.hash.sha2.Sha256;

/// The digest that seals a Knot — SHA-256 over the state's canonical bytes.
pub const knot_digest_len: u32 = 32;

/// A Knot is the folded supply at a committed cut, sealed so it can travel and be
/// checked. The state carries the whole agreed supply and nothing more; the
/// digest binds it against silent corruption in travel.
pub const Knot = struct {
    state: fold.FoldState = .{},
    digest: [knot_digest_len]u8 = undefined,
};

/// Update a running hash with a u64, little-endian — the elder Cord's own manual
/// encoding, so a Knot's canonical bytes are as legible as a block's.
fn put_u64(h: *Sha256, v: u64) void {
    var b: [8]u8 = undefined;
    var x = v;
    var i: u32 = 0;
    // invariant: exactly eight little-endian bytes cover a u64.
    assert(b.len == 8);
    while (i < 8) : (i += 1) {
        b[i] = @truncate(x);
        x >>= 8;
    }
    // invariant: the whole width was consumed, no high bits left unhashed.
    assert(x == 0);
    h.update(&b);
}

/// Update a running hash with a u32, little-endian.
fn put_u32(h: *Sha256, v: u32) void {
    var b: [4]u8 = undefined;
    var x = v;
    var i: u32 = 0;
    // invariant: exactly four little-endian bytes cover a u32.
    assert(b.len == 4);
    while (i < 4) : (i += 1) {
        b[i] = @truncate(x);
        x >>= 8;
    }
    // invariant: the whole width was consumed.
    assert(x == 0);
    h.update(&b);
}

/// The Knot's canonical digest: issued · taxed · star_count, then each reserved
/// star's length and name, streamed so no giant buffer is needed for a state that
/// may hold up to fold.myc_log_max_facts stars.
fn knot_digest(state: *const fold.FoldState, out: *[knot_digest_len]u8) void {
    // invariant: a real fold state never taxes past what it issued.
    assert(state.taxed <= state.issued);
    // invariant: the star set stays within the fold's own named bound.
    assert(state.star_count <= fold.myc_log_max_facts);
    var h = Sha256.init(.{});
    put_u64(&h, state.issued);
    put_u64(&h, state.taxed);
    put_u32(&h, state.star_count);
    var i: u32 = 0;
    while (i < state.star_count) : (i += 1) {
        const len = state.star_lens[i];
        // invariant: every star name fits the fold's per-name ceiling.
        assert(len <= fold.star_name_max_bytes);
        put_u32(&h, len);
        h.update(state.stars[i][0..len]);
    }
    h.final(out);
}

/// Seal a folded supply into a Knot — the deterministic checkpoint of a committed
/// history. A freshly sealed Knot always verifies.
pub fn seal(state: fold.FoldState) Knot {
    // invariant: only a lawful fold state may be sealed.
    assert(state.taxed <= state.issued);
    // invariant: the star set is bounded before it is hashed.
    assert(state.star_count <= fold.myc_log_max_facts);
    var k = Knot{ .state = state };
    knot_digest(&k.state, &k.digest);
    // invariant: the seal is self-consistent the instant it is made.
    assert(verify(&k));
    return k;
}

/// True when the Knot's digest matches its sealed state — a Knot that traveled and
/// was corrupted fails here before a single grain of it is trusted.
pub fn verify(k: *const Knot) bool {
    // invariant: a Knot's state is always a lawful fold state.
    assert(k.state.taxed <= k.state.issued);
    // invariant: the sealed star set stays within the fold's bound.
    assert(k.state.star_count <= fold.myc_log_max_facts);
    var d: [knot_digest_len]u8 = undefined;
    knot_digest(&k.state, &d);
    return std.mem.eql(u8, d[0..], k.digest[0..]);
}

/// Seal a committed Cord Dag to a Knot — commit the mesh to one order, flatten the
/// committed facts, fold them by the real Mycelium law, and tie off the result.
pub fn seal_dag(dag: *const cord.Dag) error{
    IdentityRefused,
    UnknownKind,
    Overdraw,
    StarTaken,
    LogFull,
}!Knot {
    // invariant: the Dag holds no more blocks than the static bound admits.
    assert(dag.len <= cord.cord_max_blocks);
    var order: [cord.cord_max_blocks]u32 = undefined;
    const count = cord.commit(dag, order[0..]);
    // invariant: the committed count never exceeds the blocks held.
    assert(count <= dag.len);
    var log = fold.Log.empty();
    cord.committed_log(dag, order[0..], count, &log);
    const state = try fold.fold_log(&log);
    return seal(state);
}

/// Continue folding a next-epoch log onto a verified Knot. The Knot's supply is
/// the real starting supply, so overdraw and star-uniqueness are enforced across
/// the cut exactly as within one unbroken fold; each fact re-verifies its own
/// signer. A corrupted Knot refuses before any fact is folded.
pub fn continue_verified(k: *const Knot, suffix: *const fold.Log) error{
    KnotCorrupt,
    IdentityRefused,
    UnknownKind,
    Overdraw,
    StarTaken,
    LogFull,
}!fold.FoldState {
    // invariant: the suffix log stays within the fold's own log bound.
    assert(suffix.len <= fold.myc_log_max_facts);
    // invariant: the Knot's sealed state is lawful before it seeds the fold.
    assert(k.state.taxed <= k.state.issued);
    if (!verify(k)) return error.KnotCorrupt;
    var s = k.state;
    var i: u32 = 0;
    while (i < suffix.len) : (i += 1) {
        try fold.fold_fact(&s, &suffix.facts[i]);
    }
    // invariant: the continued supply is still lawful past the cut.
    assert(s.taxed <= s.issued);
    return s;
}

/// True when a name is among a state's reserved stars.
fn star_present(state: *const fold.FoldState, name: []const u8) bool {
    // invariant: the star set is bounded before the walk.
    assert(state.star_count <= fold.myc_log_max_facts);
    // invariant: no star name outruns the per-name ceiling.
    assert(name.len <= fold.star_name_max_bytes);
    var i: u32 = 0;
    while (i < state.star_count) : (i += 1) {
        const len = state.star_lens[i];
        if (std.mem.eql(u8, state.stars[i][0..len], name)) return true;
    }
    return false;
}

/// Deep supply equality: issued, taxed, and the whole reserved-star set (names are
/// unique, so equal count plus every one of x's stars present in y is set
/// equality). This is the crux's assertion — a continued fold matches a whole one.
pub fn states_match(x: *const fold.FoldState, y: *const fold.FoldState) bool {
    // invariant: both star sets are bounded before comparison.
    assert(x.star_count <= fold.myc_log_max_facts);
    assert(y.star_count <= fold.myc_log_max_facts);
    if (x.issued != y.issued) return false;
    if (x.taxed != y.taxed) return false;
    if (x.star_count != y.star_count) return false;
    var i: u32 = 0;
    while (i < x.star_count) : (i += 1) {
        const len = x.star_lens[i];
        if (!star_present(y, x.stars[i][0..len])) return false;
    }
    return true;
}

// --- demo history, dev-only, deterministic seeds ---------------------------

const Facts = struct { fa: fold.Fact, fb: fold.Fact, fc: fold.Fact, fd: fold.Fact };

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

fn make_facts() !Facts {
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const kc = seeded(0xC3);
    const kd = seeded(0xD4);
    const fa = fold.mint_fact(ka, fold.kind_issue, 500, "", "genesis-a") orelse return error.MintA;
    const fb = fold.mint_fact(kb, fold.kind_issue, 500, "", "genesis-b") orelse return error.MintB;
    const fc = fold.mint_fact(kc, fold.kind_tax, 200, "", "tax-c") orelse return error.MintC;
    const fd = fold.mint_fact(kd, fold.kind_star_reserve, 100, "vega", "reserve") orelse return error.MintD;
    return .{ .fa = fa, .fb = fb, .fc = fc, .fd = fd };
}

/// Build a Cord Dag over the four facts: a, b as round-0 roots; c, d as round-1
/// children referencing both roots — the same demo history the batching arc folds.
fn full_dag(f: *const Facts) !cord.Dag {
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const kc = seeded(0xC3);
    const kd = seeded(0xD4);
    const a = cord.mint_block(ka, 0, &[_][cord.hash_len]u8{}, f.fa) orelse return error.BlockA;
    const b = cord.mint_block(kb, 0, &[_][cord.hash_len]u8{}, f.fb) orelse return error.BlockB;
    var ha: [cord.hash_len]u8 = undefined;
    var hb: [cord.hash_len]u8 = undefined;
    cord.address(&a, &ha);
    cord.address(&b, &hb);
    const roots = [_][cord.hash_len]u8{ ha, hb };
    const c = cord.mint_block(kc, 1, roots[0..], f.fc) orelse return error.BlockC;
    const d = cord.mint_block(kd, 1, roots[0..], f.fd) orelse return error.BlockD;
    var dag = cord.Dag.empty();
    try cord.add(&dag, a);
    try cord.add(&dag, b);
    try cord.add(&dag, c);
    try cord.add(&dag, d);
    return dag;
}

/// The prefix Dag — just the two genesis issues, the history a node checkpoints
/// before its Dag fills.
fn prefix_dag(f: *const Facts) !cord.Dag {
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const a = cord.mint_block(ka, 0, &[_][cord.hash_len]u8{}, f.fa) orelse return error.BlockA;
    const b = cord.mint_block(kb, 0, &[_][cord.hash_len]u8{}, f.fb) orelse return error.BlockB;
    var dag = cord.Dag.empty();
    try cord.add(&dag, a);
    try cord.add(&dag, b);
    return dag;
}

/// The suffix Dag — a fresh epoch rooted at the Knot: c, d as round-0 roots
/// referencing no pruned block. Committing it flattens the next-epoch facts.
fn suffix_dag(f: *const Facts) !cord.Dag {
    const kc = seeded(0xC3);
    const kd = seeded(0xD4);
    const c = cord.mint_block(kc, 0, &[_][cord.hash_len]u8{}, f.fc) orelse return error.BlockC;
    const d = cord.mint_block(kd, 0, &[_][cord.hash_len]u8{}, f.fd) orelse return error.BlockD;
    var dag = cord.Dag.empty();
    try cord.add(&dag, c);
    try cord.add(&dag, d);
    return dag;
}

/// Commit a Dag and flatten its committed facts into a log ready to fold.
fn dag_log(dag: *const cord.Dag) fold.Log {
    var order: [cord.cord_max_blocks]u32 = undefined;
    const count = cord.commit(dag, order[0..]);
    var log = fold.Log.empty();
    cord.committed_log(dag, order[0..], count, &log);
    return log;
}

pub fn main() !void {
    const f = try make_facts();

    // The whole history folded from empty — the truth the Knot must match.
    var whole = try full_dag(&f);
    const full_state = try fold.fold_log(&dag_log(&whole));
    if (full_state.issued != 1000) return error.SupplyIssued;
    if (full_state.taxed != 300) return error.SupplyTaxed;
    if (full_state.supply() != 700) return error.SupplyNet;
    if (full_state.star_count != 1) return error.StarCount;

    // The crux: checkpoint the prefix, continue the suffix onto the Knot, and the
    // supply is byte-identical to the whole history — the network never notices
    // where the past was tied off.
    var pre = try prefix_dag(&f);
    const knot = try seal_dag(&pre);
    if (knot.state.issued != 1000) return error.KnotIssued;
    if (knot.state.supply() != 1000) return error.KnotSupply;
    var suf = try suffix_dag(&f);
    const suf_log = dag_log(&suf);
    const continued = try continue_verified(&knot, &suf_log);
    if (!states_match(&full_state, &continued)) return error.KnotChangedSupply;

    // Boundary: the Knot at genesis (empty prefix) — continue the whole history
    // onto an empty checkpoint and reach the identical supply.
    const knot_genesis = seal(fold.FoldState{});
    const whole_log = dag_log(&whole);
    const from_genesis = try continue_verified(&knot_genesis, &whole_log);
    if (!states_match(&full_state, &from_genesis)) return error.GenesisMismatch;

    // Boundary: the full prefix (empty suffix) — checkpoint everything, continue
    // nothing, and the Knot already carries the whole supply.
    const knot_all = try seal_dag(&whole);
    const empty_log = fold.Log.empty();
    const from_all = try continue_verified(&knot_all, &empty_log);
    if (!states_match(&full_state, &from_all)) return error.FullPrefixMismatch;

    // Refusal: a Knot corrupted after sealing refuses whole — the digest catches
    // what a silent bit-flip in travel would otherwise hide.
    var knot_bad = knot;
    knot_bad.state.issued += 1;
    if (continue_verified(&knot_bad, &empty_log)) |_| {
        return error.CorruptTrusted;
    } else |err| {
        if (err != error.KnotCorrupt) return error.WrongCorrupt;
    }

    // Refusal across the cut: a suffix tax exceeding the checkpointed supply
    // overdraws — non-negativity holds against the tied-off past.
    const kc = seeded(0xC3);
    const over = fold.mint_fact(kc, fold.kind_tax, 800, "", "over-tax") orelse return error.MintOver;
    // Built raw, not via append_fact: this fact is invalid from empty (a tax with
    // no issue behind it) and lawful only against the checkpointed supply — which
    // is exactly why the Knot must still refuse it when it overdraws that supply.
    var over_log = fold.Log.empty();
    over_log.facts[0] = over;
    over_log.len = 1;
    if (continue_verified(&knot_all, &over_log)) |_| {
        return error.OverdrawCrossed;
    } else |err| {
        if (err != error.Overdraw) return error.WrongOverdraw;
    }

    // Refusal across the cut: a suffix star already sealed in the Knot refuses —
    // star-uniqueness holds across the boundary.
    const kd = seeded(0xD4);
    const dup = fold.mint_fact(kd, fold.kind_star_reserve, 50, "vega", "dup") orelse return error.MintDup;
    var dup_log = fold.Log.empty();
    dup_log.facts[0] = dup;
    dup_log.len = 1;
    if (continue_verified(&knot_all, &dup_log)) |_| {
        return error.StarCrossed;
    } else |err| {
        if (err != error.StarTaken) return error.WrongStar;
    }

    print("cord-knot: a checkpointed prefix continued onto its Knot folds to the whole history's supply\n", .{});
    print("cord-knot: the Knot at genesis and the full-prefix Knot both reach supply {d}, one star\n", .{full_state.supply()});
    print("cord-knot: a corrupted Knot, an overdraw past the cut, and a duplicate star each refuse whole\n", .{});
    print("GREEN: myc cord-knot — knot folds identical to whole · supply={d} · stars={d} · invariants cross the cut\n", .{
        full_state.supply(),
        full_state.star_count,
    });
}
