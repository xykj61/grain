//! mycelium/muster.rye -- the Muster: a known validator set a Chorus must pass (r1, the crux).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - the Muster - rung r1 -- the crux.
//! Design read: active-designing/date/20260813/20260813-110039_mycelium-muster-known-validator-set-exploration.md
//!
//! The Chorus made a position BELIEVABLE by a quorum of distinct independent Vouchers. Yet it counts ANY
//! distinct keys: `verify_chorus(3)` passes the instant three fresh keypairs each sign the claim, and
//! nothing said WHOSE keys those must be. Distinctness proves the voices are different; it cannot prove
//! they are entitled. An attacker mints three fresh keys, signs one honest reading with each, and presents
//! a quorum that passes at threshold three -- worthless, because a stranger was never told which nodes are
//! the legitimate validators.
//!
//! The Muster fills that blind spot: a known, bounded, named set of validator public keys -- the roll a
//! quorum must be drawn from. A Chorus is believed not because `t` different keys signed, but because `t`
//! of the ENROLLED validators signed, where `t` is the Muster's own BYZANTINE THRESHOLD read from its
//! size (`n − (n−1)/3` -- the 2f+1 quorum when n = 3f+1, derived never stored, so a tampered roll cannot
//! lower its own bar). The crux `pass_muster(muster, chorus)` passes exactly when:
//!   - the Chorus is internally sound on its own terms first (verify_chorus: every voice verifies - all
//!     agree on one claim - signers distinct);
//!   - every distinct voice is an enrolled Muster member (else NotMember -- an outsider voice never counts,
//!     and a quorum padded with one stranger is refused whole, never silently trimmed);
//!   - the enrolled count meets the Byzantine threshold (else BelowQuorum -- a genuine but thin quorum is
//!     not yet believed).
//! The crux demonstration: a Chorus of three fresh keys that PASSES `verify_chorus(3)` REFUSES
//! `pass_muster` against a Muster those keys were never enrolled in.
//!
//! Composes chorus - voucher - kumara public API only, editing none; the membership-and-quorum law is the
//! Muster's own bounded fold over its roll and the Chorus's voices. Siloed, dev-only, demo seeds -- no real
//! key, no funds, no network, no custody. A SERVED muster (a holder fetching the live validator set over
//! Comlink) reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/muster.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");
const chorus = @import("chorus.rye");
const voucher = @import("voucher.rye");
const tally_copy = @import("tally_copy.rye");

pub const muster_version = "20260813.110039";

/// A validator key is a full encoded holder identity, the width the ledger seats.
pub const pk_len: u32 = chorus.pk_len;

/// A validator set is bounded -- at most this many nodes ever enroll in one roll.
pub const muster_max_members: u32 = 16;

pub const MusterError = error{
    MusterFull, // the roll is full — a validator set never grows past its bound
    Duplicate, // this key is already enrolled — a validator counts once on the roll
    NotMember, // a Chorus voice is not an enrolled validator — an outsider never counts
    BelowQuorum, // fewer enrolled voices than the Byzantine threshold — a thin quorum is not believed
} || chorus.ChorusError;

/// A known, bounded set of validator public keys -- the roll a quorum must be drawn from. It carries no
/// signature and no stored threshold of its own; the Byzantine threshold is a pure function of the member
/// count, so a Muster of `n` validators cannot lie about how many voices it requires.
pub const Muster = struct {
    members: [muster_max_members][pk_len]u8 = undefined,
    len: u32 = 0,

    pub fn empty() Muster {
        return .{ .members = undefined, .len = 0 };
    }
};

/// True when `pk` names an enrolled validator on the roll.
pub fn is_member(m: *const Muster, pk: []const u8) bool {
    // invariant: membership is asked over a full holder identity.
    assert(pk.len == pk_len);
    // invariant: the roll honors its static bound.
    assert(m.len <= muster_max_members);
    var i: u32 = 0;
    while (i < m.len) : (i += 1) {
        if (std.mem.eql(u8, m.members[i][0..pk_len], pk)) return true;
    }
    return false;
}

/// Enroll a validator key on the roll -- once. Refuses `Duplicate` for a key already present and
/// `MusterFull` past the bound rather than growing.
pub fn enroll(m: *Muster, pk: []const u8) MusterError!void {
    // invariant: a validator is enrolled by a full holder identity.
    assert(pk.len == pk_len);
    // invariant: the roll honors its static bound before any growth.
    assert(m.len <= muster_max_members);
    if (m.len >= muster_max_members) return error.MusterFull;
    if (is_member(m, pk)) return error.Duplicate;
    tally_copy.copy_disjoint(u8, m.members[m.len][0..pk_len], pk);
    m.len += 1;
    // invariant: enrolling one validator grows the roll by exactly one, never past the ceiling.
    assert(m.len <= muster_max_members);
}

/// The Byzantine quorum threshold read from the roll's size: `n − (n−1)/3` -- the 2f+1 quorum when the roll
/// is a smallest fault-tolerant set (n = 3f+1), and the smallest set that must intersect any other quorum
/// in at least one honest node for any `n`. Derived here, never stored, so a tampered roll cannot quietly
/// lower its own bar.
pub fn byzantine_threshold(m: *const Muster) u32 {
    // invariant: the roll honors its static bound.
    assert(m.len <= muster_max_members);
    if (m.len == 0) return 0; // an empty roll requires nothing and believes nothing
    const f: u32 = (m.len - 1) / 3;
    const t = m.len - f;
    // invariant: a quorum is at least one voice and never more than the whole roll.
    assert(t >= 1);
    assert(t <= m.len);
    return t;
}

/// The crux: a Chorus passes muster only when its distinct, agreeing, honestly-signed voices are all
/// enrolled validators and their count meets the Muster's Byzantine threshold. The Chorus's own quorum law
/// runs first (`verify_chorus` -- every voice verifies - all agree on one claim - signers distinct), so a
/// forged, disagreeing, or Sybil-padded Chorus refuses on its own terms before the roll is consulted; then
/// every voice must be enrolled (else `NotMember`), and the enrolled count must meet the threshold (else
/// `BelowQuorum`).
pub fn pass_muster(m: *const Muster, c: *const chorus.Chorus) MusterError!void {
    // invariant: the roll honors its static bound.
    assert(m.len <= muster_max_members);
    // invariant: a meaningful roll enrolls at least one validator.
    assert(m.len >= 1);

    // 1. The Chorus is internally sound on its own terms -- verify - agree - distinct.
    try chorus.verify_chorus(c, 1);

    // 2. Every distinct voice is an enrolled validator -- an outsider never counts, and a quorum padded
    //    with one stranger is refused whole rather than silently trimmed.
    var i: u32 = 0;
    while (i < c.count) : (i += 1) {
        if (!is_member(m, c.members[i].node_slice())) return error.NotMember;
    }

    // 3. The enrolled count meets the Byzantine threshold -- a thin quorum is not yet believed.
    const t = byzantine_threshold(m);
    if (c.count < t) return error.BelowQuorum;

    // invariant: the Chorus's distinct voices are all enrolled, so its count never exceeds the roll.
    assert(c.count <= m.len);
}

/// Print a Muster a keeper can read -- the count of enrolled validators and the Byzantine threshold their
/// number sets.
pub fn render(m: *const Muster) void {
    print("muster validators={d} byzantine_threshold={d}\n", .{ m.len, byzantine_threshold(m) });
}

// --- selftest: a Chorus passes muster only when enrolled validators reach the threshold ------------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// A minimal honest scene: one genesis issue of 100 to Alice, one block, one Dag. A Chorus opened over it
/// vouches Alice's plain standing -- enough to weigh a validator set against, without the pledge machinery
/// the Chorus's own selftest already proves.
fn issue_dag(alice_pk: []const u8) !cord.Dag {
    const kf = seeded(0xF0);
    const f_gen = fold.mint_fact(kf, fold.kind_issue, 100, "", alice_pk) orelse return error.MintGen;
    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var dag = cord.Dag.empty();
    try cord.add(&dag, g);
    return dag;
}

/// Enroll a roll of `n` validators from the given seed bytes, returning the built Muster.
fn muster_of(seeds: []const u8) !Muster {
    var m = Muster.empty();
    for (seeds) |s| {
        const pk = seeded(s).public_key.toBytes();
        try enroll(&m, pk[0..]);
    }
    return m;
}

pub fn main() !void {
    const alice_pk = seeded(0xA1).public_key.toBytes();
    const dag = try issue_dag(alice_pk[0..]);

    // Four enrolled validators -- n = 4 tolerates one fault, so the Byzantine threshold is three.
    const validators = [_]u8{ 0x11, 0x22, 0x33, 0x44 };
    const roll = try muster_of(validators[0..]);
    if (roll.len != 4) return error.RollSize;
    if (byzantine_threshold(&roll) != 3) return error.RollThreshold;

    // Scene 1 -- a full quorum passes. Three of the four enrolled validators each vouch Alice's position;
    // the Chorus is sound, every voice is enrolled, and three meets the threshold of three.
    {
        var c = try chorus.open(&dag, alice_pk[0..]);
        try chorus.add(&c, &dag, seeded(0x11));
        try chorus.add(&c, &dag, seeded(0x22));
        try chorus.add(&c, &dag, seeded(0x33));
        try pass_muster(&roll, &c);
    }

    // Scene 2 -- a thin quorum refuses. Two enrolled validators is a genuine but sub-Byzantine quorum; the
    // roll refuses BelowQuorum rather than believe a reading fewer than three of its own attested.
    {
        var c = try chorus.open(&dag, alice_pk[0..]);
        try chorus.add(&c, &dag, seeded(0x11));
        try chorus.add(&c, &dag, seeded(0x22));
        if (pass_muster(&roll, &c)) |_| return error.ThinBelieved else |err| {
            if (err != error.BelowQuorum) return error.WrongThin;
        }
    }

    // Scene 3 -- THE CRUX. Three FRESH keys, none enrolled, each honestly vouches Alice's reading. The
    // Chorus's own law believes them -- verify_chorus(3) PASSES -- because they are distinct and agree. Yet
    // they are strangers to the roll, so pass_muster refuses NotMember: a fresh key never passes for a
    // validator. This is the blind spot the Muster closes.
    {
        var c = try chorus.open(&dag, alice_pk[0..]);
        try chorus.add(&c, &dag, seeded(0xE1));
        try chorus.add(&c, &dag, seeded(0xE2));
        try chorus.add(&c, &dag, seeded(0xE3));
        try chorus.verify_chorus(&c, 3); // the Chorus alone believes three fresh keys...
        if (pass_muster(&roll, &c)) |_| return error.OutsiderBelieved else |err| {
            if (err != error.NotMember) return error.WrongOutsider; // ...the Muster does not.
        }
    }

    // Scene 4 -- a padded quorum refuses whole. Three enrolled validators would pass, but one stranger
    // added among them makes the Chorus refuse NotMember rather than silently trim the outsider and count
    // the rest -- a quorum presented with a non-member voice is malformed, not merely oversized.
    {
        var c = try chorus.open(&dag, alice_pk[0..]);
        try chorus.add(&c, &dag, seeded(0x11));
        try chorus.add(&c, &dag, seeded(0x22));
        try chorus.add(&c, &dag, seeded(0x33));
        try chorus.add(&c, &dag, seeded(0xE9)); // one stranger among three enrolled
        if (pass_muster(&roll, &c)) |_| return error.PaddedBelieved else |err| {
            if (err != error.NotMember) return error.WrongPadded;
        }
    }

    // Scene 5 -- the Byzantine threshold is read from the size, across a range of rolls.
    {
        const one = try muster_of(&[_]u8{0x11});
        const three = try muster_of(&[_]u8{ 0x11, 0x22, 0x33 });
        const seven = try muster_of(&[_]u8{ 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77 });
        const ten = try muster_of(&[_]u8{ 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA });
        if (byzantine_threshold(&one) != 1) return error.T1; // n=1 f=0
        if (byzantine_threshold(&three) != 3) return error.T3; // n=3 f=0
        if (byzantine_threshold(&roll) != 3) return error.T4; // n=4 f=1
        if (byzantine_threshold(&seven) != 5) return error.T7; // n=7 f=2
        if (byzantine_threshold(&ten) != 7) return error.T10; // n=10 f=3
    }

    // Scene 6 -- membership and enroll refusals. A stranger is no member; a re-enroll refuses Duplicate; a
    // roll past its bound refuses MusterFull.
    {
        if (!is_member(&roll, seeded(0x11).public_key.toBytes()[0..])) return error.MemberMissing;
        if (is_member(&roll, seeded(0xE1).public_key.toBytes()[0..])) return error.StrangerMember;

        var m = try muster_of(&[_]u8{ 0x11, 0x22 });
        const dup = seeded(0x11).public_key.toBytes();
        if (enroll(&m, dup[0..])) |_| return error.DupEnrolled else |err| {
            if (err != error.Duplicate) return error.WrongDup;
        }

        var full = Muster.empty();
        var b: u8 = 0;
        while (b < muster_max_members) : (b += 1) {
            const pk = seeded(b + 1).public_key.toBytes();
            try enroll(&full, pk[0..]);
        }
        const over = seeded(0xFE).public_key.toBytes();
        if (enroll(&full, over[0..])) |_| return error.OverEnrolled else |err| {
            if (err != error.MusterFull) return error.WrongFull;
        }
        if (full.len != muster_max_members) return error.FullSize;
    }

    render(&roll);

    print("muster: a Chorus passes muster only when its enrolled validators meet the Byzantine threshold read from the roll's size; a full quorum of enrolled voices is believed\n", .{});
    print("muster: three fresh keys that the Chorus alone believes (verify_chorus(3) passes) refuse pass_muster NotMember against a roll they were never enrolled in; a thin quorum refuses BelowQuorum; a padded quorum refuses whole; enroll refuses Duplicate and MusterFull\n", .{});
    print("GREEN: myc muster r1 — a known validator set binds a quorum to a named roll: a Chorus is believed only when enrolled validators reach the Byzantine threshold n−(n−1)/3, and a fresh key never passes for a validator. Proof of quorum against a known set stands.\n", .{});
}
