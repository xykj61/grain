//! mycelium/warrant.rye — the Warrant: a validator set rotates only when the current quorum certifies its
//! successor (r1, the crux).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · the Warrant · rung r1 — the crux.
//! Design read: active-designing/date/20260813/20260813-112420_mycelium-warrant-validator-set-rotation-exploration.md
//!
//! The Muster named WHICH nodes are the legitimate validators — a bounded open roll with a Byzantine
//! threshold read from its own size. Yet the roll is FROZEN: nothing lets a validator set change. Real
//! fault-tolerant systems must retire a compromised node, admit a new one, or rotate a whole committee
//! between epochs (TigerBeetle changes its view, Mysticeti reconfigures its committee) — and each faces the
//! same trap: WHO authorizes the new roll? If a fresh set of keys could simply declare itself the
//! validators, the Muster's whole guarantee evaporates — an attacker mints a roll of their own keys, calls
//! it the committee, and a stranger cannot tell the real succession from a coup.
//!
//! The Warrant fills that blind spot: a validator set rotates only when a QUORUM OF THE CURRENT ROLL
//! certifies its successor. Authority is never seized; it is handed forward under signature. A new roll is
//! believed not because it says it is the committee, but because a Byzantine quorum of the OUTGOING
//! validators signed the successor's content-address. The crux `verify_warrant(warrant, prev, next)` passes
//! exactly when:
//!   - the digests bind the two real rolls (prev_digest == roll_digest(prev), next_digest ==
//!     roll_digest(next); else DigestMismatch — a certificate cannot be re-pointed at rolls it never signed);
//!   - every endorser is an enrolled member of the PREVIOUS roll (else NotMember — the CRUX: the successor's
//!     own fresh keys, signing their own coronation, do not authorize themselves; a set cannot crown itself);
//!   - the endorsers are distinct (else DuplicateSigner — one outgoing node cannot sign the handoff twice);
//!   - every signature holds over the bound tuple (else BadSignature);
//!   - the count meets the PREVIOUS roll's Byzantine threshold (else BelowQuorum — a thin handoff, short of
//!     the outgoing set's own bar, is not yet a lawful succession).
//!
//! Composes muster · muster_bron · kumara public API only, editing none; the succession law is the
//! Warrant's own bounded fold over two rolls and a quorum of the first. Siloed, dev-only, demo validator and
//! keeper seeds — no real key, no funds, no network, no custody. A SERVED warrant (a holder fetching the
//! live succession chain over Comlink) reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/warrant.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha256 = std.crypto.hash.sha2.Sha256;
const muster = @import("muster.rye");
const muster_bron = @import("muster_bron.rye");
const kumara = @import("kumara.rye");
const tally_copy = @import("tally_copy.rye");

pub const warrant_version = "20260813.112420";

/// A validator key is a full encoded holder identity, the width the roll seats.
pub const pk_len: u32 = muster.pk_len;

/// A signature encodes to a fixed width — the octets an endorsement carries.
pub const sig_len: u32 = kumara.signature_length;

/// A roll's content-address is a SHA-256 digest of its canonical bytes.
pub const digest_len: u32 = 32;

/// A handoff is endorsed by at most this many outgoing validators — one certificate never grows past the
/// largest roll it can be drawn from.
pub const warrant_max_sigs: u32 = muster.muster_max_members;

/// The domain tag separates a warrant signature from every other signature in the ledger set, so no
/// signature made elsewhere can be replayed as an endorsement.
pub const warrant_domain = "myc-warrant-v1";

/// The canonical signed body: domain tag · epoch (u32 little-endian) · prev digest · next digest.
pub const body_len: u32 = @intCast(warrant_domain.len + 4 + digest_len + digest_len);

pub const WarrantError = error{
    WarrantFull, // more endorsements than a certificate holds
    DuplicateSigner, // one outgoing validator endorsed twice — a node signs the handoff once
    DigestMismatch, // a digest does not bind the roll presented — the certificate is re-pointed
    NotMember, // an endorser is not an enrolled member of the previous roll — an outsider never authorizes
    BadSignature, // an endorsement did not verify over the bound tuple
    BelowQuorum, // fewer endorsements than the previous roll's Byzantine threshold — a thin handoff
} || muster_bron.BronError;

/// One outgoing validator's endorsement of a handoff — its key and its signature over the bound tuple.
pub const Endorsement = struct {
    signer_pk: [pk_len]u8 = undefined,
    sig: [sig_len]u8 = undefined,

    pub fn signer_slice(e: *const Endorsement) []const u8 {
        // invariant: an endorsement carries a full holder identity.
        assert(pk_len == muster.pk_len);
        return e.signer_pk[0..pk_len];
    }
};

/// A fixed, bounded certificate binding one epoch handoff — the epoch, the retiring and successor roll
/// digests, and a quorum of the outgoing validators' endorsements. It invents no attestation of its own;
/// its authority is exactly the gathered endorsement of a quorum of the previous roll.
pub const Warrant = struct {
    epoch: u32 = 0,
    prev_digest: [digest_len]u8 = undefined,
    next_digest: [digest_len]u8 = undefined,
    endorsements: [warrant_max_sigs]Endorsement = undefined,
    count: u32 = 0,
};

/// The content-address of a roll: SHA-256 over its canonical `format muster-v1` bytes, so two rolls that
/// name the same validators in the same order share one digest and any change is visible in the address.
pub fn roll_digest(m: *const muster.Muster, out: *[digest_len]u8) muster_bron.BronError!void {
    // invariant: the roll honors its static bound.
    assert(m.len <= muster.muster_max_members);
    // invariant: a SHA-256 digest is exactly thirty-two bytes.
    assert(digest_len == 32);
    var buf: [muster_bron.max_record]u8 = undefined;
    const n = try muster_bron.render(m, buf[0..]);
    Sha256.hash(buf[0..n], out, .{});
}

/// Fill the canonical signed body for a handoff into `out`: domain tag · epoch (little-endian u32) · prev
/// digest · next digest. Every endorser signs exactly these bytes, and verify rebuilds them, so a signature
/// binds the epoch and both rolls with nothing left implicit.
fn warrant_body(epoch: u32, prev_digest: *const [digest_len]u8, next_digest: *const [digest_len]u8, out: *[body_len]u8) void {
    // invariant: the body layout matches its declared width exactly.
    assert(out.len == warrant_domain.len + 4 + digest_len + digest_len);
    var off: u32 = 0;
    tally_copy.copy_disjoint(u8, out[off .. off + warrant_domain.len], warrant_domain);
    off += @intCast(warrant_domain.len);
    std.mem.writeInt(u32, out[off..][0..4], epoch, .little);
    off += 4;
    tally_copy.copy_disjoint(u8, out[off .. off + digest_len], prev_digest);
    off += digest_len;
    tally_copy.copy_disjoint(u8, out[off .. off + digest_len], next_digest);
    off += digest_len;
    // invariant: the whole body was written, no more and no less.
    assert(off == body_len);
}

/// Open a handoff certificate for a rotation — computing both roll digests from the actual rolls, with no
/// endorsements yet. The epoch is the successor's sequence number, monotone across a chain of handoffs.
pub fn open(epoch: u32, prev: *const muster.Muster, next: *const muster.Muster) muster_bron.BronError!Warrant {
    // invariant: both rolls honor the static bound before a digest is taken.
    assert(prev.len <= muster.muster_max_members);
    assert(next.len <= muster.muster_max_members);
    var w = Warrant{ .epoch = epoch, .count = 0 };
    try roll_digest(prev, &w.prev_digest);
    try roll_digest(next, &w.next_digest);
    return w;
}

/// Gather one outgoing validator's endorsement — sign the bound tuple and append. Refuses `DuplicateSigner`
/// for a key already present and `WarrantFull` past the bound rather than growing. Enrollment in the
/// previous roll is weighed at verify, not here, so a forgery scene can be constructed and then refused.
pub fn endorse(w: *Warrant, signer_kp: kumara.KeyPair) WarrantError!void {
    // invariant: the certificate honors its static bound before any growth.
    assert(w.count <= warrant_max_sigs);
    if (w.count >= warrant_max_sigs) return error.WarrantFull;

    const pk = signer_kp.public_key.toBytes();
    var i: u32 = 0;
    while (i < w.count) : (i += 1) {
        if (std.mem.eql(u8, w.endorsements[i].signer_slice(), pk[0..])) return error.DuplicateSigner;
    }

    var body: [body_len]u8 = undefined;
    warrant_body(w.epoch, &w.prev_digest, &w.next_digest, &body);
    const sig = kumara.sign(body[0..], signer_kp, null).toBytes();

    var e = Endorsement{};
    tally_copy.copy_disjoint(u8, e.signer_pk[0..pk_len], pk[0..]);
    tally_copy.copy_disjoint(u8, e.sig[0..sig_len], sig[0..]);
    w.endorsements[w.count] = e;
    w.count += 1;
    // invariant: gathering one endorsement grows the certificate by exactly one, never past the ceiling.
    assert(w.count <= warrant_max_sigs);
}

/// The crux: a successor roll is authorized only when a Byzantine quorum of the PREVIOUS roll's own
/// validators signed it. The digests bind the two real rolls first (else DigestMismatch); then every
/// endorser must be an enrolled member of `prev` (else NotMember — a set cannot crown itself), the
/// endorsers distinct (else DuplicateSigner), every signature holds over the bound tuple (else
/// BadSignature), and the count meets the previous roll's Byzantine threshold (else BelowQuorum).
pub fn verify_warrant(w: *const Warrant, prev: *const muster.Muster, next: *const muster.Muster) WarrantError!void {
    // invariant: both rolls honor the static bound.
    assert(prev.len <= muster.muster_max_members);
    assert(next.len <= muster.muster_max_members);
    // invariant: the certificate honors its static bound.
    assert(w.count <= warrant_max_sigs);

    // 1. The digests bind the two real rolls — a certificate cannot be re-pointed at rolls it never signed.
    var pd: [digest_len]u8 = undefined;
    var nd: [digest_len]u8 = undefined;
    try roll_digest(prev, &pd);
    try roll_digest(next, &nd);
    if (!std.mem.eql(u8, w.prev_digest[0..], pd[0..])) return error.DigestMismatch;
    if (!std.mem.eql(u8, w.next_digest[0..], nd[0..])) return error.DigestMismatch;

    // The bound tuple every endorsement must verify against.
    var body: [body_len]u8 = undefined;
    warrant_body(w.epoch, &w.prev_digest, &w.next_digest, &body);

    var i: u32 = 0;
    while (i < w.count) : (i += 1) {
        const e = &w.endorsements[i];

        // 2. Every endorser is an enrolled member of the PREVIOUS roll — the crux: an outsider, and the
        //    successor's own keys, never authorize the succession.
        if (!muster.is_member(prev, e.signer_slice())) return error.NotMember;

        // 3. The endorsers are distinct — one outgoing node cannot sign the handoff twice.
        var j: u32 = i + 1;
        while (j < w.count) : (j += 1) {
            if (std.mem.eql(u8, e.signer_slice(), w.endorsements[j].signer_slice())) return error.DuplicateSigner;
        }

        // 4. The signature holds over the bound tuple.
        const pk = kumara.PublicKey.fromBytes(e.signer_pk) catch return error.BadSignature;
        kumara.verify_bytes(body[0..], e.sig[0..sig_len], pk) catch return error.BadSignature;
    }

    // 5. The count meets the PREVIOUS roll's Byzantine threshold — a thin handoff is not a lawful succession.
    const t = muster.byzantine_threshold(prev);
    if (w.count < t) return error.BelowQuorum;

    // invariant: a lawful handoff never carries more endorsements than the roll it is drawn from.
    assert(w.count <= prev.len);
}

/// Print a warrant a keeper can read — the epoch and the count of outgoing validators who endorsed it.
pub fn render(w: *const Warrant) void {
    print("warrant epoch={d} endorsements={d}\n", .{ w.epoch, w.count });
}

// --- selftest: only the outgoing quorum can crown the successor -------------------------------------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// Enroll a roll of validators from the given seed bytes, returning the built Muster.
fn muster_of(seeds: []const u8) !muster.Muster {
    var m = muster.Muster.empty();
    for (seeds) |s| {
        const pk = seeded(s).public_key.toBytes();
        try muster.enroll(&m, pk[0..]);
    }
    return m;
}

pub fn main() !void {
    // The outgoing roll — four validators, Byzantine threshold three — hands authority to a fresh successor
    // roll of three new validators.
    const prev = try muster_of(&[_]u8{ 0x11, 0x22, 0x33, 0x44 });
    const next = try muster_of(&[_]u8{ 0xA1, 0xB2, 0xC3 });
    if (prev.len != 4) return error.PrevSize;
    if (muster.byzantine_threshold(&prev) != 3) return error.PrevThreshold;

    // Scene 1 — a lawful handoff passes. Three of the four OUTGOING validators endorse the fresh successor;
    // the digests bind both real rolls, every endorser is enrolled in prev, and three meets prev's
    // threshold of three.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        try endorse(&w, seeded(0x22));
        try endorse(&w, seeded(0x33));
        try verify_warrant(&w, &prev, &next);
    }

    // Scene 2 — THE CRUX. The successor's OWN fresh validators sign their own coronation. Their signatures
    // hold and they are three distinct keys, yet none is enrolled in the previous roll, so verify_warrant
    // refuses NotMember: a set cannot crown itself; only the roll it succeeds can hand authority forward.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0xA1));
        try endorse(&w, seeded(0xB2));
        try endorse(&w, seeded(0xC3));
        if (verify_warrant(&w, &prev, &next)) |_| return error.SelfCrowned else |err| {
            if (err != error.NotMember) return error.WrongSelfCrown;
        }
    }

    // Scene 3 — a thin handoff refuses. Two of the outgoing validators is a genuine but sub-Byzantine
    // quorum; the succession refuses BelowQuorum rather than admit a roll fewer than three of the outgoing
    // set attested.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        try endorse(&w, seeded(0x22));
        if (verify_warrant(&w, &prev, &next)) |_| return error.ThinCrowned else |err| {
            if (err != error.BelowQuorum) return error.WrongThin;
        }
    }

    // Scene 4 — a re-pointed certificate refuses. A warrant lawfully endorsed for `next` is presented
    // against a DIFFERENT successor roll; the next digest no longer binds, so verify_warrant refuses
    // DigestMismatch — a certificate cannot be lifted onto a roll it never authorized.
    {
        const other = try muster_of(&[_]u8{ 0xD4, 0xE5, 0xF6 });
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        try endorse(&w, seeded(0x22));
        try endorse(&w, seeded(0x33));
        if (verify_warrant(&w, &prev, &other)) |_| return error.RepointCrowned else |err| {
            if (err != error.DigestMismatch) return error.WrongRepoint;
        }
    }

    // Scene 5 — a padded handoff refuses whole. Three enrolled outgoing validators would pass, but one
    // stranger endorsing among them makes verify_warrant refuse NotMember rather than silently trim the
    // outsider and count the rest — a certificate with a non-member endorsement is malformed, not oversized.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        try endorse(&w, seeded(0x22));
        try endorse(&w, seeded(0x33));
        try endorse(&w, seeded(0xE9)); // one stranger among three enrolled
        if (verify_warrant(&w, &prev, &next)) |_| return error.PaddedCrowned else |err| {
            if (err != error.NotMember) return error.WrongPadded;
        }
    }

    // Scene 6 — a forged endorsement refuses. An enrolled validator's key is present, yet its signature is
    // one made over some other bytes (a different epoch's body); the signature does not verify over the
    // bound tuple, so verify_warrant refuses BadSignature.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        try endorse(&w, seeded(0x22));
        try endorse(&w, seeded(0x33));
        // Corrupt one endorsement's signature by flipping a byte — the key stays enrolled, the signature
        // no longer holds.
        w.endorsements[0].sig[0] ^= 0xFF;
        if (verify_warrant(&w, &prev, &next)) |_| return error.ForgedBelieved else |err| {
            if (err != error.BadSignature) return error.WrongForged;
        }
    }

    // Scene 7 — endorse refusals. A re-endorsement by the same signer refuses DuplicateSigner; a
    // certificate past its bound refuses WarrantFull.
    {
        var w = try open(1, &prev, &next);
        try endorse(&w, seeded(0x11));
        if (endorse(&w, seeded(0x11))) |_| return error.DupEndorsed else |err| {
            if (err != error.DuplicateSigner) return error.WrongDup;
        }

        // Fill a certificate to its bound against a full roll, then one more refuses WarrantFull.
        var full_seeds: [warrant_max_sigs]u8 = undefined;
        var b: u32 = 0;
        while (b < warrant_max_sigs) : (b += 1) full_seeds[b] = @intCast(b + 1);
        const full_prev = try muster_of(full_seeds[0..]);
        var wf = try open(2, &full_prev, &next);
        b = 0;
        while (b < warrant_max_sigs) : (b += 1) try endorse(&wf, seeded(@intCast(b + 1)));
        if (endorse(&wf, seeded(0xFE))) |_| return error.OverEndorsed else |err| {
            if (err != error.WarrantFull) return error.WrongFull;
        }
        if (wf.count != warrant_max_sigs) return error.FullCount;
    }

    // Scene 8 — a roll's digest is its content-address. The retiring roll and a re-built copy of it share
    // one digest; a roll that differs by one validator has a different digest.
    {
        var d1: [digest_len]u8 = undefined;
        var d2: [digest_len]u8 = undefined;
        const copy = try muster_of(&[_]u8{ 0x11, 0x22, 0x33, 0x44 });
        try roll_digest(&prev, &d1);
        try roll_digest(&copy, &d2);
        if (!std.mem.eql(u8, d1[0..], d2[0..])) return error.DigestUnstable;
        var d3: [digest_len]u8 = undefined;
        try roll_digest(&next, &d3);
        if (std.mem.eql(u8, d1[0..], d3[0..])) return error.DigestCollided;
    }

    render(&(try open(1, &prev, &next)));

    print("warrant: a validator set rotates only when a Byzantine quorum of the current roll certifies its successor; a lawful handoff of three outgoing validators over a fresh roll is believed\n", .{});
    print("warrant: the successor's own fresh keys signing their own coronation refuse verify_warrant NotMember — a set cannot crown itself; a thin handoff refuses BelowQuorum, a re-pointed certificate refuses DigestMismatch, a padded one refuses whole, a forged endorsement refuses BadSignature; endorse refuses DuplicateSigner and WarrantFull\n", .{});
    print("GREEN: myc warrant r1 — authority is handed forward under signature, never seized: a successor roll is believed only when a Byzantine quorum of the previous roll signed its content-address, and a set never crowns itself. Safe validator-set rotation stands.\n", .{});
}
