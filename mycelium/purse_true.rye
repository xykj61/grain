//! mycelium/purse_true.rye -- the Purse reads a real per-account double-spend fixture true (r4, the arc closes).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - the per-account double-spend - rung r4.
//! Design read: active-designing/date/20260813/20260813-073500_mycelium-purse-true-real-fixture-exploration.md
//!
//! r1 fixed the per-account verdict, r2 let it travel, r3 read it across a Knot -- all over Dags
//! seated in code. This closing rung carries the reader onto a **real** on-disk Cord record carrying
//! a genuine per-account double-spend a keeper can open and walk, and proves the property the whole
//! purse rests on: the SPENT-OUT holder is true to the bytes.
//!
//! The corpus is `tools/fixtures/purse_dag.bron`, a genuine record produced reproducibly by
//! `mycelium/purse_fixture_gen.rye` (a demo funder credits Alice 100; Alice -> Bob 100 wins at round 1;
//! Bob -> Dan 40 moves uncontested at round 2; Alice -> Carol 100 comes up short at round 2, her purse
//! emptied by the winning transfer), `@embedFile`-bound at compile time through a symlink in
//! `mycelium/corpora/` -- no network, the bytes read are the tree's own. Two independent readings must
//! agree: the app parses the record through `cord_bron`, **rebuilds** the Dag under `cord.add`
//! (re-verifying every signature), resolves it through `purse`, and reports the **signer of the
//! spent-out transfer**, the **moved count**, and the **short count**; the r4 witness cross-checks that
//! triple against `tools/fixtures/purse_dag_truth.awk`'s reading of the same file -- two tools, one
//! answer. The awk applies the simplest honest slice of the agreed order (per-account balance
//! accounting in file order); the app applies the full commit tie-break; the losing transfer is
//! unambiguously the round-2 one and the two paying moves touch disjoint accounts, so both name the
//! same spent-out holder.
//!
//! Additive -- composes `cord_bron` + `cord` + `purse` public API only (each re-runs GREEN).
//! Siloed, dev-only, demo seeds -- no real key, no funds, no network, no custody.
//!
//!   rye build mycelium/purse_true.rye -femit-bin=mycelium/bin/purse_true
//!   mycelium/bin/purse_true selftest | measure

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_bron = @import("cord_bron.rye");
const purse = @import("purse.rye");

pub const purse_true_version = "20260813.073500";

/// The real per-account double-spend Cord record, bound at compile time -- the tree's own bytes, never a drifting copy.
const real_dag = @embedFile("corpora/purse_dag.bron");

const hex_digits = "0123456789abcdef";

/// Encode bytes to lowercase hex -- the same width the record's signer field carries, so the app's spent-out
/// holder and awk's spent-out holder are compared as identical strings.
fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex nibbles per byte.
    assert(out.len == bytes.len * 2);
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0f];
    }
}

/// The three facts a keeper can read by hand from a per-account double-spend record: who came up short,
/// how many transfers moved coins, and how many came up short.
pub const Reading = struct {
    loser_hex: [purse.pk_len * 2]u8 = undefined,
    moved: u32 = 0,
    short: u32 = 0,
};

/// Read the real per-account double-spend record: parse it, rebuild the Dag under `cord.add` (verifying
/// every signature), resolve it through the Purse, and read off the signer of the spent-out transfer.
pub fn read_purse(text: []const u8) !Reading {
    const pl = try cord_bron.parse(text);
    // invariant: a real double-spend record carries blocks -- an empty Dag holds no contest to read.
    if (pl.len == 0) return error.BadFormat;
    var dag = try cord_bron.rebuild(&pl);
    const verdict = try purse.resolve(&dag);
    const lost = verdict.short_at(0) orelse return error.NoSpentOutTransfer;
    // invariant: a spent-out transfer carries a full-width signer key.
    assert(lost.from.len == purse.pk_len);
    var r = Reading{ .moved = verdict.moves_seen(), .short = verdict.shorts_seen() };
    to_hex(lost.from[0..], r.loser_hex[0..]);
    return r;
}

// --- selftest -----------------------------------------------------------

/// The reading of the real record -- the witness cross-checks this triple against awk's reading of the same
/// bytes, so the two tools must name one spent-out transfer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_purse(real_dag);
    // The fixture moves two transfers (Alice -> Bob, Bob -> Dan) and one comes up short (Alice -> Carol).
    assert(r.moved == 2);
    assert(r.short == 1);
    print("purse-true: truth-triple {s} {d} {d}\n", .{ r.loser_hex, r.moved, r.short });
    print("purse-true: the signer of the spent-out transfer, the moved count, and the short count match an independent reading of the same bytes.\n", .{});
}

/// The transfer that came up short is the round-2 one, not a round-1 winner -- the sender's purse emptied
/// before its turn, exactly as the agreed order rules. The spent-out loss is lawful (it once could have paid).
fn welcome_spent_out_is_the_later_round() !void {
    const pl = try cord_bron.parse(real_dag);
    var dag = try cord_bron.rebuild(&pl);
    const verdict = try purse.resolve(&dag);
    // Exactly one spent-out loss recorded -- Alice signs 200 against a purse that only ever held 100.
    assert(verdict.shorts_seen() == 1);
    const lost = verdict.short_at(0) orelse return error.NoSpentOutTransfer;
    // invariant: the loss is lawful -- it asked for no more than the holder ever received.
    assert(lost.amount <= lost.received_at);
    // invariant: the spent-out signer's own purse is empty -- the winning transfer took it first.
    assert(verdict.balance_of(lost.from[0..]) == 0);
    print("purse-true: the spent-out holder's purse is empty; it lost a lawful race the agreed order already ruled.\n", .{});
}

/// Conservation holds over the real bytes: the balances sum to exactly what genesis issued -- no coin made
/// or destroyed by the moving, the loser a lawful no-op.
fn welcome_conservation_over_the_real_bytes() !void {
    const pl = try cord_bron.parse(real_dag);
    var dag = try cord_bron.rebuild(&pl);
    const verdict = try purse.resolve(&dag);
    // invariant: the real record issued exactly the hundred the genesis credit funds.
    assert(verdict.total_issued == 100);
    // invariant: conservation -- the balances sum to exactly what genesis issued.
    assert(verdict.balances_sum() == 100);
    print("purse-true: conservation holds over the real bytes — the balances sum to the 100 genesis issued, no coin made or lost.\n", .{});
}

/// A tampered copy of the real bytes refuses -- the reader will not read a corrupted record as true. A
/// flipped header byte refuses `BadFormat`; a flipped signature byte would refuse `BadSignature` at add.
fn unwelcome_tampered_record_refuses() !void {
    var buf: [real_dag.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_dag.len) : (k += 1) buf[k] = real_dag[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_purse(buf[0..]);
    assert(bad == error.BadFormat);
    print("purse-true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_spent_out_is_the_later_round();
    try welcome_conservation_over_the_real_bytes();
    try unwelcome_tampered_record_refuses();
    print("purse_true {s} — GREEN\n", .{purse_true_version});
    print("GREEN: myc purse r4; the spent-out holder of a real per-account double-spend is true to the bytes (loser·moved·short), resolved under the Cord's own add and the agreed order, conservation whole, a tampered record refused. The Purse's agent-doable arc closes.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<loser-hex> <moved> <short>`), so the witness can compare the app's
/// reading against `purse_dag_truth.awk` byte for byte -- two tools, one answer.
fn run_measure() !u8 {
    const r = try read_purse(real_dag);
    print("{s} {d} {d}\n", .{ r.loser_hex, r.moved, r.short });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: purse-true selftest | measure\n", .{});
    return 1;
}
