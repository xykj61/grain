//! mycelium/pledge_true.rye — the Pledge reads a real two-phase-transfer fixture true (r4, the arc closes).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · the two-phase transfer · rung r4.
//! Design read: active-designing/20260813-075049_mycelium-pledge-two-phase-transfer-exploration.md
//!
//! r1 fixed the two-phase verdict, r2 let it travel, r3 read it across a Knot — all over Dags seated
//! in code. This closing rung carries the reader onto a **real** on-disk Cord record carrying a genuine
//! two-phase transfer a keeper can open and walk, and proves the property the whole Pledge rests on: the
//! HONORED recipient is true to the bytes.
//!
//! The corpus is `tools/fixtures/pledge_dag.bron`, a genuine record produced reproducibly by
//! `mycelium/pledge_fixture_gen.rye` (a demo funder credits Alice 200; Alice pledges 100 to Bob at round 1;
//! Alice posts it at round 2, honoring it so the reserved hundred reaches Bob; Alice pledges 100 to Carol at
//! round 3 and leaves it open), `@embedFile`-bound at compile time through a symlink in `mycelium/corpora/` —
//! no network, the bytes read are the tree's own. Two independent readings must agree: the app parses the
//! record through `cord_bron`, **rebuilds** the Dag under `cord.add` (re-verifying every signature), resolves
//! it through `pledge`, and reports the **honored recipient**, the **posted count**, and the **open count**;
//! the r4 witness cross-checks that triple against `tools/fixtures/pledge_dag_truth.awk`'s reading of the same
//! file — two tools, one answer. The awk applies the simplest honest slice of the agreed order (pledge-state
//! accounting in file order); the app applies the full commit tie-break; the single post unambiguously honors
//! the round-1 pledge, so both name the same honored recipient.
//!
//! Additive — composes `cord_bron` + `cord` + `pledge` public API only (each re-runs GREEN).
//! Siloed, dev-only, demo seeds — no real key, no funds, no network, no custody.
//!
//!   rye build mycelium/pledge_true.rye -femit-bin=mycelium/bin/pledge_true
//!   mycelium/bin/pledge_true selftest | measure

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_bron = @import("cord_bron.rye");
const pledge = @import("pledge.rye");

pub const pledge_true_version = "20260813.075049";

/// The real two-phase-transfer Cord record, bound at compile time — the tree's own bytes, never a drift.
const real_dag = @embedFile("corpora/pledge_dag.bron");

const hex_digits = "0123456789abcdef";

/// Encode bytes to lowercase hex — the same width the record's body recipient carries, so the app's honored
/// recipient and awk's honored recipient are compared as identical strings.
fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex nibbles per byte.
    assert(out.len == bytes.len * 2);
    var i: u32 = 0;
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0f];
    }
}

/// The three facts a keeper can read by hand from a two-phase-transfer record: who received the honored
/// pledge, how many pledges were honored, and how many still stand open.
pub const Reading = struct {
    honored_hex: [pledge.pk_len * 2]u8 = undefined,
    posted: u32 = 0,
    open: u32 = 0,
};

/// The index of the first posted pledge, or null when none was honored.
fn first_posted(l: *const pledge.Ledger) ?u32 {
    var i: u32 = 0;
    while (i < l.pledges_seen()) : (i += 1) {
        const pl = l.pledge_at(i) orelse return null;
        if (pl.state == pledge.state_posted) return i;
    }
    return null;
}

/// Read the real two-phase-transfer record: parse it, rebuild the Dag under `cord.add` (verifying every
/// signature), resolve it through the Pledge, and read off the honored pledge's recipient.
pub fn read_pledge(text: []const u8) !Reading {
    const rec = try cord_bron.parse(text);
    // invariant: a real two-phase record carries blocks — an empty Dag holds no pledge to read.
    if (rec.len == 0) return error.BadFormat;
    var dag = try cord_bron.rebuild(&rec);
    const verdict = try pledge.resolve(&dag);
    const pi = first_posted(&verdict) orelse return error.NoHonoredPledge;
    const pl = verdict.pledge_at(pi) orelse return error.NoHonoredPledge;
    // invariant: an honored pledge names a full-width recipient key.
    assert(pl.to.len == pledge.pk_len);
    var r = Reading{
        .posted = verdict.posted_seen(),
        .open = verdict.pledges_seen() - verdict.posted_seen() - verdict.voided_seen(),
    };
    to_hex(pl.to[0..], r.honored_hex[0..]);
    return r;
}

// --- selftest -----------------------------------------------------------

/// The reading of the real record — the witness cross-checks this triple against awk's reading of the same
/// bytes, so the two tools must name one honored recipient.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_pledge(real_dag);
    // The fixture honors one pledge (Alice's to Bob) and leaves one open (Alice's to Carol).
    assert(r.posted == 1);
    assert(r.open == 1);
    print("pledge-true: truth-triple {s} {d} {d}\n", .{ r.honored_hex, r.posted, r.open });
    print("pledge-true: the honored recipient, the posted count, and the open count match an independent reading of the same bytes.\n", .{});
}

/// The honored pledge's reserved coins reached its recipient, and the open pledge still holds coins reserved
/// by its pledger — the two-phase law read from the real bytes.
fn welcome_honored_moved_open_reserved() !void {
    const rec = try cord_bron.parse(real_dag);
    var dag = try cord_bron.rebuild(&rec);
    const verdict = try pledge.resolve(&dag);
    const pi = first_posted(&verdict) orelse return error.NoHonoredPledge;
    const pl = verdict.pledge_at(pi) orelse return error.NoHonoredPledge;
    // invariant: the honored recipient holds the pledge's coins outright.
    assert(verdict.balance_of(pl.to[0..]) == pl.amount);
    // invariant: exactly one pledge still stands open, its coins reserved by the pledger.
    assert(verdict.reserved_sum() == 100);
    print("pledge-true: the honored pledge's coins reached its recipient; the open pledge still holds coins reserved.\n", .{});
}

/// Conservation holds over the real bytes: balance + reserved sums to exactly what genesis issued — no coin
/// made or destroyed by reserving, honoring, or holding a pledge.
fn welcome_conservation_over_the_real_bytes() !void {
    const rec = try cord_bron.parse(real_dag);
    var dag = try cord_bron.rebuild(&rec);
    const verdict = try pledge.resolve(&dag);
    // invariant: the real record issued exactly the two hundred the genesis credit funds.
    assert(verdict.total_issued == 200);
    // invariant: conservation — balance + reserved sums to exactly what genesis issued.
    assert(verdict.balances_sum() + verdict.reserved_sum() == 200);
    print("pledge-true: conservation holds over the real bytes — balance + reserved sums to the 200 genesis issued, no coin made or lost.\n", .{});
}

/// A tampered copy of the real bytes refuses — the reader will not read a corrupted record as true. A
/// flipped header byte refuses `BadFormat`; a flipped signature byte would refuse at add.
fn unwelcome_tampered_record_refuses() !void {
    var buf: [real_dag.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_dag.len) : (k += 1) buf[k] = real_dag[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_pledge(buf[0..]);
    assert(bad == error.BadFormat);
    print("pledge-true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_honored_moved_open_reserved();
    try welcome_conservation_over_the_real_bytes();
    try unwelcome_tampered_record_refuses();
    print("pledge_true {s} — GREEN\n", .{pledge_true_version});
    print("GREEN: myc pledge r4; the honored recipient of a real two-phase transfer is true to the bytes (honored·posted·open), resolved under the Cord's own add and the agreed order, conservation of balance + reserved whole, a tampered record refused. The Pledge's agent-doable arc closes.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<honored-recipient-hex> <posted> <open>`), so the witness can compare
/// the app's reading against `pledge_dag_truth.awk` byte for byte — two tools, one answer.
fn run_measure() !u8 {
    const r = try read_pledge(real_dag);
    print("{s} {d} {d}\n", .{ r.honored_hex, r.posted, r.open });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: pledge-true selftest | measure\n", .{});
    return 1;
}
