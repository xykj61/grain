//! mycelium/testament.rye — a named constellation's verdict travels as an offline certificate (r1).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · Testament · rung r1 — the crux.
//! Design read: active-designing/date/20260813/20260813-135126_mycelium-testament-named-quorum-certificate-exploration.md
//!
//! The Constel journey gave the dev-net a name and a roster, and reached quorum on a real fact — yet that
//! quorum lived and died in one process. A TESTAMENT is the carried belief: a portable certificate that a
//! NAMED constellation, by Byzantine quorum, certified a reading, verifiable OFFLINE holding only the
//! certificate and the roster NAMES. `chorus_bron` already lets a bare quorum travel and re-verify at a
//! STATED threshold — yet it cannot tell an enrolled ship from a stranger with a valid signature, because it
//! carries no roster. A Testament closes exactly that gap: it carries the constellation's ship names, so a
//! recipient BOOTS the identical roster from the names alone (Constel's gift: reproducible, no stored keys),
//! seats the Muster, derives the Byzantine threshold from the roster's size, and confirms the sealing voices
//! are that constellation's own ships. The certificate is bound to a constellation a keeper can name and
//! re-boot, not to a set of anonymous keys.
//!
//! Made WITH the ledger, verified WITHOUT it: sealing reads the Dag to make honest vouchers; verification
//! touches no Dag — `verify_voucher`, `verify_chorus`, and `pass_muster` all work offline over the
//! certificate's own bound facts. Composes constel + chorus + muster + voucher public API only, editing none.
//! Demo ship and keeper seeds — no key held, no funds, no network, no real value.
//!
//! Scope: active-designing/date/20260813/20260813-135126_mycelium-testament-named-quorum-certificate-exploration.md
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/testament.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const kumara = @import("kumara.rye");
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const voucher = @import("voucher.rye");
const chorus = @import("chorus.rye");
const muster = @import("muster.rye");
const constel = @import("constel.rye");
const tally_copy = @import("tally_copy.rye");

pub const testament_version = "20260813.135126";

pub const pk_len: u32 = constel.pk_len;
pub const head_len: u32 = constel.head_len;
pub const max_name_len: u32 = constel.max_name_len;
pub const testament_max_ships: u32 = constel.constel_max_ships;

pub const TestamentError = error{
    EmptyRoster, // a testament names at least one ship in its constellation
    TooManyShips, // more ships than a testament's static bound holds
    NoSigners, // a seal gathers at least one voice
    TooManySigners, // more signers than ships in the roster
};

/// A carried belief: the roster NAMES that define the constellation (its keys and threshold derive from
/// these names alone), and the sealed Chorus — the shared claim (order-head · account · position) and one
/// voucher per sealing ship. The names make the certificate self-describing: a recipient boots the exact
/// roster from them, needing no stored key.
pub const Testament = struct {
    names: [testament_max_ships][max_name_len]u8 = undefined,
    name_lens: [testament_max_ships]u32 = [_]u32{0} ** testament_max_ships,
    roster_count: u32 = 0,
    seal: chorus.Chorus = undefined,

    /// One roster ship's name — the bytes that define its whole identity in this certificate.
    pub fn name_slice(t: *const Testament, i: u32) []const u8 {
        // invariant: a named ship sits within the seated roster.
        assert(i < t.roster_count);
        // invariant: a ship name honors its bounded buffer.
        assert(t.name_lens[i] <= max_name_len);
        // invariant: a seated ship carries a non-empty name.
        assert(t.name_lens[i] >= 1);
        return t.names[i][0..t.name_lens[i]];
    }
};

/// Copy a constellation's ship names into a fresh Testament — the roster the certificate is bound to. The
/// keys are NOT stored; a verifier re-derives them from these names. Refuses EmptyRoster and TooManyShips.
pub fn carry_roster(c: *const constel.Constel) TestamentError!Testament {
    if (c.count == 0) return error.EmptyRoster;
    if (c.count > testament_max_ships) return error.TooManyShips;
    // invariant: the roster honors the certificate's static bound, checked above.
    assert(c.count <= testament_max_ships);
    var t = Testament{};
    var i: u32 = 0;
    while (i < c.count) : (i += 1) {
        const nm = c.ships[i].name_slice();
        tally_copy.copy_disjoint(u8, t.names[i][0..nm.len], nm);
        t.name_lens[i] = @intCast(nm.len);
    }
    t.roster_count = c.count;
    // invariant: carrying N ships names exactly N — the whole roster, no more.
    assert(t.roster_count == c.count);
    return t;
}

/// Seal a reading with the first `signer_count` ships of the constellation: carry the roster names, open a
/// Chorus over the Dag for the account, and gather each signer's honest voucher. The full-roster seal is the
/// `signer_count == c.count` case; a subset (r2's `f` down, or the thin-quorum tooth) passes fewer. Refuses
/// NoSigners and TooManySigners. Reads the Dag — this is the one step that needs the ledger.
pub fn seal_subset(
    c: *const constel.Constel,
    dag: *const cord.Dag,
    account_pk: []const u8,
    signer_count: u32,
) !Testament {
    // invariant: a seal attests a full holder identity.
    assert(account_pk.len == pk_len);
    if (signer_count == 0) return error.NoSigners;
    if (signer_count > c.count) return error.TooManySigners;
    // invariant: the signer set fits within the roster, checked above.
    assert(signer_count <= c.count);

    var t = try carry_roster(c);
    t.seal = try chorus.open(dag, account_pk);
    var i: u32 = 0;
    while (i < signer_count) : (i += 1) {
        try chorus.add(&t.seal, dag, c.ships[i].kp);
    }
    // invariant: the seal gathered exactly one voice per named signer.
    assert(t.seal.count == signer_count);
    return t;
}

/// Seal a reading with the whole constellation signing — the common case. Every ship gathers its voucher.
pub fn seal(c: *const constel.Constel, dag: *const cord.Dag, account_pk: []const u8) !Testament {
    // invariant: the whole roster signs — one voice per ship.
    assert(c.count >= 1);
    return seal_subset(c, dag, account_pk, c.count);
}

/// Boot the constellation the certificate names — a pure function of the roster names, no Dag, no stored
/// key. The returned Constel's keys are re-derived from the names, so a tampered name re-boots a different
/// ship (which is exactly how `verify` catches tampering: the real signer stops being a member).
pub fn boot_roster(t: *const Testament) !constel.Constel {
    // invariant: a meaningful certificate names at least one ship.
    if (t.roster_count == 0) return error.EmptyRoster;
    // invariant: a testament names at least one roster member, since an empty roster would
    // leave a will nobody can execute
    assert(t.roster_count >= 1);
    // invariant: the roster honors the certificate's static bound.
    assert(t.roster_count <= testament_max_ships);
    var name_ptrs: [testament_max_ships][]const u8 = undefined;
    var i: u32 = 0;
    while (i < t.roster_count) : (i += 1) {
        name_ptrs[i] = t.name_slice(i);
    }
    return constel.boot(name_ptrs[0..t.roster_count]);
}

/// The crux: verify the sealed quorum OFFLINE against the constellation the names define. Boot the roster
/// from the certificate's names alone, seat it as a Muster, and pass the seal — every sealing voice must be
/// one of THIS constellation's ships (else NotMember), and the count must meet the Byzantine threshold the
/// booted roster's size derives (else BelowQuorum). No Dag, no network, no stored key. A stranger's valid
/// signature refuses NotMember; a thin quorum refuses BelowQuorum; a tampered name refuses NotMember.
pub fn verify(t: *const Testament) !void {
    // invariant: a certificate is verified over a bounded, non-empty roster.
    assert(t.roster_count >= 1);
    assert(t.roster_count <= testament_max_ships);
    const c = try boot_roster(t);
    const m = try constel.into_muster(&c);
    try muster.pass_muster(&m, &t.seal);
    // invariant: a believed seal meets the roll's Byzantine threshold.
    assert(t.seal.count >= muster.byzantine_threshold(&m));
}

/// The Byzantine threshold the certificate's own named roster derives — never a number the certificate
/// states about itself, so a tampered roster cannot quietly lower its bar.
pub fn threshold_of(t: *const Testament) !u32 {
    // invariant: a threshold is read over a bounded, non-empty roster.
    assert(t.roster_count >= 1);
    assert(t.roster_count <= testament_max_ships);
    const c = try boot_roster(t);
    const m = try constel.into_muster(&c);
    return muster.byzantine_threshold(&m);
}

/// Print a Testament a keeper can read — the constellation's size, its derived threshold, the voices it
/// sealed with, and a short fingerprint of the reading it certifies.
pub fn render(t: *const Testament) void {
    const hd = t.seal.head_slice();
    const th = threshold_of(t) catch 0;
    print("testament ships={d} threshold={d} voices={d} head={x:0>2}{x:0>2}{x:0>2}{x:0>2}\n", .{
        t.roster_count, th, t.seal.count, hd[0], hd[1], hd[2], hd[3],
    });
}

// --- selftest: a named constellation's verdict verifies offline; a stranger cannot ride it -------------

/// A demo genesis Dag — the issuer mints one hundred coins to the account, giving it a position the
/// constellation attests. Demo seeds only.
fn demo_genesis(issuer: kumara.KeyPair, account_pk: []const u8) !cord.Dag {
    // invariant: a genesis credits a full holder identity.
    assert(account_pk.len == pk_len);
    const f_gen = fold.mint_fact(issuer, fold.kind_issue, 100, "", account_pk) orelse return error.MintGen;
    const g = cord.mint_block(issuer, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var dag = cord.Dag.empty();
    try cord.add(&dag, g);
    // invariant: the demo genesis is one block.
    assert(dag.len == 1);
    return dag;
}

// The first Testament dev-net roster — the same names the Constel journey seated, under the Constel naming
// law and the always-on placeholder-ship-names rule (single tokens, no `~`, length != 3/6/12, never @p).
const roster = [_][]const u8{
    "xnvethqua",
    "kwelmirran",
    "xzobrilth",
    "murrqaveln",
    "xwendakosh",
};

pub fn main() !void {
    const issuer = constel.seeded(0xF0);
    const account = constel.seeded(0xA1);
    const account_pk = account.public_key.toBytes();
    var dag = try demo_genesis(issuer, account_pk[0..]);

    var c = try constel.boot(roster[0..]);
    assert(c.count == roster.len);

    // --- The crux — the whole constellation seals the reading, then verifies OFFLINE ------------------
    const t = try seal(&c, &dag, account_pk[0..]);
    assert(t.roster_count == roster.len);
    assert(t.seal.count == roster.len);
    // Verification touches no Dag — only the certificate's names and its sealed voices.
    try verify(&t);

    // The sealed head is the Dag's real order-head — the certificate swears the true reading, not a claim.
    var expected_head: [head_len]u8 = undefined;
    voucher.order_head_of(&dag, &expected_head);
    assert(std.mem.eql(u8, t.seal.head_slice(), expected_head[0..]));

    const threshold = try threshold_of(&t);

    // Reproducible: re-boot the roster the certificate names and confirm byte-identical keys, ship for ship
    // — the constellation the certificate binds to is a pure function of its names.
    {
        const c2 = try boot_roster(&t);
        assert(c2.count == c.count);
        var i: u32 = 0;
        while (i < c.count) : (i += 1) {
            const p1 = c.ships[i].pk();
            const p2 = c2.ships[i].pk();
            assert(std.mem.eql(u8, p1[0..], p2[0..]));
        }
    }

    // --- Teeth 1 — a stranger ship's valid voice never rides the named certificate --------------------
    // The distinguishing power: a bare travelling Chorus would ACCEPT this honest, valid signature; a
    // Testament refuses it because the signer is not one of the constellation's own named ships.
    {
        var forged = t;
        const stranger = try constel.seat_ship("xzoutlander7"); // a valid ship, NOT in the roster
        try chorus.add(&forged.seal, &dag, stranger.kp); // one foreign voice, honestly agreeing
        if (verify(&forged)) |_| return error.StrangerBelieved else |err| {
            if (err != error.NotMember) return error.WrongStranger;
        }
    }

    // --- Teeth 2 — a quorum too thin for the derived Byzantine threshold is not believed --------------
    {
        const thin = try seal_subset(&c, &dag, account_pk[0..], threshold - 1);
        assert(thin.seal.count == threshold - 1);
        if (verify(&thin)) |_| return error.ThinBelieved else |err| {
            if (err != error.BelowQuorum) return error.WrongThin;
        }
    }

    // --- Teeth 3 — a tampered name re-boots a different ship, so the real signer stops being a member --
    // Bound to the EXACT names, byte for byte: flip one byte of one roster name and the certificate no
    // longer verifies, because the tampered name derives a key the sealing voucher never signed with.
    {
        var tampered = t;
        tampered.names[0][0] ^= 0x01; // "xnvethqua" -> a name deriving a different key
        if (verify(&tampered)) |_| return error.TamperBelieved else |err| {
            if (err != error.NotMember) return error.WrongTamper;
        }
    }

    print("testament: GREEN — a named constellation of {d} ships seals a reading into a certificate that verifies OFFLINE from its names alone (no Dag): the roster re-boots byte-identical, the sealed head is the true order-head, and {d} voices meet the Byzantine threshold {d}. A stranger's valid voice refuses NotMember, a thin quorum refuses BelowQuorum, a tampered name refuses NotMember. The constellation's verdict travels bound to its own name.\n", .{ t.roster_count, t.seal.count, threshold });
}
