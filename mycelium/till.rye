//! mycelium/till.rye — the Till: a contested draw decided by the agreed order.
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · Journey rung r1 — the crux.
//! Design read: active-designing/20260813-064129_mycelium-till-double-spend-exploration.md
//!
//! A till is the drawer a treasury's coins sit in. When two keepers reach into one
//! till for coins that cannot pay both, the first draw the agreed order places takes
//! what is there, and the second finds the till already emptied — and breaks nothing.
//! This is the double-spend, the oldest reason a value ledger wants consensus: the
//! Cord already derives one total order from the mesh regardless of arrival, and the
//! Till reads that order as the treasury's verdict — the first draw wins the coins,
//! a later draw the treasury can no longer pay comes up short as a lawful no-op.
//!
//! The honest distinction is the whole crux, and it is the twin of the Tenure's.
//! `fold.fold_fact` returns one `Overdraw` for two different facts: a spend that lost
//! a race (affordable alone, refused only because a competing spend drained first)
//! and a spend that never could pay (more than the treasury ever held). The measure
//! that separates them is monotonic and position-respecting — `issued-so-far`, the
//! cumulative issue at the losing draw's position (issues only add; the fold invents
//! no release). A draw that overdraws yet whose amount is <= issued-so-far LOST A
//! RACE — the coins existed for it once — so it is a lawful no-op spent-out loss and
//! folding continues. A draw that overdraws and asks for more than issued-so-far
//! NEVER COULD PAY — no ordering fixes that — so it refuses the whole resolution. An
//! issue that overdraws (a u64 wrap) is never a race and stays poison unconditionally.
//!
//! Grown beside cord.rye, fold.rye, and tenure.rye — editing none, composing cord +
//! fold public API only. A `StarTaken` name-contest loss is the Tenure's verdict, so
//! the Till lets it refuse the whole resolution here (a Till log carries coins, not
//! two-keepers-one-name contests; the Tenure owns that verdict on a mixed log).
//! Siloed, dev-only, demo seeds — no real key, no funds, no network, no custody.
//!
//! Named horizon (not this arc): per-account balances (fold folds a GLOBAL supply,
//! so a double-spend here is a supply-exhaustion race — the truest this ledger carries
//! today); a Till served to another node reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/till.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");
const tally_copy = @import("tally_copy.rye");

/// A keeper's public key, in its encoded (holder-identity) width.
pub const pk_len: u32 = kumara.PublicKey.encoded_length;

/// At most one winning draw per block — the Dag holds a journey of blocks (256).
pub const till_max_draws: u32 = cord.cord_max_blocks;

/// At most one spent-out loss per block — same ceiling as draws.
pub const till_max_shorts: u32 = cord.cord_max_blocks;

/// One spend the agreed order granted — coins the treasury paid, at its position.
pub const Draw = struct {
    signer_pk: [pk_len]u8 = undefined,
    amount: u64 = 0,
    pos: u32 = 0,
    round: u32 = 0,
};

/// One draw the treasury could not pay — it lost the race for coins already spent.
/// `issued_at` records the treasury's cumulative issue at its position, the measure
/// that proved the loss lawful (amount <= issued_at) rather than never-could-pay.
pub const ShortDraw = struct {
    signer_pk: [pk_len]u8 = undefined,
    amount: u64 = 0,
    pos: u32 = 0,
    issued_at: u64 = 0,
};

/// The resolved treasury: which draws took coins, which came up short, and the
/// lawful supply folded over the verdict.
pub const Till = struct {
    draws: [till_max_draws]Draw = undefined,
    draw_count: u32 = 0,
    shorts: [till_max_shorts]ShortDraw = undefined,
    short_count: u32 = 0,
    state: fold.FoldState = .{},

    /// The count of draws that took coins.
    pub fn draws_seen(t: *const Till) u32 {
        // invariant: the draw count never exceeds the named ceiling.
        assert(t.draw_count <= till_max_draws);
        return t.draw_count;
    }

    /// The count of draws the treasury could not pay.
    pub fn shorts_seen(t: *const Till) u32 {
        // invariant: the loss count never exceeds the named ceiling.
        assert(t.short_count <= till_max_shorts);
        return t.short_count;
    }

    /// The coins the treasury actually paid out across every winning draw.
    pub fn total_drawn(t: *const Till) u64 {
        // invariant: draws stay within the ceiling before we sum them.
        assert(t.draw_count <= till_max_draws);
        var sum: u64 = 0;
        var i: u32 = 0;
        while (i < t.draw_count) : (i += 1) {
            sum += t.draws[i].amount;
        }
        // invariant: coins paid never exceed the treasury ever issued.
        assert(sum <= t.state.issued);
        return sum;
    }

    /// The coins asked for by draws that came up short — refused, never paid.
    pub fn total_lost(t: *const Till) u64 {
        // invariant: losses stay within the ceiling before we sum them.
        assert(t.short_count <= till_max_shorts);
        var sum: u64 = 0;
        var i: u32 = 0;
        while (i < t.short_count) : (i += 1) {
            sum += t.shorts[i].amount;
        }
        return sum;
    }

    /// The signer of the spend that took `pos`-th coins, or null when free.
    pub fn short_at(t: *const Till, i: u32) ?*const ShortDraw {
        // invariant: losses stay within the ceiling before indexing.
        assert(t.short_count <= till_max_shorts);
        if (i >= t.short_count) return null;
        return &t.shorts[i];
    }
};

/// Record a winning draw — coins the agreed order paid, at its position. Only a
/// spend (tax or star reservation) draws; an issue funds the treasury, never draws.
pub fn record_draw(t: *Till, fact: *const fold.Fact, pos: u32, round: u32) error{TooManyDraws}!void {
    // invariant: only a spend ever wins a draw.
    assert(fact.kind == fold.kind_tax or fact.kind == fold.kind_star_reserve);
    if (t.draw_count >= till_max_draws) return error.TooManyDraws;
    const at = t.draw_count;
    tally_copy.copy_disjoint(u8, t.draws[at].signer_pk[0..], fact.signer_pk[0..]);
    t.draws[at].amount = fact.amount;
    t.draws[at].pos = pos;
    t.draws[at].round = round;
    t.draw_count += 1;
}

/// Record a spent-out loss — a spend the treasury could not pay because an earlier
/// winning draw already emptied it. The twin of `record_draw` on the losing side.
pub fn record_short(t: *Till, fact: *const fold.Fact, pos: u32, issued_at: u64) error{TooManyShorts}!void {
    // invariant: only a spend can come up short — an issue funds, never draws.
    assert(fact.kind == fold.kind_tax or fact.kind == fold.kind_star_reserve);
    // invariant: a lawful loss asked for no more than the treasury ever issued.
    assert(fact.amount <= issued_at);
    if (t.short_count >= till_max_shorts) return error.TooManyShorts;
    const at = t.short_count;
    tally_copy.copy_disjoint(u8, t.shorts[at].signer_pk[0..], fact.signer_pk[0..]);
    t.shorts[at].amount = fact.amount;
    t.shorts[at].pos = pos;
    t.shorts[at].issued_at = issued_at;
    t.short_count += 1;
}

/// Resolve a committed Dag into a Till — the treasury verdict of the agreed order.
/// A spend the order cannot pay yet could once afford (amount <= issued-so-far) is a
/// lawful no-op spent-out loss; a spend that never could pay, a broken signature, an
/// unknown kind, a name-contest, and an issue wrap each refuse the whole resolution.
pub fn resolve(dag: *const cord.Dag) error{
    IdentityRefused,
    UnknownKind,
    Overdraw,
    StarTaken,
    LogFull,
    TooManyDraws,
    TooManyShorts,
}!Till {
    // invariant: each block carries one fact, so the Dag fits the fold ceiling.
    assert(dag.len <= fold.myc_log_max_facts);
    var order: [cord.cord_max_blocks]u32 = undefined;
    // invariant: the order buffer holds the whole Dag.
    assert(order.len >= dag.len);
    const committed = cord.commit(dag, order[0..]);

    var t = Till{};
    var state = fold.FoldState{};
    var i: u32 = 0;
    while (i < committed) : (i += 1) {
        const idx = order[i];
        // invariant: every committed index names a real seat.
        assert(idx < dag.len);
        const blk = &dag.blocks[idx];
        const fact = &blk.fact;
        // The treasury's issue at this position — the high-water measure that tells
        // a lost race (coins once existed) from a demand no order could ever meet.
        const issued_here = state.issued;
        if (fold.fold_fact(&state, fact)) |_| {
            // Accepted — a spend the order granted took coins; an issue only funds.
            if (fact.kind == fold.kind_tax or fact.kind == fold.kind_star_reserve) {
                try record_draw(&t, fact, i, blk.round);
            }
        } else |err| switch (err) {
            error.Overdraw => {
                // The verdict: a spend that once could have been paid (amount <=
                // issued-so-far) but lost the race to an earlier winning draw is a
                // lawful no-op — folding continues, the ledger unbroken. A spend that
                // asked for more than the treasury ever issued, or an issue wrap, was
                // never a race and refuses the whole resolution.
                const is_spend = fact.kind == fold.kind_tax or fact.kind == fold.kind_star_reserve;
                if (is_spend and fact.amount <= issued_here) {
                    try record_short(&t, fact, i, issued_here);
                } else {
                    return error.Overdraw;
                }
            },
            // Corruption is not a verdict — it refuses the whole resolution. A name
            // contest is the Tenure's verdict, not the Till's, so it refuses here.
            error.IdentityRefused => return error.IdentityRefused,
            error.UnknownKind => return error.UnknownKind,
            error.StarTaken => return error.StarTaken,
            error.LogFull => return error.LogFull,
        }
    }
    t.state = state;
    // invariant: the resolved state keeps the supply law.
    assert(t.state.taxed <= t.state.issued);
    return t;
}

// ---- selftest: the crux is a contested draw decided by the agreed order ------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

fn resolve_perm(blocks: []const cord.Block) !Till {
    var dag = cord.Dag.empty();
    for (blocks) |blk| try cord.add(&dag, blk);
    return resolve(&dag);
}

fn draw_amount_of(t: *const Till, pk: []const u8) ?u64 {
    var i: u32 = 0;
    while (i < t.draw_count) : (i += 1) {
        if (std.mem.eql(u8, t.draws[i].signer_pk[0..], pk)) return t.draws[i].amount;
    }
    return null;
}

fn tills_equal(x: *const Till, y: *const Till) bool {
    if (x.draw_count != y.draw_count) return false;
    if (x.short_count != y.short_count) return false;
    if (x.state.issued != y.state.issued) return false;
    if (x.state.taxed != y.state.taxed) return false;
    if (x.total_lost() != y.total_lost()) return false;
    // The loser is the coin verdict's fingerprint — one signer came up short.
    var i: u32 = 0;
    while (i < x.short_count) : (i += 1) {
        if (!std.mem.eql(u8, x.shorts[i].signer_pk[0..], y.shorts[i].signer_pk[0..])) return false;
        if (x.shorts[i].amount != y.shorts[i].amount) return false;
    }
    return true;
}

pub fn main() !void {
    const kf = seeded(0xA1); // funder / genesis issue
    const kv = seeded(0xC3); // uncontested draw
    const kx = seeded(0x11); // contestant X — draws 700
    const ky = seeded(0x22); // contestant Y — draws 700

    // A bounded treasury of 1000; three draws want 1500 — two fit, one comes short.
    const f_issue = fold.mint_fact(kf, fold.kind_issue, 1000, "", "genesis") orelse return error.MintIssue;
    const f_vega = fold.mint_fact(kv, fold.kind_tax, 100, "", "small") orelse return error.MintVega;
    const f_bx = fold.mint_fact(kx, fold.kind_tax, 700, "", "draw-x") orelse return error.MintBx;
    const f_by = fold.mint_fact(ky, fold.kind_tax, 700, "", "draw-y") orelse return error.MintBy;

    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_issue) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const roots = [_][cord.hash_len]u8{hg};

    const u = cord.mint_block(kv, 1, roots[0..], f_vega) orelse return error.BlockU;
    const w1 = cord.mint_block(kx, 1, roots[0..], f_bx) orelse return error.BlockW1;
    const w2 = cord.mint_block(ky, 1, roots[0..], f_by) orelse return error.BlockW2;

    // The contest is between the two 700-draws; the earlier-sorting key folds first
    // and takes its coins, the later-sorting key faces a drained treasury and loses.
    const pkx = kx.public_key.toBytes();
    const pky = ky.public_key.toBytes();
    const x_wins = std.mem.order(u8, pkx[0..], pky[0..]) == .lt;
    const winner_pk = if (x_wins) pkx else pky;
    const loser_pk = if (x_wins) pky else pkx;
    const pkv = kv.public_key.toBytes();

    // Three arrival permutations of the round-1 blocks (g always first — its children
    // reference it, so it must be held before they can be admitted).
    const p1 = [_]cord.Block{ g, u, w1, w2 };
    const p2 = [_]cord.Block{ g, w2, w1, u };
    const p3 = [_]cord.Block{ g, w1, u, w2 };

    const t1 = try resolve_perm(p1[0..]);
    const t2 = try resolve_perm(p2[0..]);
    const t3 = try resolve_perm(p3[0..]);

    // The verdict: two draws take coins, exactly one comes up short — every arrival.
    if (t1.draws_seen() != 2) return error.DrawCount;
    if (t1.shorts_seen() != 1) return error.ShortCount;

    // The uncontested small draw and the winning contestant each took their coins.
    if (draw_amount_of(&t1, pkv[0..]) != 100) return error.SmallDrawAbsent;
    if (draw_amount_of(&t1, winner_pk[0..]) != 700) return error.WinnerDrawAbsent;

    // The loser holds no draw and is recorded as a spent-out loss for its full ask.
    if (draw_amount_of(&t1, loser_pk[0..]) != null) return error.LoserDrewCoins;
    const lost = t1.short_at(0) orelse return error.NoShort;
    if (!std.mem.eql(u8, lost.signer_pk[0..], loser_pk[0..])) return error.WrongLoser;
    if (lost.amount != 700) return error.ShortAmount;
    // The loss was lawful — it asked for no more than the treasury ever issued.
    if (lost.amount > lost.issued_at) return error.LossNotLawful;

    // The loser is a lawful no-op: the resolution succeeds, the treasury folds once
    // to one honest supply (1000 issued − 100 − 700 drawn = 200), the loss paid nothing.
    if (t1.state.issued != 1000) return error.Issued;
    if (t1.state.taxed != 800) return error.Taxed;
    if (t1.state.supply() != 200) return error.Supply;
    if (t1.total_drawn() != 800) return error.TotalDrawn;
    if (t1.total_lost() != 700) return error.TotalLost;

    // Arrival-order independence: the whole coin verdict is identical across arrivals.
    if (!tills_equal(&t1, &t2)) return error.ArrivalChangedVerdict;
    if (!tills_equal(&t1, &t3)) return error.ArrivalChangedVerdict;

    // Never-could-pay still poisons: a draw for more than the treasury ever issued
    // refuses the whole resolution — that was never a race, only a demand unmet.
    const f_greedy = fold.mint_fact(kv, fold.kind_tax, 5000, "", "never-pays") orelse return error.MintGreedy;
    const greedy_block = cord.mint_block(kv, 1, roots[0..], f_greedy) orelse return error.BlockGreedy;
    var d_greedy = cord.Dag.empty();
    try cord.add(&d_greedy, g);
    try cord.add(&d_greedy, greedy_block);
    if (resolve(&d_greedy)) |_| return error.GreedyAdmitted else |err| {
        if (err != error.Overdraw) return error.WrongGreedy;
    }

    // Corruption still poisons: a block validly authored yet carrying a fact whose
    // OWN signature is broken refuses the whole resolution.
    var f_bad = f_vega;
    f_bad.sig[0] ^= 0xff;
    const bad_block = cord.mint_block(kv, 1, roots[0..], f_bad) orelse return error.MintBad;
    var d_bad = cord.Dag.empty();
    try cord.add(&d_bad, g);
    try cord.add(&d_bad, bad_block);
    if (resolve(&d_bad)) |_| return error.PoisonAdmitted else |err| {
        if (err != error.IdentityRefused) return error.WrongPoison;
    }

    print("till: two keepers each draw 700 from a treasury of 1000; the agreed order pays one\n", .{});
    print("till: the same keeper comes up short across three arrival orders — the verdict is deterministic\n", .{});
    print("till: the loser is a lawful no-op — the small draw still holds, supply folds to {d}, the loss recorded\n", .{t1.state.supply()});
    print("till: a never-could-pay draw and a broken-fact block each refuse the whole resolution\n", .{});
    print("GREEN: myc till — contested draw decided by the agreed order · drew={d} · short={d} · refuse whole\n", .{ t1.draws_seen(), t1.shorts_seen() });
}
