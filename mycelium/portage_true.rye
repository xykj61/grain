//! mycelium/portage_true.rye — a real portage record reads true, and is the receipt of a real crossing (r4,
//! the arc closes).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · Portage · rung r4 — reads true.
//! Design read: active-designing/date/20260813/20260813-124159_mycelium-portage-cross-world-transfer-exploration.md
//!
//! r1 proved value crosses two worlds and the pair conserves, r2 made the crossing atomic, r3 let it travel as
//! text — all over worlds seated in code. r4 carries the reader onto a REAL on-disk `format portage-v1` record
//! a keeper can open and read — `tools/fixtures/portage_record.bron`, produced reproducibly by
//! `mycelium/portage_fixture_gen.rye`, `@embedFile`-bound at compile time through the `mycelium/corpora/`
//! symlink (no network).
//!
//! Two crux checks make the reading true to the bytes:
//!   - TWO TOOLS, ONE ANSWER — the app parses the record and derives the crossing's value INDEPENDENTLY of the
//!     record's own amount field (by accepting the crossing against both worlds' real rebuilt ledgers, reading
//!     the amount off World A's burn) and the digest from the crossing's own content seeds; the r4 witness
//!     cross-checks the pair `<amount> <digest8>` against `portage_record_truth.awk`'s reading of the same
//!     bytes, so a carried crossing can never drift from a record a keeper reads by hand.
//!   - THE RECORD IS THE RECEIPT OF A REAL CROSSING — the app rebuilds World A and World B from the fixture's
//!     own seeds, and `accept` ties the parsed record to both real ledgers: the digest self-certifies its
//!     bound fields, the out-head is World A's real order-head with a matching burn, the in-head is World B's
//!     real order-head crediting the recipient under this digest. So the fixture is what a real crossing emits,
//!     not a hand-mock.
//! Genuineness beyond that: re-rendering the parsed record reproduces the embedded bytes (a fixed point), and a
//! tampered header refuses `BadFormat`.
//!
//! Composes portage + portage_bron + portage_fixture_gen + cord + kumara public API only. Siloed, dev-only,
//! demo world/keeper seeds — no real key, no funds, no network, no value crossed.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/portage_true.rye selftest
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/portage_true.rye measure

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const portage = @import("portage.rye");
const portage_bron = @import("portage_bron.rye");
const gen = @import("portage_fixture_gen.rye");
const cord = @import("cord.rye");
const kumara = @import("kumara.rye");

pub const portage_true_version = "20260813.124159";

const real_record = @embedFile("corpora/portage_record.bron");

/// Parse the real record off the embedded fixture bytes.
fn read_record() !portage_bron.Record {
    var r: portage_bron.Record = undefined;
    try portage_bron.parse(real_record, &r);
    return r;
}

/// The first eight hex characters of a digest — the prefix a keeper reads off the record and the awk reports.
fn digest8(d: []const u8, out: *[8]u8) void {
    // invariant: eight hex chars read four whole digest bytes.
    assert(d.len >= 4);
    const hex = "0123456789abcdef";
    var i: u32 = 0;
    while (i < 4) : (i += 1) {
        out[i * 2] = hex[d[i] >> 4];
        out[i * 2 + 1] = hex[d[i] & 0x0F];
    }
}

/// Derive the crossing's value and digest INDEPENDENTLY of the record's own fields: the amount from accepting
/// the crossing against both worlds' real rebuilt ledgers (World A's burn), the digest from the crossing's own
/// content seeds. The app's answer for the two-tools cross-check.
fn derive_answer(amount_out: *u64, d8_out: *[8]u8) !void {
    const r = try read_record();
    var dag_a = try gen.seat_source_dag();
    var dag_b = try gen.seat_dest_dag();
    const accepted = try portage_bron.accept(&r, &dag_a, &dag_b);
    const d = gen.crossing_digest();
    amount_out.* = accepted.amount;
    digest8(d[0..], d8_out);
}

/// The reading of the real record is true to the bytes AND is the receipt of a real crossing: the parsed
/// record accepts against both freshly-rebuilt worlds, and its digest and two heads match the freshly-derived
/// ones byte for byte.
fn welcome_reading_true_and_real() !void {
    const r = try read_record();
    var dag_a = try gen.seat_source_dag();
    var dag_b = try gen.seat_dest_dag();

    // accept ties the parsed record to both real ledgers — self-certifying digest, both heads, matching burn.
    const accepted = try portage_bron.accept(&r, &dag_a, &dag_b);
    if (accepted.amount != gen.amount) return error.RecordNotReal;

    // The record carries exactly the real crossing's digest and both worlds' real heads.
    const fresh_d = gen.crossing_digest();
    if (!std.mem.eql(u8, r.digest[0..], fresh_d[0..])) return error.RecordNotReal;
    var ha: [portage_bron.head_len]u8 = undefined;
    portage.world_head(&dag_a, &ha);
    if (!std.mem.eql(u8, r.out_head[0..], ha[0..])) return error.RecordNotReal;
    var hb: [portage_bron.head_len]u8 = undefined;
    portage.world_head(&dag_b, &hb);
    if (!std.mem.eql(u8, r.in_head[0..], hb[0..])) return error.RecordNotReal;

    var d8: [8]u8 = undefined;
    digest8(fresh_d[0..], &d8);
    print("portage-true: truth-answer {d} {s}\n", .{ accepted.amount, d8 });
    print("portage-true: the reading of the real record — the crossing's value and digest — matches an independent derivation from both worlds' real ledgers, and the record is the receipt of a real crossing (its digest self-certifies, its heads accept the real ledgers with a matching burn).\n", .{});
}

/// The record is genuinely what the Portage renders: re-rendering the parsed record reproduces the embedded
/// bytes exactly (a fixed point), so the fixture is not a hand-mock.
fn welcome_record_is_really_portage() !void {
    const r = try read_record();
    var buf: [portage_bron.max_record]u8 = undefined;
    const len = try portage_bron.render(&r, buf[0..]);
    // invariant: the re-render honors the record bound.
    assert(len <= portage_bron.max_record);
    if (!std.mem.eql(u8, buf[0..len], real_record)) return error.NotFixedPoint;
    print("portage-true: the record re-renders to the embedded bytes exactly — the fixture is what the Portage emits, never a hand-mock.\n", .{});
}

/// A tampered record refuses: a wrong header is caught before any field is read.
fn unwelcome_tampered_record_refuses() !void {
    const bad = "format portage-v2\nid 2c\n";
    var r: portage_bron.Record = undefined;
    if (portage_bron.parse(bad, &r)) |_| return error.TamperAdmitted else |err| {
        if (err != error.BadFormat) return error.WrongTamper;
    }
    print("portage-true: a tampered header refused BadFormat.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_and_real();
    try welcome_record_is_really_portage();
    try unwelcome_tampered_record_refuses();
    print("portage_true {s} — GREEN\n", .{portage_true_version});
    print("GREEN: myc portage r4; the reading of a real portage record is true to the bytes (value·digest, app == awk), the record the receipt of a real crossing whose heads accept both real ledgers, its record a fixed point. The Portage agent-doable arc closes.\n", .{});
    return 0;
}

fn run_measure() !u8 {
    var amount_out: u64 = 0;
    var d8: [8]u8 = undefined;
    try derive_answer(&amount_out, &d8);
    print("{d} {s}\n", .{ amount_out, d8 });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: portage-true selftest | measure\n", .{});
    return 1;
}
