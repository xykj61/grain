//! mycelium/chorus.rye -- the Chorus: a quorum of independent Vouchers, a position believed when
//! distinct nodes agree (r1, the crux).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - the Chorus - rung r1 -- the crux.
//! Design read: active-designing/date/20260813/20260813-102533_mycelium-chorus-quorum-attestation-exploration.md
//!
//! The Voucher made a holder's position PROVABLE under one node's signature -- a node reads an account's
//! Statement out of a Dag and signs it, bound to the order-head the reading was taken against. Yet a
//! verifier who does not hold the blocks (the ordinary case, since the whole point of a proof is that you
//! need not obtain the ledger) must simply TRUST that the single signing node read the ledger faithfully.
//! One node can sign a position it never honestly derived.
//!
//! The Chorus fills that blind spot: a bounded quorum of independent Vouchers for the SAME account
//! position at the SAME order-head. Where the Voucher is one node's word, the Chorus is a threshold of
//! independent words that agree -- a stranger who trusts no single node trusts that `threshold` distinct
//! nodes all read the same position against the same agreed order. The crux `verify_chorus(threshold)`
//! passes exactly when:
//!   - every member's signature holds offline against its own node key (else BadSignature);
//!   - every member names the one claimed order-head - account - position (else Disagreement);
//!   - the signers are distinct -- no node counts twice, so one voice cannot manufacture a quorum
//!     (a repeated signer refuses DuplicateNode: Sybil-by-repetition cannot inflate belief);
//!   - the distinct count meets the threshold (else BelowThreshold -- a thin quorum is not yet believed).
//! And `check_against(dag)`, for a verifier who DOES hold the blocks, re-derives the order-head and
//! re-reads the Statement once and confirms the one claim is true. Arrival-independence is inherited from
//! the Voucher: a chorus gathered against one arrival permutation verifies and checks against another.
//!
//! Composes voucher - cord - lapse - statement - kumara public API only, editing none; the quorum law is
//! the Chorus's own bounded fold over its member set. Siloed, dev-only, demo seeds -- no real key, no
//! funds, no network, no custody. A SERVED chorus (a holder fetching several nodes' attestations over
//! Comlink) reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/chorus.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const lapse = @import("lapse.rye");
const statement = @import("statement.rye");
const kumara = @import("kumara.rye");
const voucher = @import("voucher.rye");
const tally_copy = @import("tally_copy.rye");

pub const chorus_version = "20260813.102533";

/// A node key and an account key are each a full encoded holder identity, the width the ledger seats.
pub const pk_len: u32 = voucher.pk_len;

/// An order-head is one block-address-width digest of the whole agreed order.
pub const order_head_len: u32 = voucher.order_head_len;

/// A quorum is bounded -- at most this many independent voices gather into one Chorus.
pub const chorus_max_members: u32 = 16;

pub const ChorusError = error{
    TooManyMembers, // the member set is full — a quorum never grows past its bound
    BadSignature, // a member's signature did not verify offline over its own bound facts
    Disagreement, // a member attests a different order-head, account, or position than the claim
    DuplicateNode, // a node key appears twice — one voice cannot count as many
    BelowThreshold, // fewer than `threshold` distinct honest agreeing voices — a thin quorum
};

/// A bounded quorum of independent Vouchers for one account position at one order-head. The Chorus
/// carries the single CLAIM the quorum is asked to attest -- order-head - account - position -- and the
/// MEMBERS, each an independent node's signed slip. It invents no attestation of its own; its trust is
/// exactly the gathered agreement of its members' Voucher signatures.
pub const Chorus = struct {
    order_head: [order_head_len]u8 = undefined,
    account_pk: [pk_len]u8 = undefined,
    balance: u64 = 0,
    reserved: u64 = 0,
    received: u64 = 0,
    members: [chorus_max_members]voucher.Voucher = undefined,
    count: u32 = 0,

    /// The account key whose position this quorum attests.
    pub fn account_slice(c: *const Chorus) []const u8 {
        // invariant: a chorus always names a full-width account key.
        assert(pk_len == voucher.pk_len);
        return c.account_pk[0..pk_len];
    }

    /// The order-head the whole quorum is bound to.
    pub fn head_slice(c: *const Chorus) []const u8 {
        // invariant: an order-head is exactly one block-address width.
        assert(order_head_len == cord.hash_len);
        return c.order_head[0..order_head_len];
    }
};

/// Open a Chorus over one Dag for one account -- the CLAIM is the true reading: the Dag's own order-head
/// and the account's Statement position. Honest members added afterward agree by construction; the
/// quorum law then proves they do independently. No member is gathered yet.
pub fn open(dag: *const cord.Dag, account_pk: []const u8) !Chorus {
    // invariant: a chorus opens over a full holder identity.
    assert(account_pk.len == pk_len);
    var c = Chorus{ .count = 0 };
    voucher.order_head_of(dag, &c.order_head);
    tally_copy.copy_disjoint(u8, c.account_pk[0..], account_pk);

    const ledger = try lapse.resolve(dag);
    const s = try statement.statement_for(&ledger, account_pk);
    c.balance = s.balance;
    c.reserved = s.reserved;
    c.received = s.received;
    // invariant: an opened chorus carries a claim and no members yet.
    assert(c.count == 0);
    return c;
}

/// Gather one node's independent voice: make a Voucher over the same Dag for the chorus's account and
/// append it. Refuses TooManyMembers past the bound rather than growing.
pub fn add(c: *Chorus, dag: *const cord.Dag, node_kp: kumara.KeyPair) !void {
    // invariant: the member set honors its static bound.
    assert(c.count <= chorus_max_members);
    if (c.count >= chorus_max_members) return error.TooManyMembers;
    const v = try voucher.make_voucher(dag, node_kp, c.account_slice());
    c.members[c.count] = v;
    c.count += 1;
    // invariant: gathering one voice grows the count by exactly one.
    assert(c.count <= chorus_max_members);
}

/// Append an already-made Voucher as a member -- the seam a caller uses to gather a voice made elsewhere,
/// or (in a witness) a forged or disagreeing one the quorum law must refuse. Refuses TooManyMembers.
pub fn add_voucher(c: *Chorus, v: voucher.Voucher) !void {
    // invariant: the member set honors its static bound.
    assert(c.count <= chorus_max_members);
    if (c.count >= chorus_max_members) return error.TooManyMembers;
    c.members[c.count] = v;
    c.count += 1;
    // invariant: appending one voice grows the count by exactly one.
    assert(c.count <= chorus_max_members);
}

/// Does a member attest the chorus's one claim -- the same order-head, account, and position?
fn agrees(c: *const Chorus, v: *const voucher.Voucher) bool {
    if (!std.mem.eql(u8, v.head_slice(), c.head_slice())) return false;
    if (!std.mem.eql(u8, v.account_slice(), c.account_slice())) return false;
    return v.balance == c.balance and v.reserved == c.reserved and v.received == c.received;
}

/// The crux: a position is believed when at least `threshold` distinct, independent nodes have each
/// honestly signed the one claimed reading. Every member verifies offline (else BadSignature); every
/// member agrees on the one claim (else Disagreement); the signers are distinct -- a repeated node refuses
/// DuplicateNode, so one voice cannot manufacture a quorum; and the distinct count meets the threshold
/// (else BelowThreshold).
pub fn verify_chorus(c: *const Chorus, threshold: u32) ChorusError!void {
    // invariant: a quorum is read over a bounded member set.
    assert(c.count <= chorus_max_members);
    // invariant: a meaningful threshold asks for at least one voice.
    assert(threshold >= 1);

    // 1. Every member's signature holds offline over its own bound facts.
    var i: u32 = 0;
    while (i < c.count) : (i += 1) {
        voucher.verify_voucher(&c.members[i]) catch return error.BadSignature;
    }
    // 2. Every member attests the one claim -- one position, never a blur of several.
    i = 0;
    while (i < c.count) : (i += 1) {
        if (!agrees(c, &c.members[i])) return error.Disagreement;
    }
    // 3. The signers are distinct -- no node key counts twice.
    i = 0;
    while (i < c.count) : (i += 1) {
        var j: u32 = i + 1;
        while (j < c.count) : (j += 1) {
            if (std.mem.eql(u8, c.members[i].node_slice(), c.members[j].node_slice())) {
                return error.DuplicateNode;
            }
        }
    }
    // 4. The distinct count meets the threshold -- a thin quorum is not yet believed.
    if (c.count < threshold) return error.BelowThreshold;
}

/// For a verifier who holds the blocks: re-derive the order-head and re-read the Statement from the given
/// Dag once, and confirm the chorus's single claim is the true one -- reusing the Voucher's own
/// check-against property for the whole quorum at one cost. Returns false on any disagreement.
pub fn check_against(c: *const Chorus, dag: *const cord.Dag) !bool {
    // invariant: the claimed account is a full holder identity.
    assert(c.account_slice().len == pk_len);
    var head: [order_head_len]u8 = undefined;
    voucher.order_head_of(dag, &head);
    if (!std.mem.eql(u8, head[0..], c.order_head[0..])) return false;

    const ledger = try lapse.resolve(dag);
    const s = try statement.statement_for(&ledger, c.account_slice());
    // invariant: a matching chorus agrees on every projected field, not merely the balance.
    return s.balance == c.balance and s.reserved == c.reserved and s.received == c.received;
}

// --- a bounded render a keeper reads --------------------------------------

const hex_digits = "0123456789abcdef";

fn hex8(bytes: []const u8, out: []u8) void {
    // invariant: eight bytes render to sixteen nibbles -- a short, legible fingerprint.
    assert(out.len == 16);
    assert(bytes.len >= 8);
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0f];
    }
}

/// Print a chorus a keeper can read -- the claim (order-head, account, position) and the count of voices.
pub fn render(c: *const Chorus) void {
    var hfp: [16]u8 = undefined;
    var afp: [16]u8 = undefined;
    hex8(c.head_slice(), &hfp);
    hex8(c.account_slice(), &afp);
    print("chorus head={s} account={s} balance={d} reserved={d} received={d} voices={d}\n", .{
        hfp, afp, c.balance, c.reserved, c.received, c.count,
    });
}

// --- selftest: a position is believed when a threshold of distinct nodes agree ------------------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

fn write_deadline(deadline: u64, out: []u8) void {
    // invariant: the buffer holds a full little-endian order position.
    assert(out.len == lapse.deadline_len);
    var v = deadline;
    var i: u32 = 0;
    while (i < lapse.deadline_len) : (i += 1) {
        out[i] = @truncate(v);
        v >>= 8;
    }
}

fn pledge_body(id: []const u8, deadline: u64, to: []const u8, out: []u8) u32 {
    // invariant: the buffer holds tag - id - deadline - recipient exactly.
    assert(out.len >= 1 + lapse.id_len + lapse.deadline_len + pk_len);
    assert(id.len == lapse.id_len);
    out[0] = lapse.tag_pledge;
    tally_copy.copy_disjoint(u8, out[1 .. 1 + lapse.id_len], id);
    write_deadline(deadline, out[1 + lapse.id_len .. 1 + lapse.id_len + lapse.deadline_len]);
    tally_copy.copy_disjoint(u8, out[1 + lapse.id_len + lapse.deadline_len ..][0..pk_len], to);
    return 1 + lapse.id_len + lapse.deadline_len + pk_len;
}

fn resolve_body(tag: u8, id: []const u8, out: []u8) u32 {
    // invariant: the buffer holds tag - id exactly.
    assert(out.len >= 1 + lapse.id_len);
    assert(id.len == lapse.id_len);
    out[0] = tag;
    tally_copy.copy_disjoint(u8, out[1 .. 1 + lapse.id_len], id);
    return 1 + lapse.id_len;
}

/// Seat a scene -- the same block-building the Voucher's own selftest proved. Returns four blocks
/// (genesis - pledge - post - void); a caller resolves the prefix it wants.
fn seat_scene(id: []const u8, deadline: u64) ![4]cord.Block {
    const kf = seeded(0xF0);
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const bob_pk = kb.public_key.toBytes();
    const alice_pk = ka.public_key.toBytes();

    const f_gen = fold.mint_fact(kf, fold.kind_issue, 100, "", alice_pk[0..]) orelse return error.MintGen;

    var pb: [1 + lapse.id_len + lapse.deadline_len + pk_len]u8 = undefined;
    const pn = pledge_body(id, deadline, bob_pk[0..], &pb);
    const f_pledge = fold.mint_fact(ka, fold.kind_tax, 100, "", pb[0..pn]) orelse return error.MintPledge;

    var hb: [1 + lapse.id_len]u8 = undefined;
    const hn = resolve_body(lapse.tag_post, id, &hb);
    const f_post = fold.mint_fact(ka, fold.kind_tax, 100, "", hb[0..hn]) orelse return error.MintPost;

    var vb: [1 + lapse.id_len]u8 = undefined;
    const vn = resolve_body(lapse.tag_void, id, &vb);
    const f_void = fold.mint_fact(ka, fold.kind_tax, 100, "", vb[0..vn]) orelse return error.MintVoid;

    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const roots = [_][cord.hash_len]u8{hg};

    const bp = cord.mint_block(ka, 1, roots[0..], f_pledge) orelse return error.BlockP;
    var hp: [cord.hash_len]u8 = undefined;
    cord.address(&bp, &hp);
    const roots2 = [_][cord.hash_len]u8{hp};

    const bpost = cord.mint_block(ka, 2, roots2[0..], f_post) orelse return error.BlockPost;
    const bvoid = cord.mint_block(ka, 2, roots2[0..], f_void) orelse return error.BlockVoid;
    return .{ g, bp, bpost, bvoid };
}

fn dag_of(blocks: []const cord.Block) !cord.Dag {
    var dag = cord.Dag.empty();
    for (blocks) |blk| try cord.add(&dag, blk);
    return dag;
}

/// Three distinct honest nodes -- a small mesh that vouches together.
fn three_nodes() [3]kumara.KeyPair {
    return .{ seeded(0x11), seeded(0x22), seeded(0x33) };
}

pub fn main() !void {
    const id = [_]u8{0x01} ** lapse.id_len;
    const nodes = three_nodes();
    const alice_pk = seeded(0xA1).public_key.toBytes();

    // Scene 1 -- an OPEN pledge stands. Three distinct nodes each vouch Alice's position (balance 0,
    // reserved 100, received 100) at the two-block order-head. The chorus believes at threshold 3 and 2,
    // refuses BelowThreshold at 4, and checks against the very ledger it vouches.
    {
        const s = try seat_scene(id[0..], 9);
        const dag = try dag_of(&[_]cord.Block{ s[0], s[1] });
        var c = try open(&dag, alice_pk[0..]);
        for (nodes) |n| try add(&c, &dag, n);
        if (c.balance != 0 or c.reserved != 100 or c.received != 100) return error.OpenClaim;
        try verify_chorus(&c, 3);
        try verify_chorus(&c, 2);
        if (verify_chorus(&c, 4)) |_| return error.ThinQuorumBelieved else |err| {
            if (err != error.BelowThreshold) return error.WrongThin;
        }
        if (!try check_against(&c, &dag)) return error.OpenCheck;
    }

    // Scene 2 -- a POSTED pledge. Alice's reserved returns to 0; three nodes vouch the new position at the
    // three-block order-head, believed at threshold 2, and it checks against that longer order.
    {
        const s = try seat_scene(id[0..], 9);
        const dag = try dag_of(&[_]cord.Block{ s[0], s[1], s[2] });
        var c = try open(&dag, alice_pk[0..]);
        for (nodes) |n| try add(&c, &dag, n);
        if (c.reserved != 0) return error.PostedReserved;
        try verify_chorus(&c, 2);
        if (!try check_against(&c, &dag)) return error.PostedCheck;
    }

    // Scene 3 -- a LAPSED pledge: the clock lapses first, Alice's coins come home (balance 100, reserved
    // 0). Three nodes vouch the returned position, believed at the full threshold 3, and it checks true.
    {
        const s = try seat_scene(id[0..], 2);
        const dag = try dag_of(&[_]cord.Block{ s[0], s[1], s[2], s[3] });
        var c = try open(&dag, alice_pk[0..]);
        for (nodes) |n| try add(&c, &dag, n);
        if (c.balance != 100 or c.reserved != 0) return error.LapsedClaim;
        try verify_chorus(&c, 3);
        if (!try check_against(&c, &dag)) return error.LapsedCheck;
    }

    // Scene 4 -- arrival-independence inherited. A chorus gathered against one permutation of the round-2
    // facts VERIFIES and CHECKS AGAINST the other permutation: every honest member folds to one
    // order-head and reads one position. The quorum binds the agreed order, not the arrival.
    {
        const s = try seat_scene(id[0..], 2);
        const dag_a = try dag_of(&[_]cord.Block{ s[0], s[1], s[2], s[3] });
        const dag_b = try dag_of(&[_]cord.Block{ s[0], s[1], s[3], s[2] });
        var c = try open(&dag_a, alice_pk[0..]);
        for (nodes) |n| try add(&c, &dag_a, n);
        try verify_chorus(&c, 3);
        // The head opened from one arrival equals the head folded from the other.
        var hb: [order_head_len]u8 = undefined;
        voucher.order_head_of(&dag_b, &hb);
        if (!std.mem.eql(u8, c.order_head[0..], hb[0..])) return error.PermHead;
        if (!try check_against(&c, &dag_b)) return error.PermCheck;
    }

    // Scene 5 -- the quorum law refuses. A thin quorum, a repeated signer that cannot inflate the count,
    // a disagreeing voice, and a forged voice each hold the reading back.
    {
        const s = try seat_scene(id[0..], 9);
        const dag = try dag_of(&[_]cord.Block{ s[0], s[1], s[2] });

        // BelowThreshold -- two distinct honest voices cannot meet a threshold of three.
        {
            var c = try open(&dag, alice_pk[0..]);
            try add(&c, &dag, nodes[0]);
            try add(&c, &dag, nodes[1]);
            if (verify_chorus(&c, 3)) |_| return error.ThinBelieved else |err| {
                if (err != error.BelowThreshold) return error.WrongBelow;
            }
        }

        // DuplicateNode -- a repeated signer cannot inflate a two-voice quorum to three. The same honest
        // node vouches twice; the quorum law refuses rather than counting one voice as many.
        {
            var c = try open(&dag, alice_pk[0..]);
            try add(&c, &dag, nodes[0]);
            try add(&c, &dag, nodes[1]);
            try add(&c, &dag, nodes[0]); // node 0 again — Sybil-by-repetition
            if (verify_chorus(&c, 3)) |_| return error.DupInflated else |err| {
                if (err != error.DuplicateNode) return error.WrongDup;
            }
        }

        // Disagreement -- a voice honestly made against a DIFFERENT ledger (the open two-block order,
        // where the pledge has not posted) has a valid signature yet names a different order-head and
        // position, so the quorum refuses rather than blur two readings into one.
        {
            const dag_open = try dag_of(&[_]cord.Block{ s[0], s[1] });
            const stray = try voucher.make_voucher(&dag_open, nodes[2], alice_pk[0..]);
            var c = try open(&dag, alice_pk[0..]);
            try add(&c, &dag, nodes[0]);
            try add(&c, &dag, nodes[1]);
            try add_voucher(&c, stray);
            if (verify_chorus(&c, 3)) |_| return error.DisagreeBelieved else |err| {
                if (err != error.Disagreement) return error.WrongDisagree;
            }
        }

        // BadSignature -- a forged voice (an honest member with its balance flipped) breaks its own
        // signature, so the quorum refuses before it is trusted.
        {
            var c = try open(&dag, alice_pk[0..]);
            try add(&c, &dag, nodes[0]);
            try add(&c, &dag, nodes[1]);
            var forged = try voucher.make_voucher(&dag, nodes[2], alice_pk[0..]);
            forged.balance += 1;
            try add_voucher(&c, forged);
            if (verify_chorus(&c, 3)) |_| return error.ForgeBelieved else |err| {
                if (err != error.BadSignature) return error.WrongForge;
            }
        }
    }

    // A last render, for eyes -- a plain open-pledge chorus of three voices.
    {
        const s = try seat_scene(id[0..], 9);
        const dag = try dag_of(&[_]cord.Block{ s[0], s[1] });
        var c = try open(&dag, alice_pk[0..]);
        for (nodes) |n| try add(&c, &dag, n);
        render(&c);
    }

    print("chorus: a chorus of distinct nodes believes a position when a threshold of them agree; it inherits arrival-independence and checks against the ledger it vouches\n", .{});
    print("chorus: a thin quorum refuses BelowThreshold, a repeated signer refuses DuplicateNode (one voice cannot manufacture a quorum), a disagreeing voice refuses Disagreement, a forged voice refuses BadSignature\n", .{});
    print("GREEN: myc chorus r1 — a quorum of independent Vouchers binds an account's position: it is believed only when a threshold of distinct nodes agree, refuses tamper (thin quorum · repeated signer · disagreement · forged voice), and inherits arrival-independence. Proof of position by quorum stands.\n", .{});
}
