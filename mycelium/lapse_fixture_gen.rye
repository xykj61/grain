//! mycelium/lapse_fixture_gen.rye -- reproducibly emit a deadline-clock Cord dev-net fixture (r4 support).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - the Lapse - rung r4 support.
//! Design read: active-designing/date/20260813/20260813-085046_mycelium-lapse-pending-timeout-exploration.md
//!
//! Seats a real four-block scene carrying a genuine LAPSED reservation -- a pledge opened under a
//! short deadline the order reaches before it is settled, and a second pledge left standing open
//! under a far deadline. A demo funder issues a genesis credit of 200 to Alice (round 0); Alice
//! pledges 100 to Bob under deadline 2 (round 1, id 0x01...) reserving her coins; Alice posts that
//! pledge (round 2) -- yet the post rides order position 2, so the clock has reached the deadline
//! and the pledge LAPSES, the reserved hundred home to Alice, the post a no-op; Alice pledges 100
//! to Carol under a far deadline (round 3, id 0x02...) and leaves it open. The whole order is
//! unambiguous by round, so a keeper (or an awk) can walk the block lines in file order, track the
//! deadline each pledge carries, and name the same lapsed recipient, lapsed count, and open count
//! the Lapse's agreed-order resolution names. Committing and rendering to a `format cord-dag-v1`
//! record gives the exact bytes `mycelium/lapse_true.rye` reads back and the r4 witness cross-checks
//! against an independent awk reading.
//!
//! Deterministic: seeded demo keys and a pure commit mean the same bytes every run, so the on-disk
//! fixture is what the Cord emits, never a hand-mock. Emitted on stderr (hosted `print` is
//! `std.debug.print`), so capture with `2>`.
//!
//! Siloed, dev-only, demo seeds -- no real key, no funds, no network, no custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/lapse_fixture_gen.rye \
//!     2> tools/fixtures/lapse_dag.bron
//!
//! Kin: mycelium/pledge_fixture_gen.rye (the two-phase sibling).

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_bron = @import("cord_bron.rye");
const fold = @import("fold.rye");
const lapse = @import("lapse.rye");
const kumara = @import("kumara.rye");
const tally_copy = @import("tally_copy.rye");

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

fn write_deadline(deadline: u64, out: []u8) void {
    // invariant: the buffer holds a full little-endian order position.
    assert(out.len == lapse.deadline_len);
    var v = deadline;
    var i: u32 = 0;
    while (i < lapse.deadline_len) : (i += 1) {
        out[i] = @truncate(v);
        v >>= 8;
    }
}

fn pledge_body(id: []const u8, deadline: u64, to: []const u8, out: []u8) u32 {
    // invariant: the buffer holds tag - id - deadline - recipient exactly.
    assert(out.len >= 1 + lapse.id_len + lapse.deadline_len + lapse.pk_len);
    assert(id.len == lapse.id_len);
    out[0] = lapse.tag_pledge;
    tally_copy.copy_disjoint(u8, out[1 .. 1 + lapse.id_len], id);
    write_deadline(deadline, out[1 + lapse.id_len .. 1 + lapse.id_len + lapse.deadline_len]);
    tally_copy.copy_disjoint(u8, out[1 + lapse.id_len + lapse.deadline_len ..][0..lapse.pk_len], to);
    return 1 + lapse.id_len + lapse.deadline_len + lapse.pk_len;
}

fn post_body(id: []const u8, out: []u8) u32 {
    // invariant: the buffer holds tag - id exactly.
    assert(out.len >= 1 + lapse.id_len);
    assert(id.len == lapse.id_len);
    out[0] = lapse.tag_post;
    tally_copy.copy_disjoint(u8, out[1 .. 1 + lapse.id_len], id);
    return 1 + lapse.id_len;
}

/// Seat the deadline four-block Dag -- genesis credits Alice 200; Alice pledges 100 to Bob under
/// deadline 2 at round 1; Alice posts it at round 2, yet the clock has reached the deadline so the
/// pledge LAPSES (coins home to Alice, the post a no-op); Alice pledges 100 to Carol under a far
/// deadline at round 3 and leaves it open.
fn seat_dag() !cord.Dag {
    const id1 = [_]u8{0x01} ** lapse.id_len;
    const id2 = [_]u8{0x02} ** lapse.id_len;
    const kf = seeded(0xF0); // demo funder / genesis credit authority
    const ka = seeded(0xA1); // Alice — the pledger
    const kb = seeded(0xB2); // Bob — the lapsed pledge's intended recipient (paid nothing)
    const kc = seeded(0xC3); // Carol — the open pledge's recipient (paid nothing yet)

    const alice_pk = ka.public_key.toBytes();
    const bob_pk = kb.public_key.toBytes();
    const carol_pk = kc.public_key.toBytes();

    const f_gen = fold.mint_fact(kf, fold.kind_issue, 200, "", alice_pk[0..]) orelse return error.MintGen;
    var pb1: [1 + lapse.id_len + lapse.deadline_len + lapse.pk_len]u8 = undefined;
    const pn1 = pledge_body(id1[0..], 2, bob_pk[0..], &pb1);
    const f_p1 = fold.mint_fact(ka, fold.kind_tax, 100, "", pb1[0..pn1]) orelse return error.MintP1;
    var hb1: [1 + lapse.id_len]u8 = undefined;
    const hn1 = post_body(id1[0..], &hb1);
    const f_post1 = fold.mint_fact(ka, fold.kind_tax, 100, "", hb1[0..hn1]) orelse return error.MintPost1;
    var pb2: [1 + lapse.id_len + lapse.deadline_len + lapse.pk_len]u8 = undefined;
    const pn2 = pledge_body(id2[0..], 9, carol_pk[0..], &pb2);
    const f_p2 = fold.mint_fact(ka, fold.kind_tax, 100, "", pb2[0..pn2]) orelse return error.MintP2;

    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const r0 = [_][cord.hash_len]u8{hg};
    const b1 = cord.mint_block(ka, 1, r0[0..], f_p1) orelse return error.BlockP1;
    var h1: [cord.hash_len]u8 = undefined;
    cord.address(&b1, &h1);
    const r1 = [_][cord.hash_len]u8{h1};
    const b2 = cord.mint_block(ka, 2, r1[0..], f_post1) orelse return error.BlockPost1;
    var h2: [cord.hash_len]u8 = undefined;
    cord.address(&b2, &h2);
    const r2 = [_][cord.hash_len]u8{h2};
    const b3 = cord.mint_block(ka, 3, r2[0..], f_p2) orelse return error.BlockP2;

    var dag = cord.Dag.empty();
    try cord.add(&dag, g);
    try cord.add(&dag, b1);
    try cord.add(&dag, b2);
    try cord.add(&dag, b3);
    return dag;
}

pub fn main() !void {
    var dag = try seat_dag();
    const pl = try cord_bron.from_dag(&dag);
    var buf: [cord_bron.max_record]u8 = undefined;
    const n = try cord_bron.render(&pl, &buf);
    // invariant: the render is bounded and non-empty -- a real record carries its header.
    assert(n > 0);
    assert(n <= cord_bron.max_record);
    print("{s}", .{buf[0..n]});
}
