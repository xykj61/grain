//! mycelium/cord_knot_fixture_gen.rye -- reproducibly emit the Knot fixture (r4 support).
//!
//! Season D (Kresfa & Mycelium) - Mycelium consensus - checkpointing - rung r4 support.
//! Design read: active-designing/date/20260813/20260813-050903_mycelium-cord-knot-checkpoint-exploration.md
//!
//! Seats the honest four-fact history r1/r2/r3 checkpoint (two genesis issues, a tax,
//! a star reserve -- issued 1000 - taxed 300 - supply 700 - one star vega), seals it to
//! a Knot, and renders that Knot to a `format cord-knot-v1` record on stderr: the exact
//! bytes `mycelium/cord_knot_true.rye` reads back and the r4 witness cross-checks
//! against an independent awk reading. Deterministic -- seeded demo keys and a pure
//! commit-and-fold mean the same bytes every run, so the on-disk fixture is what the
//! Knot emits, never a hand-mock.
//!
//! Siloed, dev-only, demo seeds -- no real key, no funds, no network, no custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/cord_knot_fixture_gen.rye \
//!     2> tools/fixtures/cord_knot.bron

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_knot = @import("cord_knot.rye");
const cord_knot_bron = @import("cord_knot_bron.rye");
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// Seat the honest four-fact history and commit it to a Cord -- the same scene the
/// Knot's selftests checkpoint.
fn seat_dag(out: *cord.Dag) !void {
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const kc = seeded(0xC3);
    const kd = seeded(0xD4);
    const fa = fold.mint_fact(ka, fold.kind_issue, 500, "", "genesis-a") orelse return error.MintA;
    const fb = fold.mint_fact(kb, fold.kind_issue, 500, "", "genesis-b") orelse return error.MintB;
    const fc = fold.mint_fact(kc, fold.kind_tax, 200, "", "tax-c") orelse return error.MintC;
    const fd = fold.mint_fact(kd, fold.kind_star_reserve, 100, "vega", "reserve") orelse return error.MintD;
    const a = cord.mint_block(ka, 0, &[_][cord.hash_len]u8{}, fa) orelse return error.BlockA;
    const b = cord.mint_block(kb, 0, &[_][cord.hash_len]u8{}, fb) orelse return error.BlockB;
    var ha: [cord.hash_len]u8 = undefined;
    var hb: [cord.hash_len]u8 = undefined;
    cord.address(&a, &ha);
    cord.address(&b, &hb);
    const roots = [_][cord.hash_len]u8{ ha, hb };
    const c = cord.mint_block(kc, 1, roots[0..], fc) orelse return error.BlockC;
    const d = cord.mint_block(kd, 1, roots[0..], fd) orelse return error.BlockD;
    out.* = cord.Dag.empty();
    try cord.add(out, a);
    try cord.add(out, b);
    try cord.add(out, c);
    try cord.add(out, d);
    // invariant: exactly four blocks carry the whole scene.
    assert(out.len == 4);
}

pub fn main() !void {
    var dag: cord.Dag = undefined;
    try seat_dag(&dag);
    const knot = try cord_knot.seal_dag(&dag);
    // invariant: the sealed scene is the honest supply the selftests checkpoint.
    assert(knot.state.supply() == 700);
    assert(knot.state.star_count == 1);
    var buf: [cord_knot_bron.max_record]u8 = undefined;
    const n = try cord_knot_bron.render(&knot, buf[0..]);
    // invariant: the render is bounded and non-empty -- a real record carries its header.
    assert(n > 0);
    assert(n <= cord_knot_bron.max_record);
    print("{s}", .{buf[0..n]});
}
