//! mycelium/constel_bron.rye — a named constellation travels as a record, self-certifying (r3).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · Constel · rung r3 — travel.
//! Design read: active-designing/20260813-132009_mycelium-constel-named-dev-net-exploration.md
//!
//! r1 booted a named constellation and reached quorum; r2 proved its fault tolerance. Both held the roster
//! in memory. A dev-net a keeper cannot hand to another is only a local fixture, so r3 lets the whole
//! constellation cross as `format constel-v1` bytes — one `ship <name> <pk-hex>` line per ship in roster
//! order. Because a ship's identity is a PURE FUNCTION of its name (r1: seed = SHA-256(name)), the record is
//! SELF-CERTIFYING: `parse` re-derives each ship's keypair from its name and refuses `PkMismatch` unless the
//! carried key is exactly the one that name yields — a tampered key cannot ride a real name.
//!
//! The crux is THE CONSTELLATION SURVIVES THE WIRE, not merely the bytes: a constellation parsed from a
//! record reaches the byte-identical quorum head as the one in memory — a keeper boots the identical
//! constellation from the record alone. Render/parse is a fixed point (byte-for-byte).
//!
//! A purpose-built bounded reader: a wrong header refuses `BadFormat`, an unknown field `UnknownField`
//! (never dropped), a malformed line `BadLine`, a bad hex key `BadHex`, a carried key that its name does not
//! yield `PkMismatch`, and the ship's own laws surface as `NameEmpty`/`NameTooLong`/`TooManyShips` on
//! rebuild. Composes constel + chorus + muster + voucher public API only. Siloed dev fixtures — no key held,
//! no funds, no network; a served constellation reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/constel_bron.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

const constel = @import("constel.rye");
const voucher = @import("voucher.rye");
const tally_copy = @import("tally_copy.rye");

pub const pk_len: u32 = constel.pk_len;
pub const head_len: u32 = constel.head_len;

/// The record buffer bound — a full twelve-ship roster's lines fit with room.
pub const max_record: u32 = 2048;

pub const BronError = error{
    BadFormat, // the header is wrong
    UnknownField, // a line names a field the record does not define
    BadLine, // a known line carries the wrong token count
    BadHex, // a ship key was the wrong length or held a non-hex char
    PkMismatch, // the carried key is not the one this ship's name yields
    RecordTooLong, // the rendered record overflowed the buffer
} || constel.ConstelError;

const hex_digits = "0123456789abcdef";

fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex chars per byte.
    assert(out.len == bytes.len * 2);
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0F];
    }
}

fn nibble(c: u8) BronError!u8 {
    return switch (c) {
        '0'...'9' => c - '0',
        'a'...'f' => c - 'a' + 10,
        'A'...'F' => c - 'A' + 10,
        else => error.BadHex,
    };
}

fn from_hex(text: []const u8, out: []u8) BronError!void {
    if (text.len != out.len * 2) return error.BadHex;
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < out.len) : (i += 1) {
        const hi = try nibble(text[i * 2]);
        const lo = try nibble(text[i * 2 + 1]);
        out[i] = (hi << 4) | lo;
    }
}

/// Render one constellation to a `format constel-v1` record — one ship line (name · key hex) in roster
/// order. Refuses an overflow rather than a partial record.
pub fn render(c: *const constel.Constel, out: []u8) BronError!u32 {
    // invariant: the render buffer honors its bound.
    assert(out.len >= max_record);
    // invariant: the roster honors its static bound.
    assert(c.count <= constel.constel_max_ships);

    const head = std.fmt.bufPrint(out, "format constel-v1\n", .{}) catch return error.RecordTooLong;
    var off: u32 = @intCast(head.len);

    var i: u32 = 0;
    while (i < c.count) : (i += 1) {
        var pk_hex: [pk_len * 2]u8 = undefined;
        const p = c.ships[i].pk();
        to_hex(p[0..], &pk_hex);
        const line = std.fmt.bufPrint(out[off..], "ship {s} {s}\n", .{ c.ships[i].name_slice(), pk_hex }) catch return error.RecordTooLong;
        off += @intCast(line.len);
    }

    // invariant: the rendered record never exceeds its bound.
    assert(off <= max_record);
    return off;
}

/// Split a line into up to three tokens; returns the count (or four to signal a token past a ship line's
/// width — a ship line, at three, is the widest).
fn tokens(line: []const u8, out: *[3][]const u8) u32 {
    var count: u32 = 0;
    var it = std.mem.tokenizeScalar(u8, line, ' ');
    while (it.next()) |t| {
        if (count >= 3) return count + 1;
        out[count] = t;
        count += 1;
    }
    return count;
}

/// Parse a `format constel-v1` record into `out`, re-seating each ship through r1's own `seat_ship` (so its
/// key is re-derived from its name) and refusing `PkMismatch` unless the carried key matches — the record
/// self-certifies, a tampered key cannot ride a real name.
pub fn parse(text: []const u8, out: *constel.Constel) BronError!void {
    var lines = std.mem.splitScalar(u8, text, '\n');
    const header = lines.next() orelse return error.BadFormat;
    if (!std.mem.eql(u8, header, "format constel-v1")) return error.BadFormat;

    out.* = constel.Constel.empty();
    while (lines.next()) |raw| {
        if (raw.len == 0) continue; // a trailing newline yields one empty line
        var tok: [3][]const u8 = undefined;
        const n = tokens(raw, &tok);
        if (n == 0) continue;
        if (std.mem.eql(u8, tok[0], "ship")) {
            if (n != 3) return error.BadLine;
            if (out.count >= constel.constel_max_ships) return error.TooManyShips;
            var carried: [pk_len]u8 = undefined;
            try from_hex(tok[2], carried[0..pk_len]);
            const s = try constel.seat_ship(tok[1]); // key re-derived from the name
            const derived = s.pk();
            if (!std.mem.eql(u8, derived[0..], carried[0..])) return error.PkMismatch;
            out.ships[out.count] = s;
            out.count += 1;
        } else {
            return error.UnknownField;
        }
    }
    // invariant: a parsed roster honors the static bound.
    assert(out.count <= constel.constel_max_ships);
}

// The r1 dev-net roster — five named ships (see constel.rye for the naming law).
const roster = [_][]const u8{
    "xnvethqua",
    "kwelmirran",
    "xzobrilth",
    "murrqaveln",
    "xwendakosh",
};

pub fn main() !void {
    var c = try constel.boot(roster[0..]);

    var buf: [max_record]u8 = undefined;
    const len = try render(&c, buf[0..]);

    var recovered: constel.Constel = undefined;
    try parse(buf[0..len], &recovered);

    // The whole roster survives the wire — same names and keys in the same order.
    assert(recovered.count == c.count);
    {
        var i: u32 = 0;
        while (i < c.count) : (i += 1) {
            assert(std.mem.eql(u8, recovered.ships[i].name_slice(), c.ships[i].name_slice()));
            const pa = c.ships[i].pk();
            const pb = recovered.ships[i].pk();
            assert(std.mem.eql(u8, pa[0..], pb[0..]));
        }
    }

    // Re-rendering the recovered constellation reproduces the exact bytes (fixed point).
    var buf2: [max_record]u8 = undefined;
    const len2 = try render(&recovered, buf2[0..]);
    assert(len2 == len);
    assert(std.mem.eql(u8, buf[0..len], buf2[0..len2]));

    // THE CRUX: a keeper boots the identical constellation from the record alone — the recovered roster
    // reaches the byte-identical quorum head as the one in memory.
    const issuer = constel.seeded(0xF0);
    const account = constel.seeded(0xA1);
    const account_pk = account.public_key.toBytes();
    var dag = try constel.demo_genesis(issuer, account_pk[0..]);

    var head_mem: [head_len]u8 = undefined;
    var head_rec: [head_len]u8 = undefined;
    try constel.reach_quorum(&c, &dag, account_pk[0..], &head_mem);
    try constel.reach_quorum(&recovered, &dag, account_pk[0..], &head_rec);
    assert(std.mem.eql(u8, head_mem[0..], head_rec[0..]));

    // And that head is the Dag's real order-head — the record boots a constellation that believes the truth.
    var expected_head: [head_len]u8 = undefined;
    voucher.order_head_of(&dag, &expected_head);
    assert(std.mem.eql(u8, head_rec[0..], expected_head[0..]));

    var scratch: constel.Constel = undefined;

    // Refusal: a wrong header refuses BadFormat before any line is read.
    if (parse("format constel-v2\n", &scratch)) |_| return error.BadHeaderAdmitted else |err| {
        if (err != error.BadFormat) return error.WrongHeader;
    }

    // Refusal: an unknown field refuses UnknownField (never dropped).
    {
        var tmp: [max_record]u8 = undefined;
        tally_copy.copy_disjoint(u8, tmp[0..len], buf[0..len]);
        const extra = "bogus x\n";
        tally_copy.copy_disjoint(u8, tmp[len .. len + extra.len], extra);
        if (parse(tmp[0 .. len + extra.len], &scratch)) |_| return error.UnknownAdmitted else |err| {
            if (err != error.UnknownField) return error.WrongUnknown;
        }
    }

    // Refusal: the self-certifying crux — a carried key its name does not yield refuses PkMismatch. Flip one
    // hex nibble of the first ship's key.
    {
        var tmp: [max_record]u8 = undefined;
        tally_copy.copy_disjoint(u8, tmp[0..len], buf[0..len]);
        // Find the first ship line's key: after "format constel-v1\n" the first line is
        // "ship <name> <64 hex>\n" — flip the last hex char before its newline.
        var k: u32 = 0;
        var nl: u32 = 0;
        while (k < len) : (k += 1) {
            if (tmp[k] == '\n') {
                nl += 1;
                if (nl == 2) break; // end of the first ship line
            }
        }
        // k indexes the newline that ends the first ship line; k-1 is the last hex char.
        const last = k - 1;
        tmp[last] = if (tmp[last] == 'a') 'b' else 'a';
        if (parse(tmp[0..len], &scratch)) |_| return error.TamperAdmitted else |err| {
            if (err != error.PkMismatch) return error.WrongTamper;
        }
    }

    print("constel-bron: GREEN — a named constellation of {d} ships travels as a format constel-v1 record and boots the identical constellation from the record alone (same quorum head as in memory, the Dag's true order-head); render/parse is a fixed point, the record self-certifies (a tampered key refuses PkMismatch), and a bad header · unknown field each refuse. The dev-net a keeper hands another keeper.\n", .{c.count});
}
