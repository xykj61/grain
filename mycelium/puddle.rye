//! mycelium/puddle.rye -- the Puddle: a fleet places each world at exactly one host by a rule every node
//! computes alike (r1, the crux).
//!
//! Season D (Kresfa & Mycelium) - Puddle fleet orchestration - rung r1 -- the berth crux.
//! Design read: active-designing/date/20260813/20260813-114651_puddle-fleet-placement-exploration.md
//!
//! The Mycelium season built how nodes AGREE -- the Cord orders a DAG, the fold sums a supply, the Muster
//! names a validator roll, the Warrant rotates it. Puddle builds the layer beneath all of it: WHICH host
//! runs WHICH world. A `Puddle` world is one bounded Rye whole with its own Pond and Kumara identity; a
//! `Host` runs many worlds up to a declared capacity; a `Fleet` is the set of both.
//!
//! Every fleet faces the trap the Warrant faced with authority: WHO decides the placement? A central
//! scheduler is a single point of failure and of trust -- if it falls the fleet cannot grow, if it lies it
//! strands a world or crowds a host. The leaderless answer this tree keeps: placement is not DECIDED by
//! anyone, it is DERIVED by everyone, to the same answer. A world's assigned host is its BERTH, and the
//! berth law holds exactly when:
//!   - every node computes the same berth -- placement is invariant under the order hosts and worlds were
//!     added to the fleet (no scheduler's private state changes where a world lands);
//!   - capacity is honored -- no host berths more worlds than its declared capacity;
//!   - no world is double-berthed or orphaned -- each world lands on exactly one host, a fleet oversubscribed
//!     (worlds past total capacity) refuses whole (Oversubscribed), a fleet of worlds with no hosts refuses
//!     NoHosts.
//!
//! The berth is DERIVED, never written -- there is no set_berth; a world's host is read out of the fleet the
//! way the Cord's order is read out of its DAG, so a steward cannot hand-place a world past the rule. The
//! method is highest weave-score (rendezvous / HRW, studied clean-room as a concept only): each (world, host)
//! pair earns a weave-score SHA-256(domain - world-id - host-pk), and a world berths at the highest-scoring
//! host with room. Chosen over hash-mod-count for its minimal-disruption property -- when the roster changes,
//! only the worlds on the changed host move (r2's convergence).
//!
//! Composes kumara + tally_copy public API only. Siloed, dev-only, demo host and world seeds -- no real key,
//! no funds, no network, no world provisioned. A real Aurora host and any provisioning reach custody gates
//! #2/#4; a SERVED fleet (a node fetching the live roster over Comlink) reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/puddle.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const Sha256 = std.crypto.hash.sha2.Sha256;
const kumara = @import("kumara.rye");
const tally_copy = @import("tally_copy.rye");

pub const puddle_version = "20260813.114651";

/// A host identity is an Ed25519 public key -- thirty-two bytes, the width a berth scores against.
pub const pk_len: u32 = 32;

/// A weave-score is a SHA-256 digest of the (domain - world-id - host-pk) tuple -- thirty-two bytes.
pub const digest_len: u32 = 32;

/// A world names itself in at most this many bytes -- a bounded, human-readable id.
pub const world_id_len: u32 = 24;

/// A fleet holds at most this many hosts -- one bounded roster.
pub const max_hosts: u32 = 16;

/// A fleet holds at most this many worlds -- one bounded set of Puddles.
pub const max_worlds: u32 = 64;

/// The domain tag separates a berth weave-score from every other hash in the ledger set, so no digest made
/// elsewhere can be read as a placement score.
pub const berth_domain = "myc-puddle-berth-v1";

pub const PuddleError = error{
    TooManyHosts, // more hosts than the fleet's static roster holds
    TooManyWorlds, // more worlds than the fleet's static set holds
    DuplicateHost, // a host public key already enrolled — a host appears once
    DuplicateWorld, // a world id already present — a world is named once
    BadCapacity, // a host declared zero capacity — a host that runs nothing is not a host
    BadWorldName, // a world id is empty or past world_id_len
    NoHosts, // a fleet with worlds and no hosts — nothing could ever berth
    Oversubscribed, // more worlds than the fleet's total capacity — a world cannot berth, refuses whole
};

/// One world in the fleet -- a bounded, human-readable id naming a sovereign Rye whole.
pub const World = struct {
    id: [world_id_len]u8 = undefined,
    id_len: u32 = 0,

    pub fn id_slice(w: *const World) []const u8 {
        // invariant: a world id never exceeds its bounded width.
        assert(w.id_len <= world_id_len);
        return w.id[0..w.id_len];
    }
};

/// One host in the fleet -- its identity and how many worlds it can berth.
pub const Host = struct {
    pk: [pk_len]u8 = undefined,
    capacity: u32 = 0,

    pub fn pk_slice(h: *const Host) []const u8 {
        // invariant: a host identity is exactly one Ed25519 public key wide.
        assert(pk_len == 32);
        return h.pk[0..pk_len];
    }
};

/// A bounded fleet -- a roster of identity-bearing hosts and a set of named worlds. It carries no placement
/// of its own; a world's berth is derived from these two sets and nothing else.
pub const Fleet = struct {
    hosts: [max_hosts]Host = undefined,
    host_count: u32 = 0,
    worlds: [max_worlds]World = undefined,
    world_count: u32 = 0,

    pub fn empty() Fleet {
        return Fleet{ .host_count = 0, .world_count = 0 };
    }
};

/// The weave-score of a (world, host) pair: SHA-256 over the domain tag, the world id, and the host public
/// key, so a world scores every host deterministically and a change to either input is visible in the score.
pub fn weave_score(world_id: []const u8, host_pk: []const u8, out: *[digest_len]u8) void {
    // invariant: a host identity is exactly one public key wide.
    assert(host_pk.len == pk_len);
    // invariant: a weave-score is exactly a SHA-256 digest.
    assert(out.len == digest_len);
    var h = Sha256.init(.{});
    h.update(berth_domain);
    h.update(world_id);
    h.update(host_pk);
    h.final(out);
}

/// Enroll one host -- its public key and its capacity. Refuses `DuplicateHost` for a key already present,
/// `BadCapacity` for a host that can berth nothing, and `TooManyHosts` past the bound rather than growing.
pub fn add_host(f: *Fleet, pk: []const u8, capacity: u32) PuddleError!void {
    // invariant: the fleet honors its static host roster before any growth.
    assert(f.host_count <= max_hosts);
    // invariant: a host identity is exactly one public key wide.
    assert(pk.len == pk_len);
    if (f.host_count >= max_hosts) return error.TooManyHosts;
    if (capacity == 0) return error.BadCapacity;

    var i: u32 = 0;
    while (i < f.host_count) : (i += 1) {
        if (std.mem.eql(u8, f.hosts[i].pk_slice(), pk)) return error.DuplicateHost;
    }

    var host = Host{ .capacity = capacity };
    tally_copy.copy_disjoint(u8, host.pk[0..pk_len], pk);
    f.hosts[f.host_count] = host;
    f.host_count += 1;
    // invariant: enrolling one host grows the roster by exactly one, never past the ceiling.
    assert(f.host_count <= max_hosts);
}

/// Name one world into the fleet. Refuses `BadWorldName` for an empty or overlong id, `DuplicateWorld` for a
/// name already present, and `TooManyWorlds` past the bound rather than growing.
pub fn add_world(f: *Fleet, id: []const u8) PuddleError!void {
    // invariant: the fleet honors its static world set before any growth.
    assert(f.world_count <= max_worlds);
    if (id.len == 0 or id.len > world_id_len) return error.BadWorldName;
    if (f.world_count >= max_worlds) return error.TooManyWorlds;

    var i: u32 = 0;
    while (i < f.world_count) : (i += 1) {
        if (std.mem.eql(u8, f.worlds[i].id_slice(), id)) return error.DuplicateWorld;
    }

    var w = World{ .id_len = @intCast(id.len) };
    tally_copy.copy_disjoint(u8, w.id[0..id.len], id);
    f.worlds[f.world_count] = w;
    f.world_count += 1;
    // invariant: naming one world grows the set by exactly one, never past the ceiling.
    assert(f.world_count <= max_worlds);
}

/// Find a world by id, returning its insertion index or null. A world id is unique, so at most one matches.
pub fn find_world(f: *const Fleet, id: []const u8) ?u32 {
    // invariant: the fleet honors its static world set.
    assert(f.world_count <= max_worlds);
    var i: u32 = 0;
    while (i < f.world_count) : (i += 1) {
        if (std.mem.eql(u8, f.worlds[i].id_slice(), id)) return i;
    }
    // invariant: a search that finds nothing has walked the whole set.
    assert(i == f.world_count);
    return null;
}

/// Fill `order` with world indices sorted ascending by id -- the canonical processing order that makes the
/// derived berth independent of the order worlds were added. Bounded selection sort over world_count.
fn world_order(f: *const Fleet, order: *[max_worlds]u32) void {
    // invariant: the fleet honors its static world set.
    assert(f.world_count <= max_worlds);
    var i: u32 = 0;
    while (i < f.world_count) : (i += 1) order[i] = i;

    var s: u32 = 0;
    while (s < f.world_count) : (s += 1) {
        var min = s;
        var k: u32 = s + 1;
        while (k < f.world_count) : (k += 1) {
            const kk = f.worlds[order[k]].id_slice();
            const mm = f.worlds[order[min]].id_slice();
            if (std.mem.order(u8, kk, mm) == .lt) min = k;
        }
        const tmp = order[s];
        order[s] = order[min];
        order[min] = tmp;
    }
    // invariant: the ordering covers exactly the fleet's worlds.
    assert(s == f.world_count);
}

/// True when host `a` outranks host `b` for a given world -- a higher weave-score wins, and a tie (never seen
/// with SHA-256, yet kept total and arrival-independent) breaks on the greater public key, never on index.
fn host_ranks_above(sa: *const [digest_len]u8, pa: []const u8, sb: *const [digest_len]u8, pb: []const u8) bool {
    // invariant: both hosts carry full public keys.
    assert(pa.len == pk_len);
    assert(pb.len == pk_len);
    return switch (std.mem.order(u8, sa[0..], sb[0..])) {
        .gt => true,
        .lt => false,
        .eq => std.mem.order(u8, pa, pb) == .gt,
    };
}

/// The crux: derive each world's berth. `out[w]` is the host index the w-th world berths at. Processing
/// worlds in canonical id order, each world takes the highest-weave-score host with remaining capacity, so
/// the result is a pure function of the fleet -- invariant under the order hosts and worlds were added.
/// Refuses `NoHosts` when worlds have no host to land on, and `Oversubscribed` (whole) when a world cannot
/// berth because every host is full.
pub fn berth(f: *const Fleet, out: *[max_worlds]u32) PuddleError!void {
    // invariant: the fleet honors both static bounds.
    assert(f.host_count <= max_hosts);
    assert(f.world_count <= max_worlds);
    if (f.world_count > 0 and f.host_count == 0) return error.NoHosts;

    var remaining: [max_hosts]u32 = undefined;
    var h: u32 = 0;
    while (h < f.host_count) : (h += 1) remaining[h] = f.hosts[h].capacity;

    var order: [max_worlds]u32 = undefined;
    world_order(f, &order);

    var placed: u32 = 0;
    var oi: u32 = 0;
    while (oi < f.world_count) : (oi += 1) {
        const w = order[oi];
        var best: u32 = f.host_count; // sentinel = no host with room found yet
        var best_score: [digest_len]u8 = undefined;

        var hh: u32 = 0;
        while (hh < f.host_count) : (hh += 1) {
            if (remaining[hh] == 0) continue;
            var score: [digest_len]u8 = undefined;
            weave_score(f.worlds[w].id_slice(), f.hosts[hh].pk_slice(), &score);
            const take = best == f.host_count or
                host_ranks_above(&score, f.hosts[hh].pk_slice(), &best_score, f.hosts[best].pk_slice());
            if (take) {
                best = hh;
                tally_copy.copy_disjoint(u8, best_score[0..], score[0..]);
            }
        }

        if (best == f.host_count) return error.Oversubscribed;
        out[w] = best;
        remaining[best] -= 1;
        placed += 1;
    }

    // invariant: every world berthed exactly once -- no world orphaned, none double-counted.
    assert(placed == f.world_count);
}

/// Count how many worlds a given host berths under a placement -- used to prove capacity is honored.
pub fn load_of(f: *const Fleet, placement: *const [max_worlds]u32, host_index: u32) u32 {
    // invariant: the host index names a real host.
    assert(host_index < f.host_count);
    var n: u32 = 0;
    var w: u32 = 0;
    while (w < f.world_count) : (w += 1) {
        if (placement[w] == host_index) n += 1;
    }
    // invariant: a host never berths more worlds than the whole fleet holds.
    assert(n <= f.world_count);
    return n;
}

/// The host public key a world berths at under a placement -- so two fleets can be compared world-by-world
/// regardless of the order their hosts were added.
pub fn berth_pk(f: *const Fleet, placement: *const [max_worlds]u32, world_index: u32) []const u8 {
    // invariant: the world index names a real world.
    assert(world_index < f.world_count);
    const hi = placement[world_index];
    // invariant: a berth always names a real host.
    assert(hi < f.host_count);
    return f.hosts[hi].pk_slice();
}

/// Print a fleet a keeper can read -- its host and world counts.
pub fn render(f: *const Fleet) void {
    print("fleet hosts={d} worlds={d}\n", .{ f.host_count, f.world_count });
}

// --- selftest: a world berths at exactly one host, and every node computes the same berth ---------------

fn host_key(byte: u8) [pk_len]u8 {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    const kp = kumara.keypair_from_seed(&seed);
    return kp.public_key.toBytes();
}

/// Build a fleet: three hosts (bytes 0x11-0x22-0x33, each capacity `cap`) and the given world ids, added in
/// the given order. Same inputs in any order must berth identically.
fn build(host_bytes: []const u8, cap: u32, world_ids: []const []const u8) !Fleet {
    var f = Fleet.empty();
    for (host_bytes) |b| {
        const pk = host_key(b);
        try add_host(&f, pk[0..pk_len], cap);
    }
    for (world_ids) |id| try add_world(&f, id);
    return f;
}

pub fn main() !void {
    const ids = [_][]const u8{ "alpha", "bravo", "charlie", "delta", "echo" };
    const hosts_a = [_]u8{ 0x11, 0x22, 0x33 };

    // Scene 1 -- THE CRUX. The same five worlds and three hosts, built in two DIFFERENT arrival orders, berth
    // to the byte-identical placement: every world lands on the same host public key in both fleets. No
    // scheduler decides; every node derives the same answer from the roster alone.
    {
        var fa = try build(hosts_a[0..], 4, ids[0..]);
        // Fleet B: hosts reversed, worlds reversed -- a wholly different insertion order.
        const hosts_b = [_]u8{ 0x33, 0x22, 0x11 };
        const ids_b = [_][]const u8{ "echo", "delta", "charlie", "bravo", "alpha" };
        var fb = try build(hosts_b[0..], 4, ids_b[0..]);

        var pa: [max_worlds]u32 = undefined;
        var pb: [max_worlds]u32 = undefined;
        try berth(&fa, &pa);
        try berth(&fb, &pb);

        // Compare world-by-world by id -- the berth of each world matches across the two arrival orders.
        for (ids) |id| {
            const ia = find_world(&fa, id) orelse return error.MissingA;
            const ib = find_world(&fb, id) orelse return error.MissingB;
            if (!std.mem.eql(u8, berth_pk(&fa, &pa, ia), berth_pk(&fb, &pb, ib))) return error.BerthDrift;
        }

        // Every world berthed on a real host, capacity honored, none orphaned.
        var total: u32 = 0;
        var hi: u32 = 0;
        while (hi < fa.host_count) : (hi += 1) {
            const load = load_of(&fa, &pa, hi);
            if (load > fa.hosts[hi].capacity) return error.OverCapacity;
            total += load;
        }
        if (total != fa.world_count) return error.Orphaned;
    }

    // Scene 2 -- capacity spreads the worlds. With each host capacity one, three hosts berth exactly the three
    // worlds one apiece -- no host over its bound, none orphaned.
    {
        var f = try build(hosts_a[0..], 1, ids[0..3]);
        var p: [max_worlds]u32 = undefined;
        try berth(&f, &p);
        var hi: u32 = 0;
        while (hi < f.host_count) : (hi += 1) {
            if (load_of(&f, &p, hi) != 1) return error.NotSpread;
        }
    }

    // Scene 3 -- an oversubscribed fleet refuses whole. Two hosts of capacity one hold two worlds; a third
    // world cannot berth, so berth refuses Oversubscribed rather than strand it or crowd a host.
    {
        var f = try build(hosts_a[0..2], 1, ids[0..3]);
        var p: [max_worlds]u32 = undefined;
        if (berth(&f, &p)) |_| return error.OverBerthed else |err| {
            if (err != error.Oversubscribed) return error.WrongOver;
        }
    }

    // Scene 4 -- a fleet of worlds with no hosts refuses NoHosts (nothing could ever berth).
    {
        var f = Fleet.empty();
        try add_world(&f, "orphan");
        var p: [max_worlds]u32 = undefined;
        if (berth(&f, &p)) |_| return error.HostlessBerthed else |err| {
            if (err != error.NoHosts) return error.WrongHostless;
        }
    }

    // Scene 5 -- build refusals. A duplicate host, a duplicate world, a zero-capacity host, and an empty or
    // overlong world name each refuse rather than admit a malformed fleet.
    {
        var f = Fleet.empty();
        const p1 = host_key(0x11);
        try add_host(&f, p1[0..pk_len], 2);
        if (add_host(&f, p1[0..pk_len], 2)) |_| return error.DupHostAdmitted else |err| {
            if (err != error.DuplicateHost) return error.WrongDupHost;
        }
        const p2 = host_key(0x22);
        if (add_host(&f, p2[0..pk_len], 0)) |_| return error.ZeroCapAdmitted else |err| {
            if (err != error.BadCapacity) return error.WrongZeroCap;
        }
        try add_world(&f, "alpha");
        if (add_world(&f, "alpha")) |_| return error.DupWorldAdmitted else |err| {
            if (err != error.DuplicateWorld) return error.WrongDupWorld;
        }
        if (add_world(&f, "")) |_| return error.EmptyAdmitted else |err| {
            if (err != error.BadWorldName) return error.WrongEmpty;
        }
        const overlong = "this-world-id-is-far-too-long-to-fit";
        if (add_world(&f, overlong)) |_| return error.OverlongAdmitted else |err| {
            if (err != error.BadWorldName) return error.WrongOverlong;
        }
    }

    // Scene 6 -- the weave-score is deterministic and discriminating. The same (world, host) pair scores
    // identically twice; a different host scores differently.
    {
        const a = host_key(0x11);
        const b = host_key(0x22);
        var s1: [digest_len]u8 = undefined;
        var s2: [digest_len]u8 = undefined;
        var s3: [digest_len]u8 = undefined;
        weave_score("alpha", a[0..pk_len], &s1);
        weave_score("alpha", a[0..pk_len], &s2);
        weave_score("alpha", b[0..pk_len], &s3);
        if (!std.mem.eql(u8, s1[0..], s2[0..])) return error.ScoreUnstable;
        if (std.mem.eql(u8, s1[0..], s3[0..])) return error.ScoreCollided;
    }

    render(&(try build(hosts_a[0..], 4, ids[0..])));

    print("puddle: a fleet places each world at exactly one host by a rule every node computes alike; five worlds over three hosts berth to a byte-identical placement whatever order the roster was built in\n", .{});
    print("puddle: capacity is honored and no world is orphaned; an oversubscribed fleet refuses Oversubscribed whole, a fleet with no hosts refuses NoHosts, a duplicate host or world and a bad capacity or name each refuse\n", .{});
    print("GREEN: myc puddle r1 — placement is derived, never decided: a world's berth is a pure function of the fleet, invariant under arrival order, so no scheduler is trusted. Fleet placement without a scheduler stands.\n", .{});
}
