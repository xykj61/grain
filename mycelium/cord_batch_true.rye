//! mycelium/cord_batch_true.rye — the batched Cord reads true (fact batching r4, the arc closes).
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · fact batching · rung r4.
//! Design read: active-designing/date/20260813/20260813-043303_mycelium-fact-batching-exploration.md
//!
//! r1 proved a batched history folds to the byte-identical supply as the same facts
//! one-per-block, r2 let it travel, r3 measured the throughput win — all over Dags
//! seated in code. This closing rung carries the reader onto a **real** on-disk
//! `format cord-batch-v1` record a keeper can open and walk, and proves the property
//! the whole consensus rests on: the order and supply the batched Cord reports are
//! true to the bytes.
//!
//! The corpus is `tools/fixtures/cord_batch_dag.bron`, a genuine record produced
//! reproducibly by `mycelium/cord_batch_fixture_gen.rye` (the honest two-batch scene
//! — issued 1000 · taxed 300 · supply 700 · one star, across two blocks),
//! `@embedFile`-bound at compile time through a symlink in `mycelium/corpora/` — no
//! network, the bytes read are the tree's own. Two independent readings must agree:
//! the app parses the record through r2, **rebuilds** the Dag under r1's own
//! `add_batch` (re-verifying every block and fact signature, requiring every parent
//! already held), commits it, and reports the **block count**, the **folded supply**,
//! and the **star count**; the r4 witness cross-checks that triple against
//! `tools/fixtures/cord_batch_truth.awk`'s reading of the same file — two tools, one
//! answer. And the record is genuinely a committed batched Cord: the block lines are
//! in agreed order, so re-committing reproduces the file's order (the identity
//! permutation), and re-rendering the parsed Dag reproduces the embedded bytes exactly.
//!
//! Additive — composes r2 over public API (r1/r2/r3 re-run GREEN). Siloed, dev-only,
//! demo seeds — no real key, no funds, no network, no custody.
//!
//!   rye build mycelium/cord_batch_true.rye -femit-bin=mycelium/bin/cord_batch_true
//!   mycelium/bin/cord_batch_true selftest | measure

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const cord = @import("cord.rye");
const cord_batch = @import("cord_batch.rye");
const cord_batch_bron = @import("cord_batch_bron.rye");
const fold = @import("fold.rye");

pub const cord_batch_true_version = "20260813.050000";

/// The real batched Cord record, bound at compile time — the tree's own bytes.
const real_batch = @embedFile("corpora/cord_batch_dag.bron");

/// The three facts a keeper can count by hand: how many blocks the batched Cord
/// bundles, its folded supply, and how many of those facts reserve a star.
pub const Reading = struct {
    blocks: u32,
    supply: u64,
    stars: u32,
};

/// Read the real batched Cord: parse it, rebuild the Dag under r1's own `add_batch`
/// (verifying every signature and requiring every parent already held), commit it,
/// and fold the supply through the real Mycelium law. The fixture is rendered in
/// agreed order, so committing the rebuilt Dag must reproduce the file's order (the
/// identity permutation) — else the record is not a committed Cord and it refuses.
pub fn read_batch(text: []const u8) !Reading {
    const pl = try cord_batch_bron.parse(text);
    // invariant: a real batched Cord record carries at least one block.
    if (pl.len == 0) return error.BadFormat;
    var dag: cord_batch.BatchDag = undefined;
    try cord_batch_bron.rebuild(&pl, &dag);
    var order: [cord.cord_max_blocks]u32 = undefined;
    const count = cord_batch.commit_batch(&dag, order[0..]);
    // invariant: the block lines are already in the agreed order, so the app's
    // independent commit is the identity permutation over them.
    var i: u32 = 0;
    while (i < count) : (i += 1) {
        if (order[i] != i) return error.OrderNotCanonical;
    }
    var log = fold.Log.empty();
    cord_batch.committed_batch_log(&dag, order[0..], count, &log);
    const state = try fold.fold_log(&log);
    // invariant: supply is exactly issued minus taxed over the agreed order.
    assert(state.supply() == state.issued - state.taxed);
    return .{ .blocks = pl.len, .supply = state.supply(), .stars = state.star_count };
}

// --- selftest -----------------------------------------------------------

/// The reading of the real record — the witness cross-checks this triple against
/// awk's reading of the same bytes, so the two tools must give one answer.
fn welcome_reading_true_to_bytes() !void {
    const r = try read_batch(real_batch);
    // The fixture bundles two batched blocks, folds to supply 700, reserves one star.
    assert(r.blocks == 2);
    assert(r.supply == 700);
    assert(r.stars == 1);
    print("cord-batch-true: truth-triple {d} {d} {d}\n", .{ r.blocks, r.supply, r.stars });
    print("cord-batch-true: the reading of the real batched Cord — blocks, supply, stars — matches an independent count of the same bytes.\n", .{});
}

/// The record is genuinely a committed batched Cord: re-rendering the parsed Dag
/// reproduces the embedded bytes exactly, and re-committing reproduces the file's order.
fn welcome_record_is_really_a_cord() !void {
    const pl = try cord_batch_bron.parse(real_batch);
    var buf: [cord_batch_bron.max_record]u8 = undefined;
    const n = try cord_batch_bron.render(&pl, &buf);
    // invariant: the re-render reproduces exactly the embedded bytes.
    assert(n == real_batch.len);
    assert(std.mem.eql(u8, buf[0..n], real_batch));
    // the order check inside read_batch already proved the identity permutation.
    _ = try read_batch(real_batch);
    print("cord-batch-true: the real record re-renders to the embedded bytes exactly, and its blocks stand in the agreed order.\n", .{});
}

/// A tampered copy of the real bytes refuses — a corrupted record is never read as
/// true. A flipped header byte refuses `BadFormat`; a flipped signature byte would
/// refuse `BadSignature` at add_batch.
fn unwelcome_tampered_record_refuses() !void {
    var buf: [real_batch.len]u8 = undefined;
    var k: u32 = 0;
    while (k < real_batch.len) : (k += 1) buf[k] = real_batch[k];
    buf[7] ^= 0xFF; // inside "format ..."
    const bad = read_batch(buf[0..]);
    // invariant: a tampered header is refused, never read as true.
    assert(bad == error.BadFormat);
    print("cord-batch-true: a tampered header refused BadFormat — a corrupted record is never read as true.\n", .{});
}

fn run_selftest() !u8 {
    try welcome_reading_true_to_bytes();
    try welcome_record_is_really_a_cord();
    try unwelcome_tampered_record_refuses();
    print("cord_batch_true {s} — GREEN\n", .{cord_batch_true_version});
    print("GREEN: myc fact-batching r4; the reading of a real batched Cord record is true to the bytes (blocks·supply·stars), the supply rebuilt under add_batch and folded through the real Mycelium law, the blocks in the agreed order. The fact-batching arc closes.\n", .{});
    return 0;
}

/// Emit exactly the awk-format triple (`<blocks> <supply> <stars>`), so the witness
/// can compare the app's reading against `cord_batch_truth.awk` — two tools, one answer.
fn run_measure() !u8 {
    const r = try read_batch(real_batch);
    print("{d} {d} {d}\n", .{ r.blocks, r.supply, r.stars });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "measure")) {
        return run_measure();
    }
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest();
    }
    print("usage: cord-batch-true selftest | measure\n", .{});
    return 1;
}
