//! mycelium/purse_bron.rye — the per-account verdict travels as a readable record.
//!
//! Season D (Kresfa & Mycelium) · Mycelium consensus · Purse rung r2 — travel.
//! Design read: active-designing/20260813-070923_mycelium-purse-per-account-balances-exploration.md
//!
//! r1 resolved a Cord's agreed order into a Purse — every account's balance, which
//! transfers moved coins, which came up short. A verdict a node cannot hand to
//! another node is only a local reading, so r2 lets a resolved Purse cross as
//! `format purse-v1` bytes: an `issued <total>` line, one `holds <pk> <balance>` line
//! per account, one `moved <from> <to> <amount> <pos> <round>` line per winning
//! transfer, one `short <from> <amount> <pos> <received-at>` line per spent-out loss.
//! Render writes it, parse reads it back, so a round trip is a fixed point — and the
//! recovered Purse reports the identical balances, counts, and totals, so the per-
//! account verdict crosses to a stranger unchanged.
//!
//! The record carries conservation as its own law, the way till-v1 carried the supply
//! law: the balances a record claims must sum to exactly the `issued` total it names,
//! or the reader refuses `BadInt` before the record is trusted — no coin appears or
//! vanishes in the crossing.
//!
//! A purpose-built bounded reader, never a general parser: a wrong header refuses
//! `BadFormat`, an unknown field `UnknownField` (never dropped), a malformed line
//! `BadLine`, a bad integer or broken conservation law `BadInt`, a bad hex field
//! `BadHex`, an over-long record `TooManyAccounts`/`TooManyMoves`/`TooManyShorts`.
//! Composes purse.rye + fold.rye public API only. Siloed, dev-only, demo seeds —
//! no key, no funds, no network, no custody.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/purse_bron.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const purse = @import("purse.rye");
const cord = @import("cord.rye");
const fold = @import("fold.rye");
const kumara = @import("kumara.rye");
const parse_int = @import("parse_int.rye");

/// A travelled record carries at most this many accounts — a dev-net ledger is small
/// and legible, well under the Purse's own 512 ceiling.
pub const max_accounts_in_record: u32 = 64;

/// And at most this many winning moves.
pub const max_moves_in_record: u32 = 32;

/// And at most this many spent-out losses.
pub const max_shorts_in_record: u32 = 32;

/// The record buffer bound — a small ledger's whole verdict fits with room.
pub const max_record: u32 = 32768;

pub const BronError = error{
    BadFormat, // the header line is not `format purse-v1`, or no issued line
    UnknownField, // a line names a field the record does not define
    BadLine, // a known line carries the wrong token count
    BadInt, // an integer field did not parse, or broke the conservation law
    BadHex, // a hex field was the wrong length or held a non-hex char
    TooManyAccounts, // more accounts than a v1 record admits
    TooManyMoves, // more moves than a v1 record admits
    TooManyShorts, // more losses than a v1 record admits
    RecordTooLong, // the rendered record overflowed the buffer
};

const hex_digits = "0123456789abcdef";

fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex chars per byte.
    assert(out.len == bytes.len * 2);
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0F];
    }
}

fn nibble(c: u8) BronError!u8 {
    return switch (c) {
        '0'...'9' => c - '0',
        'a'...'f' => c - 'a' + 10,
        'A'...'F' => c - 'A' + 10,
        else => error.BadHex,
    };
}

fn from_hex(text: []const u8, out: []u8) BronError!void {
    if (text.len != out.len * 2) return error.BadHex;
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < out.len) : (i += 1) {
        const hi = try nibble(text[i * 2]);
        const lo = try nibble(text[i * 2 + 1]);
        out[i] = (hi << 4) | lo;
    }
}

/// Render a resolved Purse to a `format purse-v1` record. Refuses an overflow or an
/// over-long verdict rather than a partial record.
pub fn render(p: *const purse.Purse, out: []u8) BronError!u32 {
    // invariant: the record honors each of its axis bounds.
    if (p.account_count > max_accounts_in_record) return error.TooManyAccounts;
    if (p.move_count > max_moves_in_record) return error.TooManyMoves;
    if (p.short_count > max_shorts_in_record) return error.TooManyShorts;
    // invariant: the render buffer honors its bound.
    assert(out.len >= max_record);
    const head = std.fmt.bufPrint(out, "format purse-v1\n", .{}) catch return error.RecordTooLong;
    var off: u32 = @intCast(head.len);
    const iss = std.fmt.bufPrint(out[off..], "issued {d}\n", .{p.total_issued}) catch return error.RecordTooLong;
    off += @intCast(iss.len);

    var a: u32 = 0;
    while (a < p.account_count) : (a += 1) {
        const acct = &p.accounts[a];
        var pk_hex: [purse.pk_len * 2]u8 = undefined;
        to_hex(acct.pk[0..], &pk_hex);
        const line = std.fmt.bufPrint(out[off..], "holds {s} {d}\n", .{ pk_hex, acct.balance }) catch return error.RecordTooLong;
        off += @intCast(line.len);
    }

    var m: u32 = 0;
    while (m < p.move_count) : (m += 1) {
        const mv = &p.moves[m];
        var from_hex_buf: [purse.pk_len * 2]u8 = undefined;
        var to_hex_buf: [purse.pk_len * 2]u8 = undefined;
        to_hex(mv.from[0..], &from_hex_buf);
        to_hex(mv.to[0..], &to_hex_buf);
        const line = std.fmt.bufPrint(out[off..], "moved {s} {s} {d} {d} {d}\n", .{ from_hex_buf, to_hex_buf, mv.amount, mv.pos, mv.round }) catch return error.RecordTooLong;
        off += @intCast(line.len);
    }

    var s: u32 = 0;
    while (s < p.short_count) : (s += 1) {
        const sh = &p.shorts[s];
        var pk_hex: [purse.pk_len * 2]u8 = undefined;
        to_hex(sh.from[0..], &pk_hex);
        const line = std.fmt.bufPrint(out[off..], "short {s} {d} {d} {d}\n", .{ pk_hex, sh.amount, sh.pos, sh.received_at }) catch return error.RecordTooLong;
        off += @intCast(line.len);
    }
    // invariant: the rendered record never exceeds its bound.
    assert(off <= max_record);
    return off;
}

/// Split a line into up to six tokens; returns the count (or seven to signal a
/// trailing token past what any line allows).
fn tokens(line: []const u8, out: *[6][]const u8) u32 {
    var count: u32 = 0;
    var it = std.mem.tokenizeScalar(u8, line, ' ');
    while (it.next()) |t| {
        if (count >= 6) return count + 1;
        out[count] = t;
        count += 1;
    }
    return count;
}

/// Sum the parsed balances — the conservation law's left side, computed without the
/// read's own assert so a broken record refuses cleanly rather than tripping it.
fn balances_total(out: *const purse.Purse) u64 {
    var sum: u64 = 0;
    var i: u32 = 0;
    while (i < out.account_count) : (i += 1) {
        sum += out.accounts[i].balance;
    }
    return sum;
}

/// Parse a `format purse-v1` record into `out`, writing through a pointer (a Purse
/// carries a large account table, so no return-by-value copy). Refuses an unknown or
/// malformed field, a bad header, a broken conservation law, or an over-long verdict.
pub fn parse(text: []const u8, out: *purse.Purse) BronError!void {
    var lines = std.mem.splitScalar(u8, text, '\n');
    const header = lines.next() orelse return error.BadFormat;
    if (!std.mem.eql(u8, header, "format purse-v1")) return error.BadFormat;

    out.account_count = 0;
    out.move_count = 0;
    out.short_count = 0;
    out.total_issued = 0;
    var have_issued = false;

    while (lines.next()) |raw| {
        if (raw.len == 0) continue; // a trailing newline yields one empty line
        var tok: [6][]const u8 = undefined;
        const n = tokens(raw, &tok);
        if (n == 0) continue;
        if (std.mem.eql(u8, tok[0], "issued")) {
            if (n != 2) return error.BadLine;
            out.total_issued = parse_int.parse_int(u64, tok[1], .{}) catch return error.BadInt;
            have_issued = true;
        } else if (std.mem.eql(u8, tok[0], "holds")) {
            if (n != 3) return error.BadLine;
            if (out.account_count >= purse.purse_max_accounts) return error.TooManyAccounts;
            const at = out.account_count;
            try from_hex(tok[1], out.accounts[at].pk[0..]);
            const bal = parse_int.parse_int(u64, tok[2], .{}) catch return error.BadInt;
            out.accounts[at].balance = bal;
            // A recovered verdict never reports `received`; hold it at the balance so
            // the account's own invariant (balance <= received) is never violated.
            out.accounts[at].received = bal;
            out.account_count += 1;
        } else if (std.mem.eql(u8, tok[0], "moved")) {
            if (n != 6) return error.BadLine;
            if (out.move_count >= purse.purse_max_moves) return error.TooManyMoves;
            const at = out.move_count;
            try from_hex(tok[1], out.moves[at].from[0..]);
            try from_hex(tok[2], out.moves[at].to[0..]);
            out.moves[at].amount = parse_int.parse_int(u64, tok[3], .{}) catch return error.BadInt;
            out.moves[at].pos = parse_int.parse_int(u32, tok[4], .{}) catch return error.BadInt;
            out.moves[at].round = parse_int.parse_int(u32, tok[5], .{}) catch return error.BadInt;
            out.move_count += 1;
        } else if (std.mem.eql(u8, tok[0], "short")) {
            if (n != 5) return error.BadLine;
            if (out.short_count >= purse.purse_max_shorts) return error.TooManyShorts;
            const at = out.short_count;
            try from_hex(tok[1], out.shorts[at].from[0..]);
            out.shorts[at].amount = parse_int.parse_int(u64, tok[2], .{}) catch return error.BadInt;
            out.shorts[at].pos = parse_int.parse_int(u32, tok[3], .{}) catch return error.BadInt;
            out.shorts[at].received_at = parse_int.parse_int(u64, tok[4], .{}) catch return error.BadInt;
            // invariant: a lawful loss asked for no more than the holder received.
            if (out.shorts[at].amount > out.shorts[at].received_at) return error.BadInt;
            out.short_count += 1;
        } else {
            return error.UnknownField;
        }
    }
    if (!have_issued) return error.BadFormat;
    // The conservation law travels: the balances must sum to exactly the issued total,
    // or the record made or lost a coin in the crossing and is refused.
    if (balances_total(out) != out.total_issued) return error.BadInt;
    // invariant: the parsed verdict is bounded on every axis.
    assert(out.account_count <= purse.purse_max_accounts);
    assert(out.move_count <= purse.purse_max_moves);
    assert(out.short_count <= purse.purse_max_shorts);
}

// ---- selftest: the verdict travels and answers unchanged ---------------------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

/// Build the r1 contested scene and resolve it: genesis credits 100 to Alice; Alice
/// signs two transfers of 100 — to Bob and to Carol — at one round.
fn build_scene() !purse.Purse {
    const kf = seeded(0xF0);
    const ka = seeded(0xA1);
    const kb = seeded(0xB2);
    const kc = seeded(0xC3);

    const alice_pk = ka.public_key.toBytes();
    const bob_pk = kb.public_key.toBytes();
    const carol_pk = kc.public_key.toBytes();

    const f_gen = fold.mint_fact(kf, fold.kind_issue, 100, "", alice_pk[0..]) orelse return error.MintGen;
    const f_bob = fold.mint_fact(ka, fold.kind_tax, 100, "", bob_pk[0..]) orelse return error.MintBob;
    const f_carol = fold.mint_fact(ka, fold.kind_tax, 100, "", carol_pk[0..]) orelse return error.MintCarol;

    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const roots = [_][cord.hash_len]u8{hg};
    const wb = cord.mint_block(ka, 1, roots[0..], f_bob) orelse return error.BlockWb;
    const wc = cord.mint_block(ka, 1, roots[0..], f_carol) orelse return error.BlockWc;

    var dag = cord.Dag.empty();
    try cord.add(&dag, g);
    try cord.add(&dag, wb);
    try cord.add(&dag, wc);
    return purse.resolve(&dag);
}

/// Two Purses answer the same per-account verdict: totals, counts, every balance, and
/// the loser's signer.
fn verdicts_agree(a: *const purse.Purse, b: *const purse.Purse) bool {
    if (a.moves_seen() != b.moves_seen()) return false;
    if (a.shorts_seen() != b.shorts_seen()) return false;
    if (a.total_issued != b.total_issued) return false;
    if (a.total_moved() != b.total_moved()) return false;
    if (a.total_lost() != b.total_lost()) return false;
    if (a.account_count != b.account_count) return false;
    var i: u32 = 0;
    while (i < a.account_count) : (i += 1) {
        if (a.accounts[i].balance != b.balance_of(a.accounts[i].pk[0..])) return false;
    }
    i = 0;
    while (i < a.short_count) : (i += 1) {
        if (!std.mem.eql(u8, a.shorts[i].from[0..], b.shorts[i].from[0..])) return false;
        if (a.shorts[i].amount != b.shorts[i].amount) return false;
    }
    return true;
}

pub fn main() !void {
    const p = try build_scene();

    var buf: [max_record]u8 = undefined;
    const len = try render(&p, buf[0..]);

    var recovered: purse.Purse = undefined;
    try parse(buf[0..len], &recovered);

    // The crux: the recovered verdict answers the identical per-account verdict.
    if (!verdicts_agree(&p, &recovered)) return error.VerdictChanged;
    if (recovered.moves_seen() != 1) return error.MoveCount;
    if (recovered.shorts_seen() != 1) return error.ShortCount;
    if (recovered.total_issued != 100) return error.IssuedValue;
    // Conservation survives the crossing — the balances still sum to the issued total.
    if (recovered.balances_sum() != 100) return error.NotConserved;
    if (recovered.total_lost() != 100) return error.LostValue;

    // Re-rendering the recovered verdict reproduces the exact bytes (fixed point).
    var buf2: [max_record]u8 = undefined;
    const len2 = try render(&recovered, buf2[0..]);
    if (len2 != len) return error.NotFixedPoint;
    if (!std.mem.eql(u8, buf[0..len], buf2[0..len2])) return error.NotFixedPoint;

    // Refusal: a wrong header refuses BadFormat.
    var scratch: purse.Purse = undefined;
    if (parse("format purse-v2\nissued 0\n", &scratch)) |_| return error.BadHeaderAdmitted else |err| {
        if (err != error.BadFormat) return error.WrongHeader;
    }
    // Refusal: an unknown field refuses UnknownField (never dropped).
    if (parse("format purse-v1\nissued 0\nbogus a b\n", &scratch)) |_| return error.UnknownAdmitted else |err| {
        if (err != error.UnknownField) return error.WrongUnknown;
    }
    // Refusal: a bad hex account key refuses BadHex.
    if (parse("format purse-v1\nissued 0\nholds zz 0\n", &scratch)) |_| return error.BadHexAdmitted else |err| {
        if (err != error.BadHex) return error.WrongBadHex;
    }
    // Refusal: balances that do not sum to the issued total break conservation (BadInt).
    if (parse("format purse-v1\nissued 100\n", &scratch)) |_| return error.BadLawAdmitted else |err| {
        if (err != error.BadInt) return error.WrongBadLaw;
    }
    // Refusal: no issued line refuses BadFormat.
    if (parse("format purse-v1\n", &scratch)) |_| return error.NoIssuedAdmitted else |err| {
        if (err != error.BadFormat) return error.WrongNoIssued;
    }
    // Refusal: an over-long verdict refuses at render before a partial record.
    var big: purse.Purse = .{};
    big.move_count = max_moves_in_record + 1;
    if (render(&big, buf[0..])) |_| return error.OverLongAdmitted else |err| {
        if (err != error.TooManyMoves) return error.WrongOverLong;
    }

    print("purse-bron: the resolved verdict renders to a format purse-v1 record and parses back byte-for-byte\n", .{});
    print("purse-bron: the recovered verdict answers the identical balances and loss, conservation to {d} unchanged\n", .{recovered.balances_sum()});
    print("purse-bron: a bad header, an unknown field, a bad hex key, a broken conservation law, a missing issued, an over-long verdict each refuse\n", .{});
    print("GREEN: myc purse-bron — the per-account verdict travels as readable text · moved={d} · short={d} · fixed point\n", .{ recovered.moves_seen(), recovered.shorts_seen() });
}
