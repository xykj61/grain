//! mycelium/freight_bron.rye — a world's freight travels as a readable record, and reads the same offline (r3).
//!
//! Season D (Kresfa & Mycelium) · Puddle fleet orchestration × Mycelium consensus · rung r3 — travel.
//! Design read: active-designing/20260813-121424_puddle-freight-world-state-migration-exploration.md
//!
//! r1 proved a moved world reads the byte-identical position on its new berth; r2 proved the whole fleet's
//! state is conserved across a healing. Both read the world's own ledger blocks in hand. Yet a receiving node
//! often meets a moving world as a MANIFEST first — a small record that advertises what is coming — before it
//! pulls the ledger. r3 lets that manifest cross as `format freight-v1` bytes: a world's id · berth host key ·
//! ledger order-head · account position (balance · reserved · received · present). The reader rebuilds the
//! manifest field for field; a record can never recover a position the writer did not carry.
//!
//! The crux is THE POSITION SURVIVES THE WIRE, not merely the bytes: a manifest parsed from bytes reads the
//! byte-identical position (`freight.Position.same`) as the one rendered, and — the teeth that tie the light
//! record to r1's heavy proof — the advertised order-head it carried ACCEPTS the world's real ledger blocks
//! through `freight.receive`, while a manifest whose head was altered in transit makes those same real blocks
//! refuse `FreightTampered`. So a node can trust a moving world by reading its record alone, and still catch a
//! ledger that does not match the record it arrived under. Render writes it, parse reads it back byte-for-byte
//! — a round trip is a fixed point.
//!
//! A purpose-built bounded reader, never a general parser: a wrong header refuses `BadFormat`, an unknown
//! field `UnknownField` (never dropped), a malformed line `BadLine`, a bad hex key/head `BadHex`, a bad amount
//! `BadInt`, a bad present flag `BadBool`, a missing field `MissingField`. Composes freight + puddle + cord +
//! lapse + fold + voucher + kumara public API only. Siloed, dev-only, demo host/world/keeper seeds — no key,
//! no funds, no network, no world moved; a served migration reaches the Comlink-served gate.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run mycelium/freight_bron.rye

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const freight = @import("freight.rye");
const puddle = @import("puddle.rye");
const cord = @import("cord.rye");
const lapse = @import("lapse.rye");
const fold = @import("fold.rye");
const voucher = @import("voucher.rye");
const kumara = @import("kumara.rye");
const parse_int = @import("parse_int.rye");
const tally_copy = @import("tally_copy.rye");

/// The record buffer bound — a full freight manifest fits with room to spare.
pub const max_record: u32 = 1024;

/// The seven fields a manifest must carry; a parse refuses `MissingField` unless every bit is set.
const field_world: u8 = 1 << 0;
const field_berth: u8 = 1 << 1;
const field_head: u8 = 1 << 2;
const field_balance: u8 = 1 << 3;
const field_reserved: u8 = 1 << 4;
const field_received: u8 = 1 << 5;
const field_present: u8 = 1 << 6;
const field_all: u8 = field_world | field_berth | field_head | field_balance | field_reserved | field_received | field_present;

pub const BronError = error{
    BadFormat, // the header is wrong
    UnknownField, // a line names a field the record does not define
    BadLine, // a known line carries the wrong token count
    BadHex, // a berth key or order-head was the wrong length or held a non-hex char
    BadInt, // an amount was not a decimal u64
    BadBool, // the present flag was neither 0 nor 1
    BadWorldName, // a world id is empty or past world_id_len
    MissingField, // the record omitted a field the manifest needs
    RecordTooLong, // the rendered record overflowed the buffer
};

/// A world's freight manifest: which world, where it berths, and the account position it advertises. The
/// position is `freight.Position` unchanged — the same triple + order-head r1 reads and receives.
pub const Manifest = struct {
    id: [puddle.world_id_len]u8,
    id_len: u32,
    berth: [puddle.pk_len]u8,
    pos: freight.Position,

    pub fn id_slice(m: *const Manifest) []const u8 {
        // invariant: a manifest names a world within the id bound.
        assert(m.id_len >= 1 and m.id_len <= puddle.world_id_len);
        return m.id[0..m.id_len];
    }

    pub fn berth_slice(m: *const Manifest) []const u8 {
        return m.berth[0..puddle.pk_len];
    }
};

const hex_digits = "0123456789abcdef";

fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the output holds exactly two hex chars per byte.
    assert(out.len == bytes.len * 2);
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < bytes.len) : (i += 1) {
        out[i * 2] = hex_digits[bytes[i] >> 4];
        out[i * 2 + 1] = hex_digits[bytes[i] & 0x0F];
    }
}

fn nibble(c: u8) BronError!u8 {
    return switch (c) {
        '0'...'9' => c - '0',
        'a'...'f' => c - 'a' + 10,
        'A'...'F' => c - 'A' + 10,
        else => error.BadHex,
    };
}

fn from_hex(text: []const u8, out: []u8) BronError!void {
    if (text.len != out.len * 2) return error.BadHex;
    var i: usize = 0; // seam: slice index over owned buffers
    while (i < out.len) : (i += 1) {
        const hi = try nibble(text[i * 2]);
        const lo = try nibble(text[i * 2 + 1]);
        out[i] = (hi << 4) | lo;
    }
}

/// Render one manifest to a `format freight-v1` record — one field per line, in a fixed order. Refuses an
/// overflow rather than a partial record.
pub fn render(m: *const Manifest, out: []u8) BronError!u32 {
    // invariant: the render buffer honors its bound.
    assert(out.len >= max_record);
    // invariant: the manifest names a real world and a full-width order-head.
    assert(m.id_len >= 1 and m.id_len <= puddle.world_id_len);
    assert(voucher.order_head_len == cord.hash_len);

    var berth_hex: [puddle.pk_len * 2]u8 = undefined;
    to_hex(m.berth_slice(), &berth_hex);
    var head_hex: [voucher.order_head_len * 2]u8 = undefined;
    to_hex(m.pos.order_head[0..], &head_hex);
    const present: u8 = if (m.pos.present) 1 else 0;

    const body = std.fmt.bufPrint(out, "format freight-v1\nworld {s}\nberth {s}\nhead {s}\nbalance {d}\nreserved {d}\nreceived {d}\npresent {d}\n", .{
        m.id_slice(), berth_hex, head_hex, m.pos.balance, m.pos.reserved, m.pos.received, present,
    }) catch return error.RecordTooLong;

    const off: u32 = @intCast(body.len);
    // invariant: the rendered record never exceeds its bound.
    assert(off <= max_record);
    return off;
}

/// Split a line into up to two tokens; returns the count (or three to signal a token past a manifest line's
/// width — every line is exactly `field value`, two tokens).
fn tokens(line: []const u8, out: *[2][]const u8) u32 {
    var count: u32 = 0;
    var it = std.mem.tokenizeScalar(u8, line, ' ');
    while (it.next()) |t| {
        if (count >= 2) return count + 1;
        out[count] = t;
        count += 1;
    }
    return count;
}

fn parse_u64(text: []const u8) BronError!u64 {
    return parse_int.parse_int(u64, text, .{}) catch return error.BadInt;
}

/// Parse a `format freight-v1` record into `out`. Every field is required; the record refuses `MissingField`
/// unless all seven arrive, so a partial manifest can never leave an undefined position.
pub fn parse(text: []const u8, out: *Manifest) BronError!void {
    var lines = std.mem.splitScalar(u8, text, '\n');
    const header = lines.next() orelse return error.BadFormat;
    if (!std.mem.eql(u8, header, "format freight-v1")) return error.BadFormat;

    var seen: u8 = 0;
    out.id_len = 0;
    out.pos.present = false;
    while (lines.next()) |raw| {
        if (raw.len == 0) continue; // a trailing newline yields one empty line
        var tok: [2][]const u8 = undefined;
        const n = tokens(raw, &tok);
        if (n == 0) continue;
        if (n != 2) return error.BadLine;
        if (std.mem.eql(u8, tok[0], "world")) {
            if (tok[1].len == 0 or tok[1].len > puddle.world_id_len) return error.BadWorldName;
            tally_copy.copy_disjoint(u8, out.id[0..tok[1].len], tok[1]);
            out.id_len = @intCast(tok[1].len);
            seen |= field_world;
        } else if (std.mem.eql(u8, tok[0], "berth")) {
            try from_hex(tok[1], out.berth[0..puddle.pk_len]);
            seen |= field_berth;
        } else if (std.mem.eql(u8, tok[0], "head")) {
            try from_hex(tok[1], out.pos.order_head[0..voucher.order_head_len]);
            seen |= field_head;
        } else if (std.mem.eql(u8, tok[0], "balance")) {
            out.pos.balance = try parse_u64(tok[1]);
            seen |= field_balance;
        } else if (std.mem.eql(u8, tok[0], "reserved")) {
            out.pos.reserved = try parse_u64(tok[1]);
            seen |= field_reserved;
        } else if (std.mem.eql(u8, tok[0], "received")) {
            out.pos.received = try parse_u64(tok[1]);
            seen |= field_received;
        } else if (std.mem.eql(u8, tok[0], "present")) {
            if (std.mem.eql(u8, tok[1], "1")) {
                out.pos.present = true;
            } else if (std.mem.eql(u8, tok[1], "0")) {
                out.pos.present = false;
            } else return error.BadBool;
            seen |= field_present;
        } else {
            return error.UnknownField;
        }
    }
    if (seen != field_all) return error.MissingField;
    // invariant: a fully-parsed manifest names a world within the id bound.
    assert(out.id_len >= 1 and out.id_len <= puddle.world_id_len);
}

// --- selftest scaffolding: build a world ledger over the seasons' own idioms ----------------------------

fn seeded(byte: u8) kumara.KeyPair {
    const seed: [kumara.seed_length]u8 = .{byte} ** kumara.seed_length;
    return kumara.keypair_from_seed(&seed);
}

fn write_deadline(deadline: u64, out: []u8) void {
    // invariant: the buffer holds a full little-endian order position.
    assert(out.len == lapse.deadline_len);
    var v = deadline;
    var i: u32 = 0;
    while (i < lapse.deadline_len) : (i += 1) {
        out[i] = @truncate(v);
        v >>= 8;
    }
}

/// A world's ledger: a funder credits `owner` `credit`, and the owner pledges `pledge_amt` to a stranger
/// under a far deadline the two-block order never reaches. Returns two blocks (genesis · pledge).
fn seat_ledger(pledge_id: u8, credit: u64, pledge_amt: u64, funder: u8, owner: u8, to: []const u8) ![2]cord.Block {
    // invariant: a pledge can only encumber value the owner holds.
    assert(pledge_amt <= credit and pledge_amt > 0);
    const kf = seeded(funder);
    const ka = seeded(owner);
    const owner_pk = ka.public_key.toBytes();

    const f_gen = fold.mint_fact(kf, fold.kind_issue, credit, "", owner_pk[0..]) orelse return error.MintGen;
    const g = cord.mint_block(kf, 0, &[_][cord.hash_len]u8{}, f_gen) orelse return error.BlockG;
    var hg: [cord.hash_len]u8 = undefined;
    cord.address(&g, &hg);
    const roots = [_][cord.hash_len]u8{hg};

    var pb: [1 + lapse.id_len + lapse.deadline_len + puddle.pk_len]u8 = undefined;
    pb[0] = lapse.tag_pledge;
    const id_bytes: [lapse.id_len]u8 = .{pledge_id} ** lapse.id_len;
    tally_copy.copy_disjoint(u8, pb[1 .. 1 + lapse.id_len], id_bytes[0..]);
    write_deadline(9, pb[1 + lapse.id_len .. 1 + lapse.id_len + lapse.deadline_len]);
    tally_copy.copy_disjoint(u8, pb[1 + lapse.id_len + lapse.deadline_len ..][0..puddle.pk_len], to);
    const pn: u32 = 1 + lapse.id_len + lapse.deadline_len + puddle.pk_len;
    const f_pledge = fold.mint_fact(ka, fold.kind_tax, pledge_amt, "", pb[0..pn]) orelse return error.MintPledge;
    const bp = cord.mint_block(ka, 1, roots[0..], f_pledge) orelse return error.BlockP;
    return .{ g, bp };
}

fn dag_of(blocks: []const cord.Block) !cord.Dag {
    var dag = cord.Dag.empty();
    for (blocks) |blk| try cord.add(&dag, blk);
    return dag;
}

fn build_manifest(id: []const u8, berth: []const u8, pos: *const freight.Position) Manifest {
    var m = Manifest{ .id = undefined, .id_len = @intCast(id.len), .berth = undefined, .pos = pos.* };
    tally_copy.copy_disjoint(u8, m.id[0..id.len], id);
    tally_copy.copy_disjoint(u8, m.berth[0..puddle.pk_len], berth[0..puddle.pk_len]);
    return m;
}

pub fn main() !void {
    // One world's ledger and the position its owner reads — the freight the manifest advertises.
    const owner: u8 = 0xA1;
    const owner_pk = seeded(owner).public_key.toBytes();
    const stranger = seeded(0x5E).public_key.toBytes();
    const berth = seeded(0x11).public_key.toBytes(); // the host the world berths at (a demo host key)

    const blocks = try seat_ledger(0x10, 100, 40, 0xF0, owner, stranger[0..]);
    const dag = try dag_of(blocks[0..]);
    const pos = try freight.read_position(&dag, owner_pk[0..]);

    const manifest = build_manifest("alpha", berth[0..puddle.pk_len], &pos);

    var buf: [max_record]u8 = undefined;
    const len = try render(&manifest, buf[0..]);

    var recovered: Manifest = undefined;
    try parse(buf[0..len], &recovered);

    // The whole manifest survives the wire — id, berth, and position all recovered.
    if (!std.mem.eql(u8, manifest.id_slice(), recovered.id_slice())) return error.FreightChanged;
    if (!std.mem.eql(u8, manifest.berth_slice(), recovered.berth_slice())) return error.FreightChanged;

    // THE CRUX: the recovered manifest reads the byte-identical position offline — a node trusts the moving
    // world by reading its record alone.
    if (!manifest.pos.same(&recovered.pos)) return error.PositionDrift;

    // Re-rendering the recovered manifest reproduces the exact bytes (fixed point).
    var buf2: [max_record]u8 = undefined;
    const len2 = try render(&recovered, buf2[0..]);
    if (len2 != len) return error.NotFixedPoint;
    if (!std.mem.eql(u8, buf[0..len], buf2[0..len2])) return error.NotFixedPoint;

    // THE TEETH: the advertised order-head the manifest carried accepts the world's real ledger blocks through
    // r1's receive — the light record is honest against the heavy ledger.
    const accepted = try freight.receive(blocks[0..], recovered.pos.order_head[0..], owner_pk[0..]);
    if (!accepted.same(&recovered.pos)) return error.PositionDrift;

    // And a manifest whose head was altered in transit makes those same real blocks refuse FreightTampered —
    // a node catches a ledger that does not match the record it arrived under.
    {
        var tampered = recovered;
        tampered.pos.order_head[0] +%= 1;
        const verdict = freight.receive(blocks[0..], tampered.pos.order_head[0..], owner_pk[0..]);
        if (verdict) |_| return error.TamperAdmitted else |err| {
            if (err != error.FreightTampered) return err;
        }
    }

    var scratch: Manifest = undefined;

    // Refusal: a wrong header refuses BadFormat before any line is read.
    if (parse("format freight-v2\n", &scratch)) |_| return error.BadHeaderAdmitted else |err| {
        if (err != error.BadFormat) return error.WrongHeader;
    }
    // Refusal: an unknown field refuses UnknownField (never dropped).
    {
        var tmp: [max_record]u8 = undefined;
        tally_copy.copy_disjoint(u8, tmp[0..len], buf[0..len]);
        const extra = "bogus x\n";
        tally_copy.copy_disjoint(u8, tmp[len .. len + extra.len], extra);
        if (parse(tmp[0 .. len + extra.len], &scratch)) |_| return error.UnknownAdmitted else |err| {
            if (err != error.UnknownField) return error.WrongUnknown;
        }
    }
    // Refusal: a line with the wrong token count refuses BadLine.
    {
        const bad = "format freight-v1\nbalance\n";
        if (parse(bad, &scratch)) |_| return error.BadLineAdmitted else |err| {
            if (err != error.BadLine) return error.WrongBadLine;
        }
    }
    // Refusal: a bad hex head refuses BadHex.
    {
        const bad = "format freight-v1\nworld alpha\nberth zz\nhead zz\nbalance 0\nreserved 40\nreceived 0\npresent 1\n";
        if (parse(bad, &scratch)) |_| return error.BadHexAdmitted else |err| {
            if (err != error.BadHex) return error.WrongBadHex;
        }
    }
    // Refusal: a bad amount refuses BadInt.
    {
        var tmp: [max_record]u8 = undefined;
        var berth_hex: [puddle.pk_len * 2]u8 = undefined;
        to_hex(berth[0..puddle.pk_len], &berth_hex);
        var head_hex: [voucher.order_head_len * 2]u8 = undefined;
        to_hex(pos.order_head[0..], &head_hex);
        const bad = std.fmt.bufPrint(tmp[0..], "format freight-v1\nworld alpha\nberth {s}\nhead {s}\nbalance nope\nreserved 40\nreceived 0\npresent 1\n", .{ berth_hex, head_hex }) catch return error.RecordTooLong;
        if (parse(bad, &scratch)) |_| return error.BadIntAdmitted else |err| {
            if (err != error.BadInt) return error.WrongBadInt;
        }
    }
    // Refusal: a bad present flag refuses BadBool.
    {
        var tmp: [max_record]u8 = undefined;
        var berth_hex: [puddle.pk_len * 2]u8 = undefined;
        to_hex(berth[0..puddle.pk_len], &berth_hex);
        var head_hex: [voucher.order_head_len * 2]u8 = undefined;
        to_hex(pos.order_head[0..], &head_hex);
        const bad = std.fmt.bufPrint(tmp[0..], "format freight-v1\nworld alpha\nberth {s}\nhead {s}\nbalance 0\nreserved 40\nreceived 0\npresent 2\n", .{ berth_hex, head_hex }) catch return error.RecordTooLong;
        if (parse(bad, &scratch)) |_| return error.BadBoolAdmitted else |err| {
            if (err != error.BadBool) return error.WrongBadBool;
        }
    }
    // Refusal: a manifest missing a field refuses MissingField (no undefined position leaves the reader).
    {
        const bad = "format freight-v1\nworld alpha\npresent 1\n";
        if (parse(bad, &scratch)) |_| return error.MissingAdmitted else |err| {
            if (err != error.MissingField) return error.WrongMissing;
        }
    }

    print("freight-bron: a world's freight renders to a format freight-v1 manifest (world · berth · head · balance · reserved · received · present) and parses back byte-for-byte — a fixed point\n", .{});
    print("freight-bron: the recovered manifest reads the byte-identical position offline, its advertised head accepts the real ledger blocks through receive, and a head altered in transit makes those blocks refuse FreightTampered\n", .{});
    print("freight-bron: a bad header, unknown field, malformed line, bad hex head, bad amount, bad present flag, and a missing field each refuse\n", .{});
    print("GREEN: myc freight r3 — a world's freight travels as readable text and reads the same offline: a receiving node accepts a moving world by its record alone, yet still catches a ledger that does not match the record. The freight carries the position.\n", .{});
}
