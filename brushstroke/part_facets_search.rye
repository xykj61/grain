//! brushstroke/part_facets_search.rye — HUNK86: the faceted grammar to glass — OR-within, AND-across draws one paged
//! shelf.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK86.
//! Design read: active-designing/20260814-005836_hunk-part-facets-search-shelf-on-glass-exploration.md
//! Teacher, thanked clean-room: McMaster-Carr's faceted sidebar — OR within a facet, AND across facets (concept only,
//! siloed).
//!
//! HUNK85 joined the AND and the OR into the canonical faceted query — OR within a facet, AND across facets — yet in the
//! image layer, unseen. HUNK79 drew the pure AND on glass and HUNK84 the pure OR. This rung draws the WHOLE sidebar
//! grammar: `facets_search_shelf` reads a catalog, a faceted typed line, and a page offset, and paints exactly the parts
//! that satisfy every group — the query algebra a keeper can SEE, complete.
//!
//! The crux is HUNK79's and HUNK84's, now over the faceted grammar: WHAT A KEEPER TYPES IS WHAT A KEEPER SEES. The drawn
//! page is precisely what `part_window` would draw over the catalog `filter_facets` narrows-and-widens. The view invents
//! nothing; it is the faithful composition parse_facets → filter_facets → part_window, inheriting every law HUNK85
//! proved. Because a `|`-free line IS HUNK78's conjunction, this view is a strict superset of HUNK79 — every AND page it
//! drew, this rung draws identically, plus the within-facet unions HUNK79 could not express. A malformed clause
//! surfaces the parser's own named refusal rather than a wrong shelf.
//!
//! A price clause COMPARES a recorded cent count; nothing is moved (custody gate #3 untouched). No network, no key,
//! no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/part_facets_search.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const sprite = @import("sprite.rye");
const part_catalog = @import("part_catalog.rye");
const part_facets = @import("part_facets.rye");
const part_row = @import("part_row.rye");
const skate = @import("skate_grid.rye");

pub const part_facets_search_version = "20260814.005836";

/// How many parts a faceted line keeps — parse the line into a `FacetQuery`, then count the parts passing every group.
/// A caller shows this as *N results* and sizes the paging before it draws. A malformed clause surfaces the parser's
/// own named refusal.
pub fn facets_search_result_count(cat: *const part_catalog.PartCatalog, text: []const u8) !u32 {
    const fq = try part_facets.parse_facets(text);
    const n = try part_facets.count_facets(cat, fq);
    // invariant: a faceted result never holds more parts than the catalog it queried.
    assert(n <= cat.len());
    return n;
}

/// How many pages the faceted result needs at `rows` parts per page — parse, filter into a fresh sub-catalog over the
/// same sheet with the faceted query, and count the pages over it. Zero matches is zero pages.
pub fn facets_search_page_count(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    rows: u32,
) !u32 {
    // invariant: paging needs at least one row per page.
    assert(rows > 0);
    const fq = try part_facets.parse_facets(text);
    var sub: part_catalog.PartCatalog = undefined;
    try part_facets.filter_facets(cat, fq, &sub);
    _ = allocator;
    const pages = part_row.part_page_count(&sub, rows);
    // invariant: a faceted result needs no more pages than the catalog would at the same page size.
    assert(pages <= part_row.part_page_count(cat, rows));
    return pages;
}

/// Draw the faceted page — parse the faceted line into a `FacetQuery`, filter the catalog into a fresh sub-catalog over
/// the SAME sheet with `filter_facets`, and render the page `[offset, offset + rows)` with `part_window`. So what a
/// keeper types is what a keeper sees: the drawn page shows exactly the parts that satisfy every group (each by any of
/// its `|`-clauses), in held order, each swatch true to the one shared sheet. A malformed clause surfaces the parser's
/// named refusal and an over-long line refuses `TooManyGroups`; an offset past the result refuses `BadOffset` exactly as
/// `part_window` does; a bad dimension refuses the shelf's own named error. The drawn grid owns its cells, so it
/// outlives the local sub-catalog whose sheet is the caller's original.
pub fn facets_search_shelf(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    cols: u32,
    rows: u32,
    offset: u32,
) !skate.Grid {
    // invariant: the catalog never outgrew its own sheet's product ceiling before it is searched.
    assert(cat.len() <= sprite.max_products);
    const fq = try part_facets.parse_facets(text);
    var sub: part_catalog.PartCatalog = undefined;
    try part_facets.filter_facets(cat, fq, &sub);
    // invariant: the faceted sub-catalog windows into the caller's own sheet, never a copy.
    assert(sub.index.sheet == cat.index.sheet);
    return part_row.part_window(allocator, &sub, cols, rows, offset);
}

// --- selftest: four parts across four bands, a faceted search — the narrowed-and-widened page shows exactly the parts
//     passing every group (the same the hand-filtered window draws), an empty line is a match-all, a bad offset and a
//     malformed clause each refuse by name -----------------------------------------------------------------------

/// A 16×8 sheet in four solid vertical bands (the part_row fixture), so a 4-wide window carries one known colour.
fn craft_bands(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 16;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const band = x / 4; // 0..3
            buf[off] = if (band == 0 or band == 3) 255 else 0; // r
            buf[off + 1] = if (band == 1 or band == 3) 255 else 0; // g
            buf[off + 2] = if (band == 2) 255 else 0; // b
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// Read a row's fact line back as bytes — trim the blank tail, so the selftest sees exactly the painted fact text
/// (the part_row reader's own idiom).
fn row_text(grid: *const skate.Grid, row: u32, out: []u8) u32 {
    const cells = grid.row_cells(row);
    var n: u32 = @intCast(cells.len);
    while (n > 0 and cells[n - 1] == ' ') : (n -= 1) {}
    var i: u32 = 0;
    while (i < n) : (i += 1) out[i] = cells[i];
    return n;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const sheet = try craft_bands(garden);
    var cat = part_catalog.PartCatalog.init(&sheet);
    // Four parts across the bands, three materials, a price spread. Two are stainless-304 (bolt 125c, hexnut 55c);
    // the brass nut is 60c, the acetal gear 845c.
    try cat.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
    try cat.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
    try cat.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
    try cat.add_part("hexnut", 12, 0, 4, 8, "HX-N8", "stainless-304", 55);
    assert(cat.len() == 4);

    const cols: u32 = 48;

    // A faceted line: (stainless OR brass) AND (at most 100 cents) keeps, from the material union {bolt, nut, hexnut},
    // only the two under a dollar — nut (60c), hexnut (55c). bolt is stainless yet 125c, dropped by the price group.
    // The page draws exactly that — what a keeper types is what a keeper sees, over the faceted grammar.
    {
        assert((try facets_search_result_count(&cat, "material:stainless-304|material:brass max:100")) == 2);
        assert((try facets_search_page_count(garden, &cat, "material:stainless-304|material:brass max:100", 4)) == 1);
        const page = try facets_search_shelf(garden, &cat, "material:stainless-304|material:brass max:100", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "nut  NY-M8  brass  $0.60"));
        const r1 = row_text(&page, 1, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r1], "hexnut  HX-N8  stainless-304  $0.55"));
        // Only two parts matched — the third row's label region is blank.
        const r2 = row_text(&page, 2, buf[0..]);
        assert(r2 == 0);
    }

    // The faceted page equals the hand-filtered window drawn directly — the faceted search view invents nothing.
    {
        const line = "material:stainless-304|material:brass max:100";
        const via_search = try facets_search_shelf(garden, &cat, line, cols, 4, 0);
        const fq = try part_facets.parse_facets(line);
        var sub: part_catalog.PartCatalog = undefined;
        try part_facets.filter_facets(&cat, fq, &sub);
        const via_hand = try part_row.part_window(garden, &sub, cols, 4, 0);
        var a: [part_row.max_fact_line]u8 = undefined;
        var b: [part_row.max_fact_line]u8 = undefined;
        var row: u32 = 0;
        while (row < 4) : (row += 1) {
            const na = row_text(&via_search, row, a[0..]);
            const nb = row_text(&via_hand, row, b[0..]);
            assert(na == nb);
            assert(std.mem.eql(u8, a[0..na], b[0..nb]));
        }
    }

    // A `|`-free faceted line is exactly HUNK79's AND page — the faceted search is a strict superset. stainless AND
    // max:100 draws the one stainless part under a dollar (hexnut), the same page part_and_search would draw.
    {
        assert((try facets_search_result_count(&cat, "material:stainless-304 max:100")) == 1);
        const page = try facets_search_shelf(garden, &cat, "material:stainless-304 max:100", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "hexnut  HX-N8  stainless-304  $0.55"));
        const r1 = row_text(&page, 1, buf[0..]);
        assert(r1 == 0);
    }

    // An empty line is a MATCH-ALL — every part drawn, the first row the held-order first (bolt).
    {
        assert((try facets_search_result_count(&cat, "")) == cat.len());
        const page = try facets_search_shelf(garden, &cat, "", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "bolt  HX-M8-40  stainless-304  $1.25"));
    }

    // An offset past the faceted result refuses BadOffset — two matches, so page offset 2 (at rows=1) is past it.
    if (facets_search_shelf(garden, &cat, "material:stainless-304|material:brass max:100", cols, 1, 2)) |_| return error.OffsetSlipped else |e| {
        if (e != error.BadOffset) return error.WrongOffset;
    }

    // A malformed clause surfaces the parser's own named refusal to the glass layer — a bad facet draws nothing.
    if (facets_search_shelf(garden, &cat, "material:stainless-304|colour:red", cols, 4, 0)) |_| return error.LineSlipped else |e| {
        if (e != error.UnknownKey) return error.WrongLine;
    }
    if (facets_search_result_count(&cat, "nocolonhere")) |_| return error.LineSlipped else |e| {
        if (e != error.NoColon) return error.WrongLine;
    }

    print("GREEN part-facets-search: four parts across four bands — a faceted (stainless|brass) max:100 line draws " ++
        "exactly the material union narrowed by price (nut $0.60, hexnut $0.55, bolt dropped at $1.25), the faceted " ++
        "page equal to the hand-filtered window drawn directly (the search view invents nothing); a |-free line is " ++
        "exactly HUNK79's AND page (a strict superset); an empty line is a match-all drawing every part (bolt first); " ++
        "an offset past the result refuses BadOffset, and a malformed clause (unknown key, no colon) surfaces the " ++
        "parser's named refusal rather than a wrong shelf; a price is a fact drawn and compared, never moved — no " ++
        "network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: part_facets_search selftest\n", .{});
    return 1;
}
