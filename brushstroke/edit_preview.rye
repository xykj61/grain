//! brushstroke/edit_preview.rye — HUNK13: the Skate view of a pending edit, seen before it is committed.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK13.
//! Design read: active-designing/date/20260813/20260813-160955_hunk-edit-preview-seen-before-committed-exploration.md.
//! Teachers, thanked clean-room: gratitude/qoi.md (the open codec) · the non-destructive edit history of
//! iCloud Photos / Google Photos (concept only, siloed).
//!
//! HUNK11 recorded the Photos verbs as data and proved replay is deterministic and non-destructive; HUNK12
//! banked that determinism as a content address. Both work in bytes — neither lets a keeper look. This rung is
//! the eye: `preview` replays an edit-list over a source image (`photo_edits.apply` — pure, the source untouched,
//! nothing stored) and down-maps the fresh result to a Skate grid (`image_skate.down_map`) that lights the
//! canvas. So a pending edit is *seen* before it is committed — no name, no bead, no funds. Pure composition
//! over two proven seams: it adds no new failure mode, only sequences the refusals already proven — an
//! out-of-bounds crop surfaces `OutOfBounds` through the fold, an empty image or an over-ceiling grid refuses
//! from the down-map. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/edit_preview.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const photo_edits = @import("photo_edits.rye");
const image_skate = @import("image_skate.rye");
const skate = @import("skate_grid.rye");

pub const edit_preview_version = "20260813.160955";

/// Replay an edit-list over a source image and hand the fresh result to the Skate down-map, returning the
/// cols×rows grid a keeper looks at. Pure: `photo_edits.apply` folds from a clone, so the source is never
/// touched, and nothing is stored — a preview is a look, not a commit. Adds no new failure mode: a verb's own
/// refusal (an out-of-bounds crop) surfaces by its name through the fold, and an empty image or an over-ceiling
/// grid refuses from `down_map`, each before a grid is returned.
pub fn preview(
    allocator: std.mem.Allocator,
    source: *const qoi.Pixmap,
    list: *const photo_edits.EditList,
    cols: u32,
    rows: u32,
) !skate.Grid {
    // invariant: the edit-list stays within its named ceiling before a single verb replays.
    assert(list.len() <= photo_edits.max_edits);
    // invariant: the source is a well-formed image — four bytes per pixel — the whole pipeline relies on.
    assert(source.pixels.len == @as(usize, source.width) * @as(usize, source.height) * 4);

    const edited = try photo_edits.apply(allocator, source, list);
    // invariant: the replayed image is still four bytes per pixel, the shape the down-map reads.
    assert(edited.pixels.len == @as(usize, edited.width) * @as(usize, edited.height) * 4);

    return image_skate.down_map(allocator, &edited, cols, rows);
}

// --- selftest: preview a two-tone image, prove the view shows the replayed result faithfully, is
//     non-destructive and deterministic, changes with a pending edit, lights the canvas, and refuses by name ----

/// Build an 8×8 image whose left half is red and right half is blue — a spatial pattern a preview must carry,
/// and one a `flip_h` visibly swaps.
fn craft_two_tone(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 8;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const left = x < w / 2;
            buf[off] = if (left) 255 else 0; // r
            buf[off + 1] = 0; // g
            buf[off + 2] = if (left) 0 else 255; // b
            buf[off + 3] = 255; // a
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_two_tone(garden);
    const cols: u32 = 2;
    const rows: u32 = 2;
    const red_slot: u8 = 3; // anchors slot 3 is red
    const blue_slot: u8 = 5; // anchors slot 5 is blue

    // A pending edit: flip the image horizontally, swapping the red and blue halves. Nothing is committed.
    var list = photo_edits.EditList.init();
    try list.push(.flip_h);

    // Faithful: the preview equals the down-map of a direct apply, cell-for-cell.
    const prev = try preview(garden, &pm, &list, cols, rows);
    const edited = try photo_edits.apply(garden, &pm, &list);
    const direct = try image_skate.down_map(garden, &edited, cols, rows);
    assert(std.mem.eql(u8, prev.cells, direct.cells));
    assert(std.mem.eql(u8, prev.fg_index, direct.fg_index));

    // Non-destructive: the source is untouched, and the EMPTY list previews to exactly the source's down-map.
    assert(pm.pixels[0] == 255); // top-left red channel still full
    assert(pm.pixels[2] == 0); // top-left blue channel still dark
    var empty = photo_edits.EditList.init();
    const empty_prev = try preview(garden, &pm, &empty, cols, rows);
    const source_map = try image_skate.down_map(garden, &pm, cols, rows);
    assert(std.mem.eql(u8, empty_prev.cells, source_map.cells));
    assert(std.mem.eql(u8, empty_prev.fg_index, source_map.fg_index));

    // A pending edit changes the view: the source's left cell reads red, the flipped preview's left cell reads
    // blue — the keeper sees the edit before committing it, and the two grids differ.
    const left_i: usize = 0;
    assert(source_map.fg_index[left_i] == red_slot);
    assert(prev.fg_index[left_i] == blue_slot);
    assert(!std.mem.eql(u8, prev.fg_index, source_map.fg_index));

    // Deterministic: the same source, list, and grid preview to the same grid twice.
    const prev2 = try preview(garden, &pm, &list, cols, rows);
    assert(std.mem.eql(u8, prev.cells, prev2.cells));
    assert(std.mem.eql(u8, prev.fg_index, prev2.fg_index));

    // Genuinely seen: the preview rasterizes to a lit canvas, the swapped color landing in the left cell (blue).
    const view_scale: u32 = 1;
    const width: u32 = cols * skate.cell_w * view_scale;
    const height: u32 = rows * skate.cell_h * view_scale;
    const stride: u32 = width * 4;
    const canvas = try garden.alloc(u8, @as(usize, stride) * @as(usize, height));
    const bg = skate.Color{ .r = 1, .g = 2, .b = 3 };
    const fg = skate.Color{ .r = 200, .g = 200, .b = 200 };
    prev.rasterize(canvas, stride, @intCast(width), @intCast(height), bg, fg, view_scale);
    const lit = prev.lit_pixel_count(canvas, stride, @intCast(width), @intCast(height), bg);
    assert(lit > 0);
    // Skate writes B,G,R,A; the top-left cell's first pixel now carries blue, not the source's red.
    assert(canvas[0 + 0] == 255); // blue channel lit
    assert(canvas[0 + 2] == 0); // red channel dark

    // Refusals named: an out-of-bounds crop in the list surfaces OutOfBounds through the fold, before any grid.
    var oob = photo_edits.EditList.init();
    try oob.push(.{ .crop = .{ .x = 6, .y = 0, .w = 4, .h = 2 } }); // 6+4 > 8
    if (preview(garden, &pm, &oob, cols, rows)) |_| return error.OobSlipped else |e| {
        if (e != error.OutOfBounds) return error.WrongOob;
    }
    // An empty grid dimension refuses EmptyImage.
    if (preview(garden, &pm, &empty, 0, rows)) |_| return error.EmptySlipped else |e| {
        if (e != error.EmptyImage) return error.WrongEmpty;
    }
    // An over-ceiling grid refuses GridTooLarge.
    if (preview(garden, &pm, &empty, image_skate.max_map_cols + 1, rows)) |_| {
        return error.TooLargeSlipped;
    } else |e| {
        if (e != error.GridTooLarge) return error.WrongTooLarge;
    }

    print("GREEN edit-preview: a pending flip_h over an 8x8 two-tone previews to a {d}x{d} Skate grid equal to " ++
        "down_map(apply(source,list)) cell-for-cell; the source is untouched and the empty list previews to the " ++
        "plain source down-map; the pending edit changes the view (left cell red->blue); deterministic; the " ++
        "preview rasterizes to {d} lit pixels with blue in the left cell; an out-of-bounds crop refuses " ++
        "OutOfBounds through the fold, an empty grid EmptyImage, an over-ceiling grid GridTooLarge — seen, not " ++
        "committed; no name, no bead, no funds\n", .{ cols, rows, lit });
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: edit_preview selftest\n", .{});
    return 1;
}
