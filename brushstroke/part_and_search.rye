//! brushstroke/part_and_search.rye — HUNK79: the faceted search box on glass — a multi-clause line draws a narrowed,
//! paged shelf.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK79.
//! Design read: active-designing/20260814-000723_hunk-part-and-search-faceted-shelf-on-glass-exploration.md
//! Teacher, thanked clean-room: McMaster-Carr's search-then-see, faceted — several checks shrink the wall (concept
//! only, siloed).
//!
//! HUNK78 gave the marketplace a faceted query — a line of `key:value` clauses narrowing to the parts that satisfy
//! EVERY one — yet in the image layer, unseen. HUNK77 drew the single-clause search on glass but reaches only one
//! facet. This rung joins them: `and_search_shelf` reads a catalog, a multi-clause typed line, and a page offset, and
//! draws exactly the narrowed page — the faceted search box end to end, from keystroke to lit swatch.
//!
//! The crux is HUNK77's, now over the conjunction: WHAT A KEEPER TYPES IS WHAT A KEEPER SEES. The drawn page is
//! precisely what `part_window` would draw over the catalog `filter_and` narrows — no part shown that fails any clause,
//! no satisfying part hidden. The view invents nothing; it is the faithful composition parse_and → filter_and →
//! part_window, inheriting every law those proved (the clauses commute, an empty line is a match-all, a match-none
//! compound draws a real empty page, paging loses nothing). A malformed clause surfaces the parser's own named refusal
//! rather than a wrong shelf.
//!
//! A price clause COMPARES a recorded cent count; nothing is moved (custody gate #3 untouched). No network, no key,
//! no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/part_and_search.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const sprite = @import("sprite.rye");
const part_catalog = @import("part_catalog.rye");
const part_and = @import("part_and.rye");
const part_row = @import("part_row.rye");
const skate = @import("skate_grid.rye");

pub const part_and_search_version = "20260814.000723";

/// How many parts a multi-clause line keeps — parse the line into an `AndQuery`, then count the parts passing every
/// clause. A caller shows this as *N results* and sizes the paging before it draws. A malformed clause surfaces the
/// parser's own named refusal.
pub fn and_search_result_count(cat: *const part_catalog.PartCatalog, text: []const u8) !u32 {
    const aq = try part_and.parse_and(text);
    const n = try part_and.count_and(cat, aq);
    // invariant: a narrowed result never holds more parts than the catalog it narrowed.
    assert(n <= cat.len());
    return n;
}

/// How many pages the narrowed result needs at `rows` parts per page — parse, filter into a fresh sub-catalog over the
/// same sheet with the conjunction, and count the pages over it. Zero matches is zero pages.
pub fn and_search_page_count(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    rows: u32,
) !u32 {
    // invariant: paging needs at least one row per page.
    assert(rows > 0);
    const aq = try part_and.parse_and(text);
    var sub: part_catalog.PartCatalog = undefined;
    try part_and.filter_and(cat, aq, &sub);
    _ = allocator;
    const pages = part_row.part_page_count(&sub, rows);
    // invariant: a narrowed result needs no more pages than the catalog would at the same page size.
    assert(pages <= part_row.part_page_count(cat, rows));
    return pages;
}

/// Draw the narrowed page — parse the multi-clause line into an `AndQuery`, filter the catalog into a fresh sub-catalog
/// over the SAME sheet with `filter_and`, and render the page `[offset, offset + rows)` with `part_window`. So what a
/// keeper types is what a keeper sees: the drawn page shows exactly the parts that satisfy every clause, in held order,
/// each swatch true to the one shared sheet. A malformed clause surfaces the parser's named refusal and an over-long
/// line refuses `TooManyClauses`; an offset past the narrowed result refuses `BadOffset` exactly as `part_window`
/// does; a bad dimension refuses the shelf's own named error. The drawn grid owns its cells, so it outlives the local
/// sub-catalog whose sheet is the caller's original.
pub fn and_search_shelf(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    cols: u32,
    rows: u32,
    offset: u32,
) !skate.Grid {
    // invariant: the catalog never outgrew its own sheet's product ceiling before it is searched.
    assert(cat.len() <= sprite.max_products);
    const aq = try part_and.parse_and(text);
    var sub: part_catalog.PartCatalog = undefined;
    try part_and.filter_and(cat, aq, &sub);
    // invariant: the narrowed sub-catalog windows into the caller's own sheet, never a copy.
    assert(sub.index.sheet == cat.index.sheet);
    return part_row.part_window(allocator, &sub, cols, rows, offset);
}

// --- selftest: five parts, a faceted search — the narrowed page shows exactly the parts passing every clause (the same
//     the hand-filtered window draws), the clauses commute on glass, a match-none compound draws a real empty page, a
//     bad offset and a malformed clause each refuse by name ---------------------------------------------------------

/// A 16×8 sheet in four solid vertical bands (the part_row fixture), so a 4-wide window carries one known colour.
fn craft_bands(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 16;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const band = x / 4; // 0..3
            buf[off] = if (band == 0 or band == 3) 255 else 0; // r
            buf[off + 1] = if (band == 1 or band == 3) 255 else 0; // g
            buf[off + 2] = if (band == 2) 255 else 0; // b
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// Read a row's fact line back as bytes — trim the blank tail, so the selftest sees exactly the painted fact text
/// (the part_row reader's own idiom).
fn row_text(grid: *const skate.Grid, row: u32, out: []u8) u32 {
    const cells = grid.row_cells(row);
    var n: u32 = @intCast(cells.len);
    while (n > 0 and cells[n - 1] == ' ') : (n -= 1) {}
    var i: u32 = 0;
    while (i < n) : (i += 1) out[i] = cells[i];
    return n;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const sheet = try craft_bands(garden);
    var cat = part_catalog.PartCatalog.init(&sheet);
    // Five parts across the bands, three materials, a price spread. Two are stainless-304 (bolt 125c, hexnut 55c).
    try cat.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
    try cat.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
    try cat.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
    try cat.add_part("hexnut", 12, 0, 4, 8, "HX-N8", "stainless-304", 55);
    assert(cat.len() == 4);

    const cols: u32 = 48;

    // A faceted line: stainless-304 AND at most 100 cents keeps only hexnut (bolt is stainless but 125c). The page
    // draws exactly that one part — what a keeper types is what a keeper sees, over the conjunction.
    {
        assert((try and_search_result_count(&cat, "material:stainless-304 max:100")) == 1);
        assert((try and_search_page_count(garden, &cat, "material:stainless-304 max:100", 4)) == 1);
        const page = try and_search_shelf(garden, &cat, "material:stainless-304 max:100", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "hexnut  HX-N8  stainless-304  $0.55"));
        // Only one part matched — the second row's label region is blank.
        const r1 = row_text(&page, 1, buf[0..]);
        assert(r1 == 0);
    }

    // The narrowed page equals the hand-filtered window drawn directly — the faceted search view invents nothing.
    {
        const via_search = try and_search_shelf(garden, &cat, "material:stainless-304 max:100", cols, 4, 0);
        const aq = try part_and.parse_and("material:stainless-304 max:100");
        var sub: part_catalog.PartCatalog = undefined;
        try part_and.filter_and(&cat, aq, &sub);
        const via_hand = try part_row.part_window(garden, &sub, cols, 4, 0);
        var a: [part_row.max_fact_line]u8 = undefined;
        var b: [part_row.max_fact_line]u8 = undefined;
        var row: u32 = 0;
        while (row < 4) : (row += 1) {
            const na = row_text(&via_search, row, a[0..]);
            const nb = row_text(&via_hand, row, b[0..]);
            assert(na == nb);
            assert(std.mem.eql(u8, a[0..na], b[0..nb]));
        }
    }

    // The clauses COMMUTE on glass — the same one part is drawn whichever facet is named first.
    {
        const forward = try and_search_shelf(garden, &cat, "material:stainless-304 max:100", cols, 4, 0);
        const reverse = try and_search_shelf(garden, &cat, "max:100 material:stainless-304", cols, 4, 0);
        var a: [part_row.max_fact_line]u8 = undefined;
        var b: [part_row.max_fact_line]u8 = undefined;
        const na = row_text(&forward, 0, a[0..]);
        const nb = row_text(&reverse, 0, b[0..]);
        assert(na == nb);
        assert(std.mem.eql(u8, a[0..na], b[0..nb]));
    }

    // An empty line is a MATCH-ALL — every part drawn, the first row the held-order first (bolt).
    {
        assert((try and_search_result_count(&cat, "")) == cat.len());
        const page = try and_search_shelf(garden, &cat, "", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "bolt  HX-M8-40  stainless-304  $1.25"));
    }

    // A match-none compound draws a REAL empty page — stainless AND at most 10 cents keeps nothing (both stainless
    // parts are dearer) — zero results, zero pages, every row blank.
    {
        assert((try and_search_result_count(&cat, "material:stainless-304 max:10")) == 0);
        assert((try and_search_page_count(garden, &cat, "material:stainless-304 max:10", 4)) == 0);
        const page = try and_search_shelf(garden, &cat, "material:stainless-304 max:10", cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        var row: u32 = 0;
        while (row < 4) : (row += 1) {
            assert(row_text(&page, row, buf[0..]) == 0);
        }
    }

    // An offset past the narrowed result refuses BadOffset — one match, so page offset 1 is past it.
    if (and_search_shelf(garden, &cat, "material:stainless-304 max:100", cols, 1, 1)) |_| return error.OffsetSlipped else |e| {
        if (e != error.BadOffset) return error.WrongOffset;
    }

    // A malformed clause surfaces the parser's own named refusal to the glass layer — a bad facet draws nothing.
    if (and_search_shelf(garden, &cat, "material:stainless-304 colour:red", cols, 4, 0)) |_| return error.LineSlipped else |e| {
        if (e != error.UnknownKey) return error.WrongLine;
    }
    if (and_search_result_count(&cat, "nocolonhere")) |_| return error.LineSlipped else |e| {
        if (e != error.NoColon) return error.WrongLine;
    }

    print("GREEN part-and-search: five parts across four bands — a faceted material:stainless-304 max:100 line draws " ++
        "exactly the one stainless part under a dollar (hexnut $0.55), the narrowed page equal to the hand-filtered " ++
        "window drawn directly (the search view invents nothing); the clauses commute on glass; an empty line is a " ++
        "match-all drawing every part (bolt first); a match-none compound draws a real empty page (zero results, zero " ++
        "pages, every row blank); an offset past the narrowed result refuses BadOffset, and a malformed clause (unknown " ++
        "key, no colon) surfaces the parser's named refusal rather than a wrong shelf; a price is a fact drawn and " ++
        "compared, never moved — no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: part_and_search selftest\n", .{});
    return 1;
}
