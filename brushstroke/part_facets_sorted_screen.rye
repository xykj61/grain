//! brushstroke/part_facets_sorted_screen.rye — HUNK90: the sorted screen — a header names the sort above the very
//! cheapest-first parts it ordered.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK90.
//! Design read: active-designing/20260814-012818_hunk-part-facets-sorted-screen-exploration.md
//! Teacher, thanked clean-room: a search box that says *sorted by price* above the parts it ordered (concept only,
//! siloed).
//!
//! HUNK89 sorts the faceted result cheapest-first and HUNK88 crowns the faceted shelf with a header naming the query,
//! the count, and the page — yet the two never met: the paged header sat over the HELD-ORDER shelf, and the sorted
//! shelf carried no header at all. A keeper reading a sorted page had no word it WAS sorted — the order was silent.
//! This rung says it: `format_sorted_header` appends `  sorted by price` to HUNK88's paged header, and
//! `facets_sorted_screen` stacks that header over HUNK89's `facets_sorted_shelf`, so the whole sorted search reads top
//! to bottom in one surface — what I asked · how many I found · which page I am on · that it is sorted by price · the
//! cheapest-first parts of that page.
//!
//! The crux is NO DRIFT between the word and the order: the header names `sorted by price` and the shelf beneath is the
//! actually price-sorted page (HUNK89), and the page the header names is the page the shelf draws (HUNK88). Both read
//! the same typed line through the same `parse_facets`. A zero-result line carries neither page nor sort tail — it
//! names no order because there is nothing to order. A malformed clause surfaces the parser's named refusal before any
//! sort work.
//!
//! A price is echoed, compared, and reordered by; nothing is moved (custody gate %3 untouched). No network, no key, no
//! funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/part_facets_sorted_screen.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const part_catalog = @import("part_catalog.rye");
const part_facets_search = @import("part_facets_search.rye");
const part_facets_paged = @import("part_facets_paged.rye");
const part_facets_sort = @import("part_facets_sort.rye");
const image_skate = @import("image_skate.rye");
const skate = @import("skate_grid.rye");
const tally_copy = @import("tally_copy.rye");

pub const part_facets_sorted_screen_version = "20260814.012818";

/// The sort tail — a two-space gap and `sorted by price`. A named constant so a scratch can be sized to hold it.
const sort_tail = "  sorted by price";

/// The widest a sorted header line runs — HUNK88's whole paged header plus the sort tail. A caller sizes its scratch to
/// this, so a sorted header can never overflow.
pub const max_sorted_header_line: u32 = part_facets_paged.max_paged_header_line + sort_tail.len;

pub const SortedScreenError = error{
    HeaderOverflow,
};

/// Assemble the sorted header line — HUNK88's whole paged header (query echo · result count · `page N of M`) followed
/// by `  sorted by price`, added only when a result exists. A zero-result line names no sort, exactly as HUNK88 names
/// no page — there is nothing to order. The base header comes straight from HUNK88, so the query echo, count, and page
/// are unchanged; only the sort note is added. A malformed clause surfaces the parser's named refusal through the base
/// header, before any sort work.
pub fn format_sorted_header(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    rows: u32,
    offset: u32,
    out: []u8,
) !u32 {
    // invariant: paging needs at least one row per page.
    assert(rows > 0);
    var tmp: [max_sorted_header_line]u8 = undefined;
    var n = try part_facets_paged.format_facets_header_paged(allocator, cat, text, rows, offset, tmp[0..]);
    // invariant: the paged header never filled the whole sorted scratch — the sort tail has room.
    assert(n <= part_facets_paged.max_paged_header_line);
    const count = try part_facets_search.facets_search_result_count(cat, text);
    if (count >= 1) {
        // invariant: the sort tail fits in the room the paged header left.
        assert(n + sort_tail.len <= tmp.len);
        tally_copy.copy_disjoint(u8, tmp[n .. n + sort_tail.len], sort_tail);
        n += @intCast(sort_tail.len);
    }
    if (n > out.len) return error.HeaderOverflow;
    tally_copy.copy_disjoint(u8, out[0..n], tmp[0..n]);
    // invariant: the sorted header line stayed inside its scratch.
    assert(n <= max_sorted_header_line);
    return n;
}

/// Draw the sorted header as a fresh one-row anchor-palette grid — the sorted header line truncated to `cols`. Refuses
/// `EmptyHeader` on a zero dimension and `HeaderTooLarge` past the down-map ceiling (through the same guards HUNK88
/// uses), so a header a keeper reads always fits a real grid; a malformed clause surfaces the parser's named refusal.
pub fn sorted_header_row(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    cols: u32,
    rows: u32,
    offset: u32,
) !skate.Grid {
    if (cols == 0) return error.EmptyHeader;
    if (cols > image_skate.max_map_cols) return error.HeaderTooLarge;
    var line: [max_sorted_header_line]u8 = undefined;
    const len = try format_sorted_header(allocator, cat, text, rows, offset, line[0..]);
    var grid = try skate.Grid.init(allocator, cols, 1);
    image_skate.set_anchor_palette(&grid);
    const shown: u32 = @min(len, cols);
    grid.put_line(0, line[0..shown]);
    // invariant: the header grid is exactly one row at the requested width.
    assert(grid.rows == 1);
    assert(grid.cols == cols);
    return grid;
}

/// The whole sorted faceted search screen in one call: the sorted header row atop HUNK89's cheapest-first shelf page,
/// stacked into one grid `cols` wide and `1 + rows` tall (HUNK53's cell-for-cell copy idiom). Row 0 equals
/// `sorted_header_row` cell-for-cell and the shelf region equals `facets_sorted_shelf` cell-for-cell, so the stack adds
/// no drift — the parts under the *sorted by price* header are the actually-sorted parts. A malformed clause refuses
/// through the header first; an offset past the sorted result refuses `BadOffset` through the shelf; a too-thin row
/// refuses the shelf's own named error.
pub fn facets_sorted_screen(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    cols: u32,
    rows: u32,
    offset: u32,
) !skate.Grid {
    const header = try sorted_header_row(allocator, cat, text, cols, rows, offset); // parses; refuses here first
    const shelf = try part_facets_sort.facets_sorted_shelf(allocator, cat, text, cols, rows, offset);
    // invariant: both surfaces stand at the requested width before they are stacked.
    assert(header.cols == cols);
    assert(shelf.cols == cols);
    assert(shelf.rows == rows);

    var grid = try skate.Grid.init(allocator, cols, 1 + rows);
    image_skate.set_anchor_palette(&grid);
    // invariant: the stacked screen is one row taller than the shelf.
    assert(grid.rows == rows + 1);

    // Row 0 — the sorted header, cell-for-cell.
    var c: u32 = 0;
    while (c < cols) : (c += 1) {
        const i: usize = @intCast(c);
        // invariant: the header cell and the destination cell sit inside their grids.
        assert(i < header.cells.len);
        assert(i < grid.cells.len);
        grid.cells[i] = header.cells[i];
        grid.fg_index[i] = header.fg_index[i];
    }

    // Rows 1.. — the sorted shelf page, each source cell into the row below the header.
    var r: u32 = 0;
    while (r < rows) : (r += 1) {
        var sc: u32 = 0;
        while (sc < cols) : (sc += 1) {
            const src: usize = @intCast(r * cols + sc);
            const dst: usize = @intCast((r + 1) * cols + sc);
            // invariant: both the shelf cell and the destination cell sit inside their grids.
            assert(src < shelf.cells.len);
            assert(dst < grid.cells.len);
            grid.cells[dst] = shelf.cells[src];
            grid.fg_index[dst] = shelf.fg_index[src];
        }
    }
    return grid;
}

// --- selftest: five parts across four bands with a price spread and a 55c tie — the sorted header names the sort, a
//     zero-result line names neither page nor sort, the page named is the sorted page drawn (no drift), the screen
//     stacks header over the sorted shelf cell-for-cell, and the named refusals fire --------------------------------

/// A 16×8 sheet in four solid vertical bands (the part_row fixture), so a 4-wide window carries one known colour.
fn craft_bands(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 16;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const band = x / 4; // 0..3
            buf[off] = if (band == 0 or band == 3) 255 else 0; // r
            buf[off + 1] = if (band == 1 or band == 3) 255 else 0; // g
            buf[off + 2] = if (band == 2) 255 else 0; // b
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// Read a row's cells back as bytes, trimming the blank tail — so the selftest sees exactly the painted text.
fn row_text(grid: *const skate.Grid, row: u32, out: []u8) u32 {
    const cells = grid.row_cells(row);
    var n: u32 = @intCast(cells.len);
    while (n > 0 and cells[n - 1] == ' ') : (n -= 1) {}
    var i: u32 = 0;
    while (i < n) : (i += 1) out[i] = cells[i];
    return n;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const sheet = try craft_bands(garden);
    var cat = part_catalog.PartCatalog.init(&sheet);
    // Five parts with a price spread and a 55c tie: bolt 125c, nut 60c, gear 845c, hexnut 55c, washer 55c.
    try cat.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
    try cat.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
    try cat.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
    try cat.add_part("hexnut", 12, 0, 4, 8, "HX-N8", "stainless-304", 55);
    try cat.add_part("washer", 12, 0, 4, 8, "FW-M8", "stainless-304", 55);
    assert(cat.len() == 5);

    const cols: u32 = 96; // wide enough that the longest header line (query + count + page + sort tail, 86 cols) fits without truncation

    // The sorted header names the sort — (stainless|brass) max:100 keeps three, so at two rows per page the header
    // reads `... 3 results  page 1 of 2  sorted by price`.
    {
        var buf: [max_sorted_header_line]u8 = undefined;
        const n = try format_sorted_header(garden, &cat, "material:stainless-304|material:brass max:100", 2, 0, buf[0..]);
        assert(std.mem.eql(u8, buf[0..n], "material:stainless-304|material:brass max:100  3 results  page 1 of 2  sorted by price"));
    }

    // An empty line is a match-all — five parts, sorted, header names page and sort.
    {
        var buf: [max_sorted_header_line]u8 = undefined;
        const n = try format_sorted_header(garden, &cat, "", 5, 0, buf[0..]);
        assert(std.mem.eql(u8, buf[0..n], "all parts  5 results  page 1 of 1  sorted by price"));
    }

    // A ZERO-RESULT line names NEITHER page NOR sort — there is nothing to order.
    {
        var buf: [max_sorted_header_line]u8 = undefined;
        const n = try format_sorted_header(garden, &cat, "material:stainless-304 max:10", 1, 0, buf[0..]);
        assert(std.mem.eql(u8, buf[0..n], "material:stainless-304 max:10  0 results"));
    }

    // NO DRIFT, word to order: the header says `sorted by price` and the shelf beneath is the actually-sorted page —
    // over the three-part union at three rows per page, the first row is the cheapest (hexnut $0.55).
    {
        const line = "material:stainless-304|material:brass max:100";
        const g = try facets_sorted_screen(garden, &cat, line, cols, 3, 0);
        var buf: [max_sorted_header_line]u8 = undefined;
        const hr = row_text(&g, 0, buf[0..]);
        assert(std.mem.endsWith(u8, buf[0..hr], "  sorted by price"));
        const sr = row_text(&g, 1, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..sr], "hexnut  HX-N8  stainless-304  $0.55"));
    }

    // The screen stacks the sorted header over the sorted shelf: cols wide, 1 + rows tall.
    {
        const g = try facets_sorted_screen(garden, &cat, "", cols, 5, 0);
        assert(g.cols == cols);
        assert(g.rows == 6);
    }

    // No drift, top row: the screen's row 0 equals sorted_header_row cell-for-cell.
    {
        const g = try facets_sorted_screen(garden, &cat, "", cols, 5, 0);
        const hdr = try sorted_header_row(garden, &cat, "", cols, 5, 0);
        var c: u32 = 0;
        while (c < cols) : (c += 1) {
            assert(g.cells[c] == hdr.cells[c]);
            assert(g.fg_index[c] == hdr.fg_index[c]);
        }
    }

    // No drift, shelf region: the screen's rows 1.. equal facets_sorted_shelf cell-for-cell — the sorted page, unmoved.
    {
        const g = try facets_sorted_screen(garden, &cat, "", cols, 5, 0);
        const shelf = try part_facets_sort.facets_sorted_shelf(garden, &cat, "", cols, 5, 0);
        var r: u32 = 0;
        while (r < 5) : (r += 1) {
            var sc: u32 = 0;
            while (sc < cols) : (sc += 1) {
                const src: usize = @intCast(r * cols + sc);
                const dst: usize = @intCast((r + 1) * cols + sc);
                assert(g.cells[dst] == shelf.cells[src]);
                assert(g.fg_index[dst] == shelf.fg_index[src]);
            }
        }
    }

    // The composed sorted screen rasterizes to a lit canvas — the whole sorted search reaches the glass.
    {
        const g = try facets_sorted_screen(garden, &cat, "", cols, 5, 0);
        const scale: u32 = 1;
        const width: u32 = g.cols * skate.cell_w * scale;
        const height: u32 = g.rows * skate.cell_h * scale;
        const stride: u32 = width * 4;
        const canvas = try garden.alloc(u8, @as(usize, stride) * @as(usize, height));
        const bg = skate.Color{ .r = 1, .g = 2, .b = 3 };
        const fg = skate.Color{ .r = 210, .g = 210, .b = 210 };
        g.rasterize(canvas, stride, @intCast(width), @intCast(height), bg, fg, scale);
        const lit = g.lit_pixel_count(canvas, stride, @intCast(width), @intCast(height), bg);
        assert(lit > 0);
    }

    // A malformed clause surfaces the parser's own named refusal through the header (before any sort work).
    if (facets_sorted_screen(garden, &cat, "material:stainless-304|colour:red", cols, 2, 0)) |_| {
        return error.LineSlipped;
    } else |e| {
        if (e != error.UnknownKey) return error.WrongLine;
    }

    // A zero-width header refuses EmptyHeader, an over-ceiling one HeaderTooLarge.
    if (sorted_header_row(garden, &cat, "", 0, 1, 0)) |_| return error.HeaderSlipped else |e| {
        if (e != error.EmptyHeader) return error.WrongHeader;
    }
    if (sorted_header_row(garden, &cat, "", image_skate.max_map_cols + 1, 1, 0)) |_| return error.HeaderSlipped else |e| {
        if (e != error.HeaderTooLarge) return error.WrongHeader;
    }

    // An offset past the sorted result refuses BadOffset through the shelf — three matches, so offset 3 at one row per
    // page is past the result.
    if (facets_sorted_screen(garden, &cat, "material:stainless-304|material:brass max:100", cols, 1, 3)) |_| {
        return error.OffsetSlipped;
    } else |e| {
        if (e != error.BadOffset) return error.WrongOffset;
    }

    print("GREEN part-facets-sorted-screen: five parts across four bands with a 55c tie — the sorted header names the " ++
        "sort ((stainless|brass) max:100 at two rows per page reads `3 results  page 1 of 2  sorted by price`, an " ++
        "empty line `all parts  5 results  page 1 of 1  sorted by price`); a zero-result line names NEITHER page NOR " ++
        "sort (nothing to order); the header says `sorted by price` and the shelf beneath is the actually-sorted page " ++
        "(hexnut $0.55 first, no drift); facets_sorted_screen stacks the header over the sorted shelf into one grid, " ++
        "row 0 equal to sorted_header_row and the shelf region equal to facets_sorted_shelf cell-for-cell (no drift); " ++
        "the screen rasterizes to a lit canvas; a malformed clause refuses through the header before any sort " ++
        "(UnknownKey), a zero/over-ceiling header EmptyHeader/HeaderTooLarge, and an offset past the result BadOffset; " ++
        "a price is echoed, compared, and reordered by, never moved — no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: part_facets_sorted_screen selftest\n", .{});
    return 1;
}
