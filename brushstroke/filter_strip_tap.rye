//! brushstroke/filter_strip_tap.rye — HUNK65: tap the filter strip — a finger lands on a thumbnail, that filter is chosen.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK65.
//! Design read: active-designing/20260813-222956_hunk-filter-picker-exploration.md ("The road on from here")
//! Teacher, thanked clean-room: the tappable filter row of a photo app (iCloud Photos / Instagram / VSCO) — a keeper
//! taps the thumbnail they want and the app selects that filter (concept only, siloed).
//!
//! HUNK64 painted the whole filter book as a strip a keeper reads; yet reading is not choosing — the selection still moved
//! by a discrete call, not a finger on the glass. This rung turns the strip into a tappable carousel, the exact parallel
//! of HUNK55 tapping the history filmstrip. `FilterStripTap` owns a `FilterPicker` (HUNK63) and the thumbnail geometry the
//! strip tiles with; `tap_band` classifies a pixel tap into the filter band it lands on (`x / band_px`, the exact
//! parallel of HUNK55's idiom), and `tap_at` selects that filter so `paint`'s marker lands where the finger did — the
//! band a keeper TAPS is the band the strip MARKS, no drift. `commit` then pushes the tapped filter into the history
//! (HUNK16). A pure composition over three proven seams; it invents no pixel op and refuses `BadThumb` at open for a
//! zero-dimension thumbnail. The source is never mutated. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/filter_strip_tap.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const skate = @import("skate_grid.rye");
const filter_preset = @import("filter_preset.rye");
const filter_picker = @import("filter_picker.rye");
const filter_strip = @import("filter_strip.rye");

pub const filter_strip_tap_version = "20260813.224500";

pub const FilterStripTapError = error{
    BadThumb,
};

/// A tap-to-select surface over the filter strip: it owns a `FilterPicker` (the book, the history, the selection) and the
/// thumbnail geometry the strip tiles with. It invents no pixels of its own — `paint` is HUNK64's `paint_strip`, and a
/// tap moves the picker's selection so the marker lands where the finger did. The governing geometry: one filter band is
/// `tcols` cells, each `skate.cell_w` pixels wide, so a tap at pixel `x` picks band `x / band_px`, the exact parallel of
/// HUNK55's history-filmstrip idiom.
pub const FilterStripTap = struct {
    picker: filter_picker.FilterPicker,
    tcols: u32,
    trows: u32,

    /// Open a tap surface over `source` tiling `tcols`×`trows` thumbnails. Validates both dimensions positive once at
    /// construction (refusing `BadThumb`), so no later tap divides by a zero band and no paint down-maps a zero block.
    /// Folds `FilterPicker.open`'s `EmptyImage` through for a zero-dimension source.
    pub fn open(source: *const qoi.Pixmap, tcols: u32, trows: u32) !FilterStripTap {
        // invariant: a thumbnail has both dimensions, so a band has real pixel width and each filter down-maps a real block.
        if (tcols == 0 or trows == 0) return error.BadThumb;
        assert(tcols >= 1);
        assert(trows >= 1);
        const picker = try filter_picker.FilterPicker.open(source, tcols, trows);
        return FilterStripTap{ .picker = picker, .tcols = tcols, .trows = trows };
    }

    /// The pixel width of one filter band — `tcols` cells, each `skate.cell_w` pixels at scale 1. The divisor a tap is
    /// classified against; positive by construction (`tcols >= 1`), so the classification is well-formed.
    pub fn band_px(self: *const FilterStripTap) u32 {
        // invariant: a band spans at least one cell's worth of pixels.
        assert(self.tcols >= 1);
        return self.tcols * skate.cell_w;
    }

    /// Classify a pixel tap at `x` into the filter band it lands on, or `null` for a tap off the strip. A negative `x`
    /// (off the left edge) fires nothing; `band = x / band_px`; a band past the last filter (`band >= count`) fires
    /// nothing. Pure — it reads the geometry and moves nothing.
    pub fn tap_band(self: *const FilterStripTap, x: i32) ?u32 {
        // invariant: the selection stays within the held book.
        assert(self.picker.selection < self.picker.book.len());
        if (x < 0) return null;
        const band: u32 = @as(u32, @intCast(x)) / self.band_px();
        if (band >= self.picker.count()) return null;
        return band;
    }

    /// Tap the strip at pixel `x`: classify the band and, when the tap lands on a thumbnail, select that filter through
    /// HUNK63's `select_to`. Returns the band the selection landed on, or `null` for a tap off the strip (the selection
    /// unmoved). The one call that turns a tap into a choice.
    pub fn tap_at(self: *FilterStripTap, x: i32) ?u32 {
        const band = self.tap_band(x);
        if (band) |k| {
            self.picker.select_to(k);
            // invariant: a landed tap put the selection exactly on the tapped band.
            assert(self.picker.selection == k);
        }
        // invariant: the selection still names a real filter after the tap.
        assert(self.picker.selection < self.picker.book.len());
        return band;
    }

    /// Paint the filter strip with the marker over the selected band — HUNK64's `paint_strip` unchanged. Because a tap
    /// selects the filter and the marker paints at the selection, the band a keeper tapped is the band the marker shows.
    /// Pure — the book and history are read, never moved, the source never mutated.
    pub fn paint(self: *const FilterStripTap, allocator: std.mem.Allocator) !skate.Grid {
        return filter_strip.paint_strip(allocator, &self.picker, self.tcols, self.trows);
    }

    /// Commit the tapped filter into the history (HUNK63's `commit` — the whole recipe pushed onto the cursor). Returns
    /// how many edits the recipe pushed. The source is never mutated.
    pub fn commit(self: *FilterStripTap, allocator: std.mem.Allocator) !u32 {
        return self.picker.commit(allocator);
    }

    /// The picture a keeper currently sees — the source with every committed filter applied (HUNK16). A fresh allocation.
    pub fn current_view(self: *const FilterStripTap, allocator: std.mem.Allocator) !qoi.Pixmap {
        return self.picker.current_view(allocator);
    }
};

// --- selftest: a colour source — a tap centered on band k selects filter k and the repainted marker sits on band k (no
//     drift), a tap off the strip fires nothing, a tapped filter commits into the history, and a bad thumbnail refuses --

fn craft_colour(allocator: std.mem.Allocator, w: u32, h: u32) !qoi.Pixmap {
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            buf[off] = @intCast(x * 40 + 20);
            buf[off + 1] = @intCast(y * 30 + 10);
            buf[off + 2] = @intCast(((x * 3 + y * 7) * 5) & 0xff);
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// The marker row (row 0) of a strip grid wears the marker block over exactly `band` and nowhere else.
fn assert_marker_on(grid: *const skate.Grid, band: u32, tcols: u32) void {
    var c: u32 = 0;
    while (c < grid.cols) : (c += 1) {
        const in_band = c >= band * tcols and c < (band + 1) * tcols;
        const idx: usize = @intCast(c);
        if (in_band) {
            assert(grid.fg_index[idx] == filter_strip.marker_slot);
        } else {
            assert(grid.fg_index[idx] != filter_strip.marker_slot);
        }
    }
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_colour(garden, 4, 4);
    const tcols: u32 = 2;
    const trows: u32 = 2;
    var tap = try FilterStripTap.open(&pm, tcols, trows);
    const bpx = tap.band_px(); // 2 cells * 8 px = 16 px per band

    // A tap centered on each band k selects filter k, and the repainted marker sits on exactly band k — no drift.
    {
        var k: u32 = 0;
        while (k < tap.picker.count()) : (k += 1) {
            const centre: i32 = @intCast(k * bpx + bpx / 2);
            const landed = tap.tap_at(centre);
            assert(landed != null);
            assert(landed.? == k);
            assert(tap.picker.selection == k);
            const grid = try tap.paint(garden);
            assert_marker_on(&grid, k, tcols); // the band tapped is the band marked
        }
    }

    // A tap off the left edge and a tap past the last band each fire nothing — the selection stays put.
    {
        tap.picker.select_to(4); // park on a known filter
        const off_left = tap.tap_at(-1);
        assert(off_left == null);
        assert(tap.picker.selection == 4);
        const past: i32 = @intCast(tap.picker.count() * bpx + 3); // beyond the last band
        const off_right = tap.tap_at(past);
        assert(off_right == null);
        assert(tap.picker.selection == 4);
    }

    // A tapped filter commits into the history: tap "noir" (band 3, two verbs), commit pushes two edits, the view is the
    // named filter byte-for-byte.
    {
        var fresh = try FilterStripTap.open(&pm, tcols, trows);
        const bp = fresh.band_px();
        const centre: i32 = @intCast(3 * bp + bp / 2);
        const landed = fresh.tap_at(centre);
        assert(landed.? == 3);
        assert(std.mem.eql(u8, fresh.picker.selected_name(), "noir"));
        const pushed = try fresh.commit(garden);
        assert(pushed == 2);
        const v = try fresh.current_view(garden);
        const named = try filter_preset.apply_preset(garden, &fresh.picker.book, "noir", &pm);
        assert(v.same_bytes(&named)); // the tapped-and-committed filter is exactly the named recipe
    }

    // A zero-dimension thumbnail refuses BadThumb at open, before any picker is built.
    {
        if (FilterStripTap.open(&pm, 0, trows)) |_| return error.ThumbSlipped else |e| {
            if (e != error.BadThumb) return error.WrongThumb;
        }
    }

    print("GREEN filter-strip-tap: a 4x4 colour source — a tap centered on band k selects filter k and the repainted " ++
        "marker sits on exactly band k for every filter (no drift); a tap off the left edge and a tap past the last " ++
        "band each fire nothing (the selection unmoved); tapping noir (band 3) then committing pushes two edits and " ++
        "the view is the named filter byte-for-byte; a zero-dimension thumbnail refuses BadThumb. HUNK64 strip, HUNK63 " ++
        "picker, HUNK55 tap idiom GREEN beneath; no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: filter_strip_tap selftest\n", .{});
    return 1;
}
