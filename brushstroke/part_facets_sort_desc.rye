//! brushstroke/part_facets_sort_desc.rye — HUNK91: the sort a keeper can reverse — the faceted result read
//! dearest-first, still stable, still a permutation.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK91.
//! Design read: active-designing/date/20260814/20260814-013432_hunk-part-facets-sort-direction-exploration.md
//! Teacher, thanked clean-room: a search box whose price sort turns both ways — low to high, high to low (concept only,
//! siloed).
//!
//! HUNK89 sorts the faceted result cheapest-first and HUNK90 names that sort above the parts, yet the direction is
//! fixed — a keeper can find the least dear part, never the dearest. A real sort control turns both ways. This rung is
//! the descending half, mirroring HUNK89 clause for clause: `sort_by_price_desc` reorders a catalog DESCENDING by its
//! recorded cent count, ties keeping HELD ORDER (a stable sort, the same tie rule as ascending — never reversed), and
//! `facets_sorted_desc_shelf` composes it after the faceted filter, so the drawn page reads dearest-first. It is
//! additive: HUNK89's ascending functions keep their names and their GREEN witness; this pair sits beside them.
//!
//! The crux is that a tie is broken by HELD ORDER in BOTH directions, so descending is NOT a naive reversal of the
//! ascending array — for a result with no ties the two are exact reverses, yet two equal-price parts read in the order
//! a keeper added them whichever way the sort turns. The sort stays a PERMUTATION: same parts as a set, only reordered.
//! A malformed clause surfaces the parser's named refusal before any sort.
//!
//! A price is compared and reordered by; nothing is moved (custody gate %3 untouched). No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/part_facets_sort_desc.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const sprite = @import("sprite.rye");
const part_catalog = @import("part_catalog.rye");
const part_facets = @import("part_facets.rye");
const part_facets_sort = @import("part_facets_sort.rye");
const part_row = @import("part_row.rye");
const skate = @import("skate_grid.rye");

pub const part_facets_sort_desc_version = "20260814.013432";

/// Build `out` as a fresh sub-catalog over `src`'s own sheet, holding every part of `src` in DESCENDING price order.
/// Ties keep HELD ORDER — a stable sort, the same tie rule as the ascending sort, so two parts at the same price read
/// in the order a keeper added them whichever way the sort turns (descending is not a naive reversal). The reorder is a
/// selection over an index permutation bounded by `sprite.max_products`; each chosen part is re-added through
/// `add_part`, so every window is re-validated against the shared sheet and every fact re-checked.
pub fn sort_by_price_desc(src: *const part_catalog.PartCatalog, out: *part_catalog.PartCatalog) !void {
    // invariant: the source never outgrew its own sheet's product ceiling.
    assert(src.len() <= sprite.max_products);
    out.* = part_catalog.PartCatalog.init(src.index.sheet);
    // invariant: sorting starts from an empty sub-catalog over the source's own sheet.
    assert(out.len() == 0);
    assert(out.index.sheet == src.index.sheet);

    const n = src.len();
    var taken: [sprite.max_products]bool = [_]bool{false} ** sprite.max_products;

    // Selection sort: n times, pick the DEAREST not-yet-taken part, earliest held index breaking ties (stable, held
    // order — the same tie rule as ascending, so a tie is not reversed when the direction flips).
    var placed: u32 = 0;
    while (placed < n) : (placed += 1) {
        // invariant: fewer parts are placed than the source holds until the last is chosen.
        assert(placed < n);
        var best: u32 = n; // n marks "none chosen yet" — a real index is always < n
        var best_price: u64 = 0;
        var i: u32 = 0;
        while (i < n) : (i += 1) {
            if (taken[i]) continue;
            const price = src.facts_at(i).price_cents;
            // A strict `>` keeps the earliest held index among equal prices — the tie stays in held order.
            if (best == n or price > best_price) {
                best = i;
                best_price = price;
            }
        }
        // invariant: a not-yet-taken part was found on every pass (placed < n guarantees one remains).
        assert(best < n);
        taken[best] = true;
        const e = src.index.entry(best);
        const f = src.facts_at(best);
        try out.add_part(e.name, e.win.x, e.win.y, e.win.w, e.win.h, f.part_number, f.material, f.price_cents);
    }
    // invariant: the sorted sub-catalog holds exactly as many parts as the source — a permutation, never a change.
    assert(out.len() == src.len());
}

/// Draw the faceted page in descending price order — parse the faceted line, filter the catalog into the query's kept
/// parts, sort those dearest-first (`sort_by_price_desc`), and render the page `[offset, offset + rows)`. So a keeper
/// shopping for the best part rather than the cheapest is served the same result, read the other way. A malformed
/// clause surfaces the parser's named refusal before any sort; an offset past the sorted result refuses `BadOffset`
/// exactly as `part_window` does. The drawn grid owns its cells, so it outlives the local sub-catalogs whose sheet is
/// the caller's original.
pub fn facets_sorted_desc_shelf(
    allocator: std.mem.Allocator,
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    cols: u32,
    rows: u32,
    offset: u32,
) !skate.Grid {
    // invariant: the catalog never outgrew its own sheet's product ceiling before it is searched.
    assert(cat.len() <= sprite.max_products);
    const fq = try part_facets.parse_facets(text);
    var kept: part_catalog.PartCatalog = undefined;
    try part_facets.filter_facets(cat, fq, &kept);
    var sorted: part_catalog.PartCatalog = undefined;
    try sort_by_price_desc(&kept, &sorted);
    // invariant: sorting is a permutation — the sorted result holds exactly the filtered result's parts.
    assert(sorted.len() == kept.len());
    // invariant: the sorted sub-catalog windows into the caller's own sheet, never a copy.
    assert(sorted.index.sheet == cat.index.sheet);
    return part_row.part_window(allocator, &sorted, cols, rows, offset);
}

// --- selftest: five parts across four bands with a price spread and a 55c tie — the descending sort reads
//     dearest-first, is the exact reverse of ascending on distinct prices, keeps held order on ties (not reversed),
//     is a permutation, and the named refusals fire ---------------------------------------------------------------

/// A 16×8 sheet in four solid vertical bands (the part_row fixture), so a 4-wide window carries one known color.
fn craft_bands(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 16;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const band = x / 4; // 0..3
            buf[off] = if (band == 0 or band == 3) 255 else 0; // r
            buf[off + 1] = if (band == 1 or band == 3) 255 else 0; // g
            buf[off + 2] = if (band == 2) 255 else 0; // b
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// Read a row's fact line back as bytes — trim the blank tail, so the selftest sees exactly the painted fact text.
fn row_text(grid: *const skate.Grid, row: u32, out: []u8) u32 {
    const cells = grid.row_cells(row);
    var n: u32 = @intCast(cells.len);
    while (n > 0 and cells[n - 1] == ' ') : (n -= 1) {}
    var i: u32 = 0;
    while (i < n) : (i += 1) out[i] = cells[i];
    return n;
}

/// True if the sorted catalog holds exactly `src`'s parts as a set — every source name found once. Proves permutation.
fn same_parts_as_set(src: *const part_catalog.PartCatalog, sorted: *const part_catalog.PartCatalog) bool {
    if (src.len() != sorted.len()) return false;
    var i: u32 = 0;
    while (i < src.len()) : (i += 1) {
        const name = src.index.entry(i).name;
        var found: u32 = 0;
        var j: u32 = 0;
        while (j < sorted.len()) : (j += 1) {
            if (std.mem.eql(u8, sorted.index.entry(j).name, name)) found += 1;
        }
        if (found != 1) return false;
    }
    return true;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const sheet = try craft_bands(garden);
    var cat = part_catalog.PartCatalog.init(&sheet);
    // Five parts with a price spread and a 55c tie: bolt 125c, nut 60c, gear 845c, hexnut 55c, washer 55c.
    try cat.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
    try cat.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
    try cat.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
    try cat.add_part("hexnut", 12, 0, 4, 8, "HX-N8", "stainless-304", 55);
    try cat.add_part("washer", 12, 0, 4, 8, "FW-M8", "stainless-304", 55);
    assert(cat.len() == 5);

    const cols: u32 = 48;

    // DEAREST-FIRST and STABLE ON TIES (held order, NOT reversed): the descending sort reads gear(845), bolt(125),
    // nut(60), then the 55c tie in HELD order — hexnut before washer, the SAME order the ascending sort gives them.
    {
        var sorted: part_catalog.PartCatalog = undefined;
        try sort_by_price_desc(&cat, &sorted);
        assert(sorted.len() == 5);
        assert(std.mem.eql(u8, sorted.index.entry(0).name, "gear")); // 845c
        assert(std.mem.eql(u8, sorted.index.entry(1).name, "bolt")); // 125c
        assert(std.mem.eql(u8, sorted.index.entry(2).name, "nut")); // 60c
        assert(std.mem.eql(u8, sorted.index.entry(3).name, "hexnut")); // 55c, added first of the tie — held order
        assert(std.mem.eql(u8, sorted.index.entry(4).name, "washer")); // 55c, added second — held order, NOT reversed
        // Descending: no ascent anywhere.
        var i: u32 = 1;
        while (i < sorted.len()) : (i += 1) {
            assert(sorted.facts_at(i).price_cents <= sorted.facts_at(i - 1).price_cents);
        }
        // A PERMUTATION: same parts as a set, only reordered.
        assert(same_parts_as_set(&cat, &sorted));
    }

    // The EXACT REVERSE of ascending on a DISTINCT-price result: bolt(125), nut(60), gear(845) have no ties, so
    // descending reads gear, bolt, nut and ascending nut, bolt, gear — one the reverse of the other, part for part.
    {
        var kept = part_catalog.PartCatalog.init(&sheet);
        try kept.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
        try kept.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
        try kept.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
        var asc: part_catalog.PartCatalog = undefined;
        try part_facets_sort.sort_by_price(&kept, &asc);
        var desc: part_catalog.PartCatalog = undefined;
        try sort_by_price_desc(&kept, &desc);
        assert(asc.len() == desc.len());
        var i: u32 = 0;
        while (i < asc.len()) : (i += 1) {
            const a = asc.index.entry(i).name;
            const d = desc.index.entry(asc.len() - 1 - i).name;
            assert(std.mem.eql(u8, a, d)); // descending[i] == ascending[n-1-i] when no ties
        }
    }

    // The descending faceted shelf: (stainless OR brass) max:100 keeps nut(60), hexnut(55), washer(55) — descending
    // reads nut, hexnut, washer top to bottom (dearest-first, tie in held order).
    {
        const line = "material:stainless-304|material:brass max:100";
        const page = try facets_sorted_desc_shelf(garden, &cat, line, cols, 4, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "nut  NY-M8  brass  $0.60"));
        const r1 = row_text(&page, 1, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r1], "hexnut  HX-N8  stainless-304  $0.55"));
        const r2 = row_text(&page, 2, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r2], "washer  FW-M8  stainless-304  $0.55"));
        const r3 = row_text(&page, 3, buf[0..]);
        assert(r3 == 0);
    }

    // An empty line is a MATCH-ALL, descending: every part drawn dearest-first — gear first (845c), the 55c tie last.
    {
        const page = try facets_sorted_desc_shelf(garden, &cat, "", cols, 5, 0);
        var buf: [part_row.max_fact_line]u8 = undefined;
        const r0 = row_text(&page, 0, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r0], "gear  GR-24T  acetal  $8.45"));
        const r4 = row_text(&page, 4, buf[0..]);
        assert(std.mem.startsWith(u8, buf[0..r4], "washer  FW-M8  stainless-304  $0.55"));
    }

    // A malformed clause surfaces the parser's own named refusal before any sort.
    if (facets_sorted_desc_shelf(garden, &cat, "material:stainless-304|color:red", cols, 4, 0)) |_| {
        return error.LineSlipped;
    } else |e| {
        if (e != error.UnknownKey) return error.WrongLine;
    }

    // An offset past the sorted result refuses BadOffset — three matches, so offset 3 at one row per page is past it.
    if (facets_sorted_desc_shelf(garden, &cat, "material:stainless-304|material:brass max:100", cols, 1, 3)) |_| {
        return error.OffsetSlipped;
    } else |e| {
        if (e != error.BadOffset) return error.WrongOffset;
    }

    print("GREEN part-facets-sort-desc: five parts across four bands with a 55c tie — sort_by_price_desc reads " ++
        "dearest-first (845, 125, 60, 55, 55), stable on the tie in HELD order (hexnut before washer, NOT reversed), " ++
        "the exact reverse of ascending on a distinct-price result (descending[i] == ascending[n-1-i]), a permutation " ++
        "of the source (same parts as a set, every price <= the row above); the descending faceted shelf draws " ++
        "(stainless|brass) max:100 dearest-first (nut, hexnut, washer), an empty line is a match-all descending (gear " ++
        "first, the 55c tie last); a malformed clause refuses before any sort (UnknownKey) and an offset past the " ++
        "result refuses BadOffset; a price is a fact compared and reordered by, never moved — no network, no key, no " ++
        "funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: part_facets_sort_desc selftest\n", .{});
    return 1;
}
