//! brushstroke/brush_parse.rye — .brush → Frame → stdout/Skate grid (p23–p28 · p52).
//!
//! `.brush` describes how a value at a nib is drawn. Parse · refuse · lower to
//! glass `Frame` (alias `BrushFrame` for the sur museum); `redraw_brush_frame`
//! paints stdout; `brush_frame_to_grid` fills a skate_grid.Grid (headless raster
//! proof). No Wayland window · no CSS/HTML/JSON.
//!
//! TAME (hosted Rye): opening triad · u32 counts · named bounds · `// invariant:`
//! on every assert · short verb-named functions · named errors with try.
//!
//! Build and run:
//!   mkdir -p brushstroke/bin
//!   export RYE_ZIG="$PWD/vendor/zig-toolchain/zig"
//!   rye/bin/rye build brushstroke/brush_parse.rye -femit-bin=brushstroke/bin/brush-parse
//!   brushstroke/bin/brush-parse selftest
//!   brushstroke/bin/brush-parse brushstroke/seed-frame.brush
//!   brushstroke/bin/brush-parse lower brushstroke/seed-frame.brush
//!   brushstroke/bin/brush-parse redraw brushstroke/seed-frame.brush
//!   brushstroke/bin/brush-parse grid brushstroke/seed-frame.brush

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const skate = @import("skate_grid.rye");

pub const brush_parse_version = "20260728.215608";

/// Tally-bounded Frame ceiling — matches seed.rye · wayland_seed.rye · sur pedestal.
pub const max_frame_lines: u32 = 8;

/// Thin Skate proof grid — not the full Wayland window; seats seed Frame lines.
pub const brush_skate_cols: u32 = 40;
pub const brush_skate_rows: u32 = max_frame_lines;

/// Bound on a single .brush source file this parser will read.
pub const max_brush_bytes: u32 = 16 * 1024;

/// Bound on one pin value (nib name · present word) after trim.
pub const max_pin_bytes: u32 = 128;

/// Bound on the OPTIONAL `style:` block's token count — one flat Bron token per
/// line (paper · ink · edge · weight · space · elevate and their kin). Sized to
/// hold the seam's named token family with headroom, well under infuse's 64.
pub const max_style_tokens: u32 = 16;

/// Bound on the reassembled `style:` token sheet in bytes — a bounded Bron buffer
/// tokens.rye's infuse/dress consume directly (infuse's own max_line is 512).
pub const max_style_bytes: u32 = 512;

pub const BrushSurface = struct {
    at_nib: []const u8,
    present: []const u8,
    max_lines: u32,
    line_count: u32,
    /// Count of `style:` token lines seen. Zero when the file declares no style
    /// block — the additive default, byte-for-byte the pre-style parse.
    style_count: u32,
};

/// Frame lowered from a welcome .brush — line texts slice the source buffer.
/// Glass contract name is `Frame` (p52); `BrushFrame` stays the seated museum alias.
pub const BrushFrame = struct {
    at_nib: []const u8,
    max_lines: u32,
    lines: []const []const u8,
};

/// Glass Frame — same type as BrushFrame. Wayland host converts via Frame.from_brush.
pub const Frame = BrushFrame;

pub const ParseError = error{
    MissingAtNib,
    MissingPresent,
    PresentNotFrame,
    MissingMaxLines,
    MaxLinesOutOfBound,
    MissingLines,
    EmptyLine,
    TooManyLines,
    BadMaxLines,
    SourceTooLarge,
    TooManyStyleTokens,
    StyleTokenMalformed,
    StyleSheetTooLarge,
};

/// Raw pins collected while scanning — unfinished until `finish_brush_surface`.
const BrushPins = struct {
    at_nib: ?[]const u8 = null,
    present: ?[]const u8 = null,
    max_lines: ?u32 = null,
    line_count: u32 = 0,
    saw_lines_header: bool = false,
    style_count: u32 = 0,
    saw_style_header: bool = false,
};

/// Parse a .brush source buffer into a BrushSurface.
pub fn parse_brush(src: []const u8) ParseError!BrushSurface {
    // invariant: source fits the named read budget before any scan work
    assert(src.len <= max_brush_bytes);
    const pins = try scan_brush_pins(src);
    return try finish_brush_surface(pins);
}

/// Scan comment lines for the four surface pins. Placard prose is skipped.
fn scan_brush_pins(src: []const u8) ParseError!BrushPins {
    // invariant: caller already bound the buffer
    assert(src.len <= max_brush_bytes);

    var pins = BrushPins{};
    var in_lines = false;
    var in_style = false;
    var it = std.mem.splitScalar(u8, src, '\n');
    while (it.next()) |raw| {
        const line = trim_right(raw);
        const line_len = slice_len_u32(line);
        if (line_len == 0) continue;
        if (!std.mem.startsWith(u8, line, "::")) continue;

        const body = trim_left(line[2..]);
        if (try take_pin(body, "at-nib:", &pins.at_nib)) {
            in_lines = false;
            in_style = false;
            continue;
        }
        if (try take_pin(body, "present:", &pins.present)) {
            in_lines = false;
            in_style = false;
            continue;
        }
        if (std.mem.startsWith(u8, body, "max-lines:")) {
            const text = trim_left(body["max-lines:".len..]);
            pins.max_lines = try parse_u32_decimal(text);
            in_lines = false;
            in_style = false;
            continue;
        }
        if (std.mem.startsWith(u8, body, "lines:")) {
            pins.saw_lines_header = true;
            in_lines = true;
            in_style = false;
            continue;
        }
        // OPTIONAL `style:` block — a flat Bron token sheet tokens.rye consumes.
        // Additive: a file with no `style:` header never enters this branch, so
        // its parse is byte-for-byte the pre-style behavior.
        if (std.mem.startsWith(u8, body, "style:")) {
            pins.saw_style_header = true;
            in_style = true;
            in_lines = false;
            continue;
        }
        if (std.mem.startsWith(u8, body, "refuse:")) {
            in_lines = false;
            in_style = false;
            continue;
        }
        if (in_style) {
            in_style = try count_style_token(line, body, &pins.style_count);
            continue;
        }
        if (in_lines) {
            in_lines = try count_frame_line(line, body, &pins.line_count);
        }
    }
    // invariant: scan never invents a line count past the Frame ceiling
    assert(pins.line_count <= max_frame_lines);
    // invariant: scan never invents a style-token count past its own bound
    assert(pins.style_count <= max_style_tokens);
    return pins;
}

/// Finish pins into a surface — every refuse path is a named ParseError.
fn finish_brush_surface(pins: BrushPins) ParseError!BrushSurface {
    const nib = pins.at_nib orelse return error.MissingAtNib;
    // invariant: at-nib pin is non-empty when present
    if (slice_len_u32(nib) == 0) return error.MissingAtNib;

    const pres = pins.present orelse return error.MissingPresent;
    if (!std.mem.eql(u8, pres, "Frame")) return error.PresentNotFrame;

    const ceiling = pins.max_lines orelse return error.MissingMaxLines;
    // invariant: max-lines is a living Frame ceiling, not zero and not past seed
    if (ceiling == 0 or ceiling > max_frame_lines) return error.MaxLinesOutOfBound;

    if (!pins.saw_lines_header) return error.MissingLines;
    if (pins.line_count == 0) return error.MissingLines;
    if (pins.line_count > ceiling) return error.TooManyLines;

    // invariant: a declared style block carries at least one token, never empty
    if (pins.saw_style_header and pins.style_count == 0) return error.StyleTokenMalformed;

    const surface = BrushSurface{
        .at_nib = nib,
        .present = pres,
        .max_lines = ceiling,
        .line_count = pins.line_count,
        .style_count = pins.style_count,
    };
    // invariant: present is Frame after finish
    assert(std.mem.eql(u8, surface.present, "Frame"));
    // invariant: nib survived non-empty
    assert(surface.at_nib.len > 0);
    // invariant: at least one drawn line
    assert(surface.line_count > 0);
    // invariant: line_count respects the file's own ceiling
    assert(surface.line_count <= surface.max_lines);
    // invariant: file ceiling respects the seed Frame bound
    assert(surface.max_lines <= max_frame_lines);
    return surface;
}

/// If `body` starts with `key`, store the trimmed value and return true.
fn take_pin(body: []const u8, key: []const u8, slot: *?[]const u8) ParseError!bool {
    // invariant: keys are the short pin names we author
    assert(key.len > 0);
    assert(key.len <= max_pin_bytes);
    if (!std.mem.startsWith(u8, body, key)) return false;
    const value = trim_left(body[key.len..]);
    // invariant: pin values stay inside the named byte budget
    if (slice_len_u32(value) > max_pin_bytes) return error.SourceTooLarge;
    slot.* = value;
    return true;
}

/// Count one indented Frame line under `lines:`. Returns whether still in-lines.
fn count_frame_line(line: []const u8, body: []const u8, line_count: *u32) ParseError!bool {
    // invariant: counter never enters past the Frame ceiling
    assert(line_count.* <= max_frame_lines);
    if (slice_len_u32(body) == 0) return error.EmptyLine;
    // Line bodies under `lines:` are indented (`::  text`) in the fixture.
    const line_len = slice_len_u32(line);
    if (line_len >= 4 and line[2] == ' ' and line[3] == ' ') {
        const text = trim_left(body);
        if (slice_len_u32(text) == 0) return error.EmptyLine;
        line_count.* += 1;
        if (line_count.* > max_frame_lines) return error.TooManyLines;
        return true;
    }
    return false;
}

/// Count one indented `style:` token line (`::    key value`). Returns whether
/// still in-style. A token is a flat Bron pair: a space-delimited key and a
/// non-empty value — exactly what tokens.rye's infuse/dress parse.
fn count_style_token(line: []const u8, body: []const u8, style_count: *u32) ParseError!bool {
    // invariant: counter never enters past the style-token ceiling
    assert(style_count.* <= max_style_tokens);
    if (slice_len_u32(body) == 0) return error.StyleTokenMalformed;
    // Style tokens under `style:` are indented (`::    key value`) like `lines:`.
    const line_len = slice_len_u32(line);
    if (line_len >= 4 and line[2] == ' ' and line[3] == ' ') {
        const text = trim_left(body);
        // invariant: a style token names a key and a value, never a bare word
        if (!style_token_well_formed(text)) return error.StyleTokenMalformed;
        style_count.* += 1;
        if (style_count.* > max_style_tokens) return error.TooManyStyleTokens;
        return true;
    }
    return false;
}

/// A well-formed style token is `key value`: a non-empty key, a space, then a
/// non-empty value — the flat Bron shape tokens.rye parses. No CSS `:`/`;`, no
/// braces; the owned tongue only.
fn style_token_well_formed(text: []const u8) bool {
    const n = slice_len_u32(text);
    if (n == 0) return false;
    var sp: u32 = 0;
    // invariant: the key scan stays inside the trimmed token
    while (sp < n and text[sp] != ' ') : (sp += 1) {}
    if (sp == 0) return false; // no key
    if (sp >= n) return false; // no space → no value
    const val = trim_left(text[sp..]);
    // invariant: a value survives after the key and its separating space
    if (slice_len_u32(val) == 0) return false;
    return true;
}

/// Collect line-body slices under `lines:` into `line_buf` (second pass after parse).
fn collect_brush_lines(src: []const u8, line_buf: *[max_frame_lines][]const u8) ParseError!u32 {
    // invariant: collect shares parse's source budget
    assert(src.len <= max_brush_bytes);
    var line_count: u32 = 0;
    var in_lines = false;
    var it = std.mem.splitScalar(u8, src, '\n');
    while (it.next()) |raw| {
        const line = trim_right(raw);
        if (slice_len_u32(line) == 0) continue;
        if (!std.mem.startsWith(u8, line, "::")) continue;
        const body = trim_left(line[2..]);
        if (std.mem.startsWith(u8, body, "lines:")) {
            in_lines = true;
            continue;
        }
        if (std.mem.startsWith(u8, body, "at-nib:") or std.mem.startsWith(u8, body, "present:") or std.mem.startsWith(u8, body, "max-lines:") or std.mem.startsWith(u8, body, "refuse:") or std.mem.startsWith(u8, body, "style:")) {
            in_lines = false;
            continue;
        }
        if (!in_lines) continue;
        const line_len = slice_len_u32(line);
        if (line_len < 4 or line[2] != ' ' or line[3] != ' ') {
            in_lines = false;
            continue;
        }
        const text = trim_left(body);
        if (slice_len_u32(text) == 0) return error.EmptyLine;
        // invariant: buffer slot matches the living count
        assert(line_count < max_frame_lines);
        line_buf.*[line_count] = text;
        line_count += 1;
        if (line_count > max_frame_lines) return error.TooManyLines;
    }
    if (line_count == 0) return error.MissingLines;
    // invariant: collected count never past the Frame ceiling
    assert(line_count <= max_frame_lines);
    return line_count;
}

/// Lower a welcome .brush into a BrushFrame. Line texts borrow from `src`.
pub fn lower_brush(src: []const u8, line_buf: *[max_frame_lines][]const u8) ParseError!BrushFrame {
    const surface = try parse_brush(src);
    const n = try collect_brush_lines(src, line_buf);
    // invariant: collect agrees with the parse line_count
    assert(n == surface.line_count);
    const frame = BrushFrame{
        .at_nib = surface.at_nib,
        .max_lines = surface.max_lines,
        .lines = line_buf.*[0..n],
    };
    // invariant: lowered Frame carries at least one line
    assert(frame.lines.len > 0);
    // invariant: lowered count respects the file ceiling
    assert(frame.lines.len <= frame.max_lines);
    for (frame.lines) |text| {
        // invariant: every lowered line is non-empty
        assert(text.len > 0);
    }
    return frame;
}

/// Reassemble the OPTIONAL `style:` block into a flat Bron token sheet in
/// `out` — `key value\n` per token, exactly the shape tokens.rye's infuse and
/// dress parse. Returns the byte length written (0 when the file declares no
/// style block). This is the WADE1 bridge: a `.brush` file → a token sheet.
pub fn collect_brush_style(src: []const u8, out: []u8) ParseError!u32 {
    // invariant: collect shares parse's source budget
    assert(src.len <= max_brush_bytes);
    // invariant: the destination stays inside the named style-sheet bound
    assert(out.len <= max_style_bytes);
    var pos: u32 = 0;
    var token_count: u32 = 0;
    var in_style = false;
    var it = std.mem.splitScalar(u8, src, '\n');
    while (it.next()) |raw| {
        const line = trim_right(raw);
        if (slice_len_u32(line) == 0) continue;
        if (!std.mem.startsWith(u8, line, "::")) continue;
        const body = trim_left(line[2..]);
        if (std.mem.startsWith(u8, body, "style:")) {
            in_style = true;
            continue;
        }
        if (std.mem.startsWith(u8, body, "at-nib:") or std.mem.startsWith(u8, body, "present:") or std.mem.startsWith(u8, body, "max-lines:") or std.mem.startsWith(u8, body, "lines:") or std.mem.startsWith(u8, body, "refuse:")) {
            in_style = false;
            continue;
        }
        if (!in_style) continue;
        const line_len = slice_len_u32(line);
        if (line_len < 4 or line[2] != ' ' or line[3] != ' ') {
            in_style = false;
            continue;
        }
        const text = trim_left(body);
        // invariant: a collected token is the well-formed shape the scan proved
        if (!style_token_well_formed(text)) return error.StyleTokenMalformed;
        // invariant: token slot matches the living count under the ceiling
        assert(token_count < max_style_tokens);
        pos = try emit_style_line(out, pos, text);
        token_count += 1;
        if (token_count > max_style_tokens) return error.TooManyStyleTokens;
    }
    // invariant: collected token count never past the style ceiling
    assert(token_count <= max_style_tokens);
    // invariant: written bytes stay inside the style-sheet bound
    assert(pos <= max_style_bytes);
    return pos;
}

/// Append one already-trimmed `key value` token, plus a newline, to `out`.
/// Refuses to overflow the bounded style sheet rather than truncating.
fn emit_style_line(out: []u8, pos: u32, text: []const u8) ParseError!u32 {
    const text_len = slice_len_u32(text);
    const need: u32 = text_len + 1; // token bytes plus the trailing newline
    // invariant: the style sheet stays within its named byte bound
    if (@as(u32, pos) + need > max_style_bytes) return error.StyleSheetTooLarge;
    // invariant: the write never runs past the destination buffer
    if (@as(usize, pos) + need > out.len) return error.StyleSheetTooLarge;
    var p: u32 = pos;
    var i: u32 = 0;
    while (i < text_len) : (i += 1) {
        out[p] = text[i];
        p += 1;
    }
    out[p] = '\n';
    p += 1;
    // invariant: the cursor advanced by exactly the token plus its newline
    assert(p == pos + need);
    return p;
}

/// Redraw a BrushFrame to stdout — thin hosted Skate lean (one line = one grid row).
/// Pure pass from values; no Wayland · no retained tree.
/// The column count a grid needs to hold this frame with nothing truncated.
/// `Grid.put_line` clips silently at `cols`, so a caller sizing a grid asks
/// here first and learns the requirement before the machine runs.
pub fn frame_widest_line(frame: BrushFrame) u32 {
    assert(frame.lines.len <= max_frame_lines); // invariant: frame within its bound
    assert(frame.max_lines <= max_frame_lines); // invariant: stated bound honest
    var widest: u32 = 0;
    for (frame.lines) |line| {
        assert(line.len <= std.math.maxInt(u32)); // seam: std length into u32
        const width: u32 = @intCast(line.len);
        if (width > widest) widest = width;
    }
    assert(widest <= max_brush_bytes); // postcondition: width inside the byte bound
    return widest;
}

pub fn redraw_brush_frame(frame: BrushFrame, io: std.Io) !void {
    // invariant: Frame carries at least one line before paint
    assert(frame.lines.len > 0);
    // invariant: paint respects the file ceiling
    assert(frame.lines.len <= frame.max_lines);
    // invariant: ceiling never past the seed Frame bound
    assert(frame.max_lines <= max_frame_lines);
    // invariant: nib survives to the paint edge
    assert(frame.at_nib.len > 0);
    const stdout = std.Io.File.stdout();
    for (frame.lines) |text| {
        // invariant: empty lines never reach the surface
        assert(text.len > 0);
        try stdout.writeStreamingAll(io, text);
        try stdout.writeStreamingAll(io, "\n");
    }
}

/// Fill a skate_grid.Grid from a BrushFrame — Pond agents' Skate target (p28).
pub fn brush_frame_to_grid(frame: BrushFrame, allocator: std.mem.Allocator) !skate.Grid {
    // invariant: Frame carries lines before grid fill
    assert(frame.lines.len > 0);
    // invariant: Frame ceiling fits the proof grid rows
    assert(frame.max_lines <= brush_skate_rows);
    // invariant: line count respects the Frame ceiling
    assert(frame.lines.len <= frame.max_lines);
    var grid = try skate.Grid.init(allocator, brush_skate_cols, brush_skate_rows);
    var i: u32 = 0;
    const n: u32 = @intCast(frame.lines.len);
    while (i < n) : (i += 1) {
        // invariant: row index stays inside the Skate proof grid
        assert(i < brush_skate_rows);
        grid.put_line(i, frame.lines[i]);
    }
    // invariant: grid shape is the named proof budget
    assert(grid.cols == brush_skate_cols);
    assert(grid.rows == brush_skate_rows);
    return grid;
}

/// Headless raster lit-pixel count for a grid — proves glyphs left the buffer.
fn grid_lit_count(garden: std.mem.Allocator, grid: skate.Grid) !u32 {
    const scale: u32 = 1;
    const width: i32 = @intCast(brush_skate_cols * skate.cell_w * scale);
    const height: i32 = @intCast(brush_skate_rows * skate.cell_h * scale);
    // invariant: proof window is positive
    assert(width > 0);
    assert(height > 0);
    const stride: u32 = @intCast(@as(u32, @intCast(width)) * 4);
    const pixel_bytes: u32 = stride * @as(u32, @intCast(height));
    const pixels = try garden.alloc(u8, pixel_bytes);
    const bg = skate.Color{ .r = 0, .g = 0, .b = 0 };
    const fg = skate.Color{ .r = 255, .g = 255, .b = 255 };
    grid.rasterize(pixels, stride, width, height, bg, fg, scale);
    const lit = grid.lit_pixel_count(pixels, stride, width, height, bg);
    // invariant: seed Frame glyphs light at least one pixel
    assert(lit > 0);
    return lit;
}

fn trim_left(s: []const u8) []const u8 {
    var i: u32 = 0;
    const n = slice_len_u32(s);
    while (i < n and (s[i] == ' ' or s[i] == '\t')) : (i += 1) {}
    // invariant: cursor stays inside the slice
    assert(i <= n);
    return s[i..];
}

fn trim_right(s: []const u8) []const u8 {
    const n = slice_len_u32(s);
    if (n == 0) return s;
    var end: u32 = n;
    while (end > 0 and (s[end - 1] == ' ' or s[end - 1] == '\t' or s[end - 1] == '\r')) : (end -= 1) {}
    // invariant: trim never grows the slice
    assert(end <= n);
    return s[0..end];
}

/// Zig slice `.len` is usize at the inherited seam — authored arithmetic stays u32.
fn slice_len_u32(s: []const u8) u32 {
    // invariant: brush buffers never exceed the named source budget
    assert(s.len <= max_brush_bytes);
    return @intCast(s.len);
}

fn parse_u32_decimal(text: []const u8) ParseError!u32 {
    const n = slice_len_u32(text);
    if (n == 0) return error.BadMaxLines;
    var value: u32 = 0;
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        const c = text[i];
        if (c < '0' or c > '9') return error.BadMaxLines;
        const digit: u32 = c - '0';
        // invariant: decimal growth refuses overflow before wrap
        if (value > (std.math.maxInt(u32) - digit) / 10) return error.BadMaxLines;
        value = value * 10 + digit;
    }
    return value;
}

/// Prove one refuse path by named ParseError — call-seam capture, not `) == error.`.
fn assert_parse_error(src: []const u8, want: ParseError) void {
    // invariant: refuse fixtures stay inside the source budget
    assert(src.len <= max_brush_bytes);
    if (parse_brush(src)) |_| {
        unreachable;
    } else |err| {
        // invariant: refuse path names the seated error
        assert(err == want);
    }
}

fn prove_seed_fixture(garden: std.mem.Allocator, io: std.Io) !void {
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, "brushstroke/seed-frame.brush", garden, .limited(max_brush_bytes));
    // invariant: fixture read respects the same budget parse_brush asserts
    assert(src.len <= max_brush_bytes);
    const surface = try parse_brush(src);
    // invariant: seed fixture at-nib matches living seed name
    assert(std.mem.eql(u8, surface.at_nib, "brushstroke-seed"));
    // invariant: seed fixture presents Frame
    assert(std.mem.eql(u8, surface.present, "Frame"));
    // invariant: seed fixture ceiling is eight
    assert(surface.max_lines == 8);
    // invariant: seed Frame carries three example lines
    assert(surface.line_count == 3);
    // invariant: the seed fixture declares no style block — the additive default
    assert(surface.style_count == 0);
}

/// Prove the OPTIONAL `style:` block: a `.brush` declaring style pins parses
/// into a token sheet whose bytes are the flat Bron tokens.rye consumes, and a
/// `.brush` with no style block collects an empty sheet — additive by default.
fn prove_style_block() ParseError!void {
    const with_style =
        \\::  at-nib:     styled-seed
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  style:
        \\::    paper 0xFF2B2620
        \\::    ink 0xFFF2ECDF
        \\::    space 4
        \\::  lines:
        \\::    styled frame
    ;
    const surface = try parse_brush(with_style);
    // invariant: the style block's three tokens are counted
    assert(surface.style_count == 3);
    // invariant: the frame line beneath the style block still parses
    assert(surface.line_count == 1);

    var sheet_buf: [max_style_bytes]u8 = undefined;
    const n = try collect_brush_style(with_style, &sheet_buf);
    const sheet = sheet_buf[0..n];
    // invariant: the reassembled sheet carries the declared paper token
    assert(std.mem.indexOf(u8, sheet, "paper 0xFF2B2620") != null);
    // invariant: the reassembled sheet carries the declared ink token
    assert(std.mem.indexOf(u8, sheet, "ink 0xFFF2ECDF") != null);
    // invariant: the reassembled sheet carries the declared space token
    assert(std.mem.indexOf(u8, sheet, "space 4") != null);
    // invariant: no CSS punctuation leaked into the owned-tongue sheet
    assert(std.mem.indexOf(u8, sheet, ";") == null);
    assert(std.mem.indexOf(u8, sheet, "{") == null);

    // A .brush with no style block collects an empty sheet — additive default.
    const no_style =
        \\::  at-nib:     plain-seed
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  lines:
        \\::    plain frame
    ;
    const plain = try parse_brush(no_style);
    // invariant: absent style block leaves the style count at zero
    assert(plain.style_count == 0);
    var empty_buf: [max_style_bytes]u8 = undefined;
    const m = try collect_brush_style(no_style, &empty_buf);
    // invariant: no style block reassembles to zero bytes
    assert(m == 0);
}

/// Refuse a malformed or empty `style:` block by named ParseError.
fn prove_refuse_style() void {
    // A style header with no tokens is an empty block — refused.
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  style:
        \\::  lines:
        \\::    one line
    ,
        error.StyleTokenMalformed,
    );
    // A bare-word token (no value) is malformed — refused.
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  style:
        \\::    paper
        \\::  lines:
        \\::    one line
    ,
        error.StyleTokenMalformed,
    );
}

fn prove_seed_lower(garden: std.mem.Allocator, io: std.Io) !void {
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, "brushstroke/seed-frame.brush", garden, .limited(max_brush_bytes));
    // invariant: lower reads the same living fixture as parse
    assert(src.len <= max_brush_bytes);
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try lower_brush(src, &line_buf);
    // invariant: lower yields three seed-frame lines
    assert(frame.lines.len == 3);
    // invariant: nib survives into the Frame
    assert(std.mem.eql(u8, frame.at_nib, "brushstroke-seed"));
    // invariant: line 0 matches the fixture body
    assert(std.mem.eql(u8, frame.lines[0], "brushstroke seed"));
    // invariant: line 1 matches the fixture body
    assert(std.mem.eql(u8, frame.lines[1], "frame drawn from values"));
    // invariant: line 2 is the fixture placeholder (not seed.rye's version string)
    assert(std.mem.eql(u8, frame.lines[2], "(seed version string)"));
}

fn prove_seed_redraw(garden: std.mem.Allocator, io: std.Io) !void {
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, "brushstroke/seed-frame.brush", garden, .limited(max_brush_bytes));
    // invariant: redraw reads the same living fixture
    assert(src.len <= max_brush_bytes);
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try lower_brush(src, &line_buf);
    try redraw_brush_frame(frame, io);
    // invariant: paint path left the Frame bounds intact
    assert(frame.lines.len == 3);
    assert(frame.max_lines == 8);
}

fn prove_seed_grid(garden: std.mem.Allocator, io: std.Io) !void {
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, "brushstroke/seed-frame.brush", garden, .limited(max_brush_bytes));
    // invariant: grid path reads the same living fixture
    assert(src.len <= max_brush_bytes);
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try lower_brush(src, &line_buf);
    const grid = try brush_frame_to_grid(frame, garden);
    // invariant: first glyph of line 0 landed in row 0
    assert(grid.cells[0] == 'b');
    // invariant: first glyph of line 1 landed in row 1
    assert(grid.cells[brush_skate_cols] == 'f');
    const lit = try grid_lit_count(garden, grid);
    // invariant: raster left living ink
    assert(lit > 0);
}

/// Refuse missing / wrong identity pins.
fn prove_refuse_pins() void {
    assert_parse_error(
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  lines:
        \\::    one line
    ,
        error.MissingAtNib,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  max-lines:  8
        \\::  lines:
        \\::    one line
    ,
        error.MissingPresent,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Widget
        \\::  max-lines:  8
        \\::  lines:
        \\::    one line
    ,
        error.PresentNotFrame,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  lines:
        \\::    one line
    ,
        error.MissingMaxLines,
    );
}

/// Refuse bound and line-body failures.
fn prove_refuse_bounds() void {
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  0
        \\::  lines:
        \\::    one line
    ,
        error.MaxLinesOutOfBound,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  9
        \\::  lines:
        \\::    one line
    ,
        error.MaxLinesOutOfBound,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  abc
        \\::  lines:
        \\::    one line
    ,
        error.BadMaxLines,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  8
    ,
        error.MissingLines,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  lines:
    ,
        error.MissingLines,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  2
        \\::  lines:
        \\::    a
        \\::    b
        \\::    c
    ,
        error.TooManyLines,
    );
    assert_parse_error(
        \\::  at-nib:     x
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  lines:
        \\::    
    ,
        error.EmptyLine,
    );
}

fn run_selftest(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const io = init.io;
    try prove_seed_fixture(garden, io);
    prove_refuse_pins();
    prove_refuse_bounds();
    try prove_style_block();
    prove_refuse_style();
    try prove_seed_lower(garden, io);
    try prove_seed_redraw(garden, io);
    try prove_seed_grid(garden, io);
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse selftest — seed-frame · refuse-suite · style-block · lower · redraw · skate-grid · TAME\n");
    return 0;
}

fn load_brush_frame(garden: std.mem.Allocator, io: std.Io, path: []const u8, line_buf: *[max_frame_lines][]const u8) !BrushFrame {
    // invariant: path argument is non-empty
    assert(path.len > 0);
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, path, garden, .limited(max_brush_bytes));
    // invariant: path read stays inside the named budget
    assert(src.len <= max_brush_bytes);
    return try lower_brush(src, line_buf);
}

fn run_lower_path(garden: std.mem.Allocator, io: std.Io, path: []const u8) !u8 {
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try load_brush_frame(garden, io, path, &line_buf);
    print("brush-parse lower: at-nib={s} lines={d}\n", .{ frame.at_nib, frame.lines.len });
    try redraw_brush_frame(frame, io);
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse lower\n");
    return 0;
}

fn run_redraw_path(garden: std.mem.Allocator, io: std.Io, path: []const u8) !u8 {
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try load_brush_frame(garden, io, path, &line_buf);
    print("brush-parse redraw: at-nib={s} (stdout Skate lean)\n", .{frame.at_nib});
    try redraw_brush_frame(frame, io);
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse redraw\n");
    return 0;
}

fn run_style_path(garden: std.mem.Allocator, io: std.Io, path: []const u8) !u8 {
    // invariant: path argument is non-empty
    assert(path.len > 0);
    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, path, garden, .limited(max_brush_bytes));
    // invariant: path read stays inside the named budget
    assert(src.len <= max_brush_bytes);
    const surface = try parse_brush(src);
    var sheet_buf: [max_style_bytes]u8 = undefined;
    const n = try collect_brush_style(src, &sheet_buf);
    // invariant: the reassembled sheet honors the parsed token count's presence
    assert((n == 0) == (surface.style_count == 0));
    print("brush-parse style: at-nib={s} style-tokens={d} sheet-bytes={d}\n", .{
        surface.at_nib,
        surface.style_count,
        n,
    });
    const stdout = std.Io.File.stdout();
    try stdout.writeStreamingAll(io, "---sheet---\n");
    try stdout.writeStreamingAll(io, sheet_buf[0..n]);
    try stdout.writeStreamingAll(io, "---end---\n");
    try stdout.writeStreamingAll(io, "GREEN: brush-parse style\n");
    return 0;
}

fn run_grid_path(garden: std.mem.Allocator, io: std.Io, path: []const u8) !u8 {
    var line_buf: [max_frame_lines][]const u8 = undefined;
    const frame = try load_brush_frame(garden, io, path, &line_buf);
    const grid = try brush_frame_to_grid(frame, garden);
    const lit = try grid_lit_count(garden, grid);
    print("brush-parse grid: at-nib={s} cols={d} rows={d} lit={d}\n", .{
        frame.at_nib,
        grid.cols,
        grid.rows,
        lit,
    });
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse grid\n");
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(garden);
    // invariant: argv slice is non-empty (program name at least)
    assert(args.len >= 1);

    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(init);
    }
    if (args.len >= 3 and std.mem.eql(u8, args[1], "lower")) {
        return run_lower_path(garden, io, args[2]);
    }
    if (args.len >= 3 and std.mem.eql(u8, args[1], "redraw")) {
        return run_redraw_path(garden, io, args[2]);
    }
    if (args.len >= 3 and std.mem.eql(u8, args[1], "style")) {
        return run_style_path(garden, io, args[2]);
    }
    if (args.len >= 3 and std.mem.eql(u8, args[1], "grid")) {
        return run_grid_path(garden, io, args[2]);
    }
    if (args.len < 2) {
        try std.Io.File.stderr().writeStreamingAll(io, "usage: brush-parse <path.brush>|selftest|lower <path>|redraw <path>|style <path>|grid <path>\n");
        return 2;
    }
    const path = args[1];
    // invariant: path argument is non-empty
    assert(path.len > 0);

    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, path, garden, .limited(max_brush_bytes));
    // invariant: path read stays inside the named budget
    assert(src.len <= max_brush_bytes);
    const surface = try parse_brush(src);
    print("brush-parse: at-nib={s} present={s} max-lines={d} line-count={d}\n", .{
        surface.at_nib,
        surface.present,
        surface.max_lines,
        surface.line_count,
    });
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse\n");
    return 0;
}
