//! brushstroke/brush_parse.rye — .brush parser (Surface p23 begin · p24 TAME tidy).
//!
//! `.brush` describes how a value at a nib is drawn. This parser reads the thin
//! surface pins (at-nib · present · max-lines · lines) and refuses anything that
//! is not Frame-at-a-nib. It does not paint · does not open Wayland · does not
//! invent CSS/HTML/JSON · does not lower to Skate yet.
//!
//! TAME (hosted Rye): opening triad · u32 counts · named bounds · `// invariant:`
//! on every assert · short verb-named functions · named errors with try.
//!
//! Build and run:
//!   mkdir -p brushstroke/bin
//!   export RYE_ZIG="$PWD/vendor/zig-toolchain/zig"
//!   rye/bin/rye build brushstroke/brush_parse.rye -femit-bin=brushstroke/bin/brush-parse
//!   brushstroke/bin/brush-parse selftest
//!   brushstroke/bin/brush-parse brushstroke/seed-frame.brush

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;

pub const brush_parse_version = "20260728.212328";

/// Tally-bounded Frame ceiling — matches seed.rye · wayland_seed.rye · sur pedestal.
pub const max_frame_lines: u32 = 8;

/// Bound on a single .brush source file this parser will read.
pub const max_brush_bytes: u32 = 16 * 1024;

/// Bound on one pin value (nib name · present word) after trim.
pub const max_pin_bytes: u32 = 128;

pub const BrushSurface = struct {
    at_nib: []const u8,
    present: []const u8,
    max_lines: u32,
    line_count: u32,
};

pub const ParseError = error{
    MissingAtNib,
    MissingPresent,
    PresentNotFrame,
    MissingMaxLines,
    MaxLinesOutOfBound,
    MissingLines,
    EmptyLine,
    TooManyLines,
    BadMaxLines,
    SourceTooLarge,
};

/// Raw pins collected while scanning — unfinished until `finish_brush_surface`.
const BrushPins = struct {
    at_nib: ?[]const u8 = null,
    present: ?[]const u8 = null,
    max_lines: ?u32 = null,
    line_count: u32 = 0,
    saw_lines_header: bool = false,
};

/// Parse a .brush source buffer into a BrushSurface.
pub fn parse_brush(src: []const u8) ParseError!BrushSurface {
    // invariant: source fits the named read budget before any scan work
    assert(src.len <= max_brush_bytes);
    const pins = try scan_brush_pins(src);
    return try finish_brush_surface(pins);
}

/// Scan comment lines for the four surface pins. Placard prose is skipped.
fn scan_brush_pins(src: []const u8) ParseError!BrushPins {
    // invariant: caller already bound the buffer
    assert(src.len <= max_brush_bytes);

    var pins = BrushPins{};
    var in_lines = false;
    var it = std.mem.splitScalar(u8, src, '\n');
    while (it.next()) |raw| {
        const line = trim_right(raw);
        const line_len = slice_len_u32(line);
        if (line_len == 0) continue;
        if (!std.mem.startsWith(u8, line, "::")) continue;

        const body = trim_left(line[2..]);
        if (try take_pin(body, "at-nib:", &pins.at_nib)) {
            in_lines = false;
            continue;
        }
        if (try take_pin(body, "present:", &pins.present)) {
            in_lines = false;
            continue;
        }
        if (std.mem.startsWith(u8, body, "max-lines:")) {
            const text = trim_left(body["max-lines:".len..]);
            pins.max_lines = try parse_u32_decimal(text);
            in_lines = false;
            continue;
        }
        if (std.mem.startsWith(u8, body, "lines:")) {
            pins.saw_lines_header = true;
            in_lines = true;
            continue;
        }
        if (std.mem.startsWith(u8, body, "refuse:")) {
            in_lines = false;
            continue;
        }
        if (in_lines) {
            in_lines = try count_frame_line(line, body, &pins.line_count);
        }
    }
    // invariant: scan never invents a line count past the Frame ceiling
    assert(pins.line_count <= max_frame_lines);
    return pins;
}

/// Finish pins into a surface — every refuse path is a named ParseError.
fn finish_brush_surface(pins: BrushPins) ParseError!BrushSurface {
    const nib = pins.at_nib orelse return error.MissingAtNib;
    // invariant: at-nib pin is non-empty when present
    if (slice_len_u32(nib) == 0) return error.MissingAtNib;

    const pres = pins.present orelse return error.MissingPresent;
    if (!std.mem.eql(u8, pres, "Frame")) return error.PresentNotFrame;

    const ceiling = pins.max_lines orelse return error.MissingMaxLines;
    // invariant: max-lines is a living Frame ceiling, not zero and not past seed
    if (ceiling == 0 or ceiling > max_frame_lines) return error.MaxLinesOutOfBound;

    if (!pins.saw_lines_header) return error.MissingLines;
    if (pins.line_count == 0) return error.MissingLines;
    if (pins.line_count > ceiling) return error.TooManyLines;

    const surface = BrushSurface{
        .at_nib = nib,
        .present = pres,
        .max_lines = ceiling,
        .line_count = pins.line_count,
    };
    // invariant: present is Frame after finish
    assert(std.mem.eql(u8, surface.present, "Frame"));
    // invariant: nib survived non-empty
    assert(surface.at_nib.len > 0);
    // invariant: at least one drawn line
    assert(surface.line_count > 0);
    // invariant: line_count respects the file's own ceiling
    assert(surface.line_count <= surface.max_lines);
    // invariant: file ceiling respects the seed Frame bound
    assert(surface.max_lines <= max_frame_lines);
    return surface;
}

/// If `body` starts with `key`, store the trimmed value and return true.
fn take_pin(body: []const u8, key: []const u8, slot: *?[]const u8) ParseError!bool {
    // invariant: keys are the short pin names we author
    assert(key.len > 0);
    assert(key.len <= max_pin_bytes);
    if (!std.mem.startsWith(u8, body, key)) return false;
    const value = trim_left(body[key.len..]);
    // invariant: pin values stay inside the named byte budget
    if (slice_len_u32(value) > max_pin_bytes) return error.SourceTooLarge;
    slot.* = value;
    return true;
}

/// Count one indented Frame line under `lines:`. Returns whether still in-lines.
fn count_frame_line(line: []const u8, body: []const u8, line_count: *u32) ParseError!bool {
    // invariant: counter never enters past the Frame ceiling
    assert(line_count.* <= max_frame_lines);
    if (slice_len_u32(body) == 0) return error.EmptyLine;
    // Line bodies under `lines:` are indented (`::  text`) in the fixture.
    const line_len = slice_len_u32(line);
    if (line_len >= 4 and line[2] == ' ' and line[3] == ' ') {
        const text = trim_left(body);
        if (slice_len_u32(text) == 0) return error.EmptyLine;
        line_count.* += 1;
        if (line_count.* > max_frame_lines) return error.TooManyLines;
        return true;
    }
    return false;
}

fn trim_left(s: []const u8) []const u8 {
    var i: u32 = 0;
    const n = slice_len_u32(s);
    while (i < n and (s[i] == ' ' or s[i] == '\t')) : (i += 1) {}
    // invariant: cursor stays inside the slice
    assert(i <= n);
    return s[i..];
}

fn trim_right(s: []const u8) []const u8 {
    const n = slice_len_u32(s);
    if (n == 0) return s;
    var end: u32 = n;
    while (end > 0 and (s[end - 1] == ' ' or s[end - 1] == '\t' or s[end - 1] == '\r')) : (end -= 1) {}
    // invariant: trim never grows the slice
    assert(end <= n);
    return s[0..end];
}

/// Zig slice `.len` is usize at the inherited seam — authored arithmetic stays u32.
fn slice_len_u32(s: []const u8) u32 {
    // invariant: brush buffers never exceed the named source budget
    assert(s.len <= max_brush_bytes);
    return @intCast(s.len);
}

fn parse_u32_decimal(text: []const u8) ParseError!u32 {
    const n = slice_len_u32(text);
    if (n == 0) return error.BadMaxLines;
    var value: u32 = 0;
    var i: u32 = 0;
    while (i < n) : (i += 1) {
        const c = text[i];
        if (c < '0' or c > '9') return error.BadMaxLines;
        const digit: u32 = c - '0';
        // invariant: decimal growth refuses overflow before wrap
        if (value > (std.math.maxInt(u32) - digit) / 10) return error.BadMaxLines;
        value = value * 10 + digit;
    }
    return value;
}

fn run_selftest(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const io = init.io;
    const cwd = std.Io.Dir.cwd();

    const src = try cwd.readFileAlloc(io, "brushstroke/seed-frame.brush", garden, .limited(max_brush_bytes));
    // invariant: fixture read respects the same budget parse_brush asserts
    assert(src.len <= max_brush_bytes);
    const surface = try parse_brush(src);
    // invariant: seed fixture at-nib matches living seed name
    assert(std.mem.eql(u8, surface.at_nib, "brushstroke-seed"));
    // invariant: seed fixture presents Frame
    assert(std.mem.eql(u8, surface.present, "Frame"));
    // invariant: seed fixture ceiling is eight
    assert(surface.max_lines == 8);
    // invariant: seed Frame carries three example lines
    assert(surface.line_count == 3);

    const missing_nib =
        \\::  name       refuse missing nib
        \\::  present:    Frame
        \\::  max-lines:  8
        \\::  lines:
        \\::    one line
    ;
    if (parse_brush(missing_nib)) |_| {
        unreachable;
    } else |err| {
        // invariant: missing at-nib refuses by name
        assert(err == error.MissingAtNib);
    }

    const not_frame =
        \\::  at-nib:     x
        \\::  present:    Widget
        \\::  max-lines:  8
        \\::  lines:
        \\::    one line
    ;
    if (parse_brush(not_frame)) |_| {
        unreachable;
    } else |err| {
        // invariant: non-Frame present refuses by name
        assert(err == error.PresentNotFrame);
    }

    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse selftest — seed-frame · refuse missing-nib · refuse not-Frame · TAME tidy\n");
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const io = init.io;
    const args = try init.minimal.args.toSlice(garden);
    // invariant: argv slice is non-empty (program name at least)
    assert(args.len >= 1);

    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(init);
    }
    if (args.len < 2) {
        try std.Io.File.stderr().writeStreamingAll(io, "usage: brush-parse <path.brush>|selftest\n");
        return 2;
    }
    const path = args[1];
    // invariant: path argument is non-empty
    assert(path.len > 0);

    const cwd = std.Io.Dir.cwd();
    const src = try cwd.readFileAlloc(io, path, garden, .limited(max_brush_bytes));
    // invariant: path read stays inside the named budget
    assert(src.len <= max_brush_bytes);
    const surface = try parse_brush(src);
    print("brush-parse: at-nib={s} present={s} max-lines={d} line-count={d}\n", .{
        surface.at_nib,
        surface.present,
        surface.max_lines,
        surface.line_count,
    });
    try std.Io.File.stdout().writeStreamingAll(io, "GREEN: brush-parse\n");
    return 0;
}
