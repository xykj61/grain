//! brushstroke/edit_filmstrip_track.rye — HUNK58: a filmstrip window that follows the cursor — the step you stand on stays in view.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK58.
//! Design read: active-designing/date/20260813/20260813-215013_hunk-filmstrip-track-exploration.md
//! Teacher, thanked clean-room: the scrollable edit-history strip of a photo app (iCloud Photos / Google Photos) — the
//! strip shows a handful of thumbnails and scrolls to keep the step you stand on in view, pinning at both ends (concept
//! only, siloed).
//!
//! HUNK57 gave the filmstrip a bounded window (`filmstrip_window(first, count)`) so a history longer than the strip is
//! wide is paintable a slice at a time — yet it forced no decision about WHICH window to show, blanking the marker row
//! honestly when the current step is scrolled off-view. This rung decides: `FilmstripTrack` owns one `FilmstripJump`
//! (its cursor and thumbnail geometry) and one number, `win_bands`, and adds one pure function — `window_first` — that
//! centers the cursor and clamps to the edges. Because the cursor is always inside the window it computes, the tracking
//! window NEVER blanks the marker (the honest contrast to a fixed window); it pins at the original near step 0, climbs
//! by one across the middle, and pins at the live edge. A pure composition over proven seams: no new cursor move, no new
//! render primitive, no arithmetic beyond a clamped subtraction. The history is read, never moved, the source never
//! mutated. No network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/edit_filmstrip_track.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const edits = @import("photo_edits.rye");
const edit_cursor = @import("edit_cursor.rye");
const edit_preview = @import("edit_preview.rye");
const edit_filmstrip = @import("edit_filmstrip.rye");
const edit_filmstrip_jump = @import("edit_filmstrip_jump.rye");
const image_skate = @import("image_skate.rye");
const skate = @import("skate_grid.rye");

pub const edit_filmstrip_track_version = "20260813.215013";

pub const FilmstripTrackError = error{
    BadWindow,
    WindowTooWide,
    BadThumb,
};

/// A following-window surface over the edit-history filmstrip: it owns one `FilmstripJump` (HUNK55) — the cursor a keeper
/// builds and navigates, and the thumbnail geometry the strip tiles with — and one number, `win_bands`, the count of
/// thumbnails the window shows at once. It invents one pure function, `window_first`, that centers the cursor and clamps
/// to the edges, and overrides `paint` to draw that window through HUNK57's `filmstrip_window`. Every other surface —
/// building the history (`push`), navigating it (`seek`/`undo`/`redo`), the band geometry (`band_px`) — delegates
/// unchanged. The governing law: the window it computes always contains the cursor, so the current step is always in
/// view and the marker never blanks.
pub const FilmstripTrack = struct {
    jump: edit_filmstrip_jump.FilmstripJump,
    win_bands: u32,

    /// Open a tracking surface showing `win_bands` thumbnails of `tcols`×`trows` each. Validates the window count
    /// positive (refusing `BadWindow`, so a window always names at least one band) and no wider than the down-map ceiling
    /// (refusing `WindowTooWide`, so the window always paints where the whole strip may refuse), then delegates thumbnail
    /// validation to `FilmstripJump.open` (refusing `BadThumb` on a zero dimension). The cursor opens empty; the history
    /// is built by `push` before the window follows it.
    pub fn open(tcols: u32, trows: u32, win_bands: u32) FilmstripTrackError!FilmstripTrack {
        // A window shows at least one band, or it names nothing to follow.
        if (win_bands == 0) return error.BadWindow;
        // invariant: the owned jump opens valid, so band geometry and paint are well-formed (a valid tcols also keeps the
        // ceiling division below well-defined).
        const jump = try edit_filmstrip_jump.FilmstripJump.open(tcols, trows);
        // invariant: a grid of no columns or no rows would divide a touch position by zero
        // rather than place it on the surface
        assert(jump.tcols >= 1);
        assert(jump.trows >= 1);
        // A window wider than the map ceiling could never paint — refuse at construction rather than at every paint.
        if (win_bands > edit_filmstrip.max_film_cols / jump.tcols) return error.WindowTooWide;
        // invariant: the window is a real, paintable width.
        assert(win_bands >= 1);
        assert(win_bands * jump.tcols <= edit_filmstrip.max_film_cols);
        return FilmstripTrack{ .jump = jump, .win_bands = win_bands };
    }

    /// Record a fresh edit at the live position, delegating to the owned jump's `push` (HUNK16 forgetting any redo tail,
    /// refusing `TooManyEdits` at the list ceiling). The history grows before the window follows it.
    pub fn push(self: *FilmstripTrack, e: edits.Edit) edits.EditsError!void {
        // invariant: the cursor stands within its history before the push.
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
        try self.jump.push(e);
        // invariant: a fresh edit is the live edge.
        assert(self.jump.cursor.position == self.jump.cursor.list.count);
    }

    /// How many steps the filmstrip holds — the untouched source plus one thumbnail per recorded edit. Always at least
    /// one (the source).
    pub fn steps(self: *const FilmstripTrack) u32 {
        return self.jump.steps();
    }

    /// The pixel width of one thumbnail band — positive by construction. Delegated from the owned jump.
    pub fn band_px(self: *const FilmstripTrack) u32 {
        return self.jump.band_px();
    }

    /// How many bands the window actually shows: the window count, or the whole history when it is shorter. Always at
    /// least one, so a window always paints.
    pub fn visible_bands(self: *const FilmstripTrack) u32 {
        const s = self.steps();
        const vis: u32 = if (self.win_bands > s) s else self.win_bands;
        // invariant: at least the source band shows, and never more than the window or the history allows.
        assert(vis >= 1);
        assert(vis <= self.win_bands);
        assert(vis <= s);
        return vis;
    }

    /// The absolute step the window begins on — the following rule, and the one arithmetic this rung invents. When the
    /// whole history fits the window (`steps <= win_bands`), the window is the whole strip (`first = 0`). Otherwise the
    /// cursor is centered and clamped to the edges: `first = clamp(position - win_bands/2, 0, steps - win_bands)`. The
    /// clamp proves the promise — the cursor always lands inside `[first, first + win_bands)` — so the current step is
    /// always in view and the marker never blanks. Pure: it reads the cursor and moves nothing.
    pub fn window_first(self: *const FilmstripTrack) u32 {
        const s = self.steps();
        // invariant: the cursor stands within its history.
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
        // The whole history fits: the window is the whole strip, anchored at the origin.
        if (s <= self.win_bands) return 0;

        const pos = self.jump.cursor.position;
        const half = self.win_bands / 2;
        const max_first = s - self.win_bands; // the furthest the window can scroll and still fill
        // invariant: a scrollable history leaves real room to scroll.
        assert(max_first >= 1);

        // Center the cursor without underflow, then clamp to the last full window.
        const ideal: u32 = if (pos <= half) 0 else pos - half;
        const first: u32 = if (ideal > max_first) max_first else ideal;

        // invariant: the window is a full window (the history is longer than it), and the cursor lands inside it — this
        // is why the tracking window never blanks the marker.
        assert(first + self.win_bands <= s);
        assert(pos >= first);
        assert(pos < first + self.win_bands);
        return first;
    }

    /// Move the cursor to `target` through HUNK16's `seek` — a walk that forgets nothing — so the window re-follows on the
    /// next paint. Returns the step the cursor landed on (clamped to the live edge).
    pub fn seek(self: *FilmstripTrack, target: u32) u32 {
        self.jump.cursor.seek(target);
        // invariant: the cursor stands on the sought step (or the clamped live edge).
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
        return self.jump.cursor.position;
    }

    /// Step one edit back, the window following. Delegated to HUNK16's `undo` (a no-op at the original).
    pub fn undo(self: *FilmstripTrack) void {
        self.jump.cursor.undo();
        // invariant: the cursor never falls below the original.
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
    }

    /// Step one edit forward, the window following. Delegated to HUNK16's `redo` (a no-op at the live edge).
    pub fn redo(self: *FilmstripTrack) void {
        self.jump.cursor.redo();
        // invariant: the cursor never runs past the live edge.
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
    }

    /// Paint the following window: `win_bands` thumbnails from `window_first()`, the marker on the current step —
    /// HUNK57's `filmstrip_window` with the first the tracking rule chose. Because the window always contains the cursor,
    /// the marker always shows. Pure — the history is read, the source never mutated.
    pub fn paint(self: *const FilmstripTrack, allocator: std.mem.Allocator, source: *const qoi.Pixmap) !skate.Grid {
        // invariant: the cursor stands within its history before the replay.
        assert(self.jump.cursor.position <= self.jump.cursor.list.count);
        return edit_filmstrip.filmstrip_window(
            allocator,
            source,
            &self.jump.cursor,
            self.jump.tcols,
            self.jump.trows,
            self.window_first(),
            self.win_bands,
        );
    }
};

// --- selftest: a full 64-edit history the whole strip cannot paint — the tracking window paints GREEN at EVERY step,
//     the marker always in view, no drift, following monotonically and pinning at both ends; a short history equals the
//     whole filmstrip; a bad window, a too-wide window, and a bad thumbnail each refuse by name -----------------------

fn craft_two_tone(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 8;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const left = x < w / 2;
            buf[off] = if (left) 255 else 0; // r
            buf[off + 1] = 0; // g
            buf[off + 2] = if (left) 0 else 255; // b
            buf[off + 3] = 255; // a
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// A direct thumbnail of the first k edits — the ground truth a window band must equal.
fn direct_thumb(garden: std.mem.Allocator, source: *const qoi.Pixmap, cursor: *const edit_cursor.EditCursor, k: u32, tcols: u32, trows: u32) !skate.Grid {
    var prefix = edits.EditList.init();
    var i: u32 = 0;
    while (i < k) : (i += 1) try prefix.push(cursor.list.at(i));
    return edit_preview.preview(garden, source, &prefix, tcols, trows);
}

/// The window-relative band the marker block sits on, or null when no band is marked. Reads row 0's first cell of each
/// band; a tracking window should always find exactly one.
fn marked_band(film: *const skate.Grid, tcols: u32) ?u32 {
    const bands = film.cols / tcols;
    var band: u32 = 0;
    while (band < bands) : (band += 1) {
        const cell_i: usize = @intCast(band * tcols);
        if (film.cells[cell_i] == image_skate.block_cell and film.fg_index[cell_i] == edit_filmstrip.marker_slot) {
            return band;
        }
    }
    return null;
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_two_tone(garden);

    const tcols: u32 = 4;
    const trows: u32 = 2;
    const win_bands: u32 = 5;

    // A full 64-edit history — 65 steps — far longer than a five-band window, and wide enough that the WHOLE strip
    // refuses FilmstripTooWide (65·4 > 256). This is the history the tracking window exists for.
    var track = try FilmstripTrack.open(tcols, trows, win_bands);
    {
        var e: u32 = 0;
        while (e < edits.max_edits) : (e += 1) try track.push(.flip_h);
    }
    assert(track.jump.cursor.list.count == edits.max_edits);
    const total_steps: u32 = edits.max_edits + 1; // 65
    assert(track.steps() == total_steps);

    // The whole filmstrip cannot paint this history — it refuses by name. The window is the only way to read it.
    if (edit_filmstrip.filmstrip(garden, &pm, &track.jump.cursor, tcols, trows)) |_| {
        return error.WideSlipped;
    } else |e| {
        if (e != error.FilmstripTooWide) return error.WrongWide;
    }

    // The crux: walk EVERY step 0..64. At each the tracking window paints GREEN — a full five-band window, the marker
    // always in view (never blank), the marked band equal to a direct preview of its absolute step cell-for-cell (no
    // drift), and the window rasterizing to a lit canvas. The window follows monotonically and pins at both ends.
    var prev_first: u32 = 0;
    var saw_left_pin: bool = false;
    var saw_right_pin: bool = false;
    const max_first: u32 = total_steps - win_bands; // 60
    {
        var step: u32 = 0;
        while (step < total_steps) : (step += 1) {
            _ = track.seek(step);
            assert(track.jump.cursor.position == step);

            const first = track.window_first();
            // Following, monotone: the window never scrolls backward as the cursor climbs.
            assert(first >= prev_first);
            prev_first = first;
            if (first == 0) saw_left_pin = true;
            if (first == max_first) saw_right_pin = true;

            const win = try track.paint(garden, &pm);
            // A full window throughout: this history is longer than the window, so every window shows win_bands bands.
            assert(win.cols == win_bands * tcols);
            assert(win.rows == trows + 1);

            // The marker is ALWAYS in view — the honest contrast to HUNK57's fixed window, which blanks off-view. It sits
            // on exactly the window-relative band of the current step.
            const mb = marked_band(&win, tcols);
            assert(mb != null);
            assert(mb.? == step - first);

            // No drift: the marked band equals a direct preview of its absolute step, cell-for-cell.
            {
                const truth = try direct_thumb(garden, &pm, &track.jump.cursor, step, tcols, trows);
                const j = mb.?;
                var tr: u32 = 0;
                while (tr < trows) : (tr += 1) {
                    var tc: u32 = 0;
                    while (tc < tcols) : (tc += 1) {
                        const src: usize = @intCast(tr * tcols + tc);
                        const dst: usize = @intCast((tr + 1) * win.cols + (j * tcols + tc));
                        assert(win.cells[dst] == truth.cells[src]);
                        assert(win.fg_index[dst] == truth.fg_index[src]);
                    }
                }
            }

            // Genuinely seen: the window rasterizes to a lit canvas — every step of a too-long history reaches the glass.
            {
                const scale: u32 = 1;
                const wpx: u32 = win.cols * skate.cell_w * scale;
                const hpx: u32 = win.rows * skate.cell_h * scale;
                const stride: u32 = wpx * 4;
                const canvas = try garden.alloc(u8, @as(usize, stride) * @as(usize, hpx));
                const bg = skate.Color{ .r = 1, .g = 2, .b = 3 };
                const fg = skate.Color{ .r = 200, .g = 200, .b = 200 };
                win.rasterize(canvas, stride, @intCast(wpx), @intCast(hpx), bg, fg, scale);
                const lit = win.lit_pixel_count(canvas, stride, @intCast(wpx), @intCast(hpx), bg);
                assert(lit > 0);
            }
        }
    }
    // The window pinned at both ends over the walk — it rested on the original early and the live edge late.
    assert(saw_left_pin);
    assert(saw_right_pin);

    // Short-history parity: a history that fits the window is shown whole — the tracking window equals HUNK54's whole
    // filmstrip cell-for-cell, at first == 0.
    {
        var short = try FilmstripTrack.open(tcols, trows, win_bands);
        try short.push(.flip_h);
        try short.push(.flip_v);
        assert(short.steps() == 3); // 3 <= win_bands, the whole history fits
        _ = short.seek(1);
        assert(short.window_first() == 0);
        assert(short.visible_bands() == 3);
        const win = try short.paint(garden, &pm);
        const whole = try edit_filmstrip.filmstrip(garden, &pm, &short.jump.cursor, tcols, trows);
        assert(win.cols == whole.cols);
        assert(win.rows == whole.rows);
        var c: u32 = 0;
        while (c < whole.cells.len) : (c += 1) {
            assert(win.cells[c] == whole.cells[c]);
            assert(win.fg_index[c] == whole.fg_index[c]);
        }
    }

    // undo/redo drive the window too: from the live edge of the long history, undo scrolls the window left, redo right.
    {
        _ = track.seek(edits.max_edits); // live edge
        const at_edge = track.window_first();
        assert(at_edge == max_first); // pinned right
        track.undo();
        assert(track.jump.cursor.position == edits.max_edits - 1);
        track.redo();
        assert(track.jump.cursor.position == edits.max_edits);
        assert(track.window_first() == max_first);
    }

    // Refusals by name. A zero-band window names nothing to follow.
    if (FilmstripTrack.open(tcols, trows, 0)) |_| return error.WindowSlipped else |e| {
        if (e != error.BadWindow) return error.WrongWindow;
    }
    // A window wider than the map ceiling could never paint — refused at construction.
    if (FilmstripTrack.open(tcols, trows, edit_filmstrip.max_film_cols / tcols + 1)) |_| return error.WideSlipped else |e| {
        if (e != error.WindowTooWide) return error.WrongWide;
    }
    // A zero-dimension thumbnail refuses at open, delegated from FilmstripJump.
    if (FilmstripTrack.open(0, trows, win_bands)) |_| return error.ThumbSlipped else |e| {
        if (e != error.BadThumb) return error.WrongThumb;
    }
    if (FilmstripTrack.open(tcols, 0, win_bands)) |_| return error.ThumbSlipped else |e| {
        if (e != error.BadThumb) return error.WrongThumb;
    }

    print("GREEN edit-filmstrip-track: a full 64-edit history (65 steps) the whole strip refuses FilmstripTooWide — a " ++
        "five-band tracking window paints GREEN at EVERY step 0..64, the marker always in view (never blank, the honest " ++
        "contrast to a fixed window) on exactly the window-relative band of the current step, the marked band equal to a " ++
        "direct preview of its absolute step cell-for-cell (no drift), each window rasterizing to a lit canvas; the " ++
        "window follows monotonically (never scrolls backward) and pins at both the original and the live edge; a short " ++
        "history that fits equals the whole filmstrip cell-for-cell at first 0; undo/redo drive the window too; a zero " ++
        "window refuses BadWindow, a too-wide window WindowTooWide, a zero-dimension thumbnail BadThumb. HUNK57 window, " ++
        "HUNK55 jump, HUNK16 cursor+seek GREEN beneath; no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: edit_filmstrip_track selftest\n", .{});
    return 1;
}
