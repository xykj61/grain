//! brushstroke/part_tap.rye — HUNK80: tap a searched part to open its detail — the marketplace loop closes.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · parts-marketplace journey · rung HUNK80.
//! Design read: active-designing/20260814-001609_hunk-part-tap-open-a-searched-part-exploration.md
//! Teacher, thanked clean-room: tapping a McMaster-Carr search result to open the part's own page (concept only, siloed).
//!
//! HUNK71–79 built the marketplace whole on the reading side — a content-addressed catalog, a painted row, a paged
//! shelf, and a faceted search box that draws exactly the parts a keeper types. Yet a keeper could read the shelf and
//! not reach into it. The Photos journey met this seam at HUNK70 and closed it with `library_tap`; this rung carries the
//! same gesture to the marketplace. `part_tap` reads the shelf's row geometry BACKWARD: a tap resolves to the part the
//! keeper sees, and — this is the crux — across the search narrowing. The shelf HUNK79 drew is the NARROWED catalog, so
//! the row a finger touches sits at one place on glass and its part at another place in the original catalog. Reading
//! row `k` as catalog part `k` is a lie the moment a search hides a part above the tap. `open_tapped_and` resolves the
//! tap over the narrowed page, then maps the tapped part back to its home in the ORIGINAL catalog by its stable name —
//! so the second stainless row opens the catalog's fourth part when that is the second stainless one, never its literal
//! second part. A tap past the last result resolves to nothing; a malformed clause surfaces the parser's named refusal.
//!
//! The returned `PartRef` borrows the caller's long-lived catalog, never the local sub-catalog whose sheet is shared but
//! whose storage is a stack frame — so a detail page reads a live handle. No network, no key, no funds; a price is a
//! fact COMPARED, never moved (custody gate #3 untouched).
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/part_tap.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const sprite = @import("sprite.rye");
const part_catalog = @import("part_catalog.rye");
const part_and = @import("part_and.rye");
const part_row = @import("part_row.rye");
const skate = @import("skate_grid.rye");

pub const part_tap_version = "20260814.001609";

/// A tapped part's detail handle: its index in the ORIGINAL catalog (a stable pointer back into the source), its name,
/// and its honest facts. Every slice borrows the caller's own catalog, so the handle outlives the resolution — a detail
/// page reads it after the local sub-catalog a search built has fallen out of scope.
pub const PartRef = struct {
    index: u32,
    name: []const u8,
    facts: part_catalog.PartFacts,
};

/// Map a pixel tap to a shelf cell row through Skate's fixed cell height — the same pitch `part_row` paints each row at,
/// so a real finger lands on the row it sees.
pub fn tap_cell_row(px_y: u32) u32 {
    // invariant: a Skate cell is a real height, so the division never divides by zero.
    assert(skate.cell_h >= 1);
    const row = px_y / skate.cell_h;
    // invariant: the resolved row is the floor of the tap — it never sits below the pixel that produced it.
    assert(row * skate.cell_h <= px_y);
    return row;
}

/// Resolve a shelf cell row to the within-page part index under it, reading HUNK73's one-row-per-part geometry backward.
/// A tap on an empty tail row (past the last part drawn on this page) resolves to nothing (`null`). `page_len` is the
/// number of parts the page actually drew (`part_window_len`), never more than the page is tall.
pub fn tap_row(rows: u32, page_len: u32, cell_row: u32) ?u32 {
    // invariant: a page is at least one row tall.
    assert(rows >= 1);
    // invariant: a page never draws more parts than it has rows to hold them.
    assert(page_len <= rows);
    if (cell_row >= page_len) return null; // the tap fell on an empty tail row
    // invariant: a resolved index names a part the page really drew.
    assert(cell_row < page_len);
    return cell_row;
}

/// The index a product name holds in `cat`, or nothing when the catalog holds no such name — the map from a narrowed
/// part back to its home in the source catalog. Names in one catalog are unique (the sprite index refuses a duplicate),
/// so the first match is the only match.
pub fn find_in_catalog(cat: *const part_catalog.PartCatalog, name: []const u8) ?u32 {
    // invariant: the catalog never outgrew its own sheet's product ceiling.
    assert(cat.len() <= sprite.max_products);
    var i: u32 = 0;
    while (i < cat.len()) : (i += 1) {
        if (std.mem.eql(u8, cat.index.entry(i).name, name)) {
            // invariant: a found index sits inside the catalog.
            assert(i < cat.len());
            return i;
        }
    }
    return null;
}

/// Resolve a tap on a plain catalog page to the part under it — the part at `offset + within`, with its stable name and
/// honest facts read from `cat`. Nothing on a miss (an empty tail row, or an offset past the catalog, which draws no
/// part). The returned handle borrows `cat`, so it outlives this call.
pub fn tap_part(cat: *const part_catalog.PartCatalog, rows: u32, offset: u32, cell_row: u32) ?PartRef {
    // invariant: a page is at least one row tall.
    assert(rows >= 1);
    const page_len = part_row.part_window_len(cat, rows, offset);
    const within = tap_row(rows, page_len, cell_row) orelse return null;
    const idx = offset + within;
    // invariant: the resolved part sits inside the catalog the page windowed.
    assert(idx < cat.len());
    return PartRef{ .index = idx, .name = cat.index.entry(idx).name, .facts = cat.facts_at(idx) };
}

/// Resolve a tap on a NARROWED search page and open the part it lands on — the crux. Parse the multi-clause line, narrow
/// `cat` with `filter_and`, resolve the tap over the narrowed page, then map the tapped part back to its home in the
/// ORIGINAL catalog by its stable name. So what a keeper taps is the part they see, across the narrowing: the second row
/// of a stainless-only shelf opens the catalog's fourth part when that is the second stainless one. A malformed clause
/// surfaces the parser's named refusal (never a wrong part); a tap past the last result resolves to nothing. The
/// returned `PartRef` reads the caller's long-lived `cat`, never the local sub-catalog whose storage is this frame.
pub fn open_tapped_and(
    cat: *const part_catalog.PartCatalog,
    text: []const u8,
    rows: u32,
    offset: u32,
    cell_row: u32,
) !?PartRef {
    // invariant: the catalog never outgrew its own sheet's product ceiling before it is searched.
    assert(cat.len() <= sprite.max_products);
    const aq = try part_and.parse_and(text);
    var sub: part_catalog.PartCatalog = undefined;
    try part_and.filter_and(cat, aq, &sub);
    // invariant: the narrowed sub-catalog windows into the caller's own sheet, never a copy.
    assert(sub.index.sheet == cat.index.sheet);

    const page_len = part_row.part_window_len(&sub, rows, offset);
    const within = tap_row(rows, page_len, cell_row) orelse return null;
    const narrowed_idx = offset + within;
    // invariant: the resolved narrowed part sits inside the sub-catalog the page windowed.
    assert(narrowed_idx < sub.len());

    const name = sub.index.entry(narrowed_idx).name;
    // The narrowed part was re-added from `cat`, so its name is present in the original catalog by construction.
    const home = find_in_catalog(cat, name) orelse unreachable;
    // invariant: the tapped part maps back into the original catalog, its detail read from the caller's live storage.
    assert(home < cat.len());
    return PartRef{ .index = home, .name = cat.index.entry(home).name, .facts = cat.facts_at(home) };
}

// --- selftest: five parts across three materials and a price spread — a plain-page tap lands on each row's part, a
//     pixel tap maps through Skate's cell height, a tap on an empty tail row resolves to nothing, and the crux: a
//     faceted-search tap resolves the part the keeper SEES back to its home in the original catalog, ACROSS the
//     narrowing — the second stainless row opens the catalog's fourth part. A malformed clause refuses by name. --------

/// A 16×8 sheet in four solid vertical bands (the part_row/part_and_search fixture), so a 4-wide window is legible.
fn craft_bands(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 16;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const band = x / 4; // 0..3
            buf[off] = if (band == 0 or band == 3) 255 else 0; // r
            buf[off + 1] = if (band == 1 or band == 3) 255 else 0; // g
            buf[off + 2] = if (band == 2) 255 else 0; // b
            buf[off + 3] = 255;
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const sheet = try craft_bands(garden);
    var cat = part_catalog.PartCatalog.init(&sheet);
    // Five... four parts across the bands, three materials, a price spread. Two are stainless-304, and — key to the
    // crux — they sit at catalog index 0 (bolt) and index 3 (hexnut), a gap the narrowing must resolve across.
    try cat.add_part("bolt", 0, 0, 4, 8, "HX-M8-40", "stainless-304", 125);
    try cat.add_part("nut", 4, 0, 4, 8, "NY-M8", "brass", 60);
    try cat.add_part("gear", 8, 0, 4, 8, "GR-24T", "acetal", 845);
    try cat.add_part("hexnut", 12, 0, 4, 8, "HX-N8", "stainless-304", 55);
    assert(cat.len() == 4);

    const rows: u32 = 8; // taller than the catalog, so the tail rows are empty and a miss is real

    // A plain-page tap lands on each row's part, name-for-name — one part per row, HUNK73's geometry read backward.
    {
        const names = [_][]const u8{ "bolt", "nut", "gear", "hexnut" };
        var i: u32 = 0;
        while (i < 4) : (i += 1) {
            const ref = tap_part(&cat, rows, 0, i) orelse unreachable;
            assert(ref.index == i);
            assert(std.mem.eql(u8, ref.name, names[i]));
        }
    }

    // A pixel tap maps through Skate's cell height to the same row — a finger on row 2 opens part 2.
    {
        const px_y = 2 * skate.cell_h + 3;
        const cell = tap_cell_row(px_y);
        assert(cell == 2);
        const ref = tap_part(&cat, rows, 0, cell) orelse unreachable;
        assert(std.mem.eql(u8, ref.name, "gear"));
    }

    // A tap on an empty tail row (past the four parts) resolves to nothing.
    assert(tap_part(&cat, rows, 0, 4) == null);
    // A tap on an offset page past the catalog draws no part, so it opens nothing.
    assert(tap_part(&cat, rows, 4, 0) == null);

    // THE CRUX — a search narrows to the two stainless parts (bolt at 0, hexnut at 3). On the narrowed page they sit at
    // rows 0 and 1. Tapping row 1 must open hexnut — the ORIGINAL catalog's index 3 — not the catalog's literal second
    // part (nut). The tap resolves the part the keeper SEES back to its home, across the narrowing.
    {
        assert((try open_tapped_and(&cat, "material:stainless-304", rows, 0, 0)).?.index == 0); // row 0 -> bolt (orig 0)
        const r1 = (try open_tapped_and(&cat, "material:stainless-304", rows, 0, 1)) orelse unreachable;
        assert(r1.index == 3); // row 1 on the narrowed page -> hexnut, the catalog's FOURTH part
        assert(std.mem.eql(u8, r1.name, "hexnut"));
        assert(std.mem.eql(u8, r1.facts.material, "stainless-304"));
        assert(r1.facts.price_cents == 55);
    }

    // A faceted line: stainless AND under a dollar keeps only hexnut. Row 0 opens hexnut; row 1 is an empty tail — a tap
    // there opens nothing rather than a wrong part.
    {
        const only = (try open_tapped_and(&cat, "material:stainless-304 max:100", rows, 0, 0)) orelse unreachable;
        assert(std.mem.eql(u8, only.name, "hexnut"));
        assert((try open_tapped_and(&cat, "material:stainless-304 max:100", rows, 0, 1)) == null);
    }

    // A malformed search line surfaces the parser's own named refusal rather than opening a wrong part — nine clauses
    // past the eight-clause ceiling refuse `TooManyClauses`.
    {
        const many = "a:1 a:1 a:1 a:1 a:1 a:1 a:1 a:1 a:1";
        const attempt = open_tapped_and(&cat, many, rows, 0, 0);
        assert(std.meta.isError(attempt));
        _ = attempt catch {};
    }

    print("GREEN part-tap: a plain-page tap lands on each of four rows' parts name-for-name; a pixel tap maps through " ++
        "Skate's cell height to the same row; a tap on an empty tail row or a page past the catalog opens nothing; and " ++
        "the crux — a stainless-only search's second row opens the catalog's FOURTH part (hexnut), resolving the part " ++
        "the keeper sees back to its home across the narrowing; a faceted match-one shelf opens the one part and its " ++
        "empty tail opens nothing; a malformed clause refuses TooManyClauses. No network, no key, no funds.\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: part_tap selftest\n", .{});
    return 1;
}
