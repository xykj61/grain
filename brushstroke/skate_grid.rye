//! brushstroke/skate_grid.rye — Skate: monospace cell grid → ARGB8888 buffer.
//!
//! font8x8_basic is public domain (dhepper/font8x8). Grid mutations copy
//! through Tally's `copy_disjoint`, both preconditions asserted; allocation
//! uses strengthened `std.mem.Allocator.alloc`.
//!
//! Build and prove (from repo root):
//!   rye/bin/rye build brushstroke/skate_grid.rye -femit-bin=brushstroke/bin/skate-grid
//!   brushstroke/bin/skate-grid

const std = @import("std");
const assert = std.debug.assert;
const font8x8 = @import("font8x8_data.rye");

/// Optional glyphs for cell values 128..255 (ZETA4 emoji atlas). Slot i = cell 128+i.
pub var extended_glyphs: ?*const [128][8]u8 = null;
const tally_copy = @import("tally_copy.rye");

fn buf_len_u32(buf: []const u8) u32 {
    assert(buf.len <= std.math.maxInt(u32));
    return @intCast(buf.len);
}

pub const cell_w: u32 = 8;
pub const cell_h: u32 = 16;

/// Bound on the styled-run palette a grid may carry. Slot 0 is the sentinel
/// "use the fg passed to rasterize"; slots 1..max_palette-1 hold real colors.
/// Named small on purpose — a token sheet paints a handful of runs, not a rainbow.
pub const max_palette: u32 = 8;

/// The palette slot that means "wear the fg argument rasterize is given." A cell
/// whose fg_index is this value renders byte-identically to the pre-palette grid.
pub const fg_default_index: u8 = 0;

pub const Color = struct {
    r: u8,
    g: u8,
    b: u8,
};

pub const Grid = struct {
    cols: u32,
    rows: u32,
    cells: []u8,
    /// Per-cell foreground palette index, one byte per cell, parallel to `cells`.
    /// Slot 0 (the default for every cell) means "use rasterize's fg argument."
    fg_index: []u8,
    /// The bounded run palette. Entry 0 is a sentinel never read as a color;
    /// entries 1..max_palette-1 are the colors `put_color_run` selects.
    palette: [max_palette]Color,

    pub fn init(allocator: std.mem.Allocator, cols: u32, rows: u32) !Grid {
        assert(cols > 0);
        assert(rows > 0);
        const cell_count: usize = @intCast(cols * rows);
        const cells = try allocator.alloc(u8, cell_count);
        assert(cells.len == cell_count);
        @memset(cells, ' ');
        const fg_index = try allocator.alloc(u8, cell_count);
        // invariant: one fg index per cell, exactly parallel to `cells`.
        assert(fg_index.len == cells.len);
        @memset(fg_index, fg_default_index);
        // invariant: every cell starts on the sentinel — no run painted yet.
        assert(fg_index[0] == fg_default_index);
        return .{
            .cols = cols,
            .rows = rows,
            .cells = cells,
            .fg_index = fg_index,
            .palette = [_]Color{.{ .r = 0, .g = 0, .b = 0 }} ** max_palette,
        };
    }

    /// Set one palette slot to a color. Slot 0 is the reserved sentinel and is
    /// refused — a run painted with index 0 would be indistinguishable from the
    /// default, so a caller must pick a real slot to change a cell's color.
    pub fn set_palette(self: *Grid, index: u8, color: Color) void {
        // invariant: slot 0 stays the "use fg argument" sentinel, never a color.
        assert(index != fg_default_index);
        // invariant: the slot sits inside the bounded palette.
        assert(index < max_palette);
        self.palette[index] = color;
    }

    /// Mark cells `[col_start, col_end)` in `row` to wear palette slot
    /// `palette_index`. A no-op when the row is out of range, mirroring
    /// `put_line`'s own tolerance. `col_end` clamps to the grid width, so a run
    /// past the edge paints only the cells that exist.
    pub fn put_color_run(self: *Grid, row: u32, col_start: u32, col_end: u32, palette_index: u8) void {
        // invariant: a real run wears a real palette slot, never the sentinel.
        assert(palette_index != fg_default_index);
        // invariant: the slot sits inside the bounded palette.
        assert(palette_index < max_palette);
        if (row >= self.rows) return;
        if (col_start >= col_end) return;
        const end: u32 = @min(col_end, self.cols);
        if (col_start >= end) return;
        const base: usize = @intCast(row * self.cols);
        // invariant: the run's last cell sits inside the fg-index buffer.
        assert(base + @as(usize, @intCast(end)) <= self.fg_index.len);
        var col: u32 = col_start;
        // Bounded by `end`, itself bounded by `self.cols` — a named grid width.
        while (col < end) : (col += 1) {
            self.fg_index[base + @as(usize, @intCast(col))] = palette_index;
        }
    }

    pub fn put_line(self: *Grid, row: u32, text: []const u8) void {
        if (row >= self.rows) return;
        const base: usize = @intCast(row * self.cols);
        assert(base < self.cells.len);
        const n: u32 = @min(buf_len_u32(text), self.cols);
        const n_usize: usize = @intCast(n);
        tally_copy.copy_disjoint(u8, self.cells[base..][0..n_usize], text[0..n_usize]);
    }

    /// The row's cells, read back whole — the reading sibling of `put_line`.
    /// Named `row_cells` rather than `grid_row`: `rasterize` already binds a
    /// local `grid_row`, and a shadowed name is a name not yet free.
    /// Grid witnesses otherwise index `cells` by hand, which is exactly the
    /// seam an off-by-one lands in.
    pub fn row_cells(self: *const Grid, row: u32) []const u8 {
        assert(row < self.rows); // precondition: caller checked the bound
        const base: usize = @intCast(row * self.cols);
        const span: usize = @intCast(self.cols);
        assert(base + span <= self.cells.len); // invariant: row sits inside cells
        return self.cells[base .. base + span];
    }

    pub fn lit_pixel_count(_: Grid, pixels: []const u8, stride: u32, width: i32, height: i32, bg: Color) u32 {
        assert(width > 0);
        assert(height > 0);
        const width_u: u32 = @intCast(width);
        const height_u: u32 = @intCast(height);
        assert(stride >= width_u * 4);
        const stride_usize: usize = @intCast(stride);
        var count: u32 = 0;
        var y: u32 = 0;
        while (y < height_u) : (y += 1) {
            const y_usize: usize = @intCast(y);
            const row = pixels[y_usize * stride_usize ..][0 .. @as(usize, @intCast(width_u)) * 4];
            var x: u32 = 0;
            while (x < width_u) : (x += 1) {
                const px: usize = @intCast(x * 4);
                if (row[px + 0] != bg.b or row[px + 1] != bg.g or row[px + 2] != bg.r) {
                    count += 1;
                }
            }
        }
        return count;
    }

    pub fn rasterize(
        self: Grid,
        pixels: []u8,
        stride: u32,
        width: i32,
        height: i32,
        bg: Color,
        fg: Color,
        scale: u32,
    ) void {
        assert(scale > 0);
        const cell_pw = cell_w * scale;
        const cell_ph = cell_h * scale;
        assert(width > 0);
        assert(height > 0);
        const width_u: u32 = @intCast(width);
        const height_u: u32 = @intCast(height);
        assert(stride >= width_u * 4);
        assert(self.cells.len == @as(usize, @intCast(self.cols * self.rows)));
        // invariant: the fg-index buffer stays exactly parallel to the cells.
        assert(self.fg_index.len == self.cells.len);

        const stride_usize: usize = @intCast(stride);
        var y: u32 = 0;
        while (y < height_u) : (y += 1) {
            const y_usize: usize = @intCast(y);
            const row = pixels[y_usize * stride_usize ..][0 .. @as(usize, @intCast(width_u)) * 4];
            var x: u32 = 0;
            while (x < width_u) : (x += 1) {
                const px: usize = @intCast(x * 4);
                row[px + 0] = bg.b;
                row[px + 1] = bg.g;
                row[px + 2] = bg.r;
                row[px + 3] = 0xff;
            }
        }

        var grid_row: u32 = 0;
        while (grid_row < self.rows) : (grid_row += 1) {
            var col: u32 = 0;
            while (col < self.cols) : (col += 1) {
                const cell_i: usize = @intCast(grid_row * self.cols + col);
                const ch = self.cells[cell_i];
                // Slot 0 (the default) wears the fg argument exactly — so a grid
                // with no runs painted rasterizes byte-identically to before the
                // palette existed. Only a non-zero index picks a palette color.
                const idx = self.fg_index[cell_i];
                const cell_fg = if (idx == fg_default_index) fg else self.palette[idx];
                draw_glyph(
                    pixels,
                    stride,
                    width,
                    height,
                    @intCast(col * cell_pw),
                    @intCast(grid_row * cell_ph),
                    ch,
                    cell_fg,
                    scale,
                );
            }
        }
    }
};

fn draw_glyph(
    pixels: []u8,
    stride: u32,
    width: i32,
    height: i32,
    x0: i32,
    y0: i32,
    ch: u8,
    fg: Color,
    scale: u32,
) void {
    assert(scale > 0);
    assert(width > 0);
    assert(height > 0);
    const width_u: u32 = @intCast(width);
    assert(stride >= width_u * 4);

    const glyph = if (ch < 128)
        font8x8.font8x8_basic[ch]
    else if (extended_glyphs) |ext|
        ext[ch - 128]
    else
        [_]u8{0} ** 8;
    const stride_usize: usize = @intCast(stride);
    var gy: u32 = 0;
    while (gy < 8) : (gy += 1) {
        const bits = glyph[gy];
        var gx: u32 = 0;
        while (gx < 8) : (gx += 1) {
            if ((bits & (@as(u8, 1) << @intCast(gx))) == 0) continue;
            var sy: u32 = 0;
            while (sy < scale) : (sy += 1) {
                var sx: u32 = 0;
                while (sx < scale) : (sx += 1) {
                    const x = x0 + @as(i32, @intCast(gx * scale + sx));
                    const y = y0 + @as(i32, @intCast(gy * scale + sy));
                    if (x >= 0 and y >= 0 and x < width and y < height) {
                        const y_usize: usize = @intCast(y);
                        const row = pixels[y_usize * stride_usize ..][0 .. @as(usize, @intCast(width_u)) * 4];
                        const px: usize = @as(usize, @intCast(x)) * 4;
                        row[px + 0] = fg.b;
                        row[px + 1] = fg.g;
                        row[px + 2] = fg.r;
                        row[px + 3] = 0xff;
                    }
                }
            }
        }
    }
}
