//! brushstroke/edit_filmstrip_jump.rye — HUNK55: tap a filmstrip thumbnail, the cursor jumps there — the band tapped is the band marked.
//!
//! Season A (Hardware & Right-to-Repair) · waymark HUNK · Photos-app journey · rung HUNK55.
//! Design read: active-designing/date/20260813/20260813-212112_hunk-filmstrip-jump-exploration.md
//! Teacher, thanked clean-room: the edit-history filmstrip of a photo app (iCloud Photos / Google Photos) — a keeper
//! taps a thumbnail in the history strip and the picture jumps to that step (concept only, siloed).
//!
//! HUNK54 paints the whole edit history as a filmstrip — a marker over the step the cursor stands on — yet a keeper
//! could only *read* it; the finger arc (HUNK50) walked the history one step per swipe. A filmstrip a keeper can read is
//! one they want to tap: touch thumbnail k, land on step k, in one gesture. This rung is that surface. FilmstripJump
//! owns one EditCursor and the filmstrip's thumbnail geometry; `tap_at` classifies a pixel tap into a band (HUNK50's own
//! `x / cell_px` idiom, here `x / band_px`) and seeks the cursor there through HUNK16's new `seek` — a jump that forgets
//! nothing, unlike a fresh push. `paint` is HUNK54's `filmstrip` unchanged, so the marker lands on exactly the sought
//! step: the band a keeper TAPS equals the band the marker SHOWS (HUNK52's no-drift discipline carried to the strip). A
//! pure composition — no new render primitive, no new arithmetic beyond a clamped division, no new failure mode. No
//! network, no key, no funds.
//!
//!   env RYE_ZIG=vendor/zig-toolchain/zig rye/bin/rye run brushstroke/edit_filmstrip_jump.rye selftest

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const qoi = @import("qoi.rye");
const edits = @import("photo_edits.rye");
const edit_cursor = @import("edit_cursor.rye");
const edit_filmstrip = @import("edit_filmstrip.rye");
const image_skate = @import("image_skate.rye");
const skate = @import("skate_grid.rye");

pub const edit_filmstrip_jump_version = "20260813.212112";

pub const FilmstripJumpError = error{
    BadThumb,
};

/// A tap-to-jump surface over the edit-history filmstrip: it owns one EditCursor (the history a keeper builds and
/// navigates) and the thumbnail geometry the filmstrip tiles with. It invents no pixels of its own — `paint` is HUNK54's
/// `filmstrip`, and a tap seeks the cursor so the marker lands where the finger did. The governing geometry: one
/// thumbnail band is `tcols` cells, each `skate.cell_w` pixels wide, so a tap at pixel `x` picks band `x / band_px`,
/// the exact parallel of HUNK50's `x / cell_px`.
pub const FilmstripJump = struct {
    cursor: edit_cursor.EditCursor,
    tcols: u32,
    trows: u32,

    /// Open a jump surface tiling `tcols`×`trows` thumbnails. Validates both dimensions positive once at construction
    /// (refusing `BadThumb`), so no later tap divides by a zero band and no paint down-maps a zero block. The cursor
    /// opens empty — the history is built by `push` before it is walked.
    pub fn open(tcols: u32, trows: u32) FilmstripJumpError!FilmstripJump {
        // invariant: a thumbnail has both dimensions, so a band has real pixel width and each step down-maps a real block.
        if (tcols == 0 or trows == 0) return error.BadThumb;
        // invariant: a grid of no columns or no rows would divide a touch position by zero
        // rather than place it on the surface
        assert(tcols >= 1);
        assert(trows >= 1);
        return FilmstripJump{ .cursor = edit_cursor.EditCursor.init(), .tcols = tcols, .trows = trows };
    }

    /// Record a fresh edit at the live position, delegating to HUNK16's `push` (forgetting any redo tail, refusing
    /// `TooManyEdits` at the list's own ceiling — the only refusal building the history can surface). The strip of
    /// thumbnails is built before any finger walks it.
    pub fn push(self: *FilmstripJump, e: edits.Edit) edits.EditsError!void {
        // invariant: the cursor stands within its history before the push.
        assert(self.cursor.position <= self.cursor.list.count);
        try self.cursor.push(e);
        // invariant: a fresh edit is the live edge.
        assert(self.cursor.position == self.cursor.list.count);
    }

    /// The pixel width of one thumbnail band — `tcols` cells, each `skate.cell_w` pixels at scale 1. The divisor a tap
    /// is classified against; positive by construction (`tcols >= 1`), so the classification is well-formed.
    pub fn band_px(self: *const FilmstripJump) u32 {
        // invariant: a band spans at least one cell's worth of pixels.
        assert(self.tcols >= 1);
        return self.tcols * skate.cell_w;
    }

    /// How many steps the filmstrip paints — the untouched source plus one thumbnail per recorded edit.
    pub fn steps(self: *const FilmstripJump) u32 {
        // invariant: the cursor stands within its history.
        assert(self.cursor.position <= self.cursor.list.count);
        return self.cursor.list.count + 1;
    }

    /// Classify a pixel tap at `x` into the filmstrip band it lands on, or `null` for a tap off the strip. A negative
    /// `x` (off the left edge) fires nothing; `band = x / band_px`; a band past the last thumbnail (`band >= steps`)
    /// fires nothing. Pure — it reads the geometry and moves nothing.
    pub fn tap_band(self: *const FilmstripJump, x: i32) ?u32 {
        // invariant: the cursor stands within its history.
        assert(self.cursor.position <= self.cursor.list.count);
        if (x < 0) return null;
        const band: u32 = @as(u32, @intCast(x)) / self.band_px();
        if (band >= self.steps()) return null;
        return band;
    }

    /// Tap the filmstrip at pixel `x`: classify the band and, when the tap lands on a thumbnail, seek the cursor to that
    /// step through HUNK16's `seek` — a jump that forgets nothing, so every edit stays reachable. Returns the band the
    /// cursor landed on, or `null` for a tap off the strip (the cursor unmoved). The one call that turns a tap into a
    /// jump.
    pub fn tap_at(self: *FilmstripJump, x: i32) ?u32 {
        // invariant: the cursor stands within its history before the tap.
        assert(self.cursor.position <= self.cursor.list.count);
        const band = self.tap_band(x);
        if (band) |k| {
            self.cursor.seek(k);
            // invariant: a landed tap put the cursor exactly on the tapped band.
            assert(self.cursor.position == k);
        }
        // invariant: the cursor still stands within its history after the tap.
        assert(self.cursor.position <= self.cursor.list.count);
        return band;
    }

    /// Paint the whole edit history as a filmstrip with the marker on the step the cursor stands on — HUNK54's
    /// `filmstrip` unchanged. Because a tap seeks the cursor and the marker paints at `cursor.position`, the band a
    /// keeper tapped is the band the marker shows. Pure — the history is read, never moved, the source never mutated.
    pub fn paint(self: *const FilmstripJump, allocator: std.mem.Allocator, source: *const qoi.Pixmap) !skate.Grid {
        // invariant: the cursor stands within its history before the replay.
        assert(self.cursor.position <= self.cursor.list.count);
        return edit_filmstrip.filmstrip(allocator, source, &self.cursor, self.tcols, self.trows);
    }
};

// --- selftest: an 8x8 two-tone source, a jump surface holding three edits — a tap centered on band k seeks the cursor
//     to step k, the repainted marker sits on exactly band k (no drift), a jump forgets nothing (back then forward
//     recovers the full picture), a tap off the strip fires nothing, and a bad thumbnail refuses at open --------------

fn craft_two_tone(allocator: std.mem.Allocator) !qoi.Pixmap {
    const w: u32 = 8;
    const h: u32 = 8;
    const buf = try allocator.alloc(u8, w * h * 4);
    var y: u32 = 0;
    while (y < h) : (y += 1) {
        var x: u32 = 0;
        while (x < w) : (x += 1) {
            const off = (@as(usize, y) * @as(usize, w) + @as(usize, x)) * 4;
            const left = x < w / 2;
            buf[off] = if (left) 255 else 0; // r
            buf[off + 1] = 0; // g
            buf[off + 2] = if (left) 0 else 255; // b
            buf[off + 3] = 255; // a
        }
    }
    return qoi.Pixmap{ .width = w, .height = h, .channels = 4, .colorspace = 0, .pixels = buf };
}

/// The x-pixel at the center of band `k` — a real tap a device would report, landing squarely inside the band's span
/// `[k·band_px, (k+1)·band_px)`.
fn band_center_x(surface: *const FilmstripJump, k: u32) i32 {
    const bpx = surface.band_px();
    return @intCast(k * bpx + bpx / 2);
}

/// Assert the filmstrip's marker block sits on band `k` and nowhere else — the tapped band equals the marked band.
fn marker_on_band(film: *const skate.Grid, tcols: u32, k: u32) void {
    const bands = film.cols / tcols;
    var band: u32 = 0;
    while (band < bands) : (band += 1) {
        const cell_i: usize = @intCast(band * tcols); // first marker cell (row 0) of the band
        if (band == k) {
            assert(film.cells[cell_i] == image_skate.block_cell);
            assert(film.fg_index[cell_i] == edit_filmstrip.marker_slot);
        } else {
            assert(film.cells[cell_i] != image_skate.block_cell); // blank — not the marked step
        }
    }
}

fn run_selftest(garden: std.mem.Allocator) !u8 {
    const pm = try craft_two_tone(garden);

    const tcols: u32 = 2;
    const trows: u32 = 2;
    var surface = try FilmstripJump.open(tcols, trows);
    try surface.push(.flip_h);
    try surface.push(.flip_v);
    try surface.push(.{ .rotate = .{ .turns = 1 } });
    // invariant: three edits recorded, the cursor at the live edge, four steps to tile.
    assert(surface.cursor.list.count == 3);
    assert(surface.cursor.position == 3);
    assert(surface.steps() == 4);

    // Tap-to-jump lands exactly: a tap centered on band 1 seeks the cursor to position 1; band 2 to position 2; band 0
    // (the source) to position 0. Each time the repainted marker sits on exactly the tapped band — no drift.
    {
        var k: u32 = 0;
        while (k < surface.steps()) : (k += 1) {
            const landed = surface.tap_at(band_center_x(&surface, k));
            assert(landed != null);
            assert(landed.? == k);
            assert(surface.cursor.position == k);
            const film = try surface.paint(garden, &pm);
            marker_on_band(&film, tcols, k); // the band a keeper TAPS is the band the marker SHOWS
        }
    }

    // A jump forgets nothing: jump back to step 1, then forward to step 3 — the full picture returns byte-for-byte, so
    // every edit stayed reachable (a jump is a walk, never a push that discards the redo tail).
    {
        _ = surface.tap_at(band_center_x(&surface, 3)); // stand at the live edge
        const full = try edit_cursor.view(garden, &pm, &surface.cursor);
        _ = surface.tap_at(band_center_x(&surface, 1));
        assert(surface.cursor.position == 1);
        assert(surface.cursor.can_redo()); // steps 2 and 3 still redoable
        _ = surface.tap_at(band_center_x(&surface, 3));
        assert(surface.cursor.position == 3);
        const back = try edit_cursor.view(garden, &pm, &surface.cursor);
        assert(back.same_bytes(&full)); // the whole history rolled forward, unchanged
    }

    // A tap off the strip fires nothing — the cursor stays exactly where it stood, and a negative-x tap likewise.
    {
        _ = surface.tap_at(band_center_x(&surface, 2)); // stand on band 2
        const before = surface.cursor.position;
        const off = surface.tap_at(@intCast(surface.steps() * surface.band_px() + 5)); // past the last band
        assert(off == null);
        assert(surface.cursor.position == before);
        const neg = surface.tap_at(-3);
        assert(neg == null);
        assert(surface.cursor.position == before);
    }

    // Genuinely seen: after a tap the filmstrip rasterizes to a lit canvas — the whole road reaches the glass with the
    // marker on the tapped step.
    {
        _ = surface.tap_at(band_center_x(&surface, 1));
        const film = try surface.paint(garden, &pm);
        const scale: u32 = 1;
        const width: u32 = film.cols * skate.cell_w * scale;
        const height: u32 = film.rows * skate.cell_h * scale;
        const stride: u32 = width * 4;
        const canvas = try garden.alloc(u8, @as(usize, stride) * @as(usize, height));
        const bg = skate.Color{ .r = 1, .g = 2, .b = 3 };
        const fg = skate.Color{ .r = 200, .g = 200, .b = 200 };
        film.rasterize(canvas, stride, @intCast(width), @intCast(height), bg, fg, scale);
        const lit = film.lit_pixel_count(canvas, stride, @intCast(width), @intCast(height), bg);
        assert(lit > 0);
    }

    // A bad thumbnail refuses at open by name — a zero-dimension thumbnail would divide a tap by a zero band.
    if (FilmstripJump.open(0, trows)) |_| return error.ThumbSlipped else |e| {
        if (e != error.BadThumb) return error.WrongThumb;
    }
    if (FilmstripJump.open(tcols, 0)) |_| return error.ThumbSlipped else |e| {
        if (e != error.BadThumb) return error.WrongThumb;
    }

    print("GREEN edit-filmstrip-jump: an 8x8 two-tone source, a jump surface holding three edits — a tap centered on " ++
        "band k seeks the cursor to step k for every step (0..3), and the repainted marker sits on exactly the tapped " ++
        "band cell-for-cell (the band tapped is the band marked, no drift); a jump forgets nothing (back to step 1 " ++
        "then forward to step 3 recovers the full picture byte-for-byte, steps 2 and 3 still redoable); a tap past the " ++
        "last band and a negative-x tap each fire nothing (the cursor unmoved); the jumped filmstrip rasterizes to a " ++
        "lit canvas; a zero-dimension thumbnail refuses BadThumb at open. HUNK54 filmstrip, HUNK16 cursor+seek GREEN " ++
        "beneath; no network, no key, no funds\n", .{});
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const garden = init.arena.allocator();
    const args = try init.minimal.args.toSlice(garden);
    if (args.len >= 2 and std.mem.eql(u8, args[1], "selftest")) {
        return run_selftest(garden);
    }
    print("usage: edit_filmstrip_jump selftest\n", .{});
    return 1;
}
