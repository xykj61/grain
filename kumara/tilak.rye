//! kumara/tilak.rye — the Kumara identity template: the point and the bind.
//!
//! Kumara names the keypair that signs a fact before it enters the log
//! (`tally/kumara.rye`). A Kumara *identity* is more than a key: it is a small
//! family of type-marked records — tilaks — that say who a key is, who keeps it,
//! and how it may move. This file seats the two load-bearing tilaks every other
//! hangs from:
//!
//!   * **point** — the deed: a number within a scarcity shape, its keeper, and a
//!     version that climbs by exactly one on every change.
//!   * **bind** — the marriage of a keypair to its keeper, signed *both* ways:
//!     the key signs the keeper, and the keeper signs the key. Neither alone is
//!     the identity; the mutual signature is.
//!
//! A "template" is this shape; an "instance" is one filled quintet of tilaks for
//! a real pilot. This module builds and verifies an instance from two seeds and
//! serializes it to Bron facts — the first identity template plus a witnessed
//! example instance. The pilot's own instance is filled by his hand, from his own
//! seed kept in his own jail; this file never invents a real pilot's key.
//!
//! Scarcity is the d12·d60 fractal (`../comlink/topology.rye`): a point number
//! decodes to a place — a galaxy, a star within it, a planet within that — and the
//! place is the tier. The elder Azimuth ranks (2^8 · 2^16 · 2^32) are retired
//! (Keaton's word `20260810`); the tiers stay legible over keypairs that are what
//! actually trust, rather than a hierarchy of power.
//!
//! Settled since (JARL): the ledger is built on Sui (`../settlement/constellation.rye`),
//! the scarcity is the d12·d60 fractal, and the rotation and capability tilaks
//! (turn · tend · sow · hand · sponsor) all stand below. Held still: the human-name
//! custody park, and how small the shared surface can shrink.
//!
//!   rye build kumara/tilak.rye -femit-bin=kumara/bin/tilak
//!   kumara/bin/tilak selftest      # prove make + verify + tamper-reject
//!   kumara/bin/tilak emit          # print an example instance as Bron facts

const std = @import("std");
const assert = std.debug.assert;
const print = std.debug.print;
const kumara = @import("kumara.rye");
const topology = @import("topology.rye");

pub const tilak_version = "20260810.002400";

// A point number's tier is its place in the d12·d60 fractal. Topology is the one
// source of scarcity, so the tilak keeps no ceilings of its own; the elder Azimuth
// ranks are retired (Keaton's word `20260810`).
pub const Tier = topology.Tier;

/// The tier a point number falls in — its place in the fractal, address legibility
/// rather than a rank of power. A number past the universe has no place.
pub fn tier_of(number: u32) Tier {
    // invariant: a point number sits inside the d12·d60 universe.
    assert(number < topology.universe_points);
    return topology.decode(number).?.tier;
}

const pubkey_len: u32 = 32;
const sig_len: u32 = 64;

/// The public key bytes of the keypair a seed yields — the identity a turn or a
/// bind is verified against, without exposing the whole keypair.
pub fn pubkey_of(seed: *const [kumara.seed_length]u8) [pubkey_len]u8 {
    return kumara.keypair_from_seed(seed).public_key.bytes;
}

/// The deed. One keeper, one climbing version; the parent is the sponsor's number,
/// defaulting to the arithmetic parent until the child escapes to a chosen one.
pub const Point = struct {
    number: u32,
    keeper: [pubkey_len]u8, // the keeper's public key
    parent: u32, // sponsor point number
    version: u32, // climbs by exactly one per change

    /// A fresh point at version 1, parented to its topology default sponsor.
    pub fn seat(number: u32, keeper: [pubkey_len]u8) Point {
        // invariant: a point number sits inside the d12·d60 universe.
        assert(number < topology.universe_points);
        // invariant: the default parent is the topology sponsor — a planet's star, a
        // star's galaxy, a galaxy itself — the same parent link the fractal names.
        const default_parent: u32 = topology.encode(topology.decode(number).?.parent());
        const p = Point{ .number = number, .keeper = keeper, .parent = default_parent, .version = 1 };
        // invariant: a seated point begins at version one.
        assert(p.version == 1);
        // invariant: a point's default parent never exceeds the point itself.
        assert(p.parent <= p.number);
        return p;
    }
};

/// The marriage of a keypair to its keeper, signed both ways. `sig_by_key` is the
/// identity key's signature over the keeper's public key; `sig_by_keeper` is the
/// keeper's signature over the identity's public key. Both must verify.
pub const Bind = struct {
    kumara_pubkey: [pubkey_len]u8,
    keeper_pubkey: [pubkey_len]u8,
    sig_by_key: [sig_len]u8,
    sig_by_keeper: [sig_len]u8,
    version: u32,
};

/// Build a bind from an identity seed and a keeper seed. Each side signs the
/// other's public key, so the record proves a mutual claim rather than one side's.
pub fn make_bind(key_seed: *const [kumara.seed_length]u8, keeper_seed: *const [kumara.seed_length]u8) Bind {
    const kp = kumara.keypair_from_seed(key_seed);
    const keeper_kp = kumara.keypair_from_seed(keeper_seed);
    const key_pub = kp.public_key.bytes;
    const keeper_pub = keeper_kp.public_key.bytes;
    // The key signs the keeper; the keeper signs the key. Order fixed so verify agrees.
    const sig_key = kumara.sign(&keeper_pub, kp, null).toBytes();
    const sig_keeper = kumara.sign(&key_pub, keeper_kp, null).toBytes();
    const b = Bind{
        .kumara_pubkey = key_pub,
        .keeper_pubkey = keeper_pub,
        .sig_by_key = sig_key,
        .sig_by_keeper = sig_keeper,
        .version = 1,
    };
    // invariant: a bind names exactly one key and one keeper, distinct or not.
    assert(b.version == 1);
    return b;
}

/// A bind holds when both directions verify: the key really signed the keeper,
/// and the keeper really signed the key. Either failing rejects the whole bind.
pub fn verify_bind(b: *const Bind) bool {
    const key_pub = kumara.PublicKey.fromBytes(b.kumara_pubkey) catch return false;
    const keeper_pub = kumara.PublicKey.fromBytes(b.keeper_pubkey) catch return false;
    kumara.verify_bytes(&b.keeper_pubkey, &b.sig_by_key, key_pub) catch return false;
    kumara.verify_bytes(&b.kumara_pubkey, &b.sig_by_keeper, keeper_pub) catch return false;
    return true;
}

// Little-endian integer bytes, so a signed message is the same on every target.
fn u32_le(out: *[4]u8, v: u32) void {
    std.mem.writeInt(u32, out, v, .little);
}

fn u64_le(out: *[8]u8, v: u64) void {
    std.mem.writeInt(u64, out, v, .little);
}

/// The rotation record — the networking key Comlink reads on every handshake, with
/// two counters that only ever climb: `key_counter` on an ordinary rotation,
/// `reset_counter` when continuity must start over (which zeroes the key counter).
/// The identity key signs the record, so a rotation is authentic, not forged.
pub const Turn = struct {
    net_pubkey: [pubkey_len]u8,
    key_counter: u64,
    reset_counter: u64,
    sig: [sig_len]u8, // identity key signs net_pubkey ++ key_counter ++ reset_counter

    fn message(self: *const Turn, out: *[48]u8) void {
        for (self.net_pubkey, 0..) |b, i| out[i] = b;
        u64_le(out[32..40], self.key_counter);
        u64_le(out[40..48], self.reset_counter);
    }
};

pub fn make_turn(key_seed: *const [kumara.seed_length]u8, net_seed: *const [kumara.seed_length]u8, key_counter: u64, reset_counter: u64) Turn {
    const kp = kumara.keypair_from_seed(key_seed);
    const net_kp = kumara.keypair_from_seed(net_seed);
    var t = Turn{ .net_pubkey = net_kp.public_key.bytes, .key_counter = key_counter, .reset_counter = reset_counter, .sig = undefined };
    var msg: [48]u8 = undefined;
    t.message(&msg);
    t.sig = kumara.sign(&msg, kp, null).toBytes();
    // invariant: a turn keeps the counters it was asked to carry.
    assert(t.key_counter == key_counter);
    assert(t.reset_counter == reset_counter);
    return t;
}

pub fn verify_turn(t: *const Turn, identity_pubkey: [pubkey_len]u8) bool {
    const pub_key = kumara.PublicKey.fromBytes(identity_pubkey) catch return false;
    var msg: [48]u8 = undefined;
    t.message(&msg);
    kumara.verify_bytes(&msg, &t.sig, pub_key) catch return false;
    return true;
}

// A turn on the wire: net_pubkey ++ key_counter ++ reset_counter ++ signature,
// a fixed 112 bytes, so a descriptor can carry a peer's whole rotation as bytes
// and a reader recovers the same Turn to verify.
pub const turn_wire_len: u32 = pubkey_len + 8 + 8 + sig_len; // 112

pub fn turn_to_bytes(t: *const Turn) [turn_wire_len]u8 {
    var out: [turn_wire_len]u8 = undefined;
    for (t.net_pubkey, 0..) |b, i| out[i] = b;
    u64_le(out[32..40], t.key_counter);
    u64_le(out[40..48], t.reset_counter);
    for (t.sig, 0..) |b, i| out[48 + i] = b;
    return out;
}

/// Recover a turn from its wire bytes, or null when the slice is too short. The
/// signature still has to verify; this only parses the shape, never trusts it.
pub fn turn_from_bytes(bytes: []const u8) ?Turn {
    if (bytes.len < turn_wire_len) return null;
    var t: Turn = undefined;
    for (0..pubkey_len) |i| t.net_pubkey[@intCast(i)] = bytes[i];
    t.key_counter = std.mem.readInt(u64, bytes[32..40], .little);
    t.reset_counter = std.mem.readInt(u64, bytes[40..48], .little);
    for (0..sig_len) |i| t.sig[@intCast(i)] = bytes[48 + i];
    return t;
}

// The three lendable powers: management (tend), spawn (sow), transfer (hand).
pub const Power = enum(u8) { tend = 1, sow = 2, hand = 3 };

/// A capability record — one power over one point, in exactly one holder's hand at a
/// time. The keeper signs the grant, so the holder's claim traces back to the keeper;
/// a capability moves by a fresh signed grant, never by copying an old one.
pub const Cap = struct {
    point_number: u32,
    power: Power,
    holder: [pubkey_len]u8,
    sig: [sig_len]u8, // keeper signs point_number ++ power ++ holder
    version: u32,

    fn message(self: *const Cap, out: *[37]u8) void {
        u32_le(out[0..4], self.point_number);
        out[4] = @intFromEnum(self.power);
        for (self.holder, 0..) |b, i| out[5 + i] = b;
    }
};

pub fn make_cap(keeper_seed: *const [kumara.seed_length]u8, point_number: u32, power: Power, holder: [pubkey_len]u8) Cap {
    const keeper_kp = kumara.keypair_from_seed(keeper_seed);
    var c = Cap{ .point_number = point_number, .power = power, .holder = holder, .sig = undefined, .version = 1 };
    var msg: [37]u8 = undefined;
    c.message(&msg);
    c.sig = kumara.sign(&msg, keeper_kp, null).toBytes();
    // invariant: a fresh capability grant begins at version one.
    assert(c.version == 1);
    return c;
}

pub fn verify_cap(c: *const Cap, keeper_pubkey: [pubkey_len]u8) bool {
    const pub_key = kumara.PublicKey.fromBytes(keeper_pubkey) catch return false;
    var msg: [37]u8 = undefined;
    c.message(&msg);
    kumara.verify_bytes(&msg, &c.sig, pub_key) catch return false;
    return true;
}

/// The parent link — sponsorship. Every point has an arithmetic default parent; a
/// child may escape to a chosen one, and that escape is the child's word alone, so
/// the child's identity key signs the chosen parent. `chosen == default` means no
/// escape yet.
pub const Sponsor = struct {
    point_number: u32,
    default_parent: u32,
    chosen_parent: u32,
    sig: [sig_len]u8, // child's identity key signs point_number ++ chosen_parent
    version: u32,

    fn message(self: *const Sponsor, out: *[8]u8) void {
        u32_le(out[0..4], self.point_number);
        u32_le(out[4..8], self.chosen_parent);
    }
};

pub fn make_sponsor(child_key_seed: *const [kumara.seed_length]u8, point_number: u32, default_parent: u32, chosen_parent: u32) Sponsor {
    const child_kp = kumara.keypair_from_seed(child_key_seed);
    var s = Sponsor{ .point_number = point_number, .default_parent = default_parent, .chosen_parent = chosen_parent, .sig = undefined, .version = 1 };
    var msg: [8]u8 = undefined;
    s.message(&msg);
    s.sig = kumara.sign(&msg, child_kp, null).toBytes();
    // invariant: a sponsor link names one point and one chosen parent.
    assert(s.version == 1);
    return s;
}

pub fn verify_sponsor(s: *const Sponsor, child_pubkey: [pubkey_len]u8) bool {
    const pub_key = kumara.PublicKey.fromBytes(child_pubkey) catch return false;
    var msg: [8]u8 = undefined;
    s.message(&msg);
    kumara.verify_bytes(&msg, &s.sig, pub_key) catch return false;
    return true;
}

// --- Bron serialization -------------------------------------------------

const hex_digits = "0123456789abcdef";

/// Write `bytes` as lowercase hex into `out` (which must be twice as long).
fn to_hex(bytes: []const u8, out: []u8) void {
    // invariant: the hex output is exactly two characters per byte.
    assert(out.len == bytes.len * 2);
    for (bytes, 0..) |b, i| {
        out[i * 2] = hex_digits[b >> 4];
        out[i * 2 + 1] = hex_digits[b & 0x0f];
    }
}

fn tier_name(t: Tier) []const u8 {
    return switch (t) {
        .galaxy => "galaxy",
        .star => "star",
        .planet => "planet",
    };
}

// The Bron facts are data, so they go to stdout (diagnostics use stderr `print`).
// A line is short — a hex field is at most 128 characters — so a stack buffer holds it.
const max_bron_line: u32 = 256;

fn put_line(io: std.Io, comptime fmt: []const u8, args: anytype) void {
    var buf: [max_bron_line]u8 = undefined;
    const line = std.fmt.bufPrint(&buf, fmt, args) catch return;
    const out = std.Io.File.stdout();
    out.writeStreamingAll(io, line) catch {};
}

/// Emit a point as a Bron fact — one field per line, immutable at the seam.
pub fn emit_point(io: std.Io, p: *const Point) void {
    var keeper_hex: [pubkey_len * 2]u8 = undefined;
    to_hex(&p.keeper, &keeper_hex);
    put_line(io, "format kumara-point-v1\n", .{});
    put_line(io, "number {d}\n", .{p.number});
    put_line(io, "tier {s}\n", .{tier_name(tier_of(p.number))});
    put_line(io, "keeper {s}\n", .{keeper_hex});
    put_line(io, "parent {d}\n", .{p.parent});
    put_line(io, "version {d}\n", .{p.version});
}

/// Emit a bind as a Bron fact.
pub fn emit_bind(io: std.Io, b: *const Bind) void {
    var kpub: [pubkey_len * 2]u8 = undefined;
    var keeper: [pubkey_len * 2]u8 = undefined;
    var s_key: [sig_len * 2]u8 = undefined;
    var s_keeper: [sig_len * 2]u8 = undefined;
    to_hex(&b.kumara_pubkey, &kpub);
    to_hex(&b.keeper_pubkey, &keeper);
    to_hex(&b.sig_by_key, &s_key);
    to_hex(&b.sig_by_keeper, &s_keeper);
    put_line(io, "format kumara-bind-v1\n", .{});
    put_line(io, "kumara_pubkey {s}\n", .{kpub});
    put_line(io, "keeper_pubkey {s}\n", .{keeper});
    put_line(io, "sig_by_key {s}\n", .{s_key});
    put_line(io, "sig_by_keeper {s}\n", .{s_keeper});
    put_line(io, "version {d}\n", .{b.version});
}

fn power_name(p: Power) []const u8 {
    return switch (p) {
        .tend => "tend",
        .sow => "sow",
        .hand => "hand",
    };
}

/// Emit a rotation record as a Bron fact.
pub fn emit_turn(io: std.Io, t: *const Turn) void {
    var net_hex: [pubkey_len * 2]u8 = undefined;
    var sig_hex: [sig_len * 2]u8 = undefined;
    to_hex(&t.net_pubkey, &net_hex);
    to_hex(&t.sig, &sig_hex);
    put_line(io, "format kumara-turn-v1\n", .{});
    put_line(io, "net_pubkey {s}\n", .{net_hex});
    put_line(io, "key_counter {d}\n", .{t.key_counter});
    put_line(io, "reset_counter {d}\n", .{t.reset_counter});
    put_line(io, "sig {s}\n", .{sig_hex});
}

/// Emit a capability record as a Bron fact.
pub fn emit_cap(io: std.Io, c: *const Cap) void {
    var holder_hex: [pubkey_len * 2]u8 = undefined;
    var sig_hex: [sig_len * 2]u8 = undefined;
    to_hex(&c.holder, &holder_hex);
    to_hex(&c.sig, &sig_hex);
    put_line(io, "format kumara-cap-v1\n", .{});
    put_line(io, "point {d}\n", .{c.point_number});
    put_line(io, "power {s}\n", .{power_name(c.power)});
    put_line(io, "holder {s}\n", .{holder_hex});
    put_line(io, "sig {s}\n", .{sig_hex});
    put_line(io, "version {d}\n", .{c.version});
}

/// Emit a sponsor link as a Bron fact.
pub fn emit_sponsor(io: std.Io, s: *const Sponsor) void {
    var sig_hex: [sig_len * 2]u8 = undefined;
    to_hex(&s.sig, &sig_hex);
    put_line(io, "format kumara-sponsor-v1\n", .{});
    put_line(io, "point {d}\n", .{s.point_number});
    put_line(io, "default_parent {d}\n", .{s.default_parent});
    put_line(io, "chosen_parent {d}\n", .{s.chosen_parent});
    put_line(io, "sig {s}\n", .{sig_hex});
    put_line(io, "version {d}\n", .{s.version});
}

// --- selftest and example instance --------------------------------------

// Example seeds — plainly not a real pilot's key, so no identity is invented.
const example_key_seed: [kumara.seed_length]u8 = .{0x11} ** kumara.seed_length;
const example_keeper_seed: [kumara.seed_length]u8 = .{0x22} ** kumara.seed_length;
const example_net_seed: [kumara.seed_length]u8 = .{0x33} ** kumara.seed_length;
const example_number: u32 = 27; // a star in the inclusive fractal — of_star(3,2), galaxy 3
const example_chosen_parent: u32 = 7; // an escape to a different galaxy (default is 3)

// The whole example instance — every tilak, from the example seeds.
const Instance = struct { b: Bind, p: Point, t: Turn, tend: Cap, sow: Cap, hand: Cap, s: Sponsor };

fn example_instance() Instance {
    const b = make_bind(&example_key_seed, &example_keeper_seed);
    const p = Point.seat(example_number, b.keeper_pubkey);
    const t = make_turn(&example_key_seed, &example_net_seed, 0, 0);
    // The keeper grants each power; here all three rest with the identity key.
    const tend = make_cap(&example_keeper_seed, example_number, .tend, b.kumara_pubkey);
    const sow = make_cap(&example_keeper_seed, example_number, .sow, b.kumara_pubkey);
    const hand = make_cap(&example_keeper_seed, example_number, .hand, b.kumara_pubkey);
    const s = make_sponsor(&example_key_seed, example_number, p.parent, example_chosen_parent);
    return .{ .b = b, .p = p, .t = t, .tend = tend, .sow = sow, .hand = hand, .s = s };
}

fn run_selftest() !u8 {
    const inst = example_instance();

    // The point seats at version one and names its tier.
    if (inst.p.version != 1) return error.PointVersionWrong;
    if (tier_of(inst.p.number) != .star) return error.TierWrong;

    // The bind verifies both ways; a tampered bind refuses.
    if (!verify_bind(&inst.b)) return error.BindDidNotVerify;
    var bad_bind = inst.b;
    bad_bind.sig_by_key[0] ^= 0x01;
    if (verify_bind(&bad_bind)) return error.TamperedBindVerified;

    // The turn verifies under the identity key; a bumped counter breaks the signature.
    if (!verify_turn(&inst.t, inst.b.kumara_pubkey)) return error.TurnDidNotVerify;
    var bad_turn = inst.t;
    bad_turn.key_counter += 1;
    if (verify_turn(&bad_turn, inst.b.kumara_pubkey)) return error.TamperedTurnVerified;

    // Each capability verifies under the keeper who granted it; a swapped power refuses.
    if (!verify_cap(&inst.tend, inst.b.keeper_pubkey)) return error.CapDidNotVerify;
    if (!verify_cap(&inst.sow, inst.b.keeper_pubkey)) return error.CapDidNotVerify;
    if (!verify_cap(&inst.hand, inst.b.keeper_pubkey)) return error.CapDidNotVerify;
    var bad_cap = inst.tend;
    bad_cap.power = .hand;
    if (verify_cap(&bad_cap, inst.b.keeper_pubkey)) return error.TamperedCapVerified;

    // The sponsor escape verifies under the child's key; a changed parent refuses.
    if (!verify_sponsor(&inst.s, inst.b.kumara_pubkey)) return error.SponsorDidNotVerify;
    if (inst.s.chosen_parent == inst.s.default_parent) return error.EscapeNotRecorded;
    var bad_sponsor = inst.s;
    bad_sponsor.chosen_parent += 1;
    if (verify_sponsor(&bad_sponsor, inst.b.kumara_pubkey)) return error.TamperedSponsorVerified;

    print("kumara tilak: five tilaks — point, bind, turn, three caps, sponsor — each made, signed by its authorizing party, verified, refused on tamper.\n", .{});
    print("kumara tilak: version {s}\n", .{tilak_version});
    print("GREEN: kumara tilak — the whole identity template holds; every claim traces to a signature, every tamper refuses.\n", .{});
    return 0;
}

fn run_emit(io: std.Io) !u8 {
    const inst = example_instance();
    emit_point(io, &inst.p);
    put_line(io, "\n", .{});
    emit_bind(io, &inst.b);
    put_line(io, "\n", .{});
    emit_turn(io, &inst.t);
    put_line(io, "\n", .{});
    emit_cap(io, &inst.tend);
    put_line(io, "\n", .{});
    emit_cap(io, &inst.sow);
    put_line(io, "\n", .{});
    emit_cap(io, &inst.hand);
    put_line(io, "\n", .{});
    emit_sponsor(io, &inst.s);
    return 0;
}

pub fn main(init: std.process.Init) !u8 {
    const args = try init.minimal.args.toSlice(init.arena.allocator());
    if (args.len >= 2 and std.mem.eql(u8, args[1], "emit")) return run_emit(init.io);
    return run_selftest();
}
